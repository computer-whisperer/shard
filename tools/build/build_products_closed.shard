;;; tools/build/build_products_closed.shard — the CLOSED-TIER product list:
;;; the sha256 family (Arc B's frozen articles — impgen wasm/x86 outs, welds,
;;; the stream/dispatch bins), split out of build_products.shard on
;;; 2026-09-02 so the DEFAULT corpus stops regenerating a closed arc's
;;; 12 MB products every commit (its canon pass alone peaks near 30 GB).
;;; run_corpus.sh builds this list only under CORPUS_CLOSED=1.
;;;
;;; RUN IT:  tools/build/build.sh tools/build/build_products_closed.shard

(import "../../kernel/stdlib.shard")
(import "../../meta/build")
(use (:: meta build *))

(fn build_products () (List BuildProfile)
  (list
    (MkBuildProfile
      (quote check)
      (quote imp)
      "tools/impgen/fixtures/impgen_x86_ifl_out.shard"
      "tools/impgen/fixtures/impgen_x86_ifl_out.shard"
      "")))

;; module-owned products live in their entries (the configuration home,
;; docs/BUILD.md §3/§10 D1): the driver loads each path below as its own
;; closure and appends its build_products — composition, not discovery.
(fn build_entries () (List (List Int))
  (list
    "std/mem/mod.build.shard"
    "std/str/mod.build.shard"
    "std/sha256/mod.build.shard"))
