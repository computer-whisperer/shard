;;; image.shard — the S2a roundtrip-gate DRIVER (docs/STORAGE.md §8a).
;;;
;;; The codec itself lives in kernel/image.shard (it moved there when the
;;; S2b front door landed — the loader consults images, and the kernel
;;; cannot import tools). This tool remains the gate: per file, text-load
;;; -> encode -> decode -> structural equality with the original, plus
;;; determinism (re-encoding the decoded tree reproduces the bytes).
;;; CACHE, NEVER TRUST: images never enter the trust ledger; the
;;; from-text corpus stays the soundness gate (STORAGE.md trust posture).
;;;
;;; RUN IT:   bin/shard_eval run tools/image/image.shard FILE.shard ...
;;;   (per-file ROUNDTRIP verdict; exit 0 = all green, 1 = any FAIL,
;;;    2 = usage)
;;; CHECK IT: bin/shard_eval run kernel/check.shard tools/image/image.shard

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/reader.shard")
(import "../../kernel/image.shard")
(import "../../kernel/loader.shard")

(use (:: kernel term *))
(use (:: kernel reader *))
(use (:: kernel image *))
(use (:: kernel loader World))
(use (:: kernel loader get_args))
(use (:: kernel loader read_file))
(use (:: kernel loader write))
(use (:: kernel loader exit))
(use (:: kernel loader int_list_eq))

(fn img_report ((verdict (List Int)) (path (List Int)) (w World)) World
  (write (img_app verdict (img_app "  " (img_app path "\n"))) w))

(fn img_check_file ((path (List Int)) (w World)) (Pair Bool World)
  (match (read_file path w)
    ((Pair None w1) (Pair False (img_report "FAIL read     " path w1)))
    ((Pair (Some src) w1)
     (match (read_all src)
       (None (Pair False (img_report "FAIL parse    " path w1)))
       ((Some xs)
        (let ((enc (img_encode xs)))
          (match (img_decode enc)
            (None (Pair False (img_report "FAIL decode   " path w1)))
            ((Some ys)
             (if (img_sxs_eq xs ys)
               (if (int_list_eq (img_encode ys) enc)
                 (Pair
                   True
                   (write
                     (img_app
                       "ROUNDTRIP OK  "
                       (img_app
                         path
                         (img_app
                           "  ("
                           (img_app
                             (show_int (img_sx_len xs))
                             (img_app
                               " exprs, "
                               (img_app (show_int (img_len enc)) " bytes)\n"))))))
                     w1))
                 (Pair False (img_report "FAIL reencode " path w1)))
               (Pair False (img_report "FAIL struct   " path w1)))))))))))

(fn img_main_go ((files (List (List Int))) (ok Bool) (w World)) World
  (measure (struct files))
  (match files
    (Nil (exit (if ok 0 1) w))
    ((Cons f rest)
     (match (img_check_file f w)
       ((Pair r w1) (img_main_go rest (if r ok False) w1))))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match args
       (Nil
         (exit
           2
           (write
             "usage: image FILE.shard [FILE...] — S2a roundtrip gate\n"
             w1)))
       (_ (img_main_go args True w1))))))
