;;; The LS3b mined-instance set (SEARCH.md, the lock-step arc, slice
;;; LS3-ii): six straight-line MEMORY-FREE spans mined 2026-08-02 from
;;; the generated std/sha256/impgen_x86_out.shard — real material the
;;; imp -> x86 leg actually emits.  Selection: the two shapes with a
;;; hand-visible shorter equivalent (a 32-bit self-truncation subsumed
;;; by a byte mask; a dead constant store), plus four workhorse shapes
;;; expected minimal (the byte-accumulate pair and triple, the
;;; xor-then-move exchange, the mov-then-rotate).
;;;
;;; PROVENANCE IS CORPUS-CHECKED: tools/search/x86_span_mine_pins.shard
;;; ties each instance to its exact slice of the artifact's own
;;; ix_sstmts output (claim + offset noted per instance below).  An
;;; impgen regen that moves the material turns those pins red, forcing
;;; a re-mine — the regen-canon contract for mined instances.

(import "../../../kernel/stdlib.shard")
(import "../../../models/x86/x86.shard")

(use (:: core List))
(use (:: core Nil))
(use (:: core Cons))
(use (:: core Option))
(use (:: core None))
(use (:: core Some))
(use (:: models x86 x86 *))

(fn xsi_drop ((n Int) (is (List XInstr))) (List XInstr)
  (measure (struct is))
  (match is
    (Nil Nil)
    ((Cons h rest) (if (lt 0 n) (xsi_drop (- n 1) rest) (Cons h rest)))))

(fn xsi_take ((n Int) (is (List XInstr))) (List XInstr)
  (measure (struct is))
  (match is
    (Nil Nil)
    ((Cons h rest) (if (lt 0 n) (Cons h (xsi_take (- n 1) rest)) Nil))))

(fn xsi_slice ((start Int) (len Int) (o (Option (List XInstr))))
  (Option (List XInstr))
  (match o
    (None None)
    ((Some is) (Some (xsi_take len (xsi_drop start is))))))

;; tie_x_shtotw @3: the word-truncate-then-mask — the 32-bit
;; self-truncation is subsumed by the byte mask (improvement expected).
(fn xsi_1 () (List XInstr) (list (XMovRR32 RAX RAX) (XBin XAnd RAX (SImm 255))))

;; tie_x_shround @30: the dead constant store — RAX is overwritten one
;; instruction later (improvement expected).
(fn xsi_2 () (List XInstr) (list (XMovRI RAX 0) (XMovRR RAX R8)))

;; tie_x_shround @43: xor-then-move (both registers end equal — no
;; single instruction does that; minimal expected).
(fn xsi_3 () (List XInstr) (list (XBin XXor RAX (SReg R15)) (XMovRR R15 RAX)))

;; tie_x_shround @1: independent effects on two registers (minimal
;; expected).
(fn xsi_4 () (List XInstr)
  (list (XBin32 XAdd R12 (SImm 1)) (XBin32 XMul R15 (SImm 256))))

;; tie_x_shround @4: the byte-accumulate workhorse triple (minimal
;; expected — three effects, no two-instruction cover in its alphabet).
(fn xsi_5 () (List XInstr)
  (list
    (XBin32 XAdd R15 (SReg RAX))
    (XBin32 XAdd R12 (SImm 1))
    (XBin32 XMul R15 (SImm 256))))

;; tie_x_shround @39: mov-then-rotate (no rotate-from-source
;; instruction exists; minimal expected).
(fn xsi_6 () (List XInstr) (list (XMovRR R15 R8) (XRorI32 R15 25)))
