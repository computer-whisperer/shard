(claim swr5_comm31_cons3
  (goal ((a Int) (b Int) (c Int) (v3 (List Int))) ()
    (=
      (swr5_step (Sv1) (swr5_step (Sv3) (Cons a (Cons b (Cons c v3)))))
      (swr5_step (Sv3) (swr5_step (Sv1) (Cons a (Cons b (Cons c v3)))))))
  (induct v3
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (d v4)
       (steps ((rewrite (lemma swr5_comm31_cons4) lr lhs true ())) refl)))))

(claim swr5_comm31_cons2
  (goal ((a Int) (b Int) (v2 (List Int))) ()
    (=
      (swr5_step (Sv1) (swr5_step (Sv3) (Cons a (Cons b v2))))
      (swr5_step (Sv3) (swr5_step (Sv1) (Cons a (Cons b v2))))))
  (induct v2
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c v3)
       (steps ((rewrite (lemma swr5_comm31_cons3) lr lhs true ())) refl)))))

(claim swr5_comm31_cons1
  (goal ((a Int) (v1 (List Int))) ()
    (=
      (swr5_step (Sv1) (swr5_step (Sv3) (Cons a v1)))
      (swr5_step (Sv3) (swr5_step (Sv1) (Cons a v1)))))
  (induct v1
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (b v2)
       (steps ((rewrite (lemma swr5_comm31_cons2) lr lhs true ())) refl)))))

(claim swr5_comm31
  (goal ((v (List Int))) ()
    (=
      (swr5_step (Sv1) (swr5_step (Sv3) v))
      (swr5_step (Sv3) (swr5_step (Sv1) v))))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps ((rewrite (lemma swr5_comm31_cons1) lr lhs true ())) refl)))))

;; --- the run-level window laws and their plug lifts ------------------------

(claim swr5_run_cancel
  (goal ((tail (List Swp5)) (v (List Int)) (s Swp5)) ()
    (= (swr5_run (Cons s (Cons s tail)) v) (swr5_run tail v)))
  (steps
    ((unfold swr5_run lhs)
     (reduce lhs)
     (unfold swr5_run lhs)
     (reduce lhs)
     (rewrite (lemma swr5_step_invol) lr lhs true ()))
    refl))

(claim swr5_run_order20
  (goal ((tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (Cons (Sv2) (Cons (Sv0) tail)) v)
      (swr5_run (Cons (Sv0) (Cons (Sv2) tail)) v)))
  (steps
    ((unfold swr5_run both)
     (reduce both)
     (unfold swr5_run both)
     (reduce both)
     (rewrite (lemma swr5_comm20) lr lhs true ()))
    refl))

(claim swr5_run_order30
  (goal ((tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (Cons (Sv3) (Cons (Sv0) tail)) v)
      (swr5_run (Cons (Sv0) (Cons (Sv3) tail)) v)))
  (steps
    ((unfold swr5_run both)
     (reduce both)
     (unfold swr5_run both)
     (reduce both)
     (rewrite (lemma swr5_comm30) lr lhs true ()))
    refl))

(claim swr5_run_order31
  (goal ((tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (Cons (Sv3) (Cons (Sv1) tail)) v)
      (swr5_run (Cons (Sv1) (Cons (Sv3) tail)) v)))
  (steps
    ((unfold swr5_run both)
     (reduce both)
     (unfold swr5_run both)
     (reduce both)
     (rewrite (lemma swr5_comm31) lr lhs true ()))
    refl))

(claim swr5_run_cancel_ctx
  (goal ((prefix (List Swp5)) (tail (List Swp5)) (v (List Int)) (s Swp5)) ()
    (=
      (swr5_run (swr5_plug prefix (Cons s (Cons s tail))) v)
      (swr5_run (swr5_plug prefix tail) v)))
  (induct prefix
    ((case Nil
       (steps
         ((unfold swr5_plug both)
          (reduce both)
          (rewrite (lemma swr5_run_cancel) lr lhs true ()))
         refl))
     (case Cons
       (head rest)
       (steps ((simp both) (rewrite (hyp ih) lr lhs true ())) refl)))))

(claim swr5_run_order20_ctx
  (goal ((prefix (List Swp5)) (tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (swr5_plug prefix (Cons (Sv2) (Cons (Sv0) tail))) v)
      (swr5_run (swr5_plug prefix (Cons (Sv0) (Cons (Sv2) tail))) v)))
  (induct prefix
    ((case Nil
       (steps
         ((unfold swr5_plug both)
          (reduce both)
          (rewrite (lemma swr5_run_order20) lr lhs true ()))
         refl))
     (case Cons
       (head rest)
       (steps ((simp both) (rewrite (hyp ih) lr lhs true ())) refl)))))

(claim swr5_run_order30_ctx
  (goal ((prefix (List Swp5)) (tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (swr5_plug prefix (Cons (Sv3) (Cons (Sv0) tail))) v)
      (swr5_run (swr5_plug prefix (Cons (Sv0) (Cons (Sv3) tail))) v)))
  (induct prefix
    ((case Nil
       (steps
         ((unfold swr5_plug both)
          (reduce both)
          (rewrite (lemma swr5_run_order30) lr lhs true ()))
         refl))
     (case Cons
       (head rest)
       (steps ((simp both) (rewrite (hyp ih) lr lhs true ())) refl)))))

(claim swr5_run_order31_ctx
  (goal ((prefix (List Swp5)) (tail (List Swp5)) (v (List Int))) ()
    (=
      (swr5_run (swr5_plug prefix (Cons (Sv3) (Cons (Sv1) tail))) v)
      (swr5_run (swr5_plug prefix (Cons (Sv1) (Cons (Sv3) tail))) v)))
  (induct prefix
    ((case Nil
       (steps
         ((unfold swr5_plug both)
          (reduce both)
          (rewrite (lemma swr5_run_order31) lr lhs true ()))
         refl))
     (case Cons
       (head rest)
       (steps ((simp both) (rewrite (hyp ih) lr lhs true ())) refl)))))
