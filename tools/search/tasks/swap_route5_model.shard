;;; Swap-network model, FIVE registers: the k=4 rung of the split-economics
;;; scaling ladder (swap_route_model is the k=3 instrument).  Same
;;; position-uniform semantics, one more adjacent transposition (Sv3 swaps
;;; positions 3-4), reversal now needs ten swaps.  The law tower mirrors
;;; the four-register file claim for claim — swr_swap_head and its
;;; involution are IMPORTED, not re-proven — and adds the two deeper
;;; disjoint commutations (0,3) and (1,3).

(import "../../../kernel/stdlib.shard")
(import "swap_route_model.shard")

(use (:: core List))
(use (:: core Nil))
(use (:: core Cons))
(use (:: tools search tasks swap_route_model swr_swap_head))
(use (:: tools search tasks swap_route_model swr_swap_head_invol))

(type Swp5 (Sv0) (Sv1) (Sv2) (Sv3))

(fn swr5_step ((s Swp5) (v (List Int))) (List Int)
  (match s
    ((Sv0) (swr_swap_head v))
    ((Sv1)
     (match v
       (Nil Nil)
       ((Cons a v1) (Cons a (swr_swap_head v1)))))
    ((Sv2)
     (match v
       (Nil Nil)
       ((Cons a v1)
        (match v1
          (Nil (Cons a Nil))
          ((Cons b v2) (Cons a (Cons b (swr_swap_head v2))))))))
    ((Sv3)
     (match v
       (Nil Nil)
       ((Cons a v1)
        (match v1
          (Nil (Cons a Nil))
          ((Cons b v2)
           (match v2
             (Nil (Cons a (Cons b Nil)))
             ((Cons c v3) (Cons a (Cons b (Cons c (swr_swap_head v3)))))))))))))

(fn swr5_run ((body (List Swp5)) (v (List Int))) (List Int)
  (measure (struct body))
  (match body
    (Nil v)
    ((Cons s rest) (swr5_run rest (swr5_step s v)))))

(fn swr5_observe ((body (List Swp5))) (List Int)
  (swr5_run body (list 0 1 2 3 4)))

;; Transparent right action used to authenticate contextual sequence laws.
(fn swr5_plug ((prefix (List Swp5)) (suffix (List Swp5))) (List Swp5)
  (measure (struct prefix))
  (match prefix
    (Nil suffix)
    ((Cons head tail) (Cons head (swr5_plug tail suffix)))))

;; --- involution: s . s = id ------------------------------------------------

(claim swr5_sv0_invol
  (goal ((v (List Int))) () (= (swr5_step (Sv0) (swr5_step (Sv0) v)) v))
  (steps
    ((unfold swr5_step lhs)
     (reduce lhs)
     (unfold swr5_step lhs)
     (reduce lhs)
     (rewrite (lemma swr_swap_head_invol) lr lhs true ()))
    refl))

(claim swr5_sv1_invol
  (goal ((v (List Int))) () (= (swr5_step (Sv1) (swr5_step (Sv1) v)) v))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps
         ((unfold swr5_step lhs)
          (reduce lhs)
          (unfold swr5_step lhs)
          (reduce lhs)
          (rewrite (lemma swr_swap_head_invol) lr lhs true ()))
         refl)))))

(claim swr5_sv2_invol_cons
  (goal ((a Int) (v1 (List Int))) ()
    (= (swr5_step (Sv2) (swr5_step (Sv2) (Cons a v1))) (Cons a v1)))
  (induct v1
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (b v2)
       (steps
         ((unfold swr5_step lhs)
          (reduce lhs)
          (unfold swr5_step lhs)
          (reduce lhs)
          (rewrite (lemma swr_swap_head_invol) lr lhs true ()))
         refl)))))

(claim swr5_sv2_invol
  (goal ((v (List Int))) () (= (swr5_step (Sv2) (swr5_step (Sv2) v)) v))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps ((rewrite (lemma swr5_sv2_invol_cons) lr lhs true ())) refl)))))

(claim swr5_sv3_invol_cons2
  (goal ((a Int) (b Int) (v2 (List Int))) ()
    (=
      (swr5_step (Sv3) (swr5_step (Sv3) (Cons a (Cons b v2))))
      (Cons a (Cons b v2))))
  (induct v2
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c v3)
       (steps
         ((unfold swr5_step lhs)
          (reduce lhs)
          (unfold swr5_step lhs)
          (reduce lhs)
          (rewrite (lemma swr_swap_head_invol) lr lhs true ()))
         refl)))))

(claim swr5_sv3_invol_cons
  (goal ((a Int) (v1 (List Int))) ()
    (= (swr5_step (Sv3) (swr5_step (Sv3) (Cons a v1))) (Cons a v1)))
  (induct v1
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (b v2)
       (steps ((rewrite (lemma swr5_sv3_invol_cons2) lr lhs true ())) refl)))))

(claim swr5_sv3_invol
  (goal ((v (List Int))) () (= (swr5_step (Sv3) (swr5_step (Sv3) v)) v))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps ((rewrite (lemma swr5_sv3_invol_cons) lr lhs true ())) refl)))))

(claim swr5_step_invol
  (goal ((s Swp5) (v (List Int))) () (= (swr5_step s (swr5_step s v)) v))
  (case-on s Swp5
    ((case Sv0
       (steps
         ((rewrite (hyp Sv0) lr both true ())
          (rewrite (lemma swr5_sv0_invol) lr lhs true ()))
         refl))
     (case Sv1
       (steps
         ((rewrite (hyp Sv1) lr both true ())
          (rewrite (lemma swr5_sv1_invol) lr lhs true ()))
         refl))
     (case Sv2
       (steps
         ((rewrite (hyp Sv2) lr both true ())
          (rewrite (lemma swr5_sv2_invol) lr lhs true ()))
         refl))
     (case Sv3
       (steps
         ((rewrite (hyp Sv3) lr both true ())
          (rewrite (lemma swr5_sv3_invol) lr lhs true ()))
         refl)))))

;; --- disjoint commutations -------------------------------------------------

(claim swr5_comm20_cons3
  (goal ((a Int) (b Int) (c Int) (v3 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv2) (Cons a (Cons b (Cons c v3)))))
      (swr5_step (Sv2) (swr5_step (Sv0) (Cons a (Cons b (Cons c v3)))))))
  (induct v3
    ((case Nil (steps ((compute both)) refl))
     (case Cons (d r) (steps ((compute both)) refl)))))

(claim swr5_comm20_cons2
  (goal ((a Int) (b Int) (v2 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv2) (Cons a (Cons b v2))))
      (swr5_step (Sv2) (swr5_step (Sv0) (Cons a (Cons b v2))))))
  (induct v2
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c v3)
       (steps ((rewrite (lemma swr5_comm20_cons3) lr lhs true ())) refl)))))

(claim swr5_comm20_cons1
  (goal ((a Int) (v1 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv2) (Cons a v1)))
      (swr5_step (Sv2) (swr5_step (Sv0) (Cons a v1)))))
  (induct v1
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (b v2)
       (steps ((rewrite (lemma swr5_comm20_cons2) lr lhs true ())) refl)))))

(claim swr5_comm20
  (goal ((v (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv2) v))
      (swr5_step (Sv2) (swr5_step (Sv0) v))))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps ((rewrite (lemma swr5_comm20_cons1) lr lhs true ())) refl)))))

(claim swr5_comm30_cons4
  (goal ((a Int) (b Int) (c Int) (d Int) (v4 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv3) (Cons a (Cons b (Cons c (Cons d v4))))))
      (swr5_step (Sv3) (swr5_step (Sv0) (Cons a (Cons b (Cons c (Cons d v4))))))))
  (induct v4
    ((case Nil (steps ((compute both)) refl))
     (case Cons (e r) (steps ((compute both)) refl)))))

(claim swr5_comm30_cons3
  (goal ((a Int) (b Int) (c Int) (v3 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv3) (Cons a (Cons b (Cons c v3)))))
      (swr5_step (Sv3) (swr5_step (Sv0) (Cons a (Cons b (Cons c v3)))))))
  (induct v3
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (d v4)
       (steps ((rewrite (lemma swr5_comm30_cons4) lr lhs true ())) refl)))))

(claim swr5_comm30_cons2
  (goal ((a Int) (b Int) (v2 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv3) (Cons a (Cons b v2))))
      (swr5_step (Sv3) (swr5_step (Sv0) (Cons a (Cons b v2))))))
  (induct v2
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c v3)
       (steps ((rewrite (lemma swr5_comm30_cons3) lr lhs true ())) refl)))))

(claim swr5_comm30_cons1
  (goal ((a Int) (v1 (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv3) (Cons a v1)))
      (swr5_step (Sv3) (swr5_step (Sv0) (Cons a v1)))))
  (induct v1
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (b v2)
       (steps ((rewrite (lemma swr5_comm30_cons2) lr lhs true ())) refl)))))

(claim swr5_comm30
  (goal ((v (List Int))) ()
    (=
      (swr5_step (Sv0) (swr5_step (Sv3) v))
      (swr5_step (Sv3) (swr5_step (Sv0) v))))
  (induct v
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (a v1)
       (steps ((rewrite (lemma swr5_comm30_cons1) lr lhs true ())) refl)))))

(claim swr5_comm31_cons4
  (goal ((a Int) (b Int) (c Int) (d Int) (v4 (List Int))) ()
    (=
      (swr5_step (Sv1) (swr5_step (Sv3) (Cons a (Cons b (Cons c (Cons d v4))))))
      (swr5_step (Sv3) (swr5_step (Sv1) (Cons a (Cons b (Cons c (Cons d v4))))))))
  (induct v4
    ((case Nil (steps ((compute both)) refl))
