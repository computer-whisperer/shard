;;; Swap-network routing, FIVE registers (the k=4 scaling rung — see
;;; swap_route.shard for the k=3 instrument and the split-economics
;;; question this ladder measures).  Reversal of [0..4] is the longest
;;; element of S5: ten adjacent swaps minimum, searched at depth 11 over
;;; a four-letter alphabet.  The plan carries the nonlinear self-inverse
;;; cancel (the pair-split generator, one law for all four swaps) and the
;;; three disjoint-order laws (2,0)/(3,0)/(3,1), descending spelled as
;;; the redex.  Committed budget is the fast smoke value; deep runs ride
;;; the swap-route-deep CI job (SWAP_DEEP:1, SWAP_BUDGET/SWAP_SCHED
;;; variables) on the PIO deep-probe pattern.
;;;
;;; RUN:
;;;   bin/shard_eval run tools/search/typed_superpose.shard \
;;;     tools/search/tasks/swap_route5.shard

(import "../../../kernel/stdlib.shard")
(import "swap_route5_model.shard")

;; Only explicit bare item uses become candidate heads: the list spine
;; and the four swaps are the declared alphabet.
(use (:: core List))
(use (:: core Nil))
(use (:: core Cons))
(use (:: tools search tasks swap_route5_model Swp5))
(use (:: tools search tasks swap_route5_model Sv0))
(use (:: tools search tasks swap_route5_model Sv1))
(use (:: tools search tasks swap_route5_model Sv2))
(use (:: tools search tasks swap_route5_model Sv3))
(use (:: tools search tasks swap_route5_model swr5_observe))
(use (:: tools search tasks swap_route5_model swr5_plug))
(use (:: tools search tasks swap_route5_model swr5_run_cancel_ctx))
(use (:: tools search tasks swap_route5_model swr5_run_order20_ctx))
(use (:: tools search tasks swap_route5_model swr5_run_order30_ctx))
(use (:: tools search tasks swap_route5_model swr5_run_order31_ctx))

(fn search_forms () (List Symbol) (list (quote ctor)))
(fn search_ints () (List Int) Nil)
(fn search_symbols () (List Symbol) Nil)
(fn search_depth () Int 11)

(fn search_result_mode () Symbol (quote first))
(fn search_narrowing_strategy () Symbol (quote theorem_first))
(fn search_drive_budget () Int 500)

(fn search_probe ((body (List Swp5))) (Option (List Int))
  (Some (swr5_observe body)))

(fn search_target () (List Int) (list 4 3 2 1 0))

;; The reduced word s0 s1 s0 s2 s1 s0 s3 s2 s1 s0 for the longest
;; element of S5 (redex-free under the declared laws).
(fn search_witness () (List Swp5)
  (list (Sv0) (Sv1) (Sv0) (Sv2) (Sv1) (Sv0) (Sv3) (Sv2) (Sv1) (Sv0)))

;; --- the checked window laws (probe level, plug context) -------------------

(claim swr5_cancel_spine
  (goal ((prefix (List Swp5)) (tail (List Swp5)) (s Swp5)) ()
    (=
      (search_probe (swr5_plug prefix (Cons s (Cons s tail))))
      (search_probe (swr5_plug prefix tail))))
  (steps
    ((unfold search_probe both)
     (unfold swr5_observe both)
     (rewrite (lemma swr5_run_cancel_ctx) lr lhs true ()))
    refl))

(claim swr5_order20_spine
  (goal ((prefix (List Swp5)) (tail (List Swp5))) ()
    (=
      (search_probe (swr5_plug prefix (Cons (Sv2) (Cons (Sv0) tail))))
      (search_probe (swr5_plug prefix (Cons (Sv0) (Cons (Sv2) tail))))))
  (steps
    ((unfold search_probe both)
     (unfold swr5_observe both)
     (rewrite (lemma swr5_run_order20_ctx) lr lhs true ()))
    refl))

(claim swr5_order30_spine
  (goal ((prefix (List Swp5)) (tail (List Swp5))) ()
    (=
      (search_probe (swr5_plug prefix (Cons (Sv3) (Cons (Sv0) tail))))
      (search_probe (swr5_plug prefix (Cons (Sv0) (Cons (Sv3) tail))))))
  (steps
    ((unfold search_probe both)
     (unfold swr5_observe both)
     (rewrite (lemma swr5_run_order30_ctx) lr lhs true ()))
    refl))

(claim swr5_order31_spine
  (goal ((prefix (List Swp5)) (tail (List Swp5))) ()
    (=
      (search_probe (swr5_plug prefix (Cons (Sv3) (Cons (Sv1) tail))))
      (search_probe (swr5_plug prefix (Cons (Sv1) (Cons (Sv3) tail))))))
  (steps
    ((unfold search_probe both)
     (unfold swr5_observe both)
     (rewrite (lemma swr5_run_order31_ctx) lr lhs true ()))
    refl))

;; --- the checked hooks -----------------------------------------------------

(fn search_observer_profile () (List Symbol) Nil)

(fn search_spine_context () Symbol (quote swr5_plug))

(fn search_spine_profile () (List Symbol)
  (list
    (quote swr5_cancel_spine)
    (quote swr5_order20_spine)
    (quote swr5_order30_spine)
    (quote swr5_order31_spine)))

;; The witness routes the start file to the reversal on the real semantics.
(claim swr5_witness_pin
  (goal () () (= (swr5_observe (search_witness)) (search_target)))
  (steps ((compute both)) refl))
