;;; PCB routing board model (the heuristic-tier problem statement): a
;;; single-layer 8x8 grid, cells addressed 0..63 as y*8+x, four rectilinear
;;; moves, occupancy as a plain cell list (keepouts + already-routed nets).
;;;
;;; THE BOUNDED WALK is the load-bearing design: pcb_walk checks the
;;; Manhattan floor against the remaining move budget BEFORE demanding the
;;; move list, so under the lazy engine an infeasible prefix dies without
;;; the next hole ever forking — an admissible lower bound expressed
;;; entirely in the observation, no engine feature.  Off-grid steps,
;;; occupied cells, and budget exhaustion each refuse with their OWN
;;; head (PWalkR) so the engine's refutation census can attribute
;;; kills; the goal check lives in the engine's want-match (want =
;;; (WalkAt goal)), which kills wrong-end walks at the Int field.
;;;
;;; THE SELF-AVOIDING WALK is the second load-bearing design (added after
;;; the pipeline-182 wander-tree measurement): the recursion threads the
;;; departed cell into the occupancy, so revisiting any earlier cell of
;;; the walk refuses exactly like an occupied cell and every accepted
;;; walk is a simple path.  No completeness is lost at any rung of the
;;; deepening ladder: the grid is bipartite, so loop-erasing a legal walk
;;; yields a legal simple path with the same endpoints, even-shorter
;;; length, and a subset of its cells — a depth-d EMPTY over simple paths
;;; refutes ALL walks of length <= d, and the shortest walk is already
;;; simple.  Never-reverse is subsumed (the previous cell is the newest
;;; occ entry), so effective branching is <= 3 before any smarter
;;; pruning.
;;;
;;; No theorem laws, deliberately: interior path rewrites (N.E = E.N) are
;;; unsound the moment occupancy makes the observation position-sensitive
;;; — the same structural fact that kept pio_dme_free's plan empty.  The
;;; search rides lazy semantic killing per net; multi-net coupling belongs
;;; to the rip-up driver (pcb_route_probe), not the exact engine.

(import "../../../kernel/stdlib.shard")

(use (:: core List))
(use (:: core Nil))
(use (:: core Cons))

(type PMove (MvN) (MvE) (MvS) (MvW))

(fn pcb_x ((c Int)) Int (mod c 8))

(fn pcb_y ((c Int)) Int (ediv c 8))

;; -1 = off the board; callers refuse negatives.
(fn pcb_step ((m PMove) (c Int)) Int
  (match m
    ((MvN) (if (lt (pcb_y c) 1) (- 0 1) (- c 8)))
    ((MvE) (if (lt (pcb_x c) 7) (+ c 1) (- 0 1)))
    ((MvS) (if (lt (pcb_y c) 7) (+ c 8) (- 0 1)))
    ((MvW) (if (lt (pcb_x c) 1) (- 0 1) (- c 1)))))

(fn pcb_mem ((c Int) (occ (List Int))) Bool
  (measure (struct occ))
  (match occ
    (Nil False)
    ((Cons h t) (if (int_eq h c) True (pcb_mem c t)))))

(fn pcb_abs ((n Int)) Int (if (lt n 0) (- 0 n) n))

(fn pcb_manhattan ((a Int) (b Int)) Int
  (+ (pcb_abs (- (pcb_x a) (pcb_x b))) (pcb_abs (- (pcb_y a) (pcb_y b)))))

;; The walk's result vocabulary IS the refutation-census attribution
;; channel: each refusal mode is its own head, and WalkBlocked carries
;; the blocking cell — computed strictly BEFORE the refusal, so the
;; engine's peek-don't-force census reads it without extra evaluation.
;; WalkFloor and WalkOff stay payload-free deliberately: the
;; admissible-pruning bulk buckets into single census rows.
(type PWalkR (WalkAt Int) (WalkBlocked Int) (WalkOff) (WalkFloor))

;; Bound first, then demand: a prefix whose Manhattan floor exceeds the
;; remaining budget refuses without forcing `moves`.  The recursion
;; threads the departed cell into occ — accepted walks are self-avoiding.
(fn pcb_walk
  ((occ (List Int)) (goal Int) (budget Int) (c Int) (moves (List PMove)))
  PWalkR
  (measure (struct moves))
  (if (lt budget (pcb_manhattan c goal)) (WalkFloor)
  (match moves
    (Nil (WalkAt c))
    ((Cons m rest)
     (let ((c2 (pcb_step m c)))
       (if (lt c2 0) (WalkOff)
       (if (pcb_mem c2 occ) (WalkBlocked c2)
       (pcb_walk (Cons c occ) goal (- budget 1) c2 rest))))))))

;; Visited cells of a route, start included (use on known-legal routes).
(fn pcb_cells ((c Int) (moves (List PMove))) (List Int)
  (measure (struct moves))
  (match moves
    (Nil (Cons c Nil))
    ((Cons m rest) (Cons c (pcb_cells (pcb_step m c) rest)))))

;; --- ground pins -----------------------------------------------------------

(claim pcb_walk_open_pin
  (goal () () (= (pcb_walk Nil 3 3 0 (list (MvE) (MvE) (MvE))) (WalkAt 3)))
  (steps ((compute both)) refl))

(claim pcb_walk_blocked_pin
  (goal () ()
    (= (pcb_walk (list 1) 3 3 0 (list (MvE) (MvE) (MvE))) (WalkBlocked 1)))
  (steps ((compute both)) refl))

(claim pcb_walk_offgrid_pin
  (goal () () (= (pcb_walk Nil 8 1 0 (list (MvN))) (WalkOff)))
  (steps ((compute both)) refl))

(claim pcb_walk_bound_pin
  (goal () () (= (pcb_walk Nil 7 2 0 Nil) (WalkFloor)))
  (steps ((compute both)) refl))

;; Revisit refusal: E then W steps back onto the start cell — under the
;; wander-tree model this reached the goal; self-avoidance refuses it,
;; and the census sees the blocking cell.
(claim pcb_walk_revisit_pin
  (goal () () (= (pcb_walk Nil 0 2 0 (list (MvE) (MvW))) (WalkBlocked 0)))
  (steps ((compute both)) refl))

(claim pcb_cells_pin
  (goal () () (= (pcb_cells 0 (list (MvE) (MvS))) (list 0 1 9)))
  (steps ((compute both)) refl))
