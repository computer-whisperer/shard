;;; PCB capacity instrument: NEGOTIATED CONGESTION (PathFinder-style)
;;; on the weighted-cost space-time model — the capacity rung's
;;; opening instance, and the toll input's first live consumer.
;;; Runtime is UNVALIDATED — it fires on CI only:
;;;   glab ci run -b more-search --variables ENGINE_RUN:1 \
;;;     --variables ENGINE_RUN_TARGET:tools/search/pcb_cap_probe.shard
;;;
;;; THE MECHANISM.  Nets are routed INDEPENDENTLY — no priority
;;; order, no hard occupancy between nets, no victim selection.  Each
;;; round routes every net with one A* cost query against the CURRENT
;;; toll list (occ = Nil: other nets are invisible except through
;;; prices); conflicts are then read off the trajectories at
;;; SPACE-TIME granularity (a shared st is a real conflict; the same
;;; cell at different ticks is legal time-sharing, not congestion),
;;; and every conflicted CELL's toll is inflated by the number of
;;; nets meeting there (+2 on a 2-net board).  History accumulates
;;; until the net with the cheaper alternative diverts on its own —
;;; where the rip-up driver picks a victim by census conviction,
;;; negotiation lets the COST STRUCTURE pick.  Pure history, updated
;;; between rounds (no present-sharing term; that and space-time
;;; tolls are the named follow-on knobs).  Zero model changes, zero
;;; engine changes: the toll list went into pcbc_mcost at rung B
;;; exactly for this, and h = cmove*manhattan stays admissible AND
;;; consistent under any nonnegative tolls (tolls only ADD).
;;;
;;; THE BOARD: rung B's two-gap 8x8, reused deliberately — near gap
;;; (4,3)=28, far gap (4,6)=52, keepouts {4,12,20,36,44,60}, nets
;;; A (1,3)->(6,3) and B (2,4)->(6,4), cmove=2 chold=5, so the
;;; negotiated outcome is directly comparable to the certified
;;; minima (MINCOST-A-10, MINCOST-B-16, pipeline 231).
;;;
;;; THE HAND-DERIVED STORY (every pop simulated against the heap
;;; law: f asc, g DESC, earlier push seq first; children pushed in
;;; alternative order Nil,E,N,S,H,W).
;;;   ROUND 1 (tolls empty): A pops its unconstrained optimum
;;;        [E,E,E,E,E] cost 10 (forks 6, dominated 0 — the monotone
;;;        f=10 chain outruns its Nil-children); B pops
;;;        [E,N,E,E,E,S] cost 12 (forks 7, dominated 2 — the two
;;;        f=8 Nil leftovers drain first).  B's route rides A's
;;;        row-3 corridor AT THE SAME TICKS: shared sts 155,220,
;;;        285,350 = cells 27,28,29,30 at t2..t5 — the packets are
;;;        superposed for four ticks.  SHARE n=4, tolls +2 each.
;;;   ROUND 2 (tolls 27/28/29/30 = 2): A's near family is FORCED
;;;        through all four tolled cells (28's only free neighbors
;;;        are 27 and 29; 30 is the goal) — straight = 18; its far
;;;        detour is 11 moves and still pays the goal toll = 24.
;;;        A repops [E,E,E,E,E] (true cost 10, unchanged).  B's
;;;        near best dodges 30 via 37 but still pays 27,28,29 = 18;
;;;        the far gap pays NO tolls = 16 < 18 — B diverts.  The
;;;        pop simulation gives the far witness [E,S,S,E,E,E,N,N]
;;;        (forks 20, dominated 22; the (6,6)-corner member — the
;;;        E-child beats the N-child at the g=12 tie by push seq),
;;;        every entry floor tight from budget 16.  Trajectories
;;;        disjoint: CONVERGED, ITERS-2.
;;; The prices discriminated by alternative cost — A stayed because
;;; its detour is dear, B moved because its detour is cheap — and
;;; nobody chose a victim.  The punchline the board reuse buys: the
;;; no-priority negotiated outcome lands EXACTLY on the per-priority
;;; minima rung B certified (A=10 via its bound-9 EMPTY, B=16 via
;;; its bound-15 EMPTY, exact + checked arms agreeing); the driver
;;; ASSERTS both numerically before printing.  That agreement is an
;;; instance consistency stamp, not a new optimality claim — the
;;; negotiated grade here is HEURISTIC EXISTENCE ONLY, certified by
;;; the rung B replay: cross-occupied cost walks at budget = claimed
;;; cost EXACTLY, costs re-derived from moves with tolls STRIPPED
;;; (negotiation tolls are search scaffolding, never the instance),
;;; duplicate-free st union.
;;;
;;; Expected trace (steps= measured; all else predicted exactly):
;;;   TAP 25->#1 ... ASTAR-FOUND ... forks=6 census[]
;;;   ROUTED-TAP 25 d=9 len=5
;;;   TAP 34->#1 ... ASTAR-FOUND ... forks=7 census[ sym:2 ]
;;;   ROUTED-TAP 34 d=9 len=6
;;;   SHARE n=4 cells[ 27 28 29 30 ]
;;;   TAP 25->#1 ... ASTAR-FOUND ... forks/dominated measured
;;;   ROUTED-TAP 25 d=9 len=5
;;;   TAP 34->#1 ... ASTAR-FOUND ... forks=20 census[ sym:22 ]
;;;   ROUTED-TAP 34 d=9 len=8
;;;   CONVERGED iters=2
;;;   PCB-CAP 8x8 KEEP-6 NETS-2 ITERS-2 TOLLED-4 COST-A-10
;;;   COST-B-16 MAKESPAN-8 CERT-DISJOINT-OK          (one line)
;;; (Round-2 A drains its whole f<18 detour band before the goal
;;; pops at f=18 — forks a few dozen, dominated > 0 via the
;;; [E,H]/[H,E] twin at (26,t2) among others; witness certain,
;;; counters measured.)
;;;
;;; No engine or model additions ride this rung (driver + instance
;;; only), so the second-consumer hygiene rule is not triggered; the
;;; general N-net negotiation loop is the scaling follow-on
;;; alongside the head-to-head vs the rip driver.
;;;
;;; RUN: fires on CI via ENGINE_RUN (see above) — never locally.

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/module.shard")
(import "../../kernel/reader.shard")
(import "../../kernel/loader.shard")
(import "../../kernel/driver.shard")
(import "../../meta/sketch")
(import "../../meta/rewrite")
(import "../../meta/search")
(import "superpose.shard")
(import "pcb_route_probe.shard")
(import "pcb_time_probe.shard")
(import "pcb_cost_probe.shard")
(import "tasks/pcb_route_model.shard")
(import "tasks/pcb_time_model.shard")
(import "tasks/pcb_cost_model.shard")
(use (:: kernel term *))
(use (:: kernel module *))
(use (:: kernel reader *))
(use (:: kernel loader *))
(use (:: kernel driver *))
(use (:: meta sketch *))
(use (:: meta rewrite *))
(use (:: meta search *))
(use (:: tools search superpose *))
(use (:: tools search pcb_route_probe *))
(use (:: tools search pcb_time_probe *))
(use (:: tools search pcb_cost_probe *))
(use (:: tools search tasks pcb_route_model *))
(use (:: tools search tasks pcb_time_model *))
(use (:: tools search tasks pcb_cost_model *))

;; ---- negotiation constants ------------------------------------------------
;; Board, nets, weights, dmax, caps: rung B's (pcbcp_*), reused.

(fn pcbcap_fuel () Int 4)

(fn pcbcap_fail ((msg (List Int)) (w World)) World
  (exit 1 (write (append_int "PCB-CAP FAIL " (append_int msg "\n")) w)))

;; ---- toll bookkeeping -----------------------------------------------------

;; One conflicted cell: +2 (the number of nets meeting there on this
;; 2-net board).  Insert-or-increment keeps one row per cell, so the
;; final list length is the TOLLED- count.
(fn pcbcap_bump1 ((tolls (List PToll)) (c Int)) (List PToll)
  (measure (struct tolls))
  (match tolls
    (Nil (Cons (PToll c 2) Nil))
    ((Cons h rest)
     (match h
       ((PToll tc tv)
        (if (int_eq tc c) (Cons (PToll tc (+ tv 2)) rest)
        (Cons h (pcbcap_bump1 rest c))))))))

(fn pcbcap_bump_cells ((tolls (List PToll)) (cells (List Int))) (List PToll)
  (measure (struct cells))
  (match cells
    (Nil tolls)
    ((Cons c rest) (pcbcap_bump_cells (pcbcap_bump1 tolls c) rest))))

(fn pcbcap_tolls_len ((tolls (List PToll))) Int
  (measure (struct tolls))
  (match tolls
    (Nil 0)
    ((Cons _ rest) (+ 1 (pcbcap_tolls_len rest)))))

;; ---- conflict extraction --------------------------------------------------

;; Space-time conflicts: the sts present in BOTH trajectories.
(fn pcbcap_shared ((a (List Int)) (b (List Int))) (List Int)
  (measure (struct a))
  (match a
    (Nil Nil)
    ((Cons h rest)
     (if (pcb_mem h b) (Cons h (pcbcap_shared rest b)) (pcbcap_shared rest b)))))

;; Conflicted sts -> distinct spatial cells (first-seen order kept).
(fn pcbcap_cells ((sts (List Int))) (List Int)
  (measure (struct sts))
  (match sts
    (Nil Nil)
    ((Cons st rest)
     (let ((c (mod st (* (pcbcp_wd) (pcbcp_ht)))))
       (let ((cs (pcbcap_cells rest))) (if (pcb_mem c cs) cs (Cons c cs)))))))

;; ---- toll-parametric query and score --------------------------------------
;; occ = Nil ALWAYS: negotiation replaces hard occupancy with prices.

(fn pcbcap_tolls_expr ((tolls (List PToll))) Expr
  (measure (struct tolls))
  (match tolls
    (Nil (Ctor (qn (quote Nil)) Nil))
    ((Cons h rest)
     (match h
       ((PToll tc tv)
        (Ctor
          (qn (quote Cons))
          (list
            (Ctor (pcbcp_model_q (quote PToll)) (list (IntLit tc) (IntLit tv)))
            (pcbcap_tolls_expr rest))))))))

(fn pcbcap_query ((tolls (List PToll)) (goal Int) (start Int)) Expr
  (Call
    (pcbcp_model_q (quote pcbc_walk_from))
    (list
      (IntLit (pcbcp_wd))
      (IntLit (pcbcp_ht))
      (pcbcp_nil_expr)
      (pcbp_int_list_expr (pcbcp_keepouts))
      (pcbcap_tolls_expr tolls)
      (IntLit goal)
      (IntLit (pcbcp_cmove))
      (IntLit (pcbcp_chold))
      (IntLit (pcbcp_free_bud))
      (IntLit start)
      (hole 0))))

(fn pcbcap_score_t ((tolls (List PToll)) (goal Int) (start Int)) Expr
  (Call
    (pcbcp_model_q (quote pcbc_score))
    (list
      (IntLit (pcbcp_wd))
      (IntLit (pcbcp_ht))
      (pcbcp_nil_expr)
      (pcbp_int_list_expr (pcbcp_keepouts))
      (pcbcap_tolls_expr tolls)
      (IntLit goal)
      (IntLit (pcbcp_cmove))
      (IntLit (pcbcp_chold))
      (IntLit (pcbcp_free_bud))
      (IntLit start)
      (hole 0))))

;; ---- one negotiation route (plain astar entry: heuristic find) ------------

(fn pcbcap_route
  ((m Module) (tolls (List PToll)) (start Int) (goal Int) (w World))
  (Pair (Option (List PTMove)) World)
  (match
    (su_find_query_schema_astar
      1000000
      (pcbcp_find_cap)
      m
      (pcbp_probe_q (quote candidate))
      (hole 0)
      (hole 0)
      (ms_empty_plan)
      (pcbcap_query tolls goal start)
      (pcbp_want)
      (pcbt_grammar_a (pcbcp_find_dmax) (pcbt_move_order start goal))
      (pcbcap_score_t tolls goal start)
      (pcbcp_nil_expr))
    ((SuFindErr msg) (Pair None (write (append_int "ASTAR-ERR " msg) w)))
    ((SuFindEmpty _ _ _ forks _ steps _ _ census)
     (Pair
       None
       (pcbp_log_call
         start
         1
         (pcbcp_find_dmax)
         (pcbcp_find_cap)
         "ASTAR-EMPTY"
         steps
         forks
         census
         w)))
    ((SuFindBudget _ _ _ forks _ steps _ _ census)
     (Pair
       None
       (pcbp_log_call
         start
         1
         (pcbcp_find_dmax)
         (pcbcp_find_cap)
         "ASTAR-BUDGET"
         steps
         forks
         census
         w)))
    ((SuFindFound _ _ _ forks _ steps _ rep census)
     (let
       ((w2
          (pcbp_log_call
            start
            1
            (pcbcp_find_dmax)
            (pcbcp_find_cap)
            "ASTAR-FOUND"
            steps
            forks
            census
            w)))
       (match (pcbt_decode rep)
         (None (Pair None (write "ASTAR-ERR undecodable representative\n" w2)))
         ((Some moves)
          (Pair
            (Some moves)
            (pcbp_log_routed start (pcbcp_find_dmax) (pcbt_len_moves moves) w2))))))))

;; ---- negotiation logging --------------------------------------------------

(fn pcbcap_ints_str ((xs (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil "")
    ((Cons h rest)
     (append_int " " (append_int (show_int h) (pcbcap_ints_str rest))))))

(fn pcbcap_log_share ((cells (List Int)) (w World)) World
  (write
    (append_int
      "SHARE n="
      (append_int
        (show_int (pcbp_len_ints cells))
        (append_int " cells[" (append_int (pcbcap_ints_str cells) " ]\n"))))
    w))

(fn pcbcap_log_conv ((iters Int) (w World)) World
  (write (append_int "CONVERGED iters=" (append_int (show_int iters) "\n")) w))

;; ---- the negotiation loop -------------------------------------------------

(type PcbCapR
  (PcbCapErr (List Int))
  (PcbCapOk (List PTMove) (List PTMove) Int Int))

(fn pcbcap_negotiate
  ((m Module) (tolls (List PToll)) (iter Int) (fuel Int) (w World))
  (Pair PcbCapR World)
  (measure fuel)
  (if (lt fuel 1) (Pair (PcbCapErr "negotiation fuel exhausted") w)
  (match (pcbcap_route m tolls (pcbcp_a_start) (pcbcp_a_goal) w)
    ((Pair None w1) (Pair (PcbCapErr "net A unrouted under negotiation") w1))
    ((Pair (Some ma) w1)
     (match (pcbcap_route m tolls (pcbcp_b_start) (pcbcp_b_goal) w1)
       ((Pair None w2) (Pair (PcbCapErr "net B unrouted under negotiation") w2))
       ((Pair (Some mb) w2)
        (let ((ta (pcbt_traj (pcbcp_wd) (pcbcp_ht) (pcbcp_a_start) 0 ma)))
          (let ((tb (pcbt_traj (pcbcp_wd) (pcbcp_ht) (pcbcp_b_start) 0 mb)))
            (match (pcbcap_shared ta tb)
              (Nil
                (Pair
                  (PcbCapOk ma mb iter (pcbcap_tolls_len tolls))
                  (pcbcap_log_conv iter w2)))
              ((Cons s srest)
               (let ((cells (pcbcap_cells (Cons s srest))))
                 (pcbcap_negotiate
                   m
                   (pcbcap_bump_cells tolls cells)
                   (+ iter 1)
                   (- fuel 1)
                   (pcbcap_log_share cells w2)))))))))))))

;; ---- the report -----------------------------------------------------------

(fn pcbcap_report
  ((ma (List PTMove)) (mb (List PTMove)) (iters Int) (tolled Int) (w World))
  World
  (write
    (append_int
      "PCB-CAP 8x8 KEEP-6 NETS-2 ITERS-"
      (append_int
        (show_int iters)
        (append_int
          " TOLLED-"
          (append_int
            (show_int tolled)
            (append_int
              " COST-A-"
              (append_int
                (show_int (pcbcp_cost_of (pcbcp_a_start) ma))
                (append_int
                  " COST-B-"
                  (append_int
                    (show_int (pcbcp_cost_of (pcbcp_b_start) mb))
                    (append_int
                      " MAKESPAN-"
                      (append_int
                        (show_int
                          (pcbt_max2 (pcbt_len_moves ma) (pcbt_len_moves mb)))
                        " CERT-DISJOINT-OK\n"))))))))))
    w))

;; ---- the driver -----------------------------------------------------------
;; The negotiated costs must land exactly on rung B's certified
;; minima (bound + 1) — a drifted instance fails loudly instead of
;; printing a stale agreement; then the rung B certificate replays
;; both routes cross-occupied at those costs exactly, tolls stripped.

(fn pcbcap_run ((m Module) (w World)) World
  (match (pcbcap_negotiate m Nil 1 (pcbcap_fuel) w)
    ((Pair (PcbCapErr msg) w1) (pcbcap_fail msg w1))
    ((Pair (PcbCapOk ma mb iters tolled) w1)
     (if (int_eq (pcbcp_cost_of (pcbcp_a_start) ma) (+ (pcbcp_a_bound) 1))
       (if (int_eq (pcbcp_cost_of (pcbcp_b_start) mb) (+ (pcbcp_b_bound) 1))
         (if (pcbcp_cert_cost ma (+ (pcbcp_a_bound) 1) mb (+ (pcbcp_b_bound) 1))
           (pcbcap_report ma mb iters tolled w1)
           (pcbcap_fail "cost certificate rejected" w1))
         (pcbcap_fail "B negotiated cost is not the certified minimum" w1))
       (pcbcap_fail "A negotiated cost is not the certified minimum" w1)))))

(fn main ((w World)) World
  (match (pcbcp_load w)
    ((Pair (PcbpLoadErr msg) w1) (pcbcap_fail msg w1))
    ((Pair (PcbpLoadOk m) w1) (pcbcap_run m w1))))

;; ---- instance pins (the hand-derived story, checked) ----------------------

;; Toll bookkeeping: insert-then-increment, one row per cell.
(claim pcbcap_bump_new_pin
  (goal () ()
    (= (pcbcap_bump_cells Nil (list 27 28)) (list (PToll 27 2) (PToll 28 2))))
  (steps ((compute both)) refl))

(claim pcbcap_bump_inc_pin
  (goal () () (= (pcbcap_bump1 (list (PToll 27 2)) 27) (list (PToll 27 4))))
  (steps ((compute both)) refl))

;; ROUND 1: B's unconstrained optimum [E,N,E,E,E,S] is legal at
;; budget 12 exactly on the empty board...
(claim pcbcap_b1_route_pin
  (goal () ()
    (=
      (pcbc_walk_from
        8
        8
        Nil
        (pcbcp_keepouts)
        Nil
        38
        2
        5
        12
        34
        (list (TmE) (TmN) (TmE) (TmE) (TmE) (TmS)))
      (WalkDone)))
  (steps ((compute both)) refl))

;; ...but AGAINST A's trajectory it is refused at A's transit — what
;; priority routing forbids, negotiation prices instead.
(claim pcbcap_b1_conflict_pin
  (goal () ()
    (=
      (pcbc_walk_from
        8
        8
        (list 25 90 155 220 285 350)
        (pcbcp_keepouts)
        Nil
        38
        2
        5
        12
        34
        (list (TmE) (TmN) (TmE) (TmE) (TmE) (TmS)))
      (WalkBlocked 155)))
  (steps ((compute both)) refl))

;; The round-1 conflict set: B rides A's corridor at the same ticks —
;; four shared space-time cells...
(claim pcbcap_shared_pin
  (goal () ()
    (=
      (pcbcap_shared
        (pcbt_traj 8 8 25 0 (list (TmE) (TmE) (TmE) (TmE) (TmE)))
        (pcbt_traj 8 8 34 0 (list (TmE) (TmN) (TmE) (TmE) (TmE) (TmS))))
      (list 155 220 285 350)))
  (steps ((compute both)) refl))

;; ...mapping to the four corridor cells, each tolled +2.
(claim pcbcap_cells_pin
  (goal () () (= (pcbcap_cells (list 155 220 285 350)) (list 27 28 29 30)))
  (steps ((compute both)) refl))

;; ROUND 2 pricing, B: the near witness now pays all four tolls (20),
;; its best near dodge still pays 27/28/29 (18), and the far family
;; pays none (16) — the price ladder that makes B divert.
(claim pcbcap_b2_near_pin
  (goal () ()
    (=
      (pcbc_cost_of
        8
        8
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        2
        5
        34
        (list (TmE) (TmN) (TmE) (TmE) (TmE) (TmS)))
      20))
  (steps ((compute both)) refl))

(claim pcbcap_b2_dodge_pin
  (goal () ()
    (=
      (pcbc_cost_of
        8
        8
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        2
        5
        34
        (list (TmE) (TmN) (TmE) (TmE) (TmS) (TmE)))
      18))
  (steps ((compute both)) refl))

(claim pcbcap_b2_far_toll_free_pin
  (goal () ()
    (=
      (pcbc_cost_of
        8
        8
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        2
        5
        34
        (list (TmE) (TmS) (TmS) (TmE) (TmE) (TmE) (TmN) (TmN)))
      16))
  (steps ((compute both)) refl))

;; ROUND 2 pricing, A: forced through all four tolled cells near
;; (18); the far detour still pays the unavoidable goal toll (24) —
;; A stays.
(claim pcbcap_a2_near_pin
  (goal () ()
    (=
      (pcbc_cost_of
        8
        8
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        2
        5
        25
        (list (TmE) (TmE) (TmE) (TmE) (TmE)))
      18))
  (steps ((compute both)) refl))

(claim pcbcap_a2_far_pin
  (goal () ()
    (=
      (pcbc_cost_of
        8
        8
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        2
        5
        25
        (list (TmS) (TmS) (TmS) (TmE) (TmE) (TmE) (TmE) (TmE) (TmN) (TmN) (TmN)))
      24))
  (steps ((compute both)) refl))

;; The toll lands inside the A* g: B's [E,N] prefix under round-2
;; tolls scores g=6 (2 + 2+toll 2), keyed at (3,3)@t2 = st 155.
(claim pcbcap_score_toll_pin
  (goal () ()
    (=
      (pcbc_score
        8
        8
        Nil
        (pcbcp_keepouts)
        (list (PToll 27 2) (PToll 28 2) (PToll 29 2) (PToll 30 2))
        38
        2
        5
        1000000
        34
        (list (TmE) (TmN)))
      (PScore 6 8 (Some (list 155)))))
  (steps ((compute both)) refl))

;; B's round-2 far witness [E,S,S,E,E,E,N,N] is legal at budget 16
;; exactly (every entry floor tight)...
(claim pcbcap_b2_witness_pin
  (goal () ()
    (=
      (pcbc_walk_from
        8
        8
        Nil
        (pcbcp_keepouts)
        Nil
        38
        2
        5
        16
        34
        (list (TmE) (TmS) (TmS) (TmE) (TmE) (TmE) (TmN) (TmN)))
      (WalkDone)))
  (steps ((compute both)) refl))

;; ...and its trajectory shares no space-time cell with A's:
;; convergence, read off the same extractor the loop uses.
(claim pcbcap_conv_pin
  (goal () ()
    (=
      (pcbcap_shared
        (pcbt_traj 8 8 25 0 (list (TmE) (TmE) (TmE) (TmE) (TmE)))
        (pcbt_traj
          8
          8
          34
          0
          (list (TmE) (TmS) (TmS) (TmE) (TmE) (TmE) (TmN) (TmN))))
      Nil))
  (steps ((compute both)) refl))

(claim pcbcap_disjoint_pin
  (goal () ()
    (=
      (pcbp_dup_free
        (pcbp_app_cells
          (pcbt_traj 8 8 25 0 (list (TmE) (TmE) (TmE) (TmE) (TmE)))
          (pcbt_traj
            8
            8
            34
            0
            (list (TmE) (TmS) (TmS) (TmE) (TmE) (TmE) (TmN) (TmN)))))
      True))
  (steps ((compute both)) refl))
