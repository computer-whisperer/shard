        Nil
        38
        2
        5
        16
        34
        (list (TmS) (TmS) (TmE) (TmE) (TmE) (TmN) (TmN) (TmE)))
      (WalkDone)))
  (steps ((compute both)) refl))

;; ...and backtracking one tick behind A through the near gap.
