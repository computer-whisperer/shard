;; The fast pair shares no space-time cell (the convoy, one behind).
(claim pcbcp_disjoint_fast_pin
  (goal () ()
    (=
      (pcbp_dup_free
        (pcbp_app_cells
          (pcbt_traj 8 8 25 0 (list (TmE) (TmE) (TmE) (TmE) (TmE)))
          (pcbt_traj 8 8 34 0 (list (TmE) (TmH) (TmN) (TmE) (TmE) (TmE) (TmS)))))
      True))
  (steps ((compute both)) refl))

;; So does the cheap pair (far family shown).
(claim pcbcp_disjoint_cheap_pin
  (goal () ()
    (=
