;; THE DOMINATED TWIN: [E,H] and [H,E] both end at (3,4)@t2 = st 163,
;; live at g=7 under budget 15 — identical keys, so the checked
;; bound's frontier MUST merge one (dominated>0 guaranteed by hand).
(claim pcbcp_dom_twin1_pin
  (goal () ()
    (=
      (pcbc_score
        8
        8
        (list 25 90 155 220 285 350)
        (pcbcp_keepouts)
        Nil
        38
        2
        5
        15
        34
        (list (TmE) (TmH)))
      (PScore 7 6 (Some (list 163)))))
  (steps ((compute both)) refl))

(claim pcbcp_dom_twin2_pin
