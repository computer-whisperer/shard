;;; Regression for exact restricted Grammar regions.
;;;
;;; A two-hole, three-choice product has nine derivations. Subtracting the
;;; choice cube h0=1,h1=2 must retain the hit as one original-id region and
;;; return the disjoint complement h0!=1 | (h0=1,h1!=2), with counts 1 + 6 + 2.

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/loader.shard")
(import "../../meta/sketch")
(use (:: kernel term *))
(use (:: kernel loader World))
(use (:: kernel loader write))
(use (:: kernel loader exit))
(use (:: meta sketch *))

(fn srp_q ((name Symbol)) QName
  (QName (list (quote tools) (quote search) (quote region_probe)) name))

(fn srp_atom ((value Int)) Expr
  (Ctor (srp_q (quote Atom)) (Cons (IntLit value) Nil)))

(fn srp_pair ((left Expr) (right Expr)) Expr
  (Ctor (srp_q (quote Pair)) (list left right)))

(fn srp_grammar () Grammar
  (Grammar
    (list
      (GEnt 0 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 1 (list (srp_atom 0) (srp_atom 1) (srp_atom 2))))))

(fn srp_nested_grammar () Grammar
  (Grammar
    (list
      (GEnt
        0
        (list (srp_atom 0) (Ctor (srp_q (quote Wrap)) (Cons (hole 1) Nil))))
      (GEnt 1 (list (srp_atom 0) (srp_atom 1) (srp_atom 2))))))

(fn srp_barren_grammar () Grammar
  (Grammar
    (list
      (GEnt
        0
        (list (Ctor (srp_q (quote Dead)) (Cons (hole 1) Nil)) (srp_atom 9)))
      (GEnt 1 Nil))))

(fn srp_schema_grammar () SkSchemaGrammar
  (SkSchemaGrammar
    0
    (list
      (SkSchemaEnt
        0
        (list
          (SkSchemaAlt
            (srp_pair (hole 0) (hole 1))
            (list (SkSchemaRef 0 0 1) (SkSchemaRef 1 1 1)))))
      (SkSchemaEnt
        1
        (list (SkSchemaAlt (srp_atom 0) Nil) (SkSchemaAlt (srp_atom 1) Nil))))))

(fn srp_fail ((msg (List Int)) (w World)) World
  (exit 1 (write (append_int "REGION-PROBE FAIL " (append_int msg "\n")) w)))

(fn srp_count ((root Expr) (grammar Grammar) (region SkRegion)) (Option Int)
  (match (sk_region_count root grammar region)
    ((SkCErr _) None)
    ((SkCOk count) (Some count))))

(fn srp_sum_regions
  ((root Expr) (grammar Grammar) (regions (List SkRegion)) (acc Int))
  (Option Int)
  (measure (struct regions))
  (match regions
    (Nil (Some acc))
    ((Cons region rest)
     (match (srp_count root grammar region)
       (None None)
       ((Some count) (srp_sum_regions root grammar rest (+ acc count)))))))

(fn srp_complement_shape ((regions (List SkRegion))) Bool
  (match regions
    ((Cons first (Cons second Nil))
     (if (skr_forbidden 0 1 first)
       (match (skr_choice 0 first)
         ((Some _) False)
         (None
           (match (skr_choice 0 second)
             ((Some choice)
              (if (int_eq choice 1) (skr_forbidden 1 2 second) False))
             (None False))))
       False))
    (_ False)))

(fn srp_addressing ((root Expr) (grammar Grammar) (region SkRegion) (w World))
  World
  (match (sk_region_forbid grammar region 0 1)
    ((SkRegionEditErr msg) (srp_fail msg w))
    ((SkRegionEditEmpty) (srp_fail "addressing exclusion was empty" w))
    ((SkRegionEditOk without_middle)
     (match (sk_region_choose grammar without_middle 1 2)
       ((SkRegionEditErr msg) (srp_fail msg w))
       ((SkRegionEditEmpty) (srp_fail "addressing choice was empty" w))
       ((SkRegionEditOk addressed)
        (match (sk_region_first root grammar addressed)
          ((SkEErr msg) (srp_fail msg w))
          ((SkEOk first_direct)
           (match (sk_region_unrank root grammar addressed 0)
             ((SkEErr msg) (srp_fail msg w))
             ((SkEOk first)
              (match (sk_region_unrank root grammar addressed 1)
                ((SkEErr msg) (srp_fail msg w))
                ((SkEOk second)
                 (let
                   ((want_first (srp_pair (srp_atom 0) (srp_atom 2)))
                    (want_second (srp_pair (srp_atom 2) (srp_atom 2)))
                    (excluded (srp_pair (srp_atom 1) (srp_atom 2))))
                   (if (expr_eq first_direct want_first)
                     (if (expr_eq first want_first)
                       (if (expr_eq second want_second)
                         (match (sk_region_rank root grammar addressed second)
                           ((SkCErr msg) (srp_fail msg w))
                           ((SkCOk rank)
                            (if (int_eq rank 1)
                              (if
                                (sk_region_member root grammar addressed first)
                                (if
                                  (sk_region_member root grammar addressed
                                    excluded)
                                  (srp_fail
                                    "excluded candidate remained a member"
                                    w)
                                  (srp_nested w))
                                (srp_fail
                                  "unranked candidate was not a member"
                                  w))
                              (srp_fail
                                "restricted rank did not invert unrank"
                                w))))
                         (srp_fail "restricted unrank second candidate" w))
                       (srp_fail "restricted unrank first candidate" w))
                     (srp_fail "cardinality-free first candidate" w))))))))))))))

(fn srp_nested ((w World)) World
  (let ((grammar (srp_nested_grammar)) (root (hole 0)))
    (match (sk_region_forbid grammar (sk_empty_region) 1 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "nested child exclusion was empty" w))
      ((SkRegionEditOk restricted)
       (match (srp_count root grammar restricted)
         ((Some count)
          (if (int_eq count 3)
            (match (sk_region_choose grammar restricted 0 1)
              ((SkRegionEditErr msg) (srp_fail msg w))
              ((SkRegionEditEmpty)
               (srp_fail "nested parent choice was empty" w))
              ((SkRegionEditOk wrapped)
               (match (srp_count root grammar wrapped)
                 ((Some wrapped_count)
                  (if (int_eq wrapped_count 2)
                    (match (sk_region_first root grammar wrapped)
                      ((SkEErr msg) (srp_fail msg w))
                      ((SkEOk first)
                       (if
                         (expr_eq
                           first
                           (Ctor (srp_q (quote Wrap)) (Cons (srp_atom 0) Nil)))
                         (srp_barren w)
                         (srp_fail "nested cardinality-free first" w))))
                    (srp_fail "nested selected count" w)))
                 (None (srp_fail "nested selected region count" w)))))
            (srp_fail "nested restricted count" w)))
         (None (srp_fail "nested region count" w)))))))

(fn srp_barren ((w World)) World
  (let ((grammar (srp_barren_grammar)) (root (hole 0)))
    (match (sk_region_first root grammar (sk_empty_region))
      ((SkEErr msg) (srp_fail msg w))
      ((SkEOk first)
       (if (expr_eq first (srp_atom 9)) (srp_schema w)
       (srp_fail "first selected a barren production" w))))))

(fn srp_schema ((w World)) World
  (let ((grammar (srp_schema_grammar)))
    (match (sk_schema_wf grammar)
      ((SkSchemaWfErr msg) (srp_fail msg w))
      ((SkSchemaWfOk)
       (match (sk_schema_alts_at grammar 0)
         ((SkSchemaAltsErr msg) (srp_fail msg w))
         ((SkSchemaAltsOk root_alts)
          (match root_alts
            ((Cons root Nil)
             (if (expr_eq root (srp_pair (hole 1) (hole 2)))
               (match (sk_schema_alts_at grammar 1)
                 ((SkSchemaAltsErr msg) (srp_fail msg w))
                 ((SkSchemaAltsOk left_alts)
                  (match (sk_schema_alts_at grammar 2)
                    ((SkSchemaAltsErr msg) (srp_fail msg w))
                    ((SkSchemaAltsOk right_alts)
                     (if
                       (if (srp_exprs_eq left_alts right_alts)
                         (sk_schema_alt_productive_at
                           grammar
                           (sk_schema_productivity grammar)
                           0
                           0)
                         False)
                       (srp2_eq
                         (write
                           "REGION-PROBE RAW-9 HIT-1 COMPLEMENT-6+2 EMPTY-0 ADDRESSABLE FIRST NESTED-4>3>2 PRODUCTIVE ORIGINAL-IDS SCHEMA-SHARED-POLICY-INDEPENDENT-OCCURRENCES OK\n"
                           w))
                       (srp_fail "schema child policy/productivity drift" w))))))
               (srp_fail "schema occurrences were not structurally distinct" w)))
            (_ (srp_fail "schema root alternative shape" w)))))))))

(fn srp_exprs_eq ((left (List Expr)) (right (List Expr))) Bool
  (measure (struct left))
  (match left
    (Nil
      (match right
        (Nil True)
        ((Cons _ _) False)))
    ((Cons x xs)
     (match right
       (Nil False)
       ((Cons y ys) (if (expr_eq x y) (srp_exprs_eq xs ys) False))))))

(fn srp_empty_exclusion
  ((root Expr) (grammar Grammar) (region SkRegion) (w World))
  World
  (match (sk_region_forbid grammar region 0 0)
    ((SkRegionEditErr msg) (srp_fail msg w))
    ((SkRegionEditEmpty) (srp_fail "first exclusion was empty" w))
    ((SkRegionEditOk r1)
     (match (sk_region_forbid grammar r1 0 1)
       ((SkRegionEditErr msg) (srp_fail msg w))
       ((SkRegionEditEmpty) (srp_fail "second exclusion was empty" w))
       ((SkRegionEditOk r2)
        (match (sk_region_forbid grammar r2 0 2)
          ((SkRegionEditErr msg) (srp_fail msg w))
          ((SkRegionEditEmpty) (srp_fail "third exclusion was empty" w))
          ((SkRegionEditOk empty)
           (match (srp_count root grammar empty)
             ((Some count)
              (if (int_eq count 0) (srp_addressing root grammar region w)
              (srp_fail "all choices excluded but count was nonzero" w)))
             (None (srp_fail "empty-region count" w))))))))))

(fn srp_run ((root Expr) (grammar Grammar) (w World)) World
  (let ((whole (sk_empty_region)))
    (match (srp_count root grammar whole)
      ((Some raw)
       (if (int_eq raw 9)
         (match
           (sk_region_subtract_cube grammar whole (list (Pair 0 1) (Pair 1 2)))
           ((SkRegionSubtractErr msg) (srp_fail msg w))
           ((SkRegionSubtractOk hit complement)
            (match hit
              (None (srp_fail "choice cube had no hit" w))
              ((Some hit_region)
               (match (srp_count root grammar hit_region)
                 ((Some hit_count)
                  (if (int_eq hit_count 1)
                    (if (srp_complement_shape complement)
                      (match (srp_sum_regions root grammar complement 0)
                        ((Some kept)
                         (if (int_eq kept 8)
                           (srp_empty_exclusion root grammar whole w)
                           (srp_fail "complement count" w)))
                        (None (srp_fail "complement region count" w)))
                      (srp_fail
                        "complement was not the disjoint prefix split"
                        w))
                    (srp_fail "cube hit count" w)))
                 (None (srp_fail "cube hit region count" w)))))))
         (srp_fail "raw region count" w)))
      (None (srp_fail "raw count" w)))))

(fn main ((w World)) World
  (let ((grammar (srp_grammar)) (root (srp_pair (hole 0) (hole 1))))
    (match (g_wf grammar)
      ((GWErr msg) (srp_fail msg w))
      ((GWOk) (srp_run root grammar w)))))

;; ---- relation-aware regions (SEARCH.md arc opener, R1) ---------------------
;;
;; Hand-computed pins over the same 3-atom product and a deep (Atom | Wrap)
;; domain: the diagonal is ONE region of 3, its complement ONE region of 6,
;; the 3-clique counts 3! = 6 through inclusion-exclusion, deep eq counts the
;; 4-member diagonal, tuple-ne descends when both sides fix the same deep
;; alternative, eq fixes its partner, a last closed-template ne pair converts
;; to a forbid, split partitions 9 = 3 + 6, release restores by policy, and
;; every v1 boundary refuses loudly (liveness, closure overlap, the ne-event
;; cap, non-isomorphic domains, rank addressing).

(fn srp2_root () Expr (srp_pair (hole 0) (hole 1)))

(fn srp2_eq ((w World)) World
  (let ((grammar (srp_grammar)))
    (match (sk_region_relate_eq grammar (sk_empty_region) 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "eq relate was empty" w))
      ((SkRegionEditOk region)
       (match (srp_count (srp2_root) grammar region)
         (None (srp_fail "eq count" w))
         ((Some count)
          (if (int_eq count 3)
            (if
              (sk_region_member
                (srp2_root)
                grammar
                region
                (srp_pair (srp_atom 0) (srp_atom 0)))
              (if
                (sk_region_member
                  (srp2_root)
                  grammar
                  region
                  (srp_pair (srp_atom 0) (srp_atom 1)))
                (srp_fail "eq member accepted a differing pair" w)
                (match (sk_region_first (srp2_root) grammar region)
                  ((SkEErr msg) (srp_fail msg w))
                  ((SkEOk first)
                   (if (expr_eq first (srp_pair (srp_atom 0) (srp_atom 0)))
                     (match
                       (sk_region_rank
                         (srp2_root)
                         grammar
                         region
                         (srp_pair (srp_atom 0) (srp_atom 0)))
                       ((SkCErr _) (srp2_ne w))
                       ((SkCOk _) (srp_fail "relational rank did not refuse" w)))
                     (srp_fail "eq first representative" w)))))
              (srp_fail "eq member rejected the diagonal" w))
            (srp_fail "eq count value" w))))))))

(fn srp2_ne ((w World)) World
  (let ((grammar (srp_grammar)))
    (match (sk_region_relate_ne grammar (sk_empty_region) 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "ne relate was empty" w))
      ((SkRegionEditOk region)
       (match (srp_count (srp2_root) grammar region)
         (None (srp_fail "ne count" w))
         ((Some count)
          (if (int_eq count 6)
            (if
              (sk_region_member
                (srp2_root)
                grammar
                region
                (srp_pair (srp_atom 0) (srp_atom 1)))
              (if
                (sk_region_member
                  (srp2_root)
                  grammar
                  region
                  (srp_pair (srp_atom 1) (srp_atom 1)))
                (srp_fail "ne member accepted the diagonal" w)
                (match (sk_region_first (srp2_root) grammar region)
                  ((SkEErr msg) (srp_fail msg w))
                  ((SkEOk first)
                   (if (expr_eq first (srp_pair (srp_atom 0) (srp_atom 1)))
                     (match (sk_region_unrank (srp2_root) grammar region 0)
                       ((SkEErr _) (srp2_prop region w))
                       ((SkEOk _)
                        (srp_fail "relational unrank did not refuse" w)))
                     (srp_fail "ne first representative" w)))))
              (srp_fail "ne member rejected a differing pair" w))
            (srp_fail "ne count value" w))))))))

;; eq propagation: fixing one side fixes the partner and discharges the event.
(fn srp2_prop ((ne_region SkRegion) (w World)) World
  (let ((grammar (srp_grammar)))
    (match (sk_region_relate_eq grammar (sk_empty_region) 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "prop relate was empty" w))
      ((SkRegionEditOk eq_region)
       (match (sk_region_choose grammar eq_region 0 2)
         ((SkRegionEditErr msg) (srp_fail msg w))
         ((SkRegionEditEmpty) (srp_fail "prop choose was empty" w))
         ((SkRegionEditOk chosen)
          (match (sk_region_norm grammar chosen)
            ((SkRegionEditErr msg) (srp_fail msg w))
            ((SkRegionEditEmpty) (srp_fail "prop norm was empty" w))
            ((SkRegionEditOk normed)
             (match (skr_choice 1 normed)
               (None (srp_fail "eq did not fix its partner" w))
               ((Some partner)
                (if (int_eq partner 2)
                  (match (sk_region_rels normed)
                    (Nil
                      (match (srp_count (srp2_root) grammar normed)
                        (None (srp_fail "prop count" w))
                        ((Some count)
                         (if (int_eq count 1) (srp2_forbid ne_region w)
                         (srp_fail "prop count value" w)))))
                    ((Cons _ _) (srp_fail "discharged eq event survived" w)))
                  (srp_fail "eq fixed the wrong partner choice" w))))))))))))

;; the last ne pair against a fixed CLOSED template becomes a forbid.
(fn srp2_forbid ((ne_region SkRegion) (w World)) World
  (let ((grammar (srp_grammar)))
    (match (sk_region_choose grammar ne_region 0 0)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "forbid choose was empty" w))
      ((SkRegionEditOk chosen)
       (match (sk_region_norm grammar chosen)
         ((SkRegionEditErr msg) (srp_fail msg w))
         ((SkRegionEditEmpty) (srp_fail "forbid norm was empty" w))
         ((SkRegionEditOk normed)
          (match (sk_region_rels normed)
            ((Cons _ _) (srp_fail "closed-template ne event survived" w))
            (Nil
              (if (skr_forbidden 1 0 normed)
                (match (srp_count (srp2_root) grammar normed)
                  (None (srp_fail "forbid count" w))
                  ((Some count)
                   (if (int_eq count 2) (srp2_release chosen w)
                   (srp_fail "forbid count value" w))))
                (srp_fail "ne did not forbid the partner choice" w))))))))))

;; release: assignments are policy, relations are knowledge-or-branch policy.
(fn srp2_release ((chosen SkRegion) (w World)) World
  (let ((grammar (srp_grammar)))
    (match
      (srp_count (srp2_root) grammar (sk_region_release chosen (list 0) True))
      (None (srp_fail "release-keep count" w))
      ((Some kept)
       (if (int_eq kept 6)
         (match
           (srp_count
             (srp2_root)
             grammar
             (sk_region_release chosen (list 0) False))
           (None (srp_fail "release-drop count" w))
           ((Some dropped)
            (if (int_eq dropped 9) (srp2_split w)
            (srp_fail "release-drop count value" w))))
         (srp_fail "release-keep count value" w))))))

(fn srp2_split ((w World)) World
  (let ((grammar (srp_grammar)))
    (match (sk_region_split_pair grammar (sk_empty_region) 0 1)
      ((SkRegionSplitErr msg) (srp_fail msg w))
      ((SkRegionSplitOk meq mne)
       (match meq
         (None (srp_fail "split lost the eq branch" w))
         ((Some eq_region)
          (match mne
            (None (srp_fail "split lost the ne branch" w))
            ((Some ne_region)
             (match (srp_count (srp2_root) grammar eq_region)
               (None (srp_fail "split eq count" w))
               ((Some eqc)
                (match (srp_count (srp2_root) grammar ne_region)
                  (None (srp_fail "split ne count" w))
                  ((Some nec)
                   (if (if (int_eq eqc 3) (int_eq nec 6) False) (srp2_clique w)
                   (srp_fail "split counts" w))))))))))))))

(fn srp2_clique_grammar () Grammar
  (Grammar
    (list
      (GEnt 0 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 1 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 2 (list (srp_atom 0) (srp_atom 1) (srp_atom 2))))))

(fn srp2_trio ((a Expr) (b Expr) (c Expr)) Expr
  (Ctor (srp_q (quote Trio)) (list a b c)))

(fn srp2_clique ((w World)) World
  (let
    ((grammar (srp2_clique_grammar))
     (root (srp2_trio (hole 0) (hole 1) (hole 2))))
    (match (sk_region_relate_ne grammar (sk_empty_region) 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "clique relate 01 empty" w))
      ((SkRegionEditOk r1)
       (match (sk_region_relate_ne grammar r1 0 2)
         ((SkRegionEditErr msg) (srp_fail msg w))
         ((SkRegionEditEmpty) (srp_fail "clique relate 02 empty" w))
         ((SkRegionEditOk r2)
          (match (sk_region_relate_ne grammar r2 1 2)
            ((SkRegionEditErr msg) (srp_fail msg w))
            ((SkRegionEditEmpty) (srp_fail "clique relate 12 empty" w))
            ((SkRegionEditOk r3)
             (match (srp_count root grammar r3)
               (None (srp_fail "clique count" w))
               ((Some count)
                (if (int_eq count 6)
                  (match (sk_region_first root grammar r3)
                    ((SkEErr msg) (srp_fail msg w))
                    ((SkEOk first)
                     ;; deterministic under the newest-first event order: the
                     ;; (1,2) pair converts h1=0 into forbids, then h0 takes 1
                     ;; and h2 keeps 2 — a valid clique member, greedily found.
                     (if
                       (expr_eq
                         first
                         (srp2_trio (srp_atom 1) (srp_atom 0) (srp_atom 2)))
                       (srp2_deep w)
                       (srp_fail "clique first representative" w))))
                  (srp_fail "clique count value" w))))))))))))

(fn srp2_deep_grammar () Grammar
  (Grammar
    (list
      (GEnt
        0
        (list (srp_atom 0) (Ctor (srp_q (quote Wrap)) (Cons (hole 2) Nil))))
      (GEnt
        1
        (list (srp_atom 0) (Ctor (srp_q (quote Wrap)) (Cons (hole 3) Nil))))
      (GEnt 2 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 3 (list (srp_atom 0) (srp_atom 1) (srp_atom 2))))))

(fn srp2_deep ((w World)) World
  (let ((grammar (srp2_deep_grammar)))
    (match (sk_region_relate_eq grammar (sk_empty_region) 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "deep eq relate empty" w))
      ((SkRegionEditOk eq_region)
       (match (srp_count (srp2_root) grammar eq_region)
         (None (srp_fail "deep eq count" w))
         ((Some eqc)
          (if (int_eq eqc 4)
            (match (sk_region_relate_ne grammar (sk_empty_region) 0 1)
              ((SkRegionEditErr msg) (srp_fail msg w))
              ((SkRegionEditEmpty) (srp_fail "deep ne relate empty" w))
              ((SkRegionEditOk ne_region)
               (match (srp_count (srp2_root) grammar ne_region)
                 (None (srp_fail "deep ne count" w))
                 ((Some nec)
                  (if (int_eq nec 12) (srp2_descend ne_region w)
                  (srp_fail "deep ne count value" w))))))
            (srp_fail "deep eq count value" w))))))))

;; both sides of a deep ne fix the same alternative: the event descends to
;; the sub-hole pair as ONE tuple event, and stays exactly countable.
(fn srp2_descend ((ne_region SkRegion) (w World)) World
  (let ((grammar (srp2_deep_grammar)))
    (match (sk_region_choose grammar ne_region 0 1)
      ((SkRegionEditErr msg) (srp_fail msg w))
      ((SkRegionEditEmpty) (srp_fail "descend choose 0 empty" w))
      ((SkRegionEditOk c0)
       (match (sk_region_choose grammar c0 1 1)
         ((SkRegionEditErr msg) (srp_fail msg w))
         ((SkRegionEditEmpty) (srp_fail "descend choose 1 empty" w))
         ((SkRegionEditOk c1)
          (match (sk_region_norm grammar c1)
            ((SkRegionEditErr msg) (srp_fail msg w))
            ((SkRegionEditEmpty) (srp_fail "descend norm empty" w))
            ((SkRegionEditOk normed)
             (match (srp_count (srp2_root) grammar normed)
               (None (srp_fail "descend count" w))
               ((Some count)
                (if (int_eq count 6) (srp2_refusals w)
                (srp_fail "descend count value" w))))))))))))

(fn srp2_cap_grammar () Grammar
  (Grammar
    (list
      (GEnt 0 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 1 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 2 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 3 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 4 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 5 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 6 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 7 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 8 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 9 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 10 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 11 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 12 (list (srp_atom 0) (srp_atom 1) (srp_atom 2)))
      (GEnt 13 (list (srp_atom 0) (srp_atom 1) (srp_atom 2))))))

(fn srp2_cap_holes ((k Int)) (List Expr)
  (measure k)
  (if (lt k 1) Nil (Cons (hole (- 14 k)) (srp2_cap_holes (- k 1)))))

(fn srp2_cap_rels () (List SkRel)
  (list
    (SkRelNe (Cons 0 Nil) (Cons 1 Nil))
    (SkRelNe (Cons 1 Nil) (Cons 2 Nil))
    (SkRelNe (Cons 2 Nil) (Cons 3 Nil))
    (SkRelNe (Cons 3 Nil) (Cons 4 Nil))
    (SkRelNe (Cons 4 Nil) (Cons 5 Nil))
    (SkRelNe (Cons 5 Nil) (Cons 6 Nil))
    (SkRelNe (Cons 6 Nil) (Cons 7 Nil))
    (SkRelNe (Cons 7 Nil) (Cons 8 Nil))
    (SkRelNe (Cons 8 Nil) (Cons 9 Nil))
    (SkRelNe (Cons 9 Nil) (Cons 10 Nil))
    (SkRelNe (Cons 10 Nil) (Cons 11 Nil))
    (SkRelNe (Cons 11 Nil) (Cons 12 Nil))
    (SkRelNe (Cons 12 Nil) (Cons 13 Nil))))

(fn srp2_refusals ((w World)) World
  (let ((deep (srp2_deep_grammar)))
    ;; non-isomorphic domains refuse at the door
    (match (sk_region_relate_eq deep (sk_empty_region) 0 2)
      ((SkRegionEditOk _) (srp_fail "non-iso relate did not refuse" w))
      ((SkRegionEditEmpty) (srp_fail "non-iso relate went empty" w))
      ((SkRegionEditErr _)
       ;; an endpoint under an OPEN parent is not unconditionally live
       (match (sk_region_relate_ne deep (sk_empty_region) 2 3)
         ((SkRegionEditErr msg) (srp_fail msg w))
         ((SkRegionEditEmpty) (srp_fail "live relate went empty" w))
         ((SkRegionEditOk sub_region)
          (match (sk_region_count (srp2_root) deep sub_region)
            ((SkCOk _) (srp_fail "non-live endpoint count did not refuse" w))
            ((SkCErr _)
             ;; an endpoint inside another endpoint's closure (hand-built)
             (match
               (sk_region_count
                 (srp2_root)
                 deep
                 (SkRegion
                   (list (Pair 0 1) (Pair 1 1))
                   Nil
                   (list
                     (SkRelNe (Cons 0 Nil) (Cons 1 Nil))
                     (SkRelNe (Cons 2 Nil) (Cons 3 Nil)))))
               ((SkCOk _) (srp_fail "closure overlap count did not refuse" w))
               ((SkCErr _)
                ;; a component past the ne-event cap refuses
                (match
                  (sk_region_count
                    (Ctor (srp_q (quote Wide)) (srp2_cap_holes 14))
                    (srp2_cap_grammar)
                    (SkRegion Nil Nil (srp2_cap_rels)))
                  ((SkCOk _) (srp_fail "cap count did not refuse" w))
                  ((SkCErr _) (srp2_decide w)))))))))))))

;; The entailment decision the relation-aware evaluator consults: transitive
;; eq reachability, singleton ne lifted across eq classes, vector ne entails
;; nothing pointwise, and everything undecided stays Unknown.
(fn srp2_decide_rels () (List SkRel)
  (list
    (SkRelEq (Cons 0 Nil) (Cons 1 Nil))
    (SkRelEq (Cons 1 Nil) (Cons 2 Nil))
    (SkRelNe (Cons 2 Nil) (Cons 4 Nil))
    (SkRelNe (list 8 9) (list 10 11))))

(fn srp2_decide ((w World)) World
  (let ((rels (srp2_decide_rels)))
    (match (sk_rels_decide rels 0 2)
      ((SkRelDecideEq)
       (match (sk_rels_decide rels 4 0)
         ((SkRelDecideNe)
          (match (sk_rels_decide rels 8 10)
            ((SkRelDecideUnknown)
             (match (sk_rels_decide rels 0 5)
               ((SkRelDecideUnknown)
                (match (sk_rels_decide rels 6 6)
                  ((SkRelDecideEq)
                   (write
                     "REGION-PROBE-REL EQ-3 NE-6 CLIQUE-6 DEEP-4/12 DESCEND-6 PROPAGATE FORBID-2 SPLIT-3+6 RELEASE-6/9 ISO-REFUSE LIVE-REFUSE CLOSURE-REFUSE CAP-REFUSE RANK-REFUSE DECIDE-TRANS/NE-LIFT/VEC-UNKNOWN/REFL OK\n"
                     w))
                  (_ (srp_fail "decide reflexive" w))))
               (_ (srp_fail "decide unrelated was not unknown" w))))
            (_ (srp_fail "decide vector ne was not unknown" w))))
         (_ (srp_fail "decide ne class lift" w))))
      (_ (srp_fail "decide transitive eq" w)))))
