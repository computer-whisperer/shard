;;; tools/search/typed_superpose.shard — typed task search by SUPERPOSITION.
;;;
;;; This consumes typed_expr's reflected TeSpace, but searches it by evaluating
;;; `search_probe(root-sketch)` under partial assignments.  Evaluation forks
;;; only when it demands an open hole; a mismatch kills the whole consistent
;;; subspace and unconsulted holes in a passing region are don't-cares.
;;; Exhaustive enumeration is available only as an agreement audit.
;;; Optional explicit congruence and observer-root profiles are authenticated
;;; against the task's CHECK closure. Separable rules become generation-time
;;; formation filters; deeper or conjunctive rules remain exact partial-region
;;; constraints and can prune whole ranked subspaces lazily.
;;;
;;; The task is loaded once by typed_expr's te_load_task into the shared
;;; TeTask record; the claim ladder routes the drive (census/absence claims
;;; through the counted exhaustive drive, first-result claims through the
;;; lazy schema drive), and the only legality check added here is the one
;;; involving this engine's own invocation: the audit flag against a
;;; first-result claim.
;;;
;;; RUN IT:
;;;   bin/shard_eval run tools/search/typed_superpose.shard TASK.shard
;;;   bin/shard_eval run tools/search/typed_superpose.shard TASK.shard audit

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/module.shard")
(import "../../kernel/reader.shard")
(import "../../kernel/types.shard")
(import "../../kernel/loader.shard")
(import "../../meta/sketch")
(import "../../meta/invoke")
(import "../../meta/invoke/prepared.shard")
(import "../../meta/rewrite")
(import "../../meta/search/mod.req.shard")
(import "../../meta/spell")
(import "typed_expr.shard")
(import "superpose.shard")
(use (:: kernel term *))
(use (:: kernel module *))
(use (:: kernel reader RCtx))
(use (:: kernel loader World))
(use (:: kernel loader read_file))
(use (:: kernel loader get_args))
(use (:: kernel loader write))
(use (:: kernel loader exit))
(use (:: meta sketch *))
(use (:: meta invoke *))
(use (:: meta invoke prepared *))
(use (:: meta rewrite *))
(use (:: meta search *))
(use (:: meta spell *))
(use (:: tools search typed_expr *))
(use (:: tools search superpose *))

(fn ts_fail ((msg (List Int)) (w World)) World
  (exit
    1
    (write (append_int "SUPERPOSED-SEARCH FAIL " (append_int msg "\n")) w)))

;; ---- independent gates over passing regions -------------------------------

(type TsRepR (TsRepErr (List Int)) (TsRepOk Int))

(fn ts_reps_gate
  ((root Expr)
   (grammar Grammar)
   (constraints MsPlan)
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (sols (List SkRegion))
   (best Int))
  TsRepR
  (measure (struct sols))
  (match sols
    (Nil (if (lt best 0) (TsRepErr "no passing region") (TsRepOk best)))
    ((Cons region rest)
     (match (su_region_rep grammar region root)
       (None (TsRepErr "representative fill failed"))
       ((Some candidate)
        (match (ms_check 1000000 constraints grammar Nil candidate)
          ((MsErr msg)
           (TsRepErr (append_int "representative constraint: " msg)))
          ((MsBlocked _)
           (TsRepErr "representative constraint remained blocked"))
          ((MsRedex _) (TsRepErr "representative has a residual redex"))
          ((MsClear)
           (match (te_typecheck m want candidate)
             ((TeTcErr msg) (TsRepErr (append_int "representative type: " msg)))
             ((TeTcOk)
              (match (te_observe ctx probe candidate)
                ((TeObsErr msg)
                 (TsRepErr (append_int "representative probe: " msg)))
                ((TeObsReject) (TsRepErr "representative is rejected"))
                ((TeObsOk key)
                 (if (expr_eq key target)
                   (match (sk_rank root grammar candidate)
                     ((SkCErr msg)
                      (TsRepErr (append_int "representative rank: " msg)))
                     ((SkCOk rank)
                      (ts_reps_gate
                        root
                        grammar
                        constraints
                        m
                        want
                        ctx
                        probe
                        target
                        rest
                        (if (lt best 0) rank (if (lt rank best) rank best)))))
                   (TsRepErr "representative observation differs")))))))))))))

(type TsCandR (TsCandErr (List Int)) (TsCandOk Int Expr))

(fn ts_witness_candidate ((root Expr) (grammar Grammar) (witness TeWitness))
  TsCandR
  (match witness
    ((TeWitnessValue value)
     (match (sk_rank root grammar value)
       ((SkCErr msg) (TsCandErr (append_int "witness rank: " msg)))
       ((SkCOk rank)
        (match (sk_unrank root grammar rank)
          ((SkEErr msg) (TsCandErr (append_int "witness unrank: " msg)))
          ((SkEOk value2)
           (if (expr_eq value value2) (TsCandOk rank value)
           (TsCandErr "witness rank/unrank disagrees")))))))
    ((TeWitnessRank rank)
     (match (sk_unrank root grammar rank)
       ((SkEErr msg) (TsCandErr (append_int "witness unrank: " msg)))
       ((SkEOk value) (TsCandOk rank value))))
    ((TeWitnessEmpty)
     (TsCandErr "expected-empty mode has no witness candidate"))))

(type TsWitnessR (TsWitnessErr (List Int)) (TsWitnessOk Int))

(fn ts_witness_gate
  ((root Expr)
   (grammar Grammar)
   (constraints MsPlan)
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (sols (List SkRegion)))
  TsWitnessR
  (match (ts_witness_candidate root grammar witness)
    ((TsCandErr msg) (TsWitnessErr msg))
    ((TsCandOk rank candidate)
     (match (ms_check 1000000 constraints grammar Nil candidate)
       ((MsErr msg) (TsWitnessErr (append_int "witness constraint: " msg)))
       ((MsBlocked _) (TsWitnessErr "witness constraint remained blocked"))
       ((MsRedex _) (TsWitnessErr "witness has a residual redex"))
       ((MsClear)
        (match (te_typecheck m want candidate)
          ((TeTcErr msg) (TsWitnessErr (append_int "witness type: " msg)))
          ((TeTcOk)
           (match (te_observe ctx probe candidate)
             ((TeObsErr msg) (TsWitnessErr (append_int "witness probe: " msg)))
             ((TeObsReject) (TsWitnessErr "witness is rejected"))
             ((TeObsOk key)
              (if (expr_eq key target)
                (if (su_covered grammar root sols candidate) (TsWitnessOk rank)
                (TsWitnessErr "witness escaped every passing region"))
                (TsWitnessErr "witness observation differs")))))))))))

;; ---- optional exhaustive agreement audit ----------------------------------

(fn ts_solution_coverage
  ((root Expr) (grammar Grammar) (sols (List SkRegion)) (ranks (List Int)))
  (Option (List Int))
  (measure (struct ranks))
  (match ranks
    (Nil None)
    ((Cons rank rest)
     (match (sk_unrank root grammar rank)
       ((SkEErr msg) (Some (append_int "audit unrank: " msg)))
       ((SkEOk candidate)
        (if (su_covered grammar root sols candidate)
          (ts_solution_coverage root grammar sols rest)
          (Some "audit solution escaped every passing region")))))))

(type TsAuditR
  (TsAuditErr (List Int))
  (TsAuditSkip)
  (TsAuditOk Int Int Int Int Int))

(fn ts_audit
  ((enabled Bool)
   (total Int)
   (found Int)
   (root Expr)
   (grammar Grammar)
   (constraints MsPlan)
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (sols (List SkRegion)))
  TsAuditR
  (if enabled
    (match
      (te_sweep total total root grammar constraints m want ctx screen probe
        target Nil 0 0 0 0 Nil)
      ((TeSweepErr msg) (TsAuditErr msg))
      ((TeSweepOk _ accepted rejected screened constrained ranks)
       (if (int_eq found (te_int_len ranks))
         (match (ts_solution_coverage root grammar sols ranks)
           ((Some msg) (TsAuditErr msg))
           (None
             (TsAuditOk
               accepted
               rejected
               screened
               constrained
               (te_int_len ranks))))
         (TsAuditErr "passing coverage disagrees with exhaustive solutions"))))
    (TsAuditSkip)))

;; ---- report ----------------------------------------------------------------

(type TsPressure (TsPressure Int Int MsPlan Int))
; congruence rule count, observer-root rule count, residual plan, raw count

(fn ts_pressure_constraints ((pressure TsPressure)) MsPlan
  (match pressure
    ((TsPressure _ _ constraints _) constraints)))

(fn ts_audit_report ((audit TsAuditR)) (List Int)
  (match audit
    ((TsAuditErr msg) (append_int "AUDIT FAIL " (append_int msg "\n")))
    ((TsAuditSkip) "AUDIT SKIPPED\n")
    ((TsAuditOk accepted rejected screened constrained solutions)
     (te_cat
       (list
         "AUDIT ENUMERATIVE AGREEMENT OK ACCEPTED "
         (show_int accepted)
         " REJECTED "
         (show_int rejected)
         " SCREENED "
         (show_int screened)
         " CONSTRAINED "
         (show_int constrained)
         " SOLUTIONS "
         (show_int solutions)
         "\n")))))

(fn ts_report
  ((path (List Int))
   (depth Int)
   (holes Int)
   (total Int)
   (found Int)
   (killed Int)
   (constraint_killed Int)
   (regions Int)
   (forks Int)
   (steps Int)
   (best (List Int))
   (witness Int)
   (pressure TsPressure)
   (audit TsAuditR))
  (List Int)
  (match pressure
    ((TsPressure canon_rules observer_rules constraints raw)
     (te_cat
       (list
         "SUPERPOSED-SEARCH "
         path
         "\nDEPTH "
         (show_int depth)
         "\nHOLES "
         (show_int holes)
         "\nCANON RULES "
         (show_int canon_rules)
         "\nOBSERVER RULES "
         (show_int observer_rules)
         "\nSPINE RULES "
         (show_int (ms_plan_spine_rule_count constraints))
         "\nDEFERRED RULES "
         (show_int (ms_plan_rule_count constraints))
         "\nRAW "
         (show_int raw)
         "\nREMOVED "
         (show_int (- raw total))
         "\nTOTAL "
         (show_int total)
         "\nFOUND "
         (show_int found)
         "\nKILLED "
         (show_int killed)
         "\nCONSTRAINT KILLED "
         (show_int constraint_killed)
         "\nREGIONS "
         (show_int regions)
         "\nFORKS "
         (show_int forks)
         "\nSTEPS "
         (show_int steps)
         "\n"
         best
         "SOLUTIONS "
         (show_int found)
         "\nWITNESS "
         (if (lt witness 0) "EXPECTED EMPTY" (show_int witness))
         "\n"
         (ts_audit_report audit)
         "GATES OK\n")))))

;; ---- finish gates ----------------------------------------------------------

(fn ts_finish_audit
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (table (List (Pair QName Symbol)))
   (depth Int)
   (holes Int)
   (root Expr)
   (grammar Grammar)
   (total Int)
   (found Int)
   (killed Int)
   (constraint_killed Int)
   (regions Int)
   (forks Int)
   (steps Int)
   (sols (List SkRegion))
   (best_rank Int)
   (witness_rank Int)
   (pressure TsPressure)
   (audit_enabled Bool)
   (w World))
  World
  (match
    (ts_audit
      audit_enabled
      total
      found
      root
      grammar
      (ts_pressure_constraints pressure)
      m
      want
      ctx
      screen
      probe
      target
      sols)
    ((TsAuditErr msg) (ts_fail (append_int "audit: " msg) w))
    (audit
      (match (te_best table root grammar (Cons best_rank Nil))
        ((TeBestErr msg) (ts_fail (append_int "best: " msg) w))
        ((TeBestOk best)
         (write
           (ts_report path depth holes total found killed constraint_killed
             regions forks steps best witness_rank pressure audit)
           w))))))

(fn ts_finish_witness
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (table (List (Pair QName Symbol)))
   (depth Int)
   (holes Int)
   (root Expr)
   (grammar Grammar)
   (total Int)
   (found Int)
   (killed Int)
   (constraint_killed Int)
   (regions Int)
   (forks Int)
   (steps Int)
   (sols (List SkRegion))
   (best_rank Int)
   (pressure TsPressure)
   (audit_enabled Bool)
   (w World))
  World
  (match
    (ts_witness_gate
      root
      grammar
      (ts_pressure_constraints pressure)
      m
      want
      ctx
      probe
      target
      witness
      sols)
    ((TsWitnessErr msg) (ts_fail msg w))
    ((TsWitnessOk witness_rank)
     (ts_finish_audit path m want ctx screen probe target table depth holes root
       grammar total found killed constraint_killed regions forks steps sols
       best_rank witness_rank pressure audit_enabled w))))

(fn ts_finish_empty
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (depth Int)
   (holes Int)
   (root Expr)
   (grammar Grammar)
   (total Int)
   (found Int)
   (killed Int)
   (constraint_killed Int)
   (regions Int)
   (forks Int)
   (steps Int)
   (sols (List SkRegion))
   (pressure TsPressure)
   (audit_enabled Bool)
   (w World))
  World
  (if (int_eq found 0)
    (match
      (ts_audit
        audit_enabled
        total
        found
        root
        grammar
        (ts_pressure_constraints pressure)
        m
        want
        ctx
        screen
        probe
        target
        sols)
      ((TsAuditErr msg) (ts_fail (append_int "audit: " msg) w))
      (audit
        (write
          (ts_report
            path
            depth
            holes
            total
            found
            killed
            constraint_killed
            regions
            forks
            steps
            "BEST NONE\n"
            -1
            pressure
            audit)
          w)))
    (ts_fail
      (append_int "expected an empty search, but FOUND = " (show_int found))
      w)))

;; First-result mode deliberately validates values without ranking them: rank
;; arithmetic would reintroduce the full-space cardinality dependency this mode
;; exists to avoid.
(type TsFirstCandidateR
  (TsFirstCandidateErr (List Int))
  (TsFirstCandidateOk (List Int)))

(fn ts_first_candidate
  ((table (List (Pair QName Symbol)))
   (grammar Grammar)
   (constraints MsPlan)
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (candidate Expr))
  TsFirstCandidateR
  (match (ms_check 1000000 constraints grammar Nil candidate)
    ((MsErr msg) (TsFirstCandidateErr msg))
    ((MsBlocked _) (TsFirstCandidateErr "representative constraint blocked"))
    ((MsRedex _) (TsFirstCandidateErr "representative has a residual redex"))
    ((MsClear)
     (match (te_typecheck m want candidate)
       ((TeTcErr msg) (TsFirstCandidateErr msg))
       ((TeTcOk)
        (match (te_observe ctx probe candidate)
          ((TeObsErr msg) (TsFirstCandidateErr msg))
          ((TeObsReject) (TsFirstCandidateErr "representative is rejected"))
          ((TeObsOk key)
           (if (expr_eq key target)
             (match (sp_e table 0 candidate)
               ((SpRErr msg) (TsFirstCandidateErr msg))
               ((SpROk doc)
                (TsFirstCandidateOk
                  (append_int "BEST UNRANKED " (append_int (sp_bytes doc) "\n")))))
             (TsFirstCandidateErr "representative observation differs")))))))))

(type TsFirstWitnessR (TsFirstWitnessErr (List Int)) (TsFirstWitnessOk))

(fn ts_first_witness
  ((grammar Grammar)
   (constraints MsPlan)
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (witness TeWitness))
  TsFirstWitnessR
  (match witness
    ((TeWitnessRank _)
     (TsFirstWitnessErr
       "first result mode requires a value witness, not a rank witness"))
    ((TeWitnessValue candidate)
     (match (ms_check 1000000 constraints grammar Nil candidate)
       ((MsErr msg) (TsFirstWitnessErr msg))
       ((MsBlocked _) (TsFirstWitnessErr "witness constraint remained blocked"))
       ((MsRedex _) (TsFirstWitnessErr "witness has a residual redex"))
       ((MsClear)
        (match (te_typecheck m want candidate)
          ((TeTcErr msg) (TsFirstWitnessErr msg))
          ((TeTcOk)
           (match (te_observe ctx probe candidate)
             ((TeObsErr msg) (TsFirstWitnessErr msg))
             ((TeObsReject) (TsFirstWitnessErr "witness is rejected"))
             ((TeObsOk key)
              (if (expr_eq key target) (TsFirstWitnessOk)
              (TsFirstWitnessErr "witness observation differs")))))))))
    ((TeWitnessEmpty)
     (TsFirstWitnessErr "search_expect_empty requires exhaustive mode"))))

(fn ts_schema_first_report
  ((path (List Int))
   (depth Int)
   (schemas Int)
   (killed Int)
   (constrained Int)
   (regions Int)
   (forks Int)
   (steps Int)
   (best (List Int))
   (pressure TsPressure))
  (List Int)
  (match pressure
    ((TsPressure canon_rules observer_rules constraints _)
     (te_cat
       (list
         "SUPERPOSED-SEARCH "
         path
         "\nMODE FIRST LAZY-SCHEMA\nDEPTH "
         (show_int depth)
         "\nHOLES LAZY"
         "\nSCHEMAS "
         (show_int schemas)
         "\nCANON RULES "
         (show_int canon_rules)
         "\nOBSERVER RULES "
         (show_int observer_rules)
         "\nSPINE RULES "
         (show_int (ms_plan_spine_rule_count constraints))
         "\nDEFERRED RULES "
         (show_int (ms_plan_rule_count constraints))
         "\nCARDINALITY UNCOUNTED"
         "\nKILLED REGIONS "
         (show_int killed)
         "\nCONSTRAINT REGIONS "
         (show_int constrained)
         "\nTERMINAL REGIONS "
         (show_int regions)
         "\nFORKS "
         (show_int forks)
         "\nSTEPS "
         (show_int steps)
         "\n"
         best
         "WITNESS SEMANTIC OK\nAUDIT SKIPPED\nGATES OK\n")))))

(fn ts_finish_schema_first
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (table (List (Pair QName Symbol)))
   (depth Int)
   (schemas Int)
   (pressure TsPressure)
   (drive SuFind)
   (w World))
  World
  (match drive
    ((SuFindErr msg) (ts_fail msg w))
    ((SuFindBudget killed constrained regions forks steps nodes exprs)
     (ts_fail
       (te_cat
         (list
           "depth "
           (show_int depth)
           " schemas "
           (show_int schemas)
           ": "
           (su_find_budget_report killed constrained regions forks steps nodes
             exprs)))
       w))
    ((SuFindEmpty killed constrained regions forks steps _ _)
     (ts_fail
       (te_cat
         (list
           "first result mode exhausted without a passing region; killed-regions "
           (show_int killed)
           " constraint-regions "
           (show_int constrained)
           " terminal-regions "
           (show_int regions)
           " forks "
           (show_int forks)
           " steps "
           (show_int steps)))
       w))
    ((SuFindFound killed constrained regions forks steps _ representative)
     ;; The representative and witness are closed, so residual validation no
     ;; longer needs occurrence alternatives.  The ordinary checker over an
     ;; empty flat language still authenticates the complete theorem plan.
     (match
       (ts_first_candidate
         table
         (Grammar Nil)
         (ts_pressure_constraints pressure)
         m
         want
         ctx
         probe
         target
         representative)
       ((TsFirstCandidateErr msg) (ts_fail (append_int "best: " msg) w))
       ((TsFirstCandidateOk best)
        (match
          (ts_first_witness
            (Grammar Nil)
            (ts_pressure_constraints pressure)
            m
            want
            ctx
            probe
            target
            witness)
          ((TsFirstWitnessErr msg) (ts_fail msg w))
          ((TsFirstWitnessOk)
           (write
             (ts_schema_first_report path depth schemas killed constrained
               regions forks steps best pressure)
             w))))))))

(fn ts_finish
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (table (List (Pair QName Symbol)))
   (depth Int)
   (holes Int)
   (root Expr)
   (grammar Grammar)
   (total Int)
   (pressure TsPressure)
   (audit_enabled Bool)
   (drive SuS)
   (w World))
  World
  (match drive
    ((SuSErr msg) (ts_fail msg w))
    ((SuSBudget found killed constrained regions forks steps nodes exprs _)
     (ts_fail
       (su_budget_report found killed constrained regions forks steps nodes
         exprs)
       w))
    ((SuSOk found killed constraint_killed regions forks steps sols)
     (if (int_eq (+ found killed) total)
       (match witness
         ((TeWitnessEmpty)
          (ts_finish_empty path m want ctx screen probe target depth holes root
            grammar total found killed constraint_killed regions forks steps
            sols pressure audit_enabled w))
         (_
           (match
             (ts_reps_gate
               root
               grammar
               (ts_pressure_constraints pressure)
               m
               want
               ctx
               probe
               target
               sols
               -1)
             ((TsRepErr msg) (ts_fail msg w))
             ((TsRepOk best_rank)
              (ts_finish_witness path m want ctx screen probe target witness
                table depth holes root grammar total found killed
                constraint_killed regions forks steps sols best_rank pressure
                audit_enabled w)))))
       (ts_fail
         (te_cat
           (list
             "found + killed != total: found "
             (show_int found)
             " killed "
             (show_int killed)
             " total "
             (show_int total)
             " regions "
             (show_int regions)
             " forks "
             (show_int forks)))
         w)))))

;; ---- generic typed/superposed drive ---------------------------------------

(fn ts_drive_counted
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (screen TeScreen)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (table (List (Pair QName Symbol)))
   (depth Int)
   (holes Int)
   (root Expr)
   (grammar Grammar)
   (total Int)
   (pressure TsPressure)
   (audit Bool)
   (fuel Int)
   (theorem_first Bool)
   (w World))
  World
  (match probe
    ((FnDef probeq _ _ _)
     (let
       ((query (Call probeq (Cons root Nil)))
        (expected (Ctor (qn (quote Some)) (Cons target Nil))))
       (ts_finish
         path
         m
         want
         ctx
         screen
         probe
         target
         witness
         table
         depth
         holes
         root
         grammar
         total
         pressure
         audit
         (su_drive_query_ordered
           theorem_first
           fuel
           m
           (qn (quote __typed_superpose_data_candidate))
           root
           root
           (ts_pressure_constraints pressure)
           query
           expected
           grammar
           (sa_new)
           (Cons (sk_empty_region) Nil)
           0
           0
           0
           0
           0
           Nil)
         w)))))

(fn ts_find_schema_space
  ((path (List Int))
   (m Module)
   (want Type)
   (ctx InvokeCtx)
   (probe FnDef)
   (target Expr)
   (witness TeWitness)
   (space TeSchemaSpace)
   (pressure TsPressure)
   (fuel Int)
   (w World))
  World
  (match space
    ((TeSchemaSpace table depth root grammar schemas)
     (match probe
       ((FnDef probeq _ _ _)
        (let
          ((query (Call probeq (Cons root Nil)))
           (expected (Ctor (qn (quote Some)) (Cons target Nil))))
          (ts_finish_schema_first
            path
            m
            want
            ctx
            probe
            target
            witness
            table
            depth
            schemas
            pressure
            (su_find_query_schema
              fuel
              m
              (qn (quote __typed_superpose_data_candidate))
              root
              root
              (ts_pressure_constraints pressure)
              query
              expected
              grammar)
            w)))))))

(fn ts_exhaustive_space
  ((path (List Int))
   (m Module)
   (ctx InvokeCtx)
   (task TeTask)
   (audit Bool)
   (space TeSpace)
   (constraints MsPlan)
   (canon_rules Int)
   (observer_rules Int)
   (raw_total Int)
   (w World))
  World
  (match space
    ((TeSpace table depth root grammar holes)
     (match (sk_count root grammar)
       ((SkCErr msg) (ts_fail (append_int "count: " msg) w))
       ((SkCOk total)
        (ts_drive_counted
          path
          m
          (task_want_of task)
          ctx
          (task_screen_of task)
          (task_probe_of task)
          (task_target_of task)
          (task_witness_of task)
          table
          depth
          holes
          root
          grammar
          total
          (TsPressure
            canon_rules
            observer_rules
            constraints
            (if (lt raw_total 0) total raw_total))
          audit
          (te_task_fuel task total)
          (task_theorem_first_of task)
          w))))))

(fn ts_exhaustive_filtered
  ((path (List Int))
   (m Module)
   (ctx InvokeCtx)
   (task TeTask)
   (audit Bool)
   (scope RCtx)
   (plan TrsFormationPlan)
   (constraints MsPlan)
   (canon_rules Int)
   (observer_rules Int)
   (raw_total Int)
   (w World))
  World
  (match
    (te_make_space_plan m (task_want_of task) scope (task_cfg_of task) plan)
    ((TeSpaceErr msg) (ts_fail msg w))
    ((TeSpaceOk space)
     (ts_exhaustive_space path m ctx task audit space constraints canon_rules
       observer_rules raw_total w))))

(fn ts_exhaustive
  ((path (List Int))
   (src (List Int))
   (m Module)
   (ctx InvokeCtx)
   (task TeTask)
   (audit Bool)
   (reductions TeReductions)
   (w World))
  World
  (let ((scope (te_import_ctx m path src)))
    (match reductions
      ((TeReductions
         (TeCanon _ formation _ canon_rules)
         (TeObserved _ root_formation _ observer_rules)
         constraints)
       (let
         ((rules (+ canon_rules observer_rules))
          (plan (trs_formation_plan formation root_formation)))
         (if (lt rules 1)
           (ts_exhaustive_filtered path m ctx task audit scope plan constraints
             canon_rules observer_rules -1 w)
           (match (te_make_space m (task_want_of task) scope (task_cfg_of task))
             ((TeSpaceErr msg) (ts_fail (append_int "raw: " msg) w))
             ((TeSpaceOk raw_space)
              (match (te_space_count raw_space)
                ((TeCountErr msg) (ts_fail (append_int "raw count: " msg) w))
                ((TeCountOk raw_total)
                 (ts_exhaustive_filtered path m ctx task audit scope plan
                   constraints canon_rules observer_rules raw_total w)))))))))))

;; Formation and residual theorem pressure still apply in first-result mode;
;; only the raw/filtered census delta is intentionally uncounted.  A
;; first-result run also has no meaningful total from which to derive a
;; budget: the explicit hook wins; otherwise 801,024 region decisions is a
;; conservative general default.
(fn ts_first
  ((path (List Int))
   (src (List Int))
   (m Module)
   (ctx InvokeCtx)
   (task TeTask)
   (reductions TeReductions)
   (w World))
  World
  (match reductions
    ((TeReductions
       (TeCanon _ formation _ canon_rules)
       (TeObserved _ root_formation _ observer_rules)
       constraints)
     (match
       (te_make_schema_space_plan
         m
         (task_want_of task)
         (te_import_ctx m path src)
         (task_cfg_of task)
         (trs_formation_plan formation root_formation))
       ((TeSchemaSpaceErr msg) (ts_fail msg w))
       ((TeSchemaSpaceOk space)
        (ts_find_schema_space
          path
          m
          (task_want_of task)
          ctx
          (task_probe_of task)
          (task_target_of task)
          (task_witness_of task)
          space
          (TsPressure canon_rules observer_rules constraints -1)
          (te_task_fuel task 100000)
          w))))))

(fn ts_routed
  ((path (List Int))
   (src (List Int))
   (m Module)
   (ctx InvokeCtx)
   (task TeTask)
   (audit Bool)
   (first Bool)
   (w World))
  World
  (match
    (te_load_reductions
      path
      (te_probe_qname (task_probe_of task))
      (task_canon_of task)
      (task_observer_of task)
      (task_spine_of task)
      w)
    ((Pair result w2)
     (match result
       ((TeReductionsErr msg) (ts_fail (append_int "reductions: " msg) w2))
       ((TeReductionsOk reductions)
        (if first (ts_first path src m ctx task reductions w2)
        (ts_exhaustive path src m ctx task audit reductions w2)))))))

(fn ts_search
  ((path (List Int)) (src (List Int)) (m Module) (audit Bool) (w World))
  World
  (let ((ctx (prepare_invoke m)))
    (match (te_load_task ctx m)
      ((TeTaskErr msg) (ts_fail msg w))
      ((TeTaskOk task)
       (match (task_claim_of task)
         ((TeClaimFirst)
          (if audit
            (ts_fail "first result mode cannot run an exhaustive audit" w)
            (ts_routed path src m ctx task False True w)))
         (_ (ts_routed path src m ctx task audit False w)))))))

(fn ts_bytes_eq ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (Nil
      (match b
        (Nil True)
        ((Cons _ _) False)))
    ((Cons x xs)
     (match b
       (Nil False)
       ((Cons y ys) (if (int_eq x y) (ts_bytes_eq xs ys) False))))))

(fn ts_loaded ((path (List Int)) (audit Bool) (m Module) (w World)) World
  (match (read_file path w)
    ((Pair osrc w2)
     (match osrc
       (None (ts_fail "task source read" w2))
       ((Some src) (ts_search path src m audit w2))))))

(fn ts_load ((path (List Int)) (audit Bool) (w World)) World
  (match (load_run_module path w)
    ((Pair om w2)
     (match om
       (None (ts_fail "task module load" w2))
       ((Some m) (ts_loaded path audit m w2))))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match args
       ((Cons path Nil) (ts_load path False w1))
       ((Cons path (Cons mode Nil))
        (if (ts_bytes_eq mode "audit") (ts_load path True w1)
        (exit 2 (write "usage: typed_superpose TASK.shard [audit]\n" w1))))
       (_ (exit 2 (write "usage: typed_superpose TASK.shard [audit]\n" w1)))))))
