;;; Provenance pins for the LS3b mined-instance set (SEARCH.md, the
;;; lock-step arc, slice LS3-ii): each xsi_* instance is byte-for-byte
;;; a slice of what the imp -> x86 leg emits for its named sha256
;;; function — computed HERE from ix_sstmts directly, while the
;;; artifact's own tie claims (std/sha256/impgen_x86_out.shard) pin the
;;; same output as the stored instruction lists, closing the chain.  An
;;; impgen change that moves the material turns these pins red in the
;;; corpus, forcing a re-mine — the regen-canon contract for mined
;;; instances.  Offsets are 0-based into the function's ix_sstmts list.

(import "../../kernel/stdlib.shard")
(import "../../models/imp/imp.shard")
(import "../../models/imp/to_x86.shard")
(import "../../std/sha256/sha256.imp.shard")
(import "tasks/x86_span_instances.shard")

(use (:: models imp imp ibody_of))
(use (:: models imp to_x86 ix_sstmts))
(use (:: std sha256 sha256.imp it_shround_fn))
(use (:: std sha256 sha256.imp it_shtotw_fn))
(use (:: tools search tasks x86_span_instances *))

(claim xsmp_i1_src_pin
  (goal () ()
    (= (xsi_slice 3 2 (ix_sstmts (ibody_of (it_shtotw_fn)))) (Some (xsi_1))))
  (steps ((compute both)) refl))

(claim xsmp_i2_src_pin
  (goal () ()
    (= (xsi_slice 30 2 (ix_sstmts (ibody_of (it_shround_fn)))) (Some (xsi_2))))
  (steps ((compute both)) refl))

(claim xsmp_i3_src_pin
  (goal () ()
    (= (xsi_slice 43 2 (ix_sstmts (ibody_of (it_shround_fn)))) (Some (xsi_3))))
  (steps ((compute both)) refl))

(claim xsmp_i4_src_pin
  (goal () ()
    (= (xsi_slice 1 2 (ix_sstmts (ibody_of (it_shround_fn)))) (Some (xsi_4))))
  (steps ((compute both)) refl))

(claim xsmp_i5_src_pin
  (goal () ()
    (= (xsi_slice 4 3 (ix_sstmts (ibody_of (it_shround_fn)))) (Some (xsi_5))))
  (steps ((compute both)) refl))

(claim xsmp_i6_src_pin
  (goal () ()
    (= (xsi_slice 39 2 (ix_sstmts (ibody_of (it_shround_fn)))) (Some (xsi_6))))
  (steps ((compute both)) refl))
