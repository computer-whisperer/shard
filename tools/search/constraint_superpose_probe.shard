;;; Integration pin: grammar-alternative consensus inside lazy SUPERPOSE.
;;;
;;; The shared residual rule and grammar come from constraint_probe.  Three
;;; two-member hole domains exercise the exact outcomes before a constant-pass
;;; semantic query:
;;;   - all alternatives are clear: one passing region, no fork;
;;;   - all alternatives have the same redex: one killed region, no fork;
;;;   - one clear and one redex: fork once and settle one member each way.

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/module.shard")
(import "../../kernel/loader.shard")
(import "../../meta/sketch")
(import "../../meta/rewrite")
(import "../../meta/search")
(import "constraint_probe.shard")
(import "superpose.shard")
(use (:: kernel term *))
(use (:: kernel module *))
(use (:: kernel loader World))
(use (:: kernel loader write))
(use (:: kernel loader exit))
(use (:: meta sketch *))
(use (:: meta rewrite *))
(use (:: meta search *))
(use (:: tools search constraint_probe *))
(use (:: tools search superpose *))

(fn csp_fail ((msg (List Int)) (w World)) World
  (exit
    1
    (write
      (append_int "META-SEARCH-SUPERPOSE-PROBE FAIL " (append_int msg "\n"))
      w)))

(fn csp_empty_module () Module (Module Nil Nil Nil (FnTrie None Nil) Nil))

(fn csp_drive_region
  ((candidate Expr) (plan MsPlan) (grammar Grammar) (region SkRegion))
  SuS
  (su_drive_query
    1000
    (csp_empty_module)
    (msp_q (quote candidate))
    candidate
    candidate
    plan
    (IntLit 0)
    (IntLit 0)
    grammar
    (sa_new)
    (Cons region Nil)
    0
    0
    0
    0
    0
    Nil))

(fn csp_drive ((candidate Expr) (plan MsPlan) (grammar Grammar)) SuS
  (csp_drive_region candidate plan grammar (sk_empty_region)))

(fn csp_restricted_redex
  ((plan MsPlan) (grammar Grammar) (clear_region SkRegion) (w World))
  World
  (match (csp_drive_region (hole 4) plan grammar clear_region)
    ((SuSOk found killed constrained regions forks _ _)
     (if (int_eq found 1)
       (if (int_eq killed 0)
         (if (int_eq constrained 0)
           (if (int_eq regions 1)
             (if (int_eq forks 0)
               (match (sk_region_forbid grammar (sk_empty_region) 4 1)
                 ((SkRegionEditErr msg) (csp_fail msg w))
                 ((SkRegionEditEmpty) (csp_fail "redex exclusion was empty" w))
                 ((SkRegionEditOk redex_region)
                  (match (csp_drive_region (hole 4) plan grammar redex_region)
                    ((SuSOk found2 killed2 constrained2 regions2 forks2 _ _)
                     (if (int_eq found2 0)
                       (if (int_eq killed2 1)
                         (if (int_eq constrained2 1)
                           (if (int_eq regions2 1)
                             (if (int_eq forks2 0)
                               (csp_diag
                                 (write
                                   "META-SEARCH-SUPERPOSE-PROBE CLEAR 2 REDUX 2 MIXED 1+1 FORKS 0/0/1 RESTRICTED CLEAR/REDUX 1/1 OK\n"
                                   w))
                               (csp_fail "restricted redex fork count" w))
                             (csp_fail "restricted redex region count" w))
                           (csp_fail "restricted redex constraint count" w))
                         (csp_fail "restricted redex killed count" w))
                       (csp_fail "restricted redex found count" w)))
                    ((SuSErr msg) (csp_fail msg w))
                    ((SuSBudget _ _ _ _ _ _ _ _ _)
                     (csp_fail "restricted redex budget" w)))))
               (csp_fail "restricted clear fork count" w))
             (csp_fail "restricted clear region count" w))
           (csp_fail "restricted clear constraint count" w))
         (csp_fail "restricted clear killed count" w))
       (csp_fail "restricted clear found count" w)))
    ((SuSErr msg) (csp_fail msg w))
    ((SuSBudget _ _ _ _ _ _ _ _ _) (csp_fail "restricted clear budget" w))))

(fn csp_restricted ((plan MsPlan) (grammar Grammar) (w World)) World
  (match (sk_region_forbid grammar (sk_empty_region) 4 0)
    ((SkRegionEditErr msg) (csp_fail msg w))
    ((SkRegionEditEmpty) (csp_fail "clear exclusion was empty" w))
    ((SkRegionEditOk clear_region)
     (csp_restricted_redex plan grammar clear_region w))))

(fn csp_mixed ((plan MsPlan) (grammar Grammar) (w World)) World
  (match (csp_drive (hole 4) plan grammar)
    ((SuSOk found killed constrained regions forks _ _)
     (if (int_eq found 1)
       (if (int_eq killed 1)
         (if (int_eq constrained 1)
           (if (int_eq regions 2)
             (if (int_eq forks 1) (csp_restricted plan grammar w)
             (csp_fail "mixed fork count" w))
             (csp_fail "mixed region count" w))
           (csp_fail "mixed constraint-killed count" w))
         (csp_fail "mixed killed count" w))
       (csp_fail "mixed found count" w)))
    ((SuSErr msg) (csp_fail msg w))
    ((SuSBudget _ _ _ _ _ _ _ _ _)
     (csp_fail "unexpected drive budget exhaustion" w))))

(fn csp_redex ((plan MsPlan) (grammar Grammar) (w World)) World
  (match (csp_drive (hole 3) plan grammar)
    ((SuSOk found killed constrained regions forks _ _)
     (if (int_eq found 0)
       (if (int_eq killed 2)
         (if (int_eq constrained 2)
           (if (int_eq regions 1)
             (if (int_eq forks 0) (csp_mixed plan grammar w)
             (csp_fail "redex fork count" w))
             (csp_fail "redex region count" w))
           (csp_fail "redex constraint-killed count" w))
         (csp_fail "redex killed count" w))
       (csp_fail "redex found count" w)))
    ((SuSErr msg) (csp_fail msg w))
    ((SuSBudget _ _ _ _ _ _ _ _ _)
     (csp_fail "unexpected drive budget exhaustion" w))))

(fn csp_clear ((plan MsPlan) (grammar Grammar) (w World)) World
  (match (csp_drive (hole 2) plan grammar)
    ((SuSOk found killed constrained regions forks _ _)
     (if (int_eq found 2)
       (if (int_eq killed 0)
         (if (int_eq constrained 0)
           (if (int_eq regions 1)
             (if (int_eq forks 0) (csp_redex plan grammar w)
             (csp_fail "clear fork count" w))
             (csp_fail "clear region count" w))
           (csp_fail "clear constraint-killed count" w))
         (csp_fail "clear killed count" w))
       (csp_fail "clear found count" w)))
    ((SuSErr msg) (csp_fail msg w))
    ((SuSBudget _ _ _ _ _ _ _ _ _)
     (csp_fail "unexpected drive budget exhaustion" w))))

;; R3 drive-level relational split: a nonlinear diagonal rule over two open
;; 3-atom holes, before a constant-pass query.  The pair verdict survives to
;; the passing region, the prepared partition answers it with ONE relational
;; split, and the ne child lands in the solutions as a RELATIONAL region —
;; counted exactly, represented by the first-productive walk.
(fn csp_diag_q ((name Symbol)) QName
  (QName (list (quote tools) (quote search) (quote superpose_diag)) name))

(fn csp_atom ((value Int)) Expr
  (Ctor (csp_diag_q (quote Atom)) (Cons (IntLit value) Nil)))

(fn csp_pair ((left Expr) (right Expr)) Expr
  (Ctor (csp_diag_q (quote Pair)) (list left right)))

(fn csp_diag_grammar () Grammar
  (Grammar
    (list
      (GEnt 0 (list (csp_atom 0) (csp_atom 1) (csp_atom 2)))
      (GEnt 1 (list (csp_atom 0) (csp_atom 1) (csp_atom 2))))))

(fn csp_diag_sol
  ((grammar Grammar) (space Expr) (sols (List SkRegion)) (w World))
  World
  (match sols
    (Nil (csp_fail "diagonal drive produced no passing region" w))
    ((Cons sol rest)
     (match rest
       ((Cons _ _) (csp_fail "diagonal drive produced extra regions" w))
       (Nil
         (match (su_region_rep grammar sol space)
           (None (csp_fail "relational solution has no representative" w))
           ((Some rep)
            (if (sk_region_member space grammar sol rep)
              (csp_schema
                (write
                  "META-SEARCH-SUPERPOSE-PROBE DIAG-SPLIT FOUND-6 KILLED-3 REGIONS-2 FORKS-1 REL-SOL-REP OK\n"
                  w))
              (csp_fail "relational representative escaped its region" w)))))))))

;; R4: the SAME diagonal shape over a regular schema language — the shared
;; find loop splits the occurrence pair relationally (iso = schema-id
;; equality) and the graduated first walk closes the relational passing
;; region's representative.
(fn csp_schema_grammar () SkSchemaGrammar
  (SkSchemaGrammar
    0
    (list
      (SkSchemaEnt
        0
        (list
          (SkSchemaAlt
            (csp_pair (hole 0) (hole 1))
            (list (SkSchemaRef 0 0 1) (SkSchemaRef 1 1 1)))))
      (SkSchemaEnt
        1
        (list
          (SkSchemaAlt (csp_atom 0) Nil)
          (SkSchemaAlt (csp_atom 1) Nil)
          (SkSchemaAlt (csp_atom 2) Nil))))))

(fn csp_schema ((w World)) World
  (match
    (trs_rule
      (csp_diag_q (quote pair_refl_schema))
      (Cons (TCon (qn (quote Int)) Nil) Nil)
      (csp_pair (BVar 0) (BVar 0))
      (BVar 0))
    ((TrsRuleErr msg) (csp_fail msg w))
    ((TrsRuleOk rule)
     (match (trs_profile (Cons rule Nil))
       ((TrsProfileErr msg) (csp_fail msg w))
       ((TrsProfileOk profile)
        (match (trs_partition_formation profile)
          ((TrsProfileFormationErr msg) (csp_fail msg w))
          ((TrsProfileFormationOk projected)
           (match
             (ms_plan (trs_profile_residual projected) (trs_empty_root_profile))
             ((MsPlanErr msg) (csp_fail msg w))
             ((MsPlanOk plan)
              (match (sk_schema_wf (csp_schema_grammar))
                ((SkSchemaWfErr msg) (csp_fail msg w))
                ((SkSchemaWfOk)
                 (match
                   (su_find_query_schema
                     1000
                     (csp_empty_module)
                     (csp_diag_q (quote candidate))
                     (hole 0)
                     (hole 0)
                     plan
                     (IntLit 0)
                     (IntLit 0)
                     (csp_schema_grammar))
                   ((SuFindErr msg) (csp_fail msg w))
                   ((SuFindBudget _ _ _ _ _ _ _)
                    (csp_fail "schema diagonal budget" w))
                   ((SuFindEmpty _ _ _ _ _ _ _)
                    (csp_fail "schema diagonal came up empty" w))
                   ((SuFindFound killed constrained regions forks _ _ rep)
                    (if (int_eq killed 0)
                      (if (int_eq constrained 1)
                        (if (int_eq regions 2)
                          ;; The single-alternative root hole is transparent
                          ;; (ms_select chases a one-member domain), so the
                          ;; pair surfaces at the empty region: ONE split,
                          ;; no ground fork.
                          (if (int_eq forks 1)
                            (if
                              (expr_eq rep (csp_pair (csp_atom 0) (csp_atom 1)))
                              (write
                                "META-SEARCH-SUPERPOSE-PROBE SCHEMA-DIAG-SPLIT CONSTRAINED-1 REGIONS-2 FORKS-1 REP-NE OK\n"
                                w)
                              (csp_fail "schema diagonal representative" w))
                            (csp_fail "schema diagonal fork count" w))
                          (csp_fail "schema diagonal region count" w))
                        (csp_fail "schema diagonal constraint count" w))
                      (csp_fail "schema diagonal killed count" w)))))))))))))))

(fn csp_diag ((w World)) World
  (match
    (trs_rule
      (csp_diag_q (quote pair_refl))
      (Cons (TCon (qn (quote Int)) Nil) Nil)
      (csp_pair (BVar 0) (BVar 0))
      (BVar 0))
    ((TrsRuleErr msg) (csp_fail msg w))
    ((TrsRuleOk rule)
     (match (trs_profile (Cons rule Nil))
       ((TrsProfileErr msg) (csp_fail msg w))
       ((TrsProfileOk profile)
        (match (trs_partition_formation profile)
          ((TrsProfileFormationErr msg) (csp_fail msg w))
          ((TrsProfileFormationOk projected)
           (match
             (ms_plan (trs_profile_residual projected) (trs_empty_root_profile))
             ((MsPlanErr msg) (csp_fail msg w))
             ((MsPlanOk plan)
              (let ((grammar (csp_diag_grammar)))
                (let ((space (csp_pair (hole 0) (hole 1))))
                  (match (g_wf grammar)
                    ((GWErr msg) (csp_fail msg w))
                    ((GWOk)
                     (match
                       (csp_drive_region space plan grammar (sk_empty_region))
                       ((SuSOk found killed constrained regions forks _ sols)
                        (if (int_eq found 6)
                          (if (int_eq killed 3)
                            (if (int_eq constrained 3)
                              (if (int_eq regions 2)
                                (if (int_eq forks 1)
                                  (csp_diag_sol grammar space sols w)
                                  (csp_fail "diagonal fork count" w))
                                (csp_fail "diagonal region count" w))
                              (csp_fail "diagonal constraint count" w))
                            (csp_fail "diagonal killed count" w))
                          (csp_fail "diagonal found count" w)))
                       ((SuSErr msg) (csp_fail msg w))
                       ((SuSBudget _ _ _ _ _ _ _ _ _)
                        (csp_fail "diagonal drive budget" w))))))))))))))))

(fn csp_profile ((grammar Grammar) (w World)) World
  (match (msp_rule)
    ((TrsRuleErr msg) (csp_fail msg w))
    ((TrsRuleOk rule)
     (match (trs_profile (Cons rule Nil))
       ((TrsProfileErr msg) (csp_fail msg w))
       ((TrsProfileOk profile)
        (match (trs_partition_formation profile)
          ((TrsProfileFormationErr msg) (csp_fail msg w))
          ((TrsProfileFormationOk projected)
           (match
             (ms_plan (trs_profile_residual projected) (trs_empty_root_profile))
             ((MsPlanErr msg) (csp_fail msg w))
             ((MsPlanOk plan) (csp_clear plan grammar w))))))))))

(fn main ((w World)) World
  (let ((grammar (msp_grammar)))
    (match (g_wf grammar)
      ((GWErr msg) (csp_fail msg w))
      ((GWOk) (csp_profile grammar w)))))
