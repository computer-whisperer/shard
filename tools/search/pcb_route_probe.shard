;;; PCB routing demo: the first heuristic-tier driver.  Sequential net
;;; routing with rip-up/re-route over the EXACT engine as a library —
;;; su_find_query_schema is the inner maze solver (one net against an
;;; occupancy list), iterative deepening supplies shortest-first, and the
;;; model's bounded walk (Manhattan floor checked before the move list is
;;; demanded) gives admissible pruning through laziness alone.  Schema
;;; alternative order is the DFS branching heuristic (su_fork explores
;;; alt 0 first): each net's grammar leads with its toward-goal moves
;;; (pcbp_move_order), which accelerates FOUND and cannot touch EMPTY.
;;; The outer
;;; loop is the ratified LNS shape: greedy in queue order; on failure
;;; the failed net's DEEPEST census convicts a victim — b@CELL rows map
;;; to the routed net owning each cell (keepouts and the walk's own
;;; self-avoidance cells belong to nobody), kill counts sum per net,
;;; the heaviest blocker is ripped (w= on the RIP line; w=0 = nothing
;;; attributed, rip-oldest fallback), requeued at the back, and the
;;; failed net retries first; a rip cap bounds the loop.  Heuristic
;;; existence only: the final assignment is certified by a full replay
;;; — every route re-walks legally against the keepouts and the union
;;; of all cells is duplicate-free (pairwise disjointness follows).
;;;
;;; The board (8x8, single keepout at (4,2)) and nets are chosen so the
;;; naive order NEEDS one rip AND the oldest net is the WRONG victim: A
;;; (the decoy, (0,7)-(2,7) along the bottom edge) routes first and is
;;; uninvolved; F's shortest route (straight row 1) then eats cell
;;; (4,1) that R (the two-cell net (4,0)-(4,1)) must reach.  R's ladder
;;; census names F's row-1 cells, so the rip convicts F — rip-oldest
;;; would have burned a rip (and a re-route) on A first.  After the rip
;;; R takes its one-move route and F re-routes through row 3 at length
;;; 9 (slack 4: row 0 is blocked by R, row 2 by the keepout).  D is
;;; independent on the right edge.  Expected: NETS-4 RIPS-1 WIRE-14
;;; with RIP 9->14 w>0.
;;;
;;; SLACK ECONOMICS (measured, CI pipeline 182 full trace, on the
;;; WANDER-TREE model — pre-self-avoidance): a level explores a tree
;;; exponential in its SLACK (= depth minus the Manhattan floor; walks
;;; could revisit cells, the floor pruned only against remaining
;;; budget).  At ~1.4k evaluator steps/sec: slack-4 refutation ~29k
;;; steps, slack-6 ~156k, slack-8 ~783k to refute and >10M to NOT find
;;; (BUDGET give-up at 16k decisions).  That curve motivated making the
;;; model self-avoiding (walks thread their own cells into occupancy —
;;; see the model header for the loop-erasure completeness argument),
;;; which cuts branching to <= 3 and kills every loop.  MEASURED
;;; (pipeline 191 vs 184, same instance and budgets): per-slack-2
;;; refutation growth fell from ~x5-9 to ~x2.2-2.4 (R ladder
;;; 449/1724/3787/8600 steps at slack 0/2/4/6, was
;;; 449/3932/24383/130825), the slack-4 find fell 6.9x (328,796 ->
;;; 47,983 steps), the whole demo 550k -> 98k steps and the engine job
;;; 325s -> 135s; slack-0 calls pay a small pcb_mem tax for the longer
;;; occupancy (F d=5 FOUND: 1,933 -> 2,341).  GOAL-DIRECTED ORDERING
;;; MEASURED (pipeline 193 vs 191): every EMPTY line bit-identical
;;; (refutations are order-independent — the self-check), every FOUND
;;; cheaper — the slack-4 find 4.0x again (47,983 -> 12,054 steps,
;;; forks 62 -> 18), demo 98k -> 61k steps, job 135s -> 60s.  Hence the
;;; three sizing rules baked in here: (1) the instance keeps the forced
;;; detour at slack 4; (2) per-call budgets RAMP 1000*2^level — a
;;; level's give-up is sized to its slack, never one oversized cap
;;; (flat 500k = the ~67.6GB dev-box incident; flat 50k = the SAME
;;; structure-bound plateau on CI pipeline 174, 8h timeout, artifact
;;; lost); (3) the ladder deepens only on EMPTY — a true refutation
;;; licenses the next level, a BUDGET give-up stops the net (the next
;;; level is strictly bigger; pipeline 182 burned 20M of its 35M steps
;;; in post-BUDGET levels).  Every engine call logs one line to the
;;; World (net, depth, budget, outcome, steps, forks, and the
;;; refutation census — b@CELL rows attribute kills to blocking cells,
;;; floor/off/end@CELL rows account for the pruning bulk) so a hung
;;; run leaves evidence in the artifact and a failed ladder names its
;;; blockers.
;;;
;;; The model module is ALSO loaded at runtime (resolve_closure +
;;; build_module_d on the file path below) because the su evaluator
;;; resolves the query's pcb_walk call against a Module value.  Runtime
;;; path string — update it if the model file moves.
;;;
;;; RUN:  bin/shard_eval run tools/search/pcb_route_probe.shard

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/module.shard")
(import "../../kernel/reader.shard")
(import "../../kernel/loader.shard")
(import "../../kernel/driver.shard")
(import "../../meta/sketch")
(import "../../meta/rewrite")
(import "../../meta/search")
(import "superpose.shard")
(import "tasks/pcb_route_model.shard")
(use (:: kernel term *))
(use (:: kernel module *))
(use (:: kernel reader *))
(use (:: kernel loader *))
(use (:: kernel driver *))
(use (:: meta sketch *))
(use (:: meta rewrite *))
(use (:: meta search *))
(use (:: tools search superpose *))
(use (:: tools search tasks pcb_route_model *))

(fn pcbp_fail ((msg (List Int)) (w World)) World
  (exit 1 (write (append_int "PCB-ROUTE FAIL " (append_int msg "\n")) w)))

;; ---- the model module, twice: imported above for direct calls, loaded
;; ---- here for the su evaluator's query resolution ------------------------

(fn pcbp_model_file () (List Int) "tools/search/tasks/pcb_route_model.shard")

(fn pcbp_model_path () (List Symbol)
  (list (quote tools) (quote search) (quote tasks) (quote pcb_route_model)))

(fn pcbp_model_q ((name Symbol)) QName (QName (pcbp_model_path) name))

(fn pcbp_probe_q ((name Symbol)) QName
  (QName (list (quote tools) (quote search) (quote pcb_route_probe)) name))

(type PcbpLoadR (PcbpLoadErr (List Int)) (PcbpLoadOk Module))

(fn pcbp_build ((srcs (List SrcEntry))) PcbpLoadR
  (match
    (build_module_d
      srcs
      (Module Nil Nil Nil (FnTrie None Nil) Nil)
      (prelude_ctors)
      1)
    ((BMFail msg) (PcbpLoadErr msg))
    ((BMOk m) (PcbpLoadOk m))))

(fn pcbp_load ((w World)) (Pair PcbpLoadR World)
  (match (resolve_closure (pcbp_model_file) False w)
    ((Pair srcs w1)
     (match srcs
       (Nil (Pair (PcbpLoadErr "model closure is empty") w1))
       (_ (Pair (pcbp_build srcs) w1))))))

;; ---- the depth-bounded move-list schema grammar ---------------------------

(fn pcbp_move_alt ((name Symbol)) SkSchemaAlt
  (SkSchemaAlt (Ctor (pcbp_model_q name) Nil) Nil))

;; Goal-directed alternative order: the find loop is a LIFO stack and
;; su_fork pushes alternative 0 on top, so schema alt order IS the DFS
;; exploration order.  Toward-goal moves lead (the larger-|delta| axis
;; first), the move opposite the primary axis comes last.  Static per
;; net — the grammar tracks only remaining length, never the walk's
;; cell, so this is start->goal greedy, not per-step greedy.  Ordering
;; cannot change EMPTY costs (a refutation exhausts the tree in any
;; order); it only accelerates FOUND.
(fn pcbp_move_order ((start Int) (goal Int)) (List Symbol)
  (let ((dx (- (pcb_x goal) (pcb_x start))))
    (let ((dy (- (pcb_y goal) (pcb_y start))))
      (let ((tx (if (lt dx 0) (quote MvW) (quote MvE))))
        (let ((ax (if (lt dx 0) (quote MvE) (quote MvW))))
          (let ((ty (if (lt dy 0) (quote MvN) (quote MvS))))
            (let ((ay (if (lt dy 0) (quote MvS) (quote MvN))))
              (if (lt (pcb_abs dx) (pcb_abs dy)) (list ty tx ax ay)
              (list tx ty ay ax)))))))))

(fn pcbp_move_alts ((names (List Symbol))) (List SkSchemaAlt)
  (measure (struct names))
  (match names
    (Nil Nil)
    ((Cons h t) (Cons (pcbp_move_alt h) (pcbp_move_alts t)))))

(fn pcbp_move_ent ((id Int) (order (List Symbol))) SkSchemaEnt
  (SkSchemaEnt id (pcbp_move_alts order)))

(fn pcbp_nil_alt () SkSchemaAlt (SkSchemaAlt (Ctor (qn (quote Nil)) Nil) Nil))

(fn pcbp_cons_alt ((move_id Int) (tail_id Int)) SkSchemaAlt
  (SkSchemaAlt
    (Ctor (qn (quote Cons)) (list (hole 0) (hole 1)))
    (list (SkSchemaRef 0 0 move_id) (SkSchemaRef 1 1 tail_id))))

;; Entries ascending by id: list states 0..d (id = remaining length), the
;; move alphabet last at id d+1.
(fn pcbp_ents_up ((i Int) (d Int) (order (List Symbol))) (List SkSchemaEnt)
  (measure (- (+ d 1) i))
  (if (lt d i) (Cons (pcbp_move_ent (+ d 1) order) Nil)
  (Cons
    (if (lt i 1) (SkSchemaEnt 0 (Cons (pcbp_nil_alt) Nil))
    (SkSchemaEnt i (list (pcbp_nil_alt) (pcbp_cons_alt (+ d 1) (- i 1)))))
    (pcbp_ents_up (+ i 1) d order))))

(fn pcbp_grammar ((d Int) (order (List Symbol))) SkSchemaGrammar
  (SkSchemaGrammar d (pcbp_ents_up 0 d order)))

;; ---- query construction ---------------------------------------------------

(fn pcbp_int_list_expr ((xs (List Int))) Expr
  (measure (struct xs))
  (match xs
    (Nil (Ctor (qn (quote Nil)) Nil))
    ((Cons h t)
     (Ctor (qn (quote Cons)) (list (IntLit h) (pcbp_int_list_expr t))))))

(fn pcbp_query ((occ (List Int)) (goal Int) (d Int) (start Int)) Expr
  (Call
    (pcbp_model_q (quote pcb_walk))
    (list
      (pcbp_int_list_expr occ)
      (IntLit goal)
      (IntLit d)
      (IntLit start)
      (hole 0))))

(fn pcbp_want ((goal Int)) Expr
  (Ctor (pcbp_model_q (quote WalkAt)) (Cons (IntLit goal) Nil)))

(fn pcbp_find
  ((m Module) (occ (List Int)) (start Int) (goal Int) (d Int) (budget Int))
  SuFind
  (su_find_query_schema
    budget
    m
    (pcbp_probe_q (quote candidate))
    (hole 0)
    (hole 0)
    (ms_empty_plan)
    (pcbp_query occ goal d start)
    (pcbp_want goal)
    (pcbp_grammar d (pcbp_move_order start goal))))

;; ---- representative decoding ----------------------------------------------

(fn pcbp_decode_move ((e Expr)) (Option PMove)
  (match e
    ((Ctor q args)
     (match args
       ((Cons _ _) None)
       (Nil
         (if (qname_eq q (pcbp_model_q (quote MvN))) (Some (MvN))
         (if (qname_eq q (pcbp_model_q (quote MvE))) (Some (MvE))
         (if (qname_eq q (pcbp_model_q (quote MvS))) (Some (MvS))
         (if (qname_eq q (pcbp_model_q (quote MvW))) (Some (MvW))
         None)))))))
    (_ None)))

(fn pcbp_decode ((e Expr)) (Option (List PMove))
  (measure (struct e))
  (match e
    ((Ctor q args)
     (match args
       (Nil (if (qname_eq q (qn (quote Nil))) (Some Nil) None))
       ((Cons h rest0)
        (match rest0
          (Nil None)
          ((Cons t rest1)
           (match rest1
             ((Cons _ _) None)
             (Nil
               (if (qname_eq q (qn (quote Cons)))
                 (match (pcbp_decode_move h)
                   (None None)
                   ((Some mv)
                    (match (pcbp_decode t)
                      (None None)
                      ((Some moves) (Some (Cons mv moves))))))
                 None))))))))
    (_ None)))

;; ---- iterative deepening per net ------------------------------------------

;; A failed ladder hands its DEEPEST call's census to the rip loop —
;; the widest exploration carries the richest blocking attribution.
(type PcbNetR
  (PcbNetErr (List Int))
  (PcbNetNone SuCensus)
  (PcbNetRoute (List PMove) (List Int) Int))

;; The base of the per-level budget ramp; level ell runs at
;; (pcbp_budget0) * 2^ell steps.
(fn pcbp_budget0 () Int 1000)

(fn pcbp_len_moves ((moves (List PMove))) Int
  (measure (struct moves))
  (match moves
    (Nil 0)
    ((Cons _ t) (+ 1 (pcbp_len_moves t)))))

;; The census formatter: WalkBlocked rows carry the blocking cell
;; (b@CELL:kills) — the raw material for conflict-directed rip victim
;; selection; floor/off/end@CELL/fail rows account for the rest of the
;; kill volume.
(fn pcbp_ck_tag ((k SuCensusKey)) (List Int)
  (match k
    ((SuCkFail) "fail")
    ((SuCkSym _) "sym")
    ((SuCkInt c) (append_int "end@" (show_int c)))
    ((SuCkHead q f)
     (if (qname_eq q (pcbp_model_q (quote WalkBlocked)))
       (match f
         ((Some c) (append_int "b@" (show_int c)))
         (None "b@?"))
     (if (qname_eq q (pcbp_model_q (quote WalkFloor))) "floor"
     (if (qname_eq q (pcbp_model_q (quote WalkOff))) "off"
     "?"))))))

(fn pcbp_census_rows_str ((rows (List (Pair SuCensusKey Int)))) (List Int)
  (measure (struct rows))
  (match rows
    (Nil "")
    ((Cons (Pair k n) rest)
     (append_int
       " "
       (append_int
         (pcbp_ck_tag k)
         (append_int ":" (append_int (show_int n) (pcbp_census_rows_str rest))))))))

(fn pcbp_census_str ((census SuCensus)) (List Int)
  (match census
    ((SuCensus rows spilled)
     (append_int
       " census["
       (append_int
         (pcbp_census_rows_str rows)
         (if (lt 0 spilled)
           (append_int " +" (append_int (show_int spilled) "]"))
           "]"))))))

;; One streamed line per engine call: a hung run must leave evidence.
(fn pcbp_log_call
  ((start Int)
   (goal Int)
   (d Int)
   (budget Int)
   (tag (List Int))
   (steps Int)
   (forks Int)
   (census SuCensus)
   (w World))
  World
  (write
    (append_int
      "NET "
      (append_int
        (show_int start)
        (append_int
          "->"
          (append_int
            (show_int goal)
            (append_int
              " d="
              (append_int
                (show_int d)
                (append_int
                  " b="
                  (append_int
                    (show_int budget)
                    (append_int
                      " "
                      (append_int
                        tag
                        (append_int
                          " steps="
                          (append_int
                            (show_int steps)
                            (append_int
                              " forks="
                              (append_int
                                (show_int forks)
                                (append_int (pcbp_census_str census) "\n")))))))))))))))
    w))

(fn pcbp_log_routed ((start Int) (goal Int) (d Int) (len Int) (w World)) World
  (write
    (append_int
      "ROUTED "
      (append_int
        (show_int start)
        (append_int
          "->"
          (append_int
            (show_int goal)
            (append_int
              " d="
              (append_int
                (show_int d)
                (append_int " len=" (append_int (show_int len) "\n"))))))))
    w))

;; w= is the census blocking weight that convicted the victim; w=0
;; means no routed net owned any blocking cell — rip-oldest fallback.
(fn pcbp_log_rip ((start Int) (goal Int) (wt Int) (w World)) World
  (write
    (append_int
      "RIP "
      (append_int
        (show_int start)
        (append_int
          "->"
          (append_int
            (show_int goal)
            (append_int " w=" (append_int (show_int wt) "\n"))))))
    w))

(fn pcbp_deepen
  ((m Module)
   (occ (List Int))
   (start Int)
   (goal Int)
   (d Int)
   (levels Int)
   (budget Int)
   (last SuCensus)
   (w World))
  (Pair PcbNetR World)
  (measure levels)
  (if (lt levels 1) (Pair (PcbNetNone last) w)
  (match (pcbp_find m occ start goal d budget)
    ((SuFindErr msg) (Pair (PcbNetErr msg) w))
    ((SuFindFound _ _ _ forks _ steps _ rep census)
     (let
       ((w2 (pcbp_log_call start goal d budget "FOUND" steps forks census w)))
       (match (pcbp_decode rep)
         (None (Pair (PcbNetErr "undecodable representative") w2))
         ((Some moves) (Pair (PcbNetRoute moves (pcb_cells start moves) d) w2)))))
    ((SuFindEmpty _ _ _ forks _ steps _ _ census)
     (pcbp_deepen
       m
       occ
       start
       goal
       (+ d 2)
       (- levels 1)
       (* 2 budget)
       census
       (pcbp_log_call start goal d budget "EMPTY" steps forks census w)))
    ((SuFindBudget _ _ _ forks _ steps _ _ census)
     (Pair
       (PcbNetNone census)
       (pcbp_log_call start goal d budget "BUDGET-STOP" steps forks census w))))))

;; ---- the rip-up / re-route loop -------------------------------------------

(type PcbNet (PcbNet Int Int))

(type PcbRouted (PcbRouted PcbNet (List PMove) (List Int)))

(type PcbAllR (PcbAllErr (List Int)) (PcbAllOk (List PcbRouted) Int))

(fn pcbp_app_cells ((a (List Int)) (b (List Int))) (List Int)
  (measure (struct a))
  (match a
    (Nil b)
    ((Cons h t) (Cons h (pcbp_app_cells t b)))))

(fn pcbp_app_nets ((a (List PcbNet)) (b (List PcbNet))) (List PcbNet)
  (measure (struct a))
  (match a
    (Nil b)
    ((Cons h t) (Cons h (pcbp_app_nets t b)))))

(fn pcbp_app_routed ((a (List PcbRouted)) (b (List PcbRouted))) (List PcbRouted)
  (measure (struct a))
  (match a
    (Nil b)
    ((Cons h t) (Cons h (pcbp_app_routed t b)))))

(fn pcbp_routed_cells ((rs (List PcbRouted))) (List Int)
  (measure (struct rs))
  (match rs
    (Nil Nil)
    ((Cons (PcbRouted _ _ cells) rest)
     (pcbp_app_cells cells (pcbp_routed_cells rest)))))

(fn pcbp_levels () Int 4)

;; ---- census-directed victim selection -------------------------------------
;; WalkBlocked census rows -> (cell, kills).  Self-avoidance kills
;; attribute to the walk's OWN cells, which are unoccupied by
;; construction and so never belong to a routed net — the ownership
;; scan excludes them without any special case.
(fn pcbp_census_blockers ((rows (List (Pair SuCensusKey Int))))
  (List (Pair Int Int))
  (measure (struct rows))
  (match rows
    (Nil Nil)
    ((Cons (Pair k n) rest)
     (match k
       ((SuCkHead q f)
        (if (qname_eq q (pcbp_model_q (quote WalkBlocked)))
          (match f
            ((Some c) (Cons (Pair c n) (pcbp_census_blockers rest)))
            (None (pcbp_census_blockers rest)))
          (pcbp_census_blockers rest)))
       (_ (pcbp_census_blockers rest))))))

(fn pcbp_cells_weight ((cells (List Int)) (blockers (List (Pair Int Int)))) Int
  (measure (struct blockers))
  (match blockers
    (Nil 0)
    ((Cons (Pair c n) rest)
     (+ (if (pcb_mem c cells) n 0) (pcbp_cells_weight cells rest)))))

;; Best = strictly-greater weight displaces, so the OLDEST net wins
;; ties and a zero-weight scan leaves bestix at 0 (= rip-oldest
;; fallback when the census attributes nothing to any routed net).
(fn pcbp_best_victim_ix
  ((rs (List PcbRouted))
   (blockers (List (Pair Int Int)))
   (ix Int)
   (bestw Int)
   (bestix Int))
  (Pair Int Int)
  (measure (struct rs))
  (match rs
    (Nil (Pair bestw bestix))
    ((Cons (PcbRouted _ _ cells) rest)
     (let ((wt (pcbp_cells_weight cells blockers)))
       (if (lt bestw wt) (pcbp_best_victim_ix rest blockers (+ ix 1) wt ix)
       (pcbp_best_victim_ix rest blockers (+ ix 1) bestw bestix))))))

(fn pcbp_remove_ix ((rs (List PcbRouted)) (ix Int))
  (Option (Pair PcbRouted (List PcbRouted)))
  (measure (struct rs))
  (match rs
    (Nil None)
    ((Cons h t)
     (if (lt ix 1) (Some (Pair h t))
     (match (pcbp_remove_ix t (- ix 1))
       (None None)
       ((Some (Pair v rest)) (Some (Pair v (Cons h rest)))))))))

(fn pcbp_route_all
  ((m Module)
   (keep (List Int))
   (queue (List PcbNet))
   (routed (List PcbRouted))
   (rips Int)
   (fuel Int)
   (w World))
  (Pair PcbAllR World)
  (measure fuel)
  (if (lt fuel 1) (Pair (PcbAllErr "rip cap exceeded") w)
  (match queue
    (Nil (Pair (PcbAllOk routed rips) w))
    ((Cons net rest)
     (match net
       ((PcbNet start goal)
        (match
          (pcbp_deepen
            m
            (pcbp_app_cells keep (pcbp_routed_cells routed))
            start
            goal
            (pcb_manhattan start goal)
            (pcbp_levels)
            (pcbp_budget0)
            (su_census_empty)
            w)
          ((Pair (PcbNetErr msg) w2) (Pair (PcbAllErr msg) w2))
          ((Pair (PcbNetRoute moves cells d) w2)
           (pcbp_route_all
             m
             keep
             rest
             (pcbp_app_routed routed (Cons (PcbRouted net moves cells) Nil))
             rips
             (- fuel 1)
             (pcbp_log_routed start goal d (pcbp_len_moves moves) w2)))
          ((Pair (PcbNetNone census) w2)
           (match routed
             (Nil
               (Pair (PcbAllErr "infeasible: unroutable with empty board") w2))
             ((Cons _ _)
              (match census
                ((SuCensus rows _)
                 (match
                   (pcbp_best_victim_ix
                     routed
                     (pcbp_census_blockers rows)
                     0
                     0
                     0)
                   ((Pair bw bix)
                    (match (pcbp_remove_ix routed (if (lt 0 bw) bix 0))
                      (None (Pair (PcbAllErr "victim index out of range") w2))
                      ((Some (Pair victim remaining))
                       (match victim
                         ((PcbRouted vnet _ _)
                          (match vnet
                            ((PcbNet ostart ogoal)
                             (pcbp_route_all
                               m
                               keep
                               (Cons net (pcbp_app_nets rest (Cons vnet Nil)))
                               remaining
                               (+ rips 1)
                               (- fuel 1)
                               (pcbp_log_rip ostart ogoal bw w2))))))))))))))))))))))

;; ---- the certificate: full replay ----------------------------------------

(fn pcbp_dup_free ((xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons h t) (if (pcb_mem h t) False (pcbp_dup_free t)))))

(fn pcbp_replay_ok ((keep (List Int)) (rs (List PcbRouted))) Bool
  (measure (struct rs))
  (match rs
    (Nil True)
    ((Cons (PcbRouted (PcbNet start goal) moves _) rest)
     (match (pcb_walk keep goal (pcbp_len_moves moves) start moves)
       ((WalkAt c) (if (int_eq c goal) (pcbp_replay_ok keep rest) False))
       (_ False)))))

(fn pcbp_wire ((rs (List PcbRouted))) Int
  (measure (struct rs))
  (match rs
    (Nil 0)
    ((Cons (PcbRouted _ moves _) rest)
     (+ (pcbp_len_moves moves) (pcbp_wire rest)))))

;; ---- the board instance ---------------------------------------------------

(fn pcbp_keepouts () (List Int) (list 20))

(fn pcbp_nets () (List PcbNet)
  (list (PcbNet 56 58) (PcbNet 9 14) (PcbNet 4 12) (PcbNet 39 55)))

(fn pcbp_report ((rips Int) (wire Int) (w World)) World
  (write
    (append_int
      "PCB-ROUTE 8x8 KEEP-1 NETS-4 RIPS-"
      (append_int
        (show_int rips)
        (append_int " WIRE-" (append_int (show_int wire) " CERT-DISJOINT-OK\n"))))
    w))

(fn pcbp_run ((m Module) (w World)) World
  (match (pcbp_route_all m (pcbp_keepouts) (pcbp_nets) Nil 0 12 w)
    ((Pair (PcbAllErr msg) w2) (pcbp_fail msg w2))
    ((Pair (PcbAllOk routed rips) w2)
     (if
       (pcbp_dup_free
         (pcbp_app_cells (pcbp_keepouts) (pcbp_routed_cells routed)))
       (if (pcbp_replay_ok (pcbp_keepouts) routed)
         (pcbp_report rips (pcbp_wire routed) w2)
         (pcbp_fail "certificate: replay rejected a route" w2))
       (pcbp_fail "certificate: overlapping cells" w2)))))

(fn main ((w World)) World
  (match (pcbp_load w)
    ((Pair (PcbpLoadErr msg) w1) (pcbp_fail msg w1))
    ((Pair (PcbpLoadOk m) w1) (pcbp_run m w1))))
