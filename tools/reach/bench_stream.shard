;;; bench_stream — the LS-law 3 benchmark, engine backend:
;;; std/sha256/sha256.stream alone. The LS4-iii refire topology after
;;; CI 323 spent its full 20h inside this file (19 open goals on the
;;; machine-tier theory, the corpus's heaviest) and landed ZERO output
;;; under the old per-file write. Single file per fire + per-goal
;;; streaming: a cut lands every finished goal; a continuation fire
;;; (reach_all_engine_skip) resumes at the cut point. Budgets =
;;; reach.shard's census-grade constants, identical across all fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench_stream_targets () (List (List Int))
  (Cons "std/sha256/sha256.stream.shard" Nil))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_stream_targets) w)))
