;;; bench_stream2 — the LS-law 3 benchmark, engine backend: the
;;; sha256.stream CONTINUATION fire (the skip machinery's first use).
;;; CI 338 streamed 24 of the file's 30 goals (+6 D-ladder closes, the
;;; shc_ chunk-list family) then died on `rt trap: heap exhausted` —
;;; the runtime heap, not the watchdog. skip 24 = the REACH lines
;;; already landed; the remainder is the six heavy correspondence
;;; goals (blocks_split/blocks_prefix/step_abs/fin_abs/stream_gen/
;;; sha_stream_corresponds), each a fresh-heap run. Budgets =
;;; reach.shard's census-grade constants, identical across all fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine_skip))

(fn bench_stream2_targets () (List (Pair (List Int) Int))
  (Cons (Pair "std/sha256/sha256.stream.shard" 24) Nil))

(fn main ((w World)) World
  (exit 0 (reach_all_engine_skip (bench_stream2_targets) w)))
