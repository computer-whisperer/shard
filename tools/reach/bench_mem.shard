;;; bench_mem — the LS-law 3 benchmark, engine backend: std/mem alone.
;;; The LS4-iii refire topology after CI 320 spent ~18h inside mem
;;; without completing it (21 open goals; the original three-way split
;;; was calibrated on LS4-i costs). Single file per fire + per-goal
;;; streaming output: a watchdog cut still lands every finished goal,
;;; and a continuation fire (reach_all_engine_skip) picks up at the cut
;;; point. Budgets = reach.shard's census-grade constants, identical
;;; across all LS4-iii fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench_mem_targets () (List (List Int)) (Cons "std/mem/mem.shard" Nil))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_mem_targets) w)))
