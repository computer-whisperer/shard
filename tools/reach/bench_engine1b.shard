;;; bench_engine1b — the LS-law 3 benchmark, engine backend, FIRE 1b:
;;; the make-up run for tools/search/gen/imp_mix_refinement.shard, the
;;; 12th file of FIRE 1 (bench_engine.shard), which CI 317's watchdog
;;; cut before it ran. Three goals (2 closed in LS4-i, searched_mix_wasm
;;; open). Budgets = reach.shard's census-grade constants, identical to
;;; the other fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench1b_targets () (List (List Int))
  (Cons "tools/search/gen/imp_mix_refinement.shard" Nil))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench1b_targets) w)))
