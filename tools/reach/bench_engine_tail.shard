;;; bench_engine_tail — the LS4-i benchmark's TAIL (the five files CI 299's
;;; 12h watchdog cut; SEARCH.md LS4-i record). Gate-relevant material =
;;; word/stream/reader/wasm_rev (~86 ladder goals); std/float kit is LAST
;;; deliberately — it contributes ZERO gate-relevant goals (its sidecar is
;;; measure-keyed only: no ladder members, no far tier), so a watchdog cut
;;; there costs only far-horizon telemetry. Budgets = reach.shard's
;;; census-grade constants, identical to the head run.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench_tail_targets () (List (List Int))
  (Cons
    "std/sha256/sha256.stream.shard"
    (Cons
      "std/word/word.shard"
      (Cons
        "kernel/reader.shard"
        (Cons
          "models/wasm/probes/wasm_rev.shard"
          (Cons "std/float/mod.req/kit.shard" Nil))))))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_tail_targets) w)))
