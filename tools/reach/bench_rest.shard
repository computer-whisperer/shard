;;; bench_rest — the LS-law 3 benchmark, engine backend: the remaining
;;; heavy-tier files after the LS4-iii refire split (bench_mem,
;;; bench_stream). Cheap-first order (the LS4-i first-fire lesson):
;;; sha256 (3 opens), kernel/reader (2), wasm_rev (3), word (6 opens +
;;; ~80 cheap closes), float kit LAST (zero gate goals — a watchdog cut
;;; there costs only far-horizon telemetry). Per-goal streaming means a
;;; cut lands everything finished. Budgets = reach.shard's census-grade
;;; constants, identical across all fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench_rest_targets () (List (List Int))
  (Cons
    "std/sha256/sha256.shard"
    (Cons
      "kernel/reader.shard"
      (Cons
        "models/wasm/probes/wasm_rev.shard"
        (Cons "std/word/word.shard" (Cons "std/float/mod.req/kit.shard" Nil))))))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_rest_targets) w)))
