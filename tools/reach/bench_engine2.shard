;;; bench_engine2 — the LS-law 3 benchmark, engine backend, FIRE 2 of 3
;;; (LS4-iii's three-way split; see bench_engine.shard). The heavy mid
;;; files — big theories, few open induction-shaped goals. Budgets are
;;; the census-grade constants in reach.shard.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

(fn bench2_targets () (List (List Int))
  (Cons
    "std/bytes/bytes.shard"
    (Cons "std/mem/mem.shard" (Cons "std/sha256/sha256.shard" Nil))))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench2_targets) w)))
