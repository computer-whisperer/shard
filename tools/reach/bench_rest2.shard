;;; bench_rest2 — the LS-law 3 benchmark, engine backend: the rest
;;; CONTINUATION fire. CI 339's 22h watchdog cut mid-wasm_rev (14 of 15
;;; goals streamed; sha256 + reader complete, +1 close, 0 lost); word
;;; and kit never ran. Resume: wasm_rev skip 14 (the remainder is
;;; rev8_reverses), then word (the ladder's ~80 unmeasured members),
;;; kit LAST (zero gate goals — a cut there costs only far-horizon
;;; telemetry). Budgets = reach.shard's census-grade constants,
;;; identical across all fires.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine_skip))

(fn bench_rest2_targets () (List (Pair (List Int) Int))
  (Cons
    (Pair "models/wasm/probes/wasm_rev.shard" 14)
    (Cons
      (Pair "std/word/word.shard" 0)
      (Cons (Pair "std/float/mod.req/kit.shard" 0) Nil))))

(fn main ((w World)) World
  (exit 0 (reach_all_engine_skip (bench_rest2_targets) w)))
