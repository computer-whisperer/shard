;;; bench_engine — the LS-law 3 benchmark, engine backend, FIRE 1 of 3
;;; (lock-step arc LS4-i; LS4-iii split the 20-file benchmark into three
;;; parallel fires so each stays well under the 24h job timeout with the
;;; branch orchestrator's bigger per-goal pool). This fire = the twelve
;;; light-theory files — where the open induction-shaped (D) goals
;;; concentrate. Fire 2 = bench_engine2 (bytes/mem/sha256, the heavy mid
;;; files); fire 3 = bench_engine_tail (stream/word/reader/wasm_rev/kit).
;;; Budgets are the census-grade constants in reach.shard; the official
;;; record states them with the run.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

;; CHEAP-FIRST ORDER (post-CI-288 lesson): reach writes stream per file,
;; so a watchdog-killed run still yields every COMPLETED file.
(fn bench_targets () (List (List Int))
  (Cons
    "std/div/div.shard"
    (Cons
      "std/map/map.shard"
      (Cons
        "std/nat/nat.shard"
        (Cons
          "std/rng/rng.shard"
          (Cons
            "std/arith/arith.shard"
            (Cons
              "std/str/str.shard"
              (Cons
                "std/str/utf8.shard"
                (Cons
                  "std/list/list.shard"
                  (Cons
                    "pins/proof/adq13_probe.shard"
                    (Cons
                      "pins/proof/auto_demo.shard"
                      (Cons
                        "pins/proof/prove_cond_mine.shard"
                        (Cons "tools/search/gen/imp_mix_refinement.shard" Nil)))))))))))))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_targets) w)))
