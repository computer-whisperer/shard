;;; bench_engine — the LS-law 3 benchmark, engine backend (lock-step arc
;;; LS4-i). Runs tools/reach's engine mode over the ratified 20-file
;;; benchmark (the LS2 corpus, SEARCH.md LS2 RECORD) in one self-contained
;;; invocation, so the CI engine-run job (bin/shard_eval run FILE, no
;;; args) can fire it directly. Run from the repo root. Budgets are the
;;; census-grade constants in reach.shard (rch_e_depth / rch_e_pops /
;;; rch_e_divs); the official record states them with the run.

(import "reach.shard")

(use (:: kernel loader World))
(use (:: kernel loader exit))
(use (:: tools reach reach reach_all_engine))

;; CHEAP-FIRST ORDER (post-CI-288 lesson): reach writes stream per file,
;; so a watchdog-killed run still yields every COMPLETED file — put the
;; small-theory files first and the measured sinks (big-expr, big-theory:
;; wasm_rev, word, kernel/reader, float kit) at the tail.
(fn bench_targets () (List (List Int))
  (Cons
    "std/div/div.shard"
    (Cons
      "std/map/map.shard"
      (Cons
        "std/nat/nat.shard"
        (Cons
          "std/rng/rng.shard"
          (Cons
            "std/arith/arith.shard"
            (Cons
              "std/str/str.shard"
              (Cons
                "std/str/utf8.shard"
                (Cons
                  "std/list/list.shard"
                  (Cons
                    "pins/proof/adq13_probe.shard"
                    (Cons
                      "pins/proof/auto_demo.shard"
                      (Cons
                        "pins/proof/prove_cond_mine.shard"
                        (Cons
                          "tools/search/gen/imp_mix_refinement.shard"
                          (Cons
                            "std/bytes/bytes.shard"
                            (Cons
                              "std/mem/mem.shard"
                              (Cons
                                "std/sha256/sha256.shard"
                                (Cons
                                  "std/sha256/sha256.stream.shard"
                                  (Cons
                                    "std/word/word.shard"
                                    (Cons
                                      "kernel/reader.shard"
                                      (Cons
                                        "models/wasm/probes/wasm_rev.shard"
                                        (Cons "std/float/mod.req/kit.shard" Nil)))))))))))))))))))))

(fn main ((w World)) World (exit 0 (reach_all_engine (bench_targets) w)))
