;;; tools/digest/fixtures/sample.shard — the digest tool's pin subject: one
;;; small checkable file exercising every top-level head the digest treats
;;; specially (fn with and without a measure clause, claim) and the heads it
;;; passes through whole (type, record, import, use), with header comments,
;;; a section banner, per-definition doc blocks, and trailing comments.
;;; The committed digests sample_d1_out.shard / sample_d2_out.shard are the
;;; regen contract: run_corpus.sh re-derives both and byte-compares.

(import "../../../kernel/stdlib.shard")  ; List / Option / Bool

;; ===========================================================================
;; a type, a record, and two fns
;; ===========================================================================

(type Shape (Dot) (Box Int Int))  ; a nullary and a binary ctor

(record Pt (x Int) (y Int))

;; the area of a shape: 0 for a dot, w*h for a box
(sig fn area ((s Shape)) Int)  ; body 15

;; structural recursion with a measure clause — the digest drops the clause
;; along with the body
(sig fn sum_areas ((ss (List Shape))) Int)  ; body 24

;; ---- claims: the goal stays, the proof goes ----

;; the area of a 2x3 box, by computation
(claim area_box (goal () () (= (area (Box 2 3)) 6)))  ; proof 7

(claim sum_two (goal () () (= (sum_areas (Cons (Box 2 3) (Cons Dot Nil))) 6)))  ; proof 7
