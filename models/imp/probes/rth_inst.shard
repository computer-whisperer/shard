;; --- scenario 4: rt_alloc's two landing legs ---

(claim s4_bump_hr
  (goal ((m Mem)) ((= (heap_rep m 0 (gh_init 152 4096)) True))
    (=
      (heap_rep
        (m_alloc m 0 (gh_init 152 4096) 5 1)
        0
        (gh_alloc (gh_init 152 4096) 5 1))
      True))
  (rewrite-with
    (lemma hr_alloc)
    lr
    lhs
    ((inst r Nil))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s4_bump_rth
  (goal ((m Mem) (fs (List IpFn)) (fuel Nat))
    ((= (heap_rep m 0 (gh_init 152 4096)) True))
    (=
      (ipcall
        (nS 12 (ntl 12 fuel))
        (rt_app (rt_fns 0) fs)
        0
        4096
        8
        0
        1
        (Cons 5 (Cons 1 Nil))
        m)
      (Some
        (IpRv
          (gtop_of (gh_init 152 4096))
          (m_abump m 0 (gtop_of (gh_init 152 4096)) 1 5)))))
  (rewrite-with
    (lemma rth_alloc_bump_run)
    lr
    lhs
    ((inst g (gh_init 152 4096)) (inst r Nil))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s4_pop_hr
  (goal ((m Mem)) ((= (heap_rep m 0 (gh_dec (s4_pop_g0) 152)) True))
    (=
      (heap_rep
        (m_alloc m 0 (gh_dec (s4_pop_g0) 152) 7 1)
        0
        (gh_alloc (gh_dec (s4_pop_g0) 152) 7 1))
      True))
  (rewrite-with
    (lemma hr_alloc)
    lr
    lhs
    ((inst r Nil))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s4_pop_rth
  (goal ((m Mem) (fs (List IpFn)) (fuel Nat))
    ((= (heap_rep m 0 (gh_dec (s4_pop_g0) 152)) True))
    (=
      (ipcall
        (nS 12 (ntl 12 fuel))
        (rt_app (rt_fns 0) fs)
        0
        4096
        8
        0
        1
        (Cons 7 (Cons 1 Nil))
        m)
      (Some (IpRv 152 (m_apop m 0 1 (hhead Nil) 152 7)))))
  (rewrite-with
    (lemma rth_alloc_pop_run)
    lr
    lhs
    ((inst g (gh_dec (s4_pop_g0) 152))
     (inst r Nil)
     (inst p 152)
     (inst rest Nil))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

