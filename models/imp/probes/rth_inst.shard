;;; rth_inst — THE INSTANCE (COVERAGE.md C2b-6): rt_run's scenarios re-derived
;;; FROM THE LAWS in check mode.  rth_run pins the bytes at run time; this file
;;; applies the C2b laws (rth_*_run / hr_* / hinv_*) at the same concrete
;;; ghosts, with every ghost-side premise (hinv at the scenario's roots, the raw
;;; cell, the free list, the bounds) decided by compute and the memory premise
;;; left free — so for ANY memory that represents the scenario's ghost, the
;;; runtime call's result and the representation after it are the laws'
;;; instances, not the evaluator's.  The fuel towers stay symbolic (a bound,
;;; never a count).  Whole-program composition (the harness's iprun over the
;;; scenario's statement list) is B-1's per-fn generator, not this file.

(import "../../../kernel/stdlib.shard")
(import "../../../std/mem")
(use (:: std mem *))
(import "../../../std/nat")
(use (:: std nat *))
(import "../imp.shard")
(use (:: models imp imp *))
(import "../rt.shard")
(use (:: models imp rt *))
(import "rth_kit.shard")
(use (:: models imp probes rth_kit *))
(import "rth_run.shard")
(use (:: models imp probes rth_run *))

;; --- scenario 0 (every scenario's prologue): rt_init 152 4096 on any memory ---

(claim s0_hr_init
  (goal ((m Mem)) ()
    (= (heap_rep (m_init m 0 152 4096) 0 (gh_init 152 4096)) True))
  (rewrite-with
    (lemma hr_init)
    lr
    lhs
    ()
    ((steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s0_rth_init
  (goal ((m Mem) (fs (List IpFn)) (fuel Nat)) ()
    (=
      (ipcall
        (nS 21 (ntl 21 fuel))
        (rt_app (rt_fns 0) fs)
        0
        4096
        8
        0
        0
        (Cons 152 (Cons 4096 Nil))
        m)
      (Some (IpRv 0 (m_init m 0 152 4096)))))
  (rewrite-with
    (lemma rth_init_run)
    lr
    lhs
    ()
    ((steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

;; --- scenario 1: the chain c -> b -> a, one root (c = 184); dec c cascades all three ---

(claim s1_hinv
  (goal () () (= (hinv 0 (s1_g0) (Cons 184 Nil)) True))
  (steps ((compute lhs)) refl))

(claim s1_hr_dec
  (goal ((m Mem)) ((= (heap_rep m 0 (s1_g0)) True))
    (= (heap_rep (m_dec m 0 (s1_g0) 184) 0 (gh_dec (s1_g0) 184)) True))
  (rewrite-with
    (lemma hr_dec)
    lr
    lhs
    ((inst r (Cons 184 Nil)))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s1_rth_dec
  (goal ((m Mem) (fs (List IpFn)) (f0 Nat)) ((= (heap_rep m 0 (s1_g0)) True))
    (=
      (ipcall
        (nS (+ (+ (hlen (gcells_of (s1_g0))) 1) 65573) f0)
        (rt_app (rt_fns 0) fs)
        0
        4096
        8
        0
        3
        (Cons 184 Nil)
        m)
      (Some (IpRv 0 (m_dec m 0 (s1_g0) 184)))))
  (rewrite-with
    (lemma rth_dec_run)
    lr
    lhs
    ((inst r (Cons 184 Nil)))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

(claim s1_hinv_dec
  (goal () () (= (hinv 0 (gh_dec (s1_g0) 184) (irem (Cons 184 Nil) 184)) True))
  (rewrite-with
    (lemma hinv_dec)
    lr
    lhs
    ()
    ((steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl)
     (steps ((compute lhs)) refl))
    refl))

