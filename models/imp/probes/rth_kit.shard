;; --- THE INC LAW --------------------------------------------------------------------
;; the one exported equation: over a valid word (slot_ok — an immediate or
;; a live address) rt_inc returns 0 and leaves m_inc; B splits as gh_inc does

(claim rth_inc_run
  (goal
    ((fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (m Mem)
     (v Int)
     (fuel Nat))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (slot_ok v (haddrs (gcells_of g))) True)
     (= (le 0 v) True)
     (= (lt v 18446744073709551616) True)
     (= (le mlo rb) True)
     (= (le (gend_of g) msz) True)
     (= (lt d dmax) True))
    (=
      (ipcall
        (nS 12 (ntl 12 fuel))
        (rt_app (rt_fns rb) fs)
        mlo
        msz
        dmax
        d
        2
        (Cons v Nil)
        m)
      (Some (IpRv 0 (m_inc m g v)))))
  (case-on (int_eq (mod v 2) 1) Bool
    ((case True
       (chain
         (have hodd (= (int_eq (mod v 2) 1) True)
           (steps ((rewrite (hyp True) lr lhs true ())) refl))
         (have hmi (= (m_inc m g v) m)
           (rewrite-with
             (lemma m_inc_imm)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hodd) lr lhs true ())) refl))
             refl))
         (have hleg
           (=
             (ipcall
               (nS 12 (ntl 12 fuel))
               (rt_app (rt_fns rb) fs)
               mlo
               msz
               dmax
               d
               2
               (Cons v Nil)
               m)
             (Some (IpRv 0 m)))
           (rewrite-with
             (lemma rth_inc_imm_run)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hodd) lr lhs true ())) refl)
              (steps ((rewrite (premise 3) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl)
              (steps ((rewrite (premise 7) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (premise hmi) lr rhs true ())
            (rewrite (premise hleg) lr lhs true ()))
           refl)))
     (case False
       (chain
         (have hodd (= (int_eq (mod v 2) 1) False)
           (steps ((rewrite (hyp False) lr lhs true ())) refl))
         (have hmem (= (memb (haddrs (gcells_of g)) v) True)
           (steps
             ((rewrite (premise 2) rl rhs true ())
              (unfold slot_ok rhs)
              (rewrite (premise hodd) lr rhs true ())
              (reduce rhs))
             refl))
         (have hfd (= (hfind (gcells_of g) v) (Some (hfget (gcells_of g) v)))
           (rewrite-with
             (lemma hfind_memb)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hmem) lr lhs true ())) refl))
             refl))
         (case-on (le 2147483648 (hcount_of (hfget (gcells_of g) v))) Bool
           ((case True
              (chain
                (have hT
                  (= (le 2147483648 (hcount_of (hfget (gcells_of g) v))) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hmi (= (m_inc m g v) m)
                  (steps
                    ((unfold m_inc lhs)
                     (rewrite (premise hodd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hfd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hT) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hleg
                  (=
                    (ipcall
                      (nS 12 (ntl 12 fuel))
                      (rt_app (rt_fns rb) fs)
                      mlo
                      msz
                      dmax
                      d
                      2
                      (Cons v Nil)
                      m)
                    (Some (IpRv 0 m)))
                  (rewrite-with
                    (lemma rth_inc_sat_run)
                    lr
                    lhs
                    ((inst g g) (inst r r))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmem) lr lhs true ())) refl)
                     (steps ((rewrite (premise hT) lr lhs true ())) refl)
                     (steps ((rewrite (premise 5) lr lhs true ())) refl)
                     (steps ((rewrite (premise 6) lr lhs true ())) refl)
                     (steps ((rewrite (premise 7) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hmi) lr rhs true ())
                   (rewrite (premise hleg) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hF
                  (= (le 2147483648 (hcount_of (hfget (gcells_of g) v))) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hlt
                  (= (lt (hcount_of (hfget (gcells_of g) v)) 2147483648) True)
                  (by arith (rows (goal 1) (hF 1))))
                (have hmi
                  (=
                    (m_inc m g v)
                    (store_le (iw8) m v (+ (hword (hfget (gcells_of g) v)) 1)))
                  (steps
                    ((unfold m_inc lhs)
                     (rewrite (premise hodd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hfd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hF) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hleg
                  (=
                    (ipcall
                      (nS 12 (ntl 12 fuel))
                      (rt_app (rt_fns rb) fs)
                      mlo
                      msz
                      dmax
                      d
                      2
                      (Cons v Nil)
                      m)
                    (Some
                      (IpRv
                        0
                        (store_le
                          (iw8)
                          m
                          v
                          (+ (hword (hfget (gcells_of g) v)) 1)))))
                  (rewrite-with
                    (lemma rth_inc_ref_run)
                    lr
                    lhs
                    ((inst g g) (inst r r))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmem) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlt) lr lhs true ())) refl)
                     (steps ((rewrite (premise 5) lr lhs true ())) refl)
                     (steps ((rewrite (premise 6) lr lhs true ())) refl)
                     (steps ((rewrite (premise 7) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hmi) lr rhs true ())
                   (rewrite (premise hleg) lr lhs true ()))
                  refl))))))))))

