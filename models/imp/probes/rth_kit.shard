             refl))
         (have c6 (= (hcells_rep m (Cons (MkHCell p 1 tag n fill) gc)) True)
           (steps
             ((unfold hcells_rep lhs)
              (reduce lhs)
              (rewrite (premise hnew) lr lhs true ())
              (rewrite (premise hcr) lr lhs true ())
