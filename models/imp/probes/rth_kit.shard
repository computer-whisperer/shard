                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (unfold e_brk rhs)
                   (reduce rhs))
                  refl))
              (have h1 (= (le lo c) True)
                (rewrite-with
                  (lemma andb_l)
                  lr
                  lhs
                  ((inst
                     b
