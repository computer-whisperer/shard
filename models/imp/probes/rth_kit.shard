                  (andb
                    (lt (htag_of c) 65536)
                    (andb
                      (le 0 (harity_of c))
                      (andb (lt (harity_of c) 65536) (cells_ok rest)))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold cells_ok rhs)
         (reduce rhs))
        refl))
    (have h1
      (=
        (andb
          (int_eq (ilen (hslots_of c)) (harity_of c))
          (andb
            (le 1 (hcount_of c))
            (andb
              (lt (hcount_of c) 4294967296)
              (andb
                (le 0 (htag_of c))
                (andb
                  (lt (htag_of c) 65536)
                  (andb
                    (le 0 (harity_of c))
                    (andb (lt (harity_of c) 65536) (cells_ok rest))))))))
        True)
      (rewrite-with
