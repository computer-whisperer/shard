                  (hyp 1)
                  lr
                  lhs
                  ((inst rb rb) (inst k (+ k 1)))
                  ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                   (steps ((rewrite (premise hj0) lr lhs true ())) refl)
                   (steps ((rewrite (premise hlt2) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold fl_at lhs)
                 (reduce lhs)
                 (rewrite (hyp False) lr lhs true ())
                 (reduce lhs)
                 (rewrite (premise hih) lr lhs true ()))
                refl)))))))))

;; a positive number is not zero
(claim ieq0_false
  (goal ((p Int)) ((= (le 1 p) True)) (= (int_eq p 0) False))
  (case-on (int_eq p 0) Bool
    ((case True
       (chain
         (have hp (= p 0)
