              (steps ((rewrite (premise 6) lr lhs true ())) refl)
              (steps ((rewrite (premise 7) lr lhs true ())) refl))
             refl))
         (have hsn2
           (=
             (hslots_rep
               (store_le (iw8) m (+ p (+ 8 (* 8 i))) w)
               (+ p 8)
               (iapp fill (Cons w Nil)))
             True)
           (steps
             ((rewrite (premise hB) lr lhs true ())
              (rewrite (premise hsn) lr lhs true ()))
             refl))
         (have c7
           (=
             (hraw_rep
               (store_le (iw8) m (+ p (+ 8 (* 8 i))) w)
               (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))))
             True)
           (steps
             ((unfold hraw_rep lhs)
              (reduce lhs)
              (compute lhs (stop iw8 load_le store_le hslots_rep rword iapp))
              (rewrite (lemma hdr_rword) lr lhs true ())
              (rewrite (premise hhd3) lr lhs true ())
              (rewrite (premise hsn2) lr lhs true ())
              (compute lhs))
             refl))
         (steps
           ((rewrite (premise hg2) lr lhs true ())
            (unfold heap_rep lhs)
            (compute
              lhs
              (stop iw8 load_le store_le hfree_rep hcells_rep hraw_rep fllen
                iapp))
            (rewrite (premise c1) lr lhs true ())
            (rewrite (premise c2) lr lhs true ())
            (rewrite (premise c3) lr lhs true ())
            (rewrite (premise c4) lr lhs true ())
            (rewrite (premise c5) lr lhs true ())
            (rewrite (premise c6) lr lhs true ())
            (rewrite (premise c7) lr lhs true ())
            (compute lhs))
           refl))))))

;; FILL: an immediate joins the fill; the roots stand
