(claim nimm_at_intro
  (goal ((cs (List HCell)) (w Int))
    ((= (memb (haddrs cs) w) True)
     (= (le (count_in (haddrs cs) w) 1) True)
     (= (lt 1 (hcount_of (hfget cs w))) True)
     (= (lt (hcount_of (hfget cs w)) 2147483648) True))
    (= (nimm_at cs w) True))
  (induct cs
    ((case Nil
       (chain
