             refl))
         (have hfr (= (hfree_rep m rb 0 gf) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise hfrg) lr lhs true ()))
             refl))
         (have hbkfg
           (= (e_brk (fexts (gfree_of g) 0) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hinv_ebrk_free)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hbkf (= (e_brk (fexts gf 0) gl gt) True)
