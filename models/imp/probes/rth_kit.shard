              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hbkfg) lr lhs true ()))
             refl))
         (have hbkcg
           (= (e_brk (hexts (gcells_of g)) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hinv_ebrk_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hbkc (= (e_brk (hexts gc) gl gt) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hbkcg) lr lhs true ()))
             refl))
         (have hrblo (= (le (+ rb (+ 8 (* 8 0))) gl) True)
           (by arith (rows (goal 1) (h2 1))))
         (have htt (= (le gt gt) True) (by arith (rows (goal 1))))
         (have hdrf (= (e_disj1 rb 0 (fexts gf 0)) True)
           (rewrite-with
             (lemma ebrk_ed1_below)
             lr
             lhs
             ((inst lo gl) (inst top gt))
             ((steps ((rewrite (premise hbkf) lr lhs true ())) refl)
              (steps ((rewrite (premise hrblo) lr lhs true ())) refl))
             refl))
         (have hdtf (= (e_disj1 gt n (fexts gf 0)) True)
           (rewrite-with
             (lemma ebrk_ed1_above)
             lr
             lhs
             ((inst lo gl) (inst top gt))
             ((steps ((rewrite (premise hbkf) lr lhs true ())) refl)
              (steps ((rewrite (premise htt) lr lhs true ())) refl))
             refl))
         (have hor1a (= (le (+ rb 8) (+ rb (+ 24 (* 8 0)))) True)
           (by arith (rows (goal 1))))
         (have hor1
           (=
             (orb
               (le (+ rb 8) (+ rb (+ 24 (* 8 0))))
               (le (+ rb (+ 24 (* 8 (+ 0 (fllen gf))))) rb))
             True)
           (rewrite-with
             (lemma orb_intro_l)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hor1a) lr lhs true ())) refl))
             refl))
         (have h5a
           (=
             (hfree_rep (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) rb 0 gf)
             True)
           (rewrite-with
             (lemma hfree_rep_fr)
             lr
             lhs
             ((inst nb 0))
             ((steps ((rewrite (premise hfr) lr lhs true ())) refl)
              (steps ((rewrite (premise hdrf) lr lhs true ())) refl)
              (steps ((rewrite (premise hor1) lr lhs true ())) refl)
              (steps ((compute lhs)) refl)
              (steps ((compute lhs)) refl))
             refl))
         (have hor2a (= (le (+ rb (+ 24 (* 8 (+ 0 16)))) gt) True)
           (by arith (rows (goal 1) (h2 1) (h3 1))))
         (have hor2
           (=
             (orb
               (le (+ gt 8) (+ rb (+ 24 (* 8 0))))
               (le (+ rb (+ 24 (* 8 (+ 0 (fllen gf))))) gt))
             True)
           (rewrite-with
             (lemma orb_intro_r)
             lr
             lhs
             ()
             ((steps
                ((rewrite (premise f16e) lr lhs true ())
                 (rewrite (premise hor2a) lr lhs true ()))
                refl))
             refl))
         (have c5
           (=
             (hfree_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               rb
               0
               gf)
             True)
           (rewrite-with
             (lemma hfree_rep_fr)
             lr
             lhs
             ((inst nb n))
             ((steps ((rewrite (premise h5a) lr lhs true ())) refl)
              (steps ((rewrite (premise hdtf) lr lhs true ())) refl)
              (steps ((rewrite (premise hor2) lr lhs true ())) refl)
              (steps ((compute lhs)) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl))
             refl))
         (have hcrg (= (hcells_rep m (gcells_of g)) True)
           (rewrite-with
             (lemma hrx_cells)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcr (= (hcells_rep m gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcrg) lr lhs true ()))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have hdrc (= (e_disj1 rb 0 (hexts gc)) True)
           (rewrite-with
             (lemma ebrk_ed1_below)
             lr
             lhs
             ((inst lo gl) (inst top gt))
             ((steps ((rewrite (premise hbkc) lr lhs true ())) refl)
              (steps ((rewrite (premise hrblo) lr lhs true ())) refl))
             refl))
         (have hdtc (= (e_disj1 gt n (hexts gc)) True)
           (rewrite-with
             (lemma ebrk_ed1_above)
             lr
             lhs
             ((inst lo gl) (inst top gt))
             ((steps ((rewrite (premise hbkc) lr lhs true ())) refl)
              (steps ((rewrite (premise htt) lr lhs true ())) refl))
             refl))
         (have h6a
           (= (hcells_rep (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) gc) True)
           (rewrite-with
             (lemma hcells_rep_fr)
             lr
             lhs
             ((inst nb 0))
             ((steps ((rewrite (premise hcr) lr lhs true ())) refl)
              (steps ((rewrite (premise hdrc) lr lhs true ())) refl)
              (steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((compute lhs)) refl))
             refl))
         (have c6
           (=
             (hcells_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               gc)
             True)
           (rewrite-with
             (lemma hcells_rep_fr)
             lr
             lhs
             ((inst nb n))
             ((steps ((rewrite (premise h6a) lr lhs true ())) refl)
              (steps ((rewrite (premise hdtc) lr lhs true ())) refl)
              (steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl))
             refl))
         (have rw1
           (=
             (load_le
               (iw8)
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               gt)
             (hdr_word tag n))
           (rewrite-with
             (lemma ls8w)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hd0) lr lhs true ())) refl)
              (steps ((rewrite (premise hd1) lr lhs true ())) refl))
             refl))
         (have rw2 (= (rword (MkHRaw gt tag n Nil)) (hdr_word tag n))
           (rewrite-with (lemma hdr_rword) lr lhs () () refl))
         (have c7
           (=
             (hraw_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               (Some (MkHRaw gt tag n Nil)))
             True)
           (steps
             ((unfold hraw_rep lhs)
              (reduce lhs)
              (compute lhs (stop iw8 load_le store_le hdr_word rword hhead))
              (rewrite (premise rw1) lr lhs true ())
              (rewrite (premise rw2) lr lhs true ())
              (rewrite (lemma int_eq_refl) lr lhs true ())
              (compute lhs))
             refl))
         (steps
           ((rewrite (premise hgt0) lr lhs true ())
            (rewrite (premise hmm) lr lhs true ())
            (unfold heap_rep lhs)
            (reduce lhs)
            (rewrite (premise hgt) lr lhs true ())
            (rewrite (premise hge) lr lhs true ())
            (rewrite (premise hgf2) lr lhs true ())
            (rewrite (premise hgc2) lr lhs true ())
            (rewrite (premise hgr2) lr lhs true ())
            (rewrite (premise c1) lr lhs true ())
            (rewrite (premise c2) lr lhs true ())
            (rewrite (premise c3) lr lhs true ())
            (rewrite (premise c4) lr lhs true ())
            (rewrite (premise c5) lr lhs true ())
            (rewrite (premise c6) lr lhs true ())
            (rewrite (premise c7) lr lhs true ())
            (compute lhs))
           refl))))))

;; --- THE ALLOC LAWS (the exported pieces) ------------------------------------------

;; hinv survives rt_alloc's ghost transition whenever the call lands
(claim hinv_alloc
  (goal ((rb Int) (g GHeap) (r (List Int)) (tag Int) (n Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (gh_alloc_ok g n) True)
     (= (le 0 n) True)
     (= (lt n 65536) True)
     (= (le 0 tag) True)
     (= (lt tag 65536) True))
    (= (hinv rb (gh_alloc g tag n) r) True))
  (case-on (lt n 16) Bool
    ((case True
       (case-on (fl_at (gfree_of g) n) List
         ((case Nil
            (chain
              (have hga (= (gh_alloc g tag n) (gh_alloc_bump g tag n))
                (steps
                  ((unfold gh_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hok (= (gh_fits g n) True)
                (steps
                  ((rewrite (premise 2) rl rhs true ())
                   (unfold gh_alloc_ok rhs)
                   (rewrite (hyp True) lr rhs true ())
                   (reduce rhs)
                   (rewrite (hyp 0) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hfit (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
                (steps
                  ((rewrite (premise hok) rl rhs true ()) (unfold gh_fits rhs))
                  refl))
              (have hb (= (hinv rb (gh_alloc_bump g tag n) r) True)
                (rewrite-with
                  (lemma hinv_abump)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise hfit) lr lhs true ())) refl)
                   (steps ((rewrite (premise 3) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl)
                   (steps ((rewrite (premise 5) lr lhs true ())) refl)
                   (steps ((rewrite (premise 6) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hga) lr lhs true ())
                 (rewrite (premise hb) lr lhs true ()))
                refl)))
          (case Cons
            (p rest)
            (chain
              (have hga (= (gh_alloc g tag n) (gh_alloc_pop g tag n))
                (steps
                  ((unfold gh_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hp (= (hinv rb (gh_alloc_pop g tag n) r) True)
                (rewrite-with
                  (lemma hinv_apop)
                  lr
                  lhs
                  ((inst p p) (inst rest rest))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (hyp 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 3) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl)
                   (steps ((rewrite (premise 5) lr lhs true ())) refl)
                   (steps ((rewrite (premise 6) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hga) lr lhs true ())
                 (rewrite (premise hp) lr lhs true ()))
                refl))))))
     (case False
       (chain
         (have hga (= (gh_alloc g tag n) (gh_alloc_bump g tag n))
           (steps
             ((unfold gh_alloc lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs))
             refl))
         (have hok (= (gh_fits g n) True)
           (steps
             ((rewrite (premise 2) rl rhs true ())
              (unfold gh_alloc_ok rhs)
              (rewrite (hyp False) lr rhs true ())
              (reduce rhs))
             refl))
         (have hfit (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
           (steps
             ((rewrite (premise hok) rl rhs true ()) (unfold gh_fits rhs))
             refl))
         (have hb (= (hinv rb (gh_alloc_bump g tag n) r) True)
           (rewrite-with
             (lemma hinv_abump)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps ((rewrite (premise hfit) lr lhs true ())) refl)
              (steps ((rewrite (premise 3) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl)
              (steps ((rewrite (premise 6) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (premise hga) lr lhs true ())
            (rewrite (premise hb) lr lhs true ()))
           refl))))))

;; the bytes after rt_alloc's stores mean the ghost after its transition
(claim hr_alloc
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (tag Int) (n Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (gh_alloc_ok g n) True)
     (= (le 0 n) True)
     (= (lt n 65536) True)
     (= (le 0 tag) True)
     (= (lt tag 65536) True))
    (= (heap_rep (m_alloc m rb g tag n) rb (gh_alloc g tag n)) True))
  (case-on (lt n 16) Bool
    ((case True
       (case-on (fl_at (gfree_of g) n) List
         ((case Nil
            (chain
              (have hga (= (gh_alloc g tag n) (gh_alloc_bump g tag n))
                (steps
                  ((unfold gh_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hma
                (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
                (steps
                  ((unfold m_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hok (= (gh_fits g n) True)
                (steps
                  ((rewrite (premise 3) rl rhs true ())
                   (unfold gh_alloc_ok rhs)
                   (rewrite (hyp True) lr rhs true ())
                   (reduce rhs)
                   (rewrite (hyp 0) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hfit (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
                (steps
                  ((rewrite (premise hok) rl rhs true ()) (unfold gh_fits rhs))
                  refl))
              (have hb
                (=
                  (heap_rep
                    (m_abump m rb (gtop_of g) n tag)
                    rb
                    (gh_alloc_bump g tag n))
                  True)
                (rewrite-with
                  (lemma hr_abump)
                  lr
                  lhs
                  ((inst r r))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl)
                   (steps ((rewrite (premise hfit) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl)
                   (steps ((rewrite (premise 6) lr lhs true ())) refl)
                   (steps ((rewrite (premise 7) lr lhs true ())) refl)
                   (steps ((rewrite (premise 5) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hga) lr lhs true ())
                 (rewrite (premise hma) lr lhs true ())
                 (rewrite (premise hb) lr lhs true ()))
                refl)))
          (case Cons
            (p rest)
            (chain
              (have hga (= (gh_alloc g tag n) (gh_alloc_pop g tag n))
                (steps
                  ((unfold gh_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hma
                (= (m_alloc m rb g tag n) (m_apop m rb n (hhead rest) p tag))
                (steps
                  ((unfold m_alloc lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hl16 (= (lt n 16) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have hp
                (=
                  (heap_rep
                    (m_apop m rb n (hhead rest) p tag)
                    rb
                    (gh_alloc_pop g tag n))
                  True)
                (rewrite-with
                  (lemma hr_apop)
                  lr
                  lhs
                  ((inst r r))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl)
                   (steps ((rewrite (hyp 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise hl16) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl)
                   (steps ((rewrite (premise 6) lr lhs true ())) refl)
                   (steps ((rewrite (premise 7) lr lhs true ())) refl)
                   (steps ((rewrite (premise 5) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hga) lr lhs true ())
                 (rewrite (premise hma) lr lhs true ())
                 (rewrite (premise hp) lr lhs true ()))
                refl))))))
     (case False
       (chain
         (have hga (= (gh_alloc g tag n) (gh_alloc_bump g tag n))
           (steps
             ((unfold gh_alloc lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs))
             refl))
         (have hma (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
           (steps
             ((unfold m_alloc lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs))
             refl))
         (have hok (= (gh_fits g n) True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold gh_alloc_ok rhs)
              (rewrite (hyp False) lr rhs true ())
              (reduce rhs))
             refl))
         (have hfit (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
           (steps
             ((rewrite (premise hok) rl rhs true ()) (unfold gh_fits rhs))
             refl))
         (have hb
           (=
             (heap_rep
               (m_abump m rb (gtop_of g) n tag)
               rb
               (gh_alloc_bump g tag n))
             True)
           (rewrite-with
             (lemma hr_abump)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps ((rewrite (premise 2) lr lhs true ())) refl)
              (steps ((rewrite (premise hfit) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl)
              (steps ((rewrite (premise 6) lr lhs true ())) refl)
              (steps ((rewrite (premise 7) lr lhs true ())) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (premise hga) lr lhs true ())
            (rewrite (premise hma) lr lhs true ())
            (rewrite (premise hb) lr lhs true ()))
           refl))))))

;; the transition's two forms (the code's case order)
(claim gh_alloc_form_pop
  (goal
    ((gc (List HCell))
     (gf (List (List Int)))
     (gl Int)
     (gt Int)
     (ge Int)
     (gr (Option HRaw))
     (tag Int)
     (n Int)
     (p Int)
     (rest (List Int)))
    ((= (lt n 16) True) (= (fl_at gf n) (Cons p rest)))
    (=
      (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
      (MkGHeap gc (fl_set gf n rest) gl gt ge (Some (MkHRaw p tag n Nil)))))
  (steps
    ((unfold gh_alloc lhs)
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (compute lhs (stop fl_at fl_set gh_alloc_pop gh_alloc_bump))
     (rewrite (premise 1) lr lhs true ())
     (reduce lhs)
     (unfold gh_alloc_pop lhs)
     (compute lhs (stop fl_at fl_set))
     (rewrite (premise 1) lr lhs true ())
     (reduce lhs)
     (compute lhs (stop fl_set)))
    refl))

(claim gh_alloc_form_bump
  (goal
    ((gc (List HCell))
     (gf (List (List Int)))
     (gl Int)
     (gt Int)
     (ge Int)
     (gr (Option HRaw))
     (tag Int)
     (n Int))
    ((= (if (lt n 16) (fl_at gf n) Nil) Nil))
    (=
      (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
      (MkGHeap gc gf gl (+ gt (+ 8 (* 8 n))) ge (Some (MkHRaw gt tag n Nil)))))
  (case-on (lt n 16) Bool
    ((case True
       (chain
         (have hn (= (fl_at gf n) Nil)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (hyp True) lr rhs true ())
              (reduce rhs))
             refl))
         (steps
           ((unfold gh_alloc lhs)
            (rewrite (hyp True) lr lhs true ())
            (reduce lhs)
            (compute lhs (stop fl_at gh_alloc_pop gh_alloc_bump))
            (rewrite (premise hn) lr lhs true ())
            (reduce lhs)
            (unfold gh_alloc_bump lhs)
            (compute lhs))
           refl)))
     (case False
       (steps
         ((unfold gh_alloc lhs)
          (rewrite (hyp False) lr lhs true ())
          (reduce lhs)
          (unfold gh_alloc_bump lhs)
          (compute lhs))
         refl)))))

;; the transition's projections: the live cells stand, and when the call
;; lands the raw cell is exactly (the returned address, tag, n, no fill)
(claim gh_alloc_cells
  (goal ((g GHeap) (tag Int) (n Int)) ()
    (= (gcells_of (gh_alloc g tag n)) (gcells_of g)))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (case-on (lt n 16) Bool
         ((case True
            (case-on (fl_at gf n) List
              ((case Nil
                 (chain
                   (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                     (steps
                       ((rewrite (hyp True) lr lhs true ())
                        (reduce lhs)
                        (rewrite (hyp 0) lr lhs true ()))
                       refl))
                   (have hga
                     (=
                       (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                       (MkGHeap
                         gc
                         gf
                         gl
                         (+ gt (+ 8 (* 8 n)))
                         ge
                         (Some (MkHRaw gt tag n Nil))))
                     (rewrite-with
                       (lemma gh_alloc_form_bump)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hsel) lr lhs true ())) refl))
                       refl))
                   (steps
                     ((rewrite (hyp 2) lr both true ())
                      (rewrite (premise hga) lr lhs true ())
                      (compute both))
                     refl)))
               (case Cons
                 (p rest)
                 (chain
                   (have hga
                     (=
                       (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                       (MkGHeap
                         gc
                         (fl_set gf n rest)
                         gl
                         gt
                         ge
                         (Some (MkHRaw p tag n Nil))))
                     (rewrite-with
                       (lemma gh_alloc_form_pop)
                       lr
                       lhs
                       ((inst p p) (inst rest rest))
                       ((steps ((rewrite (hyp True) lr lhs true ())) refl)
                        (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       refl))
                   (steps
                     ((rewrite (hyp 2) lr both true ())
                      (rewrite (premise hga) lr lhs true ())
                      (compute both (stop fl_set)))
                     refl))))))
          (case False
            (chain
              (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                (steps ((rewrite (hyp False) lr lhs true ()) (reduce lhs)) refl))
              (have hga
                (=
                  (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                  (MkGHeap
                    gc
                    gf
                    gl
                    (+ gt (+ 8 (* 8 n)))
                    ge
                    (Some (MkHRaw gt tag n Nil))))
                (rewrite-with
                  (lemma gh_alloc_form_bump)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hsel) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (hyp 1) lr both true ())
                 (rewrite (premise hga) lr lhs true ())
                 (compute both))
                refl)))))))))

(claim gh_alloc_raw
  (goal ((g GHeap) (tag Int) (n Int)) ((= (gh_alloc_ok g n) True))
    (=
      (graw_of (gh_alloc g tag n))
      (Some (MkHRaw (gh_araddr (gh_alloc g tag n)) tag n Nil))))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (case-on (lt n 16) Bool
         ((case True
            (case-on (fl_at gf n) List
              ((case Nil
                 (chain
                   (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                     (steps
                       ((rewrite (hyp True) lr lhs true ())
                        (reduce lhs)
                        (rewrite (hyp 0) lr lhs true ()))
                       refl))
                   (have hga
                     (=
                       (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                       (MkGHeap
                         gc
                         gf
                         gl
                         (+ gt (+ 8 (* 8 n)))
                         ge
                         (Some (MkHRaw gt tag n Nil))))
                     (rewrite-with
                       (lemma gh_alloc_form_bump)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hsel) lr lhs true ())) refl))
                       refl))
                   (steps
                     ((rewrite (hyp 2) lr both true ())
                      (rewrite (premise hga) lr both true ())
                      (compute lhs)
                      (unfold gh_araddr rhs)
                      (compute rhs))
                     refl)))
               (case Cons
                 (p rest)
                 (chain
                   (have hga
                     (=
                       (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                       (MkGHeap
                         gc
                         (fl_set gf n rest)
                         gl
                         gt
                         ge
                         (Some (MkHRaw p tag n Nil))))
                     (rewrite-with
                       (lemma gh_alloc_form_pop)
                       lr
                       lhs
                       ((inst p p) (inst rest rest))
                       ((steps ((rewrite (hyp True) lr lhs true ())) refl)
                        (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       refl))
                   (steps
                     ((rewrite (hyp 2) lr both true ())
                      (rewrite (premise hga) lr both true ())
                      (compute lhs (stop fl_set))
                      (unfold gh_araddr rhs)
                      (compute rhs (stop fl_set)))
                     refl))))))
          (case False
            (chain
              (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                (steps ((rewrite (hyp False) lr lhs true ()) (reduce lhs)) refl))
              (have hga
                (=
                  (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
                  (MkGHeap
                    gc
                    gf
                    gl
                    (+ gt (+ 8 (* 8 n)))
                    ge
                    (Some (MkHRaw gt tag n Nil))))
                (rewrite-with
                  (lemma gh_alloc_form_bump)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hsel) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (hyp 1) lr both true ())
                 (rewrite (premise hga) lr both true ())
                 (compute lhs)
                 (unfold gh_araddr rhs)
                 (compute rhs))
                refl)))))))))

;; --- byte-grain framing of the alloc stores (the C4/I-O seam) ------------------------

(claim m_apop_fr_lo
  (goal ((m Mem) (rb Int) (n Int) (link Int) (p Int) (tag Int) (b Int))
    ((= (lt b rb) True) (= (le 0 n) True) (= (le rb p) True))
    (= (mem_get (m_apop m rb n link p tag) b) (mem_get m b)))
  (chain
    (have h1 (= (lt b (+ rb (+ 24 (* 8 n)))) True)
      (by arith (rows (goal 1) (0 1) (1 8))))
    (have h2 (= (lt b p) True) (by arith (rows (goal 1) (0 1) (2 1))))
    (have s1
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link)
            p
            (hdr_word tag n))
          b)
        (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link) b))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h2) lr lhs true ())) refl))
        refl))
    (have s2
      (=
        (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link) b)
        (mem_get m b))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h1) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold m_apop lhs)
       (rewrite (premise s1) lr lhs true ())
       (rewrite (premise s2) lr lhs true ()))
      refl)))

(claim m_apop_fr_hi
  (goal ((m Mem) (rb Int) (n Int) (link Int) (p Int) (tag Int) (b Int))
    ((= (le (+ (+ rb (+ 24 (* 8 n))) 8) b) True) (= (le (+ p 8) b) True))
    (= (mem_get (m_apop m rb n link p tag) b) (mem_get m b)))
  (chain
    (have s1
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link)
            p
            (hdr_word tag n))
          b)
        (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link) b))
      (rewrite-with
        (lemma sga8)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have s2
      (=
        (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 n))) link) b)
        (mem_get m b))
      (rewrite-with
        (lemma sga8)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold m_apop lhs)
       (rewrite (premise s1) lr lhs true ())
       (rewrite (premise s2) lr lhs true ()))
      refl)))

(claim m_abump_fr_lo
  (goal ((m Mem) (rb Int) (top Int) (n Int) (tag Int) (b Int))
    ((= (lt b rb) True) (= (le rb top) True))
    (= (mem_get (m_abump m rb top n tag) b) (mem_get m b)))
  (chain
    (have h2 (= (lt b top) True) (by arith (rows (goal 1) (0 1) (1 1))))
    (have s1
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) m rb (+ top (+ 8 (* 8 n))))
            top
            (hdr_word tag n))
          b)
        (mem_get (store_le (iw8) m rb (+ top (+ 8 (* 8 n)))) b))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h2) lr lhs true ())) refl))
        refl))
    (have s2
      (= (mem_get (store_le (iw8) m rb (+ top (+ 8 (* 8 n)))) b) (mem_get m b))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold m_abump lhs)
       (rewrite (premise s1) lr lhs true ())
       (rewrite (premise s2) lr lhs true ()))
      refl)))

(claim m_abump_fr_hi
  (goal ((m Mem) (rb Int) (top Int) (n Int) (tag Int) (b Int))
    ((= (le (+ rb 8) b) True) (= (le (+ top 8) b) True))
    (= (mem_get (m_abump m rb top n tag) b) (mem_get m b)))
  (chain
    (have s1
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) m rb (+ top (+ 8 (* 8 n))))
            top
            (hdr_word tag n))
          b)
        (mem_get (store_le (iw8) m rb (+ top (+ 8 (* 8 n)))) b))
      (rewrite-with
        (lemma sga8)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have s2
      (= (mem_get (store_le (iw8) m rb (+ top (+ 8 (* 8 n)))) b) (mem_get m b))
      (rewrite-with
        (lemma sga8)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold m_abump lhs)
       (rewrite (premise s1) lr lhs true ())
       (rewrite (premise s2) lr lhs true ()))
      refl)))

;; rt_alloc's stores never touch a byte below rb or at/after the heap end
(claim m_alloc_fr_lo
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (tag Int) (n Int) (b Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (le 0 n) True)
     (= (lt b rb) True))
    (= (mem_get (m_alloc m rb g tag n) b) (mem_get m b)))
  (chain
    (have h2 (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h3 (= (le (glo_of g) (gtop_of g)) True)
      (rewrite-with
        (lemma hi_lot)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hrt (= (le rb (gtop_of g)) True)
      (by arith (rows (goal 1) (h2 1) (h3 1))))
    (have hb (= (mem_get (m_abump m rb (gtop_of g) n tag) b) (mem_get m b))
      (rewrite-with
        (lemma m_abump_fr_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 3) lr lhs true ())) refl)
         (steps ((rewrite (premise hrt) lr lhs true ())) refl))
        refl))
    (case-on (lt n 16) Bool
      ((case True
         (case-on (fl_at (gfree_of g) n) List
           ((case Nil
              (chain
                (have hma
                  (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
                  (steps
                    ((unfold m_alloc lhs)
                     (rewrite (hyp True) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (steps
                  ((rewrite (premise hma) lr lhs true ())
                   (rewrite (premise hb) lr lhs true ()))
                  refl)))
            (case Cons
              (p rest)
              (chain
                (have hma
                  (= (m_alloc m rb g tag n) (m_apop m rb n (hhead rest) p tag))
                  (steps
                    ((unfold m_alloc lhs)
                     (rewrite (hyp True) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hap (= (apop_ok g tag n p rest) True)
                  (rewrite-with
                    (lemma apop_facts)
                    lr
                    lhs
                    ((inst rb rb) (inst r r))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (hyp 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 2) lr lhs true ())) refl))
                    refl))
                (have hlo (= (le (glo_of g) p) True)
                  (rewrite-with
                    (lemma ap_lo)
                    lr
                    lhs
                    ((inst tag tag) (inst n n) (inst rest rest))
                    ((steps ((rewrite (premise hap) lr lhs true ())) refl))
                    refl))
                (have hrp (= (le rb p) True)
                  (by arith (rows (goal 1) (h2 1) (hlo 1))))
                (have hp
                  (=
                    (mem_get (m_apop m rb n (hhead rest) p tag) b)
                    (mem_get m b))
                  (rewrite-with
                    (lemma m_apop_fr_lo)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise 3) lr lhs true ())) refl)
                     (steps ((rewrite (premise 2) lr lhs true ())) refl)
                     (steps ((rewrite (premise hrp) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hma) lr lhs true ())
                   (rewrite (premise hp) lr lhs true ()))
                  refl))))))
       (case False
         (chain
           (have hma (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
             (steps
               ((unfold m_alloc lhs)
                (rewrite (hyp False) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hma) lr lhs true ())
              (rewrite (premise hb) lr lhs true ()))
             refl)))))))

(claim m_alloc_fr_hi
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (tag Int) (n Int) (b Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (gh_alloc_ok g n) True)
     (= (le 0 n) True)
     (= (le (gend_of g) b) True))
    (= (mem_get (m_alloc m rb g tag n) b) (mem_get m b)))
  (chain
    (have h2 (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h3 (= (le (glo_of g) (gtop_of g)) True)
      (rewrite-with
        (lemma hi_lot)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h4 (= (le (gtop_of g) (gend_of g)) True)
      (rewrite-with
        (lemma hi_te)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hrb (= (le (+ rb 8) b) True)
      (by arith (rows (goal 1) (h2 1) (h3 1) (h4 1) (4 1))))
    (case-on (lt n 16) Bool
      ((case True
         (case-on (fl_at (gfree_of g) n) List
           ((case Nil
              (chain
                (have hma
                  (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
                  (steps
                    ((unfold m_alloc lhs)
                     (rewrite (hyp True) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hok (= (gh_fits g n) True)
                  (steps
                    ((rewrite (premise 2) rl rhs true ())
                     (unfold gh_alloc_ok rhs)
                     (rewrite (hyp True) lr rhs true ())
                     (reduce rhs)
                     (rewrite (hyp 0) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hfit
                  (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
                  (steps
                    ((rewrite (premise hok) rl rhs true ())
                     (unfold gh_fits rhs))
                    refl))
                (have htb (= (le (+ (gtop_of g) 8) b) True)
                  (by arith (rows (goal 1) (hfit 1) (4 1) (3 8))))
                (have hb
                  (= (mem_get (m_abump m rb (gtop_of g) n tag) b) (mem_get m b))
                  (rewrite-with
                    (lemma m_abump_fr_hi)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hrb) lr lhs true ())) refl)
                     (steps ((rewrite (premise htb) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hma) lr lhs true ())
                   (rewrite (premise hb) lr lhs true ()))
                  refl)))
            (case Cons
              (p rest)
              (chain
                (have hma
                  (= (m_alloc m rb g tag n) (m_apop m rb n (hhead rest) p tag))
                  (steps
                    ((unfold m_alloc lhs)
                     (rewrite (hyp True) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hl16 (= (lt n 16) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hap (= (apop_ok g tag n p rest) True)
                  (rewrite-with
                    (lemma apop_facts)
                    lr
                    lhs
                    ((inst rb rb) (inst r r))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (hyp 0) lr lhs true ())) refl)
                     (steps ((rewrite (premise 3) lr lhs true ())) refl))
                    refl))
                (have hhi (= (le (+ p (+ 8 (* 8 n))) (gtop_of g)) True)
                  (rewrite-with
                    (lemma ap_hi)
                    lr
                    lhs
                    ((inst tag tag) (inst rest rest))
                    ((steps ((rewrite (premise hap) lr lhs true ())) refl))
                    refl))
                (have hHb (= (le (+ (+ rb (+ 24 (* 8 n))) 8) b) True)
                  (by arith (rows (goal 1) (h2 1) (h3 1) (h4 1) (4 1) (hl16 8))))
                (have hpb (= (le (+ p 8) b) True)
                  (by arith (rows (goal 1) (hhi 1) (h4 1) (4 1) (3 8))))
                (have hp
                  (=
                    (mem_get (m_apop m rb n (hhead rest) p tag) b)
                    (mem_get m b))
                  (rewrite-with
                    (lemma m_apop_fr_hi)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hHb) lr lhs true ())) refl)
                     (steps ((rewrite (premise hpb) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hma) lr lhs true ())
                   (rewrite (premise hp) lr lhs true ()))
                  refl))))))
       (case False
         (chain
           (have hma (= (m_alloc m rb g tag n) (m_abump m rb (gtop_of g) n tag))
             (steps
               ((unfold m_alloc lhs)
                (rewrite (hyp False) lr lhs true ())
                (reduce lhs))
               refl))
           (have hok (= (gh_fits g n) True)
             (steps
               ((rewrite (premise 2) rl rhs true ())
                (unfold gh_alloc_ok rhs)
                (rewrite (hyp False) lr rhs true ())
                (reduce rhs))
               refl))
           (have hfit (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
             (steps
               ((rewrite (premise hok) rl rhs true ()) (unfold gh_fits rhs))
               refl))
           (have htb (= (le (+ (gtop_of g) 8) b) True)
             (by arith (rows (goal 1) (hfit 1) (4 1) (3 8))))
           (have hb
             (= (mem_get (m_abump m rb (gtop_of g) n tag) b) (mem_get m b))
             (rewrite-with
               (lemma m_abump_fr_hi)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hrb) lr lhs true ())) refl)
                (steps ((rewrite (premise htb) lr lhs true ())) refl))
               refl))
           (steps
             ((rewrite (premise hma) lr lhs true ())
              (rewrite (premise hb) lr lhs true ()))
             refl)))))))

;; the engine's reads through hfree_rep: head[k+j] and class j's chain
(claim hfree_rd
  (goal ((m Mem) (rb Int) (k Int) (fls (List (List Int))) (j Int))
    ((= (hfree_rep m rb k fls) True)
     (= (le 0 j) True)
     (= (lt j (fllen fls)) True))
    (= (load_le (iw8) m (+ rb (+ 24 (* 8 (+ k j))))) (hhead (fl_at fls j))))
  (induct fls
    ((case Nil
       (chain
         (have hz (= (lt j 0) True)
           (steps
             ((rewrite (premise 2) rl rhs true ())
              (unfold fllen rhs)
              (reduce rhs))
             refl))
         (have habs (= (le 1 0) True) (by arith (rows (goal 1) (1 1) (hz 1))))
         (absurd (premise habs))))
     (case Cons
       (fl r)
       (case-on (int_eq j 0) Bool
         ((case True
            (chain
              (have hj (= j 0)
                (rewrite-with
                  (lemma int_eq_eq)
                  lr
                  lhs
                  ((inst b 0))
                  ((steps ((rewrite (hyp True) lr lhs true ())) refl))
                  refl))
              (have hA (= (+ rb (+ 24 (* 8 (+ k j)))) (+ rb (+ 24 (* 8 k))))
                (by arith (list (list 1 0 0 0 -8) (list 1 0 0 0 8))))
              (have hhd
                (=
                  (int_eq (load_le (iw8) m (+ rb (+ 24 (* 8 k)))) (hhead fl))
                  True)
                (rewrite-with
                  (lemma hf_hd)
                  lr
                  lhs
                  ((inst rest r))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (have hhe (= (load_le (iw8) m (+ rb (+ 24 (* 8 k)))) (hhead fl))
                (rewrite-with
                  (lemma int_eq_eq)
                  lr
                  lhs
                  ((inst b (hhead fl)))
                  ((steps ((rewrite (premise hhd) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hA) lr lhs true ())
                 (rewrite (premise hhe) lr lhs true ())
                 (unfold fl_at rhs)
                 (reduce rhs)
                 (rewrite (hyp True) lr rhs true ())
                 (reduce rhs))
                refl)))
