                                  refl))
                              (have hco (= (cells_ok gc) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hcog) lr lhs true ()))
                                  refl))
                              (have hdsjc (= (e_disj (hexts gc)) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hdsj) lr lhs true ()))
                                  refl))
                              (have hmemc (= (memb (haddrs gc) v) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hmem) lr lhs true ()))
                                  refl))
                              (have hltc
                                (=
                                  (lt (hcount_of (hfget gc v)) 2147483648)
                                  True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hfc) lr lhs true ())
                                   (rewrite (premise hlt) lr lhs true ()))
                                  refl))
                              (have c6
                                (=
                                  (hcells_rep
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    (hincc gc v))
                                  True)
                                (rewrite-with
                                  (lemma hcells_rep_incc)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise hcr) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hco) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hdsjc) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hmemc) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hgc0) rl rhs true ())
                                      (rewrite (premise hfc) lr rhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hltc) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hrwg (= (hraw_rep m (graw_of g)) True)
                                (rewrite-with
                                  (lemma hrx_raw)
                                  lr
                                  lhs
                                  ((inst rb rb))
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hrw (= (hraw_rep m gr) True)
                                (steps
                                  ((rewrite (premise hgr0) rl lhs true ())
                                   (rewrite (premise hrwg) lr lhs true ()))
                                  refl))
                              (have hd1rg
                                (=
                                  (e_disj1
                                    v
                                    (harity_of (hfget gc v))
                                    (rexts gr))
                                  True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hgr0) rl lhs true ())
                                   (rewrite (premise hd1r) lr lhs true ()))
                                  refl))
                              (have hrkc (= (raw_ok gr gc) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hgr0) rl lhs true ())
                                   (rewrite (premise hrkg) lr lhs true ()))
                                  refl))
                              (have c7
                                (=
                                  (hraw_rep
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    gr)
                                  True)
                                (rewrite-with
                                  (lemma hraw_rep_fr1)
                                  lr
                                  lhs
                                  ((inst nb (harity_of (hfget gc v)))
                                   (inst cs gc))
                                  ((steps
                                     ((rewrite (premise hrw) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hd1rg) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hrkc) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hn0g) lr lhs true ()))
                                     refl))
                                  refl))
                              (steps
                                ((rewrite (premise hmi) lr lhs true ())
                                 (rewrite (premise hgi) lr lhs true ())
                                 (rewrite (premise hg2) lr lhs true ())
                                 (unfold heap_rep lhs)
                                 (compute
                                   lhs
                                   (stop iw8 load_le store_le hfree_rep
                                     hcells_rep hraw_rep fllen hincc hword))
                                 (rewrite (premise c1) lr lhs true ())
                                 (rewrite (premise c2) lr lhs true ())
                                 (rewrite (premise c3) lr lhs true ())
                                 (rewrite (premise c4) lr lhs true ())
                                 (rewrite (premise c5) lr lhs true ())
                                 (rewrite (premise c6) lr lhs true ())
                                 (rewrite (premise c7) lr lhs true ())
                                 (compute lhs))
                                refl))))))))))))))))))


;; THE SHARED LEG'S MEMORY LAW (C2b-5 part i): the one header store keeps
;; heap_rep for the decremented ghost — hr_inc's reference case with the
;; sign flipped, stated over the found cell
(claim hr_dec_shared
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (v Int) (c HCell))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (hfind (gcells_of g) v) (Some c))
     (= (lt (hcount_of c) 2147483648) True)
     (= (lt 1 (hcount_of c)) True))
    (=
      (heap_rep
        (store_le (iw8) m v (- (hword c) 1))
        rb
        (with_gcells (hdecc (gcells_of g) v) g))
      True))
  (chain
    (have hfd (= (hfind (gcells_of g) v) (Some c))
      (steps ((rewrite (premise 2) lr lhs true ())) refl))
    (have hmem (= (memb (haddrs (gcells_of g)) v) True)
      (steps
        ((rewrite (lemma memb_hhas) lr lhs true ())
         (unfold hhas lhs)
         (rewrite (premise hfd) lr lhs true ())
         (reduce lhs))
        refl))
    (have hfc (= (hfget (gcells_of g) v) c)
      (steps
        ((unfold hfget lhs) (rewrite (premise hfd) lr lhs true ()) (reduce lhs))
        refl))
    (have hlt (= (lt (hcount_of c) 2147483648) True)
      (steps ((rewrite (premise 3) lr lhs true ())) refl))
    (have hlv (= (live_ok g v) True)
      (rewrite-with
        (lemma live_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise hmem) lr lhs true ())) refl))
        refl))
    (have hlo (= (le (glo_of g) v) True)
      (rewrite-with
        (lemma lv_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hd1f
      (=
        (e_disj1 v (harity_of (hfget (gcells_of g) v)) (fexts (gfree_of g) 0))
        True)
      (rewrite-with
        (lemma lv_d1f)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hd1r
      (=
        (e_disj1 v (harity_of (hfget (gcells_of g) v)) (rexts (graw_of g)))
        True)
      (rewrite-with
        (lemma lv_d1r)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hdsj (= (e_disj (hexts (gcells_of g))) True)
      (rewrite-with
        (lemma lv_disj)
        lr
        lhs
        ((inst v v))
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hcb (= (cbands (hfget (gcells_of g) v)) True)
      (rewrite-with
        (lemma lv_bands)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hn0 (= (le 0 (harity_of (hfget (gcells_of g) v))) True)
      (rewrite-with
        (lemma cb_ar0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hcb) lr lhs true ())) refl))
        refl))
    (have h2g (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hcog (= (cells_ok (gcells_of g)) True)
      (rewrite-with
        (lemma hi_cells)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hrkg (= (raw_ok (graw_of g) (gcells_of g)) True)
      (rewrite-with
        (lemma hi_raw)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (case-on g GHeap
      ((case MkGHeap
         (gc gf gl gt ge gr)
         (chain
           (have hg2
             (=
               (with_gcells (hdecc (gcells_of g) v) g)
               (MkGHeap (hdecc gc v) gf gl gt ge gr))
             (steps
               ((rewrite (hyp 0) lr lhs true ()) (compute lhs (stop hdecc)))
               refl))
           (have hgl0 (= (glo_of g) gl)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hgt0 (= (gtop_of g) gt)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hge0 (= (gend_of g) ge)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hgc0 (= (gcells_of g) gc)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hgf0 (= (gfree_of g) gf)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hgr0 (= (graw_of g) gr)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have h2 (= (le (+ rb 152) gl) True)
             (steps
               ((rewrite (premise hgl0) rl lhs true ())
                (rewrite (premise h2g) lr lhs true ()))
               refl))
           (have hlo2 (= (le gl v) True)
             (steps
               ((rewrite (premise hgl0) rl lhs true ())
                (rewrite (premise hlo) lr lhs true ()))
               refl))
           (have a1 (= (le (+ rb 8) v) True)
             (by arith (rows (goal 1) (h2 1) (hlo2 1))))
           (have a2 (= (le (+ (+ rb 8) 8) v) True)
             (by arith (rows (goal 1) (h2 1) (hlo2 1))))
           (have a3 (= (le (+ (+ rb 16) 8) v) True)
             (by arith (rows (goal 1) (h2 1) (hlo2 1))))
           (have r1
             (=
               (load_le (iw8) (store_le (iw8) m v (- (hword c) 1)) rb)
               (load_le (iw8) m rb))
             (rewrite-with
               (lemma ldw_below)
               lr
               lhs
               ()
               ((steps ((rewrite (premise a1) lr lhs true ())) refl))
               refl))
           (have r1g (= (int_eq (load_le (iw8) m rb) (gtop_of g)) True)
             (rewrite-with
               (lemma hrx_top)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have c1
             (=
               (int_eq
                 (load_le (iw8) (store_le (iw8) m v (- (hword c) 1)) rb)
