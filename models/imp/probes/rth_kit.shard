;; --- the loop level: pop and push --------------------------------------------------

;; popping the worklist: the invariant reassociates (the popped cell's
;; slots become the walked suffix), the popped extent is remembered as
;; an entry extent, and its address gets one unit of domination slack
(claim winv_pop
  (goal
    ((cs0 (List HCell))
     (es0 (List (Pair Int Int)))
     (r (List Int))
     (cells (List HCell))
     (fls (List (List Int)))
     (cur HCell)
     (rest (List HCell)))
    ((= (winv cs0 es0 r cells fls (Cons cur rest) Nil) True))
    (=
      (andb
        (winv cs0 es0 r cells fls rest (hslots_of cur))
        (andb
          (emem es0 (haddr_of cur) (harity_of cur))
          (le
            (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
            (count_in (e_addrs es0) (haddr_of cur)))))
      True))
  (chain
    (have hex (= (wexact cells cells r (Cons cur rest) Nil) True)
      (rewrite-with
        (lemma wi_ex)
        lr
        lhs
        ((inst cs0 cs0) (inst es0 es0) (inst fls fls))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hco (= (cells_ok cells) True)
      (rewrite-with
        (lemma wi_co)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst r r)
         (inst fls fls)
         (inst wl (Cons cur rest))
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hro (= (roots_ok r (haddrs cells)) True)
      (rewrite-with
        (lemma wi_ro)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst fls fls)
         (inst wl (Cons cur rest))
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hea (= (eall (wext cells fls (Cons cur rest)) es0) True)
      (rewrite-with
        (lemma wi_ea)
        lr
        lhs
        ((inst cs0 cs0) (inst r r) (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hms (= (msub (wa cells fls (Cons cur rest)) (e_addrs es0)) True)
      (rewrite-with
        (lemma wi_ms)
        lr
        lhs
        ((inst cs0 cs0) (inst r r) (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hsq (= (hsubq cells cs0) True)
      (rewrite-with
        (lemma wi_sq)
        lr
        lhs
        ((inst es0 es0)
         (inst r r)
         (inst fls fls)
         (inst wl (Cons cur rest))
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hal (= (aligned8 (haddrs cells)) True)
      (rewrite-with
        (lemma wi_al)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst r r)
         (inst fls fls)
         (inst wl (Cons cur rest))
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hexp (= (wexact cells cells r rest (hslots_of cur)) True)
      (rewrite-with
        (lemma wex_pop)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hex) lr lhs true ())) refl))
        refl))
    (have hwex
      (=
        (wext cells fls (Cons cur rest))
        (fexts_app
          (hexts cells)
          (fexts_app (fexts fls 0) (hexts (Cons cur rest)))))
      (steps ((unfold wext lhs) (reduce lhs)) refl))
    (have hxc
      (=
        (hexts (Cons cur rest))
        (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest)))
      (steps ((unfold hexts lhs) (reduce lhs)) refl))
    (have hfull
      (=
        (eall
          (fexts_app
            (hexts cells)
            (fexts_app
              (fexts fls 0)
              (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest))))
          es0)
        True)
      (steps
        ((rewrite (premise hxc) rl lhs true ())
         (rewrite (premise hwex) rl lhs true ())
         (rewrite (premise hea) lr lhs true ()))
        refl))
    (have hpl (= (eall (hexts cells) es0) True)
      (rewrite-with
        (lemma eall_app_l)
        lr
        lhs
        ((inst
           b
           (fexts_app
             (fexts fls 0)
             (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest)))))
        ((steps ((rewrite (premise hfull) lr lhs true ())) refl))
        refl))
    (have hpr
      (=
        (eall
          (fexts_app
            (fexts fls 0)
            (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest)))
          es0)
        True)
      (rewrite-with
        (lemma eall_app_r)
        lr
        lhs
        ((inst a (hexts cells)))
        ((steps ((rewrite (premise hfull) lr lhs true ())) refl))
        refl))
    (have hpf (= (eall (fexts fls 0) es0) True)
      (rewrite-with
        (lemma eall_app_l)
        lr
        lhs
        ((inst b (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest))))
        ((steps ((rewrite (premise hpr) lr lhs true ())) refl))
        refl))
    (have hpwl
      (=
        (eall (Cons (Pair (haddr_of cur) (harity_of cur)) (hexts rest)) es0)
        True)
      (rewrite-with
        (lemma eall_app_r)
        lr
        lhs
        ((inst a (fexts fls 0)))
        ((steps ((rewrite (premise hpr) lr lhs true ())) refl))
        refl))
    (have hcurm (= (emem es0 (haddr_of cur) (harity_of cur)) True)
      (rewrite-with
        (lemma ea_hd)
        lr
        lhs
        ((inst t (hexts rest)))
        ((steps ((rewrite (premise hpwl) lr lhs true ())) refl))
        refl))
    (have hprest (= (eall (hexts rest) es0) True)
      (rewrite-with
        (lemma ea_tl)
        lr
        lhs
        ((inst a (haddr_of cur)) (inst n (harity_of cur)))
        ((steps ((rewrite (premise hpwl) lr lhs true ())) refl))
        refl))
    (have hin1 (= (eall (fexts_app (fexts fls 0) (hexts rest)) es0) True)
      (rewrite-with
        (lemma eall_app_intro)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hpf) lr lhs true ())) refl)
         (steps ((rewrite (premise hprest) lr lhs true ())) refl))
        refl))
    (have hin2
      (=
        (eall
          (fexts_app (hexts cells) (fexts_app (fexts fls 0) (hexts rest)))
          es0)
        True)
      (rewrite-with
        (lemma eall_app_intro)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hpl) lr lhs true ())) refl)
         (steps ((rewrite (premise hin1) lr lhs true ())) refl))
        refl))
    (have hwex2
      (=
        (wext cells fls rest)
        (fexts_app (hexts cells) (fexts_app (fexts fls 0) (hexts rest))))
      (steps ((unfold wext lhs) (reduce lhs)) refl))
    (have hea2 (= (eall (wext cells fls rest) es0) True)
      (steps
        ((rewrite (premise hwex2) lr lhs true ())
         (rewrite (premise hin2) lr lhs true ()))
        refl))
    (have hhc (= (haddrs (Cons cur rest)) (Cons (haddr_of cur) (haddrs rest)))
      (steps ((unfold haddrs lhs) (reduce lhs)) refl))
    (have hwa1
      (=
        (wa cells fls (Cons cur rest))
        (iapp
          (haddrs cells)
          (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest)))))
      (steps
        ((unfold wa lhs) (reduce lhs) (rewrite (premise hhc) lr lhs true ()))
        refl))
    (have hwa2
      (=
        (wa cells fls rest)
        (iapp (haddrs cells) (iapp (faddrs fls) (haddrs rest))))
      (steps ((unfold wa lhs) (reduce lhs)) refl))
    (have hmspre
      (=
        (msub
          (iapp
            (haddrs cells)
            (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest))))
          (e_addrs es0))
        True)
      (steps
        ((rewrite (premise hwa1) rl lhs true ())
         (rewrite (premise hms) lr lhs true ()))
        refl))
    (have hmsasc
      (=
        (msub
          (iapp
            (iapp (haddrs cells) (faddrs fls))
            (Cons (haddr_of cur) (haddrs rest)))
          (e_addrs es0))
        True)
      (steps
        ((rewrite (lemma iapp_assoc) lr lhs true ())
         (rewrite (premise hmspre) lr lhs true ()))
        refl))
    (have hmsdel
      (=
        (msub
          (iapp (iapp (haddrs cells) (faddrs fls)) (haddrs rest))
          (e_addrs es0))
        True)
      (rewrite-with
        (lemma msub_del)
        lr
        lhs
        ((inst w (haddr_of cur)))
        ((steps ((rewrite (premise hmsasc) lr lhs true ())) refl))
        refl))
    (have hms2 (= (msub (wa cells fls rest) (e_addrs es0)) True)
      (steps
        ((rewrite (premise hwa2) lr lhs true ())
         (rewrite (lemma iapp_assoc) rl lhs true ())
         (rewrite (premise hmsdel) lr lhs true ()))
        refl))
    (have hcpre
      (=
        (le
          (count_in
            (iapp
              (haddrs cells)
              (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest))))
            (haddr_of cur))
          (count_in (e_addrs es0) (haddr_of cur)))
        True)
      (rewrite-with
        (lemma msub_cin)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hmspre) lr lhs true ())) refl))
        refl))
    (have hd1
      (=
        (count_in
          (iapp
            (haddrs cells)
            (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest))))
          (haddr_of cur))
        (+
          (count_in (haddrs cells) (haddr_of cur))
          (count_in
            (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest)))
            (haddr_of cur))))
      (rewrite-with (lemma cin_iapp) lr lhs () () refl))
    (have hd2
      (=
        (count_in
          (iapp (faddrs fls) (Cons (haddr_of cur) (haddrs rest)))
          (haddr_of cur))
        (+
          (count_in (faddrs fls) (haddr_of cur))
          (count_in (Cons (haddr_of cur) (haddrs rest)) (haddr_of cur))))
      (rewrite-with (lemma cin_iapp) lr lhs () () refl))
    (have hd3
      (=
        (count_in (Cons (haddr_of cur) (haddrs rest)) (haddr_of cur))
        (+ 1 (count_in (haddrs rest) (haddr_of cur))))
      (steps
        ((unfold count_in lhs)
         (reduce lhs)
         (rewrite (lemma int_eq_refl) lr lhs true ())
         (reduce lhs))
        refl))
    (have hd4
      (=
        (count_in
          (iapp (haddrs cells) (iapp (faddrs fls) (haddrs rest)))
          (haddr_of cur))
        (+
          (count_in (haddrs cells) (haddr_of cur))
          (count_in (iapp (faddrs fls) (haddrs rest)) (haddr_of cur))))
      (rewrite-with (lemma cin_iapp) lr lhs () () refl))
    (have hd5
      (=
        (count_in (iapp (faddrs fls) (haddrs rest)) (haddr_of cur))
        (+
          (count_in (faddrs fls) (haddr_of cur))
          (count_in (haddrs rest) (haddr_of cur))))
      (rewrite-with (lemma cin_iapp) lr lhs () () refl))
    (have hslk
      (=
        (le
          (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
          (count_in (e_addrs es0) (haddr_of cur)))
        True)
      (steps
        ((rewrite (premise hwa2) lr lhs true ()))
        (by
          arith
          (rows (goal 1) (hcpre 1) (hd1 1) (hd2 1) (hd3 1) (hd4 -1) (hd5 -1)))))
    (have hwv (= (winv cs0 es0 r cells fls rest (hslots_of cur)) True)
      (steps
        ((unfold winv lhs)
         (reduce lhs)
         (rewrite (premise hexp) lr lhs true ())
         (rewrite (premise hco) lr lhs true ())
         (rewrite (premise hro) lr lhs true ())
         (rewrite (premise hea2) lr lhs true ())
         (rewrite (premise hms2) lr lhs true ())
         (rewrite (premise hsq) lr lhs true ())
         (rewrite (premise hal) lr lhs true ())
         (compute lhs))
        refl))
    (steps
      ((rewrite (premise hwv) lr lhs true ())
       (rewrite (premise hcurm) lr lhs true ())
       (rewrite (premise hslk) lr lhs true ())
       (compute lhs))
      refl)))

;; pushing a freed extent onto its class: membership comes from the
;; remembered entry extent, domination from the popped unit of slack
(claim winv_push
  (goal
    ((cs0 (List HCell))
     (es0 (List (Pair Int Int)))
     (r (List Int))
     (cells2 (List HCell))
     (fls (List (List Int)))
     (wl2 (List HCell))
     (xa Int)
     (xk Int))
    ((= (winv cs0 es0 r cells2 fls wl2 Nil) True)
     (= (emem es0 xa xk) True)
     (=
       (le (+ 1 (count_in (wa cells2 fls wl2) xa)) (count_in (e_addrs es0) xa))
       True))
    (= (winv cs0 es0 r cells2 (fls_push fls xk xa) wl2 Nil) True))
  (chain
    (have hex (= (wexact cells2 cells2 r wl2 Nil) True)
      (rewrite-with
        (lemma wi_ex)
        lr
        lhs
        ((inst cs0 cs0) (inst es0 es0) (inst fls fls))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hco (= (cells_ok cells2) True)
      (rewrite-with
        (lemma wi_co)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst r r)
         (inst fls fls)
         (inst wl wl2)
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hro (= (roots_ok r (haddrs cells2)) True)
      (rewrite-with
        (lemma wi_ro)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst fls fls)
         (inst wl wl2)
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hea (= (eall (wext cells2 fls wl2) es0) True)
      (rewrite-with
        (lemma wi_ea)
        lr
        lhs
        ((inst cs0 cs0) (inst r r) (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hms (= (msub (wa cells2 fls wl2) (e_addrs es0)) True)
      (rewrite-with
        (lemma wi_ms)
        lr
        lhs
        ((inst cs0 cs0) (inst r r) (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hsq (= (hsubq cells2 cs0) True)
      (rewrite-with
        (lemma wi_sq)
        lr
        lhs
        ((inst es0 es0) (inst r r) (inst fls fls) (inst wl wl2) (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hal (= (aligned8 (haddrs cells2)) True)
      (rewrite-with
        (lemma wi_al)
        lr
        lhs
        ((inst cs0 cs0)
         (inst es0 es0)
         (inst r r)
         (inst fls fls)
         (inst wl wl2)
         (inst ws Nil))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hwex
      (=
        (wext cells2 fls wl2)
        (fexts_app (hexts cells2) (fexts_app (fexts fls 0) (hexts wl2))))
      (steps ((unfold wext lhs) (reduce lhs)) refl))
    (have hfull
      (=
        (eall
          (fexts_app (hexts cells2) (fexts_app (fexts fls 0) (hexts wl2)))
          es0)
        True)
      (steps
        ((rewrite (premise hwex) rl lhs true ())
         (rewrite (premise hea) lr lhs true ()))
        refl))
    (have hpl (= (eall (hexts cells2) es0) True)
      (rewrite-with
        (lemma eall_app_l)
        lr
        lhs
        ((inst b (fexts_app (fexts fls 0) (hexts wl2))))
        ((steps ((rewrite (premise hfull) lr lhs true ())) refl))
        refl))
    (have hpr (= (eall (fexts_app (fexts fls 0) (hexts wl2)) es0) True)
      (rewrite-with
        (lemma eall_app_r)
        lr
        lhs
        ((inst a (hexts cells2)))
        ((steps ((rewrite (premise hfull) lr lhs true ())) refl))
        refl))
    (have hpf (= (eall (fexts fls 0) es0) True)
      (rewrite-with
        (lemma eall_app_l)
        lr
        lhs
        ((inst b (hexts wl2)))
        ((steps ((rewrite (premise hpr) lr lhs true ())) refl))
        refl))
    (have hpw (= (eall (hexts wl2) es0) True)
      (rewrite-with
        (lemma eall_app_r)
        lr
        lhs
        ((inst a (fexts fls 0)))
        ((steps ((rewrite (premise hpr) lr lhs true ())) refl))
        refl))
    (have hjk (= (+ 0 xk) xk) (by arith (list (list 1 0 0 0) (list 1 0 0 0))))
    (have hm0 (= (emem es0 xa (+ 0 xk)) True)
      (steps
        ((rewrite (premise hjk) lr lhs true ())
         (rewrite (premise 1) lr lhs true ()))
        refl))
    (have hpf2 (= (eall (fexts (fls_push fls xk xa) 0) es0) True)
      (rewrite-with
        (lemma eall_fp)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hpf) lr lhs true ())) refl)
         (steps ((rewrite (premise hm0) lr lhs true ())) refl))
        refl))
    (have hin1
      (= (eall (fexts_app (fexts (fls_push fls xk xa) 0) (hexts wl2)) es0) True)
      (rewrite-with
        (lemma eall_app_intro)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hpf2) lr lhs true ())) refl)
         (steps ((rewrite (premise hpw) lr lhs true ())) refl))
        refl))
    (have hin2
      (=
        (eall
          (fexts_app
            (hexts cells2)
            (fexts_app (fexts (fls_push fls xk xa) 0) (hexts wl2)))
          es0)
        True)
      (rewrite-with
        (lemma eall_app_intro)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hpl) lr lhs true ())) refl)
         (steps ((rewrite (premise hin1) lr lhs true ())) refl))
        refl))
    (have hwex2
      (=
        (wext cells2 (fls_push fls xk xa) wl2)
        (fexts_app
          (hexts cells2)
          (fexts_app (fexts (fls_push fls xk xa) 0) (hexts wl2))))
      (steps ((unfold wext lhs) (reduce lhs)) refl))
    (have hea2 (= (eall (wext cells2 (fls_push fls xk xa) wl2) es0) True)
      (steps
        ((rewrite (premise hwex2) lr lhs true ())
         (rewrite (premise hin2) lr lhs true ()))
        refl))
    (have hwa1
      (=
        (wa cells2 fls wl2)
        (iapp (haddrs cells2) (iapp (faddrs fls) (haddrs wl2))))
      (steps ((unfold wa lhs) (reduce lhs)) refl))
    (have hmsu
      (=
        (msub
          (iapp (haddrs cells2) (iapp (faddrs fls) (haddrs wl2)))
          (e_addrs es0))
        True)
      (steps
        ((rewrite (premise hwa1) rl lhs true ())
         (rewrite (premise hms) lr lhs true ()))
        refl))
    (have hmsasc
      (=
        (msub
          (iapp (iapp (haddrs cells2) (faddrs fls)) (haddrs wl2))
          (e_addrs es0))
        True)
      (steps
        ((rewrite (lemma iapp_assoc) lr lhs true ())
         (rewrite (premise hmsu) lr lhs true ()))
        refl))
    (have hce
      (=
        (count_in (iapp (iapp (haddrs cells2) (faddrs fls)) (haddrs wl2)) xa)
        (count_in (iapp (haddrs cells2) (iapp (faddrs fls) (haddrs wl2))) xa))
      (steps ((rewrite (lemma iapp_assoc) lr lhs true ())) refl))
    (have hslk2
      (=
        (le
          (+
            1
            (count_in
              (iapp (iapp (haddrs cells2) (faddrs fls)) (haddrs wl2))
              xa))
          (count_in (e_addrs es0) xa))
        True)
      (steps
        ((rewrite (premise hce) lr lhs true ())
         (rewrite (premise hwa1) rl lhs true ())
         (rewrite (premise 2) lr lhs true ()))
        refl))
    (have hins
      (=
        (msub
          (iapp (iapp (haddrs cells2) (faddrs fls)) (Cons xa (haddrs wl2)))
          (e_addrs es0))
        True)
      (rewrite-with
        (lemma msub_ins)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hmsasc) lr lhs true ())) refl)
         (steps ((rewrite (premise hslk2) lr lhs true ())) refl))
        refl))
    (have hins2
      (=
        (msub
          (iapp (haddrs cells2) (iapp (faddrs fls) (Cons xa (haddrs wl2))))
          (e_addrs es0))
        True)
      (steps
        ((rewrite (lemma iapp_assoc) rl lhs true ())
         (rewrite (premise hins) lr lhs true ()))
        refl))
    (have hw2f
      (=
        (msub
          (iapp
            (haddrs cells2)
            (iapp (faddrs (fls_push fls xk xa)) (haddrs wl2)))
          (e_addrs es0))
        True)
      (rewrite-with
        (lemma msub_w2f)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hins2) lr lhs true ())) refl))
        refl))
    (have hwa2
      (=
        (wa cells2 (fls_push fls xk xa) wl2)
        (iapp (haddrs cells2) (iapp (faddrs (fls_push fls xk xa)) (haddrs wl2))))
      (steps ((unfold wa lhs) (reduce lhs)) refl))
    (have hms2
      (= (msub (wa cells2 (fls_push fls xk xa) wl2) (e_addrs es0)) True)
      (steps
        ((rewrite (premise hwa2) lr lhs true ())
         (rewrite (premise hw2f) lr lhs true ()))
        refl))
    (steps
      ((unfold winv lhs)
       (reduce lhs)
       (rewrite (premise hex) lr lhs true ())
       (rewrite (premise hco) lr lhs true ())
       (rewrite (premise hro) lr lhs true ())
       (rewrite (premise hea2) lr lhs true ())
       (rewrite (premise hms2) lr lhs true ())
       (rewrite (premise hsq) lr lhs true ())
       (rewrite (premise hal) lr lhs true ())
       (compute lhs))
      refl)))

;; --- THE LOOP MASTER ---------------------------------------------------------------
;; The release loop at budget k >= |cells| + |wl| + 1 never exits on
;; fuel (the sum falls by exactly one per iteration) and lands the walk
;; invariant at rest.  Pop is winv_pop, the walk is gh_slots_inv, the
;; free push is winv_push riding the popped slack.
(claim gh_wl_inv
  (goal
    ((k Int)
     (cells (List HCell))
     (fls (List (List Int)))
     (wl (List HCell))
     (cs0 (List HCell))
     (es0 (List (Pair Int Int)))
     (r (List Int)))
    ((= (winv cs0 es0 r cells fls wl Nil) True)
     (= (anodup (e_addrs es0)) True)
     (= (le (+ (hlen cells) (+ (hlen wl) 1)) k) True))
    (=
      (winv
        cs0
        es0
        r
        (gwc (gh_wl k cells fls wl))
        (gwf (gh_wl k cells fls wl))
        Nil
        Nil)
      True))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hltT (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hn1 (= (le 0 (hlen cells)) True)
             (rewrite-with (lemma hlen_nonneg) lr lhs () () refl))
           (have hn2 (= (le 0 (hlen wl)) True)
             (rewrite-with (lemma hlen_nonneg) lr lhs () () refl))
           (have habs (= (le 1 0) True)
             (by arith (rows (goal 1) (hltT 1) (hn1 1) (hn2 1) (2 1))))
           (absurd (premise habs))))
       (case False
         (case-on wl List
           ((case Nil
              (chain
                (have hltF (= (lt k 1) False)
                  (steps ((rewrite (hyp 1) lr lhs true ())) refl))
                (have hstep (= (gh_wl k cells fls Nil) (Pair cells fls))
                  (steps
                    ((unfold gh_wl lhs)
                     (reduce lhs)
                     (rewrite (premise hltF) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hgc (= (gwc (Pair cells fls)) cells)
                  (steps ((unfold gwc lhs) (reduce lhs)) refl))
                (have hgw (= (gwf (Pair cells fls)) fls)
                  (steps ((unfold gwf lhs) (reduce lhs)) refl))
                (have hp0n (= (winv cs0 es0 r cells fls Nil Nil) True)
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (rewrite (hyp 0) lr rhs true ()))
                    refl))
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (rewrite (premise hstep) lr lhs true ())
                   (rewrite (premise hgc) lr lhs true ())
                   (rewrite (premise hgw) lr lhs true ())
                   (rewrite (premise hp0n) lr lhs true ()))
                  refl)))
            (case Cons
              (cur rest)
              (chain
                (have hp0
                  (= (winv cs0 es0 r cells fls (Cons cur rest) Nil) True)
                  (steps
                    ((rewrite (hyp 0) rl lhs true ())
                     (rewrite (premise 0) lr lhs true ()))
                    refl))
                (have hn1 (= (le 0 (hlen cells)) True)
                  (rewrite-with (lemma hlen_nonneg) lr lhs () () refl))
                (have hn2 (= (le 0 (hlen wl)) True)
                  (rewrite-with (lemma hlen_nonneg) lr lhs () () refl))
                (have hk1 (= (le 0 (- k 1)) True)
                  (by arith (rows (goal 1) (2 1) (hn1 1) (hn2 1))))
                (have hpack
                  (=
                    (andb
                      (winv cs0 es0 r cells fls rest (hslots_of cur))
                      (andb
                        (emem es0 (haddr_of cur) (harity_of cur))
                        (le
                          (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
                          (count_in (e_addrs es0) (haddr_of cur)))))
                    True)
                  (rewrite-with
                    (lemma winv_pop)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hp0) lr lhs true ())) refl))
                    refl))
                (have hwvp
                  (= (winv cs0 es0 r cells fls rest (hslots_of cur)) True)
                  (rewrite-with
                    (lemma andb_l)
                    lr
                    lhs
                    ((inst
                       b
                       (andb
                         (emem es0 (haddr_of cur) (harity_of cur))
                         (le
                           (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
                           (count_in (e_addrs es0) (haddr_of cur))))))
                    ((steps ((rewrite (premise hpack) lr lhs true ())) refl))
                    refl))
                (have hpk2
                  (=
                    (andb
                      (emem es0 (haddr_of cur) (harity_of cur))
                      (le
                        (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
                        (count_in (e_addrs es0) (haddr_of cur))))
                    True)
                  (rewrite-with
                    (lemma andb_r)
                    lr
                    lhs
                    ((inst a (winv cs0 es0 r cells fls rest (hslots_of cur))))
                    ((steps ((rewrite (premise hpack) lr lhs true ())) refl))
                    refl))
                (have hcurm (= (emem es0 (haddr_of cur) (harity_of cur)) True)
                  (rewrite-with
                    (lemma andb_l)
                    lr
                    lhs
                    ((inst
                       b
                       (le
                         (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
                         (count_in (e_addrs es0) (haddr_of cur)))))
                    ((steps ((rewrite (premise hpk2) lr lhs true ())) refl))
                    refl))
                (have hslk
                  (=
                    (le
                      (+ 1 (count_in (wa cells fls rest) (haddr_of cur)))
                      (count_in (e_addrs es0) (haddr_of cur)))
                    True)
                  (rewrite-with
                    (lemma andb_r)
                    lr
                    lhs
                    ((inst a (emem es0 (haddr_of cur) (harity_of cur))))
                    ((steps ((rewrite (premise hpk2) lr lhs true ())) refl))
                    refl))
                (case-on (gh_slots (hslots_of cur) cells rest) Pair
                  ((case Pair
                     (cells2 wl2)
                     (chain
                       (have hgsc
                         (= (gsc (gh_slots (hslots_of cur) cells rest)) cells2)
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (unfold gsc lhs)
                            (reduce lhs))
                           refl))
                       (have hgsw
                         (= (gsw (gh_slots (hslots_of cur) cells rest)) wl2)
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (unfold gsw lhs)
                            (reduce lhs))
                           refl))
                       (have hwalk0
                         (=
                           (andb
                             (winv
                               cs0
                               es0
                               r
                               (gsc (gh_slots (hslots_of cur) cells rest))
                               fls
                               (gsw (gh_slots (hslots_of cur) cells rest))
                               Nil)
                             (andb
                               (int_eq
                                 (+
                                   (hlen
                                     (gsc (gh_slots (hslots_of cur) cells rest)))
                                   (hlen
                                     (gsw (gh_slots (hslots_of cur) cells rest))))
                                 (+ (hlen cells) (hlen rest)))
                               (int_eq
                                 (count_in
                                   (wa
                                     (gsc (gh_slots (hslots_of cur) cells rest))
                                     fls
                                     (gsw (gh_slots (hslots_of cur) cells rest)))
                                   (haddr_of cur))
                                 (count_in (wa cells fls rest) (haddr_of cur)))))
                           True)
                         (rewrite-with
                           (lemma gh_slots_inv)
                           lr
                           lhs
                           ((inst x (haddr_of cur)))
                           ((steps
                              ((rewrite (premise hwvp) lr lhs true ()))
                              refl)
                            (steps ((rewrite (premise 1) lr lhs true ())) refl))
                           refl))
                       (have hwalk
                         (=
                           (andb
                             (winv cs0 es0 r cells2 fls wl2 Nil)
                             (andb
                               (int_eq
                                 (+ (hlen cells2) (hlen wl2))
                                 (+ (hlen cells) (hlen rest)))
                               (int_eq
                                 (count_in (wa cells2 fls wl2) (haddr_of cur))
                                 (count_in (wa cells fls rest) (haddr_of cur)))))
                           True)
                         (steps
                           ((rewrite (premise hgsc) rl lhs true ())
                            (rewrite (premise hgsw) rl lhs true ())
                            (rewrite (premise hwalk0) lr lhs true ()))
                           refl))
                       (have hwv2 (= (winv cs0 es0 r cells2 fls wl2 Nil) True)
                         (rewrite-with
                           (lemma andb_l)
                           lr
                           lhs
                           ((inst
                              b
                              (andb
                                (int_eq
                                  (+ (hlen cells2) (hlen wl2))
                                  (+ (hlen cells) (hlen rest)))
                                (int_eq
                                  (count_in (wa cells2 fls wl2) (haddr_of cur))
                                  (count_in (wa cells fls rest) (haddr_of cur))))))
                           ((steps
                              ((rewrite (premise hwalk) lr lhs true ()))
                              refl))
                           refl))
                       (have hwrest
                         (=
                           (andb
                             (int_eq
                               (+ (hlen cells2) (hlen wl2))
                               (+ (hlen cells) (hlen rest)))
                             (int_eq
                               (count_in (wa cells2 fls wl2) (haddr_of cur))
                               (count_in (wa cells fls rest) (haddr_of cur))))
                           True)
                         (rewrite-with
                           (lemma andb_r)
                           lr
                           lhs
                           ((inst a (winv cs0 es0 r cells2 fls wl2 Nil)))
                           ((steps
                              ((rewrite (premise hwalk) lr lhs true ()))
                              refl))
                           refl))
                       (have hsum
                         (=
                           (int_eq
                             (+ (hlen cells2) (hlen wl2))
                             (+ (hlen cells) (hlen rest)))
                           True)
                         (rewrite-with
                           (lemma andb_l)
                           lr
                           lhs
                           ((inst
                              b
                              (int_eq
                                (count_in (wa cells2 fls wl2) (haddr_of cur))
                                (count_in (wa cells fls rest) (haddr_of cur)))))
                           ((steps
                              ((rewrite (premise hwrest) lr lhs true ()))
                              refl))
                           refl))
                       (have hcnt
                         (=
                           (int_eq
                             (count_in (wa cells2 fls wl2) (haddr_of cur))
                             (count_in (wa cells fls rest) (haddr_of cur)))
                           True)
                         (rewrite-with
                           (lemma andb_r)
                           lr
                           lhs
                           ((inst
                              a
                              (int_eq
                                (+ (hlen cells2) (hlen wl2))
                                (+ (hlen cells) (hlen rest)))))
                           ((steps
                              ((rewrite (premise hwrest) lr lhs true ()))
                              refl))
                           refl))
                       (have hlenc (= (hlen (Cons cur rest)) (+ 1 (hlen rest)))
                         (steps ((unfold hlen lhs) (reduce lhs)) refl))
                       (have hp2c
                         (=
                           (le (+ (hlen cells) (+ (hlen (Cons cur rest)) 1)) k)
                           True)
                         (steps
                           ((rewrite (hyp 1) rl lhs true ())
                            (rewrite (premise 2) lr lhs true ()))
                           refl))
                       (have hble
                         (=
                           (le (+ (hlen cells2) (+ (hlen wl2) 1)) (- k 1))
                           True)
                         (by arith (rows (goal 1) (hp2c 1) (hlenc 1) (hsum -1))))
                       (have hslk2
                         (=
                           (le
                             (+ 1 (count_in (wa cells2 fls wl2) (haddr_of cur)))
                             (count_in (e_addrs es0) (haddr_of cur)))
                           True)
                         (by arith (rows (goal 1) (hslk 1) (hcnt -1))))
                       (case-on (lt (harity_of cur) 16) Bool
                         ((case True
                            (chain
                              (have hltF2 (= (lt k 1) False)
                                (steps ((rewrite (hyp 3) lr lhs true ())) refl))
                              (have hstep
                                (=
                                  (gh_wl k cells fls (Cons cur rest))
                                  (gh_wl
                                    (- k 1)
                                    cells2
                                    (fls_push
                                      fls
                                      (harity_of cur)
                                      (haddr_of cur))
                                    wl2))
                                (steps
                                  ((unfold gh_wl lhs)
                                   (reduce lhs)
                                   (rewrite (premise hltF2) lr lhs true ())
                                   (reduce lhs)
                                   (rewrite (hyp 1) lr lhs true ())
                                   (reduce lhs)
                                   (rewrite (hyp True) lr lhs true ())
                                   (reduce lhs))
                                  refl))
                              (have hpush
                                (=
                                  (winv
                                    cs0
                                    es0
                                    r
                                    cells2
                                    (fls_push
                                      fls
                                      (harity_of cur)
                                      (haddr_of cur))
                                    wl2
                                    Nil)
                                  True)
                                (rewrite-with
                                  (lemma winv_push)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise hwv2) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hcurm) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hslk2) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hih
                                (=
                                  (winv
                                    cs0
                                    es0
                                    r
                                    (gwc
                                      (gh_wl
                                        (- k 1)
                                        cells2
                                        (fls_push
                                          fls
                                          (harity_of cur)
                                          (haddr_of cur))
                                        wl2))
                                    (gwf
                                      (gh_wl
                                        (- k 1)
                                        cells2
                                        (fls_push
                                          fls
                                          (harity_of cur)
                                          (haddr_of cur))
                                        wl2))
                                    Nil
                                    Nil)
                                  True)
                                (rewrite-with
                                  (hyp 4)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise hpush) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise 1) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hble) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hk1) lr lhs true ()))
                                     refl)
                                   (by arith (rows (goal 1))))
                                  refl))
                              (steps
                                ((rewrite (hyp 2) lr lhs true ())
                                 (rewrite (premise hstep) lr lhs true ())
                                 (rewrite (premise hih) lr lhs true ()))
                                refl)))
                          (case False
                            (chain
                              (have hltF2 (= (lt k 1) False)
                                (steps ((rewrite (hyp 3) lr lhs true ())) refl))
                              (have hstep
                                (=
                                  (gh_wl k cells fls (Cons cur rest))
                                  (gh_wl (- k 1) cells2 fls wl2))
                                (steps
                                  ((unfold gh_wl lhs)
                                   (reduce lhs)
                                   (rewrite (premise hltF2) lr lhs true ())
                                   (reduce lhs)
                                   (rewrite (hyp 1) lr lhs true ())
                                   (reduce lhs)
                                   (rewrite (hyp False) lr lhs true ())
                                   (reduce lhs))
                                  refl))
                              (have hih
                                (=
                                  (winv
                                    cs0
                                    es0
                                    r
                                    (gwc (gh_wl (- k 1) cells2 fls wl2))
                                    (gwf (gh_wl (- k 1) cells2 fls wl2))
                                    Nil
                                    Nil)
                                  True)
                                (rewrite-with
                                  (hyp 4)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise hwv2) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise 1) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hble) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hk1) lr lhs true ()))
                                     refl)
                                   (by arith (rows (goal 1))))
                                  refl))
                              (steps
                                ((rewrite (hyp 2) lr lhs true ())
                                 (rewrite (premise hstep) lr lhs true ())
                                 (rewrite (premise hih) lr lhs true ()))
                                refl))))))))))))))))))

;; --- the finale: entry and rebuild -------------------------------------------------

;; a held root references a live cell
(claim roots_ok_memb
  (goal ((r (List Int)) (as (List Int)) (v Int))
    ((= (roots_ok r as) True) (= (memb r v) True))
    (= (memb as v) True))
  (induct r
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (x t)
       (chain
         (have hm (= (memb as x) True)
           (rewrite-with
             (lemma ro_hd)
             lr
             lhs
             ((inst t t))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have ht (= (roots_ok t as) True)
           (rewrite-with
             (lemma ro_tl)
             lr
             lhs
             ((inst x x))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (case-on (int_eq x v) Bool
           ((case True
              (chain
                (have hT (= (int_eq x v) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hxv (= x v)
                  (by arith (list (list 1 0 0 0 0 -1) (list 1 0 0 0 0 1))))
                (steps
                  ((rewrite (premise hxv) rl lhs true ())
                   (rewrite (premise hm) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hmt (= (memb t v) True)
                  (steps
                    ((rewrite (premise 1) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih (= (memb as v) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps ((rewrite (premise hih) lr lhs true ())) refl))))))))))

;; rebuilding hinv over the same ghost with new roots
(claim hinv_same
  (goal ((rb Int) (g GHeap) (r (List Int)) (r2 (List Int)))
    ((= (hinv rb g r) True)
     (= (counts_ok (gcells_of g) (gcells_of g) r2 (graw_of g)) True)
     (= (roots_ok r2 (haddrs (gcells_of g))) True))
    (= (hinv rb g r2) True))
  (chain
    (have h1 (= (le 0 rb) True)
      (rewrite-with
        (lemma hi_rb0)
        lr
        lhs
        ((inst g g) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h2 (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h3 (= (le (glo_of g) (gtop_of g)) True)
      (rewrite-with
        (lemma hi_lot)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h4 (= (le (gtop_of g) (gend_of g)) True)
      (rewrite-with
        (lemma hi_te)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h5 (= (le (gend_of g) 4294967296) True)
      (rewrite-with
        (lemma hi_e32)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h6 (= (int_eq (mod (glo_of g) 8) 0) True)
      (rewrite-with
        (lemma hi_alo)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h7 (= (int_eq (mod (gtop_of g) 8) 0) True)
      (rewrite-with
        (lemma hi_atop)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h8 (= (e_disj (ext_all g)) True)
      (rewrite-with
        (lemma hi_disj)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h9 (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
      (rewrite-with
        (lemma hi_brk)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h10 (= (cells_ok (gcells_of g)) True)
      (rewrite-with
        (lemma hi_cells)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h13 (= (raw_ok (graw_of g) (gcells_of g)) True)
      (rewrite-with
        (lemma hi_raw)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold hinv lhs)
       (reduce lhs)
       (rewrite (premise h1) lr lhs true ())
       (rewrite (premise h2) lr lhs true ())
       (rewrite (premise h3) lr lhs true ())
       (rewrite (premise h4) lr lhs true ())
       (rewrite (premise h5) lr lhs true ())
       (rewrite (premise h6) lr lhs true ())
       (rewrite (premise h7) lr lhs true ())
       (rewrite (premise h8) lr lhs true ())
       (rewrite (premise h9) lr lhs true ())
       (rewrite (premise h10) lr lhs true ())
       (rewrite (premise 1) lr lhs true ())
       (rewrite (premise 2) lr lhs true ())
       (rewrite (premise h13) lr lhs true ())
       (compute lhs))
      refl)))

;; THE ENTRY: a well-formed heap with no raw cell and a held root gives
;; the walk invariant with the dropped root as the walked suffix, plus
;; the static facts every leg consumes
(claim hinv_entry
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (graw_of g) None) (= (memb r v) True))
    (=
      (andb
        (winv
          (gcells_of g)
          (ext_all g)
          (irem r v)
          (gcells_of g)
          (gfree_of g)
          Nil
          (Cons v Nil))
        (andb (anodup (e_addrs (ext_all g))) (memb (haddrs (gcells_of g)) v)))
      True))
  (chain
    (have hcnt (= (counts_ok (gcells_of g) (gcells_of g) r (graw_of g)) True)
      (rewrite-with
        (lemma hi_cnts)
        lr
        lhs
        ((inst rb rb))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hco (= (cells_ok (gcells_of g)) True)
      (rewrite-with
        (lemma hi_cells)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hro (= (roots_ok r (haddrs (gcells_of g))) True)
      (rewrite-with
        (lemma hi_roots)
        lr
        lhs
        ((inst rb rb))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hdj (= (e_disj (ext_all g)) True)
      (rewrite-with
        (lemma hi_disj)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hbk (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
      (rewrite-with
        (lemma hi_brk)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hcn (= (counts_ok (gcells_of g) (gcells_of g) r None) True)
      (steps
        ((rewrite (premise 1) rl lhs true ())
         (rewrite (premise hcnt) lr lhs true ()))
        refl))
    (have hwe (= (wexact (gcells_of g) (gcells_of g) r Nil Nil) True)
      (rewrite-with
        (lemma counts_wexact)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hcn) lr lhs true ())) refl))
        refl))
    (have hcin (= (le 1 (count_in r v)) True)
      (rewrite-with
        (lemma memb_cin_pos)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hrd
      (= (wexact (gcells_of g) (gcells_of g) (irem r v) Nil (Cons v Nil)) True)
      (rewrite-with
        (lemma wex_rdrop)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hwe) lr lhs true ())) refl)
         (steps ((rewrite (premise hcin) lr lhs true ())) refl))
        refl))
    (have hro2 (= (roots_ok (irem r v) (haddrs (gcells_of g))) True)
      (rewrite-with
        (lemma roots_ok_dropr)
        lr
        lhs
        ((inst v v))
        ((steps ((rewrite (premise hro) lr lhs true ())) refl))
        refl))
    (have hn1 (= (hexts Nil) Nil)
      (steps ((unfold hexts lhs) (reduce lhs)) refl))
    (have hn2 (= (rexts None) Nil)
      (steps ((unfold rexts lhs) (reduce lhs)) refl))
    (have hn3 (= (haddrs Nil) Nil)
      (steps ((unfold haddrs lhs) (reduce lhs)) refl))
    (have hn4 (= (e_addrs Nil) Nil)
      (steps ((unfold e_addrs lhs) (reduce lhs)) refl))
    (have hwex (= (wext (gcells_of g) (gfree_of g) Nil) (ext_all g))
      (steps
        ((unfold wext lhs)
         (reduce lhs)
         (rewrite (premise hn1) lr lhs true ())
         (unfold ext_all rhs)
         (reduce rhs)
         (rewrite (premise 1) lr rhs true ())
         (rewrite (premise hn2) lr rhs true ()))
        refl))
    (have heal (= (eall (wext (gcells_of g) (gfree_of g) Nil) (ext_all g)) True)
      (steps
        ((rewrite (premise hwex) lr lhs true ())
         (rewrite (lemma eall_refl) lr lhs true ()))
        refl))
    (have hea1
      (=
        (e_addrs (ext_all g))
        (iapp
          (e_addrs (hexts (gcells_of g)))
          (iapp (e_addrs (fexts (gfree_of g) 0)) (e_addrs (rexts (graw_of g))))))
      (steps
        ((unfold ext_all lhs)
         (reduce lhs)
         (rewrite (lemma eaddrs_app) lr lhs true ())
         (rewrite (lemma eaddrs_app) lr lhs true ()))
        refl))
    (have hea2
      (=
        (e_addrs (ext_all g))
        (iapp (haddrs (gcells_of g)) (iapp (faddrs (gfree_of g)) Nil)))
      (steps
        ((rewrite (premise hea1) lr lhs true ())
         (rewrite (lemma hexts_eaddrs) lr lhs true ())
         (rewrite (lemma fexts_addrs) lr lhs true ())
         (rewrite (premise 1) lr lhs true ())
         (rewrite (premise hn2) lr lhs true ())
         (rewrite (premise hn4) lr lhs true ()))
        refl))
    (have hwa (= (wa (gcells_of g) (gfree_of g) Nil) (e_addrs (ext_all g)))
      (steps
        ((unfold wa lhs)
         (reduce lhs)
         (rewrite (premise hn3) lr lhs true ())
         (rewrite (premise hea2) lr rhs true ()))
        refl))
    (have hmsub
      (= (msub (wa (gcells_of g) (gfree_of g) Nil) (e_addrs (ext_all g))) True)
      (steps
        ((rewrite (premise hwa) lr lhs true ())
         (rewrite (lemma msub_refl) lr lhs true ()))
        refl))
    (have hsq (= (hsubq (gcells_of g) (gcells_of g)) True)
      (rewrite-with (lemma hsubq_refl) lr lhs () () refl))
    (have hal0 (= (aligned8 (e_addrs (ext_all g))) True)
      (rewrite-with
        (lemma ebrk_aligned)
        lr
        lhs
        ((inst lo (glo_of g)) (inst top (gtop_of g)))
        ((steps ((rewrite (premise hbk) lr lhs true ())) refl))
        refl))
    (have hal1
      (=
        (aligned8
          (iapp (haddrs (gcells_of g)) (iapp (faddrs (gfree_of g)) Nil)))
        True)
      (steps
        ((rewrite (premise hea2) rl lhs true ())
         (rewrite (premise hal0) lr lhs true ()))
        refl))
    (have hal (= (aligned8 (haddrs (gcells_of g))) True)
      (rewrite-with
        (lemma al8_app_l)
        lr
        lhs
        ((inst b (iapp (faddrs (gfree_of g)) Nil)))
        ((steps ((rewrite (premise hal1) lr lhs true ())) refl))
        refl))
    (have hwinv
      (=
        (winv
          (gcells_of g)
          (ext_all g)
          (irem r v)
          (gcells_of g)
          (gfree_of g)
          Nil
          (Cons v Nil))
        True)
      (steps
        ((unfold winv lhs)
         (reduce lhs)
         (rewrite (premise hrd) lr lhs true ())
         (rewrite (premise hco) lr lhs true ())
         (rewrite (premise hro2) lr lhs true ())
         (rewrite (premise heal) lr lhs true ())
         (rewrite (premise hmsub) lr lhs true ())
         (rewrite (premise hsq) lr lhs true ())
         (rewrite (premise hal) lr lhs true ())
         (compute lhs))
        refl))
    (have hnd (= (anodup (e_addrs (ext_all g))) True)
      (rewrite-with
        (lemma ed_nodup)
        lr
        lhs
        ((inst lo (glo_of g)) (inst top (gtop_of g)))
        ((steps ((rewrite (premise hdj) lr lhs true ())) refl)
         (steps ((rewrite (premise hbk) lr lhs true ())) refl))
        refl))
    (have hmv (= (memb (haddrs (gcells_of g)) v) True)
      (rewrite-with
        (lemma roots_ok_memb)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise hro) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hwinv) lr lhs true ())
       (rewrite (premise hnd) lr lhs true ())
       (rewrite (premise hmv) lr lhs true ())
       (compute lhs))
      refl)))

;; THE EXIT: the walk invariant at rest rebuilds hinv over the updated
;; ghost — separation re-derived from membership + domination, exactly
;; as the design record promised
(claim winv_hinv
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (r2 (List Int))
     (cells2 (List HCell))
     (fls2 (List (List Int))))
    ((= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (winv (gcells_of g) (ext_all g) r2 cells2 fls2 Nil Nil) True))
    (= (hinv rb (with_gcells cells2 (with_gfree fls2 g)) r2) True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hgl
           (= (glo_of (with_gcells cells2 (with_gfree fls2 g))) (glo_of g))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute lhs)
              (compute rhs))
             refl))
         (have hgt
           (= (gtop_of (with_gcells cells2 (with_gfree fls2 g))) (gtop_of g))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute lhs)
              (compute rhs))
             refl))
         (have hge
           (= (gend_of (with_gcells cells2 (with_gfree fls2 g))) (gend_of g))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute lhs)
              (compute rhs))
             refl))
         (have hgr2
           (= (graw_of (with_gcells cells2 (with_gfree fls2 g))) (graw_of g))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute lhs)
              (compute rhs))
             refl))
         (have hgc2
           (= (gcells_of (with_gcells cells2 (with_gfree fls2 g))) cells2)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf2 (= (gfree_of (with_gcells cells2 (with_gfree fls2 g))) fls2)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hex (= (wexact cells2 cells2 r2 Nil Nil) True)
           (rewrite-with
             (lemma wi_ex)
             lr
             lhs
             ((inst cs0 (gcells_of g)) (inst es0 (ext_all g)) (inst fls fls2))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok cells2) True)
           (rewrite-with
             (lemma wi_co)
             lr
             lhs
             ((inst cs0 (gcells_of g))
              (inst es0 (ext_all g))
              (inst r r2)
              (inst fls fls2)
              (inst wl Nil)
              (inst ws Nil))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hro (= (roots_ok r2 (haddrs cells2)) True)
           (rewrite-with
             (lemma wi_ro)
             lr
             lhs
             ((inst cs0 (gcells_of g))
              (inst es0 (ext_all g))
              (inst fls fls2)
              (inst wl Nil)
              (inst ws Nil))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hea (= (eall (wext cells2 fls2 Nil) (ext_all g)) True)
           (rewrite-with
             (lemma wi_ea)
             lr
             lhs
             ((inst cs0 (gcells_of g)) (inst r r2) (inst ws Nil))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hms (= (msub (wa cells2 fls2 Nil) (e_addrs (ext_all g))) True)
           (rewrite-with
             (lemma wi_ms)
             lr
             lhs
             ((inst cs0 (gcells_of g)) (inst r r2) (inst ws Nil))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hcnt2 (= (counts_ok cells2 cells2 r2 None) True)
           (rewrite-with
             (lemma wexact_counts)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hex) lr lhs true ())) refl))
             refl))
         (have hdj (= (e_disj (ext_all g)) True)
           (rewrite-with
             (lemma hi_disj)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbk (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_brk)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hnd (= (anodup (e_addrs (ext_all g))) True)
           (rewrite-with
             (lemma ed_nodup)
             lr
             lhs
             ((inst lo (glo_of g)) (inst top (gtop_of g)))
             ((steps ((rewrite (premise hdj) lr lhs true ())) refl)
              (steps ((rewrite (premise hbk) lr lhs true ())) refl))
             refl))
         (have hn1 (= (hexts Nil) Nil)
           (steps ((unfold hexts lhs) (reduce lhs)) refl))
         (have hn2 (= (rexts None) Nil)
           (steps ((unfold rexts lhs) (reduce lhs)) refl))
         (have hn3 (= (haddrs Nil) Nil)
           (steps ((unfold haddrs lhs) (reduce lhs)) refl))
         (have hn4 (= (e_addrs Nil) Nil)
           (steps ((unfold e_addrs lhs) (reduce lhs)) refl))
         (have hwaeq (= (e_addrs (wext cells2 fls2 Nil)) (wa cells2 fls2 Nil))
           (steps
             ((unfold wext lhs)
              (reduce lhs)
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma hexts_eaddrs) lr lhs true ())
              (rewrite (lemma fexts_addrs) lr lhs true ())
              (rewrite (premise hn3) lr lhs true ())
              (unfold wa rhs)
              (reduce rhs)
              (rewrite (premise hn3) lr rhs true ()))
             refl))
         (have hnd2 (= (anodup (e_addrs (wext cells2 fls2 Nil))) True)
           (steps
             ((rewrite (premise hwaeq) lr lhs true ()))
             (rewrite-with
               (lemma msub_anodup)
               lr
               lhs
               ((inst ys (e_addrs (ext_all g))))
               ((steps ((rewrite (premise hms) lr lhs true ())) refl)
                (steps ((rewrite (premise hnd) lr lhs true ())) refl))
               refl)))
         (have hdj2 (= (e_disj (wext cells2 fls2 Nil)) True)
           (rewrite-with
             (lemma ed_intro)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hea) lr lhs true ())) refl)
              (steps ((rewrite (premise hnd2) lr lhs true ())) refl)
              (steps ((rewrite (premise hdj) lr lhs true ())) refl))
             refl))
         (have hbk2
           (= (e_brk (wext cells2 fls2 Nil) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma eb_intro)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hea) lr lhs true ())) refl)
              (steps ((rewrite (premise hbk) lr lhs true ())) refl))
             refl))
         (have hext2
           (=
             (ext_all (with_gcells cells2 (with_gfree fls2 g)))
             (wext cells2 fls2 Nil))
           (steps
             ((unfold ext_all lhs)
              (reduce lhs)
              (rewrite (premise hgc2) lr lhs true ())
              (rewrite (premise hgf2) lr lhs true ())
              (rewrite (premise hgr2) lr lhs true ())
              (rewrite (premise 1) lr lhs true ())
              (rewrite (premise hn2) lr lhs true ())
              (unfold wext rhs)
              (reduce rhs)
              (rewrite (premise hn1) lr rhs true ()))
             refl))
         (have h1 (= (le 0 rb) True)
           (rewrite-with
             (lemma hi_rb0)
             lr
             lhs
             ((inst g g) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h2 (= (le (+ rb 152) (glo_of g)) True)
           (rewrite-with
             (lemma hi_hdr)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h3 (= (le (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_lot)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h4 (= (le (gtop_of g) (gend_of g)) True)
           (rewrite-with
             (lemma hi_te)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h5 (= (le (gend_of g) 4294967296) True)
           (rewrite-with
             (lemma hi_e32)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h6 (= (int_eq (mod (glo_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_alo)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h7 (= (int_eq (mod (gtop_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_atop)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hrawn (= (raw_ok None cells2) True)
           (steps ((unfold raw_ok lhs) (reduce lhs)) refl))
         (steps
           ((unfold hinv lhs)
            (reduce lhs)
            (rewrite (premise hgl) lr lhs true ())
            (rewrite (premise hgt) lr lhs true ())
            (rewrite (premise hge) lr lhs true ())
            (rewrite (premise hgr2) lr lhs true ())
            (rewrite (premise hgc2) lr lhs true ())
            (rewrite (premise hext2) lr lhs true ())
            (rewrite (premise 1) lr lhs true ())
            (rewrite (premise h1) lr lhs true ())
            (rewrite (premise h2) lr lhs true ())
            (rewrite (premise h3) lr lhs true ())
            (rewrite (premise h4) lr lhs true ())
            (rewrite (premise h5) lr lhs true ())
            (rewrite (premise h6) lr lhs true ())
            (rewrite (premise h7) lr lhs true ())
            (rewrite (premise hdj2) lr lhs true ())
            (rewrite (premise hbk2) lr lhs true ())
            (rewrite (premise hco) lr lhs true ())
            (rewrite (premise hcnt2) lr lhs true ())
            (rewrite (premise hro) lr lhs true ())
            (rewrite (premise hrawn) lr lhs true ())
            (compute lhs))
           refl))))))

;; --- THE RELEASE THEOREM -----------------------------------------------------------
;; Dropping one held root reference preserves the heap invariant, and
;; every surviving cell keeps its structure (address, tag, arity,
;; slots; the count may only fall).  The five legs of gh_dec: an odd
;; word and a find-miss are vacuous (a held root is a live, 8-aligned
;; address); an immortal root is ghost identity (the sound leak's pure
;; face); a shared root is one decrement; a dying root runs the
;; cascade — entry by wex_rdrop, the loop by gh_wl_inv, the exit by
;; winv_hinv.
(claim hinv_dec_full
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (graw_of g) None) (= (memb r v) True))
    (=
      (andb
        (hinv rb (gh_dec g v) (irem r v))
        (hsubq (gcells_of (gh_dec g v)) (gcells_of g)))
      True))
  (chain
    (have hentry
      (=
        (andb
          (winv
            (gcells_of g)
            (ext_all g)
            (irem r v)
            (gcells_of g)
            (gfree_of g)
            Nil
            (Cons v Nil))
          (andb (anodup (e_addrs (ext_all g))) (memb (haddrs (gcells_of g)) v)))
        True)
      (rewrite-with
        (lemma hinv_entry)
        lr
        lhs
        ((inst rb rb))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hwinv0
      (=
        (winv
          (gcells_of g)
          (ext_all g)
          (irem r v)
          (gcells_of g)
          (gfree_of g)
          Nil
          (Cons v Nil))
        True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb (anodup (e_addrs (ext_all g))) (memb (haddrs (gcells_of g)) v))))
        ((steps ((rewrite (premise hentry) lr lhs true ())) refl))
        refl))
    (have hrest
      (=
        (andb (anodup (e_addrs (ext_all g))) (memb (haddrs (gcells_of g)) v))
        True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst
           a
           (winv
             (gcells_of g)
             (ext_all g)
             (irem r v)
             (gcells_of g)
             (gfree_of g)
             Nil
             (Cons v Nil))))
        ((steps ((rewrite (premise hentry) lr lhs true ())) refl))
        refl))
    (have hnd (= (anodup (e_addrs (ext_all g))) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (memb (haddrs (gcells_of g)) v)))
        ((steps ((rewrite (premise hrest) lr lhs true ())) refl))
        refl))
    (have hmv (= (memb (haddrs (gcells_of g)) v) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (anodup (e_addrs (ext_all g)))))
        ((steps ((rewrite (premise hrest) lr lhs true ())) refl))
        refl))
    (have hal (= (aligned8 (haddrs (gcells_of g))) True)
      (rewrite-with
        (lemma wi_al)
        lr
        lhs
        ((inst cs0 (gcells_of g))
         (inst es0 (ext_all g))
         (inst r (irem r v))
         (inst fls (gfree_of g))
         (inst wl Nil)
         (inst ws (Cons v Nil)))
        ((steps ((rewrite (premise hwinv0) lr lhs true ())) refl))
        refl))
    (case-on (int_eq (mod v 2) 1) Bool
      ((case True
         (chain
           (have hoT (= (int_eq (mod v 2) 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hnm (= (memb (haddrs (gcells_of g)) v) False)
             (rewrite-with
               (lemma al8_odd_nmemb)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hal) lr lhs true ())) refl)
                (steps ((rewrite (premise hoT) lr lhs true ())) refl))
               refl))
           (have hf (= False True)
             (steps
               ((rewrite (premise hnm) rl lhs true ())
                (rewrite (premise hmv) lr lhs true ()))
               refl))
           (absurd (premise hf))))
       (case False
         (case-on (hfind (gcells_of g) v) Option
           ((case None
              (chain
                (have hnm (= (memb (haddrs (gcells_of g)) v) False)
                  (steps
                    ((rewrite (lemma memb_hhas) lr lhs true ())
                     (unfold hhas lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hf (= False True)
                  (steps
                    ((rewrite (premise hnm) rl lhs true ())
                     (rewrite (premise hmv) lr lhs true ()))
                    refl))
                (absurd (premise hf))))
            (case Some
              (c)
              (chain
                (have hgd (= (hfget (gcells_of g) v) c)
                  (steps
                    ((unfold hfget lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (case-on (le 2147483648 (hcount_of c)) Bool
                  ((case True
                     (chain
                       (have hstep (= (gh_dec g v) g)
                         (steps
                           ((unfold gh_dec lhs)
                            (reduce lhs)
                            (rewrite (hyp 2) lr lhs true ())
                            (reduce lhs)
                            (rewrite (hyp 1) lr lhs true ())
                            (reduce lhs)
                            (rewrite (hyp True) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (have hle
                         (=
                           (le 2147483648 (hcount_of (hfget (gcells_of g) v)))
                           True)
                         (steps
                           ((rewrite (premise hgd) lr lhs true ())
                            (rewrite (hyp True) lr lhs true ()))
                           refl))
                       (have hwv1
                         (=
                           (winv
                             (gcells_of g)
                             (ext_all g)
                             (irem r v)
                             (gcells_of g)
                             (gfree_of g)
                             Nil
                             Nil)
                           True)
                         (rewrite-with
                           (lemma winv_step_imm)
                           lr
                           lhs
                           ((inst w v))
                           ((steps
                              ((rewrite (premise hwinv0) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hnd) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hmv) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hle) lr lhs true ()))
                              refl))
                           refl))
                       (have hwex
                         (=
                           (wexact
                             (gcells_of g)
                             (gcells_of g)
                             (irem r v)
                             Nil
                             Nil)
                           True)
                         (rewrite-with
                           (lemma wi_ex)
                           lr
                           lhs
                           ((inst cs0 (gcells_of g))
                            (inst es0 (ext_all g))
                            (inst fls (gfree_of g)))
                           ((steps
                              ((rewrite (premise hwv1) lr lhs true ()))
                              refl))
                           refl))
                       (have hcnt
                         (=
                           (counts_ok
                             (gcells_of g)
                             (gcells_of g)
                             (irem r v)
                             None)
                           True)
                         (rewrite-with
                           (lemma wexact_counts)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hwex) lr lhs true ()))
                              refl))
                           refl))
                       (have hcnt2
                         (=
                           (counts_ok
                             (gcells_of g)
                             (gcells_of g)
                             (irem r v)
                             (graw_of g))
                           True)
                         (steps
                           ((rewrite (premise 1) lr lhs true ())
                            (rewrite (premise hcnt) lr lhs true ()))
                           refl))
                       (have hro2
