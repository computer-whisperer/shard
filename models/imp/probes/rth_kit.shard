                                  ((steps
                                     ((rewrite (premise f16e) lr lhs true ())
                                      (rewrite (premise hor2a) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hd1fg
                                (=
                                  (e_disj1
                                    v
                                    (harity_of (hfget gc v))
                                    (fexts gf 0))
                                  True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hgf0) rl lhs true ())
                                   (rewrite (premise hd1f) lr lhs true ()))
                                  refl))
                              (have hn0g
                                (= (le 0 (harity_of (hfget gc v))) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
                                   (rewrite (premise hn0) lr lhs true ()))
                                  refl))
                              (have c5
                                (=
                                  (hfree_rep
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    rb
                                    0
                                    gf)
                                  True)
                                (rewrite-with
                                  (lemma hfree_rep_fr)
                                  lr
                                  lhs
                                  ((inst nb (harity_of (hfget gc v))))
                                  ((steps
                                     ((rewrite (premise hfr) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hd1fg) lr lhs true ()))
                                     refl)
                                   (steps
                                     ((rewrite (premise hor) lr lhs true ()))
                                     refl)
                                   (steps ((compute lhs)) refl)
                                   (steps
                                     ((rewrite (premise hn0g) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hcrg (= (hcells_rep m (gcells_of g)) True)
                                (rewrite-with
                                  (lemma hrx_cells)
                                  lr
                                  lhs
                                  ((inst rb rb))
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hcr (= (hcells_rep m gc) True)
                                (steps
                                  ((rewrite (premise hgc0) rl lhs true ())
