               (fl_set gf n rest))
             True)
           (rewrite-with
             (lemma hfree_rep_sethead)
             lr
             lhs
             ((inst p p))
             ((steps ((rewrite (premise hfr) lr lhs true ())) refl)
              (steps
                ((rewrite (premise hgf0) rl lhs true ())
                 (rewrite (premise 3) lr lhs true ()))
                refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl)
              (steps ((rewrite (premise hdH) lr lhs true ())) refl)
              (steps ((compute lhs)) refl)
              (steps ((rewrite (premise hl0) lr lhs true ())) refl)
              (steps ((rewrite (premise hl1) lr lhs true ())) refl))
