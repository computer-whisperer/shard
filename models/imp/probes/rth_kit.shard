;; the init bytes mean the empty ghost
(claim hr_init
  (goal ((m Mem) (rb Int) (lo Int) (hi Int))
    ((= (le 0 lo) True)
     (= (lt lo 18446744073709551616) True)
     (= (le 0 hi) True)
     (= (lt hi 18446744073709551616) True))
    (= (heap_rep (m_init m rb lo hi) rb (gh_init lo hi)) True))
  (chain
    (have hqlo (= (int_eq lo lo) True)
      (by arith (list (list 1 0 0 0 0) (list 1 0 0 0 0))))
    (have hqhi (= (int_eq hi hi) True)
      (by arith (list (list 1 0 0 0 0 0) (list 1 0 0 0 0 0))))
    (have hrt (= (load_le (iw8) (m_init m rb lo hi) rb) lo)
      (rewrite-with
        (lemma m_init_rd_top)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hre (= (load_le (iw8) (m_init m rb lo hi) (+ rb 8)) hi)
      (rewrite-with
        (lemma m_init_rd_end)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise 3) lr lhs true ())) refl))
        refl))
    (have hrd (= (load_le (iw8) (m_init m rb lo hi) (+ rb 16)) 0)
      (rewrite-with (lemma m_init_rd_dep) lr lhs () () refl))
    (have hh0 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 24)) 0)
      (rewrite-with (lemma m_init_rd_h0) lr lhs () () refl))
    (have hh1 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 32)) 0)
      (rewrite-with (lemma m_init_rd_h1) lr lhs () () refl))
    (have hh2 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 40)) 0)
      (rewrite-with (lemma m_init_rd_h2) lr lhs () () refl))
    (have hh3 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 48)) 0)
      (rewrite-with (lemma m_init_rd_h3) lr lhs () () refl))
    (have hh4 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 56)) 0)
      (rewrite-with (lemma m_init_rd_h4) lr lhs () () refl))
    (have hh5 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 64)) 0)
      (rewrite-with (lemma m_init_rd_h5) lr lhs () () refl))
    (have hh6 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 72)) 0)
      (rewrite-with (lemma m_init_rd_h6) lr lhs () () refl))
    (have hh7 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 80)) 0)
      (rewrite-with (lemma m_init_rd_h7) lr lhs () () refl))
    (have hh8 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 88)) 0)
      (rewrite-with (lemma m_init_rd_h8) lr lhs () () refl))
    (have hh9 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 96)) 0)
      (rewrite-with (lemma m_init_rd_h9) lr lhs () () refl))
    (have hh10 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 104)) 0)
      (rewrite-with (lemma m_init_rd_h10) lr lhs () () refl))
    (have hh11 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 112)) 0)
      (rewrite-with (lemma m_init_rd_h11) lr lhs () () refl))
    (have hh12 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 120)) 0)
      (rewrite-with (lemma m_init_rd_h12) lr lhs () () refl))
    (have hh13 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 128)) 0)
      (rewrite-with (lemma m_init_rd_h13) lr lhs () () refl))
    (have hh14 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 136)) 0)
      (rewrite-with (lemma m_init_rd_h14) lr lhs () () refl))
    (have hh15 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 144)) 0)
      (rewrite-with (lemma m_init_rd_h15) lr lhs () () refl))
    (steps
      ((compute lhs (stop iw8 m_init))
       (rewrite (premise hrt) lr lhs true ())
       (rewrite (premise hqlo) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hre) lr lhs true ())
       (rewrite (premise hqhi) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hrd) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh0) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh1) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh2) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh3) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh4) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh5) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh6) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh7) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh8) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh9) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh10) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh11) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh12) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh13) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh14) lr lhs true ())
       (compute lhs (stop iw8 m_init))
       (rewrite (premise hh15) lr lhs true ())
       (compute lhs (stop iw8 m_init)))
      refl)))

;; --- the pure theory: reachability ------------------------------------------------
;; C2b-2 (the design record's slices).  Reachability over the ghost:
;; roots ∪ immortals seed the frontier; one newest-first pass suffices
;; because acyclicity is the list order (a cell can only be referenced
;; by NEWER cells, which the pass has already visited).

;; the reference words of a slot list (references are even)
(fn slot_refs ((ws (List Int))) (List Int)
  (measure (struct ws))
  (match ws
    (Nil Nil)
    ((Cons w t) (if (int_eq (mod w 2) 1) (slot_refs t) (Cons w (slot_refs t))))))

;; the immortal cells' addresses
(fn imm_addrs ((cs (List HCell))) (List Int)
  (measure (struct cs))
  (match cs
    (Nil Nil)
    ((Cons c t)
     (if (le 2147483648 (hcount_of c)) (Cons (haddr_of c) (imm_addrs t))
     (imm_addrs t)))))

;; the frontier after the newest-first pass: a frontiered cell donates
;; its slot references
(fn gh_reach ((cs (List HCell)) (fr (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (Nil fr)
    ((Cons c rest)
     (if (memb fr (haddr_of c))
       (gh_reach rest (iapp (slot_refs (hslots_of c)) fr))
       (gh_reach rest fr)))))

;; xs ⊆ ys, memb-wise
(fn all_in ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons x t) (andb (memb ys x) (all_in t ys)))))

;; THE WALK INVARIANT: every non-immortal cell of cs whose count exceeds
;; its inbound references FROM cs ITSELF (i.e. every externally
;; supported cell) is already frontiered.  Exactness makes the theorem's
;; entry instance of this: external support = a root.
(fn p_cov ((all (List HCell)) (cs (List HCell)) (fr (List Int))) Bool
  (measure (struct cs))
  (match cs
    (Nil True)
    ((Cons c rest)
     (andb
       (if
         (if (le 2147483648 (hcount_of c)) False
         (lt (inbound_cells all (haddr_of c)) (hcount_of c)))
         (memb fr (haddr_of c))
         True)
       (p_cov all rest fr)))))

;; --- the list lemmas --------------------------------------------------------------

(claim memb_iapp_l
  (goal ((a (List Int)) (b (List Int)) (x Int)) ((= (memb a x) True))
    (= (memb (iapp a b) x) True))
  (induct a
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (h t)
       (chain
         (steps ((unfold iapp lhs) (reduce lhs) (unfold memb lhs) (reduce lhs)))
         (case-on (int_eq h x) Bool
           ((case True
              (steps ((rewrite (hyp True) lr lhs true ()) (reduce lhs)) refl))
            (case False
              (chain
                (have hmt (= (memb t x) True)
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih (= (memb (iapp t b) x) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ()))
                  refl))))))))))

(claim memb_iapp_r
  (goal ((a (List Int)) (b (List Int)) (x Int)) ((= (memb b x) True))
    (= (memb (iapp a b) x) True))
  (induct a
    ((case Nil
       (steps
         ((unfold iapp lhs) (reduce lhs) (rewrite (premise 0) lr lhs true ()))
         refl))
     (case Cons
       (h t)
       (chain
         (have hih (= (memb (iapp t b) x) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (steps
           ((unfold iapp lhs) (reduce lhs) (unfold memb lhs) (reduce lhs))
           (case-on (int_eq h x) Bool
             ((case True
                (steps ((rewrite (hyp True) lr lhs true ()) (reduce lhs)) refl))
              (case False
                (steps
                  ((rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ()))
                  refl))))))))))

;; the two-sided equality behind an int_eq fact (fra_kit's int_eq_eq)
(claim int_eq_eq
  (goal ((a Int) (b Int)) ((= (int_eq a b) True)) (= a b))
  (by arith (list (list 1 -1) (list 1 1))))

;; a positive occurrence count is membership, and conversely
(claim cin_pos_memb
  (goal ((xs (List Int)) (x Int)) ((= (le 1 (count_in xs x)) True))
    (= (memb xs x) True))
  (induct xs
    ((case Nil
       (chain
         (have hz (= (le 1 0) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold count_in rhs)
              (reduce rhs))
             refl))
         (absurd (premise hz))))
     (case Cons
       (h t)
       (case-on (int_eq h x) Bool
         ((case True
            (steps
              ((unfold memb lhs)
               (reduce lhs)
               (rewrite (hyp True) lr lhs true ())
               (reduce lhs))
              refl))
          (case False
            (chain
              (have hct (= (le 1 (count_in t x)) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold count_in rhs)
                   (reduce rhs)
                   (rewrite (hyp False) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hih (= (memb t x) True)
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hct) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold memb lhs)
                 (reduce lhs)
                 (rewrite (hyp False) lr lhs true ())
                 (reduce lhs)
                 (rewrite (premise hih) lr lhs true ()))
                refl)))))))))

;; a non-member occurs zero times
(claim nmemb_cin
  (goal ((xs (List Int)) (x Int)) ((= (memb xs x) False)) (= (count_in xs x) 0))
  (induct xs
    ((case Nil (steps ((unfold count_in lhs) (reduce lhs)) refl))
     (case Cons
       (h t)
       (case-on (int_eq h x) Bool
         ((case True
            (chain
              (have hf (= True False)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold memb rhs)
                   (reduce rhs)
                   (rewrite (hyp True) lr rhs true ())
                   (reduce rhs))
                  refl))
              (absurd (premise hf))))
          (case False
            (chain
              (have hmt (= (memb t x) False)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold memb rhs)
                   (reduce rhs)
                   (rewrite (hyp False) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hih (= (count_in t x) 0)
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold count_in lhs)
                 (reduce lhs)
                 (rewrite (hyp False) lr lhs true ())
                 (reduce lhs)
                 (rewrite (premise hih) lr lhs true ()))
                refl)))))))))

;; the frontier only grows through the pass
(claim gh_reach_mono
  (goal ((cs (List HCell)) (fr (List Int)) (x Int)) ((= (memb fr x) True))
    (= (memb (gh_reach cs fr) x) True))
  (induct cs
    ((case Nil
       (steps
         ((unfold gh_reach lhs)
          (reduce lhs)
          (rewrite (premise 0) lr lhs true ()))
         refl))
     (case Cons
       (c rest)
       (chain
         (steps ((unfold gh_reach lhs) (reduce lhs)))
         (case-on (memb fr (haddr_of c)) Bool
           ((case True
              (chain
                (have hfr (= (memb (iapp (slot_refs (hslots_of c)) fr) x) True)
                  (rewrite-with
                    (lemma memb_iapp_r)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hih
                  (=
                    (memb (gh_reach rest (iapp (slot_refs (hslots_of c)) fr)) x)
                    True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hfr) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (hyp True) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hih (= (memb (gh_reach rest fr) x) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ()))
                  refl))))))))))

;; pointwise use of an inclusion
(claim all_in_memb
  (goal ((xs (List Int)) (ys (List Int)) (x Int))
    ((= (all_in xs ys) True) (= (memb xs x) True))
    (= (memb ys x) True))
  (induct xs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (h t)
       (chain
         (have hmh (= (memb ys h) True)
           (case-on (memb ys h) Bool
             ((case True (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (case False
                (chain
                  (have hf (= True False)
                    (steps
                      ((rewrite (premise 0) rl lhs true ())
                       (unfold all_in lhs)
                       (reduce lhs)
                       (rewrite (hyp False) lr lhs true ())
                       (unfold andb lhs)
                       (reduce lhs))
                      refl))
                  (absurd (premise hf)))))))
         (have hat (= (all_in t ys) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold all_in rhs)
              (reduce rhs)
              (rewrite (premise hmh) lr rhs true ())
              (unfold andb rhs)
              (reduce rhs))
             refl))
         (case-on (int_eq h x) Bool
           ((case True
              (chain
                (have hei (= (int_eq h x) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hxh (= h x)
                  (by arith (list (list 1 0 0 0 0 -1) (list 1 0 0 0 0 1))))
                (steps
                  ((rewrite (premise hxh) rl lhs true ())
                   (rewrite (premise hmh) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hmt (= (memb t x) True)
                  (steps
                    ((rewrite (premise 1) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih (= (memb ys x) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hat) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps ((rewrite (premise hih) lr lhs true ())) refl))))))))))

;; --- alignment and parity ---------------------------------------------------------
;; Cell addresses are 8-aligned (e_brk), hence even, hence never equal to
;; an odd immediate and never dropped by slot_refs' filter.

;; 8 | a  ⟹  2 | a (mod_unique at the witness 4q)
(claim mod8_even
  (goal ((a Int)) ((= (int_eq (mod a 8) 0) True)) (= (int_eq (mod a 2) 0) True))
  (div-facts
    a
    8
    q
    (chain
      (have hm8 (= (mod a 8) 0)
        (by arith (list (list 1 -1 0 0 0 0) (list 1 1 0 0 0 0))))
      (have heq (= a (+ (* 2 (* 4 q)) 0))
        (by arith (list (list 1 0 -1 0 0 0 -1) (list 1 0 1 0 0 0 1))))
      (have hm2 (= (mod a 2) 0)
        (rewrite-with
          (lemma mod_unique)
          lr
          lhs
          ((inst r 0) (inst q (* 4 q)))
          ((steps ((rewrite (premise heq) rl rhs true ())) refl)
           (steps ((compute lhs)) refl)
           (steps ((compute lhs)) refl))
          refl))
      (steps ((rewrite (premise hm2) lr lhs true ()) (compute lhs)) refl))))

;; the extent addresses
(fn e_addrs ((es (List (Pair Int Int)))) (List Int)
  (measure (struct es))
  (match es
    (Nil Nil)
    ((Cons e rest)
     (match e
       ((Pair a n) (Cons a (e_addrs rest)))))))

;; every listed address 8-aligned
(fn aligned8 ((xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons x t) (andb (int_eq (mod x 8) 0) (aligned8 t)))))

;; e_brk's alignment clauses, collected
(claim ebrk_aligned
  (goal ((es (List (Pair Int Int))) (lo Int) (top Int))
    ((= (e_brk es lo top) True))
    (= (aligned8 (e_addrs es)) True))
  (induct es
    ((case Nil (steps ((compute lhs)) refl))
     (case Cons
       (e rest)
       (case-on e Pair
         ((case Pair
            (a n)
            (chain
              (have hb
                (=
                  (andb
                    (le lo a)
                    (andb
                      (le (+ a (+ 8 (* 8 n))) top)
                      (andb
                        (int_eq (mod a 8) 0)
                        (andb (le 0 n) (e_brk rest lo top)))))
                  True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (unfold e_brk rhs)
                   (reduce rhs))
                  refl))
              (have h1
                (=
                  (andb
                    (le (+ a (+ 8 (* 8 n))) top)
                    (andb
                      (int_eq (mod a 8) 0)
                      (andb (le 0 n) (e_brk rest lo top))))
                  True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le lo a)))
                  ((steps ((rewrite (premise hb) lr lhs true ())) refl))
                  refl))
              (have h2
                (=
                  (andb
                    (int_eq (mod a 8) 0)
                    (andb (le 0 n) (e_brk rest lo top)))
                  True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le (+ a (+ 8 (* 8 n))) top)))
                  ((steps ((rewrite (premise h1) lr lhs true ())) refl))
                  refl))
              (have hal (= (int_eq (mod a 8) 0) True)
                (rewrite-with
                  (lemma andb_l)
                  lr
                  lhs
                  ((inst b (andb (le 0 n) (e_brk rest lo top))))
                  ((steps ((rewrite (premise h2) lr lhs true ())) refl))
                  refl))
              (have h3 (= (andb (le 0 n) (e_brk rest lo top)) True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (int_eq (mod a 8) 0)))
                  ((steps ((rewrite (premise h2) lr lhs true ())) refl))
                  refl))
              (have htl (= (e_brk rest lo top) True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le 0 n)))
                  ((steps ((rewrite (premise h3) lr lhs true ())) refl))
                  refl))
              (have hih (= (aligned8 (e_addrs rest)) True)
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ((inst lo lo) (inst top top))
                  ((steps ((rewrite (premise htl) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (hyp 0) lr lhs true ())
                 (unfold e_addrs lhs)
                 (reduce lhs)
                 (unfold aligned8 lhs)
                 (reduce lhs)
                 (rewrite (premise hal) lr lhs true ())
                 (rewrite (premise hih) lr lhs true ())
                 (unfold andb lhs)
                 (reduce lhs))
                refl)))))))))

;; hexts' addresses are the cells'
(claim hexts_eaddrs
  (goal ((cs (List HCell))) () (= (e_addrs (hexts cs)) (haddrs cs)))
  (induct cs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c rest)
       (chain
         (have hih (= (e_addrs (hexts rest)) (haddrs rest))
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (steps
           ((unfold hexts lhs)
            (reduce lhs)
            (unfold e_addrs lhs)
            (reduce lhs)
            (rewrite (premise hih) lr lhs true ())
            (unfold haddrs rhs)
            (reduce rhs))
           refl))))))

;; pointwise use of aligned8
(claim aligned_memb
  (goal ((xs (List Int)) (x Int)) ((= (aligned8 xs) True) (= (memb xs x) True))
    (= (int_eq (mod x 8) 0) True))
  (induct xs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (h t)
       (chain
         (have hah (= (int_eq (mod h 8) 0) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (aligned8 t)))
             ((steps
                ((rewrite (premise 0) rl rhs true ())
                 (unfold aligned8 rhs)
                 (reduce rhs))
                refl))
             refl))
         (have hat (= (aligned8 t) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (int_eq (mod h 8) 0)))
             ((steps
                ((rewrite (premise 0) rl rhs true ())
                 (unfold aligned8 rhs)
                 (reduce rhs))
                refl))
             refl))
         (case-on (int_eq h x) Bool
           ((case True
              (chain
                (have hei (= (int_eq h x) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hxh (= h x)
                  (by arith (list (list 1 0 0 0 0 -1) (list 1 0 0 0 0 1))))
                (steps
                  ((rewrite (premise hxh) rl lhs true ())
                   (rewrite (premise hah) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hmt (= (memb t x) True)
                  (steps
                    ((rewrite (premise 1) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih (= (int_eq (mod x 8) 0) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hat) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps ((rewrite (premise hih) lr lhs true ())) refl))))))))))

;; an even member survives slot_refs' odd filter
(claim sr_memb
  (goal ((ws (List Int)) (x Int))
    ((= (memb ws x) True) (= (int_eq (mod x 2) 0) True))
    (= (memb (slot_refs ws) x) True))
  (induct ws
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (w t)
       (case-on (int_eq w x) Bool
         ((case True
            (chain
              (have hei (= (int_eq w x) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have hwx (= w x)
                (by arith (list (list 1 0 0 -1) (list 1 0 0 1))))
              (have hwodd (= (int_eq (mod w 2) 1) False)
                (steps
                  ((rewrite (premise hwx) lr lhs true ()))
                  (by arith (list 1 0 -1 0 0))))
              (steps
                ((unfold slot_refs lhs)
                 (reduce lhs)
                 (rewrite (premise hwodd) lr lhs true ())
                 (reduce lhs)
                 (unfold memb lhs)
                 (reduce lhs)
                 (rewrite (premise hei) lr lhs true ())
                 (reduce lhs))
                refl)))
          (case False
            (chain
              (have hmt (= (memb t x) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold memb rhs)
                   (reduce rhs)
                   (rewrite (hyp False) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hih (= (memb (slot_refs t) x) True)
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hmt) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (case-on (int_eq (mod w 2) 1) Bool
                ((case True
                   (steps
                     ((unfold slot_refs lhs)
                      (reduce lhs)
                      (rewrite (hyp True) lr lhs true ())
                      (reduce lhs)
                      (rewrite (premise hih) lr lhs true ()))
                     refl))
                 (case False
                   (steps
                     ((unfold slot_refs lhs)
                      (reduce lhs)
                      (rewrite (hyp False) lr lhs true ())
                      (reduce lhs)
                      (unfold memb lhs)
                      (reduce lhs)
                      (rewrite (hyp 1) lr lhs true ())
                      (reduce lhs)
                      (rewrite (premise hih) lr lhs true ()))
                     refl))))))))))))

;; --- the release vocabulary -------------------------------------------------------
;; C2b-2 part 2b (the design record): the walk invariant's carriers.
;; irem drops a first occurrence (roots and address lists share it);
;; anodup is duplicate-freedom and msub is multiset domination, both in
;; COUNT form — the cascade permutes the extent lists, and counts are
;; the permutation-stable currency where positional nodup would fight
;; every move.  The lemmas live at the end of the file; the definitions
;; sit here so the generated peels below can cite them.

(fn irem ((xs (List Int)) (x Int)) (List Int)
  (measure (struct xs))
  (match xs
    (Nil Nil)
    ((Cons h t) (if (int_eq h x) t (Cons h (irem t x))))))

(fn orb ((a Bool) (b Bool)) Bool (if a True b))

;; duplicate-free: no element recurs in its own tail
(fn anodup ((xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons x t) (andb (int_eq (count_in t x) 0) (anodup t)))))

;; count domination: every xs-count is bounded by the ys-count (the head
;; clause is count_in xs x <= count_in ys x, spelled structurally)
(fn msub ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons x t) (andb (le (+ 1 (count_in t x)) (count_in ys x)) (msub t ys)))))

;; the free addresses, class order
(fn faddrs ((fls (List (List Int)))) (List Int)
  (measure (struct fls))
  (match fls
    (Nil Nil)
    ((Cons f rest) (iapp f (faddrs rest)))))

