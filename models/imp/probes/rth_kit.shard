;;; models/imp/probes/rth_kit.shard — THE RUNTIME-THEOREM KIT (C2b,
;;; docs/COVERAGE.md §10 C2b-0 design record): the ghost heap, its
;;; invariant, and the once-proven laws over models/imp/rt.shard's four
;;; functions at the ipcall grain — the foundation Theorem B's per-fn
;;; inductions stand on.
;;;
;;; THE GHOST. A live cell is (addr count tag arity slots); the live heap
;;; is a List HCell NEWEST FIRST — list position is BIRTH RANK, and
;;; ACYCLICITY IS THE LIST ORDER (a slot reference points only to an
;;; OLDER cell; rank is not address, because free-list reuse recycles
;;; addresses). The ghost state carries the sixteen free classes, the
;;; heap bracket (glo/gtop/gend), and at most ONE raw cell (the
;;; constructor window's, between rt_alloc and the seal). The roots R —
;;; the references the program holds — are a multiset Theorem B threads.
;;;
;;; THE SPLIT. heap_rep m rb g = the BYTES mean the ghost (headers,
;;; slots, free chains, the [rb, rb+152) header block); hinv rb g r =
;;; the PURE well-formedness (exact counts, slot validity, acyclicity,
;;; extent separation, brackets). Engine choreography proves runs land
;;; in named memory-effect terms (m_init …); pure lemmas carry
;;; heap_rep/hinv across them. No FPatch import — see the design
;;; record's departure note.
;;;
;;; Closure discipline: imports kernel, std/mem, std/nat, std/bits,
;;; std/order, imp.shard, rt.shard ONLY (machine-free; fra_kit stays a
;;; separate closure).

(import "../../../kernel/stdlib.shard")
(import "../../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../../std/mem")
(use (:: std mem *))
(import "../../../std/nat")
(use (:: std nat *))
(import "../../../std/bits")
(use (:: std bits *))
(import "../../../std/order")
(use (:: std order *))
(import "../imp.shard")
(use (:: models imp imp *))
(import "../rt.shard")
(use (:: models imp rt *))

;; --- the Nat-fuel bridge ----------------------------------------------------------
;; Fuel is a structural Nat; every law's budget premise is an Int fact
;; `le (rtc_*) (int_of_nat fuel)` so order reasoning stays Farkas-shaped.
;; nat_peel turns a budget into a LITERAL S-tower the engine computes
;; through (the fe_ldw_run recipe, imp-side).

(fn npred ((n Nat)) Nat
  (match n
    (Z Z)
    ((S k) k)))

;; wrap k successors around n / strip k predecessors off n
(fn nS ((k Int) (n Nat)) Nat
  (measure k (by arith (list 1 0)) (by arith (list 1 1)))
  (if (lt k 1) n (S (nS (- k 1) n))))

(fn ntl ((k Int) (n Nat)) Nat
  (measure k (by arith (list 1 0)) (by arith (list 1 1)))
  (if (lt k 1) n (ntl (- k 1) (npred n))))

;; a positive budget forces a successor — the S the engine burns
(claim nat_open
  (goal ((n Nat)) ((= (le 1 (int_of_nat n)) True)) (= n (S (npred n))))
  (case-on n Nat
    ((case Z
       (chain
         (have hz (= (le 1 0) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (rewrite (lemma int_of_nat_zero) lr rhs true ()))
             refl))
         (absurd (premise hz))))
     (case S
       (k)
       (steps
         ((rewrite (hyp 0) lr both true ()) (unfold npred rhs) (reduce rhs))
         refl)))))

;; the budget after the burn
(claim int_npred
  (goal ((n Nat)) ((= (le 1 (int_of_nat n)) True))
    (= (int_of_nat (npred n)) (- (int_of_nat n) 1)))
  (case-on n Nat
    ((case Z
       (chain
         (have hz (= (le 1 0) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (rewrite (lemma int_of_nat_zero) lr rhs true ()))
             refl))
         (absurd (premise hz))))
     (case S
       (k)
       (chain
         (have hs (= (int_of_nat (S k)) (+ 1 (int_of_nat k)))
           (rewrite-with (lemma int_of_nat_succ) lr lhs ((inst k k)) () refl))
         (steps
           ((rewrite (hyp 0) lr both true ())
            (unfold npred lhs)
            (reduce lhs)
            (rewrite (premise hs) lr rhs true ()))
           (by arith (list (list 1 0 0) (list 1 0 0)))))))))

;; --- the ghost --------------------------------------------------------------------

(record
  HCell
  (haddr Int)
  (hcount Int)
  (htag Int)
  (harity Int)
  (hslots (List Int)))

;; the constructor window's cell: allocated, header written, the first
;; `rfill` slots stored (in slot order), the rest still raw
(record HRaw (raddr Int) (rtag Int) (rarity Int) (rfill (List Int)))

(record
  GHeap
  (gcells (List HCell))
  (gfree (List (List Int)))
  (glo Int)
  (gtop Int)
  (gend Int)
  (graw (Option HRaw)))

(fn gfree0 () (List (List Int))
  (list Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil Nil))

;; the ghost rt_init leaves: no cells, empty classes, bracket [lo, hi)
(fn gh_init ((lo Int) (hi Int)) GHeap (MkGHeap Nil (gfree0) lo lo hi None))

;; --- the memory effects -----------------------------------------------------------
;; One named term per runtime body, in the engine's own store order, so
;; the engine claims conclude `… = Some (IpRv r (m_* …))` and every
;; heap_rep/hinv/framing fact is a PURE lemma over the named term.

;; rt_zero_heads' stores: head k-1 first is the SOURCE order, but the
;; engine executes the list head first — rt_zero_heads emits k = 16
;; (address rb+144) down to k = 1 (address rb+24), so the accumulator
;; walks the same countdown
(fn m_zh ((m Mem) (rb Int) (k Int)) Mem
  (measure k (by arith (list 1 0)) (by arith (list 1 1)))
  (if (lt k 1) m
  (m_zh (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0) rb (- k 1))))

;; rt_init's whole effect: top := lo, end := hi, [rb+16] := 0, heads := 0
(fn m_init ((m Mem) (rb Int) (lo Int) (hi Int)) Mem
  (m_zh
    (store_le
      (iw8)
      (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
      (+ rb 16)
      0)
    rb
    16))

;; --- the table --------------------------------------------------------------------
;; The runtime's four entries sit at indexes 0..3 of every rt_prog table,
;; whatever the program's own fns are.

(claim rt_at_init
  (goal ((rb Int) (fs (List IpFn))) ()
    (= (ipfn_at (rt_app (rt_fns rb) fs) 0) (Some (rt_init_fn rb))))
  (steps ((compute both)) refl))

(claim rt_at_alloc
  (goal ((rb Int) (fs (List IpFn))) ()
    (= (ipfn_at (rt_app (rt_fns rb) fs) 1) (Some (rt_alloc_fn rb))))
  (steps ((compute both)) refl))

(claim rt_at_inc
  (goal ((rb Int) (fs (List IpFn))) ()
    (= (ipfn_at (rt_app (rt_fns rb) fs) 2) (Some (rt_inc_fn rb))))
  (steps ((compute both)) refl))

(claim rt_at_dec
  (goal ((rb Int) (fs (List IpFn))) ()
    (= (ipfn_at (rt_app (rt_fns rb) fs) 3) (Some (rt_dec_fn rb))))
  (steps ((compute both)) refl))

;; a budget of k opens k literal successors: n = S (S (… (ntl k n))) —
;; consumers rewrite once and compute the engine through the tower
(claim nat_peel
  (goal ((k Int) (n Nat)) ((= (le 0 k) True) (= (le k (int_of_nat n)) True))
    (= n (nS k (ntl k n))))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hg (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold nS rhs)
              (rewrite (premise hg) lr rhs true ())
              (reduce rhs)
              (unfold ntl rhs)
              (rewrite (premise hg) lr rhs true ())
              (reduce rhs))
             refl)))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hn1 (= (le 1 (int_of_nat n)) True) (by arith (list 1 0 1 1)))
           (have hop (= n (S (npred n)))
             (rewrite-with
               (lemma nat_open)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hn1) lr lhs true ())) refl))
               refl))
           (have hnp (= (int_of_nat (npred n)) (- (int_of_nat n) 1))
             (rewrite-with
               (lemma int_npred)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hn1) lr lhs true ())) refl))
               refl))
           (have hih (= (npred n) (nS (- k 1) (ntl (- k 1) (npred n))))
             (rewrite-with
               (hyp 1)
               rl
               rhs
               ()
               ((by arith (list 1 0 0 1 0 0 0))
                (by arith (list 1 0 1 0 0 0 1))
                (by arith (list 1 0 0 1 0 0 0))
                (by arith (list 1 0 0 0 0 0 0)))
               refl))
           (steps
             ((unfold nS rhs)
              (rewrite (premise h1) lr rhs true ())
              (reduce rhs)
              (unfold ntl rhs)
              (rewrite (premise h1) lr rhs true ())
              (reduce rhs)
              (rewrite (premise hih) rl rhs true ())
              (rewrite (premise hop) rl rhs true ()))
             refl)))))))

;; --- the band collapses -----------------------------------------------------------
;; ITrunc U64 U32 narrows an address by mod 2^32; IBin U64 ops wrap by
;; mod 2^64 — under the bracket premises both are the identity
;; (fra_kit's mod64_id shape at the two runtime divisors)

(claim modu32_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 4294967296) True))
    (= (mod x 4294967296) x))
  (div-facts
    x
    4294967296
    q
    (have qlo (= (le -1 q) True)
      (by arith (list 4294967296 1 0 -1 0 1 0))
      (have qhi (= (le q 1) True)
        (by arith (list 4294967296 0 1 1 1 0 0))
        (fin-split
          q
          (premise qlo)
          (premise qhi)
          ((case -1
             (by
               arith
               (list (list 0 1 0 -1 0 1 0 0 0) (list 0 1 0 -1 0 1 0 0 0))))
           (case 0
             (by
               arith
               (list (list 1 0 0 1 0 0 0 0 0) (list 1 0 0 -1 0 0 0 0 0))))
           (case 1
             (by arith (list (list 0 0 1 1 1 0 0 0 0) (list 0 0 1 1 1 0 0 0 0))))))))))

(claim modu64_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 18446744073709551616) True))
    (= (mod x 18446744073709551616) x))
  (div-facts
    x
    18446744073709551616
    q
    (have qlo (= (le -1 q) True)
      (by arith (list 18446744073709551616 1 0 -1 0 1 0))
      (have qhi (= (le q 1) True)
        (by arith (list 18446744073709551616 0 1 1 1 0 0))
        (fin-split
          q
          (premise qlo)
          (premise qhi)
          ((case -1
             (by
               arith
               (list (list 0 1 0 -1 0 1 0 0 0) (list 0 1 0 -1 0 1 0 0 0))))
           (case 0
             (by
               arith
               (list (list 1 0 0 1 0 0 0 0 0) (list 1 0 0 -1 0 0 0 0 0))))
           (case 1
             (by arith (list (list 0 0 1 1 1 0 0 0 0) (list 0 0 1 1 1 0 0 0 0))))))))))

;; masking at the word widths is the identity in band (fra_kit's rotate
;; seam, at the address seam here: ITrunc U64 U32 narrows by
;; `band _ 4294967295`)

(claim bandu32_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 4294967296) True))
    (= (band x 4294967295) x))
  (chain
    (have hm (= (band x 4294967295) (mod x 4294967296))
      (rewrite-with
        (lemma mask_word32)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hi (= (mod x 4294967296) x)
      (rewrite-with
        (lemma modu32_id)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hm) lr lhs true ())
       (rewrite (premise hi) lr lhs true ()))
      refl)))

(claim bandu64_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 18446744073709551616) True))
    (= (band x 18446744073709551615) x))
  (chain
    (have hm (= (band x 18446744073709551615) (mod x 18446744073709551616))
      (rewrite-with
        (lemma mask_word64)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hi (= (mod x 18446744073709551616) x)
      (rewrite-with
        (lemma modu64_id)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hm) lr lhs true ())
       (rewrite (premise hi) lr lhs true ()))
      refl)))

;; --- the stepping template --------------------------------------------------------
;; One store through ipstmts at a literal tower over symbolic memory:
;; compute to the stuck window guard, collapse the ITrunc mod, discharge
;; the guards, compute on — the recipe every engine claim below follows

(claim rth_step1
  (goal
    ((fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (rb Int)
     (m Mem)
     (f Nat))
    ((= (le mlo rb) True)
     (= (le (+ rb 8) msz) True)
     (= (le 0 rb) True)
     (= (lt rb 4294967296) True))
    (=
      (ipstmts
        (S (S f))
        fs
        mlo
        msz
        dmax
        d
        (Cons (IpStoreW (ITrunc U64 U32 (IConst rb)) (IConst 7)) Nil)
        Nil
        m)
      (Some (IpNorm Nil (store_le (iw8) m rb 7)))))
  (chain
    (have hmod (= (band rb 4294967295) rb)
      (rewrite-with
        (lemma bandu32_id)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise 3) lr lhs true ())) refl))
        refl))
    (steps
      ((compute lhs (stop iw8))
       (rewrite (premise hmod) lr lhs true ())
       (rewrite (premise 0) lr lhs true ())
       (reduce lhs)
       (rewrite (premise 1) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8)))
      refl)))

;; --- the word view at (iw8) -------------------------------------------------------
;; std/mem's laws live at the literal tower / generic widths; the engine's
;; terms carry the folded (iw8).  Three twins close the gap once.

(claim iw8_int
  (goal () () (= (int_of_nat (iw8)) 8))
  (steps
    ((unfold iw8 lhs)
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_succ) lr lhs true ())
     (rewrite (lemma int_of_nat_zero) lr lhs true ())
     (compute lhs))
    refl))

;; an in-band word reads back through (iw8)
(claim ls8w
  (goal ((m Mem) (a Int) (v Int))
    ((= (le 0 v) True) (= (lt v 18446744073709551616) True))
    (= (load_le (iw8) (store_le (iw8) m a v) a) v))
  (chain
    (have h8
      (=
        (load_le
          (S (S (S (S (S (S (S (S Z))))))))
          (store_le (S (S (S (S (S (S (S (S Z)))))))) m a v)
          a)
        v)
      (rewrite-with
        (lemma ls8_id)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold iw8 lhs) (unfold iw8 lhs) (rewrite (premise h8) lr lhs true ()))
      refl)))

;; a word read below a disjoint store is untouched (read span ends first)
(claim ldw_below
  (goal ((m Mem) (a Int) (b Int) (v Int)) ((= (le (+ a 8) b) True))
    (= (load_le (iw8) (store_le (iw8) m b v) a) (load_le (iw8) m a)))
  (rewrite-with
    (lemma load_le_store_le_below)
    lr
    lhs
    ()
    ((steps
       ((rewrite (lemma iw8_int) lr lhs true ())
        (rewrite (premise 0) lr lhs true ()))
       refl))
    refl))

;; a word read above a disjoint store is untouched (store span ends first)
(claim ldw_above
  (goal ((m Mem) (a Int) (b Int) (v Int)) ((= (le (+ b 8) a) True))
    (= (load_le (iw8) (store_le (iw8) m b v) a) (load_le (iw8) m a)))
  (rewrite-with
    (lemma load_le_store_le_above)
    lr
    lhs
    ()
    ((steps
       ((rewrite (lemma iw8_int) lr lhs true ())
        (rewrite (premise 0) lr lhs true ()))
       refl))
    refl))

;; --- the conjunction spine --------------------------------------------------------
;; Every chain predicate below is a right-nested andb, so one lemma pair
;; peels any clause out (fra_kit's fe_ctx idiom).

(fn andb ((a Bool) (b Bool)) Bool (if a b False))

(claim andb_l
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= a True))
  (case-on a Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= True False)
           (steps
             ((rewrite (premise 0) rl lhs true ())
              (unfold andb lhs)
              (rewrite (hyp 0) lr lhs true ())
              (reduce lhs))
             refl))
         (absurd (premise hf)))))))

(claim andb_r
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= b True))
  (chain
    (have ha (= a True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b b))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hab (= (andb a b) b)
      (steps
        ((unfold andb lhs) (rewrite (premise ha) lr lhs true ()) (reduce lhs))
        refl))
    (steps
      ((rewrite (premise hab) rl lhs true ())
       (rewrite (premise 0) lr lhs true ()))
      refl)))

(claim andb_intro
  (goal ((a Bool) (b Bool)) ((= a True) (= b True)) (= (andb a b) True))
  (steps
    ((rewrite (premise 0) lr lhs true ())
     (rewrite (premise 1) lr lhs true ())
     (compute lhs))
    refl))

;; --- heap_rep: the bytes mean the ghost -------------------------------------------

;; a live cell's header word
(fn hword ((c HCell)) Int
  (+
    (hcount_of c)
    (+ (* (htag_of c) 4294967296) (* (harity_of c) 281474976710656))))

;; a raw cell's header word: count 1, tag, arity
(fn rword ((rc HRaw)) Int
  (+ 1 (+ (* (rtag_of rc) 4294967296) (* (rarity_of rc) 281474976710656))))

(fn hslots_rep ((m Mem) (a Int) (ws (List Int))) Bool
  (measure (struct ws))
  (match ws
    (Nil True)
    ((Cons w rest)
     (andb (int_eq (load_le (iw8) m a) w) (hslots_rep m (+ a 8) rest)))))

(fn hcell_rep ((m Mem) (c HCell)) Bool
  (andb
    (int_eq (load_le (iw8) m (haddr_of c)) (hword c))
    (hslots_rep m (+ (haddr_of c) 8) (hslots_of c))))

(fn hcells_rep ((m Mem) (cs (List HCell))) Bool
  (measure (struct cs))
  (match cs
    (Nil True)
    ((Cons c rest) (andb (hcell_rep m c) (hcells_rep m rest)))))

;; a free chain's next link (0 terminates)
(fn hhead ((as (List Int))) Int
  (match as
    (Nil 0)
    ((Cons a _) a)))

;; each free cell's HEADER WORD is the link to the next (the C2b-0 fix's
;; discipline; a dead cell's other bytes are unconstrained)
(fn hchain_rep ((m Mem) (as (List Int))) Bool
  (measure (struct as))
  (match as
    (Nil True)
    ((Cons a rest)
     (andb (int_eq (load_le (iw8) m a) (hhead rest)) (hchain_rep m rest)))))

(fn hfree_rep ((m Mem) (rb Int) (k Int) (fls (List (List Int)))) Bool
  (measure (struct fls))
  (match fls
    (Nil True)
    ((Cons fl rest)
     (andb
       (int_eq (load_le (iw8) m (+ rb (+ 24 (* 8 k)))) (hhead fl))
       (andb (hchain_rep m fl) (hfree_rep m rb (+ k 1) rest))))))

(fn hraw_rep ((m Mem) (r (Option HRaw))) Bool
  (match r
    (None True)
    ((Some rc)
     (andb
       (int_eq (load_le (iw8) m (raddr_of rc)) (rword rc))
       (hslots_rep m (+ (raddr_of rc) 8) (rfill_of rc))))))

(fn heap_rep ((m Mem) (rb Int) (g GHeap)) Bool
  (andb
    (int_eq (load_le (iw8) m rb) (gtop_of g))
    (andb
      (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g))
      (andb
        (int_eq (load_le (iw8) m (+ rb 16)) 0)
        (andb
          (hfree_rep m rb 0 (gfree_of g))
          (andb (hcells_rep m (gcells_of g)) (hraw_rep m (graw_of g))))))))

;; --- hinv: the pure well-formedness -----------------------------------------------

(fn memb ((xs (List Int)) (x Int)) Bool
  (measure (struct xs))
  (match xs
    (Nil False)
    ((Cons h t) (if (int_eq h x) True (memb t x)))))

(fn haddrs ((cs (List HCell))) (List Int)
  (measure (struct cs))
  (match cs
    (Nil Nil)
    ((Cons c rest) (Cons (haddr_of c) (haddrs rest)))))

;; multiset occurrence count (roots and slots share it)
(fn count_in ((xs (List Int)) (x Int)) Int
  (measure (struct xs))
  (match xs
    (Nil 0)
    ((Cons h t) (if (int_eq h x) (+ 1 (count_in t x)) (count_in t x)))))

;; inbound slot references to address a from the live cells
(fn inbound_cells ((cs (List HCell)) (a Int)) Int
  (measure (struct cs))
  (match cs
    (Nil 0)
    ((Cons c rest) (+ (count_in (hslots_of c) a) (inbound_cells rest a)))))

;; references to a from the raw cell's filled prefix
(fn raw_refs ((r (Option HRaw)) (a Int)) Int
  (match r
    (None 0)
    ((Some rc) (count_in (rfill_of rc) a))))

;; a slot word is valid against the OLDER cells: an odd immediate or a
;; reference to one of them (acyclicity is exactly this list order)
(fn slot_ok ((w Int) (older (List Int))) Bool
  (if (int_eq (mod w 2) 1) True (memb older w)))

(fn slots_ok ((ws (List Int)) (older (List Int))) Bool
  (measure (struct ws))
  (match ws
    (Nil True)
    ((Cons w rest) (andb (slot_ok w older) (slots_ok rest older)))))

;; per-cell structural facts, newest first: valid slots against the tail,
;; arity = slot count, the header bands, count >= 1
(fn cells_ok ((cs (List HCell))) Bool
  (measure (struct cs))
  (match cs
    (Nil True)
    ((Cons c rest)
     (andb
       (slots_ok (hslots_of c) (haddrs rest))
       (andb
         (int_eq (ilen (hslots_of c)) (harity_of c))
         (andb
           (le 1 (hcount_of c))
           (andb
             (lt (hcount_of c) 4294967296)
             (andb
               (le 0 (htag_of c))
               (andb
                 (lt (htag_of c) 65536)
                 (andb
                   (le 0 (harity_of c))
                   (andb (lt (harity_of c) 65536) (cells_ok rest))))))))))))

;; EXACT COUNTS: a live non-immortal cell's count is precisely the roots
;; plus the inbound slot references plus the raw fill's references; the
;; immortal band is exempt (and saturation parks a cell there forever)
(fn counts_ok
  ((all (List HCell)) (cs (List HCell)) (r (List Int)) (raw (Option HRaw)))
  Bool
  (measure (struct cs))
  (match cs
    (Nil True)
    ((Cons c rest)
     (andb
       (if (le 2147483648 (hcount_of c)) True
       (int_eq
         (hcount_of c)
         (+
           (count_in r (haddr_of c))
           (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))
       (counts_ok all rest r raw)))))

;; every root references a live cell
(fn roots_ok ((r (List Int)) (as (List Int))) Bool
  (measure (struct r))
  (match r
    (Nil True)
    ((Cons x t) (andb (memb as x) (roots_ok t as)))))

;; --- the extents: separation ------------------------------------------------------
;; every footprint (live cells, free cells, the raw cell) as (addr, arity)

(fn hexts ((cs (List HCell))) (List (Pair Int Int))
  (measure (struct cs))
  (match cs
    (Nil Nil)
    ((Cons c rest) (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))))

(fn fexts1 ((as (List Int)) (k Int)) (List (Pair Int Int))
  (measure (struct as))
  (match as
    (Nil Nil)
    ((Cons a rest) (Cons (Pair a k) (fexts1 rest k)))))

(fn fexts_app ((a (List (Pair Int Int))) (b (List (Pair Int Int))))
  (List (Pair Int Int))
  (measure (struct a))
  (match a
    (Nil b)
    ((Cons h t) (Cons h (fexts_app t b)))))

(fn fexts ((fls (List (List Int))) (k Int)) (List (Pair Int Int))
  (measure (struct fls))
  (match fls
    (Nil Nil)
    ((Cons fl rest) (fexts_app (fexts1 fl k) (fexts rest (+ k 1))))))

(fn rexts ((r (Option HRaw))) (List (Pair Int Int))
  (match r
    (None Nil)
    ((Some rc) (Cons (Pair (raddr_of rc) (rarity_of rc)) Nil))))

(fn ext_all ((g GHeap)) (List (Pair Int Int))
  (fexts_app
    (hexts (gcells_of g))
    (fexts_app (fexts (gfree_of g) 0) (rexts (graw_of g)))))

;; [a, a+8+8n) and [b, b+8+8k) do not overlap
(fn e_disj2 ((a Int) (n Int) (b Int) (k Int)) Bool
  (if (le (+ a (+ 8 (* 8 n))) b) True (le (+ b (+ 8 (* 8 k))) a)))

(fn e_disj1 ((a Int) (n Int) (es (List (Pair Int Int)))) Bool
  (measure (struct es))
  (match es
    (Nil True)
    ((Cons e rest)
     (match e
       ((Pair b k) (andb (e_disj2 a n b k) (e_disj1 a n rest)))))))

(fn e_disj ((es (List (Pair Int Int)))) Bool
  (measure (struct es))
  (match es
    (Nil True)
    ((Cons e rest)
     (match e
       ((Pair a n) (andb (e_disj1 a n rest) (e_disj rest)))))))

;; every extent inside [lo, top), 8-aligned, with a sane arity
(fn e_brk ((es (List (Pair Int Int))) (lo Int) (top Int)) Bool
  (measure (struct es))
  (match es
    (Nil True)
    ((Cons e rest)
     (match e
       ((Pair a n)
        (andb
          (le lo a)
          (andb
            (le (+ a (+ 8 (* 8 n))) top)
            (andb (int_eq (mod a 8) 0) (andb (le 0 n) (e_brk rest lo top))))))))))

;; the raw cell, when open: bands, arity-bounded fill, valid fill words
;; against the LIVE cells (everything live is older than raw)
(fn raw_ok ((r (Option HRaw)) (cs (List HCell))) Bool
  (match r
    (None True)
    ((Some rc)
     (andb
       (slots_ok (rfill_of rc) (haddrs cs))
       (andb
         (le (ilen (rfill_of rc)) (rarity_of rc))
         (andb
           (le 0 (rtag_of rc))
           (andb
             (lt (rtag_of rc) 65536)
             (andb (le 0 (rarity_of rc)) (lt (rarity_of rc) 65536)))))))))

(fn hinv ((rb Int) (g GHeap) (r (List Int))) Bool
  (andb
    (le 0 rb)
    (andb
      (le (+ rb 152) (glo_of g))
      (andb
        (le (glo_of g) (gtop_of g))
        (andb
          (le (gtop_of g) (gend_of g))
          (andb
            (le (gend_of g) 4294967296)
            (andb
              (int_eq (mod (glo_of g) 8) 0)
              (andb
                (int_eq (mod (gtop_of g) 8) 0)
                (andb
                  (e_disj (ext_all g))
                  (andb
                    (e_brk (ext_all g) (glo_of g) (gtop_of g))
                    (andb
                      (cells_ok (gcells_of g))
                      (andb
                        (counts_ok (gcells_of g) (gcells_of g) r (graw_of g))
                        (andb
                          (roots_ok r (haddrs (gcells_of g)))
                          (raw_ok (graw_of g) (gcells_of g)))))))))))))))

;; --- reading through m_zh ---------------------------------------------------------
;; The zero-heads block stores at rb+24 .. rb+24+8(k-1).  Three laws
;; cover every word read: below the block, above it, and at a head.

(claim m_zh_below
  (goal ((m Mem) (rb Int) (k Int) (a Int)) ((= (le (+ a 8) (+ rb 24)) True))
    (= (load_le (iw8) (m_zh m rb k) a) (load_le (iw8) m a)))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hg (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise hg) lr lhs true ())
              (reduce lhs))
             refl)))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hih
             (=
               (load_le
                 (iw8)
                 (m_zh
                   (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                   rb
                   (- k 1))
                 a)
               (load_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                 a))
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                (by arith (list 1 0 1))
                (by arith (list 1 0 0)))
               refl))
           (have hsk
             (=
               (load_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                 a)
               (load_le (iw8) m a))
             (rewrite-with
               (lemma ldw_below)
               lr
               lhs
               ()
               ((by arith (list 1 1 8 0)))
               refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise h1) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hih) lr lhs true ())
              (rewrite (premise hsk) lr lhs true ()))
             refl)))))))

(claim m_zh_above
  (goal ((m Mem) (rb Int) (k Int) (a Int))
    ((= (le (+ rb (+ 24 (* 8 k))) a) True))
    (= (load_le (iw8) (m_zh m rb k) a) (load_le (iw8) m a)))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hg (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise hg) lr lhs true ())
              (reduce lhs))
             refl)))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hih
             (=
               (load_le
                 (iw8)
                 (m_zh
                   (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                   rb
                   (- k 1))
                 a)
               (load_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                 a))
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((by arith (list 1 1 0))
                (by arith (list 1 0 1))
                (by arith (list 1 0 0)))
               refl))
           (have hsk
             (=
               (load_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                 a)
               (load_le (iw8) m a))
             (rewrite-with
               (lemma ldw_above)
               lr
               lhs
               ()
               ((by arith (list 1 1 0 0)))
               refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise h1) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hih) lr lhs true ())
              (rewrite (premise hsk) lr lhs true ()))
             refl)))))))

(claim m_zh_head
  (goal ((m Mem) (rb Int) (k Int) (j Int)) ((= (le 0 j) True) (= (lt j k) True))
    (= (load_le (iw8) (m_zh m rb k) (+ rb (+ 24 (* 8 j)))) 0))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hkz (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hz (= (le 1 0) True) (by arith (list 1 1 1 1)))
           (absurd (premise hz))))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (case-on (lt j (- k 1)) Bool
             ((case True
                (chain
                  (have hjl (= (lt j (- k 1)) True)
                    (steps ((rewrite (hyp True) lr lhs true ())) refl))
                  (have hih
                    (=
                      (load_le
                        (iw8)
                        (m_zh
                          (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                          rb
                          (- k 1))
                        (+ rb (+ 24 (* 8 j))))
                      0)
                    (rewrite-with
                      (hyp 2)
                      lr
                      lhs
                      ()
                      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                       (steps ((rewrite (premise hjl) lr lhs true ())) refl)
                       (by arith (list 1 0 0 1 0))
                       (by arith (list 1 0 0 0 0)))
                      refl))
                  (steps
                    ((unfold m_zh lhs)
                     (rewrite (premise h1) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hih) lr lhs true ()))
                    refl)))
              (case False
                (chain
                  (have hjg (= (lt j (- k 1)) False)
                    (steps ((rewrite (hyp False) lr lhs true ())) refl))
                  (have hsk
                    (=
                      (load_le
                        (iw8)
                        (m_zh
                          (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                          rb
                          (- k 1))
                        (+ rb (+ 24 (* 8 j))))
                      (load_le
                        (iw8)
                        (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                        (+ rb (+ 24 (* 8 j)))))
                    (rewrite-with
                      (lemma m_zh_above)
                      lr
                      lhs
                      ()
                      ((by arith (list 1 0 0 0 8)))
                      refl))
                  (have haq
                    (= (+ rb (+ 24 (* 8 j))) (+ rb (+ 24 (* 8 (- k 1)))))
                    (by arith (list (list 1 0 8 0 0 0) (list 1 0 0 0 8 0))))
                  (have htm
                    (=
                      (load_le
                        (iw8)
                        (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                        (+ rb (+ 24 (* 8 (- k 1)))))
                      0)
                    (rewrite-with
                      (lemma ls8w)
                      lr
                      lhs
                      ()
                      ((steps ((compute lhs)) refl)
                       (steps ((compute lhs)) refl))
                      refl))
                  (steps
                    ((unfold m_zh lhs)
                     (rewrite (premise h1) lr lhs true ())
                     (reduce lhs)
                     (rewrite (premise hsk) lr lhs true ())
                     (rewrite (premise haq) lr lhs true ())
                     (rewrite (premise htm) lr lhs true ()))
                    refl)))))))))))

;; --- the init laws: the pure side -------------------------------------------------

;; the empty ghost is well-formed at no roots
(claim hinv_init
  (goal ((rb Int) (lo Int) (hi Int))
    ((= (le 0 rb) True)
     (= (le (+ rb 152) lo) True)
     (= (le lo hi) True)
     (= (le hi 4294967296) True)
     (= (int_eq (mod lo 8) 0) True))
    (= (hinv rb (gh_init lo hi) Nil) True))
  (chain
    (have hll (= (le lo lo) True) (by arith (list 1 0 0 0 0 0)))
    (steps
      ((compute lhs)
       (rewrite (premise 0) lr lhs true ())
       (rewrite (premise 1) lr lhs true ())
       (rewrite (premise hll) lr lhs true ())
       (rewrite (premise 2) lr lhs true ())
       (rewrite (premise 3) lr lhs true ())
       (rewrite (premise 4) lr lhs true ())
       (compute lhs))
      refl)))

;; --- byte-grain framing (the C4/I-O seam) -----------------------------------------

;; a byte read at or above a word store's end is untouched
(claim sga8
  (goal ((m Mem) (a Int) (v Int) (b Int)) ((= (le (+ a 8) b) True))
    (= (mem_get (store_le (iw8) m a v) b) (mem_get m b)))
  (rewrite-with
    (lemma store_le_get_above)
    lr
    lhs
    ()
    ((steps
       ((rewrite (lemma iw8_int) lr lhs true ())
        (rewrite (premise 0) lr lhs true ()))
       refl))
    refl))

(claim m_zh_getb
  (goal ((m Mem) (rb Int) (k Int) (a Int)) ((= (lt a (+ rb 24)) True))
    (= (mem_get (m_zh m rb k) a) (mem_get m a)))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hg (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise hg) lr lhs true ())
              (reduce lhs))
             refl)))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hih
             (=
               (mem_get
                 (m_zh
                   (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                   rb
                   (- k 1))
                 a)
               (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0) a))
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                (by arith (list 1 0 1))
                (by arith (list 1 0 0)))
               refl))
           (have hsk
             (=
               (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0) a)
               (mem_get m a))
             (rewrite-with
               (lemma store_le_get_below)
               lr
               lhs
               ()
               ((by arith (list 1 1 8 0)))
               refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise h1) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hih) lr lhs true ())
              (rewrite (premise hsk) lr lhs true ()))
             refl)))))))

(claim m_zh_geta
  (goal ((m Mem) (rb Int) (k Int) (a Int))
    ((= (le (+ rb (+ 24 (* 8 k))) a) True))
    (= (mem_get (m_zh m rb k) a) (mem_get m a)))
  (wf-induct k
    (case-on (lt k 1) Bool
      ((case True
         (chain
           (have hg (= (lt k 1) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise hg) lr lhs true ())
              (reduce lhs))
             refl)))
       (case False
         (chain
           (have h1 (= (lt k 1) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hih
             (=
               (mem_get
                 (m_zh
                   (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0)
                   rb
                   (- k 1))
                 a)
               (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0) a))
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((by arith (list 1 1 0))
                (by arith (list 1 0 1))
                (by arith (list 1 0 0)))
               refl))
           (have hsk
             (=
               (mem_get (store_le (iw8) m (+ rb (+ 24 (* 8 (- k 1)))) 0) a)
               (mem_get m a))
             (rewrite-with
               (lemma sga8)
               lr
               lhs
               ()
               ((by arith (list 1 1 0 0)))
               refl))
           (steps
             ((unfold m_zh lhs)
              (rewrite (premise h1) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hih) lr lhs true ())
              (rewrite (premise hsk) lr lhs true ()))
             refl)))))))

;; rt_init touches nothing below rb …
(claim m_init_fr_lo
  (goal ((m Mem) (rb Int) (lo Int) (hi Int) (a Int)) ((= (lt a rb) True))
    (= (mem_get (m_init m rb lo hi) a) (mem_get m a)))
  (chain
    (have hz
      (=
        (mem_get
          (m_zh
            (store_le
              (iw8)
              (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
              (+ rb 16)
              0)
            rb
            16)
          a)
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
            (+ rb 16)
            0)
          a))
      (rewrite-with (lemma m_zh_getb) lr lhs () ((by arith (list 1 1))) refl))
    (have h16
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
            (+ rb 16)
            0)
          a)
        (mem_get (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi) a))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((by arith (list 1 1 0)))
        refl))
    (have h8
      (=
        (mem_get (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi) a)
        (mem_get (store_le (iw8) m rb lo) a))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((by arith (list 1 1 0 0)))
        refl))
    (have h0 (= (mem_get (store_le (iw8) m rb lo) a) (mem_get m a))
      (rewrite-with
        (lemma store_le_get_below)
        lr
        lhs
        ()
        ((by arith (list 1 1 0 0 0)))
        refl))
    (steps
      ((unfold m_init lhs)
       (rewrite (premise hz) lr lhs true ())
       (rewrite (premise h16) lr lhs true ())
       (rewrite (premise h8) lr lhs true ())
       (rewrite (premise h0) lr lhs true ()))
      refl)))

;; … and nothing at or above rb + 152
(claim m_init_fr_hi
  (goal ((m Mem) (rb Int) (lo Int) (hi Int) (a Int))
    ((= (le (+ rb 152) a) True))
    (= (mem_get (m_init m rb lo hi) a) (mem_get m a)))
  (chain
    (have hz
      (=
        (mem_get
          (m_zh
            (store_le
              (iw8)
              (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
              (+ rb 16)
              0)
            rb
            16)
          a)
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
            (+ rb 16)
            0)
          a))
      (rewrite-with (lemma m_zh_geta) lr lhs () ((by arith (list 1 1))) refl))
    (have h16
      (=
        (mem_get
          (store_le
            (iw8)
            (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi)
            (+ rb 16)
            0)
          a)
        (mem_get (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi) a))
      (rewrite-with (lemma sga8) lr lhs () ((by arith (list 1 1 0))) refl))
    (have h8
      (=
        (mem_get (store_le (iw8) (store_le (iw8) m rb lo) (+ rb 8) hi) a)
        (mem_get (store_le (iw8) m rb lo) a))
      (rewrite-with (lemma sga8) lr lhs () ((by arith (list 1 1 0 0))) refl))
    (have h0 (= (mem_get (store_le (iw8) m rb lo) a) (mem_get m a))
      (rewrite-with (lemma sga8) lr lhs () ((by arith (list 1 1 0 0 0))) refl))
    (steps
      ((unfold m_init lhs)
       (rewrite (premise hz) lr lhs true ())
       (rewrite (premise h16) lr lhs true ())
       (rewrite (premise h8) lr lhs true ())
       (rewrite (premise h0) lr lhs true ()))
      refl)))

;; --- THE INIT ENGINE LEG rth_init_run (generated by gen_rth.py init — REGENERATE, never hand-patch) ---

;; rt_init's engine leg: under the window, band and depth premises the
;; call RETURNS 0 and leaves exactly m_init's stores.  Fuel: 21 = the
;; ipcall peel + the 20 ipstmts levels (the last level's S serves the
;; final statement and the Nil arm both).
(claim rth_init_run
  (goal
    ((fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (rb Int)
     (lo Int)
     (hi Int)
     (m Mem)
     (fuel Nat))
    ((= (le mlo rb) True)
     (= (le (+ rb 152) msz) True)
     (= (le 0 rb) True)
     (= (le (+ rb 152) 4294967296) True)
     (= (le 0 lo) True)
     (= (lt lo 18446744073709551616) True)
     (= (le 0 hi) True)
     (= (lt hi 18446744073709551616) True)
     (= (lt d dmax) True))
    (=
      (ipcall
        (nS 21 (ntl 21 fuel))
        (rt_app (rt_fns rb) fs)
        mlo
        msz
        dmax
        d
        0
        (Cons lo (Cons hi Nil))
        m)
      (Some (IpRv 0 (m_init m rb lo hi)))))
  (chain
    (have hmlo (= (mod lo 18446744073709551616) lo)
      (rewrite-with
        (lemma modu64_id)
        lr
        lhs
