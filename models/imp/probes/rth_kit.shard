             lr
             lhs
             ()
             ((steps ((rewrite (premise hrw) lr lhs true ())) refl))
             refl))
         (have hhd2 (= (int_eq (load_le (iw8) m p) (hdr_word tag n)) True)
           (steps
             ((rewrite (premise hhd) rl rhs true ())
              (rewrite (lemma hdr_rword) lr rhs true ())
              (compute rhs (stop iw8 load_le hdr_word)))
             refl))
         (have hsl0
           (=
