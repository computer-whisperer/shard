           (have r2g (= (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g)) True)
             (rewrite-with
               (lemma hrx_end)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have c2
             (=
               (int_eq
                 (load_le (iw8) (store_le (iw8) m v (- (hword c) 1)) (+ rb 8))
                 ge)
               True)
             (steps
               ((rewrite (premise r2) lr lhs true ())
                (rewrite (premise hge0) rl lhs true ())
                (rewrite (premise r2g) lr lhs true ()))
               refl))
           (have r3
             (=
               (load_le (iw8) (store_le (iw8) m v (- (hword c) 1)) (+ rb 16))
               (load_le (iw8) m (+ rb 16)))
             (rewrite-with
               (lemma ldw_below)
               lr
               lhs
               ()
               ((steps ((rewrite (premise a3) lr lhs true ())) refl))
               refl))
           (have r3g (= (int_eq (load_le (iw8) m (+ rb 16)) 0) True)
             (rewrite-with
               (lemma hrx_dep)
               lr
               lhs
               ((inst g g))
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have c3
             (=
               (int_eq
                 (load_le (iw8) (store_le (iw8) m v (- (hword c) 1)) (+ rb 16))
                 0)
               True)
             (steps
               ((rewrite (premise r3) lr lhs true ())
                (rewrite (premise r3g) lr lhs true ()))
               refl))
           (have c4g (= (int_eq (fllen (gfree_of g)) 16) True)
             (rewrite-with
               (lemma hrx_fl16)
               lr
               lhs
               ((inst m m) (inst rb rb))
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have c4 (= (int_eq (fllen gf) 16) True)
             (steps
               ((rewrite (premise hgf0) rl lhs true ())
                (rewrite (premise c4g) lr lhs true ()))
               refl))
           (have f16e (= (fllen gf) 16)
             (rewrite-with
               (lemma int_eq_eq)
               lr
               lhs
               ((inst b 16))
               ((steps ((rewrite (premise c4) lr lhs true ())) refl))
               refl))
           (have hfrg (= (hfree_rep m rb 0 (gfree_of g)) True)
             (rewrite-with
               (lemma hrx_free)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hfr (= (hfree_rep m rb 0 gf) True)
             (steps
               ((rewrite (premise hgf0) rl lhs true ())
                (rewrite (premise hfrg) lr lhs true ()))
               refl))
           (have hor2a (= (le (+ rb (+ 24 (* 8 (+ 0 16)))) v) True)
             (by arith (rows (goal 1) (h2 1) (hlo2 1))))
           (have hor
             (=
               (orb
                 (le (+ v 8) (+ rb (+ 24 (* 8 0))))
                 (le (+ rb (+ 24 (* 8 (+ 0 (fllen gf))))) v))
               True)
             (rewrite-with
               (lemma orb_intro_r)
               lr
               lhs
               ()
               ((steps
                  ((rewrite (premise f16e) lr lhs true ())
                   (rewrite (premise hor2a) lr lhs true ()))
                  refl))
               refl))
           (have hd1fg
             (= (e_disj1 v (harity_of (hfget gc v)) (fexts gf 0)) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hgf0) rl lhs true ())
                (rewrite (premise hd1f) lr lhs true ()))
               refl))
           (have hn0g (= (le 0 (harity_of (hfget gc v))) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hn0) lr lhs true ()))
               refl))
           (have c5
             (= (hfree_rep (store_le (iw8) m v (- (hword c) 1)) rb 0 gf) True)
             (rewrite-with
               (lemma hfree_rep_fr)
               lr
               lhs
               ((inst nb (harity_of (hfget gc v))))
               ((steps ((rewrite (premise hfr) lr lhs true ())) refl)
                (steps ((rewrite (premise hd1fg) lr lhs true ())) refl)
                (steps ((rewrite (premise hor) lr lhs true ())) refl)
                (steps ((compute lhs)) refl)
                (steps ((rewrite (premise hn0g) lr lhs true ())) refl))
               refl))
           (have hcrg (= (hcells_rep m (gcells_of g)) True)
             (rewrite-with
               (lemma hrx_cells)
               lr
               lhs
               ((inst rb rb))
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hcr (= (hcells_rep m gc) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hcrg) lr lhs true ()))
               refl))
           (have hco (= (cells_ok gc) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hcog) lr lhs true ()))
               refl))
           (have hdsjc (= (e_disj (hexts gc)) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hdsj) lr lhs true ()))
               refl))
           (have hmemc (= (memb (haddrs gc) v) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hmem) lr lhs true ()))
               refl))
           (have hltc (= (lt (hcount_of (hfget gc v)) 2147483648) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hfc) lr lhs true ())
                (rewrite (premise hlt) lr lhs true ()))
               refl))
           (have c6
             (=
               (hcells_rep (store_le (iw8) m v (- (hword c) 1)) (hdecc gc v))
               True)
             (rewrite-with
               (lemma hcells_rep_decc)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hcr) lr lhs true ())) refl)
                (steps ((rewrite (premise hco) lr lhs true ())) refl)
                (steps ((rewrite (premise hdsjc) lr lhs true ())) refl)
                (steps ((rewrite (premise hmemc) lr lhs true ())) refl)
                (steps
                  ((rewrite (premise hgc0) rl rhs true ())
                   (rewrite (premise hfc) lr rhs true ()))
                  refl)
                (steps ((rewrite (premise hltc) lr lhs true ())) refl))
               refl))
           (have hrwg (= (hraw_rep m (graw_of g)) True)
             (rewrite-with
               (lemma hrx_raw)
               lr
               lhs
               ((inst rb rb))
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hrw (= (hraw_rep m gr) True)
             (steps
               ((rewrite (premise hgr0) rl lhs true ())
                (rewrite (premise hrwg) lr lhs true ()))
               refl))
           (have hd1rg (= (e_disj1 v (harity_of (hfget gc v)) (rexts gr)) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hgr0) rl lhs true ())
                (rewrite (premise hd1r) lr lhs true ()))
               refl))
           (have hrkc (= (raw_ok gr gc) True)
             (steps
               ((rewrite (premise hgc0) rl lhs true ())
                (rewrite (premise hgr0) rl lhs true ())
                (rewrite (premise hrkg) lr lhs true ()))
               refl))
           (have c7 (= (hraw_rep (store_le (iw8) m v (- (hword c) 1)) gr) True)
             (rewrite-with
               (lemma hraw_rep_fr1)
               lr
               lhs
               ((inst nb (harity_of (hfget gc v))) (inst cs gc))
               ((steps ((rewrite (premise hrw) lr lhs true ())) refl)
                (steps ((rewrite (premise hd1rg) lr lhs true ())) refl)
                (steps ((rewrite (premise hrkc) lr lhs true ())) refl)
                (steps ((rewrite (premise hn0g) lr lhs true ())) refl))
               refl))
           (steps
             ((rewrite (premise hg2) lr lhs true ())
              (unfold heap_rep lhs)
              (compute
                lhs
                (stop iw8 load_le store_le hfree_rep hcells_rep hraw_rep fllen
                  hdecc hword))
              (rewrite (premise c1) lr lhs true ())
              (rewrite (premise c2) lr lhs true ())
              (rewrite (premise c3) lr lhs true ())
              (rewrite (premise c4) lr lhs true ())
              (rewrite (premise c5) lr lhs true ())
              (rewrite (premise c6) lr lhs true ())
              (rewrite (premise c7) lr lhs true ())
              (compute lhs))
             refl)))))))

;; hinv_inc_ref: a reference gains a root; the immortal leg by the
;; exemption, the live leg clause by clause through the hincc algebra
(claim hinv_inc_ref
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (memb (haddrs (gcells_of g)) v) True))
    (= (hinv rb (gh_inc g v) (Cons v r)) True))
  (chain
    (have hlv (= (live_ok g v) True)
      (rewrite-with
        (lemma live_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hal (= (int_eq (mod v 8) 0) True)
      (rewrite-with
        (lemma lv_al)
        lr
        lhs
        ((inst g g))
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hev (= (int_eq (mod v 2) 0) True)
      (rewrite-with
        (lemma mod8_even)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hal) lr lhs true ())) refl))
        refl))
    (have hodd (= (int_eq (mod v 2) 1) False)
      (rewrite-with
        (lemma even_not_odd)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hev) lr lhs true ())) refl))
        refl))
    (have hcin (= (le (count_in (haddrs (gcells_of g)) v) 1) True)
      (rewrite-with
        (lemma lv_cin1)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hfd (= (hfind (gcells_of g) v) (Some (hfget (gcells_of g) v)))
      (rewrite-with
        (lemma hfind_memb)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hcog (= (cells_ok (gcells_of g)) True)
      (rewrite-with
        (lemma hi_cells)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hcng (= (counts_ok (gcells_of g) (gcells_of g) r (graw_of g)) True)
      (rewrite-with
        (lemma hi_cnts)
        lr
        lhs
        ((inst rb rb))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hrog (= (roots_ok r (haddrs (gcells_of g))) True)
      (rewrite-with
        (lemma hi_roots)
        lr
        lhs
        ((inst rb rb))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hro2 (= (roots_ok (Cons v r) (haddrs (gcells_of g))) True)
      (steps
        ((unfold roots_ok lhs)
         (reduce lhs)
