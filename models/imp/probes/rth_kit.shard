             ((rewrite (premise hsl0) rl rhs true ())
              (compute rhs (stop iw8 hslots_rep)))
             refl))
         (have hnew (= (hcell_rep m (MkHCell p 1 tag n fill)) True)
           (steps
             ((unfold hcell_rep lhs)
              (compute lhs (stop iw8 load_le hslots_rep hword))
              (rewrite (lemma hword_seal) lr lhs true ())
