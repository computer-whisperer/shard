    (have b2 (= (le 0 (mem_get m (+ (+ a 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (have b3 (= (le 0 (mem_get m (+ (+ (+ a 1) 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (have b4 (= (le 0 (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (have b5 (= (le 0 (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (have b6 (= (le 0 (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (have b7
      (= (le 0 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))) True)
      (steps ((rewrite (lemma get_lo) lr lhs true ())) refl))
    (steps
      ((unfold iw8 lhs)
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_z) lr lhs true ())
       (compute lhs (stop mem_get)))
      (by
        arith
        (rows
          (goal 1)
          (b0 1)
          (b1 256)
          (b2 65536)
          (b3 16777216)
          (b4 4294967296)
          (b5 1099511627776)
          (b6 281474976710656)
          (b7 72057594037927936))))))

(claim ldw_hi
  (goal ((m Mem) (a Int)) ()
    (= (lt (load_le (iw8) m a) 18446744073709551616) True))
  (chain
    (have b0 (= (lt (mem_get m a) 256) True)
