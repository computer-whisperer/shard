                    (hyp 1)
                    lr
                    lhs
                    ((inst w w))
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hp2) lr lhs true ())) refl))
                    refl))
                (have hso (= (slots_ok (hslots_of c) (haddrs rest)) True)
                  (rewrite-with
                    (lemma co_slots)
