(claim rth_alloc_big_run
  (goal
    ((fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (m Mem)
     (tag Int)
     (n Int)
     (fuel Nat))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (lt n 16) False)
     (= (le 0 n) True)
     (= (lt n 65536) True)
     (= (le 0 tag) True)
     (= (lt tag 65536) True)
     (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
     (= (le mlo rb) True)
     (= (le (gend_of g) msz) True)
     (= (lt d dmax) True))
    (=
      (ipcall
        (nS 12 (ntl 12 fuel))
        (rt_app (rt_fns rb) fs)
        mlo
        msz
        dmax
        d
        1
        (Cons tag (Cons n Nil))
