                           (le lo b)
                           (andb (le (+ b (+ 8 (* 8 k))) top) (le 0 k)))
                         True)
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise h5) lr lhs true ())) refl)
                          (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                         refl))
                     (steps ((rewrite (premise hih) lr lhs true ())) refl)))))))))))))

