             refl))
         (have hri (= (rinc r v) r)
           (steps
             ((unfold rinc lhs)
              (rewrite (hyp True) lr lhs true ())
              (reduce lhs))
             refl))
         (steps
           ((rewrite (premise hgi) lr lhs true ())
            (rewrite (premise hri) lr lhs true ())
            (rewrite (premise 0) lr lhs true ()))
           refl)))
     (case False
