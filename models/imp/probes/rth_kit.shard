                     (unfold hfget rhs)
                     (reduce rhs))
                    refl))
                (have hp2 (= (lt 1 (hcount_of (hfget rest w))) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 2) lr lhs true ()))
                    refl))
                (have hih (= (cells_ok (hdecc rest w)) True)
