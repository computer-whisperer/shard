(claim we_hd
  (goal
    ((all (List HCell))
     (c HCell)
     (rest (List HCell))
     (r (List Int))
     (wl (List HCell))
     (ws (List Int)))
    ((= (wexact all (Cons c rest) r wl ws) True))
    (=
      (if (le 2147483648 (hcount_of c)) True
      (int_eq
        (hcount_of c)
        (+
          (count_in r (haddr_of c))
          (+
            (inbound_cells all (haddr_of c))
            (+ (inbound_cells wl (haddr_of c)) (count_in ws (haddr_of c)))))))
      True))
  (chain
    (have h0
      (=
        (andb
          (if (le 2147483648 (hcount_of c)) True
          (int_eq
            (hcount_of c)
            (+
              (count_in r (haddr_of c))
              (+
                (inbound_cells all (haddr_of c))
                (+ (inbound_cells wl (haddr_of c)) (count_in ws (haddr_of c)))))))
          (wexact all rest r wl ws))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold wexact rhs) (reduce rhs))
        refl))
    (have hx
      (=
        (if (le 2147483648 (hcount_of c)) True
        (int_eq
          (hcount_of c)
          (+
            (count_in r (haddr_of c))
