                refl))
             refl))
         (have c5
           (=
             (hfree_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 n))) (hhead rest))
                 p
                 (hdr_word tag n))
               rb
               0
               (fl_set gf n rest))
             True)
           (rewrite-with
             (lemma hfree_rep_fr)
             lr
             lhs
             ((inst nb n))
             ((steps ((rewrite (premise h5b) lr lhs true ())) refl)
              (steps ((rewrite (premise hdp) lr lhs true ())) refl)
              (steps ((rewrite (premise hor) lr lhs true ())) refl)
              (steps ((compute lhs)) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl))
             refl))
         (have hcrg (= (hcells_rep m (gcells_of g)) True)
           (rewrite-with
             (lemma hrx_cells)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcr (= (hcells_rep m gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcrg) lr lhs true ()))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have hHlo2 (= (le (+ (+ rb (+ 24 (* 8 n))) (+ 8 (* 8 0))) gl) True)
           (by arith (rows (goal 1) (h2 1) (4 8))))
         (have hdHc (= (e_disj1 (+ rb (+ 24 (* 8 n))) 0 (hexts gc)) True)
           (rewrite-with
             (lemma ebrk_ed1_below)
             lr
             lhs
