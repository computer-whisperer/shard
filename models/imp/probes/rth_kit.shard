      (steps ((rewrite (lemma get_hi) lr lhs true ())) refl))
    (have b4 (= (lt (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1)) 256) True)
      (steps ((rewrite (lemma get_hi) lr lhs true ())) refl))
    (have b5 (= (lt (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1)) 256) True)
      (steps ((rewrite (lemma get_hi) lr lhs true ())) refl))
    (have b6 (= (lt (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1)) 256) True)
      (steps ((rewrite (lemma get_hi) lr lhs true ())) refl))
    (have b7
      (= (lt (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)) 256) True)
      (steps ((rewrite (lemma get_hi) lr lhs true ())) refl))
    (steps
      ((unfold iw8 lhs)
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_z) lr lhs true ())
       (compute lhs (stop mem_get)))
      (by
        arith
        (rows
          (goal 1)
          (b0 1)
          (b1 256)
          (b2 65536)
          (b3 16777216)
          (b4 4294967296)
          (b5 1099511627776)
          (b6 281474976710656)
          (b7 72057594037927936))))))

;; --- the counts: the roots gain v -------------------------------------------------

;; no cell at v: the new root touches no equation
(claim counts_ok_incc_nm
  (goal
    ((all (List HCell))
     (cs (List HCell))
     (r (List Int))
     (raw (Option HRaw))
     (v Int))
    ((= (counts_ok all cs r raw) True) (= (count_in (haddrs cs) v) 0))
    (= (counts_ok (hincc all v) cs (Cons v r) raw) True))
  (induct cs
    ((case Nil (steps ((unfold counts_ok lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hhd
           (=
             (if (le 2147483648 (hcount_of c)) True
             (int_eq
               (hcount_of c)
               (+
                 (count_in r (haddr_of c))
                 (+
                   (inbound_cells all (haddr_of c))
                   (raw_refs raw (haddr_of c))))))
             True)
           (rewrite-with
             (lemma cnt_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (counts_ok all rest r raw) True)
           (rewrite-with
             (lemma cnt_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcn
           (=
             (if (int_eq (haddr_of c) v) (+ 1 (count_in (haddrs rest) v))
             (count_in (haddrs rest) v))
             0)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold count_in rhs)
              (reduce rhs))
             refl))
         (have hib
           (=
             (inbound_cells (hincc all v) (haddr_of c))
             (inbound_cells all (haddr_of c)))
           (rewrite-with (lemma inb_hincc) lr lhs () () refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hz (= (+ 1 (count_in (haddrs rest) v)) 0)
                  (steps
                    ((rewrite (premise hcn) rl rhs true ())
                     (rewrite (hyp True) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hnn (= (le 0 (count_in (haddrs rest) v)) True)
                  (rewrite-with (lemma cin_nonneg) lr lhs () () refl))
                (have hf0 (= (le 1 0) True)
                  (by arith (rows (goal 1) (hz -1) (hnn 1))))
                (have hf (= False True)
                  (steps
                    ((rewrite (premise hf0) rl rhs true ()) (compute rhs))
                    refl))
                (absurd (premise hf))))
            (case False
              (chain
                (have hF (= (int_eq (haddr_of c) v) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hct (= (count_in (haddrs rest) v) 0)
                  (steps
                    ((rewrite (premise hcn) rl rhs true ())
                     (rewrite (premise hF) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih (= (counts_ok (hincc all v) rest (Cons v r) raw) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hct) lr lhs true ())) refl))
                    refl))
                (have hne (= (int_eq v (haddr_of c)) False)
                  (rewrite-with
                    (lemma ieq_comm_f)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hF) lr lhs true ())) refl))
                    refl))
                (have hcv
                  (=
                    (count_in (Cons v r) (haddr_of c))
                    (count_in r (haddr_of c)))
                  (steps
                    ((unfold count_in lhs)
                     (reduce lhs)
                     (rewrite (premise hne) lr lhs true ())
                     (reduce lhs))
                    refl))
                (steps
                  ((unfold counts_ok lhs)
                   (reduce lhs)
                   (rewrite (premise hcv) lr lhs true ())
                   (rewrite (premise hib) lr lhs true ())
                   (rewrite (premise hhd) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))

;; the cell at v (unique) grows with the root; immortal cells stay exempt
(claim counts_ok_incc
  (goal
    ((all (List HCell))
     (cs (List HCell))
     (r (List Int))
     (raw (Option HRaw))
     (v Int))
    ((= (counts_ok all cs r raw) True) (= (le (count_in (haddrs cs) v) 1) True))
    (= (counts_ok (hincc all v) (hincc cs v) (Cons v r) raw) True))
  (induct cs
    ((case Nil
       (chain
         (have hn (= (hincc Nil v) Nil)
           (steps ((unfold hincc lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hn) lr lhs true ())
            (unfold counts_ok lhs)
            (reduce lhs))
           refl)))
     (case Cons
       (c rest)
       (chain
         (have hhd
           (=
             (if (le 2147483648 (hcount_of c)) True
             (int_eq
               (hcount_of c)
               (+
                 (count_in r (haddr_of c))
                 (+
                   (inbound_cells all (haddr_of c))
                   (raw_refs raw (haddr_of c))))))
             True)
           (rewrite-with
             (lemma cnt_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (counts_ok all rest r raw) True)
           (rewrite-with
             (lemma cnt_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcn
           (=
             (le
               (if (int_eq (haddr_of c) v) (+ 1 (count_in (haddrs rest) v))
               (count_in (haddrs rest) v))
               1)
             True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold count_in rhs)
              (reduce rhs))
             refl))
         (have hib
           (=
             (inbound_cells (hincc all v) (haddr_of c))
             (inbound_cells all (haddr_of c)))
           (rewrite-with (lemma inb_hincc) lr lhs () () refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hT (= (int_eq (haddr_of c) v) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hca (= (haddr_of c) v)
                  (rewrite-with
                    (lemma int_eq_eq)
                    lr
                    lhs
                    ((inst b v))
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hc1 (= (le (+ 1 (count_in (haddrs rest) v)) 1) True)
                  (steps
                    ((rewrite (premise hcn) rl rhs true ())
                     (rewrite (premise hT) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hnn (= (le 0 (count_in (haddrs rest) v)) True)
                  (rewrite-with (lemma cin_nonneg) lr lhs () () refl))
                (have hle (= (le (count_in (haddrs rest) v) 0) True)
                  (by arith (rows (goal 1) (hc1 1))))
                (have hcte (= (int_eq (count_in (haddrs rest) v) 0) True)
                  (rewrite-with
                    (lemma ieq_of_le2)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hle) lr lhs true ())) refl)
                     (steps ((rewrite (premise hnn) lr lhs true ())) refl))
                    refl))
                (have hct (= (count_in (haddrs rest) v) 0)
                  (rewrite-with
                    (lemma int_eq_eq)
                    lr
                    lhs
                    ((inst b 0))
                    ((steps ((rewrite (premise hcte) lr lhs true ())) refl))
                    refl))
                (have htl2
                  (= (counts_ok (hincc all v) rest (Cons v r) raw) True)
                  (rewrite-with
                    (lemma counts_ok_incc_nm)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hct) lr lhs true ())) refl))
                    refl))
                (have hcv (= (count_in (Cons v r) v) (+ 1 (count_in r v)))
                  (steps
                    ((unfold count_in lhs)
                     (reduce lhs)
                     (rewrite (lemma int_eq_refl) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hcva
                  (=
                    (count_in (Cons v r) (haddr_of c))
                    (+ 1 (count_in r (haddr_of c))))
                  (steps
                    ((rewrite (premise hca) lr lhs true ())
                     (rewrite (premise hca) lr rhs true ())
                     (rewrite (premise hcv) lr lhs true ()))
                    refl))
                (have hhd2
                  (=
                    (if (le 2147483648 (+ (hcount_of c) 1)) True
                    (int_eq
                      (+ (hcount_of c) 1)
                      (+
                        (count_in (Cons v r) (haddr_of c))
                        (+
                          (inbound_cells all (haddr_of c))
                          (raw_refs raw (haddr_of c))))))
                    True)
                  (case-on (le 2147483648 (+ (hcount_of c) 1)) Bool
                    ((case True
                       (steps
                         ((rewrite (hyp True) lr lhs true ()) (reduce lhs))
                         refl))
                     (case False
                       (chain
                         (have hnb (= (le 2147483648 (+ (hcount_of c) 1)) False)
                           (steps ((rewrite (hyp False) lr lhs true ())) refl))
                         (have hnb0 (= (le 2147483648 (hcount_of c)) False)
                           (by arith (rows (goal 1) (hnb 1))))
                         (have he
                           (=
                             (int_eq
                               (hcount_of c)
                               (+
                                 (count_in r (haddr_of c))
                                 (+
                                   (inbound_cells all (haddr_of c))
                                   (raw_refs raw (haddr_of c)))))
                             True)
                           (steps
                             ((rewrite (premise hhd) rl rhs true ())
                              (rewrite (premise hnb0) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (have hee
                           (=
                             (hcount_of c)
                             (+
                               (count_in r (haddr_of c))
                               (+
                                 (inbound_cells all (haddr_of c))
                                 (raw_refs raw (haddr_of c)))))
                           (rewrite-with
                             (lemma int_eq_eq)
                             lr
                             lhs
                             ((inst
                                b
                                (+
                                  (count_in r (haddr_of c))
                                  (+
                                    (inbound_cells all (haddr_of c))
                                    (raw_refs raw (haddr_of c))))))
                             ((steps
                                ((rewrite (premise he) lr lhs true ()))
                                refl))
                             refl))
                         (have hl1
                           (=
                             (le
                               (+ (hcount_of c) 1)
                               (+
                                 (count_in (Cons v r) (haddr_of c))
                                 (+
                                   (inbound_cells all (haddr_of c))
                                   (raw_refs raw (haddr_of c)))))
                             True)
                           (by arith (rows (goal 1) (hee -1) (hcva 1))))
                         (have hl2
                           (=
                             (le
                               (+
                                 (count_in (Cons v r) (haddr_of c))
                                 (+
                                   (inbound_cells all (haddr_of c))
                                   (raw_refs raw (haddr_of c))))
                               (+ (hcount_of c) 1))
                             True)
                           (by arith (rows (goal 1) (hee 1) (hcva -1))))
                         (have hne2
                           (=
                             (int_eq
                               (+ (hcount_of c) 1)
                               (+
                                 (count_in (Cons v r) (haddr_of c))
                                 (+
                                   (inbound_cells all (haddr_of c))
                                   (raw_refs raw (haddr_of c)))))
                             True)
                           (rewrite-with
                             (lemma ieq_of_le2)
                             lr
                             lhs
                             ()
                             ((steps
                                ((rewrite (premise hl1) lr lhs true ()))
                                refl)
                              (steps
                                ((rewrite (premise hl2) lr lhs true ()))
                                refl))
                             refl))
                         (steps
                           ((rewrite (premise hnb) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hne2) lr lhs true ()))
                           refl))))))
                (case-on c HCell
                  ((case MkHCell
                     (ax cx tx rx sx)
                     (chain
                       (have hcc
                         (=
                           (hcount_of (with_hcount (+ (hcount_of c) 1) c))
                           (+ (hcount_of c) 1))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have hac
                         (=
                           (haddr_of (with_hcount (+ (hcount_of c) 1) c))
                           (haddr_of c))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have hinc1
                         (=
                           (hincc (Cons c rest) v)
                           (Cons (with_hcount (+ (hcount_of c) 1) c) rest))
                         (steps
                           ((unfold hincc lhs)
                            (reduce lhs)
                            (rewrite (premise hT) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (steps
                         ((rewrite (premise hinc1) lr lhs true ())
                          (unfold counts_ok lhs)
                          (reduce lhs)
                          (rewrite (premise hcc) lr lhs true ())
                          (rewrite (premise hac) lr lhs true ())
                          (rewrite (premise hib) lr lhs true ())
                          (rewrite (premise hhd2) lr lhs true ())
                          (rewrite (premise htl2) lr lhs true ())
                          (compute lhs))
                         refl)))))))
            (case False
              (chain
                (have hF (= (int_eq (haddr_of c) v) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hcnr (= (le (count_in (haddrs rest) v) 1) True)
                  (steps
                    ((rewrite (premise hcn) rl rhs true ())
                     (rewrite (premise hF) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih
                  (=
                    (counts_ok (hincc all v) (hincc rest v) (Cons v r) raw)
                    True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcnr) lr lhs true ())) refl))
                    refl))
                (have hne (= (int_eq v (haddr_of c)) False)
                  (rewrite-with
                    (lemma ieq_comm_f)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hF) lr lhs true ())) refl))
                    refl))
                (have hcv
                  (=
                    (count_in (Cons v r) (haddr_of c))
                    (count_in r (haddr_of c)))
                  (steps
                    ((unfold count_in lhs)
                     (reduce lhs)
                     (rewrite (premise hne) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hinc2 (= (hincc (Cons c rest) v) (Cons c (hincc rest v)))
                  (steps
                    ((unfold hincc lhs)
                     (reduce lhs)
                     (rewrite (premise hF) lr lhs true ())
                     (reduce lhs))
                    refl))
                (steps
                  ((rewrite (premise hinc2) lr lhs true ())
                   (unfold counts_ok lhs)
                   (reduce lhs)
                   (rewrite (premise hcv) lr lhs true ())
                   (rewrite (premise hib) lr lhs true ())
                   (rewrite (premise hhd) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))

;; an immortal cell at v: the roots may gain v freely (the exemption)
(claim counts_ok_cons_imm
  (goal
    ((all (List HCell))
     (cs (List HCell))
     (r (List Int))
     (raw (Option HRaw))
     (v Int))
    ((= (counts_ok all cs r raw) True) (= (imm_at cs v) True))
    (= (counts_ok all cs (Cons v r) raw) True))
  (induct cs
    ((case Nil (steps ((unfold counts_ok lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hhd
           (=
             (if (le 2147483648 (hcount_of c)) True
             (int_eq
               (hcount_of c)
               (+
                 (count_in r (haddr_of c))
                 (+
                   (inbound_cells all (haddr_of c))
                   (raw_refs raw (haddr_of c))))))
             True)
           (rewrite-with
             (lemma cnt_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (counts_ok all rest r raw) True)
           (rewrite-with
             (lemma cnt_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have him
           (=
             (andb
               (if (int_eq (haddr_of c) v) (le 2147483648 (hcount_of c)) True)
               (imm_at rest v))
             True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold imm_at rhs)
              (reduce rhs))
             refl))
         (have himh
           (=
             (if (int_eq (haddr_of c) v) (le 2147483648 (hcount_of c)) True)
             True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (imm_at rest v)))
             ((steps ((rewrite (premise him) lr lhs true ())) refl))
             refl))
         (have himt (= (imm_at rest v) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst
                a
                (if (int_eq (haddr_of c) v) (le 2147483648 (hcount_of c)) True)))
             ((steps ((rewrite (premise him) lr lhs true ())) refl))
             refl))
         (have hih (= (counts_ok all rest (Cons v r) raw) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ()
             ((steps ((rewrite (premise htl) lr lhs true ())) refl)
              (steps ((rewrite (premise himt) lr lhs true ())) refl))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hi2 (= (le 2147483648 (hcount_of c)) True)
                  (steps
                    ((rewrite (premise himh) rl rhs true ())
                     (rewrite (hyp True) lr rhs true ())
                     (reduce rhs))
                    refl))
                (steps
                  ((unfold counts_ok lhs)
                   (reduce lhs)
                   (rewrite (premise hi2) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl)))
            (case False
              (chain
                (have hne (= (int_eq v (haddr_of c)) False)
                  (rewrite-with
                    (lemma ieq_comm_f)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (hyp False) lr lhs true ())) refl))
                    refl))
                (have hcv
                  (=
                    (count_in (Cons v r) (haddr_of c))
                    (count_in r (haddr_of c)))
                  (steps
                    ((unfold count_in lhs)
                     (reduce lhs)
                     (rewrite (premise hne) lr lhs true ())
                     (reduce lhs))
                    refl))
                (steps
                  ((unfold counts_ok lhs)
                   (reduce lhs)
                   (rewrite (premise hcv) lr lhs true ())
                   (rewrite (premise hhd) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))

;; --- two carriers ---------------------------------------------------------------------

;; a store disjoint from the raw extent (open or not) keeps hraw_rep
(claim hraw_rep_fr1
  (goal ((m Mem) (raw (Option HRaw)) (cs (List HCell)) (b Int) (nb Int) (w Int))
    ((= (hraw_rep m raw) True)
     (= (e_disj1 b nb (rexts raw)) True)
     (= (raw_ok raw cs) True)
     (= (le 0 nb) True))
    (= (hraw_rep (store_le (iw8) m b w) raw) True))
  (case-on raw Option
    ((case None
       (steps
         ((rewrite (hyp 0) lr lhs true ()) (unfold hraw_rep lhs) (reduce lhs))
         refl))
     (case Some
       (rc)
       (chain
         (have hr0 (= (hraw_rep m (Some rc)) True)
           (steps
             ((rewrite (hyp 0) rl lhs true ())
              (rewrite (premise 0) lr lhs true ()))
             refl))
         (have hd1
           (=
             (e_disj1 b nb (Cons (Pair (raddr_of rc) (rarity_of rc)) Nil))
             True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (unfold rexts rhs)
              (reduce rhs))
             refl))
         (have hd2 (= (e_disj2 b nb (raddr_of rc) (rarity_of rc)) True)
           (rewrite-with
             (lemma ed1_hd)
             lr
             lhs
             ((inst rest Nil))
             ((steps ((rewrite (premise hd1) lr lhs true ())) refl))
             refl))
         (have hrk (= (raw_ok (Some rc) cs) True)
           (steps
             ((rewrite (hyp 0) rl lhs true ())
              (rewrite (premise 2) lr lhs true ()))
             refl))
         (have hln (= (le (ilen (rfill_of rc)) (rarity_of rc)) True)
           (rewrite-with
             (lemma rk_len)
             lr
             lhs
             ((inst cs cs))
             ((steps ((rewrite (premise hrk) lr lhs true ())) refl))
             refl))
         (have hfin (= (hraw_rep (store_le (iw8) m b w) (Some rc)) True)
           (rewrite-with
             (lemma hraw_rep_fr)
             lr
             lhs
             ((inst nb nb))
             ((steps ((rewrite (premise hr0) lr lhs true ())) refl)
              (steps ((rewrite (premise hd2) lr lhs true ())) refl)
              (steps ((rewrite (premise hln) lr lhs true ())) refl)
              (steps ((rewrite (premise 3) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (rewrite (premise hfin) lr lhs true ()))
           refl))))))

;; raw_ok reads only the live addresses, which hincc keeps
(claim raw_ok_hincc
  (goal ((raw (Option HRaw)) (cs (List HCell)) (v Int)) ()
    (= (raw_ok raw (hincc cs v)) (raw_ok raw cs)))
  (case-on raw Option
    ((case None
       (steps
         ((rewrite (hyp 0) lr lhs true ())
          (rewrite (hyp 0) lr rhs true ())
          (unfold raw_ok lhs)
          (reduce lhs)
          (unfold raw_ok rhs)
          (reduce rhs))
         refl))
     (case Some
       (rc)
       (steps
         ((rewrite (hyp 0) lr lhs true ())
          (rewrite (hyp 0) lr rhs true ())
          (unfold raw_ok lhs)
          (reduce lhs)
          (unfold raw_ok rhs)
          (reduce rhs)
          (rewrite (lemma haddrs_hincc) lr lhs true ()))
         refl)))))

;; --- THE INC LAWS -------------------------------------------------------------------

;; an immediate: the ghost and the memory stand
(claim gh_inc_imm
  (goal ((g GHeap) (v Int)) ((= (int_eq (mod v 2) 1) True)) (= (gh_inc g v) g))
  (steps
    ((unfold gh_inc lhs) (rewrite (premise 0) lr lhs true ()) (reduce lhs))
    refl))

(claim m_inc_imm
  (goal ((m Mem) (g GHeap) (v Int)) ((= (int_eq (mod v 2) 1) True))
    (= (m_inc m g v) m))
  (steps
    ((unfold m_inc lhs) (rewrite (premise 0) lr lhs true ()) (reduce lhs))
    refl))

;; hr_inc: the bytes after rt_inc's store mean the incremented ghost — no
;; premise on v: the identity legs are identity
(claim hr_inc
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (heap_rep m rb g) True) (= (hinv rb g r) True))
    (= (heap_rep (m_inc m g v) rb (gh_inc g v)) True))
  (case-on (int_eq (mod v 2) 1) Bool
    ((case True
       (chain
         (have hgi (= (gh_inc g v) g)
           (rewrite-with
             (lemma gh_inc_imm)
             lr
             lhs
             ()
             ((steps ((rewrite (hyp True) lr lhs true ())) refl))
             refl))
         (have hmi (= (m_inc m g v) m)
           (rewrite-with
             (lemma m_inc_imm)
             lr
             lhs
             ()
             ((steps ((rewrite (hyp True) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (premise hgi) lr lhs true ())
            (rewrite (premise hmi) lr lhs true ())
            (rewrite (premise 0) lr lhs true ()))
           refl)))
     (case False
       (chain
         (have hodd (= (int_eq (mod v 2) 1) False)
           (steps ((rewrite (hyp False) lr lhs true ())) refl))
         (case-on (hfind (gcells_of g) v) Option
           ((case None
              (chain
                (have hgi (= (gh_inc g v) g)
                  (steps
                    ((unfold gh_inc lhs)
                     (rewrite (premise hodd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hmi (= (m_inc m g v) m)
                  (steps
                    ((unfold m_inc lhs)
                     (rewrite (premise hodd) lr lhs true ())
                     (reduce lhs)
                     (rewrite (hyp 0) lr lhs true ())
                     (reduce lhs))
                    refl))
                (steps
                  ((rewrite (premise hgi) lr lhs true ())
                   (rewrite (premise hmi) lr lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl)))
            (case Some
              (c)
              (chain
                (have hfd (= (hfind (gcells_of g) v) (Some c))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (have hmem (= (memb (haddrs (gcells_of g)) v) True)
                  (steps
                    ((rewrite (lemma memb_hhas) lr lhs true ())
                     (unfold hhas lhs)
                     (rewrite (premise hfd) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hfc (= (hfget (gcells_of g) v) c)
                  (steps
                    ((unfold hfget lhs)
                     (rewrite (premise hfd) lr lhs true ())
                     (reduce lhs))
                    refl))
                (case-on (le 2147483648 (hcount_of c)) Bool
                  ((case True
                     (chain
                       (have hT (= (le 2147483648 (hcount_of c)) True)
                         (steps ((rewrite (hyp True) lr lhs true ())) refl))
                       (have hgi (= (gh_inc g v) g)
                         (steps
                           ((unfold gh_inc lhs)
                            (rewrite (premise hodd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hfd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hT) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (have hmi (= (m_inc m g v) m)
                         (steps
                           ((unfold m_inc lhs)
                            (rewrite (premise hodd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hfd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hT) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (steps
                         ((rewrite (premise hgi) lr lhs true ())
                          (rewrite (premise hmi) lr lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl)))
                   (case False
                     (chain
                       (have hF (= (le 2147483648 (hcount_of c)) False)
                         (steps ((rewrite (hyp False) lr lhs true ())) refl))
                       (have hlt (= (lt (hcount_of c) 2147483648) True)
                         (by arith (rows (goal 1) (hF 1))))
                       (have hgi
                         (=
                           (gh_inc g v)
                           (with_gcells (hincc (gcells_of g) v) g))
                         (steps
                           ((unfold gh_inc lhs)
                            (rewrite (premise hodd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hfd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hF) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (have hmi
                         (= (m_inc m g v) (store_le (iw8) m v (+ (hword c) 1)))
                         (steps
                           ((unfold m_inc lhs)
                            (rewrite (premise hodd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hfd) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hF) lr lhs true ())
                            (reduce lhs))
                           refl))
                       (have hlv (= (live_ok g v) True)
                         (rewrite-with
                           (lemma live_facts)
                           lr
                           lhs
                           ((inst rb rb) (inst r r))
                           ((steps ((rewrite (premise 1) lr lhs true ())) refl)
                            (steps
                              ((rewrite (premise hmem) lr lhs true ()))
                              refl))
                           refl))
                       (have hlo (= (le (glo_of g) v) True)
                         (rewrite-with
                           (lemma lv_lo)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hlv) lr lhs true ()))
                              refl))
                           refl))
                       (have hd1f
                         (=
                           (e_disj1
                             v
                             (harity_of (hfget (gcells_of g) v))
                             (fexts (gfree_of g) 0))
                           True)
                         (rewrite-with
                           (lemma lv_d1f)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hlv) lr lhs true ()))
                              refl))
                           refl))
                       (have hd1r
                         (=
                           (e_disj1
                             v
                             (harity_of (hfget (gcells_of g) v))
                             (rexts (graw_of g)))
                           True)
                         (rewrite-with
                           (lemma lv_d1r)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hlv) lr lhs true ()))
                              refl))
                           refl))
                       (have hdsj (= (e_disj (hexts (gcells_of g))) True)
                         (rewrite-with
                           (lemma lv_disj)
                           lr
                           lhs
                           ((inst v v))
                           ((steps
                              ((rewrite (premise hlv) lr lhs true ()))
                              refl))
                           refl))
                       (have hcb (= (cbands (hfget (gcells_of g) v)) True)
                         (rewrite-with
                           (lemma lv_bands)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hlv) lr lhs true ()))
                              refl))
                           refl))
                       (have hn0
                         (= (le 0 (harity_of (hfget (gcells_of g) v))) True)
                         (rewrite-with
                           (lemma cb_ar0)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hcb) lr lhs true ()))
                              refl))
                           refl))
                       (have h2g (= (le (+ rb 152) (glo_of g)) True)
                         (rewrite-with
                           (lemma hi_hdr)
                           lr
                           lhs
                           ((inst r r))
                           ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                           refl))
                       (have hcog (= (cells_ok (gcells_of g)) True)
                         (rewrite-with
                           (lemma hi_cells)
                           lr
                           lhs
                           ((inst rb rb) (inst r r))
                           ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                           refl))
                       (have hrkg (= (raw_ok (graw_of g) (gcells_of g)) True)
                         (rewrite-with
                           (lemma hi_raw)
                           lr
                           lhs
                           ((inst rb rb) (inst r r))
                           ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                           refl))
                       (case-on g GHeap
                         ((case MkGHeap
                            (gc gf gl gt ge gr)
                            (chain
                              (have hg2
                                (=
                                  (with_gcells (hincc (gcells_of g) v) g)
                                  (MkGHeap (hincc gc v) gf gl gt ge gr))
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs (stop hincc)))
                                  refl))
                              (have hgl0 (= (glo_of g) gl)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have hgt0 (= (gtop_of g) gt)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have hge0 (= (gend_of g) ge)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have hgc0 (= (gcells_of g) gc)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have hgf0 (= (gfree_of g) gf)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have hgr0 (= (graw_of g) gr)
                                (steps
                                  ((rewrite (hyp 0) lr lhs true ())
                                   (compute lhs))
                                  refl))
                              (have h2 (= (le (+ rb 152) gl) True)
                                (steps
                                  ((rewrite (premise hgl0) rl lhs true ())
                                   (rewrite (premise h2g) lr lhs true ()))
                                  refl))
                              (have hlo2 (= (le gl v) True)
                                (steps
                                  ((rewrite (premise hgl0) rl lhs true ())
                                   (rewrite (premise hlo) lr lhs true ()))
                                  refl))
                              (have a1 (= (le (+ rb 8) v) True)
                                (by arith (rows (goal 1) (h2 1) (hlo2 1))))
                              (have a2 (= (le (+ (+ rb 8) 8) v) True)
                                (by arith (rows (goal 1) (h2 1) (hlo2 1))))
                              (have a3 (= (le (+ (+ rb 16) 8) v) True)
                                (by arith (rows (goal 1) (h2 1) (hlo2 1))))
                              (have r1
                                (=
                                  (load_le
                                    (iw8)
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    rb)
                                  (load_le (iw8) m rb))
                                (rewrite-with
                                  (lemma ldw_below)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise a1) lr lhs true ()))
                                     refl))
                                  refl))
                              (have r1g
                                (=
                                  (int_eq (load_le (iw8) m rb) (gtop_of g))
                                  True)
                                (rewrite-with
                                  (lemma hrx_top)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have c1
                                (=
                                  (int_eq
                                    (load_le
                                      (iw8)
                                      (store_le (iw8) m v (+ (hword c) 1))
                                      rb)
                                    gt)
                                  True)
                                (steps
                                  ((rewrite (premise r1) lr lhs true ())
