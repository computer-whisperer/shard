             refl))
         (have h6 (= (int_eq (mod gl 8) 0) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h6g) lr lhs true ()))
             refl))
         (have h7g (= (int_eq (mod (gtop_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_atop)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h7 (= (int_eq (mod gt 8) 0) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h7g) lr lhs true ()))
             refl))
         (have hx1
           (=
             (ext_all g)
             (fexts_app
               (hexts gc)
               (fexts_app (fexts gf 0) (Cons (Pair p n) Nil))))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app)))
             refl))
         (have hx2
           (=
             (ext_all
               (MkGHeap
                 gc
                 gf
                 gl
                 gt
                 ge
                 (Some (MkHRaw p tag n (iapp fill (Cons w Nil))))))
             (fexts_app
               (hexts gc)
               (fexts_app (fexts gf 0) (Cons (Pair p n) Nil))))
           (steps
             ((unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app iapp)))
             refl))
         (have hdj (= (e_disj (ext_all g)) True)
           (rewrite-with
             (lemma hi_disj)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hdj2
           (=
             (e_disj
               (ext_all
                 (MkGHeap
                   gc
                   gf
                   gl
                   gt
                   ge
                   (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))))))
             True)
           (steps
             ((rewrite (premise hx2) lr lhs true ())
              (rewrite (premise hx1) rl lhs true ())
              (rewrite (premise hdj) lr lhs true ()))
             refl))
         (have hbkg (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_brk)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbk (= (e_brk (ext_all g) gl gt) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hbkg) lr lhs true ()))
             refl))
         (have hbk2
           (=
             (e_brk
               (ext_all
                 (MkGHeap
                   gc
                   gf
                   gl
                   gt
                   ge
                   (Some (MkHRaw p tag n (iapp fill (Cons w Nil))))))
               gl
               gt)
             True)
           (steps
             ((rewrite (premise hx2) lr lhs true ())
              (rewrite (premise hx1) rl lhs true ())
              (rewrite (premise hbk) lr lhs true ()))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have hcng
           (= (counts_ok (gcells_of g) (gcells_of g) r (graw_of g)) True)
           (rewrite-with
             (lemma hi_cnts)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcn0 (= (counts_ok gc gc r (Some (MkHRaw p tag n fill))) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise 1) rl lhs true ())
              (rewrite (premise hcng) lr lhs true ()))
             refl))
         (have hrog (= (roots_ok r (haddrs (gcells_of g))) True)
           (rewrite-with
             (lemma hi_roots)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hro (= (roots_ok r (haddrs gc)) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hrog) lr lhs true ()))
             refl))
         (have hcn2
           (=
             (counts_ok
               gc
               gc
               (irem r w)
               (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))))
             True)
           (rewrite-with
             (lemma counts_ok_fill_ref)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hcn0) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl))
             refl))
         (have hro2 (= (roots_ok (irem r w) (haddrs gc)) True)
           (rewrite-with
             (lemma roots_ok_dropr)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hro) lr lhs true ())) refl))
             refl))
         (have hmw (= (memb (haddrs gc) w) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise 3) lr lhs true ()))
             refl))
         (have hsk (= (slot_ok w (haddrs gc)) True)
           (rewrite-with
             (lemma slot_ok_memb)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hmw) lr lhs true ())) refl))
             refl))
         (have hrkg (= (raw_ok (graw_of g) (gcells_of g)) True)
           (rewrite-with
             (lemma hi_raw)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hrk (= (raw_ok (Some (MkHRaw p tag n fill)) gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise 1) rl lhs true ())
              (rewrite (premise hrkg) lr lhs true ()))
             refl))
         (have hr1
           (=
             (andb
               (slots_ok fill (haddrs gc))
               (andb
                 (le (ilen fill) n)
                 (andb
                   (le 0 tag)
                   (andb (lt tag 65536) (andb (le 0 n) (lt n 65536))))))
             True)
           (steps
             ((rewrite (premise hrk) rl rhs true ())
              (unfold raw_ok rhs)
              (compute rhs (stop slots_ok haddrs ilen andb)))
             refl))
         (have hso (= (slots_ok fill (haddrs gc)) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst
                b
                (andb
                  (le (ilen fill) n)
                  (andb
                    (le 0 tag)
                    (andb (lt tag 65536) (andb (le 0 n) (lt n 65536)))))))
             ((steps ((rewrite (premise hr1) lr lhs true ())) refl))
             refl))
         (have hr2
           (=
             (andb
               (le (ilen fill) n)
               (andb
                 (le 0 tag)
                 (andb (lt tag 65536) (andb (le 0 n) (lt n 65536)))))
             True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (slots_ok fill (haddrs gc))))
             ((steps ((rewrite (premise hr1) lr lhs true ())) refl))
             refl))
         (have hrkb
           (=
             (andb
               (le 0 tag)
               (andb (lt tag 65536) (andb (le 0 n) (lt n 65536))))
             True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (le (ilen fill) n)))
             ((steps ((rewrite (premise hr2) lr lhs true ())) refl))
             refl))
         (have hso2 (= (slots_ok (iapp fill (Cons w Nil)) (haddrs gc)) True)
           (rewrite-with
             (lemma slots_ok_snoc)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hso) lr lhs true ())) refl)
              (steps ((rewrite (premise hsk) lr lhs true ())) refl))
             refl))
         (have hln (= (ilen (iapp fill (Cons w Nil))) (+ (ilen fill) 1))
           (rewrite-with (lemma ilen_snoc) lr lhs () () refl))
         (have hle (= (le (+ (ilen fill) 1) n) True)
           (by arith (rows (goal 1) (2 1))))
         (have hrk2
           (= (raw_ok (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) gc) True)
           (steps
             ((unfold raw_ok lhs)
              (compute lhs (stop slots_ok haddrs ilen iapp andb))
              (rewrite (premise hso2) lr lhs true ())
              (rewrite (premise hln) lr lhs true ())
              (rewrite (premise hle) lr lhs true ())
              (rewrite (premise hrkb) lr lhs true ())
              (compute lhs))
             refl))
         (steps
           ((rewrite (premise hg2) lr lhs true ())
            (unfold hinv lhs)
            (compute
              lhs
              (stop e_disj e_brk cells_ok counts_ok roots_ok raw_ok haddrs hexts
                fexts fexts_app ext_all iapp andb irem))
            (rewrite (premise h1) lr lhs true ())
            (rewrite (premise h2) lr lhs true ())
            (rewrite (premise h3) lr lhs true ())
            (rewrite (premise h4) lr lhs true ())
            (rewrite (premise h5) lr lhs true ())
            (rewrite (premise h6) lr lhs true ())
            (rewrite (premise h7) lr lhs true ())
            (rewrite (premise hdj2) lr lhs true ())
            (rewrite (premise hbk2) lr lhs true ())
            (rewrite (premise hco) lr lhs true ())
            (rewrite (premise hcn2) lr lhs true ())
            (rewrite (premise hro2) lr lhs true ())
            (rewrite (premise hrk2) lr lhs true ())
            (compute lhs))
           refl))))))

;; --- rt_inc's toolkit (C2b-4 part i) ----------------------------------------------
;; The parity test and the count field of a header word, the hfind/hfget
;; bridge, the hincc algebra (hdecc's mirror), and the live cell's bundle.

;; band by 1 IS mod 2 (mask_pow2 at k = 1): every runtime entry's first test
(claim band1_mod2
  (goal ((v Int)) ((= (le 0 v) True)) (= (band v 1) (mod v 2)))
  (chain
    (have hz (= (pow2 0) 1) (rewrite-with (lemma pow2_z) lr lhs () () refl))
    (have hs (= (pow2 (+ 0 1)) (* 2 (pow2 0)))
      (rewrite-with
        (lemma pow2_s)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hpa (= (pow2 (+ 0 1)) (pow2 1)) (steps ((compute both)) refl))
    (have hp2 (= (pow2 1) 2)
      (steps
        ((rewrite (premise hpa) rl lhs true ())
         (rewrite (premise hs) lr lhs true ())
         (rewrite (premise hz) lr lhs true ())
         (compute lhs))
        refl))
    (have h1 (= (band v (- (pow2 1) 1)) (mod v (pow2 1)))
      (rewrite-with
        (lemma mask_pow2)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl)
         (steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hp2) rl rhs true ())
       (rewrite (premise h1) rl rhs true ())
       (rewrite (premise hp2) lr rhs true ())
       (compute rhs))
      refl)))

;; an even word is not odd
(claim even_not_odd
  (goal ((v Int)) ((= (int_eq (mod v 2) 0) True))
    (= (int_eq (mod v 2) 1) False))
  (chain
    (have he (= (mod v 2) 0)
      (rewrite-with
        (lemma int_eq_eq)
        lr
        lhs
        ((inst b 0))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise he) lr lhs true ()) (compute lhs)) refl)))

;; a header word's range under the bands
(claim hword_lo
  (goal ((c HCell)) ((= (cbands c) True)) (= (le 0 (hword c)) True))
  (chain
    (have h1 (= (le 1 (hcount_of c)) True)
      (rewrite-with
        (lemma cb_cnt1)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h3 (= (le 0 (htag_of c)) True)
      (rewrite-with
        (lemma cb_tag0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h5 (= (le 0 (harity_of c)) True)
      (rewrite-with
        (lemma cb_ar0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold hword lhs))
      (by arith (rows (goal 1) (h1 1) (h3 4294967296) (h5 281474976710656))))))

(claim hword_hi
  (goal ((c HCell)) ((= (cbands c) True))
    (= (lt (hword c) 18446744073709551616) True))
  (chain
    (have h2 (= (lt (hcount_of c) 4294967296) True)
      (rewrite-with
        (lemma cb_cnthi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h4 (= (lt (htag_of c) 65536) True)
      (rewrite-with
        (lemma cb_taghi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h6 (= (lt (harity_of c) 65536) True)
      (rewrite-with
        (lemma cb_arhi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold hword lhs))
      (by arith (rows (goal 1) (h2 1) (h4 4294967296) (h6 281474976710656))))))

;; THE COUNT FIELD: masking a header word by 0xFFFFFFFF reads the count
;; (mask_word32, then mod_unique at q = tag + arity * 2^16)
(claim hword_count
  (goal ((c HCell)) ((= (cbands c) True))
    (= (band (hword c) 4294967295) (hcount_of c)))
  (chain
    (have h1 (= (le 1 (hcount_of c)) True)
      (rewrite-with
        (lemma cb_cnt1)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h2 (= (lt (hcount_of c) 4294967296) True)
      (rewrite-with
        (lemma cb_cnthi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hlo (= (le 0 (hword c)) True)
      (rewrite-with
        (lemma hword_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hm (= (band (hword c) 4294967295) (mod (hword c) 4294967296))
      (rewrite-with
        (lemma mask_word32)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlo) lr lhs true ())) refl))
        refl))
    (have hdec
      (=
        (hword c)
        (+ (* 4294967296 (+ (htag_of c) (* 65536 (harity_of c)))) (hcount_of c)))
      (steps
        ((unfold hword lhs))
        (by arith (list (list 1 0 0 0 0 0) (list 1 0 0 0 0 0)))))
    (have hr0 (= (le 0 (hcount_of c)) True) (by arith (rows (goal 1) (h1 1))))
    (have hu (= (mod (hword c) 4294967296) (hcount_of c))
      (rewrite-with
        (lemma mod_unique)
        lr
        lhs
        ((inst q (+ (htag_of c) (* 65536 (harity_of c))))
         (inst r (hcount_of c)))
        ((steps ((rewrite (premise hdec) lr lhs true ())) refl)
         (steps ((rewrite (premise hr0) lr lhs true ())) refl)
         (steps ((rewrite (premise h2) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hm) lr lhs true ())
       (rewrite (premise hu) lr lhs true ()))
      refl)))

;; a live address is found: hfind is Some of hfget
(claim hfind_memb
  (goal ((cs (List HCell)) (v Int)) ((= (memb (haddrs cs) v) True))
    (= (hfind cs v) (Some (hfget cs v))))
  (induct cs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) v) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hg (= (hfget (Cons c rest) v) c)
                  (rewrite-with
                    (lemma hfget_cons_eq)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (hyp True) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hg) lr rhs true ())
                   (unfold hfind lhs)
                   (reduce lhs)
                   (rewrite (hyp True) lr lhs true ())
                   (reduce lhs))
                  refl)))
            (case False
              (chain
                (have hmt (= (memb (haddrs rest) v) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hg (= (hfget (Cons c rest) v) (hfget rest v))
                  (rewrite-with
                    (lemma hfget_cons_ne)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (hyp False) lr lhs true ())) refl))
                    refl))
                (have hih (= (hfind rest v) (Some (hfget rest v)))
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hg) lr rhs true ())
                   (unfold hfind lhs)
                   (reduce lhs)
                   (rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hih) lr lhs true ()))
                  refl))))))))))

;; a live cell carries its bands (cells_ok, at the found cell)
(claim hfget_bands
  (goal ((cs (List HCell)) (v Int))
    ((= (cells_ok cs) True) (= (memb (haddrs cs) v) True))
    (= (cbands (hfget cs v)) True))
  (induct cs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) v) True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hg (= (hfget (Cons c rest) v) c)
                  (rewrite-with
                    (lemma hfget_cons_eq)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (hyp True) lr lhs true ())) refl))
                    refl))
                (have hc1 (= (le 1 (hcount_of c)) True)
                  (rewrite-with
                    (lemma co_cnt1)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hchi (= (lt (hcount_of c) 4294967296) True)
                  (rewrite-with
                    (lemma co_cnthi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have ht0 (= (le 0 (htag_of c)) True)
                  (rewrite-with
                    (lemma co_tag0)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hthi (= (lt (htag_of c) 65536) True)
                  (rewrite-with
                    (lemma co_taghi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have ha0 (= (le 0 (harity_of c)) True)
                  (rewrite-with
                    (lemma co_ar0)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hahi (= (lt (harity_of c) 65536) True)
                  (rewrite-with
                    (lemma co_arhi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hg) lr lhs true ())
                   (unfold cbands lhs)
                   (rewrite (premise hc1) lr lhs true ())
                   (rewrite (premise hchi) lr lhs true ())
                   (rewrite (premise ht0) lr lhs true ())
                   (rewrite (premise hthi) lr lhs true ())
                   (rewrite (premise ha0) lr lhs true ())
                   (rewrite (premise hahi) lr lhs true ())
                   (compute lhs))
                  refl)))
            (case False
              (chain
                (have hmt (= (memb (haddrs rest) v) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hct (= (cells_ok rest) True)
                  (rewrite-with
                    (lemma co_tl)
                    lr
                    lhs
                    ((inst c c))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hg (= (hfget (Cons c rest) v) (hfget rest v))
                  (rewrite-with
                    (lemma hfget_cons_ne)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (hyp False) lr lhs true ())) refl))
                    refl))
                (have hih (= (cbands (hfget rest v)) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hct) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (steps
                  ((rewrite (premise hg) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ()))
                  refl))))))))))

;; --- the hincc algebra (hdecc's mirror) ---------------------------------------------
;; the address list, the extent list, and the inbound counts do not see
;; a count change; cells_ok survives one below the immortal band

(claim haddrs_hincc
  (goal ((cs (List HCell)) (w Int)) () (= (haddrs (hincc cs w)) (haddrs cs)))
  (induct cs
    ((case Nil (steps ((unfold hincc lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hih (= (haddrs (hincc rest w)) (haddrs rest))
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (case-on (int_eq (haddr_of c) w) Bool
           ((case True
              (case-on c HCell
                ((case MkHCell
                   (a cnt tg ar sl)
                   (chain
                     (have hac
                       (=
                         (haddr_of (with_hcount (+ (hcount_of c) 1) c))
                         (haddr_of c))
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute lhs)
                          (compute rhs))
                         refl))
                     (have hh
                       (=
                         (haddrs
                           (Cons (with_hcount (+ (hcount_of c) 1) c) rest))
                         (Cons
                           (haddr_of (with_hcount (+ (hcount_of c) 1) c))
                           (haddrs rest)))
                       (steps ((unfold haddrs lhs) (reduce lhs)) refl))
                     (have hr
                       (=
                         (haddrs (Cons c rest))
                         (Cons (haddr_of c) (haddrs rest)))
                       (steps ((unfold haddrs lhs) (reduce lhs)) refl))
                     (steps
                       ((unfold hincc lhs)
                        (reduce lhs)
                        (rewrite (hyp True) lr lhs true ())
                        (reduce lhs)
                        (rewrite (premise hh) lr lhs true ())
                        (rewrite (premise hac) lr lhs true ())
                        (rewrite (premise hr) lr rhs true ()))
                       refl))))))
            (case False
              (chain
                (have hh
                  (=
                    (haddrs (Cons c (hincc rest w)))
                    (Cons (haddr_of c) (haddrs (hincc rest w))))
                  (steps ((unfold haddrs lhs) (reduce lhs)) refl))
                (have hr
                  (= (haddrs (Cons c rest)) (Cons (haddr_of c) (haddrs rest)))
                  (steps ((unfold haddrs lhs) (reduce lhs)) refl))
                (steps
                  ((unfold hincc lhs)
                   (reduce lhs)
                   (rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hh) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (rewrite (premise hr) lr rhs true ()))
                  refl))))))))))

(claim hexts_hincc
  (goal ((cs (List HCell)) (w Int)) () (= (hexts (hincc cs w)) (hexts cs)))
  (induct cs
    ((case Nil (steps ((unfold hincc lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hih (= (hexts (hincc rest w)) (hexts rest))
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (case-on (int_eq (haddr_of c) w) Bool
           ((case True
              (case-on c HCell
                ((case MkHCell
                   (a cnt tg ar sl)
                   (chain
                     (have hac
                       (=
                         (haddr_of (with_hcount (+ (hcount_of c) 1) c))
                         (haddr_of c))
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute lhs)
                          (compute rhs))
                         refl))
                     (have har
                       (=
                         (harity_of (with_hcount (+ (hcount_of c) 1) c))
                         (harity_of c))
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute lhs)
                          (compute rhs))
                         refl))
                     (have hh
                       (=
                         (hexts (Cons (with_hcount (+ (hcount_of c) 1) c) rest))
                         (Cons
                           (Pair
                             (haddr_of (with_hcount (+ (hcount_of c) 1) c))
                             (harity_of (with_hcount (+ (hcount_of c) 1) c)))
                           (hexts rest)))
                       (steps ((unfold hexts lhs) (reduce lhs)) refl))
                     (have hr
                       (=
                         (hexts (Cons c rest))
                         (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
                       (steps ((unfold hexts lhs) (reduce lhs)) refl))
                     (steps
                       ((unfold hincc lhs)
                        (reduce lhs)
                        (rewrite (hyp True) lr lhs true ())
                        (reduce lhs)
                        (rewrite (premise hh) lr lhs true ())
                        (rewrite (premise hac) lr lhs true ())
                        (rewrite (premise har) lr lhs true ())
                        (rewrite (premise hr) lr rhs true ()))
                       refl))))))
            (case False
              (chain
                (have hh
                  (=
                    (hexts (Cons c (hincc rest w)))
                    (Cons
                      (Pair (haddr_of c) (harity_of c))
                      (hexts (hincc rest w))))
                  (steps ((unfold hexts lhs) (reduce lhs)) refl))
                (have hr
                  (=
                    (hexts (Cons c rest))
                    (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
                  (steps ((unfold hexts lhs) (reduce lhs)) refl))
                (steps
                  ((unfold hincc lhs)
                   (reduce lhs)
                   (rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hh) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (rewrite (premise hr) lr rhs true ()))
                  refl))))))))))

(claim inb_hincc
  (goal ((cs (List HCell)) (w Int) (a Int)) ()
    (= (inbound_cells (hincc cs w) a) (inbound_cells cs a)))
  (induct cs
    ((case Nil (steps ((unfold hincc lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hih (= (inbound_cells (hincc rest w) a) (inbound_cells rest a))
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hr
           (=
             (inbound_cells (Cons c rest) a)
             (+ (count_in (hslots_of c) a) (inbound_cells rest a)))
           (steps ((unfold inbound_cells lhs) (reduce lhs)) refl))
         (case-on (int_eq (haddr_of c) w) Bool
           ((case True
              (case-on c HCell
                ((case MkHCell
                   (ax cx tx rx sx)
                   (chain
                     (have hsl
                       (=
                         (hslots_of (with_hcount (+ (hcount_of c) 1) c))
                         (hslots_of c))
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute lhs)
                          (compute rhs))
                         refl))
                     (have hh
                       (=
                         (inbound_cells
                           (Cons (with_hcount (+ (hcount_of c) 1) c) rest)
                           a)
                         (+
                           (count_in
                             (hslots_of (with_hcount (+ (hcount_of c) 1) c))
                             a)
                           (inbound_cells rest a)))
                       (steps ((unfold inbound_cells lhs) (reduce lhs)) refl))
                     (steps
                       ((unfold hincc lhs)
                        (reduce lhs)
                        (rewrite (hyp True) lr lhs true ())
                        (reduce lhs)
                        (rewrite (premise hh) lr lhs true ())
                        (rewrite (premise hsl) lr lhs true ())
                        (rewrite (premise hr) lr rhs true ()))
                       refl))))))
            (case False
              (chain
                (have hh
                  (=
                    (inbound_cells (Cons c (hincc rest w)) a)
                    (+
                      (count_in (hslots_of c) a)
                      (inbound_cells (hincc rest w) a)))
                  (steps ((unfold inbound_cells lhs) (reduce lhs)) refl))
                (steps
                  ((unfold hincc lhs)
                   (reduce lhs)
                   (rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hh) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (rewrite (premise hr) lr rhs true ()))
                  refl))))))))))

(claim cells_ok_hincc
  (goal ((cs (List HCell)) (w Int))
    ((= (cells_ok cs) True)
     (= (memb (haddrs cs) w) True)
     (= (lt (hcount_of (hfget cs w)) 2147483648) True))
    (= (cells_ok (hincc cs w)) True))
  (induct cs
    ((case Nil
       (steps
         ((unfold hincc lhs) (reduce lhs) (rewrite (premise 0) lr lhs true ()))
         refl))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) w) True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (have htl (= (cells_ok rest) True)
           (rewrite-with
             (lemma co_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (case-on (int_eq (haddr_of c) w) Bool
           ((case True
              (chain
                (have hg (= (hfget (Cons c rest) w) c)
                  (steps
                    ((unfold hfget lhs)
                     (unfold hfind lhs)
                     (reduce lhs)
                     (rewrite (hyp True) lr lhs true ())
                     (reduce lhs))
                    refl))
                (have hb1 (= (lt (hcount_of c) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 2) lr lhs true ()))
                    refl))
                (case-on c HCell
                  ((case MkHCell
                     (ax cx tx rx sx)
                     (chain
                       (have hsl
                         (=
                           (hslots_of (with_hcount (+ (hcount_of c) 1) c))
                           (hslots_of c))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have hcn
                         (=
                           (hcount_of (with_hcount (+ (hcount_of c) 1) c))
                           (+ (hcount_of c) 1))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have htg
                         (=
                           (htag_of (with_hcount (+ (hcount_of c) 1) c))
                           (htag_of c))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have har
                         (=
                           (harity_of (with_hcount (+ (hcount_of c) 1) c))
                           (harity_of c))
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute lhs)
                            (compute rhs))
                           refl))
                       (have hso (= (slots_ok (hslots_of c) (haddrs rest)) True)
                         (rewrite-with
                           (lemma co_slots)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hlen
                         (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
                         (rewrite-with
                           (lemma co_len)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hchi (= (lt (hcount_of c) 4294967296) True)
                         (rewrite-with
                           (lemma co_cnthi)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have ht0 (= (le 0 (htag_of c)) True)
                         (rewrite-with
                           (lemma co_tag0)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hthi (= (lt (htag_of c) 65536) True)
                         (rewrite-with
                           (lemma co_taghi)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have ha0 (= (le 0 (harity_of c)) True)
                         (rewrite-with
                           (lemma co_ar0)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hahi (= (lt (harity_of c) 65536) True)
                         (rewrite-with
                           (lemma co_arhi)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hc1 (= (le 1 (hcount_of c)) True)
                         (rewrite-with
                           (lemma co_cnt1)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl))
                       (have hd1 (= (le 1 (+ (hcount_of c) 1)) True)
                         (by arith (rows (goal 1) (hc1 1))))
                       (have hdhi (= (lt (+ (hcount_of c) 1) 4294967296) True)
                         (by arith (rows (goal 1) (hb1 1))))
                       (steps
                         ((unfold hincc lhs)
                          (reduce lhs)
                          (rewrite (hyp 1) lr lhs true ())
                          (reduce lhs)
                          (unfold cells_ok lhs)
                          (reduce lhs)
                          (rewrite (premise hsl) lr lhs true ())
                          (rewrite (premise hcn) lr lhs true ())
                          (rewrite (premise htg) lr lhs true ())
                          (rewrite (premise har) lr lhs true ())
                          (rewrite (premise hso) lr lhs true ())
                          (rewrite (premise hlen) lr lhs true ())
                          (rewrite (premise hd1) lr lhs true ())
                          (rewrite (premise hdhi) lr lhs true ())
                          (rewrite (premise ht0) lr lhs true ())
                          (rewrite (premise hthi) lr lhs true ())
                          (rewrite (premise ha0) lr lhs true ())
                          (rewrite (premise hahi) lr lhs true ())
                          (rewrite (premise htl) lr lhs true ())
                          (compute lhs))
                         refl)))))))
            (case False
              (chain
                (have hmt (= (memb (haddrs rest) w) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hg (= (hfget (Cons c rest) w) (hfget rest w))
                  (steps
                    ((unfold hfget lhs)
                     (unfold hfind lhs)
                     (reduce lhs)
                     (rewrite (hyp False) lr lhs true ())
                     (reduce lhs)
                     (unfold hfget rhs)
                     (reduce rhs))
                    refl))
                (have hp2 (= (lt (hcount_of (hfget rest w)) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 2) lr lhs true ()))
                    refl))
                (have hih (= (cells_ok (hincc rest w)) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ((inst w w))
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hp2) lr lhs true ())) refl))
                    refl))
                (have hso (= (slots_ok (hslots_of c) (haddrs rest)) True)
                  (rewrite-with
                    (lemma co_slots)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hsog
                  (= (slots_ok (hslots_of c) (haddrs (hincc rest w))) True)
                  (steps
                    ((rewrite (lemma haddrs_hincc) lr lhs true ())
                     (rewrite (premise hso) lr lhs true ()))
                    refl))
                (have hlen (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
                  (rewrite-with
                    (lemma co_len)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hc1 (= (le 1 (hcount_of c)) True)
                  (rewrite-with
                    (lemma co_cnt1)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hchi (= (lt (hcount_of c) 4294967296) True)
                  (rewrite-with
                    (lemma co_cnthi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have ht0 (= (le 0 (htag_of c)) True)
                  (rewrite-with
                    (lemma co_tag0)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hthi (= (lt (htag_of c) 65536) True)
                  (rewrite-with
                    (lemma co_taghi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have ha0 (= (le 0 (harity_of c)) True)
                  (rewrite-with
                    (lemma co_ar0)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (have hahi (= (lt (harity_of c) 65536) True)
                  (rewrite-with
                    (lemma co_arhi)
                    lr
                    lhs
                    ((inst rest rest))
                    ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((unfold hincc lhs)
                   (reduce lhs)
                   (rewrite (hyp False) lr lhs true ())
                   (reduce lhs)
                   (unfold cells_ok lhs)
                   (reduce lhs)
                   (rewrite (premise hsog) lr lhs true ())
                   (rewrite (premise hlen) lr lhs true ())
                   (rewrite (premise hc1) lr lhs true ())
                   (rewrite (premise hchi) lr lhs true ())
                   (rewrite (premise ht0) lr lhs true ())
                   (rewrite (premise hthi) lr lhs true ())
                   (rewrite (premise ha0) lr lhs true ())
                   (rewrite (premise hahi) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))

;; --- THE LIVE CELL'S BUNDLE ------------------------------------------------------
;; hinv + membership give every fact a header store at a live address
;; needs: bracket, alignment, uniqueness, the live family's disjointness,
;; disjointness from the free cells and the raw cell, the bands

(claim live_facts
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (memb (haddrs (gcells_of g)) v) True))
    (= (live_ok g v) True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hgc (= (gcells_of g) gc)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf (= (gfree_of g) gf)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgr (= (graw_of g) gr)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hmg (= (memb (haddrs gc) v) True)
           (steps
             ((rewrite (premise hgc) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (have hx1
           (=
             (ext_all g)
             (fexts_app (hexts gc) (fexts_app (fexts gf 0) (rexts gr))))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app rexts)))
             refl))
         (have hdj (= (e_disj (ext_all g)) True)
           (rewrite-with
             (lemma hi_disj)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbk (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_brk)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have hmc (= (emem (hexts gc) v (harity_of (hfget gc v))) True)
           (rewrite-with
             (lemma hfget_hexts)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hmg) lr lhs true ())) refl))
             refl))
         (have hm2
           (=
             (emem
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) (rexts gr)))
               v
               (harity_of (hfget gc v)))
             True)
           (rewrite-with
             (lemma emem_app_l)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hmc) lr lhs true ())) refl))
             refl))
         (have hmem (= (emem (ext_all g) v (harity_of (hfget gc v))) True)
           (steps
             ((rewrite (premise hx1) lr lhs true ())
              (rewrite (premise hm2) lr lhs true ()))
             refl))
         (have hbm
           (=
             (andb
               (le (glo_of g) v)
               (andb
                 (le (+ v (+ 8 (* 8 (harity_of (hfget gc v))))) (gtop_of g))
                 (andb (int_eq (mod v 8) 0) (le 0 (harity_of (hfget gc v))))))
             True)
           (rewrite-with
             (lemma ebm)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hbk) lr lhs true ())) refl)
              (steps ((rewrite (premise hmem) lr lhs true ())) refl))
             refl))
         (have c1 (= (le (glo_of g) v) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst
                b
                (andb
                  (le (+ v (+ 8 (* 8 (harity_of (hfget gc v))))) (gtop_of g))
                  (andb (int_eq (mod v 8) 0) (le 0 (harity_of (hfget gc v)))))))
             ((steps ((rewrite (premise hbm) lr lhs true ())) refl))
             refl))
         (have hbm2
           (=
             (andb
               (le (+ v (+ 8 (* 8 (harity_of (hfget gc v))))) (gtop_of g))
               (andb (int_eq (mod v 8) 0) (le 0 (harity_of (hfget gc v)))))
             True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (le (glo_of g) v)))
             ((steps ((rewrite (premise hbm) lr lhs true ())) refl))
             refl))
         (have c2g
           (= (le (+ v (+ 8 (* 8 (harity_of (hfget gc v))))) (gtop_of g)) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst
                b
                (andb (int_eq (mod v 8) 0) (le 0 (harity_of (hfget gc v))))))
             ((steps ((rewrite (premise hbm2) lr lhs true ())) refl))
             refl))
         (have c2
           (=
             (le
               (+ v (+ 8 (* 8 (harity_of (hfget (gcells_of g) v)))))
               (gtop_of g))
             True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise c2g) lr lhs true ()))
             refl))
         (have hbm3
           (= (andb (int_eq (mod v 8) 0) (le 0 (harity_of (hfget gc v)))) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst
                a
                (le (+ v (+ 8 (* 8 (harity_of (hfget gc v))))) (gtop_of g))))
             ((steps ((rewrite (premise hbm2) lr lhs true ())) refl))
             refl))
         (have c3 (= (int_eq (mod v 8) 0) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (le 0 (harity_of (hfget gc v)))))
             ((steps ((rewrite (premise hbm3) lr lhs true ())) refl))
             refl))
         (have han (= (anodup (e_addrs (ext_all g))) True)
           (rewrite-with
             (lemma ed_nodup)
             lr
             lhs
             ((inst lo (glo_of g)) (inst top (gtop_of g)))
             ((steps ((rewrite (premise hdj) lr lhs true ())) refl)
              (steps ((rewrite (premise hbk) lr lhs true ())) refl))
             refl))
         (have hea1
           (=
             (e_addrs (ext_all g))
             (iapp (haddrs gc) (iapp (faddrs gf) (e_addrs (rexts gr)))))
           (steps
             ((rewrite (premise hx1) lr lhs true ())
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma hexts_eaddrs) lr lhs true ())
              (rewrite (lemma fexts_addrs) lr lhs true ()))
             refl))
         (have han1
           (=
             (anodup (iapp (haddrs gc) (iapp (faddrs gf) (e_addrs (rexts gr)))))
             True)
           (steps
             ((rewrite (premise hea1) rl lhs true ())
              (rewrite (premise han) lr lhs true ()))
             refl))
         (have hc1
           (=
             (le
               (count_in
                 (iapp (haddrs gc) (iapp (faddrs gf) (e_addrs (rexts gr))))
                 v)
               1)
             True)
           (rewrite-with
             (lemma an_cin1)
             lr
             lhs
             ()
             ((steps ((rewrite (premise han1) lr lhs true ())) refl))
             refl))
         (have hc2
           (=
             (count_in
               (iapp (haddrs gc) (iapp (faddrs gf) (e_addrs (rexts gr))))
               v)
             (+
               (count_in (haddrs gc) v)
               (count_in (iapp (faddrs gf) (e_addrs (rexts gr))) v)))
           (rewrite-with (lemma cin_iapp) lr lhs () () refl))
         (have hc3
           (=
             (count_in (iapp (faddrs gf) (e_addrs (rexts gr))) v)
             (+ (count_in (faddrs gf) v) (count_in (e_addrs (rexts gr)) v)))
           (rewrite-with (lemma cin_iapp) lr lhs () () refl))
         (have hmp (= (le 1 (count_in (haddrs gc) v)) True)
           (rewrite-with
             (lemma memb_cin_pos)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hmg) lr lhs true ())) refl))
             refl))
         (have hn2 (= (le 0 (count_in (faddrs gf) v)) True)
           (rewrite-with (lemma cin_nonneg) lr lhs () () refl))
         (have hn3 (= (le 0 (count_in (e_addrs (rexts gr)) v)) True)
           (rewrite-with (lemma cin_nonneg) lr lhs () () refl))
         (have c4g (= (le (count_in (haddrs gc) v) 1) True)
           (by arith (rows (goal 1) (hc1 1) (hc2 1) (hc3 1) (hn2 1) (hn3 1))))
         (have c4 (= (le (count_in (haddrs (gcells_of g)) v) 1) True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise c4g) lr lhs true ()))
             refl))
         (have hf0l (= (le (count_in (faddrs gf) v) 0) True)
           (by arith (rows (goal 1) (hc1 1) (hc2 1) (hc3 1) (hmp 1) (hn3 1))))
         (have hf0b (= (int_eq (count_in (faddrs gf) v) 0) True)
           (rewrite-with
             (lemma ieq_of_le2)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hf0l) lr lhs true ())) refl)
              (steps ((rewrite (premise hn2) lr lhs true ())) refl))
             refl))
         (have hf0 (= (count_in (faddrs gf) v) 0)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 0))
             ((steps ((rewrite (premise hf0b) lr lhs true ())) refl))
             refl))
         (have hcz2 (= (count_in (e_addrs (fexts gf 0)) v) 0)
           (steps
             ((rewrite (lemma fexts_addrs) lr lhs true ())
              (rewrite (premise hf0) lr lhs true ()))
             refl))
         (have hr0l (= (le (count_in (e_addrs (rexts gr)) v) 0) True)
           (by arith (rows (goal 1) (hc1 1) (hc2 1) (hc3 1) (hmp 1) (hn2 1))))
         (have hr0b (= (int_eq (count_in (e_addrs (rexts gr)) v) 0) True)
           (rewrite-with
             (lemma ieq_of_le2)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hr0l) lr lhs true ())) refl)
              (steps ((rewrite (premise hn3) lr lhs true ())) refl))
             refl))
         (have hcz3 (= (count_in (e_addrs (rexts gr)) v) 0)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 0))
             ((steps ((rewrite (premise hr0b) lr lhs true ())) refl))
             refl))
         (have hf1 (= (eall (fexts gf 0) (fexts gf 0)) True)
           (rewrite-with (lemma eall_refl) lr lhs () () refl))
         (have hf2
           (= (eall (fexts gf 0) (fexts_app (fexts gf 0) (rexts gr))) True)
           (rewrite-with
             (lemma eall_appr_mono)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hf1) lr lhs true ())) refl))
             refl))
         (have hf3
           (=
             (eall
               (fexts gf 0)
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) (rexts gr))))
             True)
           (rewrite-with
             (lemma eall_appl_mono)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hf2) lr lhs true ())) refl))
             refl))
         (have hf3g (= (eall (fexts gf 0) (ext_all g)) True)
           (steps
             ((rewrite (premise hx1) lr lhs true ())
              (rewrite (premise hf3) lr lhs true ()))
             refl))
         (have hr1 (= (eall (rexts gr) (rexts gr)) True)
           (rewrite-with (lemma eall_refl) lr lhs () () refl))
         (have hr2
           (= (eall (rexts gr) (fexts_app (fexts gf 0) (rexts gr))) True)
           (rewrite-with
             (lemma eall_appl_mono)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hr1) lr lhs true ())) refl))
             refl))
         (have hr3
           (=
             (eall
               (rexts gr)
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) (rexts gr))))
             True)
           (rewrite-with
             (lemma eall_appl_mono)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hr2) lr lhs true ())) refl))
             refl))
         (have hr3g (= (eall (rexts gr) (ext_all g)) True)
           (steps
             ((rewrite (premise hx1) lr lhs true ())
              (rewrite (premise hr3) lr lhs true ()))
             refl))
         (have hdj2
           (=
             (e_disj (fexts_app (hexts gc) (fexts_app (fexts gf 0) (rexts gr))))
             True)
           (steps
             ((rewrite (premise hx1) rl lhs true ())
              (rewrite (premise hdj) lr lhs true ()))
             refl))
         (have c5g (= (e_disj (hexts gc)) True)
           (rewrite-with
             (lemma edisj_app_l)
             lr
             lhs
             ((inst B (fexts_app (fexts gf 0) (rexts gr))))
             ((steps ((rewrite (premise hdj2) lr lhs true ())) refl))
             refl))
         (have c5 (= (e_disj (hexts (gcells_of g))) True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise c5g) lr lhs true ()))
             refl))
         (have c6g (= (e_disj1 v (harity_of (hfget gc v)) (fexts gf 0)) True)
           (rewrite-with
             (lemma ed1_intro)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hf3g) lr lhs true ())) refl)
              (steps ((rewrite (premise hcz2) lr lhs true ())) refl)
              (steps ((rewrite (premise hmem) lr lhs true ())) refl)
              (steps ((rewrite (premise hdj) lr lhs true ())) refl))
             refl))
         (have c6
           (=
             (e_disj1
               v
               (harity_of (hfget (gcells_of g) v))
               (fexts (gfree_of g) 0))
             True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise hgf) lr lhs true ())
              (rewrite (premise c6g) lr lhs true ()))
             refl))
         (have c7g (= (e_disj1 v (harity_of (hfget gc v)) (rexts gr)) True)
           (rewrite-with
             (lemma ed1_intro)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hr3g) lr lhs true ())) refl)
              (steps ((rewrite (premise hcz3) lr lhs true ())) refl)
              (steps ((rewrite (premise hmem) lr lhs true ())) refl)
              (steps ((rewrite (premise hdj) lr lhs true ())) refl))
             refl))
         (have c7
           (=
             (e_disj1 v (harity_of (hfget (gcells_of g) v)) (rexts (graw_of g)))
             True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (rewrite (premise c7g) lr lhs true ()))
             refl))
         (have c8g (= (cbands (hfget gc v)) True)
           (rewrite-with
             (lemma hfget_bands)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((rewrite (premise hmg) lr lhs true ())) refl))
             refl))
         (have c8 (= (cbands (hfget (gcells_of g) v)) True)
           (steps
             ((rewrite (premise hgc) lr lhs true ())
              (rewrite (premise c8g) lr lhs true ()))
             refl))
         (steps
           ((unfold live_ok lhs)
            (reduce lhs)
            (rewrite (premise c1) lr lhs true ())
            (rewrite (premise c2) lr lhs true ())
            (rewrite (premise c3) lr lhs true ())
            (rewrite (premise c4) lr lhs true ())
            (rewrite (premise c5) lr lhs true ())
            (rewrite (premise c6) lr lhs true ())
            (rewrite (premise c7) lr lhs true ())
            (rewrite (premise c8) lr lhs true ())
            (compute lhs))
           refl))))))

;; --- rt_inc's pure laws (C2b-4 part ii) ---------------------------------------------
;; THE DURABLE PRODUCT: a header store at a live address keeps hcells_rep
;; for the incremented ghost — the cell at v re-reads its new word with
;; its slots framed; every other cell is framed through e_disj (hexts cs)

(claim hcells_rep_incc
  (goal ((m Mem) (cs (List HCell)) (v Int) (w Int))
    ((= (hcells_rep m cs) True)
     (= (cells_ok cs) True)
     (= (e_disj (hexts cs)) True)
     (= (memb (haddrs cs) v) True)
     (= w (+ (hword (hfget cs v)) 1))
     (= (lt (hcount_of (hfget cs v)) 2147483648) True))
    (= (hcells_rep (store_le (iw8) m v w) (hincc cs v)) True))
  (induct cs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) v) True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (have hhd (= (hcell_rep m c) True)
           (rewrite-with
             (lemma hcs_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (hcells_rep m rest) True)
           (rewrite-with
             (lemma hcs_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcot (= (cells_ok rest) True)
           (rewrite-with
             (lemma co_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hlen (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
           (rewrite-with
             (lemma co_len)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hc1 (= (le 1 (hcount_of c)) True)
           (rewrite-with
             (lemma co_cnt1)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ht0 (= (le 0 (htag_of c)) True)
           (rewrite-with
             (lemma co_tag0)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hthi (= (lt (htag_of c) 65536) True)
           (rewrite-with
             (lemma co_taghi)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ha0 (= (le 0 (harity_of c)) True)
           (rewrite-with
             (lemma co_ar0)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hahi (= (lt (harity_of c) 65536) True)
           (rewrite-with
             (lemma co_arhi)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hex
           (=
             (hexts (Cons c rest))
             (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
           (steps ((unfold hexts lhs) (reduce lhs)) refl))
         (have hdx
           (=
             (e_disj (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
             True)
           (steps
             ((rewrite (premise hex) rl lhs true ())
              (rewrite (premise 2) lr lhs true ()))
             refl))
         (have hd1 (= (e_disj1 (haddr_of c) (harity_of c) (hexts rest)) True)
           (rewrite-with
             (lemma ed_hd)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hdt (= (e_disj (hexts rest)) True)
           (rewrite-with
             (lemma ed_tl)
             lr
             lhs
             ((inst a (haddr_of c)) (inst n (harity_of c)))
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hsl (= (hslots_rep m (+ (haddr_of c) 8) (hslots_of c)) True)
           (rewrite-with
             (lemma hc_slots)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hhd) lr lhs true ())) refl))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hT (= (int_eq (haddr_of c) v) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hg (= (hfget (Cons c rest) v) c)
                  (rewrite-with
                    (lemma hfget_cons_eq)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hca (= (haddr_of c) v)
                  (rewrite-with
                    (lemma int_eq_eq)
                    lr
                    lhs
                    ((inst b v))
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hw (= w (+ (hword c) 1))
                  (steps
                    ((rewrite (premise 4) lr lhs true ())
                     (rewrite (premise hg) lr lhs true ()))
                    refl))
                (have hlt (= (lt (hcount_of c) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 5) lr lhs true ()))
                    refl))
                (have hwe
                  (=
                    (hword c)
                    (+
                      (hcount_of c)
                      (+
                        (* (htag_of c) 4294967296)
                        (* (harity_of c) 281474976710656))))
                  (steps ((unfold hword lhs)) refl))
                (have hwlo (= (le 0 w) True)
                  (by
                    arith
                    (rows
                      (goal 1)
                      (hw 1)
                      (hwe 1)
                      (hc1 1)
                      (ht0 4294967296)
                      (ha0 281474976710656))))
                (have hwhi (= (lt w 18446744073709551616) True)
                  (by
                    arith
                    (rows
                      (goal 1)
                      (hw -1)
                      (hwe -1)
                      (hlt 1)
                      (hthi 4294967296)
                      (hahi 281474976710656))))
                (have hrest (= (hcells_rep (store_le (iw8) m v w) rest) True)
                  (chain
                    (have hd1v (= (e_disj1 v (harity_of c) (hexts rest)) True)
                      (steps
                        ((rewrite (premise hca) rl lhs true ())
                         (rewrite (premise hd1) lr lhs true ()))
                        refl))
                    (rewrite-with
                      (lemma hcells_rep_fr)
                      lr
                      lhs
                      ((inst nb (harity_of c)))
                      ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                       (steps ((rewrite (premise hd1v) lr lhs true ())) refl)
                       (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                       (steps ((rewrite (premise ha0) lr lhs true ())) refl))
                      refl)))
                (have hld (= (load_le (iw8) (store_le (iw8) m v w) v) w)
                  (rewrite-with
                    (lemma ls8w)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hwlo) lr lhs true ())) refl)
                     (steps ((rewrite (premise hwhi) lr lhs true ())) refl))
                    refl))
                (case-on c HCell
                  ((case MkHCell
                     (ax cx tx rx sx)
                     (chain
                       (have hax (= ax v)
                         (steps
                           ((rewrite (premise hca) rl rhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute rhs))
                           refl))
                       (have hwL (= w (hword (MkHCell v (+ cx 1) tx rx sx)))
                         (steps
                           ((rewrite (premise hw) lr lhs true ())
                            (rewrite (hyp 0) lr lhs true ())
                            (unfold hword lhs)
                            (unfold hword rhs)
                            (compute lhs)
                            (compute rhs))
                           (by arith (list (list 1) (list 1)))))
                       (have hslL (= (hslots_rep m (+ v 8) sx) True)
                         (steps
                           ((rewrite (premise hax) rl lhs true ())
                            (rewrite (premise hsl) rl rhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute rhs (stop hslots_rep)))
                           refl))
                       (have hor
                         (=
                           (orb
                             (le (+ v 8) (+ v 8))
                             (le (+ (+ v 8) (* 8 (ilen sx))) v))
                           True)
                         (rewrite-with
                           (lemma orb_intro_l)
                           lr
                           lhs
                           ()
                           ((by arith (rows (goal 1))))
                           refl))
                       (have hsl2
                         (= (hslots_rep (store_le (iw8) m v w) (+ v 8) sx) True)
                         (rewrite-with
                           (lemma hslots_rep_fr)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hslL) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hor) lr lhs true ()))
                              refl))
                           refl))
                       (have hnew
                         (=
                           (hcell_rep
                             (store_le (iw8) m v w)
                             (MkHCell v (+ cx 1) tx rx sx))
                           True)
                         (steps
                           ((unfold hcell_rep lhs)
                            (compute
                              lhs
                              (stop iw8 load_le store_le hslots_rep hword))
                            (rewrite (premise hld) lr lhs true ())
                            (rewrite (premise hwL) rl lhs true ())
                            (rewrite (lemma int_eq_refl) lr lhs true ())
                            (rewrite (premise hsl2) lr lhs true ())
                            (compute lhs))
                           refl))
                       (steps
                         ((unfold hincc lhs)
                          (reduce lhs)
                          (rewrite (premise hT) lr lhs true ())
                          (reduce lhs)
                          (rewrite (hyp 0) lr lhs true ())
                          (compute
                            lhs
                            (stop iw8 load_le store_le hcells_rep hslots_rep
                              hword))
                          (unfold hcells_rep lhs)
                          (reduce lhs)
                          (rewrite (premise hax) lr lhs true ())
                          (rewrite (premise hnew) lr lhs true ())
                          (rewrite (premise hrest) lr lhs true ())
                          (compute lhs))
                         refl)))))))
            (case False
              (chain
                (have hF (= (int_eq (haddr_of c) v) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hg (= (hfget (Cons c rest) v) (hfget rest v))
                  (rewrite-with
                    (lemma hfget_cons_ne)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hF) lr lhs true ())) refl))
                    refl))
                (have hmt (= (memb (haddrs rest) v) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (premise hF) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hw4 (= w (+ (hword (hfget rest v)) 1))
                  (steps
                    ((rewrite (premise 4) lr lhs true ())
                     (rewrite (premise hg) lr lhs true ()))
                    refl))
                (have hlt (= (lt (hcount_of (hfget rest v)) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 5) lr lhs true ()))
                    refl))
                (have hih
                  (= (hcells_rep (store_le (iw8) m v w) (hincc rest v)) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hdt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hw4) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlt) lr lhs true ())) refl))
                    refl))
                (have hcbr (= (cbands (hfget rest v)) True)
                  (rewrite-with
                    (lemma hfget_bands)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hn0 (= (le 0 (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma cb_ar0)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcbr) lr lhs true ())) refl))
                    refl))
                (have hmx
                  (= (emem (hexts rest) v (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma hfget_hexts)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hd2
                  (=
                    (e_disj2
                      (haddr_of c)
                      (harity_of c)
                      v
                      (harity_of (hfget rest v)))
                    True)
                  (rewrite-with
                    (lemma ed1_memb)
                    lr
                    lhs
                    ((inst es (hexts rest)))
                    ((steps ((rewrite (premise hd1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmx) lr lhs true ())) refl))
                    refl))
                (have hd2s
                  (=
                    (e_disj2
                      v
                      (harity_of (hfget rest v))
                      (haddr_of c)
                      (harity_of c))
                    True)
                  (rewrite-with
                    (lemma ed2_sym)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hd2) lr lhs true ())) refl))
                    refl))
                (have hhd2 (= (hcell_rep (store_le (iw8) m v w) c) True)
                  (rewrite-with
                    (lemma hcell_rep_fr)
                    lr
                    lhs
                    ((inst nb (harity_of (hfget rest v))))
                    ((steps ((rewrite (premise hhd) lr lhs true ())) refl)
                     (steps ((rewrite (premise hd2s) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlen) lr lhs true ())) refl)
                     (steps ((rewrite (premise hn0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((unfold hincc lhs)
                   (reduce lhs)
                   (rewrite (premise hF) lr lhs true ())
                   (reduce lhs)
                   (unfold hcells_rep lhs)
                   (reduce lhs)
                   (rewrite (premise hhd2) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))

;; THE MIRROR (C2b-5 part i): a header store of hword − 1 at a live address
;; keeps hcells_rep for the decremented ghost — hcells_rep_incc's text with
;; the sign flipped (0 ≤ w needs count ≥ 1, cells_ok's own band)
(claim hcells_rep_decc
  (goal ((m Mem) (cs (List HCell)) (v Int) (w Int))
    ((= (hcells_rep m cs) True)
     (= (cells_ok cs) True)
     (= (e_disj (hexts cs)) True)
     (= (memb (haddrs cs) v) True)
     (= w (- (hword (hfget cs v)) 1))
     (= (lt (hcount_of (hfget cs v)) 2147483648) True))
    (= (hcells_rep (store_le (iw8) m v w) (hdecc cs v)) True))
  (induct cs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) v) True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (have hhd (= (hcell_rep m c) True)
           (rewrite-with
             (lemma hcs_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (hcells_rep m rest) True)
           (rewrite-with
             (lemma hcs_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcot (= (cells_ok rest) True)
           (rewrite-with
             (lemma co_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hlen (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
           (rewrite-with
             (lemma co_len)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hc1 (= (le 1 (hcount_of c)) True)
           (rewrite-with
             (lemma co_cnt1)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ht0 (= (le 0 (htag_of c)) True)
           (rewrite-with
             (lemma co_tag0)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hthi (= (lt (htag_of c) 65536) True)
           (rewrite-with
             (lemma co_taghi)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ha0 (= (le 0 (harity_of c)) True)
           (rewrite-with
             (lemma co_ar0)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hahi (= (lt (harity_of c) 65536) True)
           (rewrite-with
             (lemma co_arhi)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hex
           (=
             (hexts (Cons c rest))
             (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
           (steps ((unfold hexts lhs) (reduce lhs)) refl))
         (have hdx
           (=
             (e_disj (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
             True)
           (steps
             ((rewrite (premise hex) rl lhs true ())
              (rewrite (premise 2) lr lhs true ()))
             refl))
         (have hd1 (= (e_disj1 (haddr_of c) (harity_of c) (hexts rest)) True)
           (rewrite-with
             (lemma ed_hd)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hdt (= (e_disj (hexts rest)) True)
           (rewrite-with
             (lemma ed_tl)
             lr
             lhs
             ((inst a (haddr_of c)) (inst n (harity_of c)))
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hsl (= (hslots_rep m (+ (haddr_of c) 8) (hslots_of c)) True)
           (rewrite-with
             (lemma hc_slots)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hhd) lr lhs true ())) refl))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hT (= (int_eq (haddr_of c) v) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hg (= (hfget (Cons c rest) v) c)
                  (rewrite-with
                    (lemma hfget_cons_eq)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hca (= (haddr_of c) v)
                  (rewrite-with
                    (lemma int_eq_eq)
                    lr
                    lhs
                    ((inst b v))
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hw (= w (- (hword c) 1))
                  (steps
                    ((rewrite (premise 4) lr lhs true ())
                     (rewrite (premise hg) lr lhs true ()))
                    refl))
                (have hlt (= (lt (hcount_of c) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 5) lr lhs true ()))
                    refl))
                (have hwe
                  (=
                    (hword c)
                    (+
                      (hcount_of c)
                      (+
                        (* (htag_of c) 4294967296)
                        (* (harity_of c) 281474976710656))))
                  (steps ((unfold hword lhs)) refl))
                (have hwlo (= (le 0 w) True)
                  (by
                    arith
                    (rows
                      (goal 1)
                      (hw 1)
                      (hwe 1)
                      (hc1 1)
                      (ht0 4294967296)
                      (ha0 281474976710656))))
                (have hwhi (= (lt w 18446744073709551616) True)
                  (by
                    arith
                    (rows
                      (goal 1)
                      (hw -1)
                      (hwe -1)
                      (hlt 1)
                      (hthi 4294967296)
                      (hahi 281474976710656))))
                (have hrest (= (hcells_rep (store_le (iw8) m v w) rest) True)
                  (chain
                    (have hd1v (= (e_disj1 v (harity_of c) (hexts rest)) True)
                      (steps
                        ((rewrite (premise hca) rl lhs true ())
                         (rewrite (premise hd1) lr lhs true ()))
                        refl))
                    (rewrite-with
                      (lemma hcells_rep_fr)
                      lr
                      lhs
                      ((inst nb (harity_of c)))
                      ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                       (steps ((rewrite (premise hd1v) lr lhs true ())) refl)
                       (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                       (steps ((rewrite (premise ha0) lr lhs true ())) refl))
                      refl)))
                (have hld (= (load_le (iw8) (store_le (iw8) m v w) v) w)
                  (rewrite-with
                    (lemma ls8w)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hwlo) lr lhs true ())) refl)
                     (steps ((rewrite (premise hwhi) lr lhs true ())) refl))
                    refl))
                (case-on c HCell
                  ((case MkHCell
                     (ax cx tx rx sx)
                     (chain
                       (have hax (= ax v)
                         (steps
                           ((rewrite (premise hca) rl rhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute rhs))
                           refl))
                       (have hwL (= w (hword (MkHCell v (- cx 1) tx rx sx)))
                         (steps
                           ((rewrite (premise hw) lr lhs true ())
                            (rewrite (hyp 0) lr lhs true ())
                            (unfold hword lhs)
                            (unfold hword rhs)
                            (compute lhs)
                            (compute rhs))
                           (by arith (list (list 1) (list 1)))))
                       (have hslL (= (hslots_rep m (+ v 8) sx) True)
                         (steps
                           ((rewrite (premise hax) rl lhs true ())
                            (rewrite (premise hsl) rl rhs true ())
                            (rewrite (hyp 0) lr rhs true ())
                            (compute rhs (stop hslots_rep)))
                           refl))
                       (have hor
                         (=
                           (orb
                             (le (+ v 8) (+ v 8))
                             (le (+ (+ v 8) (* 8 (ilen sx))) v))
                           True)
                         (rewrite-with
                           (lemma orb_intro_l)
                           lr
                           lhs
                           ()
                           ((by arith (rows (goal 1))))
                           refl))
                       (have hsl2
                         (= (hslots_rep (store_le (iw8) m v w) (+ v 8) sx) True)
                         (rewrite-with
                           (lemma hslots_rep_fr)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hslL) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hor) lr lhs true ()))
                              refl))
                           refl))
                       (have hnew
                         (=
                           (hcell_rep
                             (store_le (iw8) m v w)
                             (MkHCell v (- cx 1) tx rx sx))
                           True)
                         (steps
                           ((unfold hcell_rep lhs)
                            (compute
                              lhs
                              (stop iw8 load_le store_le hslots_rep hword))
                            (rewrite (premise hld) lr lhs true ())
                            (rewrite (premise hwL) rl lhs true ())
                            (rewrite (lemma int_eq_refl) lr lhs true ())
                            (rewrite (premise hsl2) lr lhs true ())
                            (compute lhs))
                           refl))
                       (steps
                         ((unfold hdecc lhs)
                          (reduce lhs)
                          (rewrite (premise hT) lr lhs true ())
                          (reduce lhs)
                          (rewrite (hyp 0) lr lhs true ())
                          (compute
                            lhs
                            (stop iw8 load_le store_le hcells_rep hslots_rep
                              hword))
                          (unfold hcells_rep lhs)
                          (reduce lhs)
                          (rewrite (premise hax) lr lhs true ())
                          (rewrite (premise hnew) lr lhs true ())
                          (rewrite (premise hrest) lr lhs true ())
                          (compute lhs))
                         refl)))))))
            (case False
              (chain
                (have hF (= (int_eq (haddr_of c) v) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hg (= (hfget (Cons c rest) v) (hfget rest v))
                  (rewrite-with
                    (lemma hfget_cons_ne)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hF) lr lhs true ())) refl))
                    refl))
                (have hmt (= (memb (haddrs rest) v) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (premise hF) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hw4 (= w (- (hword (hfget rest v)) 1))
                  (steps
                    ((rewrite (premise 4) lr lhs true ())
                     (rewrite (premise hg) lr lhs true ()))
                    refl))
                (have hlt (= (lt (hcount_of (hfget rest v)) 2147483648) True)
                  (steps
                    ((rewrite (premise hg) rl lhs true ())
                     (rewrite (premise 5) lr lhs true ()))
                    refl))
                (have hih
                  (= (hcells_rep (store_le (iw8) m v w) (hdecc rest v)) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hdt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hw4) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlt) lr lhs true ())) refl))
                    refl))
                (have hcbr (= (cbands (hfget rest v)) True)
                  (rewrite-with
                    (lemma hfget_bands)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hn0 (= (le 0 (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma cb_ar0)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcbr) lr lhs true ())) refl))
                    refl))
                (have hmx
                  (= (emem (hexts rest) v (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma hfget_hexts)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hd2
                  (=
                    (e_disj2
                      (haddr_of c)
                      (harity_of c)
                      v
                      (harity_of (hfget rest v)))
                    True)
                  (rewrite-with
                    (lemma ed1_memb)
                    lr
                    lhs
                    ((inst es (hexts rest)))
                    ((steps ((rewrite (premise hd1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmx) lr lhs true ())) refl))
                    refl))
                (have hd2s
                  (=
                    (e_disj2
                      v
                      (harity_of (hfget rest v))
                      (haddr_of c)
                      (harity_of c))
                    True)
                  (rewrite-with
                    (lemma ed2_sym)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hd2) lr lhs true ())) refl))
                    refl))
                (have hhd2 (= (hcell_rep (store_le (iw8) m v w) c) True)
                  (rewrite-with
                    (lemma hcell_rep_fr)
                    lr
                    lhs
                    ((inst nb (harity_of (hfget rest v))))
                    ((steps ((rewrite (premise hhd) lr lhs true ())) refl)
                     (steps ((rewrite (premise hd2s) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlen) lr lhs true ())) refl)
                     (steps ((rewrite (premise hn0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((unfold hdecc lhs)
                   (reduce lhs)
                   (rewrite (premise hF) lr lhs true ())
                   (reduce lhs)
                   (unfold hcells_rep lhs)
                   (reduce lhs)
                   (rewrite (premise hhd2) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))


;; --- the worklist representation's laws (C2b-5 part ii-a) ----------------------------
(claim hwr_hd
  (goal ((m Mem) (c HCell) (rest (List HCell)))
    ((= (hwl_rep m (Cons c rest)) True))
    (= (hcell_rep m (wl_link c rest)) True))
  (chain
    (have h0 (= (andb (hcell_rep m (wl_link c rest)) (hwl_rep m rest)) True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold hwl_rep rhs) (reduce rhs))
        refl))
    (have hx (= (hcell_rep m (wl_link c rest)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (hwl_rep m rest)))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

(claim hwr_tl
  (goal ((m Mem) (c HCell) (rest (List HCell)))
    ((= (hwl_rep m (Cons c rest)) True))
    (= (hwl_rep m rest) True))
  (chain
    (have h0 (= (andb (hcell_rep m (wl_link c rest)) (hwl_rep m rest)) True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold hwl_rep rhs) (reduce rhs))
        refl))
    (have hx (= (hwl_rep m rest) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (hcell_rep m (wl_link c rest))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

(claim wlo_hd
  (goal ((c HCell) (rest (List HCell))) ((= (wl_ok (Cons c rest)) True))
    (= (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c)) True))
  (chain
    (have h0
      (=
        (andb
          (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c))
          (wl_ok rest))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold wl_ok rhs) (reduce rhs))
        refl))
    (have hx
      (= (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (wl_ok rest)))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

(claim wlo_tl
  (goal ((c HCell) (rest (List HCell))) ((= (wl_ok (Cons c rest)) True))
    (= (wl_ok rest) True))
  (chain
    (have h0
      (=
        (andb
          (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c))
          (wl_ok rest))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold wl_ok rhs) (reduce rhs))
        refl))
    (have hx (= (wl_ok rest) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

(claim wlo_len
  (goal ((c HCell) (rest (List HCell))) ((= (wl_ok (Cons c rest)) True))
    (= (int_eq (ilen (hslots_of c)) (harity_of c)) True))
  (chain
    (have h0
      (= (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c)) True)
      (rewrite-with
        (lemma wlo_hd)
        lr
        lhs
        ((inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hx (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (cbands c)))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

(claim wlo_bands
  (goal ((c HCell) (rest (List HCell))) ((= (wl_ok (Cons c rest)) True))
    (= (cbands c) True))
  (chain
    (have h0
      (= (andb (int_eq (ilen (hslots_of c)) (harity_of c)) (cbands c)) True)
      (rewrite-with
        (lemma wlo_hd)
        lr
        lhs
        ((inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hx (= (cbands c) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (int_eq (ilen (hslots_of c)) (harity_of c))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))


(claim wl_link_addr
  (goal ((c HCell) (rest (List HCell))) ()
    (= (haddr_of (wl_link c rest)) (haddr_of c)))
  (case-on c HCell
    ((case MkHCell
       (ax cx tx rx sx)
       (steps
         ((rewrite (hyp 0) lr both true ())
          (unfold wl_link lhs)
          (compute lhs (stop whead))
          (compute rhs))
         refl)))))

(claim wl_link_arity
  (goal ((c HCell) (rest (List HCell))) ()
    (= (harity_of (wl_link c rest)) (harity_of c)))
  (case-on c HCell
    ((case MkHCell
       (ax cx tx rx sx)
       (steps
         ((rewrite (hyp 0) lr both true ())
          (unfold wl_link lhs)
          (compute lhs (stop whead))
          (compute rhs))
         refl)))))

(claim wl_link_slots
  (goal ((c HCell) (rest (List HCell))) ()
    (= (hslots_of (wl_link c rest)) (hslots_of c)))
  (case-on c HCell
    ((case MkHCell
       (ax cx tx rx sx)
       (steps
         ((rewrite (hyp 0) lr both true ())
          (unfold wl_link lhs)
          (compute lhs (stop whead))
          (compute rhs))
         refl)))))

;; THE WORKLIST FRAME: a store disjoint from every worklist extent keeps hwl_rep
(claim hwl_rep_fr
  (goal ((m Mem) (wl (List HCell)) (b Int) (nb Int) (v Int))
    ((= (hwl_rep m wl) True)
     (= (e_disj1 b nb (hexts wl)) True)
     (= (wl_ok wl) True)
     (= (le 0 nb) True))
    (= (hwl_rep (store_le (iw8) m b v) wl) True))
  (induct wl
    ((case Nil (steps ((unfold hwl_rep lhs) (reduce lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hhd (= (hcell_rep m (wl_link c rest)) True)
           (rewrite-with
             (lemma hwr_hd)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (hwl_rep m rest) True)
           (rewrite-with
             (lemma hwr_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hlen (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
           (rewrite-with
             (lemma wlo_len)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hok (= (wl_ok rest) True)
           (rewrite-with
             (lemma wlo_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hex
           (=
             (hexts (Cons c rest))
             (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
           (steps ((unfold hexts lhs) (reduce lhs)) refl))
         (have hdx
           (=
             (e_disj1
               b
               nb
               (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
             True)
           (steps
             ((rewrite (premise hex) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (have hd2 (= (e_disj2 b nb (haddr_of c) (harity_of c)) True)
           (rewrite-with
             (lemma ed1_hd)
             lr
             lhs
             ((inst rest (hexts rest)))
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hd1 (= (e_disj1 b nb (hexts rest)) True)
           (rewrite-with
             (lemma ed1_tl)
             lr
             lhs
             ((inst b (haddr_of c)) (inst k (harity_of c)))
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hla (= (haddr_of (wl_link c rest)) (haddr_of c))
           (steps ((rewrite (lemma wl_link_addr) lr lhs true ())) refl))
         (have hlr (= (harity_of (wl_link c rest)) (harity_of c))
           (steps ((rewrite (lemma wl_link_arity) lr lhs true ())) refl))
         (have hls (= (hslots_of (wl_link c rest)) (hslots_of c))
           (steps ((rewrite (lemma wl_link_slots) lr lhs true ())) refl))
         (have hd2l
           (=
             (e_disj2
               b
               nb
               (haddr_of (wl_link c rest))
               (harity_of (wl_link c rest)))
             True)
           (steps
             ((rewrite (premise hla) lr lhs true ())
              (rewrite (premise hlr) lr lhs true ())
              (rewrite (premise hd2) lr lhs true ()))
             refl))
         (have hlenl
           (=
             (int_eq
               (ilen (hslots_of (wl_link c rest)))
               (harity_of (wl_link c rest)))
             True)
           (steps
             ((rewrite (premise hls) lr lhs true ())
              (rewrite (premise hlr) lr lhs true ())
              (rewrite (premise hlen) lr lhs true ()))
             refl))
         (have hnew (= (hcell_rep (store_le (iw8) m b v) (wl_link c rest)) True)
           (rewrite-with
             (lemma hcell_rep_fr)
             lr
             lhs
             ((inst nb nb))
             ((steps ((rewrite (premise hhd) lr lhs true ())) refl)
              (steps ((rewrite (premise hd2l) lr lhs true ())) refl)
              (steps ((rewrite (premise hlenl) lr lhs true ())) refl)
              (steps ((rewrite (premise 3) lr lhs true ())) refl))
             refl))
         (have hih (= (hwl_rep (store_le (iw8) m b v) rest) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ((inst nb nb))
             ((steps ((rewrite (premise htl) lr lhs true ())) refl)
              (steps ((rewrite (premise hd1) lr lhs true ())) refl)
              (steps ((rewrite (premise hok) lr lhs true ())) refl)
              (steps ((rewrite (premise 3) lr lhs true ())) refl))
             refl))
         (steps
           ((unfold hwl_rep lhs)
            (reduce lhs)
            (rewrite (premise hnew) lr lhs true ())
            (rewrite (premise hih) lr lhs true ())
            (compute lhs))
           refl))))))


;; THE REMOVAL: a store at a live address (any word) keeps hcells_rep for the
;; cells without it — hcells_rep_decc's walk with the found cell dropped
(claim hcells_rep_hrem
  (goal ((m Mem) (cs (List HCell)) (v Int) (w Int))
    ((= (hcells_rep m cs) True)
     (= (cells_ok cs) True)
     (= (e_disj (hexts cs)) True)
     (= (memb (haddrs cs) v) True))
    (= (hcells_rep (store_le (iw8) m v w) (hrem cs v)) True))
  (induct cs
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (c rest)
       (chain
         (have hm (= (memb (Cons (haddr_of c) (haddrs rest)) v) True)
           (steps
             ((rewrite (premise 3) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs))
             refl))
         (have hhd (= (hcell_rep m c) True)
           (rewrite-with
             (lemma hcs_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (hcells_rep m rest) True)
           (rewrite-with
             (lemma hcs_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcot (= (cells_ok rest) True)
           (rewrite-with
             (lemma co_tl)
             lr
             lhs
             ((inst c c))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hlen (= (int_eq (ilen (hslots_of c)) (harity_of c)) True)
           (rewrite-with
             (lemma co_len)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ha0 (= (le 0 (harity_of c)) True)
           (rewrite-with
             (lemma co_ar0)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hex
           (=
             (hexts (Cons c rest))
             (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
           (steps ((unfold hexts lhs) (reduce lhs)) refl))
         (have hdx
           (=
             (e_disj (Cons (Pair (haddr_of c) (harity_of c)) (hexts rest)))
             True)
           (steps
             ((rewrite (premise hex) rl lhs true ())
              (rewrite (premise 2) lr lhs true ()))
             refl))
         (have hd1 (= (e_disj1 (haddr_of c) (harity_of c) (hexts rest)) True)
           (rewrite-with
             (lemma ed_hd)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (have hdt (= (e_disj (hexts rest)) True)
           (rewrite-with
             (lemma ed_tl)
             lr
             lhs
             ((inst a (haddr_of c)) (inst n (harity_of c)))
             ((steps ((rewrite (premise hdx) lr lhs true ())) refl))
             refl))
         (case-on (int_eq (haddr_of c) v) Bool
           ((case True
              (chain
                (have hT (= (int_eq (haddr_of c) v) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (have hca (= (haddr_of c) v)
                  (rewrite-with
                    (lemma int_eq_eq)
                    lr
                    lhs
                    ((inst b v))
                    ((steps ((rewrite (premise hT) lr lhs true ())) refl))
                    refl))
                (have hd1v (= (e_disj1 v (harity_of c) (hexts rest)) True)
                  (steps
                    ((rewrite (premise hca) rl lhs true ())
                     (rewrite (premise hd1) lr lhs true ()))
                    refl))
                (have hrest (= (hcells_rep (store_le (iw8) m v w) rest) True)
                  (rewrite-with
                    (lemma hcells_rep_fr)
                    lr
                    lhs
                    ((inst nb (harity_of c)))
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hd1v) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise ha0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((unfold hrem lhs)
                   (reduce lhs)
                   (rewrite (premise hT) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise hrest) lr lhs true ()))
                  refl)))
            (case False
              (chain
                (have hF (= (int_eq (haddr_of c) v) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (have hmt (= (memb (haddrs rest) v) True)
                  (steps
                    ((rewrite (premise hm) rl rhs true ())
                     (unfold memb rhs)
                     (reduce rhs)
                     (rewrite (premise hF) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hih
                  (= (hcells_rep (store_le (iw8) m v w) (hrem rest v)) True)
                  (rewrite-with
                    (hyp 1)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise htl) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hdt) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hcbr (= (cbands (hfget rest v)) True)
                  (rewrite-with
                    (lemma hfget_bands)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcot) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hn0 (= (le 0 (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma cb_ar0)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hcbr) lr lhs true ())) refl))
                    refl))
                (have hmx
                  (= (emem (hexts rest) v (harity_of (hfget rest v))) True)
                  (rewrite-with
                    (lemma hfget_hexts)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hmt) lr lhs true ())) refl))
                    refl))
                (have hd2
                  (=
                    (e_disj2
                      (haddr_of c)
                      (harity_of c)
                      v
                      (harity_of (hfget rest v)))
                    True)
                  (rewrite-with
                    (lemma ed1_memb)
                    lr
                    lhs
                    ((inst es (hexts rest)))
                    ((steps ((rewrite (premise hd1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hmx) lr lhs true ())) refl))
                    refl))
                (have hd2s
                  (=
                    (e_disj2
                      v
                      (harity_of (hfget rest v))
                      (haddr_of c)
                      (harity_of c))
                    True)
                  (rewrite-with
                    (lemma ed2_sym)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hd2) lr lhs true ())) refl))
                    refl))
                (have hhd2 (= (hcell_rep (store_le (iw8) m v w) c) True)
                  (rewrite-with
                    (lemma hcell_rep_fr)
                    lr
                    lhs
                    ((inst nb (harity_of (hfget rest v))))
                    ((steps ((rewrite (premise hhd) lr lhs true ())) refl)
                     (steps ((rewrite (premise hd2s) lr lhs true ())) refl)
                     (steps ((rewrite (premise hlen) lr lhs true ())) refl)
                     (steps ((rewrite (premise hn0) lr lhs true ())) refl))
                    refl))
                (steps
                  ((unfold hrem lhs)
                   (reduce lhs)
                   (rewrite (premise hF) lr lhs true ())
                   (reduce lhs)
                   (unfold hcells_rep lhs)
                   (reduce lhs)
                   (rewrite (premise hhd2) lr lhs true ())
                   (rewrite (premise hih) lr lhs true ())
                   (compute lhs))
                  refl))))))))))


;; THE PUSH: storing hword d − count d + head at a live cell's header makes the
;; cell the worklist's new head (its slots stay; the old chain is framed)
(claim hwl_rep_push
  (goal ((m Mem) (wl (List HCell)) (d HCell) (w Int))
    ((= (hwl_rep m wl) True)
     (= (hcell_rep m d) True)
     (= (e_disj1 (haddr_of d) (harity_of d) (hexts wl)) True)
     (= (wl_ok wl) True)
     (= (int_eq (ilen (hslots_of d)) (harity_of d)) True)
     (= (cbands d) True)
     (= (le 0 (whead wl)) True)
     (= (lt (whead wl) 4294967296) True)
     (= w (+ (- (hword d) (hcount_of d)) (whead wl))))
    (= (hwl_rep (store_le (iw8) m (haddr_of d) w) (Cons d wl)) True))
  (chain
    (have ha0 (= (le 0 (harity_of d)) True)
      (rewrite-with
        (lemma cb_ar0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 5) lr lhs true ())) refl))
        refl))
    (have ht0 (= (le 0 (htag_of d)) True)
      (rewrite-with
        (lemma cb_tag0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 5) lr lhs true ())) refl))
        refl))
    (have hthi (= (lt (htag_of d) 65536) True)
      (rewrite-with
        (lemma cb_taghi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 5) lr lhs true ())) refl))
        refl))
    (have hahi (= (lt (harity_of d) 65536) True)
      (rewrite-with
        (lemma cb_arhi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 5) lr lhs true ())) refl))
        refl))
    (have htail (= (hwl_rep (store_le (iw8) m (haddr_of d) w) wl) True)
      (rewrite-with
        (lemma hwl_rep_fr)
        lr
        lhs
        ((inst nb (harity_of d)))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise 3) lr lhs true ())) refl)
         (steps ((rewrite (premise ha0) lr lhs true ())) refl))
        refl))
    (have hsl (= (hslots_rep m (+ (haddr_of d) 8) (hslots_of d)) True)
      (rewrite-with
        (lemma hc_slots)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (case-on d HCell
      ((case MkHCell
         (ax cx tx rx sx)
         (chain
           (have hwe
             (= (hword d) (+ cx (+ (* tx 4294967296) (* rx 281474976710656))))
             (steps
               ((rewrite (hyp 0) lr lhs true ())
                (unfold hword lhs)
                (compute lhs))
               refl))
           (have hcx (= (hcount_of d) cx)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hax (= (haddr_of d) ax)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have htx (= (htag_of d) tx)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hrx (= (harity_of d) rx)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hsx (= (hslots_of d) sx)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hw2
             (= w (+ (whead wl) (+ (* tx 4294967296) (* rx 281474976710656))))
             (steps
               ((rewrite (premise 8) lr lhs true ())
                (rewrite (premise hwe) lr lhs true ())
                (rewrite (premise hcx) lr lhs true ()))
               (by arith (list (list 1) (list 1)))))
           (have ht0x (= (le 0 tx) True)
             (steps
               ((rewrite (premise htx) rl lhs true ())
                (rewrite (premise ht0) lr lhs true ()))
               refl))
           (have ha0x (= (le 0 rx) True)
             (steps
               ((rewrite (premise hrx) rl lhs true ())
                (rewrite (premise ha0) lr lhs true ()))
               refl))
           (have hthix (= (lt tx 65536) True)
             (steps
               ((rewrite (premise htx) rl lhs true ())
                (rewrite (premise hthi) lr lhs true ()))
               refl))
           (have hahix (= (lt rx 65536) True)
             (steps
               ((rewrite (premise hrx) rl lhs true ())
                (rewrite (premise hahi) lr lhs true ()))
               refl))
           (have hwlo (= (le 0 w) True)
             (by
               arith
               (rows
                 (goal 1)
                 (hw2 1)
                 (6 1)
                 (ht0x 4294967296)
                 (ha0x 281474976710656))))
           (have hwhi (= (lt w 18446744073709551616) True)
             (by
               arith
               (rows
                 (goal 1)
                 (hw2 -1)
                 (7 1)
                 (hthix 4294967296)
                 (hahix 281474976710656))))
           (have hld (= (load_le (iw8) (store_le (iw8) m ax w) ax) w)
             (rewrite-with
               (lemma ls8w)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hwlo) lr lhs true ())) refl)
                (steps ((rewrite (premise hwhi) lr lhs true ())) refl))
               refl))
           (have hwL (= w (hword (MkHCell ax (whead wl) tx rx sx)))
             (steps
               ((rewrite (premise hw2) lr lhs true ())
                (unfold hword rhs)
                (compute rhs (stop whead)))
               refl))
           (have hslx (= (hslots_rep m (+ ax 8) sx) True)
             (steps
               ((rewrite (premise hax) rl lhs true ())
                (rewrite (premise hsx) rl lhs true ())
                (rewrite (premise hsl) lr lhs true ()))
               refl))
           (have hor
             (=
               (orb (le (+ ax 8) (+ ax 8)) (le (+ (+ ax 8) (* 8 (ilen sx))) ax))
               True)
             (rewrite-with
               (lemma orb_intro_l)
               lr
               lhs
               ()
               ((by arith (rows (goal 1))))
               refl))
           (have hsl2 (= (hslots_rep (store_le (iw8) m ax w) (+ ax 8) sx) True)
             (rewrite-with
               (lemma hslots_rep_fr)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hslx) lr lhs true ())) refl)
                (steps ((rewrite (premise hor) lr lhs true ())) refl))
               refl))
           (have hlink (= (wl_link d wl) (MkHCell ax (whead wl) tx rx sx))
             (steps
               ((unfold wl_link lhs)
                (rewrite (hyp 0) lr lhs true ())
                (compute lhs (stop whead)))
               refl))
           (have hnew
             (=
               (hcell_rep
                 (store_le (iw8) m ax w)
                 (MkHCell ax (whead wl) tx rx sx))
               True)
             (steps
               ((unfold hcell_rep lhs)
                (compute lhs (stop iw8 load_le store_le hslots_rep hword whead))
                (rewrite (premise hld) lr lhs true ())
                (rewrite (premise hwL) rl lhs true ())
                (rewrite (lemma int_eq_refl) lr lhs true ())
                (rewrite (premise hsl2) lr lhs true ())
                (compute lhs))
               refl))
           (steps
             ((unfold hwl_rep lhs)
              (reduce lhs)
              (rewrite (premise hlink) lr lhs true ())
              (rewrite (premise htail) lr lhs true ())
              (rewrite (premise hax) lr lhs true ())
              (rewrite (premise hnew) lr lhs true ())
              (compute lhs))
             refl)))))))


;; --- the inner loop's helpers (C2b-5 part ii-c) ----------------------------------------
(claim eaddrs_hexts
  (goal ((cs (List HCell))) () (= (e_addrs (hexts cs)) (haddrs cs)))
  (induct cs
    ((case Nil (steps ((compute lhs) (compute rhs)) refl))
     (case Cons
       (c rest)
       (steps
         ((unfold hexts lhs)
          (reduce lhs)
          (unfold e_addrs lhs)
          (reduce lhs)
          (rewrite (hyp 0) lr lhs true ())
          (unfold haddrs rhs)
          (reduce rhs))
         refl)))))

(claim hfget_len
  (goal ((cs (List HCell)) (v Int))
    ((= (cells_ok cs) True) (= (memb (haddrs cs) v) True))
