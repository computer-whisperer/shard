    (have h0
      (=
        (andb
          (int_eq (load_le (iw8) m rb) (gtop_of g))
          (andb
            (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g))
            (andb
              (int_eq (load_le (iw8) m (+ rb 16)) 0)
              (andb
                (hfree_rep m rb 0 (gfree_of g))
                (andb (hcells_rep m (gcells_of g)) (hraw_rep m (graw_of g)))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold heap_rep rhs)
         (reduce rhs))
        refl))
    (have hx (= (int_eq (load_le (iw8) m rb) (gtop_of g)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g))
             (andb
               (int_eq (load_le (iw8) m (+ rb 16)) 0)
               (andb
                 (hfree_rep m rb 0 (gfree_of g))
                 (andb (hcells_rep m (gcells_of g)) (hraw_rep m (graw_of g))))))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

