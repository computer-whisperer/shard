                                     refl))
                                  refl))
                              (have hfrg
                                (= (hfree_rep m rb 0 (gfree_of g)) True)
                                (rewrite-with
                                  (lemma hrx_free)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have hfr (= (hfree_rep m rb 0 gf) True)
                                (steps
                                  ((rewrite (premise hgf0) rl lhs true ())
                                   (rewrite (premise hfrg) lr lhs true ()))
                                  refl))
                              (have hor2a
