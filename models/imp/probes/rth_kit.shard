         (have han (= (anodup (e_addrs (ext_all g))) True)
           (rewrite-with
             (lemma ed_nodup)
             lr
             lhs
             ((inst lo (glo_of g)) (inst top (gtop_of g)))
             ((steps ((rewrite (premise hdj) lr lhs true ())) refl)
              (steps ((rewrite (premise hbkg) lr lhs true ())) refl))
             refl))
         (have hea1
           (=
             (e_addrs (ext_all g))
             (iapp (haddrs gc) (iapp (faddrs gf) (Cons p Nil))))
