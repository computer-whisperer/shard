;; the init bytes mean the empty ghost
(claim hr_init
  (goal ((m Mem) (rb Int) (lo Int) (hi Int))
    ((= (le 0 lo) True)
     (= (lt lo 18446744073709551616) True)
     (= (le 0 hi) True)
     (= (lt hi 18446744073709551616) True))
    (= (heap_rep (m_init m rb lo hi) rb (gh_init lo hi)) True))
  (chain
    (have hqlo (= (int_eq lo lo) True)
      (by arith (list (list 1 0 0 0 0) (list 1 0 0 0 0))))
    (have hqhi (= (int_eq hi hi) True)
      (by arith (list (list 1 0 0 0 0 0) (list 1 0 0 0 0 0))))
    (have hrt (= (load_le (iw8) (m_init m rb lo hi) rb) lo)
      (rewrite-with
        (lemma m_init_rd_top)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hre (= (load_le (iw8) (m_init m rb lo hi) (+ rb 8)) hi)
      (rewrite-with
        (lemma m_init_rd_end)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise 3) lr lhs true ())) refl))
        refl))
    (have hrd (= (load_le (iw8) (m_init m rb lo hi) (+ rb 16)) 0)
      (rewrite-with (lemma m_init_rd_dep) lr lhs () () refl))
    (have hh0 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 24)) 0)
      (rewrite-with (lemma m_init_rd_h0) lr lhs () () refl))
    (have hh1 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 32)) 0)
      (rewrite-with (lemma m_init_rd_h1) lr lhs () () refl))
    (have hh2 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 40)) 0)
      (rewrite-with (lemma m_init_rd_h2) lr lhs () () refl))
    (have hh3 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 48)) 0)
      (rewrite-with (lemma m_init_rd_h3) lr lhs () () refl))
    (have hh4 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 56)) 0)
      (rewrite-with (lemma m_init_rd_h4) lr lhs () () refl))
    (have hh5 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 64)) 0)
      (rewrite-with (lemma m_init_rd_h5) lr lhs () () refl))
    (have hh6 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 72)) 0)
      (rewrite-with (lemma m_init_rd_h6) lr lhs () () refl))
    (have hh7 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 80)) 0)
      (rewrite-with (lemma m_init_rd_h7) lr lhs () () refl))
    (have hh8 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 88)) 0)
      (rewrite-with (lemma m_init_rd_h8) lr lhs () () refl))
    (have hh9 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 96)) 0)
      (rewrite-with (lemma m_init_rd_h9) lr lhs () () refl))
    (have hh10 (= (load_le (iw8) (m_init m rb lo hi) (+ rb 104)) 0)
      (rewrite-with (lemma m_init_rd_h10) lr lhs () () refl))
