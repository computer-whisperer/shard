            (compute lhs))
           refl))))))

;; the SEAL keeps hinv: the newest cell has count 1 = its one root, and
;; the extent family is the old one with the raw extent moved to the front
(claim hinv_seal
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int)))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (int_eq (ilen fill) n) True)
     (= (count_in r p) 1))
    (= (hinv rb (gh_seal g) r) True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hgr (= gr (Some (MkHRaw p tag n fill)))
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (have hsl
           (=
             (gh_seal g)
             (MkGHeap (Cons (MkHCell p 1 tag n fill) gc) gf gl gt ge None))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (unfold gh_seal lhs)
              (compute lhs))
             refl))
         (have hgl0 (= (glo_of g) gl)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgt0 (= (gtop_of g) gt)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hge0 (= (gend_of g) ge)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgc0 (= (gcells_of g) gc)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf0 (= (gfree_of g) gf)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have har (= (araw_ok g p tag n fill) True)
           (rewrite-with
             (lemma araw_facts)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hal (= (int_eq (mod p 8) 0) True)
           (rewrite-with
             (lemma ar_al)
             lr
             lhs
             ((inst g g) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hhc0 (= (int_eq (count_in (haddrs (gcells_of g)) p) 0) True)
           (rewrite-with
             (lemma ar_hc0)
             lr
             lhs
             ((inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hfc0 (= (int_eq (count_in (faddrs (gfree_of g)) p) 0) True)
           (rewrite-with
             (lemma ar_fc0)
             lr
             lhs
             ((inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hmem (= (emem (ext_all g) p n) True)
           (rewrite-with
             (lemma ar_mem)
             lr
             lhs
             ((inst tag tag) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hecells (= (eall (hexts (gcells_of g)) (ext_all g)) True)
           (rewrite-with
             (lemma ar_ecells)
             lr
             lhs
             ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hefree (= (eall (fexts (gfree_of g) 0) (ext_all g)) True)
           (rewrite-with
             (lemma ar_efree)
             lr
             lhs
             ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hx1
           (=
             (ext_all g)
             (fexts_app
               (hexts gc)
               (fexts_app (fexts gf 0) (Cons (Pair p n) Nil))))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app)))
             refl))
         (have hx2
           (=
             (ext_all
               (MkGHeap (Cons (MkHCell p 1 tag n fill) gc) gf gl gt ge None))
             (Cons
               (Pair p n)
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) Nil))))
           (steps
             ((unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app))
              (unfold hexts lhs)
              (reduce lhs)
              (compute lhs (stop hexts fexts fexts_app))
              (unfold fexts_app lhs)
              (reduce lhs))
             refl))
         (have h1 (= (le 0 rb) True)
           (rewrite-with
             (lemma hi_rb0)
             lr
             lhs
             ((inst g g) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h2g (= (le (+ rb 152) (glo_of g)) True)
           (rewrite-with
             (lemma hi_hdr)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h2 (= (le (+ rb 152) gl) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h2g) lr lhs true ()))
             refl))
         (have h3g (= (le (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_lot)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h3 (= (le gl gt) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h3g) lr lhs true ()))
             refl))
         (have h4g (= (le (gtop_of g) (gend_of g)) True)
           (rewrite-with
             (lemma hi_te)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h4 (= (le gt ge) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hge0) rl lhs true ())
              (rewrite (premise h4g) lr lhs true ()))
             refl))
         (have h5g (= (le (gend_of g) 4294967296) True)
           (rewrite-with
             (lemma hi_e32)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h5 (= (le ge 4294967296) True)
           (steps
             ((rewrite (premise hge0) rl lhs true ())
              (rewrite (premise h5g) lr lhs true ()))
             refl))
         (have h6g (= (int_eq (mod (glo_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_alo)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h6 (= (int_eq (mod gl 8) 0) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h6g) lr lhs true ()))
             refl))
         (have h7g (= (int_eq (mod (gtop_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_atop)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h7 (= (int_eq (mod gt 8) 0) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h7g) lr lhs true ()))
             refl))
         (have hdj (= (e_disj (ext_all g)) True)
           (rewrite-with
             (lemma hi_disj)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbkg (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_brk)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbk (= (e_brk (ext_all g) gl gt) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hbkg) lr lhs true ()))
             refl))
         (have he1 (= (eall (hexts gc) (ext_all g)) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hecells) lr lhs true ()))
             refl))
         (have he2 (= (eall (fexts gf 0) (ext_all g)) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise hefree) lr lhs true ()))
             refl))
         (have he3 (= (eall Nil (ext_all g)) True)
           (steps ((unfold eall lhs) (reduce lhs)) refl))
         (have he4 (= (eall (fexts_app (fexts gf 0) Nil) (ext_all g)) True)
           (rewrite-with
             (lemma eall_app_intro)
             lr
             lhs
             ()
             ((steps ((rewrite (premise he2) lr lhs true ())) refl)
              (steps ((rewrite (premise he3) lr lhs true ())) refl))
             refl))
         (have he5
           (=
             (eall
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) Nil))
               (ext_all g))
             True)
           (rewrite-with
             (lemma eall_app_intro)
             lr
             lhs
             ()
             ((steps ((rewrite (premise he1) lr lhs true ())) refl)
              (steps ((rewrite (premise he4) lr lhs true ())) refl))
             refl))
         (have heall
           (=
             (eall
               (Cons
                 (Pair p n)
                 (fexts_app (hexts gc) (fexts_app (fexts gf 0) Nil)))
