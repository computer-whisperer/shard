                                   (rewrite (premise r1g) lr lhs true ()))
                                  refl))
                              (have r2
                                (=
                                  (load_le
                                    (iw8)
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    (+ rb 8))
                                  (load_le (iw8) m (+ rb 8)))
                                (rewrite-with
                                  (lemma ldw_below)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise a2) lr lhs true ()))
                                     refl))
                                  refl))
                              (have r2g
                                (=
                                  (int_eq
                                    (load_le (iw8) m (+ rb 8))
                                    (gend_of g))
                                  True)
                                (rewrite-with
                                  (lemma hrx_end)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have c2
                                (=
                                  (int_eq
                                    (load_le
                                      (iw8)
                                      (store_le (iw8) m v (+ (hword c) 1))
                                      (+ rb 8))
                                    ge)
                                  True)
                                (steps
                                  ((rewrite (premise r2) lr lhs true ())
                                   (rewrite (premise hge0) rl lhs true ())
                                   (rewrite (premise r2g) lr lhs true ()))
                                  refl))
                              (have r3
                                (=
                                  (load_le
                                    (iw8)
                                    (store_le (iw8) m v (+ (hword c) 1))
                                    (+ rb 16))
                                  (load_le (iw8) m (+ rb 16)))
                                (rewrite-with
                                  (lemma ldw_below)
                                  lr
                                  lhs
                                  ()
                                  ((steps
                                     ((rewrite (premise a3) lr lhs true ()))
                                     refl))
                                  refl))
                              (have r3g
                                (= (int_eq (load_le (iw8) m (+ rb 16)) 0) True)
                                (rewrite-with
                                  (lemma hrx_dep)
                                  lr
                                  lhs
                                  ((inst g g))
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have c3
                                (=
                                  (int_eq
                                    (load_le
                                      (iw8)
                                      (store_le (iw8) m v (+ (hword c) 1))
                                      (+ rb 16))
                                    0)
                                  True)
                                (steps
                                  ((rewrite (premise r3) lr lhs true ())
                                   (rewrite (premise r3g) lr lhs true ()))
                                  refl))
                              (have c4g
                                (= (int_eq (fllen (gfree_of g)) 16) True)
                                (rewrite-with
                                  (lemma hrx_fl16)
                                  lr
                                  lhs
                                  ((inst m m) (inst rb rb))
                                  ((steps
                                     ((rewrite (premise 0) lr lhs true ()))
                                     refl))
                                  refl))
                              (have c4 (= (int_eq (fllen gf) 16) True)
                                (steps
                                  ((rewrite (premise hgf0) rl lhs true ())
                                   (rewrite (premise c4g) lr lhs true ()))
                                  refl))
                              (have f16e (= (fllen gf) 16)
