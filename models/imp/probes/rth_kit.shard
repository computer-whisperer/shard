         (have hczc (= (count_in (e_addrs (hexts gc)) p) 0)
           (steps
             ((rewrite (premise heac) lr lhs true ())
              (rewrite (premise hhc0e) lr lhs true ()))
             refl))
         (have hecells2 (= (eall (hexts gc) (ext_all g)) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hecells) lr lhs true ()))
             refl))
         (have hdpc (= (e_disj1 p n (hexts gc)) True)
           (rewrite-with
             (lemma ed1_intro)
             lr
             lhs
             ((inst es (ext_all g)))
             ((steps ((rewrite (premise hecells2) lr lhs true ())) refl)
              (steps ((rewrite (premise hczc) lr lhs true ())) refl)
              (steps ((rewrite (premise hmem) lr lhs true ())) refl)
              (steps ((rewrite (premise hdj) lr lhs true ())) refl))
             refl))
         (have c6
           (=
             (hcells_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 n))) (hhead rest))
                 p
                 (hdr_word tag n))
               gc)
             True)
           (rewrite-with
             (lemma hcells_rep_fr)
             lr
             lhs
             ((inst nb n))
             ((steps ((rewrite (premise h6a) lr lhs true ())) refl)
              (steps ((rewrite (premise hdpc) lr lhs true ())) refl)
              (steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl))
             refl))
         (have rw1
           (=
             (load_le
               (iw8)
               (store_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 n))) (hhead rest))
                 p
                 (hdr_word tag n))
               p)
             (hdr_word tag n))
           (rewrite-with
             (lemma ls8w)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hd0) lr lhs true ())) refl)
              (steps ((rewrite (premise hd1) lr lhs true ())) refl))
             refl))
         (have rw2 (= (rword (MkHRaw p tag n Nil)) (hdr_word tag n))
           (rewrite-with (lemma hdr_rword) lr lhs () () refl))
         (have c7
           (=
             (hraw_rep
               (store_le
                 (iw8)
                 (store_le (iw8) m (+ rb (+ 24 (* 8 n))) (hhead rest))
                 p
                 (hdr_word tag n))
               (Some (MkHRaw p tag n Nil)))
             True)
           (steps
             ((unfold hraw_rep lhs)
              (reduce lhs)
              (compute lhs (stop iw8 load_le store_le hdr_word rword hhead))
              (rewrite (premise rw1) lr lhs true ())
              (rewrite (premise rw2) lr lhs true ())
              (rewrite (lemma int_eq_refl) lr lhs true ())
              (compute lhs))
             refl))
         (steps
           ((rewrite (premise hmm) lr lhs true ())
            (unfold heap_rep lhs)
            (reduce lhs)
            (rewrite (premise hgt) lr lhs true ())
            (rewrite (premise hge) lr lhs true ())
            (rewrite (premise hgf2) lr lhs true ())
            (rewrite (premise hgc2) lr lhs true ())
            (rewrite (premise hgr2) lr lhs true ())
            (rewrite (premise c1) lr lhs true ())
            (rewrite (premise c2) lr lhs true ())
            (rewrite (premise c3) lr lhs true ())
            (rewrite (premise c4) lr lhs true ())
            (rewrite (premise c5) lr lhs true ())
            (rewrite (premise c6) lr lhs true ())
            (rewrite (premise c7) lr lhs true ())
            (compute lhs))
           refl))))))

;; THE BUMP LEG keeps heap_rep: [rb] := the new top, [top] := the header,
;; and every old word reads as before (the block below, the extents
;; ending at or before top)
(claim hr_abump
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (tag Int) (n Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g)) True)
     (= (le 0 n) True)
     (= (le 0 tag) True)
     (= (lt tag 65536) True)
     (= (lt n 65536) True))
    (=
      (heap_rep (m_abump m rb (gtop_of g) n tag) rb (gh_alloc_bump g tag n))
      True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hgl0 (= (glo_of g) gl)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgt0 (= (gtop_of g) gt)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hge0 (= (gend_of g) ge)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgc0 (= (gcells_of g) gc)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf0 (= (gfree_of g) gf)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgt (= (gtop_of (gh_alloc_bump g tag n)) (+ gt (+ 8 (* 8 n))))
           (steps
             ((unfold gh_alloc_bump lhs)
              (rewrite (hyp 0) lr lhs true ())
              (compute lhs))
             refl))
         (have hge (= (gend_of (gh_alloc_bump g tag n)) ge)
           (steps
             ((unfold gh_alloc_bump lhs)
              (rewrite (hyp 0) lr lhs true ())
              (compute lhs))
             refl))
         (have hgr2
           (= (graw_of (gh_alloc_bump g tag n)) (Some (MkHRaw gt tag n Nil)))
           (steps
             ((unfold gh_alloc_bump lhs)
              (rewrite (hyp 0) lr lhs true ())
              (compute lhs))
             refl))
         (have hgc2 (= (gcells_of (gh_alloc_bump g tag n)) gc)
           (steps
             ((unfold gh_alloc_bump lhs)
              (rewrite (hyp 0) lr lhs true ())
              (compute lhs))
             refl))
         (have hgf2 (= (gfree_of (gh_alloc_bump g tag n)) gf)
           (steps
             ((unfold gh_alloc_bump lhs)
              (rewrite (hyp 0) lr lhs true ())
              (compute lhs))
             refl))
         (have h1 (= (le 0 rb) True)
           (rewrite-with
             (lemma hi_rb0)
             lr
             lhs
             ((inst g g) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have h2g (= (le (+ rb 152) (glo_of g)) True)
           (rewrite-with
             (lemma hi_hdr)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have h2 (= (le (+ rb 152) gl) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h2g) lr lhs true ()))
             refl))
         (have h3g (= (le (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_lot)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have h3 (= (le gl gt) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h3g) lr lhs true ()))
             refl))
         (have h4 (= (le (+ gt (+ 8 (* 8 n))) ge) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hge0) rl lhs true ())
              (rewrite (premise 3) lr lhs true ()))
             refl))
         (have h5g (= (le (gend_of g) 4294967296) True)
           (rewrite-with
             (lemma hi_e32)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have h5 (= (le ge 4294967296) True)
           (steps
             ((rewrite (premise hge0) rl lhs true ())
              (rewrite (premise h5g) lr lhs true ()))
             refl))
         (have hd0 (= (le 0 (hdr_word tag n)) True)
           (rewrite-with
             (lemma hdr_lo)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 5) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl))
             refl))
         (have hd1 (= (lt (hdr_word tag n) 18446744073709551616) True)
           (rewrite-with
             (lemma hdr_hi)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 6) lr lhs true ())) refl)
              (steps ((rewrite (premise 7) lr lhs true ())) refl))
             refl))
         (have ht0 (= (le 0 (+ gt (+ 8 (* 8 n)))) True)
           (by arith (rows (goal 1) (h1 1) (h2 1) (h3 1) (4 8))))
         (have ht1 (= (lt (+ gt (+ 8 (* 8 n))) 18446744073709551616) True)
           (by arith (rows (goal 1) (h4 1) (h5 1))))
         (have hmm
           (=
             (m_abump m rb gt n tag)
             (store_le
               (iw8)
               (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
               gt
               (hdr_word tag n)))
           (steps ((unfold m_abump lhs)) refl))
         (have a1 (= (le (+ rb 8) gt) True)
           (by arith (rows (goal 1) (h2 1) (h3 1))))
         (have a2 (= (le (+ (+ rb 8) 8) gt) True)
           (by arith (rows (goal 1) (h2 1) (h3 1))))
         (have a3 (= (le (+ (+ rb 16) 8) gt) True)
           (by arith (rows (goal 1) (h2 1) (h3 1))))
         (have a4 (= (le (+ rb 8) (+ rb 8)) True) (by arith (rows (goal 1))))
         (have a5 (= (le (+ rb 8) (+ rb 16)) True) (by arith (rows (goal 1))))
         (have r1a
           (=
             (load_le
               (iw8)
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               rb)
             (load_le (iw8) (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) rb))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a1) lr lhs true ())) refl))
             refl))
         (have r1b
           (=
             (load_le (iw8) (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) rb)
             (+ gt (+ 8 (* 8 n))))
           (rewrite-with
             (lemma ls8w)
             lr
             lhs
             ()
             ((steps ((rewrite (premise ht0) lr lhs true ())) refl)
              (steps ((rewrite (premise ht1) lr lhs true ())) refl))
             refl))
         (have c1
           (=
             (int_eq
               (load_le
                 (iw8)
                 (store_le
                   (iw8)
                   (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                   gt
                   (hdr_word tag n))
                 rb)
               (+ gt (+ 8 (* 8 n))))
             True)
           (steps
             ((rewrite (premise r1a) lr lhs true ())
              (rewrite (premise r1b) lr lhs true ())
              (rewrite (lemma int_eq_refl) lr lhs true ()))
             refl))
         (have r2a
           (=
             (load_le
               (iw8)
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               (+ rb 8))
             (load_le (iw8) (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) (+ rb 8)))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a2) lr lhs true ())) refl))
             refl))
         (have r2b
           (=
             (load_le (iw8) (store_le (iw8) m rb (+ gt (+ 8 (* 8 n)))) (+ rb 8))
             (load_le (iw8) m (+ rb 8)))
           (rewrite-with
             (lemma ldw_above)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a4) lr lhs true ())) refl))
             refl))
         (have r2c (= (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g)) True)
           (rewrite-with
             (lemma hrx_end)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c2
           (=
             (int_eq
               (load_le
                 (iw8)
                 (store_le
                   (iw8)
                   (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                   gt
                   (hdr_word tag n))
                 (+ rb 8))
               ge)
             True)
           (steps
             ((rewrite (premise r2a) lr lhs true ())
              (rewrite (premise r2b) lr lhs true ())
              (rewrite (premise hge0) rl lhs true ())
              (rewrite (premise r2c) lr lhs true ()))
             refl))
         (have r3a
           (=
             (load_le
               (iw8)
               (store_le
                 (iw8)
                 (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                 gt
                 (hdr_word tag n))
               (+ rb 16))
             (load_le
               (iw8)
               (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
               (+ rb 16)))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a3) lr lhs true ())) refl))
             refl))
         (have r3b
           (=
             (load_le
               (iw8)
               (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
               (+ rb 16))
             (load_le (iw8) m (+ rb 16)))
           (rewrite-with
             (lemma ldw_above)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a5) lr lhs true ())) refl))
             refl))
         (have r3c (= (int_eq (load_le (iw8) m (+ rb 16)) 0) True)
           (rewrite-with
             (lemma hrx_dep)
             lr
             lhs
             ((inst g g))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c3
           (=
             (int_eq
               (load_le
                 (iw8)
                 (store_le
                   (iw8)
                   (store_le (iw8) m rb (+ gt (+ 8 (* 8 n))))
                   gt
                   (hdr_word tag n))
                 (+ rb 16))
               0)
             True)
           (steps
             ((rewrite (premise r3a) lr lhs true ())
              (rewrite (premise r3b) lr lhs true ())
              (rewrite (premise r3c) lr lhs true ()))
             refl))
         (have f16g (= (int_eq (fllen (gfree_of g)) 16) True)
           (rewrite-with
             (lemma hrx_fl16)
             lr
             lhs
             ((inst m m) (inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c4 (= (int_eq (fllen gf) 16) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
