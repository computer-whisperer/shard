                 (andb
                   (le 0 tag)
                   (andb (lt tag 65536) (andb (le 0 n) (lt n 65536))))))
             True)
           (steps
             ((rewrite (premise hrk) rl rhs true ())
              (unfold raw_ok rhs)
              (compute rhs (stop slots_ok haddrs ilen andb)))
             refl))
         (have hso (= (slots_ok fill (haddrs gc)) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst
                b
                (andb
                  (le (ilen fill) n)
                  (andb
                    (le 0 tag)
                    (andb (lt tag 65536) (andb (le 0 n) (lt n 65536)))))))
             ((steps ((rewrite (premise hr1) lr lhs true ())) refl))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have hr2
           (=
             (andb
               (le (ilen fill) n)
               (andb
                 (le 0 tag)
                 (andb (lt tag 65536) (andb (le 0 n) (lt n 65536)))))
             True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (slots_ok fill (haddrs gc))))
             ((steps ((rewrite (premise hr1) lr lhs true ())) refl))
             refl))
         (have hrkb
           (=
             (andb
               (le 0 tag)
               (andb (lt tag 65536) (andb (le 0 n) (lt n 65536))))
             True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (le (ilen fill) n)))
             ((steps ((rewrite (premise hr2) lr lhs true ())) refl))
             refl))
         (have ht0 (= (le 0 tag) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (andb (lt tag 65536) (andb (le 0 n) (lt n 65536)))))
             ((steps ((rewrite (premise hrkb) lr lhs true ())) refl))
             refl))
         (have hrk3 (= (andb (lt tag 65536) (andb (le 0 n) (lt n 65536))) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (le 0 tag)))
             ((steps ((rewrite (premise hrkb) lr lhs true ())) refl))
             refl))
         (have hthi (= (lt tag 65536) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (andb (le 0 n) (lt n 65536))))
             ((steps ((rewrite (premise hrk3) lr lhs true ())) refl))
             refl))
         (have hrk4 (= (andb (le 0 n) (lt n 65536)) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (lt tag 65536)))
             ((steps ((rewrite (premise hrk3) lr lhs true ())) refl))
             refl))
         (have hn0 (= (le 0 n) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (lt n 65536)))
             ((steps ((rewrite (premise hrk4) lr lhs true ())) refl))
             refl))
         (have hnhi (= (lt n 65536) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (le 0 n)))
             ((steps ((rewrite (premise hrk4) lr lhs true ())) refl))
             refl))
         (have hco2 (= (cells_ok (Cons (MkHCell p 1 tag n fill) gc)) True)
           (steps
             ((unfold cells_ok lhs)
              (reduce lhs)
              (compute lhs (stop slots_ok haddrs ilen cells_ok andb))
              (rewrite (premise hso) lr lhs true ())
              (rewrite (premise 2) lr lhs true ())
              (rewrite (premise ht0) lr lhs true ())
              (rewrite (premise hthi) lr lhs true ())
              (rewrite (premise hn0) lr lhs true ())
              (rewrite (premise hnhi) lr lhs true ())
              (rewrite (premise hco) lr lhs true ())
              (compute lhs))
             refl))
         (have hnm (= (memb (haddrs gc) p) False)
           (rewrite-with
             (lemma cin0_nmemb)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hc0a) lr lhs true ())) refl))
             refl))
         (have hev (= (int_eq (mod p 2) 0) True)
           (rewrite-with
             (lemma mod8_even)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hal) lr lhs true ())) refl))
             refl))
         (have hcf (= (count_in fill p) 0)
           (rewrite-with
             (lemma slots_nmemb_cin)
             lr
             lhs
             ((inst older (haddrs gc)))
             ((steps ((rewrite (premise hso) lr lhs true ())) refl)
              (steps ((rewrite (premise hnm) lr lhs true ())) refl)
              (steps ((rewrite (premise hev) lr lhs true ())) refl))
             refl))
         (have hib (= (inbound_cells gc p) 0)
           (rewrite-with
             (lemma inb_zero)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((rewrite (premise hnm) lr lhs true ())) refl)
              (steps ((rewrite (premise hev) lr lhs true ())) refl))
             refl))
         (have hcng
           (= (counts_ok (gcells_of g) (gcells_of g) r (graw_of g)) True)
           (rewrite-with
             (lemma hi_cnts)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcn0 (= (counts_ok gc gc r (Some (MkHRaw p tag n fill))) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise 1) rl lhs true ())
              (rewrite (premise hcng) lr lhs true ()))
             refl))
         (have hcnt
           (= (counts_ok (Cons (MkHCell p 1 tag n fill) gc) gc r None) True)
           (rewrite-with
             (lemma counts_ok_seal_tl)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hcn0) lr lhs true ())) refl))
             refl))
         (have hcn2
           (=
             (counts_ok
               (Cons (MkHCell p 1 tag n fill) gc)
               (Cons (MkHCell p 1 tag n fill) gc)
               r
               None)
             True)
           (steps
             ((unfold counts_ok lhs)
              (reduce lhs)
              (compute
                lhs
                (stop count_in inbound_cells counts_ok raw_refs andb))
              (rewrite (premise 3) lr lhs true ())
              (unfold inbound_cells lhs)
              (reduce lhs)
              (compute
                lhs
                (stop count_in inbound_cells counts_ok raw_refs andb))
              (rewrite (premise hcf) lr lhs true ())
              (rewrite (premise hib) lr lhs true ())
              (unfold raw_refs lhs)
              (reduce lhs)
              (rewrite (premise hcnt) lr lhs true ())
              (compute lhs))
             refl))
         (have hrog (= (roots_ok r (haddrs (gcells_of g))) True)
           (rewrite-with
             (lemma hi_roots)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hro (= (roots_ok r (haddrs gc)) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hrog) lr lhs true ()))
             refl))
         (have hhp
           (= (haddrs (Cons (MkHCell p 1 tag n fill) gc)) (Cons p (haddrs gc)))
           (steps
             ((unfold haddrs lhs) (reduce lhs) (compute lhs (stop haddrs)))
             refl))
         (have hro3 (= (roots_ok r (Cons p (haddrs gc))) True)
           (rewrite-with
             (lemma roots_ok_cons_as)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hro) lr lhs true ())) refl))
             refl))
         (have hro2
           (= (roots_ok r (haddrs (Cons (MkHCell p 1 tag n fill) gc))) True)
           (steps
             ((rewrite (premise hhp) lr lhs true ())
              (rewrite (premise hro3) lr lhs true ()))
             refl))
         (steps
           ((rewrite (premise hsl) lr lhs true ())
            (unfold hinv lhs)
            (compute
              lhs
              (stop e_disj e_brk cells_ok counts_ok roots_ok raw_ok haddrs hexts
                fexts fexts_app ext_all andb))
            (rewrite (premise h1) lr lhs true ())
            (rewrite (premise h2) lr lhs true ())
            (rewrite (premise h3) lr lhs true ())
            (rewrite (premise h4) lr lhs true ())
            (rewrite (premise h5) lr lhs true ())
            (rewrite (premise h6) lr lhs true ())
            (rewrite (premise h7) lr lhs true ())
            (rewrite (premise hdj3) lr lhs true ())
            (rewrite (premise hbk3) lr lhs true ())
            (rewrite (premise hco2) lr lhs true ())
            (rewrite (premise hcn2) lr lhs true ())
            (rewrite (premise hro2) lr lhs true ())
            (unfold raw_ok lhs)
            (compute lhs))
           refl))))))

;; --- THE FILL LAWS -------------------------------------------------------------------
;; The engine step is B's (IpStoreW at the raw cell's next slot); these
;; are the rep and inv facts across the resulting store.

;; the bytes after the slot store mean the ghost with the fill grown by w
(claim hr_fill
  (goal
    ((m Mem)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (i Int)
     (w Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (ilen fill) i)
     (= (le 0 i) True)
     (= (lt i n) True)
     (= (le 0 w) True)
     (= (lt w 18446744073709551616) True))
    (=
      (heap_rep
        (store_le (iw8) m (+ p (+ 8 (* 8 i))) w)
        rb
        (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g))
      True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hB (= (+ p (+ 8 (* 8 i))) (+ (+ p 8) (* 8 i)))
           (by arith (list (list 1 0 0 0 0 0 0 0 0) (list 1 0 0 0 0 0 0 0 0))))
         (have hgr (= gr (Some (MkHRaw p tag n fill)))
           (steps
             ((rewrite (premise 2) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (have hg2
           (=
             (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g)
             (MkGHeap
               gc
               gf
               gl
               gt
               ge
               (Some (MkHRaw p tag n (iapp fill (Cons w Nil))))))
           (steps
             ((rewrite (hyp 0) lr lhs true ()) (compute lhs (stop iapp)))
             refl))
         (have hgl0 (= (glo_of g) gl)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgt0 (= (gtop_of g) gt)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hge0 (= (gend_of g) ge)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgc0 (= (gcells_of g) gc)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf0 (= (gfree_of g) gf)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have har (= (araw_ok g p tag n fill) True)
           (rewrite-with
             (lemma araw_facts)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hlog (= (le (glo_of g) p) True)
           (rewrite-with
             (lemma ar_lo)
             lr
             lhs
             ((inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hlo (= (le gl p) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hlog) lr lhs true ()))
             refl))
         (have hd1cg (= (e_disj1 p n (hexts (gcells_of g))) True)
           (rewrite-with
             (lemma ar_d1c)
             lr
             lhs
             ((inst tag tag) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hd1c (= (e_disj1 p n (hexts gc)) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hd1cg) lr lhs true ()))
             refl))
         (have hd1fg (= (e_disj1 p n (fexts (gfree_of g) 0)) True)
           (rewrite-with
             (lemma ar_d1f)
             lr
             lhs
             ((inst tag tag) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hd1f (= (e_disj1 p n (fexts gf 0)) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise hd1fg) lr lhs true ()))
             refl))
         (have hdbc (= (e_disj1 (+ p (+ 8 (* 8 i))) 0 (hexts gc)) True)
           (rewrite-with
             (lemma ed1_inner)
             lr
             lhs
             ((inst n n))
             ((steps ((rewrite (premise hd1c) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl))
             refl))
         (have hdbf (= (e_disj1 (+ p (+ 8 (* 8 i))) 0 (fexts gf 0)) True)
           (rewrite-with
             (lemma ed1_inner)
             lr
             lhs
             ((inst n n))
             ((steps ((rewrite (premise hd1f) lr lhs true ())) refl)
              (steps ((rewrite (premise 4) lr lhs true ())) refl)
              (steps ((rewrite (premise 5) lr lhs true ())) refl))
             refl))
         (have h2g (= (le (+ rb 152) (glo_of g)) True)
           (rewrite-with
             (lemma hi_hdr)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have h2 (= (le (+ rb 152) gl) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h2g) lr lhs true ()))
             refl))
         (have a1 (= (le (+ rb 8) (+ p (+ 8 (* 8 i)))) True)
           (by arith (rows (goal 1) (h2 1) (hlo 1) (4 8))))
         (have a2 (= (le (+ (+ rb 8) 8) (+ p (+ 8 (* 8 i)))) True)
           (by arith (rows (goal 1) (h2 1) (hlo 1) (4 8))))
         (have a3 (= (le (+ (+ rb 16) 8) (+ p (+ 8 (* 8 i)))) True)
           (by arith (rows (goal 1) (h2 1) (hlo 1) (4 8))))
         (have a4 (= (le (+ p 8) (+ p (+ 8 (* 8 i)))) True)
           (by arith (rows (goal 1) (4 8))))
         (have r1
           (=
             (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) rb)
             (load_le (iw8) m rb))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a1) lr lhs true ())) refl))
             refl))
         (have r1g (= (int_eq (load_le (iw8) m rb) (gtop_of g)) True)
           (rewrite-with
             (lemma hrx_top)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c1
           (=
             (int_eq
               (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) rb)
               gt)
             True)
           (steps
             ((rewrite (premise r1) lr lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise r1g) lr lhs true ()))
             refl))
         (have r2
           (=
             (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) (+ rb 8))
             (load_le (iw8) m (+ rb 8)))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a2) lr lhs true ())) refl))
             refl))
         (have r2g (= (int_eq (load_le (iw8) m (+ rb 8)) (gend_of g)) True)
           (rewrite-with
             (lemma hrx_end)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c2
           (=
             (int_eq
               (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) (+ rb 8))
               ge)
             True)
           (steps
             ((rewrite (premise r2) lr lhs true ())
              (rewrite (premise hge0) rl lhs true ())
              (rewrite (premise r2g) lr lhs true ()))
             refl))
         (have r3
           (=
             (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) (+ rb 16))
             (load_le (iw8) m (+ rb 16)))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a3) lr lhs true ())) refl))
             refl))
         (have r3g (= (int_eq (load_le (iw8) m (+ rb 16)) 0) True)
           (rewrite-with
             (lemma hrx_dep)
             lr
             lhs
             ((inst g g))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c3
           (=
             (int_eq
               (load_le
                 (iw8)
                 (store_le (iw8) m (+ p (+ 8 (* 8 i))) w)
                 (+ rb 16))
               0)
             True)
           (steps
             ((rewrite (premise r3) lr lhs true ())
              (rewrite (premise r3g) lr lhs true ()))
             refl))
         (have c4g (= (int_eq (fllen (gfree_of g)) 16) True)
           (rewrite-with
             (lemma hrx_fl16)
             lr
             lhs
             ((inst m m) (inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have c4 (= (int_eq (fllen gf) 16) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise c4g) lr lhs true ()))
             refl))
         (have f16e (= (fllen gf) 16)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 16))
             ((steps ((rewrite (premise c4) lr lhs true ())) refl))
             refl))
         (have hfrg (= (hfree_rep m rb 0 (gfree_of g)) True)
           (rewrite-with
             (lemma hrx_free)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hfr (= (hfree_rep m rb 0 gf) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise hfrg) lr lhs true ()))
             refl))
         (have hor2a
           (= (le (+ rb (+ 24 (* 8 (+ 0 16)))) (+ p (+ 8 (* 8 i)))) True)
           (by arith (rows (goal 1) (h2 1) (hlo 1) (4 8))))
         (have hor
           (=
             (orb
               (le (+ (+ p (+ 8 (* 8 i))) 8) (+ rb (+ 24 (* 8 0))))
               (le (+ rb (+ 24 (* 8 (+ 0 (fllen gf))))) (+ p (+ 8 (* 8 i)))))
             True)
           (rewrite-with
             (lemma orb_intro_r)
             lr
             lhs
             ()
             ((steps
                ((rewrite (premise f16e) lr lhs true ())
                 (rewrite (premise hor2a) lr lhs true ()))
                refl))
             refl))
         (have c5
           (= (hfree_rep (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) rb 0 gf) True)
           (rewrite-with
             (lemma hfree_rep_fr)
             lr
             lhs
             ((inst nb 0))
             ((steps ((rewrite (premise hfr) lr lhs true ())) refl)
              (steps ((rewrite (premise hdbf) lr lhs true ())) refl)
              (steps ((rewrite (premise hor) lr lhs true ())) refl)
              (steps ((compute lhs)) refl)
              (steps ((compute lhs)) refl))
             refl))
         (have hcrg (= (hcells_rep m (gcells_of g)) True)
           (rewrite-with
             (lemma hrx_cells)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcr (= (hcells_rep m gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcrg) lr lhs true ()))
             refl))
         (have hcog (= (cells_ok (gcells_of g)) True)
           (rewrite-with
             (lemma hi_cells)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hco (= (cells_ok gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcog) lr lhs true ()))
             refl))
         (have c6
           (= (hcells_rep (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) gc) True)
           (rewrite-with
             (lemma hcells_rep_fr)
             lr
             lhs
             ((inst nb 0))
             ((steps ((rewrite (premise hcr) lr lhs true ())) refl)
              (steps ((rewrite (premise hdbc) lr lhs true ())) refl)
              (steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((compute lhs)) refl))
             refl))
         (have hrwg (= (hraw_rep m (graw_of g)) True)
           (rewrite-with
             (lemma hrx_raw)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hrw (= (hraw_rep m (Some (MkHRaw p tag n fill))) True)
           (steps
             ((rewrite (premise 2) rl lhs true ())
              (rewrite (premise hrwg) lr lhs true ()))
             refl))
         (have hhd
           (=
             (int_eq
               (load_le (iw8) m (raddr_of (MkHRaw p tag n fill)))
               (rword (MkHRaw p tag n fill)))
             True)
           (rewrite-with
             (lemma hrw_hdr)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hrw) lr lhs true ())) refl))
             refl))
         (have hhd2 (= (int_eq (load_le (iw8) m p) (hdr_word tag n)) True)
           (steps
             ((rewrite (premise hhd) rl rhs true ())
              (rewrite (lemma hdr_rword) lr rhs true ())
              (compute rhs (stop iw8 load_le hdr_word)))
             refl))
         (have rp
           (=
             (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) p)
             (load_le (iw8) m p))
           (rewrite-with
             (lemma ldw_below)
             lr
             lhs
             ()
             ((steps ((rewrite (premise a4) lr lhs true ())) refl))
             refl))
         (have hhd3
           (=
             (int_eq
               (load_le (iw8) (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) p)
               (hdr_word tag n))
             True)
           (steps
             ((rewrite (premise rp) lr lhs true ())
              (rewrite (premise hhd2) lr lhs true ()))
             refl))
         (have hsl0
           (=
             (hslots_rep
               m
               (+ (raddr_of (MkHRaw p tag n fill)) 8)
               (rfill_of (MkHRaw p tag n fill)))
             True)
           (rewrite-with
