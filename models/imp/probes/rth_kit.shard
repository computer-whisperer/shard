;; the pop leg's fact bundle
(claim ap_lo
  (goal ((g GHeap) (tag Int) (n Int) (p Int) (rest (List Int)))
    ((= (apop_ok g tag n p rest) True))
    (= (le (glo_of g) p) True))
  (chain
    (have h0
      (=
        (andb
          (le (glo_of g) p)
          (andb
            (le (+ p (+ 8 (* 8 n))) (gtop_of g))
            (andb
              (int_eq (mod p 8) 0)
              (andb
                (int_eq (count_in (haddrs (gcells_of g)) p) 0)
                (andb
                  (int_eq (count_in (faddrs (fl_set (gfree_of g) n rest)) p) 0)
                  (andb
                    (eall (ext_all (gh_alloc_pop g tag n)) (ext_all g))
                    (andb
                      (anodup (e_addrs (ext_all (gh_alloc_pop g tag n))))
                      (andb
                        (emem (ext_all g) p n)
                        (andb
                          (eall
                            (fexts (fl_set (gfree_of g) n rest) 0)
                            (ext_all g))
                          (eall (hexts (gcells_of g)) (ext_all g)))))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold apop_ok rhs) (reduce rhs))
        refl))
    (have hx (= (le (glo_of g) p) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (le (+ p (+ 8 (* 8 n))) (gtop_of g))
             (andb
               (int_eq (mod p 8) 0)
               (andb
                 (int_eq (count_in (haddrs (gcells_of g)) p) 0)
                 (andb
                   (int_eq (count_in (faddrs (fl_set (gfree_of g) n rest)) p) 0)
                   (andb
                     (eall (ext_all (gh_alloc_pop g tag n)) (ext_all g))
                     (andb
                       (anodup (e_addrs (ext_all (gh_alloc_pop g tag n))))
                       (andb
                         (emem (ext_all g) p n)
                         (andb
                           (eall
                             (fexts (fl_set (gfree_of g) n rest) 0)
                             (ext_all g))
                           (eall (hexts (gcells_of g)) (ext_all g))))))))))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

