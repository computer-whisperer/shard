              (rewrite (premise hodd) lr rhs true ())
              (reduce rhs))
             refl))
         (have hri (= (rinc r v) (Cons v r))
           (steps
             ((unfold rinc lhs)
              (rewrite (premise hodd) lr lhs true ())
              (reduce lhs))
             refl))
