;; THE HEAP-INVARIANT PRESERVATION LAW (Theorem B cites this)
(claim hinv_dec
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (graw_of g) None) (= (memb r v) True))
    (= (hinv rb (gh_dec g v) (irem r v)) True))
  (rewrite-with
    (lemma andb_l)
    lr
    lhs
    ((inst b (hsubq (gcells_of (gh_dec g v)) (gcells_of g))))
    ((rewrite-with
       (lemma hinv_dec_full)
       lr
       lhs
       ((inst rb rb))
       ((steps ((rewrite (premise 0) lr lhs true ())) refl)
        (steps ((rewrite (premise 1) lr lhs true ())) refl)
        (steps ((rewrite (premise 2) lr lhs true ())) refl))
       refl))
    refl))

;; THE SURVIVOR-FRAMING LAW: structure survives, counts may only fall
(claim dec_sub
  (goal ((rb Int) (g GHeap) (r (List Int)) (v Int))
    ((= (hinv rb g r) True) (= (graw_of g) None) (= (memb r v) True))
    (= (hsubq (gcells_of (gh_dec g v)) (gcells_of g)) True))
  (rewrite-with
    (lemma andb_r)
    lr
    lhs
    ((inst a (hinv rb (gh_dec g v) (irem r v))))
    ((rewrite-with
       (lemma hinv_dec_full)
       lr
       lhs
       ((inst rb rb))
       ((steps ((rewrite (premise 0) lr lhs true ())) refl)
        (steps ((rewrite (premise 1) lr lhs true ())) refl)
        (steps ((rewrite (premise 2) lr lhs true ())) refl))
       refl))
    refl))
