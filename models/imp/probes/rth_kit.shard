                 (rewrite (premise hfc0) lr lhs true ()))
                refl))
             refl))
         (have hcz (= (count_in (iapp (haddrs gc) (iapp (faddrs gf) Nil)) p) 0)
           (steps
             ((rewrite (lemma cin_iapp) lr lhs true ())
              (rewrite (lemma cin_iapp) lr lhs true ())
              (rewrite (premise hc0a) lr lhs true ())
              (rewrite (premise hc0f) lr lhs true ())
              (compute lhs))
             refl))
         (have hms0
           (=
             (msub
               (iapp (iapp (haddrs gc) (faddrs gf)) (Cons p Nil))
               (iapp (iapp (haddrs gc) (faddrs gf)) (Cons p Nil)))
             True)
           (rewrite-with (lemma msub_refl) lr lhs () () refl))
         (have hms1
