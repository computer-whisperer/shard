             ((steps ((rewrite (premise hbkc) lr lhs true ())) refl)
              (steps ((rewrite (premise hHlo2) lr lhs true ())) refl))
             refl))
         (have h6a
           (=
             (hcells_rep
               (store_le (iw8) m (+ rb (+ 24 (* 8 n))) (hhead rest))
               gc)
             True)
           (rewrite-with
             (lemma hcells_rep_fr)
             lr
             lhs
             ((inst nb 0))
             ((steps ((rewrite (premise hcr) lr lhs true ())) refl)
              (steps ((rewrite (premise hdHc) lr lhs true ())) refl)
              (steps ((rewrite (premise hco) lr lhs true ())) refl)
              (steps ((compute lhs)) refl))
