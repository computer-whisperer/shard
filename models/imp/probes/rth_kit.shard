  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (w Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (lt (ilen fill) n) True)
     (= (int_eq (mod w 2) 1) True))
    (=
