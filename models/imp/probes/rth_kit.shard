                     (reduce rhs)
                     (rewrite (hyp False) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hcc
                  (=
                    (count_in (Cons (haddr_of c) (haddrs rest)) w)
                    (count_in (haddrs rest) w))
                  (steps
                    ((unfold count_in lhs)
                     (reduce lhs)
                     (rewrite (hyp False) lr lhs true ())
                     (reduce lhs))
                    refl))
