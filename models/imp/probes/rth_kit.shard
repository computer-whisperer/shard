                 (fexts_app (hexts gc) (fexts_app (fexts gf 0) Nil))))
             (Cons p (iapp (haddrs gc) (iapp (faddrs gf) Nil))))
           (steps
             ((unfold e_addrs lhs)
              (reduce lhs)
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma eaddrs_app) lr lhs true ())
              (rewrite (lemma hexts_eaddrs) lr lhs true ())
              (rewrite (lemma fexts_addrs) lr lhs true ())
              (compute lhs (stop haddrs faddrs iapp)))
             refl))
         (have hc0a (= (count_in (haddrs gc) p) 0)
