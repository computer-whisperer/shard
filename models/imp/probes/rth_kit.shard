             refl))
         (have c5 (= (hfree_rep m rb 0 gf) True)
           (steps
             ((rewrite (premise hgf0) rl lhs true ())
              (rewrite (premise c5g) lr lhs true ()))
             refl))
         (have hcrg (= (hcells_rep m (gcells_of g)) True)
           (rewrite-with
             (lemma hrx_cells)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hcr (= (hcells_rep m gc) True)
           (steps
             ((rewrite (premise hgc0) rl lhs true ())
              (rewrite (premise hcrg) lr lhs true ()))
             refl))
         (have hrwg (= (hraw_rep m (graw_of g)) True)
           (rewrite-with
             (lemma hrx_raw)
             lr
             lhs
             ((inst rb rb))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hrw (= (hraw_rep m (Some (MkHRaw p tag n fill))) True)
           (steps
             ((rewrite (premise 1) rl lhs true ())
              (rewrite (premise hrwg) lr lhs true ()))
             refl))
         (have hhd
           (=
             (int_eq
               (load_le (iw8) m (raddr_of (MkHRaw p tag n fill)))
               (rword (MkHRaw p tag n fill)))
             True)
           (rewrite-with
