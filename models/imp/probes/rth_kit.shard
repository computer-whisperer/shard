(claim ebrk_memb
  (goal ((es (List (Pair Int Int))) (lo Int) (top Int) (b Int) (k Int))
    ((= (e_brk es lo top) True) (= (emem es b k) True))
    (= (andb (le lo b) (andb (le (+ b (+ 8 (* 8 k))) top) (le 0 k))) True))
  (induct es
    ((case Nil
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold emem rhs)
              (reduce rhs))
             refl))
         (absurd (premise hf))))
     (case Cons
       (e rest)
       (case-on e Pair
         ((case Pair
            (c m)
            (chain
              (have hbrk
                (=
                  (andb
                    (le lo c)
                    (andb
                      (le (+ c (+ 8 (* 8 m))) top)
                      (andb
                        (int_eq (mod c 8) 0)
                        (andb (le 0 m) (e_brk rest lo top)))))
