;; hinv, clause by clause
(claim hi_rb0
  (goal ((rb Int) (g GHeap) (r (List Int))) ((= (hinv rb g r) True))
    (= (le 0 rb) True))
  (chain
    (have h0
      (=
        (andb
          (le 0 rb)
          (andb
            (le (+ rb 152) (glo_of g))
            (andb
              (le (glo_of g) (gtop_of g))
              (andb
                (le (gtop_of g) (gend_of g))
                (andb
                  (le (gend_of g) 4294967296)
                  (andb
                    (int_eq (mod (glo_of g) 8) 0)
                    (andb
                      (int_eq (mod (gtop_of g) 8) 0)
                      (andb
                        (e_disj (ext_all g))
                        (andb
                          (e_brk (ext_all g) (glo_of g) (gtop_of g))
                          (andb
                            (cells_ok (gcells_of g))
                            (andb
                              (counts_ok
                                (gcells_of g)
                                (gcells_of g)
                                r
                                (graw_of g))
                              (andb
                                (roots_ok r (haddrs (gcells_of g)))
                                (raw_ok (graw_of g) (gcells_of g))))))))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold hinv rhs) (reduce rhs))
        refl))
    (have hx (= (le 0 rb) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (le (+ rb 152) (glo_of g))
             (andb
               (le (glo_of g) (gtop_of g))
               (andb
                 (le (gtop_of g) (gend_of g))
                 (andb
                   (le (gend_of g) 4294967296)
                   (andb
                     (int_eq (mod (glo_of g) 8) 0)
                     (andb
                       (int_eq (mod (gtop_of g) 8) 0)
                       (andb
                         (e_disj (ext_all g))
                         (andb
                           (e_brk (ext_all g) (glo_of g) (gtop_of g))
                           (andb
                             (cells_ok (gcells_of g))
                             (andb
                               (counts_ok
                                 (gcells_of g)
                                 (gcells_of g)
                                 r
                                 (graw_of g))
                               (andb
                                 (roots_ok r (haddrs (gcells_of g)))
                                 (raw_ok (graw_of g) (gcells_of g)))))))))))))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

