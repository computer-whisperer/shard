                       (le (+ c (+ 8 (* 8 m))) top)
                       (andb
                         (int_eq (mod c 8) 0)
                         (andb (le 0 m) (e_brk rest lo top))))))
                  ((steps ((rewrite (premise hbrk) lr lhs true ())) refl))
                  refl))
              (have h2r
                (=
                  (andb
                    (le (+ c (+ 8 (* 8 m))) top)
                    (andb
                      (int_eq (mod c 8) 0)
                      (andb (le 0 m) (e_brk rest lo top))))
                  True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le lo c)))
                  ((steps ((rewrite (premise hbrk) lr lhs true ())) refl))
                  refl))
              (have h2 (= (le (+ c (+ 8 (* 8 m))) top) True)
                (rewrite-with
                  (lemma andb_l)
                  lr
                  lhs
                  ((inst
                     b
                     (andb
                       (int_eq (mod c 8) 0)
                       (andb (le 0 m) (e_brk rest lo top)))))
                  ((steps ((rewrite (premise h2r) lr lhs true ())) refl))
                  refl))
              (have h3r
                (=
                  (andb
                    (int_eq (mod c 8) 0)
                    (andb (le 0 m) (e_brk rest lo top)))
                  True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le (+ c (+ 8 (* 8 m))) top)))
                  ((steps ((rewrite (premise h2r) lr lhs true ())) refl))
                  refl))
              (have h4r (= (andb (le 0 m) (e_brk rest lo top)) True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (int_eq (mod c 8) 0)))
                  ((steps ((rewrite (premise h3r) lr lhs true ())) refl))
                  refl))
              (have h4 (= (le 0 m) True)
                (rewrite-with
                  (lemma andb_l)
                  lr
                  lhs
                  ((inst b (e_brk rest lo top)))
                  ((steps ((rewrite (premise h4r) lr lhs true ())) refl))
                  refl))
              (have h5 (= (e_brk rest lo top) True)
                (rewrite-with
                  (lemma andb_r)
                  lr
                  lhs
                  ((inst a (le 0 m)))
                  ((steps ((rewrite (premise h4r) lr lhs true ())) refl))
                  refl))
              (case-on (andb (int_eq c b) (int_eq m k)) Bool
                ((case True
                   (chain
                     (have hcb (= (int_eq c b) True)
                       (rewrite-with
                         (lemma andb_l)
                         lr
                         lhs
                         ((inst b (int_eq m k)))
                         ((steps ((rewrite (hyp True) lr lhs true ())) refl))
                         refl))
                     (have hmk (= (int_eq m k) True)
                       (rewrite-with
                         (lemma andb_r)
                         lr
                         lhs
                         ((inst a (int_eq c b)))
                         ((steps ((rewrite (hyp True) lr lhs true ())) refl))
                         refl))
                     (have heb (= c b)
                       (rewrite-with
                         (lemma int_eq_eq)
                         lr
                         lhs
                         ((inst b b))
                         ((steps ((rewrite (premise hcb) lr lhs true ())) refl))
                         refl))
                     (have hek (= m k)
                       (rewrite-with
                         (lemma int_eq_eq)
                         lr
                         lhs
                         ((inst b k))
