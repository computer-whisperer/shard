              (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))
          (counts_ok all rest r raw))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold counts_ok rhs)
         (reduce rhs))
        refl))
    (have hx
      (=
        (if (le 2147483648 (hcount_of c)) True
        (int_eq
          (hcount_of c)
          (+
            (count_in r (haddr_of c))
            (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))
        True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (counts_ok all rest r raw)))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

