;; cells_ok, clause by clause
(claim co_slots
  (goal ((c HCell) (rest (List HCell))) ((= (cells_ok (Cons c rest)) True))
    (= (slots_ok (hslots_of c) (haddrs rest)) True))
  (chain
    (have h0
      (=
        (andb
          (slots_ok (hslots_of c) (haddrs rest))
          (andb
            (int_eq (ilen (hslots_of c)) (harity_of c))
            (andb
              (le 1 (hcount_of c))
              (andb
                (lt (hcount_of c) 4294967296)
                (andb
                  (le 0 (htag_of c))
                  (andb
                    (lt (htag_of c) 65536)
                    (andb
                      (le 0 (harity_of c))
                      (andb (lt (harity_of c) 65536) (cells_ok rest)))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold cells_ok rhs)
         (reduce rhs))
        refl))
    (have hx (= (slots_ok (hslots_of c) (haddrs rest)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (int_eq (ilen (hslots_of c)) (harity_of c))
             (andb
               (le 1 (hcount_of c))
               (andb
                 (lt (hcount_of c) 4294967296)
                 (andb
                   (le 0 (htag_of c))
                   (andb
                     (lt (htag_of c) 65536)
                     (andb
                       (le 0 (harity_of c))
                       (andb (lt (harity_of c) 65536) (cells_ok rest))))))))))
        ((steps ((rewrite (premise h0) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

