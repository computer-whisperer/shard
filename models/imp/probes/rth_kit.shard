            (hfree_rep m rb 0 (gfree_of g))
            (andb (hcells_rep m (gcells_of g)) (hraw_rep m (graw_of g)))))
        True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (int_eq (load_le (iw8) m (+ rb 16)) 0)))
        ((steps ((rewrite (premise h2) lr lhs true ())) refl))
        refl))
    (have hx (= (int_eq (fllen (gfree_of g)) 16) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (hfree_rep m rb 0 (gfree_of g))
             (andb (hcells_rep m (gcells_of g)) (hraw_rep m (graw_of g))))))
        ((steps ((rewrite (premise h3) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hx) lr lhs true ())) refl)))

