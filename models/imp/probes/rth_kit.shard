        (mod (+ (gtop_of g) (+ 8 (* n 8))) 18446744073709551616)
        (+ (gtop_of g) (+ 8 (* n 8))))
      (rewrite-with
        (lemma modu64_id)
        lr
        lhs
        ()
        ((by arith (rows (goal 1) (h1 1) (h2 1) (h3 1) (4 8)))
         (by arith (rows (goal 1) (h4 1) (h5 1) (5 8))))
        refl))
    (have hfitE (= (le (+ (gtop_of g) (+ 8 (* n 8))) (gend_of g)) False)
      (by arith (rows (goal 1) (8 1))))
    (steps
      ((compute lhs (stop iw8 hhead gtop_of gend_of))
       (rewrite (premise 11) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8 hhead gtop_of gend_of))
       (rewrite (premise hmtag) lr lhs true ())
       (rewrite (premise hmn) lr lhs true ())
       (rewrite (premise 3) lr lhs true ())
       (compute lhs (stop iw8 hhead gtop_of gend_of))
       (rewrite (premise hb0) lr lhs true ())
       (rewrite (premise 9) lr lhs true ())
       (reduce lhs)
       (rewrite (premise hh0) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8 hhead gtop_of gend_of))
       (rewrite (premise hrdT) lr lhs true ())
       (rewrite (premise hb1) lr lhs true ())
       (rewrite (premise hl1) lr lhs true ())
       (reduce lhs)
       (rewrite (premise hh1) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop iw8 hhead gtop_of gend_of))
       (rewrite (premise hrdE) lr lhs true ())
       (rewrite (premise hm8n) lr lhs true ())
       (rewrite (premise hm8s) lr lhs true ())
       (rewrite (premise hmsum) lr lhs true ())
       (rewrite (premise hfitE) lr lhs true ())
       (compute lhs (stop iw8 hhead gtop_of gend_of)))
      refl)))

;; --- THE ALLOC LAW: the one engine equation ------------------------------------------
;; alloc_out's three shapes over a destructured ghost, then the dispatch:
;; B cites rth_alloc_run once and splits on gh_alloc_ok.

(claim alloc_out_pop
  (goal
    ((m Mem)
     (rb Int)
     (gc (List HCell))
     (gf (List (List Int)))
     (gl Int)
     (gt Int)
     (ge Int)
     (gr (Option HRaw))
     (tag Int)
     (n Int)
     (p Int)
     (rest (List Int)))
    ((= (lt n 16) True) (= (fl_at gf n) (Cons p rest)))
    (=
      (alloc_out m rb (MkGHeap gc gf gl gt ge gr) tag n)
      (Some (IpRv p (m_apop m rb n (hhead rest) p tag)))))
  (chain
    (have hok (= (gh_alloc_ok (MkGHeap gc gf gl gt ge gr) n) True)
      (steps
        ((unfold gh_alloc_ok lhs)
         (rewrite (premise 0) lr lhs true ())
         (reduce lhs)
         (compute lhs (stop fl_at gh_fits))
         (rewrite (premise 1) lr lhs true ())
         (reduce lhs))
        refl))
    (have hga
      (=
        (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
        (MkGHeap gc (fl_set gf n rest) gl gt ge (Some (MkHRaw p tag n Nil))))
      (rewrite-with
        (lemma gh_alloc_form_pop)
        lr
        lhs
        ((inst p p) (inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hma
      (=
        (m_alloc m rb (MkGHeap gc gf gl gt ge gr) tag n)
        (m_apop m rb n (hhead rest) p tag))
      (steps
        ((unfold m_alloc lhs)
         (rewrite (premise 0) lr lhs true ())
         (reduce lhs)
         (compute lhs (stop fl_at m_apop m_abump hhead))
         (rewrite (premise 1) lr lhs true ())
         (reduce lhs))
        refl))
    (steps
      ((unfold alloc_out lhs)
       (rewrite (premise hok) lr lhs true ())
       (reduce lhs)
       (rewrite (premise hga) lr lhs true ())
       (rewrite (premise hma) lr lhs true ())
       (unfold gh_araddr lhs)
       (compute lhs (stop m_apop hhead fl_set)))
      refl)))

(claim alloc_out_bump
  (goal
    ((m Mem)
     (rb Int)
     (gc (List HCell))
     (gf (List (List Int)))
     (gl Int)
     (gt Int)
     (ge Int)
     (gr (Option HRaw))
     (tag Int)
     (n Int))
    ((= (if (lt n 16) (fl_at gf n) Nil) Nil)
     (= (le (+ gt (+ 8 (* 8 n))) ge) True))
    (=
      (alloc_out m rb (MkGHeap gc gf gl gt ge gr) tag n)
      (Some (IpRv gt (m_abump m rb gt n tag)))))
  (chain
    (have hfits (= (gh_fits (MkGHeap gc gf gl gt ge gr) n) True)
      (steps
        ((unfold gh_fits lhs)
         (compute lhs)
         (rewrite (premise 1) lr lhs true ()))
        refl))
    (have hok (= (gh_alloc_ok (MkGHeap gc gf gl gt ge gr) n) True)
      (case-on (lt n 16) Bool
        ((case True
           (chain
             (have hn (= (fl_at gf n) Nil)
               (steps
                 ((rewrite (premise 0) rl rhs true ())
                  (rewrite (hyp True) lr rhs true ())
                  (reduce rhs))
                 refl))
             (steps
               ((unfold gh_alloc_ok lhs)
                (rewrite (hyp True) lr lhs true ())
                (reduce lhs)
                (compute lhs (stop fl_at gh_fits))
                (rewrite (premise hn) lr lhs true ())
                (reduce lhs)
                (rewrite (premise hfits) lr lhs true ()))
               refl)))
         (case False
           (steps
             ((unfold gh_alloc_ok lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hfits) lr lhs true ()))
             refl)))))
    (have hga
      (=
        (gh_alloc (MkGHeap gc gf gl gt ge gr) tag n)
        (MkGHeap gc gf gl (+ gt (+ 8 (* 8 n))) ge (Some (MkHRaw gt tag n Nil))))
      (rewrite-with
        (lemma gh_alloc_form_bump)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hgt (= (gtop_of (MkGHeap gc gf gl gt ge gr)) gt)
      (steps ((compute lhs)) refl))
    (have hma
      (=
        (m_alloc m rb (MkGHeap gc gf gl gt ge gr) tag n)
        (m_abump m rb gt n tag))
      (case-on (lt n 16) Bool
        ((case True
           (chain
             (have hn (= (fl_at gf n) Nil)
               (steps
                 ((rewrite (premise 0) rl rhs true ())
                  (rewrite (hyp True) lr rhs true ())
                  (reduce rhs))
                 refl))
             (steps
               ((unfold m_alloc lhs)
                (rewrite (hyp True) lr lhs true ())
                (reduce lhs)
                (compute lhs (stop fl_at m_apop m_abump hhead))
                (rewrite (premise hn) lr lhs true ())
                (reduce lhs)
                (rewrite (premise hgt) lr lhs true ()))
               refl)))
         (case False
           (steps
             ((unfold m_alloc lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs)
              (compute lhs (stop m_apop m_abump)))
             refl)))))
    (steps
      ((unfold alloc_out lhs)
       (rewrite (premise hok) lr lhs true ())
       (reduce lhs)
       (rewrite (premise hga) lr lhs true ())
       (rewrite (premise hma) lr lhs true ())
       (unfold gh_araddr lhs)
       (compute lhs (stop m_abump)))
      refl)))

(claim alloc_out_oom
  (goal
    ((m Mem)
     (rb Int)
     (gc (List HCell))
     (gf (List (List Int)))
     (gl Int)
     (gt Int)
     (ge Int)
     (gr (Option HRaw))
     (tag Int)
     (n Int))
    ((= (if (lt n 16) (fl_at gf n) Nil) Nil)
     (= (le (+ gt (+ 8 (* 8 n))) ge) False))
    (=
      (alloc_out m rb (MkGHeap gc gf gl gt ge gr) tag n)
      (Some (IpRfailed FOom))))
  (chain
    (have hfits (= (gh_fits (MkGHeap gc gf gl gt ge gr) n) False)
      (steps
        ((unfold gh_fits lhs)
         (compute lhs)
         (rewrite (premise 1) lr lhs true ()))
        refl))
    (have hok (= (gh_alloc_ok (MkGHeap gc gf gl gt ge gr) n) False)
      (case-on (lt n 16) Bool
        ((case True
           (chain
             (have hn (= (fl_at gf n) Nil)
               (steps
                 ((rewrite (premise 0) rl rhs true ())
                  (rewrite (hyp True) lr rhs true ())
                  (reduce rhs))
                 refl))
             (steps
               ((unfold gh_alloc_ok lhs)
                (rewrite (hyp True) lr lhs true ())
                (reduce lhs)
                (compute lhs (stop fl_at gh_fits))
                (rewrite (premise hn) lr lhs true ())
                (reduce lhs)
                (rewrite (premise hfits) lr lhs true ()))
               refl)))
         (case False
           (steps
             ((unfold gh_alloc_ok lhs)
              (rewrite (hyp False) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hfits) lr lhs true ()))
             refl)))))
    (steps
      ((unfold alloc_out lhs)
       (rewrite (premise hok) lr lhs true ())
       (reduce lhs))
      refl)))

;; THE ALLOC LAW: under heap_rep + hinv with no raw cell, the call to
;; rt_alloc(tag, n) is alloc_out — the raw address over m_alloc when the
;; allocation lands, the oom failure otherwise
(claim rth_alloc_run
  (goal
    ((fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (m Mem)
     (tag Int)
     (n Int)
     (fuel Nat))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) None)
     (= (le 0 n) True)
     (= (lt n 65536) True)
     (= (le 0 tag) True)
     (= (lt tag 65536) True)
     (= (le mlo rb) True)
     (= (le (gend_of g) msz) True)
     (= (lt d dmax) True))
    (=
      (ipcall
        (nS 12 (ntl 12 fuel))
        (rt_app (rt_fns rb) fs)
        mlo
        msz
        dmax
        d
        1
        (Cons tag (Cons n Nil))
        m)
      (alloc_out m rb g tag n)))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (case-on (lt n 16) Bool
         ((case True
            (case-on (fl_at gf n) List
              ((case Nil
                 (case-on (le (+ gt (+ 8 (* 8 n))) ge) Bool
                   ((case True
                      (chain
                        (have hn16 (= (lt n 16) True)
                          (steps ((rewrite (hyp 2) lr lhs true ())) refl))
                        (have hfl (= (fl_at (gfree_of g) n) Nil)
                          (steps
                            ((rewrite (hyp 3) lr lhs true ())
                             (compute lhs (stop fl_at))
                             (rewrite (hyp 1) lr lhs true ()))
                            refl))
                        (have hfit
                          (=
                            (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g))
                            True)
                          (steps
                            ((rewrite (hyp 3) lr lhs true ())
                             (compute lhs)
                             (rewrite (hyp 0) lr lhs true ()))
                            refl))
                        (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                          (steps
                            ((rewrite (hyp 2) lr lhs true ())
                             (reduce lhs)
                             (rewrite (hyp 1) lr lhs true ()))
                            refl))
                        (have hleg
                          (=
                            (ipcall
                              (nS 12 (ntl 12 fuel))
                              (rt_app (rt_fns rb) fs)
                              mlo
                              msz
                              dmax
                              d
                              1
                              (Cons tag (Cons n Nil))
                              m)
                            (Some
                              (IpRv
                                (gtop_of g)
                                (m_abump m rb (gtop_of g) n tag))))
                          (rewrite-with
                            (lemma rth_alloc_bump_run)
                            lr
                            lhs
                            ((inst g g) (inst r r))
                            ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                             (steps ((rewrite (premise 1) lr lhs true ())) refl)
                             (steps ((rewrite (premise 2) lr lhs true ())) refl)
                             (steps
                               ((rewrite (premise hfl) lr lhs true ()))
                               refl)
                             (steps
                               ((rewrite (premise hn16) lr lhs true ()))
                               refl)
                             (steps ((rewrite (premise 3) lr lhs true ())) refl)
                             (steps ((rewrite (premise 4) lr lhs true ())) refl)
                             (steps ((rewrite (premise 5) lr lhs true ())) refl)
                             (steps ((rewrite (premise 6) lr lhs true ())) refl)
                             (steps
                               ((rewrite (premise hfit) lr lhs true ()))
                               refl)
                             (steps ((rewrite (premise 7) lr lhs true ())) refl)
                             (steps ((rewrite (premise 8) lr lhs true ())) refl)
                             (steps ((rewrite (premise 9) lr lhs true ())) refl))
                            refl))
                        (have hout
                          (=
                            (alloc_out m rb (MkGHeap gc gf gl gt ge gr) tag n)
                            (Some (IpRv gt (m_abump m rb gt n tag))))
                          (rewrite-with
                            (lemma alloc_out_bump)
                            lr
                            lhs
                            ()
                            ((steps
                               ((rewrite (premise hsel) lr lhs true ()))
                               refl)
                             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            refl))
                        (steps
                          ((rewrite (premise hleg) lr lhs true ())
                           (rewrite (hyp 3) lr both true ())
                           (compute lhs (stop m_abump))
                           (rewrite (premise hout) lr rhs true ()))
                          refl)))
                    (case False
                      (chain
                        (have hn16 (= (lt n 16) True)
                          (steps ((rewrite (hyp 2) lr lhs true ())) refl))
                        (have hfl (= (fl_at (gfree_of g) n) Nil)
                          (steps
                            ((rewrite (hyp 3) lr lhs true ())
                             (compute lhs (stop fl_at))
                             (rewrite (hyp 1) lr lhs true ()))
                            refl))
                        (have hfit
                          (=
                            (le (+ (gtop_of g) (+ 8 (* 8 n))) (gend_of g))
                            False)
                          (steps
                            ((rewrite (hyp 3) lr lhs true ())
                             (compute lhs)
                             (rewrite (hyp 0) lr lhs true ()))
                            refl))
                        (have hsel (= (if (lt n 16) (fl_at gf n) Nil) Nil)
                          (steps
                            ((rewrite (hyp 2) lr lhs true ())
                             (reduce lhs)
                             (rewrite (hyp 1) lr lhs true ()))
                            refl))
                        (have hleg
                          (=
                            (ipcall
                              (nS 12 (ntl 12 fuel))
                              (rt_app (rt_fns rb) fs)
                              mlo
                              msz
                              dmax
                              d
                              1
                              (Cons tag (Cons n Nil))
                              m)
                            (Some (IpRfailed FOom)))
                          (rewrite-with
                            (lemma rth_alloc_oom_run)
                            lr
                            lhs
                            ((inst g g) (inst r r))
                            ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                             (steps ((rewrite (premise 1) lr lhs true ())) refl)
                             (steps ((rewrite (premise 2) lr lhs true ())) refl)
                             (steps
                               ((rewrite (premise hfl) lr lhs true ()))
                               refl)
                             (steps
                               ((rewrite (premise hn16) lr lhs true ()))
                               refl)
                             (steps ((rewrite (premise 3) lr lhs true ())) refl)
                             (steps ((rewrite (premise 4) lr lhs true ())) refl)
                             (steps ((rewrite (premise 5) lr lhs true ())) refl)
                             (steps ((rewrite (premise 6) lr lhs true ())) refl)
                             (steps
                               ((rewrite (premise hfit) lr lhs true ()))
                               refl)
                             (steps ((rewrite (premise 7) lr lhs true ())) refl)
                             (steps ((rewrite (premise 8) lr lhs true ())) refl)
                             (steps ((rewrite (premise 9) lr lhs true ())) refl))
                            refl))
                        (have hout
                          (=
                            (alloc_out m rb (MkGHeap gc gf gl gt ge gr) tag n)
                            (Some (IpRfailed FOom)))
                          (rewrite-with
                            (lemma alloc_out_oom)
                            lr
                            lhs
                            ()
                            ((steps
                               ((rewrite (premise hsel) lr lhs true ()))
                               refl)
                             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            refl))
                        (steps
                          ((rewrite (premise hleg) lr lhs true ())
                           (rewrite (hyp 3) lr both true ())
                           (rewrite (premise hout) lr rhs true ()))
                          refl))))))
               (case Cons
                 (p rest)
                 (chain
                   (have hn16 (= (lt n 16) True)
                     (steps ((rewrite (hyp 1) lr lhs true ())) refl))
                   (have hfl (= (fl_at (gfree_of g) n) (Cons p rest))
                     (steps
                       ((rewrite (hyp 2) lr lhs true ())
                        (compute lhs (stop fl_at))
                        (rewrite (hyp 0) lr lhs true ()))
                       refl))
                   (have hleg
                     (=
                       (ipcall
                         (nS 12 (ntl 12 fuel))
                         (rt_app (rt_fns rb) fs)
                         mlo
                         msz
                         dmax
                         d
                         1
                         (Cons tag (Cons n Nil))
                         m)
                       (Some (IpRv p (m_apop m rb n (hhead rest) p tag))))
                     (rewrite-with
                       (lemma rth_alloc_pop_run)
                       lr
                       lhs
                       ((inst g g) (inst r r) (inst p p) (inst rest rest))
                       ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                        (steps ((rewrite (premise 1) lr lhs true ())) refl)
                        (steps ((rewrite (premise 2) lr lhs true ())) refl)
                        (steps ((rewrite (premise hfl) lr lhs true ())) refl)
                        (steps ((rewrite (premise hn16) lr lhs true ())) refl)
                        (steps ((rewrite (premise 3) lr lhs true ())) refl)
                        (steps ((rewrite (premise 4) lr lhs true ())) refl)
                        (steps ((rewrite (premise 5) lr lhs true ())) refl)
                        (steps ((rewrite (premise 6) lr lhs true ())) refl)
                        (steps ((rewrite (premise 7) lr lhs true ())) refl)
                        (steps ((rewrite (premise 8) lr lhs true ())) refl)
                        (steps ((rewrite (premise 9) lr lhs true ())) refl))
