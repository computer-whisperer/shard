             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 0))
             ((steps ((rewrite (hyp True) lr lhs true ())) refl))
             refl))
         (have habs (= (le 1 0) True) (by arith (rows (goal 1) (0 1) (hp -1))))
         (absurd (premise habs))))
     (case False (steps ((rewrite (hyp False) lr lhs true ())) refl)))))

