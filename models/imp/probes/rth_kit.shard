    ((case Nil
       (chain
         (have hz (= (lt j 0) True)
           (steps
             ((rewrite (premise 2) rl rhs true ())
              (unfold fllen rhs)
              (reduce rhs))
             refl))
         (have habs (= (le 1 0) True) (by arith (rows (goal 1) (1 1) (hz 1))))
         (absurd (premise habs))))
     (case Cons
       (fl r)
       (case-on (int_eq j 0) Bool
         ((case True
            (chain
              (have hch (= (hchain_rep m fl) True)
                (rewrite-with
                  (lemma hf_chain)
                  lr
                  lhs
                  ((inst rb rb) (inst k k) (inst rest r))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold fl_at lhs)
                 (reduce lhs)
                 (rewrite (hyp True) lr lhs true ())
                 (reduce lhs)
                 (rewrite (premise hch) lr lhs true ()))
                refl)))
          (case False
            (chain
              (have hj1 (= (le 1 j) True)
                (rewrite-with
                  (lemma ieq0_ge1)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (hyp False) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (have hj0 (= (le 0 (- j 1)) True)
                (by arith (rows (goal 1) (hj1 1))))
              (have hfl (= (fllen (Cons fl r)) (+ 1 (fllen r)))
                (steps ((unfold fllen lhs) (reduce lhs)) refl))
              (have hlt (= (lt j (+ 1 (fllen r))) True)
                (steps
                  ((rewrite (premise hfl) rl lhs true ())
                   (rewrite (premise 2) lr lhs true ()))
                  refl))
              (have hlt2 (= (lt (- j 1) (fllen r)) True)
                (by arith (rows (goal 1) (hlt 1))))
              (have htl (= (hfree_rep m rb (+ k 1) r) True)
                (rewrite-with
                  (lemma hf_tl)
                  lr
                  lhs
                  ((inst fl fl))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (have hih (= (hchain_rep m (fl_at r (- j 1))) True)
