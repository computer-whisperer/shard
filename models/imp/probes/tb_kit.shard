;; THE MULTIPLY CONSTRUCT'S LAW (the overflow leg): outside the band the run fails
;; FOverflow — at the divide-back when the ring product wrapped, at the band test otherwise
(claim mul_fail
  (goal
    ((fs (List IpFn))
     (mlo Int)
