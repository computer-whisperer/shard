           lhs
           ()
           ((steps ((compute lhs)) refl))
           refl)
         (rewrite-with
           (lemma mod_lo)
           lr
           lhs
           ()
           ((steps ((compute lhs)) refl))
           refl))
        refl))
    (have hm1 (= (lt (mod x 9223372036854775808) 9223372036854775808) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hn1 (= (lt (mod y 9223372036854775808) 9223372036854775808) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    ;; slots: 0 1 premises, 2 hp, 3 hs, 4 hr0, 5 hm1, 6 hn1
    (have hr1
      (=
        (le
          (bxor (mod x 9223372036854775808) (mod y 9223372036854775808))
          (- (pow2 63) 1))
        True)
      (rewrite-with
        (lemma bxor_le_pow2)
        lr
        lhs
        ()
        ((by arith (list 1 0 0 0 0 0 0 0))
         (rewrite-with
           (lemma mod_lo)
           lr
           lhs
           ()
           ((steps ((compute lhs)) refl))
           refl)
         (rewrite-with
           (lemma mod_lo)
           lr
           lhs
           ()
           ((steps ((compute lhs)) refl))
           refl)
         (chain
           (steps ((rewrite (premise hp) lr lhs true ())))
           (by arith (list 1 0 0 0 0 0 1 0)))
         (chain
           (steps ((rewrite (premise hp) lr lhs true ())))
           (by arith (list 1 0 0 0 0 0 0 1))))
        refl))
    (steps ((unfold hi lhs) (unfold hi rhs) (unfold hi rhs)))
    (rewrite-with
      (lemma div_unique)
      lr
      lhs
      ((inst q (bxor (ediv x 9223372036854775808) (ediv y 9223372036854775808)))
       (inst r (bxor (mod x 9223372036854775808) (mod y 9223372036854775808))))
      ((steps ((rewrite (premise hs) lr lhs true ())) refl)
       (steps ((rewrite (premise hr0) lr lhs true ())) refl)
       (by arith (list 1 0 0 -1 0 0 0 0 1)))
      refl)))

(claim shr63
  (goal ((x Int)) ((= (le 0 x) True)) (= (bshr x 63) (hi x)))
  (chain
    (have hp (= (pow2 63) 9223372036854775808) (steps ((compute lhs)) refl))
    (rewrite-with
