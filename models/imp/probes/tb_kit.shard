           (steps ((rewrite (premise 1) lr lhs true ())) refl)))
        (steps ((rewrite (premise hp) lr lhs true ())) refl)))
    (have hr0
      (=
        (le 0 (bxor (mod x 9223372036854775808) (mod y 9223372036854775808)))
        True)
      (rewrite-with
        (lemma bxor_lo)
