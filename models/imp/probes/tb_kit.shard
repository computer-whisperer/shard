              (reduce lhs)))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((by arith (list 1 0 0 1 0 0))
              (chain
                (steps ((rewrite (premise hnp) lr lhs true ())))
                (by arith (list 1 0 1 0 0 0)))
              (by arith (list 1 0 0 1 0 0))
              (by arith (list 1 0 0 0 0 0))))
           (steps
             ((rewrite (premise hnp) lr lhs true ()))
             (by arith (list (list 1 0 0 0 0 0) (list 1 0 0 0 0 0))))))))))

