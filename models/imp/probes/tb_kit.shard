        (band
          (bxor (hi (imm x)) (hi (dbl y)))
          (bxor (hi (imm x)) (hi (imm (- x y))))))
      (rewrite-with
        (lemma ov_bits)
        lr
        lhs
        ()
        ((steps ((rewrite (lemma imm_lo) lr lhs true ())) refl)
         (steps ((rewrite (lemma dbl_lo) lr lhs true ())) refl)
         (steps ((rewrite (lemma imm_lo) lr lhs true ())) refl))
        refl))
    (case-on (lt (- x y) -4611686018427387904) Bool
      ((case False
         (chain
           (have hf (= (lt (- x y) -4611686018427387904) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (by arith (list 1 0 0 0 0 0 0 1))))
       (case True
