                     refl))
                 ;; the remainder composition: a mod 2P = 2 (qa mod P) + a mod 2
                 (have hma
                   (=
                     (mod a (* 2 (pow2 (- k 1))))
                     (+ (* 2 (mod qa (pow2 (- k 1)))) (mod a 2)))
                   (rewrite-with
                     (lemma mod_unique)
                     lr
                     lhs
                     ((inst q (ediv qa (pow2 (- k 1))))
                      (inst r (+ (* 2 (mod qa (pow2 (- k 1)))) (mod a 2))))
                     ((chain
