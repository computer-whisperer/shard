                     lhs
                     ()
                     ((steps ((rewrite (premise hpp) lr lhs true ())) refl))
                     refl))
                 (have hqa1 (= (lt (mod qa (pow2 (- k 1))) (pow2 (- k 1))) True)
                   (rewrite-with
                     (lemma mod_hi)
                     lr
                     lhs
                     ()
                     ((steps ((rewrite (premise hpp) lr lhs true ())) refl))
