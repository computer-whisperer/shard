        ()
        ((steps ((rewrite (premise hxl) lr lhs true ())) refl)
         (steps ((rewrite (premise hxh) lr lhs true ())) refl)
         (steps ((rewrite (premise hyl) lr lhs true ())) refl)
         (steps ((rewrite (premise hyh) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hhi (= (lt (+ x y) 4611686018427387904) True)
      (rewrite-with
        (lemma ov_add_hi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hxl) lr lhs true ())) refl)
         (steps ((rewrite (premise hxh) lr lhs true ())) refl)
         (steps ((rewrite (premise hyl) lr lhs true ())) refl)
         (steps ((rewrite (premise hyh) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold in63 lhs)
       (rewrite (premise hlo) lr lhs true ())
       (rewrite (premise hhi) lr lhs true ())
       (compute lhs))
      refl)))

;; tb_ok's peels: what a caller learns from the callee's post-predicate
(claim tb_rv_eq
  (goal ((w Int) (m Mem) (v Int)) ((= (tb_ok (Some (IpRv w m)) v) True))
    (= (int_eq w (imm v)) True))
  (chain
    (have hres (= (if (int_eq w (imm v)) (in63 v) False) True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (compute rhs (stop imm in63)))
        refl))
    (case-on (int_eq w (imm v)) Bool
      ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
       (case False
         (chain
           (have hf (= False True)
             (steps
               ((rewrite (premise hres) rl rhs true ())
                (rewrite (hyp 0) lr rhs true ())
                (compute rhs (stop imm in63)))
               refl))
           (absurd (premise hf))))))))

(claim tb_rv_w
  (goal ((w Int) (m Mem) (v Int)) ((= (tb_ok (Some (IpRv w m)) v) True))
    (= w (imm v)))
  (rewrite-with
    (lemma int_eq_eq)
    lr
    lhs
    ((inst b (imm v)))
    ((rewrite-with
       (lemma tb_rv_eq)
       lr
       lhs
       ((inst m m))
       ((steps ((rewrite (premise 0) lr lhs true ())) refl))
       refl))
    refl))

(claim tb_rv_in
  (goal ((w Int) (m Mem) (v Int)) ((= (tb_ok (Some (IpRv w m)) v) True))
    (= (in63 v) True))
  (chain
    (have he (= (int_eq w (imm v)) True)
      (rewrite-with
        (lemma tb_rv_eq)
        lr
        lhs
        ((inst m m))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (compute rhs (stop imm in63))
       (rewrite (premise he) lr rhs true ())
       (compute rhs (stop imm in63)))
      refl)))

(claim tb_none
  (goal ((v Int)) ((= (tb_ok None v) True)) (= False True))
  (steps ((rewrite (premise 0) rl rhs true ()) (compute rhs)) refl))

(claim tb_trap
  (goal ((v Int)) ((= (tb_ok (Some IpRtrap) v) True)) (= False True))
  (steps ((rewrite (premise 0) rl rhs true ()) (compute rhs)) refl))
