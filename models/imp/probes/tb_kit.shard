           (have ht (= (lt (- x y) -4611686018427387904) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hx0 (= (lt x 0) True) (by arith (list 1 0 0 0 1 0 0 1)))
           (have hy0 (= (le 0 y) True) (by arith (list 1 1 0 0 0 0 0 1 0)))
           (have h1 (= (hi (imm x)) 1)
             (rewrite-with
               (lemma hi_imm_n1)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                (steps ((rewrite (premise hx0) lr lhs true ())) refl))
