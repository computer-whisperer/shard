;; ---------------------------------------------------------------------------
;; B-0b — the per-fn theorem's CITATION SURFACE: the band as ONE premise
;; (in63), the construct laws restated over it, and tb_ok's peels, so a
;; per-fn proof cites one lemma per fact instead of re-deriving it inline.
;; ---------------------------------------------------------------------------

(claim in63_lo
  (goal ((v Int)) ((= (in63 v) True)) (= (le -4611686018427387904 v) True))
  (case-on (le -4611686018427387904 v) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold in63 rhs)
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (absurd (premise hf)))))))

