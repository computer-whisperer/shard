                 ;; slots 15 hih, 16 hqa, 17 hqa0, 18 hqa1, 19 hqb, 20 hqb0, 21 hqb1
                 ;; the quotient composition: a div 2P = (a div 2) div P
                 (have hda
                   (= (ediv a (* 2 (pow2 (- k 1)))) (ediv qa (pow2 (- k 1))))
                   (rewrite-with
                     (lemma div_unique)
