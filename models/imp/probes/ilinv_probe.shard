;;; models/imp/probes/ilinv_probe.shard — ARC B rung B1 (docs/STREAM.md §3):
;;; THE 12-SLOT LIST-INVERSION LAW. A locals spine of length 12 IS the
;;; 12-slot (list ...) of its total reads (the patch kit's xp_getl) — the
;;; once-per-model law that lets a seam consumer mint its successor's
;;; twelve slot values from any Some-INorm result by ONE citation instead
;;; of a 12-deep Cons exposure (~2200 lines per seam in the replay
;;; dialect, paid 13x by the cmp_x_shblock family rung B1 replaces).
;;; Canonical read terms need no fresh names — the same insight that
;;; killed the exposure in the patch dialect (CERT.md §8, A2 verdict).
;;; B4b (STREAM.md, 2026-08-02) grows the law into a family: ilv_inv5 /
;;; ilv_inv6 are the same template at the pad walks' arities (shpad 5,
;;; shfpad 6), consumed by sha256.xchain.shard's xch_shpad/xch_shfpad
;;; conversion twins when the replay chains leave the committed closure.

(import "../../../kernel/stdlib.shard")
(import "../imp.shard")
(use (:: models imp imp *))
(import "ipatch_probe.shard")
(use (:: models imp probes ipatch_probe *))

(claim ilv_inv12
  (goal ((ls (List Int))) ((= (ilen ls) 12))
    (=
      ls
      (list
        (xp_getl ls 0)
        (xp_getl ls 1)
        (xp_getl ls 2)
        (xp_getl ls 3)
        (xp_getl ls 4)
        (xp_getl ls 5)
        (xp_getl ls 6)
        (xp_getl ls 7)
        (xp_getl ls 8)
        (xp_getl ls 9)
        (xp_getl ls 10)
        (xp_getl ls 11))))
  (chain
    (have hp12 (= (ilen ls) 12)
      (steps ((rewrite (premise 0) lr lhs true ())) refl))
    (case-on ls List
      ((case Nil
         (chain
           (have hil (= (ilen ls) 0)
             (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
           (have hcl (= (le 1 0) True)
             (by arith (rows (goal 1) (hp12 1) (hil -1))))
           (absurd (premise hcl))))
