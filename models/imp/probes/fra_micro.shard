;;; models/imp/probes/fra_micro.shard — THE THEOREM AT THE FLAGSHIP
;;; (docs/COVERAGE.md A-6): Theorem A cited at impc's micro product. Every
;;; COMPUTABLE premise is discharged by compute against the real program —
;;; the carve gate (inside ixf_prog), the table's band checks (ixf_fnsok),
;;; the ratio (ixf_fnskok at K = 1000), the entry arguments' band — and the
;;; machine result is DERIVED by citation, with no x86 replay anywhere in
;;; this file. The runs stay universally bound: their concrete values are
;;; the model differential's business (micro_x86_run, run mode), which
;;; computes both sides; this file is the once-proven bridge between them.
;;;
;;; fra_micro_v      — the entry call (rt_init on the heap bounds)
;;; fra_micro_wrap   — ANY wrapper called after init that returns a value
;;; fra_micro_deep   — a wrapper that fails: the machine sees the shim's
;;;                    trap (xrun_fn None; silicon exit 72 — C6's clause)

(import "../../../kernel/stdlib.shard")

(import "../../../kernel/facts.shard")

(import "../../../std/mem")

(import "../../../std/nat")

(import "../../../std/order")

(import "../../../std/bits")

(import "../imp.shard")

(import "../rt.shard")

(import "../../x86/x86.shard")

(import "../to_x86.shard")

(import "fra_kit.shard")

(import "../../../tools/impc/fixtures/micro_ipc_out.shard")

(use (:: kernel facts *))
(use (:: std mem *))
(use (:: std nat *))
(use (:: std order *))
(use (:: std bits *))
(use (:: models imp imp *))
(use (:: models imp rt *))
(use (:: models x86 x86 *))
(use (:: models imp to_x86 *))
(use (:: models imp probes fra_kit *))
(use (:: tools impc fixtures micro_ipc_out *))

;; the flagship program: the micro product over the drivers' window —
;; base 65536, memsize 1114112, frames from 589824, depth budget 1000
(fn fmp () IpProg (micro_iprog 65536 1114112 589824 1000))

;; rt_init's arguments: the heap bounds
(fn fma () (List Int) (Cons 65688 (Cons 589824 Nil)))

;; the entry call: rt_init on the empty memory, by citation
(claim fra_micro_v
  (goal
    ((f Nat)
     (xm XModule)
     (v Int)
     (memf Mem)
     (c Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_prog (fmp)) (Some xm))
     (= (iprun f (fmp) (rt_init_ix) (fma) (mem_empty)) (Some (IpRv v memf)))
     (= (le 0 c) True))
    (=
      (xrun_fn
        (xt c (kf 1000 f))
        xm
        (rt_init_ix)
        (MkRegs
          a0
          rcx
          dx
          rbx
          rbp
          rsi
          di
          r8
          r9
          s10
          s11
          r12
          r13
          0
          (ipstack_of (fmp)))
        (fp_mem (mem_empty) (fae_words (ipstack_of (fmp)) (fma))))
      (Some
        (Pair
          v
          (fp_mem
            (mem_empty)
            (fp_app
              (ipt_tr
                f
                (ipfns_of (fmp))
                (ipbase_of (fmp))
                (ipstack_of (fmp))
                (ipdepth_of (fmp))
                0
                (ipstack_of (fmp))
                (ilen (fma))
                0
                (IqCall (rt_init_ix))
                (fma)
                (mem_empty))
              (fae_words (ipstack_of (fmp)) (fma))))))))
  (chain
    (have hband (= (fae_band (fma)) True) (steps ((compute lhs)) refl))
    (have hsok (= (ixf_fnsok (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have hkok (= (ixf_fnskok 1000 (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have h1k (= (le 1 1000) True) (steps ((compute lhs)) refl))
    (rewrite-with
      (lemma fra_entry_v)
      lr
      lhs
      ((inst v v) (inst memf memf))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise hband) lr lhs true ())) refl)
       (steps ((rewrite (premise hsok) lr lhs true ())) refl)
       (steps ((rewrite (premise hkok) lr lhs true ())) refl)
       (steps ((rewrite (premise h1k) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)))
    refl))

;; any wrapper after init that returns a value: the machine returns it too,
;; from the machine memory the init call left
(claim fra_micro_wrap
  (goal
    ((f Nat)
     (f2 Nat)
     (xm XModule)
     (k2 Int)
     (v1 Int)
     (m1 Mem)
     (v Int)
     (memf Mem)
     (c Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_prog (fmp)) (Some xm))
     (= (iprun f (fmp) (rt_init_ix) (fma) (mem_empty)) (Some (IpRv v1 m1)))
     (= (iprun f2 (fmp) k2 Nil m1) (Some (IpRv v memf)))
     (= (le 0 c) True))
    (=
      (xrun_fn
        (xt c (kf 1000 f2))
        xm
        k2
        (MkRegs
          a0
          rcx
          dx
          rbx
          rbp
          rsi
          di
          r8
          r9
          s10
          s11
          r12
          r13
          0
          (ipstack_of (fmp)))
        (fp_mem
          (mem_empty)
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma)))))
      (Some
        (Pair
          v
          (fp_mem
            (mem_empty)
            (fp_app
              (ipt_tr
                f2
                (ipfns_of (fmp))
                (ipbase_of (fmp))
                (ipstack_of (fmp))
                (ipdepth_of (fmp))
                0
                (ipstack_of (fmp))
                (ilen Nil)
                0
                (IqCall k2)
                Nil
                m1)
              (fp_app
                (ipt_tr
                  f
                  (ipfns_of (fmp))
                  (ipbase_of (fmp))
                  (ipstack_of (fmp))
                  (ipdepth_of (fmp))
                  0
                  (ipstack_of (fmp))
                  (ilen (fma))
                  0
                  (IqCall (rt_init_ix))
                  (fma)
                  (mem_empty))
                (fae_words (ipstack_of (fmp)) (fma)))))))))
  (chain
    (have hband (= (fae_band (fma)) True) (steps ((compute lhs)) refl))
    (have hsok (= (ixf_fnsok (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have hkok (= (ixf_fnskok 1000 (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have h1k (= (le 1 1000) True) (steps ((compute lhs)) refl))
    (have hm1
      (=
        (fp_mem
          (mem_empty)
          (fbelow
            (ipstack_of (fmp))
            (fp_app
              (ipt_tr
                f
                (ipfns_of (fmp))
                (ipbase_of (fmp))
                (ipstack_of (fmp))
                (ipdepth_of (fmp))
                0
                (ipstack_of (fmp))
                (ilen (fma))
                0
                (IqCall (rt_init_ix))
                (fma)
                (mem_empty))
              (fae_words (ipstack_of (fmp)) (fma)))))
        m1)
      (rewrite-with
        (lemma fra_entry_mem)
        lr
        lhs
        ((inst v v1) (inst memf m1))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hrun2
      (=
        (iprun
          f2
          (fmp)
          k2
          Nil
          (fp_mem
            (mem_empty)
            (fbelow
              (ipstack_of (fmp))
              (fp_app
                (ipt_tr
                  f
                  (ipfns_of (fmp))
                  (ipbase_of (fmp))
                  (ipstack_of (fmp))
                  (ipdepth_of (fmp))
                  0
                  (ipstack_of (fmp))
                  (ilen (fma))
                  0
                  (IqCall (rt_init_ix))
                  (fma)
                  (mem_empty))
                (fae_words (ipstack_of (fmp)) (fma))))))
        (Some (IpRv v memf)))
      (steps
        ((rewrite (premise hm1) lr lhs true ())
         (rewrite (premise 2) lr lhs true ()))
        refl))
    (have hcout
      (=
        (fe_ctx
          xm
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipstack_of (fmp))
          (ilen (fma))
          0
          Nil
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma))))
        True)
      (rewrite-with
        (lemma fra_entry_ctxout)
        lr
        lhs
        ((inst v v1) (inst memf m1))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise hband) lr lhs true ())) refl)
         (steps ((rewrite (premise hsok) lr lhs true ())) refl))
        refl))
    (have hnl2 (= (le (ilen Nil) (ilen Nil)) True) (steps ((compute lhs)) refl))
    (have hctx2
      (=
        (fe_ctx
          xm
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipstack_of (fmp))
          (ilen Nil)
          0
          Nil
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma))))
        True)
      (rewrite-with
        (lemma ctx_renl)
        lr
        lhs
        ((inst nl (ilen (fma))))
        ((steps ((rewrite (premise hcout) lr lhs true ())) refl)
         (steps ((rewrite (premise hnl2) lr lhs true ())) refl))
        refl))
    (have htw2
      (=
        (ipt_tr
          f2
          (ipfns_of (fmp))
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipdepth_of (fmp))
          0
          (ipstack_of (fmp))
          (ilen Nil)
          0
          (IqCall k2)
          Nil
          m1)
        (ipt_tr
          f2
          (ipfns_of (fmp))
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipdepth_of (fmp))
          0
          (ipstack_of (fmp))
          (ilen Nil)
          0
          (IqCall k2)
          Nil
          (fp_mem
            (mem_empty)
            (fbelow
              (ipstack_of (fmp))
              (fp_app
                (ipt_tr
                  f
                  (ipfns_of (fmp))
                  (ipbase_of (fmp))
                  (ipstack_of (fmp))
                  (ipdepth_of (fmp))
                  0
                  (ipstack_of (fmp))
                  (ilen (fma))
                  0
                  (IqCall (rt_init_ix))
                  (fma)
                  (mem_empty))
                (fae_words (ipstack_of (fmp)) (fma)))))))
      (steps ((rewrite (premise hm1) rl lhs true ())) refl))
    (rewrite-with
      (lemma fra_sound_v)
      lr
      lhs
      ((inst args Nil) (inst v v) (inst memf memf))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise hrun2) lr lhs true ())) refl)
       (steps ((rewrite (premise hctx2) lr lhs true ())) refl)
       (steps ((rewrite (premise hsok) lr lhs true ())) refl)
       (steps ((rewrite (premise hkok) lr lhs true ())) refl)
       (steps ((rewrite (premise h1k) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (steps ((rewrite (premise htw2) rl lhs true ())))
    refl))

;; a wrapper that fails (t_deep's shape): the pure tier's machine run is
;; None — the exit shim's syscall; the world tier (C6) reads RDI = 70 +
;; family, the silicon exit 72
(claim fra_micro_deep
  (goal
    ((f Nat)
     (f2 Nat)
     (xm XModule)
     (k2 Int)
     (v1 Int)
     (m1 Mem)
     (fam IFam)
     (c Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_prog (fmp)) (Some xm))
     (= (iprun f (fmp) (rt_init_ix) (fma) (mem_empty)) (Some (IpRv v1 m1)))
     (= (iprun f2 (fmp) k2 Nil m1) (Some (IpRfailed fam)))
     (= (le 0 c) True))
    (=
      (xrun_fn
        (xt c (kf 1000 f2))
        xm
        k2
        (MkRegs
          a0
          rcx
          dx
          rbx
          rbp
          rsi
          di
          r8
          r9
          s10
          s11
          r12
          r13
          0
          (ipstack_of (fmp)))
        (fp_mem
          (mem_empty)
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma)))))
      None))
  (chain
    (have hband (= (fae_band (fma)) True) (steps ((compute lhs)) refl))
    (have hsok (= (ixf_fnsok (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have hkok (= (ixf_fnskok 1000 (ipfns_of (fmp))) True)
      (steps ((compute lhs)) refl))
    (have h1k (= (le 1 1000) True) (steps ((compute lhs)) refl))
    (have hm1
      (=
        (fp_mem
          (mem_empty)
          (fbelow
            (ipstack_of (fmp))
            (fp_app
              (ipt_tr
                f
                (ipfns_of (fmp))
                (ipbase_of (fmp))
                (ipstack_of (fmp))
                (ipdepth_of (fmp))
                0
                (ipstack_of (fmp))
                (ilen (fma))
                0
                (IqCall (rt_init_ix))
                (fma)
                (mem_empty))
              (fae_words (ipstack_of (fmp)) (fma)))))
        m1)
      (rewrite-with
        (lemma fra_entry_mem)
        lr
        lhs
        ((inst v v1) (inst memf m1))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hrun2
      (=
        (iprun
          f2
          (fmp)
          k2
          Nil
          (fp_mem
            (mem_empty)
            (fbelow
              (ipstack_of (fmp))
              (fp_app
                (ipt_tr
                  f
                  (ipfns_of (fmp))
                  (ipbase_of (fmp))
                  (ipstack_of (fmp))
                  (ipdepth_of (fmp))
                  0
                  (ipstack_of (fmp))
                  (ilen (fma))
                  0
                  (IqCall (rt_init_ix))
                  (fma)
                  (mem_empty))
                (fae_words (ipstack_of (fmp)) (fma))))))
        (Some (IpRfailed fam)))
      (steps
        ((rewrite (premise hm1) lr lhs true ())
         (rewrite (premise 2) lr lhs true ()))
        refl))
    (have hcout
      (=
        (fe_ctx
          xm
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipstack_of (fmp))
          (ilen (fma))
          0
          Nil
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma))))
        True)
      (rewrite-with
        (lemma fra_entry_ctxout)
        lr
        lhs
        ((inst v v1) (inst memf m1))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise hband) lr lhs true ())) refl)
         (steps ((rewrite (premise hsok) lr lhs true ())) refl))
        refl))
    (have hnl2 (= (le (ilen Nil) (ilen Nil)) True) (steps ((compute lhs)) refl))
    (have hctx2
      (=
        (fe_ctx
          xm
          (ipbase_of (fmp))
          (ipstack_of (fmp))
          (ipstack_of (fmp))
          (ilen Nil)
          0
          Nil
          (fp_app
            (ipt_tr
              f
              (ipfns_of (fmp))
              (ipbase_of (fmp))
              (ipstack_of (fmp))
              (ipdepth_of (fmp))
              0
              (ipstack_of (fmp))
              (ilen (fma))
              0
              (IqCall (rt_init_ix))
              (fma)
              (mem_empty))
            (fae_words (ipstack_of (fmp)) (fma))))
        True)
      (rewrite-with
        (lemma ctx_renl)
        lr
        lhs
        ((inst nl (ilen (fma))))
        ((steps ((rewrite (premise hcout) lr lhs true ())) refl)
         (steps ((rewrite (premise hnl2) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma fra_sound_fail_none)
      lr
      lhs
      ((inst args Nil) (inst fam fam))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise hrun2) lr lhs true ())) refl)
       (steps ((rewrite (premise hctx2) lr lhs true ())) refl)
       (steps ((rewrite (premise hsok) lr lhs true ())) refl)
       (steps ((rewrite (premise hkok) lr lhs true ())) refl)
       (steps ((rewrite (premise h1k) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    refl))
