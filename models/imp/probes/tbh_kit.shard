(claim rbl_tl
  (goal ((cs (List HCell)) (w Int) (h Int) (t (List Int)))
    ((= (rb_list cs w (Cons h t)) True))
    (= (rb_list cs (rb_slot cs w 1) t) True))
  (chain
    (have hu
      (=
        (andb
