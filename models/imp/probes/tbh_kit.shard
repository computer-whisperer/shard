;; --- a list word's bounds; the raw cell under inc -----------------------------------

(claim rbl_lo
  (goal ((rb Int) (g GHeap) (r (List Int)) (w Int) (v (List Int)))
    ((= (hinv rb g r) True) (= (rb_list (gcells_of g) w v) True))
    (= (le 0 w) True))
  (case-on v List
    ((case Nil
       (chain
         (have h1 (= (int_eq w 1) True)
           (rewrite-with
             (lemma rbl_nil)
             lr
             lhs
             ((inst cs (gcells_of g)))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 1) lr lhs true ()))
                refl))
             refl))
         (have he (= w 1)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 1))
             ((steps ((rewrite (premise h1) lr lhs true ())) refl))
             refl))
         (steps ((rewrite (premise he) lr lhs true ()) (compute lhs)) refl)))
     (case Cons
       (h t)
       (chain
         (have hc (= (rb_cell (gcells_of g) w 1 2) True)
           (rewrite-with
             (lemma rbl_cell)
             lr
             lhs
             ((inst h h) (inst t t))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 1) lr lhs true ()))
                refl))
             refl))
         (have hm (= (memb (haddrs (gcells_of g)) w) True)
           (rewrite-with
             (lemma rbc_memb)
             lr
             lhs
             ((inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (rewrite-with
           (lemma cell_nonneg)
           lr
           lhs
           ((inst rb rb) (inst g g) (inst r r))
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)
            (steps ((rewrite (premise hm) lr lhs true ())) refl))
           refl))))))

(claim rbl_hi
  (goal ((rb Int) (g GHeap) (r (List Int)) (w Int) (v (List Int)))
    ((= (hinv rb g r) True) (= (rb_list (gcells_of g) w v) True))
    (= (lt w 4294967296) True))
  (case-on v List
    ((case Nil
       (chain
         (have h1 (= (int_eq w 1) True)
           (rewrite-with
             (lemma rbl_nil)
             lr
             lhs
             ((inst cs (gcells_of g)))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 1) lr lhs true ()))
                refl))
             refl))
         (have he (= w 1)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 1))
             ((steps ((rewrite (premise h1) lr lhs true ())) refl))
             refl))
         (steps ((rewrite (premise he) lr lhs true ()) (compute lhs)) refl)))
     (case Cons
       (h t)
       (chain
         (have hc (= (rb_cell (gcells_of g) w 1 2) True)
           (rewrite-with
             (lemma rbl_cell)
             lr
             lhs
             ((inst h h) (inst t t))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 1) lr lhs true ()))
                refl))
             refl))
         (have hm (= (memb (haddrs (gcells_of g)) w) True)
           (rewrite-with
             (lemma rbc_memb)
             lr
             lhs
             ((inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (rewrite-with
           (lemma cell_u32)
           lr
           lhs
           ((inst rb rb) (inst g g) (inst r r))
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)
            (steps ((rewrite (premise hm) lr lhs true ())) refl))
           refl))))))

(claim graw_inc
  (goal ((g GHeap) (v Int)) () (= (graw_of (gh_inc g v)) (graw_of g)))
  (chain
    (steps ((unfold gh_inc lhs)))
    (case-on (int_eq (mod v 2) 1) Bool
      ((case True (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
       (case False
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
           (case-on (hfind (gcells_of g) v) Option
             ((case None (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
              (case Some
                (c)
                (chain
                  (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
                  (case-on (le 2147483648 (hcount_of c)) Bool
                    ((case True
                       (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
                     (case False
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (reduce lhs)
                          (rewrite (lemma graw_of_with_gcells) lr lhs true ()))
                         refl))))))))))))))
