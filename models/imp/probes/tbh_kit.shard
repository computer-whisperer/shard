      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (rb_cell cs w 1 2)))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma andb_r)
      lr
      lhs
      ((inst a (rb_int (rb_slot cs w 0) h)))
      ((steps ((rewrite (premise h1) lr lhs true ())) refl))
      refl)))

;; an immediate's readback: the word and the band
(claim rbi_w
  (goal ((w Int) (v Int)) ((= (rb_int w v) True)) (= w (imm v)))
  (case-on (in63 v) Bool
    ((case True
       (chain
         (have h1 (= (int_eq w (imm v)) True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold rb_int rhs)
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs (stop imm int_eq)))
             refl))
         (rewrite-with
           (lemma int_eq_eq)
           lr
           lhs
           ((inst b (imm v)))
           ((steps ((rewrite (premise h1) lr lhs true ())) refl))
           refl)))
     (case False
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold rb_int rhs)
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (absurd (premise hf)))))))

(claim rbi_in63
  (goal ((w Int) (v Int)) ((= (rb_int w v) True)) (= (in63 v) True))
  (case-on (in63 v) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold rb_int rhs)
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (absurd (premise hf)))))))

(claim rbi_intro
  (goal ((v Int)) ((= (in63 v) True)) (= (rb_int (imm v) v) True))
  (steps
    ((unfold rb_int lhs)
     (rewrite (premise 0) lr lhs true ())
     (compute lhs (stop imm int_eq))
     (rewrite (lemma int_eq_refl) lr lhs true ()))
    refl))

;; --- the post-predicate over a run -------------------------------------------------
;; tb_ok's heap twin: the run RETURNS the twin's word `w` over a memory
;; representing the twin's ghost `g`, hinv holds at the caller's roots
;; plus the (owned) result, no raw cell is open, and the readback fact
;; `ok` (the theorem spells it at the twin's word) holds; a failure is
;; accepted (the stack and oom families reach the caller's except
;; clause, an overflow is the source's own); a trap or a fuel-out is not.

(fn graw_none ((g GHeap)) Bool
  (match (graw_of g)
    (None True)
    ((Some _) False)))

(fn tbh
  ((r (Option IpRet))
   (rb Int)
   (msz Int)
   (g GHeap)
   (w Int)
   (rs (List Int))
   (ok Bool))
  Bool
  (match r
    (None False)
    ((Some x)
     (match x
       ((IpRv w2 m2)
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok))))))
       (IpRtrap False)
       ((IpRfailed _) True)))))

;; a run that returned or failed (never trapped, never ran out)
(fn tb_okr ((r (Option IpRet))) Bool
  (match r
    (None False)
    ((Some x)
     (match x
       ((IpRv _ _) True)
       (IpRtrap False)
       ((IpRfailed _) True)))))

;; the returned word (0 otherwise)
(fn tb_w ((r (Option IpRet))) Int
  (match r
    (None 0)
    ((Some x)
     (match x
       ((IpRv w _) w)
       (IpRtrap 0)
       ((IpRfailed _) 0)))))

(claim tbh_okr
  (goal
    ((r (Option IpRet))
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh r rb msz g w rs ok) True))
    (= (tb_okr r) True))
  (case-on r Option
    ((case None
       (chain
         (have hf (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (absurd (premise hf))))
     (case Some
       (x)
       (case-on x IpRet
         ((case IpRtrap
            (chain
              (have hf (= False True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (hyp 1) lr rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute rhs))
                  refl))
              (absurd (premise hf))))
          (case IpRfailed
            (fm)
            (steps
              ((rewrite (hyp 1) lr lhs true ())
               (rewrite (hyp 0) lr lhs true ())
               (compute lhs))
              refl))
          (case IpRv
            (w2 m2)
            (steps
              ((rewrite (hyp 1) lr lhs true ())
               (rewrite (hyp 0) lr lhs true ())
               (compute lhs))
              refl))))))))

;; the returned word is the twin's
(claim tbh_w
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= w2 w))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (have he (= (int_eq w2 w) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (heap_rep m2 rb g)
             (andb
               (hinv rb g (rinc rs w))
               (andb (graw_none g) (andb (le (gend_of g) msz) ok))))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma int_eq_eq)
      lr
      lhs
      ((inst b w))
      ((steps ((rewrite (premise he) lr lhs true ())) refl))
      refl)))

(claim tbh_rep
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= (heap_rep m2 rb g) True))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (rewrite-with
      (lemma andb_2)
      lr
      lhs
      ((inst a (int_eq w2 w))
       (inst
         c
         (andb
           (hinv rb g (rinc rs w))
           (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
      ((steps ((rewrite (premise hu) lr lhs true ())) refl))
      refl)))

(claim tbh_inv
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= (hinv rb g (rinc rs w)) True))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (rewrite-with
      (lemma andb_3)
      lr
      lhs
      ((inst a (int_eq w2 w))
       (inst b (heap_rep m2 rb g))
       (inst d (andb (graw_none g) (andb (le (gend_of g) msz) ok))))
      ((steps ((rewrite (premise hu) lr lhs true ())) refl))
      refl)))

(claim tbh_raw
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= (graw_of g) None))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (have h4 (= (andb (graw_none g) (andb (le (gend_of g) msz) ok)) True)
      (rewrite-with
        (lemma andb_4)
        lr
        lhs
        ((inst a (int_eq w2 w))
         (inst b (heap_rep m2 rb g))
         (inst c (hinv rb g (rinc rs w))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have hn (= (graw_none g) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b (andb (le (gend_of g) msz) ok)))
        ((steps ((rewrite (premise h4) lr lhs true ())) refl))
        refl))
    (case-on (graw_of g) Option
      ((case None (steps ((rewrite (hyp 0) lr lhs true ())) refl))
       (case Some
         (rc)
         (chain
           (have hf (= False True)
             (steps
               ((rewrite (premise hn) rl rhs true ())
                (unfold graw_none rhs)
                (rewrite (hyp 0) lr rhs true ())
                (compute rhs))
               refl))
           (absurd (premise hf))))))))

(claim tbh_ok
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= ok True))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (have h4 (= (andb (graw_none g) (andb (le (gend_of g) msz) ok)) True)
      (rewrite-with
        (lemma andb_4)
        lr
        lhs
        ((inst a (int_eq w2 w))
         (inst b (heap_rep m2 rb g))
         (inst c (hinv rb g (rinc rs w))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h5 (= (andb (le (gend_of g) msz) ok) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (graw_none g)))
        ((steps ((rewrite (premise h4) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma andb_r)
      lr
      lhs
      ((inst a (le (gend_of g) msz)))
      ((steps ((rewrite (premise h5) lr lhs true ())) refl))
      refl)))

;; the arena still fits the window
(claim tbh_gend
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
    (= (le (gend_of g) msz) True))
  (chain
    (have hu
      (=
        (andb
          (int_eq w2 w)
          (andb
            (heap_rep m2 rb g)
            (andb
              (hinv rb g (rinc rs w))
              (andb (graw_none g) (andb (le (gend_of g) msz) ok)))))
        True)
      (steps ((rewrite (premise 0) rl rhs true ()) (unfold tbh rhs) (reduce rhs))
        refl))
    (have h4 (= (andb (graw_none g) (andb (le (gend_of g) msz) ok)) True)
      (rewrite-with
        (lemma andb_4)
        lr
        lhs
        ((inst a (int_eq w2 w))
         (inst b (heap_rep m2 rb g))
         (inst c (hinv rb g (rinc rs w))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h5 (= (andb (le (gend_of g) msz) ok) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (graw_none g)))
        ((steps ((rewrite (premise h4) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma andb_l)
      lr
      lhs
      ((inst b ok))
      ((steps ((rewrite (premise h5) lr lhs true ())) refl))
      refl)))

;; the six facts make the post-predicate at a returned run
(claim tbh_intro
  (goal
    ((w2 Int)
     (m2 Mem)
     (rb Int)
     (msz Int)
     (g GHeap)
     (w Int)
     (rs (List Int))
     (ok Bool))
    ((= w2 w)
     (= (heap_rep m2 rb g) True)
     (= (hinv rb g (rinc rs w)) True)
     (= (graw_of g) None)
     (= (le (gend_of g) msz) True)
     (= ok True))
    (= (tbh (Some (IpRv w2 m2)) rb msz g w rs ok) True))
  (steps
    ((unfold tbh lhs)
     (reduce lhs)
     (rewrite (premise 0) lr lhs true ())
     (rewrite (lemma int_eq_refl) lr lhs true ())
     (rewrite (premise 1) lr lhs true ())
     (rewrite (premise 2) lr lhs true ())
     (rewrite (premise 4) lr lhs true ())
     (rewrite (premise 5) lr lhs true ())
     (unfold graw_none lhs)
     (rewrite (premise 3) lr lhs true ())
     (compute lhs))
    refl))

;; --- the generic call law ----------------------------------------------------------
;; A call whose callee returned or failed (tb_okr) leaves the returned
;; word in the local over the callee's memory, or fails with the
;; callee's family — st_call without tb_ok's value shape, so a heap
;; callee (tbh) and a runtime law (an equation) cite it alike.

(claim st_callg
  (goal
    ((g Nat)
     (fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (i Int)
     (k Int)
     (args (List IExp))
     (lc (List Int))
     (m Mem)
     (vs (List Int)))
    ((= (ipexps args lc m mlo msz) (Some vs))
     (= (tb_okr (ipcall g fs mlo msz dmax d k vs m)) True)
     (= (le 0 i) True)
     (= (lt i (ilen lc)) True))
    (=
      (ipstmt (S g) fs mlo msz dmax d (IpCall i k args) lc m)
      (if (tb_rv (ipcall g fs mlo msz dmax d k vs m))
        (Some
          (IpNorm
            (ilsetf lc i (tb_w (ipcall g fs mlo msz dmax d k vs m)))
            (tb_mem (ipcall g fs mlo msz dmax d k vs m) m)))
        (Some (IpFailed (tb_fam (ipcall g fs mlo msz dmax d k vs m)))))))
  (chain
    (steps
      ((compute lhs (stop ipexps ipcall ilset))
       (rewrite (premise 0) lr lhs true ())
       (compute lhs (stop ipcall ilset))))
    (case-on (ipcall g fs mlo msz dmax d k vs m) Option
      ((case None
         (chain
           (have hf (= False True)
             (steps
               ((rewrite (premise 1) rl rhs true ())
                (rewrite (hyp 0) lr rhs true ())
                (compute rhs))
               refl))
           (absurd (premise hf))))
       (case Some
         (r)
         (case-on r IpRet
           ((case IpRtrap
              (chain
                (have hf (= False True)
                  (steps
                    ((rewrite (premise 1) rl rhs true ())
                     (rewrite (hyp 1) lr rhs true ())
                     (rewrite (hyp 0) lr rhs true ())
                     (compute rhs))
                    refl))
                (absurd (premise hf))))
            (case IpRfailed
              (fm)
              (steps
                ((rewrite (hyp 1) lr both true ())
                 (rewrite (hyp 0) lr both true ())
                 (compute both (stop ilsetf)))
                refl))
            (case IpRv
              (w m2)
              (chain
                (steps
                  ((rewrite (hyp 1) lr both true ())
                   (rewrite (hyp 0) lr both true ())
                   (compute both (stop ilsetf ilset))))
                (rewrite-with
                  (lemma ilset_ok)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise 2) lr lhs true ())) refl)
                   (steps ((rewrite (premise 3) lr lhs true ())) refl)))
                (steps ((compute both (stop ilsetf))) refl))))))))))

;; --- the ghost fill and its laws ---------------------------------------------------
;; The constructor window: after rt_alloc the raw cell is open; each
;; emitted slot store fills it (gh_fill); the roots lose a stored
;; reference (rdec, rinc's mirror); the seal closes it (gh_seal).

(fn rdec ((r (List Int)) (w Int)) (List Int)
  (if (int_eq (mod w 2) 1) r (irem r w)))

(fn gh_fill ((g GHeap) (w Int)) GHeap
  (match (graw_of g)
    (None g)
    ((Some rc)
     (with_graw
       (Some
         (MkHRaw
           (raddr_of rc)
           (rtag_of rc)
           (rarity_of rc)
           (iapp (rfill_of rc) (Cons w Nil))))
       g))))

(claim gh_fill_raw
  (goal ((g GHeap) (p Int) (tag Int) (n Int) (fill (List Int)) (w Int))
    ((= (graw_of g) (Some (MkHRaw p tag n fill))))
    (=
      (gh_fill g w)
      (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g)))
  (steps
    ((unfold gh_fill lhs)
     (rewrite (premise 0) lr lhs true ())
     (compute lhs (stop iapp with_graw)))
    refl))

;; heap_rep after the store that fills slot i
(claim hr_fill_g
  (goal
    ((m Mem)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (i Int)
     (w Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (ilen fill) i)
     (= (le 0 i) True)
     (= (lt i n) True)
     (= (le 0 w) True)
     (= (lt w 18446744073709551616) True))
    (= (heap_rep (store_le (iw8) m (+ p (+ 8 (* 8 i))) w) rb (gh_fill g w)) True))
  (chain
    (have hgf
      (= (gh_fill g w) (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g))
      (rewrite-with
        (lemma gh_fill_raw)
        lr
        lhs
        ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hgf) lr lhs true ())))
    (rewrite-with
      (lemma hr_fill)
      lr
      lhs
      ((inst r r))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)
       (steps ((rewrite (premise 4) lr lhs true ())) refl)
       (steps ((rewrite (premise 5) lr lhs true ())) refl)
       (steps ((rewrite (premise 6) lr lhs true ())) refl)
       (steps ((rewrite (premise 7) lr lhs true ())) refl))
      refl)))

;; hinv after a fill: an immediate leaves the roots, a stored reference
;; (owned once in the roots) moves from the roots into the slot
(claim hinv_fill
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (w Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (lt (ilen fill) n) True)
     (= (slot_ok w (haddrs (gcells_of g))) True)
     (= (if (int_eq (mod w 2) 1) True (memb r w)) True))
    (= (hinv rb (gh_fill g w) (rdec r w)) True))
  (chain
    (have hgf
      (= (gh_fill g w) (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g))
      (rewrite-with
        (lemma gh_fill_raw)
        lr
        lhs
        ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hgf) lr lhs true ()) (unfold rdec lhs)))
    (case-on (int_eq (mod w 2) 1) Bool
      ((case True
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs (stop hinv iapp with_graw))))
           (rewrite-with
             (lemma hinv_fill_imm)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps ((rewrite (premise 2) lr lhs true ())) refl)
              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
             refl)))
       (case False
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs (stop hinv iapp with_graw irem))))
           (have hm (= (memb (haddrs (gcells_of g)) w) True)
             (steps
               ((rewrite (premise 3) rl rhs true ())
                (unfold slot_ok rhs)
                (rewrite (hyp 0) lr rhs true ())
                (reduce rhs))
               refl))
           (have hr (= (memb r w) True)
             (steps
               ((rewrite (premise 4) rl rhs true ())
                (rewrite (hyp 0) lr rhs true ())
                (reduce rhs))
               refl))
           (rewrite-with
             (lemma hinv_fill_ref)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps ((rewrite (premise 2) lr lhs true ())) refl)
              (steps ((rewrite (premise hm) lr lhs true ())) refl)
              (steps ((rewrite (premise hr) lr lhs true ())) refl))
             refl)))))))

;; --- readback framing ------------------------------------------------------------
;; A readback survives every ghost transition the constructor window and
;; the calls make: a count bump (inc) keeps every cell's address, tag,
;; arity and slots; alloc and fill touch the free classes, the top and
;; the raw cell only; the seal PREPENDS a fresh cell — one no live cell
;; is at, so no readback walk reaches it.

;; a cell modulo its count
(fn hsig ((c HCell)) HCell
  (MkHCell (haddr_of c) 1 (htag_of c) (harity_of c) (hslots_of c)))

(claim sig_tag
  (goal ((c HCell)) () (= (htag_of (hsig c)) (htag_of c)))
  (steps ((unfold hsig lhs) (compute both)) refl))

(claim sig_arity
  (goal ((c HCell)) () (= (harity_of (hsig c)) (harity_of c)))
  (steps ((unfold hsig lhs) (compute both)) refl))

(claim sig_slots
  (goal ((c HCell)) () (= (hslots_of (hsig c)) (hslots_of c)))
  (steps ((unfold hsig lhs) (compute both)) refl))

;; the found cell's signature under hincc
(claim hincc_sig
  (goal ((cs (List HCell)) (a Int) (w Int)) ()
    (= (hsig (hfget (hincc cs a) w)) (hsig (hfget cs w))))
  (induct cs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c rest)
       (chain
         (steps ((unfold hincc lhs) (reduce lhs)))
         (case-on (int_eq (haddr_of c) a) Bool
           ((case True
              (chain
                (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
                (case-on (int_eq (haddr_of c) w) Bool
                  ((case True
                     (chain
                       (have hl
                         (=
                           (hfget (Cons (with_hcount (+ (hcount_of c) 1) c) rest) w)
                           (with_hcount (+ (hcount_of c) 1) c))
                         (rewrite-with
                           (lemma hfget_cons_eq)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (lemma haddr_of_with_hcount) lr lhs true ())
                               (rewrite (hyp 0) lr lhs true ()))
                              refl))
                           refl))
                       (have hr (= (hfget (Cons c rest) w) c)
                         (rewrite-with
                           (lemma hfget_cons_eq)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (steps
                         ((rewrite (premise hl) lr lhs true ())
                          (rewrite (premise hr) lr rhs true ())
                          (unfold hsig both)
                          (rewrite (lemma haddr_of_with_hcount) lr lhs true ())
                          (rewrite (lemma htag_of_with_hcount) lr lhs true ())
                          (rewrite (lemma harity_of_with_hcount) lr lhs true ())
                          (rewrite (lemma hslots_of_with_hcount) lr lhs true ()))
                         refl)))
                   (case False
                     (chain
                       (have hl
                         (=
                           (hfget (Cons (with_hcount (+ (hcount_of c) 1) c) rest) w)
                           (hfget rest w))
                         (rewrite-with
                           (lemma hfget_cons_ne)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (lemma haddr_of_with_hcount) lr lhs true ())
                               (rewrite (hyp 0) lr lhs true ()))
                              refl))
                           refl))
                       (have hr (= (hfget (Cons c rest) w) (hfget rest w))
                         (rewrite-with
                           (lemma hfget_cons_ne)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (steps
                         ((rewrite (premise hl) lr lhs true ())
                          (rewrite (premise hr) lr rhs true ()))
                         refl)))))))
            (case False
              (chain
                (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
                (case-on (int_eq (haddr_of c) w) Bool
                  ((case True
                     (chain
                       (have hl (= (hfget (Cons c (hincc rest a)) w) c)
                         (rewrite-with
                           (lemma hfget_cons_eq)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (have hr (= (hfget (Cons c rest) w) c)
                         (rewrite-with
                           (lemma hfget_cons_eq)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (steps
                         ((rewrite (premise hl) lr lhs true ())
                          (rewrite (premise hr) lr rhs true ()))
                         refl)))
                   (case False
                     (chain
                       (have hl
                         (= (hfget (Cons c (hincc rest a)) w) (hfget (hincc rest a) w))
                         (rewrite-with
                           (lemma hfget_cons_ne)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (have hr (= (hfget (Cons c rest) w) (hfget rest w))
                         (rewrite-with
                           (lemma hfget_cons_ne)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                           refl))
                       (steps
                         ((rewrite (premise hl) lr lhs true ())
                          (rewrite (premise hr) lr rhs true ())
                          (rewrite (hyp 2) lr lhs true ()))
                         refl))))))))))))))

(claim hincc_tag
  (goal ((cs (List HCell)) (a Int) (w Int)) ()
    (= (htag_of (hfget (hincc cs a) w)) (htag_of (hfget cs w))))
  (steps
    ((rewrite (lemma sig_tag) rl both true ())
     (rewrite (lemma hincc_sig) lr lhs true ()))
    refl))

(claim hincc_arity
  (goal ((cs (List HCell)) (a Int) (w Int)) ()
    (= (harity_of (hfget (hincc cs a) w)) (harity_of (hfget cs w))))
  (steps
    ((rewrite (lemma sig_arity) rl both true ())
     (rewrite (lemma hincc_sig) lr lhs true ()))
    refl))

(claim hincc_slots
  (goal ((cs (List HCell)) (a Int) (w Int)) ()
    (= (hslots_of (hfget (hincc cs a) w)) (hslots_of (hfget cs w))))
  (steps
    ((rewrite (lemma sig_slots) rl both true ())
     (rewrite (lemma hincc_sig) lr lhs true ()))
    refl))

(claim rb_slot_incc
  (goal ((cs (List HCell)) (a Int) (w Int) (i Int)) ()
    (= (rb_slot (hincc cs a) w i) (rb_slot cs w i)))
  (steps
    ((unfold rb_slot both) (rewrite (lemma hincc_slots) lr lhs true ()))
    refl))

;; a (List Int) readback survives a count bump
(claim rbl_incc
  (goal ((v (List Int)) (cs (List HCell)) (a Int) (w Int))
    ((= (rb_list cs w v) True))
    (= (rb_list (hincc cs a) w v) True))
  (induct v
    ((case Nil
       (steps
         ((rewrite (premise 0) rl rhs true ())
          (unfold rb_list both)
          (reduce both))
         refl))
     (case Cons
       (h t)
       (chain
         (have hc (= (rb_cell cs w 1 2) True)
           (rewrite-with
             (lemma rbl_cell)
             lr
             lhs
             ((inst h h) (inst t t))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have he (= (int_eq (mod w 2) 0) True)
           (rewrite-with
             (lemma rbc_even)
             lr
             lhs
             ((inst cs cs) (inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have hm (= (memb (haddrs cs) w) True)
           (rewrite-with
             (lemma rbc_memb)
             lr
             lhs
             ((inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have htg (= (int_eq (htag_of (hfget cs w)) 1) True)
           (rewrite-with
             (lemma rbc_tag)
             lr
             lhs
             ((inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have har (= (int_eq (harity_of (hfget cs w)) 2) True)
           (rewrite-with
             (lemma rbc_arity)
             lr
             lhs
             ((inst tag 1))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have hc2 (= (rb_cell (hincc cs a) w 1 2) True)
           (rewrite-with
             (lemma rbc_intro)
             lr
             lhs
             ()
             ((steps ((rewrite (premise he) lr lhs true ())) refl)
              (steps
                ((rewrite (lemma haddrs_hincc) lr lhs true ())
                 (rewrite (premise hm) lr lhs true ()))
                refl)
              (steps
                ((rewrite (lemma hincc_tag) lr lhs true ())
                 (rewrite (premise htg) lr lhs true ()))
                refl)
              (steps
                ((rewrite (lemma hincc_arity) lr lhs true ())
                 (rewrite (premise har) lr lhs true ()))
                refl))
             refl))
         (have hh (= (rb_int (rb_slot cs w 0) h) True)
           (rewrite-with
             (lemma rbl_hd)
             lr
             lhs
             ((inst t t))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have ht (= (rb_list cs (rb_slot cs w 1) t) True)
           (rewrite-with
             (lemma rbl_tl)
             lr
             lhs
             ((inst h h))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hih (= (rb_list (hincc cs a) (rb_slot cs w 1) t) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ()
             ((steps ((rewrite (premise ht) lr lhs true ())) refl))
             refl))
         (steps
           ((unfold rb_list lhs)
            (reduce lhs)
            (rewrite (lemma rb_slot_incc) lr lhs true ())
            (rewrite (premise hc2) lr lhs true ())
            (rewrite (premise hh) lr lhs true ())
            (rewrite (premise hih) lr lhs true ())
            (compute lhs))
           refl))))))

;; a (List Int) readback survives a FRESH cell prepended (none live at its address)
(claim rbl_cons
  (goal ((v (List Int)) (cs (List HCell)) (c HCell) (w Int))
    ((= (memb (haddrs cs) (haddr_of c)) False) (= (rb_list cs w v) True))
    (= (rb_list (Cons c cs) w v) True))
  (induct v
    ((case Nil
       (steps
         ((rewrite (premise 1) rl rhs true ())
          (unfold rb_list both)
          (reduce both))
         refl))
     (case Cons
       (h t)
       (chain
         (have hc (= (rb_cell cs w 1 2) True)
           (rewrite-with
             (lemma rbl_cell)
             lr
             lhs
             ((inst h h) (inst t t))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have he (= (int_eq (mod w 2) 0) True)
           (rewrite-with
             (lemma rbc_even)
             lr
             lhs
             ((inst cs cs) (inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have hm (= (memb (haddrs cs) w) True)
           (rewrite-with
             (lemma rbc_memb)
             lr
             lhs
             ((inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (have hne (= (int_eq (haddr_of c) w) False)
           (case-on (int_eq (haddr_of c) w) Bool
             ((case True
                (chain
                  (have heq (= (haddr_of c) w)
                    (rewrite-with
                      (lemma int_eq_eq)
                      lr
                      lhs
                      ((inst b w))
                      ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                      refl))
                  (have hf (= False True)
                    (steps
                      ((rewrite (premise 0) rl lhs true ())
                       (rewrite (premise heq) lr lhs true ())
                       (rewrite (premise hm) lr lhs true ()))
                      refl))
                  (absurd (premise hf))))
              (case False (steps ((rewrite (hyp 0) lr lhs true ())) refl)))))
         (have hg (= (hfget (Cons c cs) w) (hfget cs w))
           (rewrite-with
             (lemma hfget_cons_ne)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hne) lr lhs true ())) refl))
             refl))
         (have hm2 (= (memb (haddrs (Cons c cs)) w) True)
           (steps
             ((unfold haddrs lhs)
              (reduce lhs)
              (unfold memb lhs)
              (reduce lhs)
              (rewrite (premise hne) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hm) lr lhs true ()))
             refl))
         (have hc2 (= (rb_cell (Cons c cs) w 1 2) True)
           (steps
             ((unfold rb_cell lhs)
              (rewrite (premise hg) lr lhs true ())
              (rewrite (premise hm2) lr lhs true ())
              (rewrite (premise he) lr lhs true ())
              (rewrite (premise hc) rl rhs true ())
              (unfold rb_cell rhs)
              (rewrite (premise he) lr rhs true ())
              (rewrite (premise hm) lr rhs true ()))
             refl))
         (have hs0 (= (rb_slot (Cons c cs) w 0) (rb_slot cs w 0))
           (steps ((unfold rb_slot both) (rewrite (premise hg) lr lhs true ())) refl))
         (have hs1 (= (rb_slot (Cons c cs) w 1) (rb_slot cs w 1))
           (steps ((unfold rb_slot both) (rewrite (premise hg) lr lhs true ())) refl))
         (have hh (= (rb_int (rb_slot cs w 0) h) True)
           (rewrite-with
             (lemma rbl_hd)
             lr
             lhs
             ((inst t t))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have ht (= (rb_list cs (rb_slot cs w 1) t) True)
           (rewrite-with
             (lemma rbl_tl)
             lr
             lhs
             ((inst h h))
             ((steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hih (= (rb_list (Cons c cs) (rb_slot cs w 1) t) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise ht) lr lhs true ())) refl))
             refl))
         (steps
           ((unfold rb_list lhs)
            (reduce lhs)
            (rewrite (premise hs0) lr lhs true ())
            (rewrite (premise hs1) lr lhs true ())
            (rewrite (premise hc2) lr lhs true ())
            (rewrite (premise hh) lr lhs true ())
            (rewrite (premise hih) lr lhs true ())
            (compute lhs))
           refl))))))

;; --- the ghost transitions' cells --------------------------------------------------

(claim gcells_alloc
  (goal ((g GHeap) (tag Int) (n Int)) ()
    (= (gcells_of (gh_alloc g tag n)) (gcells_of g)))
  (chain
    (steps ((unfold gh_alloc lhs)))
    (case-on (lt n 16) Bool
      ((case True
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
           (case-on (fl_at (gfree_of g) n) List
             ((case Nil
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (unfold gh_alloc_bump lhs)
                   (rewrite (lemma gcells_of_with_gtop) lr lhs true ())
                   (rewrite (lemma gcells_of_with_graw) lr lhs true ()))
                  refl))
              (case Cons
                (p rest)
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (unfold gh_alloc_pop lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (rewrite (lemma gcells_of_with_gfree) lr lhs true ())
                   (rewrite (lemma gcells_of_with_graw) lr lhs true ()))
                  refl))))))
       (case False
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (reduce lhs)
            (unfold gh_alloc_bump lhs)
            (rewrite (lemma gcells_of_with_gtop) lr lhs true ())
            (rewrite (lemma gcells_of_with_graw) lr lhs true ()))
           refl))))))

(claim gcells_fill
  (goal ((g GHeap) (w Int)) () (= (gcells_of (gh_fill g w)) (gcells_of g)))
  (chain
    (steps ((unfold gh_fill lhs)))
    (case-on (graw_of g) Option
      ((case None (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
       (case Some
         (rc)
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (reduce lhs)
            (rewrite (lemma gcells_of_with_graw) lr lhs true ()))
           refl))))))

(claim gcells_seal
  (goal ((g GHeap) (p Int) (tag Int) (n Int) (fill (List Int)))
    ((= (graw_of g) (Some (MkHRaw p tag n fill))))
    (= (gcells_of (gh_seal g)) (Cons (MkHCell p 1 tag n fill) (gcells_of g))))
  (steps
    ((unfold gh_seal lhs)
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (rewrite (lemma gcells_of_with_gcells) lr lhs true ())
     (compute lhs (stop gcells_of)))
    refl))

;; --- the readbacks under the ghost transitions ------------------------------------

(claim rbl_inc
  (goal ((g GHeap) (v Int) (w Int) (x (List Int)))
    ((= (rb_list (gcells_of g) w x) True))
    (= (rb_list (gcells_of (gh_inc g v)) w x) True))
  (chain
    (steps ((unfold gh_inc lhs)))
    (case-on (int_eq (mod v 2) 1) Bool
      ((case True
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (reduce lhs)
            (rewrite (premise 0) lr lhs true ()))
           refl))
       (case False
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
           (case-on (hfind (gcells_of g) v) Option
             ((case None
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (case Some
                (c)
                (chain
                  (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
                  (case-on (le 2147483648 (hcount_of c)) Bool
                    ((case True
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (reduce lhs)
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (case False
                       (chain
                         (steps
                           ((rewrite (hyp 0) lr lhs true ())
                            (reduce lhs)
                            (rewrite (lemma gcells_of_with_gcells) lr lhs true ())))
                         (rewrite-with
                           (lemma rbl_incc)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                           refl)))))))))))))))

(claim rbl_alloc
  (goal ((g GHeap) (tag Int) (n Int) (w Int) (x (List Int)))
    ((= (rb_list (gcells_of g) w x) True))
    (= (rb_list (gcells_of (gh_alloc g tag n)) w x) True))
  (steps
    ((rewrite (lemma gcells_alloc) lr lhs true ())
     (rewrite (premise 0) lr lhs true ()))
    refl))

(claim rbl_fill
  (goal ((g GHeap) (v Int) (w Int) (x (List Int)))
    ((= (rb_list (gcells_of g) w x) True))
    (= (rb_list (gcells_of (gh_fill g v)) w x) True))
  (steps
    ((rewrite (lemma gcells_fill) lr lhs true ())
     (rewrite (premise 0) lr lhs true ()))
    refl))

(claim rbl_seal
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (w Int)
     (x (List Int)))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (rb_list (gcells_of g) w x) True))
    (= (rb_list (gcells_of (gh_seal g)) w x) True))
  (chain
    (have ha (= (araw_ok g p tag n fill) True)
      (rewrite-with
        (lemma araw_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hc0 (= (int_eq (count_in (haddrs (gcells_of g)) p) 0) True)
      (rewrite-with
        (lemma ar_hc0)
        lr
        lhs
        ((inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise ha) lr lhs true ())) refl))
        refl))
    (have hc0e (= (count_in (haddrs (gcells_of g)) p) 0)
      (rewrite-with
        (lemma int_eq_eq)
        lr
        lhs
        ((inst b 0))
        ((steps ((rewrite (premise hc0) lr lhs true ())) refl))
        refl))
    (have hnm (= (memb (haddrs (gcells_of g)) p) False)
      (rewrite-with
        (lemma cin0_nmemb)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hc0e) lr lhs true ())) refl))
        refl))
    (have hgs
      (= (gcells_of (gh_seal g)) (Cons (MkHCell p 1 tag n fill) (gcells_of g)))
      (rewrite-with
        (lemma gcells_seal)
        lr
        lhs
        ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise hgs) lr lhs true ())))
    (rewrite-with
      (lemma rbl_cons)
      lr
      lhs
      ()
      ((steps
         ((compute lhs (stop memb haddrs gcells_of))
          (rewrite (premise hnm) lr lhs true ()))
         refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl))
      refl)))

;; --- the load bounds of a live cell's word ----------------------------------------
;; An emitted word access at `a + k` (a live cell's header or slot) is in
;; the window and below 2^32: one bundle proven from hinv, cited per load.

(fn ldok ((mlo Int) (msz Int) (ad Int)) Bool
  (andb
    (le 0 ad)
    (andb (lt ad 4294967296) (andb (le mlo ad) (le (+ ad 8) msz)))))

(claim ldok_cell
  (goal ((rb Int) (g GHeap) (r (List Int)) (mlo Int) (msz Int) (a Int) (k Int))
    ((= (hinv rb g r) True)
     (= (memb (haddrs (gcells_of g)) a) True)
     (= (le mlo rb) True)
     (= (le (gend_of g) msz) True)
     (= (le 0 k) True)
     (= (le (+ k 8) (+ 8 (* 8 (harity_of (hfget (gcells_of g) a))))) True))
    (= (ldok mlo msz (+ a k)) True))
  (chain
    (have hlv (= (live_ok g a) True)
      (rewrite-with
        (lemma live_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hlo (= (le (glo_of g) a) True)
      (rewrite-with
        (lemma lv_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hhi
      (= (le (+ a (+ 8 (* 8 (harity_of (hfget (gcells_of g) a))))) (gtop_of g)) True)
      (rewrite-with
        (lemma lv_hi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hrb0 (= (le 0 rb) True)
      (rewrite-with
        (lemma hi_rb0)
        lr
        lhs
        ((inst g g) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hhdr (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hte (= (le (gtop_of g) (gend_of g)) True)
      (rewrite-with
        (lemma hi_te)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have he32 (= (le (gend_of g) 4294967296) True)
      (rewrite-with
        (lemma hi_e32)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h1 (= (le 0 (+ a k)) True)
      (by arith (rows (goal 1) (hrb0 1) (hhdr 1) (hlo 1) (4 1))))
    (have h2 (= (lt (+ a k) 4294967296) True)
      (by arith (rows (goal 1) (hhi 1) (hte 1) (he32 1) (5 1))))
    (have h3 (= (le mlo (+ a k)) True)
      (by arith (rows (goal 1) (2 1) (hhdr 1) (hlo 1) (4 1))))
    (have h4 (= (le (+ (+ a k) 8) msz) True)
      (by arith (rows (goal 1) (hhi 1) (hte 1) (3 1) (5 1))))
    (steps
      ((unfold ldok lhs)
       (rewrite (premise h1) lr lhs true ())
       (rewrite (premise h2) lr lhs true ())
       (rewrite (premise h3) lr lhs true ())
       (rewrite (premise h4) lr lhs true ())
       (compute lhs))
      refl)))

;; the load law with the bundle as its one address premise
(claim st_loadw_h
  (goal
    ((g Nat)
     (fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (i Int)
     (s Int)
     (k Int)
     (lc (List Int))
     (m Mem)
     (sv Int))
    ((= (ilget lc s) (Some sv))
     (= (ldok mlo msz (+ sv k)) True)
     (= (le 0 i) True)
     (= (lt i (ilen lc)) True))
    (=
      (ipstmt
        (S g)
        fs
        mlo
        msz
        dmax
        d
        (IpLoadW i (ITrunc U64 U32 (IBin U64 IAdd (ILoc s) (IConst k))))
        lc
        m)
      (Some (IpNorm (ilsetf lc i (load_le (iw8) m (+ sv k))) m))))
  (chain
    (have hu
      (=
        (andb
          (le 0 (+ sv k))
          (andb
            (lt (+ sv k) 4294967296)
            (andb (le mlo (+ sv k)) (le (+ (+ sv k) 8) msz))))
        True)
      (steps ((rewrite (premise 1) rl rhs true ()) (unfold ldok rhs)) refl))
    (have h1 (= (le 0 (+ sv k)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (lt (+ sv k) 4294967296)
             (andb (le mlo (+ sv k)) (le (+ (+ sv k) 8) msz)))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h2 (= (lt (+ sv k) 4294967296) True)
      (rewrite-with
        (lemma andb_2)
        lr
        lhs
        ((inst a (le 0 (+ sv k)))
         (inst c (andb (le mlo (+ sv k)) (le (+ (+ sv k) 8) msz))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h3 (= (le mlo (+ sv k)) True)
      (rewrite-with
        (lemma andb_3)
        lr
        lhs
        ((inst a (le 0 (+ sv k)))
         (inst b (lt (+ sv k) 4294967296))
         (inst d (le (+ (+ sv k) 8) msz)))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h4 (= (le (+ (+ sv k) 8) msz) True)
      (rewrite-with
        (lemma andb_4)
        lr
        lhs
        ((inst a (le 0 (+ sv k)))
         (inst b (lt (+ sv k) 4294967296))
         (inst c (le mlo (+ sv k))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma st_loadw)
      lr
      lhs
      ((inst sv sv))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise h1) lr lhs true ())) refl)
       (steps ((rewrite (premise h2) lr lhs true ())) refl)
       (steps ((rewrite (premise h3) lr lhs true ())) refl)
       (steps ((rewrite (premise h4) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl))
      refl)))

(claim st_storew_h
  (goal
    ((g Nat)
     (fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (p Int)
     (k Int)
     (v Int)
     (lc (List Int))
     (m Mem)
     (pv Int)
     (vv Int))
    ((= (ilget lc p) (Some pv))
     (= (ilget lc v) (Some vv))
     (= (ldok mlo msz (+ pv k)) True))
    (=
      (ipstmt
        (S g)
        fs
        mlo
        msz
        dmax
        d
        (IpStoreW (ITrunc U64 U32 (IBin U64 IAdd (ILoc p) (IConst k))) (ILoc v))
        lc
        m)
      (Some (IpNorm lc (store_le (iw8) m (+ pv k) vv)))))
  (chain
    (have hu
      (=
        (andb
          (le 0 (+ pv k))
          (andb
            (lt (+ pv k) 4294967296)
            (andb (le mlo (+ pv k)) (le (+ (+ pv k) 8) msz))))
        True)
      (steps ((rewrite (premise 2) rl rhs true ()) (unfold ldok rhs)) refl))
    (have h1 (= (le 0 (+ pv k)) True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst
           b
           (andb
             (lt (+ pv k) 4294967296)
             (andb (le mlo (+ pv k)) (le (+ (+ pv k) 8) msz)))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h2 (= (lt (+ pv k) 4294967296) True)
      (rewrite-with
        (lemma andb_2)
        lr
        lhs
        ((inst a (le 0 (+ pv k)))
         (inst c (andb (le mlo (+ pv k)) (le (+ (+ pv k) 8) msz))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h3 (= (le mlo (+ pv k)) True)
      (rewrite-with
        (lemma andb_3)
        lr
        lhs
        ((inst a (le 0 (+ pv k)))
         (inst b (lt (+ pv k) 4294967296))
         (inst d (le (+ (+ pv k) 8) msz)))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (have h4 (= (le (+ (+ pv k) 8) msz) True)
      (rewrite-with
        (lemma andb_4)
        lr
        lhs
        ((inst a (le 0 (+ pv k)))
         (inst b (lt (+ pv k) 4294967296))
         (inst c (le mlo (+ pv k))))
        ((steps ((rewrite (premise hu) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma st_storew)
      lr
      lhs
      ((inst pv pv) (inst vv vv))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise h1) lr lhs true ())) refl)
       (steps ((rewrite (premise h2) lr lhs true ())) refl)
       (steps ((rewrite (premise h3) lr lhs true ())) refl)
       (steps ((rewrite (premise h4) lr lhs true ())) refl))
      refl)))

;; --- the reads at the emitted literal offsets ------------------------------------

;; the header word at `a + 0`
(claim rd_hdr
  (goal ((m Mem) (rb Int) (g GHeap) (a Int))
    ((= (heap_rep m rb g) True) (= (memb (haddrs (gcells_of g)) a) True))
    (= (load_le (iw8) m (+ a 0)) (hword (hfget (gcells_of g) a))))
  (chain
    (have h0 (= (+ a 0) a) (by arith (list (list 1 0 0) (list 1 0 0))))
    (steps ((rewrite (premise h0) lr lhs true ())))
    (rewrite-with
      (lemma hr_rd_hdr)
      lr
      lhs
      ((inst rb rb) (inst g g))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl))
      refl)))

;; slot i's word at `a + k`, k = 8 + 8i spelled as the emitted literal
(claim rd_slot
  (goal ((m Mem) (rb Int) (g GHeap) (r (List Int)) (a Int) (k Int) (i Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (memb (haddrs (gcells_of g)) a) True)
     (= (le 0 i) True)
     (= (lt i (harity_of (hfget (gcells_of g) a))) True)
     (= k (+ 8 (* 8 i))))
    (= (load_le (iw8) m (+ a k)) (rb_slot (gcells_of g) a i)))
  (chain
    (steps ((rewrite (premise 5) lr lhs true ()) (unfold rb_slot rhs)))
    (rewrite-with
      (lemma hr_rd_slot)
      lr
      lhs
      ((inst rb rb) (inst r r) (inst g g))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)
       (steps ((rewrite (premise 4) lr lhs true ())) refl))
      refl)))

;; a live address is nonnegative (the parity test's band1_mod2 premise)
(claim cell_nonneg
  (goal ((rb Int) (g GHeap) (r (List Int)) (a Int))
    ((= (hinv rb g r) True) (= (memb (haddrs (gcells_of g)) a) True))
    (= (le 0 a) True))
  (chain
    (have hlv (= (live_ok g a) True)
      (rewrite-with
        (lemma live_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hlo (= (le (glo_of g) a) True)
      (rewrite-with
        (lemma lv_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hrb0 (= (le 0 rb) True)
      (rewrite-with
        (lemma hi_rb0)
        lr
        lhs
        ((inst g g) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hhdr (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (by arith (rows (goal 1) (hrb0 1) (hhdr 1) (hlo 1)))))

;; a live address is below 2^32 (the arena ends there)
(claim cell_u32
  (goal ((rb Int) (g GHeap) (r (List Int)) (a Int))
    ((= (hinv rb g r) True) (= (memb (haddrs (gcells_of g)) a) True))
    (= (lt a 4294967296) True))
  (chain
    (have hlv (= (live_ok g a) True)
      (rewrite-with
        (lemma live_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hhi
      (= (le (+ a (+ 8 (* 8 (harity_of (hfget (gcells_of g) a))))) (gtop_of g)) True)
      (rewrite-with
        (lemma lv_hi)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have hcb (= (cbands (hfget (gcells_of g) a)) True)
      (rewrite-with
        (lemma lv_bands)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlv) lr lhs true ())) refl))
        refl))
    (have ha0 (= (le 0 (harity_of (hfget (gcells_of g) a))) True)
      (rewrite-with
        (lemma cb_ar0)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hcb) lr lhs true ())) refl))
        refl))
    (have hte (= (le (gtop_of g) (gend_of g)) True)
      (rewrite-with
        (lemma hi_te)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have he32 (= (le (gend_of g) 4294967296) True)
      (rewrite-with
        (lemma hi_e32)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (by arith (rows (goal 1) (hhi 1) (ha0 8) (hte 1) (he32 1)))))

;; the argument band on entry is the identity on a live address
(claim w64_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 4294967296) True))
    (= (mod x 18446744073709551616) x))
  (rewrite-with
    (lemma mod_unique)
    lr
    lhs
    ((inst q 0) (inst r x))
    ((by arith (list (list 1 0 0) (list 1 0 0)))
     (steps ((rewrite (premise 0) lr lhs true ())) refl)
     (by arith (rows (goal 1) (1 1))))
    refl))

;; --- the constructor window: what app's arm cites ---------------------------------

;; the fill law at the emitted literal offset
(claim hr_fill_k
  (goal
    ((m Mem)
     (rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (i Int)
     (k Int)
     (w Int))
    ((= (heap_rep m rb g) True)
     (= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (ilen fill) i)
     (= (le 0 i) True)
     (= (lt i n) True)
     (= (le 0 w) True)
     (= (lt w 18446744073709551616) True)
     (= k (+ 8 (* 8 i))))
    (= (heap_rep (store_le (iw8) m (+ p k) w) rb (gh_fill g w)) True))
  (chain
    (steps ((rewrite (premise 8) lr lhs true ())))
    (rewrite-with
      (lemma hr_fill_g)
      lr
      lhs
      ((inst r r) (inst tag tag) (inst n n) (inst fill fill))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)
       (steps ((rewrite (premise 4) lr lhs true ())) refl)
       (steps ((rewrite (premise 5) lr lhs true ())) refl)
       (steps ((rewrite (premise 6) lr lhs true ())) refl)
       (steps ((rewrite (premise 7) lr lhs true ())) refl))
      refl)))

;; the raw cell's word access at `p + k` is in the window and below 2^32
(claim ldok_raw
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (mlo Int)
     (msz Int)
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int))
     (k Int))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (le mlo rb) True)
     (= (le (gend_of g) msz) True)
     (= (le 0 k) True)
     (= (le (+ k 8) (+ 8 (* 8 n))) True))
    (= (ldok mlo msz (+ p k)) True))
  (chain
    (have har (= (araw_ok g p tag n fill) True)
      (rewrite-with
        (lemma araw_facts)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hlo (= (le (glo_of g) p) True)
      (rewrite-with
        (lemma ar_lo)
        lr
        lhs
        ((inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise har) lr lhs true ())) refl))
        refl))
    (have hhi (= (le (+ p (+ 8 (* 8 n))) (gtop_of g)) True)
      (rewrite-with
        (lemma ar_hi)
        lr
        lhs
        ((inst tag tag) (inst fill fill))
        ((steps ((rewrite (premise har) lr lhs true ())) refl))
        refl))
    (have hrb0 (= (le 0 rb) True)
      (rewrite-with
        (lemma hi_rb0)
        lr
        lhs
        ((inst g g) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hhdr (= (le (+ rb 152) (glo_of g)) True)
      (rewrite-with
        (lemma hi_hdr)
        lr
        lhs
        ((inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hte (= (le (gtop_of g) (gend_of g)) True)
      (rewrite-with
        (lemma hi_te)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have he32 (= (le (gend_of g) 4294967296) True)
      (rewrite-with
        (lemma hi_e32)
        lr
        lhs
        ((inst rb rb) (inst r r))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h1 (= (le 0 (+ p k)) True)
      (by arith (rows (goal 1) (hrb0 1) (hhdr 1) (hlo 1) (4 1))))
    (have h2 (= (lt (+ p k) 4294967296) True)
      (by arith (rows (goal 1) (hhi 1) (hte 1) (he32 1) (5 1))))
    (have h3 (= (le mlo (+ p k)) True)
      (by arith (rows (goal 1) (2 1) (hhdr 1) (hlo 1) (4 1))))
    (have h4 (= (le (+ (+ p k) 8) msz) True)
      (by arith (rows (goal 1) (hhi 1) (hte 1) (3 1) (5 1))))
    (steps
      ((unfold ldok lhs)
       (rewrite (premise h1) lr lhs true ())
       (rewrite (premise h2) lr lhs true ())
       (rewrite (premise h3) lr lhs true ())
       (rewrite (premise h4) lr lhs true ())
       (compute lhs))
      refl)))

;; a word that decodes to a list is a valid slot word
(claim rbl_slot_ok
  (goal ((cs (List HCell)) (w Int) (v (List Int))) ((= (rb_list cs w v) True))
    (= (slot_ok w (haddrs cs)) True))
  (case-on v List
    ((case Nil
       (chain
         (have h1 (= (int_eq w 1) True)
           (rewrite-with
             (lemma rbl_nil)
             lr
             lhs
             ((inst cs cs))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 0) lr lhs true ()))
                refl))
             refl))
         (have he (= w 1)
           (rewrite-with
             (lemma int_eq_eq)
             lr
             lhs
             ((inst b 1))
             ((steps ((rewrite (premise h1) lr lhs true ())) refl))
             refl))
         (steps ((rewrite (premise he) lr lhs true ()) (compute lhs)) refl)))
     (case Cons
       (h t)
       (chain
         (have hc (= (rb_cell cs w 1 2) True)
           (rewrite-with
             (lemma rbl_cell)
             lr
             lhs
             ((inst h h) (inst t t))
             ((steps
                ((rewrite (hyp 0) rl lhs true ())
                 (rewrite (premise 0) lr lhs true ()))
                refl))
             refl))
         (have hm (= (memb (haddrs cs) w) True)
           (rewrite-with
             (lemma rbc_memb)
             lr
             lhs
             ((inst tag 1) (inst n 2))
             ((steps ((rewrite (premise hc) lr lhs true ())) refl))
             refl))
         (steps ((unfold slot_ok lhs) (rewrite (premise hm) lr lhs true ())))
         (case-on (int_eq (mod w 2) 1) Bool
           ((case True (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
            (case False
              (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl)))))))))

;; a stored reference was owned once in the roots after its inc
(claim rinc_mem
  (goal ((r (List Int)) (w Int)) ()
    (= (if (int_eq (mod w 2) 1) True (memb (rinc r w) w)) True))
  (case-on (int_eq (mod w 2) 1) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
     (case False
       (steps
         ((rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (unfold rinc lhs)
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (unfold memb lhs)
          (reduce lhs)
          (rewrite (lemma int_eq_refl) lr lhs true ())
          (compute lhs))
         refl)))))

;; storing the reference the inc added gives the roots back
(claim rdec_rinc
  (goal ((r (List Int)) (w Int)) () (= (rdec (rinc r w) w) r))
  (case-on (int_eq (mod w 2) 1) Bool
    ((case True
       (steps
         ((unfold rdec lhs)
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (unfold rinc lhs)
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs))
         refl))
     (case False
       (steps
         ((unfold rdec lhs)
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (unfold rinc lhs)
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (unfold irem lhs)
          (reduce lhs)
          (rewrite (lemma int_eq_refl) lr lhs true ())
          (reduce lhs))
         refl)))))

;; an inc on an immediate is the identity (ghost and memory)
(claim gh_inc_odd
  (goal ((g GHeap) (v Int)) ((= (int_eq (mod v 2) 1) True)) (= (gh_inc g v) g))
  (steps ((unfold gh_inc lhs) (rewrite (premise 0) lr lhs true ()) (reduce lhs))
    refl))

(claim m_inc_odd
  (goal ((m Mem) (g GHeap) (v Int)) ((= (int_eq (mod v 2) 1) True))
    (= (m_inc m g v) m))
  (steps ((unfold m_inc lhs) (rewrite (premise 0) lr lhs true ()) (reduce lhs))
    refl))

;; --- the arena end and the raw cell across the transitions -------------------------

(claim gend_inc
  (goal ((g GHeap) (v Int)) () (= (gend_of (gh_inc g v)) (gend_of g)))
  (chain
    (steps ((unfold gh_inc lhs)))
    (case-on (int_eq (mod v 2) 1) Bool
      ((case True (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
       (case False
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
           (case-on (hfind (gcells_of g) v) Option
             ((case None (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
              (case Some
                (c)
                (chain
                  (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
                  (case-on (le 2147483648 (hcount_of c)) Bool
                    ((case True
                       (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
                     (case False
                       (steps
                         ((rewrite (hyp 0) lr lhs true ())
                          (reduce lhs)
                          (rewrite (lemma gend_of_with_gcells) lr lhs true ()))
                         refl))))))))))))))

(claim gend_alloc
  (goal ((g GHeap) (tag Int) (n Int)) ()
    (= (gend_of (gh_alloc g tag n)) (gend_of g)))
  (chain
    (steps ((unfold gh_alloc lhs)))
    (case-on (lt n 16) Bool
      ((case True
         (chain
           (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)))
           (case-on (fl_at (gfree_of g) n) List
             ((case Nil
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (unfold gh_alloc_bump lhs)
                   (rewrite (lemma gend_of_with_gtop) lr lhs true ())
                   (rewrite (lemma gend_of_with_graw) lr lhs true ()))
                  refl))
              (case Cons
                (p rest)
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (unfold gh_alloc_pop lhs)
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs)
                   (rewrite (lemma gend_of_with_gfree) lr lhs true ())
                   (rewrite (lemma gend_of_with_graw) lr lhs true ()))
                  refl))))))
       (case False
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (reduce lhs)
            (unfold gh_alloc_bump lhs)
            (rewrite (lemma gend_of_with_gtop) lr lhs true ())
            (rewrite (lemma gend_of_with_graw) lr lhs true ()))
           refl))))))

(claim gend_fill
  (goal ((g GHeap) (w Int)) () (= (gend_of (gh_fill g w)) (gend_of g)))
  (chain
    (steps ((unfold gh_fill lhs)))
    (case-on (graw_of g) Option
      ((case None (steps ((rewrite (hyp 0) lr lhs true ()) (reduce lhs)) refl))
       (case Some
         (rc)
         (steps
           ((rewrite (hyp 0) lr lhs true ())
            (reduce lhs)
            (rewrite (lemma gend_of_with_graw) lr lhs true ()))
           refl))))))

(claim gend_seal
  (goal ((g GHeap) (p Int) (tag Int) (n Int) (fill (List Int)))
    ((= (graw_of g) (Some (MkHRaw p tag n fill))))
    (= (gend_of (gh_seal g)) (gend_of g)))
  (steps
    ((unfold gh_seal lhs)
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (rewrite (lemma gend_of_with_gcells) lr lhs true ())
     (rewrite (lemma gend_of_with_graw) lr lhs true ()))
    refl))

(claim graw_seal
  (goal ((g GHeap) (p Int) (tag Int) (n Int) (fill (List Int)))
    ((= (graw_of g) (Some (MkHRaw p tag n fill))))
    (= (graw_of (gh_seal g)) None))
  (steps
    ((unfold gh_seal lhs)
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (rewrite (lemma graw_of_with_gcells) lr lhs true ())
     (rewrite (lemma graw_of_with_graw) lr lhs true ()))
    refl))

;; the raw cell after a fill
(claim graw_fill
  (goal ((g GHeap) (p Int) (tag Int) (n Int) (fill (List Int)) (w Int))
    ((= (graw_of g) (Some (MkHRaw p tag n fill))))
    (= (graw_of (gh_fill g w)) (Some (MkHRaw p tag n (iapp fill (Cons w Nil))))))
  (chain
    (have hgf
      (= (gh_fill g w) (with_graw (Some (MkHRaw p tag n (iapp fill (Cons w Nil)))) g))
      (rewrite-with
        (lemma gh_fill_raw)
        lr
        lhs
        ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise hgf) lr lhs true ())
       (rewrite (lemma graw_of_with_graw) lr lhs true ()))
      refl)))

;; --- the seal at the roots ---------------------------------------------------------
;; rth_kit's hinv_seal keeps the roots and asks the raw address to be
;; counted once in them — unusable, since roots_ok admits live cells
;; only. The seal law B needs ADDS the new address to the roots: the
;; sealed cell's count 1 is its one new root.

;; no root is at an address the roots never reference
(claim roots_cin0
  (goal ((r (List Int)) (as (List Int)) (p Int))
    ((= (roots_ok r as) True) (= (memb as p) False))
    (= (count_in r p) 0))
  (induct r
    ((case Nil (steps ((compute lhs)) refl))
     (case Cons
       (h t)
       (chain
         (have hu (= (andb (memb as h) (roots_ok t as)) True)
           (steps
             ((rewrite (premise 0) rl rhs true ()) (unfold roots_ok rhs) (reduce rhs))
             refl))
         (have hm (= (memb as h) True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (roots_ok t as)))
             ((steps ((rewrite (premise hu) lr lhs true ())) refl))
             refl))
         (have hr (= (roots_ok t as) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst a (memb as h)))
             ((steps ((rewrite (premise hu) lr lhs true ())) refl))
             refl))
         (have hih (= (count_in t p) 0)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ((inst as as))
             ((steps ((rewrite (premise hr) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hne (= (int_eq h p) False)
           (case-on (int_eq h p) Bool
             ((case True
                (chain
                  (have heq (= h p)
                    (rewrite-with
                      (lemma int_eq_eq)
                      lr
                      lhs
                      ((inst b p))
                      ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                      refl))
                  (have hf (= False True)
                    (steps
                      ((rewrite (premise 1) rl lhs true ())
                       (rewrite (premise heq) rl lhs true ())
                       (rewrite (premise hm) lr lhs true ()))
                      refl))
                  (absurd (premise hf))))
              (case False (steps ((rewrite (hyp 0) lr lhs true ())) refl)))))
         (steps
           ((unfold count_in lhs)
            (reduce lhs)
            (rewrite (premise hne) lr lhs true ())
            (reduce lhs)
            (rewrite (premise hih) lr lhs true ()))
           refl))))))

;; a root at no live address changes no cell's count
(claim counts_ok_roots_cons
  (goal
    ((all (List HCell)) (cs (List HCell)) (r (List Int)) (raw (Option HRaw)) (p Int))
    ((= (counts_ok all cs r raw) True) (= (memb (haddrs cs) p) False))
    (= (counts_ok all cs (Cons p r) raw) True))
  (induct cs
    ((case Nil (steps ((compute lhs)) refl))
     (case Cons
       (c rest)
       (chain
         (have hu
           (=
             (andb
               (if (le 2147483648 (hcount_of c)) True (int_eq (hcount_of c) (+ (count_in r (haddr_of c)) (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))
               (counts_ok all rest r raw))
             True)
           (steps
             ((rewrite (premise 0) rl rhs true ()) (unfold counts_ok rhs) (reduce rhs))
             refl))
         (have hhd
           (=
             (if (le 2147483648 (hcount_of c)) True (int_eq (hcount_of c) (+ (count_in r (haddr_of c)) (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))
             True)
           (rewrite-with
             (lemma andb_l)
             lr
             lhs
             ((inst b (counts_ok all rest r raw)))
             ((steps ((rewrite (premise hu) lr lhs true ())) refl))
             refl))
         (have hrt (= (counts_ok all rest r raw) True)
           (rewrite-with
             (lemma andb_r)
             lr
             lhs
             ((inst
                a
                (if (le 2147483648 (hcount_of c)) True (int_eq (hcount_of c) (+ (count_in r (haddr_of c)) (+ (inbound_cells all (haddr_of c)) (raw_refs raw (haddr_of c))))))))
             ((steps ((rewrite (premise hu) lr lhs true ())) refl))
             refl))
         (have hmu
           (= (if (int_eq (haddr_of c) p) True (memb (haddrs rest) p)) False)
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (unfold haddrs rhs)
              (reduce rhs)
              (unfold memb rhs)
              (reduce rhs))
             refl))
         (have hne (= (int_eq (haddr_of c) p) False)
           (case-on (int_eq (haddr_of c) p) Bool
             ((case True
                (chain
                  (have hf (= False True)
                    (steps
                      ((rewrite (premise hmu) rl lhs true ())
                       (rewrite (hyp 0) lr lhs true ())
                       (compute lhs))
                      refl))
                  (absurd (premise hf))))
              (case False (steps ((rewrite (hyp 0) lr lhs true ())) refl)))))
         (have hmr (= (memb (haddrs rest) p) False)
           (steps
             ((rewrite (premise hmu) rl rhs true ())
              (rewrite (premise hne) lr rhs true ())
              (reduce rhs))
             refl))
         (have hih (= (counts_ok all rest (Cons p r) raw) True)
           (rewrite-with
             (hyp 0)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hrt) lr lhs true ())) refl)
              (steps ((rewrite (premise hmr) lr lhs true ())) refl))
             refl))
         (have hne2 (= (int_eq p (haddr_of c)) False)
           (case-on (int_eq p (haddr_of c)) Bool
             ((case True
                (chain
                  (have heq (= p (haddr_of c))
                    (rewrite-with
                      (lemma int_eq_eq)
                      lr
                      lhs
                      ((inst b (haddr_of c)))
                      ((steps ((rewrite (hyp 0) lr lhs true ())) refl))
                      refl))
                  (have hf (= False True)
                    (steps
                      ((rewrite (premise hne) rl lhs true ())
                       (rewrite (premise heq) rl lhs true ())
                       (rewrite (lemma int_eq_refl) lr lhs true ()))
                      refl))
                  (absurd (premise hf))))
              (case False (steps ((rewrite (hyp 0) lr lhs true ())) refl)))))
         (have hcc
           (= (count_in (Cons p r) (haddr_of c)) (count_in r (haddr_of c)))
           (steps
             ((unfold count_in lhs)
              (reduce lhs)
              (rewrite (premise hne2) lr lhs true ())
              (reduce lhs))
             refl))
         (steps
           ((unfold counts_ok lhs)
            (reduce lhs)
            (rewrite (premise hcc) lr lhs true ())
            (rewrite (premise hhd) lr lhs true ())
            (rewrite (premise hih) lr lhs true ())
            (compute lhs))
           refl))))))

(claim hinv_seal_r
  (goal
    ((rb Int)
     (g GHeap)
     (r (List Int))
     (p Int)
     (tag Int)
     (n Int)
     (fill (List Int)))
    ((= (hinv rb g r) True)
     (= (graw_of g) (Some (MkHRaw p tag n fill)))
     (= (int_eq (ilen fill) n) True))
    (= (hinv rb (gh_seal g) (Cons p r)) True))
  (case-on g GHeap
    ((case MkGHeap
       (gc gf gl gt ge gr)
       (chain
         (have hgr (= gr (Some (MkHRaw p tag n fill)))
           (steps
             ((rewrite (premise 1) rl rhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute rhs))
             refl))
         (have hsl
           (=
             (gh_seal g)
             (MkGHeap (Cons (MkHCell p 1 tag n fill) gc) gf gl gt ge None))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (unfold gh_seal lhs)
              (compute lhs))
             refl))
         (have hgl0 (= (glo_of g) gl)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgt0 (= (gtop_of g) gt)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hge0 (= (gend_of g) ge)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgc0 (= (gcells_of g) gc)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hgf0 (= (gfree_of g) gf)
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have har (= (araw_ok g p tag n fill) True)
           (rewrite-with
             (lemma araw_facts)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (have hal (= (int_eq (mod p 8) 0) True)
           (rewrite-with
             (lemma ar_al)
             lr
             lhs
             ((inst g g) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hhc0 (= (int_eq (count_in (haddrs (gcells_of g)) p) 0) True)
           (rewrite-with
             (lemma ar_hc0)
             lr
             lhs
             ((inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hfc0 (= (int_eq (count_in (faddrs (gfree_of g)) p) 0) True)
           (rewrite-with
             (lemma ar_fc0)
             lr
             lhs
             ((inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hmem (= (emem (ext_all g) p n) True)
           (rewrite-with
             (lemma ar_mem)
             lr
             lhs
             ((inst tag tag) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hecells (= (eall (hexts (gcells_of g)) (ext_all g)) True)
           (rewrite-with
             (lemma ar_ecells)
             lr
             lhs
             ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hefree (= (eall (fexts (gfree_of g) 0) (ext_all g)) True)
           (rewrite-with
             (lemma ar_efree)
             lr
             lhs
             ((inst p p) (inst tag tag) (inst n n) (inst fill fill))
             ((steps ((rewrite (premise har) lr lhs true ())) refl))
             refl))
         (have hx1
           (=
             (ext_all g)
             (fexts_app
               (hexts gc)
               (fexts_app (fexts gf 0) (Cons (Pair p n) Nil))))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (premise hgr) lr lhs true ())
              (unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app)))
             refl))
         (have hx2
           (=
             (ext_all
               (MkGHeap (Cons (MkHCell p 1 tag n fill) gc) gf gl gt ge None))
             (Cons
               (Pair p n)
               (fexts_app (hexts gc) (fexts_app (fexts gf 0) Nil))))
           (steps
             ((unfold ext_all lhs)
              (compute lhs (stop hexts fexts fexts_app))
              (unfold hexts lhs)
              (reduce lhs)
              (compute lhs (stop hexts fexts fexts_app))
              (unfold fexts_app lhs)
              (reduce lhs))
             refl))
         (have h1 (= (le 0 rb) True)
           (rewrite-with
             (lemma hi_rb0)
             lr
             lhs
             ((inst g g) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h2g (= (le (+ rb 152) (glo_of g)) True)
           (rewrite-with
             (lemma hi_hdr)
             lr
             lhs
             ((inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h2 (= (le (+ rb 152) gl) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h2g) lr lhs true ()))
             refl))
         (have h3g (= (le (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_lot)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h3 (= (le gl gt) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h3g) lr lhs true ()))
             refl))
         (have h4g (= (le (gtop_of g) (gend_of g)) True)
           (rewrite-with
             (lemma hi_te)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h4 (= (le gt ge) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise hge0) rl lhs true ())
              (rewrite (premise h4g) lr lhs true ()))
             refl))
         (have h5g (= (le (gend_of g) 4294967296) True)
           (rewrite-with
             (lemma hi_e32)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h5 (= (le ge 4294967296) True)
           (steps
             ((rewrite (premise hge0) rl lhs true ())
              (rewrite (premise h5g) lr lhs true ()))
             refl))
         (have h6g (= (int_eq (mod (glo_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_alo)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h6 (= (int_eq (mod gl 8) 0) True)
           (steps
             ((rewrite (premise hgl0) rl lhs true ())
              (rewrite (premise h6g) lr lhs true ()))
             refl))
         (have h7g (= (int_eq (mod (gtop_of g) 8) 0) True)
           (rewrite-with
             (lemma hi_atop)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have h7 (= (int_eq (mod gt 8) 0) True)
           (steps
             ((rewrite (premise hgt0) rl lhs true ())
              (rewrite (premise h7g) lr lhs true ()))
             refl))
         (have hdj (= (e_disj (ext_all g)) True)
           (rewrite-with
             (lemma hi_disj)
             lr
             lhs
             ((inst rb rb) (inst r r))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hbkg (= (e_brk (ext_all g) (glo_of g) (gtop_of g)) True)
           (rewrite-with
             (lemma hi_brk)
