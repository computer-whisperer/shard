        refl))
    (rewrite-with
      (lemma andb_l)
      lr
      lhs
      ((inst b (andb (rb_int (rb_slot cs w 0) h) (rb_list cs (rb_slot cs w 1) t))))
      ((steps ((rewrite (premise hu) lr lhs true ())) refl))
      refl)))

(claim rbl_hd
  (goal ((cs (List HCell)) (w Int) (h Int) (t (List Int)))
    ((= (rb_list cs w (Cons h t)) True))
    (= (rb_int (rb_slot cs w 0) h) True))
  (chain
    (have hu
      (=
        (andb
          (rb_cell cs w 1 2)
          (andb (rb_int (rb_slot cs w 0) h) (rb_list cs (rb_slot cs w 1) t)))
