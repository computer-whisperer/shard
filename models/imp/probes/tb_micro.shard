                                                 (imm n)
                                                 (imm (+ n (sumto (- n 1)))))
                                               (bxor
                                                 (dbl (sumto (- n 1)))
                                                 (imm (+ n (sumto (- n 1))))))
                                             63)
                                           0)
                                         Bool
