;;; models/imp/probes/tb_micro.shard — THEOREM B's FIRST INSTANCE (the B-0
;;; probe, docs/COVERAGE.md §10): the per-fn certificate of `sumto` of the
;;; micro-flagship over tools/impc's product micro_ipc_out.shard, stated at
;;; the ipcall grain over ANY table holding the fn at its index (P5's call
;;; composition) and instanced at the micro table. Hand-written as the
;;; template; the kit it cites is tb_kit.shard.

(import "../../../kernel/stdlib.shard")
(import "../../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../../std/mem")
(use (:: std mem *))
(import "../../../std/nat")
