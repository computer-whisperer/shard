                                                       lr
                                                       rhs
                                                       true
                                                       ())
                                                     (compute rhs (stop sumto)))
                                                    refl))
                                                (absurd (premise hf)))))))
                                       ;; the add step: bm := w - 1 = dbl S1; t := n + bm = imm (n + S1)
                                       (steps
                                         ((rewrite (hyp 1) lr lhs true ())
                                          (rewrite (hyp 0) lr lhs true ())
                                          (rewrite (premise hw) lr lhs true ())
                                          (compute
