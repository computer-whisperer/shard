;; THE PER-FN THEOREM OF t_arith: four calls to id (the callee's theorem cited
;; through the table premise — P5's composition beyond self-recursion), two
;; muls (mul_run at literal operands), a sub and an add.
;; Slots: premises 0 table 30, 1 table 29, 2 budget.
(claim tb_t_arith
  (goal
    ((fuel Nat)
     (fs (List IpFn))
     (rb Int)
     (mlo Int)
     (msz Int)
     (dmax Int)
