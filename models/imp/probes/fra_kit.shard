(claim ikw_pos
  (goal ((k IKind)) () (= (lt 0 (ikw k)) True))
  (case-on k IKind
    ((case U8 (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
     (case U32 (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
     (case U64 (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl)))))

;; THE VALUE BAND (generated by gen_fra.py fe_band — REGENERATE, never hand-patch)
(claim fe_band
  (goal
    ((e IExp)
     (lc (List Int))
     (mem Mem)
