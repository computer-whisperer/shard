           (have ho (= out (IpFailed fam))
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (have h8
             (=
               (xeval_seq
                 (xt (- c (xil iss)) g)
                 m
                 it
                 (MkRegs
                   (rax_of
                     (xo_regs
                       (xeval_seq
                         (xt c g)
                         m
                         iss
                         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13
                           dep fp)
                         (fp_mem mem0 psx))))
                   rcx
                   (rdx_of
                     (xo_regs
                       (xeval_seq
                         (xt c g)
                         m
                         iss
                         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13
                           dep fp)
                         (fp_mem mem0 psx))))
                   rbx
                   rbp
                   rsi
                   di
                   r8
                   r9
                   (r10_of
                     (xo_regs
                       (xeval_seq
                         (xt c g)
                         m
                         iss
                         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13
                           dep fp)
                         (fp_mem mem0 psx))))
                   (r11_of
                     (xo_regs
                       (xeval_seq
                         (xt c g)
                         m
                         iss
                         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13
                           dep fp)
                         (fp_mem mem0 psx))))
                   r12
                   r13
                   dep
                   fp)
                 (fp_mem
                   mem0
                   (fp_app
                     (ipt_tr
                       f
                       fs
                       mlo
                       slo
                       dmax
                       dep
                       fp
                       nl
                       own
                       (IqStmt s)
                       lc
                       (fp_mem mem0 (fbelow slo psx)))
                     psx)))
               (Some XTrap))
             (steps
               ((rewrite (premise 8) lr lhs true ())
                (rewrite (premise ho) lr lhs true ())
                (unfold ixt_expect lhs)
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise ho) lr rhs true ())
              (unfold ixt_expect rhs)
              (reduce rhs)
              (rewrite (premise h8) lr lhs true ()))
             refl)))))))

(claim fs_step_cons_fail
  (goal
    ((s IpStmt)
     (t (List IpStmt))
     (iss (List XInstr))
     (it (List XInstr))
     (out IpOut)
     (fam IFam)
     (is (List XInstr))
     (nl Int)
     (own Int)
     (fail_ix Int)
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (f Nat)
     (fs (List IpFn))
     (dmax Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_stmts nl own fail_ix (Cons s t)) (Some is))
     (= (ixf_stmt nl own fail_ix s) (Some iss))
     (= (ixf_stmts nl own fail_ix t) (Some it))
     (=
       (ipstmts
         (S f)
         fs
         mlo
         slo
         dmax
         dep
         (Cons s t)
         lc
         (fp_mem mem0 (fbelow slo psx)))
       (Some out))
     (=
       (ipstmt f fs mlo slo dmax dep s lc (fp_mem mem0 (fbelow slo psx)))
       (Some (IpFailed fam)))
     (= (le (xil iss) c) True)
     (=
       (xeval_seq
         (xt c g)
         m
         iss
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (ixt_expect
         (IqStmt s)
         (IpFailed fam)
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_seq
           (xt c g)
           m
           iss
           (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
           (fp_mem mem0 psx))
         (fp_mem
           mem0
           (fp_app
             (ipt_tr
               f
               fs
               mlo
               slo
               dmax
               dep
               fp
               nl
               own
               (IqStmt s)
               lc
               (fp_mem mem0 (fbelow slo psx)))
             psx)))))
    (=
      (xeval_seq
        (xt c g)
        m
        is
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (ixt_expect
        (IqStmts (Cons s t))
        out
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          is
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (ipt_tr
              (S f)
              fs
              mlo
              slo
              dmax
              dep
              fp
              nl
              own
              (IqStmts (Cons s t))
              lc
              (fp_mem mem0 (fbelow slo psx)))
            psx)))))
  (chain
    (have hsome (= (Some (ix_app iss it)) (Some is))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_stmts rhs)
         (reduce rhs)
         (rewrite (premise 2) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 1) lr rhs true ())
         (reduce rhs))
        refl))
    (inject (premise hsome) (his))
    (have hout (= (Some (IpFailed fam)) (Some out))
      (steps
        ((rewrite (premise 3) rl rhs true ())
         (unfold ipstmts rhs)
         (reduce rhs)
         (rewrite (premise 4) lr rhs true ())
         (reduce rhs))
        refl))
    (inject (premise hout) (ho))
    (have h7
      (=
        (xeval_seq
          (xt c g)
          m
          iss
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (Some XTrap))
      (steps
        ((rewrite (premise 6) lr lhs true ())
         (unfold ixt_expect lhs)
         (reduce lhs))
        refl))
    (have hrun
      (=
        (xeval_seq
          (xt c g)
          m
          is
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (Some XTrap))
      (chain
        (steps ((rewrite (premise his) rl lhs true ())))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 5) lr lhs true ())) refl)))
        (steps
          ((rewrite (premise h7) lr lhs true ())
           (unfold xcont lhs)
           (reduce lhs))
          refl)))
    (steps
      ((rewrite (premise hrun) lr both true ())
       (rewrite (premise ho) rl rhs true ())
       (unfold ixt_expect rhs)
       (reduce rhs))
      refl)))

(claim fs_step_if_t
