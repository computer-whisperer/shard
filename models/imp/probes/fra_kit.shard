                (chain
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
