(claim fe_step_eq
  (goal
    ((k IKind)
     (a IExp)
     (b IExp)
     (ia (List XInstr))
     (va Int)
     (ib (List XInstr))
     (vb Int)
     (nl Int)
     (d Int)
     (ie (List XInstr))
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (v Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d (IBin k IEq a b)) (Some ie))
     (=
       (iexp (IBin k IEq a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb (IBin k IEq a b)) True)
     (=
       (le (+ fp (* 8 (+ nl (+ d (ixf_dep (IBin k IEq a b)))))) (xmemhi_of m))
       True)
