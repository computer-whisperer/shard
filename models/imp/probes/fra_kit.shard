                    (steps
                      ((rewrite (premise 1) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise 7) lr rhs true ())
                       (reduce rhs)
                       (rewrite (premise hl0) lr rhs true ())
                       (reduce rhs)
                       (rewrite (premise hl1) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (inject (premise hv) (hvv))
                  (have hlen (= (xil ia) (ixf_elen a))
                    (rewrite-with
                      (lemma fe_len)
                      lr
                      lhs
                      ((inst nl nl) (inst d d) (inst e a))
