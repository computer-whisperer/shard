                            (rewrite (lemma xil_app) lr lhs true ())
                            (rewrite (lemma xil_app) lr lhs true ()))
                           refl))
                       (steps
                         ((rewrite (premise hst) lr lhs true ())
                          (unfold ixf_scost lhs)
                          (reduce lhs)
                          (unfold ixf_ecost lhs)
                          (unfold ixf_ecost lhs))
                         (by arith (list 1 0 0 0 0 -1 -1 0 0 -1 -1 -1 -1)))))))))))))
     (case IpIf
