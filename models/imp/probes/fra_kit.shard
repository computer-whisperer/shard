(claim fe_tr_locs
  (goal
    ((e IExp)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (mem Mem)
     (mlo Int)
     (msz Int)
     (psx (List FPatch)))
    ((= (fr_locs fp lc psx) True) (= (le (ilen lc) nl) True) (= (le 0 d) True))
    (= (fr_locs fp lc (fp_app (fe_tr fp nl d e lc mem mlo msz) psx)) True))
