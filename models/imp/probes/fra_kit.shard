(claim fs_step_nil
  (goal
    ((out IpOut)
     (is (List XInstr))
     (nl Int)
     (own Int)
     (fail_ix Int)
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (f Nat)
     (fs (List IpFn))
     (dmax Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_stmts nl own fail_ix Nil) (Some is))
     (=
       (ipstmts (S f) fs mlo slo dmax dep Nil lc (fp_mem mem0 (fbelow slo psx)))
       (Some out))
     (= (le 1 c) True))
    (=
      (xeval_seq
        (xt c g)
        m
        is
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (ixt_expect
        (IqStmts Nil)
        out
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          is
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (ipt_tr
              (S f)
              fs
              mlo
              slo
              dmax
              dep
              fp
              nl
              own
              (IqStmts Nil)
              lc
              (fp_mem mem0 (fbelow slo psx)))
            psx)))))
  (chain
    (have hsome (= (Some Nil) (Some is))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_stmts rhs)
         (reduce rhs))
        refl))
    (inject (premise hsome) (his))
    (have hn1 (= (Some (IpNorm lc (fp_mem mem0 (fbelow slo psx)))) (Some out))
      (steps
        ((rewrite (premise 1) rl rhs true ()) (unfold ipstmts rhs) (reduce rhs))
        refl))
    (inject (premise hn1) (hout))
    (have hc (= (lt 0 c) True) (by arith (list 1 0 0 1 0 0)))
    (have hrun
      (=
        (xeval_seq
          (xt c g)
          m
          is
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (Some
          (XNorm
            (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
            (fp_mem mem0 psx))))
      (chain
        (steps ((rewrite (premise his) rl lhs true ())))
        (rewrite-with
          (lemma xt_peel)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hc) lr lhs true ())) refl)))
        (steps ((unfold xeval_seq lhs) (reduce lhs)) refl)))
    (steps
      ((rewrite (premise hrun) lr both true ())
       (rewrite (premise hout) rl rhs true ())
       (unfold ixt_expect rhs)
       (reduce rhs)
       (rewrite (lemma fs_out_of_norm) lr rhs true ())
       (rewrite (lemma rax_of_mk) lr rhs true ())
       (rewrite (lemma rcx_of_mk) lr rhs true ())
       (rewrite (lemma rdx_of_mk) lr rhs true ())
       (rewrite (lemma rbx_of_mk) lr rhs true ())
       (rewrite (lemma rbp_of_mk) lr rhs true ())
       (rewrite (lemma rsi_of_mk) lr rhs true ())
       (rewrite (lemma rdi_of_mk) lr rhs true ())
       (rewrite (lemma r8_of_mk) lr rhs true ())
       (rewrite (lemma r9_of_mk) lr rhs true ())
       (rewrite (lemma r10_of_mk) lr rhs true ())
       (rewrite (lemma r11_of_mk) lr rhs true ())
       (rewrite (lemma r12_of_mk) lr rhs true ())
       (rewrite (lemma r13_of_mk) lr rhs true ())
       (rewrite (lemma r14_of_mk) lr rhs true ())
       (rewrite (lemma r15_of_mk) lr rhs true ())
       (unfold ipt_tr rhs)
       (reduce rhs)
       (unfold ipt_stmts rhs)
       (reduce rhs)
       (unfold fp_app rhs)
       (reduce rhs))
      refl)))

