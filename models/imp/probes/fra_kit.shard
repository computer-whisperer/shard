;; ground block lengths
(claim xil_slot
  (goal ((i Int)) () (= (xil (ixf_slot i)) 2))
  (steps ((compute lhs)) refl))

(claim xil_ld
  (goal ((i Int)) () (= (xil (ixf_ld i)) 3))
  (steps ((compute lhs)) refl))

(claim xil_st
  (goal ((i Int)) () (= (xil (ixf_st i)) 3))
