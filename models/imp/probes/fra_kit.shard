                                        (reduce rhs)
                                        (unfold ixf_oplen rhs)
                                        (reduce rhs)
                                        (compute rhs (stop ixf_elen)))
                                       refl))))))))))))))))
          (case ISub
            (chain
              (have ho (= o ISub)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hp (= (ixf_exp nl d (IBin k ISub a b)) (Some ie))
                (steps
                  ((rewrite (premise ho) rl lhs true ())
