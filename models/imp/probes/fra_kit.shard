(claim fe_tr_min
  (goal
    ((e IExp)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (mem Mem)
     (mlo Int)
     (msz Int))
    ()
    (= (fp_min (fe_tr fp nl d e lc mem mlo msz) (+ fp (* 8 (+ nl d)))) True))
  (induct e
    ((case IConst
       (n)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps ((unfold fp_min lhs) (reduce lhs)) refl)))
     (case ILoc
       (i)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps ((unfold fp_min lhs) (reduce lhs)) refl)))
     (case IBin
       (k o a b)
       (case-on o IOp
         ((case IAdd
            (chain
              (have ho (= o IAdd)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
                 (unfold fe_tr lhs)
                 (reduce lhs)))
              (case-on (iexp a lc mem mlo msz) Option
                ((case None
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) None)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (steps ((unfold fp_min lhs) (reduce lhs)) refl)))
                 (case Some
                   (va)
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) (Some va))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (chain
                       (have hmb
                         (=
                           (fp_min
                             (fe_tr fp nl (+ d 1) b lc mem mlo msz)
                             (+ fp (* 8 (+ nl (+ d 1)))))
                           True)
                         (rewrite-with (hyp ih1) lr lhs () () refl))
                       (have hle
                         (=
                           (le
                             (+ fp (* 8 (+ nl d)))
                             (+ fp (* 8 (+ nl (+ d 1)))))
                           True)
                         (by arith (list 1 0)))
                       (have hmb2
                         (=
                           (fp_min
                             (fe_tr fp nl (+ d 1) b lc mem mlo msz)
                             (+ fp (* 8 (+ nl d))))
                           True)
                         (rewrite-with
                           (lemma fp_min_weaken)
                           lr
                           lhs
                           ((inst lo (+ fp (* 8 (+ nl (+ d 1))))))
                           ((steps
                              ((rewrite (premise hmb) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hle) lr lhs true ()))
