(claim cb_trunc
  (goal ((k1 IKind) (kt IKind) (a IExp)) ((= (ixf_cb (ITrunc k1 kt a)) True))
    (= (ixf_cb a) True))
  (steps
    ((rewrite (premise 0) rl rhs true ()) (unfold ixf_cb rhs) (reduce rhs))
