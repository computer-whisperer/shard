(claim ipcall_fit
  (goal
    ((f Nat)
     (fs (List IpFn))
     (mlo Int)
     (msz Int)
     (dmax Int)
     (d Int)
     (k Int)
     (vs (List Int))
     (mem Mem)
     (r IpRet))
    ((= (ipcall f fs mlo msz dmax d k vs mem) (Some r)) (= (ipr_trap r) False))
    (= (le (* 8 (ilen vs)) (ixf_maxown fs)) True))
  (case-on f Nat
    ((case Z
       (chain
         (have hf (= f Z) (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hn (= None (Some r))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (premise hf) lr rhs true ())
              (unfold ipcall rhs)
              (reduce rhs))
             refl))
         (absurd (premise hn))))
     (case S
       (f2)
       (chain
         (have hf (= f (S f2)) (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (case-on (ipfn_at fs k) Option
           ((case None
              (chain
                (have hg (= (ipfn_at fs k) None)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (have hs (= (Some IpRtrap) (Some r))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (rewrite (premise hf) lr rhs true ())
                     (unfold ipcall rhs)
                     (reduce rhs)
                     (rewrite (premise hg) lr rhs true ())
                     (reduce rhs))
                    refl))
                (inject (premise hs) (hr))
                (have hff (= True False)
                  (steps
                    ((rewrite (premise 1) rl rhs true ())
                     (rewrite (premise hr) rl rhs true ())
                     (unfold ipr_trap rhs)
                     (reduce rhs))
                    refl))
                (absurd (premise hff))))
            (case Some
              (g)
              (chain
                (have hg (= (ipfn_at fs k) (Some g))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (case-on (int_eq (ilen vs) (ikn (ipparams_of g))) Bool
                  ((case False
                     (chain
                       (have ha
                         (= (int_eq (ilen vs) (ikn (ipparams_of g))) False)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (have hs (= (Some IpRtrap) (Some r))
                         (steps
                           ((rewrite (premise 0) rl rhs true ())
                            (rewrite (premise hf) lr rhs true ())
                            (unfold ipcall rhs)
                            (reduce rhs)
                            (rewrite (premise hg) lr rhs true ())
                            (reduce rhs)
                            (rewrite (premise ha) lr rhs true ())
                            (reduce rhs))
                           refl))
                       (inject (premise hs) (hr))
                       (have hff (= True False)
                         (steps
                           ((rewrite (premise 1) rl rhs true ())
                            (rewrite (premise hr) rl rhs true ())
                            (unfold ipr_trap rhs)
                            (reduce rhs))
                           refl))
                       (absurd (premise hff))))
                   (case True
                     (chain
                       (have ha
                         (= (int_eq (ilen vs) (ikn (ipparams_of g))) True)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (have heq (= (ilen vs) (ikn (ipparams_of g)))
                         (rewrite-with
                           (lemma int_eq_eq)
                           lr
                           lhs
                           ((inst a (ilen vs)) (inst b (ikn (ipparams_of g))))
                           ((steps ((rewrite (premise ha) lr lhs true ())) refl))
                           refl))
                       (have hne (= (le 0 (ikn (ipextra_of g))) True)
                         (rewrite-with (lemma ikn_nonneg) lr lhs () () refl))
                       (have hsd (= (le 0 (ixf_sdep (ipbody_of g))) True)
                         (rewrite-with
                           (lemma ixf_sdep_nonneg)
                           lr
                           lhs
                           ()
                           ()
                           refl))
                       (have hown
                         (=
                           (le
                             (*
                               8
                               (+
                                 (+ (ikn (ipparams_of g)) (ikn (ipextra_of g)))
                                 (+ 1 (ixf_sdep (ipbody_of g)))))
                             (ixf_own g))
                           True)
                         (rewrite-with (lemma ixf_own_body) lr lhs () () refl))
                       (have hmo (= (le (ixf_own g) (ixf_maxown fs)) True)
                         (rewrite-with
                           (lemma ixf_maxown_at)
                           lr
                           lhs
                           ((inst k k))
                           ((steps ((rewrite (premise hg) lr lhs true ())) refl))
                           refl))
                       (by arith (list 1 0 0 0 0 0 -8 8 8 1 1)))))))))))))))

(claim ixf_fns_some
  (goal
    ((fs (List IpFn))
     (k Int)
     (g IpFn)
     (dmax Int)
     (fail_ix Int)
     (xfs (List XFunc)))
    ((= (ipfn_at fs k) (Some g)) (= (ixf_fns dmax fail_ix fs) (Some xfs)))
    (= (xf_some (ixf_fn dmax fail_ix g)) True))
  (induct fs
    ((case Nil
       (chain
         (have hn (= None (Some g))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ipfn_at rhs)
              (reduce rhs))
             refl))
         (absurd (premise hn))))
     (case Cons
       (h t)
       (case-on (ixf_fn dmax fail_ix h) Option
         ((case None
            (chain
              (have hxf (= (ixf_fn dmax fail_ix h) None)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hn (= None (Some xfs))
                (steps
                  ((rewrite (premise 1) rl rhs true ())
                   (unfold ixf_fns rhs)
                   (reduce rhs)
                   (rewrite (premise hxf) lr rhs true ())
                   (reduce rhs))
                  refl))
              (absurd (premise hn))))
          (case Some
            (xf)
            (chain
              (have hxf (= (ixf_fn dmax fail_ix h) (Some xf))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (case-on (ixf_fns dmax fail_ix t) Option
                ((case None
                   (chain
                     (have hxt (= (ixf_fns dmax fail_ix t) None)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hn (= None (Some xfs))
                       (steps
                         ((rewrite (premise 1) rl rhs true ())
                          (unfold ixf_fns rhs)
                          (reduce rhs)
                          (rewrite (premise hxf) lr rhs true ())
                          (reduce rhs)
                          (rewrite (premise hxt) lr rhs true ())
                          (reduce rhs))
                         refl))
                     (absurd (premise hn))))
                 (case Some
                   (xt)
                   (chain
                     (have hxt (= (ixf_fns dmax fail_ix t) (Some xt))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (case-on (int_eq k 0) Bool
                       ((case True
                          (chain
                            (have hk (= (int_eq k 0) True)
                              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            (have hg (= (Some h) (Some g))
                              (steps
                                ((rewrite (premise 0) rl rhs true ())
                                 (unfold ipfn_at rhs)
                                 (reduce rhs)
                                 (rewrite (premise hk) lr rhs true ())
                                 (reduce rhs))
                                refl))
                            (inject (premise hg) (hhg))
                            (steps
                              ((rewrite (premise hhg) rl lhs true ())
                               (rewrite (premise hxf) lr lhs true ())
                               (unfold xf_some lhs)
                               (reduce lhs))
                              refl)))
                        (case False
                          (chain
                            (have hk (= (int_eq k 0) False)
                              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            (have hat (= (ipfn_at t (- k 1)) (Some g))
                              (steps
                                ((rewrite (premise 0) rl rhs true ())
                                 (unfold ipfn_at rhs)
                                 (reduce rhs)
                                 (rewrite (premise hk) lr rhs true ())
                                 (reduce rhs))
                                refl))
                            (rewrite-with
                              (hyp ih)
                              lr
                              lhs
                              ((inst k (- k 1))
                               (inst xfs xt)
                               (inst g g)
                               (inst dmax dmax)
                               (inst fail_ix fail_ix))
                              ((steps
                                 ((rewrite (premise hat) lr lhs true ()))
                                 refl)
                               (steps
                                 ((rewrite (premise hxt) lr lhs true ()))
                                 refl)))
                            refl))))))))))))))))

(claim ipout_none
  (goal () () (= (ipout_of_ret None) None))
  (steps ((unfold ipout_of_ret lhs) (reduce lhs)) refl))

(claim post_call_ctx
  (goal
    ((k Int)
     (m XModule)
     (mlo Int)
     (slo Int)
     (fp Int)
     (nl Int)
     (lc2 (List Int))
     (ps (List FPatch)))
    ((= (ixt_post (IqCall k) m mlo slo fp nl lc2 ps) True))
    (= (fe_ctx m mlo slo fp nl 0 Nil ps) True))
  (case-on (fe_ctx m mlo slo fp nl 0 Nil ps) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (fe_ctx m mlo slo fp nl 0 Nil ps) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ixt_post rhs)
              (reduce rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim post_call_band
  (goal
    ((k Int)
     (m XModule)
     (mlo Int)
     (slo Int)
     (fp Int)
     (nl Int)
     (lc2 (List Int))
     (ps (List FPatch)))
    ((= (ixt_post (IqCall k) m mlo slo fp nl lc2 ps) True))
    (= (fe_inband (ihd lc2)) True))
  (chain
    (have hc (= (fe_ctx m mlo slo fp nl 0 Nil ps) True)
      (rewrite-with
        (lemma post_call_ctx)
        lr
        lhs
        ((inst k k) (inst lc2 lc2))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (unfold ixt_post rhs)
       (reduce rhs)
       (rewrite (premise hc) lr rhs true ())
       (reduce rhs))
      refl)))

