(claim fw_step_iter_fail
  (goal
    ((ce IExp)
     (b (List IpStmt))
     (ic (List XInstr))
     (ib (List XInstr))
     (cv Int)
     (out IpOut)
     (fam IFam)
     (is (List XInstr))
     (nl Int)
     (own Int)
     (fail_ix Int)
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (f Nat)
     (fs (List IpFn))
     (dmax Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixt_emit nl own fail_ix (IqWhile ce b)) (Some is))
     (= (ixf_exp nl 0 ce) (Some ic))
     (= (ixf_stmts nl own fail_ix b) (Some ib))
     (=
       (ipwhile
         (S f)
         fs
         mlo
         slo
         dmax
         dep
         ce
         b
         lc
         (fp_mem mem0 (fbelow slo psx)))
       (Some out))
     (= (iexp ce lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some cv))
     (= (int_eq cv 0) False)
     (= (le (+ (xil ic) 5) c) True)
     (=
       (xeval_seq
         (xt (- c 1) g)
         m
         ic
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (fe_out
         cv
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_seq
           (xt (- c 1) g)
           m
           ic
           (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
           (fp_mem mem0 psx))
         (fp_mem
           mem0
           (fp_app
             (fe_tr fp nl 0 ce lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
             psx))))
     (=
       (ipstmts f fs mlo slo dmax dep b lc (fp_mem mem0 (fbelow slo psx)))
       (Some (IpFailed fam)))
     (=
       (xeval_seq
         (xt (- (- (- c 1) (xil ic)) 3) g)
         m
         ib
         (MkRegs
           cv
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt (- c 1) g)
                 m
                 ic
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
           rbp
           rsi
           di
           r8
           r9
           (r10_of
