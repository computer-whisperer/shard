(claim fe_tr_locs
  (goal
    ((e IExp)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (mem Mem)
     (mlo Int)
     (msz Int)
     (psx (List FPatch)))
    ((= (fr_locs fp lc psx) True) (= (le (ilen lc) nl) True) (= (le 0 d) True))
    (= (fr_locs fp lc (fp_app (fe_tr fp nl d e lc mem mlo msz) psx)) True))
  (induct e
    ((case IConst
       (n)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps
           ((unfold fp_app lhs)
            (reduce lhs)
            (rewrite (premise 0) lr lhs true ()))
           refl)))
     (case ILoc
       (i)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps
           ((unfold fp_app lhs)
            (reduce lhs)
            (rewrite (premise 0) lr lhs true ()))
           refl)))
     (case IBin
       (k o a b)
       (case-on o IOp
         ((case IAdd
            (chain
              (have ho (= o IAdd)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
                 (unfold fe_tr lhs)
                 (reduce lhs)))
              (case-on (iexp a lc mem mlo msz) Option
                ((case None
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) None)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (steps
                       ((unfold fp_app lhs)
                        (reduce lhs)
                        (rewrite (premise 0) lr lhs true ()))
                       refl)))
                 (case Some
                   (va)
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) (Some va))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (chain
                       (have hla
                         (=
                           (fr_locs
                             fp
                             lc
                             (fp_app (fe_tr fp nl d a lc mem mlo msz) psx))
                           True)
                         (rewrite-with
                           (hyp ih)
                           lr
                           lhs
                           ()
                           ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                            (steps ((rewrite (premise 1) lr lhs true ())) refl)
                            (steps ((rewrite (premise 2) lr lhs true ())) refl))
                           refl))
                       (have hpast
                         (=
                           (le (+ fp (* 8 (ilen lc))) (+ fp (* 8 (+ nl d))))
                           True)
                         (by arith (list 1 0 8 8 0 0 0)))
                       (have hlc
                         (=
                           (fr_locs
                             fp
                             lc
                             (Cons
                               (FWord (+ fp (* 8 (+ nl d))) va)
                               (fp_app (fe_tr fp nl d a lc mem mlo msz) psx)))
                           True)
                         (rewrite-with
                           (lemma fr_locs_skip)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hla) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hpast) lr lhs true ()))
                              refl))
                           refl))
                       (have hnd (= (le 0 (+ d 1)) True)
                         (by arith (list 1 0 0 1 0 0 0 0 0)))
                       (have hc
                         (=
                           (fp_app
                             (Cons
                               (FWord (+ fp (* 8 (+ nl d))) va)
                               (fe_tr fp nl d a lc mem mlo msz))
                             psx)
                           (Cons
                             (FWord (+ fp (* 8 (+ nl d))) va)
                             (fp_app (fe_tr fp nl d a lc mem mlo msz) psx)))
                         (steps ((unfold fp_app lhs) (reduce lhs)) refl))
                       (steps
                         ((rewrite (lemma fp_app_assoc) lr lhs true ())
                          (rewrite (premise hc) lr lhs true ())))
                       (rewrite-with
                         (hyp ih1)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hlc) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hnd) lr lhs true ())) refl)))
                       refl)))))))
          (case ISub
            (chain
              (have ho (= o ISub)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
                 (unfold fe_tr lhs)
                 (reduce lhs)))
              (case-on (iexp a lc mem mlo msz) Option
                ((case None
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) None)
