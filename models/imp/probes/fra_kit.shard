(claim fs_step_loadw
  (goal
    ((i Int)
     (ae IExp)
     (ie (List XInstr))
     (ad Int)
     (nl Int)
     (own Int)
     (fail_ix Int)
     (is (List XInstr))
     (lc (List Int))
     (lc2 (List Int))
     (mem2 Mem)
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (f Nat)
     (fs (List IpFn))
     (dmax Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_stmt nl own fail_ix (IpLoadW i ae)) (Some is))
     (=
       (ipstmt
         (S f)
         fs
         mlo
         slo
         dmax
         dep
         (IpLoadW i ae)
         lc
         (fp_mem mem0 (fbelow slo psx)))
       (Some (IpNorm lc2 mem2)))
     (= (fe_ctx m mlo slo fp nl 0 lc psx) True)
     (= (ixf_cb ae) True)
     (= (le (+ fp (* 8 (+ nl (ixf_dep ae)))) (xmemhi_of m)) True)
     (= (le (+ (ixf_ecost ae) 4) c) True)
     (= (ixf_exp nl 0 ae) (Some ie))
     (= (iexp ae lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some ad)))
    (=
      (xeval_seq
        (xt c g)
        m
        is
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (fs_out
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          is
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (ips_tr
              fp
              nl
              (IpLoadW i ae)
              lc
              (fp_mem mem0 (fbelow slo psx))
              mlo
              slo)
            psx)))))
  (chain
    (have hie (= (ixf_exp nl 0 ae) (Some ie))
      (steps ((rewrite (premise 6) lr lhs true ())) refl))
    (have hcons
      (=
        (ix_app (list (XMem (XMLoad64 RAX (AReg RAX)))) (ixf_st i))
        (Cons (XMem (XMLoad64 RAX (AReg RAX))) (ixf_st i)))
      (steps
        ((unfold ix_app lhs) (reduce lhs) (unfold ix_app lhs) (reduce lhs))
        refl))
    (have hsome
      (=
        (Some
          (ix_app
            ie
            (ix_app (list (XMem (XMLoad64 RAX (AReg RAX)))) (ixf_st i))))
        (Some is))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_stmt rhs)
         (reduce rhs)
         (rewrite (premise hie) lr rhs true ())
         (reduce rhs)
         (rewrite (premise hcons) lr lhs true ()))
        refl))
    (inject (premise hsome) (his))
    (have hv (= (iexp ae lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some ad))
      (steps ((rewrite (premise 7) lr lhs true ())) refl))
    (case-on (le mlo ad) Bool
      ((case False
         (chain
           (have hg0 (= (le mlo ad) False)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (chain
             (have hn (= (Some IpTrap) (Some (IpNorm lc2 mem2)))
               (steps
                 ((rewrite (premise 1) rl rhs true ())
                  (unfold ipstmt rhs)
                  (reduce rhs)
                  (rewrite (premise hv) lr rhs true ())
                  (reduce rhs)
                  (rewrite (premise hg0) lr rhs true ())
                  (reduce rhs))
                 refl))
             (inject (premise hn) (hx))
             (absurd (premise hx)))))
       (case True
         (chain
           (have hg0 (= (le mlo ad) True)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (case-on (le (+ ad 8) slo) Bool
             ((case False
                (chain
                  (have hg1 (= (le (+ ad 8) slo) False)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                  (chain
                    (have hn (= (Some IpTrap) (Some (IpNorm lc2 mem2)))
                      (steps
                        ((rewrite (premise 1) rl rhs true ())
                         (unfold ipstmt rhs)
                         (reduce rhs)
                         (rewrite (premise hv) lr rhs true ())
                         (reduce rhs)
                         (rewrite (premise hg0) lr rhs true ())
                         (reduce rhs)
                         (rewrite (premise hg1) lr rhs true ())
                         (reduce rhs))
                        refl))
                    (inject (premise hn) (hx))
                    (absurd (premise hx)))))
              (case True
                (chain
                  (have hg1 (= (le (+ ad 8) slo) True)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                  (case-on
                    (ilset
                      lc
                      i
                      (load_le (iw8) (fp_mem mem0 (fbelow slo psx)) ad))
                    Option
                    ((case None
                       (chain
                         (have hset
                           (=
                             (ilset
