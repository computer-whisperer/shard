               ()
               ((steps ((rewrite (premise hlo8) lr lhs true ())) refl)
                (steps ((rewrite (premise hsa) lr lhs true ())) refl)
                (steps ((rewrite (premise hali) lr lhs true ())) refl)
                (steps ((rewrite (premise 0) lr lhs true ())) refl))
