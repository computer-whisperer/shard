      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (int_eq (xmemlo_of m) mlo)))
        ((steps ((rewrite (premise h2) lr lhs true ())) refl))
        refl))
    (have h4
      (=
        (andb
          (le slo fp)
          (andb
            (int_eq (mod (- fp slo) 8) 0)
            (andb
              (le (ilen lc) nl)
              (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296))))))
        True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (le mlo slo)))
        ((steps ((rewrite (premise h3) lr lhs true ())) refl))
        refl))
    (have h5
      (=
        (andb
          (int_eq (mod (- fp slo) 8) 0)
          (andb
            (le (ilen lc) nl)
            (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296)))))
        True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (le slo fp)))
        ((steps ((rewrite (premise h4) lr lhs true ())) refl))
        refl))
    (have h6
      (=
        (andb
          (le (ilen lc) nl)
          (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296))))
        True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (int_eq (mod (- fp slo) 8) 0)))
        ((steps ((rewrite (premise h5) lr lhs true ())) refl))
        refl))
    (have h7
      (= (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296))) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (le (ilen lc) nl)))
        ((steps ((rewrite (premise h6) lr lhs true ())) refl))
        refl))
    (have h8 (= (andb (le 0 slo) (le (xmemhi_of m) 4294967296)) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (le 0 d)))
        ((steps ((rewrite (premise h7) lr lhs true ())) refl))
        refl))
    (have h9 (= (le (xmemhi_of m) 4294967296) True)
      (rewrite-with
        (lemma andb_r)
        lr
        lhs
        ((inst a (le 0 slo)))
        ((steps ((rewrite (premise h8) lr lhs true ())) refl))
        refl))
    (steps ((rewrite (premise h9) lr lhs true ())) refl)))


