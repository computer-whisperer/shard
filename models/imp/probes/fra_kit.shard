     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d (IBin U64 IAnd a b)) (Some ie))
     (=
       (iexp (IBin U64 IAnd a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
