           (have hrun
             (=
               (xeval_seq
                 (xt c g)
                 m
                 is
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))
               (Some XTrap))
             (chain
               (steps ((rewrite (premise hpre) lr lhs true ())))
               (rewrite-with
                 (lemma fs_if_then_trap)
                 lr
                 lhs
                 ((inst
                    rs2
