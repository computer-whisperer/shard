(claim fe_step_lt
  (goal
    ((k IKind)
     (a IExp)
     (b IExp)
     (ia (List XInstr))
     (va Int)
     (ib (List XInstr))
     (vb Int)
     (nl Int)
     (d Int)
     (ie (List XInstr))
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (v Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d (IBin k ILt a b)) (Some ie))
     (=
       (iexp (IBin k ILt a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb (IBin k ILt a b)) True)
     (=
       (le (+ fp (* 8 (+ nl (+ d (ixf_dep (IBin k ILt a b)))))) (xmemhi_of m))
       True)
     (= (le (ixf_ecost (IBin k ILt a b)) c) True)
     (= (ixf_exp nl d a) (Some ia))
     (= (iexp a lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some va))
     (=
       (xeval_seq
         (xt c g)
         m
         ia
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (fe_out
         va
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_seq
           (xt c g)
           m
           ia
           (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
           (fp_mem mem0 psx))
         (fp_mem
           mem0
           (fp_app
             (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
             psx))))
     (= (ixf_exp nl (+ d 1) b) (Some ib))
     (= (iexp b lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some vb))
     (=
       (xeval_seq
         (xt (- (- c (xil ia)) 3) g)
         m
         ib
         (MkRegs
           va
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
           rbp
           rsi
           di
           r8
           r9
           (+ fp (* 8 (+ nl d)))
           (r11_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           r12
           r13
           dep
           fp)
         (fp_mem
           mem0
           (Cons
             (FWord (+ fp (* 8 (+ nl d))) va)
             (fp_app
               (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
               psx))))
       (fe_out
         vb
         (MkRegs
           va
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
           rbp
           rsi
           di
           r8
           r9
           (+ fp (* 8 (+ nl d)))
           (r11_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           r12
           r13
           dep
           fp)
         (xeval_seq
           (xt (- (- c (xil ia)) 3) g)
           m
           ib
           (MkRegs
             va
             rcx
             (rdx_of
               (xo_regs
                 (xeval_seq
                   (xt c g)
                   m
                   ia
                   (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                   (fp_mem mem0 psx))))
             rbx
             rbp
             rsi
             di
             r8
             r9
             (+ fp (* 8 (+ nl d)))
             (r11_of
               (xo_regs
                 (xeval_seq
                   (xt c g)
                   m
                   ia
                   (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                   (fp_mem mem0 psx))))
             r12
             r13
             dep
             fp)
           (fp_mem
             mem0
             (Cons
               (FWord (+ fp (* 8 (+ nl d))) va)
               (fp_app
                 (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                 psx))))
         (fp_mem
           mem0
           (fp_app
             (fe_tr
               fp
               nl
               (+ d 1)
               b
               lc
               (fp_mem
                 mem0
                 (fbelow
                   slo
                   (Cons
                     (FWord (+ fp (* 8 (+ nl d))) va)
                     (fp_app
                       (fe_tr
                         fp
                         nl
                         d
                         a
                         lc
                         (fp_mem mem0 (fbelow slo psx))
                         mlo
                         slo)
                       psx))))
               mlo
               slo)
             (Cons
               (FWord (+ fp (* 8 (+ nl d))) va)
               (fp_app
                 (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                 psx)))))))
    (=
      (xeval_seq
        (xt c g)
        m
        ie
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (fe_out
        v
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          ie
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (fe_tr
              fp
              nl
              d
              (IBin k ILt a b)
              lc
              (fp_mem mem0 (fbelow slo psx))
              mlo
              slo)
            psx)))))
  (chain
    (have hsome
      (=
        (Some
          (ix_app
            ia
            (ix_app
              (ixf_spill nl d)
              (ix_app
                ib
                (ix_app (ixf_reload10 nl d) (ixf_cmp (CLtU R10 (SReg RAX))))))))
        (Some ie))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_exp rhs)
         (reduce rhs)
         (rewrite (premise 6) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 9) lr rhs true ())
         (reduce rhs))
        refl))
    (inject (premise hsome) (hie))
    (have hop (= (iop_val k ILt va vb) (Some v))
      (steps
        ((rewrite (premise 1) rl rhs true ())
         (unfold iexp rhs)
         (reduce rhs)
         (rewrite (premise 7) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 10) lr rhs true ())
         (reduce rhs))
        refl))
    (have hv (= (Some (ib2i (lt va vb))) (Some v))
      (steps
        ((rewrite (premise hop) rl rhs true ())
         (unfold iop_val rhs)
         (reduce rhs))
        refl))
    (inject (premise hv) (hvv))
    (have hdisc (= (fp_disc slo psx) True)
      (rewrite-with
        (lemma ctx_disc)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hlocs (= (fr_locs fp lc psx) True)
      (rewrite-with
        (lemma ctx_locs)
        lr
        lhs
        ((inst m m) (inst mlo mlo) (inst slo slo) (inst nl nl) (inst d d))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hxlo (= (int_eq (xmemlo_of m) mlo) True)
      (rewrite-with
        (lemma ctx_lo)
        lr
        lhs
        ((inst slo slo)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hmlo (= (le mlo slo) True)
      (rewrite-with
        (lemma ctx_mlo)
        lr
        lhs
        ((inst m m)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hslo (= (le slo fp) True)
      (rewrite-with
        (lemma ctx_slo)
        lr
        lhs
