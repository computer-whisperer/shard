(claim cb_load
  (goal ((a IExp)) ((= (ixf_cb (ILoad a)) True)) (= (ixf_cb a) True))
  (steps
    ((rewrite (premise 0) rl rhs true ()) (unfold ixf_cb rhs) (reduce rhs))
