                   (chain
                     (have hcc (= c (IExt k2 k3 a2))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hp2
                       (=
                         (ixf_exp nl d (IRotr U32 a (IExt k2 k3 a2)))
                         (Some ie))
                       (steps
                         ((rewrite (premise hcc) rl lhs true ())
                          (rewrite (premise hp) lr lhs true ()))
                         refl))
                     (chain
                       (have hn (= None (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs))
                           refl))
                       (absurd (premise hn)))))
                 (case ITrunc
                   (k2 k3 a2)
                   (chain
                     (have hcc (= c (ITrunc k2 k3 a2))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hp2
                       (=
                         (ixf_exp nl d (IRotr U32 a (ITrunc k2 k3 a2)))
                         (Some ie))
                       (steps
                         ((rewrite (premise hcc) rl lhs true ())
                          (rewrite (premise hp) lr lhs true ()))
                         refl))
                     (chain
                       (have hn (= None (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs))
                           refl))
                       (absurd (premise hn)))))
                 (case ILoad
                   (a2)
                   (chain
                     (have hcc (= c (ILoad a2))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hp2
                       (= (ixf_exp nl d (IRotr U32 a (ILoad a2))) (Some ie))
                       (steps
                         ((rewrite (premise hcc) rl lhs true ())
                          (rewrite (premise hp) lr lhs true ()))
                         refl))
                     (chain
                       (have hn (= None (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs))
                           refl))
                       (absurd (premise hn)))))))))
          (case U64
            (chain
              (have hk (= k U64)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hp (= (ixf_exp nl d (IRotr U64 a c)) (Some ie))
                (steps
                  ((rewrite (premise hk) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (chain
                (have hn (= None (Some ie))
                  (steps
                    ((rewrite (premise hp) rl rhs true ())
                     (unfold ixf_exp rhs)
                     (reduce rhs))
                    refl))
                (absurd (premise hn))))))))
     (case IExt
       (k1 k2 a)
       (chain
         (have hp (= (ixf_exp nl d a) (Some ie))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ixf_exp rhs)
              (reduce rhs))
             refl))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ((inst nl nl) (inst d d))
           ((steps ((rewrite (premise hp) lr lhs true ())) refl)))
         (steps ((unfold ixf_elen rhs) (reduce rhs)) refl)))
     (case ITrunc
       (k1 kt a)
       (case-on (ixf_exp nl d a) Option
         ((case None
            (chain
              (have ha (= (ixf_exp nl d a) None)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (chain
                (have hn (= None (Some ie))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (unfold ixf_exp rhs)
                     (reduce rhs)
                     (rewrite (premise ha) lr rhs true ())
                     (reduce rhs))
                    refl))
                (absurd (premise hn)))))
          (case Some
            (ia)
            (chain
              (have ha (= (ixf_exp nl d a) (Some ia))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (case-on kt IKind
                ((case U8
                   (chain
                     (have hk (= kt U8)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps ((rewrite (premise hk) lr both true ())))
                     (have hp2 (= (ixf_exp nl d (ITrunc k1 U8 a)) (Some ie))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (chain
                       (have hsome
                         (=
                           (Some (ix_app ia (list (XBin XAnd RAX (SImm 255)))))
                           (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs)
                            (rewrite (premise ha) lr rhs true ())
                            (reduce rhs))
                           refl))
                       (inject (premise hsome) (hie))
                       (steps
                         ((rewrite (premise hie) rl lhs true ())
                          (rewrite (lemma xil_app) lr lhs true ())))
                       (rewrite-with
                         (hyp ih)
                         lr
                         lhs
                         ((inst nl nl) (inst d d))
                         ((steps ((rewrite (premise ha) lr lhs true ())) refl)))
                       (steps
                         ((compute lhs (stop ixf_elen))
                          (unfold ixf_elen rhs)
                          (reduce rhs)
                          (compute rhs (stop ixf_elen)))
                         refl))))
                 (case U32
                   (chain
                     (have hk (= kt U32)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps ((rewrite (premise hk) lr both true ())))
                     (have hp2 (= (ixf_exp nl d (ITrunc k1 U32 a)) (Some ie))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (chain
                       (have hsome
                         (=
                           (Some (ix_app ia (list (XMovRR32 RAX RAX))))
                           (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs)
                            (rewrite (premise ha) lr rhs true ())
                            (reduce rhs))
                           refl))
                       (inject (premise hsome) (hie))
                       (steps
                         ((rewrite (premise hie) rl lhs true ())
                          (rewrite (lemma xil_app) lr lhs true ())))
                       (rewrite-with
                         (hyp ih)
                         lr
                         lhs
                         ((inst nl nl) (inst d d))
                         ((steps ((rewrite (premise ha) lr lhs true ())) refl)))
                       (steps
                         ((compute lhs (stop ixf_elen))
                          (unfold ixf_elen rhs)
                          (reduce rhs)
                          (compute rhs (stop ixf_elen)))
                         refl))))
                 (case U64
                   (chain
                     (have hk (= kt U64)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps ((rewrite (premise hk) lr both true ())))
                     (have hp2 (= (ixf_exp nl d (ITrunc k1 U64 a)) (Some ie))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (chain
                       (have hsome (= (Some (ix_app ia Nil)) (Some ie))
                         (steps
                           ((rewrite (premise hp2) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs)
                            (rewrite (premise ha) lr rhs true ())
                            (reduce rhs))
                           refl))
                       (inject (premise hsome) (hie))
                       (steps
                         ((rewrite (premise hie) rl lhs true ())
                          (rewrite (lemma xil_app) lr lhs true ())))
                       (rewrite-with
                         (hyp ih)
                         lr
                         lhs
                         ((inst nl nl) (inst d d))
                         ((steps ((rewrite (premise ha) lr lhs true ())) refl)))
                       (steps
                         ((compute lhs (stop ixf_elen))
                          (rewrite (lemma add0) lr lhs true ())
                          (unfold ixf_elen rhs)
                          (reduce rhs)
                          (compute rhs (stop ixf_elen)))
                         refl)))))))))))
     (case ILoad
       (a)
       (case-on (ixf_exp nl d a) Option
         ((case None
            (chain
              (have ha (= (ixf_exp nl d a) None)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (chain
                (have hn (= None (Some ie))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (unfold ixf_exp rhs)
                     (reduce rhs)
                     (rewrite (premise ha) lr rhs true ())
                     (reduce rhs))
                    refl))
                (absurd (premise hn)))))
          (case Some
            (ia)
            (chain
              (have ha (= (ixf_exp nl d a) (Some ia))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (chain
                (have hsome
                  (=
                    (Some (ix_app ia (list (XLoad8 RAX (AReg RAX)))))
                    (Some ie))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (unfold ixf_exp rhs)
                     (reduce rhs)
                     (rewrite (premise ha) lr rhs true ())
                     (reduce rhs))
                    refl))
                (inject (premise hsome) (hie))
                (steps
                  ((rewrite (premise hie) rl lhs true ())
                   (rewrite (lemma xil_app) lr lhs true ())))
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst nl nl) (inst d d))
                  ((steps ((rewrite (premise ha) lr lhs true ())) refl)))
                (steps
                  ((compute lhs (stop ixf_elen))
                   (unfold ixf_elen rhs)
                   (reduce rhs)
                   (compute rhs (stop ixf_elen)))
                  refl))))))))))

;; --- the twin's laws ------------------------------------------------------------------

;; a machine store IS one patch prepended (the structural identity every
;; statement of the simulation rides)
(claim fp_mem_cons_w
  (goal ((m Mem) (ps (List FPatch)) (a Int) (v Int)) ()
    (= (store_le (xw8) (fp_mem m ps) a v) (fp_mem m (Cons (FWord a v) ps))))
  (steps ((unfold fp_mem rhs) (reduce rhs)) refl))

(claim fp_mem_cons_b
  (goal ((m Mem) (ps (List FPatch)) (a Int) (v Int)) ()
    (= (mem_set (fp_mem m ps) a v) (fp_mem m (Cons (FByte a v) ps))))
  (steps ((unfold fp_mem rhs) (reduce rhs)) refl))

;; every patch is a word at or above lo
(fn fp_min ((ps (List FPatch)) (lo Int)) Bool
  (measure (struct ps))
  (match ps
    (Nil True)
    ((Cons p rest)
     (match p
       ((FWord a _) (if (le lo a) (fp_min rest lo) False))
       ((FByte _ _) False)))))

(claim fp_min_unf_w
  (goal ((a Int) (v Int) (rest (List FPatch)) (lo Int)) ()
    (=
      (fp_min (Cons (FWord a v) rest) lo)
      (if (le lo a) (fp_min rest lo) False)))
  (steps ((unfold fp_min lhs) (reduce lhs)) refl))

(claim fp_min_head
  (goal ((a Int) (v Int) (rest (List FPatch)) (lo Int))
    ((= (fp_min (Cons (FWord a v) rest) lo) True))
    (= (le lo a) True))
  (case-on (le lo a) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (le lo a) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (lemma fp_min_unf_w) lr rhs true ())
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim fp_min_tail
  (goal ((a Int) (v Int) (rest (List FPatch)) (lo Int))
    ((= (fp_min (Cons (FWord a v) rest) lo) True))
    (= (fp_min rest lo) True))
  (chain
    (have hh (= (le lo a) True)
      (rewrite-with
        (lemma fp_min_head)
        lr
        lhs
        ((inst v v) (inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (rewrite (lemma fp_min_unf_w) lr rhs true ())
       (rewrite (premise hh) lr rhs true ())
       (reduce rhs))
      refl)))

(claim fp_min_app
  (goal ((a (List FPatch)) (b (List FPatch)) (lo Int))
    ((= (fp_min a lo) True) (= (fp_min b lo) True))
    (= (fp_min (fp_app a b) lo) True))
  (induct a
    ((case Nil
       (steps
         ((unfold fp_app lhs) (reduce lhs) (rewrite (premise 1) lr lhs true ()))
         refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_min (Cons (FWord x w) rest) lo) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le lo x) True)
                (rewrite-with
                  (lemma fp_min_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_min rest lo) True)
                (rewrite-with
                  (lemma fp_min_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (rewrite (lemma fp_min_unf_w) lr lhs true ())
                 (rewrite (premise hh) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst lo lo))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hff (= False True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (unfold fp_min rhs)
                   (reduce rhs))
                  refl))
              (absurd (premise hff))))))))))

(claim fp_min_weaken
  (goal ((ps (List FPatch)) (lo Int) (lo2 Int))
    ((= (fp_min ps lo) True) (= (le lo2 lo) True))
    (= (fp_min ps lo2) True))
  (induct ps
    ((case Nil (steps ((unfold fp_min lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_min (Cons (FWord x w) rest) lo) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le lo x) True)
                (rewrite-with
                  (lemma fp_min_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_min rest lo) True)
                (rewrite-with
                  (lemma fp_min_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hh2 (= (le lo2 x) True) (by arith (list 1 0 1 0 0 1 0)))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_min_unf_w) lr lhs true ())
                 (rewrite (premise hh2) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst lo lo))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hff (= False True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (unfold fp_min rhs)
                   (reduce rhs))
                  refl))
              (absurd (premise hff))))))))))

;; patches at or above lo are invisible to a word read below lo
(claim fp_wordv_app_min
  (goal ((ps (List FPatch)) (rest (List FPatch)) (lo Int) (a Int))
    ((= (fp_min ps lo) True) (= (lt a lo) True))
    (= (fp_wordv (fp_app ps rest) a) (fp_wordv rest a)))
  (induct ps
    ((case Nil (steps ((unfold fp_app lhs) (reduce lhs)) refl))
     (case Cons
       (p t)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_min (Cons (FWord x w) t) lo) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le lo x) True)
                (rewrite-with
                  (lemma fp_min_head)
                  lr
                  lhs
                  ((inst v w) (inst rest t))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_min t lo) True)
                (rewrite-with
                  (lemma fp_min_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hne (= (int_eq x a) False) (by arith (list -1 0 1 0 0 1 0)))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (unfold fp_wordv lhs)
                 (reduce lhs)
                 (rewrite (premise hne) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst lo lo))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hff (= False True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (unfold fp_min rhs)
                   (reduce rhs))
                  refl))
              (absurd (premise hff))))))))))

;; in-range mod at the shift widths (wrap64_id's ladder at 64 and 32)
(claim mod64_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 64) True)) (= (mod x 64) x))
  (div-facts
    x
    64
    q
    (have qlo (= (le -1 q) True)
      (by arith (list 64 1 0 -1 0 1 0))
      (have qhi (= (le q 1) True)
        (by arith (list 64 0 1 1 1 0 0))
        (fin-split
          q
          (premise qlo)
          (premise qhi)
          ((case -1
             (by
               arith
               (list (list 0 1 0 -1 0 1 0 0 0) (list 0 1 0 -1 0 1 0 0 0))))
           (case 0
             (by
               arith
               (list (list 1 0 0 1 0 0 0 0 0) (list 1 0 0 -1 0 0 0 0 0))))
           (case 1
             (by arith (list (list 0 0 1 1 1 0 0 0 0) (list 0 0 1 1 1 0 0 0 0))))))))))

(claim mod32_id
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 32) True)) (= (mod x 32) x))
  (div-facts
    x
    32
    q
    (have qlo (= (le -1 q) True)
      (by arith (list 32 1 0 -1 0 1 0))
      (have qhi (= (le q 1) True)
        (by arith (list 32 0 1 1 1 0 0))
        (fin-split
          q
          (premise qlo)
          (premise qhi)
          ((case -1
             (by
               arith
               (list (list 0 1 0 -1 0 1 0 0 0) (list 0 1 0 -1 0 1 0 0 0))))
           (case 0
             (by
               arith
               (list (list 1 0 0 1 0 0 0 0 0) (list 1 0 0 -1 0 0 0 0 0))))
           (case 1
             (by arith (list (list 0 0 1 1 1 0 0 0 0) (list 0 0 1 1 1 0 0 0 0))))))))))

;; an in-range local index
(claim ilget_lo
  (goal ((lc (List Int)) (i Int) (v Int)) ((= (ilget lc i) (Some v)))
    (= (le 0 i) True))
  (induct lc
    ((case Nil
       (chain
         (have hn (= None (Some v))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ilget rhs)
              (reduce rhs))
             refl))
         (absurd (premise hn))))
     (case Cons
       (h t)
       (case-on (int_eq i 0) Bool
         ((case True
            (chain
              (have hi (= (int_eq i 0) True)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (by arith (list 1 0 1))))
          (case False
            (chain
              (have hi (= (int_eq i 0) False)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hgt (= (ilget t (- i 1)) (Some v))
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold ilget rhs)
                   (reduce rhs)
                   (rewrite (premise hi) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hrec (= (le 0 (- i 1)) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst v v))
                  ((steps ((rewrite (premise hgt) lr lhs true ())) refl))
                  refl))
              (by arith (list 1 0 0 0 1))))))))))

(claim ilget_hi
  (goal ((lc (List Int)) (i Int) (v Int)) ((= (ilget lc i) (Some v)))
    (= (lt i (ilen lc)) True))
  (induct lc
    ((case Nil
       (chain
         (have hn (= None (Some v))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ilget rhs)
              (reduce rhs))
             refl))
         (absurd (premise hn))))
     (case Cons
       (h t)
       (chain
         (have hlen (= (ilen (Cons h t)) (+ 1 (ilen t)))
           (steps ((unfold ilen lhs) (reduce lhs)) refl))
         (have hnn (= (le 0 (ilen t)) True)
           (rewrite-with (lemma ilen_nonneg) lr lhs () () refl))
         (case-on (int_eq i 0) Bool
           ((case True
              (chain
                (have hi (= (int_eq i 0) True)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (by arith (list 1 0 1 1 -1))))
            (case False
              (chain
                (have hi (= (int_eq i 0) False)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (have hgt (= (ilget t (- i 1)) (Some v))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (unfold ilget rhs)
                     (reduce rhs)
                     (rewrite (premise hi) lr rhs true ())
                     (reduce rhs))
                    refl))
                (have hrec (= (lt (- i 1) (ilen t)) True)
                  (rewrite-with
                    (hyp ih)
                    lr
                    lhs
                    ((inst v v))
                    ((steps ((rewrite (premise hgt) lr lhs true ())) refl))
                    refl))
                (by arith (list 1 0 1 0 0 0 1)))))))))))

