                            (case-on k IKind
                              ((case U8
                                 (chain
                                   (have hk (= k U8)
                                     (steps
                                       ((rewrite (hyp 0) lr lhs true ()))
                                       refl))
                                   (chain
                                     (have hn (= None (Some ie))
                                       (steps
                                         ((rewrite (premise hp) rl rhs true ())
