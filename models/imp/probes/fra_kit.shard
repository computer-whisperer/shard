              (rewrite (lemma r12_of_mk) lr both true ())
              (rewrite (lemma r13_of_mk) lr both true ())
              (rewrite (lemma r14_of_mk) lr both true ())
              (rewrite (lemma r15_of_mk) lr both true ()))
