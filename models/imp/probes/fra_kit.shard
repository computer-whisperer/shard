     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int))
    ((= (le 2 c) True)
     (= (le (xmemlo_of m) s10) True)
     (= (le (+ s10 1) (xmemhi_of m)) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (list (XStore8 (AReg R10) (SReg RAX)))
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        xm)
      (Some
        (XNorm
