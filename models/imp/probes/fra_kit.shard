;; the spill slot is spelled (+ nl 0) by the translator (ixf_spill nl 0) and nl by
;; the twin: one Int fact reconciles them
(claim add0
  (goal ((x Int)) () (= (+ x 0) x))
  (by arith (list (list 1) (list 1))))

;; --- THE WORD-MEMORY BLOCKS (A-3 part 3): one instruction from a literal file ------------

;; RAX := [RAX] (the 8-byte LE word), everything else carried; the span
;; [RAX, RAX+8) lies in the window
(claim fe_ldw_run
  (goal
    ((c Int)
     (g Nat)
     (m XModule)
     (xm Mem)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int))
    ((= (le 2 c) True)
     (= (le (xmemlo_of m) a0) True)
     (= (le (+ a0 8) (xmemhi_of m)) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (list (XMem (XMLoad64 RAX (AReg RAX))))
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        xm)
      (Some
        (XNorm
          (MkRegs
            (load_le (xw8) xm a0)
            rcx
            dx
            rbx
            rbp
            rsi
            di
            r8
            r9
            s10
            s11
            r12
            r13
            dep
            fp)
          xm))))
  (chain
    (rewrite-with
      (lemma xt_peel2)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop xt xw8 load_le xmemlo_of xmemhi_of))
       (rewrite (premise 1) lr lhs true ())
       (rewrite (premise 2) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop xt xw8 load_le xmemlo_of xmemhi_of)))
      refl)))

