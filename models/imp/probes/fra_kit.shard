    (have hrun
      (=
        (xeval_seq
          (xt c g)
          m
          ie
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (Some
          (XNorm
            (MkRegs
              (band
                (bor
                  (bshr (band va 4294967295) (mod cc 32))
                  (bshl (band va 4294967295) (mod (- 32 (mod cc 32)) 32)))
                4294967295)
              rcx
              (rdx_of
                (xo_regs
                  (xeval_seq
                    (xt c g)
                    m
                    ia
                    (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep
                      fp)
                    (fp_mem mem0 psx))))
              rbx
              rbp
              rsi
              di
              r8
              r9
