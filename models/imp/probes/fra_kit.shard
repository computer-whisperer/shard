                    (xt c g)
                    m
                    ia
                    (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep
                      fp)
                    (fp_mem mem0 psx))))
              r12
              r13
              dep
              fp)
            (fp_mem
              mem0
              (fp_app
                (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                psx)))))
      (chain
        (steps ((rewrite (premise hie) rl lhs true ())))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hle) lr lhs true ())) refl)))
        (steps
          ((rewrite (premise 8) lr lhs true ())
           (unfold fe_out lhs)
           (reduce lhs)
