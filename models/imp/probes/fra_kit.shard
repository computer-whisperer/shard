    (steps
      ((compute lhs (stop xt xw8 store_le xmemlo_of xmemhi_of))
       (rewrite (premise 1) lr lhs true ())
       (rewrite (premise 2) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop xt xw8 store_le xmemlo_of xmemhi_of)))
      refl)))

;; [R10] := RAX (one byte: mem_set stores the register's value, mem_get
;; reads it mod 256 — the simulation stores imp's byte value, in band)
(claim fe_stb_run
  (goal
    ((c Int)
     (g Nat)
     (m XModule)
     (xm Mem)
     (a0 Int)
     (rcx Int)
     (dx Int)
