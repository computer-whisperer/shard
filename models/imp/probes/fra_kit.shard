;; --- A-5: THE CALL KIT (hand), part 7: the arms' side laws (the room algebra, the arity, the table lookup) ---
(claim room_fits
  (goal ((fp Int) (own Int) (dep Int) (dmax Int) (mo Int) (hi Int))
    ((= (le (+ (+ fp own) (* (- (+ dmax 1) dep) mo)) hi) True)
     (= (le dep dmax) True)
     (= (le 0 mo) True))
    (= (le (+ fp own) hi) True))
  (chain
    (have hd (= (le 0 (- (+ dmax 1) dep)) True) (by arith (list 1 0 1 0)))
    (have hp (= (le 0 (* (- (+ dmax 1) dep) mo)) True)
      (rewrite-with
        (lemma mul_nonneg)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hd) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (by arith (list 1 1 0 0 0 1))))

(claim room_split
  (goal ((dep Int) (dmax Int) (mo Int)) ()
    (= (* (- (+ dmax 1) dep) mo) (+ mo (* (- (+ dmax 1) (+ dep 1)) mo))))
  (chain
    (have hs (= (- (+ dmax 1) dep) (+ 1 (- (+ dmax 1) (+ dep 1))))
      (by arith (list (list 1) (list 1))))
    (steps
      ((rewrite (premise hs) lr lhs true ())
       (rewrite (lemma mul_comm) lr lhs true ())
       (rewrite (lemma mul_dist) lr lhs true ())
       (rewrite (lemma mul_comm) lr rhs true ()))
      (by arith (list (list 1 0) (list 1 0))))))

(claim room_next
  (goal ((fp Int) (own Int) (dep Int) (dmax Int) (mo Int) (hi Int))
    ((= (le (+ (+ fp own) (* (- (+ dmax 1) dep) mo)) hi) True)
     (= (le dep dmax) True)
     (= (le 0 mo) True))
    (= (le (+ (+ fp own) mo) hi) True))
  (chain
    (have hd (= (le 0 (- (+ dmax 1) (+ dep 1))) True) (by arith (list 1 0 1 0)))
    (have hp (= (le 0 (* (- (+ dmax 1) (+ dep 1)) mo)) True)
      (rewrite-with
        (lemma mul_nonneg)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hd) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hsp
      (= (* (- (+ dmax 1) dep) mo) (+ mo (* (- (+ dmax 1) (+ dep 1)) mo)))
      (rewrite-with (lemma room_split) lr lhs () () refl))
    (by arith (list 1 1 0 0 0 1 1))))

(claim room_step
  (goal ((fp Int) (own Int) (own2 Int) (dep Int) (dmax Int) (mo Int) (hi Int))
    ((= (le (+ (+ fp own) (* (- (+ dmax 1) dep) mo)) hi) True)
     (= (le own2 mo) True))
    (= (le (+ (+ (+ fp own) own2) (* (- (+ dmax 1) (+ dep 1)) mo)) hi) True))
  (chain
    (have hsp
      (= (* (- (+ dmax 1) dep) mo) (+ mo (* (- (+ dmax 1) (+ dep 1)) mo)))
      (rewrite-with (lemma room_split) lr lhs () () refl))
    (by arith (list 1 1 1 1))))

(claim ipexps_len
  (goal
    ((args (List IExp))
     (vs (List Int))
     (lc (List Int))
     (mem Mem)
     (mlo Int)
     (msz Int))
    ((= (ipexps args lc mem mlo msz) (Some vs)))
    (= (ilen vs) (ixf_nargs args)))
  (induct args
    ((case Nil
       (chain
         (have hs (= (Some Nil) (Some vs))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ipexps rhs)
              (reduce rhs))
             refl))
         (inject (premise hs) (hvs))
         (steps
           ((rewrite (premise hvs) rl lhs true ())
            (unfold ilen lhs)
            (reduce lhs)
            (unfold ixf_nargs rhs)
            (reduce rhs))
           refl)))
     (case Cons
       (a rest)
       (case-on (iexp a lc mem mlo msz) Option
         ((case None
            (chain
              (have hv (= (iexp a lc mem mlo msz) None)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hn (= None (Some vs))
                (steps
