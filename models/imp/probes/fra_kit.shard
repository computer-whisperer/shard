                  (list (XBin32 XSub R10 (SReg RAX)) (XMovRR RAX R10)))))))
        (Some ie))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_exp rhs)
         (reduce rhs)
         (rewrite (premise 6) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 9) lr rhs true ())
