                           dep fp)
                         (fp_mem mem0 psx))))
                   r12
                   r13
                   dep
                   fp)
                 (fp_mem
                   mem0
                   (fp_app
                     (fe_tr
                       fp
                       nl
                       0
                       ce
                       lc
                       (fp_mem mem0 (fbelow slo psx))
                       mlo
                       slo)
                     psx)))
               (Some XTrap))
