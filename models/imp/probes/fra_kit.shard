                      fp))
                  (inst mem2 mem0))
                 ((steps ((rewrite (premise hrax) lr lhs true ())) refl)
                  (steps ((rewrite (premise hb) lr lhs true ())) refl)))
               refl))
           (steps
             ((rewrite (premise hrun) lr both true ())
              (rewrite (premise ho) lr rhs true ())
              (unfold ixt_expect rhs)
              (reduce rhs))
             refl)))))))

