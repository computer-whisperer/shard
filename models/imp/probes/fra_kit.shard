(claim fr_locs_app_wmin
  (goal
    ((fp Int) (lc (List Int)) (q (List FPatch)) (ps (List FPatch)) (slo Int))
    ((= (fr_locs fp lc q) True)
     (= (fp_wmin slo (+ fp (* 8 (ilen lc))) ps) True)
     (= (le slo fp) True))
    (= (fr_locs fp lc (fp_app ps q)) True))
  (induct ps
    ((case Nil
       (steps
         ((unfold fp_app lhs) (reduce lhs) (rewrite (premise 0) lr lhs true ()))
         refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0
                (=
                  (fp_wmin slo (+ fp (* 8 (ilen lc))) (Cons (FWord x w) rest))
                  True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 1) lr lhs true ()))
                  refl))
              (have ht (= (fp_wmin slo (+ fp (* 8 (ilen lc))) rest) True)
                (rewrite-with
                  (lemma fp_wmin_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hih (= (fr_locs fp lc (fp_app rest q)) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)))
              (case-on (le (+ x 8) slo) Bool
                ((case True
                   (chain
                     (have hs (= (le (+ x 8) slo) True)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hxf (= (lt x fp) True)
                       (by arith (list 1 0 0 1 0 0 0 0 1)))
                     (rewrite-with
                       (lemma fr_locs_skip_lo)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hih) lr lhs true ())) refl)
                        (steps ((rewrite (premise hxf) lr lhs true ())) refl))
                       refl)))
                 (case False
                   (chain
                     (have hs (= (le (+ x 8) slo) False)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hh (= (le (+ fp (* 8 (ilen lc))) x) True)
                       (rewrite-with
                         (lemma fp_wmin_head_hi)
                         lr
                         lhs
                         ((inst v w) (inst slo slo) (inst rest rest))
                         ((steps ((rewrite (premise h0) lr lhs true ())) refl)
                          (steps ((rewrite (premise hs) lr lhs true ())) refl))
                         refl))
                     (rewrite-with
                       (lemma fr_locs_skip)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hih) lr lhs true ())) refl)
                        (steps ((rewrite (premise hh) lr lhs true ())) refl))
                       refl)))))))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_wmin slo (+ fp (* 8 (ilen lc))) rest) True)
                (steps
                  ((rewrite (premise 1) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_wmin_unf_b) lr rhs true ()))
                  refl))
              (have hih (= (fr_locs fp lc (fp_app rest q)) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)))
              (rewrite-with
                (lemma fr_locs_b)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hih) lr lhs true ())) refl))
                refl)))))))))

