                           (le
                             (+ fp (* 8 (+ nl d)))
                             (+ fp (* 8 (+ nl (+ d 1)))))
                           True)
                         (by arith (list 1 0)))
                       (have hmb2
                         (=
                           (fp_min
                             (fe_tr fp nl (+ d 1) b lc mem mlo msz)
                             (+ fp (* 8 (+ nl d))))
                           True)
                         (rewrite-with
                           (lemma fp_min_weaken)
                           lr
                           lhs
                           ((inst lo (+ fp (* 8 (+ nl (+ d 1))))))
                           ((steps
                              ((rewrite (premise hmb) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hle) lr lhs true ()))
                              refl))
                           refl))
                       (have hma
                         (=
                           (fp_min
                             (fe_tr fp nl d a lc mem mlo msz)
                             (+ fp (* 8 (+ nl d))))
                           True)
                         (rewrite-with (hyp ih) lr lhs () () refl))
                       (have hself
