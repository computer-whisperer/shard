          (mem_set xm s10 a0)))))
  (chain
    (rewrite-with
      (lemma xt_peel2)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop xt mem_set xmemlo_of xmemhi_of))
       (rewrite (premise 1) lr lhs true ())
       (rewrite (premise 2) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop xt mem_set xmemlo_of xmemhi_of)))
      refl)))

;; --- THE BINARY OP BLOCKS: RAX := R10 op RAX (R10 too) -------------------------------------

(claim fe_bop64_run
  (goal
    ((o XBop)
     (c Int)
     (g Nat)
     (m XModule)
     (xm Mem)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int))
    ((= (le 3 c) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (list (XBin o R10 (SReg RAX)) (XMovRR RAX R10))
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        xm)
      (Some
        (XNorm
          (MkRegs
            (xbop_val o s10 a0)
            rcx
            dx
            rbx
            rbp
            rsi
            di
            r8
            r9
            (xbop_val o s10 a0)
            s11
            r12
            r13
            dep
            fp)
          xm))))
  (chain
    (rewrite-with
      (lemma xt_peel3)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps ((compute lhs (stop xt xbop_val))) refl)))

(claim fe_bop32_run
  (goal
    ((o XBop)
     (c Int)
     (g Nat)
     (m XModule)
     (xm Mem)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int))
    ((= (le 3 c) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (list (XBin32 o R10 (SReg RAX)) (XMovRR RAX R10))
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        xm)
      (Some
        (XNorm
          (MkRegs
            (xbop32_val o s10 a0)
            rcx
            dx
            rbx
            rbp
            rsi
            di
            r8
            r9
            (xbop32_val o s10 a0)
            s11
            r12
            r13
            dep
            fp)
          xm))))
  (chain
    (rewrite-with
      (lemma xt_peel3)
