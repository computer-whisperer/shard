                                        (rewrite (lemma xil_app) lr lhs true ())
                                        (rewrite (lemma xil_app) lr lhs true ())
                                        (rewrite (lemma xil_app) lr lhs true ())
                                        (rewrite
                                          (lemma xil_spill)
                                          lr
                                          lhs
                                          true
                                          ())
                                        (rewrite
                                          (lemma xil_reload)
                                          lr
                                          lhs
                                          true
                                          ())))
                                     (rewrite-with
                                       (hyp ih)
                                       lr
                                       lhs
                                       ((inst nl nl) (inst d d))
                                       ((steps
                                          ((rewrite (premise ha) lr lhs true ()))
                                          refl)))
                                     (rewrite-with
                                       (hyp ih1)
                                       lr
                                       lhs
                                       ((inst nl nl) (inst d (+ d 1)))
                                       ((steps
                                          ((rewrite (premise hb) lr lhs true ()))
                                          refl)))
                                     (steps
                                       ((compute lhs (stop ixf_elen))
                                        (unfold ixf_elen rhs)
                                        (reduce rhs)
                                        (unfold ixf_oplen rhs)
                                        (reduce rhs)
                                        (compute rhs (stop ixf_elen)))
                                       refl))))))))))))))))
          (case ISub
            (chain
              (have ho (= o ISub)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hp (= (ixf_exp nl d (IBin k ISub a b)) (Some ie))
                (steps
                  ((rewrite (premise ho) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (steps ((rewrite (premise ho) lr both true ())))
              (case-on (ixf_exp nl d a) Option
                ((case None
                   (chain
                     (have ha (= (ixf_exp nl d a) None)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (chain
                       (have hn (= None (Some ie))
                         (steps
                           ((rewrite (premise hp) rl rhs true ())
                            (unfold ixf_exp rhs)
                            (reduce rhs)
                            (rewrite (premise ha) lr rhs true ())
                            (reduce rhs))
                           refl))
                       (absurd (premise hn)))))
                 (case Some
                   (ia)
                   (chain
                     (have ha (= (ixf_exp nl d a) (Some ia))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (case-on (ixf_exp nl (+ d 1) b) Option
                       ((case None
                          (chain
                            (have hb (= (ixf_exp nl (+ d 1) b) None)
                              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            (chain
                              (have hn (= None (Some ie))
                                (steps
                                  ((rewrite (premise hp) rl rhs true ())
                                   (unfold ixf_exp rhs)
                                   (reduce rhs)
                                   (rewrite (premise ha) lr rhs true ())
                                   (reduce rhs)
                                   (rewrite (premise hb) lr rhs true ())
                                   (reduce rhs))
                                  refl))
                              (absurd (premise hn)))))
                        (case Some
                          (ib)
