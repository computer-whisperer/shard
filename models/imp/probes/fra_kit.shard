                         (reduce lhs)
                         (compute
                           lhs
                           (stop xt xo_regs xeval_seq fp_mem fbelow fe_tr fp_app
                             rdx_of r10_of r11_of xil xmemlo_of xmemhi_of))
                         (reduce lhs)
                         (unfold xeval_seq lhs)
                         (reduce lhs)
                         (compute
