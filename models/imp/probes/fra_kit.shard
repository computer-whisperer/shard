    ((= (ixf_exp nl d (IBin U32 ISub a b)) (Some ie))
     (=
       (iexp (IBin U32 ISub a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb (IBin U32 ISub a b)) True)
     (=
       (le
         (+ fp (* 8 (+ nl (+ d (ixf_dep (IBin U32 ISub a b))))))
         (xmemhi_of m))
       True)
     (= (le (ixf_ecost (IBin U32 ISub a b)) c) True)
     (= (ixf_exp nl d a) (Some ia))
     (= (iexp a lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some va))
     (=
       (xeval_seq
         (xt c g)
         m
         ia
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (fe_out
         va
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_seq
           (xt c g)
           m
           ia
           (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
           (fp_mem mem0 psx))
         (fp_mem
           mem0
           (fp_app
             (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
             psx))))
     (= (ixf_exp nl (+ d 1) b) (Some ib))
     (= (iexp b lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some vb))
