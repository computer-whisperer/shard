                            a
                            lc
                            (fp_mem mem0 (fbelow slo psx))
                            mlo
                            slo)
                          psx))))))
              rbx
              rbp
              rsi
              di
              r8
              r9
              (band va vb)
              (r11_of
                (xo_regs
                  (xeval_seq
                    (xt (- (- c (xil ia)) 3) g)
                    m
                    ib
                    (MkRegs
                      va
                      rcx
                      (rdx_of
                        (xo_regs
