                            nl
                            d
                            a
                            lc
                            (fp_mem mem0 (fbelow slo psx))
                            mlo
                            slo)
                          psx))))))
              r12
              r13
              dep
              fp)
            (fp_mem
              mem0
              (fp_app
                (fe_tr
                  fp
                  nl
                  (+ d 1)
                  b
                  lc
                  (fp_mem
                    mem0
                    (fbelow
                      slo
                      (Cons
                        (FWord (+ fp (* 8 (+ nl d))) va)
                        (fp_app
                          (fe_tr
                            fp
                            nl
                            d
                            a
                            lc
                            (fp_mem mem0 (fbelow slo psx))
                            mlo
                            slo)
                          psx))))
                  mlo
                  slo)
                (Cons
                  (FWord (+ fp (* 8 (+ nl d))) va)
                  (fp_app
                    (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                    psx)))))))
      (chain
        (steps ((rewrite (premise hie) rl lhs true ())))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hle1) lr lhs true ())) refl)))
        (steps
          ((rewrite (premise 8) lr lhs true ())
