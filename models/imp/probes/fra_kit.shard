                                     (steps
                                       ((rewrite (hyp 0) lr lhs true ()))
                                       refl))
                                   (steps
                                     ((rewrite (premise hk) lr both true ())))
                                   (chain
                                     (have hsome
                                       (=
                                         (Some
                                           (ix_app
                                             ia
                                             (ix_app
                                               (ixf_spill nl d)
                                               (ix_app
                                                 ib
                                                 (ix_app
                                                   (ixf_reload10 nl d)
                                                   (list
                                                     (XBin XAdd R10 (SReg RAX))
                                                     (XMovRR RAX R10)))))))
                                         (Some ie))
                                       (steps
                                         ((rewrite (premise hp) rl rhs true ())
                                          (unfold ixf_exp rhs)
                                          (reduce rhs)
                                          (rewrite (premise ha) lr rhs true ())
