          (fp_mem mem0 psx))
        (fp_mem mem0 (fp_app (fz_tr fp from nl) psx)))))
  (chain
    (have hf (= from (- nl (- nl from))) (by arith (list (list 1) (list 1))))
    (steps ((rewrite (premise hf) lr both true ())))
    (rewrite-with
      (lemma fz_sound_n)
      lr
      lhs
      ()
