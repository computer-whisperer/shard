(claim fr_intro
  (goal ((nl Int) (own Int) (sd Int) (mo Int))
    ((= (le (* 8 (+ nl (+ 1 sd))) own) True)
     (= (int_eq (mod own 8) 0) True)
     (= (le own mo) True))
    (= (ixf_fr nl own sd mo) True))
  (steps
    ((unfold ixf_fr lhs)
     (reduce lhs)
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (rewrite (premise 1) lr lhs true ())
     (reduce lhs)
     (rewrite (premise 2) lr lhs true ()))
    refl))

(claim fr_sub
  (goal ((nl Int) (own Int) (sd Int) (sd2 Int) (mo Int))
    ((= (ixf_fr nl own sd mo) True) (= (le sd2 sd) True))
    (= (ixf_fr nl own sd2 mo) True))
  (chain
    (have h1 (= (le (* 8 (+ nl (+ 1 sd))) own) True)
      (rewrite-with
        (lemma fr_nl)
        lr
        lhs
        ((inst mo mo))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h2 (= (int_eq (mod own 8) 0) True)
      (rewrite-with
        (lemma fr_al)
        lr
        lhs
        ((inst nl nl) (inst sd sd) (inst mo mo))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h3 (= (le own mo) True)
      (rewrite-with
        (lemma fr_mo)
        lr
        lhs
        ((inst nl nl) (inst sd sd))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have h1b (= (le (* 8 (+ nl (+ 1 sd2))) own) True)
      (by arith (list 1 0 8 1 0 0)))
    (rewrite-with
      (lemma fr_intro)
      lr
      lhs
      ()
      ((steps ((rewrite (premise h1b) lr lhs true ())) refl)
       (steps ((rewrite (premise h2) lr lhs true ())) refl)
       (steps ((rewrite (premise h3) lr lhs true ())) refl))
      refl)))

(claim al_shift_own
  (goal ((slo Int) (fp Int) (own Int) (j Int))
    ((= (int_eq (mod (- fp slo) 8) 0) True) (= (int_eq (mod own 8) 0) True))
    (= (int_eq (mod (- (+ fp (+ own (* 8 j))) slo) 8) 0) True))
  (div-facts
    own
    8
    q1
    (have hown (= own (* 8 q1))
      (by arith (list (list 1 0 -1 -1 0 0 0) (list 1 0 1 1 0 0 0)))
      (have hsp (= (- (+ fp (+ own (* 8 j))) slo) (- (+ fp (* 8 (+ q1 j))) slo))
        (by arith (list (list 1 0 0 0 0 0 0 -1) (list 1 0 0 0 0 0 0 1)))
        (chain
          (steps ((rewrite (premise hsp) lr lhs true ())))
          (rewrite-with
            (lemma al_shift)
            lr
            lhs
            ((inst k (+ q1 j)))
            ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
          refl)))))

(claim al_add
  (goal ((slo Int) (fp Int) (own Int))
    ((= (int_eq (mod (- fp slo) 8) 0) True) (= (int_eq (mod own 8) 0) True))
    (= (int_eq (mod (- (+ fp own) slo) 8) 0) True))
  (chain
    (have h8 (= (- (+ fp own) slo) (- (+ fp (+ own (* 8 0))) slo))
      (by arith (list (list 1 0 0) (list 1 0 0))))
    (steps ((rewrite (premise h8) lr lhs true ())))
    (rewrite-with
      (lemma al_shift_own)
      lr
      lhs
      ((inst j 0))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)))
    refl))

(claim ixf_own_unf
  (goal ((g IpFn)) ()
    (=
      (ixf_own g)
      (*
        8
        (+
          (+ (ikn (ipparams_of g)) (ikn (ipextra_of g)))
          (+ 1 (imax2 (ixf_sdep (ipbody_of g)) (ixf_dep (ipresult_of g))))))))
  (steps ((unfold ixf_own lhs)) refl))

(claim ixf_sdep_nonneg
  (goal ((ss (List IpStmt))) () (= (le 0 (ixf_sdep ss)) True))
  (induct ss
    ((case Nil (steps ((unfold ixf_sdep lhs) (reduce lhs) (compute lhs)) refl))
     (case Cons
       (s t)
       (chain
         (have hih (= (le 0 (ixf_sdep t)) True)
           (rewrite-with (hyp ih) lr lhs () () refl))
         (have hr (= (le (ixf_sdep t) (imax2 (ixf_sdeps s) (ixf_sdep t))) True)
           (rewrite-with (lemma imax2_ge_r) lr lhs () () refl))
         (steps ((unfold ixf_sdep lhs) (reduce lhs)) (by arith (list 1 1 1))))))))

(claim ixf_own_nonneg
  (goal ((g IpFn)) () (= (le 0 (ixf_own g)) True))
  (chain
    (have hp (= (le 0 (ikn (ipparams_of g))) True)
      (rewrite-with (lemma ikn_nonneg) lr lhs () () refl))
    (have he (= (le 0 (ikn (ipextra_of g))) True)
      (rewrite-with (lemma ikn_nonneg) lr lhs () () refl))
    (have hs (= (le 0 (ixf_sdep (ipbody_of g))) True)
      (rewrite-with (lemma ixf_sdep_nonneg) lr lhs () () refl))
    (have hm
      (=
        (le
          (ixf_sdep (ipbody_of g))
          (imax2 (ixf_sdep (ipbody_of g)) (ixf_dep (ipresult_of g))))
        True)
      (rewrite-with (lemma imax2_ge_l) lr lhs () () refl))
    (steps
      ((rewrite (lemma ixf_own_unf) lr lhs true ()))
      (by arith (list 1 8 8 8 8)))))

