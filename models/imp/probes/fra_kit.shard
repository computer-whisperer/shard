         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hal (= (int_eq (mod (- fp slo) 8) 0) True)
      (rewrite-with
        (lemma ctx_al)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
