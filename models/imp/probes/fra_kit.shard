(claim fz_locs_n
  (goal ((n Int) (fp Int) (nl Int) (q (List FPatch))) ((= (le 0 (- nl n)) True))
    (=
      (fr_locs
        (+ fp (* 8 (- nl n)))
        (izeros n)
        (fp_app (fz_tr fp (- nl n) nl) q))
      True))
  (wf-induct n
    (case-on (lt (- nl n) nl) Bool
      ((case True
         (chain
           (have hlt (= (lt (- nl n) nl) True)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (have hs1 (= (+ (- nl n) 1) (- nl (- n 1)))
             (by arith (list (list 1) (list 1))))
           (have hc
             (=
               (fp_app (Cons (FWord (+ fp (* 8 (- nl n))) 0) Nil) q)
               (Cons (FWord (+ fp (* 8 (- nl n))) 0) q))
             (steps
               ((unfold fp_app lhs)
                (reduce lhs)
                (unfold fp_app lhs)
                (reduce lhs))
               refl))
           (have hz (= (izeros n) (Cons 0 (izeros (- n 1))))
             (chain
               (have hlt1 (= (lt n 1) False) (by arith (list 1 0 1 0 0)))
               (steps
                 ((unfold izeros lhs)
                  (rewrite (premise hlt1) lr lhs true ())
                  (reduce lhs))
                 refl)))
           (have hmin
             (=
               (fp_min (fz_tr fp (- nl (- n 1)) nl) (+ fp (* 8 (- nl (- n 1)))))
               True)
             (rewrite-with (lemma fz_min) lr lhs () () refl))
           (have hlt8
             (= (lt (+ fp (* 8 (- nl n))) (+ fp (* 8 (- nl (- n 1))))) True)
             (by arith (list 1)))
           (have hwv
             (=
               (fp_wordv
                 (fp_app
                   (fz_tr fp (- nl (- n 1)) nl)
                   (Cons (FWord (+ fp (* 8 (- nl n))) 0) q))
                 (+ fp (* 8 (- nl n))))
               (Some 0))
             (chain
               (rewrite-with
                 (lemma fp_wordv_app_min)
                 lr
                 lhs
                 ((inst lo (+ fp (* 8 (- nl (- n 1))))))
                 ((steps ((rewrite (premise hmin) lr lhs true ())) refl)
                  (steps ((rewrite (premise hlt8) lr lhs true ())) refl)))
               (steps
                 ((unfold fp_wordv lhs)
                  (reduce lhs)
                  (rewrite (lemma int_eq_refl) lr lhs true ())
                  (reduce lhs))
                 refl)))
           (have hnext
             (= (+ (+ fp (* 8 (- nl n))) 8) (+ fp (* 8 (- nl (- n 1)))))
             (by arith (list (list 1) (list 1))))
           (have hih
             (=
               (fr_locs
                 (+ fp (* 8 (- nl (- n 1))))
                 (izeros (- n 1))
                 (fp_app
                   (fz_tr fp (- nl (- n 1)) nl)
                   (Cons (FWord (+ fp (* 8 (- nl n))) 0) q)))
               True)
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((by arith (list 1 1 0))
                (by arith (list 1 0 1))
                (by arith (list 1)))
               refl))
           (have h00 (= (le 0 0) True) (by arith (list 1)))
           (have h0n (= (lt 0 18446744073709551616) True) (by arith (list 1)))
           (rewrite-with
             (lemma fz_unf_lt)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hlt) lr lhs true ())) refl)))
           (steps
             ((rewrite (premise hs1) lr lhs true ())
              (rewrite (lemma fp_app_assoc) lr lhs true ())
              (rewrite (premise hc) lr lhs true ())
              (rewrite (premise hz) lr lhs true ())
              (rewrite (lemma fr_locs_unf) lr lhs true ())
              (rewrite (premise hwv) lr lhs true ())
              (unfold opt_int_eq lhs)
              (reduce lhs)
              (rewrite (lemma int_eq_refl) lr lhs true ())
              (reduce lhs)
              (rewrite (premise h00) lr lhs true ())
              (reduce lhs)
              (rewrite (premise h0n) lr lhs true ())
              (reduce lhs)
              (rewrite (premise hnext) lr lhs true ())
              (rewrite (premise hih) lr lhs true ()))
             refl)))
       (case False
         (chain
           (have hlt (= (lt (- nl n) nl) False)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (have hz (= (izeros n) Nil)
             (chain
               (have hlt1 (= (lt n 1) True) (by arith (list 1 0 1)))
               (steps
                 ((unfold izeros lhs)
                  (rewrite (premise hlt1) lr lhs true ())
                  (reduce lhs))
                 refl)))
           (steps
             ((rewrite (premise hz) lr lhs true ())
              (unfold fr_locs lhs)
              (reduce lhs))
             refl)))))))

