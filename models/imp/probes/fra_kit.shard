    ((=
       (ipt_run f fs mlo slo dmax dep r lc (fp_mem mem0 (fbelow slo psx)))
       (Some (IpNorm lc2 mem2)))
     (= (le slo fp) True)
     (= (le 0 nl) True)
     (= (le 0 own) True))
    (=
      (fp_mem
        mem0
        (fbelow
          slo
          (fp_app
            (ipt_tr
              f
              fs
              mlo
              slo
              dmax
              dep
              fp
              nl
              own
              r
              lc
              (fp_mem mem0 (fbelow slo psx)))
            psx)))
      mem2))
  (induct f
    ((case Z
       (case-on r IptReq
         ((case IqStmt
            (s)
            (chain
              (have hr (= r (IqStmt s))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (chain
                (have hn (= None (Some (IpNorm lc2 mem2)))
                  (steps
                    ((rewrite (premise 0) rl rhs true ())
                     (rewrite (premise hr) lr rhs true ())
                     (unfold ipt_run rhs)
                     (reduce rhs)
                     (unfold ipstmt rhs)
