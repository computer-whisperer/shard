                           True)
                         (rewrite-with
                           (lemma bor_lo)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hsrl) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hsl) lr lhs true ()))
                              refl))
                           refl))
                       (chain
                         (have hv
                           (=
                             (Some
                               (band
                                 (bor
                                   (bshr
                                     (band va (- (ikmod k) 1))
                                     (mod vc (ikw k)))
                                   (bshl
                                     (band va (- (ikmod k) 1))
                                     (mod (- (ikw k) (mod vc (ikw k))) (ikw k))))
                                 (- (ikmod k) 1)))
                             (Some v))
                           (steps
                             ((rewrite (premise 0) rl rhs true ())
                              (unfold iexp rhs)
                              (reduce rhs)
                              (rewrite (premise hva) lr rhs true ())
                              (reduce rhs)
                              (rewrite (premise hvc) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (inject (premise hv) (hvv))
                         (steps ((rewrite (premise hvv) rl lhs true ())))
                         (rewrite-with
                           (lemma mask_inband)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hor) lr lhs true ()))
                              refl))
                           refl))))))))))))
     (case IExt
       (k1 k2 a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_ext)
             lr
             lhs
             ((inst k1 k1) (inst k2 k2))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hp (= (iexp a lc mem mlo msz) (Some v))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold iexp rhs)
              (reduce rhs))
             refl))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ((inst lc lc)
            (inst mem mem)
            (inst mlo mlo)
            (inst msz msz)
            (inst fp fp)
            (inst psx psx))
           ((steps ((rewrite (premise hp) lr lhs true ())) refl)
            (steps ((rewrite (premise 1) lr lhs true ())) refl)
            (steps ((rewrite (premise hcb) lr lhs true ())) refl)))
         refl))
     (case ITrunc
       (k1 kt a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_trunc)
             lr
             lhs
             ((inst k1 k1) (inst kt kt))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (case-on (iexp a lc mem mlo msz) Option
           ((case None
              (chain
                (have hva (= (iexp a lc mem mlo msz) None)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (chain
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn)))))
            (case Some
              (va)
              (chain
                (have hva (= (iexp a lc mem mlo msz) (Some va))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (have hba (= (fe_inband va) True)
                  (rewrite-with
                    (hyp ih)
                    lr
                    lhs
                    ((inst lc lc)
                     (inst mem mem)
                     (inst mlo mlo)
                     (inst msz msz)
                     (inst fp fp)
                     (inst psx psx))
                    ((steps ((rewrite (premise hva) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcb) lr lhs true ())) refl))
                    refl))
                (have hal (= (le 0 va) True)
                  (rewrite-with
                    (lemma inband_lo)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hba) lr lhs true ())) refl))
                    refl))
                (chain
                  (have hv (= (Some (band va (- (ikmod kt) 1))) (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (inject (premise hv) (hvv))
                  (steps ((rewrite (premise hvv) rl lhs true ())))
                  (rewrite-with
                    (lemma mask_inband)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hal) lr lhs true ())) refl))
                    refl))))))))
     (case ILoad
       (a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_load)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (case-on (iexp a lc mem mlo msz) Option
           ((case None
              (chain
                (have hva (= (iexp a lc mem mlo msz) None)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (chain
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn)))))
            (case Some
              (va)
              (chain
                (have hva (= (iexp a lc mem mlo msz) (Some va))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (case-on (le mlo va) Bool
                  ((case False
                     (chain
                       (have hl0 (= (le mlo va) False)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (chain
                         (have hn (= None (Some v))
                           (steps
                             ((rewrite (premise 0) rl rhs true ())
                              (unfold iexp rhs)
                              (reduce rhs)
                              (rewrite (premise hva) lr rhs true ())
                              (reduce rhs)
                              (rewrite (premise hl0) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (absurd (premise hn)))))
                   (case True
                     (chain
                       (have hl0 (= (le mlo va) True)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (case-on (lt va msz) Bool
                         ((case False
                            (chain
                              (have hl1 (= (lt va msz) False)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hn (= None (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (absurd (premise hn)))))
                          (case True
                            (chain
                              (have hl1 (= (lt va msz) True)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hv (= (Some (mem_get mem va)) (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (inject (premise hv) (hvv))
                                (steps ((rewrite (premise hvv) rl lhs true ())))
                                (rewrite-with
                                  (lemma get_inband)
                                  lr
                                  lhs
                                  ()
                                  ()
                                  refl)))))))))))))))))))
