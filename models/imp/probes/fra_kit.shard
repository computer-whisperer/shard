(claim fe_tr_below
  (goal
    ((e IExp)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (mem Mem)
     (mlo Int)
     (msz Int)
     (slo Int)
     (psx (List FPatch)))
    ((= (le slo fp) True) (= (le 0 (+ nl d)) True))
    (=
      (fbelow slo (fp_app (fe_tr fp nl d e lc mem mlo msz) psx))
      (fbelow slo psx)))
  (induct e
    ((case IConst
       (n)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps ((unfold fp_app lhs) (reduce lhs)) refl)))
     (case ILoc
       (i)
       (chain
         (steps ((unfold fe_tr lhs) (reduce lhs)))
         (steps ((unfold fp_app lhs) (reduce lhs)) refl)))
     (case IBin
       (k o a b)
       (case-on o IOp
         ((case IAdd
            (chain
              (have ho (= o IAdd)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
                 (unfold fe_tr lhs)
                 (reduce lhs)))
              (case-on (iexp a lc mem mlo msz) Option
                ((case None
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) None)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (steps ((unfold fp_app lhs) (reduce lhs)) refl)))
                 (case Some
                   (va)
                   (chain
                     (have hva (= (iexp a lc mem mlo msz) (Some va))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps
                       ((rewrite (premise hva) lr lhs true ()) (reduce lhs)))
                     (chain
                       (have hlo (= (le (+ (+ fp (* 8 (+ nl d))) 8) slo) False)
                         (by arith (list 1 1 8 0 0)))
                       (have hnd (= (le 0 (+ nl (+ d 1))) True)
                         (by arith (list 1 0 1 0 0 0)))
                       (have hc
                         (=
                           (fp_app
                             (Cons
                               (FWord (+ fp (* 8 (+ nl d))) va)
                               (fe_tr fp nl d a lc mem mlo msz))
                             psx)
                           (Cons
                             (FWord (+ fp (* 8 (+ nl d))) va)
                             (fp_app (fe_tr fp nl d a lc mem mlo msz) psx)))
                         (steps ((unfold fp_app lhs) (reduce lhs)) refl))
                       (steps
                         ((rewrite (lemma fp_app_assoc) lr lhs true ())
                          (rewrite (premise hc) lr lhs true ())))
                       (rewrite-with
                         (hyp ih1)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise hnd) lr lhs true ())) refl)))
                       (rewrite-with
                         (lemma fbelow_w_hi)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hlo) lr lhs true ())) refl)))
                       (rewrite-with
                         (hyp ih)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)))
                       refl)))))))
          (case ISub
            (chain
              (have ho (= o ISub)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
