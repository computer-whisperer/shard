                (reduce rhs)
                (rewrite (premise 7) lr rhs true ())
                (reduce rhs)
                (rewrite (premise hl0) lr rhs true ())
                (reduce rhs))
               refl))
           (absurd (premise hn))))
       (case True
         (chain
           (have hl0 (= (le mlo va) True)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (case-on (lt va slo) Bool
             ((case False
                (chain
                  (have hl1 (= (lt va slo) False)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 1) rl rhs true ())
