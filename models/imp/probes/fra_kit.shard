           (have hs0 (= (le 0 cc) True)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (case-on (lt cc (ikw k)) Bool
             ((case False
                (chain
                  (have hs1 (= (lt cc (ikw k)) False)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                  (have hn (= None (Some v))
