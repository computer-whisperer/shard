(claim fe_step_mul32
  (goal
    ((a IExp)
     (b IExp)
     (ia (List XInstr))
     (va Int)
     (ib (List XInstr))
     (vb Int)
     (nl Int)
     (d Int)
     (ie (List XInstr))
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (v Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d (IBin U32 IMul a b)) (Some ie))
     (=
       (iexp (IBin U32 IMul a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb (IBin U32 IMul a b)) True)
     (=
       (le
         (+ fp (* 8 (+ nl (+ d (ixf_dep (IBin U32 IMul a b))))))
         (xmemhi_of m))
       True)
     (= (le (ixf_ecost (IBin U32 IMul a b)) c) True)
     (= (ixf_exp nl d a) (Some ia))
     (= (iexp a lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some va))
     (=
       (xeval_seq
         (xt c g)
