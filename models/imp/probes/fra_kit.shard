                     (xo_regs
                       (xeval_seq
                         (xt c g)
                         m
                         ic
                         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13
                           dep fp)
                         (fp_mem mem0 psx))))
                   rbx
                   rbp
                   rsi
                   di
                   r8
                   r9
                   (r10_of
