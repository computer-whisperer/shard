;; --- the spill depth's order laws ------------------------------------------------------

(claim imax2_mono_r
  (goal ((a Int) (b Int) (c Int)) ((= (le b c) True))
    (= (le (imax2 a b) (imax2 a c)) True))
  (case-on (lt a b) Bool
    ((case True
       (chain
         (have hb (= (lt a b) True)
           (steps ((rewrite (hyp True) lr lhs true ())) refl))
         (have hc (= (lt a c) True) (by arith (list 1 1 1)))
         (steps
           ((unfold imax2 lhs)
            (rewrite (premise hb) lr lhs true ())
            (reduce lhs)
            (unfold imax2 lhs)
            (rewrite (premise hc) lr lhs true ())
            (reduce lhs))
           (by arith (list 1 1 0 0)))))
     (case False
       (chain
         (have hb (= (lt a b) False)
           (steps ((rewrite (hyp False) lr lhs true ())) refl))
         (case-on (lt a c) Bool
           ((case True
              (chain
                (have hc (= (lt a c) True)
                  (steps ((rewrite (hyp True) lr lhs true ())) refl))
                (steps
                  ((unfold imax2 lhs)
                   (rewrite (premise hb) lr lhs true ())
                   (reduce lhs)
                   (unfold imax2 lhs)
                   (rewrite (premise hc) lr lhs true ())
                   (reduce lhs))
                  (by arith (list 1 0 0 1)))))
            (case False
              (chain
                (have hc (= (lt a c) False)
                  (steps ((rewrite (hyp False) lr lhs true ())) refl))
                (steps
                  ((unfold imax2 lhs)
                   (rewrite (premise hb) lr lhs true ())
                   (reduce lhs)
                   (unfold imax2 lhs)
                   (rewrite (premise hc) lr lhs true ())
                   (reduce lhs))
                  (by arith (list 1 0 0 0))))))))))))

(claim sdep_nonneg
  (goal ((ss (List IpStmt))) () (= (le 0 (ixf_sdep ss)) True))
  (induct ss
    ((case Nil (steps ((unfold ixf_sdep lhs) (reduce lhs)) (by arith (list 1))))
     (case Cons
       (s t)
       (chain
         (have h1 (= (le 0 (ixf_sdep t)) True)
           (steps ((rewrite (hyp ih) lr lhs true ())) refl))
         (have h2 (= (le (ixf_sdep t) (imax2 (ixf_sdeps s) (ixf_sdep t))) True)
           (rewrite-with
             (lemma imax2_ge_r)
             lr
             lhs
             ((inst a (ixf_sdeps s)))
             ()
             refl))
         (steps ((unfold ixf_sdep lhs) (reduce lhs)) (by arith (list 1 1 1))))))))

(claim sdep_head
  (goal ((s IpStmt) (t (List IpStmt))) ()
    (= (le (ixf_sdep (Cons s Nil)) (ixf_sdep (Cons s t))) True))
  (chain
    (have hn (= (le 0 (ixf_sdep t)) True)
      (rewrite-with (lemma sdep_nonneg) lr lhs () () refl))
    (steps
      ((unfold ixf_sdep lhs)
       (reduce lhs)
       (unfold ixf_sdep lhs)
       (reduce lhs)
       (unfold ixf_sdep lhs)
       (reduce lhs)))
    (rewrite-with
      (lemma imax2_mono_r)
      lr
      lhs
      ((inst a (ixf_sdeps s)))
      ((steps ((rewrite (premise hn) lr lhs true ())) refl)))
    refl))

;; --- A-5: THE CALL KIT (hand), part 1: the patch predicates fp_max / fp_away / fp_wmin ---
;; fp_wmin = THE FRAME-DISJOINTNESS PREDICATE (every word patch is a program patch or
;; sits at or above lo); fp_max bounds the spill trace from above; fp_away = no word at a
(claim fp_max_unf_w
  (goal ((a Int) (v Int) (rest (List FPatch)) (hi Int)) ()
    (=
      (fp_max (Cons (FWord a v) rest) hi)
      (if (le (+ a 8) hi) (fp_max rest hi) False)))
  (steps ((unfold fp_max lhs) (reduce lhs)) refl))

(claim fp_max_unf_b
  (goal ((a Int) (v Int) (rest (List FPatch)) (hi Int)) ()
    (= (fp_max (Cons (FByte a v) rest) hi) (fp_max rest hi)))
  (steps ((unfold fp_max lhs) (reduce lhs)) refl))

(claim fp_max_head
  (goal ((a Int) (v Int) (rest (List FPatch)) (hi Int))
    ((= (fp_max (Cons (FWord a v) rest) hi) True))
    (= (le (+ a 8) hi) True))
  (case-on (le (+ a 8) hi) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (le (+ a 8) hi) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (lemma fp_max_unf_w) lr rhs true ())
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim fp_max_tail
  (goal ((a Int) (v Int) (rest (List FPatch)) (hi Int))
    ((= (fp_max (Cons (FWord a v) rest) hi) True))
    (= (fp_max rest hi) True))
  (chain
    (have hh (= (le (+ a 8) hi) True)
      (rewrite-with
        (lemma fp_max_head)
        lr
        lhs
        ((inst v v) (inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (rewrite (lemma fp_max_unf_w) lr rhs true ())
       (rewrite (premise hh) lr rhs true ())
       (reduce rhs))
      refl)))

(claim fp_max_app
  (goal ((xs (List FPatch)) (ys (List FPatch)) (hi Int))
    ((= (fp_max xs hi) True) (= (fp_max ys hi) True))
    (= (fp_max (fp_app xs ys) hi) True))
  (induct xs
    ((case Nil
       (steps
         ((unfold fp_app lhs) (reduce lhs) (rewrite (premise 1) lr lhs true ()))
         refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_max (Cons (FWord x w) rest) hi) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have ht (= (fp_max rest hi) True)
                (rewrite-with
                  (lemma fp_max_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hh (= (le (+ x 8) hi) True)
                (rewrite-with
                  (lemma fp_max_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (rewrite (lemma fp_max_unf_w) lr lhs true ())
                 (rewrite (premise hh) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_max rest hi) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_max_unf_b) lr rhs true ()))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (rewrite (lemma fp_max_unf_b) lr lhs true ())))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))))))))

(claim fp_max_weaken
  (goal ((ps (List FPatch)) (hi Int) (hi2 Int))
    ((= (fp_max ps hi) True) (= (le hi hi2) True))
    (= (fp_max ps hi2) True))
  (induct ps
    ((case Nil (steps ((unfold fp_max lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_max (Cons (FWord x w) rest) hi) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le (+ x 8) hi) True)
                (rewrite-with
                  (lemma fp_max_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_max rest hi) True)
                (rewrite-with
                  (lemma fp_max_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hh2 (= (le (+ x 8) hi2) True)
                (by arith (list 1 0 1 0 0 1 0)))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_max_unf_w) lr lhs true ())
                 (rewrite (premise hh2) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_max rest hi) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_max_unf_b) lr rhs true ()))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_max_unf_b) lr lhs true ())))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))))))))

(claim fp_away_unf_w
  (goal ((b Int) (v Int) (rest (List FPatch)) (a Int)) ()
    (=
      (fp_away (Cons (FWord b v) rest) a)
      (if (int_eq b a) False (fp_away rest a))))
  (steps ((unfold fp_away lhs) (reduce lhs)) refl))

(claim fp_away_unf_b
  (goal ((b Int) (v Int) (rest (List FPatch)) (a Int)) ()
    (= (fp_away (Cons (FByte b v) rest) a) (fp_away rest a)))
  (steps ((unfold fp_away lhs) (reduce lhs)) refl))

(claim fp_away_head
  (goal ((b Int) (v Int) (rest (List FPatch)) (a Int))
    ((= (fp_away (Cons (FWord b v) rest) a) True))
    (= (int_eq b a) False))
  (case-on (int_eq b a) Bool
    ((case True
       (chain
         (have ht (= (int_eq b a) True)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (lemma fp_away_unf_w) lr rhs true ())
              (rewrite (premise ht) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff))))
     (case False (steps ((rewrite (hyp 0) lr lhs true ())) refl)))))

(claim fp_away_tail
  (goal ((b Int) (v Int) (rest (List FPatch)) (a Int))
    ((= (fp_away (Cons (FWord b v) rest) a) True))
    (= (fp_away rest a) True))
  (chain
    (have hne (= (int_eq b a) False)
      (rewrite-with
        (lemma fp_away_head)
        lr
        lhs
        ((inst v v) (inst rest rest))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (rewrite (lemma fp_away_unf_w) lr rhs true ())
       (rewrite (premise hne) lr rhs true ())
       (reduce rhs))
      refl)))

(claim fp_away_app
  (goal ((xs (List FPatch)) (ys (List FPatch)) (a Int))
    ((= (fp_away xs a) True) (= (fp_away ys a) True))
    (= (fp_away (fp_app xs ys) a) True))
  (induct xs
    ((case Nil
       (steps
         ((unfold fp_app lhs) (reduce lhs) (rewrite (premise 1) lr lhs true ()))
         refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_away (Cons (FWord x w) rest) a) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have ht (= (fp_away rest a) True)
                (rewrite-with
                  (lemma fp_away_tail)
                  lr
                  lhs
                  ((inst b x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hne (= (int_eq x a) False)
                (rewrite-with
                  (lemma fp_away_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (rewrite (lemma fp_away_unf_w) lr lhs true ())
                 (rewrite (premise hne) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_away rest a) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_away_unf_b) lr rhs true ()))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (rewrite (lemma fp_away_unf_b) lr lhs true ())))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))))))))

(claim fp_wordv_app_away
  (goal ((ps (List FPatch)) (rest (List FPatch)) (a Int))
    ((= (fp_away ps a) True))
    (= (fp_wordv (fp_app ps rest) a) (fp_wordv rest a)))
  (induct ps
    ((case Nil (steps ((unfold fp_app lhs) (reduce lhs)) refl))
     (case Cons
       (p t)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_away (Cons (FWord x w) t) a) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hne (= (int_eq x a) False)
                (rewrite-with
                  (lemma fp_away_head)
                  lr
                  lhs
                  ((inst v w) (inst rest t))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_away t a) True)
                (rewrite-with
                  (lemma fp_away_tail)
                  lr
                  lhs
                  ((inst b x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (unfold fp_wordv lhs)
                 (reduce lhs)
                 (rewrite (premise hne) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_away t a) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_away_unf_b) lr rhs true ()))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)
                 (unfold fp_wordv lhs)
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)))
              refl))))))))

(claim fp_away_of_min
  (goal ((ps (List FPatch)) (lo Int) (a Int))
    ((= (fp_min ps lo) True) (= (lt a lo) True))
    (= (fp_away ps a) True))
  (induct ps
    ((case Nil (steps ((unfold fp_away lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_min (Cons (FWord x w) rest) lo) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le lo x) True)
                (rewrite-with
                  (lemma fp_min_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_min rest lo) True)
                (rewrite-with
                  (lemma fp_min_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hne (= (int_eq x a) False) (by arith (list -1 0 1 0 0 1 0)))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_away_unf_w) lr lhs true ())
                 (rewrite (premise hne) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a) (inst lo lo))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have hff (= False True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (unfold fp_min rhs)
                   (reduce rhs))
                  refl))
              (absurd (premise hff))))))))))

(claim fp_away_of_max
  (goal ((ps (List FPatch)) (hi Int) (a Int))
    ((= (fp_max ps hi) True) (= (le hi a) True))
    (= (fp_away ps a) True))
  (induct ps
    ((case Nil (steps ((unfold fp_away lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_max (Cons (FWord x w) rest) hi) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le (+ x 8) hi) True)
                (rewrite-with
                  (lemma fp_max_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_max rest hi) True)
                (rewrite-with
                  (lemma fp_max_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hne (= (int_eq x a) False) (by arith (list 1 0 1 0 0 1 0)))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_away_unf_w) lr lhs true ())
                 (rewrite (premise hne) lr lhs true ())
                 (reduce lhs)))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a) (inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_max rest hi) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_max_unf_b) lr rhs true ()))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (rewrite (lemma fp_away_unf_b) lr lhs true ())))
              (rewrite-with
                (hyp ih)
                lr
                lhs
                ((inst a a) (inst hi hi))
                ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                 (steps ((rewrite (premise 1) lr lhs true ())) refl)))
              refl))))))))

(claim fp_wmin_unf_w
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch))) ()
    (=
      (fp_wmin slo lo (Cons (FWord a v) rest))
      (if (if (le (+ a 8) slo) True (le lo a)) (fp_wmin slo lo rest) False)))
  (steps ((unfold fp_wmin lhs) (reduce lhs)) refl))

(claim fp_wmin_unf_b
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch))) ()
    (= (fp_wmin slo lo (Cons (FByte a v) rest)) (fp_wmin slo lo rest)))
  (steps ((unfold fp_wmin lhs) (reduce lhs)) refl))

(claim fp_wmin_cons_lo
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (le (+ a 8) slo) True) (= (fp_wmin slo lo rest) True))
    (= (fp_wmin slo lo (Cons (FWord a v) rest)) True))
  (steps
    ((rewrite (lemma fp_wmin_unf_w) lr lhs true ())
     (rewrite (premise 0) lr lhs true ())
     (reduce lhs)
     (rewrite (premise 1) lr lhs true ()))
    refl))

(claim fp_wmin_cons_hi
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (le lo a) True) (= (fp_wmin slo lo rest) True))
    (= (fp_wmin slo lo (Cons (FWord a v) rest)) True))
  (case-on (le (+ a 8) slo) Bool
    ((case True
       (steps
         ((rewrite (lemma fp_wmin_unf_w) lr lhs true ())
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (rewrite (premise 1) lr lhs true ()))
         refl))
     (case False
       (steps
         ((rewrite (lemma fp_wmin_unf_w) lr lhs true ())
          (rewrite (hyp 0) lr lhs true ())
          (reduce lhs)
          (rewrite (premise 0) lr lhs true ())
          (reduce lhs)
          (rewrite (premise 1) lr lhs true ()))
         refl)))))

(claim fp_wmin_cons_b
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (fp_wmin slo lo rest) True))
    (= (fp_wmin slo lo (Cons (FByte a v) rest)) True))
  (steps
    ((rewrite (lemma fp_wmin_unf_b) lr lhs true ())
     (rewrite (premise 0) lr lhs true ()))
    refl))

(claim fp_wmin_head_hi
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (fp_wmin slo lo (Cons (FWord a v) rest)) True)
     (= (le (+ a 8) slo) False))
    (= (le lo a) True))
  (case-on (le lo a) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (le lo a) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (rewrite (lemma fp_wmin_unf_w) lr rhs true ())
              (rewrite (premise 1) lr rhs true ())
              (reduce rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim fp_wmin_tail
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (fp_wmin slo lo (Cons (FWord a v) rest)) True))
    (= (fp_wmin slo lo rest) True))
  (case-on (le (+ a 8) slo) Bool
    ((case True
       (steps
         ((rewrite (premise 0) rl rhs true ())
          (rewrite (lemma fp_wmin_unf_w) lr rhs true ())
          (rewrite (hyp 0) lr rhs true ())
          (reduce rhs))
         refl))
     (case False
       (chain
         (have hf (= (le (+ a 8) slo) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hh (= (le lo a) True)
           (rewrite-with
             (lemma fp_wmin_head_hi)
             lr
             lhs
             ((inst v v) (inst slo slo) (inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl)
              (steps ((rewrite (premise hf) lr lhs true ())) refl))
             refl))
         (steps
           ((rewrite (premise 0) rl rhs true ())
            (rewrite (lemma fp_wmin_unf_w) lr rhs true ())
            (rewrite (premise hf) lr rhs true ())
            (reduce rhs)
            (rewrite (premise hh) lr rhs true ())
            (reduce rhs))
           refl))))))

(claim fp_wmin_tail_b
  (goal ((slo Int) (lo Int) (a Int) (v Int) (rest (List FPatch)))
    ((= (fp_wmin slo lo (Cons (FByte a v) rest)) True))
    (= (fp_wmin slo lo rest) True))
  (steps
    ((rewrite (premise 0) rl rhs true ())
     (rewrite (lemma fp_wmin_unf_b) lr rhs true ()))
    refl))

(claim fp_wmin_app
  (goal ((a (List FPatch)) (b (List FPatch)) (slo Int) (lo Int))
    ((= (fp_wmin slo lo a) True) (= (fp_wmin slo lo b) True))
    (= (fp_wmin slo lo (fp_app a b)) True))
  (induct a
    ((case Nil
       (steps
         ((unfold fp_app lhs) (reduce lhs) (rewrite (premise 1) lr lhs true ()))
         refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_wmin slo lo (Cons (FWord x w) rest)) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have ht (= (fp_wmin slo lo rest) True)
                (rewrite-with
                  (lemma fp_wmin_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hih (= (fp_wmin slo lo (fp_app rest b)) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo) (inst lo lo))
                  ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)))
              (case-on (le (+ x 8) slo) Bool
                ((case True
                   (chain
                     (have hs (= (le (+ x 8) slo) True)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (rewrite-with
                       (lemma fp_wmin_cons_lo)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hs) lr lhs true ())) refl)
                        (steps ((rewrite (premise hih) lr lhs true ())) refl))
                       refl)))
                 (case False
                   (chain
                     (have hs (= (le (+ x 8) slo) False)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hh (= (le lo x) True)
                       (rewrite-with
                         (lemma fp_wmin_head_hi)
                         lr
                         lhs
                         ((inst v w) (inst slo slo) (inst rest rest))
                         ((steps ((rewrite (premise h0) lr lhs true ())) refl)
                          (steps ((rewrite (premise hs) lr lhs true ())) refl))
                         refl))
                     (rewrite-with
                       (lemma fp_wmin_cons_hi)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hh) lr lhs true ())) refl)
                        (steps ((rewrite (premise hih) lr lhs true ())) refl))
                       refl)))))))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_wmin slo lo rest) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_wmin_unf_b) lr rhs true ()))
                  refl))
              (have hih (= (fp_wmin slo lo (fp_app rest b)) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo) (inst lo lo))
                  ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hp) lr both true ())
                 (unfold fp_app lhs)
                 (reduce lhs)))
              (rewrite-with
                (lemma fp_wmin_cons_b)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hih) lr lhs true ())) refl))
                refl)))))))))

(claim fp_wmin_mono
  (goal ((ps (List FPatch)) (slo Int) (lo Int) (lo2 Int))
    ((= (fp_wmin slo lo ps) True) (= (le lo2 lo) True))
    (= (fp_wmin slo lo2 ps) True))
  (induct ps
    ((case Nil (steps ((unfold fp_wmin lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_wmin slo lo (Cons (FWord x w) rest)) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have ht (= (fp_wmin slo lo rest) True)
                (rewrite-with
                  (lemma fp_wmin_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hih (= (fp_wmin slo lo2 rest) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo) (inst lo lo))
                  ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (steps ((rewrite (premise hp) lr both true ())))
              (case-on (le (+ x 8) slo) Bool
                ((case True
                   (chain
                     (have hs (= (le (+ x 8) slo) True)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (rewrite-with
                       (lemma fp_wmin_cons_lo)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hs) lr lhs true ())) refl)
                        (steps ((rewrite (premise hih) lr lhs true ())) refl))
                       refl)))
                 (case False
                   (chain
                     (have hs (= (le (+ x 8) slo) False)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hh (= (le lo x) True)
                       (rewrite-with
                         (lemma fp_wmin_head_hi)
                         lr
                         lhs
                         ((inst v w) (inst slo slo) (inst rest rest))
                         ((steps ((rewrite (premise h0) lr lhs true ())) refl)
                          (steps ((rewrite (premise hs) lr lhs true ())) refl))
                         refl))
                     (have hh2 (= (le lo2 x) True)
                       (by arith (list 1 0 1 0 0 0 0 0 1)))
                     (rewrite-with
                       (lemma fp_wmin_cons_hi)
                       lr
                       lhs
                       ()
                       ((steps ((rewrite (premise hh2) lr lhs true ())) refl)
                        (steps ((rewrite (premise hih) lr lhs true ())) refl))
                       refl)))))))
          (case FByte
            (x w)
            (chain
              (have hp (= p (FByte x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have ht (= (fp_wmin slo lo rest) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (rewrite (premise hp) lr rhs true ())
                   (rewrite (lemma fp_wmin_unf_b) lr rhs true ()))
                  refl))
              (have hih (= (fp_wmin slo lo2 rest) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo) (inst lo lo))
                  ((steps ((rewrite (premise ht) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (steps ((rewrite (premise hp) lr both true ())))
              (rewrite-with
                (lemma fp_wmin_cons_b)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hih) lr lhs true ())) refl))
                refl)))))))))

(claim fp_wmin_of_min
  (goal ((ps (List FPatch)) (slo Int) (lo Int)) ((= (fp_min ps lo) True))
    (= (fp_wmin slo lo ps) True))
  (induct ps
    ((case Nil (steps ((unfold fp_wmin lhs) (reduce lhs)) refl))
     (case Cons
       (p rest)
       (case-on p FPatch
         ((case FWord
            (x w)
            (chain
              (have hp (= p (FWord x w))
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (have h0 (= (fp_min (Cons (FWord x w) rest) lo) True)
                (steps
                  ((rewrite (premise hp) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (have hh (= (le lo x) True)
                (rewrite-with
                  (lemma fp_min_head)
                  lr
                  lhs
                  ((inst v w) (inst rest rest))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have ht (= (fp_min rest lo) True)
                (rewrite-with
                  (lemma fp_min_tail)
                  lr
                  lhs
                  ((inst a x) (inst v w))
                  ((steps ((rewrite (premise h0) lr lhs true ())) refl))
                  refl))
              (have hih (= (fp_wmin slo lo rest) True)
                (rewrite-with
                  (hyp ih)
                  lr
                  lhs
                  ((inst slo slo) (inst lo lo))
                  ((steps ((rewrite (premise ht) lr lhs true ())) refl))
