                           (fp_min
                             (Cons
                               (FWord (+ fp (* 8 (+ nl d))) va)
                               (fe_tr fp nl d a lc mem mlo msz))
                             (+ fp (* 8 (+ nl d))))
                           True)
                         (steps
                           ((rewrite (lemma fp_min_unf_w) lr lhs true ())
                            (rewrite (premise hself) lr lhs true ())
                            (reduce lhs)
                            (rewrite (premise hma) lr lhs true ()))
                           refl))
                       (rewrite-with
                         (lemma fp_min_app)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hmb2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hmc) lr lhs true ())) refl)))
                       refl)))))))
          (case IMul
            (chain
              (have ho (= o IMul)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps
                ((rewrite (premise ho) lr both true ())
                 (unfold fe_tr lhs)
