         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hal (= (int_eq (mod (- fp slo) 8) 0) True)
      (rewrite-with
        (lemma ctx_al)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hnl (= (le (ilen lc) nl) True)
      (rewrite-with
        (lemma ctx_nl)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst slo slo)
         (inst fp fp)
         (inst d d)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hd0 (= (le 0 d) True)
      (rewrite-with
        (lemma ctx_d)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst slo slo)
         (inst fp fp)
         (inst nl nl)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hslo0 (= (le 0 slo) True)
      (rewrite-with
        (lemma ctx_slo0)
        lr
        lhs
