              fp
              nl
              d
              (IBin k IDiv a b)
              lc
              (fp_mem mem0 (fbelow slo psx))
              mlo
              slo)
            psx)))))
  (chain
    (have hsome
      (=
        (Some
          (ix_app
            ia
            (ix_app
              (ixf_spill nl d)
              (ix_app ib (ix_app (ixf_reload10 nl d) (ixf_div))))))
        (Some ie))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_exp rhs)
         (reduce rhs)
         (rewrite (premise 6) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 9) lr rhs true ())
         (reduce rhs))
        refl))
    (inject (premise hsome) (hie))
    (have hop (= (iop_val k IDiv va vb) (Some v))
      (steps
        ((rewrite (premise 1) rl rhs true ())
         (unfold iexp rhs)
         (reduce rhs)
         (rewrite (premise 7) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 10) lr rhs true ())
         (reduce rhs))
        refl))
    (case-on (le 1 vb) Bool
      ((case False
         (chain
           (have hle (= (le 1 vb) False)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (have hn (= None (Some v))
             (steps
               ((rewrite (premise hop) rl rhs true ())
                (unfold iop_val rhs)
                (reduce rhs)
                (rewrite (premise hle) lr rhs true ())
                (reduce rhs))
               refl))
           (absurd (premise hn))))
       (case True
         (chain
           (have hle (= (le 1 vb) True)
             (steps ((rewrite (hyp 0) lr lhs true ())) refl))
           (have hv (= (Some (ediv va vb)) (Some v))
             (steps
               ((rewrite (premise hop) rl rhs true ())
                (unfold iop_val rhs)
                (reduce rhs)
                (rewrite (premise hle) lr rhs true ())
                (reduce rhs))
               refl))
           (inject (premise hv) (hvv))
           (have hdisc (= (fp_disc slo psx) True)
             (rewrite-with
               (lemma ctx_disc)
               lr
               lhs
               ((inst m m)
                (inst mlo mlo)
                (inst fp fp)
                (inst nl nl)
                (inst d d)
                (inst lc lc))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hlocs (= (fr_locs fp lc psx) True)
             (rewrite-with
               (lemma ctx_locs)
               lr
               lhs
               ((inst m m)
                (inst mlo mlo)
                (inst slo slo)
                (inst nl nl)
                (inst d d))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hxlo (= (int_eq (xmemlo_of m) mlo) True)
             (rewrite-with
               (lemma ctx_lo)
               lr
               lhs
               ((inst slo slo)
                (inst fp fp)
                (inst nl nl)
                (inst d d)
                (inst lc lc)
                (inst psx psx))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hmlo (= (le mlo slo) True)
             (rewrite-with
               (lemma ctx_mlo)
               lr
               lhs
               ((inst m m)
                (inst fp fp)
                (inst nl nl)
                (inst d d)
                (inst lc lc)
                (inst psx psx))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hslo (= (le slo fp) True)
             (rewrite-with
               (lemma ctx_slo)
               lr
               lhs
               ((inst m m)
                (inst mlo mlo)
                (inst nl nl)
                (inst d d)
                (inst lc lc)
                (inst psx psx))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hal (= (int_eq (mod (- fp slo) 8) 0) True)
             (rewrite-with
               (lemma ctx_al)
               lr
               lhs
               ((inst m m)
                (inst mlo mlo)
                (inst nl nl)
                (inst d d)
                (inst lc lc)
                (inst psx psx))
               ((steps ((rewrite (premise 2) lr lhs true ())) refl))
               refl))
           (have hnl (= (le (ilen lc) nl) True)
