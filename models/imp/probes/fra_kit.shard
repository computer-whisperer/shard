           fp)
         (fp_mem
           mem0
           (fp_app
             (fe_tr fp nl 0 ce lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
             psx)))
       (ixt_expect
         (IqStmts b)
         (IpFailed fam)
         (MkRegs
           cv
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt (- c 1) g)
                 m
                 ic
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
