                              ((rewrite (premise hm2) lr lhs true ()))
                              refl))
                           refl))
                       (have hor
                         (=
                           (le
                             0
                             (bor
                               (bshr (band va (- (ikmod k) 1)) (mod vc (ikw k)))
                               (bshl
                                 (band va (- (ikmod k) 1))
                                 (mod (- (ikw k) (mod vc (ikw k))) (ikw k)))))
                           True)
                         (rewrite-with
                           (lemma bor_lo)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hsrl) lr lhs true ()))
                              refl)
                            (steps
                              ((rewrite (premise hsl) lr lhs true ()))
                              refl))
                           refl))
                       (chain
                         (have hv
                           (=
                             (Some
                               (band
                                 (bor
                                   (bshr
                                     (band va (- (ikmod k) 1))
                                     (mod vc (ikw k)))
                                   (bshl
                                     (band va (- (ikmod k) 1))
                                     (mod (- (ikw k) (mod vc (ikw k))) (ikw k))))
                                 (- (ikmod k) 1)))
                             (Some v))
                           (steps
                             ((rewrite (premise 0) rl rhs true ())
                              (unfold iexp rhs)
                              (reduce rhs)
                              (rewrite (premise hva) lr rhs true ())
                              (reduce rhs)
                              (rewrite (premise hvc) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (inject (premise hv) (hvv))
                         (steps ((rewrite (premise hvv) rl lhs true ())))
                         (rewrite-with
                           (lemma mask_inband)
                           lr
                           lhs
                           ()
                           ((steps
                              ((rewrite (premise hor) lr lhs true ()))
                              refl))
                           refl))))))))))))
     (case IExt
       (k1 k2 a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_ext)
             lr
             lhs
             ((inst k1 k1) (inst k2 k2))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (have hp (= (iexp a lc mem mlo msz) (Some v))
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold iexp rhs)
              (reduce rhs))
             refl))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ((inst lc lc)
            (inst mem mem)
            (inst mlo mlo)
            (inst msz msz)
            (inst fp fp)
            (inst psx psx))
           ((steps ((rewrite (premise hp) lr lhs true ())) refl)
            (steps ((rewrite (premise 1) lr lhs true ())) refl)
            (steps ((rewrite (premise hcb) lr lhs true ())) refl)))
         refl))
     (case ITrunc
       (k1 kt a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_trunc)
             lr
             lhs
             ((inst k1 k1) (inst kt kt))
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (case-on (iexp a lc mem mlo msz) Option
           ((case None
              (chain
                (have hva (= (iexp a lc mem mlo msz) None)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (chain
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn)))))
            (case Some
              (va)
              (chain
                (have hva (= (iexp a lc mem mlo msz) (Some va))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (have hba (= (fe_inband va) True)
                  (rewrite-with
                    (hyp ih)
                    lr
                    lhs
                    ((inst lc lc)
                     (inst mem mem)
                     (inst mlo mlo)
                     (inst msz msz)
                     (inst fp fp)
                     (inst psx psx))
                    ((steps ((rewrite (premise hva) lr lhs true ())) refl)
                     (steps ((rewrite (premise 1) lr lhs true ())) refl)
                     (steps ((rewrite (premise hcb) lr lhs true ())) refl))
                    refl))
                (have hal (= (le 0 va) True)
                  (rewrite-with
                    (lemma inband_lo)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hba) lr lhs true ())) refl))
                    refl))
                (chain
                  (have hv (= (Some (band va (- (ikmod kt) 1))) (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (inject (premise hv) (hvv))
                  (steps ((rewrite (premise hvv) rl lhs true ())))
                  (rewrite-with
                    (lemma mask_inband)
                    lr
                    lhs
                    ()
                    ((steps ((rewrite (premise hal) lr lhs true ())) refl))
                    refl))))))))
     (case ILoad
       (a)
       (chain
         (have hcb (= (ixf_cb a) True)
           (rewrite-with
             (lemma cb_load)
             lr
             lhs
             ()
             ((steps ((rewrite (premise 2) lr lhs true ())) refl))
             refl))
         (case-on (iexp a lc mem mlo msz) Option
           ((case None
              (chain
                (have hva (= (iexp a lc mem mlo msz) None)
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (chain
                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn)))))
            (case Some
              (va)
              (chain
                (have hva (= (iexp a lc mem mlo msz) (Some va))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (case-on (le mlo va) Bool
                  ((case False
                     (chain
                       (have hl0 (= (le mlo va) False)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (chain
                         (have hn (= None (Some v))
                           (steps
                             ((rewrite (premise 0) rl rhs true ())
                              (unfold iexp rhs)
                              (reduce rhs)
                              (rewrite (premise hva) lr rhs true ())
                              (reduce rhs)
                              (rewrite (premise hl0) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (absurd (premise hn)))))
                   (case True
                     (chain
                       (have hl0 (= (le mlo va) True)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (case-on (lt va msz) Bool
                         ((case False
                            (chain
                              (have hl1 (= (lt va msz) False)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hn (= None (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (absurd (premise hn)))))
                          (case True
                            (chain
                              (have hl1 (= (lt va msz) True)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hv (= (Some (mem_get mem va)) (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (inject (premise hv) (hvv))
                                (steps ((rewrite (premise hvv) rl lhs true ())))
                                (rewrite-with
                                  (lemma get_inband)
                                  lr
                                  lhs
                                  ()
                                  ()
                                  refl)))))))))))))))))))

;; ===================================================================================
;; A-2: THE EXPRESSION LEMMA — one STEP LEMMA per constructor, the sub-runs'
;; induction hypotheses as explicit premises, then the induction cites them
;; ===================================================================================

(fn andb ((a Bool) (b Bool)) Bool (if a b False))

(claim andb_l
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= a True))
  (case-on a Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= a False) (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold andb rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim andb_r
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= b True))
  (chain
    (have ha (= a True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b b))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (unfold andb rhs)
       (rewrite (premise ha) lr rhs true ())
       (reduce rhs))
      refl)))

;; THE CONTEXT of an expression run: the patch discipline, the locals
;; relation, the module's window = imp's lower bound, mlo ≤ slo ≤ fp, fp
;; 8-aligned to slo, the locals below the spill slots, d ≥ 0, slo ≥ 0, the
;; window inside 2^32 (P4's address policy)
(fn fe_ctx
  ((m XModule)
   (mlo Int)
   (slo Int)
   (fp Int)
   (nl Int)
   (d Int)
   (lc (List Int))
   (psx (List FPatch)))
  Bool
  (andb
    (fp_disc slo psx)
    (andb
      (fr_locs fp lc psx)
      (andb
        (int_eq (xmemlo_of m) mlo)
        (andb
          (le mlo slo)
          (andb
            (le slo fp)
            (andb
              (int_eq (mod (- fp slo) 8) 0)
              (andb
                (le (ilen lc) nl)
                (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296)))))))))))

(claim ctx_disc
  (goal
    ((m XModule)
     (mlo Int)
     (slo Int)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (psx (List FPatch)))
    ((= (fe_ctx m mlo slo fp nl d lc psx) True))
    (= (fp_disc slo psx) True))
  (chain
    (have h0
      (=
        (andb
          (fp_disc slo psx)
          (andb
            (fr_locs fp lc psx)
            (andb
              (int_eq (xmemlo_of m) mlo)
              (andb
                (le mlo slo)
                (andb
                  (le slo fp)
                  (andb
                    (int_eq (mod (- fp slo) 8) 0)
                    (andb
                      (le (ilen lc) nl)
                      (andb
                        (le 0 d)
                        (andb (le 0 slo) (le (xmemhi_of m) 4294967296))))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold fe_ctx rhs) (reduce rhs))
        refl))
    (rewrite-with
      (lemma andb_l)
      lr
      lhs
      ((inst
         b
         (andb
           (fr_locs fp lc psx)
           (andb
             (int_eq (xmemlo_of m) mlo)
             (andb
               (le mlo slo)
               (andb
                 (le slo fp)
                 (andb
                   (int_eq (mod (- fp slo) 8) 0)
                   (andb
                     (le (ilen lc) nl)
                     (andb
                       (le 0 d)
                       (andb (le 0 slo) (le (xmemhi_of m) 4294967296)))))))))))
      ((steps ((rewrite (premise h0) lr lhs true ())) refl)))
    refl))

