                          (reduce rhs)
                          (rewrite (premise hv) lr rhs true ())
                          (reduce rhs)
                          (rewrite (premise hvt) lr rhs true ())
                          (reduce rhs))
                         refl))
                     (absurd (premise hn))))
                 (case Some
                   (vt)
                   (chain
                     (have hvt (= (ipexps rest lc mem mlo msz) (Some vt))
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hs (= (Some (Cons v vt)) (Some vs))
