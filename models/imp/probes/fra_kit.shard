;; --- THE FRAME STORE: ixf_st i from a literal file --------------------------------------

;; [FP + 8i] := RAX, R10 := FP + 8i, everything else carried; the slot lies in
;; the window and below 2^64 (the address arithmetic never wraps)
(claim fe_st_run
  (goal
    ((i Int)
     (c Int)
     (g Nat)
     (m XModule)
     (xm Mem)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int))
    ((= (le 4 c) True)
     (= (le 0 i) True)
     (= (le 0 fp) True)
     (= (lt (+ (+ fp (* 8 i)) 8) 18446744073709551616) True)
     (= (le (xmemlo_of m) (+ fp (* 8 i))) True)
     (= (le (+ (+ fp (* 8 i)) 8) (xmemhi_of m)) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (ixf_st i)
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        xm)
      (Some
        (XNorm
          (MkRegs
            a0
            rcx
            dx
            rbx
            rbp
            rsi
            di
            r8
            r9
            (+ fp (* 8 i))
            s11
            r12
            r13
            dep
            fp)
          (store_le (xw8) xm (+ fp (* 8 i)) a0)))))
  (chain
    (have hl1 (= (le 0 (* 8 i)) True) (by arith (list 1 0 8 0 0 0 0)))
    (have hh1 (= (lt (* 8 i) 18446744073709551616) True)
      (by arith (list 1 0 0 1 1 0 0 0)))
    (have hl2 (= (le 0 (+ fp (* 8 i))) True)
      (by arith (list 1 0 8 1 0 0 0 0 0)))
    (have hh2 (= (lt (+ fp (* 8 i)) 18446744073709551616) True)
      (by arith (list 1 0 0 0 1 0 0 0 0 0)))
    (have hw1 (= (wrap64 (* 8 i)) (* 8 i))
      (chain
        (steps ((unfold wrap64 lhs)))
        (rewrite-with
          (lemma wrap64_id)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hl1) lr lhs true ())) refl)
           (steps ((rewrite (premise hh1) lr lhs true ())) refl)))
        refl))
    (have hw2 (= (wrap64 (+ fp (* 8 i))) (+ fp (* 8 i)))
      (chain
        (steps ((unfold wrap64 lhs)))
        (rewrite-with
          (lemma wrap64_id)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hl2) lr lhs true ())) refl)
           (steps ((rewrite (premise hh2) lr lhs true ())) refl)))
        refl))
    (rewrite-with
      (lemma xt_peel4)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop xt xw8 store_le wrap64 xmemlo_of xmemhi_of))
       (rewrite (premise hw1) lr lhs true ())
       (rewrite (premise hw2) lr lhs true ())
       (rewrite (premise 4) lr lhs true ())
       (rewrite (premise 5) lr lhs true ())
       (reduce lhs)
       (compute lhs (stop xt xw8 store_le wrap64 xmemlo_of xmemhi_of)))
      refl)))

(claim xt_peel8
  (goal ((c Int) (g Nat)) ((= (le 8 c) True))
    (= (xt c g) (S (S (S (S (S (S (S (S (xt (- c 8) g)))))))))))
  (chain
    (have h1 (= (le 4 c) True) (by arith (list 1 1)))
    (have h2 (= (le 4 (- c 4)) True) (by arith (list 1 1 0)))
    (have ha (= (- (- c 4) 4) (- c 8))
      (by arith (list (list 1 0 0 0) (list 1 0 0 0))))
    (rewrite-with
      (lemma xt_peel4)
      lr
      lhs
      ()
      ((steps ((rewrite (premise h1) lr lhs true ())) refl)))
    (rewrite-with
      (lemma xt_peel4)
      lr
      lhs
      ()
      ((steps ((rewrite (premise h2) lr lhs true ())) refl)))
    (steps ((rewrite (premise ha) lr lhs true ())) refl)))

