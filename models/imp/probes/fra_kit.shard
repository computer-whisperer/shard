                                 (ixf_spill nl 0)
                                 (ix_app
                                   iv
                                   (ix_app
                                     (ixf_reload10 nl 0)
                                     (list (XStore8 (AReg R10) (SReg RAX))))))))
                           (Some iss))
                         (steps
