;; a right shift of an in-band value by a nonnegative count
(claim shr_inband
  (goal ((a Int) (k Int)) ((= (fe_inband a) True) (= (le 0 k) True))
    (= (fe_inband (bshr a k)) True))
  (chain
    (have hal (= (le 0 a) True)
      (rewrite-with
        (lemma inband_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hpp (= (lt 0 (pow2 k)) True)
      (rewrite-with
        (lemma pow2_pos)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hp1 (= (le 1 (pow2 k)) True) (by arith (list 1 0 0 0 1)))
    (rewrite-with
      (lemma shr_pow2)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hal) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)))
    (rewrite-with
      (lemma ediv_inband)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise hp1) lr lhs true ())) refl)))
    refl))

;; a left shift of a nonnegative value by a nonnegative count stays nonnegative
(claim shl_nonneg
  (goal ((a Int) (k Int)) ((= (le 0 a) True) (= (le 0 k) True))
    (= (le 0 (bshl a k)) True))
  (chain
    (have hpp (= (lt 0 (pow2 k)) True)
      (rewrite-with
        (lemma pow2_pos)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have hp0 (= (le 0 (pow2 k)) True) (by arith (list 1 0 0 1)))
    (rewrite-with
      (lemma shl_pow2)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)))
    (rewrite-with
      (lemma mul_nonneg)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise hp0) lr lhs true ())) refl)))
    refl))

(claim ib2i_inband
  (goal ((b Bool)) () (= (fe_inband (ib2i b)) True))
  (case-on b Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
     (case False (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl)))))

(claim get_inband
  (goal ((m Mem) (a Int)) () (= (fe_inband (mem_get m a)) True))
  (chain
    (have hlo (= (le 0 (mem_get m a)) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hhi (= (lt (mem_get m a) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hh2 (= (lt (mem_get m a) 18446744073709551616) True)
      (by arith (list 1 0 1)))
    (rewrite-with
      (lemma inband_intro)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hlo) lr lhs true ())) refl)
       (steps ((rewrite (premise hh2) lr lhs true ())) refl)))
    refl))

;; --- the constants-in-band predicate at each constructor ----------------------------

(claim cb_const
  (goal ((n Int)) ((= (ixf_cb (IConst n)) True)) (= (fe_inband n) True))
  (steps
    ((unfold fe_inband lhs)
     (rewrite (premise 0) rl rhs true ())
     (unfold ixf_cb rhs)
     (reduce rhs))
    refl))

(claim cb_bin_a
  (goal ((k IKind) (o IOp) (a IExp) (b IExp)) ((= (ixf_cb (IBin k o a b)) True))
    (= (ixf_cb a) True))
  (case-on (ixf_cb a) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (ixf_cb a) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ixf_cb rhs)
              (reduce rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim cb_bin_b
  (goal ((k IKind) (o IOp) (a IExp) (b IExp)) ((= (ixf_cb (IBin k o a b)) True))
    (= (ixf_cb b) True))
  (chain
    (have ha (= (ixf_cb a) True)
      (rewrite-with
        (lemma cb_bin_a)
        lr
        lhs
        ((inst k k) (inst o o) (inst b b))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (unfold ixf_cb rhs)
       (reduce rhs)
       (rewrite (premise ha) lr rhs true ())
       (reduce rhs))
      refl)))

(claim cb_rotr_a
  (goal ((k IKind) (a IExp) (c IExp)) ((= (ixf_cb (IRotr k a c)) True))
    (= (ixf_cb a) True))
  (case-on (ixf_cb a) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= (ixf_cb a) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold ixf_cb rhs)
              (reduce rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim cb_ext
  (goal ((k1 IKind) (k2 IKind) (a IExp)) ((= (ixf_cb (IExt k1 k2 a)) True))
    (= (ixf_cb a) True))
  (steps
    ((rewrite (premise 0) rl rhs true ()) (unfold ixf_cb rhs) (reduce rhs))
