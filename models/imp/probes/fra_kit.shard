           (reduce lhs)
           (unfold xcont lhs)
           (reduce lhs)
           (rewrite (lemma rcx_of_mk) lr lhs true ())
           (rewrite (lemma rbx_of_mk) lr lhs true ())
           (rewrite (lemma rbp_of_mk) lr lhs true ())
           (rewrite (lemma rsi_of_mk) lr lhs true ())
           (rewrite (lemma rdi_of_mk) lr lhs true ())
           (rewrite (lemma r8_of_mk) lr lhs true ())
           (rewrite (lemma r9_of_mk) lr lhs true ())
           (rewrite (lemma r12_of_mk) lr lhs true ())
           (rewrite (lemma r13_of_mk) lr lhs true ())
           (rewrite (lemma r14_of_mk) lr lhs true ())
           (rewrite (lemma r15_of_mk) lr lhs true ())
           (unfold ixf_spill lhs)))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps
             ((rewrite (premise hxs) lr lhs true ())
              (rewrite (premise hsp3) lr lhs true ()))
             refl)))
        (steps ((rewrite (premise hxs) lr lhs true ())))
        (rewrite-with
          (lemma fe_st_run)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hsp4) lr lhs true ())) refl)
           (steps ((rewrite (premise hnd0) lr lhs true ())) refl)
           (steps ((rewrite (premise hfp0) lr lhs true ())) refl)
           (steps ((rewrite (premise hsm) lr lhs true ())) refl)
           (steps ((rewrite (premise hwlo) lr lhs true ())) refl)
           (steps ((rewrite (premise hwhi) lr lhs true ())) refl)))
        (steps
          ((rewrite (lemma fp_mem_cons_w) lr lhs true ())
           (unfold xcont lhs)
           (reduce lhs)))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hle3) lr lhs true ())) refl)))
        (steps
          ((rewrite (premise 11) lr lhs true ())
           (unfold fe_out lhs)
           (reduce lhs)
           (unfold xcont lhs)
           (reduce lhs)
           (rewrite (lemma rcx_of_mk) lr lhs true ())
           (rewrite (lemma rbx_of_mk) lr lhs true ())
           (rewrite (lemma rbp_of_mk) lr lhs true ())
           (rewrite (lemma rsi_of_mk) lr lhs true ())
           (rewrite (lemma rdi_of_mk) lr lhs true ())
           (rewrite (lemma r8_of_mk) lr lhs true ())
           (rewrite (lemma r9_of_mk) lr lhs true ())
           (rewrite (lemma r12_of_mk) lr lhs true ())
           (rewrite (lemma r13_of_mk) lr lhs true ())
           (rewrite (lemma r14_of_mk) lr lhs true ())
           (rewrite (lemma r15_of_mk) lr lhs true ())))
        (rewrite-with
          (lemma xseq_app)
          lr
          lhs
          ()
          ((steps
             ((rewrite (premise hxr) lr lhs true ())
              (rewrite (premise hrl3) lr lhs true ()))
             refl)))
        (steps ((rewrite (premise hxr) lr lhs true ())))
        (rewrite-with
          (lemma fe_rl_run)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hrl4) lr lhs true ())) refl)
           (steps ((rewrite (premise hnd0) lr lhs true ())) refl)
           (steps ((rewrite (premise hfp0) lr lhs true ())) refl)
           (steps ((rewrite (premise hsm) lr lhs true ())) refl)
           (steps ((rewrite (premise hwlo) lr lhs true ())) refl)
           (steps ((rewrite (premise hwhi) lr lhs true ())) refl)))
        (steps
          ((rewrite (premise hread) lr lhs true ())
           (unfold xcont lhs)
           (reduce lhs)))
        (rewrite-with
          (lemma fe_bop64_run)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hopn) lr lhs true ())) refl)))
        (steps
          ((compute
             lhs
             (stop xt xo_regs xeval_seq fp_mem fbelow fe_tr fp_app rdx_of r10_of
               r11_of xil xmemlo_of xmemhi_of)))
          refl)))
    (have hc2
      (=
        (fp_app
          (Cons
            (FWord (+ fp (* 8 (+ nl d))) va)
            (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo))
          psx)
        (Cons
          (FWord (+ fp (* 8 (+ nl d))) va)
          (fp_app
            (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
            psx)))
      (steps ((unfold fp_app lhs) (reduce lhs)) refl))
    (have hte
      (=
        (fe_tr
          fp
          nl
          d
          (IBin U64 IAnd a b)
          lc
          (fp_mem mem0 (fbelow slo psx))
          mlo
          slo)
        (fp_app
          (fe_tr fp nl (+ d 1) b lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
          (Cons
            (FWord (+ fp (* 8 (+ nl d))) va)
            (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo))))
      (steps
        ((unfold fe_tr lhs)
         (reduce lhs)
         (rewrite (premise 7) lr lhs true ())
         (reduce lhs))
        refl))
    (steps
      ((rewrite (premise hrun) lr both true ())
       (rewrite (premise hvv) rl rhs true ())

       (rewrite (lemma fe_out_of_norm) lr rhs true ())
       (rewrite (lemma rcx_of_mk) lr rhs true ())
       (rewrite (lemma rdx_of_mk) lr rhs true ())
       (rewrite (lemma rbx_of_mk) lr rhs true ())
       (rewrite (lemma rbp_of_mk) lr rhs true ())
       (rewrite (lemma rsi_of_mk) lr rhs true ())
       (rewrite (lemma rdi_of_mk) lr rhs true ())
       (rewrite (lemma r8_of_mk) lr rhs true ())
       (rewrite (lemma r9_of_mk) lr rhs true ())
       (rewrite (lemma r10_of_mk) lr rhs true ())
       (rewrite (lemma r11_of_mk) lr rhs true ())
       (rewrite (lemma r12_of_mk) lr rhs true ())
       (rewrite (lemma r13_of_mk) lr rhs true ())
       (rewrite (lemma r14_of_mk) lr rhs true ())
       (rewrite (lemma r15_of_mk) lr rhs true ())
       (rewrite (premise hte) lr rhs true ())
       (rewrite (lemma fp_app_assoc) lr rhs true ())
       (rewrite (premise hc2) lr rhs true ())
       (rewrite (premise hfb) lr lhs true ()))
      refl)))

(claim fe_step_or64
  (goal
    ((a IExp)
     (b IExp)
     (ia (List XInstr))
     (va Int)
     (ib (List XInstr))
     (vb Int)
     (nl Int)
     (d Int)
     (ie (List XInstr))
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (v Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d (IBin U64 IOr a b)) (Some ie))
     (=
       (iexp (IBin U64 IOr a b) lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
       (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb (IBin U64 IOr a b)) True)
     (=
       (le (+ fp (* 8 (+ nl (+ d (ixf_dep (IBin U64 IOr a b)))))) (xmemhi_of m))
       True)
     (= (le (ixf_ecost (IBin U64 IOr a b)) c) True)
     (= (ixf_exp nl d a) (Some ia))
     (= (iexp a lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some va))
     (=
       (xeval_seq
         (xt c g)
         m
         ia
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (fe_out
         va
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_seq
           (xt c g)
           m
           ia
           (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
           (fp_mem mem0 psx))
         (fp_mem
           mem0
           (fp_app
             (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
             psx))))
     (= (ixf_exp nl (+ d 1) b) (Some ib))
     (= (iexp b lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some vb))
     (=
       (xeval_seq
         (xt (- (- c (xil ia)) 3) g)
         m
         ib
         (MkRegs
           va
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
           rbp
           rsi
           di
           r8
           r9
           (+ fp (* 8 (+ nl d)))
           (r11_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           r12
           r13
           dep
           fp)
         (fp_mem
           mem0
           (Cons
             (FWord (+ fp (* 8 (+ nl d))) va)
             (fp_app
               (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
               psx))))
       (fe_out
         vb
         (MkRegs
           va
           rcx
           (rdx_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           rbx
           rbp
           rsi
           di
           r8
           r9
           (+ fp (* 8 (+ nl d)))
           (r11_of
             (xo_regs
               (xeval_seq
                 (xt c g)
                 m
                 ia
                 (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                 (fp_mem mem0 psx))))
           r12
           r13
           dep
           fp)
         (xeval_seq
           (xt (- (- c (xil ia)) 3) g)
           m
           ib
           (MkRegs
             va
             rcx
             (rdx_of
               (xo_regs
                 (xeval_seq
                   (xt c g)
                   m
                   ia
                   (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                   (fp_mem mem0 psx))))
             rbx
             rbp
             rsi
             di
             r8
             r9
             (+ fp (* 8 (+ nl d)))
             (r11_of
               (xo_regs
                 (xeval_seq
                   (xt c g)
                   m
                   ia
                   (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
                   (fp_mem mem0 psx))))
             r12
             r13
             dep
             fp)
           (fp_mem
             mem0
             (Cons
               (FWord (+ fp (* 8 (+ nl d))) va)
               (fp_app
                 (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                 psx))))
         (fp_mem
           mem0
           (fp_app
             (fe_tr
               fp
               nl
               (+ d 1)
               b
               lc
               (fp_mem
                 mem0
                 (fbelow
                   slo
                   (Cons
                     (FWord (+ fp (* 8 (+ nl d))) va)
                     (fp_app
                       (fe_tr
                         fp
                         nl
                         d
                         a
                         lc
                         (fp_mem mem0 (fbelow slo psx))
                         mlo
                         slo)
                       psx))))
               mlo
               slo)
             (Cons
               (FWord (+ fp (* 8 (+ nl d))) va)
               (fp_app
                 (fe_tr fp nl d a lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
                 psx)))))))
    (=
      (xeval_seq
        (xt c g)
        m
        ie
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (fe_out
        v
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          ie
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (fe_tr
              fp
              nl
              d
              (IBin U64 IOr a b)
              lc
              (fp_mem mem0 (fbelow slo psx))
              mlo
              slo)
            psx)))))
  (chain
    (have hsome
      (=
        (Some
          (ix_app
            ia
            (ix_app
              (ixf_spill nl d)
              (ix_app
                ib
                (ix_app
                  (ixf_reload10 nl d)
                  (list (XBin XOr R10 (SReg RAX)) (XMovRR RAX R10)))))))
        (Some ie))
      (steps
        ((rewrite (premise 0) rl rhs true ())
         (unfold ixf_exp rhs)
         (reduce rhs)
         (rewrite (premise 6) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 9) lr rhs true ())
         (reduce rhs)
         (unfold ixf_bop rhs)
         (reduce rhs))
        refl))
    (inject (premise hsome) (hie))
    (have hop (= (iop_val U64 IOr va vb) (Some v))
      (steps
        ((rewrite (premise 1) rl rhs true ())
         (unfold iexp rhs)
         (reduce rhs)
         (rewrite (premise 7) lr rhs true ())
         (reduce rhs)
         (rewrite (premise 10) lr rhs true ())
         (reduce rhs))
        refl))
    (have hv (= (Some (bor va vb)) (Some v))
      (steps
        ((rewrite (premise hop) rl rhs true ())
         (unfold iop_val rhs)
         (reduce rhs))
        refl))
    (inject (premise hv) (hvv))
    (have hdisc (= (fp_disc slo psx) True)
      (rewrite-with
        (lemma ctx_disc)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hlocs (= (fr_locs fp lc psx) True)
      (rewrite-with
        (lemma ctx_locs)
        lr
        lhs
        ((inst m m) (inst mlo mlo) (inst slo slo) (inst nl nl) (inst d d))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hxlo (= (int_eq (xmemlo_of m) mlo) True)
      (rewrite-with
        (lemma ctx_lo)
        lr
        lhs
        ((inst slo slo)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hmlo (= (le mlo slo) True)
      (rewrite-with
        (lemma ctx_mlo)
        lr
        lhs
        ((inst m m)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hslo (= (le slo fp) True)
      (rewrite-with
        (lemma ctx_slo)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hal (= (int_eq (mod (- fp slo) 8) 0) True)
      (rewrite-with
        (lemma ctx_al)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hnl (= (le (ilen lc) nl) True)
      (rewrite-with
        (lemma ctx_nl)
        lr
        lhs
        ((inst m m)
         (inst mlo mlo)
         (inst slo slo)
         (inst fp fp)
