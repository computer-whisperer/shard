     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_stmt nl own fail_ix (IpIf ce tb eb)) (Some is))
     (= (ixf_exp nl 0 ce) (Some ic))
     (= (ixf_stmts nl own fail_ix tb) (Some itb))
     (= (ixf_stmts nl own fail_ix eb) (Some ieb))
     (=
       (ipstmt
         (S f)
         fs
         mlo
         slo
         dmax
         dep
         (IpIf ce tb eb)
         lc
         (fp_mem mem0 (fbelow slo psx)))
       (Some out))
     (= (iexp ce lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some cv))
     (= (int_eq cv 0) False)
     (= (le (+ (xil ic) 6) c) True)
     (=
       (xeval_seq
         (xt c g)
         m
