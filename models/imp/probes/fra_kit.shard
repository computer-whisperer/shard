;; --- the assembly's two helpers ---------------------------------------------------------

(claim imax2_ge_r
  (goal ((a Int) (b Int)) () (= (le b (imax2 a b)) True))
  (case-on (lt a b) Bool
    ((case True
       (chain
         (have h (= (lt a b) True)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (steps
           ((unfold imax2 lhs)
            (rewrite (premise h) lr lhs true ())
            (reduce lhs))
           (by arith (list 1 0)))))
     (case False
       (chain
         (have h (= (lt a b) False)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (steps
           ((unfold imax2 lhs)
            (rewrite (premise h) lr lhs true ())
            (reduce lhs))
           (by arith (list 1 1))))))))

;; the context from its ten facts
(claim ctx_intro
  (goal
    ((m XModule)
     (mlo Int)
     (slo Int)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (psx (List FPatch)))
    ((= (fp_disc slo psx) True)
     (= (fr_locs fp lc psx) True)
     (= (int_eq (xmemlo_of m) mlo) True)
     (= (le mlo slo) True)
     (= (le slo fp) True)
     (= (int_eq (mod (- fp slo) 8) 0) True)
     (= (le (ilen lc) nl) True)
     (= (le 0 d) True)
     (= (le 0 slo) True)
     (= (le (xmemhi_of m) 4294967296) True))
    (= (fe_ctx m mlo slo fp nl d lc psx) True))
  (steps
    ((unfold fe_ctx lhs)
     (rewrite (premise 0) lr lhs true ())
     (rewrite (premise 1) lr lhs true ())
     (rewrite (premise 2) lr lhs true ())
     (rewrite (premise 3) lr lhs true ())
     (rewrite (premise 4) lr lhs true ())
     (rewrite (premise 5) lr lhs true ())
     (rewrite (premise 6) lr lhs true ())
     (rewrite (premise 7) lr lhs true ())
     (rewrite (premise 8) lr lhs true ())
     (rewrite (premise 9) lr lhs true ())
     (compute lhs))
    refl))

;; THE EXPRESSION LEMMA (generated by gen_fra.py fe_sound — REGENERATE, never hand-patch):
;; every accepted expression's emission simulates imp's value, at any tower at or
;; above its cost, leaving RAX = the value, the frame's locals intact, the spill
;; trace as the twin says, and the scratch as the run's own
(claim fe_sound
  (goal
    ((e IExp)
     (nl Int)
     (d Int)
     (ie (List XInstr))
     (lc (List Int))
     (mem0 Mem)
     (psx (List FPatch))
     (mlo Int)
     (slo Int)
     (v Int)
     (c Int)
     (g Nat)
     (m XModule)
     (fp Int)
     (dep Int)
     (a0 Int)
     (rcx Int)
     (dx Int)
     (rbx Int)
     (rbp Int)
     (rsi Int)
     (di Int)
     (r8 Int)
     (r9 Int)
     (s10 Int)
     (s11 Int)
     (r12 Int)
     (r13 Int))
    ((= (ixf_exp nl d e) (Some ie))
     (= (iexp e lc (fp_mem mem0 (fbelow slo psx)) mlo slo) (Some v))
     (= (fe_ctx m mlo slo fp nl d lc psx) True)
     (= (ixf_cb e) True)
     (= (le (+ fp (* 8 (+ nl (+ d (ixf_dep e))))) (xmemhi_of m)) True)
     (= (le (ixf_ecost e) c) True))
    (=
      (xeval_seq
        (xt c g)
        m
        ie
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (fe_out
        v
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (xeval_seq
          (xt c g)
          m
          ie
          (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
          (fp_mem mem0 psx))
        (fp_mem
          mem0
          (fp_app
            (fe_tr fp nl d e lc (fp_mem mem0 (fbelow slo psx)) mlo slo)
            psx)))))
  (induct e
    ((case IConst
       (n)
       (rewrite-with
         (lemma fe_step_const)
         lr
         lhs
         ((inst n n)
          (inst nl nl)
          (inst d d)
          (inst lc lc)
          (inst mlo mlo)
          (inst slo slo)
          (inst v v))
         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
          (steps ((rewrite (premise 1) lr lhs true ())) refl)
          (steps ((rewrite (premise 2) lr lhs true ())) refl)
          (steps ((rewrite (premise 3) lr lhs true ())) refl)
          (steps ((rewrite (premise 4) lr lhs true ())) refl)
          (steps ((rewrite (premise 5) lr lhs true ())) refl))
         refl))
     (case ILoc
       (i)
       (rewrite-with
         (lemma fe_step_loc)
         lr
         lhs
         ((inst i i)
          (inst nl nl)
          (inst d d)
          (inst lc lc)
          (inst mlo mlo)
          (inst slo slo)
          (inst v v))
         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
          (steps ((rewrite (premise 1) lr lhs true ())) refl)
          (steps ((rewrite (premise 2) lr lhs true ())) refl)
          (steps ((rewrite (premise 3) lr lhs true ())) refl)
          (steps ((rewrite (premise 4) lr lhs true ())) refl)
          (steps ((rewrite (premise 5) lr lhs true ())) refl))
         refl))
     (case IBin
       (k o a b)
       (case-on o IOp
         ((case IAdd
            (chain
              (have ho (= o IAdd)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (steps ((rewrite (premise ho) lr both true ())))
              (case-on k IKind
                ((case U8
                   (chain
                     (have hk (= k U8)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (have hp0 (= (ixf_exp nl d (IBin U8 IAdd a b)) (Some ie))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise ho) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (case-on (ixf_exp nl d a) Option
                       ((case None
                          (chain
                            (have ha (= (ixf_exp nl d a) None)
                              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            (chain
                              (have hn (= None (Some ie))
                                (steps
                                  ((rewrite (premise hp0) rl rhs true ())
                                   (unfold ixf_exp rhs)
                                   (reduce rhs)
                                   (rewrite (premise ha) lr rhs true ())
                                   (reduce rhs))
                                  refl))
                              (absurd (premise hn)))))
                        (case Some
                          (ia)
                          (chain
                            (have ha (= (ixf_exp nl d a) (Some ia))
                              (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                            (case-on (ixf_exp nl (+ d 1) b) Option
                              ((case None
                                 (chain
                                   (have hb (= (ixf_exp nl (+ d 1) b) None)
                                     (steps
                                       ((rewrite (hyp 0) lr lhs true ()))
                                       refl))
                                   (chain
                                     (have hn (= None (Some ie))
                                       (steps
                                         ((rewrite (premise hp0) rl rhs true ())
                                          (unfold ixf_exp rhs)
                                          (reduce rhs)
                                          (rewrite (premise ha) lr rhs true ())
                                          (reduce rhs)
                                          (rewrite (premise hb) lr rhs true ())
                                          (reduce rhs))
                                         refl))
                                     (absurd (premise hn)))))
                               (case Some
                                 (ib)
                                 (chain
                                   (have hb (= (ixf_exp nl (+ d 1) b) (Some ib))
                                     (steps
                                       ((rewrite (hyp 0) lr lhs true ()))
                                       refl))
                                   (chain
                                     (have hn (= None (Some ie))
                                       (steps
                                         ((rewrite (premise hp0) rl rhs true ())
                                          (unfold ixf_exp rhs)
                                          (reduce rhs)
                                          (rewrite (premise ha) lr rhs true ())
                                          (reduce rhs)
                                          (rewrite (premise hb) lr rhs true ())
                                          (reduce rhs)
                                          (unfold ixf_bop rhs)
                                          (reduce rhs))
                                         refl))
                                     (absurd (premise hn)))))))))))))
                 (case U32
                   (chain
                     (have hk (= k U32)
                       (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                     (steps ((rewrite (premise hk) lr both true ())))
                     (have hp0 (= (ixf_exp nl d (IBin U32 IAdd a b)) (Some ie))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise ho) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hp1
                       (=
                         (iexp
                           (IBin U32 IAdd a b)
                           lc
                           (fp_mem mem0 (fbelow slo psx))
                           mlo
                           slo)
                         (Some v))
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise ho) rl lhs true ())
                          (rewrite (premise 1) lr lhs true ()))
                         refl))
                     (have hp3 (= (ixf_cb (IBin U32 IAdd a b)) True)
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise ho) rl lhs true ())
                          (rewrite (premise 3) lr lhs true ()))
                         refl))
                     (have hp4
                       (=
                         (le
                           (+
                             fp
                             (* 8 (+ nl (+ d (ixf_dep (IBin U32 IAdd a b))))))
                           (xmemhi_of m))
                         True)
                       (steps
                         ((rewrite (premise hk) rl lhs true ())
                          (rewrite (premise ho) rl lhs true ())
                          (rewrite (premise 4) lr lhs true ()))
                         refl))
