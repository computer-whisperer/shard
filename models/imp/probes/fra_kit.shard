            (MkRegs
              (band va vb)
              rcx
              (rdx_of
                (xo_regs
                  (xeval_seq
                    (xt (- (- c (xil ia)) 3) g)
                    m
                    ib
                    (MkRegs
                      va
                      rcx
                      (rdx_of
                        (xo_regs
                          (xeval_seq
                            (xt c g)
                            m
                            ia
                            (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12
                              r13 dep fp)
                            (fp_mem mem0 psx))))
                      rbx
                      rbp
                      rsi
                      di
                      r8
                      r9
                      (+ fp (* 8 (+ nl d)))
                      (r11_of
                        (xo_regs
                          (xeval_seq
                            (xt c g)
                            m
                            ia
                            (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12
                              r13 dep fp)
