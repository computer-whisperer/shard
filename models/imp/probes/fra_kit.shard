     (= (ixf_exp nl 0 ce) (Some ic))
     (= (ixf_stmts nl own fail_ix b) (Some ib))
     (=
       (ipstmt
         (S f)
         fs
         mlo
         slo
         dmax
         dep
         (IpWhile ce b)
         lc
         (fp_mem mem0 (fbelow slo psx)))
       (Some out))
     (= (le 4 c) True)
     (=
       (xeval_loop
         (xt (- c 4) g)
         m
         (ix_app
           ic
           (Cons (XBrIf (CEqz RAX) 1) (Cons (XBlock ib) (Cons (XBr 0) Nil))))
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (fp_mem mem0 psx))
       (ixt_expect
         (IqWhile ce b)
         out
         (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
         (xeval_loop
           (xt (- c 4) g)
