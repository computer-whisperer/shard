                  (have hn (= None (Some v))
                    (steps
                      ((rewrite (premise 0) rl rhs true ())
                       (unfold iexp rhs)
                       (reduce rhs)
                       (rewrite (premise hva) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn)))))
            (case Some
              (va)
              (chain
                (have hva (= (iexp a lc mem mlo msz) (Some va))
                  (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                (case-on (le mlo va) Bool
                  ((case False
                     (chain
                       (have hl0 (= (le mlo va) False)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (chain
                         (have hn (= None (Some v))
                           (steps
                             ((rewrite (premise 0) rl rhs true ())
                              (unfold iexp rhs)
                              (reduce rhs)
                              (rewrite (premise hva) lr rhs true ())
                              (reduce rhs)
                              (rewrite (premise hl0) lr rhs true ())
                              (reduce rhs))
                             refl))
                         (absurd (premise hn)))))
                   (case True
                     (chain
                       (have hl0 (= (le mlo va) True)
                         (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                       (case-on (lt va msz) Bool
                         ((case False
                            (chain
                              (have hl1 (= (lt va msz) False)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hn (= None (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (absurd (premise hn)))))
                          (case True
                            (chain
                              (have hl1 (= (lt va msz) True)
                                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                              (chain
                                (have hv (= (Some (mem_get mem va)) (Some v))
                                  (steps
                                    ((rewrite (premise 0) rl rhs true ())
                                     (unfold iexp rhs)
                                     (reduce rhs)
                                     (rewrite (premise hva) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl0) lr rhs true ())
                                     (reduce rhs)
                                     (rewrite (premise hl1) lr rhs true ())
                                     (reduce rhs))
                                    refl))
                                (inject (premise hv) (hvv))
                                (steps ((rewrite (premise hvv) rl lhs true ())))
                                (rewrite-with
                                  (lemma get_inband)
                                  lr
                                  lhs
                                  ()
                                  ()
                                  refl)))))))))))))))))))

;; ===================================================================================
;; A-2: THE EXPRESSION LEMMA — one STEP LEMMA per constructor, the sub-runs'
;; induction hypotheses as explicit premises, then the induction cites them
;; ===================================================================================

(fn andb ((a Bool) (b Bool)) Bool (if a b False))

(claim andb_l
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= a True))
  (case-on a Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hf (= a False) (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hff (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold andb rhs)
              (rewrite (premise hf) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hff)))))))

(claim andb_r
  (goal ((a Bool) (b Bool)) ((= (andb a b) True)) (= b True))
  (chain
    (have ha (= a True)
      (rewrite-with
        (lemma andb_l)
        lr
        lhs
        ((inst b b))
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps
      ((rewrite (premise 0) rl rhs true ())
       (unfold andb rhs)
       (rewrite (premise ha) lr rhs true ())
       (reduce rhs))
      refl)))

;; THE CONTEXT of an expression run: the patch discipline, the locals
;; relation, the module's window = imp's lower bound, mlo ≤ slo ≤ fp, fp
;; 8-aligned to slo, the locals below the spill slots, d ≥ 0, slo ≥ 0, the
;; window inside 2^32 (P4's address policy)
(fn fe_ctx
  ((m XModule)
   (mlo Int)
   (slo Int)
   (fp Int)
   (nl Int)
   (d Int)
   (lc (List Int))
   (psx (List FPatch)))
  Bool
  (andb
    (fp_disc slo psx)
    (andb
      (fr_locs fp lc psx)
      (andb
        (int_eq (xmemlo_of m) mlo)
        (andb
          (le mlo slo)
          (andb
            (le slo fp)
            (andb
              (int_eq (mod (- fp slo) 8) 0)
              (andb
                (le (ilen lc) nl)
                (andb (le 0 d) (andb (le 0 slo) (le (xmemhi_of m) 4294967296)))))))))))

(claim ctx_disc
  (goal
    ((m XModule)
     (mlo Int)
     (slo Int)
     (fp Int)
     (nl Int)
     (d Int)
     (lc (List Int))
     (psx (List FPatch)))
    ((= (fe_ctx m mlo slo fp nl d lc psx) True))
    (= (fp_disc slo psx) True))
  (chain
    (have h0
      (=
        (andb
          (fp_disc slo psx)
          (andb
            (fr_locs fp lc psx)
            (andb
              (int_eq (xmemlo_of m) mlo)
              (andb
                (le mlo slo)
                (andb
                  (le slo fp)
                  (andb
                    (int_eq (mod (- fp slo) 8) 0)
                    (andb
                      (le (ilen lc) nl)
                      (andb
                        (le 0 d)
                        (andb (le 0 slo) (le (xmemhi_of m) 4294967296))))))))))
        True)
      (steps
        ((rewrite (premise 0) rl rhs true ()) (unfold fe_ctx rhs) (reduce rhs))
        refl))
    (rewrite-with
      (lemma andb_l)
      lr
      lhs
      ((inst
         b
         (andb
           (fr_locs fp lc psx)
           (andb
             (int_eq (xmemlo_of m) mlo)
             (andb
               (le mlo slo)
               (andb
                 (le slo fp)
                 (andb
                   (int_eq (mod (- fp slo) 8) 0)
                   (andb
                     (le (ilen lc) nl)
                     (andb
                       (le 0 d)
                       (andb (le 0 slo) (le (xmemhi_of m) 4294967296)))))))))))
      ((steps ((rewrite (premise h0) lr lhs true ())) refl)))
    refl))

