         (inst mlo mlo)
         (inst fp fp)
         (inst nl nl)
         (inst d d)
         (inst lc lc)
         (inst psx psx))
        ((steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hhi (= (le (xmemhi_of m) 4294967296) True)
      (rewrite-with
        (lemma ctx_hi)
        lr
        lhs
