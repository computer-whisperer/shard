                       (reduce rhs)
                       (rewrite (premise 7) lr rhs true ())
                       (reduce rhs)
                       (rewrite (premise hl0) lr rhs true ())
                       (reduce rhs)
                       (rewrite (premise hl1) lr rhs true ())
                       (reduce rhs))
                      refl))
                  (absurd (premise hn))))
              (case True
