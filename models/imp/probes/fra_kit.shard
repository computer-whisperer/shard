            (bor
              (bshr (band va (- (ikmod U32) 1)) (mod cc (ikw U32)))
              (bshl
                (band va (- (ikmod U32) 1))
                (mod (- (ikw U32) (mod cc (ikw U32))) (ikw U32))))
            (- (ikmod U32) 1)))
        (Some v))
      (steps
        ((rewrite (premise 1) rl rhs true ())
         (unfold iexp rhs)
         (reduce rhs)
         (rewrite (premise 7) lr rhs true ())
         (reduce rhs)
         (unfold iexp rhs)
         (reduce rhs))
