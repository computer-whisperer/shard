                         slo
                         dmax
                         dep
                         fp
                         nl
                         own
                         s
                         lc
                         (fp_mem mem0 (fbelow slo psx)))
                       psx)))))
             (steps
               ((rewrite (premise 8) lr lhs true ())
                (rewrite (premise ho) lr lhs true ())
                (unfold ixt_expect lhs)
                (reduce lhs)
                (rewrite (premise hmemt) lr lhs true ()))
               refl))
           (steps
             ((rewrite (premise ho) lr rhs true ())
              (unfold ixt_expect rhs)
              (reduce rhs)
              (rewrite (premise h8) lr lhs true ())
              (unfold fs_out both)
              (reduce both)
              (rewrite (lemma rcx_of_mk) lr both true ())
              (rewrite (lemma rbx_of_mk) lr both true ())
              (rewrite (lemma rbp_of_mk) lr both true ())
              (rewrite (lemma rsi_of_mk) lr both true ())
              (rewrite (lemma rdi_of_mk) lr both true ())
              (rewrite (lemma r8_of_mk) lr both true ())
