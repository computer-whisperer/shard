     (s11 Int)
     (r12 Int)
     (r13 Int)
     (dep Int)
     (fp Int)
     (nl Int))
    ((= (le (+ (* 4 (- nl from)) 1) c) True)
     (= (le from nl) True)
     (= (le 0 from) True)
     (= (le 0 fp) True)
     (= (le (xmemlo_of m) fp) True)
     (= (le (+ fp (* 8 nl)) (xmemhi_of m)) True)
     (= (le (xmemhi_of m) 4294967296) True))
    (=
      (xeval_seq
        (xt c g)
        m
        (ixf_zero from nl)
        (MkRegs a0 rcx dx rbx rbp rsi di r8 r9 s10 s11 r12 r13 dep fp)
        (fp_mem mem0 psx))
      (fs_out
