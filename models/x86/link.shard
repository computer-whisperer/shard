                                 (inst fs fs)
                                 (inst ext ext)
                                 (inst lo lo)
                                 (inst hi hi))
                                ((steps
                                   ((rewrite (premise 0) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 1) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise hcb) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 3) lr lhs true ()))
                                   refl))
                                refl))
                            (have heng
                              (=
                                (wveval_seq f2 m2 (xbody_of f) rs xs mem w)
                                (wveval_seq f2 m1 (xbody_of f) rs xs mem w))
                              (chain
                                (have ha2
                                  (=
