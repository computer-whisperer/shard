                               (xlk_shq d (XQI (XBin a1 a2 a3)))
                               rs
                               xs
                               mem)
                             (xveval_instr (S f2) m2 (XBin a1 a2 a3) rs xs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlk_shi lhs)
                              (reduce lhs)
                              (unfold xlq_xv lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
