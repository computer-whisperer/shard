;; --- local list plumbing (transparent; std/list is opaque in check mode) -----

(fn xlk_app ((xs (List XFunc)) (ys (List XFunc))) (List XFunc)
  (measure (struct xs))
  (match xs
    (Nil ys)
    ((Cons h t) (Cons h (xlk_app t ys)))))

(fn xlk_len ((xs (List XFunc))) Int
  (measure (struct xs))
  (match xs
    (Nil 0)
    ((Cons h t) (+ 1 (xlk_len t)))))

;; --- the calls-resolve predicate ---------------------------------------------
;; xlk_isf: the lookup discriminator. xlk_cbi/cbl: every call the code makes
;; resolves in fs (mutual STRUCTURAL recursion — the xsz_i/xsz_seq precedent).

(fn xlk_isf ((o (Option XFunc))) Bool
  (match o
    (None False)
    ((Some f) True)))

(fn xlk_cbi ((fs (List XFunc)) (i XInstr)) Bool
  (measure (struct i))
  (match i
    ((XBlock body) (xlk_cbl fs body))
    ((XLoop body) (xlk_cbl fs body))
    ((XCall k) (xlk_isf (xfunc_at fs k)))
    (other True)))

(fn xlk_cbl ((fs (List XFunc)) (is (List XInstr))) Bool
  (measure (struct is))
  (match is
    (Nil True)
    ((Cons i rest) (if (xlk_cbi fs i) (xlk_cbl fs rest) False))))

(fn xlk_cbf ((fs (List XFunc)) (f XFunc)) Bool (xlk_cbl fs (xbody_of f)))

(fn xlk_cbfns ((fs (List XFunc)) (gs (List XFunc))) Bool
  (measure (struct gs))
  (match gs
    (Nil True)
    ((Cons g rest) (if (xlk_cbf fs g) (xlk_cbfns fs rest) False))))

(fn xlk_cbq ((fs (List XFunc)) (q XQ)) Bool
  (match q
    ((XQI i) (xlk_cbi fs i))
    ((XQC k) (xlk_isf (xfunc_at fs k)))
    ((XQB body) (xlk_cbl fs body))
    ((XQS is2) (xlk_cbl fs is2))))

;; --- the shifter: (XCall k) → (XCall (k+d)), uniformly ------------------------

(fn xlk_shi ((d Int) (i XInstr)) XInstr
  (measure (struct i))
  (match i
    ((XCall k) (XCall (+ k d)))
    ((XBlock body) (XBlock (xlk_shl d body)))
    ((XLoop body) (XLoop (xlk_shl d body)))
    (other other)))

(fn xlk_shl ((d Int) (is (List XInstr))) (List XInstr)
  (measure (struct is))
  (match is
    (Nil Nil)
    ((Cons i rest) (Cons (xlk_shi d i) (xlk_shl d rest)))))

(fn xlk_shf ((d Int) (f XFunc)) XFunc
  (match f
    ((MkXFunc p body) (MkXFunc p (xlk_shl d body)))))

(fn xlk_shfns ((d Int) (gs (List XFunc))) (List XFunc)
  (measure (struct gs))
  (match gs
    (Nil Nil)
    ((Cons g rest) (Cons (xlk_shf d g) (xlk_shfns d rest)))))

(fn xlk_shq ((d Int) (q XQ)) XQ
  (match q
    ((XQI i) (XQI (xlk_shi d i)))
    ((XQC k) (XQC (+ k d)))
    ((XQB body) (XQB (xlk_shl d body)))
    ((XQS is2) (XQS (xlk_shl d is2)))))

;; --- list lemmas -------------------------------------------------------------

;; 0 <= xlk_len xs (feeds the prefix-skip farkas steps).
(claim xlk_len_nonneg
  (goal ((xs (List XFunc))) () (= (le 0 (xlk_len xs)) True))
  (induct xs
    ((case Nil (steps ((compute lhs)) refl))
     (case Cons
       (h t)
       (chain
         (have hih (= (le 0 (xlk_len t)) True)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl))
         (have hlc (= (xlk_len (Cons h t)) (+ 1 (xlk_len t)))
           (steps ((unfold xlk_len lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hlc) lr lhs true ())))
         (by arith (list 1 1 0)))))))

;; Shifted-family lookup: looking up in the shifted family answers the shifted
;; function, position by position. Unconditional (out-of-range and negative
;; indices answer None on both sides).
(claim xlk_at_sh
  (goal ((d Int) (gs (List XFunc)) (k Int)) ()
    (=
      (xfunc_at (xlk_shfns d gs) k)
      (match (xfunc_at gs k)
        (None None)
        ((Some f) (Some (xlk_shf d f))))))
  (induct gs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (g t)
       (case-on (int_eq k 0) Bool
         ((case True
            (steps
              ((compute both (stop xlk_shf))
               (rewrite (hyp 0) lr both true ())
               (compute both (stop xlk_shf)))
              refl))
          (case False
            (chain
              (steps
                ((unfold xlk_shfns lhs)
                 (reduce lhs)
                 (unfold xfunc_at lhs)
                 (reduce lhs)
                 (rewrite (hyp 0) lr lhs true ())
                 (reduce lhs)
                 (unfold xfunc_at rhs)
                 (reduce rhs)
                 (rewrite (hyp 0) lr rhs true ())
                 (reduce rhs)))
              (rewrite-with (hyp 1) lr lhs () ())
              refl))))))))

;; Resolution implies a nonnegative index (xfunc_at only counts DOWN — a
;; negative index recurses to Nil and answers None).
(claim xlk_at_nonneg
  (goal ((gs (List XFunc)) (k Int)) ((= (xlk_isf (xfunc_at gs k)) True))
    (= (le 0 k) True))
  (induct gs
    ((case Nil
       (chain
         (have hx (= False True)
           (steps ((rewrite (premise 0) rl rhs true ()) (compute rhs)) refl))
         (absurd (premise hx))))
     (case Cons
       (g t)
       (case-on (int_eq k 0) Bool
         ((case True
            (chain
              (have hk (= (int_eq k 0) True)
                (steps ((rewrite (hyp 0) lr lhs true ())) refl))
              (by arith (list 1 0 1))))
          (case False
            (chain
              (have hpre (= (xlk_isf (xfunc_at t (- k 1))) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold xfunc_at rhs)
                   (reduce rhs)
                   (rewrite (hyp 0) lr rhs true ())
                   (reduce rhs))
                  refl))
              (have hih (= (le 0 (- k 1)) True)
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hpre) lr lhs true ())) refl))
                  refl))
              (by arith (list 1 0 0 1))))))))))

;; Prefix-preservation: a resolving lookup ignores appended functions.
(claim xlk_at_app
  (goal ((gs (List XFunc)) (ext (List XFunc)) (k Int))
    ((= (xlk_isf (xfunc_at gs k)) True))
    (= (xfunc_at (xlk_app gs ext) k) (xfunc_at gs k)))
  (induct gs
    ((case Nil
       (chain
         (have hx (= False True)
           (steps ((rewrite (premise 0) rl rhs true ()) (compute rhs)) refl))
         (absurd (premise hx))))
     (case Cons
       (g t)
       (case-on (int_eq k 0) Bool
         ((case True
            (steps
              ((compute both) (rewrite (hyp 0) lr both true ()) (compute both))
              refl))
          (case False
            (chain
              (have hpre (= (xlk_isf (xfunc_at t (- k 1))) True)
                (steps
                  ((rewrite (premise 0) rl rhs true ())
                   (unfold xfunc_at rhs)
                   (reduce rhs)
                   (rewrite (hyp 0) lr rhs true ())
                   (reduce rhs))
                  refl))
              (steps
                ((unfold xlk_app lhs)
                 (reduce lhs)
                 (unfold xfunc_at lhs)
                 (reduce lhs)
                 (rewrite (hyp 0) lr lhs true ())
                 (reduce lhs)
                 (unfold xfunc_at rhs)
                 (reduce rhs)
                 (rewrite (hyp 0) lr rhs true ())
                 (reduce rhs)))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hpre) lr lhs true ())) refl)))
              refl))))))))

;; Prefix-skip: indexing past a prefix lands in the suffix (the SHIFT layout's
;; placement fact). The one genuinely arithmetic lemma (farkas).
(claim xlk_at_skip
  (goal ((pre (List XFunc)) (rest (List XFunc)) (k Int)) ((= (le 0 k) True))
    (= (xfunc_at (xlk_app pre rest) (+ (xlk_len pre) k)) (xfunc_at rest k)))
  (induct pre
    ((case Nil
       (chain
         (have hl0 (= (xlk_len Nil) 0) (steps ((compute lhs)) refl))
         (have hk (= (+ 0 k) k) (by arith (list (list 1 0 0) (list 1 0 0))))
         (steps
           ((rewrite (premise hl0) lr lhs true ())
            (rewrite (premise hk) lr lhs true ())
            (compute both))
           refl)))
     (case Cons
       (p pt)
       (chain
         (have hlc (= (xlk_len (Cons p pt)) (+ 1 (xlk_len pt)))
           (steps ((unfold xlk_len lhs) (reduce lhs)) refl))
         (have hln (= (le 0 (xlk_len pt)) True)
           (rewrite-with (lemma xlk_len_nonneg) lr lhs () () refl))
         (steps
           ((rewrite (premise hlc) lr lhs true ())
            (unfold xlk_app lhs)
            (reduce lhs)
            (unfold xfunc_at lhs)
            (reduce lhs)))
         (have hne (= (int_eq (+ (+ 1 (xlk_len pt)) k) 0) False)
           (by arith (list -1 1 0 1)))
         (steps ((rewrite (premise hne) lr lhs true ()) (reduce lhs)))
         (have hidx (= (- (+ (+ 1 (xlk_len pt)) k) 1) (+ (xlk_len pt) k))
           (by arith (list (list 1 0 0 0 0) (list 1 0 0 0 0))))
         (steps ((rewrite (premise hidx) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
         refl)))))

;; --- calls-resolve splitting lemmas ------------------------------------------

;; Head of a resolving sequence resolves.
(claim xlk_cbl_head
  (goal ((fs (List XFunc)) (i XInstr) (rest (List XInstr)))
    ((= (xlk_cbl fs (Cons i rest)) True))
    (= (xlk_cbi fs i) True))
  (case-on (xlk_cbi fs i) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (chain
         (have hx (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold xlk_cbl rhs)
              (reduce rhs)
              (rewrite (hyp 0) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hx)))))))

;; Tail of a resolving sequence resolves.
(claim xlk_cbl_tail
  (goal ((fs (List XFunc)) (i XInstr) (rest (List XInstr)))
    ((= (xlk_cbl fs (Cons i rest)) True))
    (= (xlk_cbl fs rest) True))
  (case-on (xlk_cbi fs i) Bool
    ((case True
       (steps
         ((rewrite (premise 0) rl rhs true ())
          (unfold xlk_cbl rhs)
          (reduce rhs)
          (rewrite (hyp 0) lr rhs true ())
          (reduce rhs))
         refl))
     (case False
       (chain
         (have hx (= False True)
           (steps
             ((rewrite (premise 0) rl rhs true ())
              (unfold xlk_cbl rhs)
              (reduce rhs)
              (rewrite (hyp 0) lr rhs true ())
              (reduce rhs))
             refl))
         (absurd (premise hx)))))))

;; A family whose every member resolves hands out resolving bodies: whatever
;; xfunc_at answers, its body's calls resolve (match-wrapped, so no bounds
;; premises are needed at the citation site).
(claim xlk_cbfns_at
  (goal ((fs (List XFunc)) (gs (List XFunc)) (k Int))
    ((= (xlk_cbfns fs gs) True))
    (=
      (match (xfunc_at gs k)
        (None True)
        ((Some f) (xlk_cbl fs (xbody_of f))))
      True))
  (induct gs
    ((case Nil (steps ((compute lhs (stop xlk_cbl xbody_of))) refl))
     (case Cons
       (g t)
       (case-on (int_eq k 0) Bool
         ((case True
            (case-on (xlk_cbl fs (xbody_of g)) Bool
              ((case True
                 (steps
                   ((compute lhs (stop xlk_cbl xbody_of))
                    (rewrite (hyp 1) lr lhs true ())
                    (compute lhs (stop xlk_cbl xbody_of))
                    (rewrite (hyp 0) lr lhs true ()))
                   refl))
               (case False
                 (chain
                   (have hx (= False True)
                     (steps
                       ((rewrite (premise 0) rl rhs true ())
                        (unfold xlk_cbfns rhs)
                        (reduce rhs)
                        (unfold xlk_cbf rhs)
                        (reduce rhs)
                        (rewrite (hyp 0) lr rhs true ())
                        (reduce rhs))
                       refl))
                   (absurd (premise hx)))))))
          (case False
            (case-on (xlk_cbf fs g) Bool
              ((case True
                 (chain
                   (have htail (= (xlk_cbfns fs t) True)
                     (steps
                       ((rewrite (premise 0) rl rhs true ())
                        (unfold xlk_cbfns rhs)
                        (reduce rhs)
                        (rewrite (hyp 0) lr rhs true ())
                        (reduce rhs))
                       refl))
                   (steps
                     ((unfold xfunc_at lhs)
                      (reduce lhs)
                      (rewrite (hyp 1) lr lhs true ())
                      (reduce lhs)))
                   (rewrite-with
                     (hyp 2)
                     rl
                     rhs
                     ((inst fs fs) (inst k (- k 1)))
                     ((steps ((rewrite (premise htail) lr lhs true ())) refl)))
                   refl))
               (case False
                 (chain
                   (have hx (= False True)
                     (steps
                       ((rewrite (premise 0) rl rhs true ())
                        (unfold xlk_cbfns rhs)
                        (reduce rhs)
                        (rewrite (hyp 0) lr rhs true ())
                        (reduce rhs))
                       refl))
                   (absurd (premise hx)))))))))))))

;; --- scan commutation: the delegation scans ignore call indices --------------
;; The wv/xv dispatch predicates (xwv_fn / xvec_fn) answer identically on a
;; shifted function: shifting only rewrites XCall payloads, and both scans
;; treat XCall by CONSTRUCTOR (True), never by index. Proven over a 2-sum
;; (instr/list) mirroring the scans' mutual recursion, inducting on budget.

(type XS (XSI XInstr) (XSL (List XInstr)))

(fn xlk_shs ((dd Int) (s XS)) XS
  (match s
    ((XSI i) (XSI (xlk_shi dd i)))
    ((XSL is2) (XSL (xlk_shl dd is2)))))

(fn xlk_scv ((d Nat) (s XS)) Bool
  (match s
    ((XSI i) (xvec_i d i))
    ((XSL is2) (xvec_l d is2))))

(fn xlk_scw ((d Nat) (s XS)) Bool
  (match s
    ((XSI i) (xwv_i d i))
    ((XSL is2) (xwv_l d is2))))

(claim xlk_scv_sh
  (goal ((dd Int) (d Nat) (s XS)) ()
    (= (xlk_scv d (xlk_shs dd s)) (xlk_scv d s)))
  (induct d
    ((case Z
       (case-on s XS
         ((case XSI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XSL
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (d2)
       (case-on s XS
         ((case XSI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XStore8
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBlock
                   (body)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlk_scv lhs)
                        (reduce lhs)
                        (unfold xvec_i lhs)
                        (reduce lhs)
                        (unfold xlk_scv rhs)
                        (reduce rhs)
                        (unfold xvec_i rhs)
                        (reduce rhs)))
                     (have hal
                       (=
                         (xlk_scv d2 (xlk_shs dd (XSL body)))
                         (xvec_l d2 (xlk_shl dd body)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scv lhs)
                          (reduce lhs))
                         refl))
                     (have har (= (xlk_scv d2 (XSL body)) (xvec_l d2 body))
                       (steps ((unfold xlk_scv lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hal) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise har) lr lhs true ())))
                     refl))
                 (case XLoop
                   (body)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlk_scv lhs)
                        (reduce lhs)
                        (unfold xvec_i lhs)
                        (reduce lhs)
                        (unfold xlk_scv rhs)
                        (reduce rhs)
                        (unfold xvec_i rhs)
                        (reduce rhs)))
                     (have hal
                       (=
                         (xlk_scv d2 (xlk_shs dd (XSL body)))
                         (xvec_l d2 (xlk_shl dd body)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scv lhs)
                          (reduce lhs))
                         refl))
                     (have har (= (xlk_scv d2 (XSL body)) (xvec_l d2 body))
                       (steps ((unfold xlk_scv lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hal) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise har) lr lhs true ())))
                     refl))
                 (case XBr
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBrIf
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCall
                   (k)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRet
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XVec
                   (v)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))))))
          (case XSL
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shl lhs)
                        (reduce lhs)
                        (unfold xlk_scv lhs)
                        (reduce lhs)
                        (unfold xvec_l lhs)
                        (reduce lhs)
                        (unfold xlk_scv rhs)
                        (reduce rhs)
                        (unfold xvec_l rhs)
                        (reduce rhs)))
                     (have hgl
                       (=
                         (xlk_scv d2 (xlk_shs dd (XSI i2)))
                         (xvec_i d2 (xlk_shi dd i2)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scv lhs)
                          (reduce lhs))
                         refl))
                     (have hgr (= (xlk_scv d2 (XSI i2)) (xvec_i d2 i2))
                       (steps ((unfold xlk_scv lhs) (reduce lhs)) refl))
                     (have hel
                       (=
                         (xlk_scv d2 (xlk_shs dd (XSL rest)))
                         (xvec_l d2 (xlk_shl dd rest)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scv lhs)
                          (reduce lhs))
                         refl))
                     (have her (= (xlk_scv d2 (XSL rest)) (xvec_l d2 rest))
                       (steps ((unfold xlk_scv lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hgl) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps
                       ((rewrite (premise hgr) lr lhs true ())
                        (rewrite (premise hel) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise her) lr lhs true ())))
                     refl))))))))))))

(claim xlk_scw_sh
  (goal ((dd Int) (d Nat) (s XS)) ()
    (= (xlk_scw d (xlk_shs dd s)) (xlk_scw d s)))
  (induct d
    ((case Z
       (case-on s XS
         ((case XSI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XSL
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (d2)
       (case-on s XS
         ((case XSI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XStore8
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBlock
                   (body)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlk_scw lhs)
                        (reduce lhs)
                        (unfold xwv_i lhs)
                        (reduce lhs)
                        (unfold xlk_scw rhs)
                        (reduce rhs)
                        (unfold xwv_i rhs)
                        (reduce rhs)))
                     (have hal
                       (=
                         (xlk_scw d2 (xlk_shs dd (XSL body)))
                         (xwv_l d2 (xlk_shl dd body)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scw lhs)
                          (reduce lhs))
                         refl))
                     (have har (= (xlk_scw d2 (XSL body)) (xwv_l d2 body))
                       (steps ((unfold xlk_scw lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hal) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise har) lr lhs true ())))
                     refl))
                 (case XLoop
                   (body)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlk_scw lhs)
                        (reduce lhs)
                        (unfold xwv_i lhs)
                        (reduce lhs)
                        (unfold xlk_scw rhs)
                        (reduce rhs)
                        (unfold xwv_i rhs)
                        (reduce rhs)))
                     (have hal
                       (=
                         (xlk_scw d2 (xlk_shs dd (XSL body)))
                         (xwv_l d2 (xlk_shl dd body)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scw lhs)
                          (reduce lhs))
                         refl))
                     (have har (= (xlk_scw d2 (XSL body)) (xwv_l d2 body))
                       (steps ((unfold xlk_scw lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hal) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise har) lr lhs true ())))
                     refl))
                 (case XBr
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBrIf
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCall
                   (k)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRet
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XVec
                   (v)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))))))
          (case XSL
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps
                       ((rewrite (hyp 0) lr both true ())
                        (unfold xlk_shs lhs)
                        (reduce lhs)
                        (unfold xlk_shl lhs)
                        (reduce lhs)
                        (unfold xlk_scw lhs)
                        (reduce lhs)
                        (unfold xwv_l lhs)
                        (reduce lhs)
                        (unfold xlk_scw rhs)
                        (reduce rhs)
                        (unfold xwv_l rhs)
                        (reduce rhs)))
                     (have hgl
                       (=
                         (xlk_scw d2 (xlk_shs dd (XSI i2)))
                         (xwv_i d2 (xlk_shi dd i2)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scw lhs)
                          (reduce lhs))
                         refl))
                     (have hgr (= (xlk_scw d2 (XSI i2)) (xwv_i d2 i2))
                       (steps ((unfold xlk_scw lhs) (reduce lhs)) refl))
                     (have hel
                       (=
                         (xlk_scw d2 (xlk_shs dd (XSL rest)))
                         (xwv_l d2 (xlk_shl dd rest)))
                       (steps
                         ((unfold xlk_shs lhs)
                          (reduce lhs)
                          (unfold xlk_scw lhs)
                          (reduce lhs))
                         refl))
                     (have her (= (xlk_scw d2 (XSL rest)) (xwv_l d2 rest))
                       (steps ((unfold xlk_scw lhs) (reduce lhs)) refl))
                     (steps ((rewrite (premise hgl) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps
                       ((rewrite (premise hgr) lr lhs true ())
                        (rewrite (premise hel) rl lhs true ())))
                     (rewrite-with (hyp 2) lr lhs () ())
                     (steps ((rewrite (premise her) lr lhs true ())))
                     refl))))))))))))

;; Function-level corollaries: the dispatch predicates ignore the shift.
(claim xlk_scv_fn
  (goal ((d Nat) (dd Int) (f XFunc)) ()
    (= (xvec_fn d (xlk_shf dd f)) (xvec_fn d f)))
  (case-on f XFunc
    ((case MkXFunc
       (p body)
       (chain
         (steps
           ((rewrite (hyp 0) lr both true ())
            (unfold xlk_shf lhs)
            (reduce lhs)
            (unfold xvec_fn lhs)
            (reduce lhs)
            (unfold xbody_of lhs)
            (reduce lhs)
            (unfold xvec_fn rhs)
            (reduce rhs)
            (unfold xbody_of rhs)
            (reduce rhs)))
         (have hal
           (= (xlk_scv d (xlk_shs dd (XSL body))) (xvec_l d (xlk_shl dd body)))
           (steps
             ((unfold xlk_shs lhs)
              (reduce lhs)
              (unfold xlk_scv lhs)
              (reduce lhs))
             refl))
         (have har (= (xlk_scv d (XSL body)) (xvec_l d body))
           (steps ((unfold xlk_scv lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hal) rl lhs true ())))
         (rewrite-with (lemma xlk_scv_sh) lr lhs () ())
         (steps ((rewrite (premise har) lr lhs true ())))
         refl)))))

(claim xlk_scw_fn
  (goal ((d Nat) (dd Int) (f XFunc)) ()
    (= (xwv_fn d (xlk_shf dd f)) (xwv_fn d f)))
  (case-on f XFunc
    ((case MkXFunc
       (p body)
       (chain
         (steps
           ((rewrite (hyp 0) lr both true ())
            (unfold xlk_shf lhs)
            (reduce lhs)
            (unfold xwv_fn lhs)
            (reduce lhs)
            (unfold xbody_of lhs)
            (reduce lhs)
            (unfold xwv_fn rhs)
            (reduce rhs)
            (unfold xbody_of rhs)
            (reduce rhs)))
         (have hal
           (= (xlk_scw d (xlk_shs dd (XSL body))) (xwv_l d (xlk_shl dd body)))
           (steps
             ((unfold xlk_shs lhs)
              (reduce lhs)
              (unfold xlk_scw lhs)
              (reduce lhs))
             refl))
         (have har (= (xlk_scw d (XSL body)) (xwv_l d body))
           (steps ((unfold xlk_scw lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hal) rl lhs true ())))
         (rewrite-with (lemma xlk_scw_sh) lr lhs () ())
         (steps ((rewrite (premise har) lr lhs true ())))
         refl)))))

;; --- EXTENSION ---------------------------------------------------------------
;; Appending functions to a module preserves every walk whose code (and whose
;; reachable family) resolves in the base family. Premises are ctor equations
;; (same window by construction) + the calls-resolve scans. Stratified: each
;; upper tier cites the tier it delegates to, at (S f2), in its corners.

(claim xlk_extx
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (ext (List XFunc))
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app fs ext) lo hi))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (= (xlq_x fuel m2 q rs mem) (xlq_x fuel m1 q rs mem)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XMovRR
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XBin
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XShlI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XShrI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XBin32
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XShlI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XMovRR32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XRorI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XDivU
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XLoad8
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hlo2 (= (xmemlo_of m2) lo)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hlo1 (= (xmemlo_of m1) lo)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi2 (= (xmemhi_of m2) hi)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi1 (= (xmemhi_of m1) hi)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (steps
                       ((compute both (stop xmemhi_of xmemlo_of))
                        (rewrite (premise hlo2) lr lhs true ())
                        (rewrite (premise hlo1) lr rhs true ())
                        (rewrite (premise hhi2) lr lhs true ())
                        (rewrite (premise hhi1) lr rhs true ()))
                       refl)))
                 (case XStore8
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hlo2 (= (xmemlo_of m2) lo)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hlo1 (= (xmemlo_of m1) lo)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi2 (= (xmemhi_of m2) hi)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi1 (= (xmemhi_of m1) hi)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (steps
                       ((compute both (stop xmemhi_of xmemlo_of))
                        (rewrite (premise hlo2) lr lhs true ())
                        (rewrite (premise hlo1) lr rhs true ())
                        (rewrite (premise hhi2) lr lhs true ())
                        (rewrite (premise hhi1) lr rhs true ()))
                       refl)))
                 (case XBlock
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQS body)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (XQS body) rs mem)
                         (xlq_x f2 m1 (XQS body) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_seq f2 m2 body rs mem)
                         (xeval_seq f2 m1 body rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (XQS body) rs mem)
                             (xeval_seq f2 m2 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQS body) rs mem)
                             (xeval_seq f2 m1 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XLoop
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQB body)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (XQB body) rs mem)
                         (xlq_x f2 m1 (XQB body) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_loop f2 m2 body rs mem)
                         (xeval_loop f2 m1 body rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (XQB body) rs mem)
                             (xeval_loop f2 m2 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQB body) rs mem)
                             (xeval_loop f2 m1 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XBr
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XBrIf
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XCall
                   (k2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQC k2)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl xfunc_at)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (XQC k2) rs mem)
                         (xlq_x f2 m1 (XQC k2) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_call f2 m2 k2 rs mem)
                         (xeval_call f2 m1 k2 rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (XQC k2) rs mem)
                             (xeval_call f2 m2 k2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQC k2) rs mem)
                             (xeval_call f2 m1 k2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XRet
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))
                 (case XVec
                   (v)
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (rewrite (premise 0) lr both true ())
                      (rewrite (premise 1) lr both true ())
                      (compute both))
                     refl))))))
          (case XQC
            (k)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlq_x lhs)
                 (reduce lhs)
                 (unfold xeval_call lhs)
                 (reduce lhs)
                 (unfold xlq_x rhs)
                 (reduce rhs)
                 (unfold xeval_call rhs)
                 (reduce rhs)))
              (have hfns2 (= (xfuncs_of m2) (xlk_app fs ext))
                (steps
                  ((rewrite (premise 1) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hfns1 (= (xfuncs_of m1) fs)
                (steps
                  ((rewrite (premise 0) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hres (= (xlk_isf (xfunc_at fs k)) True)
                (steps
                  ((rewrite (premise 2) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both))
                  refl))
              (have hlk (= (xfunc_at (xlk_app fs ext) k) (xfunc_at fs k))
                (rewrite-with
                  (lemma xlk_at_app)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hres) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (premise hfns2) lr lhs true ())
                 (rewrite (premise hlk) lr lhs true ())
                 (rewrite (premise hfns1) lr rhs true ())))
              (case-on (xfunc_at fs k) Option
                ((case None
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Some
                   (f)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ()) (reduce both)))
                     (have hcb (= (xlk_cbq fs (XQS (xbody_of f))) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl xbody_of))))
                         (rewrite-with
                           (lemma xlk_cbfns_at)
                           rl
                           rhs
                           ((inst fs fs) (inst gs fs) (inst k k))
                           ((steps ((rewrite (premise 3) lr lhs true ())) refl)))
                         (steps
                           ((rewrite (hyp 0) lr rhs true ()) (reduce rhs))
                           refl)))
                     (have hih
                       (=
                         (xlq_x f2 m2 (XQS (xbody_of f)) rs mem)
                         (xlq_x f2 m1 (XQS (xbody_of f)) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_seq f2 m2 (xbody_of f) rs mem)
                         (xeval_seq f2 m1 (xbody_of f) rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (XQS (xbody_of f)) rs mem)
                             (xeval_seq f2 m2 (xbody_of f) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQS (xbody_of f)) rs mem)
                             (xeval_seq f2 m1 (xbody_of f) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))))))
          (case XQB
            (body)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlq_x lhs)
                 (reduce lhs)
                 (unfold xeval_loop lhs)
                 (reduce lhs)
                 (unfold xlq_x rhs)
                 (reduce rhs)
                 (unfold xeval_loop rhs)
                 (reduce rhs)))
              (have hcb (= (xlk_cbq fs (XQS body)) True)
                (steps
                  ((rewrite (premise 2) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both (stop xlk_cbl)))
                  refl))
              (have hih
                (=
                  (xlq_x f2 m2 (XQS body) rs mem)
                  (xlq_x f2 m1 (XQS body) rs mem))
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ((inst m1 m1)
                   (inst fs fs)
                   (inst ext ext)
                   (inst lo lo)
                   (inst hi hi))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                   (steps ((rewrite (premise 3) lr lhs true ())) refl))
                  refl))
              (have heng
                (= (xeval_seq f2 m2 body rs mem) (xeval_seq f2 m1 body rs mem))
                (chain
                  (have ha2
                    (=
                      (xlq_x f2 m2 (XQS body) rs mem)
                      (xeval_seq f2 m2 body rs mem))
                    (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                  (have ha1
                    (=
                      (xlq_x f2 m1 (XQS body) rs mem)
                      (xeval_seq f2 m1 body rs mem))
                    (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                  (steps
                    ((rewrite (premise ha2) rl lhs true ())
                     (rewrite (premise ha1) rl rhs true ())
                     (rewrite (premise hih) lr lhs true ()))
                    refl)))
              (steps ((rewrite (premise heng) lr lhs true ())))
              (case-on (xeval_seq f2 m1 body rs mem) Option
                ((case None
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Some
                   (out)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ()) (reduce both)))
                     (case-on out XOut
                       ((case XNorm
                          (rs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XBrk
                          (d3 rs2 mem2)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on (int_eq d3 0) Bool
                              ((case True
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hcbb (= (xlk_cbq fs (XQB body)) True)
                                     (steps
                                       ((rewrite (premise 2) rl rhs true ())
                                        (rewrite (hyp 3) lr rhs true ()))
                                       refl))
                                   (have hih
                                     (=
                                       (xlq_x f2 m2 (XQB body) rs2 mem2)
                                       (xlq_x f2 m1 (XQB body) rs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst ext ext)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng2
                                     (=
                                       (xeval_loop f2 m2 body rs2 mem2)
                                       (xeval_loop f2 m1 body rs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_x f2 m2 (XQB body) rs2 mem2)
                                           (xeval_loop f2 m2 body rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_x f2 m1 (XQB body) rs2 mem2)
                                           (xeval_loop f2 m1 body rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise heng2) lr lhs true ()))
                                     refl)))
                               (case False
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))
                        (case XRetO
                          (rs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XTrap
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_seq rhs)
                        (reduce rhs)))
                     (have hcbcons (= (xlk_cbl fs (Cons i2 rest)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hcbh (= (xlk_cbq fs (XQI i2)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbi))))
                         (rewrite-with
                           (lemma xlk_cbl_head)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hcbt (= (xlk_cbq fs (XQS rest)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl))))
                         (rewrite-with
                           (lemma xlk_cbl_tail)
                           lr
                           lhs
                           ((inst i i2))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (XQI i2) rs mem)
                         (xlq_x f2 m1 (XQI i2) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbh) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hinstr
                       (=
                         (xeval_instr f2 m2 i2 rs mem)
                         (xeval_instr f2 m1 i2 rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (XQI i2) rs mem)
                             (xeval_instr f2 m2 i2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQI i2) rs mem)
                             (xeval_instr f2 m1 i2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hinstr) lr lhs true ())))
                     (case-on (xeval_instr f2 m1 i2 rs mem) Option
                       ((case None
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case Some
                          (out)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on out XOut
                              ((case XNorm
                                 (rs2 mem2)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hih
                                     (=
                                       (xlq_x f2 m2 (XQS rest) rs2 mem2)
                                       (xlq_x f2 m1 (XQS rest) rs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst ext ext)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbt)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have htail
                                     (=
                                       (xeval_seq f2 m2 rest rs2 mem2)
                                       (xeval_seq f2 m1 rest rs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_x f2 m2 (XQS rest) rs2 mem2)
                                           (xeval_seq f2 m2 rest rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_x f2 m1 (XQS rest) rs2 mem2)
                                           (xeval_seq f2 m1 rest rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise htail) lr lhs true ()))
                                     refl)))
                               (case XBrk
                                 (d3 rs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XRetO
                                 (rs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XTrap
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))))))))))))))))

(claim xlk_extv
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (ext (List XFunc))
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (xs Xmms)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app fs ext) lo hi))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (= (xlq_xv fuel m2 q rs xs mem) (xlq_xv fuel m1 q rs xs mem)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRI a1 a2))) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_x (S f2) m2 (XQI (XMovRI a1 a2)) rs mem)
                         (xlq_x (S f2) m1 (XQI (XMovRI a1 a2)) rs mem))
                       (rewrite-with
                         (lemma xlk_extx)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xeval_instr (S f2) m2 (XMovRI a1 a2) rs mem)
                         (xeval_instr (S f2) m1 (XMovRI a1 a2) rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x (S f2) m2 (XQI (XMovRI a1 a2)) rs mem)
                             (xeval_instr (S f2) m2 (XMovRI a1 a2) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_x (S f2) m1 (XQI (XMovRI a1 a2)) rs mem)
                             (xeval_instr (S f2) m1 (XMovRI a1 a2) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XMovRR
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
