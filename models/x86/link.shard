                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv (S f2) m2 (XQI XRet) rs xs mem)
                         (xlq_xv (S f2) m1 (XQI XRet) rs xs mem))
                       (rewrite-with
                         (lemma xlk_extv)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xveval_instr (S f2) m2 XRet rs xs mem)
                         (xveval_instr (S f2) m1 XRet rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv (S f2) m2 (XQI XRet) rs xs mem)
                             (xveval_instr (S f2) m2 XRet rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (have ha1
