                     (rewrite (premise ha1) rl rhs true ())
                     (rewrite (premise hih) lr lhs true ()))
                    refl)))
              (steps ((rewrite (premise heng) lr lhs true ())))
              (case-on (wveval_seq f2 m1 body rs xs mem w) Option
                ((case None
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Some
                   (out)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ()) (reduce both)))
                     (case-on out WVOut
                       ((case WVNorm
                          (rs2 xs2 mem2 w2 tr)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case WVBrk
                          (d3 rs2 xs2 mem2 w2 tr)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on (int_eq d3 0) Bool
                              ((case True
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hcbb (= (xlk_cbq fs (XQB body)) True)
                                     (steps
                                       ((rewrite (premise 2) rl rhs true ())
                                        (rewrite (hyp 3) lr rhs true ()))
                                       refl))
                                   (have hih
                                     (=
                                       (xlq_wv f2 m2 (XQB body) rs2 xs2 mem2 w2)
                                       (xlq_wv f2 m1 (XQB body) rs2 xs2 mem2 w2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst ext ext)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng2
                                     (=
                                       (wveval_loop f2 m2 body rs2 xs2 mem2 w2)
                                       (wveval_loop f2 m1 body rs2 xs2 mem2 w2))
