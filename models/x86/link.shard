                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng2
                                     (=
                                       (xveval_loop f2 m2 body rs2 xs2 mem2)
                                       (xveval_loop f2 m1 body rs2 xs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_xv
                                             f2
                                             m2
                                             (XQB body)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_loop f2 m2 body rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_xv
                                             f2
                                             m1
                                             (XQB body)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_loop f2 m1 body rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise heng2) lr lhs true ()))
                                     refl)))
                               (case False
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))
                        (case XVRetO
                          (rs2 xs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVTrap
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_seq rhs)
                        (reduce rhs)))
                     (have hcbcons (= (xlk_cbl fs (Cons i2 rest)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hcbh (= (xlk_cbq fs (XQI i2)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbi))))
                         (rewrite-with
                           (lemma xlk_cbl_head)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hcbt (= (xlk_cbq fs (XQS rest)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl))))
                         (rewrite-with
                           (lemma xlk_cbl_tail)
                           lr
                           lhs
                           ((inst i i2))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hih
                       (=
                         (xlq_xv f2 m2 (XQI i2) rs xs mem)
                         (xlq_xv f2 m1 (XQI i2) rs xs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbh) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hinstr
                       (=
                         (xveval_instr f2 m2 i2 rs xs mem)
                         (xveval_instr f2 m1 i2 rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv f2 m2 (XQI i2) rs xs mem)
                             (xveval_instr f2 m2 i2 rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_xv f2 m1 (XQI i2) rs xs mem)
                             (xveval_instr f2 m1 i2 rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hinstr) lr lhs true ())))
                     (case-on (xveval_instr f2 m1 i2 rs xs mem) Option
                       ((case None
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case Some
                          (out)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on out XVOut
                              ((case XVNorm
                                 (rs2 xs2 mem2)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hih
                                     (=
                                       (xlq_xv f2 m2 (XQS rest) rs2 xs2 mem2)
                                       (xlq_xv f2 m1 (XQS rest) rs2 xs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst ext ext)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbt)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have htail
                                     (=
                                       (xveval_seq f2 m2 rest rs2 xs2 mem2)
                                       (xveval_seq f2 m1 rest rs2 xs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_xv
                                             f2
                                             m2
                                             (XQS rest)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_seq f2 m2 rest rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_xv
                                             f2
                                             m1
                                             (XQS rest)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_seq f2 m1 rest rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise htail) lr lhs true ()))
                                     refl)))
                               (case XVBrk
                                 (d3 rs2 xs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XVRetO
                                 (rs2 xs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XVTrap
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))))))))))))))))

(claim xlk_extwv
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (ext (List XFunc))
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (xs Xmms)
     (w LxWorld)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app fs ext) lo hi))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (= (xlq_wv fuel m2 q rs xs mem w) (xlq_wv fuel m1 q rs xs mem w)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRI a1 a2))) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv (S f2) m2 (XQI (XMovRI a1 a2)) rs xs mem)
                         (xlq_xv (S f2) m1 (XQI (XMovRI a1 a2)) rs xs mem))
                       (rewrite-with
                         (lemma xlk_extv)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xveval_instr (S f2) m2 (XMovRI a1 a2) rs xs mem)
                         (xveval_instr (S f2) m1 (XMovRI a1 a2) rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv (S f2) m2 (XQI (XMovRI a1 a2)) rs xs mem)
                             (xveval_instr (S f2) m2 (XMovRI a1 a2) rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_xv (S f2) m1 (XQI (XMovRI a1 a2)) rs xs mem)
                             (xveval_instr (S f2) m1 (XMovRI a1 a2) rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XMovRR
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_wv lhs)
