                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XBin a1 a2 a3)))
                           rs
                           xs
                           mem)
                         (xlq_xv (S f2) m1 (XQI (XBin a1 a2 a3)) rs xs mem))
                       (rewrite-with
                         (lemma xlk_shv)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
