                                      f2
                                      m2
                                      (XQS (xbody_of f))
                                      rs
                                      xs
                                      mem
                                      w)
                                    (wveval_seq f2 m2 (xbody_of f) rs xs mem w))
                                  (steps
                                    ((unfold xlq_wv lhs) (reduce lhs))
                                    refl))
                                (have ha1
