;;; models/x86/link.shard — the LINKING LAYER over the x86 eval tower
;;; (B6 slice B, STREAM.md §9 R3): how proven walks CROSS tiers and SURVIVE
;;; module composition.
;;;
;;; Three theorem families over a query-sum encoding of the four-fn eval SCC
;;; (XQ: instr / call / loop-walk / seq — ONE claim per theorem, induct fuel,
;;; everything else generalized):
;;;
;;;  - THE EMBEDDING TOWER (xlk_embx / xlk_embp / xlk_adeq / xlk_embw): a
;;;    non-trapping walk at a lower tier is run identically by the tier
;;;    above — the semantic ok-premise (None rides, only the trap is
;;;    excluded) needs no static vector-freedom scan. xlk_embw is THE
;;;    CROSSING: it carries the scalar family's world-tier entry equations
;;;    into the world-vector tier a merged dispatch bin lives at.
;;;
;;;  - EXTENSION (xlk_extx / xlk_extv / xlk_extwv): appending functions to a
;;;    module preserves every walk whose code (and reachable family)
;;;    RESOLVES in the base family — the calls-resolve predicate (xlk_cb*)
;;;    is spelled as lookup-success, which IS the in-range fact, so the
;;;    lemma layer stays arithmetic-free.
;;;
;;;  - SHIFT (xlk_shx / xlk_shv / xlk_shwv): uniformly mapping (XCall k) ->
;;;    (XCall (k+d)) over a family placed at offset d = len pre preserves
;;;    walks; the dispatch scans answer identically on shifted functions
;;;    (xlk_scv_sh / xlk_scw_sh — XCall is judged by CONSTRUCTOR, never by
;;;    index).
;;;
;;; Both families stratify downward (each upper tier cites the tier its
;;; call arm delegates to, at (S f2)); denotation-grain corollaries
;;; (xlk_extrun / xlk_shrun) transfer EXTENSION and SHIFT to xvrun_w, the
;;; wv-tier bin boundary. Landed from session probes b6b4/b6b6/b6b7/b6b8
;;; (B6 slice B, 2026-08-10).

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/mem")
(use (:: std mem *))
(import "x86.shard")
(use (:: models x86 x86 *))
(import "../linux/kernel.shard")
(use (:: models linux kernel *))
(import "world.shard")
(use (:: models x86 world *))
(import "vector.shard")
(use (:: models x86 vector *))
(import "vworld.shard")
(use (:: models x86 vworld *))

;; --- the query sum: the four-fn eval SCC as ONE inductive statement ----------

(type XQ (XQI XInstr) (XQC Int) (XQB (List XInstr)) (XQS (List XInstr)))

(fn xlq_x ((fuel Nat) (m XModule) (q XQ) (rs Regs) (mem Mem)) (Option XOut)
  (match q
    ((XQI i) (xeval_instr fuel m i rs mem))
    ((XQC k) (xeval_call fuel m k rs mem))
    ((XQB body) (xeval_loop fuel m body rs mem))
    ((XQS is2) (xeval_seq fuel m is2 rs mem))))

(fn xlq_xv ((fuel Nat) (m XModule) (q XQ) (rs Regs) (xs Xmms) (mem Mem))
  (Option XVOut)
  (match q
    ((XQI i) (xveval_instr fuel m i rs xs mem))
    ((XQC k) (xveval_call fuel m k rs xs mem))
    ((XQB body) (xveval_loop fuel m body rs xs mem))
    ((XQS is2) (xveval_seq fuel m is2 rs xs mem))))

(fn xlq_w ((fuel Nat) (m XModule) (q XQ) (rs Regs) (mem Mem) (w LxWorld))
  (Option WOut)
  (match q
    ((XQI i) (weval_instr fuel m i rs mem w))
    ((XQC k) (weval_call fuel m k rs mem w))
    ((XQB body) (weval_loop fuel m body rs mem w))
    ((XQS is2) (weval_seq fuel m is2 rs mem w))))

(fn xlq_wv
  ((fuel Nat) (m XModule) (q XQ) (rs Regs) (xs Xmms) (mem Mem) (w LxWorld))
  (Option WVOut)
  (match q
    ((XQI i) (wveval_instr fuel m i rs xs mem w))
    ((XQC k) (wveval_call fuel m k rs xs mem w))
    ((XQB body) (wveval_loop fuel m body rs xs mem w))
    ((XQS is2) (wveval_seq fuel m is2 rs xs mem w))))

;; --- the ok discriminators: None rides, only the trap is excluded ------------

(fn xlk_okx ((o (Option XOut))) Bool
  (match o
    (None True)
    ((Some out)
     (match out
       (XTrap False)
       (other True)))))

(fn xlk_okv ((o (Option XVOut))) Bool
  (match o
    (None True)
    ((Some out)
     (match out
       (XVTrap False)
       (other True)))))

(fn xlk_okw ((o (Option WOut))) Bool
  (match o
    (None True)
    ((Some out)
     (match out
       (WTrap False)
       (other True)))))

;; --- the kit lemmas ----------------------------------------------------------

;; ok-ness passes through the lifts
(claim xlk_okvl
  (goal ((xs Xmms) (o (Option XOut))) ()
    (= (xlk_okv (xvlift xs o)) (xlk_okx o)))
  (case-on o Option
    ((case None (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case Some
       (out)
       (case-on out XOut
         ((case XNorm
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XBrk
            (d2 rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XRetO
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XTrap
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))))))))

(claim xlk_okwl
  (goal ((w LxWorld) (o (Option XOut))) ()
    (= (xlk_okw (wlift w o)) (xlk_okx o)))
  (case-on o Option
    ((case None (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case Some
       (out)
       (case-on out XOut
         ((case XNorm
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XBrk
            (d2 rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XRetO
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XTrap
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))))))))

;; the two composition routes through the tiers agree
(claim xlk_lifts
  (goal ((xs Xmms) (w LxWorld) (o (Option XOut))) ()
    (= (wvlift_p w (xvlift xs o)) (wvlift xs (wlift w o))))
  (case-on o Option
    ((case None (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case Some
       (out)
       (case-on out XOut
         ((case XNorm
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XBrk
            (d2 rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XRetO
            (rs2 mem2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case XTrap
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))))))))

;; empty-trace prepends dissolve
(claim xlk_trnil
  (goal ((o WOut)) () (= (wtr_pre Nil o) o))
  (case-on o WOut
    ((case WNorm
       (rs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WBrk
       (d2 rs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WRetO
       (rs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WExit
       (c2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WTrap
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

(claim xlk_vtrnil
  (goal ((o WVOut)) () (= (wvtr_pre Nil o) o))
  (case-on o WVOut
    ((case WVNorm
       (rs2 xs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WVBrk
       (d2 rs2 xs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WVRetO
       (rs2 xs2 mem2 w2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WVExit
       (c2 tr)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case WVTrap
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

;; --- the static scan at query grain (WADEQ's premise) ------------------------
;; QC answers True unconditionally: a call IS an effect point for this scan
;; (xwv_i's convention), so WADEQ never speaks about call queries.

(fn xlkp_q ((d Nat) (q XQ)) Bool
  (match q
    ((XQI i) (xwv_i d i))
    ((XQC k) True)
    ((XQB body) (xwv_l d body))
    ((XQS is2) (xwv_l d is2))))

(claim xlk_okwtr
  (goal ((o (Option WOut)) (tr (List LxEvent))) ()
    (=
      (xlk_okw
        (match o
          (None None)
          ((Some out2) (Some (wtr_pre tr out2)))))
      (xlk_okw o)))
  (case-on o Option
    ((case None (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
     (case Some
       (out2)
       (case-on out2 WOut
         ((case WNorm
            (rs2 mem2 w2 tr2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case WBrk
            (d2 rs2 mem2 w2 tr2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case WRetO
            (rs2 mem2 w2 tr2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case WExit
            (c2 tr2)
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))
          (case WTrap
            (steps
              ((rewrite (hyp 1) lr both true ())
               (rewrite (hyp 0) lr both true ())
               (compute both))
              refl))))))))

;; --- THE BASE→VECTOR EMBEDDING (XVEMBED) -------------------------------------
;;
;; A non-trapping base walk never reached XVec (the trap fence), so the
;; vector tier runs it identically with the XMM file riding past. The
;; premise is SEMANTIC: no static vector-freedom scan anywhere.

(claim xlk_embx
  (goal ((fuel Nat) (m XModule) (q XQ) (rs Regs) (xs Xmms) (mem Mem))
    ((= (xlk_okx (xlq_x fuel m q rs mem)) True))
    (= (xlq_xv fuel m q rs xs mem) (xvlift xs (xlq_x fuel m q rs mem))))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (lr1 lv)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (lr1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (ld la)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XStore8
                   (la ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBlock
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hxa
                       (=
                         (xlq_x f2 m (XQS body) rs mem)
                         (xeval_seq f2 m body rs mem))
                       (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQS body) rs xs mem)
                         (xveval_seq f2 m body rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (steps ((compute both (stop xeval_seq xveval_seq))))
                     (case-on (xeval_seq f2 m body rs mem) Option
                       ((case None
                          (chain
                            (have hok
                              (= (xlk_okx (xlq_x f2 m (XQS body) rs mem)) True)
                              (steps
                                ((rewrite (premise hxa) lr lhs true ())
                                 (rewrite (hyp 0) lr lhs true ())
                                 (compute lhs))
                                refl))
                            (have hih
                              (=
                                (xlq_xv f2 m (XQS body) rs xs mem)
                                (xvlift xs (xlq_x f2 m (XQS body) rs mem)))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
                                ()
                                ((steps
                                   ((rewrite (premise hok) lr lhs true ()))
                                   refl))
                                refl))
                            (steps
                              ((rewrite (premise hva) rl lhs true ())
                               (rewrite (premise hih) lr lhs true ())
                               (rewrite (premise hxa) lr lhs true ())
                               (rewrite (hyp 0) lr both true ())
                               (compute both))
                              refl)))
                        (case Some
                          (out)
                          (case-on out XOut
                            ((case XNorm
                               (rs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okx (xlq_x f2 m (XQS body) rs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hxa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_xv f2 m (XQS body) rs xs mem)
                                     (xvlift xs (xlq_x f2 m (XQS body) rs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hxa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XBrk
                               (d2 rs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okx (xlq_x f2 m (XQS body) rs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hxa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_xv f2 m (XQS body) rs xs mem)
                                     (xvlift xs (xlq_x f2 m (XQS body) rs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hxa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both)))
                                 (case-on (int_eq d2 0) Bool
                                   ((case True
                                      (steps
                                        ((rewrite (hyp True) lr both true ())
                                         (compute both))
                                        refl))
                                    (case False
                                      (steps
                                        ((rewrite (hyp False) lr both true ())
                                         (compute both))
                                        refl))))))
                             (case XRetO
                               (rs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okx (xlq_x f2 m (XQS body) rs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hxa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_xv f2 m (XQS body) rs xs mem)
                                     (xvlift xs (xlq_x f2 m (XQS body) rs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hxa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XTrap
                               (chain
                                 (have hx (= False True)
                                   (steps
                                     ((rewrite (premise 0) rl rhs true ())
                                      (rewrite (hyp 3) lr rhs true ())
                                      (rewrite (hyp 2) lr rhs true ())
                                      (compute rhs (stop xeval_seq))
                                      (rewrite (hyp 1) lr rhs true ())
                                      (rewrite (hyp 0) lr rhs true ())
                                      (compute rhs))
                                     refl))
                                 (absurd (premise hx)))))))))))
                 (case XLoop
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hxi2
                       (=
                         (xlq_x (S f2) m (XQI (XLoop body)) rs mem)
                         (xeval_loop f2 m body rs mem))
                       (steps
                         ((unfold xlq_x lhs)
                          (reduce lhs)
                          (unfold xeval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hxa
                       (=
                         (xlq_x f2 m (XQB body) rs mem)
                         (xeval_loop f2 m body rs mem))
                       (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQB body) rs xs mem)
                         (xveval_loop f2 m body rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hok (= (xlk_okx (xlq_x f2 m (XQB body) rs mem)) True)
                       (steps
                         ((rewrite (premise hxa) lr lhs true ())
                          (rewrite (premise hxi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_xv f2 m (XQB body) rs xs mem)
                         (xvlift xs (xlq_x f2 m (XQB body) rs mem)))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hok) lr lhs true ())) refl))
                         refl))
                     (steps
                       ((compute both (stop xeval_loop xveval_loop xvlift))
                        (rewrite (premise hva) rl lhs true ())
                        (rewrite (premise hih) lr lhs true ())
                        (rewrite (premise hxa) lr lhs true ()))
                       refl)))
                 (case XBr
                   (ld)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBrIf
                   (lc ld)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCall
                   (k2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hxi2
                       (=
                         (xlq_x (S f2) m (XQI (XCall k2)) rs mem)
                         (xeval_call f2 m k2 rs mem))
                       (steps
                         ((unfold xlq_x lhs)
                          (reduce lhs)
                          (unfold xeval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hxa
                       (=
                         (xlq_x f2 m (XQC k2) rs mem)
                         (xeval_call f2 m k2 rs mem))
                       (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQC k2) rs xs mem)
                         (xveval_call f2 m k2 rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hok (= (xlk_okx (xlq_x f2 m (XQC k2) rs mem)) True)
                       (steps
                         ((rewrite (premise hxa) lr lhs true ())
                          (rewrite (premise hxi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_xv f2 m (XQC k2) rs xs mem)
