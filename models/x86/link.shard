                             (rewrite (premise hih) lr lhs true ())
                             (rewrite (premise hva) lr lhs true ())
                             (rewrite (hyp 1) lr both true ())
                             (rewrite (hyp 0) lr both true ())
                             (compute both))
                            refl)))
                      (case XVBrk
                        (d2 rs2 xs2 mem2)
                        (chain
                          (have hok
                            (=
                              (xlk_okv (xlq_xv f2 m (XQS body) rs xs mem))
                              True)
                            (steps
                              ((rewrite (premise hva) lr lhs true ())
                               (rewrite (hyp 1) lr lhs true ())
                               (rewrite (hyp 0) lr lhs true ())
                               (compute lhs))
                              refl))
                          (have hih
                            (=
                              (xlq_wv f2 m (XQS body) rs xs mem w)
                              (wvlift_p w (xlq_xv f2 m (XQS body) rs xs mem)))
                            (rewrite-with
                              (hyp 3)
                              lr
                              lhs
                              ()
                              ((steps
                                 ((rewrite (premise hok) lr lhs true ()))
                                 refl))
                              refl))
                          (steps
                            ((rewrite (premise hwa) rl lhs true ())
                             (rewrite (premise hih) lr lhs true ())
                             (rewrite (premise hva) lr lhs true ())
                             (rewrite (hyp 1) lr both true ())
                             (rewrite (hyp 0) lr both true ())
                             (compute
                               both
                               (stop xveval_loop wveval_loop wvlift_p int_eq))))
                          (case-on (int_eq d2 0) Bool
                            ((case True
                               (chain
                                 (have hvr
                                   (=
                                     (xlq_xv f2 m (XQB body) rs2 xs2 mem2)
                                     (xveval_loop f2 m body rs2 xs2 mem2))
                                   (steps
                                     ((unfold xlq_xv lhs) (reduce lhs))
                                     refl))
                                 (have hwr
                                   (=
                                     (xlq_wv f2 m (XQB body) rs2 xs2 mem2 w)
                                     (wveval_loop f2 m body rs2 xs2 mem2 w))
                                   (steps
                                     ((unfold xlq_wv lhs) (reduce lhs))
                                     refl))
                                 (have hloop
                                   (=
                                     (xlq_xv (S f2) m (XQB body) rs xs mem)
                                     (xveval_loop f2 m body rs2 xs2 mem2))
                                   (steps
                                     ((unfold xlq_xv lhs)
                                      (reduce lhs)
                                      (unfold xveval_loop lhs)
                                      (reduce lhs)
                                      (rewrite (hyp 2) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (reduce lhs)
                                      (rewrite (hyp True) lr lhs true ())
                                      (reduce lhs))
                                     refl))
                                 (have hokr
                                   (=
                                     (xlk_okv
                                       (xlq_xv f2 m (XQB body) rs2 xs2 mem2))
                                     True)
                                   (steps
                                     ((rewrite (premise hvr) lr lhs true ())
                                      (rewrite (premise hloop) rl lhs true ())
                                      (rewrite (hyp 3) rl lhs true ())
                                      (rewrite (premise 0) lr lhs true ()))
                                     refl))
                                 (have hihr
                                   (=
                                     (xlq_wv f2 m (XQB body) rs2 xs2 mem2 w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQB body) rs2 xs2 mem2)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hokr) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((compute lhs (stop xveval_loop wveval_loop))
                                    (rewrite (hyp True) lr both true ())
                                    (compute lhs (stop xveval_loop wveval_loop))
                                    (compute rhs (stop xveval_loop))
                                    (rewrite (premise hwr) rl lhs true ())
                                    (rewrite (premise hihr) lr lhs true ())
                                    (rewrite (premise hvr) lr lhs true ())))
                                 (case-on (xveval_loop f2 m body rs2 xs2 mem2)
                                   Option
                                   ((case None
                                      (steps
                                        ((rewrite (hyp 0) lr both true ())
                                         (compute both))
                                        refl))
                                    (case Some
                                      (out2)
                                      (case-on out2 XVOut
                                        ((case XVNorm
                                           (rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVBrk
                                           (rd1 rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVRetO
                                           (rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVTrap
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl)))))))))
                             (case False
                               (steps
                                 ((compute both (stop xveval_loop wveval_loop))
                                  (rewrite (hyp False) lr both true ())
                                  (compute both))
                                 refl))))))
                      (case XVRetO
                        (rs2 xs2 mem2)
                        (chain
                          (have hok
                            (=
                              (xlk_okv (xlq_xv f2 m (XQS body) rs xs mem))
                              True)
                            (steps
                              ((rewrite (premise hva) lr lhs true ())
                               (rewrite (hyp 1) lr lhs true ())
                               (rewrite (hyp 0) lr lhs true ())
                               (compute lhs))
                              refl))
                          (have hih
                            (=
                              (xlq_wv f2 m (XQS body) rs xs mem w)
                              (wvlift_p w (xlq_xv f2 m (XQS body) rs xs mem)))
                            (rewrite-with
                              (hyp 3)
                              lr
                              lhs
                              ()
                              ((steps
                                 ((rewrite (premise hok) lr lhs true ()))
                                 refl))
                              refl))
                          (steps
                            ((rewrite (premise hwa) rl lhs true ())
                             (rewrite (premise hih) lr lhs true ())
                             (rewrite (premise hva) lr lhs true ())
                             (rewrite (hyp 1) lr both true ())
                             (rewrite (hyp 0) lr both true ())
                             (compute both))
                            refl)))
                      (case XVTrap
                        (chain
                          (have hx (= False True)
                            (steps
                              ((rewrite (premise 0) rl rhs true ())
                               (rewrite (hyp 2) lr rhs true ())
                               (compute rhs (stop xveval_seq))
                               (rewrite (hyp 1) lr rhs true ())
                               (rewrite (hyp 0) lr rhs true ())
                               (compute rhs))
                              refl))
                          (absurd (premise hx)))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQI i) rs xs mem)
                         (xveval_instr f2 m i rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hwa
                       (=
                         (xlq_wv f2 m (XQI i) rs xs mem w)
                         (wveval_instr f2 m i rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (steps
                       ((unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_seq rhs)
                        (reduce rhs)))
                     (case-on (xveval_instr f2 m i rs xs mem) Option
                       ((case None
                          (chain
                            (have hok
                              (= (xlk_okv (xlq_xv f2 m (XQI i) rs xs mem)) True)
                              (steps
                                ((rewrite (premise hva) lr lhs true ())
                                 (rewrite (hyp 0) lr lhs true ())
                                 (compute lhs))
                                refl))
                            (have hih
                              (=
                                (xlq_wv f2 m (XQI i) rs xs mem w)
                                (wvlift_p w (xlq_xv f2 m (XQI i) rs xs mem)))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
                                ()
                                ((steps
                                   ((rewrite (premise hok) lr lhs true ()))
                                   refl))
                                refl))
                            (steps
                              ((rewrite (premise hwa) rl lhs true ())
                               (rewrite (premise hih) lr lhs true ())
                               (rewrite (premise hva) lr lhs true ())
                               (rewrite (hyp 0) lr both true ())
                               (compute both))
                              refl)))
                        (case Some
                          (out)
                          (case-on out XVOut
                            ((case XVNorm
                               (rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv (xlq_xv f2 m (XQI i) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQI i) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQI i) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (have hseq2
                                   (=
                                     (xveval_seq
                                       (S f2)
                                       m
                                       (Cons i rest)
                                       rs
                                       xs
                                       mem)
                                     (xveval_seq f2 m rest rs2 xs2 mem2))
                                   (steps
                                     ((unfold xveval_seq lhs)
                                      (reduce lhs)
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (reduce lhs))
                                     refl))
                                 (have hqlc
                                   (=
                                     (xlq_xv
                                       (S f2)
                                       m
                                       (XQS (Cons i rest))
                                       rs
                                       xs
                                       mem)
                                     (xveval_seq
                                       (S f2)
                                       m
                                       (Cons i rest)
                                       rs
                                       xs
                                       mem))
                                   (steps
                                     ((unfold xlq_xv lhs) (reduce lhs))
                                     refl))
                                 (have hvr
                                   (=
                                     (xlq_xv f2 m (XQS rest) rs2 xs2 mem2)
                                     (xveval_seq f2 m rest rs2 xs2 mem2))
                                   (steps
                                     ((unfold xlq_xv lhs) (reduce lhs))
                                     refl))
                                 (have hwr
                                   (=
                                     (xlq_wv f2 m (XQS rest) rs2 xs2 mem2 w)
                                     (wveval_seq f2 m rest rs2 xs2 mem2 w))
                                   (steps
                                     ((unfold xlq_wv lhs) (reduce lhs))
                                     refl))
                                 (have hokr
                                   (=
                                     (xlk_okv
                                       (xlq_xv f2 m (XQS rest) rs2 xs2 mem2))
                                     True)
                                   (steps
                                     ((rewrite (premise hvr) lr lhs true ())
                                      (rewrite (premise hseq2) rl lhs true ())
                                      (rewrite (premise hqlc) rl lhs true ())
                                      (rewrite (hyp 2) rl lhs true ())
                                      (rewrite (hyp 3) rl lhs true ())
                                      (rewrite (premise 0) lr lhs true ()))
                                     refl))
                                 (have hihr
                                   (=
                                     (xlq_wv f2 m (XQS rest) rs2 xs2 mem2 w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQS rest) rs2 xs2 mem2)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hokr) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute lhs (stop xveval_seq wveval_seq))
                                    (compute rhs (stop xveval_seq wvlift_p))
                                    (rewrite (premise hwr) rl lhs true ())
                                    (rewrite (premise hihr) lr lhs true ())
                                    (rewrite (premise hvr) lr lhs true ())
                                    (unfold wvlift_p rhs)
                                    (reduce rhs)
                                    (unfold wvlift_p lhs)
                                    (reduce lhs)))
                                 (case-on (xveval_seq f2 m rest rs2 xs2 mem2)
                                   Option
                                   ((case None
                                      (steps
                                        ((rewrite (hyp 0) lr both true ())
                                         (compute both))
                                        refl))
                                    (case Some
                                      (out2)
                                      (case-on out2 XVOut
                                        ((case XVNorm
                                           (rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVBrk
                                           (rd1 rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVRetO
                                           (rr1 rx1 rm1)
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl))
                                         (case XVTrap
                                           (steps
                                             ((rewrite (hyp 1) lr both true ())
                                              (rewrite (hyp 0) lr both true ())
                                              (compute both))
                                             refl)))))))))
                             (case XVBrk
                               (d2 rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv (xlq_xv f2 m (XQI i) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQI i) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQI i) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XVRetO
                               (rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv (xlq_xv f2 m (XQI i) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQI i) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQI i) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XVTrap
                               (chain
                                 (have hx (= False True)
                                   (steps
                                     ((rewrite (premise 0) rl rhs true ())
                                      (rewrite (hyp 3) lr rhs true ())
                                      (rewrite (hyp 2) lr rhs true ())
                                      (compute rhs (stop xveval_instr))
                                      (rewrite (hyp 1) lr rhs true ())
                                      (rewrite (hyp 0) lr rhs true ())
                                      (compute rhs))
                                     refl))
                                 (absurd (premise hx)))))))))))))))))))))

;; --- THE WORLD ADEQUACY (WADEQ) ----------------------------------------------
;;
;; Statically call/effect-free code (the xwv scan COMPLETES and answers
;; False) runs at the world tier exactly as at the base, unconditionally:
;; the world rides past untouched, no events, traps included. This is the
;; theorem the model files' "towers agree arm-by-arm" comments promise,
;; and WEMBED's budget-disagreement corner consumes it.

(claim xlk_adeq
  (goal ((fuel Nat) (m XModule) (q XQ) (rs Regs) (mem Mem) (w LxWorld) (d Nat))
    ((= (xlkp_q d q) False))
    (= (xlq_w fuel m q rs mem w) (wlift w (xlq_x fuel m q rs mem))))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (lr1 lv)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (lr1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (ld la)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XStore8
                   (la ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBlock
                   (body)
                   (case-on d Nat
                     ((case Z
                        (chain
                          (have hx (= False True)
                            (steps
                              ((rewrite (premise 0) rl lhs true ())
                               (rewrite (hyp 2) lr lhs true ())
                               (rewrite (hyp 1) lr lhs true ())
                               (rewrite (hyp 0) lr lhs true ())
                               (compute lhs))
                              refl))
                          (absurd (premise hx))))
                      (case S
                        (d2)
                        (chain
                          (have hpa
                            (=
                              (xlkp_q (S d2) (XQI (XBlock body)))
                              (xwv_l d2 body))
                            (steps
                              ((unfold xlkp_q lhs)
                               (reduce lhs)
                               (unfold xwv_i lhs)
                               (reduce lhs))
                              refl))
                          (have hsub (= (xwv_l d2 body) False)
                            (steps
                              ((rewrite (premise hpa) rl lhs true ())
                               (rewrite (hyp 1) rl lhs true ())
                               (rewrite (hyp 2) rl lhs true ())
                               (rewrite (hyp 0) rl lhs true ())
                               (rewrite (premise 0) lr lhs true ()))
                              refl))
                          (have hqs (= (xlkp_q d2 (XQS body)) (xwv_l d2 body))
                            (steps ((unfold xlkp_q lhs) (reduce lhs)) refl))
                          (have hxa
                            (=
                              (xlq_x f2 m (XQS body) rs mem)
                              (xeval_seq f2 m body rs mem))
                            (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                          (have hwa
                            (=
                              (xlq_w f2 m (XQS body) rs mem w)
                              (weval_seq f2 m body rs mem w))
                            (steps ((unfold xlq_w lhs) (reduce lhs)) refl))
                          (have hih
                            (=
                              (xlq_w f2 m (XQS body) rs mem w)
                              (wlift w (xlq_x f2 m (XQS body) rs mem)))
                            (rewrite-with
                              (hyp 3)
                              lr
                              lhs
                              ((inst d d2))
                              ((steps
                                 ((rewrite (premise hqs) lr lhs true ())
                                  (rewrite (premise hsub) lr lhs true ()))
                                 refl))
                              refl))
                          (steps
                            ((rewrite (hyp 1) lr both true ())
                             (compute both (stop xeval_seq weval_seq))
                             (rewrite (premise hwa) rl lhs true ())
                             (rewrite (premise hih) lr lhs true ())
                             (rewrite (premise hxa) lr lhs true ())))
                          (case-on (xeval_seq f2 m body rs mem) Option
                            ((case None
                               (steps
                                 ((rewrite (hyp 0) lr both true ())
                                  (compute both))
                                 refl))
                             (case Some
                               (out)
                               (case-on out XOut
                                 ((case XNorm
                                    (rs2 mem2)
                                    (steps
                                      ((rewrite (hyp 1) lr both true ())
                                       (rewrite (hyp 0) lr both true ())
                                       (compute both))
                                      refl))
                                  (case XBrk
                                    (d3 rs2 mem2)
                                    (chain
                                      (steps
                                        ((rewrite (hyp 1) lr both true ())
                                         (rewrite (hyp 0) lr both true ())
                                         (compute both)))
                                      (case-on (int_eq d3 0) Bool
                                        ((case True
                                           (steps
                                             ((rewrite
                                                (hyp True)
                                                lr
                                                both
                                                true
                                                ())
                                              (compute both))
                                             refl))
