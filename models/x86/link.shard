                              (unfold xlq_xv lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_xv (S f2) m1 (XQI (XShlI a1 a2)) rs xs mem)
                             (xveval_instr (S f2) m1 (XShlI a1 a2) rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XShrI
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XShrI a1 a2))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XShrI a1 a2)))
                           rs
