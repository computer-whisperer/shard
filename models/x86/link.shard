                                   (rewrite (premise ha1) rl rhs true ())
                                   (rewrite (premise hih) lr lhs true ()))
                                  refl)))
                            (steps
                              ((rewrite (premise heng) lr lhs true ()))
                              refl)))))))))))
          (case XQB
            (body)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlq_wv lhs)
                 (reduce lhs)
                 (unfold wveval_loop lhs)
                 (reduce lhs)
                 (unfold xlq_wv rhs)
                 (reduce rhs)
                 (unfold wveval_loop rhs)
                 (reduce rhs)))
              (have hcb (= (xlk_cbq fs (XQS body)) True)
                (steps
                  ((rewrite (premise 2) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both (stop xlk_cbl)))
                  refl))
              (have hih
                (=
                  (xlq_wv f2 m2 (XQS body) rs xs mem w)
                  (xlq_wv f2 m1 (XQS body) rs xs mem w))
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ((inst m1 m1)
                   (inst fs fs)
                   (inst ext ext)
                   (inst lo lo)
                   (inst hi hi))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                   (steps ((rewrite (premise 3) lr lhs true ())) refl))
                  refl))
              (have heng
                (=
                  (wveval_seq f2 m2 body rs xs mem w)
