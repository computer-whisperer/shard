;; --- THE WORLD->WORLD-VECTOR EMBEDDING (WEMBED) ------------------------------
;;
;; THE SLICE-B CROSSING: a non-trapping world-scalar walk is run by the
;; world-vector tier identically, the XMM file riding past untouched.
;; This is what carries the scalar streaming bin's entry equations into
;; the tier the merged dispatch bin lives at (B6, STREAM.md 9). The QC
;; dispatch grid (xfn_eff x xwv_fn x xvec_fn budget disagreements) closes
;; by citing xlk_embx, xlk_embp, xlk_adeq, and xlk_lifts.

(claim xlk_embw
  (goal
    ((fuel Nat) (m XModule) (q XQ) (rs Regs) (xs Xmms) (mem Mem) (w LxWorld))
    ((= (xlk_okw (xlq_w fuel m q rs mem w)) True))
    (= (xlq_wv fuel m q rs xs mem w) (wvlift xs (xlq_w fuel m q rs mem w))))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (lr1 lv)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XMovRI lr1 lv) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XMovRI lr1 lv) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XMovRR
                   (ld ls)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XMovRR ld ls) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XMovRR ld ls) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XBin
                   (lo ld ls)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XBin lo ld ls) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XBin lo ld ls) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XShlI
                   (ld lk)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XShlI ld lk) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XShlI ld lk) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XShrI
                   (ld lk)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XShrI ld lk) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XShrI ld lk) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XBin32
                   (lo ld ls)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XBin32 lo ld ls) rs mem w)
                         (wlift
                           w
                           (xeval_instr (S f2) m (XBin32 lo ld ls) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XShlI32
                   (ld lk)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XShlI32 ld lk) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XShlI32 ld lk) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XMovRR32
                   (ld ls)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XMovRR32 ld ls) rs mem w)
                         (wlift
                           w
                           (xeval_instr (S f2) m (XMovRR32 ld ls) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XRorI32
                   (ld lk)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XRorI32 ld lk) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XRorI32 ld lk) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XDivU
                   (lr1)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XDivU lr1) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XDivU lr1) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XLoad8
                   (ld la)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XLoad8 ld la) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XLoad8 ld la) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XStore8
                   (la ls)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XStore8 la ls) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XStore8 la ls) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XBlock
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hwa
                       (=
                         (xlq_w f2 m (XQS body) rs mem w)
                         (weval_seq f2 m body rs mem w))
                       (steps ((unfold xlq_w lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_wv f2 m (XQS body) rs xs mem w)
                         (wveval_seq f2 m body rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (steps ((compute both (stop weval_seq wveval_seq))))
                     (case-on (weval_seq f2 m body rs mem w) Option
                       ((case None
                          (chain
                            (have hok
                              (=
                                (xlk_okw (xlq_w f2 m (XQS body) rs mem w))
                                True)
                              (steps
                                ((rewrite (premise hwa) lr lhs true ())
                                 (rewrite (hyp 0) lr lhs true ())
                                 (compute lhs))
                                refl))
                            (have hih
                              (=
                                (xlq_wv f2 m (XQS body) rs xs mem w)
                                (wvlift xs (xlq_w f2 m (XQS body) rs mem w)))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
                                ()
                                ((steps
                                   ((rewrite (premise hok) lr lhs true ()))
                                   refl))
                                refl))
                            (steps
                              ((rewrite (premise hva) rl lhs true ())
                               (rewrite (premise hih) lr lhs true ())
                               (rewrite (premise hwa) lr lhs true ())
                               (rewrite (hyp 0) lr both true ())
                               (compute both))
                              refl)))
                        (case Some
                          (out)
                          (case-on out WOut
                            ((case WNorm
                               (rs2 mem2 w2 tr)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okw (xlq_w f2 m (XQS body) rs mem w))
                                     True)
                                   (steps
                                     ((rewrite (premise hwa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift
                                       xs
                                       (xlq_w f2 m (XQS body) rs mem w)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hwa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case WBrk
                               (d2 rs2 mem2 w2 tr)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okw (xlq_w f2 m (XQS body) rs mem w))
                                     True)
                                   (steps
                                     ((rewrite (premise hwa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift
                                       xs
                                       (xlq_w f2 m (XQS body) rs mem w)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hwa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both)))
                                 (case-on (int_eq d2 0) Bool
                                   ((case True
                                      (steps
                                        ((rewrite (hyp True) lr both true ())
                                         (compute both))
                                        refl))
                                    (case False
                                      (steps
                                        ((rewrite (hyp False) lr both true ())
                                         (compute both))
                                        refl))))))
                             (case WRetO
                               (rs2 mem2 w2 tr)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okw (xlq_w f2 m (XQS body) rs mem w))
                                     True)
                                   (steps
                                     ((rewrite (premise hwa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift
                                       xs
                                       (xlq_w f2 m (XQS body) rs mem w)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hwa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case WExit
                               (c2 tr)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okw (xlq_w f2 m (XQS body) rs mem w))
                                     True)
                                   (steps
                                     ((rewrite (premise hwa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift
                                       xs
                                       (xlq_w f2 m (XQS body) rs mem w)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hwa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case WTrap
                               (chain
                                 (have hx (= False True)
                                   (steps
                                     ((rewrite (premise 0) rl rhs true ())
                                      (rewrite (hyp 3) lr rhs true ())
                                      (rewrite (hyp 2) lr rhs true ())
                                      (compute rhs (stop weval_seq))
                                      (rewrite (hyp 1) lr rhs true ())
                                      (rewrite (hyp 0) lr rhs true ())
                                      (compute rhs))
                                     refl))
                                 (absurd (premise hx)))))))))))
                 (case XLoop
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hwi2
                       (=
                         (xlq_w (S f2) m (XQI (XLoop body)) rs mem w)
                         (weval_loop f2 m body rs mem w))
                       (steps
                         ((unfold xlq_w lhs)
                          (reduce lhs)
                          (unfold weval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hwa
                       (=
                         (xlq_w f2 m (XQB body) rs mem w)
                         (weval_loop f2 m body rs mem w))
                       (steps ((unfold xlq_w lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_wv f2 m (XQB body) rs xs mem w)
                         (wveval_loop f2 m body rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (have hok
                       (= (xlk_okw (xlq_w f2 m (XQB body) rs mem w)) True)
                       (steps
                         ((rewrite (premise hwa) lr lhs true ())
                          (rewrite (premise hwi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_wv f2 m (XQB body) rs xs mem w)
                         (wvlift xs (xlq_w f2 m (XQB body) rs mem w)))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hok) lr lhs true ())) refl))
                         refl))
                     (steps
                       ((compute both (stop weval_loop wveval_loop wvlift))
                        (rewrite (premise hva) rl lhs true ())
                        (rewrite (premise hih) lr lhs true ())
                        (rewrite (premise hwa) lr lhs true ()))
                       refl)))
                 (case XBr
                   (ld)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XBr ld) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XBr ld) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XBrIf
                   (lc ld)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m (XBrIf lc ld) rs mem w)
                         (wlift w (xeval_instr (S f2) m (XBrIf lc ld) rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XCall
                   (k2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hwi2
                       (=
                         (xlq_w (S f2) m (XQI (XCall k2)) rs mem w)
                         (weval_call f2 m k2 rs mem w))
                       (steps
                         ((unfold xlq_w lhs)
                          (reduce lhs)
                          (unfold weval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hwa
                       (=
                         (xlq_w f2 m (XQC k2) rs mem w)
                         (weval_call f2 m k2 rs mem w))
                       (steps ((unfold xlq_w lhs) (reduce lhs)) refl))
                     (have hva
                       (=
                         (xlq_wv f2 m (XQC k2) rs xs mem w)
                         (wveval_call f2 m k2 rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (have hok (= (xlk_okw (xlq_w f2 m (XQC k2) rs mem w)) True)
                       (steps
                         ((rewrite (premise hwa) lr lhs true ())
                          (rewrite (premise hwi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_wv f2 m (XQC k2) rs xs mem w)
                         (wvlift xs (xlq_w f2 m (XQC k2) rs mem w)))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hok) lr lhs true ())) refl))
                         refl))
                     (steps
                       ((compute both (stop weval_call wveval_call wvlift))
                        (rewrite (premise hva) rl lhs true ())
                        (rewrite (premise hih) lr lhs true ())
                        (rewrite (premise hwa) lr lhs true ()))
                       refl)))
                 (case XRet
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hfold
                       (=
                         (weval_instr (S f2) m XRet rs mem w)
                         (wlift w (xeval_instr (S f2) m XRet rs mem)))
                       (steps
                         ((unfold weval_instr lhs)
                          (reduce lhs)
                          (unfold wlift rhs)
                          (reduce rhs))
                         refl))
                     (steps
                       ((compute lhs (stop xeval_instr xvlift wvlift_p))
                        (unfold xlq_w rhs)
                        (reduce rhs)
                        (rewrite (premise hfold) lr rhs true ())))
                     (rewrite-with (lemma xlk_lifts) rl rhs () () refl)))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (compute lhs (stop wsyscall wvlift))
                      (unfold xlq_w rhs)
                      (reduce rhs)
                      (unfold weval_instr rhs)
                      (reduce rhs))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ())
                      (compute lhs (stop wcpuid wvlift))
                      (unfold xlq_w rhs)
                      (reduce rhs)
                      (unfold weval_instr rhs)
                      (reduce rhs))
                     refl))
                 (case XVec
                   (vv)
                   (chain
                     (have hx (= False True)
                       (steps
                         ((rewrite (premise 0) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute rhs))
                         refl))
                     (absurd (premise hx))))))))
          (case XQC
