                             (xlq_xv (S f2) m1 (XQI XRet) rs xs mem)
                             (xveval_instr (S f2) m1 XRet rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XVec
                   (v)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XVec v))) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv (S f2) m2 (XQI (XVec v)) rs xs mem)
                         (xlq_xv (S f2) m1 (XQI (XVec v)) rs xs mem))
                       (rewrite-with
                         (lemma xlk_extv)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xveval_instr (S f2) m2 (XVec v) rs xs mem)
                         (xveval_instr (S f2) m1 (XVec v) rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv (S f2) m2 (XQI (XVec v)) rs xs mem)
                             (xveval_instr (S f2) m2 (XVec v) rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
