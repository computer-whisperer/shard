                             (xeval_instr (S f2) m1 XSyscall rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XCpuid
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI XCpuid)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_x (S f2) m2 (xlk_shq d (XQI XCpuid)) rs mem)
                         (xlq_x (S f2) m1 (XQI XCpuid) rs mem))
                       (rewrite-with
                         (lemma xlk_shx)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xeval_instr (S f2) m2 XCpuid rs mem)
                         (xeval_instr (S f2) m1 XCpuid rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x (S f2) m2 (xlk_shq d (XQI XCpuid)) rs mem)
                             (xeval_instr (S f2) m2 XCpuid rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlk_shi lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x (S f2) m1 (XQI XCpuid) rs mem)
                             (xeval_instr (S f2) m1 XCpuid rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XVec
                   (v)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (case-on v XVInstr
                       ((case XVLoad
                          (va vb)
                          (chain
                            (steps ((rewrite (hyp 0) lr both true ())))
                            (steps
                              ((unfold xlk_shq lhs)
                               (reduce lhs)
                               (unfold xlk_shi lhs)
                               (reduce lhs)
                               (unfold xlq_xv lhs)
                               (reduce lhs)
                               (unfold xveval_instr lhs)
                               (reduce lhs)
                               (unfold xlq_xv rhs)
                               (reduce rhs)
                               (unfold xveval_instr rhs)
                               (reduce rhs)))
                            (steps ((compute both (stop xmemhi_of xmemlo_of))))
                            (have hlo2 (= (xmemlo_of m2) lo)
                              (steps
                                ((rewrite (premise 1) lr lhs true ())
                                 (unfold xmemlo_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hlo1 (= (xmemlo_of m1) lo)
                              (steps
                                ((rewrite (premise 0) lr lhs true ())
                                 (unfold xmemlo_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hhi2 (= (xmemhi_of m2) hi)
                              (steps
                                ((rewrite (premise 1) lr lhs true ())
                                 (unfold xmemhi_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hhi1 (= (xmemhi_of m1) hi)
                              (steps
                                ((rewrite (premise 0) lr lhs true ())
                                 (unfold xmemhi_of lhs)
                                 (reduce lhs))
                                refl))
                            (steps
                              ((rewrite (premise hlo2) lr lhs true ())
                               (rewrite (premise hlo1) lr rhs true ())
                               (rewrite (premise hhi2) lr lhs true ())
                               (rewrite (premise hhi1) lr rhs true ()))
                              refl)))
                        (case XVStore
                          (va vb)
                          (chain
                            (steps ((rewrite (hyp 0) lr both true ())))
                            (steps
                              ((unfold xlk_shq lhs)
                               (reduce lhs)
                               (unfold xlk_shi lhs)
                               (reduce lhs)
                               (unfold xlq_xv lhs)
                               (reduce lhs)
                               (unfold xveval_instr lhs)
                               (reduce lhs)
                               (unfold xlq_xv rhs)
                               (reduce rhs)
                               (unfold xveval_instr rhs)
                               (reduce rhs)))
                            (steps ((compute both (stop xmemhi_of xmemlo_of))))
                            (have hlo2 (= (xmemlo_of m2) lo)
                              (steps
                                ((rewrite (premise 1) lr lhs true ())
                                 (unfold xmemlo_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hlo1 (= (xmemlo_of m1) lo)
                              (steps
                                ((rewrite (premise 0) lr lhs true ())
                                 (unfold xmemlo_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hhi2 (= (xmemhi_of m2) hi)
                              (steps
                                ((rewrite (premise 1) lr lhs true ())
                                 (unfold xmemhi_of lhs)
                                 (reduce lhs))
                                refl))
                            (have hhi1 (= (xmemhi_of m1) hi)
                              (steps
                                ((rewrite (premise 0) lr lhs true ())
                                 (unfold xmemhi_of lhs)
                                 (reduce lhs))
                                refl))
                            (steps
                              ((rewrite (premise hlo2) lr lhs true ())
                               (rewrite (premise hlo1) lr rhs true ())
                               (rewrite (premise hhi2) lr lhs true ())
                               (rewrite (premise hhi1) lr rhs true ()))
                              refl)))
                        (case XVMov
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVPshufd
                          (va vb vc)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVBswap32
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVPaddd
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVPalignr
                          (va vb vc)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVPunpckL
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVPunpckH
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVSha256Rnds2
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVSha256Msg1
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVSha256Msg2
                          (va vb)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQC
            (k)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlk_shq lhs)
                 (reduce lhs)
                 (unfold xlq_xv lhs)
                 (reduce lhs)
                 (unfold xveval_call lhs)
                 (reduce lhs)
                 (unfold xlq_xv rhs)
                 (reduce rhs)
                 (unfold xveval_call rhs)
                 (reduce rhs)))
              (have hfns2
                (= (xfuncs_of m2) (xlk_app pre (xlk_app (xlk_shfns d fs) post)))
                (steps
                  ((rewrite (premise 1) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hfns1 (= (xfuncs_of m1) fs)
                (steps
                  ((rewrite (premise 0) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hres (= (xlk_isf (xfunc_at fs k)) True)
                (steps
                  ((rewrite (premise 3) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both))
                  refl))
              (have hk0 (= (le 0 k) True)
                (rewrite-with
                  (lemma xlk_at_nonneg)
                  lr
                  lhs
                  ((inst gs fs))
                  ((steps ((rewrite (premise hres) lr lhs true ())) refl))
                  refl))
              (have hidx (= (+ k d) (+ (xlk_len pre) k))
                (chain
                  (steps ((rewrite (premise 2) lr lhs true ())))
                  (by arith (list))))
              (have hskip
                (=
                  (xfunc_at
                    (xlk_app pre (xlk_app (xlk_shfns d fs) post))
                    (+ (xlk_len pre) k))
                  (xfunc_at (xlk_app (xlk_shfns d fs) post) k))
                (rewrite-with
                  (lemma xlk_at_skip)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hk0) lr lhs true ())) refl))
                  refl))
              (have hsh
                (=
                  (xfunc_at (xlk_shfns d fs) k)
                  (match (xfunc_at fs k)
                    (None None)
                    ((Some f) (Some (xlk_shf d f)))))
                (rewrite-with (lemma xlk_at_sh) lr lhs () () refl))
              (steps
                ((rewrite (premise hfns2) lr lhs true ())
                 (rewrite (premise hidx) lr lhs true ())
                 (rewrite (premise hskip) lr lhs true ())
                 (rewrite (premise hfns1) lr rhs true ())))
              (case-on (xfunc_at fs k) Option
                ((case None
                   (chain
                     (have hx (= False True)
                       (steps
                         ((rewrite (premise hres) rl rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute rhs))
                         refl))
                     (absurd (premise hx))))
                 (case Some
                   (f)
                   (chain
                     (have hressh
                       (= (xlk_isf (xfunc_at (xlk_shfns d fs) k)) True)
                       (steps
                         ((rewrite (premise hsh) lr lhs true ())
                          (rewrite (hyp 0) lr lhs true ())
                          (compute lhs (stop xlk_shf)))
                         refl))
                     (have happ
                       (=
                         (xfunc_at (xlk_app (xlk_shfns d fs) post) k)
                         (xfunc_at (xlk_shfns d fs) k))
                       (rewrite-with
                         (lemma xlk_at_app)
                         lr
                         lhs
                         ()
                         ((steps
                            ((rewrite (premise hressh) lr lhs true ()))
                            refl))
                         refl))
                     (have hlook
                       (=
                         (xfunc_at (xlk_app (xlk_shfns d fs) post) k)
                         (Some (xlk_shf d f)))
                       (steps
                         ((rewrite (premise happ) lr lhs true ())
                          (rewrite (premise hsh) lr lhs true ())
                          (rewrite (hyp 0) lr lhs true ())
                          (compute lhs (stop xlk_shf)))
                         refl))
                     (steps
                       ((rewrite (premise hlook) lr lhs true ())
                        (rewrite (hyp 0) lr rhs true ())
                        (reduce both)))
                     (have hgd
                       (=
                         (xvec_fn (xvec_budget) (xlk_shf d f))
                         (xvec_fn (xvec_budget) f))
                       (rewrite-with (lemma xlk_scv_fn) lr lhs () () refl))
                     (steps ((rewrite (premise hgd) lr lhs true ())))
                     (case-on (xvec_fn (xvec_budget) f) Bool
                       ((case False
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (have hcbc (= (xlk_cbq fs (XQC k)) True)
                              (steps
                                ((compute lhs (stop xlk_isf xfunc_at))
                                 (rewrite (premise hres) lr lhs true ()))
                                refl))
                            (have hdel
                              (=
                                (xlq_x (S f2) m2 (xlk_shq d (XQC k)) rs mem)
                                (xlq_x (S f2) m1 (XQC k) rs mem))
                              (rewrite-with
                                (lemma xlk_shx)
                                lr
                                lhs
                                ((inst m1 m1)
                                 (inst fs fs)
                                 (inst pre pre)
                                 (inst post post)
                                 (inst lo lo)
                                 (inst hi hi))
                                ((steps
                                   ((rewrite (premise 0) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 1) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 2) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise hcbc) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 4) lr lhs true ()))
                                   refl))
                                refl))
                            (have hdeng
                              (=
                                (xeval_call
                                  (S f2)
                                  m2
                                  (+ (xlk_len pre) k)
                                  rs
                                  mem)
                                (xeval_call (S f2) m1 k rs mem))
                              (chain
                                (have ha2
                                  (=
                                    (xlq_x (S f2) m2 (xlk_shq d (XQC k)) rs mem)
                                    (xeval_call
                                      (S f2)
                                      m2
                                      (+ (xlk_len pre) k)
                                      rs
                                      mem))
                                  (steps
                                    ((unfold xlk_shq lhs)
                                     (reduce lhs)
                                     (unfold xlq_x lhs)
                                     (reduce lhs)
                                     (rewrite (premise hidx) lr lhs true ()))
                                    refl))
                                (have ha1
                                  (=
                                    (xlq_x (S f2) m1 (XQC k) rs mem)
                                    (xeval_call (S f2) m1 k rs mem))
                                  (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                                (steps
                                  ((rewrite (premise ha2) rl lhs true ())
                                   (rewrite (premise ha1) rl rhs true ())
                                   (rewrite (premise hdel) lr lhs true ()))
                                  refl)))
                            (steps
                              ((rewrite (premise hdeng) lr lhs true ()))
                              refl)))
                        (case True
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on f XFunc
                              ((case MkXFunc
                                 (fp fb)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (unfold xlk_shf lhs)
                                      (reduce lhs)
                                      (unfold xbody_of lhs)
                                      (reduce lhs)
                                      (unfold xbody_of rhs)
                                      (reduce rhs)))
                                   (have hcb (= (xlk_cbq fs (XQS fb)) True)
                                     (chain
                                       (steps ((compute lhs (stop xlk_cbl))))
                                       (rewrite-with
                                         (lemma xlk_cbfns_at)
                                         rl
                                         rhs
                                         ((inst fs fs) (inst gs fs) (inst k k))
                                         ((steps
                                            ((rewrite
                                               (premise 4)
                                               lr
                                               lhs
                                               true
                                               ()))
                                            refl)))
                                       (steps
                                         ((rewrite (hyp 2) lr rhs true ())
                                          (rewrite (hyp 0) lr rhs true ())
                                          (reduce rhs)
                                          (unfold xbody_of rhs)
                                          (reduce rhs))
                                         refl)))
                                   (have hih
                                     (=
                                       (xlq_xv
                                         f2
                                         m2
                                         (xlk_shq d (XQS fb))
                                         rs
                                         xs
                                         mem)
                                       (xlq_xv f2 m1 (XQS fb) rs xs mem))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst pre pre)
                                        (inst post post)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 2) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 4) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng
                                     (=
                                       (xveval_seq
                                         f2
                                         m2
                                         (xlk_shl d fb)
                                         rs
                                         xs
                                         mem)
                                       (xveval_seq f2 m1 fb rs xs mem))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_xv
                                             f2
                                             m2
                                             (xlk_shq d (XQS fb))
                                             rs
                                             xs
                                             mem)
                                           (xveval_seq
                                             f2
                                             m2
                                             (xlk_shl d fb)
                                             rs
                                             xs
                                             mem))
                                         (steps
                                           ((unfold xlk_shq lhs)
                                            (reduce lhs)
                                            (unfold xlq_xv lhs)
                                            (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_xv f2 m1 (XQS fb) rs xs mem)
                                           (xveval_seq f2 m1 fb rs xs mem))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise heng) lr lhs true ()))
                                     refl)))))))))))))))
          (case XQB
            (body)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlk_shq lhs)
                 (reduce lhs)
                 (unfold xlq_xv lhs)
                 (reduce lhs)
                 (unfold xveval_loop lhs)
                 (reduce lhs)
                 (unfold xlq_xv rhs)
                 (reduce rhs)
                 (unfold xveval_loop rhs)
                 (reduce rhs)))
              (have hcb (= (xlk_cbq fs (XQS body)) True)
                (steps
                  ((rewrite (premise 3) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both (stop xlk_cbl)))
                  refl))
              (have hih
                (=
                  (xlq_xv f2 m2 (xlk_shq d (XQS body)) rs xs mem)
                  (xlq_xv f2 m1 (XQS body) rs xs mem))
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ((inst m1 m1)
                   (inst fs fs)
                   (inst pre pre)
                   (inst post post)
                   (inst lo lo)
                   (inst hi hi))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl)
                   (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl))
                  refl))
              (have heng
                (=
                  (xveval_seq f2 m2 (xlk_shl d body) rs xs mem)
                  (xveval_seq f2 m1 body rs xs mem))
                (chain
                  (have ha2
                    (=
                      (xlq_xv f2 m2 (xlk_shq d (XQS body)) rs xs mem)
                      (xveval_seq f2 m2 (xlk_shl d body) rs xs mem))
                    (steps
                      ((unfold xlk_shq lhs)
                       (reduce lhs)
                       (unfold xlq_xv lhs)
                       (reduce lhs))
                      refl))
                  (have ha1
                    (=
                      (xlq_xv f2 m1 (XQS body) rs xs mem)
                      (xveval_seq f2 m1 body rs xs mem))
                    (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                  (steps
                    ((rewrite (premise ha2) rl lhs true ())
                     (rewrite (premise ha1) rl rhs true ())
                     (rewrite (premise hih) lr lhs true ()))
                    refl)))
              (steps ((rewrite (premise heng) lr lhs true ())))
              (case-on (xveval_seq f2 m1 body rs xs mem) Option
                ((case None
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Some
                   (out)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ()) (reduce both)))
                     (case-on out XVOut
                       ((case XVNorm
                          (rs2 xs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVBrk
                          (d3 rs2 xs2 mem2)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on (int_eq d3 0) Bool
                              ((case True
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hcbb (= (xlk_cbq fs (XQB body)) True)
                                     (steps
                                       ((rewrite (premise 3) rl rhs true ())
                                        (rewrite (hyp 3) lr rhs true ()))
                                       refl))
                                   (have hih
                                     (=
                                       (xlq_xv
                                         f2
                                         m2
                                         (xlk_shq d (XQB body))
                                         rs2
                                         xs2
                                         mem2)
                                       (xlq_xv f2 m1 (XQB body) rs2 xs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst pre pre)
                                        (inst post post)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 2) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 4) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng2
                                     (=
                                       (xveval_loop
                                         f2
                                         m2
                                         (xlk_shl d body)
                                         rs2
                                         xs2
                                         mem2)
                                       (xveval_loop f2 m1 body rs2 xs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_xv
                                             f2
                                             m2
                                             (xlk_shq d (XQB body))
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_loop
                                             f2
                                             m2
                                             (xlk_shl d body)
                                             rs2
                                             xs2
                                             mem2))
                                         (steps
                                           ((unfold xlk_shq lhs)
                                            (reduce lhs)
                                            (unfold xlq_xv lhs)
                                            (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_xv
                                             f2
                                             m1
                                             (XQB body)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_loop f2 m1 body rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise heng2) lr lhs true ()))
                                     refl)))
                               (case False
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))
                        (case XVRetO
                          (rs2 xs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XVTrap
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shl lhs)
                        (reduce lhs)
                        (unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_seq rhs)
                        (reduce rhs)))
                     (have hcbcons (= (xlk_cbl fs (Cons i2 rest)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hcbh (= (xlk_cbq fs (XQI i2)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbi))))
                         (rewrite-with
                           (lemma xlk_cbl_head)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hcbt (= (xlk_cbq fs (XQS rest)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl))))
                         (rewrite-with
                           (lemma xlk_cbl_tail)
                           lr
                           lhs
                           ((inst i i2))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hih
                       (=
                         (xlq_xv f2 m2 (xlk_shq d (XQI i2)) rs xs mem)
                         (xlq_xv f2 m1 (XQI i2) rs xs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbh) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hinstr
                       (=
                         (xveval_instr f2 m2 (xlk_shi d i2) rs xs mem)
                         (xveval_instr f2 m1 i2 rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv f2 m2 (xlk_shq d (XQI i2)) rs xs mem)
                             (xveval_instr f2 m2 (xlk_shi d i2) rs xs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlq_xv lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_xv f2 m1 (XQI i2) rs xs mem)
                             (xveval_instr f2 m1 i2 rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hinstr) lr lhs true ())))
                     (case-on (xveval_instr f2 m1 i2 rs xs mem) Option
                       ((case None
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case Some
                          (out)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on out XVOut
                              ((case XVNorm
                                 (rs2 xs2 mem2)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hih
                                     (=
                                       (xlq_xv
                                         f2
                                         m2
                                         (xlk_shq d (XQS rest))
                                         rs2
                                         xs2
                                         mem2)
                                       (xlq_xv f2 m1 (XQS rest) rs2 xs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst pre pre)
                                        (inst post post)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 2) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbt)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 4) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have htail
                                     (=
                                       (xveval_seq
                                         f2
                                         m2
                                         (xlk_shl d rest)
                                         rs2
                                         xs2
                                         mem2)
                                       (xveval_seq f2 m1 rest rs2 xs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_xv
                                             f2
                                             m2
                                             (xlk_shq d (XQS rest))
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_seq
                                             f2
                                             m2
                                             (xlk_shl d rest)
                                             rs2
                                             xs2
                                             mem2))
                                         (steps
                                           ((unfold xlk_shq lhs)
                                            (reduce lhs)
                                            (unfold xlq_xv lhs)
                                            (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_xv
                                             f2
                                             m1
                                             (XQS rest)
                                             rs2
                                             xs2
                                             mem2)
                                           (xveval_seq f2 m1 rest rs2 xs2 mem2))
                                         (steps
                                           ((unfold xlq_xv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise htail) lr lhs true ()))
                                     refl)))
                               (case XVBrk
                                 (d3 rs2 xs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XVRetO
                                 (rs2 xs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XVTrap
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))))))))))))))))

(claim xlk_shwv
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (pre (List XFunc))
     (post (List XFunc))
     (d Int)
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (xs Xmms)
     (w LxWorld)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app pre (xlk_app (xlk_shfns d fs) post)) lo hi))
     (= d (xlk_len pre))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (=
      (xlq_wv fuel m2 (xlk_shq d q) rs xs mem w)
      (xlq_wv fuel m1 q rs xs mem w)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRI a1 a2))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_xv
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XMovRI a1 a2)))
                           rs
                           xs
                           mem)
                         (xlq_xv (S f2) m1 (XQI (XMovRI a1 a2)) rs xs mem))
                       (rewrite-with
                         (lemma xlk_shv)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xveval_instr (S f2) m2 (XMovRI a1 a2) rs xs mem)
                         (xveval_instr (S f2) m1 (XMovRI a1 a2) rs xs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_xv
                               (S f2)
                               m2
                               (xlk_shq d (XQI (XMovRI a1 a2)))
                               rs
                               xs
                               mem)
                             (xveval_instr (S f2) m2 (XMovRI a1 a2) rs xs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlk_shi lhs)
                              (reduce lhs)
                              (unfold xlq_xv lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_xv (S f2) m1 (XQI (XMovRI a1 a2)) rs xs mem)
                             (xveval_instr (S f2) m1 (XMovRI a1 a2) rs xs mem))
                           (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XMovRR
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRR a1 a2))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
