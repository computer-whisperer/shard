                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
