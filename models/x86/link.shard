                                   refl))))))
                        (case WVRetO
                          (rs2 xs2 mem2 w2 tr)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case WVExit
                          (c2 tr)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case WVTrap
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlq_wv lhs)
                        (reduce lhs)
                        (unfold wveval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_wv rhs)
                        (reduce rhs)
                        (unfold wveval_seq rhs)
                        (reduce rhs)))
                     (have hcbcons (= (xlk_cbl fs (Cons i2 rest)) True)
                       (steps
                         ((rewrite (premise 2) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hcbh (= (xlk_cbq fs (XQI i2)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbi))))
                         (rewrite-with
                           (lemma xlk_cbl_head)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hcbt (= (xlk_cbq fs (XQS rest)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl))))
                         (rewrite-with
                           (lemma xlk_cbl_tail)
                           lr
                           lhs
                           ((inst i i2))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hih
                       (=
                         (xlq_wv f2 m2 (XQI i2) rs xs mem w)
                         (xlq_wv f2 m1 (XQI i2) rs xs mem w))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst ext ext)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbh) lr lhs true ())) refl)
                          (steps ((rewrite (premise 3) lr lhs true ())) refl))
                         refl))
                     (have hinstr
                       (=
                         (wveval_instr f2 m2 i2 rs xs mem w)
                         (wveval_instr f2 m1 i2 rs xs mem w))
                       (chain
                         (have ha2
                           (=
                             (xlq_wv f2 m2 (XQI i2) rs xs mem w)
                             (wveval_instr f2 m2 i2 rs xs mem w))
                           (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                         (have ha1
                           (=
                             (xlq_wv f2 m1 (XQI i2) rs xs mem w)
                             (wveval_instr f2 m1 i2 rs xs mem w))
                           (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hinstr) lr lhs true ())))
                     (case-on (wveval_instr f2 m1 i2 rs xs mem w) Option
                       ((case None
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case Some
                          (out)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on out WVOut
                              ((case WVNorm
                                 (rs2 xs2 mem2 w2 tr)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hih
                                     (=
                                       (xlq_wv f2 m2 (XQS rest) rs2 xs2 mem2 w2)
                                       (xlq_wv f2 m1 (XQS rest) rs2 xs2 mem2 w2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst ext ext)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbt)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 3) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have htail
                                     (=
                                       (wveval_seq f2 m2 rest rs2 xs2 mem2 w2)
                                       (wveval_seq f2 m1 rest rs2 xs2 mem2 w2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_wv
                                             f2
                                             m2
                                             (XQS rest)
                                             rs2
                                             xs2
                                             mem2
                                             w2)
                                           (wveval_seq f2 m2 rest rs2 xs2 mem2
                                             w2))
                                         (steps
                                           ((unfold xlq_wv lhs) (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_wv
                                             f2
                                             m1
                                             (XQS rest)
                                             rs2
                                             xs2
                                             mem2
                                             w2)
                                           (wveval_seq f2 m1 rest rs2 xs2 mem2
                                             w2))
                                         (steps
                                           ((unfold xlq_wv lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise htail) lr lhs true ()))
                                     refl)))
                               (case WVBrk
                                 (d3 rs2 xs2 mem2 w2 tr)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case WVRetO
                                 (rs2 xs2 mem2 w2 tr)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case WVExit
                                 (c2 tr)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case WVTrap
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))))))))))))))))

;; --- SHIFT -------------------------------------------------------------------
;; Uniformly mapping (XCall k) -> (XCall (k+d)) over a family placed at offset
;; d = len pre preserves walks: the shifted code in the placed module computes
;; exactly what the original code computes in the standalone module.

(claim xlk_shx
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (pre (List XFunc))
     (post (List XFunc))
     (d Int)
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app pre (xlk_app (xlk_shfns d fs) post)) lo hi))
     (= d (xlk_len pre))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (= (xlq_x fuel m2 (xlk_shq d q) rs mem) (xlq_x fuel m1 q rs mem)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (a1 a2 a3)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps ((compute both (stop xmemhi_of xmemlo_of))))
                     (have hlo2 (= (xmemlo_of m2) lo)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hlo1 (= (xmemlo_of m1) lo)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi2 (= (xmemhi_of m2) hi)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi1 (= (xmemhi_of m1) hi)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (steps
                       ((rewrite (premise hlo2) lr lhs true ())
                        (rewrite (premise hlo1) lr rhs true ())
                        (rewrite (premise hhi2) lr lhs true ())
                        (rewrite (premise hhi1) lr rhs true ()))
                       refl)))
                 (case XStore8
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps ((compute both (stop xmemhi_of xmemlo_of))))
                     (have hlo2 (= (xmemlo_of m2) lo)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hlo1 (= (xmemlo_of m1) lo)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemlo_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi2 (= (xmemhi_of m2) hi)
                       (steps
                         ((rewrite (premise 1) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (have hhi1 (= (xmemhi_of m1) hi)
                       (steps
                         ((rewrite (premise 0) lr lhs true ())
                          (unfold xmemhi_of lhs)
                          (reduce lhs))
                         refl))
                     (steps
                       ((rewrite (premise hlo2) lr lhs true ())
                        (rewrite (premise hlo1) lr rhs true ())
                        (rewrite (premise hhi2) lr lhs true ())
                        (rewrite (premise hhi1) lr rhs true ()))
                       refl)))
                 (case XBlock
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQS body)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (xlk_shq d (XQS body)) rs mem)
                         (xlq_x f2 m1 (XQS body) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_seq f2 m2 (xlk_shl d body) rs mem)
                         (xeval_seq f2 m1 body rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (xlk_shq d (XQS body)) rs mem)
                             (xeval_seq f2 m2 (xlk_shl d body) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQS body) rs mem)
                             (xeval_seq f2 m1 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XLoop
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQB body)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (xlk_shq d (XQB body)) rs mem)
                         (xlq_x f2 m1 (XQB body) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_loop f2 m2 (xlk_shl d body) rs mem)
                         (xeval_loop f2 m1 body rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (xlk_shq d (XQB body)) rs mem)
                             (xeval_loop f2 m2 (xlk_shl d body) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQB body) rs mem)
                             (xeval_loop f2 m1 body rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XBr
                   (a1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBrIf
                   (a1 a2)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCall
                   (k2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_instr rhs)
                        (reduce rhs)))
                     (have hcb (= (xlk_cbq fs (XQC k2)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl xfunc_at)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (xlk_shq d (XQC k2)) rs mem)
                         (xlq_x f2 m1 (XQC k2) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have heng
                       (=
                         (xeval_call f2 m2 (+ k2 d) rs mem)
                         (xeval_call f2 m1 k2 rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (xlk_shq d (XQC k2)) rs mem)
                             (xeval_call f2 m2 (+ k2 d) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQC k2) rs mem)
                             (xeval_call f2 m1 k2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise heng) lr lhs true ())) refl)))
                 (case XRet
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XSyscall
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCpuid
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XVec
                   (v)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))))))
          (case XQC
            (k)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlk_shq lhs)
                 (reduce lhs)
                 (unfold xlq_x lhs)
                 (reduce lhs)
                 (unfold xeval_call lhs)
                 (reduce lhs)
                 (unfold xlq_x rhs)
                 (reduce rhs)
                 (unfold xeval_call rhs)
                 (reduce rhs)))
              (have hfns2
                (= (xfuncs_of m2) (xlk_app pre (xlk_app (xlk_shfns d fs) post)))
                (steps
                  ((rewrite (premise 1) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hfns1 (= (xfuncs_of m1) fs)
                (steps
                  ((rewrite (premise 0) lr lhs true ())
                   (unfold xfuncs_of lhs)
                   (reduce lhs))
                  refl))
              (have hres (= (xlk_isf (xfunc_at fs k)) True)
                (steps
                  ((rewrite (premise 3) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both))
                  refl))
              (have hk0 (= (le 0 k) True)
                (rewrite-with
                  (lemma xlk_at_nonneg)
                  lr
                  lhs
                  ((inst gs fs))
                  ((steps ((rewrite (premise hres) lr lhs true ())) refl))
                  refl))
              (have hidx (= (+ k d) (+ (xlk_len pre) k))
                (chain
                  (steps ((rewrite (premise 2) lr lhs true ())))
                  (by arith (list))))
              (have hskip
                (=
                  (xfunc_at
                    (xlk_app pre (xlk_app (xlk_shfns d fs) post))
                    (+ (xlk_len pre) k))
                  (xfunc_at (xlk_app (xlk_shfns d fs) post) k))
                (rewrite-with
                  (lemma xlk_at_skip)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hk0) lr lhs true ())) refl))
                  refl))
              (have hsh
                (=
                  (xfunc_at (xlk_shfns d fs) k)
                  (match (xfunc_at fs k)
                    (None None)
                    ((Some f) (Some (xlk_shf d f)))))
                (rewrite-with (lemma xlk_at_sh) lr lhs () () refl))
              (steps
                ((rewrite (premise hfns2) lr lhs true ())
                 (rewrite (premise hidx) lr lhs true ())
                 (rewrite (premise hskip) lr lhs true ())
                 (rewrite (premise hfns1) lr rhs true ())))
              (case-on (xfunc_at fs k) Option
                ((case None
                   (chain
                     (have hx (= False True)
                       (steps
                         ((rewrite (premise hres) rl rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute rhs))
                         refl))
                     (absurd (premise hx))))
                 (case Some
                   (f)
                   (chain
                     (have hressh
                       (= (xlk_isf (xfunc_at (xlk_shfns d fs) k)) True)
                       (steps
                         ((rewrite (premise hsh) lr lhs true ())
                          (rewrite (hyp 0) lr lhs true ())
                          (compute lhs (stop xlk_shf)))
                         refl))
                     (have happ
                       (=
                         (xfunc_at (xlk_app (xlk_shfns d fs) post) k)
                         (xfunc_at (xlk_shfns d fs) k))
                       (rewrite-with
                         (lemma xlk_at_app)
                         lr
                         lhs
                         ()
                         ((steps
                            ((rewrite (premise hressh) lr lhs true ()))
                            refl))
                         refl))
                     (have hlook
                       (=
                         (xfunc_at (xlk_app (xlk_shfns d fs) post) k)
                         (Some (xlk_shf d f)))
                       (steps
                         ((rewrite (premise happ) lr lhs true ())
                          (rewrite (premise hsh) lr lhs true ())
                          (rewrite (hyp 0) lr lhs true ())
                          (compute lhs (stop xlk_shf)))
                         refl))
                     (steps
                       ((rewrite (premise hlook) lr lhs true ())
                        (rewrite (hyp 0) lr rhs true ())
                        (reduce both)))
                     (case-on f XFunc
                       ((case MkXFunc
                          (fp fb)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ())
                               (unfold xlk_shf lhs)
                               (reduce lhs)
                               (unfold xbody_of lhs)
                               (reduce lhs)
                               (unfold xbody_of rhs)
                               (reduce rhs)))
                            (have hcb (= (xlk_cbq fs (XQS fb)) True)
                              (chain
                                (steps ((compute lhs (stop xlk_cbl))))
                                (rewrite-with
                                  (lemma xlk_cbfns_at)
                                  rl
                                  rhs
                                  ((inst fs fs) (inst gs fs) (inst k k))
                                  ((steps
                                     ((rewrite (premise 4) lr lhs true ()))
                                     refl)))
                                (steps
                                  ((rewrite (hyp 1) lr rhs true ())
                                   (rewrite (hyp 0) lr rhs true ())
                                   (reduce rhs)
                                   (unfold xbody_of rhs)
                                   (reduce rhs))
                                  refl)))
                            (have hih
                              (=
                                (xlq_x f2 m2 (xlk_shq d (XQS fb)) rs mem)
                                (xlq_x f2 m1 (XQS fb) rs mem))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
                                ((inst m1 m1)
                                 (inst fs fs)
                                 (inst pre pre)
                                 (inst post post)
                                 (inst lo lo)
                                 (inst hi hi))
                                ((steps
                                   ((rewrite (premise 0) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 1) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 2) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise hcb) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 4) lr lhs true ()))
                                   refl))
                                refl))
                            (have heng
                              (=
                                (xeval_seq f2 m2 (xlk_shl d fb) rs mem)
                                (xeval_seq f2 m1 fb rs mem))
                              (chain
                                (have ha2
                                  (=
                                    (xlq_x f2 m2 (xlk_shq d (XQS fb)) rs mem)
                                    (xeval_seq f2 m2 (xlk_shl d fb) rs mem))
                                  (steps
                                    ((unfold xlk_shq lhs)
                                     (reduce lhs)
                                     (unfold xlq_x lhs)
                                     (reduce lhs))
                                    refl))
                                (have ha1
                                  (=
                                    (xlq_x f2 m1 (XQS fb) rs mem)
                                    (xeval_seq f2 m1 fb rs mem))
                                  (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                                (steps
                                  ((rewrite (premise ha2) rl lhs true ())
                                   (rewrite (premise ha1) rl rhs true ())
                                   (rewrite (premise hih) lr lhs true ()))
                                  refl)))
                            (steps
                              ((rewrite (premise heng) lr lhs true ()))
                              refl)))))))))))
          (case XQB
            (body)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (steps
                ((unfold xlk_shq lhs)
                 (reduce lhs)
                 (unfold xlq_x lhs)
                 (reduce lhs)
                 (unfold xeval_loop lhs)
                 (reduce lhs)
                 (unfold xlq_x rhs)
                 (reduce rhs)
                 (unfold xeval_loop rhs)
                 (reduce rhs)))
              (have hcb (= (xlk_cbq fs (XQS body)) True)
                (steps
                  ((rewrite (premise 3) rl rhs true ())
                   (rewrite (hyp 0) lr rhs true ())
                   (compute both (stop xlk_cbl)))
                  refl))
              (have hih
                (=
                  (xlq_x f2 m2 (xlk_shq d (XQS body)) rs mem)
                  (xlq_x f2 m1 (XQS body) rs mem))
                (rewrite-with
                  (hyp 1)
                  lr
                  lhs
                  ((inst m1 m1)
                   (inst fs fs)
                   (inst pre pre)
                   (inst post post)
                   (inst lo lo)
                   (inst hi hi))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise 1) lr lhs true ())) refl)
                   (steps ((rewrite (premise 2) lr lhs true ())) refl)
                   (steps ((rewrite (premise hcb) lr lhs true ())) refl)
                   (steps ((rewrite (premise 4) lr lhs true ())) refl))
                  refl))
              (have heng
                (=
                  (xeval_seq f2 m2 (xlk_shl d body) rs mem)
                  (xeval_seq f2 m1 body rs mem))
                (chain
                  (have ha2
                    (=
                      (xlq_x f2 m2 (xlk_shq d (XQS body)) rs mem)
                      (xeval_seq f2 m2 (xlk_shl d body) rs mem))
                    (steps
                      ((unfold xlk_shq lhs)
                       (reduce lhs)
                       (unfold xlq_x lhs)
                       (reduce lhs))
                      refl))
                  (have ha1
                    (=
                      (xlq_x f2 m1 (XQS body) rs mem)
                      (xeval_seq f2 m1 body rs mem))
                    (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                  (steps
                    ((rewrite (premise ha2) rl lhs true ())
                     (rewrite (premise ha1) rl rhs true ())
                     (rewrite (premise hih) lr lhs true ()))
                    refl)))
              (steps ((rewrite (premise heng) lr lhs true ())))
              (case-on (xeval_seq f2 m1 body rs mem) Option
                ((case None
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Some
                   (out)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ()) (reduce both)))
                     (case-on out XOut
                       ((case XNorm
                          (rs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XBrk
                          (d3 rs2 mem2)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on (int_eq d3 0) Bool
                              ((case True
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hcbb (= (xlk_cbq fs (XQB body)) True)
                                     (steps
                                       ((rewrite (premise 3) rl rhs true ())
                                        (rewrite (hyp 3) lr rhs true ()))
                                       refl))
                                   (have hih
                                     (=
                                       (xlq_x
                                         f2
                                         m2
                                         (xlk_shq d (XQB body))
                                         rs2
                                         mem2)
                                       (xlq_x f2 m1 (XQB body) rs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst pre pre)
                                        (inst post post)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 2) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbb)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 4) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have heng2
                                     (=
                                       (xeval_loop
                                         f2
                                         m2
                                         (xlk_shl d body)
                                         rs2
                                         mem2)
                                       (xeval_loop f2 m1 body rs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_x
                                             f2
                                             m2
                                             (xlk_shq d (XQB body))
                                             rs2
                                             mem2)
                                           (xeval_loop
                                             f2
                                             m2
                                             (xlk_shl d body)
                                             rs2
                                             mem2))
                                         (steps
                                           ((unfold xlk_shq lhs)
                                            (reduce lhs)
                                            (unfold xlq_x lhs)
                                            (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_x f2 m1 (XQB body) rs2 mem2)
                                           (xeval_loop f2 m1 body rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise heng2) lr lhs true ()))
                                     refl)))
                               (case False
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))
                        (case XRetO
                          (rs2 mem2)
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case XTrap
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))))))))))
          (case XQS
            (is2)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on is2 List
                ((case Nil
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case Cons
                   (i2 rest)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shl lhs)
                        (reduce lhs)
                        (unfold xlq_x lhs)
                        (reduce lhs)
                        (unfold xeval_seq lhs)
                        (reduce lhs)
                        (unfold xlq_x rhs)
                        (reduce rhs)
                        (unfold xeval_seq rhs)
                        (reduce rhs)))
                     (have hcbcons (= (xlk_cbl fs (Cons i2 rest)) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute both (stop xlk_cbl)))
                         refl))
                     (have hcbh (= (xlk_cbq fs (XQI i2)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbi))))
                         (rewrite-with
                           (lemma xlk_cbl_head)
                           lr
                           lhs
                           ((inst rest rest))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hcbt (= (xlk_cbq fs (XQS rest)) True)
                       (chain
                         (steps ((compute lhs (stop xlk_cbl))))
                         (rewrite-with
                           (lemma xlk_cbl_tail)
                           lr
                           lhs
                           ((inst i i2))
                           ((steps
                              ((rewrite (premise hcbcons) lr lhs true ()))
                              refl)))
                         refl))
                     (have hih
                       (=
                         (xlq_x f2 m2 (xlk_shq d (XQI i2)) rs mem)
                         (xlq_x f2 m1 (XQI i2) rs mem))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbh) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hinstr
                       (=
                         (xeval_instr f2 m2 (xlk_shi d i2) rs mem)
                         (xeval_instr f2 m1 i2 rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x f2 m2 (xlk_shq d (XQI i2)) rs mem)
                             (xeval_instr f2 m2 (xlk_shi d i2) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x f2 m1 (XQI i2) rs mem)
                             (xeval_instr f2 m1 i2 rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hih) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hinstr) lr lhs true ())))
                     (case-on (xeval_instr f2 m1 i2 rs mem) Option
                       ((case None
                          (steps
                            ((rewrite (hyp 0) lr both true ()) (compute both))
                            refl))
                        (case Some
                          (out)
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (case-on out XOut
                              ((case XNorm
                                 (rs2 mem2)
                                 (chain
                                   (steps
                                     ((rewrite (hyp 0) lr both true ())
                                      (reduce both)))
                                   (have hih
                                     (=
                                       (xlq_x
                                         f2
                                         m2
                                         (xlk_shq d (XQS rest))
                                         rs2
                                         mem2)
                                       (xlq_x f2 m1 (XQS rest) rs2 mem2))
                                     (rewrite-with
                                       (hyp 4)
                                       lr
                                       lhs
                                       ((inst m1 m1)
                                        (inst fs fs)
                                        (inst pre pre)
                                        (inst post post)
                                        (inst lo lo)
                                        (inst hi hi))
                                       ((steps
                                          ((rewrite (premise 0) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 1) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 2) lr lhs true ()))
                                          refl)
                                        (steps
                                          ((rewrite
                                             (premise hcbt)
                                             lr
                                             lhs
                                             true
                                             ()))
                                          refl)
                                        (steps
                                          ((rewrite (premise 4) lr lhs true ()))
                                          refl))
                                       refl))
                                   (have htail
                                     (=
                                       (xeval_seq
                                         f2
                                         m2
                                         (xlk_shl d rest)
                                         rs2
                                         mem2)
                                       (xeval_seq f2 m1 rest rs2 mem2))
                                     (chain
                                       (have ha2
                                         (=
                                           (xlq_x
                                             f2
                                             m2
                                             (xlk_shq d (XQS rest))
                                             rs2
                                             mem2)
                                           (xeval_seq
                                             f2
                                             m2
                                             (xlk_shl d rest)
                                             rs2
                                             mem2))
                                         (steps
                                           ((unfold xlk_shq lhs)
                                            (reduce lhs)
                                            (unfold xlq_x lhs)
                                            (reduce lhs))
                                           refl))
                                       (have ha1
                                         (=
                                           (xlq_x f2 m1 (XQS rest) rs2 mem2)
                                           (xeval_seq f2 m1 rest rs2 mem2))
                                         (steps
                                           ((unfold xlq_x lhs) (reduce lhs))
                                           refl))
                                       (steps
                                         ((rewrite (premise ha2) rl lhs true ())
                                          (rewrite (premise ha1) rl rhs true ())
                                          (rewrite (premise hih) lr lhs true ()))
                                         refl)))
                                   (steps
                                     ((rewrite (premise htail) lr lhs true ()))
                                     refl)))
                               (case XBrk
                                 (d3 rs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XRetO
                                 (rs2 mem2)
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))
                               (case XTrap
                                 (steps
                                   ((rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl))))))))))))))))))))

(claim xlk_shv
  (goal
    ((fuel Nat)
     (m1 XModule)
     (m2 XModule)
     (fs (List XFunc))
     (pre (List XFunc))
     (post (List XFunc))
     (d Int)
     (lo Int)
     (hi Int)
     (q XQ)
     (rs Regs)
     (xs Xmms)
     (mem Mem))
    ((= m1 (MkXModule fs lo hi))
     (= m2 (MkXModule (xlk_app pre (xlk_app (xlk_shfns d fs) post)) lo hi))
     (= d (xlk_len pre))
     (= (xlk_cbq fs q) True)
     (= (xlk_cbfns fs fs) True))
    (= (xlq_xv fuel m2 (xlk_shq d q) rs xs mem) (xlq_xv fuel m1 q rs xs mem)))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRI a1 a2))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_x
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XMovRI a1 a2)))
                           rs
                           mem)
                         (xlq_x (S f2) m1 (XQI (XMovRI a1 a2)) rs mem))
                       (rewrite-with
                         (lemma xlk_shx)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xeval_instr (S f2) m2 (XMovRI a1 a2) rs mem)
                         (xeval_instr (S f2) m1 (XMovRI a1 a2) rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x
                               (S f2)
                               m2
                               (xlk_shq d (XQI (XMovRI a1 a2)))
                               rs
                               mem)
                             (xeval_instr (S f2) m2 (XMovRI a1 a2) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlk_shi lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x (S f2) m1 (XQI (XMovRI a1 a2)) rs mem)
                             (xeval_instr (S f2) m1 (XMovRI a1 a2) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XMovRR
                   (a1 a2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XMovRR a1 a2))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_x
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XMovRR a1 a2)))
                           rs
                           mem)
                         (xlq_x (S f2) m1 (XQI (XMovRR a1 a2)) rs mem))
                       (rewrite-with
                         (lemma xlk_shx)
                         lr
                         lhs
                         ((inst m1 m1)
                          (inst fs fs)
                          (inst pre pre)
                          (inst post post)
                          (inst lo lo)
                          (inst hi hi))
                         ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                          (steps ((rewrite (premise 1) lr lhs true ())) refl)
                          (steps ((rewrite (premise 2) lr lhs true ())) refl)
                          (steps ((rewrite (premise hcbd) lr lhs true ())) refl)
                          (steps ((rewrite (premise 4) lr lhs true ())) refl))
                         refl))
                     (have hdeng
                       (=
                         (xeval_instr (S f2) m2 (XMovRR a1 a2) rs mem)
                         (xeval_instr (S f2) m1 (XMovRR a1 a2) rs mem))
                       (chain
                         (have ha2
                           (=
                             (xlq_x
                               (S f2)
                               m2
                               (xlk_shq d (XQI (XMovRR a1 a2)))
                               rs
                               mem)
                             (xeval_instr (S f2) m2 (XMovRR a1 a2) rs mem))
                           (steps
                             ((unfold xlk_shq lhs)
                              (reduce lhs)
                              (unfold xlk_shi lhs)
                              (reduce lhs)
                              (unfold xlq_x lhs)
                              (reduce lhs))
                             refl))
                         (have ha1
                           (=
                             (xlq_x (S f2) m1 (XQI (XMovRR a1 a2)) rs mem)
                             (xeval_instr (S f2) m1 (XMovRR a1 a2) rs mem))
                           (steps ((unfold xlq_x lhs) (reduce lhs)) refl))
                         (steps
                           ((rewrite (premise ha2) rl lhs true ())
                            (rewrite (premise ha1) rl rhs true ())
                            (rewrite (premise hdel) lr lhs true ()))
                           refl)))
                     (steps ((rewrite (premise hdeng) lr lhs true ())) refl)))
                 (case XBin
                   (a1 a2 a3)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (steps
                       ((unfold xlk_shq lhs)
                        (reduce lhs)
                        (unfold xlk_shi lhs)
                        (reduce lhs)
                        (unfold xlq_xv lhs)
                        (reduce lhs)
                        (unfold xveval_instr lhs)
                        (reduce lhs)
                        (unfold xlq_xv rhs)
                        (reduce rhs)
                        (unfold xveval_instr rhs)
                        (reduce rhs)))
                     (have hcbd (= (xlk_cbq fs (XQI (XBin a1 a2 a3))) True)
                       (steps
                         ((rewrite (premise 3) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ()))
                         refl))
                     (have hdel
                       (=
                         (xlq_x
                           (S f2)
                           m2
                           (xlk_shq d (XQI (XBin a1 a2 a3)))
                           rs
                           mem)
