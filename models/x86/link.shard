                                    (rewrite (premise hvr) rl lhs true ())
                                    (rewrite (premise hihr) lr lhs true ())
                                    (rewrite (premise hxr) lr lhs true ()))
                                   refl)))
                             (case XBrk
                               (d2 rs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okx (xlq_x f2 m (XQI i) rs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hxa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_xv f2 m (XQI i) rs xs mem)
                                     (xvlift xs (xlq_x f2 m (XQI i) rs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hxa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XRetO
                               (rs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okx (xlq_x f2 m (XQI i) rs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hxa) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_xv f2 m (XQI i) rs xs mem)
                                     (xvlift xs (xlq_x f2 m (XQI i) rs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hva) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hxa) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XTrap
                               (chain
                                 (have hx (= False True)
                                   (steps
                                     ((rewrite (premise 0) rl rhs true ())
                                      (rewrite (hyp 3) lr rhs true ())
                                      (rewrite (hyp 2) lr rhs true ())
                                      (compute rhs (stop xeval_instr))
                                      (rewrite (hyp 1) lr rhs true ())
                                      (rewrite (hyp 0) lr rhs true ())
                                      (compute rhs))
                                     refl))
                                 (absurd (premise hx)))))))))))))))))))))

;; --- THE VECTOR->WORLD-VECTOR EMBEDDING (PVEMBED) ----------------------------
;;
;; A non-trapping pure-vector walk never reached an effect point (the pure
;; tier traps on XSyscall/XCpuid), so the world-vector tier runs it with
;; the world riding past untouched and no events. Cites xlk_embx in the
;; dispatch corner where the vector tier delegated a leaf callee to the
;; base while the world-vector tier mirrors it.

(claim xlk_embp
  (goal
    ((fuel Nat) (m XModule) (q XQ) (rs Regs) (xs Xmms) (mem Mem) (w LxWorld))
    ((= (xlk_okv (xlq_xv fuel m q rs xs mem)) True))
    (= (xlq_wv fuel m q rs xs mem w) (wvlift_p w (xlq_xv fuel m q rs xs mem))))
  (induct fuel
    ((case Z
       (case-on q XQ
         ((case XQI
            (i)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQC
            (k)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQB
            (body)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl))
          (case XQS
            (is2)
            (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))
     (case S
       (f2)
       (case-on q XQ
         ((case XQI
            (i)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on i XInstr
                ((case XMovRI
                   (lr1 lv)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShrI
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBin32
                   (lo ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XShlI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XMovRR32
                   (ld ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XRorI32
                   (ld lk)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XDivU
                   (lr1)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XLoad8
                   (ld la)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XStore8
                   (la ls)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBlock
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQS body) rs xs mem)
                         (xveval_seq f2 m body rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hwa
                       (=
                         (xlq_wv f2 m (XQS body) rs xs mem w)
                         (wveval_seq f2 m body rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (steps ((compute both (stop xveval_seq wveval_seq))))
                     (case-on (xveval_seq f2 m body rs xs mem) Option
                       ((case None
                          (chain
                            (have hok
                              (=
                                (xlk_okv (xlq_xv f2 m (XQS body) rs xs mem))
                                True)
                              (steps
                                ((rewrite (premise hva) lr lhs true ())
                                 (rewrite (hyp 0) lr lhs true ())
                                 (compute lhs))
                                refl))
                            (have hih
                              (=
                                (xlq_wv f2 m (XQS body) rs xs mem w)
                                (wvlift_p w (xlq_xv f2 m (XQS body) rs xs mem)))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
                                ()
                                ((steps
                                   ((rewrite (premise hok) lr lhs true ()))
                                   refl))
                                refl))
                            (steps
                              ((rewrite (premise hwa) rl lhs true ())
                               (rewrite (premise hih) lr lhs true ())
                               (rewrite (premise hva) lr lhs true ())
                               (rewrite (hyp 0) lr both true ())
                               (compute both))
                              refl)))
                        (case Some
                          (out)
                          (case-on out XVOut
                            ((case XVNorm
                               (rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv
                                       (xlq_xv f2 m (XQS body) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQS body) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XVBrk
                               (d2 rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv
                                       (xlq_xv f2 m (XQS body) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQS body) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both)))
                                 (case-on (int_eq d2 0) Bool
                                   ((case True
                                      (steps
                                        ((rewrite (hyp True) lr both true ())
                                         (compute both))
                                        refl))
                                    (case False
                                      (steps
                                        ((rewrite (hyp False) lr both true ())
                                         (compute both))
                                        refl))))))
                             (case XVRetO
                               (rs2 xs2 mem2)
                               (chain
                                 (have hok
                                   (=
                                     (xlk_okv
                                       (xlq_xv f2 m (XQS body) rs xs mem))
                                     True)
                                   (steps
                                     ((rewrite (premise hva) lr lhs true ())
                                      (rewrite (hyp 1) lr lhs true ())
                                      (rewrite (hyp 0) lr lhs true ())
                                      (compute lhs))
                                     refl))
                                 (have hih
                                   (=
                                     (xlq_wv f2 m (XQS body) rs xs mem w)
                                     (wvlift_p
                                       w
                                       (xlq_xv f2 m (XQS body) rs xs mem)))
                                   (rewrite-with
                                     (hyp 4)
                                     lr
                                     lhs
                                     ()
                                     ((steps
                                        ((rewrite (premise hok) lr lhs true ()))
                                        refl))
                                     refl))
                                 (steps
                                   ((rewrite (premise hwa) rl lhs true ())
                                    (rewrite (premise hih) lr lhs true ())
                                    (rewrite (premise hva) lr lhs true ())
                                    (rewrite (hyp 1) lr both true ())
                                    (rewrite (hyp 0) lr both true ())
                                    (compute both))
                                   refl)))
                             (case XVTrap
                               (chain
                                 (have hx (= False True)
                                   (steps
                                     ((rewrite (premise 0) rl rhs true ())
                                      (rewrite (hyp 3) lr rhs true ())
                                      (rewrite (hyp 2) lr rhs true ())
                                      (compute rhs (stop xveval_seq))
                                      (rewrite (hyp 1) lr rhs true ())
                                      (rewrite (hyp 0) lr rhs true ())
                                      (compute rhs))
                                     refl))
                                 (absurd (premise hx)))))))))))
                 (case XLoop
                   (body)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hvi2
                       (=
                         (xlq_xv (S f2) m (XQI (XLoop body)) rs xs mem)
                         (xveval_loop f2 m body rs xs mem))
                       (steps
                         ((unfold xlq_xv lhs)
                          (reduce lhs)
                          (unfold xveval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQB body) rs xs mem)
                         (xveval_loop f2 m body rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hwa
                       (=
                         (xlq_wv f2 m (XQB body) rs xs mem w)
                         (wveval_loop f2 m body rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (have hok
                       (= (xlk_okv (xlq_xv f2 m (XQB body) rs xs mem)) True)
                       (steps
                         ((rewrite (premise hva) lr lhs true ())
                          (rewrite (premise hvi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_wv f2 m (XQB body) rs xs mem w)
                         (wvlift_p w (xlq_xv f2 m (XQB body) rs xs mem)))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hok) lr lhs true ())) refl))
                         refl))
                     (steps
                       ((compute both (stop xveval_loop wveval_loop wvlift_p))
                        (rewrite (premise hwa) rl lhs true ())
                        (rewrite (premise hih) lr lhs true ())
                        (rewrite (premise hva) lr lhs true ()))
                       refl)))
                 (case XBr
                   (ld)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XBrIf
                   (lc ld)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XCall
                   (k2)
                   (chain
                     (steps ((rewrite (hyp 0) lr both true ())))
                     (have hvi2
                       (=
                         (xlq_xv (S f2) m (XQI (XCall k2)) rs xs mem)
                         (xveval_call f2 m k2 rs xs mem))
                       (steps
                         ((unfold xlq_xv lhs)
                          (reduce lhs)
                          (unfold xveval_instr lhs)
                          (reduce lhs))
                         refl))
                     (have hva
                       (=
                         (xlq_xv f2 m (XQC k2) rs xs mem)
                         (xveval_call f2 m k2 rs xs mem))
                       (steps ((unfold xlq_xv lhs) (reduce lhs)) refl))
                     (have hwa
                       (=
                         (xlq_wv f2 m (XQC k2) rs xs mem w)
                         (wveval_call f2 m k2 rs xs mem w))
                       (steps ((unfold xlq_wv lhs) (reduce lhs)) refl))
                     (have hok
                       (= (xlk_okv (xlq_xv f2 m (XQC k2) rs xs mem)) True)
                       (steps
                         ((rewrite (premise hva) lr lhs true ())
                          (rewrite (premise hvi2) rl lhs true ())
                          (rewrite (hyp 0) rl lhs true ())
                          (rewrite (hyp 1) rl lhs true ())
                          (rewrite (premise 0) lr lhs true ()))
                         refl))
                     (have hih
                       (=
                         (xlq_wv f2 m (XQC k2) rs xs mem w)
                         (wvlift_p w (xlq_xv f2 m (XQC k2) rs xs mem)))
                       (rewrite-with
                         (hyp 2)
                         lr
                         lhs
                         ()
                         ((steps ((rewrite (premise hok) lr lhs true ())) refl))
                         refl))
                     (steps
                       ((compute both (stop xveval_call wveval_call wvlift_p))
                        (rewrite (premise hwa) rl lhs true ())
                        (rewrite (premise hih) lr lhs true ())
                        (rewrite (premise hva) lr lhs true ()))
                       refl)))
                 (case XRet
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))
                 (case XSyscall
                   (chain
                     (have hx (= False True)
                       (steps
                         ((rewrite (premise 0) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute rhs))
                         refl))
                     (absurd (premise hx))))
                 (case XCpuid
                   (chain
                     (have hx (= False True)
                       (steps
                         ((rewrite (premise 0) rl rhs true ())
                          (rewrite (hyp 1) lr rhs true ())
                          (rewrite (hyp 0) lr rhs true ())
                          (compute rhs))
                         refl))
                     (absurd (premise hx))))
                 (case XVec
                   (vv)
                   (steps
                     ((rewrite (hyp 0) lr both true ()) (compute both))
                     refl))))))
          (case XQC
            (k)
            (chain
              (steps ((rewrite (hyp 0) lr both true ())))
              (case-on (xfunc_at (xfuncs_of m) k) Option
                ((case None
                   (steps
                     ((compute
                        lhs
                        (stop xfunc_at xfuncs_of xbody_of xwv_fn xwv_budget
                          xvec_fn xvec_budget xveval_call wvlift_p xvlift
                          wveval_seq xveval_seq xeval_call xeval_seq))
                      (rewrite (hyp 0) lr lhs true ())
                      (unfold xlq_xv rhs)
                      (reduce rhs)
                      (unfold xveval_call rhs)
                      (reduce rhs)
                      (rewrite (hyp 0) lr rhs true ())
                      (compute both))
                     refl))
                 (case Some
                   (f)
                   (case-on (xwv_fn (xwv_budget) f) Bool
                     ((case False
                        (steps
                          ((compute
                             lhs
                             (stop xfunc_at xfuncs_of xbody_of xwv_fn xwv_budget
                               xvec_fn xvec_budget xveval_call wvlift_p xvlift
                               wveval_seq xveval_seq xeval_call xeval_seq))
                           (rewrite (hyp 1) lr lhs true ())
                           (compute
                             lhs
                             (stop xbody_of xwv_fn xwv_budget xveval_call
                               wvlift_p wveval_seq xveval_seq))
                           (rewrite (hyp False) lr lhs true ())
                           (compute lhs (stop xveval_call wvlift_p))
                           (unfold xlq_xv rhs)
                           (reduce rhs))
                          refl))
                      (case True
                        (case-on (xvec_fn (xvec_budget) f) Bool
                          ((case False
                             (chain
                               (steps
                                 ((compute
                                    both
                                    (stop xfunc_at xfuncs_of xbody_of xwv_fn
                                      xwv_budget xvec_fn xvec_budget xveval_call
                                      wvlift_p xvlift wveval_seq xveval_seq
                                      xeval_call xeval_seq))
                                  (rewrite (hyp 2) lr lhs true ())
                                  (compute
                                    lhs
                                    (stop xbody_of xwv_fn xwv_budget wveval_seq
                                      xveval_call wvlift_p))
                                  (rewrite (hyp 1) lr lhs true ())
                                  (compute
                                    lhs
                                    (stop xbody_of wveval_seq xveval_call
                                      wvlift_p))
                                  (unfold xveval_call rhs)
                                  (reduce rhs)
                                  (rewrite (hyp 2) lr rhs true ())
                                  (compute
                                    rhs
                                    (stop xbody_of xvec_fn xvec_budget
                                      xveval_seq xvlift xeval_call xeval_seq))
                                  (rewrite (hyp 0) lr rhs true ())
                                  (compute
                                    rhs
                                    (stop xbody_of xvlift xeval_call xeval_seq))))
                               (case-on (xeval_seq f2 m (xbody_of f) rs mem)
                                 Option
                                 ((case None
                                    (chain
                                      (have hxa2
                                        (=
                                          (xlq_x f2 m (XQS (xbody_of f)) rs mem)
                                          (xeval_seq f2 m (xbody_of f) rs mem))
                                        (steps
                                          ((unfold xlq_x lhs) (reduce lhs))
                                          refl))
                                      (have hokx
                                        (=
                                          (xlk_okx
                                            (xlq_x
                                              f2
                                              m
                                              (XQS (xbody_of f))
                                              rs
                                              mem))
                                          True)
                                        (steps
                                          ((rewrite
                                             (premise hxa2)
                                             lr
                                             lhs
                                             true
                                             ())
                                           (rewrite (hyp 0) lr lhs true ())
                                           (compute lhs))
                                          refl))
                                      (have hembx
                                        (=
                                          (xlq_xv
                                            f2
                                            m
                                            (XQS (xbody_of f))
                                            rs
                                            xs
                                            mem)
                                          (xvlift
                                            xs
                                            (xlq_x
                                              f2
                                              m
                                              (XQS (xbody_of f))
                                              rs
                                              mem)))
                                        (rewrite-with
                                          (lemma xlk_embx)
                                          lr
                                          lhs
                                          ()
                                          ((steps
                                             ((rewrite
                                                (premise hokx)
                                                lr
                                                lhs
                                                true
                                                ()))
                                             refl))
                                          refl))
                                      (have hwa
                                        (=
                                          (xlq_wv
                                            f2
                                            m
                                            (XQS (xbody_of f))
                                            rs
                                            xs
                                            mem
                                            w)
                                          (wveval_seq
                                            f2
                                            m
                                            (xbody_of f)
                                            rs
                                            xs
                                            mem
                                            w))
                                        (steps
                                          ((unfold xlq_wv lhs) (reduce lhs))
                                          refl))
                                      (have hokv
                                        (=
                                          (xlk_okv
                                            (xlq_xv
                                              f2
                                              m
                                              (XQS (xbody_of f))
                                              rs
                                              xs
                                              mem))
                                          True)
                                        (steps
                                          ((rewrite
                                             (premise hembx)
                                             lr
                                             lhs
                                             true
                                             ())
                                           (rewrite
                                             (premise hxa2)
                                             lr
                                             lhs
                                             true
                                             ())
                                           (rewrite (hyp 0) lr lhs true ())
                                           (compute lhs))
                                          refl))
                                      (have hih
                                        (=
                                          (xlq_wv
                                            f2
                                            m
                                            (XQS (xbody_of f))
                                            rs
                                            xs
                                            mem
                                            w)
                                          (wvlift_p
                                            w
                                            (xlq_xv
                                              f2
                                              m
                                              (XQS (xbody_of f))
                                              rs
                                              xs
                                              mem)))
                                        (rewrite-with
                                          (hyp 5)
                                          lr
                                          lhs
                                          ()
                                          ((steps
                                             ((rewrite
                                                (premise hokv)
                                                lr
                                                lhs
                                                true
                                                ()))
                                             refl))
                                          refl))
                                      (steps
                                        ((rewrite (premise hwa) rl lhs true ())
                                         (rewrite (premise hih) lr lhs true ())
                                         (rewrite
                                           (premise hembx)
                                           lr
                                           lhs
                                           true
                                           ())
                                         (rewrite (premise hxa2) lr lhs true ())
                                         (rewrite (hyp 0) lr lhs true ())
                                         (compute lhs)
                                         (unfold xeval_call rhs)
                                         (reduce rhs)
                                         (rewrite (hyp 3) lr rhs true ())
