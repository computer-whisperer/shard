                                ((inst m1 m1)
                                 (inst fs fs)
                                 (inst ext ext)
                                 (inst lo lo)
                                 (inst hi hi))
                                ((steps
                                   ((rewrite (premise 0) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 1) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise hcbc) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise 3) lr lhs true ()))
                                   refl))
                                refl))
                            (have hdeng
                              (=
                                (xveval_call (S f2) m2 k rs xs mem)
                                (xveval_call (S f2) m1 k rs xs mem))
                              (chain
                                (have ha2
                                  (=
                                    (xlq_xv (S f2) m2 (XQC k) rs xs mem)
                                    (xveval_call (S f2) m2 k rs xs mem))
                                  (steps
                                    ((unfold xlq_xv lhs) (reduce lhs))
                                    refl))
                                (have ha1
                                  (=
                                    (xlq_xv (S f2) m1 (XQC k) rs xs mem)
                                    (xveval_call (S f2) m1 k rs xs mem))
                                  (steps
                                    ((unfold xlq_xv lhs) (reduce lhs))
                                    refl))
                                (steps
                                  ((rewrite (premise ha2) rl lhs true ())
                                   (rewrite (premise ha1) rl rhs true ())
                                   (rewrite (premise hdel) lr lhs true ()))
                                  refl)))
                            (steps
                              ((rewrite (premise hdeng) lr lhs true ()))
                              refl)))
                        (case True
                          (chain
                            (steps
                              ((rewrite (hyp 0) lr both true ()) (reduce both)))
                            (have hcb (= (xlk_cbq fs (XQS (xbody_of f))) True)
                              (chain
                                (steps ((compute lhs (stop xlk_cbl xbody_of))))
                                (rewrite-with
                                  (lemma xlk_cbfns_at)
                                  rl
                                  rhs
                                  ((inst fs fs) (inst gs fs) (inst k k))
                                  ((steps
                                     ((rewrite (premise 3) lr lhs true ()))
                                     refl)))
                                (steps
                                  ((rewrite (hyp 1) lr rhs true ())
                                   (reduce rhs))
                                  refl)))
                            (have hih
                              (=
                                (xlq_wv f2 m2 (XQS (xbody_of f)) rs xs mem w)
                                (xlq_wv f2 m1 (XQS (xbody_of f)) rs xs mem w))
                              (rewrite-with
                                (hyp 3)
                                lr
                                lhs
