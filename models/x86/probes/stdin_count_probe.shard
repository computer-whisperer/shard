      (Some
        (WExit
          (mod (scp_cnt (mem_get m0 65536) its) 256)
          (scp_tr
            its
            (Cons
              (LxRead 0 Nil)
              (Cons (LxExited (mod (scp_cnt (mem_get m0 65536) its) 256)) Nil)))))))
  (chain
    (steps
      ((unfold xrun_w lhs)
       (compute
         lhs
         (stop weval_loop lx_take lx_fill lx_read scp_app scp_len scp_msk
           scp_ibs scp_ilen int_of_nat scb0_of scbs_of scc1_of scc2_of scp_cnt
           scp_tr scp_fuel scp_ws))))
    (rewrite-with
      (lemma scp_walk_eof)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps
      ((compute
         both
         (stop weval_loop lx_take lx_fill lx_read scp_app scp_len scp_msk
           scp_ibs scp_ilen int_of_nat scb0_of scbs_of scc1_of scc2_of scp_cnt
           scp_tr scp_fuel scp_ws)))
      refl)))

