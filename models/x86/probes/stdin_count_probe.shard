;; the DRY terminator: the oracle stream runs out at a loop head. None is
;; the world-layer resource convention (exactly like fuel) — the third
;; way a walk can end, and the one a real machine never takes.
(claim scp_walk_dry
  (goal
    ((its (List ScpIt))
     (m0 Mem)
     (a0 Int)
     (c0 Int)
     (d0 Int)
     (b0 Int)
     (p0 Int)
     (si0 Int)
     (di0 Int)
     (e8 Int)
     (e9 Int)
     (e10 Int)
     (e11 Int)
     (e12 Int)
     (e13 Int)
     (e14 Int)
     (e15 Int)
     (f Nat))
    ((= (scp_ok its) True))
    (=
      (weval_loop
        (S^ 17 (scp_fuel its f))
        (MkXModule
          (Cons
            (MkXFunc 0 (list (XLoop (inline scp_loop_body))))
            (Cons
              (MkXFunc 3 (inline scp_read_body))
              (Cons (MkXFunc 1 (inline scp_exit_body)) Nil)))
          65536
          131072)
        (inline scp_loop_body)
        (MkRegs a0 c0 d0 b0 p0 si0 di0 e8 e9 e10 e11 e12 e13 e14 e15)
        m0
        (MkLxWorld (scp_ws its Nil)))
      None))
  (induct its
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (it rest)
       (chain
         (have hhd (= (le (scp_ilen it) 4096) True)
           (rewrite-with
             (lemma scp_ok_hd)
             lr
             lhs
             ((inst rest rest))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have htl (= (scp_ok rest) True)
           (rewrite-with
             (lemma scp_ok_tl)
             lr
             lhs
             ((inst it it))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hfu (= (scp_fuel (Cons it rest) f) (S (scp_fuel rest f)))
           (steps ((unfold scp_fuel lhs) (reduce lhs)) refl))
         (have hws
           (=
             (scp_ws (Cons it rest) Nil)
             (Cons
               (scp_ilen it)
               (scp_app
                 (scp_ibs it)
                 (Cons (scc1_of it) (Cons (scc2_of it) (scp_ws rest Nil))))))
           (steps ((unfold scp_ws lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hfu) lr lhs true ())
            (rewrite (premise hws) lr lhs true ())))
         (rewrite-with
           (lemma scp_iter_data)
           lr
           lhs
           ()
           ((steps ((rewrite (premise hhd) lr lhs true ())) refl)))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise htl) lr lhs true ())) refl)))
         (steps
           ((compute
              both
              (stop weval_loop lx_take lx_fill lx_read scp_app scp_len scp_msk
                scp_ibs scp_ilen int_of_nat scb0_of scbs_of scc1_of scc2_of
                scp_cnt scp_tr scp_fuel scp_ws)))
           refl))))))

