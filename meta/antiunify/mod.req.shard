;;; meta/antiunify — least-general generalization of closed algebraic Expr.
;;;
;;; Program, proof-frontier, and transition censuses observe concrete terms,
;;; while useful conjectures normally quantify the roles that vary between
;;; observations.  This component computes a simultaneous anti-unifier for a
;;; pair of directed equations.  One mismatch table is shared by both sides,
;;; so correlations survive across the complete equation:
;;;
;;;   f A A = g A       f B B = g B
;;;              ==>   f $0 $0 = g $0
;;;
;;; Inputs are deliberately the closed first-order fragment.  BVar is reserved
;;; for the resulting metavariables; FVar/Match/Let are refused rather than
;;; assigned an accidental mining meaning.  Repeated mismatch pairs receive
;;; the same BVar, which is the ordinary Plotkin anti-unification construction.
;;;
;;; `au_guard_sets` is observational metadata, not a theorem.  Given a schema
;;; and its concrete supporting equations it reports a structural baseline
;;; plus alternate low-complexity affine domains over Int-valued roles.  A
;;; consumer must replay every domain over its complete census and may use the
;;; survivors to propose conditional theorems, but must not install them as
;;; proof licenses.  `au_distinct_guards` remains as the small compatibility
;;; API for clients which only need the structural baseline.
;;;
;;; The optional `meta/antiunify/typed.shard` companion recovers the type of
;;; every generalized role from checked concrete equations.  Keeping the
;;; kernel type synthesizer out of this small interface lets purely syntactic
;;; census clients retain the lightweight dependency boundary.
(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../../kernel/module.shard")
(import "../rewrite")
(import "../../std/list")

;; std list names come FIRST: an earlier `use` wins, and the kernel term glob
;; below carries a monomorphic (List Expr) `len` that would shadow std's.
(use (:: std list append))
(use (:: std list len))
(use (:: kernel term *))
(use (:: kernel module Type))
(use (:: kernel module type_eq))
(use (:: meta rewrite *))

(type AuEquation (AuEquation Expr Expr))

(type AuSchema (AuSchema AuEquation Int))

(type AuTypedSchema (AuTypedSchema AuSchema (List Type)))

; generalized schema, parameter types in binder-introduction order

(type AuSchemaR (AuSchemaErr (List Int)) (AuSchemaOk AuSchema))

(type AuTypedSchemaR
  (AuTypedSchemaErr (List Int))
  (AuTypedSchemaOk AuTypedSchema))

(type AuDistinct (AuDistinct Int Int))

(type AuDistinctR (AuDistinctErr (List Int)) (AuDistinctOk (List AuDistinct)))

;; Empirical guards are finite-census metadata, never proof licenses.  An
;; affine value stores an ordered linear form and a constant.  Equality uses
;; it as
;;
;;   sum (coefficient * rule-variable) = constant
;;
;; and order uses the same payload with `<=`.  Terms are ordered by increasing
;; variable index.  Equality fixes the first coefficient positive because its
;; sign dual is equivalent; order retains either sign.  Inference currently
;; bounds coefficients to {-1,1}; the general representation lets checked-
;; theorem normalization compare equivalent addition/subtraction spellings.
(type AuAffine (AuAffine (List (Pair Int Int)) Int))

(type AuGuard
  (AuGuardDistinct Int Int)
  (AuGuardAffine AuAffine)
  (AuGuardAffineLe AuAffine))

(type AuGuardSetsR
  (AuGuardSetsErr (List Int))
  (AuGuardSetsOk (List (List AuGuard))))

(type AuMismatch (AuMismatch Expr Expr Int))

(type AuState (AuState Int (List AuMismatch)))

(type AuExprR (AuExprErr (List Int)) (AuExprOk Expr AuState))

(type AuExprsR (AuExprsErr (List Int)) (AuExprsOk (List Expr) AuState))

(sig fn au_lhs ((eq AuEquation)) Expr)

(sig fn au_rhs ((eq AuEquation)) Expr)

(sig fn au_schema_arity ((schema AuSchema)) Int)

(sig fn au_typed_schema ((schema AuTypedSchema)) AuSchema)

;; Simultaneous equation LGG: the RHS continues with the LHS mismatch table.
(sig fn au_equations ((a AuEquation) (b AuEquation)) AuSchemaR)

(sig fn au_match_equation ((schema AuEquation) (concrete AuEquation))
  (Option TrsEnv))

(sig fn au_distinct_guards ((schema AuSchema) (concretes (List AuEquation)))
  AuDistinctR)

;; ---- bounded empirical affine guards -------------------------------------

;; The baseline structural family remains first and, when numeric inference is
;; enabled, carries the interval hull of every Int role.  Every inferred
;; affine equality then forms a separate alternative family atop that
;; baseline; the consumer must replay each family over its complete census
;; before retaining it.  This avoids treating unrelated multi-role
;; coincidences as one giant conjunction while still preserving the ordinary
;; scope bounds needed by checked domain premises.
(sig fn au_guard_sets
  ((max_terms Int) (schema AuSchema) (concretes (List AuEquation)))
  AuGuardSetsR)

(sig fn au_guard_eq ((left AuGuard) (right AuGuard)) Bool)

(sig fn au_guards_hold ((env TrsEnv) (guards (List AuGuard))) Bool)

(type AuPoly (AuPoly (List (Pair Int Int)) Int))

(sig fn au_affine_mem ((wanted AuAffine) (guards (List AuGuard))) Bool)

(sig fn au_conditioned_rule_covers
  ((typed AuTypedSchema)
   (proposal_guards (List AuGuard))
   (conditioned TrsConditionedRule))
  Bool)

;; Context-fragment counterpart to `au_conditioned_rule_covers`.  The strict
;; API above requires every declared schema binder to participate in the
;; equation.  This variant ignores declared binders absent from the fragment,
;; while retaining the same matching, used-binder type checks, and guard
;; entailment for everything the fragment actually observes.
(sig fn au_conditioned_rule_fragment_covers
  ((typed AuTypedSchema)
   (proposal_guards (List AuGuard))
   (conditioned TrsConditionedRule))
  Bool)

(sig fn au_spine_rule_covers
  ((fuel Int)
   (typed AuTypedSchema)
   (proposal_guards (List AuGuard))
   (item TrsSpineRule))
  Bool)
