;;; meta/sketch — the TERM-WITH-HOLES vocabulary: partial kernel terms
;;; and the exact addressing of their candidate spaces (docs/SEARCH.md
;;; S1). THE LINE: a definition lives here iff it manipulates PARTIAL
;;; kernel Exprs (hole-headed subterms) or addresses the candidate space
;;; a grammar induces over them — counting, rank-addressed decoding,
;;; filling. Nothing here evaluates, checks, proves, or renders.
;;;
;;; THE HOLE ENCODING (SEARCH.md D1): a hole is a reserved-head call
;;; inside the ordinary kernel Expr —
;;;
;;;   (Call (:: meta sketch hole) ((IntLit k)))
;;;
;;; — so every existing Expr walker, recognizer, and renderer works on
;;; partial terms unchanged. The reserved head is exactly the qname of
;;; the `hole` builder below: the name is reserved BY the definition.
;;; The kernel never checks a sketch; holes are filled before any check.
;;; A hole-headed call with any other argument shape is a MALFORMED
;;; sketch: every walker here refuses it loudly (HVBad / *Err), never
;;; skips it.
;;;
;;; SHARING: one hole id at two positions is ONE decision (the
;;; correlation primitive) — collection dedups, counting multiplies a
;;; shared hole once, filling substitutes every occurrence.
;;;
;;; THE FILL CONTRACT: fill is verbatim substitution — no binder
;;; shifting. An assignment's Expr is spelled in the binder context of
;;; the hole's position; sharing an id across positions requires those
;;; positions to agree on context. (The rev skeleton's per-arm hole
;;; scopes are the model.)
;;;
;;; GRAMMARS: per-hole alternative lists (GEnt), each alternative an
;;; Expr that may itself contain holes. THE STRATIFICATION LAW: entry
;;; ids are strictly ascending, and an alternative's holes are strictly
;;; GREATER than its entry's id — so counting is one reverse fold,
;;; deciding is one forward fold, closing is one reverse fold, all
;;; structural (no fuel, no cycle detection: a violation is a loud
;;; refusal at the pass that notices, and g_wf checks the law whole).
;;; One hole is owned by at most ONE entry's alternative set; reuse
;;; across alternatives of the SAME entry is fine (alternatives are
;;; exclusive), cross-entry sharing is refused (it would correlate
;;; distinct decisions and break the product counts).
;;;
;;; THE ADDRESSING LAW (rank <-> candidate): a sketch's space is the
;;; product over its distinct holes, ASCENDING id order, of per-hole
;;; counts; the LAST hole is the least-significant digit. Within a
;;; hole, alternatives occupy consecutive index intervals in list
;;; order (leaves-first grammars put leaves at the low indices); an
;;; alternative's interval decomposes over its distinct sub-holes the
;;; same way (ascending, last least-significant). Counts are exact
;;; bignum Int at any rung.

(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../doc")
(use (:: kernel term Expr))
(use (:: kernel term Call))
(use (:: kernel term Ctor))
(use (:: kernel term Match))
(use (:: kernel term Let))
(use (:: kernel term If))
(use (:: kernel term IntLit))
(use (:: kernel term Arm))
(use (:: kernel term Pat))
(use (:: kernel term QName))
(use (:: kernel term expr_eq))
(use (:: kernel term pat_eq))
(use (:: kernel term qname_eq))
(use (:: meta doc sym_list_eq))

;; ---- the reserved head (D1) --------------------------------------------------

(fn hole_path () (List Symbol) (Cons (quote meta) (Cons (quote sketch) Nil)))

(fn hole_qn () QName (QName (hole_path) (quote hole)))

;; build hole k. This fn's own qname IS the reserved head.
(fn hole ((k Int)) Expr (Call (hole_qn) (Cons (IntLit k) Nil)))

(fn qn_is_hole ((q QName)) Bool
  (match q
    ((QName path name)
     (if (sym_eq name (quote hole)) (sym_list_eq path (hole_path)) False))))

;; the loud pointwise classifier: a well-formed hole, a non-hole, or a
;; MALFORMED hole-headed call (refused, never skipped)
(type HoleView (HVHole Int) (HVBad (List Int)) (HVNot))

(fn call_hole_view ((q QName) (as (List Expr))) HoleView
  (if (qn_is_hole q)
    (match as
      ((Cons (IntLit k) Nil) (HVHole k))
      (_ (HVBad "malformed hole: want (hole K), exactly one IntLit argument")))
    (HVNot)))

(fn hole_view ((e Expr)) HoleView
  (match e
    ((Call q as) (call_hole_view q as))
    (_ (HVNot))))

(fn is_hole ((e Expr)) Bool
  (match (hole_view e)
    ((HVHole _) True)
    (_ False)))

(fn hole_id ((e Expr)) (Option Int)
  (match (hole_view e)
    ((HVHole k) (Some k))
    (_ None)))

;; ---- sorted id sets ----------------------------------------------------------

(fn ids_insert ((k Int) (ks (List Int))) (List Int)
  (measure (struct ks))
  (match ks
    (Nil (Cons k Nil))
    ((Cons h t)
     (if (lt k h) (Cons k ks) (if (int_eq k h) ks (Cons h (ids_insert k t)))))))

(fn ids_member ((k Int) (ks (List Int))) Bool
  (measure (struct ks))
  (match ks
    (Nil False)
    ((Cons h t) (if (int_eq k h) True (ids_member k t)))))

(fn ids_union ((xs (List Int)) (ks (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil ks)
    ((Cons h t) (ids_union t (ids_insert h ks)))))

(fn ids_rev ((xs (List Int)) (acc (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil acc)
    ((Cons h t) (ids_rev t (Cons h acc)))))

;; ---- hole collection: distinct ids, ASCENDING (sharing = one decision) -------

(type SkIds (SkIdsErr (List Int)) (SkIdsOk (List Int)))

(fn holes_e ((e Expr) (acc (List Int))) SkIds
  (measure (struct e))
  (match e
    ((Ctor _ as) (holes_l as acc))
    ((Call q as)
     (match (call_hole_view q as)
       ((HVHole k) (SkIdsOk (ids_insert k acc)))
       ((HVBad m) (SkIdsErr m))
       ((HVNot) (holes_l as acc))))
    ((Match s arms)
     (match (holes_e s acc)
       ((SkIdsErr m) (SkIdsErr m))
       ((SkIdsOk a2) (holes_arms arms a2))))
    ((Let bs body)
     (match (holes_l bs acc)
       ((SkIdsErr m) (SkIdsErr m))
       ((SkIdsOk a2) (holes_e body a2))))
    ((If c a b)
     (match (holes_e c acc)
       ((SkIdsErr m) (SkIdsErr m))
       ((SkIdsOk a1)
        (match (holes_e a a1)
          ((SkIdsErr m) (SkIdsErr m))
          ((SkIdsOk a2) (holes_e b a2))))))
    (_ (SkIdsOk acc))))

(fn holes_l ((es (List Expr)) (acc (List Int))) SkIds
  (measure (struct es))
  (match es
    (Nil (SkIdsOk acc))
    ((Cons h t)
     (match (holes_e h acc)
       ((SkIdsErr m) (SkIdsErr m))
       ((SkIdsOk a2) (holes_l t a2))))))

(fn holes_arms ((arms (List Arm)) (acc (List Int))) SkIds
  (measure (struct arms))
  (match arms
    (Nil (SkIdsOk acc))
    ((Cons (Arm _ b) t)
     (match (holes_e b acc)
       ((SkIdsErr m) (SkIdsErr m))
       ((SkIdsOk a2) (holes_arms t a2))))))

(fn sk_holes ((e Expr)) SkIds (holes_e e Nil))

;; ---- closedness: NO hole-headed call anywhere (malformed included) -----------

(fn closed_e ((e Expr)) Bool
  (measure (struct e))
  (match e
    ((Ctor _ as) (closed_l as))
    ((Call q as) (if (qn_is_hole q) False (closed_l as)))
    ((Match s arms) (if (closed_e s) (closed_arms arms) False))
    ((Let bs body) (if (closed_l bs) (closed_e body) False))
    ((If c a b) (if (closed_e c) (if (closed_e a) (closed_e b) False) False))
    (_ True)))

(fn closed_l ((es (List Expr))) Bool
  (measure (struct es))
  (match es
    (Nil True)
    ((Cons h t) (if (closed_e h) (closed_l t) False))))

(fn closed_arms ((arms (List Arm))) Bool
  (measure (struct arms))
  (match arms
    (Nil True)
    ((Cons (Arm _ b) t) (if (closed_e b) (closed_arms t) False))))

(fn sk_closed ((e Expr)) Bool (closed_e e))

;; ---- fill: verbatim hole substitution (single pass, no recursion into
;; the substituted value — bottom-up closing is the caller's job) --------------

(type SkE (SkEErr (List Int)) (SkEOk Expr))

(type SkEL (SkELErr (List Int)) (SkELOk (List Expr)))

(type SkEA (SkEAErr (List Int)) (SkEAOk (List Arm)))

(fn asg_find ((k Int) (asg (List (Pair Int Expr)))) (Option Expr)
  (measure (struct asg))
  (match asg
    (Nil None)
    ((Cons (Pair i v) t) (if (int_eq k i) (Some v) (asg_find k t)))))

(fn fill_e ((e Expr) (asg (List (Pair Int Expr)))) SkE
  (measure (struct e))
  (match e
    ((Ctor c as)
     (match (fill_l as asg)
       ((SkELErr m) (SkEErr m))
       ((SkELOk as2) (SkEOk (Ctor c as2)))))
    ((Call q as)
     (match (call_hole_view q as)
       ((HVHole k)
        (match (asg_find k asg)
          (None (SkEOk e))
          ((Some v) (SkEOk v))))
       ((HVBad m) (SkEErr m))
       ((HVNot)
        (match (fill_l as asg)
          ((SkELErr m) (SkEErr m))
          ((SkELOk as2) (SkEOk (Call q as2)))))))
    ((Match s arms)
     (match (fill_e s asg)
       ((SkEErr m) (SkEErr m))
       ((SkEOk s2)
        (match (fill_arms arms asg)
          ((SkEAErr m) (SkEErr m))
          ((SkEAOk arms2) (SkEOk (Match s2 arms2)))))))
    ((Let bs body)
     (match (fill_l bs asg)
       ((SkELErr m) (SkEErr m))
       ((SkELOk bs2)
        (match (fill_e body asg)
          ((SkEErr m) (SkEErr m))
          ((SkEOk body2) (SkEOk (Let bs2 body2)))))))
    ((If c a b)
     (match (fill_e c asg)
       ((SkEErr m) (SkEErr m))
       ((SkEOk c2)
        (match (fill_e a asg)
          ((SkEErr m) (SkEErr m))
          ((SkEOk a2)
           (match (fill_e b asg)
             ((SkEErr m) (SkEErr m))
             ((SkEOk b2) (SkEOk (If c2 a2 b2)))))))))
    (_ (SkEOk e))))

(fn fill_l ((es (List Expr)) (asg (List (Pair Int Expr)))) SkEL
  (measure (struct es))
  (match es
    (Nil (SkELOk Nil))
    ((Cons h t)
     (match (fill_e h asg)
       ((SkEErr m) (SkELErr m))
       ((SkEOk h2)
        (match (fill_l t asg)
          ((SkELErr m) (SkELErr m))
          ((SkELOk t2) (SkELOk (Cons h2 t2)))))))))

(fn fill_arms ((arms (List Arm)) (asg (List (Pair Int Expr)))) SkEA
  (measure (struct arms))
  (match arms
    (Nil (SkEAOk Nil))
    ((Cons (Arm p b) t)
     (match (fill_e b asg)
       ((SkEErr m) (SkEAErr m))
       ((SkEOk b2)
        (match (fill_arms t asg)
          ((SkEAErr m) (SkEAErr m))
          ((SkEAOk t2) (SkEAOk (Cons (Arm p b2) t2)))))))))

(fn sk_fill ((e Expr) (asg (List (Pair Int Expr)))) SkE (fill_e e asg))

;; ---- grammars ----------------------------------------------------------------

;; one hole's alternatives; each alternative may contain holes with
;; STRICTLY GREATER ids (the stratification law)
(type GEnt (GEnt Int (List Expr)))

(type Grammar (Grammar (List GEnt)))

;; ---- regular schema grammars -----------------------------------------------
;;
;; A materialized Grammar gives every possible occurrence a hole id up front.
;; That is the right representation for exact ranking, but recursively typed
;; languages repeat the same production state at exponentially many possible
;; positions.  Schema grammars separate the reusable production policy from
;; the independent occurrence that eventually chooses one production.
;;
;; `local` names a hole in the alternative template.  `edge` is unique within
;; the parent schema and gives that child position a stable structural address.
;; `child_schema` names the reusable policy at that child.  Equal child schemas
;; do *not* share choices: occurrence addresses include the whole parent path.
(type SkSchemaRef (SkSchemaRef Int Int Int))
; local template hole, parent-local edge, child schema

(type SkSchemaAlt (SkSchemaAlt Expr (List SkSchemaRef)))
(type SkSchemaEnt (SkSchemaEnt Int (List SkSchemaAlt)))
(type SkSchemaGrammar (SkSchemaGrammar Int (List SkSchemaEnt)))
; root schema, entries

(fn sks_ent_find ((schema_id Int) (entries (List SkSchemaEnt)))
  (Option (List SkSchemaAlt))
  (measure (struct entries))
  (match entries
    (Nil None)
    ((Cons (SkSchemaEnt prior alts) rest)
     (if (int_eq schema_id prior) (Some alts) (sks_ent_find schema_id rest)))))

(fn sks_ref_edge_find ((edge Int) (alts (List SkSchemaAlt)))
  (Option SkSchemaRef)
  (measure (struct alts))
  (match alts
    (Nil None)
    ((Cons (SkSchemaAlt _ refs) rest)
     (match (sks_ref_edge_find_go edge refs)
       (None (sks_ref_edge_find edge rest))
       ((Some ref) (Some ref))))))

(fn sks_ref_edge_find_go ((edge Int) (refs (List SkSchemaRef)))
  (Option SkSchemaRef)
  (measure (struct refs))
  (match refs
    (Nil None)
    ((Cons ref rest)
     (match ref
       ((SkSchemaRef _ prior _)
        (if (int_eq edge prior) (Some ref) (sks_ref_edge_find_go edge rest)))))))

(fn sks_ints_eq ((left (List Int)) (right (List Int))) Bool
  (measure (struct left))
  (match left
    (Nil
      (match right
        (Nil True)
        ((Cons _ _) False)))
    ((Cons x xs)
     (match right
       (Nil False)
       ((Cons y ys) (if (int_eq x y) (sks_ints_eq xs ys) False))))))

(fn sks_ref_locals ((refs (List SkSchemaRef))) (List Int)
  (measure (struct refs))
  (match refs
    (Nil Nil)
    ((Cons (SkSchemaRef local _ _) rest) (Cons local (sks_ref_locals rest)))))

(type SkSchemaRefsWfR
  (SkSchemaRefsWfErr (List Int))
  (SkSchemaRefsWfOk (List Int)))
; updated entry-global edge set

(fn sks_refs_wf
  ((refs (List SkSchemaRef))
   (schema_ids (List Int))
   (prior_local Int)
   (edges (List Int)))
  SkSchemaRefsWfR
  (measure (struct refs))
  (match refs
    (Nil (SkSchemaRefsWfOk edges))
    ((Cons (SkSchemaRef local edge child_schema) rest)
     (if (lt local 0)
       (SkSchemaRefsWfErr "schema local hole must be nonnegative")
     (if (if (lt prior_local 0) False (le local prior_local))
       (SkSchemaRefsWfErr "schema local holes must be strictly ascending")
     (if (lt edge 0) (SkSchemaRefsWfErr "schema edge must be nonnegative")
     (if (ids_member edge edges)
       (SkSchemaRefsWfErr "schema edge is owned by two alternatives")
     (if (ids_member child_schema schema_ids)
       (sks_refs_wf rest schema_ids local (ids_insert edge edges))
       (SkSchemaRefsWfErr "schema edge references a missing schema")))))))))

(type SkSchemaAltsWfR
  (SkSchemaAltsWfErr (List Int))
  (SkSchemaAltsWfOk (List Int)))

(fn sks_alts_wf
  ((alts (List SkSchemaAlt)) (schema_ids (List Int)) (edges (List Int)))
  SkSchemaAltsWfR
  (measure (struct alts))
  (match alts
    (Nil (SkSchemaAltsWfOk edges))
    ((Cons (SkSchemaAlt template refs) rest)
     (match (sk_holes template)
       ((SkIdsErr msg) (SkSchemaAltsWfErr msg))
       ((SkIdsOk holes)
        (if (sks_ints_eq holes (sks_ref_locals refs))
          (match (sks_refs_wf refs schema_ids -1 edges)
            ((SkSchemaRefsWfErr msg) (SkSchemaAltsWfErr msg))
            ((SkSchemaRefsWfOk edges2) (sks_alts_wf rest schema_ids edges2)))
          (SkSchemaAltsWfErr "schema references do not equal alternative holes")))))))

(type SkSchemaWf (SkSchemaWfErr (List Int)) (SkSchemaWfOk))

(fn sks_entries_wf ((entries (List SkSchemaEnt)) (schema_ids (List Int)))
  SkSchemaWf
  (measure (struct entries))
  (match entries
    (Nil (SkSchemaWfOk))
    ((Cons (SkSchemaEnt _ alts) rest)
     (match (sks_alts_wf alts schema_ids Nil)
       ((SkSchemaAltsWfErr msg) (SkSchemaWfErr msg))
       ((SkSchemaAltsWfOk _) (sks_entries_wf rest schema_ids))))))

(fn sks_ids ((entries (List SkSchemaEnt))) (List Int)
  (measure (struct entries))
  (match entries
    (Nil Nil)
    ((Cons (SkSchemaEnt schema_id _) rest) (Cons schema_id (sks_ids rest)))))

(fn sks_ids_nonnegative ((ids (List Int))) Bool
  (measure (struct ids))
  (match ids
    (Nil True)
    ((Cons schema_id rest)
     (if (lt schema_id 0) False (sks_ids_nonnegative rest)))))

(fn sk_schema_wf ((grammar SkSchemaGrammar)) SkSchemaWf
  (match grammar
    ((SkSchemaGrammar root entries)
     (let ((ids (sks_ids entries)))
       (if (lt root 0) (SkSchemaWfErr "schema root must be nonnegative")
       (if (if (sks_ids_nonnegative ids) (ids_ascending ids) False)
         (if (ids_member root ids) (sks_entries_wf entries ids)
         (SkSchemaWfErr "schema root has no entry"))
         (SkSchemaWfErr
           "schema entry ids must be nonnegative and strictly ascending")))))))

;; Structural occurrence addresses.  A child address is
;;
;;     2^edge * (2 * parent + 1)
;;
;; and is therefore positive and uniquely reversible by removing factors of
;; two.  The complete parent path remains in the number, so two occurrences of
;; the same schema are independent without a mutable/global id allocator.
(fn sks_pow2 ((n Int) (fuel Int)) Int
  (measure fuel)
  (if (lt fuel 1) 1 (if (lt n 1) 1 (* 2 (sks_pow2 (- n 1) (- fuel 1))))))

(fn sk_occ_child ((parent Int) (edge Int)) Int
  (* (sks_pow2 edge (+ edge 1)) (+ (* 2 parent) 1)))

(type SkOccSplitR (SkOccSplitErr (List Int)) (SkOccSplitOk Int Int))
; parent, edge

(fn sk_occ_split_go ((value Int) (edge Int) (fuel Int)) SkOccSplitR
  (measure fuel)
  (if (lt fuel 1) (SkOccSplitErr "occurrence address split fuel exhausted")
  (if (lt value 1) (SkOccSplitErr "occurrence address must be positive")
  (if (int_eq (mod value 2) 0)
    (sk_occ_split_go (ediv value 2) (+ edge 1) (- fuel 1))
    (SkOccSplitOk (ediv (- value 1) 2) edge)))))

(fn sk_occ_split ((occurrence Int)) SkOccSplitR
  (sk_occ_split_go occurrence 0 1000000))

(type SkSchemaIdR (SkSchemaIdErr (List Int)) (SkSchemaIdOk Int))

(fn sk_schema_id_at_go ((grammar SkSchemaGrammar) (occurrence Int) (fuel Int))
  SkSchemaIdR
  (measure fuel)
  (if (lt fuel 1) (SkSchemaIdErr "occurrence schema lookup fuel exhausted")
  (match grammar
    ((SkSchemaGrammar root entries)
     (if (int_eq occurrence 0) (SkSchemaIdOk root)
     (if (lt occurrence 0) (SkSchemaIdErr "negative occurrence address")
     (match (sk_occ_split occurrence)
       ((SkOccSplitErr msg) (SkSchemaIdErr msg))
       ((SkOccSplitOk parent edge)
        (match (sk_schema_id_at_go grammar parent (- fuel 1))
          ((SkSchemaIdErr msg) (SkSchemaIdErr msg))
          ((SkSchemaIdOk parent_schema)
           (match (sks_ent_find parent_schema entries)
             (None (SkSchemaIdErr "occurrence parent schema is missing"))
             ((Some alts)
              (match (sks_ref_edge_find edge alts)
                (None (SkSchemaIdErr "occurrence edge is absent from schema"))
                ((Some (SkSchemaRef _ _ child_schema))
                 (SkSchemaIdOk child_schema)))))))))))))))

(fn sk_schema_id_at ((grammar SkSchemaGrammar) (occurrence Int)) SkSchemaIdR
  (sk_schema_id_at_go grammar occurrence 1000000))

(fn sks_ref_asg ((parent Int) (refs (List SkSchemaRef))) (List (Pair Int Expr))
  (measure (struct refs))
  (match refs
    (Nil Nil)
    ((Cons (SkSchemaRef local edge _) rest)
     (Cons
       (Pair local (hole (sk_occ_child parent edge)))
       (sks_ref_asg parent rest)))))

(type SkSchemaAltsR (SkSchemaAltsErr (List Int)) (SkSchemaAltsOk (List Expr)))

(fn sks_instantiate_alts ((parent Int) (alts (List SkSchemaAlt))) SkSchemaAltsR
  (measure (struct alts))
  (match alts
    (Nil (SkSchemaAltsOk Nil))
    ((Cons (SkSchemaAlt template refs) rest)
     (match (sk_fill template (sks_ref_asg parent refs))
       ((SkEErr msg) (SkSchemaAltsErr msg))
       ((SkEOk instantiated)
        (match (sks_instantiate_alts parent rest)
          ((SkSchemaAltsErr msg) (SkSchemaAltsErr msg))
          ((SkSchemaAltsOk tail) (SkSchemaAltsOk (Cons instantiated tail)))))))))

(fn sk_schema_alts_at ((grammar SkSchemaGrammar) (occurrence Int)) SkSchemaAltsR
  (match (sk_schema_id_at grammar occurrence)
    ((SkSchemaIdErr msg) (SkSchemaAltsErr msg))
    ((SkSchemaIdOk schema_id)
     (match grammar
       ((SkSchemaGrammar _ entries)
        (match (sks_ent_find schema_id entries)
          (None (SkSchemaAltsErr "occurrence schema is missing"))
          ((Some alts) (sks_instantiate_alts occurrence alts))))))))

;; Saturating productivity over the schema graph.  Unlike occurrence-grammar
;; productivity, schema ids need not be topologically ordered.  Starting from
;; all-false alternative facts, N rounds suffice for every finite productive
;; derivation in an N-schema graph; ungrounded cycles remain unproductive.
(type SkSchemaProductivity (SkSchemaProductivity (List (Pair Int (List Bool)))))

(fn sks_false_bits ((alts (List SkSchemaAlt))) (List Bool)
  (measure (struct alts))
  (match alts
    (Nil Nil)
    ((Cons _ rest) (Cons False (sks_false_bits rest)))))

(fn sks_false_facts ((entries (List SkSchemaEnt))) (List (Pair Int (List Bool)))
  (measure (struct entries))
  (match entries
    (Nil Nil)
    ((Cons (SkSchemaEnt schema_id alts) rest)
     (Cons (Pair schema_id (sks_false_bits alts)) (sks_false_facts rest)))))

(fn sks_fact_find ((schema_id Int) (facts (List (Pair Int (List Bool)))))
  (Option (List Bool))
  (measure (struct facts))
  (match facts
    (Nil None)
    ((Cons (Pair prior bits) rest)
     (if (int_eq schema_id prior) (Some bits) (sks_fact_find schema_id rest)))))

(fn sks_bits_any ((bits (List Bool))) Bool
  (measure (struct bits))
  (match bits
    (Nil False)
    ((Cons bit rest) (if bit True (sks_bits_any rest)))))

(fn sks_schema_productive
  ((schema_id Int) (facts (List (Pair Int (List Bool)))))
  Bool
  (match (sks_fact_find schema_id facts)
    (None False)
    ((Some bits) (sks_bits_any bits))))

(fn sks_refs_productive
  ((refs (List SkSchemaRef)) (facts (List (Pair Int (List Bool)))))
  Bool
  (measure (struct refs))
  (match refs
    (Nil True)
    ((Cons (SkSchemaRef _ _ child_schema) rest)
     (if (sks_schema_productive child_schema facts)
       (sks_refs_productive rest facts)
       False))))

(fn sks_alts_productivity
  ((alts (List SkSchemaAlt)) (facts (List (Pair Int (List Bool)))))
  (List Bool)
  (measure (struct alts))
  (match alts
    (Nil Nil)
    ((Cons (SkSchemaAlt _ refs) rest)
     (Cons (sks_refs_productive refs facts) (sks_alts_productivity rest facts)))))

(fn sks_productivity_round
  ((entries (List SkSchemaEnt)) (prior (List (Pair Int (List Bool)))))
  (List (Pair Int (List Bool)))
  (measure (struct entries))
  (match entries
    (Nil Nil)
    ((Cons (SkSchemaEnt schema_id alts) rest)
     (Cons
       (Pair schema_id (sks_alts_productivity alts prior))
       (sks_productivity_round rest prior)))))

(fn sks_productivity_rounds
  ((entries (List SkSchemaEnt))
   (facts (List (Pair Int (List Bool))))
   (fuel Int))
  (List (Pair Int (List Bool)))
  (measure fuel)
  (if (lt fuel 1) facts
  (sks_productivity_rounds
    entries
    (sks_productivity_round entries facts)
    (- fuel 1))))

(fn sks_entries_len ((entries (List SkSchemaEnt))) Int
  (measure (struct entries))
  (match entries
    (Nil 0)
    ((Cons _ rest) (+ 1 (sks_entries_len rest)))))

(fn sk_schema_productivity ((grammar SkSchemaGrammar)) SkSchemaProductivity
  (match grammar
    ((SkSchemaGrammar _ entries)
     (SkSchemaProductivity
       (sks_productivity_rounds
         entries
         (sks_false_facts entries)
         (sks_entries_len entries))))))

(fn sks_nth_bool ((bits (List Bool)) (index Int)) Bool
  (measure (struct bits))
  (match bits
    (Nil False)
    ((Cons bit rest) (if (le index 0) bit (sks_nth_bool rest (- index 1))))))

(fn sk_schema_alt_productive_at
  ((grammar SkSchemaGrammar)
   (productivity SkSchemaProductivity)
   (occurrence Int)
   (index Int))
  Bool
  (match productivity
    ((SkSchemaProductivity facts)
     (match (sk_schema_id_at grammar occurrence)
       ((SkSchemaIdErr _) False)
       ((SkSchemaIdOk schema_id)
        (match (sks_fact_find schema_id facts)
          (None False)
          ((Some bits) (sks_nth_bool bits index))))))))

(fn ents_rev ((es (List GEnt)) (acc (List GEnt))) (List GEnt)
  (measure (struct es))
  (match es
    (Nil acc)
    ((Cons h t) (ents_rev t (Cons h acc)))))

(fn ge_ids ((es (List GEnt))) (List Int)
  (measure (struct es))
  (match es
    (Nil Nil)
    ((Cons (GEnt h _) t) (Cons h (ge_ids t)))))

(fn ids_ascending ((ks (List Int))) Bool
  (measure (struct ks))
  (match ks
    (Nil True)
    ((Cons a t)
     (match t
       (Nil True)
       ((Cons b _) (if (lt a b) (ids_ascending t) False))))))

;; Persistent integer sets for grammar-scale validation.  Occurrence grammars
;; can contain hundreds of thousands of entries; checking every reference by
;; scanning the complete id list makes the otherwise-linear stratification
;; gate quadratic.  Keys are stored as id+1 in a binary digital trie.
(type SkIdSet (SkIdSetLeaf) (SkIdSetNode Bool SkIdSet SkIdSet))

(fn sk_idset_get ((set SkIdSet) (key Int) (fuel Int)) Bool
  (measure fuel)
  (if (lt fuel 1) False
  (match set
    ((SkIdSetLeaf) False)
    ((SkIdSetNode here left right)
     (if (le key 1) here
     (if (int_eq (mod key 2) 0) (sk_idset_get left (ediv key 2) (- fuel 1))
     (sk_idset_get right (ediv key 2) (- fuel 1))))))))

(fn sk_idset_put ((set SkIdSet) (key Int) (fuel Int)) SkIdSet
  (measure fuel)
  (if (lt fuel 1) set
  (match set
    ((SkIdSetLeaf)
     (if (le key 1) (SkIdSetNode True (SkIdSetLeaf) (SkIdSetLeaf))
     (if (int_eq (mod key 2) 0)
       (SkIdSetNode
         False
         (sk_idset_put (SkIdSetLeaf) (ediv key 2) (- fuel 1))
         (SkIdSetLeaf))
       (SkIdSetNode
         False
         (SkIdSetLeaf)
         (sk_idset_put (SkIdSetLeaf) (ediv key 2) (- fuel 1))))))
    ((SkIdSetNode here left right)
     (if (le key 1) (SkIdSetNode True left right)
     (if (int_eq (mod key 2) 0)
       (SkIdSetNode here (sk_idset_put left (ediv key 2) (- fuel 1)) right)
       (SkIdSetNode here left (sk_idset_put right (ediv key 2) (- fuel 1)))))))))

(type SkIdSetBuildR (SkIdSetBuildErr (List Int)) (SkIdSetBuildOk SkIdSet))

(fn sk_idset_build ((ids (List Int)) (set SkIdSet)) SkIdSetBuildR
  (measure (struct ids))
  (match ids
    (Nil (SkIdSetBuildOk set))
    ((Cons id rest)
     (if (lt id 0) (SkIdSetBuildErr "grammar hole id must be nonnegative")
     (sk_idset_build rest (sk_idset_put set (+ id 1) 64))))))

;; ---- well-formedness: the stratification law, checked whole ------------------

(type GW (GWErr (List Int)) (GWOk))

(fn refs_check ((hs (List Int)) (h Int) (tids (List Int)) (seen (List Int))) GW
  (measure (struct hs))
  (match hs
    (Nil (GWOk))
    ((Cons k t)
     (if (le k h) (GWErr "alternative hole id must exceed its entry id")
     (if (ids_member k tids)
       (if (ids_member k seen) (GWErr "hole is owned by two grammar entries")
       (refs_check t h tids seen))
       (GWErr "alternative references a hole with no grammar entry"))))))

(fn wf_go ((es (List GEnt)) (tids (List Int)) (seen (List Int))) GW
  (measure (struct es))
  (match es
    (Nil (GWOk))
    ((Cons (GEnt h alts) rest)
     (match (holes_l alts Nil)
       ((SkIdsErr m) (GWErr m))
       ((SkIdsOk hs)
        (match (refs_check hs h tids seen)
          ((GWErr m) (GWErr m))
          ((GWOk) (wf_go rest tids (ids_union hs seen)))))))))

(type GWSet (GWSetErr (List Int)) (GWSetOk SkIdSet))

(fn refs_check_set ((hs (List Int)) (h Int) (ids SkIdSet) (seen SkIdSet)) GWSet
  (measure (struct hs))
  (match hs
    (Nil (GWSetOk seen))
    ((Cons k rest)
     (if (le k h) (GWSetErr "alternative hole id must exceed its entry id")
     (if (sk_idset_get ids (+ k 1) 64)
       (if (sk_idset_get seen (+ k 1) 64)
         (GWSetErr "hole is owned by two grammar entries")
         (refs_check_set rest h ids (sk_idset_put seen (+ k 1) 64)))
       (GWSetErr "alternative references a hole with no grammar entry"))))))

(fn wf_go_set ((es (List GEnt)) (ids SkIdSet) (seen SkIdSet)) GW
  (measure (struct es))
  (match es
    (Nil (GWOk))
    ((Cons (GEnt h alts) rest)
     (match (holes_l alts Nil)
       ((SkIdsErr msg) (GWErr msg))
       ((SkIdsOk hs)
        (match (refs_check_set hs h ids seen)
          ((GWSetErr msg) (GWErr msg))
          ((GWSetOk seen2) (wf_go_set rest ids seen2))))))))

(fn g_wf ((g Grammar)) GW
  (match g
    ((Grammar es)
     (let ((ids (ge_ids es)))
       (if (ids_ascending ids)
         (match (sk_idset_build ids (SkIdSetLeaf))
           ((SkIdSetBuildErr msg) (GWErr msg))
           ((SkIdSetBuildOk id_set) (wf_go_set es id_set (SkIdSetLeaf))))
         (GWErr "grammar entry ids must be strictly ascending"))))))

;; Saturating (zero/nonzero) grammar analysis.  Synthesis schedulers need to
;; avoid barren depth-boundary productions without paying exact bignum counts.
;; Keep one productivity bit per original alternative so choice indices remain
;; stable for regions, ranks, and checked theorem facts.
(type SkProductivity
  (SkProductivityLeaf)
  (SkProductivityNode (Option (List Bool)) SkProductivity SkProductivity))

(fn skp_get ((productivity SkProductivity) (key Int) (fuel Int))
  (Option (List Bool))
  (measure fuel)
  (if (lt fuel 1) None
  (match productivity
    ((SkProductivityLeaf) None)
    ((SkProductivityNode value left right)
     (if (le key 1) value
     (if (int_eq (mod key 2) 0) (skp_get left (ediv key 2) (- fuel 1))
     (skp_get right (ediv key 2) (- fuel 1))))))))

(fn skp_put
  ((productivity SkProductivity) (key Int) (bits (List Bool)) (fuel Int))
  SkProductivity
  (measure fuel)
  (if (lt fuel 1) productivity
  (match productivity
    ((SkProductivityLeaf)
     (if (le key 1)
       (SkProductivityNode
         (Some bits)
         (SkProductivityLeaf)
         (SkProductivityLeaf))
     (if (int_eq (mod key 2) 0)
       (SkProductivityNode
         None
         (skp_put (SkProductivityLeaf) (ediv key 2) bits (- fuel 1))
         (SkProductivityLeaf))
       (SkProductivityNode
         None
         (SkProductivityLeaf)
         (skp_put (SkProductivityLeaf) (ediv key 2) bits (- fuel 1))))))
    ((SkProductivityNode value left right)
     (if (le key 1) (SkProductivityNode (Some bits) left right)
     (if (int_eq (mod key 2) 0)
       (SkProductivityNode
         value
         (skp_put left (ediv key 2) bits (- fuel 1))
         right)
       (SkProductivityNode
         value
         left
         (skp_put right (ediv key 2) bits (- fuel 1)))))))))

(fn skp_any ((bits (List Bool))) Bool
  (measure (struct bits))
  (match bits
    (Nil False)
    ((Cons bit rest) (if bit True (skp_any rest)))))

(fn skp_holes ((holes (List Int)) (productivity SkProductivity)) Bool
  (measure (struct holes))
  (match holes
    (Nil True)
    ((Cons hole_id rest)
     (match (skp_get productivity (+ hole_id 1) 64)
       (None False)
       ((Some bits) (if (skp_any bits) (skp_holes rest productivity) False))))))

(fn skp_expr ((e Expr) (productivity SkProductivity)) Bool
  (match (holes_e e Nil)
    ((SkIdsErr _) False)
    ((SkIdsOk holes) (skp_holes holes productivity))))

(fn skp_rev_bools ((bits (List Bool)) (acc (List Bool))) (List Bool)
  (measure (struct bits))
  (match bits
    (Nil acc)
    ((Cons bit rest) (skp_rev_bools rest (Cons bit acc)))))

(fn skp_alts
  ((alts (List Expr)) (productivity SkProductivity) (reverse_bits (List Bool)))
  (List Bool)
  (measure (struct alts))
  (match alts
    (Nil (skp_rev_bools reverse_bits Nil))
    ((Cons alt rest)
     (skp_alts
       rest
       productivity
       (Cons (skp_expr alt productivity) reverse_bits)))))

(fn skp_index ((reverse_entries (List GEnt)) (productivity SkProductivity))
  SkProductivity
  (measure (struct reverse_entries))
  (match reverse_entries
    (Nil productivity)
    ((Cons (GEnt hole_id alts) rest)
     (let ((bits (skp_alts alts productivity Nil)))
       (skp_index rest (skp_put productivity (+ hole_id 1) bits 64))))))

(fn sk_productivity ((grammar Grammar)) SkProductivity
  (match grammar
    ((Grammar entries) (skp_index (ents_rev entries Nil) (SkProductivityLeaf)))))

(fn skp_nth ((bits (List Bool)) (index Int)) Bool
  (measure (struct bits))
  (match bits
    (Nil False)
    ((Cons bit rest) (if (le index 0) bit (skp_nth rest (- index 1))))))

(fn sk_alt_productive ((productivity SkProductivity) (hole_id Int) (index Int))
  Bool
  (match (skp_get productivity (+ hole_id 1) 64)
    (None False)
    ((Some bits) (skp_nth bits index))))

;; ---- exact counting: one reverse fold over the entries -----------------------

(type SkC (SkCErr (List Int)) (SkCOk Int))

(type GCt (GCtErr (List Int)) (GCtOk (List (Pair Int Int))))

(fn memo_find ((k Int) (memo (List (Pair Int Int)))) (Option Int)
  (measure (struct memo))
  (match memo
    (Nil None)
    ((Cons (Pair i c) t) (if (int_eq k i) (Some c) (memo_find k t)))))

;; product over distinct holes of memoed counts (a shared hole is ONE factor)
(fn prod_counts ((hs (List Int)) (memo (List (Pair Int Int)))) SkC
  (measure (struct hs))
  (match hs
    (Nil (SkCOk 1))
    ((Cons h t)
     (match (memo_find h memo)
       (None (SkCErr "count memo is missing a hole (stratification violated)"))
       ((Some c)
        (match (prod_counts t memo)
          ((SkCErr m) (SkCErr m))
          ((SkCOk p) (SkCOk (* c p)))))))))

(fn alt_size ((a Expr) (memo (List (Pair Int Int)))) SkC
  (match (holes_e a Nil)
    ((SkIdsErr m) (SkCErr m))
    ((SkIdsOk hs) (prod_counts hs memo))))

(fn sum_alts ((alts (List Expr)) (memo (List (Pair Int Int)))) SkC
  (measure (struct alts))
  (match alts
    (Nil (SkCOk 0))
    ((Cons a t)
     (match (alt_size a memo)
       ((SkCErr m) (SkCErr m))
       ((SkCOk sz)
        (match (sum_alts t memo)
          ((SkCErr m) (SkCErr m))
          ((SkCOk s) (SkCOk (+ sz s)))))))))

(fn counts_go ((rev_es (List GEnt)) (memo (List (Pair Int Int)))) GCt
  (measure (struct rev_es))
  (match rev_es
    (Nil (GCtOk memo))
    ((Cons (GEnt h alts) rest)
     (match (sum_alts alts memo)
       ((SkCErr m) (GCtErr m))
       ((SkCOk c) (counts_go rest (Cons (Pair h c) memo)))))))

;; per-hole exact counts for every entry, later entries first computed —
;; the stratification law makes one reverse fold sufficient
(fn g_counts ((g Grammar)) GCt
  (match g
    ((Grammar es) (counts_go (ents_rev es Nil) Nil))))

;; the sketch's whole space: product over its distinct holes
(fn sk_count ((root Expr) (g Grammar)) SkC
  (match (g_counts g)
    ((GCtErr m) (SkCErr m))
    ((GCtOk memo)
     (match (holes_e root Nil)
       ((SkIdsErr m) (SkCErr m))
       ((SkIdsOk roots) (prod_counts roots memo))))))

;; ---- unrank: index -> closed candidate ----------------------------------------

;; digit split per the addressing law: holes given REVERSED (last =
;; least-significant digit), each digit = ix mod count
(type DgR (DgRErr (List Int)) (DgROk (List (Pair Int Int))))

(fn digits_go
  ((hs_rev (List Int))
   (memo (List (Pair Int Int)))
   (ix Int)
   (acc (List (Pair Int Int))))
  DgR
  (measure (struct hs_rev))
  (match hs_rev
    (Nil (DgROk acc))
    ((Cons h t)
     (match (memo_find h memo)
       (None (DgRErr "count memo is missing a hole (stratification violated)"))
       ((Some c)
        (if (le c 0) (DgRErr "hole with an empty candidate space")
        (digits_go t memo (ediv ix c) (Cons (Pair h (mod ix c)) acc))))))))

;; alternative selection: consecutive intervals in list order
(type PkR (PkRErr (List Int)) (PkROk Expr Int))

(fn pick_alt ((alts (List Expr)) (memo (List (Pair Int Int))) (i Int)) PkR
  (measure (struct alts))
  (match alts
    (Nil (PkRErr "alternative index out of range (count drift)"))
    ((Cons a t)
     (match (alt_size a memo)
       ((SkCErr m) (PkRErr m))
       ((SkCOk sz) (if (lt i sz) (PkROk a i) (pick_alt t memo (- i sz))))))))

;; merge freshly decided digits into the live map; a collision means a
;; hole reached from two entries (cross-entry sharing) — refused
(fn live_merge ((ds (List (Pair Int Int))) (live (List (Pair Int Int))))
  (Option (List (Pair Int Int)))
  (measure (struct ds))
  (match ds
    (Nil (Some live))
    ((Cons (Pair k d) t)
     (match (memo_find k live)
       (None (live_merge t (Cons (Pair k d) live)))
       ((Some _) None)))))

;; the forward decide pass: each live entry picks its alternative and
;; hands index digits down to the alternative's own holes
(type DcR (DcRErr (List Int)) (DcROk (List (Pair Int Expr))))

(fn decide_go
  ((es (List GEnt))
   (memo (List (Pair Int Int)))
   (live (List (Pair Int Int)))
   (choices (List (Pair Int Expr))))
  DcR
  (measure (struct es))
  (match es
    (Nil (DcROk choices))
    ((Cons (GEnt h alts) rest)
     (match (memo_find h live)
       (None (decide_go rest memo live choices))
       ((Some i)
        (match (pick_alt alts memo i)
          ((PkRErr m) (DcRErr m))
          ((PkROk a r)
           (match (holes_e a Nil)
             ((SkIdsErr m) (DcRErr m))
             ((SkIdsOk hs)
              (match (digits_go (ids_rev hs Nil) memo r Nil)
                ((DgRErr m) (DcRErr m))
                ((DgROk ds)
                 (match (live_merge ds live)
                   (None (DcRErr "hole is owned by two grammar entries"))
                   ((Some live2)
                    (decide_go rest memo live2 (Cons (Pair h a) choices)))))))))))))))

;; the reverse close pass: substitute bottom-up, so every chosen
;; alternative closes against already-closed deeper holes
(type ClR (ClRErr (List Int)) (ClROk (List (Pair Int Expr))))

(fn close_go
  ((rev_es (List GEnt))
   (choices (List (Pair Int Expr)))
   (closed (List (Pair Int Expr))))
  ClR
  (measure (struct rev_es))
  (match rev_es
    (Nil (ClROk closed))
    ((Cons (GEnt h _) rest)
     (match (asg_find h choices)
       (None (close_go rest choices closed))
       ((Some a)
        (match (fill_e a closed)
          ((SkEErr m) (ClRErr m))
          ((SkEOk v) (close_go rest choices (Cons (Pair h v) closed)))))))))

;; ---- rank: closed candidate -> index (unrank's inverse) -----------------------
;;
;; Matching walks a TEMPLATE (an Expr with holes) against a closed
;; candidate: a hole binds the candidate subtree at its position (a
;; repeated id must bind expr_eq-equal subtrees — sharing), everything
;; else must agree exactly. Across a hole's alternatives the FIRST
;; structural match wins, and there is NO backtracking into a later
;; alternative when the bound subtree fails deeper — so THE ORDERING
;; DISCIPLINE for builders: an earlier alternative must never
;; structurally match a candidate that belongs to a later one. Plain
;; distinct-head alternatives satisfy it trivially; point-exclusion
;; splits (Cons(x, B') before Cons(A', B)) must list the
;; CONCRETE-headed alternative first. rank . unrank = id is what
;; consumers gate (the census round-trip).

(type MtR (MtRErr (List Int)) (MtRNo) (MtROk (List (Pair Int Expr))))

(fn mt_bind ((k Int) (v Expr) (bs (List (Pair Int Expr)))) MtR
  (match (asg_find k bs)
    (None (MtROk (Cons (Pair k v) bs)))
    ((Some v0) (if (expr_eq v0 v) (MtROk bs) (MtRNo)))))

(fn match_e ((p Expr) (c Expr) (bs (List (Pair Int Expr)))) MtR
  (measure (struct p))
  (match p
    ((Ctor q as)
     (match c
       ((Ctor q2 as2) (if (qname_eq q q2) (match_l as as2 bs) (MtRNo)))
       (_ (MtRNo))))
    ((Call q as)
     (match (call_hole_view q as)
       ((HVHole k) (mt_bind k c bs))
       ((HVBad m) (MtRErr m))
       ((HVNot)
        (match c
          ((Call q2 as2) (if (qname_eq q q2) (match_l as as2 bs) (MtRNo)))
          (_ (MtRNo))))))
    ((Match s arms)
     (match c
       ((Match s2 arms2)
        (match (match_e s s2 bs)
          ((MtRErr m) (MtRErr m))
          ((MtRNo) (MtRNo))
          ((MtROk bs2) (match_arms arms arms2 bs2))))
       (_ (MtRNo))))
    ((Let xs body)
     (match c
       ((Let xs2 body2)
        (match (match_l xs xs2 bs)
          ((MtRErr m) (MtRErr m))
          ((MtRNo) (MtRNo))
          ((MtROk bs2) (match_e body body2 bs2))))
       (_ (MtRNo))))
    ((If a b d)
     (match c
       ((If a2 b2 d2)
        (match (match_e a a2 bs)
          ((MtRErr m) (MtRErr m))
          ((MtRNo) (MtRNo))
          ((MtROk bs1)
           (match (match_e b b2 bs1)
             ((MtRErr m) (MtRErr m))
             ((MtRNo) (MtRNo))
             ((MtROk bs2) (match_e d d2 bs2))))))
       (_ (MtRNo))))
    (_ (if (expr_eq p c) (MtROk bs) (MtRNo)))))

(fn match_l ((ps (List Expr)) (cs (List Expr)) (bs (List (Pair Int Expr)))) MtR
  (measure (struct ps))
  (match ps
    (Nil
      (match cs
        (Nil (MtROk bs))
        (_ (MtRNo))))
    ((Cons p pt)
     (match cs
       (Nil (MtRNo))
       ((Cons c ct)
        (match (match_e p c bs)
          ((MtRErr m) (MtRErr m))
          ((MtRNo) (MtRNo))
          ((MtROk bs2) (match_l pt ct bs2))))))))

(fn match_arms ((ps (List Arm)) (cs (List Arm)) (bs (List (Pair Int Expr)))) MtR
  (measure (struct ps))
  (match ps
    (Nil
      (match cs
        (Nil (MtROk bs))
        (_ (MtRNo))))
    ((Cons (Arm pp pb) pt)
     (match cs
       (Nil (MtRNo))
       ((Cons (Arm cp cb) ct)
        (if (pat_eq pp cp)
          (match (match_e pb cb bs)
            ((MtRErr m) (MtRErr m))
            ((MtRNo) (MtRNo))
            ((MtROk bs2) (match_arms pt ct bs2)))
          (MtRNo)))))))

;; first alternative matching v: its index offset (sum of the sizes of
;; the alternatives before it), its template, and its bindings
(type FaR (FaRErr (List Int)) (FaROk Int Expr (List (Pair Int Expr))))

(fn find_alt
  ((alts (List Expr)) (memo (List (Pair Int Int))) (v Expr) (off Int))
  FaR
  (measure (struct alts))
  (match alts
    (Nil (FaRErr "candidate matches no alternative of a live hole"))
    ((Cons a t)
     (match (match_e a v Nil)
       ((MtRErr m) (FaRErr m))
       ((MtRNo)
        (match (alt_size a memo)
          ((SkCErr m) (FaRErr m))
          ((SkCOk sz) (find_alt t memo v (+ off sz)))))
       ((MtROk bs) (FaROk off a bs))))))

;; forward pass: live (hole -> bound subtree); choices (hole -> its
;; matched alternative's offset and template)
(type RkR (RkRErr (List Int)) (RkROk (List (Pair Int (Pair Int Expr)))))

(fn rk_find ((k Int) (m (List (Pair Int Expr)))) (Option Expr) (asg_find k m))

(fn rk_merge ((ds (List (Pair Int Expr))) (live (List (Pair Int Expr))))
  (Option (List (Pair Int Expr)))
  (measure (struct ds))
  (match ds
    (Nil (Some live))
    ((Cons (Pair k v) t)
     (match (asg_find k live)
       (None (rk_merge t (Cons (Pair k v) live)))
       ((Some _) None)))))

(fn rank_decide
  ((es (List GEnt))
   (memo (List (Pair Int Int)))
   (live (List (Pair Int Expr)))
   (choices (List (Pair Int (Pair Int Expr)))))
  RkR
  (measure (struct es))
  (match es
    (Nil (RkROk choices))
    ((Cons (GEnt h alts) rest)
     (match (rk_find h live)
       (None (rank_decide rest memo live choices))
       ((Some v)
        (match (find_alt alts memo v 0)
          ((FaRErr m) (RkRErr m))
          ((FaROk off a bs)
           (match (rk_merge bs live)
             (None (RkRErr "hole is owned by two grammar entries"))
             ((Some live2)
              (rank_decide rest memo live2 (Cons (Pair h (Pair off a)) choices)))))))))))

;; compose digits over distinct holes ascending (last least-significant)
(fn digits_compose
  ((hs (List Int))
   (dmemo (List (Pair Int Int)))
   (memo (List (Pair Int Int)))
   (acc Int))
  SkC
  (measure (struct hs))
  (match hs
    (Nil (SkCOk acc))
    ((Cons h t)
     (match (memo_find h memo)
       (None (SkCErr "count memo is missing a hole (stratification violated)"))
       ((Some c)
        (match (memo_find h dmemo)
          (None (SkCErr "digit memo is missing a hole (rank drift)"))
          ((Some d) (digits_compose t dmemo memo (+ (* acc c) d)))))))))

;; reverse pass: each chosen hole's digit = its alternative's offset
;; composed with the (already-computed) digits of its own sub-holes
(fn rank_close
  ((rev_es (List GEnt))
   (choices (List (Pair Int (Pair Int Expr))))
   (memo (List (Pair Int Int)))
   (dmemo (List (Pair Int Int))))
  GCt
  (measure (struct rev_es))
  (match rev_es
    (Nil (GCtOk dmemo))
    ((Cons (GEnt h _) rest)
     (match (rk_choice h choices)
       (None (rank_close rest choices memo dmemo))
       ((Some (Pair off a))
        (match (holes_e a Nil)
          ((SkIdsErr m) (GCtErr m))
          ((SkIdsOk hs)
           (match (digits_compose hs dmemo memo 0)
             ((SkCErr m) (GCtErr m))
             ((SkCOk sub)
              (rank_close rest choices memo (Cons (Pair h (+ off sub)) dmemo)))))))))))

(fn rk_choice ((k Int) (cs (List (Pair Int (Pair Int Expr)))))
  (Option (Pair Int Expr))
  (measure (struct cs))
  (match cs
    (Nil None)
    ((Cons (Pair i v) t) (if (int_eq k i) (Some v) (rk_choice k t)))))

;; closed candidate -> its index under the addressing law (loud when the
;; candidate is not a member of the grammar's space)
(fn sk_rank ((root Expr) (g Grammar) (cand Expr)) SkC
  (match (g_counts g)
    ((GCtErr m) (SkCErr m))
    ((GCtOk memo)
     (match (match_e root cand Nil)
       ((MtRErr m) (SkCErr m))
       ((MtRNo) (SkCErr "candidate does not match the root sketch"))
       ((MtROk live0)
        (match g
          ((Grammar es)
           (match (rank_decide es memo live0 Nil)
             ((RkRErr m) (SkCErr m))
             ((RkROk choices)
              (match (rank_close (ents_rev es Nil) choices memo Nil)
                ((GCtErr m) (SkCErr m))
                ((GCtOk dmemo)
                 (match (holes_e root Nil)
                   ((SkIdsErr m) (SkCErr m))
                   ((SkIdsOk roots) (digits_compose roots dmemo memo 0))))))))))))))

;; ---- exact restricted regions ---------------------------------------------
;;
;; A narrowing job normally fixes some grammar choices. Relational pressure
;; also needs the dual operation: retain the original hole identity while
;; excluding one or more choices. `SkRegion` records both over the unchanged
;; Grammar DAG. This is deliberately below any rewrite/search policy.
;;
;; Exact counting is the ordinary reverse grammar fold with each entry's
;; alternatives restricted before summation. No grammar nodes are cloned, so
;; evaluators and their memos continue to use the original stable hole ids.
;;
;; `sk_region_subtract_cube` subtracts a conjunction of required choices as a
;; disjoint sum of products. For cube [h=a, k=b], the complement is
;;
;;   h!=a  |  (h=a, k!=b)
;;
;; and the optional hit is the final h=a,k=b region.
;;
;; RELATION-AWARE REGIONS (SEARCH.md arc-opener design, ratified 2026-07-25).
;; A region additionally carries lazy equality/difference restrictions
;; between holes of the UNCHANGED grammar — no cloned hole identities, and
;; relations (like forbids) never enter any evaluator memo key. An event
;; holds PARALLEL HOLE VECTORS, pointwise paired:
;;
;;   (SkRelEq ls rs) — every pointwise pair fills to EQUAL subtrees;
;;   (SkRelNe ls rs) — at least ONE pointwise pair differs (tuple
;;                     difference).
;;
;; Vector `ne` is what keeps propagation CLOSED: when a deep pair fixes the
;; same alternative on both sides, the pair is replaced by the sub-hole
;; vector of the aligned templates — the disjunction stays one event; `eq`
;; descends pointwise (the conjunction becomes more pairs). Relations relate
;; holes with BY-INDEX ISOMORPHIC domains (same alternative count, templates
;; equal up to a bijective renaming of sub-holes, recursively), so subtree
;; equality is exactly agreement of the remaining choice chain — under the
;; same alternative non-overlap discipline rank already requires.
;; `sk_region_relate_eq` / `sk_region_relate_ne` are the VALIDATED DOORS
;; (the trs_profile precedent): they check isomorphism and normalize; the
;; transparent constructor is not the API.
;;
;; Exact counting or loud refusal, never approximation: events partition
;; into connected components; unrelated holes keep the ordinary product
;; fold (endpoint factors masked to 1); per component, `eq` contracts by
;; union-find (a class counts as its members' intersected diagonal, walked
;; recursively through aligned templates) and `ne` counts by INCLUSION-
;; EXCLUSION over ne events — exact for arbitrary relation graphs, 2^events
;; per component, capped loudly. Count-time refusals: an endpoint that is
;; not unconditionally live under the region's fixed chains, an endpoint
;; inside another endpoint's domain closure, a component past the cap.
;; Relational regions are NOT rank-addressable (rank/unrank refuse);
;; membership is decided directly on bound subtrees.

(type SkRel (SkRelEq (List Int) (List Int)) (SkRelNe (List Int) (List Int)))
; parallel hole vectors, pointwise paired; same nonzero length

(type SkRegion
  (SkRegion (List (Pair Int Int)) (List (Pair Int Int)) (List SkRel)))
; fixed hole -> alternative index, forbidden hole -> alternative index,
; relation events

(fn sk_empty_region () SkRegion (SkRegion Nil Nil Nil))

(fn sk_region_choices ((region SkRegion)) (List (Pair Int Int))
  (match region
    ((SkRegion choices _ _) choices)))

(fn sk_region_forbids ((region SkRegion)) (List (Pair Int Int))
  (match region
    ((SkRegion _ forbids _) forbids)))

(fn sk_region_rels ((region SkRegion)) (List SkRel)
  (match region
    ((SkRegion _ _ rels) rels)))

(fn skr_region_with_rels ((region SkRegion) (rels (List SkRel))) SkRegion
  (match region
    ((SkRegion choices forbids _) (SkRegion choices forbids rels))))

(fn skr_pair_mem ((hole_id Int) (choice Int) (pairs (List (Pair Int Int)))) Bool
  (measure (struct pairs))
  (match pairs
    (Nil False)
    ((Cons (Pair h c) rest)
     (if (int_eq hole_id h)
       (if (int_eq choice c) True (skr_pair_mem hole_id choice rest))
       (skr_pair_mem hole_id choice rest)))))

(fn skr_hole_mem ((hole_id Int) (pairs (List (Pair Int Int)))) Bool
  (measure (struct pairs))
  (match pairs
    (Nil False)
    ((Cons (Pair h _) rest)
     (if (int_eq hole_id h) True (skr_hole_mem hole_id rest)))))

(fn skr_choice ((hole_id Int) (region SkRegion)) (Option Int)
  (match region
    ((SkRegion choices _ _) (memo_find hole_id choices))))

(fn skr_forbidden ((hole_id Int) (choice Int) (region SkRegion)) Bool
  (match region
    ((SkRegion _ forbids _) (skr_pair_mem hole_id choice forbids))))

(fn skr_alts_len ((alts (List Expr))) Int
  (measure (struct alts))
  (match alts
    (Nil 0)
    ((Cons _ rest) (+ 1 (skr_alts_len rest)))))

(fn skr_choice_valid ((choice Int) (alts (List Expr))) Bool
  (if (lt choice 0) False (lt choice (skr_alts_len alts))))

(fn skr_entry_alts ((entries (List GEnt)) (hole_id Int)) (Option (List Expr))
  (measure (struct entries))
  (match entries
    (Nil None)
    ((Cons (GEnt h alts) rest)
     (if (int_eq hole_id h) (Some alts) (skr_entry_alts rest hole_id)))))

(fn skr_pairs_wf
  ((entries (List GEnt))
   (pairs (List (Pair Int Int)))
   (unique_holes Bool)
   (seen (List (Pair Int Int))))
  (Option (List Int))
  (measure (struct pairs))
  (match pairs
    (Nil None)
    ((Cons (Pair hole_id choice) rest)
     (if (if unique_holes (skr_hole_mem hole_id seen) False)
       (Some "region fixes one hole more than once")
       (match (skr_entry_alts entries hole_id)
         (None (Some "region references an unknown grammar hole"))
         ((Some alts)
          (if (skr_choice_valid choice alts)
            (skr_pairs_wf
              entries
              rest
              unique_holes
              (Cons (Pair hole_id choice) seen))
            (Some "region choice is outside its grammar entry"))))))))

(fn skr_vec_wf ((entries (List GEnt)) (lefts (List Int)) (rights (List Int)))
  (Option (List Int))
  (measure (struct lefts))
  (match lefts
    (Nil
      (match rights
        (Nil None)
        ((Cons _ _) (Some "relation vectors differ in length"))))
    ((Cons l lrest)
     (match rights
       (Nil (Some "relation vectors differ in length"))
       ((Cons r rrest)
        (match (skr_entry_alts entries l)
          (None (Some "relation references an unknown grammar hole"))
          ((Some _)
           (match (skr_entry_alts entries r)
             (None (Some "relation references an unknown grammar hole"))
             ((Some _) (skr_vec_wf entries lrest rrest))))))))))

(fn skr_rels_wf ((entries (List GEnt)) (rels (List SkRel))) (Option (List Int))
  (measure (struct rels))
  (match rels
    (Nil None)
    ((Cons rel rest)
     (match rel
       ((SkRelEq lefts rights)
        (match lefts
          (Nil (Some "relation vector is empty"))
          ((Cons _ _)
           (match (skr_vec_wf entries lefts rights)
             ((Some msg) (Some msg))
             (None (skr_rels_wf entries rest))))))
       ((SkRelNe lefts rights)
        (match lefts
          (Nil (Some "relation vector is empty"))
          ((Cons _ _)
           (match (skr_vec_wf entries lefts rights)
             ((Some msg) (Some msg))
             (None (skr_rels_wf entries rest))))))))))

(type SkRegionWfR (SkRegionWfErr (List Int)) (SkRegionWfOk))

(fn sk_region_wf ((grammar Grammar) (region SkRegion)) SkRegionWfR
  (match grammar
    ((Grammar entries)
     (match region
       ((SkRegion choices forbids rels)
        (match (skr_pairs_wf entries choices True Nil)
          ((Some msg) (SkRegionWfErr msg))
          (None
            (match (skr_pairs_wf entries forbids False Nil)
              ((Some msg) (SkRegionWfErr msg))
              (None
                (match (skr_rels_wf entries rels)
                  ((Some msg) (SkRegionWfErr msg))
                  (None (SkRegionWfOk))))))))))))

(fn skr_sum_region_alts
  ((hole_id Int)
   (index Int)
   (alts (List Expr))
   (memo (List (Pair Int Int)))
   (region SkRegion))
  SkC
  (measure (struct alts))
  (match alts
    (Nil (SkCOk 0))
    ((Cons alt rest)
     (match (skr_choice hole_id region)
       ((Some chosen)
        (if (int_eq index chosen)
          (if (skr_forbidden hole_id index region) (SkCOk 0)
          (alt_size alt memo))
          (skr_sum_region_alts hole_id (+ index 1) rest memo region)))
       (None
         (match
           (if (skr_forbidden hole_id index region) (SkCOk 0)
           (alt_size alt memo))
           ((SkCErr msg) (SkCErr msg))
           ((SkCOk here)
            (match (skr_sum_region_alts hole_id (+ index 1) rest memo region)
              ((SkCErr msg) (SkCErr msg))
              ((SkCOk tail) (SkCOk (+ here tail)))))))))))

(fn skr_counts_go
  ((rev_entries (List GEnt)) (region SkRegion) (memo (List (Pair Int Int))))
  GCt
  (measure (struct rev_entries))
  (match rev_entries
    (Nil (GCtOk memo))
    ((Cons (GEnt hole_id alts) rest)
     (match (skr_sum_region_alts hole_id 0 alts memo region)
       ((SkCErr msg) (GCtErr msg))
       ((SkCOk count)
        (skr_counts_go rest region (Cons (Pair hole_id count) memo)))))))

(fn sk_region_count ((root Expr) (grammar Grammar) (region SkRegion)) SkC
  (match (g_wf grammar)
    ((GWErr msg) (SkCErr msg))
    ((GWOk)
     (match (sk_region_wf grammar region)
       ((SkRegionWfErr msg) (SkCErr msg))
       ((SkRegionWfOk)
        (match grammar
          ((Grammar entries)
           (match (sk_region_rels region)
             (Nil
               (match (skr_counts_go (ents_rev entries Nil) region Nil)
                 ((GCtErr msg) (SkCErr msg))
                 ((GCtOk memo)
                  (match (holes_e root Nil)
                    ((SkIdsErr msg) (SkCErr msg))
                    ((SkIdsOk roots) (prod_counts roots memo))))))
             ((Cons _ _) (skr_rel_count root entries region))))))))))

;; Restricted addressing keeps the ordinary candidate ordering after removing
;; forbidden alternatives and alternatives other than a fixed choice.  This is
;; not merely a convenience for search drivers: it makes a region an exact,
;; independently enumerable candidate space without manufacturing a second
;; Grammar (and therefore without changing any hole identity).

(fn skr_pick_alt
  ((hole_id Int)
   (index Int)
   (alts (List Expr))
   (memo (List (Pair Int Int)))
   (region SkRegion)
   (digit Int))
  PkR
  (measure (struct alts))
  (match alts
    (Nil (PkRErr "region alternative index out of range (count drift)"))
    ((Cons alt rest)
     (let
       ((allowed
          (match (skr_choice hole_id region)
            ((Some chosen) (int_eq index chosen))
            (None True))))
       (if (if allowed (skr_forbidden hole_id index region) False)
         (skr_pick_alt hole_id (+ index 1) rest memo region digit)
       (if allowed
         (match (alt_size alt memo)
           ((SkCErr msg) (PkRErr msg))
           ((SkCOk size)
            (if (lt digit size) (PkROk alt digit)
            (skr_pick_alt hole_id (+ index 1) rest memo region (- digit size)))))
         (skr_pick_alt hole_id (+ index 1) rest memo region digit)))))))

(fn skr_decide_go
  ((entries (List GEnt))
   (memo (List (Pair Int Int)))
   (region SkRegion)
   (live (List (Pair Int Int)))
   (choices (List (Pair Int Expr))))
  DcR
  (measure (struct entries))
  (match entries
    (Nil (DcROk choices))
    ((Cons (GEnt hole_id alts) rest)
     (match (memo_find hole_id live)
       (None (skr_decide_go rest memo region live choices))
       ((Some digit)
        (match (skr_pick_alt hole_id 0 alts memo region digit)
          ((PkRErr msg) (DcRErr msg))
          ((PkROk alt residual)
           (match (holes_e alt Nil)
             ((SkIdsErr msg) (DcRErr msg))
             ((SkIdsOk holes)
              (match (digits_go (ids_rev holes Nil) memo residual Nil)
                ((DgRErr msg) (DcRErr msg))
                ((DgROk digits)
                 (match (live_merge digits live)
                   (None (DcRErr "hole is owned by two grammar entries"))
                   ((Some live2)
                    (skr_decide_go
                      rest
                      memo
                      region
                      live2
                      (Cons (Pair hole_id alt) choices)))))))))))))))

(fn skr_find_alt
  ((hole_id Int)
   (index Int)
   (alts (List Expr))
   (memo (List (Pair Int Int)))
   (region SkRegion)
   (value Expr)
   (offset Int))
  FaR
  (measure (struct alts))
  (match alts
    (Nil (FaRErr "candidate matches no allowed alternative of a live hole"))
    ((Cons alt rest)
     (let
       ((allowed
          (match (skr_choice hole_id region)
            ((Some chosen) (int_eq index chosen))
            (None True))))
       (if (if allowed (skr_forbidden hole_id index region) False)
         (skr_find_alt hole_id (+ index 1) rest memo region value offset)
       (if allowed
         (match (match_e alt value Nil)
           ((MtRErr msg) (FaRErr msg))
           ((MtROk bindings) (FaROk offset alt bindings))
           ((MtRNo)
            (match (alt_size alt memo)
              ((SkCErr msg) (FaRErr msg))
              ((SkCOk size)
               (skr_find_alt
                 hole_id
                 (+ index 1)
                 rest
                 memo
                 region
                 value
                 (+ offset size))))))
         (skr_find_alt hole_id (+ index 1) rest memo region value offset)))))))

(fn skr_rank_decide
  ((entries (List GEnt))
   (memo (List (Pair Int Int)))
   (region SkRegion)
   (live (List (Pair Int Expr)))
   (choices (List (Pair Int (Pair Int Expr)))))
  RkR
  (measure (struct entries))
  (match entries
    (Nil (RkROk choices))
    ((Cons (GEnt hole_id alts) rest)
     (match (rk_find hole_id live)
       (None (skr_rank_decide rest memo region live choices))
       ((Some value)
        (match (skr_find_alt hole_id 0 alts memo region value 0)
          ((FaRErr msg) (RkRErr msg))
          ((FaROk offset alt bindings)
           (match (rk_merge bindings live)
             (None (RkRErr "hole is owned by two grammar entries"))
             ((Some live2)
              (skr_rank_decide
                rest
                memo
                region
                live2
                (Cons (Pair hole_id (Pair offset alt)) choices)))))))))))

(fn sk_region_rank
  ((root Expr) (grammar Grammar) (region SkRegion) (candidate Expr))
  SkC
  (match (sk_region_rels region)
    (Nil
      (match (g_wf grammar)
        ((GWErr msg) (SkCErr msg))
        ((GWOk)
         (match (sk_region_wf grammar region)
           ((SkRegionWfErr msg) (SkCErr msg))
           ((SkRegionWfOk)
            (match (match_e root candidate Nil)
              ((MtRErr msg) (SkCErr msg))
              ((MtRNo) (SkCErr "candidate does not match the root sketch"))
              ((MtROk live0)
               (match grammar
                 ((Grammar entries)
                  (match (skr_counts_go (ents_rev entries Nil) region Nil)
                    ((GCtErr msg) (SkCErr msg))
                    ((GCtOk memo)
                     (match (skr_rank_decide entries memo region live0 Nil)
                       ((RkRErr msg) (SkCErr msg))
                       ((RkROk choices)
                        (match
                          (rank_close (ents_rev entries Nil) choices memo Nil)
                          ((GCtErr msg) (SkCErr msg))
                          ((GCtOk digits)
                           (match (holes_e root Nil)
                             ((SkIdsErr msg) (SkCErr msg))
                             ((SkIdsOk roots)
                              (digits_compose roots digits memo 0))))))))))))))))))
    ((Cons _ _) (SkCErr "relational regions are not rank-addressable"))))

;; Membership is decided directly — the cube part by the same first-match
;; forward walk rank uses (without counts), relations by expr_eq over the
;; bound subtrees. Relational regions are members-decidable even though
;; they are not rank-addressable.
(fn sk_region_member
  ((root Expr) (grammar Grammar) (region SkRegion) (candidate Expr))
  Bool
  (match (g_wf grammar)
    ((GWErr _) False)
    ((GWOk)
     (match (sk_region_wf grammar region)
       ((SkRegionWfErr _) False)
       ((SkRegionWfOk)
        (match (match_e root candidate Nil)
          ((MtRErr _) False)
          ((MtRNo) False)
          ((MtROk live0)
           (match grammar
             ((Grammar entries)
              (match (skr_member_decide entries region live0)
                ((MbRErr _) False)
                ((MbRNo) False)
                ((MbROk bound) (skr_member_rels (sk_region_rels region) bound))))))))))))

(fn sk_region_unrank
  ((root Expr) (grammar Grammar) (region SkRegion) (index Int))
  SkE
  (match (sk_region_rels region)
    (Nil
      (match (g_wf grammar)
        ((GWErr msg) (SkEErr msg))
        ((GWOk)
         (match (sk_region_wf grammar region)
           ((SkRegionWfErr msg) (SkEErr msg))
           ((SkRegionWfOk)
            (match grammar
              ((Grammar entries)
               (match (skr_counts_go (ents_rev entries Nil) region Nil)
                 ((GCtErr msg) (SkEErr msg))
                 ((GCtOk memo)
                  (match (holes_e root Nil)
                    ((SkIdsErr msg) (SkEErr msg))
                    ((SkIdsOk roots)
                     (match (prod_counts roots memo)
                       ((SkCErr msg) (SkEErr msg))
                       ((SkCOk total)
                        (if (lt index 0)
                          (SkEErr "region candidate index below zero")
                        (if (le total index)
                          (SkEErr "region candidate index out of range")
                          (match (digits_go (ids_rev roots Nil) memo index Nil)
                            ((DgRErr msg) (SkEErr msg))
                            ((DgROk live0)
                             (match
                               (skr_decide_go entries memo region live0 Nil)
                               ((DcRErr msg) (SkEErr msg))
                               ((DcROk choices)
                                (match
                                  (close_go (ents_rev entries Nil) choices Nil)
                                  ((ClRErr msg) (SkEErr msg))
                                  ((ClROk closed)
                                   (match (fill_e root closed)
                                     ((SkEErr msg) (SkEErr msg))
                                     ((SkEOk result)
                                      (if (sk_closed result) (SkEOk result)
                                      (SkEErr
                                        "region unrank left holes (grammar incomplete for the root)")))))))))))))))))))))))))
    ((Cons _ _) (SkEErr "relational regions are not rank-addressable"))))

;; Cardinality-free representative selection.  Synthesis only needs one
;; member of a surviving restricted region; computing its rank first couples
;; that operation to every (potentially enormous) sibling subspace.  The
;; graduated walk lives below with the language interface
;; (`sk_region_first_lang`); this materialized-Grammar door validates and
;; delegates.
(type SkrFirstAltR (SkrFirstAltErr (List Int)) (SkrFirstAltOk Expr))

(fn sk_region_first ((root Expr) (grammar Grammar) (region SkRegion)) SkE
  (match (g_wf grammar)
    ((GWErr msg) (SkEErr msg))
    ((GWOk)
     (match (sk_region_wf grammar region)
       ((SkRegionWfErr msg) (SkEErr msg))
       ((SkRegionWfOk) (sk_region_first_lang root (SkLangFlat grammar) region))))))

(type SkRegionEditR
  (SkRegionEditErr (List Int))
  (SkRegionEditEmpty)
  (SkRegionEditOk SkRegion))

(fn sk_region_choose_known
  ((region SkRegion) (hole_id Int) (choice Int) (alts (List Expr)))
  SkRegionEditR
  (if (skr_choice_valid choice alts)
    (match (skr_choice hole_id region)
      ((Some prior)
       (if (int_eq prior choice) (SkRegionEditOk region) (SkRegionEditEmpty)))
      (None
        (if (skr_forbidden hole_id choice region) (SkRegionEditEmpty)
        (match region
          ((SkRegion choices forbids rels)
           (SkRegionEditOk
             (SkRegion (Cons (Pair hole_id choice) choices) forbids rels)))))))
    (SkRegionEditErr "region choice is outside its grammar entry")))

(fn sk_region_choose
  ((grammar Grammar) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR
  (match grammar
    ((Grammar entries)
     (match (skr_entry_alts entries hole_id)
       (None (SkRegionEditErr "region choice references an unknown hole"))
       ((Some alts) (sk_region_choose_known region hole_id choice alts))))))

(fn skr_forbid_known ((region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR
  (match (skr_choice hole_id region)
    ((Some prior)
     (if (int_eq prior choice) (SkRegionEditEmpty) (SkRegionEditOk region)))
    (None
      (if (skr_forbidden hole_id choice region) (SkRegionEditOk region)
      (match region
        ((SkRegion choices forbids rels)
         (SkRegionEditOk
           (SkRegion choices (Cons (Pair hole_id choice) forbids) rels))))))))

(fn sk_region_forbid
  ((grammar Grammar) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR
  (match grammar
    ((Grammar entries)
     (match (skr_entry_alts entries hole_id)
       (None (SkRegionEditErr "region exclusion references an unknown hole"))
       ((Some alts)
        (if (skr_choice_valid choice alts)
          (skr_forbid_known region hole_id choice)
          (SkRegionEditErr "region exclusion is outside its grammar entry")))))))

(fn skr_regions_reverse ((regions (List SkRegion)) (acc (List SkRegion)))
  (List SkRegion)
  (measure (struct regions))
  (match regions
    (Nil acc)
    ((Cons region rest) (skr_regions_reverse rest (Cons region acc)))))

(type SkRegionSubtractR
  (SkRegionSubtractErr (List Int))
  (SkRegionSubtractOk (Option SkRegion) (List SkRegion)))
; exact cube hit, disjoint complement regions

(fn skr_subtract_cube_go
  ((grammar Grammar)
   (prefix SkRegion)
   (cube (List (Pair Int Int)))
   (rev_complement (List SkRegion)))
  SkRegionSubtractR
  (measure (struct cube))
  (match cube
    (Nil
      (SkRegionSubtractOk
        (Some prefix)
        (skr_regions_reverse rev_complement Nil)))
    ((Cons (Pair hole_id choice) rest)
     (match (sk_region_choose grammar prefix hole_id choice)
       ((SkRegionEditErr msg) (SkRegionSubtractErr msg))
       ((SkRegionEditEmpty)
        (SkRegionSubtractOk
          None
          (skr_regions_reverse (Cons prefix rev_complement) Nil)))
       ((SkRegionEditOk hit_prefix)
        (match (sk_region_forbid grammar prefix hole_id choice)
          ((SkRegionEditErr msg) (SkRegionSubtractErr msg))
          ((SkRegionEditEmpty)
           (skr_subtract_cube_go grammar hit_prefix rest rev_complement))
          ((SkRegionEditOk miss_branch)
           (skr_subtract_cube_go
             grammar
             hit_prefix
             rest
             (Cons miss_branch rev_complement)))))))))

(fn sk_region_subtract_cube
  ((grammar Grammar) (region SkRegion) (cube (List (Pair Int Int))))
  SkRegionSubtractR
  (match (sk_region_wf grammar region)
    ((SkRegionWfErr msg) (SkRegionSubtractErr msg))
    ((SkRegionWfOk) (skr_subtract_cube_go grammar region cube Nil))))

;; ---- the language interface: one relational algebra over both grammars ----
;;
;; The relational region machinery (the doors, normalization, and the
;; first walk) is language-parametric: a materialized Grammar and a
;; regular schema grammar answer the same three questions — a hole's
;; instantiated alternatives, endpoint isomorphism, and per-alternative
;; productivity.  Schema isomorphism holds BY CONSTRUCTION: two
;; occurrences governed by the same schema id instantiate index-aligned
;; identical domains at every depth, so the door's check is id equality.
;; Exact counting and rank/unrank remain materialized-Grammar-only —
;; first-mode never counts.
(type SkLang (SkLangFlat Grammar) (SkLangSchema SkSchemaGrammar))

(fn skl_alts ((lang SkLang) (hole_id Int)) SkSchemaAltsR
  (match lang
    ((SkLangFlat (Grammar entries))
     (match (skr_entry_alts entries hole_id)
       (None (SkSchemaAltsErr "region hole is absent from its grammar"))
       ((Some alts) (SkSchemaAltsOk alts))))
    ((SkLangSchema grammar) (sk_schema_alts_at grammar hole_id))))

(fn skl_iso ((lang SkLang) (h0 Int) (h1 Int)) SkIsoR
  (match lang
    ((SkLangFlat (Grammar entries))
     (skr_iso_holes entries h0 h1 (skr_iso_fuel entries)))
    ((SkLangSchema grammar)
     (match (sk_schema_id_at grammar h0)
       ((SkSchemaIdErr msg) (SkIsoErr msg))
       ((SkSchemaIdOk id0)
        (match (sk_schema_id_at grammar h1)
          ((SkSchemaIdErr msg) (SkIsoErr msg))
          ((SkSchemaIdOk id1)
           (if (int_eq id0 id1) (SkIsoOk)
           (SkIsoErr "relation endpoints have non-isomorphic domains")))))))))

(fn skl_size ((lang SkLang)) Int
  (match lang
    ((SkLangFlat (Grammar entries)) (skr_ents_len entries))
    ((SkLangSchema (SkSchemaGrammar _ entries)) (sks_entries_len entries))))

(fn skl_pairs_len ((pairs (List (Pair Int Int)))) Int
  (measure (struct pairs))
  (match pairs
    (Nil 0)
    ((Cons _ rest) (+ 1 (skl_pairs_len rest)))))

;; Normalization rounds are bounded by the live description, not by the
;; (schema-infinite) occurrence space: entries + fixed chains + events.
(fn skl_norm_fuel ((lang SkLang) (region SkRegion)) Int
  (match region
    ((SkRegion choices _ rels)
     (+
       16
       (* 8 (+ (skl_size lang) (+ (skl_pairs_len choices) (skr_rels_len rels))))))))

(type SkLangProd
  (SkLangProdFlat SkProductivity)
  (SkLangProdSchema SkSchemaProductivity))

(fn skl_productivity ((lang SkLang)) SkLangProd
  (match lang
    ((SkLangFlat grammar) (SkLangProdFlat (sk_productivity grammar)))
    ((SkLangSchema grammar) (SkLangProdSchema (sk_schema_productivity grammar)))))

(fn skl_alt_productive
  ((lang SkLang) (prod SkLangProd) (hole_id Int) (index Int))
  Bool
  (match prod
    ((SkLangProdFlat productivity)
     (sk_alt_productive productivity hole_id index))
    ((SkLangProdSchema (SkSchemaProductivity facts))
     (match lang
       ((SkLangFlat _) False)
       ((SkLangSchema grammar)
        (match (sk_schema_id_at grammar hole_id)
          ((SkSchemaIdErr _) False)
          ((SkSchemaIdOk schema_id)
           (match (sks_fact_find schema_id facts)
             (None False)
             ((Some bits) (sks_nth_bool bits index))))))))))

;; ---- relation machinery: alignment, isomorphism, pair evaluation ----------

(fn skr_ents_len ((entries (List GEnt))) Int
  (measure (struct entries))
  (match entries
    (Nil 0)
    ((Cons _ rest) (+ 1 (skr_ents_len rest)))))

(fn skr_nth_alt ((alts (List Expr)) (index Int)) (Option Expr)
  (measure (struct alts))
  (match alts
    (Nil None)
    ((Cons alt rest)
     (if (lt index 0) None
     (if (int_eq index 0) (Some alt)
     (skr_nth_alt rest (- index 1)))))))

(fn skr_vec_pairs ((lefts (List Int)) (rights (List Int))) (List (Pair Int Int))
  (measure (struct lefts))
  (match lefts
    (Nil Nil)
    ((Cons l lrest)
     (match rights
       (Nil Nil)
       ((Cons r rrest) (Cons (Pair l r) (skr_vec_pairs lrest rrest)))))))

(fn skr_pairs_onto ((pairs (List (Pair Int Int))) (acc (List (Pair Int Int))))
  (List (Pair Int Int))
  (measure (struct pairs))
  (match pairs
    (Nil acc)
    ((Cons pair rest) (skr_pairs_onto rest (Cons pair acc)))))

(fn skr_pairs_rev ((pairs (List (Pair Int Int)))) (List (Pair Int Int))
  (skr_pairs_onto pairs Nil))

(fn skr_pairs_lefts ((pairs (List (Pair Int Int)))) (List Int)
  (measure (struct pairs))
  (match pairs
    (Nil Nil)
    ((Cons (Pair l _) rest) (Cons l (skr_pairs_lefts rest)))))

(fn skr_pairs_rights ((pairs (List (Pair Int Int)))) (List Int)
  (measure (struct pairs))
  (match pairs
    (Nil Nil)
    ((Cons (Pair _ r) rest) (Cons r (skr_pairs_rights rest)))))

(fn skr_rel_eq_of ((pairs (List (Pair Int Int)))) SkRel
  (SkRelEq (skr_pairs_lefts pairs) (skr_pairs_rights pairs)))

(fn skr_rel_ne_of ((pairs (List (Pair Int Int)))) SkRel
  (SkRelNe (skr_pairs_lefts pairs) (skr_pairs_rights pairs)))

(fn skr_rel_holes_into ((rel SkRel) (acc (List Int))) (List Int)
  (match rel
    ((SkRelEq lefts rights) (ids_union lefts (ids_union rights acc)))
    ((SkRelNe lefts rights) (ids_union lefts (ids_union rights acc)))))

(fn skr_rels_holes ((rels (List SkRel)) (acc (List Int))) (List Int)
  (measure (struct rels))
  (match rels
    (Nil acc)
    ((Cons rel rest) (skr_rels_holes rest (skr_rel_holes_into rel acc)))))

(fn skr_rels_len ((rels (List SkRel))) Int
  (measure (struct rels))
  (match rels
    (Nil 0)
    ((Cons _ rest) (+ 1 (skr_rels_len rest)))))

(fn skr_rels_rev ((rels (List SkRel)) (acc (List SkRel))) (List SkRel)
  (measure (struct rels))
  (match rels
    (Nil acc)
    ((Cons rel rest) (skr_rels_rev rest (Cons rel acc)))))

(fn skr_ids_subset ((xs (List Int)) (ks (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons x rest) (if (ids_member x ks) (skr_ids_subset rest ks) False))))

(fn skr_any_id_member ((xs (List Int)) (ks (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil False)
    ((Cons x rest) (if (ids_member x ks) True (skr_any_id_member rest ks)))))

(fn skr_allows ((hole_id Int) (index Int) (region SkRegion)) Bool
  (match (skr_choice hole_id region)
    ((Some chosen) (int_eq chosen index))
    (None (if (skr_forbidden hole_id index region) False True))))

(fn skr_index_allowed
  ((alts (List Expr)) (index Int) (hole_id Int) (region SkRegion))
  Bool
  (match (skr_nth_alt alts index)
    (None False)
    ((Some _) (skr_allows hole_id index region))))

(fn skr_any_common
  ((h0 Int)
   (h1 Int)
   (index Int)
   (alts0 (List Expr))
   (alts1 (List Expr))
   (region SkRegion))
  Bool
  (measure (struct alts0))
  (match alts0
    (Nil False)
    ((Cons _ rest0)
     (match alts1
       (Nil False)
       ((Cons _ rest1)
        (if (if (skr_allows h0 index region) (skr_allows h1 index region) False)
          True
          (skr_any_common h0 h1 (+ index 1) rest0 rest1 region)))))))

;; Template alignment: walk two templates in parallel, requiring structural
;; agreement everywhere except at holes, which must correspond through ONE
;; BIJECTIVE renaming (sharing patterns must match on both sides). Ok
;; carries the positional hole pairs; No means the shapes disagree.
(type SkAlignR
  (SkAlignErr (List Int))
  (SkAlignNo)
  (SkAlignOk (List (Pair Int Int))))

(fn skr_pairs_bwd ((h1 Int) (pairs (List (Pair Int Int)))) (Option Int)
  (measure (struct pairs))
  (match pairs
    (Nil None)
    ((Cons (Pair a b) rest) (if (int_eq b h1) (Some a) (skr_pairs_bwd h1 rest)))))

(fn skr_align_bind ((h0 Int) (h1 Int) (pairs (List (Pair Int Int)))) SkAlignR
  (match (memo_find h0 pairs)
    (None
      (match (skr_pairs_bwd h1 pairs)
        (None (SkAlignOk (Cons (Pair h0 h1) pairs)))
        ((Some _) (SkAlignNo))))
    ((Some bound) (if (int_eq bound h1) (SkAlignOk pairs) (SkAlignNo)))))

(fn skr_align_e ((e0 Expr) (e1 Expr) (pairs (List (Pair Int Int)))) SkAlignR
  (measure (struct e0))
  (match (hole_view e0)
    ((HVBad msg) (SkAlignErr msg))
    ((HVHole h0)
     (match (hole_view e1)
       ((HVBad msg) (SkAlignErr msg))
       ((HVHole h1) (skr_align_bind h0 h1 pairs))
       ((HVNot) (SkAlignNo))))
    ((HVNot)
     (match (hole_view e1)
       ((HVBad msg) (SkAlignErr msg))
       ((HVHole _) (SkAlignNo))
       ((HVNot)
        (match e0
          ((Ctor q0 as0)
           (match e1
             ((Ctor q1 as1)
              (if (qname_eq q0 q1) (skr_align_l as0 as1 pairs) (SkAlignNo)))
             (_ (SkAlignNo))))
          ((Call q0 as0)
           (match e1
             ((Call q1 as1)
              (if (qname_eq q0 q1) (skr_align_l as0 as1 pairs) (SkAlignNo)))
             (_ (SkAlignNo))))
          ((Match s0 arms0)
           (match e1
             ((Match s1 arms1)
              (match (skr_align_e s0 s1 pairs)
                ((SkAlignErr msg) (SkAlignErr msg))
                ((SkAlignNo) (SkAlignNo))
                ((SkAlignOk pairs2) (skr_align_arms arms0 arms1 pairs2))))
             (_ (SkAlignNo))))
          ((Let binds0 body0)
           (match e1
             ((Let binds1 body1)
              (match (skr_align_l binds0 binds1 pairs)
                ((SkAlignErr msg) (SkAlignErr msg))
                ((SkAlignNo) (SkAlignNo))
                ((SkAlignOk pairs2) (skr_align_e body0 body1 pairs2))))
             (_ (SkAlignNo))))
          ((If c0 a0 b0)
           (match e1
             ((If c1 a1 b1)
              (match (skr_align_e c0 c1 pairs)
                ((SkAlignErr msg) (SkAlignErr msg))
                ((SkAlignNo) (SkAlignNo))
                ((SkAlignOk pairs1)
                 (match (skr_align_e a0 a1 pairs1)
                   ((SkAlignErr msg) (SkAlignErr msg))
                   ((SkAlignNo) (SkAlignNo))
                   ((SkAlignOk pairs2) (skr_align_e b0 b1 pairs2))))))
             (_ (SkAlignNo))))
          (_ (if (expr_eq e0 e1) (SkAlignOk pairs) (SkAlignNo)))))))))

(fn skr_align_l
  ((es0 (List Expr)) (es1 (List Expr)) (pairs (List (Pair Int Int))))
  SkAlignR
  (measure (struct es0))
  (match es0
    (Nil
      (match es1
        (Nil (SkAlignOk pairs))
        ((Cons _ _) (SkAlignNo))))
    ((Cons h0 t0)
     (match es1
       (Nil (SkAlignNo))
       ((Cons h1 t1)
        (match (skr_align_e h0 h1 pairs)
          ((SkAlignErr msg) (SkAlignErr msg))
          ((SkAlignNo) (SkAlignNo))
          ((SkAlignOk pairs2) (skr_align_l t0 t1 pairs2))))))))

(fn skr_align_arms
  ((arms0 (List Arm)) (arms1 (List Arm)) (pairs (List (Pair Int Int))))
  SkAlignR
  (measure (struct arms0))
  (match arms0
    (Nil
      (match arms1
        (Nil (SkAlignOk pairs))
        ((Cons _ _) (SkAlignNo))))
    ((Cons (Arm p0 b0) t0)
     (match arms1
       (Nil (SkAlignNo))
       ((Cons (Arm p1 b1) t1)
        (if (pat_eq p0 p1)
          (match (skr_align_e b0 b1 pairs)
            ((SkAlignErr msg) (SkAlignErr msg))
            ((SkAlignNo) (SkAlignNo))
            ((SkAlignOk pairs2) (skr_align_arms t0 t1 pairs2)))
          (SkAlignNo)))))))

;; By-index domain isomorphism — the validated doors' admission check.
(type SkIsoR (SkIsoErr (List Int)) (SkIsoOk))

(fn skr_iso_fuel ((entries (List GEnt))) Int
  (+ 64 (* 8 (skr_ents_len entries))))

(fn skr_iso_holes ((entries (List GEnt)) (h0 Int) (h1 Int) (fuel Int)) SkIsoR
  (measure fuel)
  (if (lt fuel 1) (SkIsoErr "relation isomorphism fuel exhausted")
  (if (int_eq h0 h1) (SkIsoOk)
  (match (skr_entry_alts entries h0)
    (None (SkIsoErr "relation references an unknown grammar hole"))
    ((Some alts0)
     (match (skr_entry_alts entries h1)
       (None (SkIsoErr "relation references an unknown grammar hole"))
       ((Some alts1) (skr_iso_alts entries alts0 alts1 (- fuel 1)))))))))

(fn skr_iso_alts
  ((entries (List GEnt)) (alts0 (List Expr)) (alts1 (List Expr)) (fuel Int))
  SkIsoR
  (measure fuel)
  (if (lt fuel 1) (SkIsoErr "relation isomorphism fuel exhausted")
  (match alts0
    (Nil
      (match alts1
        (Nil (SkIsoOk))
        ((Cons _ _) (SkIsoErr "relation endpoints have non-isomorphic domains"))))
    ((Cons a0 rest0)
     (match alts1
       (Nil (SkIsoErr "relation endpoints have non-isomorphic domains"))
       ((Cons a1 rest1)
        (match (skr_align_e a0 a1 Nil)
          ((SkAlignErr msg) (SkIsoErr msg))
          ((SkAlignNo)
           (SkIsoErr "relation endpoints have non-isomorphic domains"))
          ((SkAlignOk pairs)
           (match (skr_iso_pairs entries pairs (- fuel 1))
             ((SkIsoErr msg) (SkIsoErr msg))
             ((SkIsoOk) (skr_iso_alts entries rest0 rest1 (- fuel 1))))))))))))

(fn skr_iso_pairs
  ((entries (List GEnt)) (pairs (List (Pair Int Int))) (fuel Int))
  SkIsoR
  (measure fuel)
  (if (lt fuel 1) (SkIsoErr "relation isomorphism fuel exhausted")
  (match pairs
    (Nil (SkIsoOk))
    ((Cons (Pair h0 h1) rest)
     (match (skr_iso_holes entries h0 h1 (- fuel 1))
       ((SkIsoErr msg) (SkIsoErr msg))
       ((SkIsoOk) (skr_iso_pairs entries rest (- fuel 1))))))))

;; ---- relation propagation: three-valued pair evaluation + normalization ---

(fn skr_choose_at ((lang SkLang) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR
  (match (skl_alts lang hole_id)
    ((SkSchemaAltsErr msg) (SkRegionEditErr msg))
    ((SkSchemaAltsOk alts) (sk_region_choose_known region hole_id choice alts))))

(fn skr_forbid_at ((lang SkLang) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR
  (match (skl_alts lang hole_id)
    ((SkSchemaAltsErr msg) (SkRegionEditErr msg))
    ((SkSchemaAltsOk alts)
     (if (skr_choice_valid choice alts) (skr_forbid_known region hole_id choice)
     (SkRegionEditErr "region exclusion is outside its grammar entry")))))

;; One pointwise pair, three-valued (with descent as the fourth outcome):
;; both endpoints fixed to the same index descend to the aligned templates'
;; sub-hole pairs; different indices differ (the non-overlap discipline);
;; a one-sided fix or an undecided overlap stays blocked — normalization
;; owns the propagation.
(type SkRelPairR
  (SkRelPairErr (List Int))
  (SkRelPairEqual)
  (SkRelPairDiffer)
  (SkRelPairBlocked)
  (SkRelPairDescend (List (Pair Int Int))))

(fn skr_pair_eval ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int)) SkRelPairR
  (if (int_eq h0 h1) (SkRelPairEqual)
  (match (skl_alts lang h0)
    ((SkSchemaAltsErr msg) (SkRelPairErr msg))
    ((SkSchemaAltsOk alts0)
     (match (skl_alts lang h1)
       ((SkSchemaAltsErr msg) (SkRelPairErr msg))
       ((SkSchemaAltsOk alts1)
        (match (skr_choice h0 region)
          ((Some c0)
           (match (skr_choice h1 region)
             ((Some c1)
              (if (int_eq c0 c1)
                (match (skr_nth_alt alts0 c0)
                  (None
                    (SkRelPairErr "region choice is outside its grammar entry"))
                  ((Some t0)
                   (match (skr_nth_alt alts1 c1)
                     (None (SkRelPairDiffer))
                     ((Some t1)
                      (match (skr_align_e t0 t1 Nil)
                        ((SkAlignErr msg) (SkRelPairErr msg))
                        ((SkAlignNo)
                         (if (if (sk_closed t0) (sk_closed t1) False)
                           (SkRelPairDiffer)
                           (SkRelPairErr
                             "relation endpoints have non-isomorphic domains")))
                        ((SkAlignOk pairs)
                         (match pairs
                           (Nil (SkRelPairEqual))
                           ((Cons _ _) (SkRelPairDescend pairs)))))))))
                (SkRelPairDiffer)))
             (None
               (if (skr_index_allowed alts1 c0 h1 region) (SkRelPairBlocked)
               (SkRelPairDiffer)))))
          (None
            (match (skr_choice h1 region)
              ((Some c1)
               (if (skr_index_allowed alts0 c1 h0 region) (SkRelPairBlocked)
               (SkRelPairDiffer)))
              (None
                (if (skr_any_common h0 h1 0 alts0 alts1 region)
                  (SkRelPairBlocked)
                  (SkRelPairDiffer))))))))))))

;; The last live pair of a `ne` event whose fixed side chose a CLOSED
;; template converts to an ordinary forbid on the open side.
(type SkRelSingR
  (SkRelSingErr (List Int))
  (SkRelSingEmpty)
  (SkRelSingKeep)
  (SkRelSingDrop SkRegion))

(fn skr_ne_singleton_side
  ((lang SkLang)
   (region SkRegion)
   (fixed_hole Int)
   (fixed_choice Int)
   (open_hole Int))
  SkRelSingR
  (match (skl_alts lang fixed_hole)
    ((SkSchemaAltsErr msg) (SkRelSingErr msg))
    ((SkSchemaAltsOk alts)
     (match (skr_nth_alt alts fixed_choice)
       (None (SkRelSingErr "region choice is outside its grammar entry"))
       ((Some template)
        (if (sk_closed template)
          (match (skr_forbid_at lang region open_hole fixed_choice)
            ((SkRegionEditErr msg) (SkRelSingErr msg))
            ((SkRegionEditEmpty) (SkRelSingEmpty))
            ((SkRegionEditOk region2) (SkRelSingDrop region2)))
          (SkRelSingKeep)))))))

(fn skr_ne_singleton ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRelSingR
  (match (skr_choice h0 region)
    ((Some c0)
     (match (skr_choice h1 region)
       ((Some _) (SkRelSingKeep))
       (None (skr_ne_singleton_side lang region h0 c0 h1))))
    (None
      (match (skr_choice h1 region)
        ((Some c1) (skr_ne_singleton_side lang region h1 c1 h0))
        (None (SkRelSingKeep))))))

(type SkRelVecR
  (SkRelVecErr (List Int))
  (SkRelVecEmpty)
  (SkRelVecSat)
  (SkRelVecOk (List (Pair Int Int)) SkRegion Bool))

(fn skr_norm_eq_pairs
  ((lang SkLang)
   (region SkRegion)
   (pairs (List (Pair Int Int)))
   (acc (List (Pair Int Int)))
   (changed Bool))
  SkRelVecR
  (measure (struct pairs))
  (match pairs
    (Nil (SkRelVecOk (skr_pairs_rev acc) region changed))
    ((Cons (Pair h0 h1) rest)
     (match (skr_pair_eval lang region h0 h1)
       ((SkRelPairErr msg) (SkRelVecErr msg))
       ((SkRelPairEqual) (skr_norm_eq_pairs lang region rest acc True))
       ((SkRelPairDiffer) (SkRelVecEmpty))
       ((SkRelPairBlocked)
        (match (skr_choice h0 region)
          ((Some c0)
           (match (skr_choose_at lang region h1 c0)
             ((SkRegionEditErr msg) (SkRelVecErr msg))
             ((SkRegionEditEmpty) (SkRelVecEmpty))
             ((SkRegionEditOk region2)
              (skr_norm_eq_pairs lang region2 rest (Cons (Pair h0 h1) acc) True))))
          (None
            (match (skr_choice h1 region)
              ((Some c1)
               (match (skr_choose_at lang region h0 c1)
                 ((SkRegionEditErr msg) (SkRelVecErr msg))
                 ((SkRegionEditEmpty) (SkRelVecEmpty))
                 ((SkRegionEditOk region2)
                  (skr_norm_eq_pairs
                    lang
                    region2
                    rest
                    (Cons (Pair h0 h1) acc)
                    True))))
              (None
                (skr_norm_eq_pairs
                  lang
                  region
                  rest
                  (Cons (Pair h0 h1) acc)
                  changed))))))
       ((SkRelPairDescend subs)
        (skr_norm_eq_pairs lang region rest (skr_pairs_onto subs acc) True))))))

(fn skr_norm_ne_pairs
  ((lang SkLang)
   (region SkRegion)
   (pairs (List (Pair Int Int)))
   (acc (List (Pair Int Int)))
   (changed Bool))
  SkRelVecR
  (measure (struct pairs))
  (match pairs
    (Nil
      (match acc
        (Nil (SkRelVecEmpty))
        ((Cons _ _) (SkRelVecOk (skr_pairs_rev acc) region changed))))
    ((Cons (Pair h0 h1) rest)
     (match (skr_pair_eval lang region h0 h1)
       ((SkRelPairErr msg) (SkRelVecErr msg))
       ((SkRelPairEqual) (skr_norm_ne_pairs lang region rest acc True))
       ((SkRelPairDiffer) (SkRelVecSat))
       ((SkRelPairBlocked)
        (skr_norm_ne_pairs lang region rest (Cons (Pair h0 h1) acc) changed))
       ((SkRelPairDescend subs)
        (skr_norm_ne_pairs lang region rest (skr_pairs_onto subs acc) True))))))

(type SkRelNormR
  (SkRelNormErr (List Int))
  (SkRelNormEmpty)
  (SkRelNormOk SkRegion Bool))

(fn skr_norm_rels
  ((lang SkLang)
   (region SkRegion)
   (rels (List SkRel))
   (acc (List SkRel))
   (changed Bool))
  SkRelNormR
  (measure (struct rels))
  (match rels
    (Nil
      (SkRelNormOk (skr_region_with_rels region (skr_rels_rev acc Nil)) changed))
    ((Cons rel rest)
     (match rel
       ((SkRelEq lefts rights)
        (match
          (skr_norm_eq_pairs lang region (skr_vec_pairs lefts rights) Nil False)
          ((SkRelVecErr msg) (SkRelNormErr msg))
          ((SkRelVecEmpty) (SkRelNormEmpty))
          ((SkRelVecSat) (skr_norm_rels lang region rest acc True))
          ((SkRelVecOk pairs2 region2 ch)
           (match pairs2
             (Nil (skr_norm_rels lang region2 rest acc True))
             ((Cons _ _)
              (skr_norm_rels
                lang
                region2
                rest
                (Cons (skr_rel_eq_of pairs2) acc)
                (if changed True ch)))))))
       ((SkRelNe lefts rights)
        (match
          (skr_norm_ne_pairs lang region (skr_vec_pairs lefts rights) Nil False)
          ((SkRelVecErr msg) (SkRelNormErr msg))
          ((SkRelVecEmpty) (SkRelNormEmpty))
          ((SkRelVecSat) (skr_norm_rels lang region rest acc True))
          ((SkRelVecOk pairs2 region2 ch)
           (match pairs2
             (Nil (SkRelNormEmpty))
             ((Cons (Pair h0 h1) more)
              (match more
                (Nil
                  (match (skr_ne_singleton lang region2 h0 h1)
                    ((SkRelSingErr msg) (SkRelNormErr msg))
                    ((SkRelSingEmpty) (SkRelNormEmpty))
                    ((SkRelSingKeep)
                     (skr_norm_rels
                       lang
                       region2
                       rest
                       (Cons (skr_rel_ne_of pairs2) acc)
                       (if changed True ch)))
                    ((SkRelSingDrop region3)
                     (skr_norm_rels lang region3 rest acc True))))
                ((Cons _ _)
                 (skr_norm_rels
                   lang
                   region2
                   rest
                   (Cons (skr_rel_ne_of pairs2) acc)
                   (if changed True ch)))))))))))))

(fn skr_norm_go ((lang SkLang) (region SkRegion) (fuel Int)) SkRegionEditR
  (measure fuel)
  (if (lt fuel 1) (SkRegionEditErr "relational normalization fuel exhausted")
  (match (skr_norm_rels lang region (sk_region_rels region) Nil False)
    ((SkRelNormErr msg) (SkRegionEditErr msg))
    ((SkRelNormEmpty) (SkRegionEditEmpty))
    ((SkRelNormOk region2 changed)
     (if changed (skr_norm_go lang region2 (- fuel 1)) (SkRegionEditOk region2))))))

;; Normalization to a fixpoint: discharge decided pairs, descend fixed deep
;; pairs, fix eq partners, convert last-pair closed-template `ne` to a
;; forbid. Verdict-neutral: it rewrites the region's DESCRIPTION, never its
;; candidate set.
(fn sk_region_norm_lang ((lang SkLang) (region SkRegion)) SkRegionEditR
  (skr_norm_go lang region (skl_norm_fuel lang region)))

(fn sk_region_norm ((grammar Grammar) (region SkRegion)) SkRegionEditR
  (sk_region_norm_lang (SkLangFlat grammar) region))

;; ---- the validated relation doors + the split and release ops -------------

(fn sk_region_relate_eq_lang ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR
  (if (int_eq h0 h1) (SkRegionEditOk region)
  (match (skl_iso lang h0 h1)
    ((SkIsoErr msg) (SkRegionEditErr msg))
    ((SkIsoOk)
     (skr_norm_go
       lang
       (skr_region_with_rels
         region
         (Cons (SkRelEq (Cons h0 Nil) (Cons h1 Nil)) (sk_region_rels region)))
       (skl_norm_fuel lang region))))))

(fn sk_region_relate_eq ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR
  (sk_region_relate_eq_lang (SkLangFlat grammar) region h0 h1))

(fn sk_region_relate_ne_lang ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR
  (if (int_eq h0 h1) (SkRegionEditEmpty)
  (match (skl_iso lang h0 h1)
    ((SkIsoErr msg) (SkRegionEditErr msg))
    ((SkIsoOk)
     (skr_norm_go
       lang
       (skr_region_with_rels
         region
         (Cons (SkRelNe (Cons h0 Nil) (Cons h1 Nil)) (sk_region_rels region)))
       (skl_norm_fuel lang region))))))

(fn sk_region_relate_ne ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR
  (sk_region_relate_ne_lang (SkLangFlat grammar) region h0 h1))

;; The relational split: one region becomes the disjoint (eq, ne) pair —
;; the drive's answer to a blocked hole-pair obligation, replacing
;; per-value forks. None marks an empty branch.
(type SkRegionSplitR
  (SkRegionSplitErr (List Int))
  (SkRegionSplitOk (Option SkRegion) (Option SkRegion)))

(fn sk_region_split_pair_lang
  ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionSplitR
  (match (sk_region_relate_eq_lang lang region h0 h1)
    ((SkRegionEditErr msg) (SkRegionSplitErr msg))
    ((SkRegionEditEmpty)
     (match (sk_region_relate_ne_lang lang region h0 h1)
       ((SkRegionEditErr msg) (SkRegionSplitErr msg))
       ((SkRegionEditEmpty) (SkRegionSplitOk None None))
       ((SkRegionEditOk ne_region) (SkRegionSplitOk None (Some ne_region)))))
    ((SkRegionEditOk eq_region)
     (match (sk_region_relate_ne_lang lang region h0 h1)
       ((SkRegionEditErr msg) (SkRegionSplitErr msg))
       ((SkRegionEditEmpty) (SkRegionSplitOk (Some eq_region) None))
       ((SkRegionEditOk ne_region)
        (SkRegionSplitOk (Some eq_region) (Some ne_region)))))))

(fn sk_region_split_pair ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionSplitR
  (sk_region_split_pair_lang (SkLangFlat grammar) region h0 h1))

;; The perturbation seam (rip-up): release the given holes' assignments.
;; Relations are knowledge-or-branch-policy — the caller chooses whether
;; events touching a released hole survive. Pairs with sa_forget_holes on
;; the evaluator side.
(fn skr_pairs_drop ((pairs (List (Pair Int Int))) (holes (List Int)))
  (List (Pair Int Int))
  (measure (struct pairs))
  (match pairs
    (Nil Nil)
    ((Cons (Pair h c) rest)
     (if (ids_member h holes) (skr_pairs_drop rest holes)
     (Cons (Pair h c) (skr_pairs_drop rest holes))))))

(fn skr_rels_drop ((rels (List SkRel)) (holes (List Int))) (List SkRel)
  (measure (struct rels))
  (match rels
    (Nil Nil)
    ((Cons rel rest)
     (if (skr_any_id_member (skr_rel_holes_into rel Nil) holes)
       (skr_rels_drop rest holes)
       (Cons rel (skr_rels_drop rest holes))))))

(fn sk_region_release ((region SkRegion) (holes (List Int)) (keep_rels Bool))
  SkRegion
  (match region
    ((SkRegion choices forbids rels)
     (SkRegion
       (skr_pairs_drop choices holes)
       (skr_pairs_drop forbids holes)
       (if keep_rels rels (skr_rels_drop rels holes))))))

;; ---- relational entailment decisions --------------------------------------
;;
;; The relation-aware evaluator asks exactly one question: do this region's
;; relation events already decide subtree(h0) == subtree(h1)?  Only entailed
;; structure answers.  An eq event entails every pointwise pair (it is a
;; conjunction), so entailed equality is reachability over its edges; a ne
;; event entails a pair only when it is a SINGLETON (tuple-difference over
;; two or more pairs is a disjunction), lifted across eq classes.  Anything
;; else is Unknown — the sound pre-relational behavior.  Choices and forbids
;; are the caller's business; a decision on an empty region is vacuous.

(type SkRelDecideR (SkRelDecideEq) (SkRelDecideNe) (SkRelDecideUnknown))

(fn skd_eq_onto
  ((lefts (List Int)) (rights (List Int)) (acc (List (Pair Int Int))))
  (List (Pair Int Int))
  (measure (struct lefts))
  (match lefts
    (Nil acc)
    ((Cons l lrest)
     (match rights
       (Nil acc)
       ((Cons r rrest) (skd_eq_onto lrest rrest (Cons (Pair l r) acc)))))))

(fn skd_eq_edges ((rels (List SkRel)) (acc (List (Pair Int Int))))
  (List (Pair Int Int))
  (measure (struct rels))
  (match rels
    (Nil acc)
    ((Cons rel rest)
     (match rel
       ((SkRelEq lefts rights)
        (skd_eq_edges rest (skd_eq_onto lefts rights acc)))
       ((SkRelNe _ _) (skd_eq_edges rest acc))))))

(fn skd_edges_len ((edges (List (Pair Int Int)))) Int
  (measure (struct edges))
  (match edges
    (Nil 0)
    ((Cons _ rest) (+ 1 (skd_edges_len rest)))))

(fn skd_mem ((hole_id Int) (set (List Int))) Bool
  (measure (struct set))
  (match set
    (Nil False)
    ((Cons head rest) (if (int_eq hole_id head) True (skd_mem hole_id rest)))))

(fn skd_singleton ((values (List Int))) (Option Int)
  (match values
    (Nil None)
    ((Cons head rest)
     (match rest
       (Nil (Some head))
       ((Cons _ _) None)))))

(type SkdPassR (SkdPass (List Int) (List (Pair Int Int)) Bool))

;; One growth pass: move every edge incident to the set into it.  A growing
;; pass consumes at least one edge, so edge-count passes reach the fixpoint.
(fn skd_pass
  ((edges (List (Pair Int Int)))
   (set (List Int))
   (missed (List (Pair Int Int)))
   (grew Bool))
  SkdPassR
  (measure (struct edges))
  (match edges
    (Nil (SkdPass set missed grew))
    ((Cons (Pair a b) rest)
     (if (skd_mem a set)
       (if (skd_mem b set) (skd_pass rest set missed grew)
       (skd_pass rest (Cons b set) missed True))
     (if (skd_mem b set) (skd_pass rest (Cons a set) missed True)
     (skd_pass rest set (Cons (Pair a b) missed) grew))))))

(fn skd_reach ((fuel Int) (edges (List (Pair Int Int))) (set (List Int)))
  (List Int)
  (measure fuel)
  (if (lt fuel 1) set
  (match (skd_pass edges set Nil False)
    ((SkdPass set2 missed grew)
     (if grew (skd_reach (- fuel 1) missed set2) set2)))))

(fn skd_ne_hits ((rels (List SkRel)) (seta (List Int)) (setb (List Int))) Bool
  (measure (struct rels))
  (match rels
    (Nil False)
    ((Cons rel rest)
     (match rel
       ((SkRelEq _ _) (skd_ne_hits rest seta setb))
       ((SkRelNe lefts rights)
        (match (skd_singleton lefts)
          (None (skd_ne_hits rest seta setb))
          ((Some l)
           (match (skd_singleton rights)
             (None (skd_ne_hits rest seta setb))
             ((Some r)
              (if (if (skd_mem l seta) (skd_mem r setb) False) True
              (if (if (skd_mem l setb) (skd_mem r seta) False) True
              (skd_ne_hits rest seta setb))))))))))))

(fn sk_rels_decide ((rels (List SkRel)) (h0 Int) (h1 Int)) SkRelDecideR
  (if (int_eq h0 h1) (SkRelDecideEq)
  (let ((edges (skd_eq_edges rels Nil)))
    (let ((fuel (+ (skd_edges_len edges) 1)))
      (let ((seta (skd_reach fuel edges (Cons h0 Nil))))
        (if (skd_mem h1 seta) (SkRelDecideEq)
        (let ((setb (skd_reach fuel edges (Cons h1 Nil))))
          (if (skd_ne_hits rels seta setb) (SkRelDecideNe) (SkRelDecideUnknown)))))))))

;; ---- direct membership (cube first-match walk + relations on bindings) ----

(type MbAltR (MbAltErr (List Int)) (MbAltNo) (MbAltOk (List (Pair Int Expr))))

(fn skr_member_alt
  ((hole_id Int) (index Int) (alts (List Expr)) (region SkRegion) (value Expr))
  MbAltR
  (measure (struct alts))
  (match alts
    (Nil (MbAltNo))
    ((Cons alt rest)
     (if (skr_allows hole_id index region)
       (match (match_e alt value Nil)
         ((MtRErr msg) (MbAltErr msg))
         ((MtRNo) (skr_member_alt hole_id (+ index 1) rest region value))
         ((MtROk bindings) (MbAltOk bindings)))
       (skr_member_alt hole_id (+ index 1) rest region value)))))

(type MbR (MbRErr (List Int)) (MbRNo) (MbROk (List (Pair Int Expr))))

(fn skr_member_decide
  ((entries (List GEnt)) (region SkRegion) (live (List (Pair Int Expr))))
  MbR
  (measure (struct entries))
  (match entries
    (Nil (MbROk live))
    ((Cons (GEnt hole_id alts) rest)
     (match (rk_find hole_id live)
       (None (skr_member_decide rest region live))
       ((Some value)
        (match (skr_member_alt hole_id 0 alts region value)
          ((MbAltErr msg) (MbRErr msg))
          ((MbAltNo) (MbRNo))
          ((MbAltOk bindings)
           (match (rk_merge bindings live)
             (None (MbRErr "hole is owned by two grammar entries"))
             ((Some live2) (skr_member_decide rest region live2))))))))))

(fn skr_member_pair ((bound (List (Pair Int Expr))) (h0 Int) (h1 Int))
  (Option Bool)
  (match (rk_find h0 bound)
    (None None)
    ((Some v0)
     (match (rk_find h1 bound)
       (None None)
       ((Some v1) (Some (expr_eq v0 v1)))))))

(fn skr_member_eq_vec
  ((bound (List (Pair Int Expr))) (pairs (List (Pair Int Int))))
  Bool
  (measure (struct pairs))
  (match pairs
    (Nil True)
    ((Cons (Pair h0 h1) rest)
     (match (skr_member_pair bound h0 h1)
       (None False)
       ((Some equal) (if equal (skr_member_eq_vec bound rest) False))))))

(fn skr_member_ne_vec
  ((bound (List (Pair Int Expr))) (pairs (List (Pair Int Int))))
  Bool
  (measure (struct pairs))
  (match pairs
    (Nil False)
    ((Cons (Pair h0 h1) rest)
     (match (skr_member_pair bound h0 h1)
       (None (skr_member_ne_vec bound rest))
       ((Some equal) (if equal (skr_member_ne_vec bound rest) True))))))

(fn skr_member_rels ((rels (List SkRel)) (bound (List (Pair Int Expr)))) Bool
  (measure (struct rels))
  (match rels
    (Nil True)
    ((Cons rel rest)
     (match rel
       ((SkRelEq lefts rights)
        (if (skr_member_eq_vec bound (skr_vec_pairs lefts rights))
          (skr_member_rels rest bound)
          False))
       ((SkRelNe lefts rights)
        (if (skr_member_ne_vec bound (skr_vec_pairs lefts rights))
          (skr_member_rels rest bound)
          False))))))

;; ---- relational exact counting ---------------------------------------------
;;
;; count = (ordinary product with endpoint factors masked to 1)
;;         x (per relation component: inclusion-exclusion over ne events,
;;            eq classes counted as intersected diagonals).
;; Refusals are loud: a non-live endpoint, an endpoint inside another
;; endpoint's closure, a component past the ne-event cap, non-isomorphic
;; class domains.

(fn skr_live_go ((entries (List GEnt)) (region SkRegion) (live (List Int)))
  SkIds
  (measure (struct entries))
  (match entries
    (Nil (SkIdsOk live))
    ((Cons (GEnt hole_id alts) rest)
     (if (ids_member hole_id live)
       (match (skr_choice hole_id region)
         (None (skr_live_go rest region live))
         ((Some choice)
          (match (skr_nth_alt alts choice)
            (None (SkIdsErr "region choice is outside its grammar entry"))
            ((Some template)
             (match (holes_e template Nil)
               ((SkIdsErr msg) (SkIdsErr msg))
               ((SkIdsOk children)
                (skr_live_go rest region (ids_union children live))))))))
       (skr_live_go rest region live)))))

(type SkClosR (SkClosErr (List Int)) (SkClosOk (List (Pair Int (List Int)))))

(fn skr_closure_find ((k Int) (memo (List (Pair Int (List Int)))))
  (Option (List Int))
  (measure (struct memo))
  (match memo
    (Nil None)
    ((Cons (Pair i closure) rest)
     (if (int_eq k i) (Some closure) (skr_closure_find k rest)))))

(fn skr_closure_ids
  ((holes (List Int)) (memo (List (Pair Int (List Int)))) (acc (List Int)))
  (List Int)
  (measure (struct holes))
  (match holes
    (Nil acc)
    ((Cons h rest)
     (skr_closure_ids
       rest
       memo
       (ids_insert
         h
         (match (skr_closure_find h memo)
           (None acc)
           ((Some closure) (ids_union closure acc))))))))

(fn skr_closure_alts
  ((alts (List Expr)) (memo (List (Pair Int (List Int)))) (acc (List Int)))
  SkIds
  (measure (struct alts))
  (match alts
    (Nil (SkIdsOk acc))
    ((Cons alt rest)
     (match (holes_e alt Nil)
       ((SkIdsErr msg) (SkIdsErr msg))
       ((SkIdsOk holes)
        (skr_closure_alts rest memo (skr_closure_ids holes memo acc)))))))

(fn skr_closures_go
  ((rev_entries (List GEnt)) (memo (List (Pair Int (List Int)))))
  SkClosR
  (measure (struct rev_entries))
  (match rev_entries
    (Nil (SkClosOk memo))
    ((Cons (GEnt hole_id alts) rest)
     (match (skr_closure_alts alts memo Nil)
       ((SkIdsErr msg) (SkClosErr msg))
       ((SkIdsOk closure)
        (skr_closures_go rest (Cons (Pair hole_id closure) memo)))))))

(fn skr_endpoint_hits ((closure (List Int)) (all (List Int)) (self Int)) Bool
  (measure (struct all))
  (match all
    (Nil False)
    ((Cons b rest)
     (if (int_eq b self) (skr_endpoint_hits closure rest self)
     (if (ids_member b closure) True
     (skr_endpoint_hits closure rest self))))))

(fn skr_endpoints_disjoint
  ((check (List Int)) (all (List Int)) (closures (List (Pair Int (List Int)))))
  (Option (List Int))
  (measure (struct check))
  (match check
    (Nil None)
    ((Cons a rest)
     (if
       (skr_endpoint_hits
         (match (skr_closure_find a closures)
           (None Nil)
           ((Some closure) closure))
         all
         a)
       (Some "relation endpoint lies inside another endpoint's domain")
       (skr_endpoints_disjoint rest all closures)))))

(fn skr_rel_touches ((rel SkRel) (holes (List Int))) Bool
  (skr_any_id_member (skr_rel_holes_into rel Nil) holes))

(type SkCompPass (SkCompPass (List Int) (List SkRel) (List SkRel) Bool))
; holes, members, leftover pool, changed

(fn skr_comp_pass
  ((pending (List SkRel))
   (holes (List Int))
   (members (List SkRel))
   (rest (List SkRel))
   (changed Bool))
  SkCompPass
  (measure (struct pending))
  (match pending
    (Nil (SkCompPass holes members rest changed))
    ((Cons rel prest)
     (if (skr_rel_touches rel holes)
       (skr_comp_pass
         prest
         (ids_union (skr_rel_holes_into rel Nil) holes)
         (Cons rel members)
         rest
         True)
       (skr_comp_pass prest holes members (Cons rel rest) changed)))))

(fn skr_comp_grow
  ((pool (List SkRel)) (holes (List Int)) (members (List SkRel)) (fuel Int))
  SkCompPass
  (measure fuel)
  (if (lt fuel 1) (SkCompPass holes members pool False)
  (match (skr_comp_pass pool holes members Nil False)
    ((SkCompPass holes2 members2 leftover changed)
     (if changed (skr_comp_grow leftover holes2 members2 (- fuel 1))
     (SkCompPass holes2 members2 leftover False))))))

(type SkComps
  (SkCompsErr (List Int))
  (SkCompsOk (List (Pair (List SkRel) (List Int)))))

(fn skr_components ((rels (List SkRel)) (fuel Int)) SkComps
  (measure fuel)
  (if (lt fuel 1) (SkCompsErr "relation component fuel exhausted")
  (match rels
    (Nil (SkCompsOk Nil))
    ((Cons rel rest)
     (match
       (skr_comp_grow
         rest
         (skr_rel_holes_into rel Nil)
         (Cons rel Nil)
         (+ 1 (skr_rels_len rest)))
       ((SkCompPass holes members leftover _)
        (match (skr_components leftover (- fuel 1))
          ((SkCompsErr msg) (SkCompsErr msg))
          ((SkCompsOk comps) (SkCompsOk (Cons (Pair members holes) comps))))))))))

(fn skr_comp_eq_pairs ((rels (List SkRel)) (acc (List (Pair Int Int))))
  (List (Pair Int Int))
  (measure (struct rels))
  (match rels
    (Nil acc)
    ((Cons rel rest)
     (match rel
       ((SkRelEq lefts rights)
        (skr_comp_eq_pairs
          rest
          (skr_pairs_onto (skr_vec_pairs lefts rights) acc)))
       ((SkRelNe _ _) (skr_comp_eq_pairs rest acc))))))

(fn skr_comp_ne_events ((rels (List SkRel)) (acc (List (List (Pair Int Int)))))
  (List (List (Pair Int Int)))
  (measure (struct rels))
  (match rels
    (Nil acc)
    ((Cons rel rest)
     (match rel
       ((SkRelEq _ _) (skr_comp_ne_events rest acc))
       ((SkRelNe lefts rights)
        (skr_comp_ne_events rest (Cons (skr_vec_pairs lefts rights) acc)))))))

(fn skr_events_len ((events (List (List (Pair Int Int))))) Int
  (measure (struct events))
  (match events
    (Nil 0)
    ((Cons _ rest) (+ 1 (skr_events_len rest)))))

;; Union-find as explicit class lists (components are small).
(type SkClsSplit (SkClsSplitNone) (SkClsSplitSome (List Int) (List (List Int))))

(fn skr_cls_split ((classes (List (List Int))) (x Int)) SkClsSplit
  (measure (struct classes))
  (match classes
    (Nil (SkClsSplitNone))
    ((Cons cls rest)
     (if (ids_member x cls) (SkClsSplitSome cls rest)
     (match (skr_cls_split rest x)
       ((SkClsSplitNone) (SkClsSplitNone))
       ((SkClsSplitSome found others) (SkClsSplitSome found (Cons cls others))))))))

(fn skr_cls_seed ((holes (List Int))) (List (List Int))
  (measure (struct holes))
  (match holes
    (Nil Nil)
    ((Cons h rest) (Cons (Cons h Nil) (skr_cls_seed rest)))))

(fn skr_cls_merge ((classes (List (List Int))) (a Int) (b Int))
  (List (List Int))
  (match (skr_cls_split classes a)
    ((SkClsSplitNone) classes)
    ((SkClsSplitSome ca rest1)
     (if (ids_member b ca) classes
     (match (skr_cls_split rest1 b)
       ((SkClsSplitNone) classes)
       ((SkClsSplitSome cb rest2) (Cons (ids_union ca cb) rest2)))))))

(fn skr_cls_merge_pairs
  ((classes (List (List Int))) (pairs (List (Pair Int Int))))
  (List (List Int))
  (measure (struct pairs))
  (match pairs
    (Nil classes)
    ((Cons (Pair a b) rest)
     (skr_cls_merge_pairs (skr_cls_merge classes a b) rest))))

(fn skr_all_allow ((holes (List Int)) (index Int) (region SkRegion)) Bool
  (measure (struct holes))
  (match holes
    (Nil True)
    ((Cons h rest)
     (if (skr_allows h index region) (skr_all_allow rest index region) False))))

;; Aligning one representative template against every other class member's
;; same-index template. Zero means the diagonal is empty at this index
;; (a member's domain ends earlier, or closed templates disagree).
(type SkClsAlignsR
  (SkClsAlignsErr (List Int))
  (SkClsAlignsZero)
  (SkClsAlignsOk (List (List (Pair Int Int)))))

(fn skr_cls_aligns
  ((entries (List GEnt)) (t0 Expr) (others (List Int)) (index Int))
  SkClsAlignsR
  (measure (struct others))
  (match others
    (Nil (SkClsAlignsOk Nil))
    ((Cons other rest)
     (match (skr_entry_alts entries other)
       (None (SkClsAlignsErr "relation references an unknown grammar hole"))
       ((Some alts)
        (match (skr_nth_alt alts index)
          (None (SkClsAlignsZero))
          ((Some t1)
           (match (skr_align_e t0 t1 Nil)
             ((SkAlignErr msg) (SkClsAlignsErr msg))
             ((SkAlignNo)
              (if (if (sk_closed t0) (sk_closed t1) False) (SkClsAlignsZero)
              (SkClsAlignsErr "relation endpoints have non-isomorphic domains")))
             ((SkAlignOk pairs)
              (match (skr_cls_aligns entries t0 rest index)
                ((SkClsAlignsErr msg) (SkClsAlignsErr msg))
                ((SkClsAlignsZero) (SkClsAlignsZero))
                ((SkClsAlignsOk maps) (SkClsAlignsOk (Cons pairs maps)))))))))))))

(fn skr_tuple_of ((h Int) (maps (List (List (Pair Int Int)))))
  (Option (List Int))
  (measure (struct maps))
  (match maps
    (Nil (Some Nil))
    ((Cons map rest)
     (match (memo_find h map)
       (None None)
       ((Some partner)
        (match (skr_tuple_of h rest)
          (None None)
          ((Some partners) (Some (Cons partner partners)))))))))

;; The class-count SCC: one uniform fuel measure, every mutual edge fuel-1.
(fn skr_cls_count
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (members (List Int))
   (fuel Int))
  SkC
  (measure fuel)
  (if (lt fuel 1) (SkCErr "relational class counting fuel exhausted")
  (match members
    (Nil (SkCOk 1))
    ((Cons m0 rest)
     (match rest
       (Nil
         (match (memo_find m0 memo)
           (None
             (SkCErr "count memo is missing a hole (stratification violated)"))
           ((Some count) (SkCOk count))))
       ((Cons _ _)
        (match (skr_entry_alts entries m0)
          (None (SkCErr "relation references an unknown grammar hole"))
          ((Some alts)
           (skr_cls_alts entries region memo m0 rest 0 alts (- fuel 1))))))))))

(fn skr_cls_alts
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (m0 Int)
   (others (List Int))
   (index Int)
   (alts (List Expr))
   (fuel Int))
  SkC
  (measure fuel)
  (if (lt fuel 1) (SkCErr "relational class counting fuel exhausted")
  (match alts
    (Nil (SkCOk 0))
    ((Cons alt rest)
     (if
       (if (skr_allows m0 index region) (skr_all_allow others index region)
       False)
       (match (skr_cls_joint entries region memo alt others index (- fuel 1))
         ((SkCErr msg) (SkCErr msg))
         ((SkCOk here)
          (match
            (skr_cls_alts
              entries
              region
              memo
              m0
              others
              (+ index 1)
              rest
              (- fuel 1))
            ((SkCErr msg) (SkCErr msg))
            ((SkCOk tail) (SkCOk (+ here tail))))))
       (skr_cls_alts entries region memo m0 others (+ index 1) rest (- fuel 1)))))))

(fn skr_cls_joint
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (t0 Expr)
   (others (List Int))
   (index Int)
   (fuel Int))
  SkC
  (measure fuel)
  (if (lt fuel 1) (SkCErr "relational class counting fuel exhausted")
  (match (skr_cls_aligns entries t0 others index)
    ((SkClsAlignsErr msg) (SkCErr msg))
    ((SkClsAlignsZero) (SkCOk 0))
    ((SkClsAlignsOk maps)
     (match (holes_e t0 Nil)
       ((SkIdsErr msg) (SkCErr msg))
       ((SkIdsOk holes)
        (skr_cls_tuples entries region memo holes maps (- fuel 1))))))))

(fn skr_cls_tuples
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (holes (List Int))
   (maps (List (List (Pair Int Int))))
   (fuel Int))
  SkC
  (measure fuel)
  (if (lt fuel 1) (SkCErr "relational class counting fuel exhausted")
  (match holes
    (Nil (SkCOk 1))
    ((Cons h rest)
     (match (skr_tuple_of h maps)
       (None (SkCErr "internal: alignment lost a sub-hole"))
       ((Some partners)
        (match (skr_cls_count entries region memo (Cons h partners) (- fuel 1))
          ((SkCErr msg) (SkCErr msg))
          ((SkCOk here)
           (match (skr_cls_tuples entries region memo rest maps (- fuel 1))
             ((SkCErr msg) (SkCErr msg))
             ((SkCOk tail) (SkCOk (* here tail))))))))))))

(fn skr_term_count
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (classes (List (List Int)))
   (fuel Int))
  SkC
  (measure (struct classes))
  (match classes
    (Nil (SkCOk 1))
    ((Cons cls rest)
     (match (skr_cls_count entries region memo cls fuel)
       ((SkCErr msg) (SkCErr msg))
       ((SkCOk here)
        (match (skr_term_count entries region memo rest fuel)
          ((SkCErr msg) (SkCErr msg))
          ((SkCOk tail) (SkCOk (* here tail)))))))))

;; Inclusion-exclusion over ne events:
;;   count(ne_e AND rest) = count(rest) - count(all-equal_e AND rest).
(fn skr_ie_go
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (holes (List Int))
   (base_pairs (List (Pair Int Int)))
   (ne_events (List (List (Pair Int Int))))
   (fuel Int))
  SkC
  (measure (struct ne_events))
  (match ne_events
    (Nil
      (skr_term_count
        entries
        region
        memo
        (skr_cls_merge_pairs (skr_cls_seed holes) base_pairs)
        fuel))
    ((Cons event rest)
     (match (skr_ie_go entries region memo holes base_pairs rest fuel)
       ((SkCErr msg) (SkCErr msg))
       ((SkCOk without)
        (match
          (skr_ie_go
            entries
            region
            memo
            holes
            (skr_pairs_onto event base_pairs)
            rest
            fuel)
          ((SkCErr msg) (SkCErr msg))
          ((SkCOk with) (SkCOk (- without with)))))))))

(fn skr_comps_count
  ((entries (List GEnt))
   (region SkRegion)
   (memo (List (Pair Int Int)))
   (comps (List (Pair (List SkRel) (List Int)))))
  SkC
  (measure (struct comps))
  (match comps
    (Nil (SkCOk 1))
    ((Cons (Pair rels holes) rest)
     (let ((ne_events (skr_comp_ne_events rels Nil)))
       (if (lt 12 (skr_events_len ne_events))
         (SkCErr "relation component exceeds the exact-counting cap")
         (match
           (skr_ie_go
             entries
             region
             memo
             holes
             (skr_comp_eq_pairs rels Nil)
             ne_events
             1000000)
           ((SkCErr msg) (SkCErr msg))
           ((SkCOk count)
            (if (lt count 0)
              (SkCErr "internal: negative relational component count")
              (match (skr_comps_count entries region memo rest)
                ((SkCErr msg) (SkCErr msg))
                ((SkCOk tail) (SkCOk (* count tail))))))))))))

(fn skr_counts_masked_go
  ((rev_entries (List GEnt))
   (region SkRegion)
   (mask (List Int))
   (memo (List (Pair Int Int))))
  GCt
  (measure (struct rev_entries))
  (match rev_entries
    (Nil (GCtOk memo))
    ((Cons (GEnt hole_id alts) rest)
     (match (skr_sum_region_alts hole_id 0 alts memo region)
       ((SkCErr msg) (GCtErr msg))
       ((SkCOk count)
        (skr_counts_masked_go
          rest
          region
          mask
          (Cons (Pair hole_id (if (ids_member hole_id mask) 1 count)) memo)))))))

(fn skr_rel_count ((root Expr) (entries (List GEnt)) (region SkRegion)) SkC
  (match (skr_counts_go (ents_rev entries Nil) region Nil)
    ((GCtErr msg) (SkCErr msg))
    ((GCtOk memo)
     (match (holes_e root Nil)
       ((SkIdsErr msg) (SkCErr msg))
       ((SkIdsOk roots)
        (match (skr_live_go entries region roots)
          ((SkIdsErr msg) (SkCErr msg))
          ((SkIdsOk live)
           (let ((endpoints (skr_rels_holes (sk_region_rels region) Nil)))
             (if (skr_ids_subset endpoints live)
               (match (skr_closures_go (ents_rev entries Nil) Nil)
                 ((SkClosErr msg) (SkCErr msg))
                 ((SkClosOk closures)
                  (match (skr_endpoints_disjoint endpoints endpoints closures)
                    ((Some msg) (SkCErr msg))
                    (None
                      (match
                        (skr_components
                          (sk_region_rels region)
                          (+ 1 (skr_rels_len (sk_region_rels region))))
                        ((SkCompsErr msg) (SkCErr msg))
                        ((SkCompsOk comps)
                         (match (skr_comps_count entries region memo comps)
                           ((SkCErr msg) (SkCErr msg))
                           ((SkCOk relational)
                            (match
                              (skr_counts_masked_go
                                (ents_rev entries Nil)
                                region
                                endpoints
                                Nil)
                              ((GCtErr msg) (SkCErr msg))
                              ((GCtOk masked)
                               (match (prod_counts roots masked)
                                 ((SkCErr msg) (SkCErr msg))
                                 ((SkCOk base) (SkCOk (* base relational))))))))))))))
               (SkCErr
                 "relation endpoint is not unconditionally live in the region"))))))))))

;; ---- relational first-productive representative ----------------------------

(fn skr_rel_first_pair ((rels (List SkRel))) (Option (Pair Int Int))
  (match rels
    (Nil None)
    ((Cons rel _)
     (match rel
       ((SkRelEq lefts rights)
        (match (skr_vec_pairs lefts rights)
          (Nil None)
          ((Cons pair _) (Some pair))))
       ((SkRelNe lefts rights)
        (match (skr_vec_pairs lefts rights)
          (Nil None)
          ((Cons pair _) (Some pair))))))))

;; ---- the graduated first walk (language-parametric, relational) -----------
;;
;; ONE cardinality-free representative walk serves both grammar languages
;; and both drives (tools/search/superpose's su_first_* family graduated
;; here).  The cube walk is demand-driven from the root: at each open hole
;; take the first allowed PRODUCTIVE alternative and recurse into its
;; instantiation, so only the selected candidate's occurrences are ever
;; touched — exactly what a lazy schema language requires.  A relational
;; region normalizes first, then backtracks over the RELATED holes only:
;; fix the first live pair's open side to each allowed productive
;; alternative in turn and recurse; unrelated holes close through the
;; plain walk once every event has discharged.  Fuel is a loud bound, not
;; a policy.  The lang entry trusts its region: doors and forks build
;; well-formed regions by construction, and the materialized-Grammar door
;; above validates before delegating.

(fn skf_alt
  ((lang SkLang)
   (prod SkLangProd)
   (region SkRegion)
   (hole_id Int)
   (index Int)
   (alts (List Expr)))
  SkrFirstAltR
  (measure (struct alts))
  (match alts
    (Nil (SkrFirstAltErr "region has no permitted alternative"))
    ((Cons alt rest)
     (let
       ((selected
          (match (skr_choice hole_id region)
            ((Some chosen) (int_eq chosen index))
            (None True))))
       (if (if selected (skr_forbidden hole_id index region) False)
         (skf_alt lang prod region hole_id (+ index 1) rest)
       (if (if selected (skl_alt_productive lang prod hole_id index) False)
         (SkrFirstAltOk alt)
         (skf_alt lang prod region hole_id (+ index 1) rest)))))))

(fn skf_expr
  ((fuel Int) (lang SkLang) (prod SkLangProd) (region SkRegion) (e Expr))
  SkE
  (measure fuel)
  (if (lt fuel 1) (SkEErr "region first fuel exhausted")
  (match (hole_view e)
    ((HVBad msg) (SkEErr msg))
    ((HVHole hole_id)
     (match (skl_alts lang hole_id)
       ((SkSchemaAltsErr msg) (SkEErr msg))
       ((SkSchemaAltsOk alts)
        (match (skf_alt lang prod region hole_id 0 alts)
          ((SkrFirstAltErr msg) (SkEErr msg))
          ((SkrFirstAltOk alt) (skf_expr (- fuel 1) lang prod region alt))))))
    ((HVNot)
     (match e
       ((Ctor q args)
        (match (skf_list (- fuel 1) lang prod region args)
          ((SkELErr msg) (SkEErr msg))
          ((SkELOk args2) (SkEOk (Ctor q args2)))))
       ((Call q args)
        (match (skf_list (- fuel 1) lang prod region args)
          ((SkELErr msg) (SkEErr msg))
          ((SkELOk args2) (SkEOk (Call q args2)))))
       ((Match scrut arms)
        (match (skf_expr (- fuel 1) lang prod region scrut)
          ((SkEErr msg) (SkEErr msg))
          ((SkEOk scrut2)
           (match (skf_arms (- fuel 1) lang prod region arms)
             ((SkEAErr msg) (SkEErr msg))
             ((SkEAOk arms2) (SkEOk (Match scrut2 arms2)))))))
       ((Let binds body)
        (match (skf_list (- fuel 1) lang prod region binds)
          ((SkELErr msg) (SkEErr msg))
          ((SkELOk binds2)
           (match (skf_expr (- fuel 1) lang prod region body)
             ((SkEErr msg) (SkEErr msg))
             ((SkEOk body2) (SkEOk (Let binds2 body2)))))))
       ((If cond yes no)
        (match (skf_expr (- fuel 1) lang prod region cond)
          ((SkEErr msg) (SkEErr msg))
          ((SkEOk cond2)
           (match (skf_expr (- fuel 1) lang prod region yes)
             ((SkEErr msg) (SkEErr msg))
             ((SkEOk yes2)
              (match (skf_expr (- fuel 1) lang prod region no)
                ((SkEErr msg) (SkEErr msg))
                ((SkEOk no2) (SkEOk (If cond2 yes2 no2)))))))))
       (_ (SkEOk e)))))))

(fn skf_list
  ((fuel Int)
   (lang SkLang)
   (prod SkLangProd)
   (region SkRegion)
   (es (List Expr)))
  SkEL
  (measure fuel)
  (if (lt fuel 1) (SkELErr "region first list fuel exhausted")
  (match es
    (Nil (SkELOk Nil))
    ((Cons head rest)
     (match (skf_expr (- fuel 1) lang prod region head)
       ((SkEErr msg) (SkELErr msg))
       ((SkEOk head2)
        (match (skf_list (- fuel 1) lang prod region rest)
          ((SkELErr msg) (SkELErr msg))
          ((SkELOk rest2) (SkELOk (Cons head2 rest2))))))))))

(fn skf_arms
  ((fuel Int)
   (lang SkLang)
   (prod SkLangProd)
   (region SkRegion)
   (arms (List Arm)))
  SkEA
  (measure fuel)
  (if (lt fuel 1) (SkEAErr "region first arms fuel exhausted")
  (match arms
    (Nil (SkEAOk Nil))
    ((Cons (Arm pattern body) rest)
     (match (skf_expr (- fuel 1) lang prod region body)
       ((SkEErr msg) (SkEAErr msg))
       ((SkEOk body2)
        (match (skf_arms (- fuel 1) lang prod region rest)
          ((SkEAErr msg) (SkEAErr msg))
          ((SkEAOk rest2) (SkEAOk (Cons (Arm pattern body2) rest2))))))))))

(fn skf_plain ((lang SkLang) (prod SkLangProd) (region SkRegion) (root Expr))
  SkE
  (match (skf_expr 1000000 lang prod region root)
    ((SkEErr msg) (SkEErr msg))
    ((SkEOk result)
     (if (sk_closed result) (SkEOk result)
     (SkEErr "region first left holes (grammar incomplete for the root)")))))

(fn skf_rel_go
  ((root Expr) (lang SkLang) (prod SkLangProd) (region SkRegion) (fuel Int))
  SkE
  (measure fuel)
  (if (lt fuel 1) (SkEErr "relational first-productive fuel exhausted")
  (match (skr_norm_go lang region (skl_norm_fuel lang region))
    ((SkRegionEditErr msg) (SkEErr msg))
    ((SkRegionEditEmpty) (SkEErr "relational region is empty"))
    ((SkRegionEditOk region2)
     (match (sk_region_rels region2)
       (Nil (skf_plain lang prod region2 root))
       ((Cons _ _)
        (match (skr_rel_first_pair (sk_region_rels region2))
          (None (SkEErr "internal: relational region without a live pair"))
          ((Some (Pair h0 h1))
           (let
             ((target
                (match (skr_choice h0 region2)
                  (None h0)
                  ((Some _) h1))))
             (match (skl_alts lang target)
               ((SkSchemaAltsErr msg) (SkEErr msg))
               ((SkSchemaAltsOk alts)
                (skf_rel_try root lang prod region2 target 0 alts (- fuel 1)))))))))))))

(fn skf_rel_try
  ((root Expr)
   (lang SkLang)
   (prod SkLangProd)
   (region SkRegion)
   (hole_id Int)
   (index Int)
   (alts (List Expr))
   (fuel Int))
  SkE
  (measure fuel)
  (if (lt fuel 1) (SkEErr "relational first-productive fuel exhausted")
  (match alts
    (Nil (SkEErr "relational region has no satisfiable representative"))
    ((Cons _ rest)
     (if
       (if (skr_forbidden hole_id index region) True
       (if (skl_alt_productive lang prod hole_id index) False
       True))
       (skf_rel_try root lang prod region hole_id (+ index 1) rest (- fuel 1))
       (match (skr_choose_at lang region hole_id index)
         ((SkRegionEditErr msg) (SkEErr msg))
         ((SkRegionEditEmpty)
          (skf_rel_try
            root
            lang
            prod
            region
            hole_id
            (+ index 1)
            rest
            (- fuel 1)))
         ((SkRegionEditOk region2)
          (match (skf_rel_go root lang prod region2 (- fuel 1))
            ((SkEErr _)
             (skf_rel_try
               root
               lang
               prod
               region
               hole_id
               (+ index 1)
               rest
               (- fuel 1)))
            ((SkEOk result) (SkEOk result))))))))))

(fn sk_region_first_lang ((root Expr) (lang SkLang) (region SkRegion)) SkE
  (let ((prod (skl_productivity lang)))
    (match (sk_region_rels region)
      (Nil (skf_plain lang prod region root))
      ((Cons _ _) (skf_rel_go root lang prod region 100000)))))
;; index -> the closed candidate it addresses (range-checked, loud)
(fn sk_unrank ((root Expr) (g Grammar) (ix Int)) SkE
  (match (g_counts g)
    ((GCtErr m) (SkEErr m))
    ((GCtOk memo)
     (match (holes_e root Nil)
       ((SkIdsErr m) (SkEErr m))
       ((SkIdsOk roots)
        (match (prod_counts roots memo)
          ((SkCErr m) (SkEErr m))
          ((SkCOk total)
           (if (lt ix 0) (SkEErr "candidate index below zero")
           (if (le total ix) (SkEErr "candidate index out of range")
           (match (digits_go (ids_rev roots Nil) memo ix Nil)
             ((DgRErr m) (SkEErr m))
             ((DgROk live0)
              (match g
                ((Grammar es)
                 (match (decide_go es memo live0 Nil)
                   ((DcRErr m) (SkEErr m))
                   ((DcROk choices)
                    (match (close_go (ents_rev es Nil) choices Nil)
                      ((ClRErr m) (SkEErr m))
                      ((ClROk closed)
                       (match (fill_e root closed)
                         ((SkEErr m) (SkEErr m))
                         ((SkEOk r)
                          (if (sk_closed r) (SkEOk r)
                          (SkEErr
                            "unrank left holes (grammar incomplete for the root)")))))))))))))))))))))
