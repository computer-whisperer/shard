;;; meta/sketch — the TERM-WITH-HOLES vocabulary: partial kernel terms
;;; and the exact addressing of their candidate spaces (docs/SEARCH.md
;;; S1). THE LINE: a definition lives here iff it manipulates PARTIAL
;;; kernel Exprs (hole-headed subterms) or addresses the candidate space
;;; a grammar induces over them — counting, rank-addressed decoding,
;;; filling. Nothing here evaluates, checks, proves, or renders.
;;;
;;; THE HOLE ENCODING (SEARCH.md D1): a hole is a reserved-head call
;;; inside the ordinary kernel Expr —
;;;
;;;   (Call (:: meta sketch hole) ((IntLit k)))
;;;
;;; — so every existing Expr walker, recognizer, and renderer works on
;;; partial terms unchanged. The reserved head is exactly the qname of
;;; the `hole` builder below: the name is reserved BY the definition.
;;; The kernel never checks a sketch; holes are filled before any check.
;;; A hole-headed call with any other argument shape is a MALFORMED
;;; sketch: every walker here refuses it loudly (HVBad / *Err), never
;;; skips it.
;;;
;;; SHARING: one hole id at two positions is ONE decision (the
;;; correlation primitive) — collection dedups, counting multiplies a
;;; shared hole once, filling substitutes every occurrence.
;;;
;;; THE FILL CONTRACT: fill is verbatim substitution — no binder
;;; shifting. An assignment's Expr is spelled in the binder context of
;;; the hole's position; sharing an id across positions requires those
;;; positions to agree on context. (The rev skeleton's per-arm hole
;;; scopes are the model.)
;;;
;;; GRAMMARS: per-hole alternative lists (GEnt), each alternative an
;;; Expr that may itself contain holes. THE STRATIFICATION LAW: entry
;;; ids are strictly ascending, and an alternative's holes are strictly
;;; GREATER than its entry's id — so counting is one reverse fold,
;;; deciding is one forward fold, closing is one reverse fold, all
;;; structural (no fuel, no cycle detection: a violation is a loud
;;; refusal at the pass that notices, and g_wf checks the law whole).
;;; One hole is owned by at most ONE entry's alternative set; reuse
;;; across alternatives of the SAME entry is fine (alternatives are
;;; exclusive), cross-entry sharing is refused (it would correlate
;;; distinct decisions and break the product counts).
;;;
;;; THE ADDRESSING LAW (rank <-> candidate): a sketch's space is the
;;; product over its distinct holes, ASCENDING id order, of per-hole
;;; counts; the LAST hole is the least-significant digit. Within a
;;; hole, alternatives occupy consecutive index intervals in list
;;; order (leaves-first grammars put leaves at the low indices); an
;;; alternative's interval decomposes over its distinct sub-holes the
;;; same way (ascending, last least-significant). Counts are exact
;;; bignum Int at any rung.
(import "../../kernel/stdlib.shard")
(import "../../kernel/term.shard")
(import "../doc")
(use (:: kernel term Expr))
(use (:: kernel term Call))
(use (:: kernel term Ctor))
(use (:: kernel term Match))
(use (:: kernel term Let))
(use (:: kernel term If))
(use (:: kernel term IntLit))
(use (:: kernel term Arm))
(use (:: kernel term Pat))
(use (:: kernel term QName))
(use (:: kernel term expr_eq))
(use (:: kernel term pat_eq))
(use (:: kernel term qname_eq))
(use (:: meta doc sym_list_eq))

;; ---- the reserved head (D1) --------------------------------------------------

(sig fn hole_qn () QName)

;; build hole k. This fn's own qname IS the reserved head.
(sig fn hole ((k Int)) Expr)

;; the loud pointwise classifier: a well-formed hole, a non-hole, or a
;; MALFORMED hole-headed call (refused, never skipped)
(type HoleView (HVHole Int) (HVBad (List Int)) (HVNot))

(sig fn hole_view ((e Expr)) HoleView)

(sig fn hole_id ((e Expr)) (Option Int))

;; ---- sorted id sets ----------------------------------------------------------

(sig fn ids_rev ((xs (List Int)) (acc (List Int))) (List Int))

;; ---- hole collection: distinct ids, ASCENDING (sharing = one decision) -------

(type SkIds (SkIdsErr (List Int)) (SkIdsOk (List Int)))

(sig fn holes_e ((e Expr) (acc (List Int))) SkIds)

(sig fn sk_holes ((e Expr)) SkIds)

;; ---- closedness: NO hole-headed call anywhere (malformed included) -----------

(sig fn sk_closed ((e Expr)) Bool)

;; ---- fill: verbatim hole substitution (single pass, no recursion into
;; the substituted value — bottom-up closing is the caller's job) --------------

(type SkE (SkEErr (List Int)) (SkEOk Expr))

(type SkEL (SkELErr (List Int)) (SkELOk (List Expr)))

(type SkEA (SkEAErr (List Int)) (SkEAOk (List Arm)))

(sig fn asg_find ((k Int) (asg (List (Pair Int Expr)))) (Option Expr))

(sig fn sk_fill ((e Expr) (asg (List (Pair Int Expr)))) SkE)

;; ---- grammars ----------------------------------------------------------------

;; one hole's alternatives; each alternative may contain holes with
;; STRICTLY GREATER ids (the stratification law)
(type GEnt (GEnt Int (List Expr)))

(type Grammar (Grammar (List GEnt)))

;; ---- regular schema grammars -----------------------------------------------
;;
;; A materialized Grammar gives every possible occurrence a hole id up front.
;; That is the right representation for exact ranking, but recursively typed
;; languages repeat the same production state at exponentially many possible
;; positions.  Schema grammars separate the reusable production policy from
;; the independent occurrence that eventually chooses one production.
;;
;; `local` names a hole in the alternative template.  `edge` is unique within
;; the parent schema and gives that child position a stable structural address.
;; `child_schema` names the reusable policy at that child.  Equal child schemas
;; do *not* share choices: occurrence addresses include the whole parent path.
(type SkSchemaRef (SkSchemaRef Int Int Int))

; local template hole, parent-local edge, child schema

(type SkSchemaAlt (SkSchemaAlt Expr (List SkSchemaRef)))

(type SkSchemaEnt (SkSchemaEnt Int (List SkSchemaAlt)))

(type SkSchemaGrammar (SkSchemaGrammar Int (List SkSchemaEnt)))

; root schema, entries

(sig fn sks_ref_edge_find ((edge Int) (alts (List SkSchemaAlt)))
  (Option SkSchemaRef))

(type SkSchemaRefsWfR
  (SkSchemaRefsWfErr (List Int))
  (SkSchemaRefsWfOk (List Int)))

; updated entry-global edge set

(type SkSchemaAltsWfR
  (SkSchemaAltsWfErr (List Int))
  (SkSchemaAltsWfOk (List Int)))

(type SkSchemaWf (SkSchemaWfErr (List Int)) (SkSchemaWfOk))

(sig fn sk_schema_wf ((grammar SkSchemaGrammar)) SkSchemaWf)

(type SkOccSplitR (SkOccSplitErr (List Int)) (SkOccSplitOk Int Int))

; parent, edge

(sig fn sk_occ_split ((occurrence Int)) SkOccSplitR)

(type SkSchemaIdR (SkSchemaIdErr (List Int)) (SkSchemaIdOk Int))

(type SkSchemaAltsR (SkSchemaAltsErr (List Int)) (SkSchemaAltsOk (List Expr)))

(sig fn sks_instantiate_alts ((parent Int) (alts (List SkSchemaAlt)))
  SkSchemaAltsR)

(sig fn sk_schema_alts_at ((grammar SkSchemaGrammar) (occurrence Int))
  SkSchemaAltsR)

;; Saturating productivity over the schema graph.  Unlike occurrence-grammar
;; productivity, schema ids need not be topologically ordered.  Starting from
;; all-false alternative facts, N rounds suffice for every finite productive
;; derivation in an N-schema graph; ungrounded cycles remain unproductive.
(type SkSchemaProductivity (SkSchemaProductivity (List (Pair Int (List Bool)))))

(sig fn sk_schema_productivity ((grammar SkSchemaGrammar)) SkSchemaProductivity)

(sig fn sks_nth_bool ((bits (List Bool)) (index Int)) Bool)

(sig fn sk_schema_alt_productive_at
  ((grammar SkSchemaGrammar)
   (productivity SkSchemaProductivity)
   (occurrence Int)
   (index Int))
  Bool)

(sig fn ents_rev ((es (List GEnt)) (acc (List GEnt))) (List GEnt))

;; Persistent integer sets for grammar-scale validation.  Occurrence grammars
;; can contain hundreds of thousands of entries; checking every reference by
;; scanning the complete id list makes the otherwise-linear stratification
;; gate quadratic.  Keys are stored as id+1 in a binary digital trie.
(type SkIdSet (SkIdSetLeaf) (SkIdSetNode Bool SkIdSet SkIdSet))

(type SkIdSetBuildR (SkIdSetBuildErr (List Int)) (SkIdSetBuildOk SkIdSet))

;; ---- well-formedness: the stratification law, checked whole ------------------

(type GW (GWErr (List Int)) (GWOk))

(type GWSet (GWSetErr (List Int)) (GWSetOk SkIdSet))

(sig fn g_wf ((g Grammar)) GW)

;; Saturating (zero/nonzero) grammar analysis.  Synthesis schedulers need to
;; avoid barren depth-boundary productions without paying exact bignum counts.
;; Keep one productivity bit per original alternative so choice indices remain
;; stable for regions, ranks, and checked theorem facts.
(type SkProductivity
  (SkProductivityLeaf)
  (SkProductivityNode (Option (List Bool)) SkProductivity SkProductivity))

(sig fn sk_productivity ((grammar Grammar)) SkProductivity)

(sig fn sk_alt_productive
  ((productivity SkProductivity) (hole_id Int) (index Int))
  Bool)

;; ---- exact counting: one reverse fold over the entries -----------------------

(type SkC (SkCErr (List Int)) (SkCOk Int))

(type GCt (GCtErr (List Int)) (GCtOk (List (Pair Int Int))))

;; the sketch's whole space: product over its distinct holes
(sig fn sk_count ((root Expr) (g Grammar)) SkC)

;; ---- unrank: index -> closed candidate ----------------------------------------

;; digit split per the addressing law: holes given REVERSED (last =
;; least-significant digit), each digit = ix mod count
(type DgR (DgRErr (List Int)) (DgROk (List (Pair Int Int))))

;; alternative selection: consecutive intervals in list order
(type PkR (PkRErr (List Int)) (PkROk Expr Int))

;; the forward decide pass: each live entry picks its alternative and
;; hands index digits down to the alternative's own holes
(type DcR (DcRErr (List Int)) (DcROk (List (Pair Int Expr))))

;; the reverse close pass: substitute bottom-up, so every chosen
;; alternative closes against already-closed deeper holes
(type ClR (ClRErr (List Int)) (ClROk (List (Pair Int Expr))))

;; ---- rank: closed candidate -> index (unrank's inverse) -----------------------
;;
;; Matching walks a TEMPLATE (an Expr with holes) against a closed
;; candidate: a hole binds the candidate subtree at its position (a
;; repeated id must bind expr_eq-equal subtrees — sharing), everything
;; else must agree exactly. Across a hole's alternatives the FIRST
;; structural match wins, and there is NO backtracking into a later
;; alternative when the bound subtree fails deeper — so THE ORDERING
;; DISCIPLINE for builders: an earlier alternative must never
;; structurally match a candidate that belongs to a later one. Plain
;; distinct-head alternatives satisfy it trivially; point-exclusion
;; splits (Cons(x, B') before Cons(A', B)) must list the
;; CONCRETE-headed alternative first. rank . unrank = id is what
;; consumers gate (the census round-trip).

(type MtR (MtRErr (List Int)) (MtRNo) (MtROk (List (Pair Int Expr))))

(sig fn match_e ((p Expr) (c Expr) (bs (List (Pair Int Expr)))) MtR)

;; first alternative matching v: its index offset (sum of the sizes of
;; the alternatives before it), its template, and its bindings
(type FaR (FaRErr (List Int)) (FaROk Int Expr (List (Pair Int Expr))))

;; forward pass: live (hole -> bound subtree); choices (hole -> its
;; matched alternative's offset and template)
(type RkR (RkRErr (List Int)) (RkROk (List (Pair Int (Pair Int Expr)))))

;; closed candidate -> its index under the addressing law (loud when the
;; candidate is not a member of the grammar's space)
(sig fn sk_rank ((root Expr) (g Grammar) (cand Expr)) SkC)

;; ---- exact restricted regions ---------------------------------------------
;;
;; A narrowing job normally fixes some grammar choices. Relational pressure
;; also needs the dual operation: retain the original hole identity while
;; excluding one or more choices. `SkRegion` records both over the unchanged
;; Grammar DAG. This is deliberately below any rewrite/search policy.
;;
;; Exact counting is the ordinary reverse grammar fold with each entry's
;; alternatives restricted before summation. No grammar nodes are cloned, so
;; evaluators and their memos continue to use the original stable hole ids.
;;
;; `sk_region_subtract_cube` subtracts a conjunction of required choices as a
;; disjoint sum of products. For cube [h=a, k=b], the complement is
;;
;;   h!=a  |  (h=a, k!=b)
;;
;; and the optional hit is the final h=a,k=b region.
;;
;; RELATION-AWARE REGIONS (SEARCH.md arc-opener design, ratified 2026-07-25).
;; A region additionally carries lazy equality/difference restrictions
;; between holes of the UNCHANGED grammar — no cloned hole identities, and
;; relations (like forbids) never enter any evaluator memo key. An event
;; holds PARALLEL HOLE VECTORS, pointwise paired:
;;
;;   (SkRelEq ls rs) — every pointwise pair fills to EQUAL subtrees;
;;   (SkRelNe ls rs) — at least ONE pointwise pair differs (tuple
;;                     difference).
;;
;; Vector `ne` is what keeps propagation CLOSED: when a deep pair fixes the
;; same alternative on both sides, the pair is replaced by the sub-hole
;; vector of the aligned templates — the disjunction stays one event; `eq`
;; descends pointwise (the conjunction becomes more pairs). Relations relate
;; holes with BY-INDEX ISOMORPHIC domains (same alternative count, templates
;; equal up to a bijective renaming of sub-holes, recursively), so subtree
;; equality is exactly agreement of the remaining choice chain — under the
;; same alternative non-overlap discipline rank already requires.
;; `sk_region_relate_eq` / `sk_region_relate_ne` are the VALIDATED DOORS
;; (the trs_profile precedent): they check isomorphism and normalize; the
;; transparent constructor is not the API.
;;
;; Exact counting or loud refusal, never approximation: events partition
;; into connected components; unrelated holes keep the ordinary product
;; fold (endpoint factors masked to 1); per component, `eq` contracts by
;; union-find (a class counts as its members' intersected diagonal, walked
;; recursively through aligned templates) and `ne` counts by INCLUSION-
;; EXCLUSION over ne events — exact for arbitrary relation graphs, 2^events
;; per component, capped loudly. Count-time refusals: an endpoint that is
;; not unconditionally live under the region's fixed chains, an endpoint
;; inside another endpoint's domain closure, a component past the cap.
;; Relational regions are NOT rank-addressable (rank/unrank refuse);
;; membership is decided directly on bound subtrees.

(type SkRel (SkRelEq (List Int) (List Int)) (SkRelNe (List Int) (List Int)))

; parallel hole vectors, pointwise paired; same nonzero length

(type SkRegion
  (SkRegion (List (Pair Int Int)) (List (Pair Int Int)) (List SkRel)))

; fixed hole -> alternative index, forbidden hole -> alternative index,
; relation events

(sig fn sk_empty_region () SkRegion)

(sig fn sk_region_choices ((region SkRegion)) (List (Pair Int Int)))

(sig fn sk_region_rels ((region SkRegion)) (List SkRel))

(sig fn skr_choice ((hole_id Int) (region SkRegion)) (Option Int))

(sig fn skr_forbidden ((hole_id Int) (choice Int) (region SkRegion)) Bool)

(type SkRegionWfR (SkRegionWfErr (List Int)) (SkRegionWfOk))

(sig fn sk_region_wf ((grammar Grammar) (region SkRegion)) SkRegionWfR)

(sig fn sk_region_count ((root Expr) (grammar Grammar) (region SkRegion)) SkC)

;; Restricted addressing keeps the ordinary candidate ordering after removing
;; forbidden alternatives and alternatives other than a fixed choice.  This is
;; not merely a convenience for search drivers: it makes a region an exact,
;; independently enumerable candidate space without manufacturing a second
;; Grammar (and therefore without changing any hole identity).

(sig fn sk_region_rank
  ((root Expr) (grammar Grammar) (region SkRegion) (candidate Expr))
  SkC)

;; Membership is decided directly — the cube part by the same first-match
;; forward walk rank uses (without counts), relations by expr_eq over the
;; bound subtrees. Relational regions are members-decidable even though
;; they are not rank-addressable.
(sig fn sk_region_member
  ((root Expr) (grammar Grammar) (region SkRegion) (candidate Expr))
  Bool)

(sig fn sk_region_unrank
  ((root Expr) (grammar Grammar) (region SkRegion) (index Int))
  SkE)

;; Cardinality-free representative selection.  Synthesis only needs one
;; member of a surviving restricted region; computing its rank first couples
;; that operation to every (potentially enormous) sibling subspace.  The
;; graduated walk lives below with the language interface
;; (`sk_region_first_lang`); this materialized-Grammar door validates and
;; delegates.
(type SkrFirstAltR (SkrFirstAltErr (List Int)) (SkrFirstAltOk Expr))

(sig fn sk_region_first ((root Expr) (grammar Grammar) (region SkRegion)) SkE)

(type SkRegionEditR
  (SkRegionEditErr (List Int))
  (SkRegionEditEmpty)
  (SkRegionEditOk SkRegion))

(sig fn sk_region_choose_known
  ((region SkRegion) (hole_id Int) (choice Int) (alts (List Expr)))
  SkRegionEditR)

(sig fn sk_region_choose
  ((grammar Grammar) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR)

(sig fn sk_region_forbid
  ((grammar Grammar) (region SkRegion) (hole_id Int) (choice Int))
  SkRegionEditR)

(type SkRegionSubtractR
  (SkRegionSubtractErr (List Int))
  (SkRegionSubtractOk (Option SkRegion) (List SkRegion)))

; exact cube hit, disjoint complement regions

(sig fn sk_region_subtract_cube
  ((grammar Grammar) (region SkRegion) (cube (List (Pair Int Int))))
  SkRegionSubtractR)

;; ---- the language interface: one relational algebra over both grammars ----
;;
;; The relational region machinery (the doors, normalization, and the
;; first walk) is language-parametric: a materialized Grammar and a
;; regular schema grammar answer the same three questions — a hole's
;; instantiated alternatives, endpoint isomorphism, and per-alternative
;; productivity.  Schema isomorphism holds BY CONSTRUCTION: two
;; occurrences governed by the same schema id instantiate index-aligned
;; identical domains at every depth, so the door's check is id equality.
;; Exact counting and rank/unrank remain materialized-Grammar-only —
;; first-mode never counts.
(type SkLang (SkLangFlat Grammar) (SkLangSchema SkSchemaGrammar))

(sig fn skl_alts ((lang SkLang) (hole_id Int)) SkSchemaAltsR)

(sig fn skl_iso ((lang SkLang) (h0 Int) (h1 Int)) SkIsoR)

(type SkLangProd
  (SkLangProdFlat SkProductivity)
  (SkLangProdSchema SkSchemaProductivity))

;; ---- relation machinery: alignment, isomorphism, pair evaluation ----------

;; Template alignment: walk two templates in parallel, requiring structural
;; agreement everywhere except at holes, which must correspond through ONE
;; BIJECTIVE renaming (sharing patterns must match on both sides). Ok
;; carries the positional hole pairs; No means the shapes disagree.
(type SkAlignR
  (SkAlignErr (List Int))
  (SkAlignNo)
  (SkAlignOk (List (Pair Int Int))))

;; By-index domain isomorphism — the validated doors' admission check.
(type SkIsoR (SkIsoErr (List Int)) (SkIsoOk))

;; ---- relation propagation: three-valued pair evaluation + normalization ---

;; One pointwise pair, three-valued (with descent as the fourth outcome):
;; both endpoints fixed to the same index descend to the aligned templates'
;; sub-hole pairs; different indices differ (the non-overlap discipline);
;; a one-sided fix or an undecided overlap stays blocked — normalization
;; owns the propagation.
(type SkRelPairR
  (SkRelPairErr (List Int))
  (SkRelPairEqual)
  (SkRelPairDiffer)
  (SkRelPairBlocked)
  (SkRelPairDescend (List (Pair Int Int))))

;; The last live pair of a `ne` event whose fixed side chose a CLOSED
;; template converts to an ordinary forbid on the open side.
(type SkRelSingR
  (SkRelSingErr (List Int))
  (SkRelSingEmpty)
  (SkRelSingKeep)
  (SkRelSingDrop SkRegion))

(type SkRelVecR
  (SkRelVecErr (List Int))
  (SkRelVecEmpty)
  (SkRelVecSat)
  (SkRelVecOk (List (Pair Int Int)) SkRegion Bool))

(type SkRelNormR
  (SkRelNormErr (List Int))
  (SkRelNormEmpty)
  (SkRelNormOk SkRegion Bool))

;; Normalization to a fixpoint: discharge decided pairs, descend fixed deep
;; pairs, fix eq partners, convert last-pair closed-template `ne` to a
;; forbid. Verdict-neutral: it rewrites the region's DESCRIPTION, never its
;; candidate set.
(sig fn sk_region_norm_lang ((lang SkLang) (region SkRegion)) SkRegionEditR)

(sig fn sk_region_norm ((grammar Grammar) (region SkRegion)) SkRegionEditR)

;; ---- the validated relation doors + the split and release ops -------------

(sig fn sk_region_relate_eq_lang
  ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR)

(sig fn sk_region_relate_eq
  ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR)

(sig fn sk_region_relate_ne_lang
  ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR)

(sig fn sk_region_relate_ne
  ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionEditR)

;; The relational split: one region becomes the disjoint (eq, ne) pair —
;; the drive's answer to a blocked hole-pair obligation, replacing
;; per-value forks. None marks an empty branch.
(type SkRegionSplitR
  (SkRegionSplitErr (List Int))
  (SkRegionSplitOk (Option SkRegion) (Option SkRegion)))

(sig fn sk_region_split_pair_lang
  ((lang SkLang) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionSplitR)

(sig fn sk_region_split_pair
  ((grammar Grammar) (region SkRegion) (h0 Int) (h1 Int))
  SkRegionSplitR)

(sig fn sk_region_release
  ((region SkRegion) (holes (List Int)) (keep_rels Bool))
  SkRegion)

;; ---- relational entailment decisions --------------------------------------
;;
;; The relation-aware evaluator asks exactly one question: do this region's
;; relation events already decide subtree(h0) == subtree(h1)?  Only entailed
;; structure answers.  An eq event entails every pointwise pair (it is a
;; conjunction), so entailed equality is reachability over its edges; a ne
;; event entails a pair only when it is a SINGLETON (tuple-difference over
;; two or more pairs is a disjunction), lifted across eq classes.  Anything
;; else is Unknown — the sound pre-relational behavior.  Choices and forbids
;; are the caller's business; a decision on an empty region is vacuous.

(type SkRelDecideR (SkRelDecideEq) (SkRelDecideNe) (SkRelDecideUnknown))

(type SkdPassR (SkdPass (List Int) (List (Pair Int Int)) Bool))

(sig fn sk_rels_decide ((rels (List SkRel)) (h0 Int) (h1 Int)) SkRelDecideR)

;; ---- direct membership (cube first-match walk + relations on bindings) ----

(type MbAltR (MbAltErr (List Int)) (MbAltNo) (MbAltOk (List (Pair Int Expr))))

(type MbR (MbRErr (List Int)) (MbRNo) (MbROk (List (Pair Int Expr))))

;; ---- relational exact counting ---------------------------------------------
;;
;; count = (ordinary product with endpoint factors masked to 1)
;;         x (per relation component: inclusion-exclusion over ne events,
;;            eq classes counted as intersected diagonals).
;; Refusals are loud: a non-live endpoint, an endpoint inside another
;; endpoint's closure, a component past the ne-event cap, non-isomorphic
;; class domains.

(type SkClosR (SkClosErr (List Int)) (SkClosOk (List (Pair Int (List Int)))))

(type SkCompPass (SkCompPass (List Int) (List SkRel) (List SkRel) Bool))

; holes, members, leftover pool, changed

(type SkComps
  (SkCompsErr (List Int))
  (SkCompsOk (List (Pair (List SkRel) (List Int)))))

;; Union-find as explicit class lists (components are small).
(type SkClsSplit (SkClsSplitNone) (SkClsSplitSome (List Int) (List (List Int))))

;; Aligning one representative template against every other class member's
;; same-index template. Zero means the diagonal is empty at this index
;; (a member's domain ends earlier, or closed templates disagree).
(type SkClsAlignsR
  (SkClsAlignsErr (List Int))
  (SkClsAlignsZero)
  (SkClsAlignsOk (List (List (Pair Int Int)))))

;; ---- relational first-productive representative ----------------------------

;; ---- the graduated first walk (language-parametric, relational) -----------
;;
;; ONE cardinality-free representative walk serves both grammar languages
;; and both drives (tools/search/superpose's su_first_* family graduated
;; here).  The cube walk is demand-driven from the root: at each open hole
;; take the first allowed PRODUCTIVE alternative and recurse into its
;; instantiation, so only the selected candidate's occurrences are ever
;; touched — exactly what a lazy schema language requires.  A relational
;; region normalizes first, then backtracks over the RELATED holes only:
;; fix the first live pair's open side to each allowed productive
;; alternative in turn and recurse; unrelated holes close through the
;; plain walk once every event has discharged.  Fuel is a loud bound, not
;; a policy.  The lang entry trusts its region: doors and forks build
;; well-formed regions by construction, and the materialized-Grammar door
;; above validates before delegating.

(sig fn sk_region_first_lang ((root Expr) (lang SkLang) (region SkRegion)) SkE)

;; index -> the closed candidate it addresses (range-checked, loud)
(sig fn sk_unrank ((root Expr) (g Grammar) (ix Int)) SkE)
