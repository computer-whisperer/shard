;; (by STEP…) is I's block, read since slice 3.20 (tactic.shard): rfl closes the equation by Eq.refl
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq a a)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(theorem t4 () (Eq two two) (by rfl))
