;; expect: read-error unsolved_universe
;; slice 3.15: a polymorphic constant cited bare takes level metavariables (universe inference);
;; one the declared inputs do not determine is a refusal with the pointer to write NAME.{…}
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq a a)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(axiom lonely.{v} () Nat)
(def bad () Nat lonely)
