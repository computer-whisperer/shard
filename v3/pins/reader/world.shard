(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq.{u} α a a)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))

(theorem two_rfl () (Eq.{1} Nat two two) (exact (Eq.refl.{1} Nat two)))
(def five () Nat 5)
(def id () (forall ((A Type)) (-> A A)) (fun ((A Type) (x A)) x))
(def two' () Nat (id Nat two))
(def four () Nat (let ((t Nat two) (u Nat (Nat.succ t))) (Nat.succ u)))
(theorem four_rfl () (Eq.{1} Nat four (Nat.succ (Nat.succ two))) (exact (Eq.refl.{1} Nat four)))
(structure Pt () (x Nat) (y Nat))
(theorem pt_x () (Eq.{1} Nat (Pt.x (Pt.mk two Nat.zero)) two) (exact (Eq.refl.{1} Nat two)))
(structure Dep () (n Nat) (p (Eq.{1} Nat n n)))
(def dep () Dep (Dep.mk two (Eq.refl.{1} Nat two)))
(type Color (red) (green))
(def c () Color Color.red)
(type (Pair2 A B) (mk A B))
(def pr () (Pair2 Nat Color) (Pair2.mk Nat Color two Color.green))
(inductive Id.{u} ((α (Type u))) (Type u) (mk (-> α (Id.{u} α))))
(type (W T) (mk (Id T)))
(def w () (W Nat) (W.mk Nat (Id.mk.{0} Nat two)))
(abbrev two2 () Nat two)
(opaque hidden () Nat two)
(axiom ax () (Eq.{1} Nat two two))
