;; expect: Bad refused non_positive_occurrence
;; a non-positive occurrence (hostile battery 4, from S)
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq.{u} α a a)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(inductive Bad () Type (mk (-> (-> Bad Nat) Bad)))
