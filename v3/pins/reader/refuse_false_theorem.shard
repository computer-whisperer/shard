;; expect: read-error type_mismatch
;; a false theorem: (Eq.refl two) is no proof of (Eq two Nat.zero) — the elaborator refuses it
;; before K
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq a a)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(theorem t2 () (Eq two Nat.zero) (exact (Eq.refl two)))
