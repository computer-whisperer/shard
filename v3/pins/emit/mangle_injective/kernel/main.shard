;; a record's accessor A.x beside a plain fn spelled A_x: two identities, two C names — the
;; back end mangles an identity injectively (`.` as `_x2e`, `_` as `__`). Until slice 5.0 the
;; text projection mangled both to `A_x` and the emit was refused (refused_mangle_collision).
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(record A (x Int))
(fn A_x ((k Int)) Int (* k 1000))
(fn main ((w World)) World (write_line (if (= (+ (A.x (make A (x 1))) (A_x 1)) 1001) "both" "neither") w))
