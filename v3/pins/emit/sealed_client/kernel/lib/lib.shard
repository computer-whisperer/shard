;; the implementation: the concrete Counter and the fns as E bodies over it
(type Counter (Counter Int))
(fn start () Counter (Counter 0))
(fn bump ((c Counter)) Counter (match c ((Counter k) (Counter (+ k 1)))))
(fn value ((c Counter)) Int (match c ((Counter k) k)))
(fn hidden ((c Counter)) Int (match c ((Counter k) (* k 2))))
