;; a sealed client: a consumer of a directory module's view, the implementation linked by the
;; directory's own check (lib given as a second root) — the back end receives the linked program
(import "lib")
(use Init.List cons nil)
(use kernel.lib)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn byte_ints ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Int.ofNat (Fin.val (BitVec.toFin (UInt8.toBitVec b)))) (byte_ints r)))))
;; a literal is a String; its bytes as the list the externs take
(fn utf8 ((s String)) (List Int) (byte_ints (Array.toList (ByteArray.data (String.toByteArray s)))))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn main ((w World)) World
  (write_line (append (utf8 "counter: ") (show_nat (value (bump (bump (bump (start))))))) w))
