;; emit refused: a numeral pattern outside the runtime's small integers in kernel.main.classify
;; a numeral pattern past 2^62, under a constructor (a numeral that is a whole row is read as a
;; test): a C case label is one of the runtime's small integers, so the generator refuses the
;; closure rather than compare approximately (compare it with `=` instead)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn classify ((p (Prod Int Int))) (List Int)
  (match p
    ((Prod.mk 4611686018427387904 _) "past")
    (_ "within")))
(fn main ((w World)) World (write_line (classify (Prod.mk 4611686018427387904 0)) w))
