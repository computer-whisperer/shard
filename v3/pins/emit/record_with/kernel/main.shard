;; a record built with make, read through its accessors, updated with `with` — the loader's
;; expansion (accessors and updaters as plain fns) reaches the chain, never the record form
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(record Pt (x Int) (y Int) (tag (List Int)))
(fn show_nat ((n Int)) (List Int) (if (< n 10) (Cons (+ 48 n) Nil) (append (show_nat (/ n 10)) (Cons (+ 48 (mod n 10)) Nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn show_pt ((p Pt)) (List Int) (append (Pt.tag p) (append ": " (append (show_nat (Pt.x p)) (append "," (show_nat (Pt.y p)))))))
(fn moved ((p Pt) (dx Int)) Pt (with Pt p (x (+ (Pt.x p) dx)) (tag "moved")))
(fn main ((w World)) World
  (let ((p (make Pt (x 3) (y 4) (tag "origin")))
        (q (moved p 10)))
    (write_line (show_pt q) (write_line (show_pt p) w))))
