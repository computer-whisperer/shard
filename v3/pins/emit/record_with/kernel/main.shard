;; a record built with make, read through its accessors, updated with `with` — the loader's
;; expansion (accessors and updaters as plain fns) reaches the back end, never the record form
(use Init.List cons nil)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(record Pt (x Int) (y Int) (tag (List Int)))
(fn byte_ints ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Int.ofNat (Fin.val (BitVec.toFin (UInt8.toBitVec b)))) (byte_ints r)))))
;; a literal is a String; its bytes as the list the externs take
(fn utf8 ((s String)) (List Int) (byte_ints (Array.toList (ByteArray.data (String.toByteArray s)))))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn show_pt ((p Pt)) (List Int)
  (append (Pt.tag p)
    (append (utf8 ": ") (append (show_nat (Pt.x p)) (append (utf8 ",") (show_nat (Pt.y p)))))))
(fn moved ((p Pt) (dx Int)) Pt (with Pt p (x (+ (Pt.x p) dx)) (tag (utf8 "moved"))))
(fn main ((w World)) World
  (let ((p (make Pt (x 3) (y 4) (tag (utf8 "origin")))) (q (moved p 10)))
    (write_line (show_pt q) (write_line (show_pt p) w))))
