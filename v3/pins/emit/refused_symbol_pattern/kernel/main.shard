;; emit refused: the symbol pattern t' is not an atom of the chain's reader
;; a symbol literal the old reader cannot lex as one atom, in a PATTERN: the chain has no
;; spelling for it, so the emitter refuses the closure (compare it with sym_eq instead)
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn classify ((s Symbol)) (List Int) (match s ((quote t') "prime") (_ "other")))
(fn main ((w World)) World (write_line (classify (quote t')) w))
