;; emit refused: a string literal over List.cons: the chain builds its closure's Cons and Nil in main.main
;; a program under the naming law (LANGUAGE.md §8.6 slice 4.3 landing 2): its World, its
;; extern over ByteArray, its string literal over Init's List — the chain's string is the old
;; reader's Cons and Nil, so the emitter refuses the closure rather than approximate it. Route 1
;; over a naming-law program is phase 5's, with the chain's replacement; the bootstrap runs this
;; program and the native loader (v3/bin/load) runs it under ev, each tracing its host calls
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn main ((w World)) World (write_line (String.toByteArray "hello") w))
