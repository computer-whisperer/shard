;; emit refused: the constructor kernel.main.World.World is the World's cell and must not be the second constructor of its type
;; the World's cell carries a fixed tag, and an `if` reads a constructor's place in its type
;; from the tag: `World` declared second in its type has no tag that is right for both, so the
;; generator refuses the closure rather than take a branch the evaluator does not
(type World (Closed) (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn main ((w World)) World (write_line "one" w))
