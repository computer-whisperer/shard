;; quoted symbols: a capitalised symbol in a term and in a pattern (never a constructor), a
;; symbol the old reader cannot lex as one atom (t', its quote macro; built by sym_of_chars —
;; compared, never a pattern: refused_symbol_pattern), operator-spelled symbols in patterns,
;; the comparison and conversion primitives on symbols
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(type Foo (Foo Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn classify ((s Symbol)) (List Int)
  (if (sym_eq s (quote t')) "the symbol t'"
    (match s ((quote Foo) "the symbol Foo") ((quote <=) "the symbol <=") ((quote -) "the symbol -") (_ (append "other: " (chars_of_sym s))))))
(fn main ((w World)) World
  (write_line (classify (sym_of_chars "Bar"))
  (write_line (classify (quote -))
  (write_line (classify (quote <=))
  (write_line (classify (sym_of_chars "t'"))
  (write_line (classify (quote t'))
  (write_line (classify (quote Foo))
  (write_line (if (sym_eq (quote Foo) (sym_of_chars (chars_of_sym (quote Foo)))) "round trip" "no round trip") w))))))))
