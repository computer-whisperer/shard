;; nested shadowing: a let rebinding the same name three times, each seeing the last; a match
;; variable shadowing a parameter; a let inside an arm shadowing the arm's variable; the
;; sequential let — printed by depth, the back end sees every binding distinct
(use Init.List cons nil)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_int ((n Int)) (List Int) (if (< n 0) (cons 45 (show_nat (- 0 n))) (show_nat n)))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn chain3 ((x Int)) Int (let ((x (+ x 1)) (x (* x 3)) (x (- x 2))) x))
(fn shadow_param ((x Int) (p (Prod Int Int))) Int
  (match p
    ((Prod.mk x y) (let ((y (+ x y))) (- y x)))))
(fn arm_let ((xs (List Int))) Int
  (match xs
    ((cons x r)
     (let ((x (+ x 100)))
       (match r
         ((cons x _) x)
         (nil x))))
    (nil -1)))
(fn main ((w World)) World
  (write_line
    (append (show_int (chain3 5))
      (append " "
        (append (show_int (shadow_param 1 (Prod.mk 10 20)))
          (append " "
            (append (show_int (arm_let (list 1 2)))
              (append " "
                (append (show_int (arm_let (list 1))) (append " " (show_int (arm_let nil))))))))))
    w))
