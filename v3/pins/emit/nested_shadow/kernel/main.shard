;; nested shadowing: a let rebinding the same name three times, each seeing the last; a match
;; variable shadowing a parameter; a let inside an arm shadowing the arm's variable; the
;; sequential let (R44) — printed by depth, the chain sees every binding distinct
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type (Pair A B) (Pair A B))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_int ((n Int)) (List Int) (if (lt n 0) (Cons 45 (show_nat (- 0 n))) (show_nat n)))
(fn show_nat ((n Int)) (List Int) (if (lt n 10) (Cons (+ 48 n) Nil) (append (show_nat (/ n 10)) (Cons (+ 48 (mod n 10)) Nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn chain3 ((x Int)) Int (let ((x (+ x 1)) (x (* x 3)) (x (- x 2))) x))
(fn shadow_param ((x Int) (p (Pair Int Int))) Int (match p ((Pair x y) (let ((y (+ x y))) (- y x)))))
(fn arm_let ((xs (List Int))) Int (match xs ((Cons x r) (let ((x (+ x 100))) (match r ((Cons x _) x) (Nil x)))) (Nil -1)))
(fn main ((w World)) World
  (write_line (append (show_int (chain3 5)) (append " " (append (show_int (shadow_param 1 (Pair 10 20))) (append " " (append (show_int (arm_let (list 1 2))) (append " " (append (show_int (arm_let (list 1))) (append " " (show_int (arm_let Nil)))))))))) w))
