;; two dotted names sharing a last component: the accessors A.x and B.x of two records, and the
;; updaters — distinct identities whose mangled heads stay distinct in the back end (a plain fn
;; spelled A_x beside them is the case mangle_injective)
(use Init.List cons nil)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(record A (x Int) (y Int))
(record B (x (List Int)) (n Int))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn main ((w World)) World
  (let ((a (make A (x 1) (y 2))) (b (make B (x "bee") (n 3))))
    (write_line
      (append (show_nat (A.x (with A a (x 7))))
        (append " "
          (append (B.x (with B b (x "updated"))) (append " " (show_nat (A.y (with A a (y 9))))))))
      w)))
