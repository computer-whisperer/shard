;; an `if` on a value of a two-constructor type takes the then-branch on the type's second
;; constructor, whatever the type: a type of the program without fields, with fields, and with
;; the fields on its first constructor, each declared after a type of three constructors;
;; Init's Option, List and Bool; a decision. Every type is tested on its first constructor,
;; then on its second, and each test prints the branch it takes. The evaluator decides by the
;; constructor's place in its type; the binary reads the same answer from the constructor's tag
(import Init String.toByteArray)
(import Init Bool.casesOn)
(import Init Nat.ble)
(type World (World Nat))
(type Tri (A) (B) (C))
(type Dec (No) (Yes))
(type Side (Left Nat) (Right Nat))
(type Maybe (Just Nat) (Nothing))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn say ((s String) (w World)) World (write_line (String.toByteArray s) w))
(fn tri ((x Tri) (w World)) World
  (match x
    (Tri.A (say "Tri.A" w))
    (Tri.B (say "Tri.B" w))
    (Tri.C (say "Tri.C" w))))
(fn dec ((x Dec) (w World)) World (if x (say "Dec: then" w) (say "Dec: else" w)))
(fn side ((x Side) (w World)) World (if x (say "Side: then" w) (say "Side: else" w)))
(fn maybe ((x Maybe) (w World)) World (if x (say "Maybe: then" w) (say "Maybe: else" w)))
(fn opt ((x (Option Nat)) (w World)) World (if x (say "Option: then" w) (say "Option: else" w)))
(fn lst ((x (List Nat)) (w World)) World (if x (say "List: then" w) (say "List: else" w)))
(fn bool ((x Bool) (w World)) World (if x (say "Bool: then" w) (say "Bool: else" w)))
(fn less ((a Nat) (b Nat) (w World)) World
  (if (< a b) (say "decision: then" w) (say "decision: else" w)))
(fn main ((w World)) World
  (let
    ((w1 (tri Tri.C (tri Tri.B (tri Tri.A w))))
     (w2 (dec Dec.Yes (dec Dec.No w1)))
     (w3 (side (Side.Right 2) (side (Side.Left 1) w2)))
     (w4 (maybe Maybe.Nothing (maybe (Maybe.Just 1) w3)))
     (w5 (opt (Option.some 1) (opt Option.none w4)))
     (w6 (lst (List.cons 1 List.nil) (lst List.nil w5)))
     (w7 (bool (Nat.ble 1 2) (bool (Nat.ble 2 1) w6)))
     (w8 (bool Bool.true (bool Bool.false w7))))
    (less 1 2 (less 2 1 w8))))
