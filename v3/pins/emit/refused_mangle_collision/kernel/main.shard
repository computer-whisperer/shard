;; emit refused: the head A_x is emitted twice (the mangling of a dotted name collides)
;; a record's accessor A.x beside a plain fn spelled A_x: the dotted head mangles to the
;; plain one's spelling, so the emitter refuses the closure rather than let the chain bind either
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(record A (x Int))
(fn A_x ((k Int)) Int (* k 1000))
(fn main ((w World)) World (write_line (if (= (+ (A.x (make A (x 1))) (A_x 1)) 1001) "both" "neither") w))
