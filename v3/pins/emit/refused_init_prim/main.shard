;; emit refused: the primitive Nat.sub has no spelling in the chain (the profile's eighteen only) in main.dec
;; a naming-law program reaching Init's `Nat.sub` (LANGUAGE.md §8.6 slice 4.3 landing 2): a
;; realized primitive beyond the chain's eighteen has no spelling there — and no semantics, the
;; chain's `-` being the integers' — so the emitter refuses the closure with the primitive and
;; the function named, as it refused calc's bin through `List.take`
(import Init Nat.sub)
(type World (World Nat))
(extern exit ((code Int) (w World)) World)
(fn dec ((n Nat)) Nat (- n 1))
(fn main ((w World)) World (match (dec 3) (_ (exit 0 w))))
