;; the profile's integer and symbol primitives on their edges, under the chain's runtime
;; against the bootstrap's: negative operands of mod, tmod and ediv; truncating division;
;; the bitwise operations; shifts; the comparisons as decisions; a product near 2^62
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_int ((n Int)) (List Int) (if (< n 0) (Cons 45 (show_nat (- 0 n))) (show_nat n)))
(fn show_nat ((n Int)) (List Int) (if (< n 10) (Cons (+ 48 n) Nil) (append (show_nat (/ n 10)) (Cons (+ 48 (mod n 10)) Nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn bool_text ((b Bool)) (List Int) (if b "T" "F"))
(fn row ((label (List Int)) (xs (List Int))) (List Int) (match xs (Nil label) ((Cons x r) (row (append label (Cons 32 (show_int x))) r))))
(fn main ((w World)) World
  (write_line (row "cmp" (list (if (= 3 3) 1 0) (if (< -1 0) 1 0) (if (<= 2 2) 1 0) (if (< 2 2) 1 0)))
  (write_line (row "big" (list (* 1000000007 2147483647) (* -3037000499 3037000499) (+ 4611686018427387903 1)))
  (write_line (row "bits" (list (band 12 10) (bor 12 10) (bxor 12 10) (bshl 1 40) (bshr 1099511627776 39) (bshr -16 2)))
  (write_line (row "div" (list (/ 7 2) (/ -7 2) (/ 7 -2) (mod 7 3) (mod -7 3) (mod 7 -3) (tmod -7 3) (tmod 7 -3) (ediv -7 3) (ediv 7 -3) (ediv -7 -3)))
  (write_line (row "arith" (list (+ 2 3) (- 2 5) (* -4 6) (- 0 0))) w))))))
