;; the integer primitives on their edges, under the back end's runtime against the
;; bootstrap's: `/` and `mod` at Int (Init's Euclidean pair) and the bare `tmod` and `ediv` on
;; negative operands; the bitwise operations; shifts; the comparisons as decisions; a product
;; near 2^62
(use Init.List cons nil)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_int ((n Int)) (List Int) (if (< n 0) (cons 45 (show_nat (- 0 n))) (show_nat n)))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn bool_text ((b Bool)) (List Int) (if b "T" "F"))
(fn row ((label (List Int)) (xs (List Int))) (List Int)
  (match xs
    (nil label)
    ((cons x r) (row (append label (cons 32 (show_int x))) r))))
(fn main ((w World)) World
  (write_line
    (row "cmp" (list (if (= 3 3) 1 0) (if (< -1 0) 1 0) (if (<= 2 2) 1 0) (if (< 2 2) 1 0)))
    (write_line
      (row "big"
        (list (* 1000000007 2147483647) (* -3037000499 3037000499) (+ 4611686018427387903 1)))
      (write_line
        (row "bits"
          (list (band 12 10) (bor 12 10) (bxor 12 10) (bshl 1 40) (bshr 1099511627776 39)
            (bshr -16 2)))
        (write_line
          (row "div"
            (list (/ 7 2) (/ -7 2) (/ 7 -2) (mod 7 3) (mod -7 3) (mod 7 -3) (tmod -7 3) (tmod 7 -3)
              (ediv -7 3)
              (ediv 7 -3)
              (ediv -7 -3)))
          (write_line (row "arith" (list (+ 2 3) (- 2 5) (* -4 6) (- 0 0))) w))))))
