;; the integer primitives on their edges, under the back end's runtime against the
;; bootstrap's: `/` and `mod` at Int (Init's Euclidean pair) and `Int.tmod` on negative
;; operands; the bitwise operations on both signs; shifts, by 63, by 64 and by more, of a
;; negative number and of one past 2^100; the comparisons as decisions; a product near 2^62
(use Init.List cons nil)
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn byte_ints ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Int.ofNat (Fin.val (BitVec.toFin (UInt8.toBitVec b)))) (byte_ints r)))))
;; a literal is a String; its bytes as the list the externs take
(fn utf8 ((s String)) (List Int) (byte_ints (Array.toList (ByteArray.data (String.toByteArray s)))))
(fn show_int ((n Int)) (List Int) (if (< n 0) (cons 45 (show_nat (- 0 n))) (show_nat n)))
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn bool_text ((b Bool)) (List Int) (if b (utf8 "T") (utf8 "F")))
;; a comparison of two numerals is read at Nat, where no numeral is negative: the operands are
;; typed by the parameters here
(fn less ((a Int) (b Int)) Int (if (< a b) 1 0))
(fn row ((label (List Int)) (xs (List Int))) (List Int)
  (match xs
    (nil label)
    ((cons x r) (row (append label (cons 32 (show_int x))) r))))
(fn main ((w World)) World
  (write_line
    (row (utf8 "cmp") (list (if (= 3 3) 1 0) (less -1 0) (if (<= 2 2) 1 0) (if (< 2 2) 1 0)))
    (write_line
      (row (utf8 "big")
        (list (* 1000000007 2147483647) (* -3037000499 3037000499) (+ 4611686018427387903 1)))
      (write_line
        (row (utf8 "bits")
          (list (band 12 10) (bor 12 10) (bxor 12 10) (band -4 -6) (bor -8 3) (bxor -1 5)
            (bshl 1 40)
            (bshr 1099511627776 39)
            (bshr -16 2)
            (bshl 1 63)
            (bshl 1 64)
            (bshl -5 100)
            (bshr 5 64)
            (bshr -5 64)
            (bshr -5 200)
            (bshr 1267650600228229401496703205376 99)
            (bshr -1267650600228229401496703205377 99)))
        (write_line
          (row (utf8 "div")
            (list (/ 7 2) (/ -7 2) (/ 7 -2) (mod 7 3) (mod -7 3) (mod 7 -3) (Int.tmod -7 3)
              (Int.tmod 7 -3)
              (/ -7 3)
              (/ 7 -3)
              (/ -7 -3)))
          (write_line (row (utf8 "arith") (list (+ 2 3) (- 2 5) (* -4 6) (- 0 0))) w))))))
