;; the bit-level operators at Int, held to their definitions on three engines. Each case is
;; stated twice: a theorem, which K checks by computing the definition — the base's `land`,
;; `lor`, `xor` over Init's Nat operations (kernel/base.shard), Init's `Int.shiftLeft` and
;; `Int.shiftRight` — and a row of `main`, which the engine computes by its own operation (the
;; registry's rows, kernel/prog.shard realization_of) and compares with the same number. A row
;; is silent when the two agree and prints its name otherwise; the last line is always printed.
;; The cases: both signs of each operand, numbers past 2^63 and past 2^100, a shift by 63, by
;; 64 and by more, a right shift that leaves the sign alone
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn bad ((name String) (w World)) World (write_line (String.toByteArray name) w))
(fn row ((name String) (got Int) (want Int) (w World)) World (if (= got want) w (bad name w)))
(fn iand ((a Int) (b Int)) Int (band a b))
(fn ior ((a Int) (b Int)) Int (bor a b))
(fn ixor ((a Int) (b Int)) Int (bxor a b))
(fn ishl ((a Int) (k Nat)) Int (bshl a k))
(fn ishr ((a Int) (k Nat)) Int (bshr a k))
(theorem and_1 () (= (iand 12 10) 8) (by (decide)))
(theorem and_2 () (= (iand -1 255) 255) (by (decide)))
(theorem and_3 () (= (iand -4 -6) -8) (by (decide)))
(theorem and_4 () (= (iand 255 -16) 240) (by (decide)))
(theorem and_5 () (= (iand -16 255) 240) (by (decide)))
(theorem and_6 () (= (iand 1267650600228229401496703205381 1267650600228229401496703205375) 5)
  (by (decide)))
(theorem and_7 () (= (iand -1 1267650600228229401496703205381) 1267650600228229401496703205381)
  (by (decide)))
(theorem and_8 ()
  (= (iand -1267650600228229401496703205376 1267650600228229401496703205381)
    1267650600228229401496703205376)
  (by (decide)))
(theorem and_9 ()
  (= (iand -1267650600228229401496703205377 -1267650600228229401496703205378)
    -1267650600228229401496703205378)
  (by (decide)))
(theorem or_1 () (= (ior 12 10) 14) (by (decide)))
(theorem or_2 () (= (ior -8 3) -5) (by (decide)))
(theorem or_3 () (= (ior -4 -6) -2) (by (decide)))
(theorem or_4 () (= (ior 0 -1) -1) (by (decide)))
(theorem or_5 () (= (ior 1267650600228229401496703205376 5) 1267650600228229401496703205381)
  (by (decide)))
(theorem or_6 () (= (ior -1267650600228229401496703205376 5) -1267650600228229401496703205371)
  (by (decide)))
(theorem or_7 () (= (ior -1267650600228229401496703205377 1267650600228229401496703205376) -1)
  (by (decide)))
(theorem xor_1 () (= (ixor 12 10) 6) (by (decide)))
(theorem xor_2 () (= (ixor -1 5) -6) (by (decide)))
(theorem xor_3 () (= (ixor -4 -6) 6) (by (decide)))
(theorem xor_4 () (= (ixor -1 -1) 0) (by (decide)))
(theorem xor_5 () (= (ixor 1267650600228229401496703205381 5) 1267650600228229401496703205376)
  (by (decide)))
(theorem xor_6 ()
  (= (ixor -1267650600228229401496703205376 1267650600228229401496703205376)
    -2535301200456458802993406410752)
  (by (decide)))
(theorem xor_7 () (= (ixor -1267650600228229401496703205377 -1) 1267650600228229401496703205376)
  (by (decide)))
(theorem shl_1 () (= (ishl 3 2) 12) (by (decide)))
(theorem shl_2 () (= (ishl -3 2) -12) (by (decide)))
(theorem shl_3 () (= (ishl 1 63) 9223372036854775808) (by (decide)))
(theorem shl_4 () (= (ishl 1 64) 18446744073709551616) (by (decide)))
(theorem shl_5 () (= (ishl -5 100) -6338253001141147007483516026880) (by (decide)))
(theorem shl_6 () (= (ishl 0 1180591620717411303424) 0) (by (decide)))
(theorem shl_7 ()
  (= (ishl 1267650600228229401496703205377 67) 187072209578355573530071658587831800468549041913856)
  (by (decide)))
(theorem shr_1 () (= (ishr 12 2) 3) (by (decide)))
(theorem shr_2 () (= (ishr -16 2) -4) (by (decide)))
(theorem shr_3 () (= (ishr -1 1) -1) (by (decide)))
(theorem shr_4 () (= (ishr -5 1) -3) (by (decide)))
(theorem shr_5 () (= (ishr 5 64) 0) (by (decide)))
(theorem shr_6 () (= (ishr -5 64) -1) (by (decide)))
(theorem shr_7 () (= (ishr -5 200) -1) (by (decide)))
(theorem shr_8 () (= (ishr 1267650600228229401496703205376 99) 2) (by (decide)))
(theorem shr_9 () (= (ishr -1267650600228229401496703205376 99) -2) (by (decide)))
(theorem shr_10 () (= (ishr -1267650600228229401496703205377 99) -3) (by (decide)))
(theorem shr_11 () (= (ishr -1267650600228229401496703205377 1180591620717411303424) -1)
  (by (decide)))
(fn main ((w World)) World
  (let
    ((w1 (row "and_1" (iand 12 10) 8 w))
     (w2 (row "and_2" (iand -1 255) 255 w1))
     (w3 (row "and_3" (iand -4 -6) -8 w2))
     (w4 (row "and_4" (iand 255 -16) 240 w3))
     (w5 (row "and_5" (iand -16 255) 240 w4))
     (w6 (row "and_6" (iand 1267650600228229401496703205381 1267650600228229401496703205375) 5 w5))
     (w7 (row "and_7" (iand -1 1267650600228229401496703205381) 1267650600228229401496703205381 w6))
     (w8
       (row "and_8" (iand -1267650600228229401496703205376 1267650600228229401496703205381)
         1267650600228229401496703205376
         w7))
     (w9
       (row "and_9" (iand -1267650600228229401496703205377 -1267650600228229401496703205378)
         -1267650600228229401496703205378
         w8))
     (w10 (row "or_1" (ior 12 10) 14 w9))
     (w11 (row "or_2" (ior -8 3) -5 w10))
     (w12 (row "or_3" (ior -4 -6) -2 w11))
     (w13 (row "or_4" (ior 0 -1) -1 w12))
     (w14 (row "or_5" (ior 1267650600228229401496703205376 5) 1267650600228229401496703205381 w13))
     (w15 (row "or_6" (ior -1267650600228229401496703205376 5) -1267650600228229401496703205371 w14))
     (w16 (row "or_7" (ior -1267650600228229401496703205377 1267650600228229401496703205376) -1 w15))
     (w17 (row "xor_1" (ixor 12 10) 6 w16))
     (w18 (row "xor_2" (ixor -1 5) -6 w17))
     (w19 (row "xor_3" (ixor -4 -6) 6 w18))
     (w20 (row "xor_4" (ixor -1 -1) 0 w19))
     (w21 (row "xor_5" (ixor 1267650600228229401496703205381 5) 1267650600228229401496703205376 w20))
     (w22
       (row "xor_6" (ixor -1267650600228229401496703205376 1267650600228229401496703205376)
         -2535301200456458802993406410752
         w21))
     (w23
       (row "xor_7" (ixor -1267650600228229401496703205377 -1) 1267650600228229401496703205376 w22))
     (w24 (row "shl_1" (ishl 3 2) 12 w23))
     (w25 (row "shl_2" (ishl -3 2) -12 w24))
     (w26 (row "shl_3" (ishl 1 63) 9223372036854775808 w25))
     (w27 (row "shl_4" (ishl 1 64) 18446744073709551616 w26))
     (w28 (row "shl_5" (ishl -5 100) -6338253001141147007483516026880 w27))
     (w29 (row "shl_6" (ishl 0 1180591620717411303424) 0 w28))
     (w30
       (row "shl_7" (ishl 1267650600228229401496703205377 67)
         187072209578355573530071658587831800468549041913856
         w29))
     (w31 (row "shr_1" (ishr 12 2) 3 w30))
     (w32 (row "shr_2" (ishr -16 2) -4 w31))
     (w33 (row "shr_3" (ishr -1 1) -1 w32))
     (w34 (row "shr_4" (ishr -5 1) -3 w33))
     (w35 (row "shr_5" (ishr 5 64) 0 w34))
     (w36 (row "shr_6" (ishr -5 64) -1 w35))
     (w37 (row "shr_7" (ishr -5 200) -1 w36))
     (w38 (row "shr_8" (ishr 1267650600228229401496703205376 99) 2 w37))
     (w39 (row "shr_9" (ishr -1267650600228229401496703205376 99) -2 w38))
     (w40 (row "shr_10" (ishr -1267650600228229401496703205377 99) -3 w39))
     (w41 (row "shr_11" (ishr -1267650600228229401496703205377 1180591620717411303424) -1 w40)))
    (write_line (String.toByteArray "int_bits: 41 cases") w41)))
