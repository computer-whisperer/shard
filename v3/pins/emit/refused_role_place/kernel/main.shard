;; emit refused: the constructor kernel.main.Tree.Pair is named as a cell of the runtime and must not be the second constructor of its type
;; a constructor named as one of the runtime's cells carries that cell's tag, and an `if` reads a
;; constructor's place in its type from the tag: `Pair`, the first constructor of the runtime's
;; pair, declared second in a type of the program has no tag that is right for both, so the
;; generator refuses the closure rather than take a branch the evaluator does not
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(type Tree (Leaf) (Pair Tree Tree))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn depth ((t Tree)) Int
  (match t
    (Leaf 0)
    ((Pair l _) (+ 1 (depth l)))))
(fn main ((w World)) World (write_line (if (= (depth (Pair Leaf Leaf)) 1) "one" "other") w))
