;; capitalised locals: a parameter, a let binding and a match variable spelled like a
;; constructor's name (M, N; X beside a type whose constructors are M and N) — the old reader
;; takes a capitalised binder for a constructor; every local reaches the chain by its depth
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(type Tag (M) (N Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_nat ((n Int)) (List Int) (if (lt n 10) (Cons (+ 48 n) Nil) (append (show_nat (/ n 10)) (Cons (+ 48 (mod n 10)) Nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn twice ((M Int)) Int (let ((K (+ M M))) K))
(fn first_or ((Xs (List Int)) (D Int)) Int (match Xs ((Cons X _) X) (Nil D)))
(fn tag_val ((t Tag)) Int (match t (M 0) ((N k) k)))
(fn main ((w World)) World
  (write_line (show_nat (+ (twice 21) (+ (first_or (list 7 8) 1) (+ (first_or Nil 5) (+ (tag_val M) (tag_val (N 100))))))) w))
