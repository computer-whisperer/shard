;; capitalised locals: a parameter, a let binding and a match variable spelled like a
;; constructor's name (M, N; X beside a type whose constructors are M and N) — each is a local,
;; and every local reaches the back end by its depth
(use Init.List cons nil)
(type World (World Int))
(type Tag (M) (N Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) nil) (append (show_nat (/ n 10)) (cons (+ 48 (mod n 10)) nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))
(fn twice ((M Int)) Int (let ((K (+ M M))) K))
(fn first_or ((Xs (List Int)) (D Int)) Int
  (match Xs
    ((cons X _) X)
    (nil D)))
(fn tag_val ((t Tag)) Int
  (match t
    (M 0)
    ((N k) k)))
(fn main ((w World)) World
  (write_line
    (show_nat
      (+ (twice 21)
        (+ (first_or (list 7 8) 1) (+ (first_or nil 5) (+ (tag_val M) (tag_val (N 100)))))))
    w))
