;; a nonzero program exit after output on both streams: the status and both streams tied
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(extern exit ((code Int) (w World)) World)
(fn main ((w World)) World
  (exit 7 (write_line "leaving with 7" w)))
