;; string literals the emitter must re-escape: a quote, a backslash, a newline, a tab, a
;; carriage return, UTF-8 bytes, an empty string, a string that looks like a form
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn len ((xs (List Int))) Int (match xs (Nil 0) ((Cons _ r) (+ 1 (len r)))))
(fn show_nat ((n Int)) (List Int) (if (lt n 10) (Cons (+ 48 n) Nil) (append (show_nat (/ n 10)) (Cons (+ 48 (mod n 10)) Nil))))
(fn append ((xs (List Int)) (ys (List Int))) (List Int) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn main ((w World)) World
  (write_line (show_nat (len "é→∀"))
  (write_line "(fn not_a_form ((x Int)) Int x) ; not a comment"
  (write_line ""
  (write_line "tab\there, cr\rthere, quote \" and backslash \\ and newline\nsecond line" w)))))
