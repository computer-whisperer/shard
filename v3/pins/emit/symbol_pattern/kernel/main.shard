;; a symbol literal with a quote character in it, in a PATTERN: a static of the generated
;; text by its bytes, compared by identity
(type (List T) (Nil) (Cons T (List T)))
(type Bool (False) (True))
(type World (World Int))
(extern write_line ((bytes (List Int)) (w World)) World)
(fn classify ((s Symbol)) (List Int)
  (match s
    ((quote t') "prime")
    (_ "other")))
(fn main ((w World)) World (write_line (classify (quote t')) w))
