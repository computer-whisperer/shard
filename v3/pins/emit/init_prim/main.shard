;; the bridge's primitive rows (LANGUAGE.md §8.6 slice 4.4 landing 1): the naming law's Nat.sub,
;; Nat.div, Nat.mod, Int.tdiv, Int.tmod, Int.ediv and Int.emod at the values where the chain's
;; own operations differ — an underflow, a zero divisor, negative operands — and the bitwise
;; five with Nat.beq and Nat.ble, which print by name. Each row is silent when the naming law's
;; result holds and prints its name otherwise; the last line is always printed. The V3 driver
;; under ev is the authority (its entries are K's: Nat.sub truncates, a division by zero is the
;; migration table's x / 0 = 0 and x % 0 = x); the binary must agree, byte for byte
(import Init Nat.sub)
(import Init Nat.div)
(import Init Nat.mod)
(import Init Int.tdiv)
(import Init Int.tmod)
(import Init Int.ediv)
(import Init Int.emod)
(import Init Nat.land)
(import Init Nat.lor)
(import Init Nat.xor)
(import Init Nat.shiftLeft)
(import Init Nat.shiftRight)
(import Init Nat.beq)
(import Init Nat.ble)
(import Init Nat.decEq)
(import Init Int.decEq)
(import Init String.toByteArray)
(use Init.Bool)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn bad ((name String) (w World)) World (write_line (String.toByteArray name) w))
(fn nrow ((name String) (got Nat) (want Nat) (w World)) World (if (= got want) w (bad name w)))
(fn irow ((name String) (got Int) (want Int) (w World)) World (if (= got want) w (bad name w)))
(fn brow ((name String) (got Bool) (w World)) World (match got (true w) (false (bad name w))))
(fn neg ((n Int)) Int (- 0 n))
(fn main ((w World)) World
  (let ((w1 (nrow "Nat.sub underflow" (Nat.sub 0 1) 0 w))
        (w2 (nrow "Nat.sub" (Nat.sub 5 2) 3 w1))
        (w3 (nrow "Nat.div by zero" (Nat.div 7 0) 0 w2))
        (w4 (nrow "Nat.div" (Nat.div 7 2) 3 w3))
        (w5 (nrow "Nat.mod by zero" (Nat.mod 7 0) 7 w4))
        (w6 (nrow "Nat.mod" (Nat.mod 7 2) 1 w5))
        (w7 (irow "Int.tdiv negative" (Int.tdiv (neg 7) 2) (neg 3) w6))
        (w8 (irow "Int.tmod negative" (Int.tmod (neg 7) 2) (neg 1) w7))
        (w9 (irow "Int.ediv negative" (Int.ediv (neg 7) 2) (neg 4) w8))
        (w10 (irow "Int.emod negative" (Int.emod (neg 7) 2) 1 w9))
        (w11 (irow "Int.tdiv by zero" (Int.tdiv 7 0) 0 w10))
        (w12 (irow "Int.tmod by zero" (Int.tmod 7 0) 7 w11))
        (w13 (irow "Int.ediv by zero" (Int.ediv (neg 7) 0) 0 w12))
        (w14 (irow "Int.emod by zero" (Int.emod (neg 7) 0) (neg 7) w13))
        (w15 (nrow "Nat.land" (Nat.land 12 10) 8 w14))
        (w16 (nrow "Nat.lor" (Nat.lor 12 10) 14 w15))
        (w17 (nrow "Nat.xor" (Nat.xor 12 10) 6 w16))
        (w18 (nrow "Nat.shiftLeft" (Nat.shiftLeft 3 2) 12 w17))
        (w19 (nrow "Nat.shiftRight" (Nat.shiftRight 12 2) 3 w18))
        (w20 (brow "Nat.beq" (Nat.beq 3 3) w19))
        (w21 (brow "Nat.ble" (Nat.ble 2 3) w20)))
    (write_line (String.toByteArray "rows done") w21)))
