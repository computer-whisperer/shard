;; an ordinary program — one that imports Init — through the back end: its World, its extern
;; over ByteArray, its string literal over Init's List. Init's List cells are the cells the
;; runtime's externs build and read, so the literal needs no rewrite. An ordinary case lives at
;; the root (no kernel/ directory) and its reference under the tie is the V3 driver's --run,
;; never the bootstrap's flat read, which reads an unknown head as an effect and `-` at Nat as
;; the integer's
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn main ((w World)) World (write_line (String.toByteArray "hello") w))
