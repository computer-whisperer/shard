;; revision B of the session's pins (kernel/test/session_test.shard) — A's module, entry and
;; citations of Init under another body: `answer` adds 2
(import "lib.shard")
(import Init Nat.sub)
(use lib)
(fn answer ((n Nat)) Nat (Nat.add (twice n) 2))
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(fn width ((s Span)) Nat (Nat.sub (Span.hi s) (Span.lo s)))
(fn small ((n Nat) (h (Nat.lt n 10))) Nat n)
