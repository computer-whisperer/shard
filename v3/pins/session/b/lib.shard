;; the file revision B's main.shard stands on, the same as revision A's
;; (kernel/test/session_test.shard). What it demands of Init is demanded before the root's first
;; declaration and stays with the session's base; what main.shard demands after it is the
;; revision's own
(import Init Nat.add)
(fn twice ((n Nat)) Nat (Nat.add n n))
