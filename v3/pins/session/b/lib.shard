;; §8.6 slice 4.6 rule 2 (kernel/test/session_test.shard): the file both of revision A's
;; modules stand on. What it demands of Init is demanded before the root's first declaration
;; and stays with the session's base; what main.shard demands after it is the revision's own
(import Init Nat.add)
(fn twice ((n Nat)) Nat (Nat.add n n))
