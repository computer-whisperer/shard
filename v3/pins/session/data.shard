;; the module a declaration built as data enters (kernel/test/session_test.shard). It has no
;; `main`: the test builds one as a term of K —
;;   main : Nat → World → World := fun n w => write_line (show_digit (thrice n)) w
;; — admits it through the raw entry, takes its derived view, prepares it, invokes it and emits
;; the closure as the back end's C text. `shown` and `guarded` are the command line's door
;; (session.shard run_load): one entry it runs, one whose evidence binder it refuses
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(use std.bytes)
(use std.host)
(use Init.List cons nil)
;; a fn with no L meaning — a program, no constant of K: a declaration built as data may not
;; take its name
(fn rawfn ((n Int)) Int (band n 1))
(fn thrice ((n Nat)) Nat (Nat.add n (Nat.add n n)))
(fn show_digit ((n Nat)) ByteArray (Bytes.ofList (cons (Byte.ofNat (+ 48 (Nat.mod n 10))) nil)))
(fn shown ((n Nat) (w World)) World (write_line (show_digit n) w))
(fn guarded ((n Nat) (h (Nat.lt n 10)) (w World)) World (write_line (show_digit n) w))
