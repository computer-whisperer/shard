;; revision A of the session's pins (kernel/test/session_test.shard). `answer` is the entry the
;; two revisions differ in — A adds 1, B adds 2 — so which revision a handle ran is read from
;; its answer. `small` and `width` are the checked door's limit (the loader pin handle_door),
;; closed here from the environment: an evidence binder, a proposition field
(import "lib.shard")
(import Init Nat.sub)
(use lib)
(fn answer ((n Nat)) Nat (Nat.add (twice n) 1))
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(fn width ((s Span)) Nat (Nat.sub (Span.hi s) (Span.lo s)))
(fn small ((n Nat) (h (Nat.lt n 10))) Nat n)
