;; expect: main.main unthreaded world_twice
;; slice 4.3 landing 0 (law §4.7, §12.4 item 4): the negative fixture — one World boxed in a pair,
;; unwrapped twice, written twice. The box is one token: its second unwrapping is the second use,
;; whatever the names say (`wa`, `wb`)
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World
  (let ((p (Prod.mk 0 w)))
    (match p
      ((Prod.mk _ wa)
       (let ((w2 (write_line (text "a") wa)))
         (match p ((Prod.mk _ wb) (write_line (text "b") wb))))))))
