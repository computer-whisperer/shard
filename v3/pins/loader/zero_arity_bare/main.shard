;; expect: ok
;; §8.4 slice 3.27 landing 4 (T9's finding): a fn of no parameters written bare in argument
;; position is its call on the E-first route as on the typed route — `(count_below n sample)`
;; for `(count_below n (sample))`. Before, the classifier refused it function_value (law §4.3)
;; while the typed route's elaborator read the constant as the value it is (std/list's
;; sorted_demo). main is on the E-first route (it calls an extern): RUNNABLE no_l_meaning, no
;; refusal; count_below and sample are DEFINEd.
(import Init Prod)
(type World (World Nat))
(extern write_line ((bytes (List Nat)) (w World)) World)
(fn sample () (List Nat) (list 1 4 7 10))
(fn count_below ((n Nat) (xs (List Nat))) Nat (measure (struct xs))
  (match xs (List.nil 0) ((List.cons x t) (if (< x n) (+ (count_below n t) 1) (count_below n t)))))
(fn main ((n Nat) (w World)) World
  (write_line (List.cons (+ 48 (count_below n sample)) List.nil) w))
