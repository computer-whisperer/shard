;; expect: ok
;; a fn of no parameters written bare in argument position is its call — `(count_below n
;; sample)` for `(count_below n (sample))`. Every fn here is defined, no refusal.
(import Init Prod)
(type World (World Nat))
(extern write_line ((bytes (List Nat)) (w World)) World)
(fn sample () (List Nat) (list 1 4 7 10))
(fn count_below ((n Nat) (xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (List.nil 0)
    ((List.cons x t) (if (< x n) (+ (count_below n t) 1) (count_below n t)))))
(fn main ((n Nat) (w World)) World
  (write_line (List.cons (+ 48 (count_below n sample)) List.nil) w))
