;; expect: ok
;; the `if` conditions Stage 0 admits (§6.2; GPT-6 R56): Init's Bool, a two-constructor type of the
;; program's, a comparison's result; a condition whose type the pass cannot fix (a type parameter) is unchecked
(import Init Bool.casesOn)
(type Dec (No) (Yes))
(fn b ((x Bool)) Nat (if x 1 0))
(fn d ((x Dec)) Nat (if x 1 0))
(fn c ((x Nat) (y Nat)) Nat (if (Nat.ble x y) 1 0))
(fn go () Nat (Nat.add (b Bool.true) (d Dec.Yes)))
