;; expect: main.pick refused ambiguous_type
;; T5: two same-spelled nominal types are two identities — Init's Bool and this file's main.Bool —
;; never conflated: a bare `Bool` where both are visible is refused as ambiguous, and each is
;; citable in full — `main.Bool` by its module path, `Init.Bool` by the import's prefix (§3.1)
(import Init Bool.casesOn)
(type Bool (No) (Yes))
(fn pick ((b Bool)) Nat (match b (No 0) (Yes 1)))
(fn own ((b main.Bool)) Nat (match b (No 0) (Yes 1)))
(fn theirs ((b Init.Bool)) Nat (match b (Bool.false 0) (Bool.true 1)))
