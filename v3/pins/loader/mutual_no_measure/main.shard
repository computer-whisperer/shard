;; expect: main.ping runnable group_measure
;; every member of a group states its measure; one without — `ping` — leaves the whole group
;; programs, each record naming the reason
(import Init UInt8.toNat)
(use Init.Bool)
(fn ping ((n Nat)) Nat (if (= n 0) 0 (pong (Nat.sub n 1))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 1 (ping (Nat.sub n 1))))
