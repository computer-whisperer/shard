;; expect: ok
;; a fn that names itself in full calls itself: `main.len` in the body of `len` is the fn being
;; defined, as `len` is — one function by structural recursion, not a group of two
(use Init.List cons nil)
(fn len ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ r) (+ 1 (main.len r)))))
(theorem len_two () (= (len (cons 5 (cons 6 nil))) 2) (by rfl))
