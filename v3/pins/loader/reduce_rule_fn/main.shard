;; expect: read-error rw_not_eq
;; the run with its facts: a function's name is no rule — reduce applies every function's
;; equations unnamed (Lean's `simp only [f, h]` names both; here the list holds the facts
;; alone). The refusal points at leaving the name out
(import Init WellFounded.fix_eq)
(type T (A Nat))
(fn f ((t T) (y Nat)) Nat
  (match t
    ((A n) (+ n y))))
(theorem t ((a Nat) (k Nat) (h (= (+ 1 a) k))) (= (f (A 1) a) k) (by (reduce lhs (using f h)) rfl))
