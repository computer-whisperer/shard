;; expect: read-error type_mismatch
;; a false theorem: the elaborator refuses the proof's type before K (the reader pin
;; refuse_false_theorem is the same case)
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (x α)) (-> α Prop) (refl (Eq x x)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(theorem bad () (Eq two Nat.zero) (exact (Eq.refl two)))
(def after () Nat two)
