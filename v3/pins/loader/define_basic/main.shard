;; expect: ok
;; §8.4 (slice 3.13): fn = def + realize. A non-recursive fn and a structurally recursive one get
;; definitions K checks and equations NAME.eq_N by Eq.refl; a theorem cites an equation; an
;; accumulator changes the other argument through the abstracted motive; the operators resolve
;; by operand type (+ at Nat = Nat.add, lt = Nat.decLt); a let and an if sit in tail position
(import Init Int.decEq)
(use Init.List)
(fn twice ((n Nat)) Nat (+ n n))
(theorem twice_eq ((n Nat)) (Eq.{1} Nat (twice n) (Nat.add n n)) (exact (twice.eq_1 n)))
(fn len ((a Type) (xs (List a))) Nat (measure (struct xs))
  (match xs (List.nil 0) ((List.cons _ t) (+ 1 (len t)))))
(theorem len_cons ((a Type) (x a) (t (List.{0} a)))
  (Eq.{1} Nat (len a (List.cons.{0} a x t)) (Nat.add 1 (len a t)))
  (exact (len.eq_2 a x t)))
(fn sum_acc ((xs (List Nat)) (acc Nat)) Nat (measure (struct xs))
  (match xs (List.nil acc) ((List.cons x t) (sum_acc t (+ acc x)))))
(theorem sum_acc_cons ((x Nat) (t (List.{0} Nat)) (acc Nat))
  (Eq.{1} Nat (sum_acc (List.cons.{0} Nat x t) acc) (sum_acc t (Nat.add acc x)))
  (exact (sum_acc.eq_2 acc x t)))
(fn clamp ((n Nat) (k Nat)) Nat (let ((m (+ n 1))) (if (lt m k) m k)))
(theorem clamp_eq ((n Nat) (k Nat)) (Eq.{1} Nat (clamp n k) (clamp n k)) (exact (Eq.refl.{1} Nat (clamp n k))))
(fn total ((xs (List Nat))) Nat (sum_acc xs 0))
