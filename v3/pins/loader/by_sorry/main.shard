;; expect: main.t pending sorry goals=2
;; §8.4 slice 3.20 rule 9: a sorry in a block closes its goal and the theorem is pending —
;; nothing declared, the count of sorried goals in the record; the whole block is elaborated
;; first (the rfl of the true arm must still be right)
(import Init InvImage.wf)
(theorem t ((n Nat) (b Bool)) (= n n)
  (by (cases b ((false () sorry) (true () (have h (= 1 1) sorry) rfl)))))
