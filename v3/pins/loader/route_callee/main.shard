;; expect: main.b runnable callee_runnable
;; §8.4 slice 3.16 rule 6 (GPT-6 R70; fixture G8): a callee that is RUNNABLE — `down`, its Int
;; measure the obstacle — stands in `b` as a local of its signature's type. The body is still
;; elaborated once and erased: `b`'s program is `a`'s with the call in it — the same operator,
;; literal and constructors (define_test.sh compares the dumps) — and nothing is re-read by the
;; classifier; only K's half is missing, and the record says why
(import Init Int.decEq)
(use Init.List)
(fn down ((n Int)) Int (measure n) (if (lt 0 n) (down (- n 1)) 0))
(fn a ((n Int) (xs (List Int))) Int (match xs (List.nil (- n 1)) ((List.cons h _) (+ h 2))))
(fn b ((n Int) (xs (List Int))) Int (match xs (List.nil (- (down n) 1)) ((List.cons h _) (+ h 2))))
