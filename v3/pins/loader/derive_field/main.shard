;; expect: main.derive refused derive_field
;; §8.4 slice 3.19 rule 8: Line's field is a (List Tok), which has no equality here — the
;; refusal names the constructor, the type and the form to write, `(derive (List main.Tok) eq)`:
;; an instantiation is derived by the program, never found by search. Line stays admitted
(import Init Int.decEq)
(type Tok (TNum Nat) (TPlus))
(derive Tok eq)
(type Line (MkLine (List Tok)))
(derive Line eq)
(def line_stays ((l Line)) Line l)
