;; expect: main.up runnable measure_type
;; the members of a group are compared with each other, so they state measures of as many
;; parts each: `up` states two and `down` one, and both are programs with the reason
(use Init.List cons nil)
(fn up ((d Nat) (xs (List Nat))) Nat
  (measure d (List.length xs))
  (match xs
    (nil 0)
    ((cons x r) (+ (down d x) (up d r)))))
(fn down ((d Nat) (x Nat)) Nat (measure d) (if (< 0 d) (up (Nat.sub d 1) (cons x nil)) x))
