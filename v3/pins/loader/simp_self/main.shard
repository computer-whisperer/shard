;; expect: read-error simp_self
;; §8.4 slice 3.21 rule 6 (found by the slice's second reader): a rule whose right side holds
;; its left at the instance matched rewrites its own result — `r = mk (fst r) (snd r)` given
;; without its argument matches every P2 and puts the term back twice, so the target doubles at
;; each step and a budget of rewrites is never reached (the load did not end). It is refused at
;; once; `(rw eta)` is the one step, `(simp_only (eta r))` is refused the same way
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(type P2 (mk Int Int))
(fn fst ((p P2)) Int (match p ((mk a b) a)))
(fn snd ((p P2)) Int (match p ((mk a b) b)))
(theorem eta ((r P2)) (= r (mk (fst r) (snd r))) (by (cases r ((mk (a b) (reduce) rfl)))))
(theorem t ((r P2)) (= (fst r) (fst r)) (by (simp_only eta) rfl))
