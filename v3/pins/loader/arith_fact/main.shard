;; expect: read-error arith_fact
;; §8.4 slice 3.21 rule 1: a fact given is a row — a term whose statement is no linear
;; comparison is refused (a context hypothesis that is none is passed over)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((x Int) (p Prop) (hp p) (h (<= 0 x))) (<= 0 (+ x 1)) (by (arith hp)))
