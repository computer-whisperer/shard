;; expect: ok
;; a string literal: outside the toolchain's sources "…" is a String in every position — K's literal
;; in a `fn` body, its program the UTF-8 bytes as Init's List cells, String's representation, built
;; once by the linker. `(fn g () (List Nat) "abc")` is type_mismatch. v3/kernel/test/rows_test.shard
;; runs these under ev: g = 97 98 99, size = 3
(import Init String.toByteArray)
(fn g () String "abc")
(fn bytes ((s String)) (List UInt8)
  (match (String.toByteArray s)
    ((ByteArray.mk a) (Array.toList a))))
(fn count ((xs (List UInt8))) Nat
  (measure (struct xs))
  (match xs
    (List.nil 0)
    ((List.cons _ t) (+ 1 (count t)))))
(fn size () Nat (count (bytes (g))))
