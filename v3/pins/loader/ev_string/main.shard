;; expect: ok
;; a string literal in every file (§8.1 rule 2; slice 3.4): the byte list of the List in scope —
;; Init's here — built once by the linker; before, S refused it (string_literal) until String's realization
(import Init Bool.casesOn)
(fn g () (List Nat) "abc")
(fn h ((xs (List Nat))) Nat (match xs (List.nil 0) ((List.cons x _) x)))
(fn first () Nat (h (g)))
