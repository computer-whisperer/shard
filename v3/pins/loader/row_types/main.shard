;; expect: ok
;; §8.4 slice 3.18 rule 1: the registry's type rows — Fin, BitVec, UInt8, Array, ByteArray,
;; String, each represented by its one runtime field. A constructor is its argument, a
;; projection its subject, a constructor pattern binds the field to the scrutinee: `pack`,
;; `unpack`, `val`, `bytes` erase to the identity and `byte` to (Nat.mod #0 256), its proof
;; gone. K's half keeps the constructors: unpack_pack is Eq.refl
(import Init String.toByteArray)
(fn pack ((l (List UInt8))) ByteArray (ByteArray.mk (Array.mk l)))
(fn unpack ((b ByteArray)) (List UInt8) (match b ((ByteArray.mk a) (Array.toList a))))
(fn byte ((n Nat)) UInt8 (UInt8.ofBitVec (BitVec.ofFin (Fin.mk (Nat.mod n 256) (Nat.mod_lt n (Nat.zero_lt_succ 255))))))
(fn val ((x (Fin 3))) Nat (Fin.val x))
(fn width ((x (BitVec 8))) (Fin 256) (BitVec.toFin x))
(fn bytes ((s String)) ByteArray (String.toByteArray s))
(theorem unpack_pack ((l (List UInt8))) (= (unpack (pack l)) l) (exact (Eq.refl l)))
