;; expect: ok
;; §8.4 (slice 3.14 rule 2's `ite`; fixed at slice 3.19): a structural recursion whose `if`
;; condition is a self-call. `(if (all x1) …)` is `ite (all x1 = true) inst …`: the call is in
;; the proposition and in its decision, and both go through the walk — the proposition kept
;; the self-local before, and K refused the definition (fvar_in_value). The equations are
;; stated over the function, so all_pair is Eq.refl
(import Init Int.decEq)
(type Tok (TNum Nat) (TPlus) (TPair Tok Tok))
(fn all ((a Tok)) Bool
  (measure (struct a))
  (match a
    ((TNum _) Bool.true)
    (TPlus Bool.false)
    ((TPair x1 x2) (if (all x1) (all x2) Bool.false))))
(theorem all_pair () (= (all (TPair (TNum 1) (TPair (TNum 2) (TNum 3)))) Bool.true) (exact (Eq.refl Bool.true)))
(theorem all_plus () (= (all (TPair (TNum 1) TPlus)) Bool.false) (exact (Eq.refl Bool.false)))
