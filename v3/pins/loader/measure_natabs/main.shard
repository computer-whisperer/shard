;; expect: main.digits pending measure
;; §8.4 slice 3.17 rule 7: an Int function recursing on a quotient takes its Nat measure
;; through Int.natAbs, which the realization registry reads as an E expression over the
;; table's entries (no new primitive) — the measure is erased with the body. The function is
;; defined, its descent the pending obligation main.digits.dec_1
(import Init InvImage.wf)
(fn digits ((n Int)) Nat (measure (Int.natAbs n))
  (if (< n 10) 1 (+ 1 (digits (Int.ediv n 10)))))
