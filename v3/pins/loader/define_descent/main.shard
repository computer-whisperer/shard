;; expect: main.count runnable realize_descent
;; a structural clause that is not one — the recursive call passes `b`, no part of `a` — gives
;; no definition: the function keeps its program, with the reason
(use Init.List cons nil)
(fn count ((a (List Nat)) (b (List Nat))) Nat
  (measure (struct a))
  (match a
    (nil 0)
    ((cons _ r) (count b r))))
