;; expect: read-error above_horizon
;; a name above the horizon inside a by block: the step's refusal wraps the name (`step 1:
;; NAME — the goal: …`), and the loader still finds it among the names the table places
;; above the module's horizon — Nat.max_self is declaration 34,717, the import reaches 23,369.
(import Init Nat.zero_and)
(theorem max_self ((n Nat)) (= (max n n) n) (by (apply Nat.max_self)))
