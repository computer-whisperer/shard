;; expect: main.f refused nested_recursion
;; a recursive call whose argument is computed by the recursion — here through a let bound to
;; a recursive call — has no obligation that could be stated before the function is defined:
;; refused by name, with the let it cites
(import Init UInt8.toNat)
(fn f ((n Nat)) Nat (measure n) (if (= n 0) 0 (let ((r (f (- n 1)))) (f (- n (+ r 1))))))
