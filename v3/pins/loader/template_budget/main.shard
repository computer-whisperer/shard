;; expect: main.c refused specialization_budget
;; §8.4 slice 3.28 rule 4 (landing 3): instance_budget instances of one template per load — 1,024,
;; or the driver's --instance-budget N — past which a demand is refused naming the template, under
;; the taker's name: a refusal, never a proof of anything (law §4.3). The harness loads this case
;; at a budget of 2 (loader_pins_test.shard's case_budget), so the third shape of `twice` is
;; refused under `c`, the body that demanded it; `a` and `b` took theirs.
(import Init Int.add)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(fn a ((x Int)) Int (twice (fun ((y Int)) (+ y 1)) x))
(fn b ((x Int)) Int (twice (fun ((y Int)) (+ y 2)) x))
(fn c ((x Int)) Int (twice (fun ((y Int)) (+ y 3)) x))
