;; expect: ok
;; §8.4 slice 3.24 rule 1: `(dif h C T F)` — the dependent if, its hypothesis named: `h : C` in the
;; then-branch, `h : ¬C` in the else, the term `dite C dec (λ h. T) (λ h. F)`; the proof used in a
;; `Fin.mk` field (T1's branch-local proof), erased at E (`Fin.mk i h` runs as `i`); a Bool condition
;; as `C = true`; the hypothesis in a theorem's position in each branch
(import Init dif_pos)
(fn clamp ((n Nat) (i Nat)) (Option (Fin n))
  (dif h (< i n) (Option.some (Fin.mk i h)) Option.none))
(fn flag ((b Bool)) Nat (dif h b 1 0))
(theorem clamp_lt ((n Nat) (i Nat) (h (< i n))) (= (clamp n i) (Option.some (Fin.mk i h)))
  (by (unfold clamp) (rw (dif_pos h)) rfl))
(theorem clamp_ge ((n Nat) (i Nat) (h (Not (< i n)))) (= (clamp n i) Option.none)
  (by (unfold clamp) (rw (dif_neg h)) rfl))
