;; expect: ok
;; §8.4 slice 3.21 rule 6: simp_only rewrites to a fixpoint over its rules — the first rule in
;; list order with a match is applied as rw applies it. A rule's premises are discharged by
;; assumption: `if_neg` applies at the condition the context negates (h2) and not at the other
;; (s2: the two rules meet the two `ite`s by their premises); a hypothesis is a rule (s3), and
;; `(<- h)` is it reversed (s4); a quantified rule applies at each instance in turn (s5).
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(use Init.Bool)
(fn f ((c Int)) Int (if (= c 43) 1 (if (= c 45) 2 3)))
(fn g ((x Int)) Int (- (+ x 1) 1))
(theorem g_id ((x Int)) (= (g x) x) (by (unfold g) arith))
(theorem s1 ((c Int) (h2 (Not (= c 43))) (h3 (= c 45))) (= (f c) 2)
  (by (unfold f) (simp_only (if_neg h2) (if_pos h3)) rfl))
(theorem s2 ((c Int) (h2 (Not (= c 43))) (h3 (= c 45))) (= (f c) 2)
  (by (unfold f) (simp_only if_neg if_pos) rfl))
(theorem s3 ((a Int) (b Int) (h (= a b))) (= (+ a a) (+ b b)) (by (simp_only h) rfl))
(theorem s4 ((a Int) (b Int) (h (= a b))) (= (+ a a) (+ b b)) (by (simp_only (<- h)) rfl))
(theorem s5 ((a Int) (b Int)) (= (+ (g a) (g b)) (+ a b)) (by (simp_only g_id) rfl))
