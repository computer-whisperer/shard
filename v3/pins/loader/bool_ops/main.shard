;; expect: ok
;; the operator spellings `and`, `or`, `not` on Bools are Init's Bool.and, Bool.or, Bool.not — Lean
;; 4.33's names (the export has no constant `and`, `or` or `not`). Their programs are the registry's
;; Bool rows, the `if` their definitions are: (if a b false), (if a false true). Every row of both
;; by Eq.refl (Bool.or is at line 182,994 of the export, past this file's import: derive_test.sh
;; runs all three, every row, on the host)
(import Init Int.decEq)
(fn both ((a Bool) (b Bool)) Bool (and a b))
(fn flip ((a Bool)) Bool (not a))
(def both_def ((a Bool) (b Bool)) Bool (and a (not b)))
(theorem both_tt () (= (both Bool.true Bool.true) Bool.true) (exact (Eq.refl Bool.true)))
(theorem both_tf () (= (both Bool.true Bool.false) Bool.false) (exact (Eq.refl Bool.false)))
(theorem both_ft () (= (both Bool.false Bool.true) Bool.false) (exact (Eq.refl Bool.false)))
(theorem both_ff () (= (both Bool.false Bool.false) Bool.false) (exact (Eq.refl Bool.false)))
(theorem flip_t () (= (flip Bool.true) Bool.false) (exact (Eq.refl Bool.false)))
(theorem flip_f () (= (flip Bool.false) Bool.true) (exact (Eq.refl Bool.true)))
