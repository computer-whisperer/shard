;; expect: ok
;; slice 3.16 rule 5: a bare name that is ambiguous is the constructor of the expected type's
;; inductive — `Add` is main.Exp.Add at an expected Exp (Init's class Add is the other
;; candidate), as an argument, as a value and in a statement alike
(import Init Int.decEq)
(type Exp (Num Int) (Add Exp Exp))
(def two () Exp (Add (Num 1) (Num 1)))
(def wrap ((e Exp)) Exp (Add e e))
(theorem wrap_two () (= (wrap (two)) (Add (two) (two))) (exact (Eq.refl (Add (two) (two)))))
