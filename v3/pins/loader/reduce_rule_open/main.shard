;; expect: read-error reduce_rule_open
;; §8.4, the run with its facts: nothing is looked for. A rule with an argument its left side
;; does not fix — here if_pos without its premise — is refused before the run; the author gives
;; the premise, (if_pos h)
(import Init WellFounded.fix_eq)
(type T (A Nat))
(fn f ((t T) (y Nat)) Nat (match t ((A n) (+ n y))))
(theorem t ((a Nat) (h (< a 5)))
  (= (f (A 2) (if (< a 5) 3 4)) 5)
  (by (reduce lhs (using if_pos)) rfl))
