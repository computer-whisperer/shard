;; expect: read-error reduce_rule_unused
;; §8.4, the run with its facts: a rule that rewrote nothing is refused at the run's end — the
;; list is what the run used, no more. Here the second fact's left side, (+ b 0), never stands
;; in the run
(import Init WellFounded.fix_eq)
(type T (A Nat))
(fn f ((t T) (y Nat)) Nat (match t ((A n) (+ n y))))
(theorem t ((a Nat) (b Nat) (k Nat) (h (= (f (A 1) a) k)) (hz (= (+ b 0) b)))
  (= (f (A 1) a) k)
  (by (reduce lhs (using h hz)) rfl))
