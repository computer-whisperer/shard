;; expect: main.hello bin ok
;; §8.6 slice 4.3 landing 1 (rule 4): the bin form — the entry a fn with the World last, the
;; roster the extern it calls, the trusts the bolt axiom its requirement rests on, the
;; requirement an accepted theorem over the entry's observable. `w_output` is an opaque constant
;; over the World (never unfolded: its value is a typing witness); the bolt an axiom the file
;; trusts, PARAM; the requirement proven through main's equation and the bolt. The record:
;; BIN main.hello entry main.main externs 1 trusts 1 requires 1/1
(import Init String.toByteArray)
(trusts write_line_output)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(opaque w_output ((w World)) (List ByteArray) List.nil)
(axiom write_line_output ((bs ByteArray) (w World)) (= (w_output (write_line bs w)) (List.append (w_output w) (List.cons bs List.nil))))
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World (write_line (text "hello") w))
(theorem main_output ((w World)) (= (w_output (main w)) (List.append (w_output w) (List.cons (text "hello") List.nil)))
  (by (rw main.eq_1) (rw write_line_output) rfl))
(bin hello (entry main) (externs write_line) (trusts write_line_output) (requires main_output))
