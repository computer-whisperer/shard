;; expect: load-error late_init_import
;; a file whose leading directives import no Init is read as one that sees none: an
;; `(import Init …)` after its first declaration would give it a horizon nothing was fetched
;; for, and is refused
(type Color (Red) (Green))
(fn pick ((c Color)) Color c)
(import Init Int.decEq)
(theorem t () (Eq Int Int) (exact (Eq.refl Int)))
