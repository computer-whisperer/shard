;; expect: load-error late_init_import
;; a file whose leading directives import no Init is read as one that sees none — its types get
;; no noConfusion, its functions no equations. An `(import Init)` after its first declaration
;; would change what the declarations before it mean, and is refused with where to write it
(type Color (Red) (Green))
(fn pick ((c Color)) Color c)
(import Init)
(theorem t () (Eq Int Int) (exact (Eq.refl Int)))
