;; expect: main.grow refused realize_descent
;; a template calling itself at a type built from its own type parameter — f[A] recursing at
;; f[List A] — is refused at its declaration, where the self-call's type arguments are read: the
;; shape set would grow without bound. A refusal before any instance is built, which is what
;; the budget and this check are — totality is not compiler termination.
(import Init Nat.sub)
(fn idl ((a Type) (xs (List a))) (List a) xs)
(fn grow ((a Type) (f (-> a a)) (x a) (n Nat)) Nat
  (measure n)
  (if (= n 0) 0 (grow idl (List.cons x List.nil) (- n 1))))
