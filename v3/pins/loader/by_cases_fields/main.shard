;; expect: read-error induction_fields
;; §8.4 slice 3.20 rule 4: an arm names every binder of its constructor's case — the fields
;; and, under induction, the hypotheses after them; the refusal lists the binders
(import Init InvImage.wf)
(theorem t ((xs (List Nat))) (= xs xs) (by (induction xs ((nil () rfl) (cons (x r) rfl)))))
