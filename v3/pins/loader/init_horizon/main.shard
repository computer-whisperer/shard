;; expect: ok
;; a module sees the export through its own `(import Init NAME)` and its imports' horizons, the
;; farthest of them, whatever else the load admitted. wide.shard imports through
;; Bool.decide_eq_true and is loaded first; small.shard imports through Int.decEq, opens
;; Init.Bool and cites decide_eq_true — unambiguous, since Bool.decide_eq_true lies past its
;; horizon whatever an earlier file imported: a module's meaning does not depend on the load's
;; order.
(import "wide.shard")
(import "small.shard")
(use wide)
(def m () Nat wide_marker)
