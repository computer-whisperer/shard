;; expect: ok
;; slice 3.15: a native inductive's constructor-structure bundle, generated after its admission in
;; Lean's shapes — T.casesOn, T.noConfusionType, T.noConfusion, T.c.inj — cited by theorems:
;; distinct constructors are unequal, a constructor is injective, casesOn computes
(import Init Int.decEq)
(type Color (red) (green))
(type Tree (Leaf) (Node Tree Tree))
(theorem red_ne_green () (-> (= Color.red Color.green) False) (exact (fun ((h (= Color.red Color.green))) (Color.noConfusion h))))
(theorem node_inj ((a Tree) (b Tree) (c Tree) (d Tree)) (-> (= (Tree.Node a b) (Tree.Node c d)) (and (= a c) (= b d)))
  (exact (fun ((h (= (Tree.Node a b) (Tree.Node c d)))) (Tree.Node.inj h))))
(theorem leaf_ne_node ((a Tree) (b Tree)) (-> (= Tree.Leaf (Tree.Node a b)) False) (exact (fun ((h (= Tree.Leaf (Tree.Node a b)))) (Tree.noConfusion h))))
(def is_leaf ((t Tree)) Bool (Tree.casesOn t Bool.true (fun ((l Tree) (r Tree)) Bool.false)))
(theorem is_leaf_leaf () (= (is_leaf Tree.Leaf) Bool.true) (exact (Eq.refl Bool.true)))
