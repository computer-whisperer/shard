;; expect: ok
;; §8.6 slice 4.6 rule 1, the checked door's stated limit (kernel/test/handle_test.shard): what
;; the erasure dropped beside a type's value arguments is not in the program a handle is
;; prepared from — `small`'s evidence binder, `Span`'s proposition field. Both prepare as
;; checked entries, and each takes a value its L type excludes
(import Init Nat.sub)
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(fn width ((s Span)) Nat (Nat.sub (Span.hi s) (Span.lo s)))
(fn small ((n Nat) (h (Nat.lt n 10))) Nat n)
