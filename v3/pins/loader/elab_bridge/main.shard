;; expect: ok
;; slice 3.16 rules 3, 11 and the operator rule: a proposition where a Bool is expected is
;; decide with the decision of its head; `if` on a Bool is `ite (c = true)` (Lean's
;; elaboration; slice 3.15's cond reversed), on a two-constructor type of the program's the
;; match it abbreviates; an operator whose first operand is a numeral takes its identity from
;; the other operand's type (`(le 48 c)` at c's Int); `(list …)` is the constructor chain of the
;; expected type's list; a body's let binding takes its term's type
(import Init Int.decEq)
(use Init.Bool)
(use Init.List)
(type Dec (No) (Yes))
(def is_digit ((c Int)) Bool (if (le 48 c) (le c 57) false))
(def digit_val ((c Int)) Int (- c 48))
(def flip ((d Dec)) Dec (if d No Yes))
(def three () (List Nat) (list 1 2 3))
(def twice_plus ((n Nat)) Nat (let ((m (+ n n))) (+ m 1)))
(theorem is_digit_5 () (= (is_digit 53) true) (exact (Eq.refl true)))
(theorem is_digit_a () (= (is_digit 97) false) (exact (Eq.refl false)))
(theorem digit_val_5 () (= (digit_val 53) 5) (exact (Eq.refl (digit_val 53))))
(theorem flip_no () (= (flip No) Yes) (exact (Eq.refl Yes)))
(theorem three_is () (= (three) (cons 1 (cons 2 (cons 3 nil)))) (exact (Eq.refl (three))))
(theorem twice_plus_2 () (= (twice_plus 2) 5) (exact (Eq.refl 5)))
