;; expect: main.ax param axiom
;; (trusts ax) widens this file's policy: the axiom is admitted as a declared parameter (PARAM
;; main.ax axiom) and what rests on it is accepted, the axiom listed on its record
(trusts ax)
(def two () Nat 2)
(axiom ax () (Eq two two))
(theorem t () (Eq two two) (exact ax))
