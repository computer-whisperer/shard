;; expect: main.ax param axiom
;; (trusts ax) widens this file's policy: the axiom is admitted as a declared parameter (PARAM main.ax axiom;
;; slice 4.2 landing 2 — the store's manifest lists it, the release gate verifies what rests on it as
;; conditional on it) and what rests on it is accepted
(trusts ax)
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (x α)) (-> α Prop) (refl (Eq x x)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(axiom ax () (Eq two two))
(theorem t () (Eq two two) (exact ax))
