;; §8.4 slice 3.16 rule 4 (reversing slice 3.13's nat_operator refusal): `-` at Nat resolves to
;; Nat.sub once, in the elaborator, and the program is the erasure — the Nat.sub entry, which
;; truncates as K's does; the E-first reading of the spelling is gone from a typed fn
(import Init Int.decEq)
(fn pred ((n Nat)) Nat (- n 1))
