;; expect: ok
;; §8.4 slice 3.20 rule 4 (`wf`) and the measured equations: a function under `(measure n)`
;; has its equation `count_down.eq_1 : count_down n = ite (n = 0) 0 (count_down (n - 1))`,
;; proven by Lean's `WellFounded.fix_eq` at the instance (define.shard; the descent
;; obligation stays pending, named in the records). The theorem is by well-founded induction
;; on n: `wf` opens the strong hypothesis `ih : ∀ y, y < n → count_down y = 0`; `unfold`
;; applies the unfolding equation once; `cases` on the decision gives each branch its
;; hypothesis; `rw` by if_neg and if_pos; the hypothesis at n - 1 with Init's descent fact.
(import Init WellFounded.fix_eq)
(fn count_down ((n Nat)) Nat
  (measure n)
  (if (= n 0) 0 (count_down (- n 1))))
(theorem cd ((n Nat)) (= (count_down n) 0)
  (by (wf n n ih
        (unfold count_down)
        (cases (Nat.decEq n 0)
          ((isFalse (h) (rw (if_neg h)) (exact (ih (- n 1) (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
           (isTrue (h) (rw (if_pos h)) rfl))))))
;; the descent obligation discharged by a block too: the fact is n - 1 < n under n ≠ 0, stated
;; by the loader as the relation's instance, which K converts to Nat.lt
(fulfills count_down.dec_1 (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
