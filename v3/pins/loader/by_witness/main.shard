;; expect: ok
;; §8.4 slice 3.22 rule 4: a premise whose statement mentions an argument the target does not
;; determine (Eq.trans's middle term) is a witness goal — closed over the context as a goal is,
;; assigned by the first premise's exact through pattern unification, so the second premise's
;; goal reads b = c when its block opens. Until 3.22 this was apply_unsolved with a pointer.
(import Init InvImage.wf)
(theorem t ((a Nat) (b Nat) (c Nat) (h1 (= a b)) (h2 (= b c))) (= a c)
  (by (apply Eq.trans (exact h1) (exact h2))))
(theorem t_int ((x Int) (y Int) (z Int) (h1 (= x y)) (h2 (= y z))) (= x z)
  (by (apply Eq.trans ((exact h1)) ((exact h2)))))
