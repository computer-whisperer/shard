;; expect: ok
;; an obligation delegated with `auto` is discharged from the sidecar as a theorem is: the
;; file's only `auto` stands in a `fulfills`, the entry bears the obligation's name as the
;; source writes it (`dn.dec_1`), and its block is replayed against the obligation's statement
(import Init UInt8.toNat)
(fn dn ((n Nat) (m Nat)) Nat (measure n) (if (< m n) (dn m m) 0))
(fulfills dn.dec_1 auto)
(theorem dn_zero ((m Nat)) (= (dn 0 m) 0) (by (rw dn.eq_1) rfl))
