;; expect: ok
;; a fn with an obstacle to L meaning stays RUNNABLE with the obstacle named — a Symbol binder or
;; a Symbol result (E only), an Int-valued measure. The fns over Nat beside them are defined:
;; `succ`, `is_zero` (numeral rows) and `later` (a call to an extern, an opaque constant in L)
(import Init Int.decEq)
(fn tag ((s Symbol)) Symbol s)
(fn tagged ((n Nat)) Symbol (tag (quote x)))
(extern read_byte ((n Nat)) Nat)
(fn later ((n Nat)) Nat (read_byte n))
(fn down ((n Int)) Int (measure n) (if (< 0 n) (down (- n 1)) 0))
(fn is_zero ((n Nat)) Nat
  (match n
    (0 1)
    (_ 0)))
(fn succ ((n Nat)) Nat (+ n 1))
