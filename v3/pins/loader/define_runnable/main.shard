;; expect: ok
;; §8.4 rule 1: a fn with an obstacle to L meaning stays RUNNABLE with the obstacle named — a
;; Symbol binder (E only), a call to such a fn, an extern, an Int-valued measure (slice 3.14), a
;; numeral pattern; a fn over Nat beside them is defined
(import Init Int.decEq)
(fn tag ((s Symbol)) Symbol s)
(fn tagged ((n Nat)) Symbol (tag (quote x)))
(extern read_byte ((n Nat)) Nat)
(fn later ((n Nat)) Nat (read_byte n))
(fn down ((n Int)) Int (measure n) (if (lt 0 n) (down (- n 1)) 0))
(fn is_zero ((n Nat)) Nat (match n (0 1) (_ 0)))
(fn succ ((n Nat)) Nat (+ n 1))
