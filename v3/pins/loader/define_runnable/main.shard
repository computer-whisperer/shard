;; expect: ok
;; a fn with an obstacle to L meaning stays RUNNABLE with the obstacle named — a bare bit
;; primitive in its body, a call of such a function, an Int-valued measure. The fns over Nat
;; beside them are defined: `succ`, `is_zero` (numeral rows) and `later` (a call to an extern,
;; an opaque constant in L)
(fn low ((n Int)) Int (band n 1))
(fn lowest ((n Int)) Int (low (low n)))
(extern read_byte ((n Nat)) Nat)
(fn later ((n Nat)) Nat (read_byte n))
(fn down ((n Int)) Int (measure n) (if (< 0 n) (down (- n 1)) 0))
(fn is_zero ((n Nat)) Nat
  (match n
    (0 1)
    (_ 0)))
(fn succ ((n Nat)) Nat (+ n 1))
