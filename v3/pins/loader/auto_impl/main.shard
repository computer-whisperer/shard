;; roots: main.shard lib
;; `auto` inside the implementation of a view: a requirement's `fulfills`, a theorem of the
;; implementation and an obligation of one of its measured functions are each replayed from
;; the sidecar beside the implementation file, lib/lib.auto.shard, under the name the source
;; writes
(import "lib")
(use lib)
(fn twice_pick ((n Nat)) Nat (pick (pick n)))
