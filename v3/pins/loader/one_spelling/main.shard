;; expect: ok
;; §8.4 slice 3.27 rule 2: a lemma Init states through a class method under its instance
;; (`0 &&& b = 0` is HAnd.hAnd Nat Nat Nat (instHAndOfAndOp Nat Nat.instAndOp) 0 b) applies to
;; V3's spelling (Nat.land 0 b): the unifier reads the method as its function before K's whnf
;; — which would compute Nat.land 0 b to 0 and leave the lemma's argument open (the probe's
;; witness_open). apply, rw and simp_only across the two spellings, at the bitwise operators
;; and at List.append.
(import Init Nat.zero_and)
(theorem zero_land ((b Nat)) (= (Nat.land 0 b) 0) (by (apply Nat.zero_and)))
(theorem land_rw ((b Nat)) (= (+ (Nat.land 0 b) 1) 1) (by (rw Nat.zero_and) rfl))
(theorem land_simp ((b Nat)) (= (+ (Nat.land 0 b) (Nat.lor 0 b)) b) (by (simp_only Nat.zero_and Nat.zero_or) (arith)))
(theorem app_len ((xs (List Nat)) (ys (List Nat))) (= (List.length (List.append xs ys)) (+ (List.length xs) (List.length ys))) (by (apply List.length_append)))
(theorem app_nil ((xs (List Nat))) (= (List.append xs List.nil) xs) (by (apply List.append_nil)))
