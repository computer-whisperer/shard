;; expect: main.g.dec_1 refuses fulfills_cycle
;; §8.4 slice 3.16 rule 8 (GPT-6 R69; fixture G7): a two-obligation cycle. f.dec_1 proved from
;; g.dec_1 is a discharge whose account keeps g.dec_1 (every dependent of f now rests on it);
;; g.dec_1 proved from f.dec_1 would rest, through that account, on itself — refused, and the
;; first discharge stands as it was
(import Init InvImage.wf)
(fn f ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (f (Nat.sub n 1) (+ acc 1))))
(fn g ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (g (Nat.sub n 1) (+ acc 1))))
(fulfills f.dec_1 (exact g.dec_1))
(fulfills g.dec_1 (exact f.dec_1))
