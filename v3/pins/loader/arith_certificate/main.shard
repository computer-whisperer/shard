;; expect: read-error arith_certificate
;; §8.4 slice 3.21 rule 1: a certificate is checked, never repaired — the weights 1 and 2 leave
;; a coefficient of x, and the refusal shows the rows the weights are over
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((x Int) (h (<= 0 x))) (<= 48 (+ 48 x)) (by (arith (farkas 1 2))))
