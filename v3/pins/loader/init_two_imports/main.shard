;; expect: read-error above_horizon
;; several `(import Init …)` lines: the farthest sets the horizon, whatever their order, and it
;; is the one the INIT record and the refusal name — here the first line, not the last
(import Init WellFounded.fix_eq)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((n Nat) (h (Not (= n 0)))) (< (- n 1) n) (exact (Nat.sub_one_lt h)))
