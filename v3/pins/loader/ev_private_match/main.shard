;; expect: main.peek refused private_match
;; the private-equality leak (§6.5): a value of the view's sig type matched against a constructor — here the implementation's, reached by importing its file directly (§6.3 item 5)
(import Init Nat)
(import "lib")
(import "lib/lib.shard")
(fn peek ((s lib.Stack)) Nat (match s ((lib.lib.Stack.mk k) k)))
