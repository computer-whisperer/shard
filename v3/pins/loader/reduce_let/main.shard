;; expect: ok
;; `reduce` opens a `let` whose body cannot finish reducing. Under this one a `match` waits on
;; the variable, and in the row it takes stands an `if` on an open condition: K's whnf of the
;; `let` runs on through the row into that `if`, a stuck eliminator, which reads as no progress.
;; The step is then taken by hand, the body at the value, and the case steps under it go on.
;; Left standing, the `let` holds every step below it: the `rw` here finds no `if` to rewrite
;; (`rw_no_match`)
(fn pick ((x Nat) (xs (List Nat))) Nat
  (let ((ys (List.cons x xs)))
    (match ys
      (List.nil 0)
      ((List.cons y r) (if (= y 0) 7 y)))))
(theorem pick_pos ((x Nat) (xs (List Nat)) (h (Not (= x 0)))) (= (pick x xs) x)
  (by (unfold pick) (reduce) (rw (if_neg h)) rfl))
