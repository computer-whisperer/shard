;; expect: ok
;; §8.4 slice 3.16 (GPT-6 R63, R66, R70; fixture G1): one source meaning. The same scoped
;; expression — numerals, the constructor `Add` beside Init's class of that name, a nested
;; match with a fall-through row, `-` at Nat (Nat.sub, truncating) and at Int — as a fn's body
;; and as a def's value is one L term: `sem_same` proves the two equal by Eq.refl with nothing
;; unfolded by hand, and the instances compute in K as the fn's program computes under ev
;; (2 + (5 - 1) = 6; at n = 0 the Nat difference is 0, so 2)
(import Init Int.decEq)
(type Exp (Num Int) (Add Exp Exp))
(fn sem ((e Exp) (n Nat) (i Int)) Int
  (match e ((Num k) (- i k)) ((Add (Num a) _) (+ a (- n 1))) ((Add _ _) 0)))
(def sem_d ((e Exp) (n Nat) (i Int)) Int
  (match e ((Num k) (- i k)) ((Add (Num a) _) (+ a (- n 1))) ((Add _ _) 0)))
(theorem sem_same ((e Exp) (n Nat) (i Int)) (= (sem e n i) (sem_d e n i)) (exact (Eq.refl (sem e n i))))
(theorem sem_at () (= (sem (Add (Num 2) (Num 3)) 5 7) 6) (exact (Eq.refl (sem (Add (Num 2) (Num 3)) 5 7))))
(theorem sem_trunc () (= (sem (Add (Num 2) (Num 3)) 0 7) 2) (exact (Eq.refl (sem (Add (Num 2) (Num 3)) 0 7))))
(theorem sem_int () (= (sem (Num 9) 0 7) (Int.negSucc 1)) (exact (Eq.refl (sem (Num 9) 0 7))))   ; 7 - 9 at Int is -2: Int.sub, not the truncating difference
