;; expect: ok
;; §8.7 slice 5.2 rule 6: the size of a plain type and of Init's list at a closed argument;
;; `depth` — one function, no group — is measured by the derived size and calls itself on a
;; value another function computed, its obligation closed through the lemma that `strip`
;; returns no more than it was given. Its program runs though its measure has none
;; (derive_test.sh runs `main`: exit 3, as K's `depth` is 2)
(import Init UInt8.toNat)
(use Init.Bool)
(use Init.List)
(type World (World Nat))
(extern exit ((code Int) (w World)) World)
(type Exp (Num Nat) (Add Exp Exp) (Neg Exp))
(derive Exp size)
(derive (List Nat) size)
(fn strip ((e Exp)) Exp
  (match e
    ((Neg x) x)
    (_ e)))
(theorem strip_le ((e Exp)) (<= (Exp.size (strip e)) (Exp.size e))
  (by
    (cases e
      ((Num (n) (rw strip.eq_1) (arith))
       (Add (a b) (rw strip.eq_2) (arith))
       (Neg (x) (rw strip.eq_3) (rw Exp.size.eq_3) (arith))))))
(fn depth ((e Exp)) Nat
  (measure (Exp.size e))
  (match e
    ((Num _) 0)
    ((Add a b) (+ 1 (+ (depth (strip a)) (depth b))))
    ((Neg x) (depth x))))
(fulfills depth.dec_1 (by (intro e a b h) (rw h) (rw Exp.size.eq_2) (arith (strip_le a))))
(fulfills depth.dec_2 (by (intro e a b h) (rw h) (rw Exp.size.eq_2) (arith)))
(fulfills depth.dec_3 (by (intro e x h) (rw h) (rw Exp.size.eq_3) (arith)))
(theorem list_size () (= (List_Nat.size (cons 4 (cons 5 nil))) 3) (by rfl))
(fn main ((w World)) World
  (exit (if (= (depth (Add (Neg (Num 1)) (Add (Num 2) (Num 3)))) 2) 3 4) w))
