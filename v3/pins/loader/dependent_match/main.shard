;; expect: ok
;; §8.4 slice 3.27 rule 7, landing 3: a match generalizes the locals whose types mention the
;; scrutinee (Lean's revert), so a row sees them at its pattern's type. Three consumers: a fn
;; whose Fin index is bounded by the scrutinee's length (its equations stated under the row's
;; index, its leaf binders ordered after the fields they name); a term-level match on a Fin's
;; value under its bound; and List.get realized — the nil row refuted by Init's absurd, which
;; erases to the refuted row (stuck if ever reached), the cons row under dif with the bound
;; carried into the tail. A realize's binders are E types: the Fin is `Fin`, the registry's row.
(import Init Nat.sub_lt_right_of_lt_add)
(fn head_or ((xs (List Nat)) (i (Fin (List.length xs))) (d Nat)) Nat
  (match xs (List.nil d) ((List.cons x t) (+ x (Fin.val i)))))
(theorem head_or_cons ((x Nat) (t (List Nat)) (i (Fin (List.length (List.cons x t)))) (d Nat)) (= (head_or (List.cons x t) i d) (+ x (Fin.val i)))
  (by (unfold head_or) rfl))
(theorem fin_zero_or ((n Nat) (i (Fin (+ n 1)))) (or (= (Fin.val i) 0) (< 0 (Fin.val i)))
  (exact (match i ((Fin.mk v hv) (match v (Nat.zero (Or.inl (Eq.refl 0))) ((Nat.succ j) (Or.inr (Nat.zero_lt_succ j))))))))
(theorem get_bound ((n Nat) (m Nat) (h1 (< n (+ m 1))) (h2 (Not (= n 0)))) (< (- n 1) m)
  (exact (Nat.sub_lt_right_of_lt_add (Nat.pos_of_ne_zero h2) h1)))
(theorem get_nil_eq ((a Type) (i (Fin (List.length (@List.nil a))))) (= (List.get List.nil i) (absurd (Fin.isLt i) (Nat.not_lt_zero (Fin.val i))))
  (exact (absurd (Fin.isLt i) (Nat.not_lt_zero (Fin.val i)))))
(theorem get_cons_eq ((a Type) (x a) (t (List a)) (i (Fin (List.length (List.cons x t)))))
  (= (List.get (List.cons x t) i) (dif h (= (Fin.val i) 0) x (List.get t (Fin.mk (- (Fin.val i) 1) (get_bound (Fin.val i) (List.length t) (Fin.isLt i) h)))))
  (exact (match i ((Fin.mk v hv) (match v (Nat.zero (Eq.refl x)) ((Nat.succ j) (Eq.refl (List.get t (Fin.mk j (Nat.le_of_succ_le_succ hv))))))))))
(realize List.get ((a Type) (xs (List a)) (i Fin)) a (measure (struct xs))
  (match xs
    (List.nil (absurd (Fin.isLt i) (Nat.not_lt_zero (Fin.val i))))
    ((List.cons x t) (dif h (= (Fin.val i) 0) x (List.get t (Fin.mk (- (Fin.val i) 1) (get_bound (Fin.val i) (List.length t) (Fin.isLt i) h))))))
  (equations get_nil_eq get_cons_eq))
(theorem one_lt_two () (< 1 (List.length (List.cons 5 (List.cons 7 List.nil)))) (by (decide)))
(fn get_demo () Nat (List.get (List.cons 5 (List.cons 7 List.nil)) (@Fin.mk (List.length (List.cons 5 (List.cons 7 List.nil))) 1 one_lt_two)))
