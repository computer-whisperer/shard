;; expect: read-error apply_unsolved
;; §8.4 slice 3.20 rule 4: a premise whose statement mentions an argument the target does not
;; determine (Eq.trans's middle term) is a witness goal — the graph's, after 3.20; the pointer
;; says to give it through the first premise
(import Init InvImage.wf)
(theorem t ((a Nat) (b Nat) (c Nat) (h1 (= a b)) (h2 (= b c))) (= a c)
  (by (apply Eq.trans (exact h1) (exact h2))))
