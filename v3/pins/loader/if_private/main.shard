;; expect: main.pick refused private_if
;; an `if` on a value of the view's sig type: the second-constructor observation is the type's
;; to export, not the cell's to leak — the implementation's constructor order would decide the
;; branch at run time
(import Init Nat)
(import "lib")
(fn pick ((h lib.Handle)) Nat (if h 1 0))
