;; expect: main.pick refused private_if
;; an `if` on a value of the view's sig type (§6.2; GPT-6 R56): the second-constructor observation is the
;; type's to export, not the cell's to leak — before slice 10 this was RUNNABLE and the implementation's
;; constructor order decided the branch at run time
(import Init Nat)
(import "lib")
(fn pick ((h lib.Handle)) Nat (if h 1 0))
