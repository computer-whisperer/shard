;; expect: ok
;; §8.4 slice 3.27 landing 2: an equation whose two sides have the same linear combination
;; over the atoms, the combinations' coefficient lists of different lengths — a bare variable
;; against a sum whose atoms were collected after it. The two evaluations are one term only
;; when the lists are the same entry for entry; otherwise the equation is proved as two
;; inequalities. Before the fix K refused the first four (app_type_mismatch): the evaluation of
;; `[1]` against `[1, 0]` is stuck at `0 * x`.
(import Init Int.lt_mul_ediv_self_add)   ; the quotient's bounds and Omega's product lemma, as the arith_div pin
(theorem a1 ((n Int)) (= n (+ (* 10 (/ n 10)) (% n 10))) (by (arith)))
(theorem a3 ((b Int) (y Int)) (= (- (- (+ (+ b 1) y) 1) y) b) (by (arith)))
(theorem a4 ((b Int) (y Int)) (= b (- (- (+ (+ b 1) y) 1) y)) (by (arith)))
(theorem a6 ((b Int) (y Int)) (= (- (+ b y) y) b) (by (arith)))
(theorem a2 ((n Int)) (= (+ (* 10 (/ n 10)) (% n 10)) n) (by (arith)))
(theorem a5 ((b Int) (y Int)) (= (- (+ (+ b 1) y) 1) (+ b y)) (by (arith)))
