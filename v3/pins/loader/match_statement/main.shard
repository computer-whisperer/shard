;; expect: ok
;; slice 3.16 rule 1: a match in a statement is the same form — the theorem owns the matcher
;; (main.bit_spec.match_1); slice 3.15's "not in the slice" item closes. The match stands where
;; its type is known: after `(bit b)` has fixed Eq's implicit type
(import Init Int.decEq)
(use Init.Bool)
(def bit ((b Bool)) Nat (match b (false 0) (true 1)))
(theorem bit_spec ((b Bool)) (= (bit b) (match b (false 0) (true 1)))
  (exact (Bool.casesOn b (Eq.refl 0) (Eq.refl 1))))
