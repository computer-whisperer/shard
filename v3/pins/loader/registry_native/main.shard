;; expect: ok
;; §8.4 slice 3.19 (found by the second reader): a row of the realization registry speaks for
;; Init's constant, never for a native declaration that bears its name. The module `Bool`
;; declares `or` under a prefix that stops before Init's Bool.or (line 182,994): `f` calls
;; that function — K decides `f true true = false` — and its program is the call, not the
;; row's `(if a true b)` (define_test.sh reads the dump)
(import "Bool.shard")
(import Init Int.decEq)
(fn f ((a Bool) (b Bool)) Bool (Bool.or a b))
(theorem f_is_native () (= (f Bool.true Bool.true) Bool.false) (exact (Eq.refl Bool.false)))
