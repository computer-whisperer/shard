;; expect: Bool.or refused name_taken
;; Init's names are Init's. The module `Bool` declares `or`, the name of an Init constant, and
;; is refused by name wherever it loads, whether or not the load demanded Init's `Bool.or`
;; (define_test.sh loads it too). A row of the realization registry speaks for Init's constant,
;; never for a native declaration bearing its name: accepted, `f` would be the call of the
;; native `or` (K deciding `f true true = false`) where the row runs `(if a true b)`
(import "Bool.shard")
(import Init Int.decEq)
(fn f ((a Bool) (b Bool)) Bool (Bool.or a b))
(theorem f_is_native () (= (f Bool.true Bool.true) Bool.false) (exact (Eq.refl Bool.false)))
