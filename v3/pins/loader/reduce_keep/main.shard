;; expect: ok
;; (reduce SIDE? (keep NAME…) (using RULE…)?): a call of a kept function is a variable to the
;; run. No equation of the function is applied to it (twice_le: without the keep the two calls
;; of `step` unfold at the constructor and the hypothesis speaks of nothing left in the target),
;; a closed term it stands in is not computed (step_closed), a function over it is not run as a
;; ground computation (pick_kept), a case step at a discriminant it stands in waits (ite_kept);
;; in each of the three the plain `reduce` computes through the call and the rewrite after it
;; finds no instance. The rules of (using …) follow the kept names (both)
(fn step ((xs (List Nat))) Nat
  (match xs
    (List.nil 0)
    ((List.cons y r) (if (= y 0) 7 (+ y 1)))))
(fn twice ((xs (List Nat))) Nat
  (match xs
    (List.nil 0)
    ((List.cons y r) (+ (step (List.cons y r)) (step (List.cons y r))))))
(fn pick ((n Nat)) Nat (if (= n 0) 5 6))
(theorem twice_le ((y Nat) (r (List Nat)) (h (<= (step (List.cons y r)) 9)))
  (<= (twice (List.cons y r)) 18)
  (by (reduce (keep step)) (arith h)))
(theorem step_closed ((h (= (step (List.cons 1 List.nil)) 2)))
  (= (+ (step (List.cons 1 List.nil)) 1) 3)
  (by (reduce (keep step)) (rw h) rfl))
(theorem pick_kept ((h (= (step (List.cons 0 List.nil)) 7)))
  (= (pick (step (List.cons 0 List.nil))) 6)
  (by (reduce (keep step)) (rw h) (reduce) rfl))
(theorem ite_kept ((h (= (step (List.cons 0 List.nil)) 7)))
  (= (if (= (step (List.cons 0 List.nil)) 0) 5 6) 6)
  (by (reduce (keep step)) (rw h) (reduce) rfl))
(theorem both
  ((y Nat) (r (List Nat)) (a Nat) (b Nat) (hab (= a b)) (h (<= (step (List.cons y r)) 9)))
  (<= (+ (twice (List.cons y r)) a) (+ 18 b))
  (by (reduce (keep step) (using hab)) (arith h)))
