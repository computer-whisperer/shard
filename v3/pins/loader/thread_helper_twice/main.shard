;; expect: main.tap unthreaded world_twice
;; the duplication behind a helper boundary: the helper writes through the token it was given and
;; also returns it. Its own body is where the second use is, whatever its caller does — the
;; caller consumes the token by the helper's signature and gets one back
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn tap ((b ByteArray) (w World)) (Prod World World) (Prod.mk (write_line b w) w))
(fn main ((w World)) World
  (match (tap (String.toByteArray "a") w) ((Prod.mk w1 _) w1)))
