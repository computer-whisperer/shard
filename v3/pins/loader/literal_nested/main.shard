;; expect: main.g runnable no_l_identity
;; §8.4 slice 3.17 rule 3: a numeral under a constructor pattern has no L form (the matcher's
;; rows are constructor patterns) — the function falls to the E-first route whole, flagged; the
;; pointer is to bind the field and compare with an if
(import Init Int.decEq)
(fn g ((xs (List Int))) Int (match xs ((List.cons 43 r) 1) ((List.cons h r) h) (List.nil 0)))
