;; expect: ok
;; §8.7 slice 5.2 rules 1 to 3 and 5: two functions that call each other, each with its
;; measure, are one definition by well-founded recursion — the group's argument type
;; `main.ping.args`, the fixpoint `main.ping.mutual` with its unfolding theorem, each member the
;; fixpoint at its constructor, an equation per member, one obligation per call between members
;; named under the caller. The group is settled when `pong` is read: the `fulfills`, the caller
;; and the theorems below it cite both. Their programs run as written (define_test.sh runs
;; `main`: exit 3)
(import Init UInt8.toNat)
(use Init.Bool)
(type World (World Nat))
(extern exit ((code Int) (w World)) World)
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (pong (Nat.sub n 1))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 7 (ping (Nat.sub n 1))))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fn caller ((n Nat)) Nat (ping n))
(theorem ping_zero () (= (ping 0) 0) (by rfl))
(theorem caller_five () (= (caller 5) 7) (by rfl))
(theorem pong_unfolds ((n Nat)) (= (pong n) (if (= n 0) 7 (ping (Nat.sub n 1))))
  (by (rw pong.eq_1) rfl))
(fn main ((w World)) World (exit (if (= (ping 5) 7) 3 4) w))
