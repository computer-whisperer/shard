;; expect: ok
;; §8.4 slice 3.28 rules 1 and 3 (landing 1): a fn with a function-typed binder is a template
;; (TEMPLATE, no program of its own); a closed lambda as its static argument is lifted to
;; CALLER.lam_N with the captured local `off` its leading parameter (DEFINE main.add_off.lam_1);
;; the call takes the instance at the lifted lambda's shape — identity and captured count, never
;; the value — named main.main_twice.of.main_add_off_lam_1_1 (INSTANCE): its definition unfolds to
;; the template applied, so the theorem over the instance holds by Eq.refl, and its equation is
;; the template's instantiated. The recursive template `mapi` is instantiated the same way, its
;; self-call the same instance.
(import Init Int.add)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(fn add_off ((off Int) (x Int)) Int (twice (fun ((y Int)) (+ y off)) x))
(theorem add_off_unfolds ((off Int) (x Int)) (= (add_off off x) (twice (fun ((y Int)) (+ y off)) x)) (exact (Eq.refl (add_off off x))))
(fn mapi ((f (-> Int Int)) (xs (List Int))) (List Int) (measure (struct xs))
  (match xs (nil List.nil) ((cons x t) (List.cons (f x) (mapi f t)))))
(fn add_all ((off Int) (xs (List Int))) (List Int) (mapi (fun ((y Int)) (+ y off)) xs))
(theorem add_all_nil ((off Int)) (= (add_all off List.nil) List.nil) (by (unfold add_all) (unfold mapi) rfl))
