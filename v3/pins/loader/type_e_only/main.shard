;; expect: read-error unknown_constant
;; a type enters K with the types below it that it names, as far as they are read in the
;; scope it is read in: `Bar` stands below a `use`, so `Foo` is a program only by its field
;; (RUNNABLE type, why=e_only_type, never in K) — the `def` citing it is refused, since K
;; holds no such constant (type_in_logic and type_forward are the other half)
(type Foo (MkFoo Bar))
(use Init.Option none some)
(type Bar (MkBar))
(fn get ((x Foo)) Bar
  (match x
    ((MkFoo s) s)))
(def one () Foo (MkFoo MkBar))
