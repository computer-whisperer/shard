;; expect: read-error unknown_constant
;; `Symbol` has no constant in the logic, so `Foo` is E only by its field (RUNNABLE type, never
;; in K) — the `def` citing it is refused, since K holds no such constant (type_in_logic is the
;; other half)
(type Foo (MkFoo Symbol))
(fn get ((x Foo)) Symbol
  (match x
    ((MkFoo s) s)))
(def one () Foo (MkFoo (quote a)))
