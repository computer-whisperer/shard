;; expect: read-error unknown_constant
;; §13 item 35, the flip's first half: no Init in scope, so `Nat` is the built-in with no L
;; constant and `Foo` is E only by its field (RUNNABLE type, never in K) — the `def` citing
;; it is refused, since K holds no such constant
(type Foo (MkFoo Nat))
(fn get ((x Foo)) Nat (match x ((MkFoo n) n)))
(def one () Foo (MkFoo 1))
