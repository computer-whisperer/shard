;; expect: read-error unknown_constant
;; `Foo` names a type declared after it, so it is E only by its field (RUNNABLE type, never in
;; K) — the `def` citing it is refused, since K holds no such constant (type_in_logic is the
;; other half)
(type Foo (MkFoo Bar))
(type Bar (MkBar))
(fn get ((x Foo)) Bar
  (match x
    ((MkFoo s) s)))
(def one () Foo (MkFoo MkBar))
