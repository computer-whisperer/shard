;; expect: read-error unknown_constant
;; no Init in scope, so `Nat` is the built-in with no L constant and `Foo` is E only by its
;; field (RUNNABLE type, never in K) — the `def` citing it is refused, since K holds no such
;; constant (type_flip is the other half)
(type Foo (MkFoo Nat))
(fn get ((x Foo)) Nat
  (match x
    ((MkFoo n) n)))
(def one () Foo (MkFoo 1))
