(import "prelude.shard")
(use kernel.prelude)
(use kernel.prelude.List)
(fn len ((T Type) (xs (List T))) Int (measure (struct xs)) (match xs (Nil 0) ((Cons _ r) (+ 1 (len r)))))
(fn neg () Int -7)
(fn tag ((s Symbol)) Bool (sym_eq s (quote x)))
(fn hello () (List Int) "hi")
(fn two () (List Int) (list 1 2))
