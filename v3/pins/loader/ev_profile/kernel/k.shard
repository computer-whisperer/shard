(import "prelude.shard")
(fn len ((xs (List T))) Int (measure (struct xs)) (match xs (Nil 0) ((Cons _ r) (+ 1 (len r)))))
(fn neg () Int -7)
(fn tag ((s Symbol)) Bool (sym_eq s (quote x)))
(fn hello () (List Int) (append "hi" (list 33 -1)))
(fn append ((xs (List T)) (ys (List T))) (List T) (measure (struct xs)) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn pick ((a Int) (b Int)) (Option Int) (if (lt a b) (Some a) None))
(fn both ((a Int) (b Int)) (Pair Int Int) (let ((c (+ a b)) (d (* c 2))) (Pair c d)))
