;; expect: ok
;; a theorem whose proof is `auto` takes its block from the sidecar main.auto.shard beside the file
;; — (proof-for NAME (req S D P E) (by STEP…)), the key the resolved requirement's — and replays it
;; as a hand-written block; `(auto HINT…)` the same, the hints a producer's. The build never
;; searches.
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((x Int) (y Int) (h1 (<= 0 x)) (h2 (<= x y))) (<= 0 y) auto)
(theorem u ((n Nat)) (= (+ n 0) n) (auto (induct n)))
