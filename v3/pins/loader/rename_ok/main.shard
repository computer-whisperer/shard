;; expect: ok
;; §8.4 slice 3.17 rule 5: `< <= =` on both routes — the classifier's table entries (g, E-first
;; by its Symbol binder) and the decisions of the typed route (f)
(import Init Int.decEq)
(fn f ((a Int) (b Int)) Int (if (< a b) 1 (if (= a b) 2 (if (<= b a) 3 4))))
(fn g ((s Symbol) (a Int) (b Int)) Int (if (< a b) 1 (if (= a b) 2 (if (<= b a) 3 4))))
