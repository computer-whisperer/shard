;; expect: ok
;; `< <= =` on both routes — the classifier's table entries (g, E-first by the bare `band` it binds)
;; and the decisions of the typed route (f)
(fn f ((a Int) (b Int)) Int
  (if (< a b) 1
  (if (= a b) 2
  (if (<= b a) 3
  4))))
(fn g ((a Int) (b Int)) Int
  (let ((k (band a 1)))
    (if (< a b) 1
    (if (= a b) 2
    (if (<= b a) 3
    4)))))
