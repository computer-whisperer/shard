;; expect: ok
;; `< <= =` on both routes — the classifier's table entries (g, E-first by the match of a numeral
;; under a constructor it binds) and the decisions of the typed route (f)
(fn f ((a Int) (b Int)) Int
  (if (< a b) 1
  (if (= a b) 2
  (if (<= b a) 3
  4))))
(fn g ((a Int) (b Int)) Int
  (let
    ((k Nat
       (match (List.cons 1 List.nil)
         ((List.cons 1 _) 1)
         (_ 0))))
    (if (< a b) 1
    (if (= a b) 2
    (if (<= b a) 3
    4)))))
