;; expect: ok
;; §8.4 slice 3.28 rule 3(d): a static parameter passed on unchanged inside a template — `mapi2`
;; is a template too (TEMPLATE main.mapi2 static=g), its body's calls of `mapi` instantiated when
;; mapi2 is: the instance main.main_mapi2.of.main_inc_0 calls main.main_mapi.of.main_inc_0 twice.
(import Init Int.add)
(fn mapi ((f (-> Int Int)) (xs (List Int))) (List Int) (measure (struct xs))
  (match xs (nil List.nil) ((cons x t) (List.cons (f x) (mapi f t)))))
(fn mapi2 ((g (-> Int Int)) (xs (List Int))) (List Int) (mapi g (mapi g xs)))
(fn inc ((x Int)) Int (+ x 1))
(fn use2 ((xs (List Int))) (List Int) (mapi2 inc xs))
(theorem use2_unfolds ((xs (List Int))) (= (use2 xs) (mapi inc (mapi inc xs))) (exact (Eq.refl (use2 xs))))
