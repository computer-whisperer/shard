;; expect: ok
;; (arith only FACT… (farkas K…)?) — the rows are the goal and the facts named, nothing from the
;; context, so a certificate's positions survive a changed context: with_have has an unrelated have
;; before the step, under the same explicit certificate. The third theorem shows a context
;; hypothesis is no row under only: the fact must be named.
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem base ((x Int)) (-> (<= 0 x) (<= 48 (+ 48 x))) (by (intro h) (arith only h (farkas 1 1))))
(theorem with_have ((x Int)) (-> (<= 0 x) (<= 48 (+ 48 x)))
  (by (have unused (= x x) rfl) (intro h) (arith only h (farkas 1 1))))
(theorem reconstructed ((x Int) (y Int) (h1 (<= 0 x)) (h2 (<= x y))) (<= 0 y)
  (by (arith only h1 h2)))
