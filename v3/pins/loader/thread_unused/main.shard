;; expect: main.main threaded
;; affine use: a token left unused is not a fault — `drop` takes a World and returns none; `main`
;; unwraps the arguments and returns the token without using the arguments
(import Init String.toByteArray)
(type World (World Nat))
(extern get_args ((w World)) (Prod (List ByteArray) World))
(fn drop ((w World)) Nat 0)
(fn main ((w World)) World
  (match (get_args w) ((Prod.mk _ w1) w1)))
