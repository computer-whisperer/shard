;; expect: ok
;; §13 item 28 (slice 6): a type whose constructor bears its name — v2's commonest idiom — opens both
;; World and World.World for its file; an E-type position (a binder, a result, a field) takes the
;; inductive, a term or pattern position the constructor
(import Init Nat)
(type World (World Nat))
(fn tick ((w World)) World (match w ((World n) (World (+ n 1)))))
(fn clock ((w World)) Nat (match w ((World n) n)))
(type Box (Box World))
(fn unbox ((b Box)) World (match b ((Box w) w)))
