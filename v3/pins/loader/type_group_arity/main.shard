;; expect: main.T runnable block_parameters
;; types that name each other at different numbers of parameters are no block K takes: each
;; is a program only — the first with that reason, the second for naming it — and what is
;; written over them runs
(type T (MkT (U Int)))
(type (U a) (UNil) (UCons a T))
(fn t_len ((t T)) Int
  (match t
    ((MkT _) 1)))
