;; expect: ok
;; slice 3.15: a forward reference — a fn calling one defined later in the file — is parked and
;; defined once the callee is (retried after every definition); a theorem cites its equation
(import Init Int.decEq)
(fn twice_succ ((n Nat)) Nat (succ2 (succ2 n)))
(fn succ2 ((n Nat)) Nat (+ n 1))
(theorem ts ((n Nat)) (= (twice_succ n) (succ2 (succ2 n))) (exact (twice_succ.eq_1 n)))
