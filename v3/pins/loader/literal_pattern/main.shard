;; expect: ok
;; §8.4 slice 3.17 rule 3: numeral rows on the typed route, at Int and at Nat — Lean's value
;; patterns: the scrutinee once, then the `ite` on the type's decision per row in order, the
;; last row `_` or a name for the scrutinee. A local scrutinee is its own name in the
;; conditions (code, kind); anything else is bound once (of_sum). The functions are defined,
;; a def reads the same rows, and the rows compute in K (Eq.refl)
(import Init Int.decEq)
(fn code ((n Int)) Int (match n (0 10) (5 20) (_ 30)))
(fn kind ((n Nat)) Nat (match n (0 1) (7 2) (m (+ m 1))))
(fn of_sum ((a Int) (b Int)) Int (match (+ a b) (0 1) (-1 2) (s (* s 2))))
(def dcode ((n Int)) Int (match n (0 10) (_ 30)))
(theorem code_0 () (= (code 0) 10) (exact (Eq.refl 10)))
(theorem code_9 () (= (code 9) 30) (exact (Eq.refl 30)))
(theorem kind_7 () (= (kind 7) 2) (exact (Eq.refl 2)))
(theorem kind_3 () (= (kind 3) 4) (exact (Eq.refl 4)))
(theorem of_sum_m () (= (of_sum 2 -3) 2) (exact (Eq.refl 2)))
(theorem dcode_0 () (= (dcode 0) 10) (exact (Eq.refl 10)))
