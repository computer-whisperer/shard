;; expect: main.pick refused prim_type
;; §8.4 slice 3.19 rule 7: `=` at a derived type is the elaborator's — on the typed route it is
;; the table's decision. An E-first body (one that calls `mark`, a fn over a Symbol, E only —
;; an extern was the trigger until slice 4.3 landing 1 gave externs an L meaning) is read by
;; the classifier, where `=` is the integers' primitive: at an inductive it was accepted and
;; stuck at run; now it is refused with the pointer to call the decision by name, as `pick2` does
(import Init Int.decEq)
(type Tok (TNum Nat) (TPlus))
(derive Tok eq)
(type World (World Nat))
(extern tick ((w World)) World)
(fn mark ((s Symbol) (w World)) World w)
(fn pick2 ((a Tok) (b Tok) (w World)) World (if (Tok.decEq a b) (tick w) w))
(fn pick ((a Tok) (b Tok) (w World)) World (if (= a b) (tick (mark (quote p) w)) w))
