;; expect: main.pick refused prim_type
;; `=` at a type of the program's is its derived decision, on both readings: the elaborator
;; takes the derivation table's one visible entry, and the classifier — the only reader of a
;; body with no L reading, as these that bind a match of a numeral under a constructor first —
;; takes the same.
;; `pick1` is read so, to the call `pick2` writes by name. At a type with no derivation
;; visible there is nothing to take, and the integers' primitive would be stuck at run: `pick`
;; is refused, with the pointer
(type Tok (TNum Nat) (TPlus))
(derive Tok eq)
(type Raw (RNum Nat) (RPlus))
(type World (World Nat))
(extern tick ((w World)) World)
(fn pick2 ((a Tok) (b Tok) (w World)) World (if (Tok.decEq a b) (tick w) w))
(fn pick1 ((a Tok) (b Tok) (w World)) World
  (let
    ((k Nat
       (match (List.cons 1 List.nil)
         ((List.cons 1 _) 1)
         (_ 0))))
    (if (= a b) (tick w) w)))
(fn pick ((a Raw) (b Raw) (w World)) World
  (let
    ((k Nat
       (match (List.cons 1 List.nil)
         ((List.cons 1 _) 1)
         (_ 0))))
    (if (= a b) (tick w) w)))
