;; expect: read-error match_motive
;; slice 3.16 rule 1: the motive is constant and comes from the position — Eq's implicit type is
;; still open when its first argument is read, so the match has no type to take
(import Init Int.decEq)
(use Init.Bool)
(theorem t ((b Bool)) (= (match b (false 0) (true 1)) (match b (false 0) (true 1))) (exact (Eq.refl 0)))
