;; the implementation: its theorem cites a declaration of Init the view does not
(fn pick ((n Nat)) Nat n)
(theorem t ((w Nat) (a (BitVec w)) (b (BitVec w)))
  (= (@AndOp.and (BitVec w) (@BitVec.instAndOp w) a b)
    (@AndOp.and (BitVec w) (@BitVec.instAndOp w) a b))
  (exact (Eq.refl (@AndOp.and (BitVec w) (@BitVec.instAndOp w) a b))))
