;; expect: ok
;; §8.4 slice 3.18 rule 4: the wire by declared type. The six externs under the naming law —
;; ByteArray, Init's List, Option, Prod and Bool — performed by the driver, which builds and
;; reads each value by these types (the toolchain's own signatures stay the prelude's: the
;; `entry` case). `main` prints a literal and echoes its arguments; `copy` is a checked entry
;; over two ByteArray parameters (§9): FILE to OUT, exit 7 when written, 8 when not, 9 for a
;; missing FILE. kernel/test/wire_test.sh runs both and compares the bytes
(import Init String.toByteArray)
(type World (World Nat))
(extern get_args ((w World)) (Prod (List ByteArray) World))
(extern read_file ((path ByteArray) (w World)) (Prod (Option ByteArray) World))
(extern write ((bytes ByteArray) (w World)) World)
(extern write_line ((bytes ByteArray) (w World)) World)
(extern write_file ((path ByteArray) (bytes ByteArray) (w World)) (Prod Bool World))
(extern exit ((code Int) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn echo ((xs (List ByteArray)) (w World)) World (measure (struct xs))
  (match xs
    (List.nil w)
    ((List.cons x t) (echo t (write_line x w)))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk xs w1) (echo xs (write_line (text "wire: héllo") w1)))))
(fn copy ((src ByteArray) (dst ByteArray) (w World)) World
  (match (read_file src w)
    ((Prod.mk Option.none w1) (exit 9 (write_line (text "no such file") w1)))
    ((Prod.mk (Option.some bytes) w1)
     (match (write_file dst bytes w1)
       ((Prod.mk ok w2) (exit (if ok 7 8) (write (text "copied") w2)))))))
