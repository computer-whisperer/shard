;; expect: main.main unthreaded world_forged
;; a World built by its constructor: the token comes from the entry, never from a program
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World (write_line (text "a") (World 0)))
