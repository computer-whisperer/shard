;; expect: main.derive refused derive_shape
;; §8.4 slice 3.19 rule 8 (the ruling's fifth lean): a type nested through List — its
;; equality would recurse through List's, which no entry can hold before the type's own. The
;; capability is named missing; the type is admitted
(import Init Int.decEq)
(type Tree (Leaf Nat) (Node (List Tree)))
(derive Tree eq)
