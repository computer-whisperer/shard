;; expect: ok
;; a type whose constructor bears its name in a theorem's binder and in an argument at a sort —
;; where a type is expected the name is the type's, as in a `fn`'s signature
(import Init InvImage.wf)
(use Init.List)
(type World (World Nat))
(fn clock ((w World)) Nat
  (match w
    ((World n) n)))
(theorem t ((w World) (ws (List World))) (= (clock w) (clock w)) (by rfl))
