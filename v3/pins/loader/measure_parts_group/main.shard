;; expect: ok
;; functions that call each other, measured in three parts: a depth, a rank, a length. `down`
;; steps the depth and hands a new list to `up` (the first part decides); `up` calls `down` at
;; its own depth (the depth holds, `down`'s rank is the lower) and itself on the list's rest
;; (depth and rank hold, the length falls). No one number says this: the list `down` builds
;; is no part of what it was given
(use Init.List cons nil)
(fn up ((d Nat) (xs (List Nat))) Nat
  (measure d 1 (List.length xs))
  (match xs
    (nil 0)
    ((cons x r) (+ (down d x) (up d r)))))
(fn down ((d Nat) (x Nat)) Nat
  (measure d 0 0)
  (if (< 0 d) (up (Nat.sub d 1) (cons x (cons x nil))) x))
(fulfills up.dec_1
  (by (intro d xs x r h) (apply Prod.Lex.right' (arith) (apply Prod.Lex.left (arith)))))
(fulfills up.dec_2
  (by
    (intro d xs x r h)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right' (arith) (apply Prod.Lex.right' (arith) (arith)))))
(fulfills down.dec_1
  (by (intro d x h) (apply Prod.Lex.left (exact (Nat.sub_lt h (Nat.lt_succ_self 0))))))
(theorem up_nil ((d Nat)) (= (up d nil) 0) (by (rw up.eq_1) rfl))
(theorem down_spent ((x Nat)) (= (down 0 x) x) (by (rw down.eq_1) rfl))
