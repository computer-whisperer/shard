;; expect: ok
;; §8.4 slice 3.28 rule 3(a): the name of a fn with a program as a static argument — the shape
;; main.inc/0, nothing captured; the instance main.main_twice.of.main_inc_0 is taken once for the
;; two callers (one program per distinct shape tuple per module), and a theorem over the template
;; proven once applies at the instance through its unfolding.
(import Init Int.add)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(theorem twice_twice ((f (-> Int Int)) (x Int)) (= (twice f x) (f (f x))) (exact (Eq.refl (f (f x)))))
(fn inc ((x Int)) Int (+ x 1))
(fn inc2 ((x Int)) Int (twice inc x))
(fn inc2b ((x Int)) Int (twice inc (twice inc x)))
(theorem inc2_eq ((x Int)) (= (inc2 x) (inc (inc x))) (by (unfold inc2) (apply (twice_twice inc x))))
