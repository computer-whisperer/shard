;; expect: ok
;; an entry whose fn asks for none of it — its author has written the body out — is passed
;; over, as a proof no `auto` asks for is: no record, and the fn is what its source says
(use Init.List cons nil)
(fn rev_onto ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil acc)
    ((cons x r) (rev_onto r (cons x acc)))))
