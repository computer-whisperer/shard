;; expect: main.e_only refused absurd_e_first
;; a refuted row is Init's absurd applied to a proof and its negation — an L term, read on the typed
;; route and erased to the refuted row. A body read E-first (here: it binds a match of a numeral
;; under a constructor, which has no L reading) cannot write one: the pointer names the route, as
;; dif's does.
(fn e_only ((n Nat)) Nat
  (let
    ((k Nat
       (match (List.cons 1 List.nil)
         ((List.cons 1 _) 1)
         (_ 0))))
    (if (= n 0) 0 (absurd 1 2))))
