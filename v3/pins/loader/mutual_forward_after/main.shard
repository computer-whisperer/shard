;; expect: ok
;; a member of a group cites, after its call of the other member, a function that is read
;; later. When `pong` is read the two are looked at and `ping` stops at `later`, which names
;; nothing yet. `later` is read and is a definition, and the two are one: a reading the search
;; for a group keeps does not outlast the definition of a function its form names
(use Init.Bool)
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (+ (pong (Nat.sub n 1)) (later n))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 1 (ping (Nat.sub n 1))))
(fn later ((n Nat)) Nat (+ n 7))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem ping_zero () (= (ping 0) 0) (by rfl))
(theorem pong_zero () (= (pong 0) 1) (by rfl))
