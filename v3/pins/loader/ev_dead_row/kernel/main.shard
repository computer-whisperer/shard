;; functions that are programs only — each takes a `Symbol` —: `Rde` is no constructor in scope
(use Init.List cons nil)
(type Color (Red) (Green) (Blue))
(fn first_or ((S Symbol) (Xs (List Int)) (D Int)) Int
  (match Xs
    ((cons X _) X)
    (Other D)))
(fn code ((s Symbol) (c Color)) Int
  (match c
    (Rde 1)
    (Green 2)
    (Blue 3)))
