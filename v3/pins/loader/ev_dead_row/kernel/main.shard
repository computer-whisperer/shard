;; functions that are programs only — each binds a bare `band` first —: `Rde` is no constructor in scope
(use Init.List cons nil)
(type Color (Red) (Green) (Blue))
(fn first_or ((Xs (List Int)) (D Int)) Int
  (let ((K (band D 1)))
    (match Xs
      ((cons X _) X)
      (Other D))))
(fn code ((c Color)) Int
  (let ((k (band 1 1)))
    (match c
      (Rde 1)
      (Green 2)
      (Blue 3))))
