;; functions that are programs only — each binds a match of a numeral under a constructor first —:
;; `Rde` is no constructor in scope
(use Init.List cons nil)
(type Color (Red) (Green) (Blue))
(fn first_or ((Xs (List Int)) (D Int)) Int
  (let
    ((K Int
       (match (cons D nil)
         ((cons 0 _) 0)
         (_ 1))))
    (match Xs
      ((cons X _) X)
      (Other D))))
(fn code ((c Color)) Int
  (let
    ((k Int
       (match (cons 1 nil)
         ((cons 1 _) 1)
         (_ 0))))
    (match c
      (Rde 1)
      (Green 2)
      (Blue 3))))
