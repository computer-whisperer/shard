;; expect: main.g refused renamed_primitive
;; the same refusal from the classifier — a function E-first by the match of a numeral under a
;; constructor it binds first, which has no L reading
(fn g ((n Int)) Int
  (let
    ((k Nat
       (match (List.cons 1 List.nil)
         ((List.cons 1 _) 1)
         (_ 0))))
    (if (int_eq n 3) 1 2)))
