;; expect: main.leak refused unknown_type
;; §8.4 slice 3.24 rule 1: the hypothesis is the branch's — cited outside its dif it is nothing
;; (the missing bound evidence of law §12.4's breaks). The typed route refuses `h` as
;; unknown_constant; the body is then read E-first, where the dependent result type is no E
;; type (unknown_type: n), the typed route's reason carried in the message
(import Init dif_pos)
(fn leak ((n Nat) (i Nat)) (Option (Fin n))
  (if (< i n) (Option.some (Fin.mk i h)) Option.none))
