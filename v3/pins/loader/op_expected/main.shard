;; expect: ok
;; slice 3.21b rule 1 (GPT-6's trajectory review, finding 1): an arithmetic operator under an
;; expected Nat or Int takes that type's identity and reads both operands at it — as Lean's
;; binop% reads `(n + 1 : Int)`. Before, the operation was chosen from an operand and the
;; result coerced: `(- 1 2)` at Int was Int.ofNat (Nat.sub 1 2) = 0, and K proved it so.
;; Where the expected type decides nothing (a comparison's operands), the first operand that
;; is not numeric-closed decides: `(<= (- 0 5) x)` is at x's Int. A boundary the author
;; writes holds: `(Int.ofNat (- 1 2))` is Nat's subtraction, 0.
(import Init Int.decEq)
(def inferred () Int (- 1 2))
(theorem inferred_is () (= inferred (Int.sub 1 2)) (exact (Eq.refl inferred)))
(theorem inferred_neg () (= inferred -1) (exact (Eq.refl inferred)))
(def up1 ((n Nat)) Int (+ n 1))
(theorem up1_is ((n Nat)) (= (up1 n) (Int.add (Int.ofNat n) 1)) (exact (Eq.refl (up1 n))))
(theorem cmp_closed ((x Int)) (-> (<= (- 0 5) x) (Int.le (Int.sub 0 5) x)) (exact (fun ((h (<= (- 0 5) x))) h)))
(def boundary () Int (Int.ofNat (- 1 2)))
(theorem boundary_is () (= boundary (Int.ofNat (Nat.sub 1 2))) (exact (Eq.refl boundary)))
(theorem boundary_zero () (= boundary 0) (exact (Eq.refl boundary)))
(def at_nat ((n Nat)) Nat (- n 1))
(theorem at_nat_is ((n Nat)) (= (at_nat n) (Nat.sub n 1)) (exact (Eq.refl (at_nat n))))
