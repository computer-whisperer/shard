;; expect: main.code refused unreachable_arm
;; a row that is a bare name no constructor of the type bears binds a variable and matches
;; every value: here `Rde`, a misspelt `Red`. With rows after it the match is refused — they
;; could never be taken, and the function would run with another meaning than it reads
(import Init Int.decEq)
(type Color (Red) (Green) (Blue))
(fn code ((c Color)) Nat
  (match c
    (Rde 1)
    (Green 2)
    (Blue 3)))
