;; expect: main.main unthreaded world_unsupported
;; unsupported ownership, refused conservatively: a token passed to a polymorphic function, whose
;; signature cannot say what becomes of it — never through a wrapper that looks pure
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn wrap ((T Type) (x T)) (List T) (List.cons x List.nil))
(fn main ((w World)) World
  (match (wrap w)
    ((List.cons w1 _) (write_line (text "a") w1))
    (List.nil w)))
