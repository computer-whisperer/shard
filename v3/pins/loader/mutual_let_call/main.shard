;; expect: ok
;; in a group of functions that call each other, a `let` bound to a member's call with another
;; such call in its scope: the group is one definition, the second call's obligation stated
;; without the let
(import Init UInt8.toNat)
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (let ((r (pong (- n 1)))) (+ r (pong (- n 2))))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 7 (ping (- n 1))))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills ping.dec_2 (by (intro n h) (apply Nat.sub_lt (exact (Nat.pos_of_ne_zero h)) (decide))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem ping_two () (= (ping 2) 7) (by rfl))
