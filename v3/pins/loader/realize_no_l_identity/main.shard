;; expect: main.twice refused no_l_identity
;; `band` has no L identity at any type (§8.1 rule 5, §8.4 rule 3: only + * at Nat, + - * at Int and
;; the comparisons resolve by operand type): a realization writes the naming-law spelling (Nat.land)
(import Init Int.decEq)
(def twice ((n Nat)) Nat (Nat.add n n))
(realize twice ((n Nat)) Nat (band n n))
