;; expect: ok
;; §8.4 slice 3.18 rule 4: a declared type the host's value does not fit. write_line is
;; declared over a String — text leaves by its bytes, never as itself — so the driver has no
;; codec for the argument and the extern is stuck (kernel/test/wire_test.sh: `RUN: stuck
;; extern`, exit 4), before the host is asked. The load is clean: an extern's signature is the
;; program's claim, checked where it is performed
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((s String) (w World)) World)
(fn main ((w World)) World (write_line "never printed" w))
