;; expect: read-error above_horizon
;; §8.4 slice 3.27 rule 5: a cited name the name table places at or above the module's horizon
;; is refused above_horizon with its ordinal, the horizon and the import to write — where it
;; was unknown_constant. Here the name was never loaded by any file (init_horizon_beyond is the
;; other case: loaded by an earlier file, past this one's horizon). The citation is bare under
;; an opened namespace; the refusal names the qualified declaration.
(import Init Int.decEq)
(use Init.Nat)
(theorem t ((b Nat)) (= (Nat.land 0 b) 0) (exact (zero_and b)))
