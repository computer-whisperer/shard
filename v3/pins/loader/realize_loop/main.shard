;; expect: List.concat refused realize_descent
;; T1: a tautological equation for a looping recursion — `f x = f x` proves, the descent check refuses it
(import Init Bool.casesOn)
(realize List.concat ((a Type) (xs (List a)) (y a)) (List a) (measure (struct xs))
  (match xs (List.nil (List.cons y List.nil)) ((List.cons x t) (List.concat (List.cons x t) y))))
