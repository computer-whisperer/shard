;; expect: ok
;; type_e_only's `Foo` with Init's `Nat` in scope enters K (ACCEPT main.Foo) as well as E, so
;; the `def` citing it is accepted — the same text means a different thing by its file's scope
(import Init Nat.add)
(type Foo (MkFoo Nat))
(fn get ((x Foo)) Nat
  (match x
    ((MkFoo n) n)))
(def one () Foo (MkFoo (Nat.succ Nat.zero)))
