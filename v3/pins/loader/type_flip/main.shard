;; §13 item 35, the flip's second half: the same `Foo` with Init's `Nat` in scope enters K
;; (ACCEPT main.Foo) and E (the fn is RUNNABLE), so the `def` citing it is accepted — the
;; same text means a different thing by its file's scope, which is the one-E rule 1
(import Init Nat.add)
(type Foo (MkFoo Nat))
(fn get ((x Foo)) Nat (match x ((MkFoo n) n)))
(def one () Foo (MkFoo (Nat.succ Nat.zero)))
