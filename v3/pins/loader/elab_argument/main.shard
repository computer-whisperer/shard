;; expect: read-error argument_mismatch
;; a written argument is held to what the application's other arguments fix its parameter to:
;; the hypothesis, a bare name and read first, is about 3 and settles `x`, and the 4 written
;; for `x` is refused, naming both. (What the expected type makes of a written parameter is
;; never the reason: arg_written_kept)
(theorem lem_poly ((a Type implicit) (x a) (h (= x x))) (= x x) (exact h))
(theorem clash ((hyp (= (Int.ofNat 3) (Int.ofNat 3)))) (= (Int.ofNat 3) (Int.ofNat 3))
  (exact (lem_poly 4 hyp)))
