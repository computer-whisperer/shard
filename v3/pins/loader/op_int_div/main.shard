;; expect: ok
;; `/` at Int is Int.ediv, the Euclidean quotient; `%` at Int is Int.emod. At Nat the pair is
;; Nat.div and Nat.mod.
(import Init Int.ediv_emod_unique)
(theorem div_is_ediv ((n Int) (d Int)) (= (/ n d) (Int.ediv n d)) (by rfl))
(theorem mod_is_emod ((n Int) (d Int)) (= (% n d) (Int.emod n d)) (by rfl))
(theorem nat_div ((n Nat) (d Nat)) (= (/ n d) (Nat.div n d)) (by rfl))
(theorem div_at_int ((n Int)) (= (/ n 1) n) (by (exact (Int.ediv_one n))))
