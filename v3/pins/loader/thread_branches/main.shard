;; expect: main.main threaded
;; the positive fixture: mutually exclusive branches — the arms of a match, the two sides of an
;; if — each consume the incoming token once; the token of an extern's pair result is the arm's
(import Init String.toByteArray)
(type World (World Nat))
(extern read_file ((path ByteArray) (w World)) (Prod (Option ByteArray) World))
(extern write_file ((path ByteArray) (bytes ByteArray) (w World)) (Prod Bool World))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World
  (match (read_file (text "in") w)
    ((Prod.mk Option.none w1) (write_line (text "missing") w1))
    ((Prod.mk (Option.some bs) w1)
     (match (write_file (text "out") bs w1)
       ((Prod.mk ok w2) (if ok (write_line (text "copied") w2) (write_line (text "failed") w2)))))))
