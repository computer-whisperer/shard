;; expect: ok
;; §8.4 slice 3.27 rule 6, landing 3: a definition whose value is a match in Init — Option.getD
;; is `match opt with | some x => x | none => dflt` — has its matcher (Option.getD.match_1) as a
;; definition over casesOn; the derived view unfolds it at its arguments and erases the result as
;; any value's, so `(realize Option.getD (view))` needs no supplied body. The view attaches no
;; equations; the E body is the value's erasure.
(import Init Option.getD)
(realize Option.getD (view))
(fn getd_demo ((o (Option Nat))) Nat (Option.getD o 0))
(theorem getd_some ((x Nat)) (= (Option.getD (Option.some x) 0) x) (exact (Eq.refl x)))
(theorem getd_none () (= (Option.getD (@Option.none Nat) 7) 7) (exact (Eq.refl 7)))
