;; expect: ok
;; a group whose member builds a value of a type declared after both. When `pong` is read
;; `ping` does not read — `Pack` names nothing yet — and nothing closes. The type is declared,
;; and at the next function read the two are one definition: what the search for a group
;; keeps of a reading does not outlast a form that is no function
(use Init.Bool)
(fn ping ((n Nat)) Nat
  (measure n)
  (if (= n 0) 0
  (+ (pong (Nat.sub n 1))
    (match (Pack n)
      ((Pack k) k)))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 7 (ping (Nat.sub n 1))))
(type Crate (Pack Nat))
(fn after ((n Nat)) Nat (+ n 1))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem ping_zero () (= (ping 0) 0) (by rfl))
(theorem pong_zero () (= (pong 0) 7) (by rfl))
