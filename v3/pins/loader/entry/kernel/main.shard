(import "host.shard")
(use kernel.host)
(use kernel.prelude)
(use kernel.host.World)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(fn append ((T Type) (xs (List T)) (ys (List T))) (List T) (measure (struct xs)) (match xs (Nil ys) ((Cons x r) (Cons x (append r ys)))))
(fn show_nat ((n Int)) (List Int) (measure n) (if (lt n 10) (list (+ 48 n)) (append (show_nat (/ n 10)) (list (+ 48 (mod n 10))))))
(fn show_int ((n Int)) (List Int) (if (lt n 0) (Cons 45 (show_nat (- 0 n))) (show_nat n)))
;; the checked entry: NAME and N validated by the driver; prints "NAME 2N"
(fn main ((n Int) (name (List Int)) (w World)) World (write_line (append name (append " " (show_int (* n 2)))) w))
;; the World alone: the raw argument list through get_args, counted
(fn raw ((w World)) World (match (get_args w) ((Pair args w1) (write_line (count args) w1))))
(fn count ((xs (List (List Int)))) (List Int) (measure (struct xs)) (match xs (Nil "0") ((Cons _ r) (append "1+" (count r)))))
;; a parameter no command-line argument supplies (bad_entry), and no World last (bad_entry)
(fn opt ((x (Option Int)) (w World)) World w)
(fn noworld ((n Int)) Int n)
