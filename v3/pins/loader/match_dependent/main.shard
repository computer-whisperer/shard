;; expect: ok
;; §5.1 (slice 3.19): a match on a local the expected type mentions generalizes it — the
;; motive is `λ d. RET[d]` and each row is read at RET with its pattern, Lean's rule. A proof
;; by cases is a match (the motive was constant before: each row would have had to prove the
;; statement about `b` itself), and a result typed by its scrutinee is written row by row
(import Init Int.decEq)
(theorem not_not ((b Bool)) (= (not (not b)) b)
  (exact (match b (Bool.false (Eq.refl Bool.false)) (Bool.true (Eq.refl Bool.true)))))
(type Tok (TNum Nat) (TPlus))
(def is_num ((t Tok)) Bool (match t ((TNum _) Bool.true) (TPlus Bool.false)))
(theorem is_num_or ((t Tok)) (or (= (is_num t) Bool.true) (= (is_num t) Bool.false))
  (exact (match t ((TNum _) (Or.inl (Eq.refl Bool.true))) (TPlus (Or.inr (Eq.refl Bool.false))))))
;; only the expected type is generalized, not a hypothesis about the scrutinee: a row that
;; needs the hypothesis as it stands is read with the constant motive, as before the slice
(theorem keeps_h ((t Tok) (h (= t TPlus))) (= t TPlus) (exact (match t (_ h))))
(theorem keeps_t ((t Tok)) (= t t) (exact (match t (_ (Eq.refl t)))))
