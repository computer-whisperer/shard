;; expect: read-error reduce_stuck
;; §8.4 slice 3.20 rule 6: reduce applies computation rules anywhere — an equation with a
;; constructor or a literal in its left side — and K's whnf where it progresses; a measured
;; function's unfolding equation (`f n = …`) only at a closed occurrence (at a variable it
;; would apply to its own result without end; `unfold` applies it once). At a variable
;; nothing reduces, and the step says so. The descent obligation is discharged first, so the
;; refusal is the load's first bad record.
(import Init WellFounded.fix_eq)
(fn count_down ((n Nat)) Nat
  (measure n)
  (if (= n 0) 0 (count_down (- n 1))))
(fulfills count_down.dec_1 (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem t ((n Nat)) (= (count_down n) (count_down n)) (by (reduce) rfl))
