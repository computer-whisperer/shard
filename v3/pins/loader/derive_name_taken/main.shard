;; expect: main.T3.ctorIdx refused name_taken
;; §8.4 slice 3.19 rule 8 (found by the second reader): a derivation generates its functions'
;; names; a constant that already bears one is never taken for the derivation's. Here a
;; hand-written `T3.ctorIdx` answering 0 would have made every constructor compare equal
;; under a record that said `structural`: the form is refused and nothing is registered
(import Init Int.decEq)
(type T3 (A) (B) (C))
(fn T3.ctorIdx ((a T3)) Nat 0)
(derive T3 eq)
