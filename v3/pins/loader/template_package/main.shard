;; expect: ok
;; §8.4 slice 3.28 rule 5: a structure with a function-typed field is a package type — never an
;; E type, no runtime dictionary; a package constant is a def whose value is the constructor
;; applied; a binder of a package type is a static parameter of arity 0 and its shape the
;; constant's identity (main.IntAdd/0). In the template `(Monoid.op m x y)` erases at the
;; instance as the field applied — Int.add —, `(Monoid.unit m)` as the field's closed term, 0;
;; the generic theorem over m is proven once and applies at the constant by unification.
(import Init Int.zero_add)
(structure Monoid ((a Type)) (op (-> a a a)) (unit a)
  (op_assoc (forall ((x a) (y a) (z a)) (= (op (op x y) z) (op x (op y z)))))
  (unit_left (forall ((x a)) (= (op unit x) x))))
(def IntAdd () (Monoid Int) (Monoid.mk Int.add 0 Int.add_assoc Int.zero_add))
(fn fold_m ((a Type) (m (Monoid a)) (xs (List a))) a (measure (struct xs))
  (match xs (nil (Monoid.unit m)) ((cons x t) (Monoid.op m x (fold_m m t)))))
(theorem fold_m_nil ((a Type) (m (Monoid a))) (= (fold_m m List.nil) (Monoid.unit m)) (exact (Eq.refl (Monoid.unit m))))
(fn sum_int ((xs (List Int))) Int (fold_m IntAdd xs))
(theorem sum_int_nil () (= (sum_int List.nil) 0) (by (unfold sum_int) (apply fold_m_nil)))
(fn plus_unit ((x Int)) Int (Monoid.op IntAdd x (Monoid.unit IntAdd)))
