;; expect: ok
;; §8.4 slice 3.27 rule 3: an instance-implicit binder at one of the library's types takes
;; the pin's instance from the table — List.sum at Int (Add Int is Int.instAdd, Zero Int is
;; Zero.ofOfNat0 over instOfNat 0), at Nat (instAddNat, instOfNatNat 0); `min` and `max` are
;; Min.min and Max.max under instMinNat/Nat.instMax, the spelling of List.length_take's right
;; side; a class the table lacks stays instance_needed (elab_instance).
(import Init Nat.zero_and)
(def total ((xs (List Int))) Int (List.sum xs))
(def count ((xs (List Nat))) Nat (List.sum xs))
(theorem sum_nil () (= (List.sum (@List.nil Int)) 0) (by rfl))
(theorem sum_cons ((x Int) (xs (List Int))) (= (List.sum (List.cons x xs)) (+ x (List.sum xs))) (by rfl))
(theorem min_len ((n Nat) (xs (List Nat))) (= (List.length (List.take n xs)) (min n (List.length xs))) (by (apply List.length_take)))
(theorem min_self ((n Nat)) (= (min n n) n) (by (apply Nat.min_self)))
(theorem max_left ((a Nat) (b Nat) (h (<= b a))) (= (max a b) a) (by (exact (Nat.max_eq_left h))))
(theorem min_int ((a Int) (b Int) (h (<= a b))) (= (min a b) a) (by (exact (Int.min_eq_left h))))
