;; expect: ok
;; a `let` bound to a recursive call, with another recursive call in its scope: the second
;; call's obligation is stated without the let — its value is the function's own — and without
;; a hypothesis that cites it. The function is defined, runs, and computes in the logic
(import Init UInt8.toNat)
(fn fib ((n Nat)) Nat (measure n) (if (< n 2) n (let ((r (fib (- n 1)))) (+ r (fib (- n 2))))))
(fulfills fib.dec_1 (by (intro n h) (apply Nat.sub_lt (arith) (decide))))
(fulfills fib.dec_2 (by (intro n h) (apply Nat.sub_lt (arith) (decide))))
(fn pick ((n Nat)) Nat
  (measure n)
  (if (= n 0) 0 (let ((r (pick (- n 1)))) (if (= r 0) (pick (- n 1)) (+ r 1)))))
(fulfills pick.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem fib_seven () (= (fib 7) 13) (by rfl))
