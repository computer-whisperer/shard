;; expect: read-error match_not_exhaustive
;; slice 3.16 rule 1: in L a match is total — a constructor no row covers is a refusal that says
;; so (in E a missing arm is a stuck run; §6.2)
(import Init Int.decEq)
(type Token (TNum Int) (TPlus) (TMinus))
(def is_num ((t Token)) Nat (match t ((TNum n) 1) (TPlus 0)))
