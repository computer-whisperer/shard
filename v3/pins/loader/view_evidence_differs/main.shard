;; expect: lib.before impl-error impl_signature
;; roots: main.shard lib
;; the evidence a signature asks for is part of the parameter's type and no part of the
;; program's signature: an implementation that asks for other evidence is the same program and
;; another definition, and K, handed it at the view's type, refuses
(import "lib")
(use lib)
(theorem one_pos () (< 0 1) (by decide))
(fn zero () Nat (before 1 one_pos))
