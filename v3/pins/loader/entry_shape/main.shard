;; expect: ok
;; the checked entry's codecs are by identity: a Tree with the list arities, and a list of Bool,
;; load as any type and are refused at the entry (v3/kernel/test/entry_test.shard: bad_entry) — a
;; codec chosen by shape would hand `abc` over as Branch cells with the bytes in Tree fields, stuck
;; at the first match on them
(import Init Bool.casesOn)
(type Tree (Empty) (Branch Tree Tree))
(type Tri (A) (B) (C))
(fn main ((t Tree) (w Tri)) Nat
  (match t
    (Tree.Empty 0)
    ((Tree.Branch l r)
     (match l
       (Tree.Empty 0)
       ((Tree.Branch _ _) 1)))))
(fn bools ((xs (List Bool)) (w Tri)) Tri w)
(fn nats ((xs (List Nat)) (w Tri)) Nat
  (match xs
    (List.nil 0)
    ((List.cons x _) x)))
