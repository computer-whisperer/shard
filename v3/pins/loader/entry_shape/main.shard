;; expect: ok
;; the checked entry's codecs are by identity (§9; GPT-6 R59): a Tree with the list arities, and a list of
;; Bool, load as any type and are refused at the entry (kernel/test/entry_test.shard: bad_entry) — before
;; slice 10 `abc` arrived as Branch cells with the bytes in Tree fields, stuck at the first match on them
(import Init Bool.casesOn)
(type Tree (Empty) (Branch Tree Tree))
(type Tri (A) (B) (C))
(fn main ((t Tree) (w Tri)) Nat (match t (Tree.Empty 0) ((Tree.Branch l r) (match l (Tree.Empty 0) ((Tree.Branch _ _) 1)))))
(fn bools ((xs (List Bool)) (w Tri)) Tri w)
(fn nats ((xs (List Nat)) (w Tri)) Nat (match xs (List.nil 0) ((List.cons x _) x)))
