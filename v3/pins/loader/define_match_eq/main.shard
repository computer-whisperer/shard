;; expect: ok
;; §8.4 slice 3.21 (define.shard): under a measure a matcher carries its equation — the
;; motive `λ s' . s = s' → motive s'`, each row's last binder `h : s = pattern`, the application
;; applied to `Eq.refl s` (Lean's `match h : s with`, by addArg). The descent obligation of a
;; call in a row is stated under it: `drop2.dec_1 : ∀ xs x r, tail2 xs = cons x r → len3 r <
;; len3 xs` is a fact (before, it quantified r freely and no proof existed). The equation
;; `drop2.eq_1` is stated over the same shape, and a row at a constructor still computes (t).
(import Init WellFounded.fix_eq)   ; through WellFounded.fix and its equation; Lean.Omega's kit lies before it
(use Init.List)
(fn len3 ((xs (List Int))) Nat
  (measure (struct xs))
  (match xs (nil 0) ((cons _ t) (+ 1 (len3 t)))))
(fn tail2 ((xs (List Int))) (List Int)
  (match xs (nil nil) ((cons _ t) t)))
(theorem tail2_len ((xs (List Int)) (x Int) (r (List Int)) (h (= (tail2 xs) (cons x r)))) (< (len3 r) (len3 xs))
  (by (have e (= (len3 (tail2 xs)) (+ 1 (len3 r))) (rw h) (reduce) rfl)
      (have le (<= (len3 (tail2 xs)) (len3 xs)) (cases xs ((nil () (reduce) arith) (cons (y t) (reduce) arith))))
      arith))
;; every other element's count, recursing on the tail's tail
(fn drop2 ((xs (List Int))) Nat
  (measure (len3 xs))
  (match (tail2 xs)
    (nil 0)
    ((cons x r) (+ 1 (drop2 r)))))
(fulfills drop2.dec_1 (by (intro xs x r h) (exact (tail2_len xs x r h))))
(theorem t () (= (drop2 (list 1 2 3)) 1) (by (reduce) rfl))
;; a nested match on the binder itself: the obligation is the comparison at Nat under both rows'
;; equations and the source's names — ∀ xs x r, xs = cons x r → ∀ y s, r = cons y s → len3 s <
;; len3 xs — so it is rewritten and reduced as it stands (found by the slice's second reader:
;; every variable printed `x`, and the fact was the relation's instance `InvImage … s xs`,
;; where `reduce` stepped into the relation and arith read no comparison)
(fn pairs ((xs (List Int))) Nat
  (measure (len3 xs))
  (match xs
    (nil 0)
    ((cons x r) (match r (nil 0) ((cons y s) (+ 1 (pairs s)))))))
(fulfills pairs.dec_1 (by (intro xs x r h y s h2) (rw h) (rw h2) (reduce) arith))
(theorem u () (= (pairs (list 1 2 3 4 5)) 2) (by (reduce) rfl))
