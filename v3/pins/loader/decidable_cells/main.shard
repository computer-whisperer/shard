;; expect: ok
;; §8.4 slice 3.19 (found by the second reader; older than the slice): a `Decidable` value is
;; one of the type's two cells wherever it is not an `if`'s condition. `tag` takes a decision
;; apart by constructor; handed `(Nat.decEq a b)` or `(instDecidableEqBool a true)` — whose
;; programs were the bare test, an integer comparison's cell or a Bool — it took the wrong
;; row while K proved the right one. Now the test stands only where an `if` reads it
;; (`cond`'s program is unchanged) and a value is `(if TEST isTrue isFalse)`; define_test.sh
;; runs both entries against the two theorems
(import Init Int.decEq)
(type World (World Nat))
(extern exit ((code Int) (w World)) World)
(fn tag ((p Prop) (d (Decidable p))) Int (match d ((Decidable.isFalse _) 10) ((Decidable.isTrue _) 11)))
(fn tag_bool ((a Bool)) Int (tag (instDecidableEqBool a Bool.true)))
(fn tag_nat ((a Nat) (b Nat)) Int (tag (Nat.decEq a b)))
(fn cond ((a Nat) (b Nat)) Int (if (= a b) 1 0))
(theorem k_bool () (= (tag_bool Bool.false) 10) (exact (Eq.refl 10)))
(theorem k_nat () (= (tag_nat 1 2) 10) (exact (Eq.refl 10)))
(theorem k_nat_eq () (= (tag_nat 2 2) 11) (exact (Eq.refl 11)))
(fn main_bool ((w World)) World (exit (tag_bool Bool.false) w))
(fn main_nat ((w World)) World (exit (tag_nat 1 2) w))
(fn main_nat_eq ((w World)) World (exit (tag_nat 2 2) w))
