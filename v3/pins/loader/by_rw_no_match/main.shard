;; expect: read-error rw_no_match
;; §8.4 slice 3.20 rule 7: the lemma's side is matched syntactically against the target's
;; subterms — never by conversion — so a + b finds no a + b that is written b + a
(import Init InvImage.wf)
(theorem t ((a Nat) (b Nat) (h (= (+ a b) 3))) (= (+ b a) 3) (by (rw h)))
