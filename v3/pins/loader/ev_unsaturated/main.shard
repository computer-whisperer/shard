;; expect: main.g refused type_mismatch
;; a head takes exactly its arity (§6.3 item 1): on the typed route (slice 3.16 rule 6) a partial
;; application is a function where a Nat is expected — the elaborator's refusal, never an E-first success
(import Init Nat)
(fn f ((a Nat) (b Nat)) Nat a)
(fn g ((a Nat)) Nat (f a))
