;; expect: ok
;; `walk` and `skip` are a group — two binders each, a call under a match and under an `if` on a
;; function defined before them, a self-call beside the call to the other member, and `skip`
;; handing its list on unchanged, paid by a rank in the measures. `even_len`, declared after
;; them, calls only itself and is no member: an ordinary measured function. Each obligation is
;; stated over the caller's binders by name and the facts in scope at the call, and closes by
;; the equation of its match and arithmetic
(import Init UInt8.toNat)
(use Init.Bool)
(use Init.List)
(fn twice ((n Nat)) Nat (+ n n))
(fn len ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ r) (+ 1 (len r)))))
(fn walk ((xs (List Nat)) (acc Nat)) Nat
  (measure (+ (+ (len xs) (len xs)) 1))
  (match xs
    (nil acc)
    ((cons x r) (if (even_len r) (walk r (+ acc (twice x))) (skip r acc)))))
(fn skip ((xs (List Nat)) (acc Nat)) Nat (measure (+ (+ (len xs) (len xs)) 2)) (walk xs (+ acc 1)))
(fn even_len ((xs (List Nat))) Bool
  (measure (+ (len xs) (len xs)))
  (match xs
    (nil true)
    ((cons _ r)
     (match r
       (nil false)
       ((cons _ r2) (even_len r2))))))
(theorem walk_nil ((a Nat)) (= (walk nil a) a) (by (rw walk.eq_1) rfl))
(theorem even_two () (= (even_len (cons 1 (cons 2 nil))) true) (by rfl))
(fulfills even_len.dec_1
  (by (intro xs a r h b r2 h2) (rw h) (rw h2) (rw len.eq_2) (rw len.eq_2) (arith)))
(fulfills walk.dec_1 (by (intro xs acc x r h c) (rw h) (rw len.eq_2) (arith)))
(fulfills walk.dec_2 (by (intro xs acc x r h c) (rw h) (rw len.eq_2) (arith)))
(fulfills skip.dec_1 (by (intro xs acc) (arith)))
