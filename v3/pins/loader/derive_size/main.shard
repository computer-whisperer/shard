;; expect: ok
;; `(derive TYPE size)` on a type nested through `List` — `Tree.size` from `Tree.rec` and
;; `List_Tree.size` from `Tree.rec_1`, every motive `λ _. Nat`, a constructor 1 plus the sizes of
;; the fields K gives an induction hypothesis for; an equation per constructor by `Eq.refl`. The
;; tree-and-forest pair below is a group measured by them: no size of such a type can be written as
;; a `fn`, since it is this pair. Each obligation closes by the equation of its match, the size's
;; equation and arithmetic. The sizes have no program: the members' programs record that their
;; measure is K's alone
(import Init UInt8.toNat)
(use Init.Bool)
(use Init.List)
(type Tree (Leaf Nat) (Node (List Tree)))
(derive Tree size)
(theorem tail_smaller ((k Tree) (r (List Tree))) (< (List_Tree.size r) (List_Tree.size (cons k r)))
  (by (rw List_Tree.size.eq_2) (arith)))
(fn count ((t Tree)) Nat
  (measure (Tree.size t))
  (match t
    ((Leaf _) 1)
    ((Node ks) (counts ks))))
(fn counts ((ts (List Tree))) Nat
  (measure (List_Tree.size ts))
  (match ts
    (nil 0)
    ((cons k r) (+ (count k) (counts r)))))
(fulfills count.dec_1 (by (intro t ks h) (rw h) (rw Tree.size.eq_2) (arith)))
(fulfills counts.dec_1 (by (intro ts k r h) (rw h) (rw List_Tree.size.eq_2) (arith)))
(fulfills counts.dec_2 (by (intro ts k r h) (rw h) (rw List_Tree.size.eq_2) (arith)))
(theorem count_two () (= (count (Node (cons (Leaf 1) (cons (Leaf 2) nil)))) 2) (by rfl))
