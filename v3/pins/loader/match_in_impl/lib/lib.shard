;; the implementation: the concrete Stack (a count); depth and push by match, the law by computation
(import Init Int.decEq)
(type Stack (mk Nat))
(fn empty () Stack (Stack.mk 0))
(fn push ((n Nat) (s Stack)) Stack (match s ((Stack.mk k) (Stack.mk (+ k 1)))))
(fn depth ((s Stack)) Nat (match s ((Stack.mk k) k)))
(fulfills depth_empty (exact (Eq.refl (depth (empty)))))
