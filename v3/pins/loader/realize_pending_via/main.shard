;; expect: main.f pending measure
;; GPT-6 R58's counterexample: the logical f n = 0, the executable body f (n+1) under (measure n) — the
;; equation `f n = f (Nat.add n 1)` is TRUE of the constant function and proves by rfl, the measure
;; increases, the body never returns. The realization is retained as a candidate with its obligation
;; (PENDING), and g, whose body calls f, carries it: REALIZE main.g … pending=main.f
;; (kernel/test/loader_test.shard checks the line)
(import Init Bool.casesOn)
(def f ((n Nat)) Nat 0)
(realize f ((n Nat)) Nat (measure n) (f (Nat.add n 1)))
(def g ((n Nat)) Nat (f n))
(realize g ((n Nat)) Nat (f n))
(def h ((n Nat)) Nat (g n))
(realize h ((n Nat)) Nat (g n))
