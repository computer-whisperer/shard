;; expect: ok
;; a schema-2 sidecar — (sidecar 2), each entry keyed by the statement's fingerprint alone — still
;; stands on replay: an entry fits when its fingerprint is the statement's, the load reporting
;; SIDECAR main.shard schema=2 current=3 (a report, never a refusal). prove rewrites such a file
;; whole at schema 3 with the full keys computed at replay — no search.
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((x Int) (y Int) (h1 (<= 0 x)) (h2 (<= x y))) (<= 0 y) auto)
(theorem u ((n Nat)) (= (+ n 0) n) (auto (induct n)))
