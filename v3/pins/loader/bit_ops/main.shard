;; expect: ok
;; the bit-level operators take their meaning from an operand's type, as `+` does: Init's at
;; Nat; at Int its two shifts, and the base's `and`, `or`, `xor` (kernel/base.shard), which no
;; file imports. A function over them is a definition: each theorem cites one, and K computes
;; it from the definitions
(fn nat_ops ((a Nat) (b Nat)) Nat (bshr (bor (bxor a b) (band a b)) 1))
(fn int_ops ((a Int) (b Int)) Int (bor (bxor a b) (band a b)))
(fn int_shifts ((a Int) (k Nat)) Int (bshr (bshl a k) 1))
(fn mask ((a Int)) Int (band 255 a))
(theorem nat_ops_at () (= (nat_ops 12 10) 7) (by (decide)))
(theorem int_ops_at () (= (int_ops -4 -6) -2) (by (decide)))
(theorem int_shifts_at () (= (int_shifts -3 4) -24) (by (decide)))
(theorem mask_at () (= (mask -1) 255) (by (decide)))
