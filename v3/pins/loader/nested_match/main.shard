;; expect: ok
;; §8.4 (slice 4.2 landing 0): a nested inductive — a constructor carrying the type under List —
;; has its casesOn (the recursor's auxiliary motives PUnit, their minors PUnit.unit): a match on
;; it is defined with its equations, which the theorem unfolds; its noConfusion and injectivity
;; follow. Structural recursion through the nesting stays outside (the old refusal).
(import Init Nat.sub_one_lt)
(type Tree (Leaf) (Node Nat (List Tree)))
(fn label ((t Tree)) Nat (match t (Leaf 0) ((Node n _) n)))
(theorem label_node ((n Nat) (ts (List Tree))) (= (label (Node n ts)) n) (by (unfold label) rfl))
(theorem node_inj ((n Nat) (m Nat) (ts (List Tree)) (us (List Tree))) (-> (= (Node n ts) (Node m us)) (= n m))
  (by (intro h) (exact (And.left (Tree.Node.inj h)))))
