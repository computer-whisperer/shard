;; expect: ok
;; slice 3.16 rule 1 (GPT-6 R64, fixture G2): a matcher is recognized by regenerating it from its
;; own type and comparing, never by its name. `pick.match_1` is the matcher of two `_` rows written
;; out by hand — first match wins, so the first alternative answers — and is one; `fake.match_1`
;; has the same type and answers with the second: K accepts it as a definition, and it is no
;; matcher (kernel/test/matcher_test.shard asks mt_is_matcher about both)
(import Init Int.decEq)
(use Init.Bool)
(def pick.match_1.{v} ((motive (-> Bool (Sort v))) (t Bool) (h_1 (forall ((x Bool)) (motive x))) (h_2 (forall ((x Bool)) (motive x)))) (motive t) (h_1 t))
(def fake.match_1.{v} ((motive (-> Bool (Sort v))) (t Bool) (h_1 (forall ((x Bool)) (motive x))) (h_2 (forall ((x Bool)) (motive x)))) (motive t) (h_2 t))
