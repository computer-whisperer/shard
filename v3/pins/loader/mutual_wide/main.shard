;; expect: ok
;; a member of a group may call any number of the others: `hub` calls seventeen, and the group
;; is found as any other — the search reads a waiting function again for each callee it names,
;; as the load itself does. Each `s` goes back to `hub` one lower; `hub` hands its number on, so
;; its measure stands one above theirs
(fn hub ((n Nat)) Nat
  (measure (+ (* 2 n) 1))
  (+ (s1 n)
    (+ (s2 n)
      (+ (s3 n)
        (+ (s4 n)
          (+ (s5 n)
            (+ (s6 n)
              (+ (s7 n)
                (+ (s8 n)
                  (+ (s9 n)
                    (+ (s10 n)
                      (+ (s11 n) (+ (s12 n) (+ (s13 n) (+ (s14 n) (+ (s15 n) (+ (s16 n) (s17 n))))))))))))))))))
(fn s1 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 1 (hub (Nat.sub n 1))))
(fn s2 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 2 (hub (Nat.sub n 1))))
(fn s3 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 3 (hub (Nat.sub n 1))))
(fn s4 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 4 (hub (Nat.sub n 1))))
(fn s5 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 5 (hub (Nat.sub n 1))))
(fn s6 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 6 (hub (Nat.sub n 1))))
(fn s7 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 7 (hub (Nat.sub n 1))))
(fn s8 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 8 (hub (Nat.sub n 1))))
(fn s9 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 9 (hub (Nat.sub n 1))))
(fn s10 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 10 (hub (Nat.sub n 1))))
(fn s11 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 11 (hub (Nat.sub n 1))))
(fn s12 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 12 (hub (Nat.sub n 1))))
(fn s13 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 13 (hub (Nat.sub n 1))))
(fn s14 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 14 (hub (Nat.sub n 1))))
(fn s15 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 15 (hub (Nat.sub n 1))))
(fn s16 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 16 (hub (Nat.sub n 1))))
(fn s17 ((n Nat)) Nat (measure (* 2 n)) (if (= n 0) 17 (hub (Nat.sub n 1))))
(fulfills hub.dec_1 (by (intro n) (arith)))
(fulfills s1.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s2.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s3.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s4.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s5.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s6.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s7.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s8.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s9.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s10.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s11.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s12.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s13.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s14.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s15.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s16.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills s17.dec_1 (by (intro n h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(theorem hub_zero () (= (hub 0) 153) (by rfl))
