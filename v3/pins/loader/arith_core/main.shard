;; expect: ok
;; §8.4 slice 3.21 rules 1–5: arith closes a goal that follows from linear arithmetic over Int
;; and Nat. Its rows are the goal negated, the context's linear hypotheses and the facts given
;; (a term: a hypothesis applied, a lemma); the certificate — one integer per row under which
;; the rows sum to a false constant — is the default reconstruction's (Fourier–Motzkin over
;; the rows) or the node's own (`(farkas K…)`: t1f checks the sum and runs no elimination).
;; P is Lean.Omega's: `t = l.eval v` on the term's structure, a fold of combo_sat', and
;; not_sat'_of_isImpossible. A Nat row is cast into Int and each Nat atom brings 0 ≤ ↑a (n2);
;; an equation is its two sides' one normal form (e1) or ≤ both ways (e2); a goal ¬ P is P's
;; row (g3, g4); False has no negation row (f1); a strict comparison is tight at the integers.
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t1 ((x Int) (h (<= 0 x))) (<= 48 (+ 48 x)) (by arith))
(theorem t1f ((x Int) (h (<= 0 x))) (<= 48 (+ 48 x)) (by (arith (farkas 1 1))))
(theorem t2 ((x Int) (h (<= x 9))) (<= (+ 48 x) 57) (by arith))
(theorem g3 ((c Int) (h (<= c 32))) (Not (<= 48 c)) (by arith))
(theorem g4 ((c Int) (h (<= 48 c))) (Not (= c 43)) (by arith))
(theorem e1 ((a Int) (b Int)) (= (- (+ a b) a) b) (by arith))
(theorem e2 ((x Int) (y Int) (h1 (<= x y)) (h2 (<= y x))) (= x y) (by arith))
(theorem f1 ((x Int) (y Int) (h1 (< x y)) (h2 (< y x))) False (by arith))
(theorem n1 ((a Nat) (b Nat) (c Nat) (h1 (<= (+ 1 a) b)) (h2 (<= (+ 1 b) c))) (< a c) (by arith))
(theorem n2 ((a Nat)) (<= 0 a) (by arith))
(theorem n3 ((a Nat) (b Nat) (h (= a (Nat.succ b)))) (< b a) (by arith))
;; a fact as a term: the lemma applied to a hypothesis, a universally quantified hypothesis at an instance
(theorem k1 ((f (-> Int Int)) (mono (forall ((x Int)) (<= x (f x)))) (a Int) (h (<= 3 a))) (<= 3 (f a))
  (by (arith (mono a))))
;; Init's spelling and the source's are one (rule 3): Int.le_refl speaks LE.le
(theorem s1 ((a Int) (b Int) (h (< a b))) (<= a b) (by (arith (Int.le_refl a))))
