;; expect: main.even runnable mutual_recursion
;; §8.4 (slice 3.14 rule 3): a callee declared later in the file — a forward reference, mutual
;; recursion — is an obstacle until slice 3.15
(import Init Int.decEq)
(use Init.Bool)
(use Init.List)
(fn even ((xs (List Nat))) Bool (measure (struct xs)) (match xs (List.nil Bool.true) ((List.cons _ t) (odd t))))
(fn odd ((xs (List Nat))) Bool (measure (struct xs)) (match xs (List.nil Bool.false) ((List.cons _ t) (even t))))
