;; expect: main.even runnable group_measure
;; §8.4 slice 3.14 rule 3, as §8.7 slice 5.2 rules 2 and 4 have it: two functions that call each
;; other are a group, found when the second is read, and a group is one definition by
;; well-founded recursion only where every member states a measure — a structural clause on a
;; member is not read as a size. These two stay programs by erasure, the reason on each record
;; (before slice 5.2: `callee_runnable`, at the file's end)
(import Init Int.decEq)
(use Init.Bool)
(use Init.List)
(fn even ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (List.nil Bool.true)
    ((List.cons _ t) (odd t))))
(fn odd ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (List.nil Bool.false)
    ((List.cons _ t) (even t))))
