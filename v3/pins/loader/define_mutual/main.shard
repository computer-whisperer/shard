;; expect: main.even runnable group_measure
;; two functions that call each other are a group, found when the second is read, and a group is one
;; definition by well-founded recursion only where every member states a measure — a structural
;; clause on a member is not read as a size. These two stay programs by erasure, the reason on each
;; record
(import Init Int.decEq)
(use Init.Bool)
(use Init.List)
(fn even ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (List.nil Bool.true)
    ((List.cons _ t) (odd t))))
(fn odd ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (List.nil Bool.false)
    ((List.cons _ t) (even t))))
