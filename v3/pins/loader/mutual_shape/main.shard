;; expect: main.evenT runnable group_shape
;; §8.7 slice 5.2 rule 4: a member of a group with a type parameter is not compiled — the
;; members stay programs, the reason on each record
(import Init UInt8.toNat)
(use Init.Bool)
(use Init.List)
(fn lenT ((T Type) (xs (List T))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ r) (+ 1 (lenT r)))))
(fn evenT ((T Type) (xs (List T))) Bool
  (measure (lenT xs))
  (match xs
    (nil true)
    ((cons _ t) (oddT t))))
(fn oddT ((T Type) (xs (List T))) Bool
  (measure (lenT xs))
  (match xs
    (nil false)
    ((cons _ t) (evenT t))))
