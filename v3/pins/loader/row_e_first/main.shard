;; expect: main.f refused unknown_head
;; §8.4 slice 3.18 rule 1: a row's type is never an E inductive. This body is E-first (it
;; calls an extern), and the classifier does not know ByteArray.mk: no E-first function builds
;; a cell where the typed route passes the bare field, so the two routes cannot disagree on a
;; ByteArray's representation. The remedy is a typed function that packs (row_types' `pack`)
(import Init String.toByteArray)
(extern poke ((n Nat)) Nat)
(fn f ((l (List UInt8))) ByteArray (match (poke 0) (_ (ByteArray.mk (Array.mk l)))))
