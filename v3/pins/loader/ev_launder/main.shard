;; expect: main.peek refused private_match
;; the leak through a polymorphic wrapper: the static type is inferred from the constructor's arguments (§6.7)
(import Init Nat)
(import "lib")
(import "lib/lib.shard")
(type (Box T) (mk T))
(fn unbox ((T Type) (b (Box T))) T (match b ((Box.mk x) x)))
(fn peek () Nat (match (unbox (Box.mk (lib.empty))) ((lib.lib.Stack.mk k) k)))
