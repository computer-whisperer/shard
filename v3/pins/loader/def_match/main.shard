;; expect: ok
;; §8.4 guard 1 (rule 5): a def written in the E forms — a match on a parameter — is elaborated by
;; the same translation a fn's body is; K computes it, so the theorem is Eq.refl
(import Init Int.decEq)
(use Init.Bool)
(def bit ((b Bool)) Nat (match b (Bool.false 0) (Bool.true 1)))
(theorem bit_true () (Eq (bit Bool.true) 1) (exact (Eq.refl 1)))
