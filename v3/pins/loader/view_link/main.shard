;; expect: main.two_next linked closed
;; roots: main.shard lib
;; link: yes
;; the link: the consumer's theorem rests on the view's parameters, the implementation's fork
;; ends with a definition and a theorem under the same names, and K accepts the consumer's
;; declarations once more in an environment where those names are the implementation's — what
;; `two_next` rests on there is what the implementation's proof rests on, and no parameter
(import "lib")
(use lib)
(theorem three_pos () (< 0 3) (by decide))
(fn two () Nat (before 3 three_pos))
(theorem two_next () (= (+ two 1) 3) (by (rw two.eq_1) (exact (before_next 3 three_pos))))
