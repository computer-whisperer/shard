;; expect: ok
;; T5: a theorem about the imported List.append stated before its realization is cited after it —
;; the realization attaches under the same identity and changes nothing a theorem rests on
(import Init Bool.casesOn)
(theorem nil_app ((a Type) (ys (List.{0} a)))
  (Eq.{1} (List.{0} a) (List.append.{0} a (List.nil.{0} a) ys) ys)
  (exact (Eq.refl.{1} (List.{0} a) ys)))
(realize List.append ((a Type) (xs (List a)) (ys (List a))) (List a) (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x t) (List.cons x (List.append t ys)))))
(theorem nil_app_again ((a Type) (ys (List.{0} a)))
  (Eq.{1} (List.{0} a) (List.append.{0} a (List.nil.{0} a) ys) ys)
  (exact (nil_app a ys)))
(fn twice ((xs (List Nat))) (List Nat) (List.append xs xs))
