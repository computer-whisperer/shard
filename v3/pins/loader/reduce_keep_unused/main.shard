;; expect: read-error reduce_keep_unused
;; a kept name no call of which the run met is refused at the run's end — the list is what the
;; run held, no more. Here `step` is kept and the target calls `pick` alone
(fn step ((xs (List Nat))) Nat
  (match xs
    (List.nil 0)
    ((List.cons y r) (if (= y 0) 7 (+ y 1)))))
(fn pick ((n Nat)) Nat (if (= n 0) 5 6))
(theorem t () (= (pick 3) 6) (by (reduce (keep step)) rfl))
