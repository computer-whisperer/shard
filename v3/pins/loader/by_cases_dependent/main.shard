;; expect: ok
;; §8.4 slice 3.29 rule 6 (law §12.5's T10 row): the dependent motive — under `cases` and
;; `induction` every local whose type mentions the eliminated local is reverted into the motive
;; and re-introduced in each arm after the fields, so the arm sees it at the constructor: the
;; zero arm faces h : (< 0 Nat.zero), which arith refutes; under induction the hypothesis of
;; the step is generalized over it (Lean's `cases` and `induction … generalizing`)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((n Nat) (h (< 0 n))) (<= 1 n)
  (by (cases n ((zero () (arith h)) (succ (k) (exact (Nat.succ_le_succ (Nat.zero_le k))))))))
(theorem u ((n Nat) (m Nat) (h (<= n m))) (<= n (+ m 1))
  (by (cases m ((zero () (arith h)) (succ (k) (arith h))))))
(theorem v ((n Nat) (m Nat) (h (<= n m)) (g (<= m n))) (= n m)
  (by (cases n ((zero () (arith h g)) (succ (k) (arith h g))))))
