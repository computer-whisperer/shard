;; expect: ok
;; E at Stage 0 in S: a native type, fns over it with match, let, if and the primitives by their bare and naming-law spellings; RUNNABLE, no L meaning
(import Init Nat)
(type (Lst T) (nil) (cons T (Lst T)))
(fn length ((xs (Lst Nat))) Nat (measure (struct xs))
  (match xs (nil 0) ((cons _ t) (+ 1 (length t)))))
(fn sum3 ((a Nat) (b Nat) (c Nat)) Nat (let ((ab (+ a b)) (abc (+ ab c))) abc))
(fn safe_sub ((a Nat) (b Nat)) Nat (if (lt a b) 0 (Nat.sub a b)))
(fn main ((n Nat)) Nat (sum3 (length (cons n (cons n nil))) (safe_sub 2 n) (Int.tdiv n 0)))
