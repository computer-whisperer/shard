;; expect: ok
;; E: a native type, fns over it with match, let, if and the primitives by
;; their bare and naming-law spellings. `main` takes a bit-level primitive, which has no form in
;; the logic: RUNNABLE, no L meaning, its program the classifier's; the others are defined, their
;; programs the erasure
(type (Lst T) (nil) (cons T (Lst T)))
(fn length ((xs (Lst Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ t) (+ 1 (length t)))))
(fn sum3 ((a Nat) (b Nat) (c Nat)) Nat (let ((ab (+ a b)) (abc (+ ab c))) abc))
(fn safe_sub ((a Nat) (b Nat)) Nat (if (< a b) 0 (Nat.sub a b)))
(fn main ((n Nat)) Nat (sum3 (length (cons n (cons n nil))) (safe_sub 2 n) (band (Int.tdiv n 0) 1)))
