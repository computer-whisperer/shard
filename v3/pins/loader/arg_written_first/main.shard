;; expect: ok
;; what was written for a parameter is read before an argument whose type is stated over it.
;; `outer`'s parameter c is given `(bump c)`; the hypothesis g is about the local c, where
;; `outer` asks it about `(bump c)` — the two agree by unfolding —, and g3 is about `(bump c)`.
;; Read before `(bump c)`, g would settle the parameter to the local c and g3 be refused.
;; `use_nested` has an application with an implicit parameter between them. `use_numeral`: a
;; numeral written for j, and a hypothesis about `(+ j 1)` that is about 3. `use_open`: a
;; numeral whose own type only the hypothesis after it fixes is still read after that
;; hypothesis, and is an `Int`
(fn pick ((c (Prod Nat Nat))) Nat (Prod.fst c))
(fn bump ((c (Prod Nat Nat))) (Prod Nat Nat) (Prod.mk (Prod.fst c) (+ (Prod.snd c) 1)))
(theorem inner ((a Nat implicit) (h (< a 9))) (< a 9) (exact h))
(theorem outer ((c (Prod Nat Nat)) (n Nat) (h2 (= (pick c) n)) (h3 (= (Prod.snd c) (Prod.snd c))))
  (= (pick c) n)
  (exact h2))
(theorem use_plain
  ((c (Prod Nat Nat)) (n Nat) (g (= (pick c) n)) (g3 (= (Prod.snd (bump c)) (Prod.snd (bump c)))))
  (= (pick (bump c)) n)
  (exact (outer (bump c) n g g3)))
(theorem outer_w
  ((c (Prod Nat Nat))
   (n Nat)
   (h1 (< (pick c) 9))
   (h2 (= (pick c) n))
   (h3 (= (Prod.snd c) (Prod.snd c))))
  (= (pick c) n)
  (exact h2))
(theorem use_nested
  ((c (Prod Nat Nat))
   (n Nat)
   (w (< (pick (bump c)) 9))
   (g (= (pick c) n))
   (g3 (= (Prod.snd (bump c)) (Prod.snd (bump c)))))
  (= (pick (bump c)) n)
  (exact (outer_w (bump c) n (inner w) g g3)))
(theorem lem ((j Nat) (h (< (+ j 1) 9))) (< (+ j 1) 9) (exact h))
(theorem use_numeral ((hyp (< 3 9))) (< 3 9) (exact (lem 2 hyp)))
(theorem lem_poly ((a Type implicit) (x a) (h (= x x))) (= x x) (exact h))
(theorem use_open ((hyp (= (Int.ofNat 3) (Int.ofNat 3)))) (= (Int.ofNat 3) (Int.ofNat 3))
  (exact (lem_poly 3 hyp)))
