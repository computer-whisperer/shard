;; expect: main.hello bad-bin unthreaded
;; §8.6 slice 4.3 landing 1 (rule 4): the well-threadedness check over the bin's closure
;; refuses — a report on every load (landing 0), a failure of the load under a bin. `main`
;; writes twice through one token (the law's sequential-use negative): UNTHREADED main.main
;; world_twice: parameter 1 used twice: main.write_line, main.write_line
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World (match (write_line (text "a") w) (_ (write_line (text "b") w))))
(theorem main_total ((w World)) (= (main w) (main w)) (exact (Eq.refl (main w))))
(bin hello (entry main) (externs write_line) (trusts) (requires main_total))
