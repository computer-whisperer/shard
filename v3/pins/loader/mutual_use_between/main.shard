;; expect: ok
;; a member of a group cites a name that a `use` after both opens. When `pong` is read
;; `ping` does not read — `succ` names nothing in its scope — and nothing closes. The
;; namespace is opened, and at the next function read the two are one definition: what the
;; search for a group keeps of a reading does not outlast a change of the scope
(use Init.Bool)
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (+ (pong (Nat.sub n 1)) (succ n))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 7 (ping (Nat.sub n 1))))
(use Init.Nat succ)
(fn after ((n Nat)) Nat (+ n 1))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem ping_zero () (= (ping 0) 0) (by rfl))
