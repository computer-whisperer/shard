;; expect: main.pick refused type_mismatch
;; code from a sidecar is checked as source written in the hole's place is: here it is a list
;; where the hole's type is Nat, and the fn is refused as it would be had its author written that
(use Init.List cons nil)
(fn pick ((xs (List Nat))) Nat
  (match xs
    (nil 0)
    ((cons x r) (hole first))))
