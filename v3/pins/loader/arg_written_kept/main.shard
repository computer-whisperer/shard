;; expect: ok
;; the expected type does not settle a parameter that was written out. `keep` states its
;; parameter p under `Prod.fst`, and `(bump p)` has the first part of p: its result held
;; against the goal before `(bump p)` is read would settle the parameter to the local p, and
;; what was written be refused. `direct`: the hypothesis is a bare name, which waits for
;; `(bump p)` (arg_written_first); `compound`: it is a compound term, read after `(bump p)`
;; in any case. `tied`: what the expected type makes of a parameter still reaches whatever
;; took the result type before the argument was read — `absurd`'s open proposition takes
;; `congrArg`'s result before `Option.isSome` is read, and is about `Option.isSome`
(fn bump ((p (Prod Nat Nat))) (Prod Nat Nat) (Prod.mk (Prod.fst p) 7))
(theorem keep ((p (Prod Nat Nat)) (q (Prod Nat Nat)) (h (= q p))) (= (Prod.fst q) (Prod.fst p))
  (by (rw h) (rfl)))
(theorem direct ((p (Prod Nat Nat)) (q (Prod Nat Nat)) (kq (= q (bump p))))
  (= (Prod.fst q) (Prod.fst p))
  (exact (keep (bump p) q kq)))
(theorem compound ((p (Prod Nat Nat)) (q (Prod Nat Nat)) (kq (= q (bump p))))
  (= (Prod.fst q) (Prod.fst p))
  (exact (keep (bump p) q (Eq.symm (Eq.symm kq)))))
(fn first ((l (List Nat))) (Option Nat)
  (match l
    (nil Option.none)
    ((cons a _) (Option.some a))))
(theorem tied ((n Nat) (h (= (first List.nil) (Option.some n)))) False
  (exact (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl Bool.false)))))
