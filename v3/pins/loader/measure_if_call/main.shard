;; expect: main.down pending measure
;; §8.4 (slice 3.14 rule 2; fixed at slice 3.19): a measured recursion whose `if` condition is a
;; self-call. The call stands in the condition's proposition and in its decision; it is one
;; call and one obligation — main.down.dec_1, no dec_2 (an obligation is named once per
;; statement: `twice` calls itself twice on the same argument in one scope and has one too)
(import Init InvImage.wf)
(fn down ((n Nat)) Bool
  (measure n)
  (if (= n 0) Bool.true (if (down (Nat.sub n 1)) Bool.true Bool.false)))
;; a self-call in a branch under a self-call condition: its obligation is stated without the
;; branch's hypothesis `down2 (n - 1) = true`, which states the function's own value and
;; cannot stand in a closed statement (it was dec_2 fvar_in_type)
(fn down2 ((n Nat)) Bool
  (measure n)
  (if (< n 1) Bool.true (if (down2 (Nat.sub n 1)) (down2 (Nat.sub n 1)) Bool.false)))
(fn twice ((n Nat)) Nat
  (measure n)
  (if (= n 0) 0 (+ (twice (Nat.sub n 1)) (twice (Nat.sub n 1)))))
