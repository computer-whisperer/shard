;; an external proof term accepted through `exact` — one from outside the elaborator's producers:
;; Init's theorems applied (Lean's proofs through the export); each passes through the one check (K)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((n Nat)) (<= n n) (by (exact (Nat.le_refl n))))
(theorem u ((a Nat) (b Nat)) (= (+ a b) (+ b a)) (by (exact (Nat.add_comm a b))))
(theorem v ((n Nat)) (<= n (+ n 1)) (by (exact (Nat.le_succ n))))
