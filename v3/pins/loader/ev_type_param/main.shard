;; expect: ok
;; S declares a type parameter as a `(T Type)` binder (§4): not an argument — the arity is the value binders' (a recursive call saturates)
(import Init Nat)
(type (Lst T) (nil) (cons T (Lst T)))
(fn length ((T Type) (xs (Lst T))) Nat (measure (struct xs)) (match xs (nil 0) ((cons _ t) (+ 1 (length t)))))
(fn two () Nat (length (cons 1 (cons 2 nil))))
