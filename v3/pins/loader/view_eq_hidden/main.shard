;; expect: read-error unknown_constant
;; roots: main.shard lib
;; §8.5: a consumer's environment holds the view's parameter, never the implementation's
;; definition or its equations — lib.step.eq_1 does not exist here (the requirement is the lemma)
(import Init Int.decEq)
(import "lib")
(use lib)
(theorem t ((n Nat)) (Eq.{1} Nat (step n) (Nat.add n 1)) (exact (step.eq_1 n)))
