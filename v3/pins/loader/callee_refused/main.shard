;; expect: main.outer refuses callee_undeclared
;; a function that calls a refused one does not read: it is refused with the callee named, and
;; so is what calls it — never a program that calls a function with no declaration
(fn outer ((n Nat)) Nat (Nat.add 1 (inner n)))
(fn inner ((n Nat)) Nat (Nat.add 1 (wrong n)))
(fn wrong ((n Nat)) Nat (Nat.add n "one"))
