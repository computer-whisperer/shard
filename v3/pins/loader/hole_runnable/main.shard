;; expect: main.count.at_nil hole [(xs : (List Nat)) ⊢ Nat]
;; a function with a hole that calls itself without a measure: a program without a definition,
;; as it would be without the hole, and the hole is its program's extern — HOLE, then RUNNABLE
(use Init.List cons nil)
(fn count ((xs (List Nat))) Nat
  (match xs
    (nil (hole at_nil))
    ((cons x r) (+ 1 (count r)))))
