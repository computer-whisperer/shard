;; expect: main.run runnable no_l_identity
;; an E-first body that takes an instance builds it as a program with no generated definition.
;; `run` is E-first through `tag`, a fn over a Symbol (E only — the symbol it passes has no L
;; form, `no_l_identity`), and takes the template `mapi` at the named fn `digit`: INSTANCE
;; main.main_mapi.of.main_digit_0 … equations= (none), RUNNABLE fn main.run why=no_l_identity
;; route=e_first (kernel/test/template_test.sh reads both).
(import Init Int.decEq)
(fn mapi ((f (-> Int Int)) (xs (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (List.nil List.nil)
    ((List.cons x t) (List.cons (f x) (mapi f t)))))
(fn digit ((n Int)) Int (+ 48 n))
(fn tag ((s Symbol)) Nat 0)
(fn run ((xs (List Int))) (List Int)
  (match (tag (quote x))
    (_ (mapi digit xs))))
