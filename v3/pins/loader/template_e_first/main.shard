;; expect: ok
;; §8.4 slice 3.28 rule 3's last sentence (landing 3): a template called in a body with no L
;; reading — `main` performs an extern — takes an instance with a program and no generated
;; definition: INSTANCE main.main_twice.of.main_inc_0 … equations= (none), and the polymorphic
;; `mapi` at Int, main.main_mapi_Int.of.main_inc_0, its type argument read off the arguments'
;; E types. The static arguments are a fn by name (`inc`) and a named partial application
;; (`(addk k)`, k captured as the instance's leading parameter); a lambda, a registry constant or
;; a polymorphic fn here is refused with its pointer (read_static_arg).
(import Init Int.add)
(use Init.List cons nil)
(type World (World Nat))
(extern put ((n Int) (w World)) World)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(fn inc ((x Int)) Int (+ x 1))
(fn addk ((k Int) (x Int)) Int (+ x k))
(fn mapi ((a Type) (f (-> a a)) (xs (List a))) (List a) (measure (struct xs))
  (match xs (nil List.nil) ((cons x t) (List.cons (f x) (mapi f t)))))
(fn first ((xs (List Int))) Int (match xs (nil 0) ((cons x _) x)))
(fn main ((k Int) (w World)) World (put (+ (twice inc 1) (+ (twice (addk k) 2) (first (mapi inc (cons k nil))))) w))
