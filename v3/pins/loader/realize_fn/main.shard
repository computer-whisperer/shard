;; expect: main.id2 refused no_l_meaning
;; a RUNNABLE fn has no L meaning: a realization cannot call it. `helper` is one here — its
;; definition needs more of Init than this file's import reaches
(import Init Bool.casesOn)
(fn helper ((xs (List Nat)) (n Nat)) (List Nat)
  (measure n)
  (if (Nat.ble n 0) xs (helper xs (Nat.sub n 1))))
(def id2 ((xs (List Nat))) (List Nat) xs)
(realize id2 ((xs (List Nat))) (List Nat) (helper xs 0))
