;; expect: main.id2 refused no_l_meaning
;; a RUNNABLE fn has no L meaning (§0; under Stage 1 one with an obstacle, §8.4 rule 1 — here a
;; an `if` on a Bool where `ite` is past the Init prefix, so the body has no L identity): a
;; realization cannot call it
(import Init Bool.casesOn)
(fn helper ((xs (List Nat)) (n Nat)) (List Nat) (measure n) (if (Nat.ble n 0) xs (helper xs (Nat.sub n 1))))
(def id2 ((xs (List Nat))) (List Nat) xs)
(realize id2 ((xs (List Nat))) (List Nat) (helper xs 0))
