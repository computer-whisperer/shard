;; expect: main.sum linked c.fc_is,c.fc
;; roots: main.shard a
;; link: yes
;; a consumer of two modules linked with one of them: the theorem enters the linked
;; environment with `a`'s names as `a`'s implementation and `c`'s as the parameters they are,
;; and rests on those still
(import "a")
(import "c")
(use a)
(use c)
(theorem sum () (= (+ fa fc) 3) (by (rw fa_is) (rw fc_is) rfl))
