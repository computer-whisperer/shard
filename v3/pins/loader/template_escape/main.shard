;; expect: main.bad_let refused function_value
;; §8.4 slice 3.28 rule 2, the escape rule at the erasure's refusal sites: a lambda anywhere but
;; as a template's static argument — here a let's value — is function_value with the pointer
;; (law §4.3); on the E-first route a lambda or a function type is the same refusal.
(import Init Int.add)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(fn bad_let ((x Int)) Int (let ((h (fun ((y Int)) (+ y 1)))) (h x)))
