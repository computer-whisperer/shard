;; expect: main.main threaded
;; a helper threading correctly: it takes the token, returns it inside a pair, and the caller
;; unwraps that pair once; a recursive helper consumes and yields along its one path
(import Init String.toByteArray)
(type World (World Nat))
(extern get_args ((w World)) (Prod (List ByteArray) World))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn ask ((w World)) (Prod (List ByteArray) World) (get_args w))
(fn echo ((xs (List ByteArray)) (w World)) World (measure (struct xs))
  (match xs
    (List.nil w)
    ((List.cons x t) (echo t (write_line x w)))))
(fn main ((w World)) World
  (match (ask w) ((Prod.mk xs w1) (echo xs w1))))
