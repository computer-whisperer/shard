;; expect: read-error unfold_stuck
;; §8.4 slice 3.20 rule 6: unfold where no equation of the constant matches an occurrence —
;; a structural function at a variable (cases on it first)
(import Init InvImage.wf)
(fn len ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs (List.nil 0) ((List.cons _ r) (+ (len r) 1))))
(theorem t ((xs (List Nat))) (= (len xs) (len xs)) (by (unfold len) rfl))
