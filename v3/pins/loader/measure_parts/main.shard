;; expect: ok
;; a measure of two parts, compared part by part: a call may refill the list when the counter
;; falls (the first part decides: `Prod.Lex.left`), and walks the list with the counter as it
;; is (the first part holds, the second falls: `Prod.Lex.right'`). `(measure k (List.length
;; xs))` is the pair `(Prod.mk k (List.length xs))`; `refill` writes the pair out. The function
;; is reasoned about by its equations: K does not evaluate through a call of it
(use Init.List cons nil)
(fn drain ((k Nat) (xs (List Nat))) Nat
  (measure k (List.length xs))
  (match xs
    (nil (if (< 0 k) (drain (Nat.sub k 1) (cons 1 (cons 2 nil))) 0))
    ((cons x r) (+ x (drain k r)))))
(fulfills drain.dec_1
  (by (intro p hx hk) (apply Prod.Lex.left (exact (Nat.sub_lt hk (Nat.lt_succ_self 0))))))
(fulfills drain.dec_2
  (by (intro p x r h) (rw h) (rw List.length_cons) (apply Prod.Lex.right' (arith) (arith))))
(theorem drain_done () (= (drain 0 nil) 0) (by rfl))
(theorem drain_step ((k Nat) (x Nat) (r (List Nat))) (= (drain k (cons x r)) (+ x (drain k r)))
  (by (rw drain.eq_2) rfl))
(fn refill ((k Nat) (xs (List Nat))) Nat
  (measure (Prod.mk k (List.length xs)))
  (match xs
    (nil 0)
    ((cons x r) (+ x (refill k r)))))
(fulfills refill.dec_1
  (by (intro p x r h) (rw h) (rw List.length_cons) (apply Prod.Lex.right' (arith) (arith))))
