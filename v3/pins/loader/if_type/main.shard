;; expect: main.tri refused if_type
;; an `if` on a three-constructor type (§6.2; GPT-6 R56): the binary rule is not inherited by ordinal parity —
;; before slice 10 `Tri.B` took the then-branch and `Tri.C` the else-branch, silently
(import Init Nat)
(type Tri (A) (B) (C))
(fn tri ((x Tri)) Nat (if x 1 0))
