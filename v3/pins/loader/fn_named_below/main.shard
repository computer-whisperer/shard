;; expect: ok
;; a function may bear the last name component of a constant generated for an inductive type
;; or a recursion — `below`, `brecOn`, `fix`, `casesOn` —: its callers are erased as any call
;; is and keep their definitions. Only `T.below`, `T.brecOn` and `T.casesOn` of an inductive
;; T, and Init's fixpoints, are read as what the generator made
(import Init Int.decEq)
(fn below ((n Nat)) Nat (+ n 1))
(fn brecOn ((n Nat)) Nat (+ n 2))
(fn fix ((n Nat)) Nat (+ n 3))
(fn casesOn ((n Nat)) Nat (+ n 4))
(fn caller ((n Nat)) Nat (+ (below n) (+ (brecOn n) (+ (fix n) (casesOn n)))))
(theorem caller_one () (= (caller 1) 14) (by rfl))
