;; expect: main.hello bad-bin bad_entry
;; the entry takes the World last and checked parameters before it. `main` returns a Nat and takes
;; no World: BAD-BIN main.hello bad_entry: main.main does not take a World last
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn main ((n Nat)) Nat n)
(theorem main_total ((n Nat)) (= (main n) (main n)) (exact (Eq.refl (main n))))
(bin hello (entry main) (externs write_line) (trusts) (requires main_total))
