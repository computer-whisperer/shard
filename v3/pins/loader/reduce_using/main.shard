;; expect: ok
;; §8.4, the run with its facts: (reduce SIDE? (using RULE…)) runs the target as reduce does
;; and rewrites by the facts given where their left sides stand — at each subterm a rule before
;; a step. A function a fact's left side applies is held: its equations wait while anything
;; else steps, so a call a fact speaks of keeps its form while its argument reaches the form the
;; fact states, and the fact rewrites the call's result in.
(import Init WellFounded.fix_eq)
(type T (A Nat))
(fn f ((t T) (y Nat)) Nat (match t ((A n) (+ n y))))
(fn wr ((x Nat)) Nat (match x (0 7) (_ x)))
;; a fact about a call. Run, the call is (+ 1 (% b 10)) and the fact has nothing to match
(theorem direct ((b Nat) (k Nat) (hb (= (% b 10) b)) (h (= (f (A 1) b) k)))
  (= (wr (f (A 1) (% b 10))) (wr k))
  (by (reduce lhs (using hb h)) rfl))
;; the call under another function in the fact's left side: both are held (held at the left
;; side's head alone, `f` was run before its argument was rewritten and the fact never fired)
(theorem wrapped ((b Nat) (k Nat) (hb (= (% b 10) b)) (h (= (wr (f (A 1) b)) k)))
  (= (wr (f (A 1) (% b 10))) k)
  (by (reduce lhs (using hb h)) rfl))
;; a lemma given its premise decides a case analysis; the rest computes
(theorem premise ((a Nat) (h (< a 5)))
  (= (f (A 2) (if (< a 5) 3 4)) 5)
  (by (reduce lhs (using (if_pos h))) rfl))
;; a reversed rule, and no side named: both sides run
(theorem reversed ((b Nat) (k Nat) (h (= k (f (A 1) b))))
  (= (wr (f (A 1) b)) (wr k))
  (by (reduce (using (<- h))) rfl))
