;; expect: ok
;; a group is found, not declared. `top` waits on `ping`; `ping` waits on `pong`, and on
;; `later`, a forward reference that is no cycle; the group closes only when `later` is read —
;; its two members are then one definition and `top` an ordinary one
(import Init UInt8.toNat)
(use Init.Bool)
(fn top ((n Nat)) Nat (+ 1 (ping n)))
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) (later 0) (pong (Nat.sub n 1))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 1 (ping (Nat.sub n 1))))
(fn later ((n Nat)) Nat (+ n 7))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem top_two () (= (top 2) 8) (by rfl))
