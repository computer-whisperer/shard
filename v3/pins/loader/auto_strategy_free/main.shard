;; expect: ok
;; §8.6 slice 4.5 rule 1: the key is the requirement, not the strategy — the sidecar's entry
;; was made for (theorem t ((x Int) (y Int) (h1 (<= 0 x)) (h2 (<= x y))) (<= 0 y) auto); the
;; source now names its binders a and b and delegates (auto (budget 1)): binder names are
;; outside the statement's fingerprint (law §7.5: display names are no part of identity) and
;; the hints are the producer's, so the entry fits and replays unchanged, the build never
;; searching
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((a Int) (b Int) (h1 (<= 0 a)) (h2 (<= a b))) (<= 0 b) (auto (budget 1)))
