;; expect: ok
;; an arm that mentions the matched parameter itself: the substitution reaches the body's environment (§7.5)
(import Init Bool.casesOn)
(def keep ((a Type) (xs (List a))) (List a) xs)
(realize keep ((a Type) (xs (List a))) (List a) (match xs (List.nil xs) ((List.cons x t) (List.cons x t))))
