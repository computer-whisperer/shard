;; expect: ok
;; a projection function is its projection. Span.lo is a constant whose value is λ self. self.1;
;; in a `fn` body it erases as the match on Span.mk
(import Init Int.decEq)
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(fn lo2 ((s Span)) Nat (Span.lo s))
(fn width ((s Span)) Nat (Nat.sub (Span.hi s) (Span.lo s)))
(theorem lo2_mk ((a Nat) (b Nat) (h (Nat.le a b))) (= (lo2 (Span.mk a b h)) a) (exact (Eq.refl a)))
