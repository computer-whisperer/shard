;; expect: load-error late_init_import
;; a file import after a declaration that would bring Init into a file that sees none: the
;; declarations before it were read without Init, so the import is refused, as a late
;; `(import Init)` is
(type Color (Red) (Green))
(fn pick ((c Color)) Color c)
(import "far.shard")
(theorem t () (Eq Int Int) (exact (Eq.refl Int)))
