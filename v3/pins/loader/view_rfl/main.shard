;; expect: read-error type_mismatch
;; roots: main.shard lib
;; K cannot unfold a view's parameter — a consumer's Eq.refl through the implementation's body
;; is refused (by the elaborator, whose unifier asks K's is_def_eq over the consumer's
;; environment, where step is opaque); the requirement step_pos is what a consumer cites
;; (view_basic)
(import Init Int.decEq)
(import "lib")
(use lib)
(theorem t ((n Nat)) (Eq (step n) (Nat.add n 1)) (exact (Eq.refl (Nat.add n 1))))
