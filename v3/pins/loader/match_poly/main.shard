;; expect: ok
;; slice 3.16 rule 1: the matcher abstracts the binders its scrutinee's type mentions — `a` is
;; main.head_or.match_1's parameter
(import Init Int.decEq)
(use Init.List)
(def head_or ((a Type) (xs (List a)) (d a)) a (match xs (nil d) ((cons x t) x)))
(theorem head_or_cons ((a Type) (x a) (t (List a)) (d a)) (= (head_or a (cons x t) d) x) (exact (Eq.refl x)))
