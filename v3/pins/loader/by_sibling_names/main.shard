;; expect: ok
;; §8.4 slice 3.29 rule 7 (law §12.5's T10 row): reused local names in sibling branches — two
;; arms naming the same field and the same `have`, each filling closing over its own locals; a
;; goal is scope-safe by construction (an arm opens fresh locals, display names are the binders')
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((b Bool) (c Bool)) (= (and b c) (and c b))
  (by (cases b
        ((false ()
           (cases c ((false () (have h (= Bool.false Bool.false) rfl) (decide))
                     (true () (have h (= Bool.true Bool.true) rfl) (decide)))))
         (true ()
           (cases c ((false () (have h (= Bool.false Bool.false) rfl) (decide))
                     (true () (have h (= Bool.true Bool.true) rfl) (decide)))))))))
(theorem u ((n Nat)) (<= 0 n)
  (by (cases n ((zero () (have h (= Nat.zero Nat.zero) rfl) (decide))
                (succ (k) (have h (= Nat.zero Nat.zero) rfl) (exact (Nat.zero_le (Nat.succ k))))))))
