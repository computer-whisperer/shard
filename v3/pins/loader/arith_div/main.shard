;; expect: ok
;; §8.4 slice 3.21 rules 4 and 5: a product with a literal is linear (m1, m2: LinearCombo's
;; mul_eval_of_const_left/right, line 271,373 of the export), and so are the quotient and the
;; remainder by a positive literal — `x / k` is an atom that brings k * (x / k) ≤ x and x < k *
;; (x / k) + k, `x % k` is x - k * (x / k) — as in omega and as v2's div-facts gave them. The
;; file imports through the quotient's bounds (line 274,616).
(import Init Int.lt_mul_ediv_self_add)
(theorem m1 ((a Int)) (= (* a 10) (* 10 a)) (by arith))
(theorem m2 ((x Int) (h (< x 10))) (<= (* 10 x) 90) (by arith))
(theorem d1 ((n Int) (h (Not (< n 10)))) (< (Int.ediv n 10) n) (by arith))
(theorem d2 ((n Int) (h (<= 0 n))) (<= 0 (Int.ediv n 10)) (by arith))
(theorem d3 ((n Int)) (= (+ (* 10 (Int.ediv n 10)) (Int.emod n 10)) n) (by arith))
(theorem d4 ((n Int)) (<= 0 (Int.emod n 10)) (by arith))
(theorem d5 ((n Int)) (<= (Int.emod n 10) 9) (by arith))
;; a Nat product
(theorem m3 ((a Nat) (b Nat) (h (<= (* 2 a) b))) (<= a b) (by arith))
