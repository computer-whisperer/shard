;; expect: read-error unknown_constant
;; roots: seer.shard main.shard
;; a file that sees no Init is given nothing that is built of Init, whatever another root of
;; the load fetched: seer.shard, loaded first, brings Init's Eq into the environment, and
;; `pick` here still has no equation — `pick.eq_1` names nothing — as when this file is
;; loaded alone
(type Color (Red) (Green))
(fn pick ((c Color)) Color c)
(def probe () Color pick.eq_1)
