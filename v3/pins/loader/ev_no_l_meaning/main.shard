;; expect: read-error unknown_constant
;; a fn with an obstacle to L meaning — here a numeral under a constructor pattern, which has no
;; form in the logic, so the body has no L identity (route=e_first) — is RUNNABLE only; a theorem
;; citing it finds no constant
(fn f ((n Nat)) Nat
  (match (List.cons n List.nil)
    ((List.cons 0 _) 0)
    (_ 1)))
(theorem t () (Eq (f Nat.zero) (f Nat.zero)) (exact (Eq.refl (f Nat.zero))))
