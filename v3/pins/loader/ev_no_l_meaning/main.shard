;; expect: read-error unknown_constant
;; R45, under Stage 1 (§8.4 rule 1): a fn with an obstacle to L meaning — here a measure other than
;; struct, slice 3.14's — is RUNNABLE only; a theorem citing it finds no constant
(import Init Eq)
(fn f ((n Nat)) Nat (measure n) n)
(theorem t () (Eq (f Nat.zero) (f Nat.zero)) (exact (Eq.refl (f Nat.zero))))
