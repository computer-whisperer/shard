;; expect: read-error unknown_constant
;; R45, under Stage 1 (§8.4 rule 1): a fn with an obstacle to L meaning — here an `if` on a Bool
;; where `ite` is past the Init prefix, so the body has no L identity (slice 3.16 rule 6:
;; route=e_first) — is RUNNABLE only; a theorem citing it finds no constant
(import Init Eq)
(fn f ((n Nat)) Nat (measure n) (if (Nat.ble n 0) 0 (f (Nat.sub n 1))))
(theorem t () (Eq (f Nat.zero) (f Nat.zero)) (exact (Eq.refl (f Nat.zero))))
