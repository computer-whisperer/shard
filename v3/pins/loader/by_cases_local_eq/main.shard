;; expect: ok
;; §8.4 slice 3.20 (found by its second reader): `(cases X H …)` on a local keeps X in each
;; arm's context — H : X = CTOR … names it — where a split without H drops it; and a case
;; analysis on a decision (`Nat.decEq n 0`) gives each arm the proposition or its negation
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem t ((b Bool) (n Nat)) (= b b)
  (by (cases b hb ((false () rfl) (true () rfl)))))
(theorem u ((n Nat)) (<= 0 n)
  (by (cases (Nat.decEq n 0) ((isFalse (h) arith) (isTrue (h) arith)))))
