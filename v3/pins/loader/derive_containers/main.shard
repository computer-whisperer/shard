;; expect: ok
;; §8.4 slice 3.19 rules 1 and 6: Init's List, Option and Prod at closed arguments — each
;; instantiation its own first-order function under the mangled name (List_Tok.decEq), because
;; E has no function values — and a type whose fields are those: Line's decision calls
;; List_Tok.decEq, Option_Tok.decEq and Prod_Nat_Tok.decEq, which the DERIVE record names
(import Init List.cons.inj)
(type Tok (TNum Nat) (TPlus))
(derive Tok eq)
(derive (List Tok) eq)
(derive (Option Tok) eq)
(derive (Prod Nat Tok) eq)
;; a container of a container: `(@List.nil (Prod Nat Tok))` needs `Type ?u` met by Prod's
;; `Sort (max 1 1)` — a closed level is compared in normal form
(derive (List (Prod Nat Tok)) eq)
;; a definition that stands for a type is the type: the entry's key is the normal form
(def Key () Type Nat)
(derive (List Key) eq)
(fn same_keys ((a (List Nat)) (b (List Nat))) Nat (if (= a b) 1 0))
(type Line (Line (List Tok) (Option Tok) (Prod Nat Tok)))
(derive Line eq)
(fn same ((a Line) (b Line)) Nat (if (= a b) 1 0))
(theorem same_1 ()
  (= (same (Line (List.cons TPlus List.nil) (Option.some (TNum 1)) (Prod.mk 2 TPlus)) (Line (List.cons TPlus List.nil) (Option.some (TNum 1)) (Prod.mk 2 TPlus))) 1)
  (exact (Eq.refl 1)))
(theorem same_0 ()
  (= (same (Line (List.cons TPlus List.nil) Option.none (Prod.mk 2 TPlus)) (Line (List.cons TPlus List.nil) (Option.some (TNum 1)) (Prod.mk 2 TPlus))) 0)
  (exact (Eq.refl 0)))
