;; expect: ok
;; the code and a proof about it in one sidecar: the fn's holes are filled from its `fill-for`
;; entry, and the theorem's `auto` block — found for the fn with that code — is replayed from
;; its `proof-for` entry. Neither is in the source; the source states the fn's shape and the
;; theorem
(use Init.List cons nil)
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (match xs
    (nil ys)
    ((cons x r) (hole at_cons))))
(theorem app_nil ((xs (List Nat))) (= (app xs nil) xs) auto)
