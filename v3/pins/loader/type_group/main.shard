;; expect: ok
;; two types that name each other — a term holding a list of arms, an arm holding a term —
;; enter K as one block, where the first of them stands. Each has its record, its casesOn
;; and its constructors' injectivity; a function matching on either is a definition, and a
;; `def` and theorems cite them (type_in_logic is the same for one type)
(use Init.List cons nil)
(type T (TLeaf Int) (TNode (List A)))
(type A (MkA Int T))
(fn t_tag ((t T)) Int
  (match t
    ((TLeaf k) k)
    ((TNode _) 0)))
(fn a_tag ((a A)) Int
  (match a
    ((MkA k _) k)))
(def one () T (TNode (cons (MkA 1 (TLeaf 2)) nil)))
(theorem a_tag_one () (= (a_tag (MkA 1 (TLeaf 2))) 1) (by rfl))
(theorem leaf_inj ((a Int) (b Int) (h (= (TLeaf a) (TLeaf b)))) (= a b) (exact (T.TLeaf.inj h)))
(theorem arm_inj ((a Int) (b Int) (t T) (h (= (MkA a t) (MkA b t)))) (= a b)
  (exact (And.left (A.MkA.inj h))))
