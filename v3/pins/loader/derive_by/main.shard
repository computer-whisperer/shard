;; expect: main.derive refused derive_by
;; §8.4 slice 3.19 rule 1: `(eq by NAME)` registers a procedure the file wrote, after its type
;; is checked against the capability's — (a b : Tok) → Decidable (a = b). `always` decides
;; another proposition; `Tok.same` has the type and is registered (the `if` below uses it)
(import Init Int.decEq)
(type Tok (TPlus))
(fn Tok.same ((a Tok) (b Tok)) (Decidable (= a b))
  (match a (TPlus (match b (TPlus (Decidable.isTrue rfl))))))
(type Unit2 (U2))
(derive Unit2 eq)
(derive Tok (eq by Tok.same))
(fn one ((a Tok) (b Tok)) Nat (if (= a b) 1 0))
(theorem one_is () (= (one TPlus TPlus) 1) (exact (Eq.refl 1)))
(type Other (O1) (O2))
(fn always ((a Other) (b Other)) (Decidable (= a a)) (Decidable.isTrue rfl))
(derive Other (eq by always))
