;; expect: ok
;; §8.4 slice 3.28 rule 3(b): a named partial application `(addk 3)` as a static argument — the
;; shape main.addk/1, the value 3 captured as the instance's leading parameter and never part of
;; the key: `(addk 3)` and `(addk k)` take the same instance main.main_twice.of.main_addk_1.
(import Init Int.add)
(fn twice ((f (-> Int Int)) (x Int)) Int (f (f x)))
(fn addk ((k Int) (x Int)) Int (+ x k))
(fn add6 ((x Int)) Int (twice (addk 3) x))
(fn add2k ((k Int) (x Int)) Int (twice (addk k) x))
(theorem add6_eq ((x Int)) (= (add6 x) (+ (+ x 3) 3)) (by (unfold add6) (unfold twice) (unfold addk) rfl))
