;; expect: ok
;; roots: main.shard lib
;; a view's signature with a parameter whose type is a proposition over an earlier one: the
;; consumer writes the proof at the call, its program passes none, and its theorem rests on the
;; view's parameters
(import "lib")
(use lib)
(theorem three_pos () (< 0 3) (by decide))
(fn two () Nat (before 3 three_pos))
(theorem two_next () (= (+ two 1) 3) (by (rw two.eq_1) (exact (before_next 3 three_pos))))
