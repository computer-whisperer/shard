;; expect: main.f runnable no_l_meaning
;; roots: main.shard lib
;; a callee that is a view's sig fn whose signature has no L reading (Symbol) is not in K's
;; environment. The caller's signature reads, its body cannot: E-first, and the obstacle is the
;; callee's missing L meaning — not a missing identity of the caller's own
(import Init Int.decEq)
(import "lib")
(use lib)
(fn f ((n Int)) Int (size_of (tag_of n)))
