;; expect: main.pick.hole_1 hole [(ys : (List Nat)) (x : Nat) (r : (List Nat)) (m : Nat) (h : (< 0 m)) ⊢ Nat]
;; what a hole is handed: every name visible where it stands, in the order bound. The
;; parameter `x` is hidden by the row's `x` and is not handed; a let-bound name is (its value
;; the argument); so is a hypothesis. An unnamed hole is hole_K under its function
(use Init.List cons nil)
(fn pick ((x Nat) (ys (List Nat))) Nat
  (match ys
    (nil x)
    ((cons x r) (let ((m Nat (+ x 1))) (dif h (< 0 m) (hole) 0)))))
