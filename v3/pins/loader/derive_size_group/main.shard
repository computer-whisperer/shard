;; expect: ok
;; `(derive TYPE size)` on a type of a block — types that name each other: each type of the block
;; has its size from its own recursor (`T.size` from `T.rec`, `A.size` from `A.rec`) and an
;; auxiliary type its from the block's first type's (`List_A.size` from `T.rec_1`), whichever
;; type of the block the form names — here the second. The three walkers are a group measured
;; by the three sizes, an obligation each call (derive_test.sh reads the records)
(use Init.List cons nil)
(type T (TLeaf Int) (TNode (List A)))
(type A (MkA Int T))
(derive A size)
(fn leaves ((t T)) Nat
  (measure (T.size t))
  (match t
    ((TLeaf _) 1)
    ((TNode as) (leaves_all as))))
(fn leaves_of ((a A)) Nat
  (measure (A.size a))
  (match a
    ((MkA _ t) (leaves t))))
(fn leaves_all ((as (List A))) Nat
  (measure (List_A.size as))
  (match as
    (nil 0)
    ((cons a r) (+ (leaves_of a) (leaves_all r)))))
(fulfills leaves.dec_1 (by (intro t as h) (rw h) (rw T.size.eq_2) (arith)))
(fulfills leaves_of.dec_1 (by (intro a w t h) (rw h) (rw A.size.eq_1) (arith)))
(fulfills leaves_all.dec_1 (by (intro as a r h) (rw h) (rw List_A.size.eq_2) (arith)))
(fulfills leaves_all.dec_2 (by (intro as a r h) (rw h) (rw List_A.size.eq_2) (arith)))
(theorem leaves_two () (= (leaves (TNode (cons (MkA 0 (TLeaf 1)) (cons (MkA 0 (TLeaf 2)) nil)))) 2)
  (by rfl))
