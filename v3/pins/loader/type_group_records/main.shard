;; expect: ok
;; a group through records: a module holding an optional fork point, the state holding the
;; modules, the fork point holding the state. The accessors a record brings stand between
;; the types of the group, and are definitions over them all the same: the group is
;; admitted where its first type stands
(use Init.List cons nil)
(use Init.Option none some)
(record M (id Int) (fork (Option F)))
(record L (mods (List M)) (n Int))
(type F (MkF L Int))
(fn l_count ((l L)) Int (L.n (with L l (n 3))))
(fn f_n ((x F)) Int
  (match x
    ((MkF l k) (+ k (L.n l)))))
(fn m0 () M (make M (id 1) (fork none)))
(theorem m0_id () (= (M.id (m0)) 1) (by rfl))
