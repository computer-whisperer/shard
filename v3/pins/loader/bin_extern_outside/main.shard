;; expect: main.hello bad-bin extern_outside
;; §8.6 slice 4.3 landing 1 (rule 4): the roster is every extern the entry's E closure
;; calls. `main` calls `exit` through `finish`, which the roster lacks: BAD-BIN main.hello
;; extern_outside: main.exit is called in main.finish and is not in the roster
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(extern exit ((code Int) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn finish ((w World)) World (exit 0 w))
(fn main ((w World)) World (finish (write_line (text "hello") w)))
(theorem main_total ((w World)) (= (main w) (main w)) (exact (Eq.refl (main w))))
(bin hello (entry main) (externs write_line) (trusts) (requires main_total))
