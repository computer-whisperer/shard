;; expect: ok
;; a function defined by a measure may take evidence about its parameters: the parameters of
;; the recursion are packed with each later type over the earlier ones (Lean's packing of a
;; recursion's domain), so the body uses the evidence at the tuple's own components and a
;; call hands on evidence about its own arguments. `walk` is a loop over an index below a
;; bound; `mid` has the evidence between its data; `plain` evidence that names no parameter
;; (a proposition in an ordinary pair); `two` descends in two parts
(fn room ((n Nat) (k Nat) (h (<= k n))) Nat (- n k))
(fn walk ((n Nat) (k Nat) (hk (<= k n))) Nat
  (measure n)
  (if (= n 0) (room n k hk) (walk (- n 1) 0 (Nat.zero_le (- n 1)))))
(fn mid ((n Nat) (hn (<= 0 n)) (k Nat)) Nat
  (measure n)
  (if (= n 0) k (mid (- n 1) (Nat.zero_le (- n 1)) (+ k 1))))
(fn plain ((n Nat) (h (<= 0 0))) Nat (measure n) (if (= n 0) 0 (plain (- n 1) h)))
(fn two ((n Nat) (k Nat) (hk (<= k n))) Nat
  (measure n k)
  (if (= k 0) (if (= n 0) 0 (two (- n 1) (- n 1) (Nat.le_refl (- n 1))))
  (two n (- k 1) (Nat.le_trans (Nat.sub_le k 1) hk))))
(fulfills walk.dec_1 (by (intro p h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills mid.dec_1 (by (intro p h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills plain.dec_1 (by (intro p h) (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one))))
(fulfills two.dec_1
  (by
    (intro p h)
    (apply Prod.Lex.right (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one)))))
(fulfills two.dec_2
  (by
    (intro p hk h)
    (apply Prod.Lex.left (arith (Nat.sub_lt (Nat.pos_of_ne_zero h) Nat.zero_lt_one)))))
(theorem walk_zero () (= (walk 0 0 (Nat.le_refl 0)) 0) (by rfl))
(theorem walk_two () (= (walk 2 1 (Nat.le_succ 1)) 0) (by rfl))
(theorem mid_three () (= (mid 3 (Nat.zero_le 3) 0) 3) (by rfl))
