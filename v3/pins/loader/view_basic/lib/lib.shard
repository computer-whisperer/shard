;; the implementation: the concrete Stack (a count), the fns as E bodies over it, the law proved
(import Init Eq)
(type Stack (mk Nat))
(fn empty () Stack (Stack.mk 0))
(fn push ((n Nat) (s Stack)) Stack (match s ((Stack.mk k) (Stack.mk (+ k 1)))))
(fulfills stack_refl (exact (Eq.refl.{1} Stack s)))
