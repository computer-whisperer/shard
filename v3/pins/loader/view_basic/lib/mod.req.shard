;; the view: an opaque Stack, its operations as signatures, a law, a public theorem resting on the law
(import Init Eq)
(sig type Stack)
(sig fn empty () Stack)
(sig fn push ((n Nat) (s Stack)) Stack)
(requirement stack_refl ((s Stack)) (Eq.{1} Stack s s))
(theorem push_refl ((n Nat) (s Stack)) (Eq.{1} Stack (push n s) (push n s)) (exact (stack_refl (push n s))))
