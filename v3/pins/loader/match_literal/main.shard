;; expect: read-error literal_pattern
;; a row that is a numeral is read (pin literal_pattern); a numeral under a constructor has no L
;; form — the matcher's rows are constructor patterns — and the pointer is to bind the field
;; and compare with an if
(import Init Int.decEq)
(def head_is_zero ((xs (List Nat))) Nat
  (match xs
    ((List.cons 0 _) 1)
    (_ 0)))
