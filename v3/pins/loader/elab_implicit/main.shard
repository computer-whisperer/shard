;; expect: ok
;; slice 3.15 (LANGUAGE.md §5.1, §8.4): implicit arguments and universes inferred, law §5.1–5.2.
;; List.append, List.cons and Eq cited bare; Eq.refl's implicit from the expected type, Or.inl's
;; from the statement; a polymorphic constant at its inferred level (List Type at level 1);
;; @ for the explicit application; exists as a binder form
(import Init Int.decEq)
(def one () Nat 1)
(theorem app_nil ((xs (List Nat))) (Eq (List.append List.nil xs) xs) (exact (Eq.refl xs)))
(theorem cons_eq ((x Nat) (t (List Nat))) (= (List.cons x t) (List.cons x t)) (exact (Eq.refl (List.cons x t))))
(theorem or_l ((p Prop) (q Prop)) (-> p (or p q)) (exact (fun ((h p)) (Or.inl h))))
(theorem at_explicit () (@Eq.{1} Nat one one) (exact (@Eq.refl.{1} Nat one)))
(theorem ex () (exists ((n Nat)) (= n one)) (exact (Exists.intro one (Eq.refl one))))
(def types () (List Type) (List.cons Nat List.nil))
