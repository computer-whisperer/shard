;; expect: ok
;; §8.4 slice 3.17 rule 4: make and with reach a structure of the file — the L form whose later
;; fields' types may mention earlier ones. make is Span.mk on the values in field order; with is
;; Span.mk on each field's entry or its projection of the subject. Updating `hi` with its
;; dependent `ok` supplied is accepted, and the fields kept are the subject's (Eq.refl)
(import Init Int.decEq)
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(def unit () Span (make Span (hi 1) (ok (Nat.le.refl)) (lo 1)))
(def widen ((s Span) (h Nat) (p (Nat.le (Span.lo s) h))) Span (with Span s (hi h) (ok p)))
(theorem widen_lo ((s Span) (h Nat) (p (Nat.le (Span.lo s) h))) (= (Span.lo (widen s h p)) (Span.lo s)) (exact (Eq.refl (Span.lo s))))
(theorem widen_hi ((s Span) (h Nat) (p (Nat.le (Span.lo s) h))) (= (Span.hi (widen s h p)) h) (exact (Eq.refl h)))
