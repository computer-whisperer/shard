;; expect: ok
;; §8.4 (slice 4.2 landing 0): a def with a recursion clause recurses structurally — the fn
;; pipeline's K half alone: a definition with its equations and no program. A specification
;; over data into Prop; the theorem unfolds its cons equation, which a RUNNABLE def would not have.
(import Init Nat.sub_one_lt)
(def allz ((xs (List Nat))) Prop (measure (struct xs))
  (match xs (List.nil True) ((List.cons x t) (And (= x 0) (allz t)))))
(theorem allz_cons ((x Nat) (t (List Nat))) (-> (allz (List.cons x t)) (= x 0))
  (by (unfold allz) (intro h) (exact (And.left h))))
(def addr_ok ((ws (List Nat)) (a Nat)) Prop (measure (struct ws))
  (match ws (List.nil True) ((List.cons w rest) (And (= w a) (addr_ok rest (+ a 8))))))
(theorem addr_ok_cons ((w Nat) (rest (List Nat)) (a Nat)) (-> (addr_ok (List.cons w rest) a) (addr_ok rest (+ a 8)))
  (by (unfold addr_ok) (intro h) (exact (And.right h))))
