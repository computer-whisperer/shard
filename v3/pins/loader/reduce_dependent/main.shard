;; expect: ok
;; a rewrite's motive is checked, not only typed. `reduce` walks the value of
;; `(String.toByteArray "x")` down to `ByteArray.mk …`, and on the way a number is rewritten
;; that stands beside the proof stating it (`Fin.mk 256 v h`): no motive abstracts that
;; occurrence, the step is K-convertible, and it is left to conversion. An ill-typed motive let
;; through would have K refuse the whole certificate — `lit refused app_type_mismatch`, no step
;; named
(import Init UInt8.toNat)
(theorem lit () (= (String.toByteArray "x") (String.toByteArray "x")) (by (reduce lhs) rfl))
(theorem hyp ((b ByteArray)) (-> (= b (String.toByteArray "x")) (= (String.toByteArray "x") b))
  (by (intro h) (reduce) (rw h) rfl))
