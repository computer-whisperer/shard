;; expect: ok
;; slice 3.15: the numeral rule (law §5.2) in L — a numeral at Int is Int.ofNat, a negative one
;; Int.negSucc, a Nat where an Int is expected is coerced by Int.ofNat (the one coercion), Nat
;; where nothing decides; the operator spellings take the identity at the first operand's type
;; (+ at Int is Int.add, - at Nat is Nat.sub here: nothing runs in a statement); if is ite with
;; the decision of its proposition's head (Nat.lt → Nat.decLt); on a Bool it is cond, declared
;; past this fixture (export line 151,585), so unpinned here
(import Init Int.decEq)
(def five () Int 5)
(def minus_three () Int -3)
(theorem five_is () (= five (Int.ofNat 5)) (exact (Eq.refl five)))
(theorem m3_is () (= minus_three (Int.negSucc 2)) (exact (Eq.refl minus_three)))
(def up ((n Nat)) Int n)
(theorem up_is ((n Nat)) (= (up n) (Int.ofNat n)) (exact (Eq.refl (up n))))
(theorem add_zero ((n Nat)) (= (+ n 0) n) (exact (Eq.refl n)))
(theorem sub_self ((n Nat)) (= (- n n) (Nat.sub n n)) (exact (Eq.refl (Nat.sub n n))))
(theorem int_add ((a Int) (b Int)) (= (+ a b) (Int.add a b)) (exact (Eq.refl (Int.add a b))))
(def max2 ((a Nat) (b Nat)) Nat (if (< a b) b a))
(theorem max2_is ((a Nat) (b Nat)) (= (max2 a b) (@ite Nat (Nat.lt a b) (Nat.decLt a b) b a)) (exact (Eq.refl (max2 a b))))
(theorem lt_is ((a Nat) (b Nat)) (-> (< a b) (Nat.lt a b)) (exact (fun ((h (< a b))) h)))
