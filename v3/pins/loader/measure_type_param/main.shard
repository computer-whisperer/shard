;; expect: ok
;; a measured function with a type parameter. Its obligation is stated over the type parameter
;; first, then over what every obligation is — the data binders' tuple and the branch's proof —,
;; so the statement is closed and K takes it; the definition cites it at the function's own
;; type parameter. The second, with one data binder, has the binder under its own name
(use Init.List cons nil)
(fn rep ((V Type) (n Nat) (x V) (acc (List V))) (List V)
  (measure n)
  (if (= n 0) acc (rep (Nat.sub n 1) x (cons x acc))))
(fulfills rep.dec_1
  (by (intro V p h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
(fn blanks ((V Type) (n Nat)) (List (Option V))
  (measure n)
  (if (= n 0) nil (cons Option.none (blanks (Nat.sub n 1)))))
(fulfills blanks.dec_1
  (by (intro V n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
(theorem rep_two () (= (rep 2 7 nil) (cons 7 (cons 7 nil))) (by rfl))
