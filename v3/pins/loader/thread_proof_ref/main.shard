;; expect: main.main threaded
;; law §12.4 item 4, the erased proof reference: a reference used only in an erased proof
;; consumes nothing. `main` binds a proof about the token under a typed let — a proposition
;; vanishes at erasure (erasure.shard) — and then passes the token to the extern once; the check
;; walks the erased program and sees one use. Deferred from landing 0: until the World's L
;; meaning (slice 4.3 landing 1, rule 3) an extern-calling body was read E-first, where a proof
;; term is no E term at all
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World
  (let ((h (= w w) (Eq.refl w)))
    (write_line (text "kept") w)))
