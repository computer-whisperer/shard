;; expect: main.main threaded
;; the erased proof reference: a reference used only in an erased proof consumes nothing. `main`
;; binds a proof about the token under a typed let — a proposition vanishes at erasure
;; (erasure.shard) — and then passes the token to the extern once; the check walks the erased
;; program and sees one use
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World (let ((h (= w w) (Eq.refl w))) (write_line (text "kept") w)))
