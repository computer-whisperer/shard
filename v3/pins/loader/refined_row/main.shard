;; expect: ok
;; §8.4 slice 3.27 rule 8, landing 3 (law §10.3 row 11): Subtype is a row of the registry — one
;; constructor, one runtime field — so a ghost refinement runs as its value: Subtype.mk v h is v,
;; Subtype.val s is s, the proof erased. The carrier is named by a def (a fn signature reads
;; `(@Subtype T P)` at the wrong universe today — the def's `Type` fixes it). The predicate is a
;; constant partially applied; there are no lambdas.
(import Init Subtype.property)   ; above Nat.le_succ_of_le: the projection is cited too
(def Pos () Type (@Subtype Nat (Nat.le 1)))
(fn bump ((s Pos)) Pos (Subtype.mk (+ (Subtype.val s) 1) (Nat.le_succ_of_le (Subtype.property s))))
(fn bump_val ((s Pos)) Nat (Subtype.val (bump s)))
(theorem bump_val_eq ((s Pos)) (= (Subtype.val (bump s)) (+ (Subtype.val s) 1)) (by (unfold bump) rfl))
(fn one_pos () Pos (@Subtype.mk Nat (Nat.le 1) 1 (Nat.le_refl 1)))
(fn two () Nat (bump_val one_pos))
