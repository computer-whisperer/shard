;; expect: ok
;; slice 3.16 rules 1, 3 (GPT-6 R64, R66; fixtures G2's forcing half and G3): the E projection of
;; definitions the elaborator made, run by kernel/test/project_test.shard. A proposition where a
;; Bool is expected is `Decidable.decide` and erases to the explicit conversion
;; (if ⟦decision⟧ true false) — Bool and Decidable have different cells, so the decision's own
;; cell is never handed on as a Bool: both values survive being returned, matched against Bool's
;; constructors, stored in a field, used as a condition and as an operand of another if. A
;; matcher application erases to the E match of its rows: only the chosen arm runs — `pick
;; false` answers 1 although its other arm exhausts
(import Init Int.decEq)
(use Init.Bool)
(use Init.Option)
(def small ((n Nat)) Bool (le n 3))
(realize small (view))
(def as_nat ((b Bool)) Nat (match b (false 0) (true 1)))
(realize as_nat (view))
(def stored ((n Nat)) (Option Bool) (some (small n)))
(realize stored (view))
(def cond_use ((n Nat)) Nat (if (small n) 10 20))
(realize cond_use (view))
(def both ((a Nat) (b Nat)) Bool (if (small a) (small b) false))
(realize both (view))
(def pick ((b Bool)) Nat (match b (false 1) (true (Nat.pow 2 100000000000))))
(realize pick (view))
(fn t_true () Nat (as_nat (small 1)))
(fn t_false () Nat (as_nat (small 9)))
(fn t_stored () Nat (match (stored 1) (none 7) ((some b) (as_nat b))))
(fn t_stored_false () Nat (match (stored 9) (none 7) ((some b) (as_nat b))))
(fn t_cond () Nat (+ (cond_use 1) (cond_use 9)))
(fn t_both () Nat (+ (as_nat (both 1 2)) (+ (as_nat (both 1 9)) (as_nat (both 9 1)))))
(fn t_pick () Nat (pick false))
(fn t_pick_spent () Nat (pick true))
