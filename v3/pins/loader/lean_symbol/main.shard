;; expect: main.same refused lean_symbol
;; `==`, `&&`, `||` are lexed as symbols and are no operators of the elaborator (`==` for Bool
;; values is Init's BEq.beq under the table's instance, and/or/not at Bool operands are
;; Bool.and/or/not). The citation is refused lean_symbol with the spelling, on both routes.
(import Init Nat.decEq)
(fn same ((a Nat) (b Nat)) Bool (== a b))
