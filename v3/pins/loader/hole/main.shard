;; expect: main.rev_onto.at_nil hole [(xs : (List Nat)) (acc : (List Nat)) ⊢ (List Nat)]
;; a hole in a fn's body: a value still to be found. Each is a generated opaque constant under
;; the function's name over the names in scope where it stands — HOLE with those names, their
;; types and the hole's own —, the function is defined as usual (its equations name the
;; constant), and a theorem may speak of the constant. The second hole stands under the row's
;; pattern: it is handed `x` and `r` too
(use Init.List cons nil)
(fn rev_onto ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (match xs
    (nil (hole at_nil))
    ((cons x r) (hole at_cons))))
(theorem rev_onto_nil ((acc (List Nat))) (= (rev_onto nil acc) (rev_onto.at_nil nil acc)) (by rfl))
