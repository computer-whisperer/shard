;; expect: ok
;; the checked entry in S (§9, slice 7): Nat and Init's (List Nat) before the World; an S program
;; names no wire cell at phase 2, so it prints nothing and kernel/test/entry_test.shard checks the
;; run's result alone
(import Init Bool.casesOn)
(type World (World Nat))
(fn main ((n Nat) (xs (List Nat)) (w World)) World w)
(fn total ((n Nat) (xs (List Nat))) Nat (measure (struct xs)) (match xs (List.nil n) ((List.cons x t) (total (Nat.add n x) t))))
