;; expect: main.derive refused derive_needs
;; §8.4 slice 3.19 rule 8: a type of the program's with parameters and two constructors has
;; no constructor-structure bundle (slice 3.15: Box.Full.inj is not generated), so its
;; injectivity has no proof. A one-constructor type is decided through its projections
;; (Wrap, derived first)
(import Init Int.decEq)
(type (Wrap A) (MkWrap A Nat))
(derive (Wrap Nat) eq)
(fn same ((a (Wrap Nat)) (b (Wrap Nat))) Nat (if (= a b) 1 0))
(theorem wrap_eq () (= (same (MkWrap 1 2) (MkWrap 1 2)) 1) (exact (Eq.refl 1)))
(type (Box A) (Full A) (Empty))
(derive (Box Nat) eq)
