;; expect: load-error private_module
;; a directory module nested inside a directory that has a view is private to it, as a file
;; there is: `outer/inner` is imported by outer's own files and by nothing outside — `outer`
;; is the way in
(import Init Int.decEq)
(import "outer/inner")
(fn use_deep ((n Nat)) Nat (outer.inner.deep n))
