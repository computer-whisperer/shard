;; expect: ok
;; §7.2: the equations clause — the second equation proven by a named theorem instead of Eq.refl
(import Init Bool.casesOn)
(theorem app_cons ((a Type) (ys (List.{0} a)) (x a) (t (List.{0} a)))
  (Eq.{1} (List.{0} a) (List.append.{0} a (List.cons.{0} a x t) ys) (List.cons.{0} a x (List.append.{0} a t ys)))
  (exact (Eq.refl.{1} (List.{0} a) (List.cons.{0} a x (List.append.{0} a t ys)))))
(theorem app_nil ((a Type) (ys (List.{0} a)))
  (Eq.{1} (List.{0} a) (List.append.{0} a (List.nil.{0} a) ys) ys)
  (exact (Eq.refl.{1} (List.{0} a) ys)))
(realize List.append ((a Type) (xs (List a)) (ys (List a))) (List a) (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x t) (List.cons x (List.append t ys))))
  (equations app_nil app_cons))
