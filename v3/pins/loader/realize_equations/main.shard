;; expect: ok
;; §7.2: the equations clause — the second equation proven by a named theorem instead of Eq.refl
(import Init Bool.casesOn)
(theorem app_cons ((a Type) (ys (List a)) (x a) (t (List a)))
  (Eq (List.append (List.cons x t) ys) (List.cons x (List.append t ys)))
  (exact (Eq.refl (List.cons x (List.append t ys)))))
(theorem app_nil ((a Type) (ys (List a)))
  (Eq (List.append List.nil ys) ys)
  (exact (Eq.refl ys)))
(realize List.append ((a Type) (xs (List a)) (ys (List a))) (List a) (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x t) (List.cons x (List.append t ys))))
  (equations app_nil app_cons))
