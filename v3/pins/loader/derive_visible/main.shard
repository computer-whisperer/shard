;; expect: main.same refused no_decision
;; roots: reg.shard main.shard
;; an entry is visible where its deriving module is. `reg` registers a decision for `other.T`; this
;; file imports `other` alone, so the entry is not its own — whichever of the two the loader was
;; given first (visible by load order, the entry would make this module's meaning, and its hash,
;; depend on the order of the roots)
(import "other.shard")
(import Init Int.decEq)
(fn same ((a other.T) (b other.T)) Nat (if (= a b) 1 0))
