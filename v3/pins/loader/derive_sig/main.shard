;; expect: main.derive refused derive_type
;; roots: main.shard lib
;; §8.5 (item 46) and §8.4 slice 3.19 rules 1 and 8: a view's sig type is a parameter in a
;; consumer — nothing to take apart, so nothing to generate from: `(derive lib.Handle eq)` is
;; refused. Its module derives and exports: the view states the decision as a sig fn, the
;; consumer registers it with `(eq by NAME)`, and a type of the consumer's over the sig type
;; derives through that entry — Job.decEq calls lib.Handle.same, a parameter here
(import Init Int.decEq)
(import "lib")
(derive lib.Handle (eq by lib.Handle.same))
(type Job (Job lib.Handle Nat))
(derive Job eq)
(fn same_job ((a Job) (b Job)) Nat (if (= a b) 1 0))
(derive lib.Handle eq)
