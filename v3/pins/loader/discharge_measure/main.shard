;; expect: ok
;; §8.4 slice 3.16 rule 8 (GPT-6 R65, R69; fixture G4): a measured definition completed. Each
;; obligation is stated over every local in scope at its call — here the branch's proof
;; `h : ¬ p.1 = 0`, which Decidable.rec puts in scope wherever the `if` stands: the call in tail
;; position (count), under a let (count_let, the let in the statement), in an argument
;; (count_arg) — and discharged by a handwritten term over Init's library (Nat.sub_lt; no omega,
;; no I). After the DISCHARGE the function is no longer PENDING and count_self's params= is
;; empty (define_test.sh reads the records): the account recomputed, never a suppressed warning
(import Init InvImage.wf)
(fn count ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (count (Nat.sub n 1) (+ acc 1))))
(theorem count_self ((n Nat)) (Eq (count n 0) (count n 0)) (exact (Eq.refl (count n 0))))
(fulfills count.dec_1
  (exact (fun ((p (PProd.{1 1} Nat Nat)) (h (Not (= (proj PProd 0 p) 0))))
    (@Nat.sub_lt (proj PProd 0 p) 1 (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
(fn count_let ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (let ((m (Nat.sub n 1))) (count_let m (+ acc 1)))))
(fulfills count_let.dec_1
  (exact (fun ((p (PProd.{1 1} Nat Nat)) (h (Not (= (proj PProd 0 p) 0))))
    (@Nat.sub_lt (proj PProd 0 p) 1 (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
(fn count_arg ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (Nat.succ (count_arg (Nat.sub n 1) acc))))
(fulfills count_arg.dec_1
  (exact (fun ((p (PProd.{1 1} Nat Nat)) (h (Not (= (proj PProd 0 p) 0))))
    (@Nat.sub_lt (proj PProd 0 p) 1 (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
