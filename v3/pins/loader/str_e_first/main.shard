;; expect: ok
;; §8.4 slice 3.18 rule 3: "…" is the same String literal, its static type String, in a body
;; that calls an extern. Until slice 4.3 landing 1 that body was E-first (`no_l_meaning`, the
;; extern's sake alone) and `shown` over it typed with a callee-local; the extern now an opaque
;; constant in L (§8.6 slice 4.3 rule 3), both are defined with their equations
(import Init String.toByteArray)
(extern poke ((n Nat)) Nat)
(fn label ((n Nat)) String (match (poke n) (_ "poked")))
(fn shown ((n Nat)) ByteArray (String.toByteArray (label n)))
