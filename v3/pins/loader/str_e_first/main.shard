;; expect: ok
;; "…" is the same String literal, its static type String, in a body that calls an extern. The
;; extern is an opaque constant in L, so that body and `shown` over it are defined with their
;; equations
(import Init String.toByteArray)
(extern poke ((n Nat)) Nat)
(fn label ((n Nat)) String
  (match (poke n)
    (_ "poked")))
(fn shown ((n Nat)) ByteArray (String.toByteArray (label n)))
