;; expect: main.label runnable no_l_meaning
;; §8.4 slice 3.18 rule 3: in an E-first body — this one calls an extern — "…" is the same
;; String literal, its static type String: the function is a program without a definition for
;; the extern's sake alone, and `shown` over it is typed with a callee-local
(import Init String.toByteArray)
(extern poke ((n Nat)) Nat)
(fn label ((n Nat)) String (match (poke n) (_ "poked")))
(fn shown ((n Nat)) ByteArray (String.toByteArray (label n)))
