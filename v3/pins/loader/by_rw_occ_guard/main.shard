;; expect: read-error rw_occ_changed
;; §8.4 slice 3.29 rule 5 (law §12.5's T10 row): the guarded occurrence — (rw LEMMA (occ K EXPECT))
;; names the K-th occurrence and the instance it expects there; when the source's term moved,
;; the instance found is another and the step is refused, showing both (a positional path alone
;; would rewrite the wrong subterm silently)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem ok ((a Nat) (b Nat)) (= (+ (+ a 0) (+ b 0)) (+ a b))
  (by (rw Nat.add_zero (occ 1 (+ a 0))) (rw Nat.add_zero (occ 1 (+ b 0))) rfl))
(theorem moved ((a Nat) (b Nat)) (= (+ (+ b 0) (+ a 0)) (+ b a))
  (by (rw Nat.add_zero (occ 1 (+ a 0))) (rw Nat.add_zero (occ 1 (+ b 0))) rfl))
