;; expect: ok
;; §8.4 slice 3.20 (found by its second reader): `(occ K)` counts whole applications — the
;; second occurrence of `a` in (+ (+ a a) a) is the second `a`, a prefix of a spine is none
(import Init InvImage.wf)
(theorem t ((a Nat) (b Nat) (h (= a b))) (= (+ (+ a a) a) (+ (+ a b) a)) (by (rw h (occ 2)) rfl))
