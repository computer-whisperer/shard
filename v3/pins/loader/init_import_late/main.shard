;; expect: load-error late_init_import
;; Init's declarations are fetched once, after the file's leading directives. An
;; `(import Init …)` that follows a declaration and would raise the horizon is refused: what
;; it would let the file see was never fetched for it. The refusal names the import and where
;; it belongs
(import Init Eq)
(theorem a () (Eq 1 1) (exact (Eq.refl 1)))
(import Init Int.decEq)
(theorem t () (Eq Int Int) (exact (Eq.refl Int)))
