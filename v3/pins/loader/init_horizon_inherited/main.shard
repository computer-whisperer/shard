;; expect: read-error above_horizon
;; a horizon inherited through a file import is farther than the file's own `(import Init Eq)`:
;; the INIT record shows `-` and the refusal names the imported file, not the Init line
(import Init Eq)
(import "base.shard")
(theorem t ((n Nat) (h (Not (= n 0)))) (< (- n 1) n) (exact (Nat.sub_one_lt h)))
