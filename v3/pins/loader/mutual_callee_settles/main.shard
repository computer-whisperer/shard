;; expect: ok
;; a member of a group calls a function that is itself waiting — `part`, on `helper` — when
;; the group is first looked at: `ping` reads with `part` standing as a variable, and nothing
;; closes, for `part` does not read. `helper` is read, `part` is a definition, and `ping`
;; and `pong` are one: a reading the search for a group keeps does not outlast the
;; definition of a function it took as a variable
(use Init.Bool)
(fn part ((n Nat)) Nat (+ (helper n) 1))
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (+ (pong (Nat.sub n 1)) (part n))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 7 (ping (Nat.sub n 1))))
(fn helper ((n Nat)) Nat (+ n 2))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fulfills pong.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(theorem ping_zero () (= (ping 0) 0) (by rfl))
(theorem part_zero () (= (part 0) 3) (by rfl))
