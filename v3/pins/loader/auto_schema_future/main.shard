;; expect: load-error sidecar_schema
;; a sidecar whose schema form names a schema past this loader's ((sidecar 4) against the current 3)
;; is refused at the file — the entries may use forms this reader does not know; the sidecar is
;; regenerated by prove.shard, never hand-patched
(import Init)
(theorem t ((n Nat)) (= n n) auto)
