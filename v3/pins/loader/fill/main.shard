;; expect: main.rev_onto filled at_nil,at_cons
;; a fn's holes with code in the sidecar beside the file: the fn is read with the code where
;; each hole stands, and with the entry's measure — its second row calls it on a proper part —,
;; as a fn written that way is: no constant is made for a hole, the fn is defined, and a theorem
;; is about the body with the code in it. The entry was made for this text of the fn (the
;; fingerprint of its form) and names it in full, as the tool that writes it does
(use Init.List cons nil)
(fn rev_onto ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (match xs
    (nil (hole at_nil))
    ((cons x r) (hole at_cons))))
(theorem rev_onto_three ()
  (= (rev_onto (cons 1 (cons 2 (cons 3 nil))) nil) (cons 3 (cons 2 (cons 1 nil))))
  (by rfl))
