;; expect: main.count.dec_1 refuses fulfills_cycle
;; §8.4 slice 3.16 rule 8 (GPT-6 R69; fixture G7): a proof that cites the obligation it
;; discharges closes nothing — the theorem's axiom closure reaches count.dec_1, and the
;; closure is the acyclicity check
(import Init InvImage.wf)
(fn count ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (count (Nat.sub n 1) (+ acc 1))))
(fulfills count.dec_1 (exact count.dec_1))
