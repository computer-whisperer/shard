;; expect: main.hello bad-bin untrusted
;; §8.6 slice 4.3 landing 1 (rule 4): the bin's trusts are the roster of assumptions beyond the
;; standard profile that its requirements and its closure's definitions may rest on. The file
;; trusts both bolts (its own policy, §9); the bin lists only `exit_output`, and `main_output`
;; rests on `write_line_output`: BAD-BIN main.hello untrusted: main.main_output rests on
;; main.write_line_output, which the bin does not trust
(import Init String.toByteArray)
(trusts write_line_output exit_output)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(extern exit ((code Int) (w World)) World)
(opaque w_output ((w World)) (List ByteArray) List.nil)
(axiom write_line_output ((bs ByteArray) (w World)) (= (w_output (write_line bs w)) (List.append (w_output w) (List.cons bs List.nil))))
(axiom exit_output ((code Int) (w World)) (= (w_output (exit code w)) (w_output w)))
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World (write_line (text "hello") w))
(theorem main_output ((w World)) (= (w_output (main w)) (List.append (w_output w) (List.cons (text "hello") List.nil)))
  (by (rw main.eq_1) (rw write_line_output) rfl))
(bin hello (entry main) (externs write_line) (trusts exit_output) (requires main_output))
