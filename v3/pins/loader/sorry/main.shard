;; expect: main.t3 pending sorry
;; sorry admits nothing; citing t3 is the obligation, never an assumption (loader_test)
(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))
(inductive Eq.{u} ((α (Sort u) implicit) (x α)) (-> α Prop) (refl (Eq.{u} α x x)))
(def two () Nat (Nat.succ (Nat.succ Nat.zero)))
(theorem t3 () (Eq.{1} Nat two Nat.zero) sorry)
(theorem t4 () (Eq.{1} Nat two Nat.zero) (exact t3))
