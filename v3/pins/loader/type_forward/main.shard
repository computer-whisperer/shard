;; expect: ok
;; a type may name one declared below it: both enter K where the first stands — the one
;; named first, then the one naming it — so a function and a `def` over the first are
;; accepted (type_e_only: not across a `use`)
(type Foo (MkFoo Bar))
(type Bar (MkBar))
(fn get ((x Foo)) Bar
  (match x
    ((MkFoo s) s)))
(def one () Foo (MkFoo MkBar))
