;; expect: main.t pending auto_stale env fp=1340625431200418405
;; the sidecar's entry was made against another export of Init: the environment part of its key
;; — the export's identity, its record count and byte length — is not this export's, so the
;; requirement differs: pending auto_stale env, never re-searched at build
(import Init)
(theorem t ((n Nat)) (= (+ n 0) n) auto)
