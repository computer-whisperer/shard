;; expect: main.count pending measure
;; §8.4 (slice 3.14 rule 2): a measured fn is WellFounded.fix over its parameter tuple; each
;; self-call's decreasing fact is an obligation main.count.dec_1 admitted as a parameter of the
;; fourth class (PARAM … obligation), the definition is PENDING measure, no equations; a theorem
;; citing count rests on the obligation (its params=)
(import Init InvImage.wf)
(fn count ((n Nat) (acc Nat)) Nat (measure n)
  (if (int_eq n 0) acc (count (Nat.sub n 1) (+ acc 1))))
(theorem count_self ((n Nat)) (Eq.{1} Nat (count n 0) (count n 0)) (exact (Eq.refl.{1} Nat (count n 0))))
