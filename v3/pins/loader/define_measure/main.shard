;; expect: main.count pending measure
;; a measured fn is WellFounded.fix over its parameter tuple; each self-call's decreasing fact is an
;; obligation, main.count.dec_1, admitted as a parameter of the load (PARAM … obligation); the
;; definition is PENDING measure, with no equations here (the import stops before
;; WellFounded.fix_eq); a theorem citing count rests on the obligation (its params=)
(import Init InvImage.wf)
(fn count ((n Nat) (acc Nat)) Nat (measure n) (if (= n 0) acc (count (Nat.sub n 1) (+ acc 1))))
(theorem count_self ((n Nat)) (Eq (count n 0) (count n 0)) (exact (Eq.refl (count n 0))))
