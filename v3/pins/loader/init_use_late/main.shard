;; expect: ok
;; a `use` after a declaration opens an Init namespace for the forms after it: the names those
;; forms cite bare under it were fetched with the rest, before the first declaration
(import Init)
(theorem a () (Eq 1 1) (exact (Eq.refl 1)))
(use Init.Nat)
(theorem t ((n Nat) (h (Not (= n 0)))) (< (- n 1) n) (exact (sub_one_lt h)))
