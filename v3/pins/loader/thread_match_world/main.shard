;; expect: main.main unthreaded world_unsupported
;; the World itself matched: a token is opaque to the program; taking it apart is unsupported
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn main ((w World)) World
  (match w ((World n) (write_line (text "a") (World n)))))
