;; expect: main.pong pending measure
;; §8.7 slice 5.2 rule 2: the group's fixpoint is one, so a member carries every member's
;; measure — with `ping.dec_1` discharged and `pong.dec_1` open, `pong` is PENDING and `ping`,
;; `pong` and their caller each name it (`pending=main.pong`)
(import Init UInt8.toNat)
(use Init.Bool)
(fn ping ((n Nat)) Nat (measure n) (if (= n 0) 0 (pong (Nat.sub n 1))))
(fn pong ((n Nat)) Nat (measure n) (if (= n 0) 1 (ping (Nat.sub n 1))))
(fulfills ping.dec_1
  (by (intro n h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
(fn caller ((n Nat)) Nat (ping n))
