;; expect: ok
;; slice 3.16 rule 1: a match in a def elaborates to a generated matcher — main.flush.match_1,
;; main.parse1.match_1, ACCEPT records of their own, admitted before their owners — applied to a
;; constant motive, the scrutinee and one alternative per row. Nested patterns with a fall-through
;; row: the `_` alternative is applied at every leaf it reaches, never copied. K computes through
;; the matcher, so the theorems are Eq.refl; `Add` and `Num` are Exp's by the expected type (rule 5)
(import Init Int.decEq)
(use Init.List)
(use Init.Option)
(type Token (TNum Int) (TPlus) (TMinus) (TBad))
(type Exp (Num Int) (Add Exp Exp) (Sub Exp Exp))
(def flush ((acc (Option Int)) (toks (List Token))) (List Token)
  (match acc (none toks) ((some n) (cons (TNum n) toks))))
(def parse1 ((toks (List Token)) (acc Exp)) (Option Exp)
  (match toks
    (nil (some acc))
    ((cons TPlus (cons (TNum n) rest)) (some (Add acc (Num n))))
    ((cons TMinus (cons (TNum n) rest)) (some (Sub acc (Num n))))
    (_ none)))
(theorem flush_none ((toks (List Token))) (= (flush none toks) toks) (exact (Eq.refl toks)))
(theorem flush_some ((n Int) (toks (List Token))) (= (flush (some n) toks) (cons (TNum n) toks)) (exact (Eq.refl (cons (TNum n) toks))))
(theorem parse1_plus ((acc Exp) (n Int)) (= (parse1 (cons TPlus (cons (TNum n) nil)) acc) (some (Add acc (Num n))))
  (exact (Eq.refl (some (Add acc (Num n))))))
(theorem parse1_bad ((acc Exp)) (= (parse1 (cons TBad nil) acc) none) (exact (Eq.refl none)))
(theorem parse1_short ((acc Exp)) (= (parse1 (cons TPlus nil) acc) none) (exact (Eq.refl none)))
