;; expect: ok
;; records (§13 item 42): a record expands to its positional type, an accessor NAME.FIELD and an
;; updater NAME.with_FIELD per field in the record's namespace — opened for the file, so a field
;; no other opened record has is cited bare; make builds one by field name in any order; with
;; chains updaters, a later entry outermost
(record Point (x Int) (y Int))
(record Box (ctor MkB) (lo Point) (hi Point) (tag Symbol))
(record (Cell T) (val T) (count Int))
(fn origin () Point (make Point (y 0) (x 0)))
(fn unit () Box (make Box (tag (quote unit)) (lo (origin)) (hi (make Point (x 1) (y 1)))))
(fn moved ((b Box)) Box (with Box b (lo (with Point (lo b) (x 5))) (tag (quote moved))))
(fn wider ((b Box)) Int (+ (Point.x (hi b)) (y (hi b))))
(fn cell ((T Type) (v T)) (Cell T) (make Cell (count 1) (val v)))
(fn bump ((T Type) (c (Cell T))) (Cell T) (Cell.with_count (+ (count c) 1) c))
