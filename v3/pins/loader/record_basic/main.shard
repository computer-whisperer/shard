;; expect: ok
;; records (§13 item 42): a record expands to its positional type, an accessor NAME.FIELD and an
;; updater NAME.with_FIELD per field in the record's namespace — cited qualified, or bare where a
;; file opens the namespace with `(use M.T)` (a type's automatic open covers its constructors only,
;; item 7); make builds one by field name in any order; with chains updaters, a later entry outermost
(use main.Cell)
(record Point (x Int) (y Int))
(record Box (ctor MkB) (lo Point) (hi Point) (tag Symbol))
(record (Cell T) (val T) (count Int))
(fn origin () Point (make Point (y 0) (x 0)))
(fn unit () Box (make Box (tag (quote unit)) (lo (origin)) (hi (make Point (x 1) (y 1)))))
(fn moved ((b Box)) Box (with Box b (lo (with Point (Box.lo b) (x 5))) (tag (quote moved))))
(fn wider ((b Box)) Int (+ (Point.x (Box.hi b)) (Point.y (Box.hi b))))
(fn cell ((T Type) (v T)) (Cell T) (make Cell (count 1) (val v)))
(fn bump ((T Type) (c (Cell T))) (Cell T) (with_count (+ (count c) 1) c))
