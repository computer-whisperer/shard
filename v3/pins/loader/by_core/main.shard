;; expect: ok
;; §8.4 slice 3.20 rules 1–7: a theorem's proof as `(by STEP…)`, I's concrete syntax elaborated
;; to one closed term K checks. Every form of the opener on a small type and two list
;; functions: intro/exact/rfl/have/show; apply with a premise block, and with the middle term
;; given through h1 (a witness goal is the graph's); cases on a Tok with its arms in one list;
;; unfold by the equations and reduce to the normal form; induction with the hypothesis
;; rewritten in; decide at Nat; cases on a term (an if's condition) generalizing it in the
;; target; a reversed rw and an occurrence selector; a conditional lemma (if_pos) with its
;; premise as a block
(import Init InvImage.wf)
(use Init.Bool)
(type Tok (TNum Nat) (TPlus) (TMinus))
(fn tok_size ((t Tok)) Nat
  (match t ((TNum n) (+ n 1)) (TPlus 0) (TMinus 0)))
(fn len ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs (List.nil 0) ((List.cons _ r) (+ (len r) 1))))
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x r) (List.cons x (app r ys)))))
(fn drop1 ((xs (List Nat))) (List Nat)
  (match xs (List.nil List.nil) ((List.cons _ r) r)))
(fn is_small ((c Nat)) Bool (if (<= c 3) true false))
;; the plain forms
(theorem t1 ((n Nat)) (= n n) (by rfl))
(theorem t2 ((n Nat) (h (= n 1))) (= n 1) (by (exact h)))
(theorem t3 () (-> (= 1 1) (= 2 2)) (by (intro h) rfl))
(theorem t4 ((a Nat) (b Nat) (h (= a b))) (= b a) (by (have h2 (= b a) (exact (Eq.symm h))) (exact h2)))
(theorem t5 ((n Nat)) (= (+ n 0) n) (by (show (= (+ n 0) n)) rfl))
;; apply
(theorem a1 ((a Nat) (b Nat) (c Nat) (h1 (= a b)) (h2 (= b c))) (= a c)
  (by (apply (Eq.trans h1) (exact h2))))
(theorem a2 ((a Nat) (b Nat) (h (= a b))) (= b a)
  (by (apply Eq.symm (exact h))))
;; decide, cases
(theorem d1 () (= 2 2) (by decide))
(theorem d2 () (< 1 2) (by decide))
(theorem c1 ((t Tok)) (<= 0 (tok_size t))
  (by (cases t ((TNum (n) decide) (TPlus () decide) (TMinus () decide)))))
;; unfold, reduce
(theorem u1 () (= (tok_size TPlus) 0) (by (unfold tok_size) rfl))
(theorem u2 ((n Nat)) (= (tok_size (TNum n)) (+ n 1)) (by (reduce lhs) rfl))
(theorem r1 () (= (len (List.cons 1 (List.cons 2 List.nil))) 2) (by (reduce) rfl))
;; induction, the hypothesis rewritten in
(theorem app_nil ((xs (List Nat))) (= (app xs List.nil) xs)
  (by (induction xs ((nil () rfl) (cons (x r ih) (reduce lhs) (rw ih) rfl)))))
;; rw: an occurrence, the reverse direction, a premise
(theorem o1 ((a Nat) (b Nat) (h (= a b))) (= (+ a a) (+ a b))
  (by (rw h (occ 2)) rfl))
(theorem o2 ((a Nat) (b Nat) (h (= a b))) (= (+ b 1) (+ a 1))
  (by (rw (<- h)) rfl))
(theorem p1 ((c Nat) (h (<= c 3))) (= (is_small c) true)
  (by (unfold is_small) (rw if_pos (exact h)) rfl))
;; cases on a term: the if's condition, generalized in the target
(theorem p2 ((c Nat)) (= (is_small c) (is_small c))
  (by (cases (is_small c) ((false () rfl) (true () rfl)))))
(theorem w2 ((xs (List Nat))) (<= (len (drop1 xs)) (len xs))
  (by (cases xs ((nil () decide) (cons (x r) (reduce) (exact (Nat.le_succ (len r))))))))
