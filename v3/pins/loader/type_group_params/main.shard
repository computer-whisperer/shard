;; types that name each other and take a parameter: a block's types share their parameters
(type (Rose a) (RNode a (Forest a)))
(type (Forest a) (FNil) (FCons (Rose a) (Forest a)))
(fn rose_top ((a Type) (r (Rose a))) a
  (match r
    ((RNode x _) x)))
(def r0 () (Rose Int) (RNode 1 FNil))
