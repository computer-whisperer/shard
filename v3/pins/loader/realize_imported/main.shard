;; T5's imported-theorem form (law §12.5 T5; LANGUAGE.md §11's row, closed at slice 3.30 landing 1): an
;; imported theorem about List.append — Init's own List.append_nil — is cited before a realization of
;; List.append is attached, the realization is attached by a supplied body with its equations proved,
;; and the same theorem is cited after it, as is a theorem that cited it before; the identity is
;; unchanged (every record ACCEPT, the three statements one fingerprint). `(realize List.append (view))`
;; is refused recursion_structure — a recursive Init body is supplied, as examples/path supplies List.length's.
(import Init List.append_nil)
(theorem app_nil_before ((a Type) (xs (List a))) (= (List.append xs List.nil) xs) (exact (List.append_nil xs)))
(realize List.append ((a Type) (xs (List a)) (ys (List a))) (List a) (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x t) (List.cons x (List.append t ys)))))
(theorem app_nil_after ((a Type) (xs (List a))) (= (List.append xs List.nil) xs) (exact (List.append_nil xs)))
(theorem app_nil_cited ((a Type) (xs (List a))) (= (List.append xs List.nil) xs) (exact (app_nil_before a xs)))
