;; expect: ok
;; §8.4 slice 3.21 rule 3 (found by the slice's second reader): a goal's statement enters in
;; one spelling — `Ne a b` is `Not (a = b)` at Ne's own universe (the rewrite wrote Eq.{1}, and
;; `intro` then built a term K refused: Ne at two types is at Sort 2)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(theorem q0 ((p Prop) (q Prop)) (-> (Ne p q) (Ne p q)) (by (intro h) (exact h)))
(theorem q ((u Unit)) (-> (Ne Nat Int) (Ne Nat Int)) (by (intro h) (exact h)))
(theorem r ((a Int) (b Int) (h (Ne a b))) (Not (= a b)) (by (exact h)))
