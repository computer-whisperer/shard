;; expect: ok
;; §8.4 (slice 3.14 rule 1): a self-call two constructors down (t under (cons x (cons z t))) is
;; course-of-values — brecOn's table holds the result at every sub-structure — and the three
;; equations state the nested left-hand sides; a theorem cites the third
(import Init Int.decEq)
(use Init.List)
(fn snoc2 ((a Type) (xs (List a)) (y a)) (List a) (measure (struct xs))
  (match xs
    (List.nil (List.cons y List.nil))
    ((List.cons x List.nil) (List.cons x (List.cons y List.nil)))
    ((List.cons x (List.cons z t)) (List.cons x (List.cons z (snoc2 t y))))))
(theorem concat_deep ((a Type) (x a) (z a) (t (List.{0} a)) (y a))
  (Eq.{1} (List.{0} a) (snoc2 a (List.cons.{0} a x (List.cons.{0} a z t)) y) (List.cons.{0} a x (List.cons.{0} a z (snoc2 a t y))))
  (exact (snoc2.eq_3 a y x z t)))
