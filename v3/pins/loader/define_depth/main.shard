;; expect: main.concat runnable recursion_depth
;; §8.4 rule 2: a self-call on a field two constructors down (t under (cons x (cons z t))) is not
;; an immediate field of the structural parameter — course-of-values is slice 3.14's, so the fn
;; stays RUNNABLE with that obstacle named, not refused
(import Init Int.decEq)
(use Init.List)
(fn concat ((a Type) (xs (List a)) (y a)) (List a) (measure (struct xs))
  (match xs
    (List.nil (List.cons y List.nil))
    ((List.cons x List.nil) (List.cons x (List.cons y List.nil)))
    ((List.cons x (List.cons z t)) (List.cons x (List.cons z (concat t y))))))
