;; expect: ok
;; §8.4 slice 3.16 landing 3: a structural self-call under a `match` in an argument and under a
;; `let`'s value finds its table entry as one in tail position does — the matcher's motive
;; carries the table wherever the matcher stands (slice 3.14 had the obstacle recursion_depth
;; here). No equation is stated: the body has no leading matcher, and `total xs = …` at a local
;; xs unfolds only by a case analysis (I's) — an equation is stated where K decides it by
;; conversion. A theorem computes through the definition
(import Init Int.decEq)
(use Init.List)
(fn total ((xs (List Nat))) Nat (measure (struct xs))
  (Nat.add 1 (match xs (List.nil 0) ((List.cons h t) (let ((r (total t))) (Nat.add h r))))))
(theorem total_two () (= (total (List.cons 2 (List.cons 3 List.nil))) 8)
  (exact (Eq.refl (total (List.cons 2 (List.cons 3 List.nil))))))
