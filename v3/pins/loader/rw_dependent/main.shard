;; expect: read-error rw_motive
;; §8.7 slice 5.2 rule 7: an equation that is no conversion, rewritten at an occurrence under a
;; dependency, is refused at its step — `h` states `v < 5`, so `λ x. Fin.val (Fin.mk x h) = w`
;; is no term. Before the motive was checked the step passed and K refused the theorem
;; (`t refused app_type_mismatch`)
(import Init UInt8.toNat)
(theorem t ((v Nat) (w Nat) (e (= v w)) (h (< v 5))) (= (Fin.val (@Fin.mk 5 v h)) w)
  (by (rw e) rfl))
