;; expect: read-error rw_motive
;; an equation that is no conversion, rewritten at an occurrence under a dependency, is refused
;; at its step — `h` states `v < 5`, so `λ x. Fin.val (Fin.mk x h) = w` is no term. The motive
;; is checked at the step: let through, K would refuse the whole theorem, no step named
;; (`t refused app_type_mismatch`)
(import Init UInt8.toNat)
(theorem t ((v Nat) (w Nat) (e (= v w)) (h (< v 5))) (= (Fin.val (@Fin.mk 5 v h)) w)
  (by (rw e) rfl))
