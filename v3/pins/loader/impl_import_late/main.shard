;; expect: load-error late_init_import
;; roots: main.shard lib
;; an implementation sees Init exactly when its view does: its forms stand after the view's
;; declarations, so an `(import Init)` there, where the view imports none, is refused — the
;; import belongs in the view
(import "lib")
(use lib)
(fn twice_pick ((c Color)) Color (pick (pick c)))
