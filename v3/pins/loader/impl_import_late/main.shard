;; expect: load-error late_init_import
;; roots: main.shard lib
;; an implementation is read at its view's horizon: its own `(import Init …)` lines are read
;; after the view's declarations, and one that would raise the horizon is refused — the
;; import belongs in the view
(import "lib")
(use lib)
(fn twice_pick ((n Nat)) Nat (pick (pick n)))
