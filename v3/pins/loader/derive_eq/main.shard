;; expect: ok
;; §8.4 slice 3.19 rules 1 to 3 and 7: `(derive Tok eq)` writes Tok.ctorIdx and Tok.decEq as
;; source — a row per pair of constructors, the recursive fields decided by the function
;; itself, two constructors told apart by their indices — and registers the decision, so
;; `(if (= a b) …)` at Tok is `ite (a = b) (Tok.decEq a b)`. K has the definitions: both
;; theorems are evaluation; the program is the erasure. A generated variable is no symbol a
;; source can write, so a constructor of a field's type named like one (Inner's `x1`) does not
;; capture it in a pattern
(import Init Int.decEq)
(type Tok (TNum Nat) (TPlus) (TPair Tok Tok) (TFlag Bool Int))
(derive Tok eq)
(fn same ((a Tok) (b Tok)) Nat (if (= a b) 1 0))
(theorem same_1 () (= (same (TPair (TNum 3) (TFlag Bool.true -2)) (TPair (TNum 3) (TFlag Bool.true -2))) 1) (exact (Eq.refl 1)))
(theorem same_0 () (= (same (TPair (TNum 3) TPlus) (TPair (TNum 4) TPlus)) 0) (exact (Eq.refl 0)))
(theorem same_ctor () (= (same TPlus (TNum 0)) 0) (exact (Eq.refl 0)))
(def as_bool ((a Tok) (b Tok)) Bool (= a b))
(type Inner (x1) (y1))
(type Outer (MkO Inner))
(derive Inner eq)
(derive Outer eq)
