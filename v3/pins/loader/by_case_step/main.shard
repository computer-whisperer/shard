;; expect: ok
;; §8.4 slice 3.21: reduce takes a case analysis at a decided scrutinee one step, to its
;; alternative — the matcher at `cons x r` to its row, whose body is an `if` on an open
;; condition (K's whnf goes on into it and ends at a stuck Decidable.rec; the alternatives are
;; masked while K picks one) — and leaves a comparison as it is (`(< …)` is no computation)
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(use Init.List)
(fn pick ((xs (List Int)) (c Int)) Int
  (if (= c 0) 0
    (match xs
      (nil 0)
      ((cons x r) (if (= c 43) 1 2)))))
(theorem t ((c Int) (x Int) (r (List Int)) (h0 (Not (= c 0))) (h (= c 43))) (= (pick (cons x r) c) 1)
  (by (unfold pick) (rw (if_neg h0)) (reduce lhs) (rw (if_pos h)) rfl))
(fn len2 ((xs (List Int))) Nat
  (measure (struct xs))
  (match xs (nil 0) ((cons _ t) (+ 1 (len2 t)))))
(theorem u ((x Int) (r (List Int))) (< (len2 r) (len2 (cons x r))) (by (reduce) arith))
