;; expect: read-error dependent_update
;; `ok`'s type mentions `hi`; updating `hi` and keeping the old `ok` would need a cast, which the
;; sugar never inserts — refused, naming the field to supply
(import Init Int.decEq)
(structure Span () (lo Nat) (hi Nat) (ok (Nat.le lo hi)))
(def raise ((s Span) (h Nat)) Span (with Span s (hi h)))
