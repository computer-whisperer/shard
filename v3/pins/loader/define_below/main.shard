;; expect: ok
;; §8.4 (slice 3.14 rule 1): a native inductive gets Tree.below and Tree.brecOn generated on
;; first need (two ACCEPT lines), then the deep recursion over it; an immediate recursion goes
;; through the same table
(import Init Int.decEq)
(type Tree (Leaf Nat) (Node Tree Tree))
(fn size ((t Tree)) Nat (measure (struct t))
  (match t ((Leaf _) 1) ((Node l r) (+ (size l) (size r)))))
(fn leftmost ((t Tree)) Nat (measure (struct t))
  (match t
    ((Leaf n) n)
    ((Node (Leaf n) _) n)
    ((Node (Node a b) c) (leftmost a))))
(theorem size_node ((l Tree) (r Tree)) (Eq (size (Tree.Node l r)) (Nat.add (size l) (size r))) (exact (size.eq_2 l r)))
(theorem leftmost_deep ((a Tree) (b Tree) (c Tree)) (Eq (leftmost (Tree.Node (Tree.Node a b) c)) (leftmost a)) (exact (leftmost.eq_3 c a b)))   ; the equation's binders: the parameters not split, then each split's fields in order (§7.5)
