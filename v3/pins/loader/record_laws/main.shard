;; expect: ok
;; §8.4 slice 3.17 rule 4 (GPT-6 R60): v2's record law family needs no generator. A record's
;; accessors and updaters are definitions since Stage 1, and the laws — get after set, get
;; of another field, set after set, through a `with` in a function — are Eq.refl over a local:
;; K unfolds a structure's recursor on a local through its projections
(import Init Int.decEq)
(record Pt (x Nat) (y Nat))
(fn origin () Pt (make Pt (y 0) (x 0)))
(fn bump ((p Pt)) Pt (with Pt p (x (+ (Pt.x p) 1))))
(theorem get_set ((v Nat) (p Pt)) (= (Pt.x (Pt.with_x v p)) v) (exact (Eq.refl v)))
(theorem get_other ((v Nat) (p Pt)) (= (Pt.y (Pt.with_x v p)) (Pt.y p)) (exact (Eq.refl (Pt.y p))))
(theorem set_set ((v Nat) (w Nat) (p Pt)) (= (Pt.with_x v (Pt.with_x w p)) (Pt.with_x v p)) (exact (Eq.refl (Pt.with_x v p))))
(theorem bump_y ((p Pt)) (= (Pt.y (bump p)) (Pt.y p)) (exact (Eq.refl (Pt.y p))))
(theorem made () (= (Pt.x (origin)) 0) (exact (Eq.refl 0)))
