;; expect: read-error cases_fields
;; an arm of `cases` names every field of its constructor: `Add` has two and the arm names one.
;; The refusal gives both counts and lists the case's binders
(import Init Int.decEq)
(type Exp (Num Nat) (Add Exp Exp))
(theorem t ((e Exp)) (= e e) (by (cases e ((Num (n) rfl) (Add (a) rfl)))))
