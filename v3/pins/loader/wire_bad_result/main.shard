;; expect: ok
;; §8.4 slice 3.18 rule 4: an extern's declared result is checked before the host is asked.
;; write_line returns the World it was passed, at that type: declared to return a pair it is
;; stuck with nothing written (`out`), and get_args declared to pair its list with a Nat — the
;; World's token would land in the Nat's slot — is stuck too (`args`). kernel/test/wire_test.sh
;; runs both: `RUN: stuck extern`, exit 4, no other output
(import Init String.toByteArray)
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) (Prod Bool World))
(extern get_args ((w World)) (Prod (List ByteArray) Nat))
(fn text ((s String)) ByteArray (String.toByteArray s))
(fn out ((w World)) World (match (write_line (text "never printed") w) ((Prod.mk _ w1) w1)))
(fn args ((w World)) World (match (get_args w) ((Prod.mk _ _) w)))
