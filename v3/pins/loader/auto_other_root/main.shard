;; expect: ok
;; roots: other.shard main.shard
;; the policy part of an entry's key ranges over the parameters the file can see: other.shard,
;; loaded first, admits an obligation main.shard does not import, and the entry made for
;; main.shard loaded alone still fits
(import Init UInt8.toNat)
(theorem le_chain ((x Int) (y Int) (z Int) (h1 (<= x y)) (h2 (<= y z))) (<= x z) auto)
