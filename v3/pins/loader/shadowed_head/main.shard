;; expect: read-error function_expected
;; `(use exp)` opens the module, not its type's constructors: a bare `Add` is
;; Init's class of that name, applied past its type. The refusal names the head it resolved
(import "exp.shard")
(import Init Int.decEq)
(use exp)
(theorem count_add ((a Exp) (b Exp)) (= (count (Add a b)) (+ (count a) (count b)))
  (by (rw count.eq_2) rfl))
