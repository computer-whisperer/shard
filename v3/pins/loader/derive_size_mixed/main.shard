;; expect: main.derive refused bad_shape
;; §8.7 slice 5.2 rule 6: size is derived by a form of its own — it is taken before the
;; shapes the other capabilities refuse (a nested type), so it does not stand in their list
(import Init UInt8.toNat)
(type Exp (Num Nat) (Add Exp Exp))
(derive Exp eq size)
