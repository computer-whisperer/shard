;; expect: ok
;; §7.5: the supplied form — List.append realized under its own identity, its two equations theorems
;; K proves by unfolding; a consumer fn calls it; a theorem cites an equation; nested patterns and
;; a leading match on a pattern variable state nested left-hand sides
(import Init Bool.casesOn)
(realize List.append ((a Type) (xs (List a)) (ys (List a))) (List a) (measure (struct xs))
  (match xs (List.nil ys) ((List.cons x t) (List.cons x (List.append t ys)))))
(fn twice ((xs (List Nat))) (List Nat) (List.append xs xs))
(theorem app_cons ((a Type) (x a) (t (List a)) (ys (List a)))
  (Eq (List.append (List.cons x t) ys) (List.cons x (List.append t ys)))
  (exact (List.append.realize_2 a ys x t)))   ; the equation's binders: the type parameters, the parameters not split, then the fields (§7.5)
(realize List.concat ((a Type) (xs (List a)) (y a)) (List a) (measure (struct xs))
  (match xs
    (List.nil (List.cons y List.nil))
    ((List.cons x List.nil) (List.cons x (List.cons y List.nil)))
    ((List.cons x (List.cons z t)) (List.cons x (List.cons z (List.concat t y))))))
(realize List.flatten ((a Type) (xs (List (List a)))) (List a) (measure (struct xs))
  (match xs (List.nil List.nil) ((List.cons l L) (List.append l (List.flatten L)))))
