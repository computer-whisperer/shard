;; The reading of a build (kernel/load.shard --unchecked; kernel/test/readings_test.sh). Under
;; the flag every fn is the classifier's program and nothing is checked: `total`, a definition
;; in a load without the flag, has none, and `mistyped`, whose body is a String where its
;; result is a list, is a program — a String runs as the list of its bytes — where a load
;; without the flag refuses it and `main`, which calls it.
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn say ((s String) (w World)) World (write_line (String.toByteArray s) w))
(fn total ((l (List Nat))) Nat
  (measure (struct l))
  (match l
    (List.nil 0)
    ((List.cons x r) (+ x (total r)))))
(fn mistyped () (List Nat) "ab")
(fn report ((ok Bool) (yes String) (no String) (w World)) World
  (match ok
    (Bool.true (say yes w))
    (Bool.false (say no w))))
(fn main ((w World)) World
  (report (= (total (mistyped)) 195) "a String where a list is declared: its bytes"
    "a String where a list is declared: WRONG"
    (report (= (total (List.cons 1 (List.cons 2 List.nil))) 3) "total: ok" "total: WRONG" w)))
