;; A theorem and a descent proof under the reading of a build (kernel/load.shard --unchecked;
;; kernel/test/readings_test.sh). A load without the flag defines `count`, proves its descent
;; and accepts `count_two`. Under the flag `count` is a program, and the two proofs are passed
;; over: no program is made of them, and the check of the same file is the load without the
;; flag. A proof written inside a fn is another matter (build_proof.shard).
(fn count ((n Nat) (acc Nat)) Nat (measure n) (if (= n 0) acc (count (Nat.sub n 1) (+ acc 1))))
(fulfills count.dec_1
  (by (intro p h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.zero_lt_succ 0)))))
(theorem count_two () (= (count 2 0) 2) (by decide))
