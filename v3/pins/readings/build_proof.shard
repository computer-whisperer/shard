;; A written proof under the reading of a build (kernel/load.shard --unchecked;
;; kernel/test/readings_test.sh). A load without the flag checks the proof and `first` is a
;; definition; under the flag nothing reads it, and a proof nothing reads is refused, not
;; passed over.
(fn first () (Fin 3) (Fin.mk 0 (Nat.zero_lt_succ 2)))
