;; The two readings of a program (docs/LAW.md rule 24; kernel/test/readings_test.sh). A fn's
;; program is read twice: by the typed route, as the erasure of the elaborated body, and by the
;; classifier, from the source and the types its binders state. Part 1: each fn is read both
;; ways and the two programs are one text — an arithmetic operator takes its entry from the
;; type expected of it where that is Nat or Int, else from its first operand that is not
;; numerals alone; a comparison where a Bool is expected is the decision's value; Init's
;; operations written by name are the table's entries. Part 2: the controls — a difference
;; the comparison reports, and a body the classifier does not read. Part 3: a program the
;; classifier alone reads (a Symbol has no form in the logic), run.
(import Init)

;; ---- 1. one program by both readings
(type Exp (Num Int) (Add Exp Exp))
(fn sub_nat ((a Nat) (b Nat)) Nat (- a b))
(fn sub_int ((a Int) (b Int)) Int (- a b))
(fn numeral_right ((a Int)) Int (- a 1))
(fn numerals_at_int () Int (- 3 5))
(fn numerals_at_nat () Nat (- 3 5))
(fn div_both ((a Nat) (b Int)) Int (+ (Int.ofNat (/ a 2)) (/ b 2)))
(fn mod_both ((a Nat) (b Int)) Int (+ (Int.ofNat (% a 2)) (mod b 2)))
(fn under_int ((e Exp) (n Nat) (i Int)) Int
  (match e
    ((Num k) (- i k))
    ((Add (Num a) _) (+ a (- n 1)))
    ((Add _ _) 0)))
(fn under_list ((a Nat) (xs (List Int))) (List Int) (List.cons (- a 1) xs))
(fn cmp_value ((c Int)) Bool (<= c 32))
(fn cmp_cond ((c Int)) Bool (if (<= 48 c) (<= c 57) Bool.false))
(fn abs_pred ((c Int)) Nat (- (Int.natAbs c) 1))
(fn connectives ((a Bool) (b Bool)) Bool (and (or a b) (not a)))
(fn succ_zero ((n Nat)) Nat (Nat.succ (Nat.add n Nat.zero)))
(fn by_name ((a Int) (b Int)) Int (Int.add a (Int.mul b 2)))
(fn self_call ((xs (List Nat)) (k Nat)) Bool
  (measure (struct xs))
  (match xs
    (List.nil (< k 1))
    ((List.cons x t) (if (self_call t k) (< (- (/ x 2) 1) 3) Bool.false))))

;; ---- 2. the controls
(fn lit_pattern ((n Nat)) Nat
  (match n
    (0 1)
    (_ 0)))
(fn twice ((f (-> Nat Nat)) (x Nat)) Nat (f (f x)))
(fn add_two ((x Nat)) Nat (twice (fun ((y Nat)) (+ y 1)) x))

;; ---- 3. read by the classifier alone, and run
(type World (World Nat))
(extern write_line ((bytes ByteArray) (w World)) World)
(fn say ((s String) (w World)) World (write_line (String.toByteArray s) w))
(fn p_sub ((s Symbol) (n Nat) (k Nat)) Nat (- n k))
(fn p_div ((s Symbol) (a Int)) Int (/ a 2))
(fn p_mod ((s Symbol) (a Int)) Int (% a 3))
(fn p_abs ((s Symbol) (a Int)) Nat (- (Int.natAbs a) 1))
(fn p_low ((s Symbol) (c Int)) Bool (<= c 32))
(fn report ((ok Bool) (yes String) (no String) (w World)) World
  (match ok
    (Bool.true (say yes w))
    (Bool.false (say no w))))
(fn main ((w World)) World
  (report (p_low (quote x) 7) "a comparison is a Bool: ok" "a comparison is a Bool: WRONG"
    (report (= (p_abs (quote x) 0) 0) "natAbs then Nat.sub: ok" "natAbs then Nat.sub: WRONG"
      (report (= (p_mod (quote x) -7) 2) "Int.emod: ok" "Int.emod: WRONG"
        (report (= (p_div (quote x) -7) -4) "Int.ediv: ok" "Int.ediv: WRONG"
          (report (= (p_sub (quote x) 3 5) 0) "Nat.sub: ok" "Nat.sub: WRONG" w))))))
