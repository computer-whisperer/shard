;; A written proof has one reader (kernel/test/readings_test.sh). The classifier passes a proof
;; over unread: where the typed route read the same form the proof was checked there, and
;; where the classifier's is the program's only reading — a signature over `Mark`, which names
;; a type declared below a `use`, has no form in the logic — a written proof is refused, for nothing
;; checks it. `no_proof` builds the same row with no proof to write, and is a program.
(type Mark (MkMark Tail))
(use Init.Option none some)
(type Tail (TNil))
(fn false_claim ((s Mark) (i Nat)) (Fin 3) (Fin.mk i (Nat.zero_lt_succ 2)))
(fn refuted ((s Mark) (n Nat)) Nat (if (< n 0) (absurd (Nat.zero_lt_succ 0) (Nat.lt_irrefl 0)) n))
(fn no_proof ((s Mark) (l (List UInt8))) ByteArray (ByteArray.mk (Array.mk l)))
