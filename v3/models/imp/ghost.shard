;;; v3/models/imp/ghost.shard — the ghost kit (slice 4.2 landing 2): what the runtime protocol's
;;; ghost operations — the increment, the fill, the seal (heap.shard) — do to the cells, the window's
;;; end, the raw cell and the readbacks; the raw cell's place under the invariant; the roots'
;;; algebra; the runtime table's entries. Written by need for `tb_app` (the old tbh_kit/rth_kit laws
;;; gcells_*, gend_*, graw_*, rbl_inc, rbl_seal, araw_facts, rbl_slot_ok, rbl_lo/hi, rdec_rinc,
;;; rt_at_alloc, rt_at_inc), as V3 theorems over the definitions: a record updater reduces once the
;;; record is a constructor (`cases g`); an operation under a known raw cell by its equation.
(import Init List.mem_nil_iff)
(import Init List.mem_cons_self)
(import Init List.mem_cons_of_mem)
(import Init Nat.lt_irrefl)
(import Init Nat.lt_of_lt_of_le)
(import Init Nat.mod_mul_left_mod)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "rt.shard")
(import "heap.shard")
(import "readback.shard")
(import "cell.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.imp.IpFn)
(use models.imp.rt)
(use models.imp.heap)
(use models.imp.heap.HCell)
(use models.imp.heap.HRaw)
(use models.imp.heap.GHeap)
(use models.imp.heap.Ext)
(use models.imp.readback)
(use models.imp.cell)

;; ---- the record updaters at a constructor ----------------------------------------------------------
(theorem gcells_with_graw ((g GHeap) (o (Option HRaw))) (= (GHeap.gcells (GHeap.with_graw o g)) (GHeap.gcells g))
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))
(theorem gend_with_graw ((g GHeap) (o (Option HRaw))) (= (GHeap.gend (GHeap.with_graw o g)) (GHeap.gend g))
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))
(theorem graw_with_graw ((g GHeap) (o (Option HRaw))) (= (GHeap.graw (GHeap.with_graw o g)) o)
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))
(theorem gcells_with_gcells ((g GHeap) (cs2 (List HCell))) (= (GHeap.gcells (GHeap.with_gcells cs2 g)) cs2)
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))
(theorem gend_with_gcells ((g GHeap) (cs2 (List HCell))) (= (GHeap.gend (GHeap.with_gcells cs2 g)) (GHeap.gend g))
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))
(theorem graw_with_gcells ((g GHeap) (cs2 (List HCell))) (= (GHeap.graw (GHeap.with_gcells cs2 g)) (GHeap.graw g))
  (by (cases g ((MkGHeap (cs fl lo top ed raw) rfl)))))

;; ---- the fill under a known raw cell ---------------------------------------------------------------
(theorem gh_fill_some ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (w Nat) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (gh_fill g w) (GHeap.with_graw (Option.some (MkHRaw p tag n (List.append fill (List.cons w List.nil)))) g))
  (by (unfold gh_fill) (rw hraw) (reduce lhs) rfl))
(theorem gcells_fill ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (w Nat) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.gcells (gh_fill g w)) (GHeap.gcells g))
  (by (rw (gh_fill_some g p tag n fill w hraw)) (exact (gcells_with_graw g (Option.some (MkHRaw p tag n (List.append fill (List.cons w List.nil))))))))
(theorem gend_fill ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (w Nat) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.gend (gh_fill g w)) (GHeap.gend g))
  (by (rw (gh_fill_some g p tag n fill w hraw)) (exact (gend_with_graw g (Option.some (MkHRaw p tag n (List.append fill (List.cons w List.nil))))))))
(theorem graw_fill ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (w Nat) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.graw (gh_fill g w)) (Option.some (MkHRaw p tag n (List.append fill (List.cons w List.nil)))))
  (by (rw (gh_fill_some g p tag n fill w hraw)) (exact (graw_with_graw g (Option.some (MkHRaw p tag n (List.append fill (List.cons w List.nil))))))))

;; ---- the seal under a known raw cell ---------------------------------------------------------------
(theorem gh_seal_some ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (gh_seal g) (GHeap.with_graw Option.none (GHeap.with_gcells (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g)) g)))
  (by (unfold gh_seal) (rw hraw) (reduce lhs) rfl))
(theorem gcells_seal ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.gcells (gh_seal g)) (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g)))
  (by (rw (gh_seal_some g p tag n fill hraw))
      (rw (gcells_with_graw (GHeap.with_gcells (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g)) g) Option.none))
      (exact (gcells_with_gcells g (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g))))))
(theorem gend_seal ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.gend (gh_seal g)) (GHeap.gend g))
  (by (rw (gh_seal_some g p tag n fill hraw))
      (rw (gend_with_graw (GHeap.with_gcells (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g)) g) Option.none))
      (exact (gend_with_gcells g (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g))))))
(theorem graw_seal ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (GHeap.graw (gh_seal g)) Option.none)
  (by (rw (gh_seal_some g p tag n fill hraw))
      (exact (graw_with_graw (GHeap.with_gcells (List.cons (MkHCell p 1 tag n fill) (GHeap.gcells g)) g) Option.none))))

;; ---- the increment: the ghost, or the ghost with one count raised ---------------------------------
(theorem gh_inc_odd ((g GHeap) (v Nat) (h (= (% v 2) 1))) (= (gh_inc g v) g)
  (by (unfold gh_inc) (rw (if_pos h)) rfl))
(theorem gh_inc_shape ((g GHeap) (v Nat))
  (Or (= (gh_inc g v) g) (= (gh_inc g v) (GHeap.with_gcells (hincc (GHeap.gcells g) v) g)))
  (by (unfold gh_inc)
      (cases (Nat.decEq (% v 2) 1) hpar
        ((isTrue (ho) (rw (if_pos ho)) (exact (Or.inl (Eq.refl g))))
         (isFalse (hn) (rw (if_neg hn))
           (cases (hfind (GHeap.gcells g) v) hfd
             ((none () (exact (Or.inl (Eq.refl g))))
              (some (c)
                (show (Or (= (if (<= 2147483648 (HCell.hcount c)) g (GHeap.with_gcells (hincc (GHeap.gcells g) v) g)) g)
                          (= (if (<= 2147483648 (HCell.hcount c)) g (GHeap.with_gcells (hincc (GHeap.gcells g) v) g)) (GHeap.with_gcells (hincc (GHeap.gcells g) v) g))))
                (cases (Nat.decLe 2147483648 (HCell.hcount c)) himm
                  ((isTrue (hi) (rw (if_pos hi)) (exact (Or.inl (Eq.refl g))))
                   (isFalse (hni) (rw (if_neg hni)) (exact (Or.inr (Eq.refl (GHeap.with_gcells (hincc (GHeap.gcells g) v) g)))))))))))))))
(theorem gend_inc ((g GHeap) (v Nat)) (= (GHeap.gend (gh_inc g v)) (GHeap.gend g))
  (by (cases (gh_inc_shape g v) ((inl (h) (rw h) rfl) (inr (h) (rw h) (exact (gend_with_gcells g (hincc (GHeap.gcells g) v))))))))
(theorem graw_inc ((g GHeap) (v Nat)) (= (GHeap.graw (gh_inc g v)) (GHeap.graw g))
  (by (cases (gh_inc_shape g v) ((inl (h) (rw h) rfl) (inr (h) (rw h) (exact (graw_with_gcells g (hincc (GHeap.gcells g) v))))))))
;; the operations at a constructor cell, as rewriting kit (the reducer at an `if` over an open
;; condition leaves the projections of the constructor alone; these state the reduced forms)
(theorem haddr_mk ((ad Nat) (cnt Nat) (tg Nat) (ar Nat) (sl (List Nat))) (= (HCell.haddr (MkHCell ad cnt tg ar sl)) ad) (by rfl))
(theorem hsig_mk ((ad Nat) (cnt Nat) (tg Nat) (ar Nat) (sl (List Nat))) (= (hsig (MkHCell ad cnt tg ar sl)) (MkHCell ad 0 tg ar sl)) (by (unfold hsig) rfl))
(theorem haddrs_mk ((ad Nat) (cnt Nat) (tg Nat) (ar Nat) (sl (List Nat)) (rest (List HCell)))
  (= (haddrs (List.cons (MkHCell ad cnt tg ar sl) rest)) (List.cons ad (haddrs rest))) (by (unfold haddrs) rfl))
(theorem hfget_mk ((ad Nat) (cnt Nat) (tg Nat) (ar Nat) (sl (List Nat)) (rest (List HCell)) (w Nat))
  (= (hfget (List.cons (MkHCell ad cnt tg ar sl) rest) w) (if (= ad w) (MkHCell ad cnt tg ar sl) (hfget rest w)))
  (by (cases (Nat.decEq ad w)
        ((isTrue (h) (rw (if_pos h)) (rw h) (exact (hfget_head (MkHCell w cnt tg ar sl) rest)))
         (isFalse (h) (rw (if_neg h)) (have h2 (Not (= (HCell.haddr (MkHCell ad cnt tg ar sl)) w)) (exact h)) (exact (hfget_tail (MkHCell ad cnt tg ar sl) rest w h2)))))))
(theorem hincc_mk ((ad Nat) (cnt Nat) (tg Nat) (ar Nat) (sl (List Nat)) (rest (List HCell)) (a Nat))
  (= (hincc (List.cons (MkHCell ad cnt tg ar sl) rest) a) (if (= ad a) (List.cons (MkHCell ad (+ cnt 1) tg ar sl) rest) (List.cons (MkHCell ad cnt tg ar sl) (hincc rest a))))
  (by (unfold hincc) rfl))
;; the raised count leaves the addresses and every cell's signature
(theorem haddrs_hincc ((cs (List HCell)) (a Nat)) (= (haddrs (hincc cs a)) (haddrs cs))
  (by (induction cs
        ((nil () rfl)
         (cons (c rest ih)
           (cases c ((MkHCell (ad cnt tg ar sl)
             (rw (hincc_mk ad cnt tg ar sl rest a))
             (cases (Nat.decEq ad a)
               ((isTrue (he) (rw (if_pos he)) (rw (haddrs_mk ad (+ cnt 1) tg ar sl rest)) (rw (haddrs_mk ad cnt tg ar sl rest)) rfl)
                (isFalse (hne) (rw (if_neg hne)) (rw (haddrs_mk ad cnt tg ar sl (hincc rest a))) (rw (haddrs_mk ad cnt tg ar sl rest)) (rw ih) rfl)))))))))))
(theorem hfget_hincc ((cs (List HCell)) (a Nat) (w Nat)) (= (hsig (hfget (hincc cs a) w)) (hsig (hfget cs w)))
  (by (induction cs
        ((nil () rfl)
         (cons (c rest ih)
           (cases c ((MkHCell (ad cnt tg ar sl)
             (rw (hincc_mk ad cnt tg ar sl rest a))
             (cases (Nat.decEq ad a)
               ((isTrue (he) (rw (if_pos he))
                  (rw (hfget_mk ad (+ cnt 1) tg ar sl rest w)) (rw (hfget_mk ad cnt tg ar sl rest w))
                  (cases (Nat.decEq ad w)
                    ((isTrue (hw) (rw (if_pos hw)) (rw (if_pos hw)) (rw (hsig_mk ad (+ cnt 1) tg ar sl)) (rw (hsig_mk ad cnt tg ar sl)) rfl)
                     (isFalse (hnw) (rw (if_neg hnw)) (rw (if_neg hnw)) rfl))))
                (isFalse (hne) (rw (if_neg hne))
                  (rw (hfget_mk ad cnt tg ar sl (hincc rest a) w)) (rw (hfget_mk ad cnt tg ar sl rest w))
                  (cases (Nat.decEq ad w)
                    ((isTrue (hw) (rw (if_pos hw)) (rw (if_pos hw)) rfl)
                     (isFalse (hnw) (rw (if_neg hnw)) (rw (if_neg hnw)) (exact ih)))))))))))))))
(theorem rbl_hincc ((cs (List HCell)) (a Nat) (x (List Int)))
  (forall ((w Nat)) (-> (rb_list cs w x) (rb_list (hincc cs a) w x)))
  (by (induction x
        ((nil () (intro w h) (have h1 (= w 1) (exact h)) (exact h1))
         (cons (h t ih) (intro w hr)
           (have hr2 (And (rb_cell cs w 1 2) (And (rb_int (rb_slot cs w 0) h) (rb_list cs (rb_slot cs w 1) t))) (exact hr))
           (have hc (rb_cell cs w 1 2) (exact (And.left hr2)))
           (have hc2 (And (= (% w 2) 0) (And (List.Mem w (haddrs cs)) (And (= (HCell.htag (hfget cs w)) 1) (= (HCell.harity (hfget cs w)) 2)))) (exact hc))
           (have hsig (= (hsig (hfget (hincc cs a) w)) (hsig (hfget cs w))) (exact (hfget_hincc cs a w)))
           (have htag (= (HCell.htag (hfget (hincc cs a) w)) (HCell.htag (hfget cs w))) (exact (congrArg (fun ((c HCell)) (HCell.htag c)) hsig)))
           (have har (= (HCell.harity (hfget (hincc cs a) w)) (HCell.harity (hfget cs w))) (exact (congrArg (fun ((c HCell)) (HCell.harity c)) hsig)))
           (have hsl (= (HCell.hslots (hfget (hincc cs a) w)) (HCell.hslots (hfget cs w))) (exact (congrArg (fun ((c HCell)) (HCell.hslots c)) hsig)))
           (have hmem (List.Mem w (haddrs (hincc cs a))) (rw (haddrs_hincc cs a)) (exact (And.left (And.right hc2))))
           (show (And (And (= (% w 2) 0) (And (List.Mem w (haddrs (hincc cs a))) (And (= (HCell.htag (hfget (hincc cs a) w)) 1) (= (HCell.harity (hfget (hincc cs a) w)) 2))))
                      (And (rb_int (List.getD (HCell.hslots (hfget (hincc cs a) w)) 0 0) h) (rb_list (hincc cs a) (List.getD (HCell.hslots (hfget (hincc cs a) w)) 1 0) t))))
           (rw htag) (rw har) (rw hsl)
           (exact (And.intro (And.intro (And.left hc2) (And.intro hmem (And.right (And.right hc2))))
                             (And.intro (And.left (And.right hr2)) (ih (rb_slot cs w 1) (And.right (And.right hr2)))))))))))
(theorem rbl_inc ((g GHeap) (v Nat) (w Nat) (x (List Int)) (hr (rb_list (GHeap.gcells g) w x))) (rb_list (GHeap.gcells (gh_inc g v)) w x)
  (by (cases (gh_inc_shape g v)
        ((inl (h) (rw h) (exact hr))
         (inr (h) (rw h) (rw (gcells_with_gcells g (hincc (GHeap.gcells g) v))) (exact (rbl_hincc (GHeap.gcells g) v x w hr)))))))

;; ---- a new cell at the head keeps every readback of the old cells (the seal) ----------------------
(theorem rbl_seal ((cs (List HCell)) (c HCell) (x (List Int)) (hfresh (Not (List.Mem (HCell.haddr c) (haddrs cs)))))
  (forall ((w Nat)) (-> (rb_list cs w x) (rb_list (List.cons c cs) w x)))
  (by (induction x
        ((nil () (intro w h) (have h1 (= w 1) (exact h)) (exact h1))
         (cons (h t ih) (intro w hr)
           (have hr2 (And (rb_cell cs w 1 2) (And (rb_int (rb_slot cs w 0) h) (rb_list cs (rb_slot cs w 1) t))) (exact hr))
           (have hc2 (And (= (% w 2) 0) (And (List.Mem w (haddrs cs)) (And (= (HCell.htag (hfget cs w)) 1) (= (HCell.harity (hfget cs w)) 2)))) (exact (And.left hr2)))
           (have hmem (List.Mem w (haddrs cs)) (exact (And.left (And.right hc2))))
           (have hne (Not (= (HCell.haddr c) w)) (intro he) (have hm2 (List.Mem (HCell.haddr c) (haddrs cs)) (rw he) (exact hmem)) (exact (hfresh hm2)))
           (have hfg (= (hfget (List.cons c cs) w) (hfget cs w)) (exact (hfget_tail c cs w hne)))
           (have hmem2 (List.Mem w (haddrs (List.cons c cs))) (exact (List.mem_cons_of_mem (HCell.haddr c) hmem)))
           (show (And (And (= (% w 2) 0) (And (List.Mem w (haddrs (List.cons c cs))) (And (= (HCell.htag (hfget (List.cons c cs) w)) 1) (= (HCell.harity (hfget (List.cons c cs) w)) 2))))
                      (And (rb_int (List.getD (HCell.hslots (hfget (List.cons c cs) w)) 0 0) h) (rb_list (List.cons c cs) (List.getD (HCell.hslots (hfget (List.cons c cs) w)) 1 0) t))))
           (rw hfg)
           (exact (And.intro (And.intro (And.left hc2) (And.intro hmem2 (And.right (And.right hc2))))
                             (And.intro (And.left (And.right hr2)) (ih (rb_slot cs w 1) (And.right (And.right hr2)))))))))))

;; ---- the raw cell under the invariant: fresh, and inside the window ------------------------------
(theorem e_disj1_app_r ((a Nat) (k Nat) (xs (List Ext)) (ys (List Ext))) (-> (e_disj1 a k (List.append xs ys)) (e_disj1 a k ys))
  (by (induction xs
        ((nil () (intro h) (exact h))
         (cons (e rest ih) (intro h)
           (cases e ((Ext (b j)
             (have h2 (And (e_disj2 a k b j) (e_disj1 a k (List.append rest ys))) (exact h))
             (exact (ih (And.right h2)))))))))))
(theorem e_disj_hexts ((cs (List HCell)) (ys (List Ext)) (a Nat))
  (-> (e_disj (List.append (hexts cs) ys)) (-> (List.Mem a (haddrs cs)) (exists ((k Nat)) (e_disj1 a k ys))))
  (by (induction cs
        ((nil () (intro hd hm) (have hm2 (List.Mem a List.nil) (exact hm)) (exact (False.elim (Iff.mp (List.mem_nil_iff a) hm2))))
         (cons (c rest ih) (intro hd hm)
           (have hd2 (And (e_disj1 (HCell.haddr c) (HCell.harity c) (List.append (hexts rest) ys)) (e_disj (List.append (hexts rest) ys))) (exact hd))
           (cases (haddrs_mem c rest a hm)
             ((inl (he) (rw he) (exact (Exists.intro (HCell.harity c) (e_disj1_app_r (HCell.haddr c) (HCell.harity c) (hexts rest) ys (And.left hd2)))))
              (inr (hm2) (exact (ih (And.right hd2) hm2))))))))))
(theorem e_disj1_raw ((a Nat) (k Nat) (p Nat) (n Nat)) (-> (e_disj1 a k (List.cons (Ext p n) List.nil)) (Not (= a p)))
  (by (intro h hap)
      (have h2 (And (Or (<= (+ a (+ 8 (* 8 k))) p) (<= (+ p (+ 8 (* 8 n))) a)) True) (exact h))
      (cases (And.left h2)
        ((inl (h1) (have h4 (< a (+ a (+ 8 (* 8 k)))) (arith)) (have h5 (< p (+ a (+ 8 (* 8 k)))) (rw (Eq.symm hap)) (exact h4)) (exact (Nat.lt_irrefl p (Nat.lt_of_lt_of_le h5 h1))))
         (inr (h1) (have h4 (< p (+ p (+ 8 (* 8 n)))) (arith)) (have h5 (< a (+ p (+ 8 (* 8 n)))) (rw hap) (exact h4)) (exact (Nat.lt_irrefl a (Nat.lt_of_lt_of_le h5 h1))))))))
;; the invariant's first four conjuncts and its extents
(theorem hinv_bounds ((rb Nat) (g GHeap) (r (List Nat)) (hinvr (hinv rb g r)))
  (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (<= (GHeap.gend g) 4294967296))))
  (by (have hi2 (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (And (<= (GHeap.gend g) 4294967296)
                 (And (= (% (GHeap.glo g) 8) 0) (And (= (% (GHeap.gtop g) 8) 0) (And (e_disj (ext_all g)) (And (e_brk (ext_all g) (GHeap.glo g) (GHeap.gtop g))
                 (And (cells_ok (GHeap.gcells g)) (And (counts_ok (GHeap.gcells g) (GHeap.gcells g) r (GHeap.graw g)) (And (roots_ok r (haddrs (GHeap.gcells g))) (raw_ok (GHeap.graw g) (GHeap.gcells g)))))))))))))
        (exact hinvr))
      (exact (And.intro (And.left hi2) (And.intro (And.left (And.right hi2)) (And.intro (And.left (And.right (And.right hi2))) (And.left (And.right (And.right (And.right hi2))))))))))
(theorem hinv_exts ((rb Nat) (g GHeap) (r (List Nat)) (hinvr (hinv rb g r)))
  (And (e_disj (ext_all g)) (e_brk (ext_all g) (GHeap.glo g) (GHeap.gtop g)))
  (by (have hi2 (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (And (<= (GHeap.gend g) 4294967296)
                 (And (= (% (GHeap.glo g) 8) 0) (And (= (% (GHeap.gtop g) 8) 0) (And (e_disj (ext_all g)) (And (e_brk (ext_all g) (GHeap.glo g) (GHeap.gtop g))
                 (And (cells_ok (GHeap.gcells g)) (And (counts_ok (GHeap.gcells g) (GHeap.gcells g) r (GHeap.graw g)) (And (roots_ok r (haddrs (GHeap.gcells g))) (raw_ok (GHeap.graw g) (GHeap.gcells g)))))))))))))
        (exact hinvr))
      (exact (And.intro (And.left (And.right (And.right (And.right (And.right (And.right (And.right hi2)))))))
                        (And.left (And.right (And.right (And.right (And.right (And.right (And.right (And.right hi2))))))))))))
(theorem rexts_some ((g GHeap) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (= (rexts (GHeap.graw g)) (List.cons (Ext p n) List.nil))
  (by (rw hraw) (reduce lhs) rfl))
;; no live cell sits at the raw cell's address
(theorem raw_fresh ((rb Nat) (g GHeap) (r (List Nat)) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hinvr (hinv rb g r)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (Not (List.Mem p (haddrs (GHeap.gcells g))))
  (by (intro hm)
      (have hdisj (e_disj (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g))))) (exact (And.left (hinv_exts rb g r hinvr))))
      (have hdisj2 (e_disj (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil)))) (rw (Eq.symm (rexts_some g p tag n fill hraw))) (exact hdisj))
      (cases (e_disj_hexts (GHeap.gcells g) (List.append (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil)) p hdisj2 hm)
        ((intro (k hk) (exact (e_disj1_raw p k p n (e_disj1_app_r p k (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil) hk) (Eq.refl p))))))))
(theorem e_brk_app_r ((xs (List Ext)) (ys (List Ext)) (lo Nat) (top Nat)) (-> (e_brk (List.append xs ys) lo top) (e_brk ys lo top))
  (by (induction xs
        ((nil () (intro h) (exact h))
         (cons (e rest ih) (intro h)
           (cases e ((Ext (x n)
             (have h2 (And (<= lo x) (And (<= (+ x (+ 8 (* 8 n))) top) (And (= (% x 8) 0) (e_brk (List.append rest ys) lo top)))) (exact h))
             (exact (ih (And.right (And.right (And.right h2)))))))))))))
;; the raw cell's extent inside the window, 8-aligned
(theorem raw_window ((rb Nat) (g GHeap) (r (List Nat)) (p Nat) (tag Nat) (n Nat) (fill (List Nat)) (hinvr (hinv rb g r)) (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (And (<= (+ rb 152) p) (And (<= (+ p (+ 8 (* 8 n))) (GHeap.gend g)) (And (<= (GHeap.gend g) 4294967296) (= (% p 8) 0))))
  (by (have hb (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (<= (GHeap.gend g) 4294967296)))) (exact (hinv_bounds rb g r hinvr)))
      (have hbrk (e_brk (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g)))) (GHeap.glo g) (GHeap.gtop g)) (exact (And.right (hinv_exts rb g r hinvr))))
      (have hbrk2 (e_brk (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil))) (GHeap.glo g) (GHeap.gtop g)) (rw (Eq.symm (rexts_some g p tag n fill hraw))) (exact hbrk))
      (have hlast (e_brk (List.cons (Ext p n) List.nil) (GHeap.glo g) (GHeap.gtop g))
        (exact (e_brk_app_r (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil) (GHeap.glo g) (GHeap.gtop g)
                 (e_brk_app_r (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (List.cons (Ext p n) List.nil)) (GHeap.glo g) (GHeap.gtop g) hbrk2))))
      (have hl2 (And (<= (GHeap.glo g) p) (And (<= (+ p (+ 8 (* 8 n))) (GHeap.gtop g)) (And (= (% p 8) 0) True))) (exact hlast))
      (have b1 (<= (+ rb 152) (GHeap.glo g)) (exact (And.left hb)))
      (have b2 (<= (GHeap.glo g) (GHeap.gtop g)) (exact (And.left (And.right hb))))
      (have b3 (<= (GHeap.gtop g) (GHeap.gend g)) (exact (And.left (And.right (And.right hb)))))
      (have b4 (<= (GHeap.gend g) 4294967296) (exact (And.right (And.right (And.right hb)))))
      (have b5 (<= (GHeap.glo g) p) (exact (And.left hl2)))
      (have b6 (<= (+ p (+ 8 (* 8 n))) (GHeap.gtop g)) (exact (And.left (And.right hl2))))
      (apply And.intro (arith) ((apply And.intro (arith) ((apply And.intro (exact b4) (exact (And.left (And.right (And.right hl2)))))))))))
;; an 8-aligned address is even
(theorem even_of_mod8 ((p Nat) (h (= (% p 8) 0))) (= (% p 2) 0)
  (by (have h1 (= (% (% p (* 4 2)) 2) (% p 2)) (exact (Nat.mod_mul_left_mod p 4 2)))
      (have h2 (= (% p (* 4 2)) 0) (exact h))
      (rw (Eq.symm h1)) (rw h2) rfl))

;; ---- a readback's word: an immediate or a live address, below 2^32 --------------------------------
(theorem rbl_slot_ok ((cs (List HCell)) (w Nat) (v (List Int)) (h (rb_list cs w v))) (slot_ok w (haddrs cs))
  (by (cases v
        ((nil () (have h1 (= w 1) (exact h)) (rw h1) (exact (Or.inl (Eq.refl 1))))
         (cons (x t)
           (have h2 (And (rb_cell cs w 1 2) (And (rb_int (rb_slot cs w 0) x) (rb_list cs (rb_slot cs w 1) t))) (exact h))
           (have hc2 (And (= (% w 2) 0) (And (List.Mem w (haddrs cs)) (And (= (HCell.htag (hfget cs w)) 1) (= (HCell.harity (hfget cs w)) 2)))) (exact (And.left h2)))
           (exact (Or.inr (And.left (And.right hc2)))))))))
(theorem rbl_bound ((rb Nat) (g GHeap) (r (List Nat)) (w Nat) (v (List Int)) (hinvr (hinv rb g r)) (h (rb_list (GHeap.gcells g) w v))) (< w 4294967296)
  (by (cases v
        ((nil () (have h1 (= w 1) (exact h)) (rw h1) (arith))
         (cons (x t)
           (have h2 (And (rb_cell (GHeap.gcells g) w 1 2) (And (rb_int (rb_slot (GHeap.gcells g) w 0) x) (rb_list (GHeap.gcells g) (rb_slot (GHeap.gcells g) w 1) t))) (exact h))
           (have hc2 (And (= (% w 2) 0) (And (List.Mem w (haddrs (GHeap.gcells g))) (And (= (HCell.htag (hfget (GHeap.gcells g) w)) 1) (= (HCell.harity (hfget (GHeap.gcells g) w)) 2)))) (exact (And.left h2)))
           (have hmem (List.Mem w (haddrs (GHeap.gcells g))) (exact (And.left (And.right hc2))))
           (have hb (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (<= (GHeap.gend g) 4294967296)))) (exact (hinv_bounds rb g r hinvr)))
           (have hbrk (e_brk (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g)))) (GHeap.glo g) (GHeap.gtop g)) (exact (And.right (hinv_exts rb g r hinvr))))
           (have hbrk2 (e_brk (hexts (GHeap.gcells g)) (GHeap.glo g) (GHeap.gtop g)) (exact (e_brk_app_l (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g))) (GHeap.glo g) (GHeap.gtop g) hbrk)))
           (have hx (And (<= (GHeap.glo g) w) (And (<= (+ w (+ 8 (* 8 (HCell.harity (hfget (GHeap.gcells g) w))))) (GHeap.gtop g)) (= (% w 8) 0))) (exact (e_brk_hexts (GHeap.gcells g) w (GHeap.glo g) (GHeap.gtop g) hbrk2 hmem)))
           (have b3 (<= (GHeap.gtop g) (GHeap.gend g)) (exact (And.left (And.right (And.right hb)))))
           (have b4 (<= (GHeap.gend g) 4294967296) (exact (And.right (And.right (And.right hb)))))
           (have b5 (<= (+ w (+ 8 (* 8 (HCell.harity (hfget (GHeap.gcells g) w))))) (GHeap.gtop g)) (exact (And.left (And.right hx))))
           (arith))))))

;; ---- the roots: a reference joins, a consumed reference leaves ------------------------------------
(theorem rinc_odd ((r (List Nat)) (w Nat) (h (= (% w 2) 1))) (= (rinc r w) r) (by (unfold rinc) (rw (if_pos h)) rfl))
(theorem rinc_even ((r (List Nat)) (w Nat) (h (Not (= (% w 2) 1)))) (= (rinc r w) (List.cons w r)) (by (unfold rinc) (rw (if_neg h)) rfl))
(theorem rdec_odd ((r (List Nat)) (w Nat) (h (= (% w 2) 1))) (= (rdec r w) r) (by (unfold rdec) (rw (if_pos h)) rfl))
(theorem rdec_rinc ((r (List Nat)) (w Nat)) (= (rdec (rinc r w) w) r)
  (by (cases (Nat.decEq (% w 2) 1) hpar
        ((isTrue (ho) (rw (rinc_odd r w ho)) (exact (rdec_odd r w ho)))
         (isFalse (hn) (rw (rinc_even r w hn)) (unfold rdec) (rw (if_neg hn)) (unfold irem) (rw (if_pos (Eq.refl w))) rfl)))))
(theorem root_rinc ((r (List Nat)) (w Nat)) (Or (= (% w 2) 1) (List.Mem w (rinc r w)))
  (by (cases (Nat.decEq (% w 2) 1) hpar
        ((isTrue (ho) (exact (Or.inl ho)))
         (isFalse (hn) (rw (rinc_even r w hn)) (exact (Or.inr List.mem_cons_self)))))))

;; ---- the runtime table's entries -----------------------------------------------------------------------
(theorem rt_at_alloc ((rb Nat) (fs (List IpFn))) (= (ipfn_at (List.append (rt_fns rb) fs) 1) (Option.some (rt_alloc_fn rb)))
  (by (unfold rt_fns) (reduce lhs) rfl))
(theorem rt_at_inc ((rb Nat) (fs (List IpFn))) (= (ipfn_at (List.append (rt_fns rb) fs) 2) (Option.some (rt_inc_fn rb)))
  (by (unfold rt_fns) (reduce lhs) rfl))
(theorem rt_alloc_params ((rb Nat)) (= (List.length (IpFn.ipparams (rt_alloc_fn rb))) 2) (by (unfold rt_alloc_fn) (reduce lhs) rfl))
(theorem rt_inc_params ((rb Nat)) (= (List.length (IpFn.ipparams (rt_inc_fn rb))) 1) (by (unfold rt_inc_fn) (reduce lhs) rfl))
