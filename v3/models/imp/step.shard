;;; v3/models/imp/step.shard — the evaluator's step laws (slice 4.2 landing 1): one law per
;;; statement kind and per outcome, at fuel `FS f` with the sub-runs' results as hypotheses, so a
;;; certificate steps through a product one statement at a time by rewriting — the old
;;; tbh_kit's st_* laws, re-proven here over `ipeval`'s equations by `unfold` and `rw`, a matcher
;;; at a constructor taken by name (`unfold ipeval.match_N`: one case step, nothing else touched).
;;; The whole-run normalization by `reduce` alone was measured at over ten minutes and 11 GB on
;;; the cons case of `len` and abandoned (the as-built records it).
(import Init Nat.sub_one_lt)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.imp.IFam)
(use models.imp.imp.Fuel)
(use models.imp.imp.IpStmt)
(use models.imp.imp.IpTask)
(use models.imp.imp.IpRes)
(use models.imp.imp.IpOut)
(use models.imp.imp.IpRet)

;; ---- statement lists ------------------------------------------------------------------------------
(theorem stmts_nil ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (lc (List Nat)) (mem Mem))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmts List.nil lc mem)) (RStmt (Option.some (IpNorm lc mem))))
  (by (unfold ipeval) (reduce lhs) rfl))
(theorem stmts_cons ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (s IpStmt) (t (List IpStmt)) (lc (List Nat)) (mem Mem) (lc2 (List Nat)) (mem2 Mem) (R IpRes)
                     (h1 (= (ipeval f fs mlo msz dmax d (TStmt s lc mem)) (RStmt (Option.some (IpNorm lc2 mem2)))))
                     (h2 (= (ipeval f fs mlo msz dmax d (TStmts t lc2 mem2)) R)))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmts (List.cons s t) lc mem)) R)
  (by (unfold ipeval) (reduce lhs) (rw h1) (reduce lhs) (rw h2) rfl))
(theorem stmts_cons_fail ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (s IpStmt) (t (List IpStmt)) (lc (List Nat)) (mem Mem) (fam IFam)
                          (h1 (= (ipeval f fs mlo msz dmax d (TStmt s lc mem)) (RStmt (Option.some (IpFailed fam))))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmts (List.cons s t) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (unfold ipeval) (reduce lhs) (rw h1) (reduce lhs) rfl))

;; ---- statements -------------------------------------------------------------------------------------
(theorem stmt_set ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (e IExp) (lc (List Nat)) (mem Mem) (v Nat) (lc2 (List Nat))
                   (he (= (iexp e lc mem mlo msz) (Option.some v))) (hs (= (ilset lc i v) (Option.some lc2))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpSet i e) lc mem)) (RStmt (Option.some (IpNorm lc2 mem))))
  (by (unfold ipeval) (reduce lhs) (rw he) (reduce lhs) (rw hs) (reduce lhs) rfl))
(theorem stmt_if_z ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (c IExp) (tb (List IpStmt)) (eb (List IpStmt)) (lc (List Nat)) (mem Mem) (cv Nat)
                    (he (= (iexp c lc mem mlo msz) (Option.some cv))) (hc (= cv 0)))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpIf c tb eb) lc mem)) (ipeval f fs mlo msz dmax d (TStmts eb lc mem)))
  (by (unfold ipeval) (reduce lhs) (rw he) (reduce lhs) (rw (if_pos hc)) rfl))
(theorem stmt_if_nz ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (c IExp) (tb (List IpStmt)) (eb (List IpStmt)) (lc (List Nat)) (mem Mem) (cv Nat)
                     (he (= (iexp c lc mem mlo msz) (Option.some cv))) (hc (Not (= cv 0))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpIf c tb eb) lc mem)) (ipeval f fs mlo msz dmax d (TStmts tb lc mem)))
  (by (unfold ipeval) (reduce lhs) (rw he) (reduce lhs) (rw (if_neg hc)) rfl))
(theorem stmt_loadw ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (ae IExp) (lc (List Nat)) (mem Mem) (ad Nat) (lc2 (List Nat))
                     (he (= (iexp ae lc mem mlo msz) (Option.some ad))) (hlo (<= mlo ad)) (hhi (<= (+ ad 8) msz))
                     (hs (= (ilset lc i (load_le 8 mem ad)) (Option.some lc2))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpLoadW i ae) lc mem)) (RStmt (Option.some (IpNorm lc2 mem))))
  (by (unfold ipeval) (rw he) (unfold ipeval.match_11) (rw (if_pos hlo)) (rw (if_pos hhi)) (rw hs) (unfold ipeval.match_10) rfl))
(theorem stmt_call_ret ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (k Nat) (args (List IExp)) (lc (List Nat)) (mem Mem) (vs (List Nat)) (v Nat) (mem2 Mem) (lc2 (List Nat))
                        (ha (= (ipexps args lc mem mlo msz) (Option.some vs)))
                        (hr (= (ipeval f fs mlo msz dmax d (TCall k vs mem)) (RCall (Option.some (IpRv v mem2)))))
                        (hs (= (ilset lc i v) (Option.some lc2))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpCall i k args) lc mem)) (RStmt (Option.some (IpNorm lc2 mem2))))
  (by (unfold ipeval) (rw ha) (unfold ipeval.match_9) (rw hr) (unfold ret_of) (unfold ipeval.match_8) (unfold ipeval.match_7) (rw hs) (unfold ipeval.match_6) rfl))
(theorem stmt_call_fail ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (k Nat) (args (List IExp)) (lc (List Nat)) (mem Mem) (vs (List Nat)) (fam IFam)
                         (ha (= (ipexps args lc mem mlo msz) (Option.some vs)))
                         (hr (= (ipeval f fs mlo msz dmax d (TCall k vs mem)) (RCall (Option.some (IpRfailed fam))))))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpCall i k args) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (unfold ipeval) (rw ha) (unfold ipeval.match_9) (rw hr) (unfold ret_of) (unfold ipeval.match_8) (unfold ipeval.match_7) rfl))
(theorem stmt_fail ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (fam IFam) (lc (List Nat)) (mem Mem))
  (= (ipeval (FS f) fs mlo msz dmax d (TStmt (IpFail fam) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (unfold ipeval) rfl))

;; ---- the call ----------------------------------------------------------------------------------------
(theorem call_ret ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn) (lc2 (List Nat)) (mem2 Mem) (v Nat)
                   (ht (= (ipfn_at fs k) (Option.some fn)))
                   (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                   (hd (< d dmax))
                   (hb (= (ipeval f fs mlo msz dmax (+ d 1) (TStmts (IpFn.ipbody fn) (List.append (iband_args (IpFn.ipparams fn) args) (izeros_of (IpFn.ipextra fn))) mem)) (RStmt (Option.some (IpNorm lc2 mem2)))))
                   (hv (= (iexp (IpFn.ipresult fn) lc2 mem2 mlo msz) (Option.some v))))
  (= (ipeval (FS f) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRv v mem2))))
  (by (unfold ipeval) (rw ht) (unfold ipeval.match_27) (rw (if_pos hl)) (rw (if_pos hd)) (rw hb) (unfold out_of) (unfold ipeval.match_26) (unfold ipeval.match_25) (rw hv) (unfold ipeval.match_24) rfl))
(theorem call_fail ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn) (fam IFam)
                    (ht (= (ipfn_at fs k) (Option.some fn)))
                    (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                    (hd (< d dmax))
                    (hb (= (ipeval f fs mlo msz dmax (+ d 1) (TStmts (IpFn.ipbody fn) (List.append (iband_args (IpFn.ipparams fn) args) (izeros_of (IpFn.ipextra fn))) mem)) (RStmt (Option.some (IpFailed fam))))))
  (= (ipeval (FS f) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRfailed fam))))
  (by (unfold ipeval) (rw ht) (unfold ipeval.match_27) (rw (if_pos hl)) (rw (if_pos hd)) (rw hb) (unfold out_of) (unfold ipeval.match_26) (unfold ipeval.match_25) rfl))
(theorem call_depth ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn)
                     (ht (= (ipfn_at fs k) (Option.some fn)))
                     (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                     (hd (Not (< d dmax))))
  (= (ipeval (FS f) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRfailed FStack))))
  (by (unfold ipeval) (rw ht) (unfold ipeval.match_27) (rw (if_pos hl)) (rw (if_neg hd)) rfl))

;; ---- the same over a Nat fuel, as the statement spells it ----------------------------------------
(theorem fuel_of_succ ((n Nat)) (= (fuel_of (+ n 1)) (FS (fuel_of n)))
  (by (rw fuel_of.eq_1) (reduce lhs) (rw (Nat.add_sub_cancel n 1)) rfl))
(theorem stmts_nil_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (lc (List Nat)) (mem Mem))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmts List.nil lc mem)) (RStmt (Option.some (IpNorm lc mem))))
  (by (rw (fuel_of_succ n)) (exact (stmts_nil (fuel_of n) fs mlo msz dmax d lc mem))))
(theorem stmts_cons_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (s IpStmt) (t (List IpStmt)) (lc (List Nat)) (mem Mem) (lc2 (List Nat)) (mem2 Mem) (R IpRes)
                       (h1 (= (ipeval (fuel_of n) fs mlo msz dmax d (TStmt s lc mem)) (RStmt (Option.some (IpNorm lc2 mem2)))))
                       (h2 (= (ipeval (fuel_of n) fs mlo msz dmax d (TStmts t lc2 mem2)) R)))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmts (List.cons s t) lc mem)) R)
  (by (rw (fuel_of_succ n)) (exact (stmts_cons (fuel_of n) fs mlo msz dmax d s t lc mem lc2 mem2 R h1 h2))))
(theorem stmts_cons_fail_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (s IpStmt) (t (List IpStmt)) (lc (List Nat)) (mem Mem) (fam IFam)
                            (h1 (= (ipeval (fuel_of n) fs mlo msz dmax d (TStmt s lc mem)) (RStmt (Option.some (IpFailed fam))))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmts (List.cons s t) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (rw (fuel_of_succ n)) (exact (stmts_cons_fail (fuel_of n) fs mlo msz dmax d s t lc mem fam h1))))
(theorem stmt_set_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (e IExp) (lc (List Nat)) (mem Mem) (v Nat) (lc2 (List Nat))
                     (he (= (iexp e lc mem mlo msz) (Option.some v))) (hs (= (ilset lc i v) (Option.some lc2))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpSet i e) lc mem)) (RStmt (Option.some (IpNorm lc2 mem))))
  (by (rw (fuel_of_succ n)) (exact (stmt_set (fuel_of n) fs mlo msz dmax d i e lc mem v lc2 he hs))))
(theorem stmt_if_z_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (c IExp) (tb (List IpStmt)) (eb (List IpStmt)) (lc (List Nat)) (mem Mem) (cv Nat)
                      (he (= (iexp c lc mem mlo msz) (Option.some cv))) (hc (= cv 0)))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpIf c tb eb) lc mem)) (ipeval (fuel_of n) fs mlo msz dmax d (TStmts eb lc mem)))
  (by (rw (fuel_of_succ n)) (exact (stmt_if_z (fuel_of n) fs mlo msz dmax d c tb eb lc mem cv he hc))))
(theorem stmt_if_nz_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (c IExp) (tb (List IpStmt)) (eb (List IpStmt)) (lc (List Nat)) (mem Mem) (cv Nat)
                       (he (= (iexp c lc mem mlo msz) (Option.some cv))) (hc (Not (= cv 0))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpIf c tb eb) lc mem)) (ipeval (fuel_of n) fs mlo msz dmax d (TStmts tb lc mem)))
  (by (rw (fuel_of_succ n)) (exact (stmt_if_nz (fuel_of n) fs mlo msz dmax d c tb eb lc mem cv he hc))))
(theorem stmt_loadw_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (ae IExp) (lc (List Nat)) (mem Mem) (ad Nat) (lc2 (List Nat))
                       (he (= (iexp ae lc mem mlo msz) (Option.some ad))) (hlo (<= mlo ad)) (hhi (<= (+ ad 8) msz))
                       (hs (= (ilset lc i (load_le 8 mem ad)) (Option.some lc2))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpLoadW i ae) lc mem)) (RStmt (Option.some (IpNorm lc2 mem))))
  (by (rw (fuel_of_succ n)) (exact (stmt_loadw (fuel_of n) fs mlo msz dmax d i ae lc mem ad lc2 he hlo hhi hs))))
(theorem stmt_call_ret_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (k Nat) (args (List IExp)) (lc (List Nat)) (mem Mem) (vs (List Nat)) (v Nat) (mem2 Mem) (lc2 (List Nat))
                          (ha (= (ipexps args lc mem mlo msz) (Option.some vs)))
                          (hr (= (ipeval (fuel_of n) fs mlo msz dmax d (TCall k vs mem)) (RCall (Option.some (IpRv v mem2)))))
                          (hs (= (ilset lc i v) (Option.some lc2))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpCall i k args) lc mem)) (RStmt (Option.some (IpNorm lc2 mem2))))
  (by (rw (fuel_of_succ n)) (exact (stmt_call_ret (fuel_of n) fs mlo msz dmax d i k args lc mem vs v mem2 lc2 ha hr hs))))
(theorem stmt_call_fail_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (i Nat) (k Nat) (args (List IExp)) (lc (List Nat)) (mem Mem) (vs (List Nat)) (fam IFam)
                           (ha (= (ipexps args lc mem mlo msz) (Option.some vs)))
                           (hr (= (ipeval (fuel_of n) fs mlo msz dmax d (TCall k vs mem)) (RCall (Option.some (IpRfailed fam))))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpCall i k args) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (rw (fuel_of_succ n)) (exact (stmt_call_fail (fuel_of n) fs mlo msz dmax d i k args lc mem vs fam ha hr))))
(theorem stmt_fail_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (fam IFam) (lc (List Nat)) (mem Mem))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmt (IpFail fam) lc mem)) (RStmt (Option.some (IpFailed fam))))
  (by (rw (fuel_of_succ n)) (exact (stmt_fail (fuel_of n) fs mlo msz dmax d fam lc mem))))
(theorem call_ret_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn) (lc2 (List Nat)) (mem2 Mem) (v Nat)
                     (ht (= (ipfn_at fs k) (Option.some fn)))
                     (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                     (hd (< d dmax))
                     (hb (= (ipeval (fuel_of n) fs mlo msz dmax (+ d 1) (TStmts (IpFn.ipbody fn) (List.append (iband_args (IpFn.ipparams fn) args) (izeros_of (IpFn.ipextra fn))) mem)) (RStmt (Option.some (IpNorm lc2 mem2)))))
                     (hv (= (iexp (IpFn.ipresult fn) lc2 mem2 mlo msz) (Option.some v))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRv v mem2))))
  (by (rw (fuel_of_succ n)) (exact (call_ret (fuel_of n) fs mlo msz dmax d k args mem fn lc2 mem2 v ht hl hd hb hv))))
(theorem call_fail_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn) (fam IFam)
                      (ht (= (ipfn_at fs k) (Option.some fn)))
                      (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                      (hd (< d dmax))
                      (hb (= (ipeval (fuel_of n) fs mlo msz dmax (+ d 1) (TStmts (IpFn.ipbody fn) (List.append (iband_args (IpFn.ipparams fn) args) (izeros_of (IpFn.ipextra fn))) mem)) (RStmt (Option.some (IpFailed fam))))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRfailed fam))))
  (by (rw (fuel_of_succ n)) (exact (call_fail (fuel_of n) fs mlo msz dmax d k args mem fn fam ht hl hd hb))))
(theorem call_depth_n ((n Nat) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn)
                       (ht (= (ipfn_at fs k) (Option.some fn)))
                       (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                       (hd (Not (< d dmax))))
  (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRfailed FStack))))
  (by (rw (fuel_of_succ n)) (exact (call_depth (fuel_of n) fs mlo msz dmax d k args mem fn ht hl hd))))
