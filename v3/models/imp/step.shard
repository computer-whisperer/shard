;;; v3/models/imp/step.shard — what a certificate's proof cites of the evaluator beside its run
;;; (slice 4.2 landing 1; cut to these three 2026-11-10): the call refused at the depth bound, the
;;; Nat fuel's successor as the structural fuel's, and a call's result record behind `ipcall`'s
;;; Option. The file held one law per statement kind and per outcome — at fuel `FS f` and again
;;; over a Nat fuel, the sub-runs' results as hypotheses — so that a certificate stepped through a
;;; product one statement at a time by rewriting: `reduce` over a whole run did not end in K (K
;;; re-deriving its conversion steps, found 2026-11-09, docs/records/REDUCE-2026-11-10.md). Since
;;; `reduce` shows K each step and takes the facts of a run (LANGUAGE.md §8.6, "The run with its
;;; facts"), len.shard's and app.shard's run lemmas run the evaluator over a whole call, and the
;;; twenty-seven laws nothing cited are gone.
(import Init Nat.sub_one_lt)
(import Init Option.some_ne_none)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.imp.IFam)
(use models.imp.imp.Fuel)
(use models.imp.imp.IpTask)
(use models.imp.imp.IpRes)
(use models.imp.imp.IpRet)

;; ---- the call refused at the depth bound -----------------------------------------------------------
(theorem call_depth ((f Fuel) (fs (List IpFn)) (mlo Nat) (msz Nat) (dmax Nat) (d Nat) (k Nat) (args (List Nat)) (mem Mem) (fn IpFn)
                     (ht (= (ipfn_at fs k) (Option.some fn)))
                     (hl (= (List.length args) (List.length (IpFn.ipparams fn))))
                     (hd (Not (< d dmax))))
  (= (ipeval (FS f) fs mlo msz dmax d (TCall k args mem)) (RCall (Option.some (IpRfailed FStack))))
  (by (unfold ipeval) (rw ht) (unfold ipeval.match_27) (rw (if_pos hl)) (rw (if_neg hd)) rfl))

;; ---- the Nat fuel's successor ----------------------------------------------------------------------
(theorem fuel_of_succ ((n Nat)) (= (fuel_of (+ n 1)) (FS (fuel_of n)))
  (by (rw fuel_of.eq_1) (reduce lhs) (rw (Nat.add_sub_cancel n 1)) rfl))

;; ---- the call's result as the statement spells it (landing 2) ----------------------------------
;; a call that returned or failed: the result record behind `ipcall`'s Option
(theorem ret_of_some ((R IpRes) (x IpRet) (h (= (ret_of R) (Option.some x)))) (= R (RCall (Option.some x)))
  (by (cases R
        ((RStmt (o) (have h2 (= Option.none (Option.some x)) (exact h)) (exact (False.elim (Option.some_ne_none x (Eq.symm h2)))))
         (RCall (o) (have h2 (= o (Option.some x)) (exact h)) (rw h2) rfl)))))
