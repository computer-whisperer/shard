;; the theorem's general form: for every fuel, word and depth, by induction on the first list; the
;; output ghost and word existential, the run lemmas instantiated at the fuel's 25 levels, the
;; runtime's laws at the levels their calls run
(theorem tb_app_aux ((av (List Int)) (fs (List IpFn)) (rb Nat) (mlo Nat) (msz Nat) (dmax Nat) (m Mem) (g GHeap) (r (List Nat)) (b Nat) (bv (List Int))
   (hrep (heap_rep m rb g))
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) Option.none))
   (hreadb (rb_list (GHeap.gcells g) b bv))
   (htable (= (ipfn_at (List.append (rt_fns rb) fs) 5) (Option.some (app_ipfn))))
   (hlo (<= mlo rb))
   (hend (<= (GHeap.gend g) msz)))
  (forall ((fuel Nat)) (forall ((a Nat)) (forall ((d Nat))
    (-> (rb_list (GHeap.gcells g) a av)
    (-> (<= 25 fuel)
    (-> (<= (+ 25 (* 12 (List.length av))) fuel)
        (exists ((g2 GHeap)) (exists ((w Nat)) (tbh (ipcall fuel (List.append (rt_fns rb) fs) mlo msz dmax d 5 (list a b) m) rb msz g2 w r (rb_list (GHeap.gcells g2) w (app av bv)))))))))))
  (by (induction av
        ((nil () (intro fuel a d hread hf0 hf)
