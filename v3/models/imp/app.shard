;;; v3/models/imp/app.shard — `app` proven against its lowered form: the source function `app`,
;;; its product `app_ipfn`, the lowered form written out as a value (eleven extra locals, the
;;; match skeleton, the recursive call at the table's index 5, the allocation at 1, the increment
;;; at 2, the two slot stores), and the theorem: for lists `av` and `bv` read back at the words
;;; `a` and `b` in a memory representing the ghost `g` under the invariant at the roots `r`,
;;; with the table's entry 5 the product and fuel at least 25 + 12·|av|, the call satisfies the
;;; post-predicate at some ghost and some word reading back as `app av bv` — the output ghost
;;; existential in the conclusion. `app` allocates: the proof rests on the runtime's laws as
;;; parameters (rtlaw.shard), the ghost kit (ghost.shard) and the run lemmas — one per outcome
;;; of a call, each over the whole call and each one run of the evaluator with its facts.
(import Init Int.add_comm)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "rt.shard")
(import "heap.shard")
(import "readback.shard")
(import "word.shard")
(import "cell.shard")
(import "step.shard")
(import "ghost.shard")
(import "rtlaw.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.imp.IKind)
(use models.imp.imp.IOp)
(use models.imp.imp.IExp)
(use models.imp.imp.IFam)
(use models.imp.imp.IpStmt)
(use models.imp.imp.IpFn)
(use models.imp.imp.IpTask)
(use models.imp.imp.IpRes)
(use models.imp.imp.IpRet)
(use models.imp.imp.Fuel)
(use models.imp.rt)
(use models.imp.heap)
(use models.imp.heap.HCell)
(use models.imp.heap.HRaw)
(use models.imp.readback)
(use models.imp.word)
(use models.imp.cell)
(use models.imp.step)
(use models.imp.ghost)
(use models.imp.rtlaw)
(trusts rt_alloc_run hr_fill hinv_fill hr_seal hinv_seal rt_inc_run)

;; the source: the append of two lists
(fn app ((a (List Int)) (b (List Int))) (List Int)
  (measure (struct a))
  (match a
    (List.nil b)
    ((List.cons h t) (List.cons h (app t b)))))
;; the product: the lowered form of `app`, written out
(fn app_ipfn () IpFn
  (MkIpFn (list U64 U64) (list U64 U64 U64 U64 U64 U64 U64 U64 U64 U64 U64)
    (list (IpSet 4 (IConst 1))
      (IpIf (IBin U64 IEq (ILoc 0) (IConst 1)) List.nil (list (IpSet 4 (IConst 0))))
      (IpIf (IBin U64 IEq (ILoc 4) (IConst 1))
        (list (IpCall 5 2 (list (ILoc 1))) (IpSet 3 (ILoc 1)))
        (list (IpSet 6 (IConst 1))
          (IpIf (IBin U64 IEq (IBin U64 IAnd (ILoc 0) (IConst 1)) (IConst 0))
            (list (IpLoadW 7 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 0))))
              (IpIf
                (IBin U64 IEq (IBin U64 IAnd (IBin U64 IShr (ILoc 7) (IConst 32)) (IConst 65535))
                  (IConst 1))
                (list (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 8))))
                  (IpIf (IBin U64 IEq (ILoc 6) (IConst 1))
                    (list (IpLoadW 9 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16))))
                      (IpIf (IBin U64 IEq (ILoc 6) (IConst 1)) List.nil List.nil))
                    List.nil))
                (list (IpSet 6 (IConst 0)))))
            (list (IpSet 6 (IConst 0))))
          (IpIf (IBin U64 IEq (ILoc 6) (IConst 1))
            (list (IpCall 10 5 (list (ILoc 9) (ILoc 1))) (IpCall 11 1 (list (IConst 1) (IConst 2)))
              (IpCall 12 2 (list (ILoc 8)))
              (IpStoreW (ITrunc U64 U32 (IBin U64 IAdd (ILoc 11) (IConst 8))) (ILoc 8))
              (IpStoreW (ITrunc U64 U32 (IBin U64 IAdd (ILoc 11) (IConst 16))) (ILoc 10))
              (IpSet 3 (ILoc 11)))
            (list IpUnreach)))))
    (ILoc 3)
    U64))

;; --- the run lemmas: one per outcome of a call to the product, each over the whole call at a fuel f
;; under its literal levels (8 on the nil paths, 25 on the cons paths) and each proof one run of the
;; evaluator with its facts — the table's entry, the depth, the banded arguments, the cell's words hw,
;; w0, w1 and the inner calls' results as hypotheses about those calls: the recursive call 14 levels
;; above f, the allocation 13, the increment 12 (the nil path's increment one)
(theorem app_call_nil
  ((f Fuel)
   (fs (List IpFn))
   (mlo Nat)
   (msz Nat)
   (dmax Nat)
   (d Nat)
   (b Nat)
   (m Mem)
   (w Nat)
   (m1 Mem)
   (ht (= (ipfn_at fs 5) (Option.some (app_ipfn))))
   (hd (< d dmax))
   (hbM (= (% b 18446744073709551616) b))
   (hinc
     (= (ipeval (FS f) fs mlo msz dmax (+ d 1) (TCall 2 (list b) m))
       (RCall (Option.some (IpRv w m1))))))
  (= (ipeval (FS (FS (FS (FS (FS (FS (FS (FS f)))))))) fs mlo msz dmax d (TCall 5 (list 1 b) m))
    (RCall (Option.some (IpRv b m1))))
  (by (reduce lhs (using ht app_ipfn.eq_1 (if_pos hd) hbM hinc)) rfl))
(theorem app_call_nil_fail
  ((f Fuel)
   (fs (List IpFn))
   (mlo Nat)
   (msz Nat)
   (dmax Nat)
   (d Nat)
   (b Nat)
   (m Mem)
   (fam IFam)
   (ht (= (ipfn_at fs 5) (Option.some (app_ipfn))))
   (hd (< d dmax))
   (hbM (= (% b 18446744073709551616) b))
   (hinc
     (= (ipeval (FS f) fs mlo msz dmax (+ d 1) (TCall 2 (list b) m))
       (RCall (Option.some (IpRfailed fam))))))
  (= (ipeval (FS (FS (FS (FS (FS (FS (FS (FS f)))))))) fs mlo msz dmax d (TCall 5 (list 1 b) m))
    (RCall (Option.some (IpRfailed fam))))
  (by (reduce lhs (using ht app_ipfn.eq_1 (if_pos hd) hbM hinc)) rfl))
(theorem app_call_fail_app
  ((f Fuel)
   (fs (List IpFn))
   (mlo Nat)
   (msz Nat)
   (dmax Nat)
   (d Nat)
   (a Nat)
   (b Nat)
   (m Mem)
   (hw Nat)
   (w0 Nat)
   (w1 Nat)
   (fam IFam)
   (ht (= (ipfn_at fs 5) (Option.some (app_ipfn))))
   (hd (< d dmax))
   (ha1 (Not (= a 1)))
   (heven (= (% a 2) 0))
   (hmlo (<= mlo a))
   (hmlo8 (<= mlo (+ a 8)))
   (hmlo16 (<= mlo (+ a 16)))
   (ha8 (<= (+ a 8) msz))
   (ha16 (<= (+ (+ a 8) 8) msz))
   (ha24 (<= (+ (+ a 16) 8) msz))
   (hM (= (% a 18446744073709551616) a))
   (hbM (= (% b 18446744073709551616) b))
   (hM8 (= (% (+ a 8) 18446744073709551616) (+ a 8)))
   (hM16 (= (% (+ a 16) 18446744073709551616) (+ a 16)))
   (h32 (= (Nat.land a 4294967295) a))
   (h32b (= (Nat.land (+ a 8) 4294967295) (+ a 8)))
   (h32c (= (Nat.land (+ a 16) 4294967295) (+ a 16)))
   (hhdr (= (load_le 8 m a) hw))
   (hwt (= (Nat.land (Nat.shiftRight hw 32) 65535) 1))
   (hs0 (= (load_le 8 m (+ a 8)) w0))
   (hs1 (= (load_le 8 m (+ a 16)) w1))
   (hr
     (=
       (ipeval (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS f)))))))))))))) fs mlo msz
         dmax
         (+ d 1)
         (TCall 5 (list w1 b) m))
       (RCall (Option.some (IpRfailed fam))))))
  (=
    (ipeval
      (FS
        (FS
          (FS
            (FS
              (FS
                (FS
                  (FS
                    (FS
                      (FS
                        (FS
                          (FS
                            (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS f)))))))))))))))))))))))))
      fs
      mlo
      msz
      dmax
      d
      (TCall 5 (list a b) m))
    (RCall (Option.some (IpRfailed fam))))
  (by
    (reduce lhs
      (using ht app_ipfn.eq_1 (if_pos hd) hM hbM (if_neg ha1) (Nat.and_one_is_mod a) heven
        (Nat.add_zero a)
        h32
        (if_pos hmlo)
        (if_pos ha8)
        hhdr
        hwt
        hM8
        h32b
        (if_pos hmlo8)
        (if_pos ha16)
        hs0
        hM16
        h32c
        (if_pos hmlo16)
        (if_pos ha24)
        hs1
        hr))
    rfl))
