   (w0 Nat)
   (w1 Nat)
   (w2 Nat)
   (m1 Mem)
   (fam IFam)
   (ht (= (ipfn_at fs 5) (Option.some (app_ipfn))))
   (hd (< d dmax))
   (ha1 (Not (= a 1)))
   (heven (= (% a 2) 0))
   (hmlo (<= mlo a))
   (hmlo8 (<= mlo (+ a 8)))
