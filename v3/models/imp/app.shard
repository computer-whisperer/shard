;; the theorem (B-1b's statement with the ghost existential; the old tb_micro.shard's tb_app): the general form at its binders
(theorem tb_app
  ((av (List Int)) (fuel Nat) (fs (List IpFn)) (rb Nat) (mlo Nat) (msz Nat) (dmax Nat) (d Nat)
   (m Mem) (g GHeap) (r (List Nat)) (a Nat) (b Nat) (bv (List Int))
   (hrep (heap_rep m rb g))
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) Option.none))
   (hread (rb_list (GHeap.gcells g) a av))
   (hreadb (rb_list (GHeap.gcells g) b bv))
   (htable (= (ipfn_at (List.append (rt_fns rb) fs) 5) (Option.some (app_ipfn))))
   (hlo (<= mlo rb))
   (hend (<= (GHeap.gend g) msz))
   (hfuel0 (<= 25 fuel))
   (hfuel (<= (+ 25 (* 12 (List.length av))) fuel)))
  (exists ((g2 GHeap)) (exists ((w Nat))
    (tbh (ipcall fuel (List.append (rt_fns rb) fs) mlo msz dmax d 5 (list a b) m) rb msz g2 w r (rb_list (GHeap.gcells g2) w (app av bv)))))
  (by (exact (tb_app_aux av fs rb mlo msz dmax m g r b bv hrep hinvr hraw hreadb htable hlo hend fuel a d hread hfuel0 hfuel))))
