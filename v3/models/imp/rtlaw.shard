;;; v3/models/imp/rtlaw.shard — the runtime's laws as parameters. A certificate of a function
;;; that allocates rests on what the counted-heap runtime does to a memory representing the
;;; ghost under the invariant: the allocation with its fill and seal, and the increment, stated
;;; here as the declared parameters of the model — axioms under `trusts`, recorded PARAM NAME
;;; axiom; the store's manifest lists them and the verifier reports them as what the store's
;;; theorems are conditional on. Nothing proves them. The release law (dec) is not here:
;;; `app` never releases. Words are `Nat`, the predicates `Prop`; a run law is stated with the
;;; memory it leaves existential and the representation and invariant laws over it folded in —
;;; the allocation's new ghost existential too (its cells, end and raw cell stated; the free
;;; lists' bookkeeping is not the certificate's business); a law over the model's own functions
;;; (the fill, the seal) is stated on them directly. A parameter holds for any fuel of at least
;;; 12, the runtime function's own cost: the certificate instantiates it at the level its call
;;; runs.
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "rt.shard")
(import "heap.shard")
(import "readback.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.imp.IFam)
(use models.imp.imp.IpRet)
(use models.imp.rt)
(use models.imp.heap)
(use models.imp.heap.HRaw)
(use models.imp.readback)
(trusts rt_alloc_run hr_fill hinv_fill hr_seal hinv_seal rt_inc_run)

;; --- the allocation ------------------------------------------------------------------------------
;; the call at the table's index 1 on a tag and an arity, over a memory representing a ghost with no
;; raw cell under the invariant: it fails for want of memory, or returns the address of a raw cell
;; of that tag and arity, empty, over a memory representing the ghost with that raw cell under the
;; invariant at the same roots, the live cells and the window's end as they were
(axiom rt_alloc_run
  ((fuel Nat)
   (fs (List IpFn))
   (rb Nat)
   (mlo Nat)
   (msz Nat)
   (dmax Nat)
   (d Nat)
   (m Mem)
   (g GHeap)
   (r (List Nat))
   (tag Nat)
   (n Nat)
   (hf (<= 12 fuel))
   (hrep (heap_rep m rb g))
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) Option.none))
   (htag (< tag 65536))
   (hn (< n 65536))
   (hlo (<= mlo rb))
   (hend (<= (GHeap.gend g) msz))
   (hd (< d dmax)))
  (exists ((res IpRet))
    (And
      (= (ipcall fuel (List.append (rt_fns rb) fs) mlo msz dmax d 1 (list tag n) m)
        (Option.some res))
      (Or (= res (IpRfailed FOom))
        (exists ((g2 GHeap))
          (exists ((p Nat))
            (exists ((m2 Mem))
              (And (= res (IpRv p m2))
                (And (heap_rep m2 rb g2)
                  (And (hinv rb g2 r)
                    (And (= (GHeap.gcells g2) (GHeap.gcells g))
                      (And (= (GHeap.gend g2) (GHeap.gend g))
                        (= (GHeap.graw g2) (Option.some (MkHRaw p tag n List.nil)))))))))))))))
;; a store of a word into the raw cell's next slot: the memory represents the ghost with the slot
;; filled
(axiom hr_fill
  ((m Mem)
   (rb Nat)
   (g GHeap)
   (r (List Nat))
   (p Nat)
   (tag Nat)
   (n Nat)
   (fill (List Nat))
   (i Nat)
   (w Nat)
   (hrep (heap_rep m rb g))
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill))))
   (hi (= (List.length fill) i))
   (hin (< i n))
   (hw (< w 18446744073709551616)))
  (heap_rep (store_le 8 m (+ p (+ 8 (* 8 i))) w) rb (gh_fill g w)))
;; the fill keeps the invariant: an immediate leaves the roots alone, a stored reference moves from
;; the roots into the slot
(axiom hinv_fill
  ((rb Nat)
   (g GHeap)
   (r (List Nat))
   (p Nat)
   (tag Nat)
   (n Nat)
   (fill (List Nat))
   (w Nat)
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill))))
   (hin (< (List.length fill) n))
   (hso (slot_ok w (haddrs (GHeap.gcells g))))
   (hroot (Or (= (% w 2) 1) (List.Mem w r))))
  (hinv rb (gh_fill g w) (rdec r w)))
;; the seal: the memory already represents the sealed ghost (the raw cell's header word is the
;; live cell's at count 1)
(axiom hr_seal
  ((m Mem)
   (rb Nat)
   (g GHeap)
   (p Nat)
   (tag Nat)
   (n Nat)
   (fill (List Nat))
   (hrep (heap_rep m rb g))
   (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill)))))
  (heap_rep m rb (gh_seal g)))
;; the seal of a full raw cell keeps the invariant with the new cell a root
(axiom hinv_seal
  ((rb Nat)
   (g GHeap)
   (r (List Nat))
   (p Nat)
   (tag Nat)
   (n Nat)
   (fill (List Nat))
   (hinvr (hinv rb g r))
   (hraw (= (GHeap.graw g) (Option.some (MkHRaw p tag n fill))))
   (hn (= (List.length fill) n)))
  (hinv rb (gh_seal g) (List.cons p r)))

;; --- the increment -------------------------------------------------------------------------------
;; the call at the table's index 2 on an immediate or a live address: it returns 0 over a memory
;; representing the ghost with that count raised, under the invariant with the word a root
(axiom rt_inc_run
  ((fuel Nat)
   (fs (List IpFn))
   (rb Nat)
   (mlo Nat)
   (msz Nat)
   (dmax Nat)
   (d Nat)
   (m Mem)
   (g GHeap)
   (r (List Nat))
   (v Nat)
   (hf (<= 12 fuel))
   (hrep (heap_rep m rb g))
   (hinvr (hinv rb g r))
   (hso (slot_ok v (haddrs (GHeap.gcells g))))
   (hv (< v 18446744073709551616))
   (hlo (<= mlo rb))
   (hend (<= (GHeap.gend g) msz))
   (hd (< d dmax)))
  (exists ((m2 Mem))
    (And
      (= (ipcall fuel (List.append (rt_fns rb) fs) mlo msz dmax d 2 (list v) m)
        (Option.some (IpRv 0 m2)))
      (And (heap_rep m2 rb (gh_inc g v)) (hinv rb (gh_inc g v) (rinc r v))))))
