;;; v3/models/imp/cell.shard — the laws of a live cell (slice 4.2 landing 1): what the ghost heap's
;;; invariant and its representation in memory say about one cell at a word `a` that is an
;;; address of the heap — written by need for `tb_len` (the old tree's rth_kit/tbh_kit laws
;;; `ldok_cell`, `hcells_rd_hdr`, `hr_rd_slot`, `hword_tag`, `rbc_*`, re-proven here as V3 theorems
;;; over the definitions of heap.shard). Membership is Init's `List.Mem`, unpacked by
;;; `List.mem_cons`; the invariant's conjunctions by definitional unfolding.
(import Init List.mem_nil_iff)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "heap.shard")
(import "readback.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.heap)
(use models.imp.heap.Ext)
(use models.imp.readback)

;; ---- the cell at an address: hfget is the first cell whose address is a ------------------------
;; the cell found at the head's address is the head
(theorem hfget_head ((c HCell) (rest (List HCell)))
  (= (hfget (List.cons c rest) (HCell.haddr c)) c)
  (by (unfold hfget) (unfold hfind) (rw (if_pos (Eq.refl (HCell.haddr c)))) rfl))
;; past a head of another address, the cell found is the tail's
(theorem hfget_tail ((c HCell) (rest (List HCell)) (a Nat) (hne (Not (= (HCell.haddr c) a))))
  (= (hfget (List.cons c rest) a) (hfget rest a))
  (by (unfold hfget) (unfold hfind) (rw (if_neg hne)) rfl))

;; ---- membership in the addresses --------------------------------------------------------------
;; a member of the addresses is the head's address or a member of the tail's
(theorem haddrs_mem ((c HCell) (rest (List HCell)) (a Nat) (hm (List.Mem a (haddrs (List.cons c rest)))))
  (Or (= a (HCell.haddr c)) (List.Mem a (haddrs rest)))
  (by (have hm2 (List.Mem a (List.cons (HCell.haddr c) (haddrs rest))) (exact hm)) (exact (Iff.mp List.mem_cons hm2))))

;; ---- the header read: the representation gives the cell's header word at its address -----------
(theorem rd_hdr ((m Mem) (cs (List HCell)) (a Nat))
  (-> (hcells_rep m cs) (-> (List.Mem a (haddrs cs)) (= (load_le 8 m a) (hword (hfget cs a)))))
  (by (induction cs
        ((nil () (intro hrep hm) (have hm2 (List.Mem a List.nil) (exact hm)) (exact (False.elim (Iff.mp (List.mem_nil_iff a) hm2))))
         (cons (c rest ih) (intro hrep hm)
           (have hc (hcell_rep m c) (exact (And.left hrep)))
           (have hr (hcells_rep m rest) (exact (And.right hrep)))
           (cases (haddrs_mem c rest a hm)
             ((inl (he) (rw he) (rw (hfget_head c rest)) (exact (And.left hc)))
              (inr (hm2)
                (cases (Nat.decEq (HCell.haddr c) a)
                  ((isFalse (hne) (rw (hfget_tail c rest a hne)) (exact (ih hr hm2)))
                   (isTrue (heq) (rw (Eq.symm heq)) (rw (hfget_head c rest)) (exact (And.left hc)))))))))))))

;; ---- the slot reads: the slots' representation gives each slot word at its offset ---------------
(theorem rd_slots ((m Mem) (ws (List Nat)))
  (forall ((b Nat)) (forall ((i Nat)) (-> (hslots_rep m b ws) (-> (< i (List.length ws)) (= (load_le 8 m (+ b (* 8 i))) (List.getD ws i 0))))))
  (by (induction ws
        ((nil () (intro b i hr hi) (have hi2 (< i 0) (exact hi)) (exact (False.elim (Nat.not_lt_zero i hi2))))
         (cons (w rest ih) (intro b i hr hi)
           (have hw (= (load_le 8 m b) w) (exact (And.left hr)))
           (have hrest (hslots_rep m (+ b 8) rest) (exact (And.right hr)))
           (cases i
             ((zero () (reduce rhs) (reduce lhs) (exact hw))
              (succ (j)
                (have hs (= (Nat.succ j) (+ j 1)) (exact (Eq.refl (+ j 1))))
                (rw hs)
                (have hj (< j (List.length rest)) (have hi2 (< (+ j 1) (+ (List.length rest) 1)) (exact hi)) (arith))
                (have hx (= (+ b (* 8 (+ j 1))) (+ (+ b 8) (* 8 j))) (arith))
                (rw hx) (reduce rhs) (exact (ih (+ b 8) j hrest hj))))))))))
;; a cell's slot i, read from memory at the cell's address plus 8 plus 8·i
(theorem rd_slot ((m Mem) (cs (List HCell)) (a Nat) (i Nat))
  (-> (hcells_rep m cs) (-> (List.Mem a (haddrs cs)) (-> (< i (List.length (HCell.hslots (hfget cs a))))
      (= (load_le 8 m (+ (+ a 8) (* 8 i))) (List.getD (HCell.hslots (hfget cs a)) i 0)))))
  (by (induction cs
        ((nil () (intro hrep hm) (have hm2 (List.Mem a List.nil) (exact hm)) (exact (False.elim (Iff.mp (List.mem_nil_iff a) hm2))))
         (cons (c rest ih) (intro hrep hm)
           (have hc (hcell_rep m c) (exact (And.left hrep)))
           (have hr (hcells_rep m rest) (exact (And.right hrep)))
           (cases (Nat.decEq (HCell.haddr c) a)
             ((isFalse (hne)
                (have hm3 (List.Mem a (haddrs rest))
                  (cases (haddrs_mem c rest a hm) ((inl (he) (exact (False.elim (hne (Eq.symm he))))) (inr (hm2) (exact hm2)))))
                (rw (hfget_tail c rest a hne)) (exact (ih hr hm3)))
              (isTrue (heq)
                (rw (Eq.symm heq)) (rw (hfget_head c rest)) (intro hi)
                (exact (rd_slots m (HCell.hslots c) (+ (HCell.haddr c) 8) i (And.right hc) hi))))))))))

;; ---- the cell's bands and slot count, from the invariant's cells_ok --------------------------------
(theorem cells_ok_at ((cs (List HCell)) (a Nat))
  (-> (cells_ok cs) (-> (List.Mem a (haddrs cs))
      (And (= (List.length (HCell.hslots (hfget cs a))) (HCell.harity (hfget cs a)))
      (And (<= 1 (HCell.hcount (hfget cs a)))
      (And (< (HCell.hcount (hfget cs a)) 4294967296)
      (And (< (HCell.htag (hfget cs a)) 65536) (< (HCell.harity (hfget cs a)) 65536)))))))
  (by (induction cs
        ((nil () (intro hok hm) (have hm2 (List.Mem a List.nil) (exact hm)) (exact (False.elim (Iff.mp (List.mem_nil_iff a) hm2))))
         (cons (c rest ih) (intro hok hm)
           (have hok2 (And (slots_ok (HCell.hslots c) (haddrs rest))
                      (And (= (List.length (HCell.hslots c)) (HCell.harity c))
                      (And (<= 1 (HCell.hcount c))
                      (And (< (HCell.hcount c) 4294967296)
                      (And (< (HCell.htag c) 65536)
                      (And (< (HCell.harity c) 65536) (cells_ok rest)))))))
             (exact hok))
           (cases (Nat.decEq (HCell.haddr c) a)
             ((isFalse (hne)
                (have hm3 (List.Mem a (haddrs rest))
                  (cases (haddrs_mem c rest a hm) ((inl (he) (exact (False.elim (hne (Eq.symm he))))) (inr (hm2) (exact hm2)))))
                (rw (hfget_tail c rest a hne))
                (exact (ih (And.right (And.right (And.right (And.right (And.right (And.right hok2)))))) hm3)))
              (isTrue (heq)
                (rw (Eq.symm heq)) (rw (hfget_head c rest))
                (exact (And.intro (And.left (And.right hok2))
                       (And.intro (And.left (And.right (And.right hok2)))
                       (And.intro (And.left (And.right (And.right (And.right hok2))))
                       (And.intro (And.left (And.right (And.right (And.right (And.right hok2)))))
                                  (And.left (And.right (And.right (And.right (And.right (And.right hok2)))))))))))))))))))

;; ---- the cell's extent inside the window, from the invariant's e_brk ------------------------------
(theorem e_brk_app_l ((xs (List Ext)) (ys (List Ext)) (lo Nat) (top Nat))
  (-> (e_brk (List.append xs ys) lo top) (e_brk xs lo top))
  (by (induction xs
        ((nil () (intro hb) (exact True.intro))
         (cons (e rest ih) (intro hb)
           (cases e ((Ext (x n)
             (have hb2 (And (<= lo x) (And (<= (+ x (+ 8 (* 8 n))) top) (And (= (% x 8) 0) (e_brk (List.append rest ys) lo top)))) (exact hb))
             (exact (And.intro (And.left hb2) (And.intro (And.left (And.right hb2)) (And.intro (And.left (And.right (And.right hb2))) (ih (And.right (And.right (And.right hb2))))))))))))))))
(theorem e_brk_hexts ((cs (List HCell)) (a Nat) (lo Nat) (top Nat))
  (-> (e_brk (hexts cs) lo top) (-> (List.Mem a (haddrs cs))
      (And (<= lo a) (And (<= (+ a (+ 8 (* 8 (HCell.harity (hfget cs a))))) top) (= (% a 8) 0)))))
  (by (induction cs
        ((nil () (intro hb hm) (have hm2 (List.Mem a List.nil) (exact hm)) (exact (False.elim (Iff.mp (List.mem_nil_iff a) hm2))))
         (cons (c rest ih) (intro hb hm)
           (have hb2 (And (<= lo (HCell.haddr c)) (And (<= (+ (HCell.haddr c) (+ 8 (* 8 (HCell.harity c)))) top) (And (= (% (HCell.haddr c) 8) 0) (e_brk (hexts rest) lo top)))) (exact hb))
           (cases (Nat.decEq (HCell.haddr c) a)
             ((isFalse (hne)
                (have hm3 (List.Mem a (haddrs rest))
                  (cases (haddrs_mem c rest a hm) ((inl (he) (exact (False.elim (hne (Eq.symm he))))) (inr (hm2) (exact hm2)))))
                (rw (hfget_tail c rest a hne)) (exact (ih (And.right (And.right (And.right hb2))) hm3)))
              (isTrue (heq)
                (rw (Eq.symm heq)) (rw (hfget_head c rest))
                (exact (And.intro (And.left hb2) (And.intro (And.left (And.right hb2)) (And.left (And.right (And.right hb2))))))))))))))
;; the bounds of a live cell of arity 2 under the invariant: the loads of its header and two slots
;; are inside the window and the address space
(theorem cell_window ((rb Nat) (g GHeap) (r (List Nat)) (a Nat))
  (-> (hinv rb g r) (-> (List.Mem a (haddrs (GHeap.gcells g))) (-> (= (HCell.harity (hfget (GHeap.gcells g) a)) 2)
      (And (<= (+ rb 152) a) (And (<= (+ a 24) (GHeap.gend g)) (<= (GHeap.gend g) 4294967296))))))
  (by (intro hi hm h2)
      (have hi2 (And (<= (+ rb 152) (GHeap.glo g)) (And (<= (GHeap.glo g) (GHeap.gtop g)) (And (<= (GHeap.gtop g) (GHeap.gend g)) (And (<= (GHeap.gend g) 4294967296)
                 (And (= (% (GHeap.glo g) 8) 0) (And (= (% (GHeap.gtop g) 8) 0) (And (e_disj (ext_all g)) (And (e_brk (ext_all g) (GHeap.glo g) (GHeap.gtop g))
                 (And (cells_ok (GHeap.gcells g)) (And (counts_ok (GHeap.gcells g) (GHeap.gcells g) r (GHeap.graw g)) (And (roots_ok r (haddrs (GHeap.gcells g))) (raw_ok (GHeap.graw g) (GHeap.gcells g)))))))))))))
        (exact hi))
      (have hbrk (e_brk (ext_all g) (GHeap.glo g) (GHeap.gtop g)) (exact (And.left (And.right (And.right (And.right (And.right (And.right (And.right (And.right hi2))))))))))
      (have hbrk3 (e_brk (List.append (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g)))) (GHeap.glo g) (GHeap.gtop g)) (exact hbrk))
      (have hbrk2 (e_brk (hexts (GHeap.gcells g)) (GHeap.glo g) (GHeap.gtop g)) (exact (e_brk_app_l (hexts (GHeap.gcells g)) (List.append (fexts (GHeap.gfree g) 0) (rexts (GHeap.graw g))) (GHeap.glo g) (GHeap.gtop g) hbrk3)))
      (have hx (And (<= (GHeap.glo g) a) (And (<= (+ a (+ 8 (* 8 (HCell.harity (hfget (GHeap.gcells g) a))))) (GHeap.gtop g)) (= (% a 8) 0))) (exact (e_brk_hexts (GHeap.gcells g) a (GHeap.glo g) (GHeap.gtop g) hbrk2 hm)))
      (have hx2 (<= (+ a (+ 8 (* 8 2))) (GHeap.gtop g)) (rw (Eq.symm h2)) (exact (And.left (And.right hx))))
      (have b1 (<= (+ rb 152) (GHeap.glo g)) (exact (And.left hi2)))
      (have b2 (<= (GHeap.glo g) (GHeap.gtop g)) (exact (And.left (And.right hi2))))
      (have b3 (<= (GHeap.gtop g) (GHeap.gend g)) (exact (And.left (And.right (And.right hi2)))))
      (have b4 (<= (GHeap.gend g) 4294967296) (exact (And.left (And.right (And.right (And.right hi2))))))
      (have b5 (<= (GHeap.glo g) a) (exact (And.left hx)))
      (apply And.intro (arith) ((apply And.intro (arith) (exact b4))))))

;; ---- the header word's tag band, and the 32-bit mask ---------------------------------------------
(theorem band32 ((a Nat) (h (< a 4294967296))) (= (Nat.land a 4294967295) a)
  (by (have e (= 4294967295 (- (Nat.pow 2 32) 1)) (exact (Eq.refl 4294967295)))
      (rw e) (rw (Nat.and_two_pow_sub_one_eq_mod a 32)) (exact (Nat.mod_eq_of_lt h))))
(theorem hword_tag ((c HCell) (hc (< (HCell.hcount c) 4294967296)) (ht (< (HCell.htag c) 65536)) (ha (< (HCell.harity c) 65536)))
  (= (Nat.land (Nat.shiftRight (hword c) 32) 65535) (HCell.htag c))
  (by (unfold hword)
      (have e (= (+ (HCell.hcount c) (+ (* (HCell.htag c) 4294967296) (* (HCell.harity c) 281474976710656))) (+ (HCell.hcount c) (* 4294967296 (+ (HCell.htag c) (* (HCell.harity c) 65536))))) (arith))
      (rw e)
      (rw (Nat.shiftRight_eq_div_pow (+ (HCell.hcount c) (* 4294967296 (+ (HCell.htag c) (* (HCell.harity c) 65536)))) 32))
      (have e32 (= (Nat.pow 2 32) 4294967296) (exact (Eq.refl 4294967296)))
      (rw e32)
      (have h0 (< 0 4294967296) (arith))
      (rw (Nat.add_mul_div_left (HCell.hcount c) (+ (HCell.htag c) (* (HCell.harity c) 65536)) h0))
      (rw (Nat.div_eq_of_lt hc))
      (have e16 (= 65535 (- (Nat.pow 2 16) 1)) (exact (Eq.refl 65535)))
      (rw e16) (rw (Nat.and_two_pow_sub_one_eq_mod (+ 0 (+ (HCell.htag c) (* (HCell.harity c) 65536))) 16))
      (have e16b (= (Nat.pow 2 16) 65536) (exact (Eq.refl 65536)))
      (rw e16b)
      (have e2 (= (+ 0 (+ (HCell.htag c) (* (HCell.harity c) 65536))) (+ (HCell.htag c) (* (HCell.harity c) 65536))) (arith))
      (rw e2)
      (rw (Nat.add_mul_mod_self_right (HCell.htag c) (HCell.harity c) 65536))
      (exact (Nat.mod_eq_of_lt ht))))
