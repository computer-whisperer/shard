;; the source: the length of a list, as the old compiler's fixture states it
(fn len ((xs (List Int))) Int
  (measure (struct xs))
  (match xs
    (List.nil 0)
    ((List.cons _ t) (+ 1 (len t)))))

;; the source's length is the cast of Init's
(theorem len_ofNat ((xs (List Int))) (= (len xs) (Int.ofNat (List.length xs)))
  (by (induction xs
        ((nil () (unfold len) (reduce rhs) rfl)
         (cons (x t ih) (unfold len) (rw ih) (rw (Int.add_comm 1 (Int.ofNat (List.length t)))) (reduce rhs) rfl)))))
