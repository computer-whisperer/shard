      (have hst8 (= (ilset (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) 8 (load_le 8 m (+ a 16))) (Option.some (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0))) (rw hs1) (reduce lhs) rfl)
      (have hLD8 (= (ipeval (fuel_of (+ (+ (+ n 1) 1) 1)) fs mlo msz dmax d (TStmt (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16)))) (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (exact (stmt_loadw_n (+ (+ n 1) 1) fs mlo msz dmax d 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16))) (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m (+ a 16) (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) heA16 hmlo16 ha24 hst8)))
      (have he5c (= (iexp (IBin U64 IEq (ILoc 5) (IConst 1)) (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m mlo msz) (Option.some 1)) (reduce lhs) rfl)
      (have hn1 (= (ipeval (fuel_of (+ n 1)) fs mlo msz dmax d (TStmts List.nil (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (exact (stmts_nil_n n fs mlo msz dmax d (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))
      (have hIF5b (= (ipeval (fuel_of (+ (+ n 1) 1)) fs mlo msz dmax d (TStmt (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil) (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (rw (stmt_if_nz_n (+ n 1) fs mlo msz dmax d (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m 1 he5c Nat.one_ne_zero)) (exact hn1))
      (have hn2 (= (ipeval (fuel_of (+ (+ n 1) 1)) fs mlo msz dmax d (TStmts List.nil (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (exact (stmts_nil_n (+ n 1) fs mlo msz dmax d (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))
      (have hl3 (= (ipeval (fuel_of (+ (+ (+ n 1) 1) 1)) fs mlo msz dmax d (TStmts (list (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil)) (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (exact (stmts_cons_n (+ (+ n 1) 1) fs mlo msz dmax d (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil) List.nil (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m))) hIF5b hn2)))
      (have hl4 (= (ipeval (fuel_of (+ (+ (+ (+ n 1) 1) 1) 1)) fs mlo msz dmax d (TStmts (list (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16)))) (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil)) (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (exact (stmts_cons_n (+ (+ (+ n 1) 1) 1) fs mlo msz dmax d (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16)))) (list (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil)) (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m))) hLD8 hl3)))
      (have hIF5a (= (ipeval (fuel_of (+ (+ (+ (+ (+ n 1) 1) 1) 1) 1)) fs mlo msz dmax d (TStmt (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) (list (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16)))) (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil)) List.nil) (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m)) (RStmt (Option.some (IpNorm (list a 0 0 0 0 1 hw w0 w1 0 0 0 0 0) m)))) (rw (stmt_if_nz_n (+ (+ (+ (+ n 1) 1) 1) 1) fs mlo msz dmax d (IBin U64 IEq (ILoc 5) (IConst 1)) (list (IpLoadW 8 (ITrunc U64 U32 (IBin U64 IAdd (ILoc 0) (IConst 16)))) (IpIf (IBin U64 IEq (ILoc 5) (IConst 1)) List.nil List.nil)) List.nil (list a 0 0 0 0 1 hw w0 0 0 0 0 0 0) m 1 he5b Nat.one_ne_zero)) (exact hl4))
