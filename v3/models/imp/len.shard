               (have hrinc (= (rinc r (+ (* 2 0) 1)) r) (unfold rinc) (rw (if_pos hodd)) rfl)
               (unfold ipcall) (rw hF) (rw (len_call_one (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (FS (fuel_of (- fuel 24)))))))))))))))))) (List.append (rt_fns rb) fs) mlo msz dmax d m htable hd)) (rw hlen0) (rw (imm_small 0 h0))
               (show (And (= 1 (+ (* 2 0) 1)) (And (heap_rep m rb g) (And (hinv rb g (rinc r (+ (* 2 0) 1))) (And (= (GHeap.graw g) Option.none) (And (<= (GHeap.gend g) msz) (rb_int (+ (* 2 0) 1) (Int.ofNat 0))))))))
