;;; v3/models/imp/word.shard — the word kit's laws (slice 4.2 landing 1): the source's `len` as a
;;; cast of Init's length, the immediate of a cast as Nat arithmetic (definitional: Int's
;;; operations on `Int.ofNat` compute), the band `in63` at a cast — written by need for `tb_len`
;;; (the old tb_kit's imm_*/in63_* laws). The source's length as a cast is len.shard's, beside `len`.
(import Init Int.add_comm)
(import Init Nat.ne_of_gt)
(import Init Int.emod_def)
(import Init Int.add_mul_emod_self_left)
(import Init Int.emod_nonneg)
(import Init Int.emod_lt_of_pos)
(import Init Int.toNat_of_nonneg)
(import Init Int.natCast_emod)
(import Init Int.ofNat_inj)
(import Init Int.ofNat_lt)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "heap.shard")
(import "readback.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.heap)
(use models.imp.readback)

;; the immediate of a cast: Int's arithmetic on casts computes
(theorem imm_ofNat ((n Nat)) (= (imm (Int.ofNat n)) (% (+ (* 2 n) 1) 18446744073709551616))
  (by (unfold imm) rfl))
;; below the band, the immediate is 2n + 1
(theorem imm_small ((n Nat) (h (< n 4611686018427387904))) (= (imm (Int.ofNat n)) (+ (* 2 n) 1))
  (by (rw (imm_ofNat n)) (have h2 (< (+ (* 2 n) 1) 18446744073709551616) (arith)) (exact (Nat.mod_eq_of_lt h2))))
;; the band at a cast, both ways
(theorem in63_ofNat ((n Nat) (h (< n 4611686018427387904))) (in63 (Int.ofNat n))
  (by (unfold in63) (apply And.intro (arith) (arith))))
(theorem in63_ofNat_lt ((n Nat) (h (in63 (Int.ofNat n)))) (< n 4611686018427387904)
  (by (have h2 (And (<= -4611686018427387904 (Int.ofNat n)) (< (Int.ofNat n) 4611686018427387904)) (exact h)) (arith (And.right h2))))

;; --- any banded value (landing 2): the immediate is odd and below 2^64 ----------------------------
;; the immediate as an Int: the two's-complement word, nonnegative and below 2^64
(theorem imm_word ((v Int)) (And (<= 0 (% (+ (* 2 v) 1) 18446744073709551616)) (< (% (+ (* 2 v) 1) 18446744073709551616) 18446744073709551616))
  (by (have hne (Not (= (Int.ofNat 18446744073709551616) 0)) (intro h0) (have h1 (= 18446744073709551616 0) (exact (Iff.mp Int.ofNat_inj h0))) (exact (Nat.ne_of_gt (Nat.zero_lt_succ 18446744073709551615) h1)))
      (have hpos (< (Int.ofNat 0) (Int.ofNat 18446744073709551616)) (exact (Iff.mpr Int.ofNat_lt (Nat.zero_lt_succ 18446744073709551615))))
      (exact (And.intro (Int.emod_nonneg (+ (* 2 v) 1) hne) (Int.emod_lt_of_pos (+ (* 2 v) 1) hpos)))))
;; the word's parity: 2v + 1 less a multiple of 2^64 is 1 plus a multiple of 2
(theorem imm_odd ((v Int)) (= (% (imm v) 2) 1)
  (by (unfold imm)
      (have hw (And (<= 0 (% (+ (* 2 v) 1) 18446744073709551616)) (< (% (+ (* 2 v) 1) 18446744073709551616) 18446744073709551616)) (exact (imm_word v)))
      (have hcast (= (Int.ofNat (Int.toNat (% (+ (* 2 v) 1) 18446744073709551616))) (% (+ (* 2 v) 1) 18446744073709551616)) (exact (Int.toNat_of_nonneg (And.left hw))))
      (have hdef (= (% (+ (* 2 v) 1) 18446744073709551616) (- (+ (* 2 v) 1) (* 18446744073709551616 (/ (+ (* 2 v) 1) 18446744073709551616)))) (exact (Int.emod_def (+ (* 2 v) 1) 18446744073709551616)))
      (have e (= (- (+ (* 2 v) 1) (* 18446744073709551616 (/ (+ (* 2 v) 1) 18446744073709551616))) (+ 1 (* 2 (- v (* 9223372036854775808 (/ (+ (* 2 v) 1) 18446744073709551616)))))) (arith))
      (have hmod (= (% (% (+ (* 2 v) 1) 18446744073709551616) 2) 1) (rw hdef) (rw e) (rw (Int.add_mul_emod_self_left 1 2 (- v (* 9223372036854775808 (/ (+ (* 2 v) 1) 18446744073709551616))))) rfl)
      (have hcast2 (= (Int.ofNat (% (Int.toNat (% (+ (* 2 v) 1) 18446744073709551616)) 2)) (Int.ofNat 1))
        (exact (Eq.trans (Int.natCast_emod (Int.toNat (% (+ (* 2 v) 1) 18446744073709551616)) 2) (Eq.trans (congrArg (fun ((y Int)) (% y 2)) hcast) hmod))))
      (exact (Iff.mp Int.ofNat_inj hcast2))))
;; the word's bound
(theorem imm_lt ((v Int)) (< (imm v) 18446744073709551616)
  (by (unfold imm)
      (have hw (And (<= 0 (% (+ (* 2 v) 1) 18446744073709551616)) (< (% (+ (* 2 v) 1) 18446744073709551616) 18446744073709551616)) (exact (imm_word v)))
      (have hcast (= (Int.ofNat (Int.toNat (% (+ (* 2 v) 1) 18446744073709551616))) (% (+ (* 2 v) 1) 18446744073709551616)) (exact (Int.toNat_of_nonneg (And.left hw))))
      (have h1 (< (Int.ofNat (Int.toNat (% (+ (* 2 v) 1) 18446744073709551616))) (Int.ofNat 18446744073709551616)) (rw hcast) (exact (And.right hw)))
      (exact (Iff.mp Int.ofNat_lt h1))))
