;;; v3/models/imp/word.shard — the word kit's laws (slice 4.2 landing 1): the source's `len` as a
;;; cast of Init's length, the immediate of a cast as Nat arithmetic (definitional: Int's
;;; operations on `Int.ofNat` compute), the band `in63` at a cast — written by need for `tb_len`
;;; (the old tb_kit's imm_*/in63_* laws). The source's length as a cast is len.shard's, beside `len`.
(import Init Int.add_comm)
(import "../../std/list.shard")
(import "../../std/mem.shard")
(import "imp.shard")
(import "heap.shard")
(import "readback.shard")
(use std.list)
(use std.mem)
(use models.imp.imp)
(use models.imp.heap)
(use models.imp.readback)

;; the immediate of a cast: Int's arithmetic on casts computes
(theorem imm_ofNat ((n Nat)) (= (imm (Int.ofNat n)) (% (+ (* 2 n) 1) 18446744073709551616))
  (by (unfold imm) rfl))
;; below the band, the immediate is 2n + 1
(theorem imm_small ((n Nat) (h (< n 4611686018427387904))) (= (imm (Int.ofNat n)) (+ (* 2 n) 1))
  (by (rw (imm_ofNat n)) (have h2 (< (+ (* 2 n) 1) 18446744073709551616) (arith)) (exact (Nat.mod_eq_of_lt h2))))
;; the band at a cast, both ways
(theorem in63_ofNat ((n Nat) (h (< n 4611686018427387904))) (in63 (Int.ofNat n))
  (by (unfold in63) (apply And.intro (arith) (arith))))
(theorem in63_ofNat_lt ((n Nat) (h (in63 (Int.ofNat n)))) (< n 4611686018427387904)
  (by (have h2 (And (<= -4611686018427387904 (Int.ofNat n)) (< (Int.ofNat n) 4611686018427387904)) (exact h)) (arith (And.right h2))))
