; a product, of a register and memory and of two registers, one of them high and the memory
; operand indexed; read back from each of its eight bytes: KK runs F8..FF, the status the byte
; of the low word of 0123456789ABCDEF * FEDCBA9876543211 * 1000000F3, which is
; FD97CCBD69AD41AD, at KK - F8.
; statuses: 173 65 173 105 189 204 151 253
48 B8 EF CD AB 89 67 45 23 01   ; mov rax, 0x0123456789ABCDEF
48 B9 11 32 54 76 98 BA DC FE   ; mov rcx, 0xFEDCBA9876543211
48 89 4C 24 F0                  ; mov [rsp-16], rcx
48 0F AF 44 24 F0               ; imul rax, [rsp-16]
49 B8 F3 00 00 00 01 00 00 00   ; mov r8, 0x1000000F3
48 89 44 24 E8                  ; mov [rsp-24], rax
B9 01 00 00 00                  ; mov ecx, 1
4C 0F AF 44 CC E0               ; imul r8, [rsp+rcx*8-32]
4C 89 44 24 F8                  ; mov [rsp-8], r8
48 8B 7C 24 KK                  ; mov rdi, [rsp-8+k]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
