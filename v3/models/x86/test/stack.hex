; a call and its return, pushes and pops of a low and a high register, a jump; after the return
; the stack pointer is where it was before the call.
; statuses: 7
48 89 E3                        ; mov rbx, rsp
BF 01 00 00 00                  ; mov edi, 1
E8 14 00 00 00                  ; call F
48 39 E3                        ; cmp rbx, rsp
0F 85 04 00 00 00               ; jne +4         not taken: the stack pointer is back
48 83 C7 04                     ; add rdi, 4
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
57                              ; F: push rdi
41 50                           ; push r8
BF 64 00 00 00                  ; mov edi, 100
41 58                           ; pop r8
5F                              ; pop rdi
48 83 C7 02                     ; add rdi, 2
E9 00 00 00 00                  ; jmp +0
C3                              ; ret
