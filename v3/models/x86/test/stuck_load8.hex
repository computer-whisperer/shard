; a byte read where nothing is mapped: the model has no rule, the processor's run is killed
; model: stuck: not mapped to read at 0
; processor: killed
B8 00 00 00 00                  ; mov eax, 0
48 0F B6 00                     ; movzx rax, byte [rax]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
