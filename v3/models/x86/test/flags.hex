; eight comparisons, each followed by a conditional jump over an add of one bit to rdi: the
; status holds a bit for every jump not taken.
; statuses: 250
48 B8 05 00 00 00 00 00 00 00   ; mov rax, 5
48 B9 07 00 00 00 00 00 00 00   ; mov rcx, 7
48 39 C8                        ; cmp rax, rcx
0F 82 04 00 00 00               ; jb +4          taken: 5 is below 7
48 83 C7 01                     ; add rdi, 1
48 B8 05 00 00 00 00 00 00 00   ; mov rax, 5
48 B9 07 00 00 00 00 00 00 00   ; mov rcx, 7
48 39 C8                        ; cmp rax, rcx
0F 87 04 00 00 00               ; ja +4          not taken
48 83 C7 02                     ; add rdi, 2
48 B8 00 00 00 00 00 00 00 80   ; mov rax, 8000000000000000
48 B9 01 00 00 00 00 00 00 00   ; mov rcx, 1
48 39 C8                        ; cmp rax, rcx   overflow: the most negative number less one
0F 8C 04 00 00 00               ; jl +4          taken: the signs say less
48 83 C7 04                     ; add rdi, 4
48 B8 00 00 00 00 00 00 00 80   ; mov rax, 8000000000000000
48 B9 01 00 00 00 00 00 00 00   ; mov rcx, 1
48 39 C8                        ; cmp rax, rcx
0F 81 04 00 00 00               ; jno +4         not taken
48 83 C7 08                     ; add rdi, 8
48 B8 09 00 00 00 00 00 00 00   ; mov rax, 9
48 B9 09 00 00 00 00 00 00 00   ; mov rcx, 9
48 39 C8                        ; cmp rax, rcx
0F 85 04 00 00 00               ; jne +4         not taken
48 83 C7 10                     ; add rdi, 16
48 B8 07 00 00 00 00 00 00 00   ; mov rax, 7
48 B9 05 00 00 00 00 00 00 00   ; mov rcx, 5
48 39 C8                        ; cmp rax, rcx
0F 8E 04 00 00 00               ; jle +4         not taken
48 83 C7 20                     ; add rdi, 32
48 B8 07 00 00 00 00 00 00 00   ; mov rax, 7
48 B9 05 00 00 00 00 00 00 00   ; mov rcx, 5
48 39 C8                        ; cmp rax, rcx
0F 88 04 00 00 00               ; js +4          not taken
48 83 C7 40                     ; add rdi, 64
48 B8 05 00 00 00 00 00 00 00   ; mov rax, 5
48 B9 07 00 00 00 00 00 00 00   ; mov rcx, 7
48 39 C8                        ; cmp rax, rcx
0F 83 04 00 00 00               ; jae +4         not taken
48 83 C7 80                     ; add rdi, -128  the status's top bit
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
