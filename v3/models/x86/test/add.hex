; a sum with a carry out of the top bit, stored below the stack pointer and read back from each
; of its eight bytes: KK runs F8..FF, the status the byte of the sum 0223344556677889 at KK - F8.
; statuses: 137 120 103 86 69 52 35 2
48 B8 88 77 66 55 44 33 22 11   ; mov rax, 1122334455667788
48 B9 01 01 01 01 01 01 01 F1   ; mov rcx, F101010101010101
48 01 C8                        ; add rax, rcx
48 89 44 24 F8                  ; mov [rsp-8], rax
48 8B 7C 24 KK                  ; mov rdi, [rsp-8+k]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
