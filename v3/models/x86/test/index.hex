; an operand with an index register: each scale, the stack pointer as the base, a high register
; as the index, the base r13 (which always takes a displacement), a displacement of one byte and
; of four, a load, a store and an operation into memory. The words 11, 7, 5 are pushed; the
; status is the third word after 12 is stored there and 30 added to it.
; statuses: 42
BF 05 00 00 00                  ; mov edi, 5
57                              ; push rdi
BF 07 00 00 00                  ; mov edi, 7
57                              ; push rdi
BF 0B 00 00 00                  ; mov edi, 11
57                              ; push rdi
B9 01 00 00 00                  ; mov ecx, 1
48 8B 04 CC                     ; mov rax, [rsp+rcx*8]   7
BA 02 00 00 00                  ; mov edx, 2
48 03 04 D4                     ; add rax, [rsp+rdx*8]   12
48 89 E3                        ; mov rbx, rsp
41 BC 02 00 00 00               ; mov r12d, 2
4A 89 04 E3                     ; mov [rbx+r12*8], rax   the third word is 12
49 89 E5                        ; mov r13, rsp
B9 10 00 00 00                  ; mov ecx, 16
49 8B 7C 0D 00                  ; mov rdi, [r13+rcx*1]   12
B9 04 00 00 00                  ; mov ecx, 4
48 03 7C 4B F8                  ; add rdi, [rbx+rcx*2-8]   23
B9 02 00 00 00                  ; mov ecx, 2
48 03 BC 8B 00 00 00 00         ; add rdi, [rbx+rcx*4+0]   30: the displacement in four bytes
48 01 3C CB                     ; add [rbx+rcx*8], rdi   the third word is 42
48 8B 7B 10                     ; mov rdi, [rbx+16]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
