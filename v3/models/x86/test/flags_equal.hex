; conditions on equal operands, and on a sum that overflows the signed range: a bit of the
; status for every jump not taken.
; statuses: 89
48 B8 09 00 00 00 00 00 00 00   ; mov rax, 9
48 B9 09 00 00 00 00 00 00 00   ; mov rcx, 9
48 39 C8                        ; cmp rax, rcx
0F 82 04 00 00 00               ; jb +4          not taken: no borrow between equals
48 83 C7 01                     ; add rdi, 1
48 39 C8                        ; cmp rax, rcx
0F 83 04 00 00 00               ; jae +4         taken
48 83 C7 02                     ; add rdi, 2
48 39 C8                        ; cmp rax, rcx
0F 86 04 00 00 00               ; jbe +4         taken
48 83 C7 04                     ; add rdi, 4
48 39 C8                        ; cmp rax, rcx
0F 87 04 00 00 00               ; ja +4          not taken
48 83 C7 08                     ; add rdi, 8
48 39 C8                        ; cmp rax, rcx
0F 8C 04 00 00 00               ; jl +4          not taken
48 83 C7 10                     ; add rdi, 16
48 39 C8                        ; cmp rax, rcx
0F 8D 04 00 00 00               ; jge +4         taken
48 83 C7 20                     ; add rdi, 32
48 B8 FF FF FF FF FF FF FF 7F   ; mov rax, 7FFFFFFFFFFFFFFF
48 83 C0 01                     ; add rax, 1     the largest signed number and one: overflow
0F 81 04 00 00 00               ; jno +4         not taken
48 83 C7 40                     ; add rdi, 64
48 B8 FF FF FF FF FF FF FF 7F   ; mov rax, 7FFFFFFFFFFFFFFF
48 83 C0 01                     ; add rax, 1
0F 88 04 00 00 00               ; js +4          taken: the sum's top bit is set
48 83 C7 80                     ; add rdi, -128
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
