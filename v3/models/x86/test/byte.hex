; a byte read from memory as a word: KK runs F8..FF, the status the byte of 0123456789ABCDEF at
; KK - F8. The register read into held all ones: where the bytes above the one read are not
; zero the status is 0.
; statuses: 239 205 171 137 103 69 35 1
48 B8 EF CD AB 89 67 45 23 01   ; mov rax, 0x0123456789ABCDEF
48 89 44 24 F8                  ; mov [rsp-8], rax
48 BF FF FF FF FF FF FF FF FF   ; mov rdi, 0xFFFFFFFFFFFFFFFF
48 0F B6 7C 24 KK               ; movzx rdi, byte [rsp-8+k]
48 81 FF 00 01 00 00            ; cmp rdi, 256
0F 82 05 00 00 00               ; jb +5
BF 00 00 00 00                  ; mov edi, 0
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
