; an immediate and a displacement of one byte at the edge of its sign, where 80 is -128; the
; same address reached by a displacement of four bytes: KK runs F8..FF, the status the byte of
; 128 at KK - F8.
; statuses: 128 0 0 0 0 0 0 0
48 B8 00 01 00 00 00 00 00 00   ; mov rax, 256
48 83 C0 80                     ; add rax, -128          128
48 89 44 24 80                  ; mov [rsp-128], rax     a displacement of one byte
48 8B 8C 24 80 FF FF FF         ; mov rcx, [rsp-128]     the same address by four bytes
48 89 4C 24 F8                  ; mov [rsp-8], rcx
48 8B 7C 24 KK                  ; mov rdi, [rsp-8+k]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
