; a byte as a word, of a register (sil: the low byte, under the prefix) into a high register,
; and through a base and an index: 34 + 12 of FFFFFFFF00001234 is 46.
; statuses: 70
48 BE 34 12 00 00 FF FF FF FF   ; mov rsi, 0xFFFFFFFF00001234
4C 0F B6 C6                     ; movzx r8, sil
48 89 74 24 F8                  ; mov [rsp-8], rsi
B9 01 00 00 00                  ; mov ecx, 1
4C 0F B6 4C 0C F8               ; movzx r9, byte [rsp+rcx*1-8]
4D 01 C8                        ; add r8, r9
4C 89 C7                        ; mov rdi, r8
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
