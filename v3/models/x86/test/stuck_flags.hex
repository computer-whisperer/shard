; a product leaves the zero and the sign flag undefined on the processor, and the model says
; nothing of any flag after one: a jump that reads one is stuck in the model. The processor
; takes the jump or does not, and exits with 3 or with 4.
; model: stuck: no rule for a jump on condition 4
BF 03 00 00 00                  ; mov edi, 3
B8 02 00 00 00                  ; mov eax, 2
48 0F AF C0                     ; imul rax, rax
0F 84 04 00 00 00               ; je +4
48 83 C7 01                     ; add rdi, 1
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
