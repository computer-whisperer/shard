; and, xor and or through memory at a base register with a displacement of one byte and of
; four, a high register as a base (which takes a SIB byte), an immediate of four bytes
; sign-extended: KK runs F8..FF, the status the byte of FFFFFFFFF000F000 at KK - F8.
; statuses: 0 240 0 240 255 255 255 255
48 89 E5                        ; mov rbp, rsp
48 B8 F0 F0 F0 F0 0F 0F 0F 0F   ; mov rax, 0F0F0F0FF0F0F0F0
48 89 45 F0                     ; mov [rbp-16], rax
48 B9 FF 00 FF 00 FF 00 FF 00   ; mov rcx, 00FF00FF00FF00FF
48 23 8D F0 FF FF FF            ; and rcx, [rbp-16]      rcx = 000F000F00F000F0
48 31 4D F0                     ; xor [rbp-16], rcx      there: 0F000F00F000F000
49 89 EC                        ; mov r12, rbp
49 8B 54 24 F0                  ; mov rdx, [r12-16]
48 81 CA 00 00 00 80            ; or rdx, FFFFFFFF80000000
48 89 55 F8                     ; mov [rbp-8], rdx
48 8B 7D KK                     ; mov rdi, [rbp-8+k]
B8 3C 00 00 00                  ; mov eax, 60
0F 05                           ; syscall
