;;; v3/models/x86/hello.shard — a file that writes: instructions by hand that write two pieces
;;; of text to the standard output with `write_all` (write.shard), one call each, and exit with
;;; 0. The text stands in the file as the immediate numbers of two instructions the process
;;; never comes to — the assembler has no line for bytes that are not an instruction. What the
;;; file's process comes to, for every stack and every list of the kernel's answers, is
;;; hello_run.shard's; hello_main.shard writes the file.
(import "asm.shard")
(import "write.shard")
(use std.mem)
(use models.x86.asm)
(use models.x86.asm.Asm)
(use models.x86.elf)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.write)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the text -----------------------------------------------------------------------------------
;; `hello, ` and `world` with a line's end
(fn hello_one () (List Nat) (list 104 101 108 108 111 44 32))
(fn hello_two () (List Nat) (list 119 111 114 108 100 10))
;; How the file's process ends on the answers `as`: the two pieces written one after the other
;; and the exit with 0, or what `sends_end` says of a kernel that fails a write or ends the
;; process (models/x86/linux.shard).
(fn hello_res ((as (List Answer))) Res (sends_end as nil (list hello_one hello_two) 0))

;; ---- its listing ----------------------------------------------------------------------------------
;; label 0: write_all
(fn hello_head () (List Asm)
  (list (AI (MovRI32 6 4194522))  ; mov esi, the address of `hello, `
    (AI (MovRI32 2 7))  ; mov edx, its length
    (ACall 0)  ; call write_all
    (AI (MovRI32 6 4194532))  ; mov esi, the address of `world` and the line's end
    (AI (MovRI32 2 6))  ; mov edx, its length
    (ACall 0)  ; call write_all
    (AI (MovRI32 7 0))  ; mov edi, 0
    (AI (MovRI32 0 60))  ; mov eax, 60
    (AI Syscall)
    (ALabel 0)))
;; the two pieces as the numbers their bytes are, the least significant first, each the
;; immediate of a `mov rax`: the bytes stand from the instruction's third byte
(fn hello_text () (List Asm)
  (list (AI (MovRI64 0 9056056326776168)) (AI (MovRI64 0 11426432446327))))
(fn hello_listing () (List Asm) (List.append hello_head (List.append (lines write_all) hello_text)))
;; the listing's file; no bytes where the assembler answers nothing
(fn hello_file () (List Nat)
  (match (assemble hello_listing)
    (none nil)
    ((some code) (elf_exec code))))
