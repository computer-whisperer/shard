;;; v3/models/x86/run_main.shard — the model run on a file from the command line: the file's
;;; bytes loaded as Linux would, the processor stepped from `start_zero` — or, for a file given
;;; arguments, from `start_args` — for at most the count given, on the kernel's answers given — or
;;; on none, a kernel that takes all it is offered —, and how the run ended printed as one line:
;;; `exit N`; `killed`; `stuck` with the reason, the address and the bytes found there; `out of
;;; steps`. A process that wrote has `, wrote` and its bytes after the first two. The same file
;;; run by the real processor is what the model is held to (kernel/test/x86_test.sh).
;;;
;;;   load.shard --root v3 --init … --run models.x86.run_main.main v3/models/x86/run_main.shard -- run STEPS FILE…
;;;   … -- args STEPS FILE ARG…  the file run with the arguments ARG…, the first its name
;;;   … -- answers STEPS FILE SPEC…  the file run as `run` runs it, once on each list SPEC of
;;;                                the kernel's answers, a line each: items between commas, `N`
;;;                                (it takes N bytes, all for 0), `eN` (it fails with the error
;;;                                N), `k` (it ends the process)
;;;   … -- wrap CODE FILE …     the bytes of CODE as the executable file FILE that runs them
(import "../../std/bytes.shard")
(import "../../std/derive.shard")
(import "../../std/host.shard")
(import "../../std/list.shard")
(import "elf.shard")
(import "linux.shard")
(use std.bytes)
(use std.derive)
(use std.host)
(use std.mem)
(use models.x86.elf)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.linux.Answer)
(use models.x86.linux.How)
(use models.x86.linux.Res)
(use models.x86.x86.Why)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; a literal's bytes as numbers
(fn text ((s String)) (List Nat) (Bytes.toNats (Bytes.ofString s)))
;; a byte as two hexadecimal digits before `rest`; a list of bytes, a space before each
(fn hex_digit ((d Nat)) Nat (if (< d 10) (+ 48 d) (+ 87 d)))
(fn hex2 ((b Nat) (rest (List Nat))) (List Nat)
  (cons (hex_digit (/ b 16)) (cons (hex_digit (% b 16)) rest)))
(fn hex_bytes ((bs (List Nat))) (List Nat)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons 32 (hex2 b (hex_bytes r))))))

;; how a run ended, as a line
(fn at_address ((what String) (a Nat) (rest (List Nat))) (List Nat)
  (List.append (text what) (Nat.renderOnto a rest)))
(fn show_why ((y Why)) (List Nat)
  (match y
    ((WDecode a bs)
     (at_address "stuck: no instruction of the model at " a (cons 58 (hex_bytes bs))))
    ((WLoad a) (at_address "stuck: not mapped to read at " a nil))
    ((WStore a) (at_address "stuck: not mapped to write at " a nil))
    ((WCond cc) (at_address "stuck: no rule for a jump on condition " cc nil))
    ((WSyscall n) (at_address "stuck: no rule for system call " n nil))
    (WFile (text "stuck: not a file the model loads"))))
;; what a process wrote, after how it ended: nothing where it wrote nothing
(fn show_out ((out (List Nat))) (List Nat)
  (match out
    (nil nil)
    ((cons _ _) (List.append (text ", wrote") (hex_bytes out)))))
(fn show_res ((r Res)) (List Nat)
  (match r
    ((RExit status out) (at_address "exit " status (show_out out)))
    ((RKill out) (List.append (text "killed") (show_out out)))
    ((RStuck y) (show_why y))
    ((ROut c) (at_address "out of steps at " (w64_val (Cpu.rip c)) nil))))

;; what the runner starts a process from: zeroed registers but the stack pointer, cleared flags,
;; eight megabytes of zeroed stack below 7FFFFFFFF000, the stack pointer a page under its top
(fn start_zero () Start (runner_start regs_zero flags_clear mem_empty))

;; ---- a start with arguments ------------------------------------------------------------------
;; the bytes the arguments' strings take, each with its 0
(fn strs_size ((args (List (List Nat)))) Nat
  (measure (struct args))
  (match args
    (nil 0)
    ((cons s r) (+ (+ (List.length s) 1) (strs_size r)))))
;; the strings laid from the address a, each with its 0 and the next after it, and from the
;; address p a word for each: its string's address
(fn lay_args ((m Mem) (p Nat) (a Nat) (args (List (List Nat)))) Mem
  (measure (struct args))
  (match args
    (nil m)
    ((cons s r)
     (lay_args (mem_put64 (put_bytes (mem_set m (+ a (List.length s)) 0) a s (List.length s)) p a)
       (+ p 8)
       (+ (+ a (List.length s)) 1)
       r))))
;; where the stack pointer stands for these arguments: under the strings, the count, the
;; addresses and two words more, at a multiple of sixteen
(fn args_sp ((args (List (List Nat)))) Nat
  (* 16 (/ (- (- 140737488351232 (strs_size args)) (* 8 (+ (List.length args) 3))) 16)))
;; What the runner starts a process with arguments from, laid out as Linux lays them: the
;; strings at the top of the stack's range; under them the count at the stack pointer, the
;; strings' addresses, and two words of 0 — the end of the arguments and an empty environment.
;; It is one start `args_at` allows (models/x86/linux.shard); a theorem about a file is for all.
(fn start_args ((args (List (List Nat)))) Start
  (start_at 140737479962624 (args_sp args) 140737488351232 regs_zero flags_clear
    (lay_args (mem_put64 mem_empty (args_sp args) (List.length args)) (+ (args_sp args) 8)
      (- 140737488351232 (strs_size args))
      args)))

;; ---- the command line ----------------------------------------------------------------------
;;   run STEPS FILE…      each file run for at most STEPS steps, a line each
;;   args STEPS FILE ARG… the file run for at most STEPS steps with the arguments ARG…
;;   answers STEPS FILE SPEC…      the file run once on each list SPEC of the kernel's answers
;;   wrap SRC DST …       each SRC's bytes as code, wrapped as the executable file DST
(fn same ((a (List Nat)) (b (List Nat))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x r)
     (match b
       (nil false)
       ((cons y s) (if (= x y) (same r s) false))))))
;; decimal digits as a number
(fn nat_of ((ds (List Nat)) (acc Nat)) Nat
  (measure (struct ds))
  (match ds
    (nil acc)
    ((cons d r) (nat_of r (+ (* 10 acc) (- d 48))))))
(fn fail ((w World)) World
  (exit 2 (write_line (Bytes.ofNats (text "x86run: a file cannot be read or written")) w)))
;; the kernel's answers from their text: items between commas — a number N (it takes N bytes,
;; all for 0), `e` and a number (it fails with that error), `k` (it ends the process). The two
;; registers an answer leaves are given two words no program has a use for.
(fn answer_of ((item (List Nat))) Answer
  (MkAnswer
    (match item
      (nil (HTook 0))
      ((cons x r)
       (if (= x 101) (HErr (nat_of r 0))
       (if (= x 107) HKill
       (HTook (nat_of item 0))))))
    (w64 12297829382473034410)
    (w64 6148914691236517205)))
(fn answers_of ((spec (List Nat)) (item (List Nat))) (List Answer)
  (measure (struct spec))
  (match spec
    (nil (cons (answer_of (List.reverse item)) nil))
    ((cons x r)
     (if (= x 44) (cons (answer_of (List.reverse item)) (answers_of r nil))
     (answers_of r (cons x item))))))
(fn run_one ((steps Nat) (st Start) (as (List Answer)) (path ByteArray) (w World)) World
  (match (read_file path w)
    ((Prod.mk r w1)
     (match r
       (none (fail w1))
       ((some bs)
        (write_line (Bytes.ofNats (show_res (run_file (fuel_of steps) (Bytes.toNats bs) st as))) w1))))))
;; a file's bytes run once on each list of answers, a line each
(fn run_specs ((steps Nat) (bs (List Nat)) (specs (List ByteArray)) (w World)) World
  (measure (struct specs))
  (match specs
    (nil w)
    ((cons sp r)
     (run_specs steps bs r
       (write_line
         (Bytes.ofNats
           (show_res (run_file (fuel_of steps) bs start_zero (answers_of (Bytes.toNats sp) nil))))
         w)))))
(fn run_each ((steps Nat) (paths (List ByteArray)) (w World)) World
  (measure (struct paths))
  (match paths
    (nil w)
    ((cons p r) (run_each steps r (run_one steps start_zero nil p w)))))
(fn nats_each ((bs (List ByteArray))) (List (List Nat))
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Bytes.toNats b) (nats_each r)))))
(fn wrap_one ((src ByteArray) (dst ByteArray) (w World)) World
  (match (read_file src w)
    ((Prod.mk r w1)
     (match r
       (none (fail w1))
       ((some bs)
        (match (write_file dst (Bytes.ofNats (elf_exec (Bytes.toNats bs))) w1)
          ((Prod.mk ok w2) (if ok w2 (fail w2)))))))))
(fn wrap_each ((paths (List ByteArray)) (w World)) World
  (measure (struct paths))
  (match paths
    ((cons src (cons dst r)) (wrap_each r (wrap_one src dst w)))
    (_ w)))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       ((cons cmd rest)
        (if (same (Bytes.toNats cmd) (text "wrap")) (wrap_each rest w1)
        (match rest
          ((cons steps files)
           (if (same (Bytes.toNats cmd) (text "run"))
             (run_each (nat_of (Bytes.toNats steps) 0) files w1)
           (if (same (Bytes.toNats cmd) (text "args"))
             (match files
               ((cons file argv)
                (run_one (nat_of (Bytes.toNats steps) 0) (start_args (nats_each argv)) nil file w1))
               (nil (fail w1)))
           (if (same (Bytes.toNats cmd) (text "answers"))
             (match files
               ((cons file specs)
                (match (read_file file w1)
                  ((Prod.mk r w2)
                   (match r
                     (none (fail w2))
                     ((some bs)
                      (run_specs (nat_of (Bytes.toNats steps) 0) (Bytes.toNats bs) specs w2))))))
               (nil (fail w1)))
             (fail w1)))))
          (nil (fail w1)))))
       (nil (fail w1))))))
