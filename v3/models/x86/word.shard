;;; v3/models/x86/word.shard — the machine word of the x86-64 model: Init's `(BitVec 64)`, so
;;; a word's range is its type and Init's lemmas on bit vectors apply to it. Init's operations on
;;; a bit vector have no program; an operation here is a function whose program is arithmetic
;;; on naturals. `w64`, `w64_add`, `w64_sub` and `w64_mul` are proven to be Init's; the bitwise
;;; three are not yet.
(import "../../std/bytes.shard")
(use std.bytes)
(use Init.Bool false true)

;; n mod 2^64 as a word; it is Init's `BitVec.ofNat 64`
(fn w64 ((n Nat)) (BitVec 64)
  (BitVec.ofFin
    (Fin.mk (Nat.mod n 18446744073709551616) (Nat.mod_lt n (Nat.zero_lt_succ 18446744073709551615)))))
(theorem w64_eq ((n Nat)) (= (w64 n) (BitVec.ofNat 64 n)) (exact (Eq.refl (BitVec.ofNat 64 n))))

;; a word's number, below 2^64
(fn w64_val ((x (BitVec 64))) Nat (@BitVec.toNat 64 x))
(theorem w64_val_w64 ((n Nat)) (= (w64_val (w64 n)) (Nat.mod n 18446744073709551616))
  (exact (Eq.refl (Nat.mod n 18446744073709551616))))

;; the sum and the difference, mod 2^64: Init's `BitVec.add` and `BitVec.sub`
(fn w64_add ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64) (w64 (+ (w64_val a) (w64_val b))))
(fn w64_sub ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64)
  (w64 (+ (- 18446744073709551616 (w64_val b)) (w64_val a))))
;; the low word of the product: Init's `BitVec.mul`
(fn w64_mul ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64) (w64 (* (w64_val a) (w64_val b))))
(theorem w64_mul_eq ((a (BitVec 64)) (b (BitVec 64))) (= (w64_mul a b) (BitVec.mul a b))
  (exact (Eq.refl (BitVec.mul a b))))
(theorem w64_add_eq ((a (BitVec 64)) (b (BitVec 64))) (= (w64_add a b) (BitVec.add a b))
  (exact (Eq.refl (BitVec.add a b))))
(theorem w64_sub_eq ((a (BitVec 64)) (b (BitVec 64))) (= (w64_sub a b) (BitVec.sub a b))
  (exact (Eq.refl (BitVec.sub a b))))

;; bit by bit
(fn w64_and ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64) (w64 (band (w64_val a) (w64_val b))))
(fn w64_or ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64) (w64 (bor (w64_val a) (w64_val b))))
(fn w64_xor ((a (BitVec 64)) (b (BitVec 64))) (BitVec 64) (w64 (bxor (w64_val a) (w64_val b))))

;; whether a is below b, both read as unsigned numbers
(fn w64_ltu ((a (BitVec 64)) (b (BitVec 64))) Bool (if (< (w64_val a) (w64_val b)) true false))

;; the top bit: the sign of the word read as a signed number
(fn w64_msb ((a (BitVec 64))) Bool (if (<= 9223372036854775808 (w64_val a)) true false))

;; a byte, and four bytes, as the number of the 64-bit word they sign-extend to
(fn sx8 ((n Nat)) Nat (if (< n 128) n (+ n 18446744073709551360)))
(fn sx32 ((n Nat)) Nat (if (< n 2147483648) n (+ n 18446744069414584320)))

;; ---- facts of a word's number ----------------------------------------------------------------
;; a word's number is below 2^64
(theorem w64_val_lt ((x (BitVec 64))) (< (w64_val x) 18446744073709551616) (exact (BitVec.isLt x)))
;; a word below another, and one more: no wrap
(theorem w64_val_succ ((i (BitVec 64)) (n (BitVec 64)) (h (< (w64_val i) (w64_val n))))
  (= (w64_val (w64_add i (w64 1))) (+ (w64_val i) 1))
  (by
    (have hn (< (w64_val n) 18446744073709551616) (exact (w64_val_lt n)))
    (have hm (= (w64_val (w64_add i (w64 1))) (Nat.mod (+ (w64_val i) 1) 18446744073709551616)) rfl)
    (rw hm)
    (apply Nat.mod_eq_of_lt (arith))))

;; a loop's count of what is left falls where its index, below the bound, goes up by one
(theorem loop_descends ((n (BitVec 64)) (i (BitVec 64)) (h (< (w64_val i) (w64_val n))))
  (< (- (w64_val n) (w64_val (w64_add i (w64 1)))) (- (w64_val n) (w64_val i)))
  (by
    (rw (w64_val_succ i n h))
    (apply Nat.sub_lt_sub_left (exact h) (exact (Nat.lt_succ_self (w64_val i))))))
;; a word's number, as a word, is the word
(theorem w64_of_val ((x (BitVec 64))) (= (w64 (w64_val x)) x)
  (by
    (apply BitVec.eq_of_toNat_eq
      ((show (= (Nat.mod (w64_val x) 18446744073709551616) (w64_val x)))
       (exact (Nat.mod_eq_of_lt (w64_val_lt x)))))))
;; a word taken away and added back
(theorem w64_sub_add ((x (BitVec 64)) (y (BitVec 64))) (= (w64_add (w64_sub x y) y) x)
  (exact (BitVec.sub_add_cancel x y)))
;; k taken from a word whose number is a and k more: no wrap
(theorem w64_val_sub
  ((x (BitVec 64)) (a Nat) (k Nat) (h (= (w64_val x) (+ a k))) (hk (< k 18446744073709551616)))
  (= (w64_val (w64_sub x (w64 k))) a)
  (by
    (have hx (< (w64_val x) 18446744073709551616) (exact (w64_val_lt x)))
    (have ha (< a 18446744073709551616) (arith))
    (have hm
      (= (w64_val (w64_sub x (w64 k)))
        (Nat.mod (+ (- 18446744073709551616 (Nat.mod k 18446744073709551616)) (w64_val x))
          18446744073709551616))
      rfl)
    (have he (= (+ (- 18446744073709551616 k) (+ a k)) (+ a 18446744073709551616))
      (arith (Nat.sub_add_cancel (Nat.le_of_lt hk))))
    (rw hm)
    (rw (Nat.mod_eq_of_lt hk))
    (rw h)
    (rw he)
    (exact (Eq.trans (Nat.add_mod_right a 18446744073709551616) (Nat.mod_eq_of_lt ha)))))
(theorem w64_xor_self ((a (BitVec 64))) (= (w64_xor a a) (w64 0))
  (by (show (= (w64 (bxor (w64_val a) (w64_val a))) (w64 0))) (rw (Nat.xor_self (w64_val a))) rfl))
