;;; v3/models/x86/word.shard — the machine word of the x86-64 model: Init's `(BitVec 64)`, so
;;; a word's range is its type and Init's lemmas on bit vectors apply to it. Init's operations on
;;; a bit vector have no program; each operation here is a function whose program is arithmetic
;;; on naturals, with a theorem that it is Init's.
(import "../../std/bytes.shard")
(use std.bytes)

;; n mod 2^64 as a word; it is Init's `BitVec.ofNat 64`
(fn w64 ((n Nat)) (BitVec 64)
  (BitVec.ofFin
    (Fin.mk (Nat.mod n 18446744073709551616) (Nat.mod_lt n (Nat.zero_lt_succ 18446744073709551615)))))
(theorem w64_eq ((n Nat)) (= (w64 n) (BitVec.ofNat 64 n)) (exact (Eq.refl (BitVec.ofNat 64 n))))

;; a word's number, below 2^64
(fn w64_val ((x (BitVec 64))) Nat (@BitVec.toNat 64 x))
(theorem w64_val_w64 ((n Nat)) (= (w64_val (w64 n)) (Nat.mod n 18446744073709551616))
  (exact (Eq.refl (Nat.mod n 18446744073709551616))))
