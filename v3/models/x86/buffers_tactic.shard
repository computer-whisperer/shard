;;; v3/models/x86/buffers_tactic.shard — the tactic the trial's lemmas name (`buffers_facts.shard`,
;;; `(auto (tactic models.x86.buffers_tactic.block))`): `derive.shard`'s proof of a run of
;;; instructions, over the trial's table. No file of the trial imports it: a load replays the
;;; blocks `prove` wrote into `buffers_facts.auto.shard`, and `prove` is given this file before
;;; that one.
(import "buffers.shard")
(import "derive.shard")
(use models.x86.buffers)
(use models.x86.derive)

(fn block ((goal (List Int)) (hints (List Int))) (List Int) (derive_block buffers_table goal hints))
