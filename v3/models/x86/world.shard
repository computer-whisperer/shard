;;; v3/models/x86/world.shard — a program's World (std/world.shard) against what is outside a
;;; process in this model (linux.shard `Os`). A World has of the kernel's answers how each call
;;; went and nothing of the registers a call destroys; what a process has written is the same
;;; in both. The platform's `write_all` on the World of what is outside a process says what
;;; the model's `send` says of it (`send_put`), so a run of a file that the model ends in a
;;; result is the result its program's World gives (`world_res`).
(import "linux.shard")
(use std.mem)
(use std.world)
(use std.world.How)
(use std.world.Life)
(use std.world.Put)
(use std.world.World)
(use models.x86.linux)
(use models.x86.linux.Answer)
(use models.x86.linux.Os)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.linux.Sent)
(use models.x86.word)
(use Init.Bool false true)
(use Init.List cons nil)

;; the answers a program has of the kernel's: how each call went
(fn hows ((as (List Answer))) (List How)
  (measure (struct as))
  (match as
    (nil nil)
    ((cons a r) (cons (Answer.how a) (hows r)))))
;; the World of what is outside a process that runs, and the World a process starts with
(fn os_world ((o Os)) World (MkWorld (hows (Os.ans o)) (Os.out o) Live))
(fn world_of ((as (List Answer))) World (os_world (os_start as)))
;; How a file ends whose function returned the word v and left the World w: with v's low byte
;; where the process still ran; with the status of a failed write where one failed; ended by
;; the kernel where it was — in each case having written what the World has.
(fn world_res ((v (BitVec 64)) (w World)) Res
  (match (World.life w)
    (Live (RExit (% (w64_val v) 256) (World.out w)))
    (Failed (RExit status_io (World.out w)))
    (Killed (RKill (World.out w)))))

;; ---- the model's loop is the platform's function ------------------------------------------------
(fn sent_put ((s Sent)) Put
  (match s
    ((SAll l) (PAll (hows l)))
    ((SFail q) (PFail q))
    ((SKill q) (PKill q))))
(theorem sent_put_after ((p (List Nat)) (s Sent))
  (= (sent_put (sent_after p s)) (put_after p (sent_put s)))
  (by (cases s ((SAll (l) rfl) (SFail (q) rfl) (SKill (q) rfl)))))
(theorem send_put ((as (List Answer)))
  (forall ((bs (List Nat))) (= (put (hows as) bs) (sent_put (send as bs))))
  (by
    (induction as
      ((nil () (intro bs) rfl)
       (cons (a r ih) (intro bs)
         (cases bs
           ((nil () rfl)
            (cons (b t)
              (show
                (= (put (cons (Answer.how a) (hows r)) (cons b t))
                  (sent_put (send (cons a r) (cons b t)))))
              (rw send.eq_3)
              (cases (Answer.how a) hh
                ((HTook (k) (rw put.eq_3) (reduce)
                   (rw (ih (List.drop (took k (List.length (cons b t))) (cons b t))))
                   (exact
                     (Eq.symm
                       (sent_put_after (List.take (took k (List.length (cons b t))) (cons b t))
                         (send r (List.drop (took k (List.length (cons b t))) (cons b t)))))))
                 (HErr (e) rfl)
                 (HKill () rfl)))))))))))

;; ---- an outcome of code against a program's value -------------------------------------------------
;; A program's function has a value: a word and a World. What it says of the memory it leaves
;; is a CONDITION on it, K: code that stores cannot name that memory ahead of its run. The
;; outcome of the code's run is that value's, under K, when the code returned that word, left
;; a memory K holds of, and left outside what that World is of; or when the process ended in
;; it, the World has stopped, and the process ended as that World says.
(def tied ((out Outcome) (v (BitVec 64)) (K (-> Mem Prop)) (w World)) Prop
  (match out
    ((ORet v1 m1 o1) (and (= v1 v) (and (K m1) (= (os_world o1) w))))
    ((OEnd r)
     (and (= (runs (World.life w)) false) (forall ((x (BitVec 64))) (= (world_res x w) r))))))
;; under a weaker condition too
(theorem tied_weaken
  ((out Outcome)
   (v (BitVec 64))
   (K (-> Mem Prop))
   (K2 (-> Mem Prop))
   (w World)
   (h (forall ((m2 Mem)) (-> (K m2) (K2 m2)))))
  (-> (tied out v K w) (tied out v K2 w))
  (by
    (cases out
      ((ORet (v0 m0 o0) (intro ht)
         (exact
           (And.intro (And.left ht)
             (And.intro (h m0 (And.left (And.right ht))) (And.right (And.right ht))))))
       (OEnd (r) (intro ht) (exact ht))))))
;; so a file whose function's outcome is its program's value ends as the program's World says
(theorem tied_exit ((out Outcome) (v (BitVec 64)) (K (-> Mem Prop)) (w World))
  (-> (tied out v K w) (= (exit_of out) (world_res v w)))
  (by
    (cases out
      ((ORet (v1 m1 o1)
         (show
           (-> (and (= v1 v) (and (K m1) (= (os_world o1) w)))
             (= (exit_of (ORet v1 m1 o1)) (world_res v w))))
         (intro h)
         (rw (<- (And.right (And.right h))))
         (rw (<- (And.left h)))
         rfl)
       (OEnd (r)
         (show
           (->
             (and (= (runs (World.life w)) false) (forall ((x (BitVec 64))) (= (world_res x w) r)))
             (= r (world_res v w))))
         (intro h)
         (exact (Eq.symm ((And.right h) v))))))))
