;;; v3/models/x86/hello_main.shard — the file `hello.shard` describes, written; and what its
;;; theorem says of a list of the kernel's answers (`hello_res`), printed as the model's runner
;;; prints a run, for the two to be compared (kernel/test/x86_write_test.sh).
;;;
;;;   load.shard --root v3 --init … --run models.x86.hello_main.main v3/models/x86/hello_main.shard -- write PATH
;;;   … -- says SPEC…    a line for each SPEC, answers as the runner's `answers` reads them
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "hello.shard")
(import "run_main.shard")
(use std.bytes)
(use std.host)
(use models.x86.hello)
(use models.x86.linux)
(use models.x86.run_main answers_of same show_res text)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(fn fail ((w World)) World
  (exit 2 (write_line (Bytes.ofNats (text "hello: write PATH | says SPEC…")) w)))
(fn says_each ((specs (List ByteArray)) (w World)) World
  (measure (struct specs))
  (match specs
    (nil w)
    ((cons sp r)
     (says_each r
       (write_line (Bytes.ofNats (show_res (hello_res (answers_of (Bytes.toNats sp) nil)))) w)))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       ((cons cmd rest)
        (if (same (Bytes.toNats cmd) (text "says")) (says_each rest w1)
        (match rest
          ((cons path nil)
           (if (same (Bytes.toNats cmd) (text "write"))
             (match (write_file path (Bytes.ofNats hello_file) w1)
               ((Prod.mk ok w2) (if ok w2 (fail w2))))
             (fail w1)))
          (_ (fail w1)))))
       (nil (fail w1))))))
