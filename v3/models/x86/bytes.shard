;;; v3/models/x86/bytes.shard — the bytes of a word that stands in memory: the eight bytes from
;;; an address are the eight low bytes of the number `mem_le64` reads there, least significant
;;; first (`le64_bytes`). By it a program's text that a file holds as words — a start-up pushes
;;; words — is known byte for byte.
(import "laws.shard")
(use std.mem)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)

;; the eight low bytes of a number, least significant first
(fn bytes8 ((v Nat)) (List Nat)
  (cons (% v 256)
    (cons (% (/ v 256) 256)
      (cons (% (/ (/ v 256) 256) 256)
        (cons (% (/ (/ (/ v 256) 256) 256) 256)
          (cons (% (/ (/ (/ (/ v 256) 256) 256) 256) 256)
            (cons (% (/ (/ (/ (/ (/ v 256) 256) 256) 256) 256) 256)
              (cons (% (/ (/ (/ (/ (/ (/ v 256) 256) 256) 256) 256) 256) 256)
                (cons (% (/ (/ (/ (/ (/ (/ (/ v 256) 256) 256) 256) 256) 256) 256) 256) nil)))))))))
;; a number below 256 and 256 times another: the first is the sum's low byte, the other the
;; rest
(theorem split_mod ((b Nat) (x Nat) (h (< b 256))) (= (% (+ b (* 256 x)) 256) b)
  (by (rw (Nat.add_mul_mod_self_left b 256 x)) (exact (Nat.mod_eq_of_lt h))))
(theorem split_div ((b Nat) (x Nat) (h (< b 256))) (= (/ (+ b (* 256 x)) 256) x)
  (by
    (have h0 (< 0 256) (decide))
    (rw (Nat.add_mul_div_left b x h0))
    (rw (Nat.div_eq_of_lt h))
    (exact (Nat.zero_add x))))
;; a range's bytes, the first and those after it
(theorem mem_bytes_cons ((m Mem) (a Nat) (n Nat) (k Nat) (h (= n (+ k 1))))
  (= (mem_bytes m a n) (cons (mem_get m a) (mem_bytes m (+ a 1) k)))
  (by (rw h) (exact (mem_bytes_succ m a k))))
(theorem le64_bytes ((m Mem) (a Nat)) (= (mem_bytes m a 8) (bytes8 (mem_le64 m a)))
  (by
    (have hV
      (= (mem_le64 m a)
        (+ (mem_get m a)
          (* 256
            (+ (mem_get m (+ a 1))
              (* 256
                (+ (mem_get m (+ (+ a 1) 1))
                  (* 256
                    (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                      (* 256
                        (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                          (* 256
                            (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                              (* 256
                                (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                                  (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))))))))))))
      (show
        (=
          (+
            (le32 (mem_get m a) (mem_get m (+ a 1)) (mem_get m (+ (+ a 1) 1))
              (mem_get m (+ (+ (+ a 1) 1) 1)))
            (* 4294967296
              (le32 (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))
          (+ (mem_get m a)
            (* 256
              (+ (mem_get m (+ a 1))
                (* 256
                  (+ (mem_get m (+ (+ a 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                        (* 256
                          (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                            (* 256
                              (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                                (* 256
                                  (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                                    (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))))))))))
      (unfold le32)
      (arith))
    (have hb0 (< (mem_get m a) 256) (exact (mem_get_lt m a)))
    (have hb1 (< (mem_get m (+ a 1)) 256) (exact (mem_get_lt m (+ a 1))))
    (have hb2 (< (mem_get m (+ (+ a 1) 1)) 256) (exact (mem_get_lt m (+ (+ a 1) 1))))
    (have hb3 (< (mem_get m (+ (+ (+ a 1) 1) 1)) 256) (exact (mem_get_lt m (+ (+ (+ a 1) 1) 1))))
    (have hb4 (< (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ a 1) 1) 1) 1))))
    (have hb5 (< (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))))
    (have hb6 (< (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))))
    (have hb7 (< (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))
    (have d1
      (= (/ (mem_le64 m a) 256)
        (+ (mem_get m (+ a 1))
          (* 256
            (+ (mem_get m (+ (+ a 1) 1))
              (* 256
                (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                  (* 256
                    (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                      (* 256
                        (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                          (* 256
                            (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                              (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))))))))))
      (rw hV)
      (exact
        (split_div (mem_get m a)
          (+ (mem_get m (+ a 1))
            (* 256
              (+ (mem_get m (+ (+ a 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                        (* 256
                          (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                            (* 256
                              (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                                (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))))))
          hb0)))
    (have d2
      (= (/ (/ (mem_le64 m a) 256) 256)
        (+ (mem_get m (+ (+ a 1) 1))
          (* 256
            (+ (mem_get m (+ (+ (+ a 1) 1) 1))
              (* 256
                (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                  (* 256
                    (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                      (* 256
                        (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                          (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))))))))
      (rw d1)
      (exact
        (split_div (mem_get m (+ a 1))
          (+ (mem_get m (+ (+ a 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                        (* 256
                          (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                            (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))))
          hb1)))
    (have d3
      (= (/ (/ (/ (mem_le64 m a) 256) 256) 256)
        (+ (mem_get m (+ (+ (+ a 1) 1) 1))
          (* 256
            (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
              (* 256
                (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                  (* 256
                    (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                      (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))))))
      (rw d2)
      (exact
        (split_div (mem_get m (+ (+ a 1) 1))
          (+ (mem_get m (+ (+ (+ a 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                        (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))
          hb2)))
    (have d4
      (= (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256)
        (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
          (* 256
            (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
              (* 256
                (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                  (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))))
      (rw d3)
      (exact
        (split_div (mem_get m (+ (+ (+ a 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                    (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))
          hb3)))
    (have d5
      (= (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256)
        (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
          (* 256
            (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
              (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))))
      (rw d4)
      (exact
        (split_div (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))
          hb4)))
    (have d6
      (= (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256)
        (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
          (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))
      (rw d5)
      (exact
        (split_div (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
            (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))
          hb5)))
    (have d7
      (= (/ (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256) 256)
        (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))
      (rw d6)
      (exact
        (split_div (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
          (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))
          hb6)))
    (have c0 (= (% (mem_le64 m a) 256) (mem_get m a))
      (rw hV)
      (exact
        (split_mod (mem_get m a)
          (+ (mem_get m (+ a 1))
            (* 256
              (+ (mem_get m (+ (+ a 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                        (* 256
                          (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                            (* 256
                              (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                                (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))))))
          hb0)))
    (have c1 (= (% (/ (mem_le64 m a) 256) 256) (mem_get m (+ a 1)))
      (rw d1)
      (exact
        (split_mod (mem_get m (+ a 1))
          (+ (mem_get m (+ (+ a 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ a 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                        (* 256
                          (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                            (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))))
          hb1)))
    (have c2 (= (% (/ (/ (mem_le64 m a) 256) 256) 256) (mem_get m (+ (+ a 1) 1)))
      (rw d2)
      (exact
        (split_mod (mem_get m (+ (+ a 1) 1))
          (+ (mem_get m (+ (+ (+ a 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                    (* 256
                      (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                        (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))))
          hb2)))
    (have c3 (= (% (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) (mem_get m (+ (+ (+ a 1) 1) 1)))
      (rw d3)
      (exact
        (split_mod (mem_get m (+ (+ (+ a 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                (* 256
                  (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                    (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))))
          hb3)))
    (have c4
      (= (% (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256)
        (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1)))
      (rw d4)
      (exact
        (split_mod (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
            (* 256
              (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))))
          hb4)))
    (have c5
      (= (% (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256)
        (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1)))
      (rw d5)
      (exact
        (split_mod (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
          (+ (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
            (* 256 (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))
          hb5)))
    (have c6
      (= (% (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256) 256)
        (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1)))
      (rw d6)
      (exact
        (split_mod (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
          (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))
          hb6)))
    (have c7
      (= (% (/ (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256) 256) 256)
        (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))
      (rw d7)
      (exact (Nat.mod_eq_of_lt hb7)))
    (have e8 (= 8 (+ 7 1)) rfl)
    (rw (mem_bytes_cons m a 8 7 e8))
    (have e7 (= 7 (+ 6 1)) rfl)
    (rw (mem_bytes_cons m (+ a 1) 7 6 e7))
    (have e6 (= 6 (+ 5 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ a 1) 1) 6 5 e6))
    (have e5 (= 5 (+ 4 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ (+ a 1) 1) 1) 5 4 e5))
    (have e4 (= 4 (+ 3 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ (+ (+ a 1) 1) 1) 1) 4 3 e4))
    (have e3 (= 3 (+ 2 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 3 2 e3))
    (have e2 (= 2 (+ 1 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 2 1 e2))
    (have e1 (= 1 (+ 0 1)) rfl)
    (rw (mem_bytes_cons m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1) 1 0 e1))
    (rw (mem_bytes_zero m (+ (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1) 1)))
    (show
      (=
        (cons (mem_get m a)
          (cons (mem_get m (+ a 1))
            (cons (mem_get m (+ (+ a 1) 1))
              (cons (mem_get m (+ (+ (+ a 1) 1) 1))
                (cons (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1))
                  (cons (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
                    (cons (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
                      (cons (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)) nil))))))))
        (cons (% (mem_le64 m a) 256)
          (cons (% (/ (mem_le64 m a) 256) 256)
            (cons (% (/ (/ (mem_le64 m a) 256) 256) 256)
              (cons (% (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256)
                (cons (% (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256)
                  (cons (% (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256)
                    (cons (% (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256) 256)
                      (cons
                        (% (/ (/ (/ (/ (/ (/ (/ (mem_le64 m a) 256) 256) 256) 256) 256) 256) 256)
                          256)
                        nil))))))))))
    (rw c0)
    (rw c1)
    (rw c2)
    (rw c3)
    (rw c4)
    (rw c5)
    (rw c6)
    (rw c7)
    rfl))
;; the number read is below 2^64
(theorem le64_lt ((m Mem) (a Nat)) (< (mem_le64 m a) 18446744073709551616)
  (by
    (have hb0 (< (mem_get m a) 256) (exact (mem_get_lt m a)))
    (have hb1 (< (mem_get m (+ a 1)) 256) (exact (mem_get_lt m (+ a 1))))
    (have hb2 (< (mem_get m (+ (+ a 1) 1)) 256) (exact (mem_get_lt m (+ (+ a 1) 1))))
    (have hb3 (< (mem_get m (+ (+ (+ a 1) 1) 1)) 256) (exact (mem_get_lt m (+ (+ (+ a 1) 1) 1))))
    (have hb4 (< (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ a 1) 1) 1) 1))))
    (have hb5 (< (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))))
    (have hb6 (< (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))))
    (have hb7 (< (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)) 256)
      (exact (mem_get_lt m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1))))
    (show
      (<
        (+
          (le32 (mem_get m a) (mem_get m (+ a 1)) (mem_get m (+ (+ a 1) 1))
            (mem_get m (+ (+ (+ a 1) 1) 1)))
          (* 4294967296
            (le32 (mem_get m (+ (+ (+ (+ a 1) 1) 1) 1)) (mem_get m (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1))
              (mem_get m (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1))
              (mem_get m (+ (+ (+ (+ (+ (+ (+ a 1) 1) 1) 1) 1) 1) 1)))))
        18446744073709551616))
    (unfold le32)
    (arith)))
;; so where the word read at an address is a number's word, the eight bytes there are the
;; number's
(theorem held_bytes
  ((m Mem) (a Nat) (v Nat) (h (= (w64 (mem_le64 m a)) (w64 v))) (hv (< v 18446744073709551616)))
  (= (mem_bytes m a 8) (bytes8 v))
  (by
    (have e (= (mem_le64 m a) v)
      (rw (<- (w64_val_small (mem_le64 m a) (le64_lt m a))))
      (rw h)
      (exact (w64_val_small v hv)))
    (rw (le64_bytes m a))
    (rw e)
    rfl))
