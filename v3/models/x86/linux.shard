;;; v3/models/x86/linux.shard — Linux at the processor's boundary, as far as a consumer has
;;; needed it: how an executable file becomes a process's first state, what stands at its stack
;;; pointer then — its arguments —, what a system call does, and what is outside the process: the
;;; answers the kernel gives its calls and the bytes it has written out. A file the model does
;;; not load, and a system call it has no rule for, are stuck with the reason. A run is the
;;; processor's steps until the process ends, counted by a fuel that no statement about a run
;;; names: `ends` quantifies it away.
(import "../../std/list.shard")
(import "../../std/world.shard")
(import "x86.shard")
(use std.mem)
(use std.world)
(use std.world.How)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use models.x86.x86.Seg)
(use models.x86.x86.Step)
(use models.x86.x86.Why)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- reading a file's bytes -----------------------------------------------------------------
;; the byte at index i, 0 past the end
(fn byte_at ((bs (List Nat)) (i Nat)) Nat
  (measure (struct bs))
  (match bs
    (nil 0)
    ((cons b r) (if (= i 0) b (byte_at r (- i 1))))))
;; a little-endian number of two, four, eight bytes at index i
(fn le16_at ((bs (List Nat)) (i Nat)) Nat (+ (byte_at bs i) (* 256 (byte_at bs (+ i 1)))))
(fn le32_at ((bs (List Nat)) (i Nat)) Nat (+ (le16_at bs i) (* 65536 (le16_at bs (+ i 2)))))
(fn le64_at ((bs (List Nat)) (i Nat)) Nat (+ (le32_at bs i) (* 4294967296 (le32_at bs (+ i 4)))))
;; the first n bytes of bs stored from address a
(fn put_bytes ((m Mem) (a Nat) (bs (List Nat)) (n Nat)) Mem
  (measure (struct bs))
  (match bs
    (nil m)
    ((cons b r) (if (= n 0) m (put_bytes (mem_set m a b) (+ a 1) r (- n 1))))))

;; ---- an executable file ---------------------------------------------------------------------
;; what a file loads to: where it starts, its bytes in memory, what is mapped
(record Image (entry Nat) (mem Mem) (segs (List Seg)))

;; the header of a 64-bit little-endian executable for x86-64, with program headers of 56 bytes:
;; the magic 7F 45 4C 46, class 2, data 1, type 2 (an executable at fixed addresses), machine 62
(fn elf_header_ok ((bs (List Nat))) Bool
  (if (= (le32_at bs 0) 1179403647)
    (if (= (byte_at bs 4) 2)
      (if (= (byte_at bs 5) 1)
        (if (= (le16_at bs 16) 2)
          (if (= (le16_at bs 18) 62) (if (= (le16_at bs 54) 56) true false) false)
          false)
        false)
      false)
    false))
;; a loadable segment the model maps: its bytes inside the file, no more of them than its size
;; in memory, its address and its place in the file alike within a page of 4096, not below the
;; lowest address a process may map, 65536, and ending below the top of a process's addresses,
;; 2^47
(fn segment_ok ((len Nat) (off Nat) (vaddr Nat) (filesz Nat) (memsz Nat)) Bool
  (if (<= (+ off filesz) len)
    (if (<= filesz memsz)
      (if (= (% vaddr 4096) (% off 4096))
        (if (<= 65536 vaddr) (if (<= (+ vaddr memsz) 140737488355328) true false) false)
        false)
      false)
    false))
;; one program header, at index off: a loadable segment (type 1) is copied and mapped with its
;; permissions; any other header is refused
(fn load_ph ((bs (List Nat)) (off Nat) (img Image)) (Option Image)
  (if (= (le32_at bs off) 1)
    (if
      (segment_ok (List.length bs) (le64_at bs (+ off 8)) (le64_at bs (+ off 16))
        (le64_at bs (+ off 32))
        (le64_at bs (+ off 40)))
      (some
        (make Image (entry (Image.entry img))
          (mem
            (put_bytes (Image.mem img) (le64_at bs (+ off 16)) (List.drop (le64_at bs (+ off 8)) bs)
              (le64_at bs (+ off 32))))
          (segs
            (cons
              (MkSeg (le64_at bs (+ off 16)) (+ (le64_at bs (+ off 16)) (le64_at bs (+ off 40)))
                (le32_at bs (+ off 4)))
              (Image.segs img)))))
      none)
    none))
;; k program headers from index off
(fn load_phs ((bs (List Nat)) (off Nat) (k Nat) (img Image)) (Option Image)
  (measure k)
  (if (= k 0) (some img)
  (match (load_ph bs off img)
    (none none)
    ((some img1) (load_phs bs (+ off 56) (- k 1) img1)))))
(fulfills load_phs.dec_1 (by (intro p h img1 hm) (exact (Nat.sub_one_lt h))))
;; a file's image laid over the memory given, where the model loads the file
(fn elf_load ((bs (List Nat)) (m Mem)) (Option Image)
  (if (elf_header_ok bs)
    (load_phs bs (le64_at bs 32) (le16_at bs 56)
      (make Image (entry (le64_at bs 24)) (mem m) (segs nil)))
    none))

;; ---- a process ------------------------------------------------------------------------------
;; what the kernel leaves beside the image when a process starts: the registers, the flags, the
;; stack's range — mapped to read and write — and the memory the image is laid over, which holds
;; the stack's contents. They are a run's input: a statement about a file is for every one
(record Start (regs Regs) (flags Flags) (stack Seg) (mem Mem))
;; a process's first state. The image's ranges stand before the stack's: an access inside the
;; image is then decided without a word about where the stack is
(fn boot ((img Image) (st Start)) Cpu
  (cpu_at (Image.entry img) (Start.regs st) (Start.flags st) (Image.mem img)
    (List.append (Image.segs img) (cons (Start.stack st) nil))))

;; a start with the stack in the range [lo, hi), mapped to read and write, and the stack pointer
;; at sp; the other registers, the flags and the memory as given
(fn start_at ((lo Nat) (sp Nat) (hi Nat) (r Regs) (f Flags) (m Mem)) Start
  (MkStart (reg_set r 4 (w64 sp)) f (MkSeg lo hi 6) m))
;; What the model takes the kernel to promise a file about its stack, and no more: the range
;; begins at or above `top` — a bound the file's theorem states, above its image and the bytes
;; the processor reads past an instruction —; n words stand under the stack pointer; the pointer
;; is inside the range; and the range ends at or below the top of a process's addresses, 2^47.
;; Where the range is, and where in it the pointer stands, a file is not told: a kernel places
;; them anew at each start. Nothing is said of the pointer's alignment. What stands at the
;; pointer and above it is `args_at`'s to say.
(def stack_ok ((lo Nat) (sp Nat) (hi Nat) (top Nat) (n Nat)) Prop
  (and (<= top lo) (and (<= (+ lo (* 8 n)) sp) (and (<= sp hi) (<= hi 140737488355328)))))
;; the start the model's runner makes for a file given no arguments (`run_main.shard`; with
;; arguments it makes `start_args`): eight megabytes under 7FFFFFFFF000, the stack pointer a
;; page under the top. A run of the model is from one of the two; a theorem about a file is for
;; every start `stack_ok` allows.
(fn runner_start ((r Regs) (f Flags) (m Mem)) Start
  (start_at 140737479962624 140737488347136 140737488351232 r f m))

;; ---- what the kernel leaves at the stack pointer ------------------------------------------------
;; a string at the address a: its bytes, none of them 0, and a 0 after them
(def str_at ((m Mem) (a Nat) (bs (List Nat))) Prop
  (measure (struct bs))
  (match bs
    (nil (= (mem_get m a) 0))
    ((cons b r) (and (= (mem_get m a) b) (and (< 0 b) (str_at m (+ a 1) r))))))
;; the arguments' addresses, a word each from the address a: each is the address of its
;; argument's string, which lies — its 0 with it — in [sp, hi)
(def argv_at ((m Mem) (a Nat) (sp Nat) (hi Nat) (args (List (List Nat)))) Prop
  (measure (struct args))
  (match args
    (nil True)
    ((cons s r)
     (and (<= sp (mem_le64 m a))
       (and (< (+ (mem_le64 m a) (List.length s)) hi)
         (and (str_at m (mem_le64 m a) s) (argv_at m (+ a 8) sp hi r)))))))
;; What the model takes the kernel to leave a process at its stack pointer: the count of its
;; arguments, a word; after it a word for each argument, the address of that argument's bytes;
;; and the bytes of each, none of them 0, with a 0 after them. The count, the addresses and the
;; strings lie from the stack pointer up, inside the stack's range. The first argument is by
;; convention the name the program was run by; the model does not say there is one. Nothing is
;; said of the word after the last address, of the environment, or of anything else above.
(def args_at ((m Mem) (sp Nat) (hi Nat) (args (List (List Nat)))) Prop
  (and (= (mem_le64 m sp) (List.length args))
    (and (<= (+ sp (* 8 (+ (List.length args) 1))) hi) (argv_at m (+ sp 8) sp hi args))))

;; ---- what is outside a process -----------------------------------------------------------------
;; How the kernel answers a call that offers it bytes is the platform's `How` (std/world.shard):
;; it took some of them; it failed, with an error's number; or it ended the process there.
;; An answer of the kernel to a call: how the call went and, for a call that returns, what it
;; leaves in rcx and r11, the two registers Linux destroys at every system call.
(record Answer (how How) (rcx (BitVec 64)) (r11 (BitVec 64)))
;; What is outside a process, as far as the model follows it: the answers the kernel will give
;; the process's calls, in order, and the bytes the process has written to descriptor 1, its
;; standard output. The answers are an input of a run, as the arguments are: the model does not
;; say what a kernel answers, and a statement about a file is for every list of answers.
(record Os (ans (List Answer)) (out (List Nat)))
;; a process's start: nothing written
(fn os_start ((as (List Answer))) Os (MkOs as nil))
;; the answer to the next call and the answers after it. When the list is used up the kernel
;; takes everything a call offers: the empty list is a kernel that never takes less and never
;; fails.
(fn next_answer ((as (List Answer))) Answer
  (match as
    (nil (MkAnswer (HTook 0) (w64 0) (w64 0)))
    ((cons a _) a)))
(fn rest_answers ((as (List Answer))) (List Answer)
  (match as
    (nil nil)
    ((cons _ r) r)))
;; what a failed call returns for the answer `(HErr e)`: the negative of an error number from 1
;; to 4095, as a word
(fn err_word ((e Nat)) (BitVec 64) (w64 (- 18446744073709551616 (+ 1 (% e 4095)))))
;; the n bytes from the address a
(fn mem_bytes ((m Mem) (a Nat) (n Nat)) (List Nat)
  (measure n)
  (if (= n 0) nil (cons (mem_get m a) (mem_bytes m (+ a 1) (- n 1)))))
(fulfills mem_bytes.dec_1 (by (intro p h) (exact (Nat.sub_one_lt h))))

;; how a run ends: the process exited with a status, having written these bytes; the kernel
;; ended it at a call, having written these; a step had no rule; the count ran out
(type Res (RExit Nat (List Nat)) (RKill (List Nat)) (RStuck Why) (ROut Cpu))
;; what a step of a run comes to: the process goes on, or the run has ended
(type Move (MGo Cpu Os) (MEnd Res))
;; what a call of a function comes to: it returns — its word, the memory and what is outside
;; as they then are —, or the process ends in it
(type Outcome (ORet (BitVec 64) Mem Os) (OEnd Res))
;; a call's return to the process: its result in rax, rcx and r11 as the answer leaves them, and
;; no flag known
(fn sys_back ((c Cpu) (a Answer) (v (BitVec 64))) Cpu
  (set_flags (set_reg (set_reg (set_reg c 0 v) 1 (Answer.rcx a)) 11 (Answer.r11 a)) flags_none))
;; What a write of the n bytes at the address a comes to, as the kernel's next answer decides:
;; it takes a count of them, from the first — they are then written, and the count returned —;
;; it fails, nothing written; or it ends the process.
(fn write_to ((c Cpu) (o Os) (a Nat) (n Nat)) Move
  (match (Answer.how (next_answer (Os.ans o)))
    ((HTook t)
     (MGo (sys_back c (next_answer (Os.ans o)) (w64 (took t n)))
       (MkOs (rest_answers (Os.ans o)) (List.append (Os.out o) (mem_bytes (Cpu.mem c) a (took t n))))))
    ((HErr e)
     (MGo (sys_back c (next_answer (Os.ans o)) (err_word e))
       (MkOs (rest_answers (Os.ans o)) (Os.out o))))
    (HKill (MEnd (RKill (Os.out o))))))
;; `write`: the count in rdx of bytes at the address in rsi, offered to the descriptor in rdi.
;; The model has a rule for descriptor 1 and for bytes that are all mapped to read.
(fn on_write ((c Cpu) (o Os)) Move
  (if (= (w64_val (reg c 7)) 1)
    (if (mapped (Cpu.segs c) (w64_val (reg c 6)) (w64_val (reg c 2)) 4)
      (write_to c o (w64_val (reg c 6)) (w64_val (reg c 2)))
      (MEnd (RStuck (WLoad (w64_val (reg c 6))))))
    (MEnd (RStuck (WSyscall 1)))))
;; a system call, by the number in rax: 60 (exit) ends the process with the low byte of rdi, the
;; status its parent is given; 1 is `write`
(fn on_syscall ((c Cpu) (o Os)) Move
  (if (= (w64_val (reg c 0)) 60) (MEnd (RExit (% (w64_val (reg c 7)) 256) (Os.out o)))
  (if (= (w64_val (reg c 0)) 1) (on_write c o)
  (MEnd (RStuck (WSyscall (w64_val (reg c 0))))))))
;; one step of a run: the processor's, or a system call's
(fn move ((c Cpu) (o Os)) Move
  (match (step c)
    ((SNext c1) (MGo c1 o))
    ((SSys c1) (on_syscall c1 o))
    ((SStuck y) (MEnd (RStuck y)))))
;; at most n steps
(fn run ((n Fuel) (c Cpu) (o Os)) Res
  (measure (struct n))
  (match n
    (FZ (ROut c))
    ((FS n1)
     (match (move c o)
       ((MGo c1 o1) (run n1 c1 o1))
       ((MEnd r) r)))))
;; a file run from what the kernel leaves, on the answers it will give
(fn run_file ((n Fuel) (bs (List Nat)) (st Start) (as (List Answer))) Res
  (match (elf_load bs (Start.mem st))
    (none (RStuck WFile))
    ((some img) (run n (boot img st) (os_start as)))))

;; the machine's system (docs/COMPILE.md §2): started on a file, with what the kernel leaves and
;; the answers it will give, the process ends so
(def ends ((bs (List Nat)) (st Start) (as (List Answer)) (r Res)) Prop
  (exists ((n Fuel)) (= (run_file n bs st as) r)))
;; a file that writes nothing: whatever the kernel would answer, the process exits with the
;; status
(def exits ((bs (List Nat)) (st Start) (status Nat)) Prop
  (forall ((as (List Answer))) (ends bs st as (RExit status nil))))

;; ---- writing all of some bytes ----------------------------------------------------------------
;; The status a file exits with where the kernel fails a write: the program's loop stops there.
(fn status_io () Nat 74)
;; What a loop that offers bytes until all are taken comes to, as the answers decide it: every
;; byte was taken, and these answers are left; an answer failed, these bytes taken before it; or
;; the kernel ended the process, these taken before.
(type Sent (SAll (List Answer)) (SFail (List Nat)) (SKill (List Nat)))
;; the bytes p taken before what followed
(fn sent_after ((p (List Nat)) (s Sent)) Sent
  (match s
    ((SAll as) (SAll as))
    ((SFail q) (SFail (List.append p q)))
    ((SKill q) (SKill (List.append p q)))))
;; the loop on the bytes bs: nothing is offered where none is left; each call offers all that is
;; left and takes one answer
(fn send ((as (List Answer)) (bs (List Nat))) Sent
  (measure (struct as))
  (match as
    (nil (SAll nil))
    ((cons a ar)
     (match bs
       (nil (SAll as))
       ((cons _ _)
        (match (Answer.how a)
          ((HTook t)
           (sent_after (List.take (took t (List.length bs)) bs)
             (send ar (List.drop (took t (List.length bs)) bs))))
          ((HErr _) (SFail nil))
          (HKill (SKill nil))))))))
;; How a process ends that writes these pieces one after another, each by that loop, and then
;; exits with the status, `before` already written: where every byte of every piece was taken,
;; with the status and all of them written; where a call failed, with `status_io` and what was
;; taken before it; or ended by the kernel, what was taken before written.
(fn sends_end ((as (List Answer)) (before (List Nat)) (pieces (List (List Nat))) (status Nat)) Res
  (measure (struct pieces))
  (match pieces
    (nil (RExit status before))
    ((cons p r)
     (match (send as p)
       ((SAll left) (sends_end left (List.append before p) r status))
       ((SFail q) (RExit status_io (List.append before q)))
       ((SKill q) (RKill (List.append before q)))))))
