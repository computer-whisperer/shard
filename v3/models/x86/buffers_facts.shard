;;; v3/models/x86/buffers_facts.shard — what is proven of the listing of `buffers.shard`: for each
;;; of its three functions a contract of its code — from a state at the function's first
;;; instruction that holds its arguments, the processor comes to a state that holds the
;;; function's value, with what the code has written stated.
(import "buffers.shard")
(import "laws.shard")
(use std.list)
(use std.mem)
(use models.x86.buffers)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Cpu)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- a buffer in memory -----------------------------------------------------------------------
;; the words of a buffer stand in memory from address p, eight bytes each
(def holds ((m Mem) (p Nat) (xs (List (BitVec 64)))) Prop
  (forall ((k Nat)) (-> (< k (List.length xs)) (= (w64 (mem_le64 m (+ p (* 8 k)))) (nth xs k)))))
;; the word an access with evidence gives is the word at that index
(theorem get_nth ((xs (List (BitVec 64))))
  (forall ((k Nat) (h (< k (List.length xs)))) (= (List.get xs (Fin.mk k h)) (nth xs k)))
  (by
    (induction xs
      ((nil () (intro k h) (exact (absurd h (Nat.not_lt_zero k))))
       (cons (x r ih) (intro k h)
         (cases k ((zero () rfl) (succ (j) (exact (ih j (Nat.le_of_succ_le_succ h)))))))))))
(theorem word_at_nth ((xs (List (BitVec 64))) (i (BitVec 64)) (h (< (w64_val i) (List.length xs))))
  (= (word_at xs i h) (nth xs (w64_val i)))
  (exact (get_nth xs (w64_val i) h)))

;; a list with one word replaced: that word at its index, every other as it was
(theorem nth_upd_same ((xs (List (BitVec 64))))
  (forall ((k Nat) (w (BitVec 64))) (-> (< k (List.length xs)) (= (nth (upd xs k w) k) w)))
  (by
    (induction xs
      ((nil () (intro k w hk) (exact (absurd hk (Nat.not_lt_zero k))))
       (cons (x r ih) (intro k w hk)
         (cases (Nat.decEq k 0)
           ((isTrue (h0) (rw upd.eq_2) (rw (if_pos h0)) (rw nth.eq_2) (rw (if_pos h0)) rfl)
            (isFalse (h0) (have hk1 (< k (+ (List.length r) 1)) (exact hk)) (rw upd.eq_2)
              (rw (if_neg h0))
              (rw nth.eq_2)
              (rw (if_neg h0))
              (exact (ih (- k 1) w (get_bound k (List.length r) hk1 h0)))))))))))
(theorem nth_upd_other ((xs (List (BitVec 64))))
  (forall ((k Nat) (w (BitVec 64)) (j Nat)) (-> (Not (= j k)) (= (nth (upd xs k w) j) (nth xs j))))
  (by
    (induction xs
      ((nil () (intro k w j hne) rfl)
       (cons (x r ih) (intro k w j hne)
         (cases (Nat.decEq k 0)
           ((isTrue (hk0)
              (cases (Nat.decEq j 0)
                ((isTrue (hj0) (exact (absurd (Eq.trans hj0 (Eq.symm hk0)) hne)))
                 (isFalse (hj0) (rw upd.eq_2) (rw (if_pos hk0)) (rw nth.eq_2) (rw nth.eq_2)
                   (rw (if_neg hj0))
                   (rw (if_neg hj0))
                   rfl))))
            (isFalse (hk0)
              (cases (Nat.decEq j 0)
                ((isTrue (hj0) (rw upd.eq_2) (rw (if_neg hk0)) (rw nth.eq_2) (rw nth.eq_2)
                   (rw (if_pos hj0))
                   (rw (if_pos hj0))
                   rfl)
                 (isFalse (hj0) (have hj1 (<= 1 j) (exact (Nat.pos_of_ne_zero hj0)))
                   (have hk1 (<= 1 k) (exact (Nat.pos_of_ne_zero hk0)))
                   (have hne1 (Not (= (- j 1) (- k 1)))
                     (intro heq)
                     (apply hne ((arith heq (Nat.sub_add_cancel hj1) (Nat.sub_add_cancel hk1)))))
                   (rw upd.eq_2)
                   (rw (if_neg hk0))
                   (rw nth.eq_2)
                   (rw nth.eq_2)
                   (rw (if_neg hj0))
                   (rw (if_neg hj0))
                   (exact (ih (- k 1) w (- j 1) hne1)))))))))))))
;; a word stored at a buffer's index: the memory then holds the list with that word replaced
(theorem holds_upd
  ((m Mem)
   (p Nat)
   (xs (List (BitVec 64)))
   (k Nat)
   (w (BitVec 64))
   (h (holds m p xs))
   (hk (< k (List.length xs))))
  (holds (mem_put64 m (+ p (* 8 k)) (w64_val w)) p (upd xs k w))
  (by
    (intro j hj)
    (have hj2 (< j (List.length xs)) (rw (<- (upd_length xs k w))) (exact hj))
    (cases (Nat.decEq j k)
      ((isTrue (he) (rw he) (rw (le64_put64_word m (+ p (* 8 k)) w))
         (exact (Eq.symm (nth_upd_same xs k w hk))))
       (isFalse (hne)
         (have hso
           (same_outside m (mem_put64 m (+ p (* 8 k)) (w64_val w)) (+ p (* 8 k)) (+ (+ p (* 8 k)) 8))
           (exact
             (same_outside_put64 m m (+ p (* 8 k)) (+ (+ p (* 8 k)) 8) (+ p (* 8 k)) (w64_val w)
               (same_outside_refl m (+ p (* 8 k)) (+ (+ p (* 8 k)) 8))
               (Nat.le_refl (+ p (* 8 k)))
               (Nat.le_refl (+ (+ p (* 8 k)) 8)))))
         (have hd (or (<= (+ (+ p (* 8 j)) 8) (+ p (* 8 k))) (<= (+ (+ p (* 8 k)) 8) (+ p (* 8 j))))
           (cases (Nat.decLt j k)
             ((isTrue (hl) (apply Or.inl ((arith))))
              (isFalse (hnl)
                (cases (Nat.decLt k j)
                  ((isTrue (hr) (apply Or.inr ((arith))))
                   (isFalse (hnr) (have he (= j k) (arith)) (exact (absurd he hne)))))))))
         (rw
           (le64_same m (mem_put64 m (+ p (* 8 k)) (w64_val w)) (+ p (* 8 k)) (+ (+ p (* 8 k)) 8)
             (+ p (* 8 j))
             hso
             hd))
         (rw (nth_upd_other xs k w j hne))
         (exact (h j hj2)))))))
;; a buffer clear of a range is held by any memory that agrees with the first outside the range
(theorem holds_same
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (q Nat)
   (ys (List (BitVec 64)))
   (h (holds m q ys))
   (hso (same_outside m m2 lo hi))
   (hclear (or (<= (+ q (* 8 (List.length ys))) lo) (<= hi q))))
  (holds m2 q ys)
  (by
    (intro j hj)
    (have hd (or (<= (+ (+ q (* 8 j)) 8) lo) (<= hi (+ q (* 8 j))))
      (cases hclear ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
    (rw (le64_same m m2 lo hi (+ q (* 8 j)) hso hd))
    (exact (h j hj))))

;; ---- the code -----------------------------------------------------------------------------------
;; the three functions' instructions by address, as the listing's file holds them
(fn buffers_table () (List (Prod Nat (Prod Instr Nat)))
  (list
    ;; dot
    (Prod.mk 4194489 (Prod.mk (AluRmR BXor (RmReg 0) 0) 3))
    (Prod.mk 4194492 (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))
    (Prod.mk 4194495 (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))
    (Prod.mk 4194498 (Prod.mk (Jcc 3 21) 6))
    (Prod.mk 4194504 (Prod.mk (MovRRm 8 (RmSib 7 1 8 0)) 4))
    (Prod.mk 4194508 (Prod.mk (ImulRRm 8 (RmSib 6 1 8 0)) 5))
    (Prod.mk 4194513 (Prod.mk (AluRmR BAdd (RmReg 0) 8) 3))
    (Prod.mk 4194516 (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))
    (Prod.mk 4194520 (Prod.mk (Jmp 18446744073709551586) 5))
    (Prod.mk 4194525 (Prod.mk Ret 1))
    ;; addto
    (Prod.mk 4194526 (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))
    (Prod.mk 4194529 (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))
    (Prod.mk 4194532 (Prod.mk (Jcc 3 17) 6))
    (Prod.mk 4194538 (Prod.mk (MovRRm 8 (RmSib 6 1 8 0)) 4))
    (Prod.mk 4194542 (Prod.mk (AluRmR BAdd (RmSib 7 1 8 0) 8) 4))
    (Prod.mk 4194546 (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))
    (Prod.mk 4194550 (Prod.mk (Jmp 18446744073709551590) 5))
    (Prod.mk 4194555 (Prod.mk Ret 1))
    ;; both
    (Prod.mk 4194556 (Prod.mk (Push 3) 1))
    (Prod.mk 4194557 (Prod.mk (Push 12) 2))
    (Prod.mk 4194559 (Prod.mk (MovRmR (RmReg 3) 7) 3))
    (Prod.mk 4194562 (Prod.mk (MovRmR (RmReg 12) 2) 3))
    (Prod.mk 4194565 (Prod.mk (Call 18446744073709551572) 5))
    (Prod.mk 4194570 (Prod.mk (MovRmR (RmReg 7) 3) 3))
    (Prod.mk 4194573 (Prod.mk (MovRmR (RmReg 6) 3) 3))
    (Prod.mk 4194576 (Prod.mk (MovRmR (RmReg 2) 12) 3))
    (Prod.mk 4194579 (Prod.mk (Call 18446744073709551521) 5))
    (Prod.mk 4194584 (Prod.mk (Pop 12) 2))
    (Prod.mk 4194586 (Prod.mk (Pop 3) 1))
    (Prod.mk 4194587 (Prod.mk Ret 1))))

;; ---- dot: the states its code passes through ----------------------------------------------------
;; one turn of the loop from its head, the index below the count: after the comparison, the jump
;; not taken, the load, the product, the sum, the index's increment; the jump back then leaves
;; the last of them at the loop's head
(fn dot_s1 ((c Cpu)) Cpu (x_cmp_rr (at_pc c (w64 4194495)) 1 2 (w64 4194498)))
(fn dot_s2 ((c Cpu)) Cpu (at_pc (dot_s1 c) (w64 4194504)))
(fn dot_s3 ((c Cpu)) Cpu (x_load_sib (dot_s2 c) 8 7 1 8 0 (w64 4194508)))
(fn dot_s4 ((c Cpu)) Cpu (x_imul_sib (dot_s3 c) 8 6 1 8 0 (w64 4194513)))
(fn dot_s5 ((c Cpu)) Cpu (x_alu_rr (dot_s4 c) BAdd 0 8 (w64 4194516)))
(fn dot_s6 ((c Cpu)) Cpu (x_alu_ri (dot_s5 c) BAdd 1 1 (w64 4194520)))
;; from the loop's head with the index not below the count: the jump taken, the return
(fn dot_out ((c Cpu)) Cpu (x_ret (at_pc (dot_s1 c) (w64 4194525))))
;; from the function's first instruction to the loop's head
(fn dot_in ((c Cpu)) Cpu
  (x_alu_rr (x_alu_rr (at_pc c (w64 4194489)) BXor 0 0 (w64 4194492)) BXor 1 1 (w64 4194495)))

;; one turn of the loop
(theorem dot_turn
  ((c Cpu)
   (hcode (code_in c buffers_table))
   (h (< (w64_val (reg c 1)) (w64_val (reg c 2))))
   (hmx (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 4) true))
   (hmy (= (mapped (Cpu.segs c) (ea_sib c 6 1 8 0) 8 4) true)))
  (reaches (at_pc c (w64 4194495)) (at_pc (dot_s6 c) (w64 4194495)))
  (by
    (have h1 (< (w64_val (reg (at_pc c (w64 4194495)) 1)) (w64_val (reg (at_pc c (w64 4194495)) 2)))
      (exact h))
    (apply (do_cmp_rr 4194495 1 2 3 4194498) (rfl)
      ((exact
         (hcode 4194495 (AluRmR BCmp (RmReg 1) 2) 3
           (Eq.refl (some (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))))))
      (rfl)
      ((apply (do_jcc_not 4194498 3 21 6 4194504) (rfl)
         ((exact (hcode 4194498 (Jcc 3 21) 6 (Eq.refl (some (Prod.mk (Jcc 3 21) 6))))))
         ((exact (cmp_below (at_pc c (w64 4194495)) 1 2 (w64 4194498) h1)))
         (rfl)
         ((apply (do_load_sib 4194504 8 7 1 8 0 4 4194508) (rfl)
            ((exact
               (hcode 4194504 (MovRRm 8 (RmSib 7 1 8 0)) 4
                 (Eq.refl (some (Prod.mk (MovRRm 8 (RmSib 7 1 8 0)) 4))))))
            ((exact hmx))
            (rfl)
            ((apply (do_imul_sib 4194508 8 6 1 8 0 5 4194513) (rfl)
               ((exact
                  (hcode 4194508 (ImulRRm 8 (RmSib 6 1 8 0)) 5
                    (Eq.refl (some (Prod.mk (ImulRRm 8 (RmSib 6 1 8 0)) 5))))))
               ((exact hmy))
               (rfl)
               ((apply (do_alu_rr 4194513 BAdd 0 8 3 4194516) (rfl)
                  ((exact
                     (hcode 4194513 (AluRmR BAdd (RmReg 0) 8) 3
                       (Eq.refl (some (Prod.mk (AluRmR BAdd (RmReg 0) 8) 3))))))
                  (rfl)
                  (rfl)
                  ((apply (do_alu_ri 4194516 BAdd 1 1 4 4194520) (rfl)
                     ((exact
                        (hcode 4194516 (AluRmI BAdd (RmReg 1) 1) 4
                          (Eq.refl (some (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))))))
                     (rfl)
                     (rfl)
                     ((apply (do_jmp 4194520 5 18446744073709551586 4194495) (rfl)
                        ((exact
                           (hcode 4194520 (Jmp 18446744073709551586) 5
                             (Eq.refl (some (Prod.mk (Jmp 18446744073709551586) 5))))))
                        (rfl)
                        ((exact (reaches_refl (at_pc (dot_s6 c) (w64 4194495))))))))))))))))))))
;; out of the loop: the index not below the count
(theorem dot_leave
  ((c Cpu)
   (hcode (code_in c buffers_table))
   (h (Not (< (w64_val (reg c 1)) (w64_val (reg c 2)))))
   (hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)))
  (reaches (at_pc c (w64 4194495)) (dot_out c))
  (by
    (have h1
      (Not (< (w64_val (reg (at_pc c (w64 4194495)) 1)) (w64_val (reg (at_pc c (w64 4194495)) 2))))
      (exact h))
    (apply (do_cmp_rr 4194495 1 2 3 4194498) (rfl)
      ((exact
         (hcode 4194495 (AluRmR BCmp (RmReg 1) 2) 3
           (Eq.refl (some (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))))))
      (rfl)
      ((apply (do_jcc_taken 4194498 3 6 21 4194525) (rfl)
         ((exact (hcode 4194498 (Jcc 3 21) 6 (Eq.refl (some (Prod.mk (Jcc 3 21) 6))))))
         ((exact (cmp_not_below (at_pc c (w64 4194495)) 1 2 (w64 4194498) h1)))
         (rfl)
         ((apply (do_ret 4194525 1) (rfl)
            ((exact (hcode 4194525 Ret 1 (Eq.refl (some (Prod.mk Ret 1))))))
            ((exact hsp))
            ((exact (reaches_refl (dot_out c)))))))))))
;; into the loop
(theorem dot_enter ((c Cpu) (hcode (code_in c buffers_table)))
  (reaches (at_pc c (w64 4194489)) (dot_in c))
  (by
    (apply (do_alu_rr 4194489 BXor 0 0 3 4194492) (rfl)
      ((exact
         (hcode 4194489 (AluRmR BXor (RmReg 0) 0) 3
           (Eq.refl (some (Prod.mk (AluRmR BXor (RmReg 0) 0) 3))))))
      (rfl)
      (rfl)
      ((apply (do_alu_rr 4194492 BXor 1 1 3 4194495) (rfl)
         ((exact
            (hcode 4194492 (AluRmR BXor (RmReg 1) 1) 3
              (Eq.refl (some (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))))))
         (rfl)
         (rfl)
         ((exact (reaches_refl (dot_in c)))))))))

;; ---- dot: the loop, and the contract ------------------------------------------------------------
;; the function's own two cases
(theorem dot_go_turn
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (= (dot_go xs ys n rx ry i acc)
    (dot_go xs ys n rx ry (w64_add i (w64 1))
      (w64_add acc
        (w64_mul (word_at xs i (Nat.lt_of_lt_of_le h rx)) (word_at ys i (Nat.lt_of_lt_of_le h ry))))))
  (by (rw dot_go.eq_1 (occ 1)) (rw (dif_pos h)) rfl))
(theorem dot_go_done
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (Not (< (w64_val i) (w64_val n)))))
  (= (dot_go xs ys n rx ry i acc) acc)
  (by (rw dot_go.eq_1) (rw (dif_neg h)) rfl))
(theorem dot_out_returned ((c Cpu)) (returned c (dot_out c))
  (by
    (unfold returned)
    (unfold kept)
    (apply And.intro (rfl)
      ((apply And.intro (rfl)
         ((apply And.intro (rfl)
            ((apply And.intro (rfl)
               ((apply And.intro (rfl)
                  ((apply And.intro (rfl) ((apply And.intro (rfl) ((apply And.intro (rfl) (rfl))))))))))))))))))
;; From the loop's head, in a state whose registers hold the two buffers' addresses, the count,
;; an index and a sum: the processor comes to the function's return with `dot_go` of that index
;; and sum in rax, and memory as it was.
(theorem dot_loop
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu))
  (-> (code_in c buffers_table) (= (reg c 2) n) (holds (Cpu.mem c) (w64_val (reg c 7)) xs)
    (holds (Cpu.mem c) (w64_val (reg c 6)) ys)
    (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4)
    (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4)
    (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616)
    (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616)
    (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)
    (exists ((c2 Cpu))
      (and (reaches (at_pc c (w64 4194495)) c2)
        (and (= (reg c2 0) (dot_go xs ys n rx ry (reg c 1) (reg c 0)))
          (and (= (Cpu.mem c2) (Cpu.mem c)) (returned c c2))))))
  (by
    (wf c (- (w64_val n) (w64_val (reg c 1))) ih (intro hcode hn hx hy hmx hmy hwx hwy hsp)
      (cases (Nat.decLt (w64_val (reg c 1)) (w64_val n))
        ((isFalse (h) (have h2 (Not (< (w64_val (reg c 1)) (w64_val (reg c 2)))) (rw hn) (exact h))
           (apply (Exists.intro (dot_out c))
             ((apply And.intro ((exact (dot_leave c hcode h2 hsp)))
                ((apply And.intro ((rw (dot_go_done xs ys n rx ry (reg c 1) (reg c 0) h)) rfl)
                   ((apply And.intro (rfl) ((exact (dot_out_returned c)))))))))))
         (isTrue (h) (have h2 (< (w64_val (reg c 1)) (w64_val (reg c 2))) (rw hn) (exact h))
           (have hkx (< (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 18446744073709551616)
             (arith))
           (have hky (< (+ (w64_val (reg c 6)) (* 8 (w64_val (reg c 1)))) 18446744073709551616)
             (arith))
           (have hmx1 (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 4) true)
             (rw (ea_sib_8 c 7 1 hkx))
             (exact (hmx (w64_val (reg c 1)) h)))
           (have hmy1 (= (mapped (Cpu.segs c) (ea_sib c 6 1 8 0) 8 4) true)
             (rw (ea_sib_8 c 6 1 hky))
             (exact (hmy (w64_val (reg c 1)) h)))
           (have ex
             (= (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
               (w64 (mem_le64 (Cpu.mem c) (ea_sib c 7 1 8 0))))
             (rw (word_at_nth xs (reg c 1) (Nat.lt_of_lt_of_le h rx)))
             (rw (ea_sib_8 c 7 1 hkx))
             (exact (Eq.symm (hx (w64_val (reg c 1)) (Nat.lt_of_lt_of_le h rx)))))
           (have ey
             (= (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry))
               (w64 (mem_le64 (Cpu.mem c) (ea_sib c 6 1 8 0))))
             (rw (word_at_nth ys (reg c 1) (Nat.lt_of_lt_of_le h ry)))
             (rw (ea_sib_8 c 6 1 hky))
             (exact (Eq.symm (hy (w64_val (reg c 1)) (Nat.lt_of_lt_of_le h ry)))))
           ;; the hypotheses, of the state the turn ends in
           (have hdec
             (< (- (w64_val n) (w64_val (reg (dot_s6 c) 1))) (- (w64_val n) (w64_val (reg c 1))))
             (exact (loop_descends n (reg c 1) h)))
           (have hcode1 (code_in (dot_s6 c) buffers_table) (exact hcode))
           (have hn1 (= (reg (dot_s6 c) 2) n) (exact hn))
           (have hx1 (holds (Cpu.mem (dot_s6 c)) (w64_val (reg (dot_s6 c) 7)) xs) (exact hx))
           (have hy1 (holds (Cpu.mem (dot_s6 c)) (w64_val (reg (dot_s6 c) 6)) ys) (exact hy))
           (have hmx2
             (mapped_words (Cpu.segs (dot_s6 c)) (w64_val (reg (dot_s6 c) 7)) (w64_val n) 4)
             (exact hmx))
           (have hmy2
             (mapped_words (Cpu.segs (dot_s6 c)) (w64_val (reg (dot_s6 c) 6)) (w64_val n) 4)
             (exact hmy))
           (have hwx1 (<= (+ (w64_val (reg (dot_s6 c) 7)) (* 8 (w64_val n))) 18446744073709551616)
             (exact hwx))
           (have hwy1 (<= (+ (w64_val (reg (dot_s6 c) 6)) (* 8 (w64_val n))) 18446744073709551616)
             (exact hwy))
           (have hsp1 (= (mapped (Cpu.segs (dot_s6 c)) (w64_val (reg (dot_s6 c) 4)) 8 4) true)
             (exact hsp))
           (cases (ih (dot_s6 c) hdec hcode1 hn1 hx1 hy1 hmx2 hmy2 hwx1 hwy1 hsp1)
             ((intro (c2 hc2)
                (cases hc2
                  ((intro (hreach hrest)
                     (apply (Exists.intro c2)
                       ((apply And.intro
                          ((exact
                             (reaches_trans (at_pc c (w64 4194495)) (at_pc (dot_s6 c) (w64 4194495))
                               c2
                               (dot_turn c hcode h2 hmx1 hmy1)
                               hreach)))
                          ((rw (dot_go_turn xs ys n rx ry (reg c 1) (reg c 0) h))
                           (rw ex)
                           (rw ey)
                           (exact hrest)))))))))))))))))
;; the state the entry ends in is at the loop's head, its index and its sum zero
(theorem dot_in_head ((c Cpu)) (= (at_pc (dot_in c) (w64 4194495)) (dot_in c))
  (by (unfold dot_in) (unfold x_alu_rr) (rw at_pc_twice) rfl))
(theorem dot_in_zero
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu))
  (= (dot_go xs ys n rx ry (reg (dot_in c) 1) (reg (dot_in c) 0)) (dot xs ys n rx ry))
  (by
    (show
      (= (dot_go xs ys n rx ry (w64_xor (reg c 1) (reg c 1)) (w64_xor (reg c 0) (reg c 0)))
        (dot xs ys n rx ry)))
    (rw (w64_xor_self (reg c 1)))
    (rw (w64_xor_self (reg c 0)))
    rfl))
;; The contract of `dot`'s code. From a state at its first instruction whose rdi and rsi hold the
;; addresses of two buffers, each mapped to read for the count in rdx and holding the lists of
;; t, with the return address readable at the stack pointer: the processor comes to a state at
;; that return address with `dot t` in rax, the stack pointer above the address, the callee's
;; registers kept — and memory as it was: the code writes nothing.
(theorem dot_contract
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu)
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hx (holds (Cpu.mem c) (w64_val (reg c 7)) xs))
   (hy (holds (Cpu.mem c) (w64_val (reg c 6)) ys))
   (hmx (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616))
   (hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)))
  (exists ((c2 Cpu))
    (and (reaches (at_pc c (w64 4194489)) c2)
      (and (= (reg c2 0) (dot xs ys n rx ry)) (and (= (Cpu.mem c2) (Cpu.mem c)) (returned c c2)))))
  (by
    (have hcode1 (code_in (dot_in c) buffers_table) (exact hcode))
    (have hn1 (= (reg (dot_in c) 2) n) (exact hn))
    (have hx1 (holds (Cpu.mem (dot_in c)) (w64_val (reg (dot_in c) 7)) xs) (exact hx))
    (have hy1 (holds (Cpu.mem (dot_in c)) (w64_val (reg (dot_in c) 6)) ys) (exact hy))
    (have hmx1 (mapped_words (Cpu.segs (dot_in c)) (w64_val (reg (dot_in c) 7)) (w64_val n) 4)
      (exact hmx))
    (have hmy1 (mapped_words (Cpu.segs (dot_in c)) (w64_val (reg (dot_in c) 6)) (w64_val n) 4)
      (exact hmy))
    (have hwx1 (<= (+ (w64_val (reg (dot_in c) 7)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwx))
    (have hwy1 (<= (+ (w64_val (reg (dot_in c) 6)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwy))
    (have hsp1 (= (mapped (Cpu.segs (dot_in c)) (w64_val (reg (dot_in c) 4)) 8 4) true) (exact hsp))
    (cases (dot_loop xs ys n rx ry (dot_in c) hcode1 hn1 hx1 hy1 hmx1 hmy1 hwx1 hwy1 hsp1)
      ((intro (c2 hc2)
         (cases hc2
           ((intro (hreach hrest)
              (have hreach1 (reaches (dot_in c) c2) (rw (<- (dot_in_head c))) (exact hreach))
              (apply (Exists.intro c2)
                ((apply And.intro
                   ((exact
                      (reaches_trans (at_pc c (w64 4194489)) (dot_in c) c2 (dot_enter c hcode)
                        hreach1)))
                   ((rw (<- (dot_in_zero xs ys n rx ry c))) (exact hrest)))))))))))))

;; The same buffer as both operands (`dot a a`): the contract asks nothing of where the two
;; buffers stand, so one buffer's hypotheses serve for both.
(theorem dot_contract_same
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (hreg (= (reg c 6) (reg c 7)))
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hx (holds (Cpu.mem c) (w64_val (reg c 7)) xs))
   (hmx (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)))
  (exists ((c2 Cpu))
    (and (reaches (at_pc c (w64 4194489)) c2)
      (and (= (reg c2 0) (dot xs xs n rx rx)) (and (= (Cpu.mem c2) (Cpu.mem c)) (returned c c2)))))
  (by
    (have hy (holds (Cpu.mem c) (w64_val (reg c 6)) xs) (rw hreg) (exact hx))
    (have hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4) (rw hreg) (exact hmx))
    (have hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616)
      (rw hreg)
      (exact hwx))
    (exact (dot_contract xs xs n rx rx c hcode hn hx hy hmx hmy hwx hwy hsp))))

;; ---- addto: the states its code passes through --------------------------------------------------
;; one turn of the loop from its head, the index below the count: after the comparison, the jump
;; not taken, the load of the second buffer's word, the sum written into the first buffer, the
;; index's increment
(fn add_s1 ((c Cpu)) Cpu (x_cmp_rr (at_pc c (w64 4194529)) 1 2 (w64 4194532)))
(fn add_s2 ((c Cpu)) Cpu (at_pc (add_s1 c) (w64 4194538)))
(fn add_s3 ((c Cpu)) Cpu (x_load_sib (add_s2 c) 8 6 1 8 0 (w64 4194542)))
(fn add_s4 ((c Cpu)) Cpu (x_add_m_sib (add_s3 c) 7 1 8 0 8 (w64 4194546)))
(fn add_s5 ((c Cpu)) Cpu (x_alu_ri (add_s4 c) BAdd 1 1 (w64 4194550)))
(fn add_out ((c Cpu)) Cpu (x_ret (at_pc (add_s1 c) (w64 4194555))))
(fn add_in ((c Cpu)) Cpu (x_alu_rr (at_pc c (w64 4194526)) BXor 1 1 (w64 4194529)))
;; the memory after a turn: one word written, the sum of the two words read
(fn add_mem ((c Cpu)) Mem
  (mem_put64 (Cpu.mem c) (ea_sib c 7 1 8 0)
    (w64_val
      (w64_add (w64 (mem_le64 (Cpu.mem c) (ea_sib c 7 1 8 0)))
        (w64 (mem_le64 (Cpu.mem c) (ea_sib c 6 1 8 0)))))))
(theorem add_s5_mem ((c Cpu)) (= (Cpu.mem (add_s5 c)) (add_mem c)) (by rfl))
;; every address of the table lies in the code's range
(theorem table_within () (= (all_within buffers_table 4194489 4194588) true) (by rfl))

;; one turn of the loop; the code is in place before the store and after it
(theorem add_turn
  ((c Cpu)
   (hcode (code_in c buffers_table))
   (hcode4 (code_in (add_s4 c) buffers_table))
   (h (< (w64_val (reg c 1)) (w64_val (reg c 2))))
   (hmy (= (mapped (Cpu.segs c) (ea_sib c 6 1 8 0) 8 4) true))
   (hmx (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 4) true))
   (hmw (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 2) true)))
  (reaches (at_pc c (w64 4194529)) (at_pc (add_s5 c) (w64 4194529)))
  (by
    (have h1 (< (w64_val (reg (at_pc c (w64 4194529)) 1)) (w64_val (reg (at_pc c (w64 4194529)) 2)))
      (exact h))
    (apply (do_cmp_rr 4194529 1 2 3 4194532) (rfl)
      ((exact
         (hcode 4194529 (AluRmR BCmp (RmReg 1) 2) 3
           (Eq.refl (some (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))))))
      (rfl)
      ((apply (do_jcc_not 4194532 3 17 6 4194538) (rfl)
         ((exact (hcode 4194532 (Jcc 3 17) 6 (Eq.refl (some (Prod.mk (Jcc 3 17) 6))))))
         ((exact (cmp_below (at_pc c (w64 4194529)) 1 2 (w64 4194532) h1)))
         (rfl)
         ((apply (do_load_sib 4194538 8 6 1 8 0 4 4194542) (rfl)
            ((exact
               (hcode 4194538 (MovRRm 8 (RmSib 6 1 8 0)) 4
                 (Eq.refl (some (Prod.mk (MovRRm 8 (RmSib 6 1 8 0)) 4))))))
            ((exact hmy))
            (rfl)
            ((apply (do_add_m_sib 4194542 7 1 8 0 8 4 4194546) (rfl)
               ((exact
                  (hcode 4194542 (AluRmR BAdd (RmSib 7 1 8 0) 8) 4
                    (Eq.refl (some (Prod.mk (AluRmR BAdd (RmSib 7 1 8 0) 8) 4))))))
               ((exact hmx))
               ((exact hmw))
               (rfl)
               ((apply (do_alu_ri 4194546 BAdd 1 1 4 4194550) (rfl)
                  ((exact
                     (hcode4 4194546 (AluRmI BAdd (RmReg 1) 1) 4
                       (Eq.refl (some (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))))))
                  (rfl)
                  (rfl)
                  ((apply (do_jmp 4194550 5 18446744073709551590 4194529) (rfl)
                     ((exact
                        (hcode4 4194550 (Jmp 18446744073709551590) 5
                          (Eq.refl (some (Prod.mk (Jmp 18446744073709551590) 5))))))
                     (rfl)
                     ((exact (reaches_refl (at_pc (add_s5 c) (w64 4194529))))))))))))))))))
;; out of the loop
(theorem add_leave
  ((c Cpu)
   (hcode (code_in c buffers_table))
   (h (Not (< (w64_val (reg c 1)) (w64_val (reg c 2)))))
   (hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)))
  (reaches (at_pc c (w64 4194529)) (add_out c))
  (by
    (have h1
      (Not (< (w64_val (reg (at_pc c (w64 4194529)) 1)) (w64_val (reg (at_pc c (w64 4194529)) 2))))
      (exact h))
    (apply (do_cmp_rr 4194529 1 2 3 4194532) (rfl)
      ((exact
         (hcode 4194529 (AluRmR BCmp (RmReg 1) 2) 3
           (Eq.refl (some (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))))))
      (rfl)
      ((apply (do_jcc_taken 4194532 3 6 17 4194555) (rfl)
         ((exact (hcode 4194532 (Jcc 3 17) 6 (Eq.refl (some (Prod.mk (Jcc 3 17) 6))))))
         ((exact (cmp_not_below (at_pc c (w64 4194529)) 1 2 (w64 4194532) h1)))
         (rfl)
         ((apply (do_ret 4194555 1) (rfl)
            ((exact (hcode 4194555 Ret 1 (Eq.refl (some (Prod.mk Ret 1))))))
            ((exact hsp))
            ((exact (reaches_refl (add_out c)))))))))))
;; into the loop
(theorem add_enter ((c Cpu) (hcode (code_in c buffers_table)))
  (reaches (at_pc c (w64 4194526)) (add_in c))
  (by
    (apply (do_alu_rr 4194526 BXor 1 1 3 4194529) (rfl)
      ((exact
         (hcode 4194526 (AluRmR BXor (RmReg 1) 1) 3
           (Eq.refl (some (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))))))
      (rfl)
      (rfl)
      ((exact (reaches_refl (add_in c)))))))
(theorem add_out_returned ((c Cpu)) (returned c (add_out c))
  (by
    (unfold returned)
    (unfold kept)
    (apply And.intro (rfl)
      ((apply And.intro (rfl)
         ((apply And.intro (rfl)
            ((apply And.intro (rfl)
               ((apply And.intro (rfl)
                  ((apply And.intro (rfl) ((apply And.intro (rfl) ((apply And.intro (rfl) (rfl))))))))))))))))))
;; ---- addto: the loop, and the contract ----------------------------------------------------------
;; From the loop's head, in a state whose registers hold the two buffers' addresses, the count
;; and an index, where what the loop will write is clear of the code, of the second buffer and
;; of the return address: the processor comes to the function's return with the first buffer's
;; memory holding `addto_go` of that index, and memory outside the first buffer's counted words
;; as it was.
(theorem add_loop
  ((ys (List (BitVec 64))) (n (BitVec 64)) (ry (<= (w64_val n) (List.length ys))) (c Cpu))
  (forall ((xs (List (BitVec 64))) (rx (<= (w64_val n) (List.length xs))))
    (-> (code_in c buffers_table) (= (reg c 2) n) (holds (Cpu.mem c) (w64_val (reg c 7)) xs)
      (holds (Cpu.mem c) (w64_val (reg c 6)) ys)
      (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4)
      (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 2)
      (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4)
      (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616)
      (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616)
      (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true)
      (or (<= 4194603 (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489))
      (or (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 6)))
        (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) (w64_val (reg c 7))))
      (or (<= (+ (w64_val (reg c 4)) 8) (w64_val (reg c 7)))
        (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 4))))
      (exists ((c2 Cpu))
        (and (reaches (at_pc c (w64 4194529)) c2)
          (and (holds (Cpu.mem c2) (w64_val (reg c 7)) (addto_go xs ys n rx ry (reg c 1)))
            (and
              (same_outside (Cpu.mem c) (Cpu.mem c2) (w64_val (reg c 7))
                (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
              (returned c c2)))))))
  (by
    (wf c (- (w64_val (reg c 2)) (w64_val (reg c 1))) ih
      (intro xs rx hcode hn hx hy hmxr hmxw hmy hwx hwy hsp dcode dy dsp)
      (cases (Nat.decLt (w64_val (reg c 1)) (w64_val n))
        ((isFalse (h) (have h2 (Not (< (w64_val (reg c 1)) (w64_val (reg c 2)))) (rw hn) (exact h))
           (apply (Exists.intro (add_out c))
             ((apply And.intro ((exact (add_leave c hcode h2 hsp)))
                ((apply And.intro ((rw (addto_go_done xs ys n rx ry (reg c 1) h)) (exact hx))
                   ((apply And.intro
                      ((exact
                         (same_outside_refl (Cpu.mem c) (w64_val (reg c 7))
                           (+ (w64_val (reg c 7)) (* 8 (w64_val n))))))
                      ((exact (add_out_returned c)))))))))))
         (isTrue (h) (have h2 (< (w64_val (reg c 1)) (w64_val (reg c 2))) (rw hn) (exact h))
           (have hkx (< (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 18446744073709551616)
             (arith))
           (have hky (< (+ (w64_val (reg c 6)) (* 8 (w64_val (reg c 1)))) 18446744073709551616)
             (arith))
           (have ex7 (= (ea_sib c 7 1 8 0) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
             (exact (ea_sib_8 c 7 1 hkx)))
           (have ex6 (= (ea_sib c 6 1 8 0) (+ (w64_val (reg c 6)) (* 8 (w64_val (reg c 1)))))
             (exact (ea_sib_8 c 6 1 hky)))
           (have hmy1 (= (mapped (Cpu.segs c) (ea_sib c 6 1 8 0) 8 4) true)
             (rw ex6)
             (exact (hmy (w64_val (reg c 1)) h)))
           (have hmx1 (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 4) true)
             (rw ex7)
             (exact (hmxr (w64_val (reg c 1)) h)))
           (have hmw1 (= (mapped (Cpu.segs c) (ea_sib c 7 1 8 0) 8 2) true)
             (rw ex7)
             (exact (hmxw (w64_val (reg c 1)) h)))
           ;; the two words read are the buffers' at the index
           (have ex
             (= (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
               (w64 (mem_le64 (Cpu.mem c) (ea_sib c 7 1 8 0))))
             (rw (word_at_nth xs (reg c 1) (Nat.lt_of_lt_of_le h rx)))
             (rw ex7)
             (exact (Eq.symm (hx (w64_val (reg c 1)) (Nat.lt_of_lt_of_le h rx)))))
           (have ey
             (= (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry))
               (w64 (mem_le64 (Cpu.mem c) (ea_sib c 6 1 8 0))))
             (rw (word_at_nth ys (reg c 1) (Nat.lt_of_lt_of_le h ry)))
             (rw ex6)
             (exact (Eq.symm (hy (w64_val (reg c 1)) (Nat.lt_of_lt_of_le h ry)))))
           ;; the memory after the turn is the memory before with the sum stored at the index
           (have hmem
             (= (add_mem c)
               (mem_put64 (Cpu.mem c) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (w64_val
                   (w64_add (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
                     (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry))))))
             (rw ex)
             (rw ey)
             (rw (<- ex7))
             rfl)
           (have hso
             (same_outside (Cpu.mem c) (add_mem c) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
               (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8))
             (rw hmem)
             (exact
               (same_outside_put64 (Cpu.mem c) (Cpu.mem c)
                 (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
                 (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (w64_val
                   (w64_add (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
                     (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry))))
                 (same_outside_refl (Cpu.mem c) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                   (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8))
                 (Nat.le_refl (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
                 (Nat.le_refl (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)))))
           (have hx4
             (holds (add_mem c) (w64_val (reg c 7))
               (upd xs (w64_val (reg c 1))
                 (w64_add (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
                   (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry)))))
             (rw hmem)
             (exact
               (holds_upd (Cpu.mem c) (w64_val (reg c 7)) xs (w64_val (reg c 1))
                 (w64_add (word_at xs (reg c 1) (Nat.lt_of_lt_of_le h rx))
                   (word_at ys (reg c 1) (Nat.lt_of_lt_of_le h ry)))
                 hx
                 (Nat.lt_of_lt_of_le h rx))))
           (have cy
             (or
               (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys)))
                 (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
               (<= (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8) (w64_val (reg c 6))))
             (cases dy ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((arith)))))))
           (have hy4 (holds (add_mem c) (w64_val (reg c 6)) ys)
             (exact
               (holds_same (Cpu.mem c) (add_mem c) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
                 (w64_val (reg c 6))
                 ys
                 hy
                 hso
                 cy)))
           (have ccode
             (or (<= (+ 4194588 15) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
               (<= (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8) 4194489))
             (cases dcode ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
           (have hcode4 (code_in (add_s4 c) buffers_table)
             (exact
               (code_in_same c (add_mem c) buffers_table 4194489 4194588
                 (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
                 table_within
                 hso
                 ccode
                 hcode)))
           (have csp
             (or (<= (+ (w64_val (reg c 4)) 8) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
               (<= (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8) (w64_val (reg c 4))))
             (cases dsp ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
           (have hra (= (ret_addr (add_s5 c)) (ret_addr c))
             (show
               (= (w64 (mem_le64 (Cpu.mem (add_s5 c)) (w64_val (reg c 4))))
                 (w64 (mem_le64 (Cpu.mem c) (w64_val (reg c 4))))))
             (rw (add_s5_mem c))
             (rw
               (le64_same (Cpu.mem c) (add_mem c) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
                 (w64_val (reg c 4))
                 hso
                 csp))
             rfl)
           (have hlo (<= (w64_val (reg c 7)) (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))))
             (arith))
           (have hhi
             (<= (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
               (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
             (arith))
           (have hso1
             (same_outside (Cpu.mem c) (add_mem c) (w64_val (reg c 7))
               (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
             (exact
               (same_outside_widen (Cpu.mem c) (add_mem c)
                 (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1))))
                 (+ (+ (w64_val (reg c 7)) (* 8 (w64_val (reg c 1)))) 8)
                 (w64_val (reg c 7))
                 (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
                 hso
                 hlo
                 hhi)))
           ;; the hypotheses, of the state the turn ends in and of the first buffer after one word
           (have hdec
             (< (- (w64_val (reg (add_s5 c) 2)) (w64_val (reg (add_s5 c) 1)))
               (- (w64_val (reg c 2)) (w64_val (reg c 1))))
             (exact (loop_descends (reg c 2) (reg c 1) h2)))
           (have hcode5 (code_in (add_s5 c) buffers_table) (exact hcode4))
           (have hn5 (= (reg (add_s5 c) 2) n) (exact hn))
           (have hx5
             (holds (Cpu.mem (add_s5 c)) (w64_val (reg (add_s5 c) 7))
               (addto_next xs ys n rx ry (reg c 1) h))
             (exact hx4))
           (have hy5 (holds (Cpu.mem (add_s5 c)) (w64_val (reg (add_s5 c) 6)) ys) (exact hy4))
           (have hmxr5
             (mapped_words (Cpu.segs (add_s5 c)) (w64_val (reg (add_s5 c) 7)) (w64_val n) 4)
             (exact hmxr))
           (have hmxw5
             (mapped_words (Cpu.segs (add_s5 c)) (w64_val (reg (add_s5 c) 7)) (w64_val n) 2)
             (exact hmxw))
           (have hmy5
             (mapped_words (Cpu.segs (add_s5 c)) (w64_val (reg (add_s5 c) 6)) (w64_val n) 4)
             (exact hmy))
           (have hwx5 (<= (+ (w64_val (reg (add_s5 c) 7)) (* 8 (w64_val n))) 18446744073709551616)
             (exact hwx))
           (have hwy5 (<= (+ (w64_val (reg (add_s5 c) 6)) (* 8 (w64_val n))) 18446744073709551616)
             (exact hwy))
           (have hsp5 (= (mapped (Cpu.segs (add_s5 c)) (w64_val (reg (add_s5 c) 4)) 8 4) true)
             (exact hsp))
           (have dcode5
             (or (<= 4194603 (w64_val (reg (add_s5 c) 7)))
               (<= (+ (w64_val (reg (add_s5 c) 7)) (* 8 (w64_val n))) 4194489))
             (exact dcode))
           (have dy5
             (or
               (<= (+ (w64_val (reg (add_s5 c) 7)) (* 8 (w64_val n))) (w64_val (reg (add_s5 c) 6)))
               (<= (+ (w64_val (reg (add_s5 c) 6)) (* 8 (List.length ys)))
                 (w64_val (reg (add_s5 c) 7))))
             (exact dy))
           (have dsp5
             (or (<= (+ (w64_val (reg (add_s5 c) 4)) 8) (w64_val (reg (add_s5 c) 7)))
               (<= (+ (w64_val (reg (add_s5 c) 7)) (* 8 (w64_val n))) (w64_val (reg (add_s5 c) 4))))
             (exact dsp))
           (cases
             (ih (add_s5 c) hdec (addto_next xs ys n rx ry (reg c 1) h)
               (addto_next_room xs ys n rx ry (reg c 1) h)
               hcode5
               hn5
               hx5
               hy5
               hmxr5
               hmxw5
               hmy5
               hwx5
               hwy5
               hsp5
               dcode5
               dy5
               dsp5)
             ((intro (c2 hc2)
                (cases hc2
                  ((intro (hreach hr1)
                     (cases hr1
                       ((intro (hheld hr2)
                          (cases hr2
                            ((intro (hsame hret)
                               (have hsame1
                                 (same_outside (add_mem c) (Cpu.mem c2) (w64_val (reg c 7))
                                   (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
                                 (exact hsame))
                               (apply (Exists.intro c2)
                                 ((apply And.intro
                                    ((exact
                                       (reaches_trans (at_pc c (w64 4194529))
                                         (at_pc (add_s5 c) (w64 4194529))
                                         c2
                                         (add_turn c hcode hcode4 h2 hmy1 hmx1 hmw1)
                                         hreach)))
                                    ((apply And.intro
                                       ((rw (addto_go_turn xs ys n rx ry (reg c 1) h))
                                        (exact hheld))
                                       ((apply And.intro
                                          ((exact
                                             (same_outside_trans (Cpu.mem c) (add_mem c)
                                               (Cpu.mem c2)
                                               (w64_val (reg c 7))
                                               (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
                                               hso1
                                               hsame1)))
                                          ((unfold returned)
                                           (cases hret
                                             ((intro (hrip hkept)
                                                (apply And.intro ((rw (<- hra)) (exact hrip))
                                                  ((exact hkept))))))))))))))))))))))))))))))))
(theorem add_in_zero
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu))
  (= (addto_go xs ys n rx ry (reg (add_in c) 1)) (addto xs ys n rx ry))
  (by
    (show (= (addto_go xs ys n rx ry (w64_xor (reg c 1) (reg c 1))) (addto xs ys n rx ry)))
    (rw (w64_xor_self (reg c 1)))
    rfl))
;; The contract of `addto`'s code. From a state at its first instruction whose rdi and rsi hold
;; the addresses of two buffers that hold two lists — the first mapped to read and to
;; write, the second to read, for the count in rdx — with the return address readable at the
;; stack pointer, and the first buffer's counted words clear of the code, of the second buffer
;; and of the return address: the processor comes to a state at that return address in which
;; the first buffer's memory holds the list `addto t` returns, the callee's registers are kept,
;; and every byte outside the first buffer's counted words is as it was.
(theorem addto_contract
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu)
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hx (holds (Cpu.mem c) (w64_val (reg c 7)) xs))
   (hy (holds (Cpu.mem c) (w64_val (reg c 6)) ys))
   (hmxr (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hmxw (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 2))
   (hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616))
   (hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true))
   (dcode
     (or (<= 4194603 (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489)))
   (dy
     (or (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 6)))
       (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) (w64_val (reg c 7)))))
   (dsp
     (or (<= (+ (w64_val (reg c 4)) 8) (w64_val (reg c 7)))
       (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 4))))))
  (exists ((c2 Cpu))
    (and (reaches (at_pc c (w64 4194526)) c2)
      (and (holds (Cpu.mem c2) (w64_val (reg c 7)) (addto xs ys n rx ry))
        (and
          (same_outside (Cpu.mem c) (Cpu.mem c2) (w64_val (reg c 7))
            (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
          (returned c c2)))))
  (by
    (have hcode1 (code_in (add_in c) buffers_table) (exact hcode))
    (have hn1 (= (reg (add_in c) 2) n) (exact hn))
    (have hx1 (holds (Cpu.mem (add_in c)) (w64_val (reg (add_in c) 7)) xs) (exact hx))
    (have hy1 (holds (Cpu.mem (add_in c)) (w64_val (reg (add_in c) 6)) ys) (exact hy))
    (have hmxr1 (mapped_words (Cpu.segs (add_in c)) (w64_val (reg (add_in c) 7)) (w64_val n) 4)
      (exact hmxr))
    (have hmxw1 (mapped_words (Cpu.segs (add_in c)) (w64_val (reg (add_in c) 7)) (w64_val n) 2)
      (exact hmxw))
    (have hmy1 (mapped_words (Cpu.segs (add_in c)) (w64_val (reg (add_in c) 6)) (w64_val n) 4)
      (exact hmy))
    (have hwx1 (<= (+ (w64_val (reg (add_in c) 7)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwx))
    (have hwy1 (<= (+ (w64_val (reg (add_in c) 6)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwy))
    (have hsp1 (= (mapped (Cpu.segs (add_in c)) (w64_val (reg (add_in c) 4)) 8 4) true) (exact hsp))
    (have dcode1
      (or (<= 4194603 (w64_val (reg (add_in c) 7)))
        (<= (+ (w64_val (reg (add_in c) 7)) (* 8 (w64_val n))) 4194489))
      (exact dcode))
    (have dy1
      (or (<= (+ (w64_val (reg (add_in c) 7)) (* 8 (w64_val n))) (w64_val (reg (add_in c) 6)))
        (<= (+ (w64_val (reg (add_in c) 6)) (* 8 (List.length ys))) (w64_val (reg (add_in c) 7))))
      (exact dy))
    (have dsp1
      (or (<= (+ (w64_val (reg (add_in c) 4)) 8) (w64_val (reg (add_in c) 7)))
        (<= (+ (w64_val (reg (add_in c) 7)) (* 8 (w64_val n))) (w64_val (reg (add_in c) 4))))
      (exact dsp))
    (cases
      (add_loop ys n ry (add_in c) xs rx hcode1 hn1 hx1 hy1 hmxr1 hmxw1 hmy1 hwx1 hwy1 hsp1 dcode1
        dy1
        dsp1)
      ((intro (c2 hc2)
         (cases hc2
           ((intro (hreach hrest)
              (have hreach1 (reaches (add_in c) c2)
                (show (reaches (at_pc (add_in c) (w64 4194529)) c2))
                (exact hreach))
              (apply (Exists.intro c2)
                ((apply And.intro
                   ((exact
                      (reaches_trans (at_pc c (w64 4194526)) (add_in c) c2 (add_enter c hcode)
                        hreach1)))
                   ((rw (<- (add_in_zero xs ys n rx ry c))) (exact hrest)))))))))))))

;; ---- both: the states its code passes through ---------------------------------------------------
;; to the first call: rbx and r12 pushed, the first address and the count moved into them, the
;; return address pushed — the state `addto` is entered in, put at its first instruction
(fn bo_s1 ((c Cpu)) Cpu
  (at_pc (pushed (at_pc c (w64 4194556)) (reg (at_pc c (w64 4194556)) 3)) (w64 4194557)))
(fn bo_s2 ((c Cpu)) Cpu (at_pc (pushed (bo_s1 c) (reg (bo_s1 c) 12)) (w64 4194559)))
(fn bo_s3 ((c Cpu)) Cpu (x_mov_rr (bo_s2 c) 3 7 (w64 4194562)))
(fn bo_s4 ((c Cpu)) Cpu (x_mov_rr (bo_s3 c) 12 2 (w64 4194565)))
(fn bo_s5 ((c Cpu)) Cpu (pushed (bo_s4 c) (w64 4194570)))
;; from the state `addto` returned in to the second call: the kept address as both buffers, the
;; kept count, the return address pushed — the state `dot` is entered in
(fn bo_m1 ((c Cpu)) Cpu (x_mov_rr c 7 3 (w64 4194573)))
(fn bo_m2 ((c Cpu)) Cpu (x_mov_rr (bo_m1 c) 6 3 (w64 4194576)))
(fn bo_m3 ((c Cpu)) Cpu (x_mov_rr (bo_m2 c) 2 12 (w64 4194579)))
(fn bo_m4 ((c Cpu)) Cpu (pushed (bo_m3 c) (w64 4194584)))
;; from the state `dot` returned in: r12 and rbx popped, the return
(fn bo_e1 ((c Cpu)) Cpu (x_pop c 12 (w64 4194586)))
(fn bo_e2 ((c Cpu)) Cpu (x_pop (bo_e1 c) 3 (w64 4194587)))
(fn bo_out ((c Cpu)) Cpu (x_ret (bo_e2 c)))

;; the stack pointer one, two and three words below where a state has it
(fn below1 ((c Cpu)) (BitVec 64) (w64_sub (reg c 4) (w64 8)))
(fn below2 ((c Cpu)) (BitVec 64) (w64_sub (below1 c) (w64 8)))
(fn below3 ((c Cpu)) (BitVec 64) (w64_sub (below2 c) (w64 8)))

;; ---- both: its frame ----------------------------------------------------------------------------
;; where the stack pointer stands 24 above an address f: the addresses of the three words pushed
(theorem fr_16 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (= (w64_val (below1 c)) (+ f 16))
  (by
    (have h (= (w64_val (reg c 4)) (+ (+ f 16) 8)) (arith))
    (have k8 (< 8 18446744073709551616) (arith))
    (exact (w64_val_sub (reg c 4) (+ f 16) 8 h k8))))
(theorem fr_8 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (= (w64_val (below2 c)) (+ f 8))
  (by
    (have h (= (w64_val (below1 c)) (+ (+ f 8) 8)) (rw (fr_16 c f hf)) (arith))
    (have k8 (< 8 18446744073709551616) (arith))
    (exact (w64_val_sub (below1 c) (+ f 8) 8 h k8))))
(theorem fr_0 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24)))) (= (w64_val (below3 c)) f)
  (by
    (have h (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have k8 (< 8 18446744073709551616) (arith))
    (exact (w64_val_sub (below2 c) f 8 h k8))))
;; memory up to the first call is as it was outside the frame: where the stack pointer stands
;; 24 above f, the three words pushed lie in the 24 bytes from f
(theorem bo_so1 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (same_outside (Cpu.mem c) (Cpu.mem (bo_s1 c)) f (+ f 24))
  (by
    (have h16 (= (w64_val (below1 c)) (+ f 16)) (exact (fr_16 c f hf)))
    (have a1 (<= f (w64_val (below1 c))) (rw h16) (arith))
    (have b1 (<= (+ (w64_val (below1 c)) 8) (+ f 24)) (rw h16) (arith))
    (exact
      (same_outside_put64 (Cpu.mem c) (Cpu.mem c) f (+ f 24) (w64_val (below1 c))
        (w64_val (reg c 3))
        (same_outside_refl (Cpu.mem c) f (+ f 24))
        a1
        b1))))
(theorem bo_so2 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (same_outside (Cpu.mem c) (Cpu.mem (bo_s2 c)) f (+ f 24))
  (by
    (have h8 (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have a2 (<= f (w64_val (below2 c))) (rw h8) (arith))
    (have b2 (<= (+ (w64_val (below2 c)) 8) (+ f 24)) (rw h8) (arith))
    (exact
      (same_outside_put64 (Cpu.mem c) (Cpu.mem (bo_s1 c)) f (+ f 24) (w64_val (below2 c))
        (w64_val (reg c 12))
        (bo_so1 c f hf)
        a2
        b2))))
(theorem bo_so5 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (same_outside (Cpu.mem c) (Cpu.mem (bo_s5 c)) f (+ f 24))
  (by
    (have h0 (= (w64_val (below3 c)) f) (exact (fr_0 c f hf)))
    (have a3 (<= f (w64_val (below3 c))) (rw h0) (arith))
    (have b3 (<= (+ (w64_val (below3 c)) 8) (+ f 24)) (rw h0) (arith))
    (exact
      (same_outside_put64 (Cpu.mem c) (Cpu.mem (bo_s2 c)) f (+ f 24) (w64_val (below3 c))
        (w64_val (w64 4194570))
        (bo_so2 c f hf)
        a3
        b3))))
;; so the code is in place where `addto` is entered
(theorem bo_code5
  ((c Cpu)
   (f Nat)
   (hcode (code_in c buffers_table))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfc (or (<= 4194603 f) (<= (+ f 24) 4194489))))
  (code_in (bo_s5 c) buffers_table)
  (by
    (have sg5 (= (Cpu.segs (bo_s5 c)) (Cpu.segs c)) rfl)
    (have cfc (or (<= (+ 4194588 15) f) (<= (+ f 24) 4194489)) (exact dfc))
    (exact
      (code_in_after c (bo_s5 c) buffers_table 4194489 4194588 f (+ f 24) table_within sg5
        (bo_so5 c f hf)
        cfc
        hcode))))
;; the words the frame holds where `addto` is entered: rbx and r12 as the caller had them
(theorem bo_saved_rbx ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (= (w64 (mem_le64 (Cpu.mem (bo_s5 c)) (+ f 16))) (reg c 3))
  (by
    (have h16 (= (w64_val (below1 c)) (+ f 16)) (exact (fr_16 c f hf)))
    (have h8 (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have h0 (= (w64_val (below3 c)) f) (exact (fr_0 c f hf)))
    (have x3 (or (<= (+ (+ f 16) 8) (w64_val (below3 c))) (<= (+ (w64_val (below3 c)) 8) (+ f 16)))
      (rw h0)
      (apply Or.inr ((arith))))
    (have x2 (or (<= (+ (+ f 16) 8) (w64_val (below2 c))) (<= (+ (w64_val (below2 c)) 8) (+ f 16)))
      (rw h8)
      (apply Or.inr ((arith))))
    (have e1 (= (mem_le64 (Cpu.mem (bo_s5 c)) (+ f 16)) (mem_le64 (Cpu.mem (bo_s2 c)) (+ f 16)))
      (exact
        (le64_put64_other (Cpu.mem (bo_s2 c)) (w64_val (below3 c)) (w64_val (w64 4194570)) (+ f 16)
          x3)))
    (have e2 (= (mem_le64 (Cpu.mem (bo_s2 c)) (+ f 16)) (mem_le64 (Cpu.mem (bo_s1 c)) (+ f 16)))
      (exact
        (le64_put64_other (Cpu.mem (bo_s1 c)) (w64_val (below2 c)) (w64_val (reg c 12)) (+ f 16) x2)))
    (have e3 (= (w64 (mem_le64 (Cpu.mem (bo_s1 c)) (w64_val (below1 c)))) (reg c 3))
      (exact (le64_put64_word (Cpu.mem c) (w64_val (below1 c)) (reg c 3))))
    (rw e1)
    (rw e2)
    (rw (<- h16))
    (exact e3)))
(theorem bo_saved_r12 ((c Cpu) (f Nat) (hf (= (w64_val (reg c 4)) (+ f 24))))
  (= (w64 (mem_le64 (Cpu.mem (bo_s5 c)) (+ f 8))) (reg c 12))
  (by
    (have h8 (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have h0 (= (w64_val (below3 c)) f) (exact (fr_0 c f hf)))
    (have x3 (or (<= (+ (+ f 8) 8) (w64_val (below3 c))) (<= (+ (w64_val (below3 c)) 8) (+ f 8)))
      (rw h0)
      (apply Or.inr ((arith))))
    (have e1 (= (mem_le64 (Cpu.mem (bo_s5 c)) (+ f 8)) (mem_le64 (Cpu.mem (bo_s2 c)) (+ f 8)))
      (exact
        (le64_put64_other (Cpu.mem (bo_s2 c)) (w64_val (below3 c)) (w64_val (w64 4194570)) (+ f 8)
          x3)))
    (have e3 (= (w64 (mem_le64 (Cpu.mem (bo_s2 c)) (w64_val (below2 c)))) (reg c 12))
      (exact (le64_put64_word (Cpu.mem (bo_s1 c)) (w64_val (below2 c)) (reg c 12))))
    (rw e1)
    (rw (<- h8))
    (exact e3)))

;; ---- both: its code, block by block -------------------------------------------------------------
;; to the first call
(theorem both_enter
  ((c Cpu)
   (f Nat)
   (hcode (code_in c buffers_table))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hfw (mapped_words (Cpu.segs c) f 3 2))
   (dfc (or (<= 4194603 f) (<= (+ f 24) 4194489))))
  (reaches (at_pc c (w64 4194556)) (at_pc (bo_s5 c) (w64 4194526)))
  (by
    (have h16 (= (w64_val (below1 c)) (+ f 16)) (exact (fr_16 c f hf)))
    (have h8 (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have h0 (= (w64_val (below3 c)) f) (exact (fr_0 c f hf)))
    (have n0 (< 0 3) (arith))
    (have n1 (< 1 3) (arith))
    (have n2 (< 2 3) (arith))
    (have hm1 (= (mapped (Cpu.segs c) (w64_val (below1 c)) 8 2) true) (rw h16) (exact (hfw 2 n2)))
    (have hm2 (= (mapped (Cpu.segs c) (w64_val (below2 c)) 8 2) true) (rw h8) (exact (hfw 1 n1)))
    (have hm3 (= (mapped (Cpu.segs c) (w64_val (below3 c)) 8 2) true) (rw h0) (exact (hfw 0 n0)))
    (have sg1 (= (Cpu.segs (bo_s1 c)) (Cpu.segs c)) rfl)
    (have sg2 (= (Cpu.segs (bo_s2 c)) (Cpu.segs c)) rfl)
    (have cfc (or (<= (+ 4194588 15) f) (<= (+ f 24) 4194489)) (exact dfc))
    (have hcode1 (code_in (bo_s1 c) buffers_table)
      (exact
        (code_in_after c (bo_s1 c) buffers_table 4194489 4194588 f (+ f 24) table_within sg1
          (bo_so1 c f hf)
          cfc
          hcode)))
    (have hcode2 (code_in (bo_s2 c) buffers_table)
      (exact
        (code_in_after c (bo_s2 c) buffers_table 4194489 4194588 f (+ f 24) table_within sg2
          (bo_so2 c f hf)
          cfc
          hcode)))
    (apply (do_push 4194556 3 1 4194557) (rfl)
      ((exact (hcode 4194556 (Push 3) 1 (Eq.refl (some (Prod.mk (Push 3) 1))))))
      ((exact hm1))
      (rfl)
      ((apply (do_push 4194557 12 2 4194559) (rfl)
         ((exact (hcode1 4194557 (Push 12) 2 (Eq.refl (some (Prod.mk (Push 12) 2))))))
         ((exact hm2))
         (rfl)
         ((apply (do_mov_rr 4194559 3 7 3 4194562) (rfl)
            ((exact
               (hcode2 4194559 (MovRmR (RmReg 3) 7) 3
                 (Eq.refl (some (Prod.mk (MovRmR (RmReg 3) 7) 3))))))
            (rfl)
            ((apply (do_mov_rr 4194562 12 2 3 4194565) (rfl)
               ((exact
                  (hcode2 4194562 (MovRmR (RmReg 12) 2) 3
                    (Eq.refl (some (Prod.mk (MovRmR (RmReg 12) 2) 3))))))
               (rfl)
               ((apply (do_call 4194565 5 18446744073709551572 4194570 4194526) (rfl)
                  ((exact
                     (hcode2 4194565 (Call 18446744073709551572) 5
                       (Eq.refl (some (Prod.mk (Call 18446744073709551572) 5))))))
                  ((exact hm3))
                  (rfl)
                  (rfl)
                  ((exact (reaches_refl (at_pc (bo_s5 c) (w64 4194526))))))))))))))))
;; from the first call's return to the second call
(theorem both_mid
  ((c Cpu)
   (hrip (= (w64_val (Cpu.rip c)) 4194570))
   (hcode (code_in c buffers_table))
   (hm (= (mapped (Cpu.segs c) (w64_val (below1 c)) 8 2) true)))
  (reaches c (at_pc (bo_m4 c) (w64 4194489)))
  (by
    (apply (do_mov_rr 4194570 7 3 3 4194573) ((exact hrip))
      ((exact
         (hcode 4194570 (MovRmR (RmReg 7) 3) 3 (Eq.refl (some (Prod.mk (MovRmR (RmReg 7) 3) 3))))))
      (rfl)
      ((apply (do_mov_rr 4194573 6 3 3 4194576) (rfl)
         ((exact
            (hcode 4194573 (MovRmR (RmReg 6) 3) 3 (Eq.refl (some (Prod.mk (MovRmR (RmReg 6) 3) 3))))))
         (rfl)
         ((apply (do_mov_rr 4194576 2 12 3 4194579) (rfl)
            ((exact
               (hcode 4194576 (MovRmR (RmReg 2) 12) 3
                 (Eq.refl (some (Prod.mk (MovRmR (RmReg 2) 12) 3))))))
            (rfl)
            ((apply (do_call 4194579 5 18446744073709551521 4194584 4194489) (rfl)
               ((exact
                  (hcode 4194579 (Call 18446744073709551521) 5
                    (Eq.refl (some (Prod.mk (Call 18446744073709551521) 5))))))
               ((exact hm))
               (rfl)
               (rfl)
               ((exact (reaches_refl (at_pc (bo_m4 c) (w64 4194489))))))))))))))
;; from the second call's return to the function's own
(theorem both_leave
  ((c Cpu)
   (hrip (= (w64_val (Cpu.rip c)) 4194584))
   (hcode (code_in c buffers_table))
   (hm1 (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true))
   (hm2 (= (mapped (Cpu.segs c) (w64_val (w64_add (reg c 4) (w64 8))) 8 4) true))
   (hm3 (= (mapped (Cpu.segs c) (w64_val (w64_add (w64_add (reg c 4) (w64 8)) (w64 8))) 8 4) true)))
  (reaches c (bo_out c))
  (by
    (apply (do_pop 4194584 12 2 4194586) ((exact hrip))
      ((exact (hcode 4194584 (Pop 12) 2 (Eq.refl (some (Prod.mk (Pop 12) 2))))))
      ((exact hm1))
      (rfl)
      ((apply (do_pop 4194586 3 1 4194587) (rfl)
         ((exact (hcode 4194586 (Pop 3) 1 (Eq.refl (some (Prod.mk (Pop 3) 1))))))
         ((exact hm2))
         (rfl)
         ((apply (do_ret 4194587 1) (rfl)
            ((exact (hcode 4194587 Ret 1 (Eq.refl (some (Prod.mk Ret 1))))))
            ((exact hm3))
            ((exact (reaches_refl (bo_out c)))))))))))

;; ---- both: its two calls ------------------------------------------------------------------------
;; The first call: `addto`'s contract in the state the code enters it in, its hypotheses met
;; from the caller's, and what it gives said of the caller's registers.
(theorem both_first
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu)
   (f Nat)
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hx (holds (Cpu.mem c) (w64_val (reg c 7)) xs))
   (hy (holds (Cpu.mem c) (w64_val (reg c 6)) ys))
   (hmxr (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hmxw (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 2))
   (hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hfr (mapped_words (Cpu.segs c) f 4 4))
   (dcode
     (or (<= 4194603 (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489)))
   (dy
     (or (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 6)))
       (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) (w64_val (reg c 7)))))
   (dfc (or (<= 4194603 f) (<= (+ f 24) 4194489)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (dfy (or (<= (+ f 24) (w64_val (reg c 6))) (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) f))))
  (exists ((c6 Cpu))
    (and (reaches (at_pc (bo_s5 c) (w64 4194526)) c6)
      (and (holds (Cpu.mem c6) (w64_val (reg c 7)) (addto xs ys n rx ry))
        (and
          (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
            (+ (w64_val (reg c 7)) (* 8 (w64_val n))))
          (returned (bo_s5 c) c6)))))
  (by
    (have h0 (= (w64_val (below3 c)) f) (exact (fr_0 c f hf)))
    (have hlen (<= (w64_val n) (List.length xs)) (exact rx))
    (have r0 (< 0 4) (arith))
    (have so5 (same_outside (Cpu.mem c) (Cpu.mem (bo_s5 c)) f (+ f 24)) (exact (bo_so5 c f hf)))
    (have hcode5 (code_in (bo_s5 c) buffers_table) (exact (bo_code5 c f hcode hf dfc)))
    (have cx
      (or (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f) (<= (+ f 24) (w64_val (reg c 7))))
      (cases dfx ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((exact hr)))))))
    (have cy
      (or (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) f) (<= (+ f 24) (w64_val (reg c 6))))
      (cases dfy ((inl (hl) (apply Or.inr ((exact hl)))) (inr (hr) (apply Or.inl ((exact hr)))))))
    (have hn5 (= (reg (bo_s5 c) 2) n) (exact hn))
    (have hx5 (holds (Cpu.mem (bo_s5 c)) (w64_val (reg (bo_s5 c) 7)) xs)
      (exact
        (holds_same (Cpu.mem c) (Cpu.mem (bo_s5 c)) f (+ f 24) (w64_val (reg c 7)) xs hx so5 cx)))
    (have hy5 (holds (Cpu.mem (bo_s5 c)) (w64_val (reg (bo_s5 c) 6)) ys)
      (exact
        (holds_same (Cpu.mem c) (Cpu.mem (bo_s5 c)) f (+ f 24) (w64_val (reg c 6)) ys hy so5 cy)))
    (have hmxr5 (mapped_words (Cpu.segs (bo_s5 c)) (w64_val (reg (bo_s5 c) 7)) (w64_val n) 4)
      (exact hmxr))
    (have hmxw5 (mapped_words (Cpu.segs (bo_s5 c)) (w64_val (reg (bo_s5 c) 7)) (w64_val n) 2)
      (exact hmxw))
    (have hmy5 (mapped_words (Cpu.segs (bo_s5 c)) (w64_val (reg (bo_s5 c) 6)) (w64_val n) 4)
      (exact hmy))
    (have hwx5 (<= (+ (w64_val (reg (bo_s5 c) 7)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwx))
    (have hwy5 (<= (+ (w64_val (reg (bo_s5 c) 6)) (* 8 (w64_val n))) 18446744073709551616)
      (exact hwy))
    (have hsp5a (= (mapped (Cpu.segs c) (w64_val (below3 c)) 8 4) true) (rw h0) (exact (hfr 0 r0)))
    (have hsp5 (= (mapped (Cpu.segs (bo_s5 c)) (w64_val (reg (bo_s5 c) 4)) 8 4) true) (exact hsp5a))
    (have dcode5
      (or (<= 4194603 (w64_val (reg (bo_s5 c) 7)))
        (<= (+ (w64_val (reg (bo_s5 c) 7)) (* 8 (w64_val n))) 4194489))
      (exact dcode))
    (have dy5
      (or (<= (+ (w64_val (reg (bo_s5 c) 7)) (* 8 (w64_val n))) (w64_val (reg (bo_s5 c) 6)))
        (<= (+ (w64_val (reg (bo_s5 c) 6)) (* 8 (List.length ys))) (w64_val (reg (bo_s5 c) 7))))
      (exact dy))
    (have dsp5a
      (or (<= (+ (w64_val (below3 c)) 8) (w64_val (reg c 7)))
        (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (below3 c))))
      (rw h0)
      (cases dfx ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
    (have dsp5
      (or (<= (+ (w64_val (reg (bo_s5 c) 4)) 8) (w64_val (reg (bo_s5 c) 7)))
        (<= (+ (w64_val (reg (bo_s5 c) 7)) (* 8 (w64_val n))) (w64_val (reg (bo_s5 c) 4))))
      (exact dsp5a))
    (exact
      (addto_contract xs ys n rx ry (bo_s5 c) hcode5 hn5 hx5 hy5 hmxr5 hmxw5 hmy5 hwx5 hwy5 hsp5
        dcode5
        dy5
        dsp5))))

;; in the state `addto` returned in: the stack pointer two words below the caller's, the word
;; below it at f, and the second call's push inside the frame
(theorem bo_sp6 ((c Cpu) (c6 Cpu) (kp6 (kept (bo_s5 c) c6))) (= (reg c6 4) (below2 c))
  (by (rw (kept_sp (bo_s5 c) c6 kp6)) (exact (w64_sub_add (below2 c) (w64 8)))))
(theorem bo_a6
  ((c Cpu) (f Nat) (c6 Cpu) (hf (= (w64_val (reg c 4)) (+ f 24))) (kp6 (kept (bo_s5 c) c6)))
  (= (w64_val (below1 c6)) f)
  (by
    (show (= (w64_val (w64_sub (reg c6 4) (w64 8))) f))
    (rw (bo_sp6 c c6 kp6))
    (exact (fr_0 c f hf))))
(theorem bo_so7
  ((c Cpu) (f Nat) (c6 Cpu) (hf (= (w64_val (reg c 4)) (+ f 24))) (kp6 (kept (bo_s5 c) c6)))
  (same_outside (Cpu.mem c6) (Cpu.mem (bo_m4 c6)) f (+ f 24))
  (by
    (have ha6 (= (w64_val (below1 c6)) f) (exact (bo_a6 c f c6 hf kp6)))
    (have a7 (<= f (w64_val (below1 c6))) (rw ha6) (arith))
    (have b7 (<= (+ (w64_val (below1 c6)) 8) (+ f 24)) (rw ha6) (arith))
    (exact
      (same_outside_put64 (Cpu.mem c6) (Cpu.mem c6) f (+ f 24) (w64_val (below1 c6))
        (w64_val (w64 4194584))
        (same_outside_refl (Cpu.mem c6) f (+ f 24))
        a7
        b7))))

;; The second call: from the state `addto` returned in, through the three moves and the call,
;; `dot`'s contract with the one buffer as both operands, its hypotheses met from what the
;; first call gave and what it kept.
(theorem both_second
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hmxr (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hfr (mapped_words (Cpu.segs c) f 4 4))
   (hfw (mapped_words (Cpu.segs c) f 3 2))
   (dcode
     (or (<= 4194603 (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489)))
   (dfc (or (<= 4194603 f) (<= (+ f 24) 4194489)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hx6 (holds (Cpu.mem c6) (w64_val (reg c 7)) (addto xs ys n rx ry)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (hret6 (returned (bo_s5 c) c6)))
  (exists ((c8 Cpu))
    (and (reaches c6 c8)
      (and (code_in c8 buffers_table)
        (and
          (= (reg c8 0)
            (dot (addto xs ys n rx ry) (addto xs ys n rx ry) n (addto_room xs ys n rx ry)
              (addto_room xs ys n rx ry)))
          (and (holds (Cpu.mem c8) (w64_val (reg c 7)) (addto xs ys n rx ry))
            (and (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6))) (returned (bo_m4 c6) c8)))))))
  (by
    (have n0 (< 0 3) (arith))
    (have r0 (< 0 4) (arith))
    (have kp6 (kept (bo_s5 c) c6) (exact (returned_kept (bo_s5 c) c6 hret6)))
    (have hsegs6 (= (Cpu.segs c6) (Cpu.segs c)) (exact (kept_segs (bo_s5 c) c6 kp6)))
    (have hrbx6 (= (reg c6 3) (reg c 7)) (exact (kept_rbx (bo_s5 c) c6 kp6)))
    (have hr12x (= (reg c6 12) (reg c 2)) (exact (kept_r12 (bo_s5 c) c6 kp6)))
    (have hra6 (= (ret_addr (bo_s5 c)) (w64 4194570))
      (exact (ret_addr_pushed (bo_s4 c) (w64 4194570))))
    (have hrip6 (= (w64_val (Cpu.rip c6)) 4194570)
      (rw (returned_at (bo_s5 c) c6 hret6))
      (rw hra6)
      rfl)
    ;; the code is in place after the first call, and after the second call's push
    (have hcode5 (code_in (bo_s5 c) buffers_table) (exact (bo_code5 c f hcode hf dfc)))
    (have ccode6
      (or (<= (+ 4194588 15) (w64_val (reg c 7)))
        (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489))
      (exact dcode))
    (have hcode6 (code_in c6 buffers_table)
      (exact
        (code_in_after (bo_s5 c) c6 buffers_table 4194489 4194588 (w64_val (reg c 7))
          (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
          table_within
          (kept_segs (bo_s5 c) c6 kp6)
          hso6
          ccode6
          hcode5)))
    (have ha6 (= (w64_val (below1 c6)) f) (exact (bo_a6 c f c6 hf kp6)))
    (have hm6 (= (mapped (Cpu.segs c6) (w64_val (below1 c6)) 8 2) true)
      (rw hsegs6)
      (rw ha6)
      (exact (hfw 0 n0)))
    (have so7 (same_outside (Cpu.mem c6) (Cpu.mem (bo_m4 c6)) f (+ f 24))
      (exact (bo_so7 c f c6 hf kp6)))
    (have sg7 (= (Cpu.segs (bo_m4 c6)) (Cpu.segs c6)) rfl)
    (have cfc (or (<= (+ 4194588 15) f) (<= (+ f 24) 4194489)) (exact dfc))
    (have hcode7 (code_in (bo_m4 c6) buffers_table)
      (exact
        (code_in_after c6 (bo_m4 c6) buffers_table 4194489 4194588 f (+ f 24) table_within sg7 so7
          cfc
          hcode6)))
    ;; `dot`'s hypotheses, of the state it is entered in
    (have hreg7 (= (reg (bo_m4 c6) 6) (reg (bo_m4 c6) 7)) rfl)
    (have hn7 (= (reg (bo_m4 c6) 2) n) (show (= (reg c6 12) n)) (rw hr12x) (exact hn))
    (have cx7
      (or (<= (+ (w64_val (reg c 7)) (* 8 (List.length (addto xs ys n rx ry)))) f)
        (<= (+ f 24) (w64_val (reg c 7))))
      (rw (addto_length xs ys n rx ry))
      (cases dfx ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((exact hr)))))))
    (have hx7a (holds (Cpu.mem (bo_m4 c6)) (w64_val (reg c 7)) (addto xs ys n rx ry))
      (exact
        (holds_same (Cpu.mem c6) (Cpu.mem (bo_m4 c6)) f (+ f 24) (w64_val (reg c 7))
          (addto xs ys n rx ry)
          hx6
          so7
          cx7)))
    (have hx7 (holds (Cpu.mem (bo_m4 c6)) (w64_val (reg (bo_m4 c6) 7)) (addto xs ys n rx ry))
      (show (holds (Cpu.mem (bo_m4 c6)) (w64_val (reg c6 3)) (addto xs ys n rx ry)))
      (rw hrbx6)
      (exact hx7a))
    (have hmx7 (mapped_words (Cpu.segs (bo_m4 c6)) (w64_val (reg (bo_m4 c6) 7)) (w64_val n) 4)
      (show (mapped_words (Cpu.segs c6) (w64_val (reg c6 3)) (w64_val n) 4))
      (rw hsegs6)
      (rw hrbx6)
      (exact hmxr))
    (have hwx7 (<= (+ (w64_val (reg (bo_m4 c6) 7)) (* 8 (w64_val n))) 18446744073709551616)
      (show (<= (+ (w64_val (reg c6 3)) (* 8 (w64_val n))) 18446744073709551616))
      (rw hrbx6)
      (exact hwx))
    (have hsp7 (= (mapped (Cpu.segs (bo_m4 c6)) (w64_val (reg (bo_m4 c6) 4)) 8 4) true)
      (show (= (mapped (Cpu.segs c6) (w64_val (below1 c6)) 8 4) true))
      (rw hsegs6)
      (rw ha6)
      (exact (hfr 0 r0)))
    (cases
      (dot_contract_same (addto xs ys n rx ry) n (addto_room xs ys n rx ry) (bo_m4 c6) hreg7 hcode7
        hn7
        hx7
        hmx7
        hwx7
        hsp7)
      ((intro (c8 hc8)
         (cases hc8
           ((intro (hreach8 hr8a)
              (cases hr8a
                ((intro (hv8 hr8b)
                   (cases hr8b
                     ((intro (hmem8 hret8)
                        (apply (Exists.intro c8)
                          ((apply And.intro
                             ((exact
                                (reaches_trans c6 (at_pc (bo_m4 c6) (w64 4194489)) c8
                                  (both_mid c6 hrip6 hcode6 hm6)
                                  hreach8)))
                             ((apply And.intro
                                ((exact
                                   (code_in_of (bo_m4 c6) c8 buffers_table
                                     (kept_segs (bo_m4 c6) c8 (returned_kept (bo_m4 c6) c8 hret8))
                                     hmem8
                                     hcode7)))
                                ((apply And.intro ((exact hv8))
                                   ((apply And.intro ((rw hmem8) (exact hx7a))
                                      ((apply And.intro ((exact hmem8)) ((exact hret8)))))))))))))))))))))))))))

;; ---- both: the way out --------------------------------------------------------------------------
;; in the state `dot` returned in the stack pointer is again two words below the caller's; one
;; word up and two words up
(theorem bo_sp8 ((c Cpu) (c6 Cpu) (c8 Cpu) (kp6 (kept (bo_s5 c) c6)) (kp8 (kept (bo_m4 c6) c8)))
  (= (reg c8 4) (below2 c))
  (by
    (rw (kept_sp (bo_m4 c6) c8 kp8))
    (show (= (w64_add (w64_sub (reg c6 4) (w64 8)) (w64 8)) (below2 c)))
    (rw (w64_sub_add (reg c6 4) (w64 8)))
    (exact (bo_sp6 c c6 kp6))))
(theorem bo_up1 ((c Cpu)) (= (w64_add (below2 c) (w64 8)) (below1 c))
  (exact (w64_sub_add (below1 c) (w64 8))))
(theorem bo_up2 ((c Cpu)) (= (w64_add (below1 c) (w64 8)) (reg c 4))
  (exact (w64_sub_add (reg c 4) (w64 8))))
;; the two pops and the return
(theorem both_exit
  ((c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hfr (mapped_words (Cpu.segs c) f 4 4))
   (hcode8 (code_in c8 buffers_table))
   (kp6 (kept (bo_s5 c) c6))
   (hret8 (returned (bo_m4 c6) c8)))
  (reaches c8 (bo_out c8))
  (by
    (have kp8 (kept (bo_m4 c6) c8) (exact (returned_kept (bo_m4 c6) c8 hret8)))
    (have hsegs6 (= (Cpu.segs c6) (Cpu.segs c)) (exact (kept_segs (bo_s5 c) c6 kp6)))
    (have hsegs8 (= (Cpu.segs c8) (Cpu.segs c)) (rw (kept_segs (bo_m4 c6) c8 kp8)) (exact hsegs6))
    (have hsp8 (= (reg c8 4) (below2 c)) (exact (bo_sp8 c c6 c8 kp6 kp8)))
    (have hra8 (= (ret_addr (bo_m4 c6)) (w64 4194584))
      (exact (ret_addr_pushed (bo_m3 c6) (w64 4194584))))
    (have hrip8 (= (w64_val (Cpu.rip c8)) 4194584)
      (rw (returned_at (bo_m4 c6) c8 hret8))
      (rw hra8)
      rfl)
    (have h16 (= (w64_val (below1 c)) (+ f 16)) (exact (fr_16 c f hf)))
    (have h8 (= (w64_val (below2 c)) (+ f 8)) (exact (fr_8 c f hf)))
    (have r1 (< 1 4) (arith))
    (have r2 (< 2 4) (arith))
    (have r3 (< 3 4) (arith))
    (have hp1 (= (mapped (Cpu.segs c8) (w64_val (reg c8 4)) 8 4) true)
      (rw hsegs8)
      (rw hsp8)
      (rw h8)
      (exact (hfr 1 r1)))
    (have hp2 (= (mapped (Cpu.segs c8) (w64_val (w64_add (reg c8 4) (w64 8))) 8 4) true)
      (rw hsegs8)
      (rw hsp8)
      (rw (bo_up1 c))
      (rw h16)
      (exact (hfr 2 r2)))
    (have hp3
      (= (mapped (Cpu.segs c8) (w64_val (w64_add (w64_add (reg c8 4) (w64 8)) (w64 8))) 8 4) true)
      (rw hsegs8)
      (rw hsp8)
      (rw (bo_up1 c))
      (rw (bo_up2 c))
      (rw hf)
      (exact (hfr 3 r3)))
    (exact (both_leave c8 hrip8 hcode8 hp1 hp2 hp3))))
;; memory where the code returns: as it was outside the first buffer's counted words and the
;; frame
(theorem both_foot
  ((n (BitVec 64))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (same_outside2 (Cpu.mem c) (Cpu.mem c8) (w64_val (reg c 7))
    (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
    f
    (+ f 24))
  (by
    (have ha6 (= (w64_val (below1 c6)) f) (exact (bo_a6 c f c6 hf kp6)))
    (have a7 (<= f (w64_val (below1 c6))) (rw ha6) (arith))
    (have b7 (<= (+ (w64_val (below1 c6)) 8) (+ f 24)) (rw ha6) (arith))
    (have s2
      (same_outside2 (Cpu.mem c) (Cpu.mem c6) (w64_val (reg c 7))
        (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
        f
        (+ f 24))
      (exact
        (same_outside2_of (Cpu.mem c) (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
          (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
          f
          (+ f 24)
          (bo_so5 c f hf)
          hso6)))
    (rw hmem8)
    (exact
      (same_outside2_put64 (Cpu.mem c) (Cpu.mem c6) (w64_val (reg c 7))
        (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
        f
        (+ f 24)
        (w64_val (below1 c6))
        (w64_val (w64 4194584))
        s2
        a7
        b7))))
;; a word of the frame or the return address, k bytes above f, read where `dot` has returned,
;; is the word there when `addto` was entered: the second call's push is below it, and the
;; first buffer is clear of it
(theorem both_word
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (k Nat)
   (hk (<= 8 k))
   (hk2 (<= k 24))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (= (mem_le64 (Cpu.mem c8) (+ f k)) (mem_le64 (Cpu.mem (bo_s5 c)) (+ f k)))
  (by
    (have hlen (<= (w64_val n) (List.length xs)) (exact rx))
    (have ha6 (= (w64_val (below1 c6)) f) (exact (bo_a6 c f c6 hf kp6)))
    (have d (or (<= (+ (+ f k) 8) (w64_val (below1 c6))) (<= (+ (w64_val (below1 c6)) 8) (+ f k)))
      (rw ha6)
      (apply Or.inr ((arith))))
    (have g
      (or (<= (+ (+ f k) 8) (w64_val (reg c 7)))
        (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (+ f k)))
      (cases dfx ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
    (have eA (= (mem_le64 (Cpu.mem (bo_m4 c6)) (+ f k)) (mem_le64 (Cpu.mem c6) (+ f k)))
      (exact (le64_put64_other (Cpu.mem c6) (w64_val (below1 c6)) (w64_val (w64 4194584)) (+ f k) d)))
    (have eB (= (mem_le64 (Cpu.mem c6) (+ f k)) (mem_le64 (Cpu.mem (bo_s5 c)) (+ f k)))
      (exact
        (le64_same (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
          (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
          (+ f k)
          hso6
          g)))
    (rw hmem8)
    (rw eA)
    (exact eB)))
;; the code returns where its caller's return address says
(theorem both_ret
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (kp8 (kept (bo_m4 c6) c8))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (= (Cpu.rip (bo_out c8)) (ret_addr c))
  (by
    (have k1 (<= 8 24) (arith))
    (have k2 (<= 24 24) (arith))
    (have dA (or (<= (+ (+ f 24) 8) f) (<= (+ f 24) (+ f 24))) (apply Or.inr ((arith))))
    (have eC (= (mem_le64 (Cpu.mem (bo_s5 c)) (+ f 24)) (mem_le64 (Cpu.mem c) (+ f 24)))
      (exact (le64_same (Cpu.mem c) (Cpu.mem (bo_s5 c)) f (+ f 24) (+ f 24) (bo_so5 c f hf) dA)))
    (show
      (= (w64 (mem_le64 (Cpu.mem c8) (w64_val (w64_add (w64_add (reg c8 4) (w64 8)) (w64 8)))))
        (w64 (mem_le64 (Cpu.mem c) (w64_val (reg c 4))))))
    (rw (bo_sp8 c c6 c8 kp6 kp8))
    (rw (bo_up1 c))
    (rw (bo_up2 c))
    (rw hf)
    (rw (both_word xs n rx c f c6 c8 24 k1 k2 hf dfx hso6 kp6 hmem8))
    (rw eC)
    rfl))
;; rbx and r12 are popped as the caller had them
(theorem both_rbx
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (kp8 (kept (bo_m4 c6) c8))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (= (reg (bo_out c8) 3) (reg c 3))
  (by
    (have k1 (<= 8 16) (arith))
    (have k2 (<= 16 24) (arith))
    (show (= (w64 (mem_le64 (Cpu.mem c8) (w64_val (w64_add (reg c8 4) (w64 8))))) (reg c 3)))
    (rw (bo_sp8 c c6 c8 kp6 kp8))
    (rw (bo_up1 c))
    (rw (fr_16 c f hf))
    (rw (both_word xs n rx c f c6 c8 16 k1 k2 hf dfx hso6 kp6 hmem8))
    (exact (bo_saved_rbx c f hf))))
(theorem both_r12
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (kp8 (kept (bo_m4 c6) c8))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (= (reg (bo_out c8) 12) (reg c 12))
  (by
    (have k1 (<= 8 8) (arith))
    (have k2 (<= 8 24) (arith))
    (show (= (w64 (mem_le64 (Cpu.mem c8) (w64_val (reg c8 4)))) (reg c 12)))
    (rw (bo_sp8 c c6 c8 kp6 kp8))
    (rw (fr_8 c f hf))
    (rw (both_word xs n rx c f c6 c8 8 k1 k2 hf dfx hso6 kp6 hmem8))
    (exact (bo_saved_r12 c f hf))))
;; what the code keeps of the state it was entered in
(theorem both_kept
  ((xs (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (c Cpu)
   (f Nat)
   (c6 Cpu)
   (c8 Cpu)
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (hso6
     (same_outside (Cpu.mem (bo_s5 c)) (Cpu.mem c6) (w64_val (reg c 7))
       (+ (w64_val (reg c 7)) (* 8 (w64_val n)))))
   (kp6 (kept (bo_s5 c) c6))
   (kp8 (kept (bo_m4 c6) c8))
   (hmem8 (= (Cpu.mem c8) (Cpu.mem (bo_m4 c6)))))
  (kept c (bo_out c8))
  (by
    (have hsegs6 (= (Cpu.segs c6) (Cpu.segs c)) (exact (kept_segs (bo_s5 c) c6 kp6)))
    (have hrbp6 (= (reg c6 5) (reg c 5)) (exact (kept_rbp (bo_s5 c) c6 kp6)))
    (have hr13x (= (reg c6 13) (reg c 13)) (exact (kept_r13 (bo_s5 c) c6 kp6)))
    (have hr14x (= (reg c6 14) (reg c 14)) (exact (kept_r14 (bo_s5 c) c6 kp6)))
    (have hr15x (= (reg c6 15) (reg c 15)) (exact (kept_r15 (bo_s5 c) c6 kp6)))
    (unfold kept)
    (apply And.intro
      ((show
         (= (w64_add (w64_add (w64_add (reg c8 4) (w64 8)) (w64 8)) (w64 8))
           (w64_add (reg c 4) (w64 8))))
       (rw (bo_sp8 c c6 c8 kp6 kp8))
       (rw (bo_up1 c))
       (rw (bo_up2 c))
       rfl)
      ((apply And.intro
         ((show (= (Cpu.segs c8) (Cpu.segs c))) (rw (kept_segs (bo_m4 c6) c8 kp8)) (exact hsegs6))
         ((apply And.intro ((exact (both_rbx xs n rx c f c6 c8 hf dfx hso6 kp6 kp8 hmem8)))
            ((apply And.intro
               ((show (= (reg c8 5) (reg c 5))) (rw (kept_rbp (bo_m4 c6) c8 kp8)) (exact hrbp6))
               ((apply And.intro ((exact (both_r12 xs n rx c f c6 c8 hf dfx hso6 kp6 kp8 hmem8)))
                  ((apply And.intro
                     ((show (= (reg c8 13) (reg c 13)))
                      (rw (kept_r13 (bo_m4 c6) c8 kp8))
                      (exact hr13x))
                     ((apply And.intro
                        ((show (= (reg c8 14) (reg c 14)))
                         (rw (kept_r14 (bo_m4 c6) c8 kp8))
                         (exact hr14x))
                        ((show (= (reg c8 15) (reg c 15)))
                         (rw (kept_r15 (bo_m4 c6) c8 kp8))
                         (exact hr15x)))))))))))))))))

;; ---- both: the contract -------------------------------------------------------------------------
;; The contract of `both`'s code. From a state at its first instruction whose rdi and rsi hold
;; the addresses of two buffers that hold two lists — the first mapped to read and to
;; write, the second to read, for the count in rdx — whose stack pointer stands 24 above an
;; address f, with the three words from f mapped to write and those and the return address to
;; read, the first buffer's counted words clear of the code and of the second buffer, and the
;; frame clear of the code and of both buffers: the processor comes to a state at the return
;; address with the value of `both t` in rax, the first buffer's memory holding the list
;; `both t` returns, the callee's registers as the caller had them, and every byte outside the
;; first buffer's counted words and the 24 bytes from f as it was.
(theorem both_contract
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (c Cpu)
   (f Nat)
   (hcode (code_in c buffers_table))
   (hn (= (reg c 2) n))
   (hx (holds (Cpu.mem c) (w64_val (reg c 7)) xs))
   (hy (holds (Cpu.mem c) (w64_val (reg c 6)) ys))
   (hmxr (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4))
   (hmxw (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 2))
   (hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4))
   (hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616))
   (hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616))
   (hf (= (w64_val (reg c 4)) (+ f 24)))
   (hfr (mapped_words (Cpu.segs c) f 4 4))
   (hfw (mapped_words (Cpu.segs c) f 3 2))
   (dcode
     (or (<= 4194603 (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 4194489)))
   (dy
     (or (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) (w64_val (reg c 6)))
       (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) (w64_val (reg c 7)))))
   (dfc (or (<= 4194603 f) (<= (+ f 24) 4194489)))
   (dfx (or (<= (+ f 32) (w64_val (reg c 7))) (<= (+ (w64_val (reg c 7)) (* 8 (List.length xs))) f)))
   (dfy (or (<= (+ f 24) (w64_val (reg c 6))) (<= (+ (w64_val (reg c 6)) (* 8 (List.length ys))) f))))
  (exists ((c2 Cpu))
    (and (reaches (at_pc c (w64 4194556)) c2)
      (and (= (reg c2 0) (Prod.fst (both xs ys n rx ry)))
        (and (holds (Cpu.mem c2) (w64_val (reg c 7)) (Prod.snd (both xs ys n rx ry)))
          (and
            (same_outside2 (Cpu.mem c) (Cpu.mem c2) (w64_val (reg c 7))
              (+ (w64_val (reg c 7)) (* 8 (w64_val n)))
              f
              (+ f 24))
            (returned c c2))))))
  (by
    (cases
      (both_first xs ys n rx ry c f hcode hn hx hy hmxr hmxw hmy hwx hwy hf hfr dcode dy dfc dfx dfy)
      ((intro (c6 hc6)
         (cases hc6
           ((intro (hreach6 hr6a)
              (cases hr6a
                ((intro (hx6 hr6b)
                   (cases hr6b
                     ((intro (hso6 hret6)
                        (have kp6 (kept (bo_s5 c) c6) (exact (returned_kept (bo_s5 c) c6 hret6)))
                        (cases
                          (both_second xs ys n rx ry c f c6 hcode hn hmxr hwx hf hfr hfw dcode dfc
                            dfx hx6 hso6 hret6)
                          ((intro (c8 hc8)
                             (cases hc8
                               ((intro (hreach8 hr8a)
                                  (cases hr8a
                                    ((intro (hcode8 hr8b)
                                       (cases hr8b
                                         ((intro (hv8 hr8c)
                                            (cases hr8c
                                              ((intro (hx8 hr8d)
                                                 (cases hr8d
                                                   ((intro (hmem8 hret8)
                                                      (have kp8 (kept (bo_m4 c6) c8)
                                                        (exact (returned_kept (bo_m4 c6) c8 hret8)))
                                                      (apply (Exists.intro (bo_out c8))
                                                        ((apply And.intro
                                                           ((exact
                                                              (reaches_trans (at_pc c (w64 4194556))
                                                                (at_pc (bo_s5 c) (w64 4194526))
                                                                (bo_out c8)
                                                                (both_enter c f hcode hf hfw dfc)
                                                                (reaches_trans
                                                                  (at_pc (bo_s5 c) (w64 4194526))
                                                                  c6
                                                                  (bo_out c8)
                                                                  hreach6
                                                                  (reaches_trans c6 c8 (bo_out c8)
                                                                    hreach8
                                                                    (both_exit c f c6 c8 hf hfr
                                                                      hcode8 kp6 hret8))))))
                                                           ((apply And.intro
                                                              ((show
                                                                 (= (reg c8 0)
                                                                   (dot (addto xs ys n rx ry)
                                                                     (addto xs ys n rx ry)
                                                                     n
                                                                     (addto_room xs ys n rx ry)
                                                                     (addto_room xs ys n rx ry))))
                                                               (exact hv8))
                                                              ((apply And.intro
                                                                 ((show
                                                                    (holds (Cpu.mem c8)
                                                                      (w64_val (reg c 7))
                                                                      (addto xs ys n rx ry)))
                                                                  (exact hx8))
                                                                 ((apply And.intro
                                                                    ((exact
                                                                       (both_foot n c f c6 c8 hf
                                                                         hso6 kp6 hmem8)))
                                                                    ((unfold returned)
                                                                     (apply And.intro
                                                                       ((exact
                                                                          (both_ret xs n rx c f c6
                                                                            c8 hf dfx hso6 kp6 kp8
                                                                            hmem8)))
                                                                       ((exact
                                                                          (both_kept xs n rx c f c6
                                                                            c8 hf dfx hso6 kp6 kp8
                                                                            hmem8))))))))))))))))))))))))))))))))))))))))))))))
