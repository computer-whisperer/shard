;;; v3/models/x86/buffers.shard — a trial of low-level code as shard (docs/COMPILE.md §4): three
;;; functions over buffers of machine words — a sum of products, a sum into the first buffer, and
;;; a caller of both — written as ordinary shard, and a listing for them compiled BY HAND, one
;;; instruction or two for each operation of the source. A buffer is a value: in the logic it is
;;; its contents, a list of words. A read or a write takes the evidence that its index is one of
;;; the buffer's (`word_at`, `put_at`), so the function is total and the listing checks no index.
;;; `addto` returns a new list; its listing writes into the buffer it was given. What is proven
;;; of the listing is in `buffers_facts.shard`.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "../../std/list.shard")
(import "asm.shard")
(import "linux.shard")
(import "words.shard")
(use std.bytes)
(use std.host)
(use std.list)
(use models.x86.asm)
(use models.x86.asm.Asm)
(use models.x86.elf)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the three functions ----------------------------------------------------------------------
;; Each takes two buffers and a count, with the evidence that each buffer holds that many words.
;; In a listing the evidence is nothing: three registers, the two addresses and the count.
;; the sum of the products of the two buffers' words, from index i to the count, added to acc
(fn dot_go
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (acc (BitVec 64)))
  (BitVec 64)
  (measure (- (w64_val n) (w64_val i)))
  (dif h (< (w64_val i) (w64_val n))
    (dot_go xs ys n rx ry (w64_add i (w64 1))
      (w64_add acc
        (w64_mul (word_at xs i (Nat.lt_of_lt_of_le h rx)) (word_at ys i (Nat.lt_of_lt_of_le h ry)))))
    acc))
(fulfills dot_go.dec_1 (by (intro p h) (apply loop_descends (exact h))))
(fn dot
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (BitVec 64)
  (dot_go xs ys n rx ry (w64 0) (w64 0)))
;; the function's own two cases
(theorem dot_go_turn
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (= (dot_go xs ys n rx ry i acc)
    (dot_go xs ys n rx ry (w64_add i (w64 1))
      (w64_add acc
        (w64_mul (word_at xs i (Nat.lt_of_lt_of_le h rx)) (word_at ys i (Nat.lt_of_lt_of_le h ry))))))
  (by (rw dot_go.eq_1 (occ 1)) (rw (dif_pos h)) rfl))
(theorem dot_go_done
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (Not (< (w64_val i) (w64_val n)))))
  (= (dot_go xs ys n rx ry i acc) acc)
  (by (rw dot_go.eq_1) (rw (dif_neg h)) rfl))

;; the first buffer after one word of the sum: its word at index i the sum of that word and the
;; second buffer's
(fn addto_next
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (List (BitVec 64))
  (put_at xs i
    (w64_add (word_at xs i (Nat.lt_of_lt_of_le h rx)) (word_at ys i (Nat.lt_of_lt_of_le h ry)))
    (Nat.lt_of_lt_of_le h rx)))
;; the evidence carried past that write
(theorem addto_next_room
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (<= (w64_val n) (List.length (addto_next xs ys n rx ry i h)))
  (exact
    (put_at_room xs i
      (w64_add (word_at xs i (Nat.lt_of_lt_of_le h rx)) (word_at ys i (Nat.lt_of_lt_of_le h ry)))
      (Nat.lt_of_lt_of_le h rx)
      n
      rx)))
;; the first buffer with each word from index i to the count the sum of that word and the second
;; buffer's: a new list in the logic, the same buffer written in the listing
(fn addto_go
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64)))
  (List (BitVec 64))
  (measure (- (w64_val n) (w64_val i)))
  (dif h (< (w64_val i) (w64_val n))
    (addto_go (addto_next xs ys n rx ry i h) ys n (addto_next_room xs ys n rx ry i h) ry
      (w64_add i (w64 1)))
    xs))
(fulfills addto_go.dec_1 (by (intro p h) (apply loop_descends (exact h))))
(fn addto
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (List (BitVec 64))
  (addto_go xs ys n rx ry (w64 0)))
;; the function's own two cases
(theorem addto_go_turn
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (= (addto_go xs ys n rx ry i)
    (addto_go (addto_next xs ys n rx ry i h) ys n (addto_next_room xs ys n rx ry i h) ry
      (w64_add i (w64 1))))
  (by (rw addto_go.eq_1 (occ 1)) (rw (dif_pos h)) rfl))
(theorem addto_go_done
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (i (BitVec 64))
   (h (Not (< (w64_val i) (w64_val n)))))
  (= (addto_go xs ys n rx ry i) xs)
  (by (rw addto_go.eq_1) (rw (dif_neg h)) rfl))
;; the sum is as long as the first buffer was, so the evidence about the first buffer holds of it
(theorem addto_go_length
  ((ys (List (BitVec 64))) (n (BitVec 64)) (ry (<= (w64_val n) (List.length ys))) (k Nat))
  (forall ((xs (List (BitVec 64))) (rx (<= (w64_val n) (List.length xs))) (i (BitVec 64)))
    (-> (= (- (w64_val n) (w64_val i)) k)
      (= (List.length (addto_go xs ys n rx ry i)) (List.length xs))))
  (by
    (wf k k ih (intro xs rx i hk)
      (cases (Nat.decLt (w64_val i) (w64_val n))
        ((isFalse (h) (rw (addto_go_done xs ys n rx ry i h)) rfl)
         (isTrue (h)
           (have hdec (< (- (w64_val n) (w64_val (w64_add i (w64 1)))) k)
             (rw (<- hk))
             (exact (loop_descends n i h)))
           (rw (addto_go_turn xs ys n rx ry i h))
           (rw
             (ih (- (w64_val n) (w64_val (w64_add i (w64 1)))) hdec (addto_next xs ys n rx ry i h)
               (addto_next_room xs ys n rx ry i h)
               (w64_add i (w64 1))
               (Eq.refl (- (w64_val n) (w64_val (w64_add i (w64 1)))))))
           (exact
             (upd_length xs (w64_val i)
               (w64_add (word_at xs i (Nat.lt_of_lt_of_le h rx))
                 (word_at ys i (Nat.lt_of_lt_of_le h ry)))))))))))
(theorem addto_length
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (= (List.length (addto xs ys n rx ry)) (List.length xs))
  (exact
    (addto_go_length ys n ry (- (w64_val n) (w64_val (w64 0))) xs rx (w64 0)
      (Eq.refl (- (w64_val n) (w64_val (w64 0)))))))
(theorem addto_room
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (<= (w64_val n) (List.length (addto xs ys n rx ry)))
  (by (rw (addto_length xs ys n rx ry)) (exact rx)))

;; the second buffer added into the first, then the sum of the squares of the result — the one
;; buffer read as both operands, on the evidence that the sum is as long as the first buffer
;; was — with the first buffer as it then is
(fn both
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (Prod (BitVec 64) (List (BitVec 64)))
  (let ((s (addto xs ys n rx ry)))
    (Prod.mk (dot s s n (addto_room xs ys n rx ry) (addto_room xs ys n rx ry)) s)))

;; ---- the listing, by hand ---------------------------------------------------------------------
;; A buffer is the address of its first word; the two addresses arrive in rdi and rsi and the
;; count in rdx, and a result leaves in rax. `addto` writes through the address it was given, so
;; what it returns in the logic is where its first argument was. `both` keeps the first address
;; and the count in rbx and r12 across its calls, and saves those two on the stack.
;; Labels: 1 dot, 2 its loop, 3 its end; 4 addto, 5 its loop, 6 its end; 7 both.
;; `dot`'s lines stand on their own, so that another file can have them as they are
(fn dot_asm () (List Asm)
  (list
    ;; dot: rax the sum, rcx the index
    (ALabel 1)
    (AI (AluRmR BXor (RmReg 0) 0))  ; xor rax, rax
    (AI (AluRmR BXor (RmReg 1) 1))  ; xor rcx, rcx
    (ALabel 2)
    (AI (AluRmR BCmp (RmReg 1) 2))  ; cmp rcx, rdx
    (AJcc 3 3)  ; jae end
    (AI (MovRRm 8 (RmSib 7 1 8 0)))  ; mov r8, [rdi+rcx*8]
    (AI (ImulRRm 8 (RmSib 6 1 8 0)))  ; imul r8, [rsi+rcx*8]
    (AI (AluRmR BAdd (RmReg 0) 8))  ; add rax, r8
    (AI (AluRmI BAdd (RmReg 1) 1))  ; add rcx, 1
    (AJmp 2)
    (ALabel 3)
    (AI Ret)))
(fn buffers_listing () (List Asm)
  (List.append
    (list
      ;; the process's first instructions: the words 3 5 7 and 2 4 6 pushed as two buffers, `both`
      ;; called on them with the count 3, exit with the low byte of its result
      (AI (MovRI32 7 7))
      (AI (Push 7))
      (AI (MovRI32 7 5))
      (AI (Push 7))
      (AI (MovRI32 7 3))
      (AI (Push 7))
      (AI (MovRmR (RmReg 14) 4))  ; mov r14, rsp
      (AI (MovRI32 7 6))
      (AI (Push 7))
      (AI (MovRI32 7 4))
      (AI (Push 7))
      (AI (MovRI32 7 2))
      (AI (Push 7))
      (AI (MovRmR (RmReg 6) 4))  ; mov rsi, rsp
      (AI (MovRmR (RmReg 7) 14))  ; mov rdi, r14
      (AI (MovRI32 2 3))  ; mov edx, 3
      (ACall 7)
      (AI (MovRmR (RmReg 7) 0))  ; mov rdi, rax
      (AI (MovRI32 0 60))
      (AI Syscall))
    (List.append dot_asm
      (list
        ;; addto: rcx the index
        (ALabel 4)
        (AI (AluRmR BXor (RmReg 1) 1))  ; xor rcx, rcx
        (ALabel 5)
        (AI (AluRmR BCmp (RmReg 1) 2))  ; cmp rcx, rdx
        (AJcc 3 6)  ; jae end
        (AI (MovRRm 8 (RmSib 6 1 8 0)))  ; mov r8, [rsi+rcx*8]
        (AI (AluRmR BAdd (RmSib 7 1 8 0) 8))  ; add [rdi+rcx*8], r8
        (AI (AluRmI BAdd (RmReg 1) 1))  ; add rcx, 1
        (AJmp 5)
        (ALabel 6)
        (AI Ret)
        ;; both
        (ALabel 7)
        (AI (Push 3))  ; push rbx
        (AI (Push 12))  ; push r12
        (AI (MovRmR (RmReg 3) 7))  ; mov rbx, rdi
        (AI (MovRmR (RmReg 12) 2))  ; mov r12, rdx
        (ACall 4)  ; call addto
        (AI (MovRmR (RmReg 7) 3))  ; mov rdi, rbx
        (AI (MovRmR (RmReg 6) 3))  ; mov rsi, rbx
        (AI (MovRmR (RmReg 2) 12))  ; mov rdx, r12
        (ACall 1)  ; call dot
        (AI (Pop 12))
        (AI (Pop 3))
        (AI Ret)))))
;; the listing's file; no bytes where the assembler answers nothing
(fn buffers_file () (List Nat)
  (match (assemble buffers_listing)
    (none nil)
    ((some code) (elf_exec code))))

;; `dot`'s own rows, from its first instruction to its return: what `dot`'s contract is stated
;; over, so that it holds in any file whose table has these rows at these addresses
(fn dot_rows () (List (Prod Nat (Prod Instr Nat)))
  (list (Prod.mk 4194489 (Prod.mk (AluRmR BXor (RmReg 0) 0) 3))
    (Prod.mk 4194492 (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))
    (Prod.mk 4194495 (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))
    (Prod.mk 4194498 (Prod.mk (Jcc 3 21) 6))
    (Prod.mk 4194504 (Prod.mk (MovRRm 8 (RmSib 7 1 8 0)) 4))
    (Prod.mk 4194508 (Prod.mk (ImulRRm 8 (RmSib 6 1 8 0)) 5))
    (Prod.mk 4194513 (Prod.mk (AluRmR BAdd (RmReg 0) 8) 3))
    (Prod.mk 4194516 (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))
    (Prod.mk 4194520 (Prod.mk (Jmp 18446744073709551586) 5))
    (Prod.mk 4194525 (Prod.mk Ret 1))))
;; the listing's instructions by address, as its file holds them: the assembler's layout of the
;; listing (`buffers_run.shard` `buffers_laid`), and what the contracts of the code are stated over
(fn buffers_table () (List (Prod Nat (Prod Instr Nat)))
  (List.append
    (list
      ;; the process's first instructions
      (Prod.mk 4194424 (Prod.mk (MovRI32 7 7) 5))
      (Prod.mk 4194429 (Prod.mk (Push 7) 1))
      (Prod.mk 4194430 (Prod.mk (MovRI32 7 5) 5))
      (Prod.mk 4194435 (Prod.mk (Push 7) 1))
      (Prod.mk 4194436 (Prod.mk (MovRI32 7 3) 5))
      (Prod.mk 4194441 (Prod.mk (Push 7) 1))
      (Prod.mk 4194442 (Prod.mk (MovRmR (RmReg 14) 4) 3))
      (Prod.mk 4194445 (Prod.mk (MovRI32 7 6) 5))
      (Prod.mk 4194450 (Prod.mk (Push 7) 1))
      (Prod.mk 4194451 (Prod.mk (MovRI32 7 4) 5))
      (Prod.mk 4194456 (Prod.mk (Push 7) 1))
      (Prod.mk 4194457 (Prod.mk (MovRI32 7 2) 5))
      (Prod.mk 4194462 (Prod.mk (Push 7) 1))
      (Prod.mk 4194463 (Prod.mk (MovRmR (RmReg 6) 4) 3))
      (Prod.mk 4194466 (Prod.mk (MovRmR (RmReg 7) 14) 3))
      (Prod.mk 4194469 (Prod.mk (MovRI32 2 3) 5))
      (Prod.mk 4194474 (Prod.mk (Call 77) 5))
      (Prod.mk 4194479 (Prod.mk (MovRmR (RmReg 7) 0) 3))
      (Prod.mk 4194482 (Prod.mk (MovRI32 0 60) 5))
      (Prod.mk 4194487 (Prod.mk Syscall 2)))
    (List.append dot_rows
      (list
        ;; addto
        (Prod.mk 4194526 (Prod.mk (AluRmR BXor (RmReg 1) 1) 3))
        (Prod.mk 4194529 (Prod.mk (AluRmR BCmp (RmReg 1) 2) 3))
        (Prod.mk 4194532 (Prod.mk (Jcc 3 17) 6))
        (Prod.mk 4194538 (Prod.mk (MovRRm 8 (RmSib 6 1 8 0)) 4))
        (Prod.mk 4194542 (Prod.mk (AluRmR BAdd (RmSib 7 1 8 0) 8) 4))
        (Prod.mk 4194546 (Prod.mk (AluRmI BAdd (RmReg 1) 1) 4))
        (Prod.mk 4194550 (Prod.mk (Jmp 18446744073709551590) 5))
        (Prod.mk 4194555 (Prod.mk Ret 1))
        ;; both
        (Prod.mk 4194556 (Prod.mk (Push 3) 1))
        (Prod.mk 4194557 (Prod.mk (Push 12) 2))
        (Prod.mk 4194559 (Prod.mk (MovRmR (RmReg 3) 7) 3))
        (Prod.mk 4194562 (Prod.mk (MovRmR (RmReg 12) 2) 3))
        (Prod.mk 4194565 (Prod.mk (Call 18446744073709551572) 5))
        (Prod.mk 4194570 (Prod.mk (MovRmR (RmReg 7) 3) 3))
        (Prod.mk 4194573 (Prod.mk (MovRmR (RmReg 6) 3) 3))
        (Prod.mk 4194576 (Prod.mk (MovRmR (RmReg 2) 12) 3))
        (Prod.mk 4194579 (Prod.mk (Call 18446744073709551521) 5))
        (Prod.mk 4194584 (Prod.mk (Pop 12) 2))
        (Prod.mk 4194586 (Prod.mk (Pop 3) 1))
        (Prod.mk 4194587 (Prod.mk Ret 1))))))

;; ---- the same, run in the logic ---------------------------------------------------------------
;; the two buffers the file's first instructions push, the evidence about them, and the value of
;; `both` of them
(fn sample_xs () (List (BitVec 64)) (cons (w64 3) (cons (w64 5) (cons (w64 7) nil))))
(fn sample_ys () (List (BitVec 64)) (cons (w64 2) (cons (w64 4) (cons (w64 6) nil))))
(theorem sample_rx () (<= (w64_val (w64 3)) (List.length sample_xs)) (by decide))
(theorem sample_ry () (<= (w64_val (w64 3)) (List.length sample_ys)) (by decide))
(fn sample_value () (BitVec 64) (Prod.fst (both sample_xs sample_ys (w64 3) sample_rx sample_ry)))
;; the file written to the path given; the status is the low byte of that value as the evaluator
;; computes it, which is what the file's own run exits with
(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats buffers_file) w)
    ((Prod.mk ok w1) (exit (if ok (% (w64_val sample_value) 256) 1) w1))))
