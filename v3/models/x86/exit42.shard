;;; v3/models/x86/exit42.shard — the first program through the machine: twelve bytes that end a
;;; process with status 42, in the file Linux runs, and the theorem that the model's run of that
;;; file ends so, whatever the registers and flags at its start. `main` writes the file.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "elf.shard")
(import "linux.shard")
(use std.bytes)
(use std.host)
(use models.x86.elf)
(use models.x86.linux)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use models.x86.linux.Res)

;; mov edi, 42 (BF 2A 00 00 00); mov eax, 60 (B8 3C 00 00 00); syscall (0F 05)
(fn exit42_code () (List Nat) (list 191 42 0 0 0 184 60 0 0 0 15 5))
(fn exit42_file () (List Nat) (elf_exec exit42_code))

;; three steps from any registers and flags, and the process has exited with 42
(theorem exit42_run ((r Regs) (f Flags)) (= (run_file (FS (FS (FS FZ))) exit42_file r f) (RExit 42))
  (by rfl))
(theorem exit42_exits ((r Regs) (f Flags)) (exits exit42_file r f 42)
  (by (apply (Exists.intro (FS (FS (FS FZ)))) ((exact (exit42_run r f))))))

;; the file, written to the path given
(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats exit42_file) w)
    ((Prod.mk ok w1) (exit (if ok 0 1) w1))))
