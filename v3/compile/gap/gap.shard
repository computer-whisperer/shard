;;; v3/compile/gap/gap.shard — the implementation of the view: the low form, each call of
;;; `sqdiff` in it the low form of `sqdiff`'s view; the first fact by the same fact of
;;; `sqdiff`, once for each call; and the tie, a rule of the machine for each statement and at
;;; each call the answer of `sqdiff`'s low form on words that have the evidence.
(import "../sqdiff")
(import "../two.shard")
(import "../gap_src.shard")
(import "../sqdiff_src.shard")
(import "../gap_obj.shard")
(import "../ir_laws.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.ir_laws)
(use compile.sqdiff)
(use compile.gap_src)
(use compile.sqdiff_src)
(use compile.gap_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn gap_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (BitVec 64)
  (w64_sub (sqdiff_lo rs m px py n ex ey) (sqdiff_lo rs m py px n ey ex)))
(fulfills gap_lo_means
  (by
    (rw gap_lo.eq_1)
    (show
      (= (w64_sub (sqdiff_lo rs m px py n ex ey) (sqdiff_lo rs m py px n ey ex))
        (w64_sub (sqdiff xs ys n rx ry) (sqdiff ys xs n ry rx))))
    (rw (sqdiff_lo_means rs m px py n ex ey xs ys rx ry hx hy))
    (rw (sqdiff_lo_means rs m py px n ey ex ys xs ry rx hy hx))
    rfl))
(fulfills gap_tie
  (by
    (rw gap_lo.eq_1)
    (apply And.intro (rfl)
      ((apply (iends_call_ext (cons px (cons py (cons n nil))) (sqdiff_lo rs m px py n ex ey) m)
         (rfl)
         ((rw (hd (cons px (cons py (cons n nil))) m))
          (exact (two_ext_is sqdiff_lo rs m px py n ex ey)))
         ((apply (iends_call_ext (cons py (cons px (cons n nil))) (sqdiff_lo rs m py px n ey ex) m)
            (rfl)
            ((rw (hd (cons py (cons px (cons n nil))) m))
             (exact (two_ext_is sqdiff_lo rs m py px n ey ex)))
            ((apply iends_ret (rfl))))))))))
