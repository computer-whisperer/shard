;;; v3/compile/sqdiff_ir.shard — the intermediate code of `sqdiff_lo` (`sqdiff_lo.shard`),
;;; written by hand, and the tie (docs/COMPILE.md §5, the front step). The code calls `dot` as a
;;; function OUTSIDE its module: of `dot` it has an answer — a function of the argument words
;;; and the memory — and no code. The tie holds with any outside functions whose function 0
;;; answers as `dot_ext` does (`dot_lo.shard`: the low form's value where the evidence exists);
;;; who wrote `dot`'s instructions, and where they stand, is a file's matter.
(import "sqdiff_lo.shard")
(import "ir_laws.shard")
(use std.mem)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use compile.dot_lo)
(use compile.lo)
(use compile.sqdiff_lo)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the code ----------------------------------------------------------------------------------
;; Locals: 0 px, 1 py, 2 n, then the two sums. One function, the module's only one.
(fn sqdiff_code () IFn
  (MkIFn 3 2
    (SCall 3 (CExt 0) (list (EVar 0) (EVar 0) (EVar 2))
      (SCall 4 (CExt 0) (list (EVar 1) (EVar 1) (EVar 2)) (SRet (EOp OSub (EVar 3) (EVar 4)))))))
(fn sqdiff_prog () (List IFn) (list sqdiff_code))
;; the functions the module calls from outside, by their answers: one, `dot`
(def sqdiff_ext ((rs (List Seg)) (j Nat) (vs (List (BitVec 64))) (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (if (= j 0) (dot_ext rs vs m) none))

;; ---- the tie -----------------------------------------------------------------------------------
;; in any program, with any outside functions whose function 0 answers as `dot_ext`: a rule of
;; the machine for each statement, and at each call `dot_ext` on words that have the evidence
(theorem sqdiff_tie
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (hd (forall ((vs (List (BitVec 64))) (m1 Mem)) (= (ext 0 vs m1) (dot_ext rs vs m1)))))
  (fn_ans p ext rs sqdiff_code (cons px (cons py (cons n nil))) m (sqdiff_lo rs m px py n ex ey) m)
  (by
    (apply And.intro (rfl)
      ((apply (iends_call_ext (cons px (cons px (cons n nil))) (dot_lo rs m px px n ex ex) m) (rfl)
         ((rw (hd (cons px (cons px (cons n nil))) m)) (exact (dot_ext_is rs m px px n ex ex)))
         ((apply (iends_call_ext (cons py (cons py (cons n nil))) (dot_lo rs m py py n ey ey) m)
            (rfl)
            ((rw (hd (cons py (cons py (cons n nil))) m)) (exact (dot_ext_is rs m py py n ey ey)))
            ((apply iends_ret (rfl))))))))))
;; the module, with its own outside functions
(theorem sqdiff_prog_tie
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code (cons px (cons py (cons n nil))) m
    (sqdiff_lo rs m px py n ex ey)
    m)
  (by
    (have hd
      (forall ((vs (List (BitVec 64))) (m1 Mem)) (= (sqdiff_ext rs 0 vs m1) (dot_ext rs vs m1)))
      (intro vs m1)
      rfl)
    (exact (sqdiff_tie sqdiff_prog (sqdiff_ext rs) rs m px py n ex ey hd))))
(theorem sqdiff_code_is () (= (fn_at sqdiff_prog 0) (some sqdiff_code)) (by rfl))

;; ---- the code's answer is the meaning's value -----------------------------------------------------
;; the tie and the first fact: in a memory that holds xs and ys at px and py, the code answers
;; `sqdiff xs ys` and leaves the memory as it was
(theorem sqdiff_answer
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code (cons px (cons py (cons n nil))) m
    (sqdiff xs ys n rx ry)
    m)
  (by
    (rw (<- (sqdiff_lo_means rs m px py n ex ey xs ys rx ry hx hy)))
    (exact (sqdiff_prog_tie rs m px py n ex ey))))
;; on the sample arguments (`dot_lo.shard`), in any memory that holds the two sample buffers
(theorem sample_sqdiff_answer
  ((m Mem) (hx (holds m 140737488347112 sample_xs)) (hy (holds m 140737488347088 sample_ys)))
  (fn_ans sqdiff_prog (sqdiff_ext sample_rs) sample_rs sqdiff_code
    (cons (w64 140737488347112) (cons (w64 140737488347088) (cons (w64 3) nil)))
    m
    (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)
    m)
  (exact
    (sqdiff_answer sample_rs m (w64 140737488347112) (w64 140737488347088) (w64 3) sample_ex
      sample_ey
      sample_xs
      sample_ys
      sample_rx
      sample_ry
      hx
      hy)))
