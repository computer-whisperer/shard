;;; v3/compile/addto/low.shard — the loop of `addto`'s low form: each read through `rd64` and the
;;; write through `wr64`, each with the evidence that its address is in the ranges; and the
;;; loop's one equation at each side of its test. The evidence is about the ranges and not about
;;; the memory, so it goes round the loop as it is while the memory changes.
(import "../lo.shard")
(use std.mem)
(use compile.lo)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)

(fn addto_lo_go
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64)))
  Mem
  (measure (- (w64_val n) (w64_val i)))
  (dif h (< (w64_val i) (w64_val n))
    (addto_lo_go rs
      (wr64 rs m (w64_add px (w64_mul (w64 8) i))
        (w64_add (rd64 rs m (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h))
          (rd64 rs m (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h)))
        (at8_ok rs px n 2 i ew h))
      px
      py
      n
      ex
      ew
      ey
      (w64_add i (w64 1)))
    m))
(fulfills addto_lo_go.dec_1 (by (intro p h) (apply loop_descends (exact h))))

(theorem addto_lo_go_turn
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (= (addto_lo_go rs m px py n ex ew ey i)
    (addto_lo_go rs
      (wr64 rs m (w64_add px (w64_mul (w64 8) i))
        (w64_add (rd64 rs m (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h))
          (rd64 rs m (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h)))
        (at8_ok rs px n 2 i ew h))
      px
      py
      n
      ex
      ew
      ey
      (w64_add i (w64 1))))
  (by (rw addto_lo_go.eq_1 (occ 1)) (rw (dif_pos h)) rfl))
(theorem addto_lo_go_done
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64))
   (h (Not (< (w64_val i) (w64_val n)))))
  (= (addto_lo_go rs m px py n ex ew ey i) m)
  (by (rw addto_lo_go.eq_1) (rw (dif_neg h)) rfl))
