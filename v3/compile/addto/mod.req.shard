;;; v3/compile/addto — the module of `addto`: the second buffer's words added into the first
;;; (docs/COMPILE.md §5). This view is the whole of what any other file knows of it. The low form
;;; as a signature: a function of the ranges, the memory, two addresses and a count as words,
;;; and the evidence it asks for — the first buffer in the ranges to read and to write, the
;;; second to read, the two apart —, whose value is a word and the memory after. And its facts
;;; as laws the module proves: the memory after holds at the first address the list the meaning
;;; returns (`addto`, models/x86/buffers.shard); every byte outside the first buffer's words is
;;; as it was; and the run of the module's intermediate code (../addto_obj.shard) answers the
;;; low form's word and memory. The low form as the answer of a function called from outside its
;;; module is `upd_ext addto_lo` (../upd.shard).
(import "../lo.shard")
(import "../upd.shard")
(import "../addto_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.upd)
(use compile.addto_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the low form -------------------------------------------------------------------------------
(sig fn addto_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (Prod (BitVec 64) Mem))

;; ---- the first fact: what the memory after holds -------------------------------------------------
;; where two lists stand in memory at the two addresses, the list `addto` returns stands at the
;; first
(requirement addto_lo_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (holds (Prod.snd (addto_lo rs m px py n ex ew ey ea)) (w64_val px) (addto xs ys n rx ry)))
;; ---- what it leaves alone -------------------------------------------------------------------------
;; every byte outside the first buffer's n words is as it was
(requirement addto_lo_keeps
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (same_outside m (Prod.snd (addto_lo rs m px py n ex ew ey ea)) (w64_val px)
    (+ (w64_val px) (* 8 (w64_val n)))))

;; ---- the second fact's front step: the code's run answers the low form ----------------------------
(requirement addto_prog_tie
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (fn_ans addto_prog ext rs addto_code (cons px (cons py (cons n nil))) m
    (Prod.fst (addto_lo rs m px py n ex ew ey ea))
    (Prod.snd (addto_lo rs m px py n ex ew ey ea))))
;; whatever the low form's answer says (`upd_ans`), the code's run answers
(theorem addto_ans_tie
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (upd_ans addto_lo rs vs m v m2)))
  (fn_ans addto_prog ext rs addto_code vs m v m2)
  (exact
    (upd_ans_tie addto_lo addto_prog ext rs addto_code
      (fun
        ((m1 Mem)
         (px (BitVec 64))
         (py (BitVec 64))
         (n (BitVec 64))
         (ex (buf_ok rs px n 4))
         (ew (buf_ok rs px n 2))
         (ey (buf_ok rs py n 4))
         (ea (apart px py n)))
        (addto_prog_tie ext rs m1 px py n ex ew ey ea))
      vs
      m
      v
      m2
      h)))
