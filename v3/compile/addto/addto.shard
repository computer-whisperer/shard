;;; v3/compile/addto/addto.shard — the implementation of the view: the low form is the loop from
;;; index 0, with the word 0; each of the view's three laws is the loop's fact at that start.
(import "low.shard")
(import "mean.shard")
(import "tie.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.upd)
(use compile.addto_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn addto_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (Prod (BitVec 64) Mem)
  (Prod.mk (w64 0) (addto_lo_go rs m px py n ex ew ey (w64 0))))
(fulfills addto_lo_means
  (by
    (rw addto_lo.eq_1)
    (show
      (holds (addto_lo_go rs m px py n ex ew ey (w64 0)) (w64_val px)
        (addto_go xs ys n rx ry (w64 0))))
    (exact
      (addto_lo_go_means rs m px py n ex ew ey ea ys ry hy (- (w64_val n) (w64_val (w64 0))) m xs rx
        (w64 0)
        (Eq.refl (- (w64_val n) (w64_val (w64 0))))
        (same_outside_refl m (w64_val px) (+ (w64_val px) (* 8 (w64_val n))))
        hx))))
(fulfills addto_lo_keeps
  (by
    (rw addto_lo.eq_1)
    (show
      (same_outside m (addto_lo_go rs m px py n ex ew ey (w64 0)) (w64_val px)
        (+ (w64_val px) (* 8 (w64_val n)))))
    (exact
      (addto_lo_go_keeps rs m px py n ex ew ey (- (w64_val n) (w64_val (w64 0))) m (w64 0)
        (Eq.refl (- (w64_val n) (w64_val (w64 0))))
        (same_outside_refl m (w64_val px) (+ (w64_val px) (* 8 (w64_val n))))))))
(fulfills addto_prog_tie
  (by
    (rw addto_lo.eq_1)
    (exact (addto_tie addto_prog ext rs m px py n ex ew ey (Eq.refl (some addto_go_code))))))
