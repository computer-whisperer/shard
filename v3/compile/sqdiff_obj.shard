;;; v3/compile/sqdiff_obj.shard — the intermediate code of `sqdiff`'s module (docs/COMPILE.md
;;; §5): the code as data, which the pass reads and a file's writer runs. It calls `dot` as
;;; a function OUTSIDE its module: of `dot` the code has an index and no code. Written by
;;; hand from the low form in the directory `sqdiff`, whose view states what its run answers.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use Init.List cons nil)
(use Init.Option none some)

;; Locals: 0 px, 1 py, 2 n, then the two values. One function, the module's only one.
(fn sqdiff_code () IFn
  (MkIFn 3 2
    (SCall 3 (CExt 0) (list (EVar 0) (EVar 0) (EVar 2))
      (SCall 4 (CExt 0) (list (EVar 1) (EVar 1) (EVar 2)) (SRet (EOp OSub (EVar 3) (EVar 4)))))))
(fn sqdiff_prog () (List IFn) (list sqdiff_code))
(theorem sqdiff_code_is () (= (fn_at sqdiff_prog 0) (some sqdiff_code)) (by rfl))
