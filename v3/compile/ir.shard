;;; v3/compile/ir.shard — the intermediate machine (docs/COMPILE.md §5): a language a little
;;; above x86, in tail form. A function's body is a tree: a local set from an
;;; expression, a store, a call whose result is a local, a two-way branch, and at each leaf a
;;; return or a tail call. There is no loop form: a loop is a function that tail-calls itself.
;;; Locals are 64-bit words and have no address. Memory is the machine's bytes with the ranges
;;; this run may read (4) and write (2); an access outside them has no rule. A callee is a
;;; function of the same program, or an external one whose answer the run is given: from the
;;; argument words and the memory, a result word and the memory after, or nothing.
;;; A run is big-step, counted by a fuel no statement mentions: every statement run takes one.
(import "../models/x86/words.shard")
(import "../models/x86/x86.shard")
(use std.mem)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(type IOp (OAdd) (OSub) (OMul) (OAnd) (OOr) (OXor))
(type ICmp (CLtu) (CGeu) (CEq) (CNe))
(type ICallee (CFn Nat) (CExt Nat))
(type IExp (ENum (BitVec 64)) (EVar Nat) (EOp IOp IExp IExp) (ELoad IExp))
(type IStm
  (SLet Nat IExp IStm)
  (SStore IExp IExp IStm)
  (SCall Nat ICallee (List IExp) IStm)
  (SIf IExp ICmp IExp IStm IStm)
  (SRet IExp)
  (STail ICallee (List IExp)))
;; a function: how many parameters it takes, how many locals it has beyond them, and its body
(record IFn (params Nat) (extra Nat) (body IStm))

(fn iop ((o IOp) (a (BitVec 64)) (b (BitVec 64))) (BitVec 64)
  (match o
    (OAdd (w64_add a b))
    (OSub (w64_sub a b))
    (OMul (w64_mul a b))
    (OAnd (w64_and a b))
    (OOr (w64_or a b))
    (OXor (w64_xor a b))))
(fn icmp ((c ICmp) (a (BitVec 64)) (b (BitVec 64))) Bool
  (match c
    (CLtu (w64_ltu a b))
    (CGeu (if (w64_ltu a b) false true))
    (CEq (if (= (w64_val a) (w64_val b)) true false))
    (CNe (if (= (w64_val a) (w64_val b)) false true))))

;; an expression's word; nothing where it reads outside the ranges
(fn ieval ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (e IExp)) (Option (BitVec 64))
  (measure (struct e))
  (match e
    ((ENum w) (some w))
    ((EVar i) (some (nth ls i)))
    ((EOp o a b)
     (match (ieval rs ls m a)
       (none none)
       ((some x)
        (match (ieval rs ls m b)
          (none none)
          ((some y) (some (iop o x y)))))))
    ((ELoad a)
     (match (ieval rs ls m a)
       (none none)
       ((some q) (if (mapped rs (w64_val q) 8 4) (some (w64 (mem_le64 m (w64_val q)))) none))))))
(fn ievals ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (es (List IExp)))
  (Option (List (BitVec 64)))
  (measure (struct es))
  (match es
    (nil (some nil))
    ((cons e r)
     (match (ieval rs ls m e)
       (none none)
       ((some v)
        (match (ievals rs ls m r)
          (none none)
          ((some vs) (some (cons v vs)))))))))

(fn fn_at ((p (List IFn)) (i Nat)) (Option IFn)
  (measure (struct p))
  (match p
    (nil none)
    ((cons f r) (if (= i 0) (some f) (fn_at r (- i 1))))))
(fn zeros ((n Nat)) (List (BitVec 64)) (measure n) (if (= n 0) nil (cons (w64 0) (zeros (- n 1)))))
(fulfills zeros.dec_1 (by (intro p h) (exact (Nat.sub_one_lt h))))
(fn app ((xs (List (BitVec 64))) (ys (List (BitVec 64)))) (List (BitVec 64))
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (app r ys)))))
;; a function's locals at its entry: the arguments, then its other locals at 0
(fn enter ((g IFn) (vs (List (BitVec 64)))) (List (BitVec 64)) (app vs (zeros (IFn.extra g))))

;; ---- a run ------------------------------------------------------------------------------------
;; The statement s run to its return, with the locals ls and the memory m: the word returned and
;; the memory after. Nothing where the fuel runs out, an access lies outside the ranges, a callee
;; is not there, or an external answers nothing.
(fn irun
  ((n Fuel)
   (p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (measure (struct n))
  (match n
    (FZ none)
    ((FS n1)
     (match s
       ((SLet x e k)
        (match (ieval rs ls m e)
          (none none)
          ((some v) (irun n1 p ext rs k (upd ls x v) m))))
       ((SStore a e k)
        (match (ieval rs ls m a)
          (none none)
          ((some q)
           (match (ieval rs ls m e)
             (none none)
             ((some v)
              (if (mapped rs (w64_val q) 8 2)
                (irun n1 p ext rs k ls (mem_put64 m (w64_val q) (w64_val v)))
                none))))))
       ((SCall x f es k)
        (match (ievals rs ls m es)
          (none none)
          ((some vs)
           (let
             ((a (Option (Prod (BitVec 64) Mem))
                (match f
                  ((CExt j) (ext j vs m))
                  ((CFn i)
                   (match (fn_at p i)
                     (none none)
                     ((some g) (irun n1 p ext rs (IFn.body g) (enter g vs) m)))))))
             (match a
               (none none)
               ((some r) (irun n1 p ext rs k (upd ls x (Prod.fst r)) (Prod.snd r))))))))
       ((SIf a cc b t e)
        (match (ieval rs ls m a)
          (none none)
          ((some x)
           (match (ieval rs ls m b)
             (none none)
             ((some y) (irun n1 p ext rs (if (icmp cc x y) t e) ls m))))))
       ((SRet e)
        (match (ieval rs ls m e)
          (none none)
          ((some v) (some (Prod.mk v m)))))
       ((STail f es)
        (match (ievals rs ls m es)
          (none none)
          ((some vs)
           (match f
             ((CExt j) (ext j vs m))
             ((CFn i)
              (match (fn_at p i)
                (none none)
                ((some g) (irun n1 p ext rs (IFn.body g) (enter g vs) m))))))))))))
;; the statement s, run with ls and m, returns v and leaves the memory m2
(def iends
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem))
  Prop
  (exists ((n Fuel)) (= (irun n p ext rs s ls m) (some (Prod.mk v m2)))))
;; a function's answer: its body run on the arguments, as many as its parameters
(def fn_ans
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (g IFn)
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem))
  Prop
  (and (= (List.length vs) (IFn.params g)) (iends p ext rs (IFn.body g) (enter g vs) m v m2)))

;; ---- a run's rules, one statement at a time ----------------------------------------------------
(theorem iends_ret
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (iends p ext rs (SRet e) ls m v m)
  (by
    (apply (Exists.intro (FS FZ))
      ((show (= (irun (FS FZ) p ext rs (SRet e) ls m) (some (Prod.mk v m))))
       (unfold irun)
       (reduce)
       (rw he)
       rfl))))
;; an expression's word, one node at a time
(theorem ieval_op
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (o IOp)
   (a IExp)
   (b IExp)
   (x (BitVec 64))
   (y (BitVec 64))
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y))))
  (= (ieval rs ls m (EOp o a b)) (some (iop o x y)))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hb) rfl))
(theorem ieval_load
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (a IExp)
   (q (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (hm (= (mapped rs (w64_val q) 8 4) true)))
  (= (ieval rs ls m (ELoad a)) (some (w64 (mem_le64 m (w64_val q)))))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hm) rfl))
;; a comparison, from the fact a low form's test states
(theorem icmp_ltu_true ((a (BitVec 64)) (b (BitVec 64)) (h (< (w64_val a) (w64_val b))))
  (= (icmp CLtu a b) true)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) true)) (rw (if_pos h)) rfl))
(theorem icmp_ltu_false ((a (BitVec 64)) (b (BitVec 64)) (h (Not (< (w64_val a) (w64_val b)))))
  (= (icmp CLtu a b) false)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) false)) (rw (if_neg h)) rfl))
;; a branch, each way
(theorem iends_if_true
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) true))
   (hr (iends p ext rs t ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SIf a cc b t e) ls m) (some (Prod.mk v m2))))
            (unfold irun)
            (reduce)
            (rw ha)
            (reduce)
            (rw hb)
            (reduce)
            (rw hc)
            (reduce)
            (exact hn))))))))
(theorem iends_if_false
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) false))
   (hr (iends p ext rs e ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SIf a cc b t e) ls m) (some (Prod.mk v m2))))
            (unfold irun)
            (reduce)
            (rw ha)
            (reduce)
            (rw hb)
            (reduce)
            (rw hc)
            (reduce)
            (exact hn))))))))
;; a local set: the word given, everything the goal fixes left out
(theorem iends_let
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (w (BitVec 64))
   (he (= (ieval rs ls m e) (some w)))
   (hr (iends p ext rs k (upd ls x w) m v m2)))
  (iends p ext rs (SLet x e k) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SLet x e k) ls m) (some (Prod.mk v m2))))
            (unfold irun)
            (reduce)
            (rw he)
            (reduce)
            (exact hn))))))))
;; a tail call to a function of the program: the callee's answer is the statement's
(theorem iends_tail
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hr (fn_ans p ext rs g vs m v m2)))
  (iends p ext rs (STail (CFn i) es) ls m v m2)
  (by
    (cases hr
      ((intro (hlen hrun)
         (cases hrun
           ((intro (n hn)
              (apply (Exists.intro (FS n))
                ((show (= (irun (FS n) p ext rs (STail (CFn i) es) ls m) (some (Prod.mk v m2))))
                 (unfold irun)
                 (reduce)
                 (rw hes)
                 (reduce)
                 (rw hg)
                 (reduce)
                 (exact hn)))))))))))

;; ---- a run with nothing outside ----------------------------------------------------------------
;; no external answers
(fn no_ext ((j Nat) (vs (List (BitVec 64))) (m Mem)) (Option (Prod (BitVec 64) Mem)) none)
