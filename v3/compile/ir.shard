;;; v3/compile/ir.shard — the intermediate machine (docs/COMPILE.md §5): a language a little
;;; above x86, in tail form. A function's body is a tree: a local set from an
;;; expression, a store, a call whose result is a local, a two-way branch, and at each leaf a
;;; return or a tail call. There is no loop form: a loop is a function that tail-calls itself.
;;; Locals are 64-bit words and have no address. Memory is the machine's bytes with the ranges
;;; this run may read (4) and write (2); an access outside them has no rule. A callee is a
;;; function of the same program, or an external one whose answer the run is given: from the
;;; argument words and the memory, a result word and the memory after, or nothing.
;;; A run is big-step, counted by a fuel no statement mentions: every statement run takes one.
;;; A run has what is outside a process (models/x86/linux.shard `Os`): an external's answer may
;;; change it, or end the process, and a run in which a callee ends the process has ended
;;; (`Outcome`). Code that calls nothing outside is the case in which what is outside stays as
;;; it was: its answer is a word and a memory (`iends`, `fn_ans`), for every outside.
;;; The machine's laws are ir_laws.shard's.
(import "../models/x86/linux.shard")
(import "../models/x86/words.shard")
(import "../models/x86/x86.shard")
(use std.mem)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(type IOp (OAdd) (OSub) (OMul) (OAnd) (OOr) (OXor))
(type ICmp (CLtu) (CGeu) (CEq) (CNe))
(type ICallee (CFn Nat) (CExt Nat))
(type IExp (ENum (BitVec 64)) (EVar Nat) (EOp IOp IExp IExp) (ELoad IExp) (ELoad8 IExp))
(type IStm
  (SLet Nat IExp IStm)
  (SStore IExp IExp IStm)
  (SCall Nat ICallee (List IExp) IStm)
  (SIf IExp ICmp IExp IStm IStm)
  (SRet IExp)
  (STail ICallee (List IExp)))
;; a function: how many parameters it takes, how many locals it has beyond them, and its body
(record IFn (params Nat) (extra Nat) (body IStm))

(fn iop ((o IOp) (a (BitVec 64)) (b (BitVec 64))) (BitVec 64)
  (match o
    (OAdd (w64_add a b))
    (OSub (w64_sub a b))
    (OMul (w64_mul a b))
    (OAnd (w64_and a b))
    (OOr (w64_or a b))
    (OXor (w64_xor a b))))
(fn icmp ((c ICmp) (a (BitVec 64)) (b (BitVec 64))) Bool
  (match c
    (CLtu (w64_ltu a b))
    (CGeu (if (w64_ltu a b) false true))
    (CEq (if (= (w64_val a) (w64_val b)) true false))
    (CNe (if (= (w64_val a) (w64_val b)) false true))))

;; an expression's word: a load's is the eight bytes at an address, a byte load's the one byte
;; there; nothing where it reads outside the ranges
(fn ieval ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (e IExp)) (Option (BitVec 64))
  (measure (struct e))
  (match e
    ((ENum w) (some w))
    ((EVar i) (some (nth ls i)))
    ((EOp o a b)
     (match (ieval rs ls m a)
       (none none)
       ((some x)
        (match (ieval rs ls m b)
          (none none)
          ((some y) (some (iop o x y)))))))
    ((ELoad a)
     (match (ieval rs ls m a)
       (none none)
       ((some q) (if (mapped rs (w64_val q) 8 4) (some (w64 (mem_le64 m (w64_val q)))) none))))
    ((ELoad8 a)
     (match (ieval rs ls m a)
       (none none)
       ((some q) (if (mapped rs (w64_val q) 1 4) (some (w64 (mem_get m (w64_val q)))) none))))))
(fn ievals ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (es (List IExp)))
  (Option (List (BitVec 64)))
  (measure (struct es))
  (match es
    (nil (some nil))
    ((cons e r)
     (match (ieval rs ls m e)
       (none none)
       ((some v)
        (match (ievals rs ls m r)
          (none none)
          ((some vs) (some (cons v vs)))))))))

(fn fn_at ((p (List IFn)) (i Nat)) (Option IFn)
  (measure (struct p))
  (match p
    (nil none)
    ((cons f r) (if (= i 0) (some f) (fn_at r (- i 1))))))
(fn zeros ((n Nat)) (List (BitVec 64)) (measure n) (if (= n 0) nil (cons (w64 0) (zeros (- n 1)))))
(fulfills zeros.dec_1 (by (intro p h) (exact (Nat.sub_one_lt h))))
(fn app ((xs (List (BitVec 64))) (ys (List (BitVec 64)))) (List (BitVec 64))
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (app r ys)))))
;; a function's locals at its entry: the arguments, then its other locals at 0
(fn enter ((g IFn) (vs (List (BitVec 64)))) (List (BitVec 64)) (app vs (zeros (IFn.extra g))))

;; ---- a run ------------------------------------------------------------------------------------
;; The statement s run with the locals ls, the memory m and what is outside o, to its outcome:
;; it returns a word and leaves a memory and an outside, or the process ended in a callee.
;; Nothing where the fuel runs out, an access lies outside the ranges, a callee is not there,
;; or an external answers nothing.
(fn wrun
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (measure (struct n))
  (match n
    (FZ none)
    ((FS n1)
     (match s
       ((SLet x e k)
        (match (ieval rs ls m e)
          (none none)
          ((some v) (wrun n1 p wx rs k (upd ls x v) m o))))
       ((SStore a e k)
        (match (ieval rs ls m a)
          (none none)
          ((some q)
           (match (ieval rs ls m e)
             (none none)
             ((some v)
              (if (mapped rs (w64_val q) 8 2)
                (wrun n1 p wx rs k ls (mem_put64 m (w64_val q) (w64_val v)) o)
                none))))))
       ((SCall x f es k)
        (match (ievals rs ls m es)
          (none none)
          ((some vs)
           (let
             ((a (Option Outcome)
                (match f
                  ((CExt j) (wx j vs m o))
                  ((CFn i)
                   (match (fn_at p i)
                     (none none)
                     ((some g) (wrun n1 p wx rs (IFn.body g) (enter g vs) m o)))))))
             (match a
               (none none)
               ((some r)
                (match r
                  ((ORet v m1 o1) (wrun n1 p wx rs k (upd ls x v) m1 o1))
                  ((OEnd e) (some (OEnd e))))))))))
       ((SIf a cc b t e)
        (match (ieval rs ls m a)
          (none none)
          ((some x)
           (match (ieval rs ls m b)
             (none none)
             ((some y) (wrun n1 p wx rs (if (icmp cc x y) t e) ls m o))))))
       ((SRet e)
        (match (ieval rs ls m e)
          (none none)
          ((some v) (some (ORet v m o)))))
       ((STail f es)
        (match (ievals rs ls m es)
          (none none)
          ((some vs)
           (match f
             ((CExt j) (wx j vs m o))
             ((CFn i)
              (match (fn_at p i)
                (none none)
                ((some g) (wrun n1 p wx rs (IFn.body g) (enter g vs) m o))))))))))))
;; the statement s, run with ls, m and o, comes to the outcome `out`
(def wends
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (out Outcome))
  Prop
  (exists ((n Fuel)) (= (wrun n p wx rs s ls m o) (some out))))
;; a function's answer with the outside: its body run on the arguments, as many as its parameters
(def wfn_ans
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (g IFn)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (out Outcome))
  Prop
  (and (= (List.length vs) (IFn.params g)) (wends p wx rs (IFn.body g) (enter g vs) m o out)))

;; ---- code that names nothing outside ---------------------------------------------------------
;; an external that leaves what is outside as it was: its answer, as a run takes one
(fn wlift
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (j Nat)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (match (ext j vs m)
    (none none)
    ((some r) (some (ORet (Prod.fst r) (Prod.snd r) o)))))
;; no external answers
(fn no_ext ((j Nat) (vs (List (BitVec 64))) (m Mem)) (Option (Prod (BitVec 64) Mem)) none)
;; the statement s, run with ls and m on such externals, returns v and leaves the memory m2,
;; whatever is outside, and leaves that as it was
(def iends
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem))
  Prop
  (forall ((o Os)) (wends p (wlift ext) rs s ls m o (ORet v m2 o))))
;; a function's answer: its body run on the arguments, as many as its parameters
(def fn_ans
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (g IFn)
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem))
  Prop
  (and (= (List.length vs) (IFn.params g)) (iends p ext rs (IFn.body g) (enter g vs) m v m2)))
