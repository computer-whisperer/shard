;;; v3/compile/sqdiff/sqdiff.shard — the implementation of the view: the low form, each call of
;;; `dot` in it the low form of `dot`'s view; the first fact by the same fact of
;;; `dot`, once for each call; and the tie, a rule of the machine for each statement and at
;;; each call the answer of `dot`'s low form on words that have the evidence.
(import "../dot")
(import "../two.shard")
(import "../sqdiff_src.shard")
(import "../sqdiff_obj.shard")
(import "../ir_laws.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.ir_laws)
(use compile.dot)
(use compile.sqdiff_src)
(use compile.sqdiff_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn sqdiff_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (BitVec 64)
  (w64_sub (dot_lo rs m px px n ex ex) (dot_lo rs m py py n ey ey)))
(fulfills sqdiff_lo_means
  (by
    (rw sqdiff_lo.eq_1)
    (show
      (= (w64_sub (dot_lo rs m px px n ex ex) (dot_lo rs m py py n ey ey))
        (w64_sub (dot xs xs n rx rx) (dot ys ys n ry ry))))
    (rw (dot_lo_means rs m px px n ex ex xs xs rx rx hx hx))
    (rw (dot_lo_means rs m py py n ey ey ys ys ry ry hy hy))
    rfl))
(fulfills sqdiff_tie
  (by
    (rw sqdiff_lo.eq_1)
    (apply And.intro (rfl)
      ((apply (iends_call_ext (cons px (cons px (cons n nil))) (dot_lo rs m px px n ex ex) m) (rfl)
         ((rw (hd (cons px (cons px (cons n nil))) m))
          (exact (two_ext_is dot_lo rs m px px n ex ex)))
         ((apply (iends_call_ext (cons py (cons py (cons n nil))) (dot_lo rs m py py n ey ey) m)
            (rfl)
            ((rw (hd (cons py (cons py (cons n nil))) m))
             (exact (two_ext_is dot_lo rs m py py n ey ey)))
            ((apply iends_ret (rfl))))))))))
