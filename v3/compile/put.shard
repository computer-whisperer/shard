;;; v3/compile/put.shard — the platform's `write_all` (std/world.shard) as a function outside a
;;; module. Its answer is given on what is outside the process (`put_ext`): the bytes at the
;;; address, in the memory the answer is asked on, go as the kernel's answers decide — all of
;;; them, and the call returns 1; or a write fails and the process exits with the failure's
;;; status; or the kernel ends it. That is the platform's function on the World of what is
;;; outside (`put_all`, `put_fail`, `put_kill`): the answer's outcome is tied to it
;;; (`put_tied`). And the rule for a call of it in a program's function (`tie_put`), by the
;;; rule for a call of anything that is tied (tie.shard). The code that realizes the answer is
;;; x86/put.shard's.
(import "tie.shard")
(use std.mem)
(use std.world)
(use std.world.Life)
(use std.world.Put)
(use std.world.World)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IStm)
(use compile.tie)
(use models.x86.linux)
(use models.x86.linux.Os)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.linux.Sent)
(use models.x86.word)
(use models.x86.words)
(use models.x86.world)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the answer -----------------------------------------------------------------------------------
(fn put_out ((m Mem) (o Os) (bs (List Nat))) Outcome
  (match (send (Os.ans o) bs)
    ((SAll left) (ORet (w64 1) m (MkOs left (List.append (Os.out o) bs))))
    ((SFail q) (OEnd (RExit status_io (List.append (Os.out o) q))))
    ((SKill q) (OEnd (RKill (List.append (Os.out o) q))))))
(fn put_ext ((rs (List Seg)) (vs (List (BitVec 64))) (m Mem) (o Os)) (Option Outcome)
  (if (= (List.length vs) 2)
    (if (mapped rs (w64_val (nth vs 0)) (w64_val (nth vs 1)) 4)
      (if (<= (+ (w64_val (nth vs 0)) (w64_val (nth vs 1))) 140737488355328)
        (some (put_out m o (mem_bytes m (w64_val (nth vs 0)) (w64_val (nth vs 1)))))
        none)
      none)
    none))
(def put_ans ((rs (List Seg)) (vs (List (BitVec 64))) (m Mem) (o Os) (out Outcome)) Prop
  (= (put_ext rs vs m o) (some out)))
(theorem put_ext_inv
  ((rs (List Seg))
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (out Outcome)
   (h (= (put_ext rs vs m o) (some out))))
  (and (= (List.length vs) 2)
    (and (= (mapped rs (w64_val (nth vs 0)) (w64_val (nth vs 1)) 4) true)
      (and (<= (+ (w64_val (nth vs 0)) (w64_val (nth vs 1))) 140737488355328)
        (= out (put_out m o (mem_bytes m (w64_val (nth vs 0)) (w64_val (nth vs 1))))))))
  (by
    (have g
      (-> (= (put_ext rs vs m o) (some out))
        (and (= (List.length vs) 2)
          (and (= (mapped rs (w64_val (nth vs 0)) (w64_val (nth vs 1)) 4) true)
            (and (<= (+ (w64_val (nth vs 0)) (w64_val (nth vs 1))) 140737488355328)
              (= out (put_out m o (mem_bytes m (w64_val (nth vs 0)) (w64_val (nth vs 1)))))))))
      (cases (Nat.decEq (List.length vs) 2)
        ((isFalse (e) (intro h0)
           (have hn (= (@Option.none Outcome) (some out))
             (rw (<- h0))
             (unfold put_ext)
             (rw (if_neg e))
             rfl)
           (exact (absurd (Eq.symm hn) (Option.some_ne_none out))))
         (isTrue (e)
           (cases (mapped rs (w64_val (nth vs 0)) (w64_val (nth vs 1)) 4) hm
             ((false () (intro h0)
                (have hn (= (@Option.none Outcome) (some out))
                  (rw (<- h0))
                  (unfold put_ext)
                  (rw (if_pos e))
                  (rw hm)
                  rfl)
                (exact (absurd (Eq.symm hn) (Option.some_ne_none out))))
              (true ()
                (cases (Nat.decLe (+ (w64_val (nth vs 0)) (w64_val (nth vs 1))) 140737488355328)
                  ((isFalse (e2) (intro h0)
                     (have hn (= (@Option.none Outcome) (some out))
                       (rw (<- h0))
                       (unfold put_ext)
                       (rw (if_pos e))
                       (rw hm)
                       (rw (if_neg e2))
                       rfl)
                     (exact (absurd (Eq.symm hn) (Option.some_ne_none out))))
                   (isTrue (e2) (intro h0)
                     (have hs
                       (=
                         (some (put_out m o (mem_bytes m (w64_val (nth vs 0)) (w64_val (nth vs 1)))))
                         (some out))
                       (rw (<- h0))
                       (unfold put_ext)
                       (rw (if_pos e))
                       (rw hm)
                       (rw (if_pos e2))
                       rfl)
                     (exact
                       (And.intro e
                         (And.intro (Eq.refl true) (And.intro e2 (Eq.symm (Option.some.inj hs))))))))))))))))
    (exact (g h))))
;; the answer on an address and a count that have the evidence
(theorem put_ext_is
  ((rs (List Seg))
   (a (BitVec 64))
   (n (BitVec 64))
   (m Mem)
   (o Os)
   (hm (= (mapped rs (w64_val a) (w64_val n) 4) true))
   (hb (<= (+ (w64_val a) (w64_val n)) 140737488355328)))
  (= (put_ext rs (cons a (cons n nil)) m o)
    (some (put_out m o (mem_bytes m (w64_val a) (w64_val n)))))
  (by
    (have hl (= (List.length (cons a (cons n nil))) 2) rfl)
    (unfold put_ext)
    (rw (if_pos hl))
    (show
      (=
        (if (mapped rs (w64_val a) (w64_val n) 4)
          (if (<= (+ (w64_val a) (w64_val n)) 140737488355328)
            (some (put_out m o (mem_bytes m (w64_val a) (w64_val n))))
            none)
          none)
        (some (put_out m o (mem_bytes m (w64_val a) (w64_val n))))))
    (rw hm)
    (rw (if_pos hb))
    rfl))

;; the outside functions of a module that has one, the platform's `write_all` over the data
;; ranges, as a run with the outside is given them: function 0, and there is no other
(fn put_wx ((rs (List Seg)) (j Nat) (vs (List (BitVec 64))) (m Mem) (o Os)) (Option Outcome)
  (if (= j 0) (put_ext rs vs m o) none))
(theorem put_wx_is ((rs (List Seg)))
  (forall ((vs (List (BitVec 64))) (m0 Mem) (o0 Os))
    (= (put_wx rs 0 vs m0 o0) (put_ext rs vs m0 o0)))
  (by (intro vs m0 o0) rfl))

;; ---- the answer is the platform's function ----------------------------------------------------------
;; by what the model's loop comes to on the answers: the call's outcome, and the World after
(theorem put_all
  ((m Mem) (o Os) (bs (List Nat)) (left (List Answer)) (hs (= (send (Os.ans o) bs) (SAll left))))
  (and (= (put_out m o bs) (ORet (w64 1) m (MkOs left (List.append (Os.out o) bs))))
    (= (write_all bs (os_world o)) (os_world (MkOs left (List.append (Os.out o) bs)))))
  (by
    (have h1 (= (put_out m o bs) (ORet (w64 1) m (MkOs left (List.append (Os.out o) bs))))
      (unfold put_out)
      (rw hs)
      rfl)
    (have hp (= (put (hows (Os.ans o)) bs) (PAll (hows left)))
      (rw (send_put (Os.ans o) bs))
      (rw hs)
      rfl)
    (have h2
      (= (write_all bs (MkWorld (hows (Os.ans o)) (Os.out o) Live))
        (MkWorld (hows left) (List.append (Os.out o) bs) Live))
      (rw (write_all_live bs (hows (Os.ans o)) (Os.out o)))
      (rw hp)
      rfl)
    (exact (And.intro h1 h2))))
(theorem put_fail
  ((m Mem) (o Os) (bs (List Nat)) (q (List Nat)) (hs (= (send (Os.ans o) bs) (SFail q))))
  (and (= (put_out m o bs) (OEnd (RExit status_io (List.append (Os.out o) q))))
    (= (write_all bs (os_world o)) (MkWorld nil (List.append (Os.out o) q) Failed)))
  (by
    (have h1 (= (put_out m o bs) (OEnd (RExit status_io (List.append (Os.out o) q))))
      (unfold put_out)
      (rw hs)
      rfl)
    (have hp (= (put (hows (Os.ans o)) bs) (PFail q)) (rw (send_put (Os.ans o) bs)) (rw hs) rfl)
    (have h2
      (= (write_all bs (MkWorld (hows (Os.ans o)) (Os.out o) Live))
        (MkWorld nil (List.append (Os.out o) q) Failed))
      (rw (write_all_live bs (hows (Os.ans o)) (Os.out o)))
      (rw hp)
      rfl)
    (exact (And.intro h1 h2))))
(theorem put_kill
  ((m Mem) (o Os) (bs (List Nat)) (q (List Nat)) (hs (= (send (Os.ans o) bs) (SKill q))))
  (and (= (put_out m o bs) (OEnd (RKill (List.append (Os.out o) q))))
    (= (write_all bs (os_world o)) (MkWorld nil (List.append (Os.out o) q) Killed)))
  (by
    (have h1 (= (put_out m o bs) (OEnd (RKill (List.append (Os.out o) q))))
      (unfold put_out)
      (rw hs)
      rfl)
    (have hp (= (put (hows (Os.ans o)) bs) (PKill q)) (rw (send_put (Os.ans o) bs)) (rw hs) rfl)
    (have h2
      (= (write_all bs (MkWorld (hows (Os.ans o)) (Os.out o) Live))
        (MkWorld nil (List.append (Os.out o) q) Killed))
      (rw (write_all_live bs (hows (Os.ans o)) (Os.out o)))
      (rw hp)
      rfl)
    (exact (And.intro h1 h2))))

;; so the answer's outcome is tied to the platform's function: the word 1, the memory as it
;; was, and the World `write_all` gives on the World of what is outside
(theorem put_tied ((m Mem) (o Os) (bs (List Nat)))
  (tied (put_out m o bs) (w64 1) m (write_all bs (os_world o)))
  (by
    (cases (send (Os.ans o) bs) hs
      ((SAll (left) (rw (And.left (put_all m o bs left hs)))
         (rw (And.right (put_all m o bs left hs)))
         (show
           (and (= (w64 1) (w64 1))
             (and (= m m)
               (= (os_world (MkOs left (List.append (Os.out o) bs)))
                 (os_world (MkOs left (List.append (Os.out o) bs)))))))
         (apply And.intro (rfl) ((apply And.intro (rfl) (rfl)))))
       (SFail (q) (rw (And.left (put_fail m o bs q hs))) (rw (And.right (put_fail m o bs q hs)))
         (show
           (and (= (runs Failed) false)
             (forall ((y (BitVec 64)))
               (= (world_res y (MkWorld nil (List.append (Os.out o) q) Failed))
                 (RExit status_io (List.append (Os.out o) q))))))
         (apply And.intro (rfl) ((intro y) rfl)))
       (SKill (q) (rw (And.left (put_kill m o bs q hs))) (rw (And.right (put_kill m o bs q hs)))
         (show
           (and (= (runs Killed) false)
             (forall ((y (BitVec 64)))
               (= (world_res y (MkWorld nil (List.append (Os.out o) q) Killed))
                 (RKill (List.append (Os.out o) q))))))
         (apply And.intro (rfl) ((intro y) rfl)))))))

;; ---- THE RULE FOR A CALL THAT WRITES ----------------------------------------------------------------
;; A call of the function with an address and a count that have the evidence, the bytes there
;; being bs, where the program's value is the word v and the World w. The call's code and what
;; follows it have an outcome that is that value's (`ties`, tie.shard), if: wherever the
;; process still runs after the write, what follows has such an outcome on what the write
;; left; and where the write stopped the process, the program's World is the World the write
;; left — the rest of the program writes nothing in a process that has stopped.
(theorem tie_put
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (j Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (w World implicit)
   (a (BitVec 64))
   (n (BitVec 64))
   (bs (List Nat))
   (hx (forall ((vs (List (BitVec 64))) (m0 Mem) (o0 Os)) (= (wx j vs m0 o0) (put_ext rs vs m0 o0))))
   (hes (= (ievals rs ls m es) (some (cons a (cons n nil)))))
   (hm (= (mapped rs (w64_val a) (w64_val n) 4) true))
   (hb (<= (+ (w64_val a) (w64_val n)) 140737488355328))
   (hbs (= (mem_bytes m (w64_val a) (w64_val n)) bs))
   (hlive
     (forall ((o1 Os))
       (-> (= (os_world o1) (write_all bs (os_world o)))
         (ties p wx rs k (upd ls x (w64 1)) m o1 v m2 w))))
   (hdead
     (-> (= (runs (World.life (write_all bs (os_world o)))) false) (= w (write_all bs (os_world o))))))
  (ties p wx rs (SCall x (CExt j) es k) ls m o v m2 w)
  (by
    (have hc
      (exists ((q Outcome))
        (and (= (wx j (cons a (cons n nil)) m o) (some q))
          (tied q (w64 1) m (write_all bs (os_world o)))))
      (apply (Exists.intro (put_out m o bs))
        ((apply And.intro
           ((rw (hx (cons a (cons n nil)) m o)) (rw (<- hbs)) (exact (put_ext_is rs a n m o hm hb)))
           ((exact (put_tied m o bs)))))))
    (exact (tie_ext (cons a (cons n nil)) (w64 1) m (write_all bs (os_world o)) hes hc hlive hdead))))
