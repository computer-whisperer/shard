;;; v3/compile/ir_laws.shard — laws of the intermediate machine (ir.shard): an expression's
;;; word; what a run of a statement says of the statement's parts; a run of a statement from
;;; its parts; that a run with an outcome has it on any fuel above; a rule of `wends` for each
;;; statement form a proof above the pass uses — a call that returns among them, the two runs
;;; it joins brought to one fuel, and a call in which the process ends —; and from those the
;;; rules of `iends`, for code that names nothing outside.
(import "ir.shard")
(use std.mem)
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IStm)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- expressions --------------------------------------------------------------------------------
;; an expression's word, one node at a time
(theorem ieval_op
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (o IOp)
   (a IExp)
   (b IExp)
   (x (BitVec 64))
   (y (BitVec 64))
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y))))
  (= (ieval rs ls m (EOp o a b)) (some (iop o x y)))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hb) rfl))
(theorem ieval_load
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (a IExp)
   (q (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (hm (= (mapped rs (w64_val q) 8 4) true)))
  (= (ieval rs ls m (ELoad a)) (some (w64 (mem_le64 m (w64_val q)))))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hm) rfl))
(theorem ieval_load8
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (a IExp)
   (q (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (hm (= (mapped rs (w64_val q) 1 4) true)))
  (= (ieval rs ls m (ELoad8 a)) (some (w64 (mem_get m (w64_val q)))))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hm) rfl))
;; a comparison, from the fact a low form's test states
(theorem icmp_ltu_true ((a (BitVec 64)) (b (BitVec 64)) (h (< (w64_val a) (w64_val b))))
  (= (icmp CLtu a b) true)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) true)) (rw (if_pos h)) rfl))
(theorem icmp_ltu_false ((a (BitVec 64)) (b (BitVec 64)) (h (Not (< (w64_val a) (w64_val b)))))
  (= (icmp CLtu a b) false)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) false)) (rw (if_neg h)) rfl))
;; arguments' words, one list element at a time
(theorem ievals_nil_inv
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (vs (List (BitVec 64)))
   (h (= (ievals rs ls m nil) (some vs))))
  (= vs nil)
  (by
    (have g (= (some (@List.nil (BitVec 64))) (some vs)) (exact h))
    (exact (Eq.symm (Option.some.inj g)))))
(theorem ievals_cons_inv
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (e IExp)
   (r (List IExp))
   (vs (List (BitVec 64)))
   (h (= (ievals rs ls m (cons e r)) (some vs))))
  (exists ((v1 (BitVec 64)))
    (exists ((vr (List (BitVec 64))))
      (and (= (ieval rs ls m e) (some v1))
        (and (= (ievals rs ls m r) (some vr)) (= vs (cons v1 vr))))))
  (by
    (have g
      (-> (= (ievals rs ls m (cons e r)) (some vs))
        (exists ((v1 (BitVec 64)))
          (exists ((vr (List (BitVec 64))))
            (and (= (ieval rs ls m e) (some v1))
              (and (= (ievals rs ls m r) (some vr)) (= vs (cons v1 vr)))))))
      (rw ievals.eq_2)
      (cases (ieval rs ls m e) hv
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none vs))))
         (some (v0) (reduce)
           (cases (ievals rs ls m r) hr
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none vs))))
              (some (vr0) (reduce) (intro h0)
                (apply (Exists.intro v0)
                  ((apply (Exists.intro vr0)
                     ((apply And.intro (rfl)
                        ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0))))))))))))))))))
    (exact (g h))))
(theorem ievals_len ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (es (List IExp)))
  (forall ((vs (List (BitVec 64))))
    (-> (= (ievals rs ls m es) (some vs)) (= (List.length vs) (List.length es))))
  (by
    (induction es
      ((nil () (intro vs h) (rw (ievals_nil_inv rs ls m vs h)) rfl)
       (cons (e r ih) (intro vs h)
         (cases (ievals_cons_inv rs ls m e r vs h)
           ((intro (v1 g1)
              (cases g1
                ((intro (vr g2) (rw (And.right (And.right g2)))
                   (show (= (+ (List.length vr) 1) (+ (List.length r) 1)))
                   (rw (ih vr (And.left (And.right g2))))
                   rfl)))))))))))

;; ---- fuels added ---------------------------------------------------------------------------------
(fn fadd ((a Fuel) (b Fuel)) Fuel
  (measure (struct a))
  (match a
    (FZ b)
    ((FS a1) (FS (fadd a1 b)))))
(theorem fadd_zero ((a Fuel)) (= (fadd a FZ) a)
  (by (induction a ((FZ () rfl) (FS (a1 ih) (show (= (FS (fadd a1 FZ)) (FS a1))) (rw ih) rfl)))))
(theorem fadd_succ ((a Fuel) (b Fuel)) (= (fadd a (FS b)) (FS (fadd a b)))
  (by
    (induction a
      ((FZ () rfl) (FS (a1 ih) (show (= (FS (fadd a1 (FS b))) (FS (FS (fadd a1 b))))) (rw ih) rfl)))))

;; ---- what a run says of its parts ---------------------------------------------------------------
;; a callee's run, as a statement's run takes it: an external's answer on what is outside, or
;; the run of a function's body on the fuel below
(def wfn_run
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (og (Option IFn))
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (match og
    (none none)
    ((some g) (wrun n p wx rs (IFn.body g) (enter g vs) m o))))
(def wcal_run
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (match cal
    ((CExt j) (wx j vs m o))
    ((CFn i) (wfn_run n p wx rs (fn_at p i) vs m o))))
;; what follows a call, by the callee's outcome: the rest of the statement with the local set,
;; on the memory and the outside the callee left; or, the process ended in the callee, the end
(def wnext
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (q Outcome))
  (Option Outcome)
  (match q
    ((ORet v m1 o1) (wrun n p wx rs k (upd ls x v) m1 o1))
    ((OEnd e) (some (OEnd e)))))
(theorem wrun_ret_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SRet e) ls m o) (some r))))
  (exists ((v (BitVec 64))) (and (= (ieval rs ls m e) (some v)) (= r (ORet v m o))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SRet e) ls m o) (some r))
        (exists ((v (BitVec 64))) (and (= (ieval rs ls m e) (some v)) (= r (ORet v m o)))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (x) (reduce) (intro h0)
           (apply (Exists.intro x)
             ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0)))))))))))
    (exact (g h))))
(theorem wrun_let_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SLet x e k) ls m o) (some r))))
  (exists ((w (BitVec 64)))
    (and (= (ieval rs ls m e) (some w)) (= (wrun n1 p wx rs k (upd ls x w) m o) (some r))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SLet x e k) ls m o) (some r))
        (exists ((w (BitVec 64)))
          (and (= (ieval rs ls m e) (some w)) (= (wrun n1 p wx rs k (upd ls x w) m o) (some r)))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (w1) (reduce) (intro h0)
           (apply (Exists.intro w1) ((apply And.intro (rfl) ((exact h0)))))))))
    (exact (g h))))
(theorem wrun_store_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SStore a e k) ls m o) (some r))))
  (exists ((q (BitVec 64)))
    (exists ((w (BitVec 64)))
      (and (= (ieval rs ls m a) (some q))
        (and (= (ieval rs ls m e) (some w))
          (and (= (mapped rs (w64_val q) 8 2) true)
            (= (wrun n1 p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r)))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SStore a e k) ls m o) (some r))
        (exists ((q (BitVec 64)))
          (exists ((w (BitVec 64)))
            (and (= (ieval rs ls m a) (some q))
              (and (= (ieval rs ls m e) (some w))
                (and (= (mapped rs (w64_val q) 8 2) true)
                  (= (wrun n1 p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r))))))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m a) ha
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (q1) (reduce)
           (cases (ieval rs ls m e) he
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (w1) (reduce)
                (cases (mapped rs (w64_val q1) 8 2) hm
                  ((false () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (true () (reduce) (intro h0)
                     (apply (Exists.intro q1)
                       ((apply (Exists.intro w1)
                          ((apply And.intro (rfl)
                             ((apply And.intro (rfl) ((apply And.intro ((exact hm)) ((exact h0)))))))))))))))))))))
    (exact (g h))))
(theorem wrun_if_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SIf x cc y t e) ls m o) (some r))))
  (exists ((vx (BitVec 64)))
    (exists ((vy (BitVec 64)))
      (and (= (ieval rs ls m x) (some vx))
        (and (= (ieval rs ls m y) (some vy))
          (= (wrun n1 p wx rs (if (icmp cc vx vy) t e) ls m o) (some r))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SIf x cc y t e) ls m o) (some r))
        (exists ((vx (BitVec 64)))
          (exists ((vy (BitVec 64)))
            (and (= (ieval rs ls m x) (some vx))
              (and (= (ieval rs ls m y) (some vy))
                (= (wrun n1 p wx rs (if (icmp cc vx vy) t e) ls m o) (some r)))))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m x) hx
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vx0) (reduce)
           (cases (ieval rs ls m y) hy
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (vy0) (reduce) (intro h0)
                (apply (Exists.intro vx0)
                  ((apply (Exists.intro vy0)
                     ((apply And.intro (rfl) ((apply And.intro (rfl) ((exact h0))))))))))))))))
    (exact (g h))))
(theorem wrun_tail_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (STail cal es) ls m o) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs)) (= (wcal_run n1 p wx rs cal vs m o) (some r))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (STail cal es) ls m o) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs)) (= (wcal_run n1 p wx rs cal vs m o) (some r)))))
      (unfold wrun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((show (= (wfn_run n1 p wx rs (fn_at p i) vs0 m o) (some r)))
                           (rw hf)
                           (exact h0)))))))))
              (CExt (j) (reduce) (intro h0)
                (apply (Exists.intro vs0) ((apply And.intro (rfl) ((exact h0))))))))))))
    (exact (g h))))
(theorem wrun_call_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SCall x cal es k) ls m o) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs))
      (exists ((q Outcome))
        (and (= (wcal_run n1 p wx rs cal vs m o) (some q)) (= (wnext n1 p wx rs x k ls q) (some r))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SCall x cal es k) ls m o) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs))
            (exists ((q Outcome))
              (and (= (wcal_run n1 p wx rs cal vs m o) (some q))
                (= (wnext n1 p wx rs x k ls q) (some r)))))))
      (unfold wrun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce)
                     (cases (wrun n1 p wx rs (IFn.body g0) (enter g0 vs0) m o) hb
                       ((none () (reduce) (intro h0)
                          (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                        (some (q0) (reduce) (intro h0)
                          (apply (Exists.intro vs0)
                            ((apply And.intro (rfl)
                               ((apply (Exists.intro q0)
                                  ((apply And.intro
                                     ((show (= (wfn_run n1 p wx rs (fn_at p i) vs0 m o) (some q0)))
                                      (rw hf)
                                      (exact hb))
                                     ((exact h0))))))))))))))))
              (CExt (j) (reduce)
                (cases (wx j vs0 m o) hx
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (q0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((apply (Exists.intro q0) ((apply And.intro ((exact hx)) ((exact h0)))))))))))))))))))
    (exact (g h))))

;; ---- a run from its parts -----------------------------------------------------------------------
(theorem wrun_ret
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (= (wrun (FS n) p wx rs (SRet e) ls m o) (some (ORet v m o)))
  (by (unfold wrun) (reduce) (rw he) rfl))
(theorem wrun_let
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (w (BitVec 64))
   (r Outcome)
   (he (= (ieval rs ls m e) (some w)))
   (hk (= (wrun n p wx rs k (upd ls x w) m o) (some r))))
  (= (wrun (FS n) p wx rs (SLet x e k) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw he) (reduce) (exact hk)))
(theorem wrun_store
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (q (BitVec 64))
   (w (BitVec 64))
   (r Outcome)
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hk (= (wrun n p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r))))
  (= (wrun (FS n) p wx rs (SStore a e k) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw ha) (reduce) (rw he) (reduce) (rw hm) (reduce) (exact hk)))
(theorem wrun_if
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (x (BitVec 64))
   (y (BitVec 64))
   (r Outcome)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hk (= (wrun n p wx rs (if (icmp cc x y) t e) ls m o) (some r))))
  (= (wrun (FS n) p wx rs (SIf a cc b t e) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw ha) (reduce) (rw hb) (reduce) (exact hk)))
(theorem wrun_tail
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (vs (List (BitVec 64)))
   (r Outcome)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wcal_run n p wx rs cal vs m o) (some r))))
  (= (wrun (FS n) p wx rs (STail cal es) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw hes) (reduce) (exact hc)))
(theorem wrun_call
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (vs (List (BitVec 64)))
   (q Outcome)
   (r Outcome)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wcal_run n p wx rs cal vs m o) (some q)))
   (hk (= (wnext n p wx rs x k ls q) (some r))))
  (= (wrun (FS n) p wx rs (SCall x cal es k) ls m o) (some r))
  (by
    (unfold wrun)
    (reduce)
    (rw hes)
    (reduce)
    (cases cal
      ((CFn (i) (reduce)
         (cases (fn_at p i) hf
           ((none ()
              (have h1 (= (wfn_run n p wx rs (@Option.none IFn) vs m o) (some q))
                (rw (<- hf))
                (exact hc))
              (have h2 (= (@Option.none Outcome) (some q)) (exact h1))
              (exact (absurd (Eq.symm h2) (Option.some_ne_none q))))
            (some (g0)
              (have h1 (= (wfn_run n p wx rs (some g0) vs m o) (some q)) (rw (<- hf)) (exact hc))
              (have h2 (= (wrun n p wx rs (IFn.body g0) (enter g0 vs) m o) (some q)) (exact h1))
              (reduce)
              (rw h2)
              (exact hk)))))
       (CExt (j) (reduce) (have h1 (= (wx j vs m o) (some q)) (exact hc)) (rw h1) (exact hk))))))

;; ---- more fuel ------------------------------------------------------------------------------------
(theorem wcal_run_more
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
       (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r)))))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (q Outcome)
   (h (= (wcal_run n p wx rs cal vs m o) (some q))))
  (= (wcal_run (FS n) p wx rs cal vs m o) (some q))
  (by
    (have g
      (-> (= (wcal_run n p wx rs cal vs m o) (some q))
        (= (wcal_run (FS n) p wx rs cal vs m o) (some q)))
      (cases cal
        ((CFn (i)
           (show
             (-> (= (wfn_run n p wx rs (fn_at p i) vs m o) (some q))
               (= (wfn_run (FS n) p wx rs (fn_at p i) vs m o) (some q))))
           (cases (fn_at p i) hf
             ((none () (intro h0) (exact h0))
              (some (g0) (intro h0) (exact (ih (IFn.body g0) (enter g0 vs) m o q h0))))))
         (CExt (j) (intro h0) (exact h0)))))
    (exact (g h))))
(theorem wnext_more
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
       (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r)))))
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (q Outcome)
   (r Outcome))
  (-> (= (wnext n p wx rs x k ls q) (some r)) (= (wnext (FS n) p wx rs x k ls q) (some r)))
  (by
    (cases q
      ((ORet (v m1 o1)
         (show
           (-> (= (wrun n p wx rs k (upd ls x v) m1 o1) (some r))
             (= (wrun (FS n) p wx rs k (upd ls x v) m1 o1) (some r))))
         (exact (ih k (upd ls x v) m1 o1 r)))
       (OEnd (e) (intro h0) (exact h0))))))
(theorem wrun_more
  ((p (List IFn)) (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome))) (rs (List Seg)) (n Fuel))
  (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
    (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r))))
  (by
    (induction n
      ((FZ () (intro s ls m o r h)
         (have hn (= (wrun FZ p wx rs s ls m o) (@Option.none Outcome)) rfl)
         (exact (absurd (Eq.symm (Eq.trans (Eq.symm hn) h)) (Option.some_ne_none r))))
       (FS (n1 ih) (intro s)
         (cases s
           ((SLet (x e k) (intro ls m o r h)
              (cases (wrun_let_inv p wx rs n1 x e k ls m o r h)
                ((intro (w hw)
                   (exact
                     (wrun_let p wx rs (FS n1) x e k ls m o w r (And.left hw)
                       (ih k (upd ls x w) m o r (And.right hw))))))))
            (SStore (a e k) (intro ls m o r h)
              (cases (wrun_store_inv p wx rs n1 a e k ls m o r h)
                ((intro (q hq)
                   (cases hq
                     ((intro (w hw)
                        (exact
                          (wrun_store p wx rs (FS n1) a e k ls m o q w r (And.left hw)
                            (And.left (And.right hw))
                            (And.left (And.right (And.right hw)))
                            (ih k ls (mem_put64 m (w64_val q) (w64_val w)) o r
                              (And.right (And.right (And.right hw)))))))))))))
            (SCall (x cal es k) (intro ls m o r h)
              (cases (wrun_call_inv p wx rs n1 x cal es k ls m o r h)
                ((intro (vs hv)
                   (cases (And.right hv)
                     ((intro (q hq)
                        (exact
                          (wrun_call p wx rs (FS n1) x cal es k ls m o vs q r (And.left hv)
                            (wcal_run_more p wx rs n1 ih cal vs m o q (And.left hq))
                            (wnext_more p wx rs n1 ih x k ls q r (And.right hq)))))))))))
            (SIf (x cc y t e) (intro ls m o r h)
              (cases (wrun_if_inv p wx rs n1 x cc y t e ls m o r h)
                ((intro (vx hx)
                   (cases hx
                     ((intro (vy hy)
                        (exact
                          (wrun_if p wx rs (FS n1) x cc y t e ls m o vx vy r (And.left hy)
                            (And.left (And.right hy))
                            (ih (if (icmp cc vx vy) t e) ls m o r (And.right (And.right hy))))))))))))
            (SRet (e) (intro ls m o r h) (exact h))
            (STail (cal es) (intro ls m o r h)
              (cases (wrun_tail_inv p wx rs n1 cal es ls m o r h)
                ((intro (vs hv)
                   (exact
                     (wrun_tail p wx rs (FS n1) cal es ls m o vs r (And.left hv)
                       (wcal_run_more p wx rs n1 ih cal vs m o r (And.right hv)))))))))))))))
;; a run with an outcome has it with any fuel put before its own, and with any after
(theorem wrun_front
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (n Fuel)
   (h (= (wrun n p wx rs s ls m o) (some r)))
   (d Fuel))
  (= (wrun (fadd d n) p wx rs s ls m o) (some r))
  (by
    (induction d
      ((FZ () (exact h)) (FS (d1 ih) (exact (wrun_more p wx rs (fadd d1 n) s ls m o r ih)))))))
(theorem wrun_back
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (n Fuel)
   (h (= (wrun n p wx rs s ls m o) (some r)))
   (d Fuel))
  (= (wrun (fadd n d) p wx rs s ls m o) (some r))
  (by
    (induction d
      ((FZ () (rw (fadd_zero n)) (exact h))
       (FS (d1 ih) (rw (fadd_succ n d1)) (exact (wrun_more p wx rs (fadd n d1) s ls m o r ih)))))))

;; ---- a run's rules, one statement at a time -------------------------------------------------------
;; the rules of `wends` a proof above the pass uses: a return; a local set; a branch, each way;
;; a tail call to a function of the program; and a call — of an outside function or of a
;; function of the program — that returns, then what follows on what it left, and one in which
;; the process ends
(theorem wends_ret
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (wends p wx rs (SRet e) ls m o (ORet v m o))
  (by (apply (Exists.intro (FS FZ)) ((exact (wrun_ret p wx rs FZ e ls m o v he))))))
(theorem wends_let
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (out Outcome implicit)
   (w (BitVec 64))
   (he (= (ieval rs ls m e) (some w)))
   (hk (wends p wx rs k (upd ls x w) m o out)))
  (wends p wx rs (SLet x e k) ls m o out)
  (by
    (cases hk
      ((intro (n hn)
         (apply (Exists.intro (FS n)) ((exact (wrun_let p wx rs n x e k ls m o w out he hn)))))))))
(theorem wends_call_ext
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (j Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (out Outcome implicit)
   (vs (List (BitVec 64)))
   (v1 (BitVec 64))
   (m1 Mem)
   (o1 Os)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wx j vs m o) (some (ORet v1 m1 o1))))
   (hk (wends p wx rs k (upd ls x v1) m1 o1 out)))
  (wends p wx rs (SCall x (CExt j) es k) ls m o out)
  (by
    (cases hk
      ((intro (nk hnk)
         (have hc2 (= (wcal_run nk p wx rs (CExt j) vs m o) (some (ORet v1 m1 o1))) (exact hc))
         (have hk2 (= (wnext nk p wx rs x k ls (ORet v1 m1 o1)) (some out)) (exact hnk))
         (apply (Exists.intro (FS nk))
           ((exact (wrun_call p wx rs nk x (CExt j) es k ls m o vs (ORet v1 m1 o1) out hes hc2 hk2)))))))))
(theorem wends_call_ext_end
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (j Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (vs (List (BitVec 64)))
   (r Res)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wx j vs m o) (some (OEnd r)))))
  (wends p wx rs (SCall x (CExt j) es k) ls m o (OEnd r))
  (by
    (have hc2 (= (wcal_run FZ p wx rs (CExt j) vs m o) (some (OEnd r))) (exact hc))
    (have hk2 (= (wnext FZ p wx rs x k ls (OEnd r)) (some (OEnd r))) rfl)
    (apply (Exists.intro (FS FZ))
      ((exact (wrun_call p wx rs FZ x (CExt j) es k ls m o vs (OEnd r) (OEnd r) hes hc2 hk2))))))
;; a branch, each way
(theorem wends_if_true
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (x (BitVec 64))
   (y (BitVec 64))
   (out Outcome)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) true))
   (hr (wends p wx rs t ls m o out)))
  (wends p wx rs (SIf a cc b t e) ls m o out)
  (by
    (cases hr
      ((intro (n hn)
         (have hk (= (wrun n p wx rs (if (icmp cc x y) t e) ls m o) (some out)) (rw hc) (exact hn))
         (apply (Exists.intro (FS n))
           ((exact (wrun_if p wx rs n a cc b t e ls m o x y out ha hb hk)))))))))
(theorem wends_if_false
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (x (BitVec 64))
   (y (BitVec 64))
   (out Outcome)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) false))
   (hr (wends p wx rs e ls m o out)))
  (wends p wx rs (SIf a cc b t e) ls m o out)
  (by
    (cases hr
      ((intro (n hn)
         (have hk (= (wrun n p wx rs (if (icmp cc x y) t e) ls m o) (some out)) (rw hc) (exact hn))
         (apply (Exists.intro (FS n))
           ((exact (wrun_if p wx rs n a cc b t e ls m o x y out ha hb hk)))))))))
;; a tail call to a function of the program: the callee's outcome is the statement's
(theorem wends_tail
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (out Outcome implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hr (wfn_ans p wx rs g vs m o out)))
  (wends p wx rs (STail (CFn i) es) ls m o out)
  (by
    (cases hr
      ((intro (hlen hrun)
         (cases hrun
           ((intro (n hn)
              (have hc (= (wcal_run n p wx rs (CFn i) vs m o) (some out))
                (show (= (wfn_run n p wx rs (fn_at p i) vs m o) (some out)))
                (rw hg)
                (exact hn))
              (apply (Exists.intro (FS n))
                ((exact (wrun_tail p wx rs n (CFn i) es ls m o vs out hes hc))))))))))))
;; a call of a function of the program that returns: the callee's word w, the memory m1 and
;; the outside o1 it left, then what follows the call with the local set, on m1 and o1. The
;; two runs are given on two fuels and the statement takes one for both: their sum
(theorem wends_call
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (out Outcome implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (w (BitVec 64))
   (m1 Mem)
   (o1 Os)
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hc (wfn_ans p wx rs g vs m o (ORet w m1 o1)))
   (hk (wends p wx rs k (upd ls x w) m1 o1 out)))
  (wends p wx rs (SCall x (CFn i) es k) ls m o out)
  (by
    (cases hc
      ((intro (hlen hrun)
         (cases hrun
           ((intro (nc hnc)
              (cases hk
                ((intro (nk hnk)
                   (have hc2
                     (= (wcal_run (fadd nc nk) p wx rs (CFn i) vs m o) (some (ORet w m1 o1)))
                     (show
                       (= (wfn_run (fadd nc nk) p wx rs (fn_at p i) vs m o) (some (ORet w m1 o1))))
                     (rw hg)
                     (exact
                       (wrun_back p wx rs (IFn.body g) (enter g vs) m o (ORet w m1 o1) nc hnc nk)))
                   (have hk2 (= (wnext (fadd nc nk) p wx rs x k ls (ORet w m1 o1)) (some out))
                     (exact (wrun_front p wx rs k (upd ls x w) m1 o1 out nk hnk nc)))
                   (apply (Exists.intro (FS (fadd nc nk)))
                     ((exact
                        (wrun_call p wx rs (fadd nc nk) x (CFn i) es k ls m o vs (ORet w m1 o1) out
                          hes
                          hc2
                          hk2)))))))))))))))
;; a call of a function of the program in which the process ends: the statement's outcome is
;; that end, and what follows the call is not run
(theorem wends_call_end
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (r Res)
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hc (wfn_ans p wx rs g vs m o (OEnd r))))
  (wends p wx rs (SCall x (CFn i) es k) ls m o (OEnd r))
  (by
    (cases hc
      ((intro (hlen hrun)
         (cases hrun
           ((intro (n hn)
              (have hc2 (= (wcal_run n p wx rs (CFn i) vs m o) (some (OEnd r)))
                (show (= (wfn_run n p wx rs (fn_at p i) vs m o) (some (OEnd r))))
                (rw hg)
                (exact hn))
              (have hk2 (= (wnext n p wx rs x k ls (OEnd r)) (some (OEnd r))) rfl)
              (apply (Exists.intro (FS n))
                ((exact (wrun_call p wx rs n x (CFn i) es k ls m o vs (OEnd r) (OEnd r) hes hc2 hk2))))))))))))

;; a store: the address's word and the stored word given, with the evidence that the address is
;; in a range mapped to write
(theorem wends_store
  ((p (List IFn) implicit)
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)) implicit)
   (rs (List Seg) implicit)
   (a IExp implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (o Os implicit)
   (out Outcome implicit)
   (q (BitVec 64))
   (w (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hk (wends p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o out)))
  (wends p wx rs (SStore a e k) ls m o out)
  (by
    (cases hk
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((exact (wrun_store p wx rs n a e k ls m o q w out ha he hm hn)))))))))

;; ---- code that names nothing outside -----------------------------------------------------------
;; The rules of `iends`: each is its rule of `wends` on externals that leave what is outside as
;; it was, for every outside. An external of that kind answers so in a run
(theorem wlift_is
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (j Nat)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (w (BitVec 64))
   (m1 Mem)
   (h (= (ext j vs m) (some (Prod.mk w m1)))))
  (= (wlift ext j vs m o) (some (ORet w m1 o)))
  (by (unfold wlift) (reduce) (rw h) rfl))
;; a return
(theorem iends_ret
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (iends p ext rs (SRet e) ls m v m)
  (by (intro o) (exact (wends_ret p (wlift ext) rs e ls m o v he))))
;; a branch, each way
(theorem iends_if_true
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) true))
   (hr (iends p ext rs t ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (intro o)
    (exact (wends_if_true p (wlift ext) rs a cc b t e ls m o x y (ORet v m2 o) ha hb hc (hr o)))))
(theorem iends_if_false
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) false))
   (hr (iends p ext rs e ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (intro o)
    (exact (wends_if_false p (wlift ext) rs a cc b t e ls m o x y (ORet v m2 o) ha hb hc (hr o)))))
;; a local set: the word given, everything the goal fixes left out
(theorem iends_let
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (w (BitVec 64))
   (he (= (ieval rs ls m e) (some w)))
   (hr (iends p ext rs k (upd ls x w) m v m2)))
  (iends p ext rs (SLet x e k) ls m v m2)
  (by (intro o) (exact (wends_let w he (hr o)))))
;; a store: the address's word and the stored word given, with the evidence that the address is
;; in a range mapped to write
(theorem iends_store
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (a IExp implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (q (BitVec 64))
   (w (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hr (iends p ext rs k ls (mem_put64 m (w64_val q) (w64_val w)) v m2)))
  (iends p ext rs (SStore a e k) ls m v m2)
  (by (intro o) (exact (wends_store q w ha he hm (hr o)))))
;; a tail call to a function of the program: the callee's answer is the statement's
(theorem iends_tail
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hr (fn_ans p ext rs g vs m v m2)))
  (iends p ext rs (STail (CFn i) es) ls m v m2)
  (by
    (intro o)
    (have hw (wfn_ans p (wlift ext) rs g vs m o (ORet v m2 o))
      (exact (And.intro (And.left hr) ((And.right hr) o))))
    (exact (wends_tail g vs hes hg hw))))
;; a call of a function of the program that returns: the callee's answer w and its memory m1,
;; then what follows the call run with the local set to w on m1
(theorem iends_call
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (w (BitVec 64))
   (m1 Mem)
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hc (fn_ans p ext rs g vs m w m1))
   (hk (iends p ext rs k (upd ls x w) m1 v m2)))
  (iends p ext rs (SCall x (CFn i) es k) ls m v m2)
  (by
    (intro o)
    (have hw (wfn_ans p (wlift ext) rs g vs m o (ORet w m1 o))
      (exact (And.intro (And.left hc) ((And.right hc) o))))
    (exact (wends_call g vs w m1 o hes hg hw (hk o)))))
;; a call of an outside function that returns: the function's answer on the arguments, then what
;; follows with the local set to the word it returned, on the memory it left
(theorem iends_call_ext
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (j Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (vs (List (BitVec 64)))
   (w (BitVec 64))
   (m1 Mem)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (ext j vs m) (some (Prod.mk w m1))))
   (hk (iends p ext rs k (upd ls x w) m1 v m2)))
  (iends p ext rs (SCall x (CExt j) es k) ls m v m2)
  (by (intro o) (exact (wends_call_ext vs w m1 o hes (wlift_is ext j vs m o w m1 hc) (hk o)))))
