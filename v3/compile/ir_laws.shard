;;; v3/compile/ir_laws.shard — laws of the intermediate machine (ir.shard): what a run of a
;;; statement says of the statement's parts; a run of a statement from its parts; that a run
;;; given more fuel answers the same; and from these a rule of `iends` for each statement form
;;; that a proof above the pass uses — a call that returns among them, the two runs it joins
;;; brought to one fuel.
(import "ir.shard")
(use std.mem)
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IStm)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- expressions --------------------------------------------------------------------------------
;; an expression's word, one node at a time
(theorem ieval_op
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (o IOp)
   (a IExp)
   (b IExp)
   (x (BitVec 64))
   (y (BitVec 64))
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y))))
  (= (ieval rs ls m (EOp o a b)) (some (iop o x y)))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hb) rfl))
(theorem ieval_load
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (a IExp)
   (q (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (hm (= (mapped rs (w64_val q) 8 4) true)))
  (= (ieval rs ls m (ELoad a)) (some (w64 (mem_le64 m (w64_val q)))))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hm) rfl))
(theorem ieval_load8
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (a IExp)
   (q (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (hm (= (mapped rs (w64_val q) 1 4) true)))
  (= (ieval rs ls m (ELoad8 a)) (some (w64 (mem_get m (w64_val q)))))
  (by (unfold ieval) (reduce) (rw ha) (reduce) (rw hm) rfl))
;; a comparison, from the fact a low form's test states
(theorem icmp_ltu_true ((a (BitVec 64)) (b (BitVec 64)) (h (< (w64_val a) (w64_val b))))
  (= (icmp CLtu a b) true)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) true)) (rw (if_pos h)) rfl))
(theorem icmp_ltu_false ((a (BitVec 64)) (b (BitVec 64)) (h (Not (< (w64_val a) (w64_val b)))))
  (= (icmp CLtu a b) false)
  (by (show (= (if (< (w64_val a) (w64_val b)) true false) false)) (rw (if_neg h)) rfl))
;; arguments' words, one list element at a time
(theorem ievals_nil_inv
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (vs (List (BitVec 64)))
   (h (= (ievals rs ls m nil) (some vs))))
  (= vs nil)
  (by
    (have g (= (some (@List.nil (BitVec 64))) (some vs)) (exact h))
    (exact (Eq.symm (Option.some.inj g)))))
(theorem ievals_cons_inv
  ((rs (List Seg))
   (ls (List (BitVec 64)))
   (m Mem)
   (e IExp)
   (r (List IExp))
   (vs (List (BitVec 64)))
   (h (= (ievals rs ls m (cons e r)) (some vs))))
  (exists ((v1 (BitVec 64)))
    (exists ((vr (List (BitVec 64))))
      (and (= (ieval rs ls m e) (some v1))
        (and (= (ievals rs ls m r) (some vr)) (= vs (cons v1 vr))))))
  (by
    (have g
      (-> (= (ievals rs ls m (cons e r)) (some vs))
        (exists ((v1 (BitVec 64)))
          (exists ((vr (List (BitVec 64))))
            (and (= (ieval rs ls m e) (some v1))
              (and (= (ievals rs ls m r) (some vr)) (= vs (cons v1 vr)))))))
      (rw ievals.eq_2)
      (cases (ieval rs ls m e) hv
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none vs))))
         (some (v0) (reduce)
           (cases (ievals rs ls m r) hr
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none vs))))
              (some (vr0) (reduce) (intro h0)
                (apply (Exists.intro v0)
                  ((apply (Exists.intro vr0)
                     ((apply And.intro (rfl)
                        ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0))))))))))))))))))
    (exact (g h))))
(theorem ievals_len ((rs (List Seg)) (ls (List (BitVec 64))) (m Mem) (es (List IExp)))
  (forall ((vs (List (BitVec 64))))
    (-> (= (ievals rs ls m es) (some vs)) (= (List.length vs) (List.length es))))
  (by
    (induction es
      ((nil () (intro vs h) (rw (ievals_nil_inv rs ls m vs h)) rfl)
       (cons (e r ih) (intro vs h)
         (cases (ievals_cons_inv rs ls m e r vs h)
           ((intro (v1 g1)
              (cases g1
                ((intro (vr g2) (rw (And.right (And.right g2)))
                   (show (= (+ (List.length vr) 1) (+ (List.length r) 1)))
                   (rw (ih vr (And.left (And.right g2))))
                   rfl)))))))))))

;; ---- what a run says of its parts ---------------------------------------------------------------
;; a pair of a word and a memory is its parts
;; a pair of a word and a memory is its parts
(theorem pair_inj
  ((a (BitVec 64)) (b Mem) (c (BitVec 64)) (d Mem) (h (= (Prod.mk a b) (Prod.mk c d))))
  (and (= a c) (= b d))
  (by
    (have e1 (= (Prod.fst (Prod.mk a b)) (Prod.fst (Prod.mk c d))) (rw h) rfl)
    (have e2 (= (Prod.snd (Prod.mk a b)) (Prod.snd (Prod.mk c d))) (rw h) rfl)
    (exact (And.intro e1 e2))))
(theorem irun_ret_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (= (irun (FS n1) p ext rs (SRet e) ls m) (some (Prod.mk v m2)))))
  (and (= (ieval rs ls m e) (some v)) (= m2 m))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (SRet e) ls m) (some (Prod.mk v m2)))
        (and (= (ieval rs ls m e) (some v)) (= m2 m)))
      (unfold irun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0)
           (exact (absurd (Eq.symm h0) (Option.some_ne_none (Prod.mk v m2)))))
         (some (x) (reduce) (intro h0)
           (have hp (= (Prod.mk x m) (Prod.mk v m2)) (exact (Option.some.inj h0)))
           (cases (pair_inj x m v m2 hp)
             ((intro (e1 e2) (apply And.intro ((rw e1) rfl) ((exact (Eq.symm e2)))))))))))
    (exact (g h))))
(theorem irun_let_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (h (= (irun (FS n1) p ext rs (SLet x e k) ls m) (some r))))
  (exists ((w (BitVec 64)))
    (and (= (ieval rs ls m e) (some w)) (= (irun n1 p ext rs k (upd ls x w) m) (some r))))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (SLet x e k) ls m) (some r))
        (exists ((w (BitVec 64)))
          (and (= (ieval rs ls m e) (some w)) (= (irun n1 p ext rs k (upd ls x w) m) (some r)))))
      (unfold irun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (w1) (reduce) (intro h0)
           (apply (Exists.intro w1) ((apply And.intro (rfl) ((exact h0)))))))))
    (exact (g h))))
;; a store: its address and its word, the address mapped to write, the rest on the memory after
(theorem irun_store_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (h (= (irun (FS n1) p ext rs (SStore a e k) ls m) (some r))))
  (exists ((q (BitVec 64)))
    (exists ((w (BitVec 64)))
      (and (= (ieval rs ls m a) (some q))
        (and (= (ieval rs ls m e) (some w))
          (and (= (mapped rs (w64_val q) 8 2) true)
            (= (irun n1 p ext rs k ls (mem_put64 m (w64_val q) (w64_val w))) (some r)))))))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (SStore a e k) ls m) (some r))
        (exists ((q (BitVec 64)))
          (exists ((w (BitVec 64)))
            (and (= (ieval rs ls m a) (some q))
              (and (= (ieval rs ls m e) (some w))
                (and (= (mapped rs (w64_val q) 8 2) true)
                  (= (irun n1 p ext rs k ls (mem_put64 m (w64_val q) (w64_val w))) (some r))))))))
      (unfold irun)
      (reduce)
      (cases (ieval rs ls m a) ha
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (q1) (reduce)
           (cases (ieval rs ls m e) he
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (w1) (reduce)
                (cases (mapped rs (w64_val q1) 8 2) hm
                  ((false () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (true () (reduce) (intro h0)
                     (apply (Exists.intro q1)
                       ((apply (Exists.intro w1)
                          ((apply And.intro (rfl)
                             ((apply And.intro (rfl) ((apply And.intro ((exact hm)) ((exact h0)))))))))))))))))))))
    (exact (g h))))
;; a callee's run, as a statement's run takes it: an external's answer, or the run of a
;; function's body on the fuel below
(def fn_run
  ((n Fuel)
   (p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (og (Option IFn))
   (vs (List (BitVec 64)))
   (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (match og
    (none none)
    ((some g) (irun n p ext rs (IFn.body g) (enter g vs) m))))
(def cal_run
  ((n Fuel)
   (p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (match cal
    ((CExt j) (ext j vs m))
    ((CFn i) (fn_run n p ext rs (fn_at p i) vs m))))
(theorem irun_call_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (h (= (irun (FS n1) p ext rs (SCall x cal es k) ls m) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs))
      (exists ((q (Prod (BitVec 64) Mem)))
        (and (= (cal_run n1 p ext rs cal vs m) (some q))
          (= (irun n1 p ext rs k (upd ls x (Prod.fst q)) (Prod.snd q)) (some r))))))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (SCall x cal es k) ls m) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs))
            (exists ((q (Prod (BitVec 64) Mem)))
              (and (= (cal_run n1 p ext rs cal vs m) (some q))
                (= (irun n1 p ext rs k (upd ls x (Prod.fst q)) (Prod.snd q)) (some r)))))))
      (unfold irun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce)
                     (cases (irun n1 p ext rs (IFn.body g0) (enter g0 vs0) m) hb
                       ((none () (reduce) (intro h0)
                          (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                        (some (q0) (reduce) (intro h0)
                          (apply (Exists.intro vs0)
                            ((apply And.intro (rfl)
                               ((apply (Exists.intro q0)
                                  ((apply And.intro
                                     ((show (= (fn_run n1 p ext rs (fn_at p i) vs0 m) (some q0)))
                                      (rw hf)
                                      (exact hb))
                                     ((exact h0))))))))))))))))
              (CExt (j) (reduce)
                (cases (ext j vs0 m) hx
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (q0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((apply (Exists.intro q0) ((apply And.intro ((exact hx)) ((exact h0)))))))))))))))))))
    (exact (g h))))
(theorem irun_if_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (h (= (irun (FS n1) p ext rs (SIf x cc y t e) ls m) (some r))))
  (exists ((vx (BitVec 64)))
    (exists ((vy (BitVec 64)))
      (and (= (ieval rs ls m x) (some vx))
        (and (= (ieval rs ls m y) (some vy))
          (= (irun n1 p ext rs (if (icmp cc vx vy) t e) ls m) (some r))))))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (SIf x cc y t e) ls m) (some r))
        (exists ((vx (BitVec 64)))
          (exists ((vy (BitVec 64)))
            (and (= (ieval rs ls m x) (some vx))
              (and (= (ieval rs ls m y) (some vy))
                (= (irun n1 p ext rs (if (icmp cc vx vy) t e) ls m) (some r)))))))
      (unfold irun)
      (reduce)
      (cases (ieval rs ls m x) hx
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vx0) (reduce)
           (cases (ieval rs ls m y) hy
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (vy0) (reduce) (intro h0)
                (apply (Exists.intro vx0)
                  ((apply (Exists.intro vy0)
                     ((apply And.intro (rfl) ((apply And.intro (rfl) ((exact h0))))))))))))))))
    (exact (g h))))
(theorem irun_tail_inv
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n1 Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (h (= (irun (FS n1) p ext rs (STail cal es) ls m) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs)) (= (cal_run n1 p ext rs cal vs m) (some r))))
  (by
    (have g
      (-> (= (irun (FS n1) p ext rs (STail cal es) ls m) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs)) (= (cal_run n1 p ext rs cal vs m) (some r)))))
      (unfold irun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((show (= (fn_run n1 p ext rs (fn_at p i) vs0 m) (some r)))
                           (rw hf)
                           (exact h0)))))))))
              (CExt (j) (reduce) (intro h0)
                (apply (Exists.intro vs0) ((apply And.intro (rfl) ((exact h0))))))))))))
    (exact (g h))))

;; ---- a run from its parts ------------------------------------------------------------------------
;; one statement on the fuel above its parts': the words of its expressions, then the run of
;; what follows
(theorem irun_let
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (w (BitVec 64))
   (r (Prod (BitVec 64) Mem))
   (he (= (ieval rs ls m e) (some w)))
   (hk (= (irun n p ext rs k (upd ls x w) m) (some r))))
  (= (irun (FS n) p ext rs (SLet x e k) ls m) (some r))
  (by (unfold irun) (reduce) (rw he) (reduce) (exact hk)))
(theorem irun_store
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (q (BitVec 64))
   (w (BitVec 64))
   (r (Prod (BitVec 64) Mem))
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hk (= (irun n p ext rs k ls (mem_put64 m (w64_val q) (w64_val w))) (some r))))
  (= (irun (FS n) p ext rs (SStore a e k) ls m) (some r))
  (by (unfold irun) (reduce) (rw ha) (reduce) (rw he) (reduce) (rw hm) (reduce) (exact hk)))
(theorem irun_call
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (vs (List (BitVec 64)))
   (q (Prod (BitVec 64) Mem))
   (r (Prod (BitVec 64) Mem))
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (cal_run n p ext rs cal vs m) (some q)))
   (hk (= (irun n p ext rs k (upd ls x (Prod.fst q)) (Prod.snd q)) (some r))))
  (= (irun (FS n) p ext rs (SCall x cal es k) ls m) (some r))
  (by
    (unfold irun)
    (reduce)
    (rw hes)
    (reduce)
    (cases cal
      ((CFn (i) (reduce)
         (cases (fn_at p i) hf
           ((none ()
              (have h1 (= (fn_run n p ext rs (@Option.none IFn) vs m) (some q))
                (rw (<- hf))
                (exact hc))
              (have h2 (= (@Option.none (Prod (BitVec 64) Mem)) (some q)) (exact h1))
              (exact (absurd (Eq.symm h2) (Option.some_ne_none q))))
            (some (g0)
              (have h1 (= (fn_run n p ext rs (some g0) vs m) (some q)) (rw (<- hf)) (exact hc))
              (have h2 (= (irun n p ext rs (IFn.body g0) (enter g0 vs) m) (some q)) (exact h1))
              (reduce)
              (rw h2)
              (exact hk)))))
       (CExt (j) (reduce) (have h1 (= (ext j vs m) (some q)) (exact hc)) (rw h1) (exact hk))))))
(theorem irun_if
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (r (Prod (BitVec 64) Mem))
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hk (= (irun n p ext rs (if (icmp cc x y) t e) ls m) (some r))))
  (= (irun (FS n) p ext rs (SIf a cc b t e) ls m) (some r))
  (by (unfold irun) (reduce) (rw ha) (reduce) (rw hb) (reduce) (exact hk)))
(theorem irun_tail
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (vs (List (BitVec 64)))
   (r (Prod (BitVec 64) Mem))
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (cal_run n p ext rs cal vs m) (some r))))
  (= (irun (FS n) p ext rs (STail cal es) ls m) (some r))
  (by (unfold irun) (reduce) (rw hes) (reduce) (exact hc)))

;; ---- more fuel ------------------------------------------------------------------------------------
;; A run that answers answers the same on the fuel above: the fuel bounds how deep a run goes
;; and enters no answer. A callee's run first, given it of every statement on the same fuel.
(theorem cal_run_more
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (r (Prod (BitVec 64) Mem)))
       (-> (= (irun n p ext rs s ls m) (some r)) (= (irun (FS n) p ext rs s ls m) (some r)))))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (q (Prod (BitVec 64) Mem))
   (h (= (cal_run n p ext rs cal vs m) (some q))))
  (= (cal_run (FS n) p ext rs cal vs m) (some q))
  (by
    (have g
      (-> (= (cal_run n p ext rs cal vs m) (some q)) (= (cal_run (FS n) p ext rs cal vs m) (some q)))
      (cases cal
        ((CFn (i)
           (show
             (-> (= (fn_run n p ext rs (fn_at p i) vs m) (some q))
               (= (fn_run (FS n) p ext rs (fn_at p i) vs m) (some q))))
           (cases (fn_at p i) hf
             ((none () (intro h0) (exact h0))
              (some (g0) (intro h0) (exact (ih (IFn.body g0) (enter g0 vs) m q h0))))))
         (CExt (j) (intro h0) (exact h0)))))
    (exact (g h))))
(theorem irun_more
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel))
  (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (r (Prod (BitVec 64) Mem)))
    (-> (= (irun n p ext rs s ls m) (some r)) (= (irun (FS n) p ext rs s ls m) (some r))))
  (by
    (induction n
      ((FZ () (intro s ls m r h)
         (have hn (= (irun FZ p ext rs s ls m) (@Option.none (Prod (BitVec 64) Mem))) rfl)
         (exact (absurd (Eq.symm (Eq.trans (Eq.symm hn) h)) (Option.some_ne_none r))))
       (FS (n1 ih) (intro s)
         (cases s
           ((SLet (x e k) (intro ls m r h)
              (cases (irun_let_inv p ext rs n1 x e k ls m r h)
                ((intro (w hw)
                   (exact
                     (irun_let p ext rs (FS n1) x e k ls m w r (And.left hw)
                       (ih k (upd ls x w) m r (And.right hw))))))))
            (SStore (a e k) (intro ls m r h)
              (cases (irun_store_inv p ext rs n1 a e k ls m r h)
                ((intro (q hq)
                   (cases hq
                     ((intro (w hw)
                        (exact
                          (irun_store p ext rs (FS n1) a e k ls m q w r (And.left hw)
                            (And.left (And.right hw))
                            (And.left (And.right (And.right hw)))
                            (ih k ls (mem_put64 m (w64_val q) (w64_val w)) r
                              (And.right (And.right (And.right hw)))))))))))))
            (SCall (x cal es k) (intro ls m r h)
              (cases (irun_call_inv p ext rs n1 x cal es k ls m r h)
                ((intro (vs hv)
                   (cases (And.right hv)
                     ((intro (q hq)
                        (exact
                          (irun_call p ext rs (FS n1) x cal es k ls m vs q r (And.left hv)
                            (cal_run_more p ext rs n1 ih cal vs m q (And.left hq))
                            (ih k (upd ls x (Prod.fst q)) (Prod.snd q) r (And.right hq)))))))))))
            (SIf (x cc y t e) (intro ls m r h)
              (cases (irun_if_inv p ext rs n1 x cc y t e ls m r h)
                ((intro (vx hx)
                   (cases hx
                     ((intro (vy hy)
                        (exact
                          (irun_if p ext rs (FS n1) x cc y t e ls m vx vy r (And.left hy)
                            (And.left (And.right hy))
                            (ih (if (icmp cc vx vy) t e) ls m r (And.right (And.right hy))))))))))))
            (SRet (e) (intro ls m r h) (exact h))
            (STail (cal es) (intro ls m r h)
              (cases (irun_tail_inv p ext rs n1 cal es ls m r h)
                ((intro (vs hv)
                   (exact
                     (irun_tail p ext rs (FS n1) cal es ls m vs r (And.left hv)
                       (cal_run_more p ext rs n1 ih cal vs m r (And.right hv)))))))))))))))
;; a fuel and a fuel more
(fn fadd ((a Fuel) (b Fuel)) Fuel
  (measure (struct a))
  (match a
    (FZ b)
    ((FS a1) (FS (fadd a1 b)))))
(theorem fadd_zero ((a Fuel)) (= (fadd a FZ) a)
  (by (induction a ((FZ () rfl) (FS (a1 ih) (show (= (FS (fadd a1 FZ)) (FS a1))) (rw ih) rfl)))))
(theorem fadd_succ ((a Fuel) (b Fuel)) (= (fadd a (FS b)) (FS (fadd a b)))
  (by
    (induction a
      ((FZ () rfl) (FS (a1 ih) (show (= (FS (fadd a1 (FS b))) (FS (FS (fadd a1 b))))) (rw ih) rfl)))))
;; a run that answers answers the same with any fuel put before its own, and with any after
(theorem irun_front
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (n Fuel)
   (h (= (irun n p ext rs s ls m) (some r)))
   (d Fuel))
  (= (irun (fadd d n) p ext rs s ls m) (some r))
  (by
    (induction d
      ((FZ () (exact h)) (FS (d1 ih) (exact (irun_more p ext rs (fadd d1 n) s ls m r ih)))))))
(theorem irun_back
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (r (Prod (BitVec 64) Mem))
   (n Fuel)
   (h (= (irun n p ext rs s ls m) (some r)))
   (d Fuel))
  (= (irun (fadd n d) p ext rs s ls m) (some r))
  (by
    (induction d
      ((FZ () (rw (fadd_zero n)) (exact h))
       (FS (d1 ih) (rw (fadd_succ n d1)) (exact (irun_more p ext rs (fadd n d1) s ls m r ih)))))))

;; ---- a run's rules, one statement at a time -------------------------------------------------------
(theorem iends_ret
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (iends p ext rs (SRet e) ls m v m)
  (by
    (apply (Exists.intro (FS FZ))
      ((show (= (irun (FS FZ) p ext rs (SRet e) ls m) (some (Prod.mk v m))))
       (unfold irun)
       (reduce)
       (rw he)
       rfl))))
;; a branch, each way
(theorem iends_if_true
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) true))
   (hr (iends p ext rs t ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (have hk (= (irun n p ext rs (if (icmp cc x y) t e) ls m) (some (Prod.mk v m2)))
           (rw hc)
           (exact hn))
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SIf a cc b t e) ls m) (some (Prod.mk v m2))))
            (exact (irun_if p ext rs n a cc b t e ls m x y (Prod.mk v m2) ha hb hk)))))))))
(theorem iends_if_false
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (x (BitVec 64))
   (y (BitVec 64))
   (v (BitVec 64))
   (m2 Mem)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hc (= (icmp cc x y) false))
   (hr (iends p ext rs e ls m v m2)))
  (iends p ext rs (SIf a cc b t e) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (have hk (= (irun n p ext rs (if (icmp cc x y) t e) ls m) (some (Prod.mk v m2)))
           (rw hc)
           (exact hn))
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SIf a cc b t e) ls m) (some (Prod.mk v m2))))
            (exact (irun_if p ext rs n a cc b t e ls m x y (Prod.mk v m2) ha hb hk)))))))))
;; a local set: the word given, everything the goal fixes left out
(theorem iends_let
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (w (BitVec 64))
   (he (= (ieval rs ls m e) (some w)))
   (hr (iends p ext rs k (upd ls x w) m v m2)))
  (iends p ext rs (SLet x e k) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SLet x e k) ls m) (some (Prod.mk v m2))))
            (exact (irun_let p ext rs n x e k ls m w (Prod.mk v m2) he hn)))))))))
;; a store: the address's word and the stored word given, with the evidence that the address is
;; in a range mapped to write
(theorem iends_store
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (a IExp implicit)
   (e IExp implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (q (BitVec 64))
   (w (BitVec 64))
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hr (iends p ext rs k ls (mem_put64 m (w64_val q) (w64_val w)) v m2)))
  (iends p ext rs (SStore a e k) ls m v m2)
  (by
    (cases hr
      ((intro (n hn)
         (apply (Exists.intro (FS n))
           ((show (= (irun (FS n) p ext rs (SStore a e k) ls m) (some (Prod.mk v m2))))
            (exact (irun_store p ext rs n a e k ls m q w (Prod.mk v m2) ha he hm hn)))))))))
;; a tail call to a function of the program: the callee's answer is the statement's
(theorem iends_tail
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hr (fn_ans p ext rs g vs m v m2)))
  (iends p ext rs (STail (CFn i) es) ls m v m2)
  (by
    (cases hr
      ((intro (hlen hrun)
         (cases hrun
           ((intro (n hn)
              (have hc (= (cal_run n p ext rs (CFn i) vs m) (some (Prod.mk v m2)))
                (show (= (fn_run n p ext rs (fn_at p i) vs m) (some (Prod.mk v m2))))
                (rw hg)
                (exact hn))
              (apply (Exists.intro (FS n))
                ((show (= (irun (FS n) p ext rs (STail (CFn i) es) ls m) (some (Prod.mk v m2))))
                 (exact (irun_tail p ext rs n (CFn i) es ls m vs (Prod.mk v m2) hes hc))))))))))))
;; a call of a function of the program that returns: the callee's answer w and its memory m1,
;; then what follows the call run with the local set to w on m1. The two runs are given on two
;; fuels and the statement takes one for both: the sum of the two, each run brought to it.
(theorem iends_call
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (i Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (g IFn)
   (vs (List (BitVec 64)))
   (w (BitVec 64))
   (m1 Mem)
   (hes (= (ievals rs ls m es) (some vs)))
   (hg (= (fn_at p i) (some g)))
   (hc (fn_ans p ext rs g vs m w m1))
   (hk (iends p ext rs k (upd ls x w) m1 v m2)))
  (iends p ext rs (SCall x (CFn i) es k) ls m v m2)
  (by
    (cases hc
      ((intro (hlen hrun)
         (cases hrun
           ((intro (nc hnc)
              (cases hk
                ((intro (nk hnk)
                   (have hc2 (= (cal_run (fadd nc nk) p ext rs (CFn i) vs m) (some (Prod.mk w m1)))
                     (show (= (fn_run (fadd nc nk) p ext rs (fn_at p i) vs m) (some (Prod.mk w m1))))
                     (rw hg)
                     (exact
                       (irun_back p ext rs (IFn.body g) (enter g vs) m (Prod.mk w m1) nc hnc nk)))
                   (have hk2
                     (=
                       (irun (fadd nc nk) p ext rs k (upd ls x (Prod.fst (Prod.mk w m1)))
                         (Prod.snd (Prod.mk w m1)))
                       (some (Prod.mk v m2)))
                     (exact (irun_front p ext rs k (upd ls x w) m1 (Prod.mk v m2) nk hnk nc)))
                   (apply (Exists.intro (FS (fadd nc nk)))
                     ((show
                        (= (irun (FS (fadd nc nk)) p ext rs (SCall x (CFn i) es k) ls m)
                          (some (Prod.mk v m2))))
                      (exact
                        (irun_call p ext rs (fadd nc nk) x (CFn i) es k ls m vs (Prod.mk w m1)
                          (Prod.mk v m2)
                          hes
                          hc2
                          hk2)))))))))))))))

;; a call of an outside function that returns: the function's answer on the arguments, then what
;; follows with the local set to the word it returned, on the memory it left. The outside
;; function takes no fuel, so the fuel is what follows' and one more
(theorem iends_call_ext
  ((p (List IFn) implicit)
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))) implicit)
   (rs (List Seg) implicit)
   (x Nat implicit)
   (j Nat implicit)
   (es (List IExp) implicit)
   (k IStm implicit)
   (ls (List (BitVec 64)) implicit)
   (m Mem implicit)
   (v (BitVec 64) implicit)
   (m2 Mem implicit)
   (vs (List (BitVec 64)))
   (w (BitVec 64))
   (m1 Mem)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (ext j vs m) (some (Prod.mk w m1))))
   (hk (iends p ext rs k (upd ls x w) m1 v m2)))
  (iends p ext rs (SCall x (CExt j) es k) ls m v m2)
  (by
    (cases hk
      ((intro (nk hnk)
         (have hc2 (= (cal_run nk p ext rs (CExt j) vs m) (some (Prod.mk w m1))) (exact hc))
         (have hk2
           (= (irun nk p ext rs k (upd ls x (Prod.fst (Prod.mk w m1))) (Prod.snd (Prod.mk w m1)))
             (some (Prod.mk v m2)))
           (exact hnk))
         (apply (Exists.intro (FS nk))
           ((show (= (irun (FS nk) p ext rs (SCall x (CExt j) es k) ls m) (some (Prod.mk v m2))))
            (exact
              (irun_call p ext rs nk x (CExt j) es k ls m vs (Prod.mk w m1) (Prod.mk v m2) hes hc2
                hk2)))))))))
