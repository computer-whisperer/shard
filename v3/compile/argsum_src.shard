;;; v3/compile/argsum_src.shard — the meaning of `argsum`, a program of its command-line
;;; arguments (docs/COMPILE.md §5): the sum of the decimal numbers given after the name the
;;; program was run by. An argument is its bytes, a list of numbers; the sum is in word
;;; arithmetic. A byte that is no digit is counted as a digit all the same: its number less 48,
;;; in a word.
(import "../models/x86/word.shard")
(use models.x86.word)
(use Init.List cons nil)

;; the number a string's digits spell after the number acc: ten times the number so far, and
;; the digit
(fn digits ((bs (List Nat)) (acc (BitVec 64))) (BitVec 64)
  (measure (struct bs))
  (match bs
    (nil acc)
    ((cons b r) (digits r (w64_add (w64_mul acc (w64 10)) (w64_sub (w64 b) (w64 48)))))))
;; the numbers of a list of strings added to acc
(fn sum_strs ((ss (List (List Nat))) (acc (BitVec 64))) (BitVec 64)
  (measure (struct ss))
  (match ss
    (nil acc)
    ((cons s r) (sum_strs r (w64_add acc (digits s (w64 0)))))))
;; of a program's arguments: the first, its name, is passed over
(fn argsum ((args (List (List Nat)))) (BitVec 64)
  (match args
    (nil (w64 0))
    ((cons name r) (sum_strs r (w64 0)))))
;; of `argsum 12 30`: 42
(theorem sample_argsum ()
  (= (w64_val (argsum (list (list 97 114 103 115 117 109) (list 49 50) (list 51 48)))) 42)
  (by decide))
