;;; v3/compile/gap_obj.shard — the intermediate code of `gap`'s module (docs/COMPILE.md
;;; §5): the code as data, which the pass reads and a file's writer runs. It calls `sqdiff` as
;;; a function OUTSIDE its module: of `sqdiff` the code has an index and no code. Written by
;;; hand from the low form in the directory `gap`, whose view states what its run answers.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use Init.List cons nil)
(use Init.Option none some)

;; Locals: 0 px, 1 py, 2 n, then the two values. One function, the module's only one.
(fn gap_code () IFn
  (MkIFn 3 2
    (SCall 3 (CExt 0) (list (EVar 0) (EVar 1) (EVar 2))
      (SCall 4 (CExt 0) (list (EVar 1) (EVar 0) (EVar 2)) (SRet (EOp OSub (EVar 3) (EVar 4)))))))
(fn gap_prog () (List IFn) (list gap_code))
(theorem gap_code_is () (= (fn_at gap_prog 0) (some gap_code)) (by rfl))
