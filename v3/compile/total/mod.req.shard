;;; v3/compile/total — the module of `total`, a caller of `both` and of `dot`: `both` of the two
;;; buffers, and to its word the sum of the squares of the second buffer, read after the call
;;; (`total`, ../total_src.shard). The view: the low form as a signature, with the evidence
;;; `both` asks for; and its facts as laws — the word is the meaning's and the memory after holds
;;; the meaning's list at the first address; every byte outside the first buffer's words is as
;;; it was; and the run of the module's intermediate code (../total_obj.shard) answers the low
;;; form with any outside functions whose function 0 answers as `both`'s low form and function 1
;;; as `dot`'s. Of `both` and `dot`, this view and the module behind it have their views and
;;; nothing else: nothing of `addto`.
(import "../both")
(import "../dot")
(import "../two.shard")
(import "../upd.shard")
(import "../sample.shard")
(import "../total_src.shard")
(import "../total_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.upd)
(use compile.sample)
(use compile.both)
(use compile.dot)
(use compile.total_src)
(use compile.total_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the low form -------------------------------------------------------------------------------
(sig fn total_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (Prod (BitVec 64) Mem))

;; ---- the first fact -------------------------------------------------------------------------------
;; where two lists stand in memory at the two addresses: the word is the meaning's, and the
;; meaning's list stands at the first address after
(requirement total_lo_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (and (= (Prod.fst (total_lo rs m px py n ex ew ey ea)) (Prod.fst (total xs ys n rx ry)))
    (holds (Prod.snd (total_lo rs m px py n ex ew ey ea)) (w64_val px)
      (Prod.snd (total xs ys n rx ry)))))
;; ---- what it leaves alone -------------------------------------------------------------------------
(requirement total_lo_keeps
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (same_outside m (Prod.snd (total_lo rs m px py n ex ew ey ea)) (w64_val px)
    (+ (w64_val px) (* 8 (w64_val n)))))

;; ---- the second fact's front step -----------------------------------------------------------------
;; in any program, with any outside functions whose function 0 answers as `both`'s low form and
;; function 1 as `dot`'s
(requirement total_tie
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n))
   (ha (forall ((vs (List (BitVec 64))) (m1 Mem)) (= (ext 0 vs m1) (upd_ext both_lo rs vs m1))))
   (hd (forall ((vs (List (BitVec 64))) (m1 Mem)) (= (ext 1 vs m1) (two_ext dot_lo rs vs m1)))))
  (fn_ans p ext rs total_code (cons px (cons py (cons n nil))) m
    (Prod.fst (total_lo rs m px py n ex ew ey ea))
    (Prod.snd (total_lo rs m px py n ex ew ey ea))))
;; the functions the module calls from outside, by their answers
(def total_ext ((rs (List Seg)) (j Nat) (vs (List (BitVec 64))) (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (if (= j 0) (upd_ext both_lo rs vs m)
  (if (= j 1) (two_ext dot_lo rs vs m)
  none)))
(theorem total_prog_tie
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (fn_ans total_prog (total_ext rs) rs total_code (cons px (cons py (cons n nil))) m
    (Prod.fst (total_lo rs m px py n ex ew ey ea))
    (Prod.snd (total_lo rs m px py n ex ew ey ea)))
  (by
    (have ha
      (forall ((vs (List (BitVec 64))) (m1 Mem))
        (= (total_ext rs 0 vs m1) (upd_ext both_lo rs vs m1)))
      (intro vs m1)
      rfl)
    (have hd
      (forall ((vs (List (BitVec 64))) (m1 Mem))
        (= (total_ext rs 1 vs m1) (two_ext dot_lo rs vs m1)))
      (intro vs m1)
      rfl)
    (exact (total_tie total_prog (total_ext rs) rs m px py n ex ew ey ea ha hd))))
(theorem total_ans_tie
  ((rs (List Seg))
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (upd_ans total_lo rs vs m v m2)))
  (fn_ans total_prog (total_ext rs) rs total_code vs m v m2)
  (exact
    (upd_ans_tie total_lo total_prog (total_ext rs) rs total_code
      (fun
        ((m1 Mem)
         (px (BitVec 64))
         (py (BitVec 64))
         (n (BitVec 64))
         (ex (buf_ok rs px n 4))
         (ew (buf_ok rs px n 2))
         (ey (buf_ok rs py n 4))
         (ea (apart px py n)))
        (total_prog_tie rs m1 px py n ex ew ey ea))
      vs
      m
      v
      m2
      h)))

;; ---- the code's answer is the meaning's value -----------------------------------------------------
;; the facts together: in a memory that holds xs and ys at px and py, the code answers the word
;; of `total xs ys`, and leaves the low form's memory
(theorem total_answer
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (fn_ans total_prog (total_ext rs) rs total_code (cons px (cons py (cons n nil))) m
    (Prod.fst (total xs ys n rx ry))
    (Prod.snd (total_lo rs m px py n ex ew ey ea)))
  (by
    (rw (<- (And.left (total_lo_means rs m px py n ex ew ey ea xs ys rx ry hx hy))))
    (exact (total_prog_tie rs m px py n ex ew ey ea))))

;; on the sample arguments (../sample.shard): the first buffer is mapped to write, and the two
;; lie apart
(theorem sample_ew () (buf_ok sample_rs (w64 140737488347112) (w64 3) 2)
  (by
    (apply And.intro
      ((apply (mapped_words_of sample_rs (w64_val (w64 140737488347112)) (w64_val (w64 3)) 2)
         (decide)))
      ((decide)))))
(theorem sample_ea () (apart (w64 140737488347112) (w64 140737488347088) (w64 3))
  (by (apply Or.inr ((decide)))))
(theorem sample_total_answer
  ((m Mem) (hx (holds m 140737488347112 sample_xs)) (hy (holds m 140737488347088 sample_ys)))
  (exists ((m2 Mem))
    (fn_ans total_prog (total_ext sample_rs) sample_rs total_code
      (cons (w64 140737488347112) (cons (w64 140737488347088) (cons (w64 3) nil)))
      m
      (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))
      m2))
  (exact
    (Exists.intro
      (Prod.snd
        (total_lo sample_rs m (w64 140737488347112) (w64 140737488347088) (w64 3) sample_ex
          sample_ew
          sample_ey
          sample_ea))
      (total_answer sample_rs m (w64 140737488347112) (w64 140737488347088) (w64 3) sample_ex
        sample_ew
        sample_ey
        sample_ea
        sample_xs
        sample_ys
        sample_rx
        sample_ry
        hx
        hy))))
