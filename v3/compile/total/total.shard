;;; v3/compile/total/total.shard — the implementation of the view. The low form: `both`'s low form,
;;; then `dot`'s on the second buffer in the memory `both` leaves. The first fact: `both`'s, and
;;; for the read after the call what `both`'s view says it left alone — the two memories agree
;;; on the second buffer's words, so `dot`, which by its first fact reads those words and
;;; nothing else, gives one value before and after. Nothing here is about what `both` calls.
(import "../both")
(import "../dot")
(import "../two.shard")
(import "../upd.shard")
(import "../total_src.shard")
(import "../total_obj.shard")
(import "../ir_laws.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.upd)
(use compile.ir_laws)
(use compile.both)
(use compile.dot)
(use compile.total_src)
(use compile.total_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn total_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (Prod (BitVec 64) Mem)
  (Prod.mk
    (w64_add (Prod.fst (both_lo rs m px py n ex ew ey ea))
      (dot_lo rs (Prod.snd (both_lo rs m px py n ex ew ey ea)) py py n ey ey))
    (Prod.snd (both_lo rs m px py n ex ew ey ea))))
(fulfills total_lo_means
  (by
    (rw total_lo.eq_1)
    (cases (both_lo_means rs m px py n ex ew ey ea xs ys rx ry hx hy)
      ((intro (hv hs)
         ;; the second buffer across the call: `both` left it alone, so `dot` reads it the same
         (have hk
           (same_on m (Prod.snd (both_lo rs m px py n ex ew ey ea)) (w64_val py)
             (+ (w64_val py) (* 8 (w64_val n))))
           (exact
             (kept_apart m (Prod.snd (both_lo rs m px py n ex ew ey ea)) px py n
               (both_lo_keeps rs m px py n ex ew ey ea)
               ea)))
         (have e1
           (= (dot_lo rs (Prod.snd (both_lo rs m px py n ex ew ey ea)) py py n ey ey)
             (dot_lo rs m py py n ey ey))
           (exact
             (reads_on dot_lo dot dot_lo_means rs m (Prod.snd (both_lo rs m px py n ex ew ey ea)) py
               py
               n
               ey
               ey
               hk
               hk)))
         (have e2 (= (dot_lo rs m py py n ey ey) (dot ys ys n ry ry))
           (exact (dot_lo_means rs m py py n ey ey ys ys ry ry hy hy)))
         (apply And.intro
           ((show
              (=
                (w64_add (Prod.fst (both_lo rs m px py n ex ew ey ea))
                  (dot_lo rs (Prod.snd (both_lo rs m px py n ex ew ey ea)) py py n ey ey))
                (w64_add (Prod.fst (both xs ys n rx ry)) (dot ys ys n ry ry))))
            (rw hv)
            (rw (Eq.trans e1 e2))
            rfl)
           ((exact hs))))))))
(fulfills total_lo_keeps (by (rw total_lo.eq_1) (exact (both_lo_keeps rs m px py n ex ew ey ea))))
(fulfills total_tie
  (by
    (rw total_lo.eq_1)
    (apply And.intro (rfl)
      ((apply
         (iends_call_ext (cons px (cons py (cons n nil)))
           (Prod.fst (both_lo rs m px py n ex ew ey ea))
           (Prod.snd (both_lo rs m px py n ex ew ey ea)))
         (rfl)
         ((rw (ha (cons px (cons py (cons n nil))) m))
          (exact (upd_ext_is both_lo rs m px py n ex ew ey ea)))
         ((apply
            (iends_call_ext (cons py (cons py (cons n nil)))
              (dot_lo rs (Prod.snd (both_lo rs m px py n ex ew ey ea)) py py n ey ey)
              (Prod.snd (both_lo rs m px py n ex ew ey ea)))
            (rfl)
            ((rw (hd (cons py (cons py (cons n nil))) (Prod.snd (both_lo rs m px py n ex ew ey ea))))
             (exact
               (two_ext_is dot_lo rs (Prod.snd (both_lo rs m px py n ex ew ey ea)) py py n ey ey)))
            ((apply iends_ret (rfl))))))))))
