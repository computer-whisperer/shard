;;; v3/compile/both/both.shard — the implementation of the view: the low form, `dot`'s low form on
;;; the memory `addto`'s low form leaves; the first fact by the first facts of the two; what it
;;; leaves alone by `addto`'s; and the tie, at each call the answer of the callee's low form on
;;; words that have the evidence.
(import "../addto")
(import "../dot")
(import "../two.shard")
(import "../upd.shard")
(import "../both_obj.shard")
(import "../ir_laws.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.upd)
(use compile.ir_laws)
(use compile.addto)
(use compile.dot)
(use compile.both_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn both_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (Prod (BitVec 64) Mem)
  (Prod.mk (dot_lo rs (Prod.snd (addto_lo rs m px py n ex ew ey ea)) px px n ex ex)
    (Prod.snd (addto_lo rs m px py n ex ew ey ea))))
(fulfills both_lo_means
  (by
    (rw both_lo.eq_1)
    (have hs
      (holds (Prod.snd (addto_lo rs m px py n ex ew ey ea)) (w64_val px) (addto xs ys n rx ry))
      (exact (addto_lo_means rs m px py n ex ew ey ea xs ys rx ry hx hy)))
    (apply And.intro
      ((show
         (= (dot_lo rs (Prod.snd (addto_lo rs m px py n ex ew ey ea)) px px n ex ex)
           (dot (addto xs ys n rx ry) (addto xs ys n rx ry) n (addto_room xs ys n rx ry)
             (addto_room xs ys n rx ry))))
       (exact
         (dot_lo_means rs (Prod.snd (addto_lo rs m px py n ex ew ey ea)) px px n ex ex
           (addto xs ys n rx ry)
           (addto xs ys n rx ry)
           (addto_room xs ys n rx ry)
           (addto_room xs ys n rx ry)
           hs
           hs)))
      ((exact hs)))))
(fulfills both_lo_keeps (by (rw both_lo.eq_1) (exact (addto_lo_keeps rs m px py n ex ew ey ea))))
(fulfills both_tie
  (by
    (rw both_lo.eq_1)
    (apply And.intro (rfl)
      ((apply
         (iends_call_ext (cons px (cons py (cons n nil)))
           (Prod.fst (addto_lo rs m px py n ex ew ey ea))
           (Prod.snd (addto_lo rs m px py n ex ew ey ea)))
         (rfl)
         ((rw (ha (cons px (cons py (cons n nil))) m))
          (exact (upd_ext_is addto_lo rs m px py n ex ew ey ea)))
         ((apply
            (iends_call_ext (cons px (cons px (cons n nil)))
              (dot_lo rs (Prod.snd (addto_lo rs m px py n ex ew ey ea)) px px n ex ex)
              (Prod.snd (addto_lo rs m px py n ex ew ey ea)))
            (rfl)
            ((rw
               (hd (cons px (cons px (cons n nil))) (Prod.snd (addto_lo rs m px py n ex ew ey ea))))
             (exact
               (two_ext_is dot_lo rs (Prod.snd (addto_lo rs m px py n ex ew ey ea)) px px n ex ex)))
            ((apply iends_ret (rfl))))))))))
