;;; v3/compile/greet_src.shard — the meaning of `greet`, a program that writes: a function on a
;;; World (std/world.shard), its value a word — the status its process exits with — and the
;;; World after. It writes "hello, world" and a line's end in two pieces, the second only where
;;; the first left the process running.
(import "../std/world.shard")
(import "../models/x86/word.shard")
(use std.world)
(use std.world.World)
(use models.x86.word)
(use Init.List cons nil)

;; "hello, w" and "orld" with a line's end: the text as the two words of memory that hold it
(fn greet_one () (List Nat) (list 104 101 108 108 111 44 32 119))
(fn greet_two () (List Nat) (list 111 114 108 100 10))
(fn greet ((w World)) (Prod (BitVec 64) World)
  (Prod.mk (w64 0) (write_all greet_two (write_all greet_one w))))
