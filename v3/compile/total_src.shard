;;; v3/compile/total_src.shard — the meaning of `total`: `both` of two buffers — the second added
;;; into the first, and the sum of the squares of the result — and to that the sum of the squares
;;; of the second, which `both` did not write; with the first buffer as `both` leaves it. A
;;; function over two lists and a count; and its value on the sample lists.
(import "../models/x86/buffers.shard")
(use models.x86.buffers)
(use models.x86.word)

(fn total
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (Prod (BitVec 64) (List (BitVec 64)))
  (Prod.mk (w64_add (Prod.fst (both xs ys n rx ry)) (dot ys ys n ry ry))
    (Prod.snd (both xs ys n rx ry))))
;; of 3 5 7 and 2 4 6: the first becomes 5 9 13, whose squares sum to 275; and 4 + 16 + 36
(theorem sample_total ()
  (= (w64_val (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))) 331)
  (by decide))
