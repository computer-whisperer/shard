;;; v3/compile/gap_src.shard — the meaning of `gap` (docs/COMPILE.md §5): `sqdiff` of two buffers
;;; less `sqdiff` of the same two the other way round.
;;; A function over two lists and a count, as `dot` is (v3/models/x86/buffers.shard); and its
;;; value on the sample lists.
(import "sqdiff_src.shard")
(use compile.sqdiff_src)
(use models.x86.buffers)
(use models.x86.word)

(fn gap
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (BitVec 64)
  (w64_sub (sqdiff xs ys n rx ry) (sqdiff ys xs n ry rx)))
;; of 3 5 7 and 2 4 6: 27 less the 27 below zero of the other way round
(theorem sample_gap () (= (w64_val (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)) 54)
  (by decide))
