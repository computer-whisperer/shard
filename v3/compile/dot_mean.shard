;;; v3/compile/dot_mean.shard — the low form of `dot` against its meaning (docs/COMPILE.md §5,
;;; the first fact). Where two lists stand in memory at the two addresses and the low form's
;;; evidence holds, the low form's value is the meaning-level function's (`dot`,
;;; v3/models/x86/buffers.shard). With the tie of `dot_ir.shard`, the answer of `dot`'s
;;; intermediate code is then the meaning's value; and that stated of the sample buffers.
(import "dot_ir.shard")
(import "../models/x86/buffers.shard")
(import "../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.dot_lo)
(use compile.dot_ir)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.List cons nil)

;; ---- the low form's value is the meaning's ------------------------------------------------------
;; the loop: by induction on its measure, each side's equation at the test, and a read of word i
;; of a buffer for the list's word at i
(theorem dot_lo_go_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys))
   (k Nat))
  (forall ((i (BitVec 64)) (acc (BitVec 64)))
    (-> (= (- (w64_val n) (w64_val i)) k)
      (= (dot_lo_go rs m px py n ex ey i acc) (dot_go xs ys n rx ry i acc))))
  (by
    (wf k k ih (intro i acc hk)
      (cases (Nat.decLt (w64_val i) (w64_val n))
        ((isFalse (h) (rw (dot_lo_go_done rs m px py n ex ey i acc h))
           (rw (dot_go_done xs ys n rx ry i acc h))
           rfl)
         (isTrue (h)
           (have hdec (< (- (w64_val n) (w64_val (w64_add i (w64 1)))) k)
             (rw (<- hk))
             (exact (loop_descends n i h)))
           (rw (dot_lo_go_turn rs m px py n ex ey i acc h))
           (rw (dot_go_turn xs ys n rx ry i acc h))
           (rw
             (rd_word rs m px n 4 i xs ex h hx (Nat.lt_of_lt_of_le h rx) (at8_ok rs px n 4 i ex h)))
           (rw
             (rd_word rs m py n 4 i ys ey h hy (Nat.lt_of_lt_of_le h ry) (at8_ok rs py n 4 i ey h)))
           (exact
             (ih (- (w64_val n) (w64_val (w64_add i (w64 1)))) hdec (w64_add i (w64 1))
               (w64_add acc
                 (w64_mul (word_at xs i (Nat.lt_of_lt_of_le h rx))
                   (word_at ys i (Nat.lt_of_lt_of_le h ry))))
               (Eq.refl (- (w64_val n) (w64_val (w64_add i (w64 1)))))))))))))
(theorem dot_lo_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (= (dot_lo rs m px py n ex ey) (dot xs ys n rx ry))
  (exact
    (dot_lo_go_means rs m px py n ex ey xs ys rx ry hx hy (- (w64_val n) (w64_val (w64 0))) (w64 0)
      (w64 0)
      (Eq.refl (- (w64_val n) (w64_val (w64 0)))))))

;; ---- the code's answer is the meaning's value -----------------------------------------------------
;; the tie and the fact above: on the arguments px py n, in a memory that holds xs and ys there,
;; `dot`'s code answers `dot xs ys` and leaves the memory as it was
(theorem dot_answer
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (fn_ans dot_prog ext rs dot_code (cons px (cons py (cons n nil))) m (dot xs ys n rx ry) m)
  (by
    (rw (<- (dot_lo_means rs m px py n ex ey xs ys rx ry hx hy)))
    (exact (dot_prog_tie ext rs m px py n ex ey))))

;; ---- the sample ----------------------------------------------------------------------------------
;; the sum of the products of 3 5 7 and 2 4 6
(theorem sample_dot () (= (w64_val (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)) 68)
  (by decide))
;; the code's answer on the sample arguments (`dot_lo.shard`), in any memory that holds the two
;; sample buffers at the sample addresses
(theorem sample_answer
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (m Mem)
   (hx (holds m 140737488347112 sample_xs))
   (hy (holds m 140737488347088 sample_ys)))
  (fn_ans dot_prog ext sample_rs dot_code
    (cons (w64 140737488347112) (cons (w64 140737488347088) (cons (w64 3) nil)))
    m
    (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)
    m)
  (exact
    (dot_answer ext sample_rs m (w64 140737488347112) (w64 140737488347088) (w64 3) sample_ex
      sample_ey
      sample_xs
      sample_ys
      sample_rx
      sample_ry
      hx
      hy)))
