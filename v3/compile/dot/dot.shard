;;; v3/compile/dot/dot.shard — the implementation of the view: the low form is the loop from
;;; index and sum 0; each of the view's two laws is the loop's fact at that start.
(import "low.shard")
(import "mean.shard")
(import "tie.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.dot_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

(fn dot_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (BitVec 64)
  (dot_lo_go rs m px py n ex ey (w64 0) (w64 0)))
(fulfills dot_lo_means
  (by
    (rw dot_lo.eq_1)
    (exact
      (dot_lo_go_means rs m px py n ex ey xs ys rx ry hx hy (- (w64_val n) (w64_val (w64 0)))
        (w64 0)
        (w64 0)
        (Eq.refl (- (w64_val n) (w64_val (w64 0))))))))
(fulfills dot_prog_tie
  (by
    (rw dot_lo.eq_1)
    (exact (dot_tie dot_prog ext rs m px py n ex ey (Eq.refl (some dot_go_code))))))
