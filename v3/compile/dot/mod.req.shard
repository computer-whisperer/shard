;;; v3/compile/dot — the module of `dot`, the sum of the products of two buffers' words
;;; (docs/COMPILE.md §5). This view is the whole of what any other file knows of it: the low
;;; form as a signature — a function of the ranges, the memory, two addresses and a count as
;;; words, and the evidence about the two buffers — and the two facts as laws the module proves:
;;; the low form's value is the meaning's (`dot`, v3/models/x86/buffers.shard), and the run of
;;; the module's intermediate code (../dot_obj.shard) answers the low form's value. The low form
;;; as the answer of a function called from outside its module is `two_ext dot_lo`
;;; (../two.shard). A caller, the author of hand-written instructions for `dot`, and a file that
;;; links the code reason from these.
(import "../lo.shard")
(import "../two.shard")
(import "../sample.shard")
(import "../dot_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use compile.two)
(use compile.sample)
(use compile.dot_obj)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the low form -------------------------------------------------------------------------------
(sig fn dot_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (BitVec 64))

;; ---- the first fact: the low form's value is the meaning's ----------------------------------------
;; where two lists stand in memory at the two addresses
(requirement dot_lo_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (= (dot_lo rs m px py n ex ey) (dot xs ys n rx ry)))

;; ---- the second fact's front step: the code's run answers the low form's value --------------------
;; the module's two functions as one program, with any functions outside it
(requirement dot_prog_tie
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (fn_ans dot_prog ext rs dot_code (cons px (cons py (cons n nil))) m (dot_lo rs m px py n ex ey) m))
;; whatever the low form's answer says (`two_ans`, ../two.shard), the code's run answers: so
;; code that realizes the run's answer realizes the answer a caller outside the module runs with
(theorem dot_ans_tie
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (two_ans dot_lo rs vs m v m2)))
  (fn_ans dot_prog ext rs dot_code vs m v m2)
  (exact
    (two_ans_tie dot_lo dot_prog ext rs dot_code
      (fun
        ((m1 Mem)
         (px (BitVec 64))
         (py (BitVec 64))
         (n (BitVec 64))
         (ex (buf_ok rs px n 4))
         (ey (buf_ok rs py n 4)))
        (dot_prog_tie ext rs m1 px py n ex ey))
      vs
      m
      v
      m2
      h)))

;; ---- the code's answer is the meaning's value -----------------------------------------------------
;; the tie and the fact above: on the arguments px py n, in a memory that holds xs and ys there,
;; `dot`'s code answers `dot xs ys` and leaves the memory as it was
(theorem dot_answer
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (fn_ans dot_prog ext rs dot_code (cons px (cons py (cons n nil))) m (dot xs ys n rx ry) m)
  (by
    (rw (<- (dot_lo_means rs m px py n ex ey xs ys rx ry hx hy)))
    (exact (dot_prog_tie ext rs m px py n ex ey))))

;; ---- the sample ----------------------------------------------------------------------------------

;; on the sample arguments (../sample.shard), the data at any address b, in any memory that
;; holds the two sample buffers there
(theorem sample_answer
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (b Nat)
   (m Mem)
   (hb (<= (+ b 48) 140737488355328))
   (hx (holds m (+ b 24) sample_xs))
   (hy (holds m b sample_ys)))
  (fn_ans dot_prog ext (sample_rs b) dot_code (sample_args b) m
    (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)
    m)
  (exact
    (dot_answer ext (sample_rs b) m (sample_px b) (sample_py b) (w64 3) (sample_ex b hb)
      (sample_ey b hb)
      sample_xs
      sample_ys
      sample_rx
      sample_ry
      (sample_hx b m hb hx)
      (sample_hy b m hb hy))))
