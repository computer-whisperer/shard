;;; v3/compile/dot/low.shard — the loop of `dot`'s low form, which is the loop from index and
;;; sum 0 (`dot.shard`): each read through `rd64` with the evidence that its address is in the
;;; ranges; the loop's one equation at each side of its test; and its value on the sample
;;; memory, by evaluation.
(import "../lo.shard")
(import "../sample.shard")
(use std.mem)
(use compile.lo)
(use compile.sample)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)

;; ---- the low form ------------------------------------------------------------------------------
(fn dot_lo_go
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64))
   (acc (BitVec 64)))
  (BitVec 64)
  (measure (- (w64_val n) (w64_val i)))
  (dif h (< (w64_val i) (w64_val n))
    (dot_lo_go rs m px py n ex ey (w64_add i (w64 1))
      (w64_add acc
        (w64_mul (rd64 rs m (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h))
          (rd64 rs m (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h)))))
    acc))
(fulfills dot_lo_go.dec_1 (by (intro p h) (apply loop_descends (exact h))))

;; ---- the loop's two cases: its one equation, at each side of its test -----------------------------
(theorem dot_lo_go_turn
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (< (w64_val i) (w64_val n))))
  (= (dot_lo_go rs m px py n ex ey i acc)
    (dot_lo_go rs m px py n ex ey (w64_add i (w64 1))
      (w64_add acc
        (w64_mul (rd64 rs m (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h))
          (rd64 rs m (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h))))))
  (by (rw dot_lo_go.eq_1 (occ 1)) (rw (dif_pos h)) rfl))
(theorem dot_lo_go_done
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (i (BitVec 64))
   (acc (BitVec 64))
   (h (Not (< (w64_val i) (w64_val n)))))
  (= (dot_lo_go rs m px py n ex ey i acc) acc)
  (by (rw dot_lo_go.eq_1) (rw (dif_neg h)) rfl))


;; ---- the sample ----------------------------------------------------------------------------------
;; the low form on the sample memory, by evaluation: 3*2 + 5*4 + 7*6
(theorem sample_dot_lo ()
  (=
    (w64_val
      (dot_lo_go sample_rs sample_m (w64 140737488347112) (w64 140737488347088) (w64 3) sample_ex
        sample_ey
        (w64 0)
        (w64 0)))
    68)
  (by decide))
