;;; v3/compile/rep.shard — representations: how a value of a program stands in a machine's
;;; memory and words, as a relation with a REGION. Each says where the value stands — inside
;;; [lo, hi) — and comes with the lemmas a match on the value gives, stated in the very terms
;;; code computes (the word loaded, the test's outcome, the rest at the next address), and a
;;; `_keep` lemma: the value stands in any memory that is the first outside a range apart from
;;; its region (`same_outside`, models/x86/laws.shard). So a tie (tie.shard) cites a lemma for
;;; each load and test, carries a value over a store or a call that stores by one `_keep`, and
;;; proves no arithmetic of its own. Nothing here names a stack's range: what a run may read
;;; or write is a fact about its range list (`readable`, `writable`). Here: a character as a
;;; word; a string with its 0; n bytes; a scratch word a function may store in; a list of
;;; strings as an array of addresses with a count; the kernel's argument block.
(import "ir_laws.shard")
(import "../models/x86/args.shard")
(import "../models/x86/bytes.shard")
(use std.mem)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use models.x86.args)
(use models.x86.bytes)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Seg)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- what a run may read and write --------------------------------------------------------------
(def readable ((rs (List Seg)) (lo Nat) (hi Nat)) Prop
  (forall ((a Nat) (n Nat)) (-> (<= lo a) (<= (+ a n) hi) (= (mapped rs a n 4) true))))
(def writable ((rs (List Seg)) (lo Nat) (hi Nat)) Prop
  (forall ((a Nat) (n Nat)) (-> (<= lo a) (<= (+ a n) hi) (= (mapped rs a n 2) true))))
(theorem args_rs_readable ((b Nat) (hi Nat)) (readable (args_rs b hi) b hi)
  (by (intro a n h1 h2) (exact (args_rs_mapped b hi a n h1 h2))))
(theorem args_rs_writable ((b Nat) (hi Nat)) (writable (args_rs b hi) b hi)
  (by
    (intro a n h1 h2)
    (have b2 (= (band 6 2) 2) (decide))
    (exact (mapped_head (MkSeg b hi 6) nil a n 2 (seg_holds_in b hi 6 a n 2 h1 h2 b2)))))
(theorem readable_in
  ((rs (List Seg))
   (lo Nat)
   (hi Nat)
   (lo2 Nat)
   (hi2 Nat)
   (h (readable rs lo hi))
   (h1 (<= lo lo2))
   (h2 (<= hi2 hi)))
  (readable rs lo2 hi2)
  (by
    (intro a n k1 k2)
    (have j1 (<= lo a) (arith))
    (have j2 (<= (+ a n) hi) (arith))
    (exact (h a n j1 j2))))
(theorem writable_in
  ((rs (List Seg))
   (lo Nat)
   (hi Nat)
   (lo2 Nat)
   (hi2 Nat)
   (h (writable rs lo hi))
   (h1 (<= lo lo2))
   (h2 (<= hi2 hi)))
  (writable rs lo2 hi2)
  (by
    (intro a n k1 k2)
    (have j1 (<= lo a) (arith))
    (have j2 (<= (+ a n) hi) (arith))
    (exact (h a n j1 j2))))

;; ---- memory the same in a region -------------------------------------------------------------------
;; a string's bytes and its 0 in [lo, hi) stand in a memory that is the first outside [a, c),
;; a range apart from [lo, hi)
(theorem str_at_keep
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (a Nat)
   (c Nat)
   (hs (same_outside m m2 a c))
   (hd (or (<= c lo) (<= hi a)))
   (bs (List Nat)))
  (forall ((q Nat)) (-> (<= lo q) (< (+ q (List.length bs)) hi) (str_at m q bs) (str_at m2 q bs)))
  (by
    (induction bs
      ((nil () (intro q h1 h2 h3) (have h2b (< (+ q 0) hi) (exact h2))
         (have hx (or (< q a) (<= c q))
           (cases hd ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((arith)))))))
         (show (= (mem_get m2 q) 0))
         (rw (hs q hx))
         (exact h3))
       (cons (b r ih) (intro q h1 h2 h3) (have hlen (< (+ q (+ (List.length r) 1)) hi) (exact h2))
         (have hx (or (< q a) (<= c q))
           (cases hd ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((arith)))))))
         (have e1 (= (mem_get m q) b) (exact (And.left h3)))
         (have e2 (< 0 b) (exact (And.left (And.right h3))))
         (have e3 (str_at m (+ q 1) r) (exact (And.right (And.right h3))))
         (have g1 (= (mem_get m2 q) b) (rw (hs q hx)) (exact e1))
         (have k1 (<= lo (+ q 1)) (arith))
         (have k2 (< (+ (+ q 1) (List.length r)) hi) (arith))
         (exact (And.intro g1 (And.intro e2 (ih (+ q 1) k1 k2 e3)))))))))
;; n bytes apart from the range
(theorem mem_bytes_keep ((m Mem) (m2 Mem) (a Nat) (c Nat) (hs (same_outside m m2 a c)) (n Nat))
  (forall ((q Nat)) (-> (or (<= c q) (<= (+ q n) a)) (= (mem_bytes m2 q n) (mem_bytes m q n))))
  (by
    (induction n
      ((zero () (intro q hd) (show (= (mem_bytes m2 q 0) (mem_bytes m q 0)))
         (rw (mem_bytes_zero m2 q))
         (rw (mem_bytes_zero m q))
         rfl)
       (succ (j ih) (intro q hd0) (have hd (or (<= c q) (<= (+ q (+ j 1)) a)) (exact hd0))
         (have hx (or (< q a) (<= c q))
           (cases hd ((inl (hl) (apply Or.inr ((exact hl)))) (inr (hr) (apply Or.inl ((arith)))))))
         (have hn (or (<= c (+ q 1)) (<= (+ (+ q 1) j) a))
           (cases hd ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
         (show (= (mem_bytes m2 q (+ j 1)) (mem_bytes m q (+ j 1))))
         (rw (mem_bytes_succ m2 q j))
         (rw (mem_bytes_succ m q j))
         (rw (hs q hx))
         (rw (ih (+ q 1) hn))
         rfl)))))
;; the addresses of a list of strings, the array and the strings in [lo, hi)
(theorem argv_at_keep
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (a Nat)
   (c Nat)
   (hs (same_outside m m2 a c))
   (hd (or (<= c lo) (<= hi a)))
   (ss (List (List Nat))))
  (forall ((q Nat))
    (-> (<= lo q) (<= (+ q (* 8 (List.length ss))) hi) (argv_at m q lo hi ss)
      (argv_at m2 q lo hi ss)))
  (by
    (induction ss
      ((nil () (intro q h1 h2 hv) (exact True.intro))
       (cons (s r ih) (intro q h1 h2 hv)
         (have hlen (<= (+ q (* 8 (+ (List.length r) 1))) hi) (exact h2))
         (have hx (or (<= (+ q 8) a) (<= c q))
           (cases hd ((inl (hl) (apply Or.inr ((arith)))) (inr (hr) (apply Or.inl ((arith)))))))
         (have e (= (mem_le64 m2 q) (mem_le64 m q)) (exact (le64_same m m2 a c q hs hx)))
         (have p1 (<= lo (mem_le64 m q)) (exact (And.left hv)))
         (have p2 (< (+ (mem_le64 m q) (List.length s)) hi) (exact (And.left (And.right hv))))
         (have p3 (str_at m (mem_le64 m q) s) (exact (And.left (And.right (And.right hv)))))
         (have p4 (argv_at m (+ q 8) lo hi r) (exact (And.right (And.right (And.right hv)))))
         (have k1 (<= lo (+ q 8)) (arith))
         (have k2 (<= (+ (+ q 8) (* 8 (List.length r))) hi) (arith))
         (show
           (and (<= lo (mem_le64 m2 q))
             (and (< (+ (mem_le64 m2 q) (List.length s)) hi)
               (and (str_at m2 (mem_le64 m2 q) s) (argv_at m2 (+ q 8) lo hi r)))))
         (rw e)
         (exact
           (And.intro p1
             (And.intro p2
               (And.intro (str_at_keep m m2 lo hi a c hs hd s (mem_le64 m q) p1 p2 p3)
                 (ih (+ q 8) k1 k2 p4))))))))))

;; ---- a character as a word ---------------------------------------------------------------------------
(def chr_rep ((x (BitVec 64)) (c Nat)) Prop (and (= (w64_val x) c) (< c 256)))
;; k added to it: the low byte of the sum
(theorem chr_add_low ((x (BitVec 64)) (c Nat) (k Nat) (hk (< k 256)) (h (chr_rep x c)))
  (= (% (w64_val (w64_add x (w64 k))) 256) (% (+ c k) 256))
  (by
    (have h1 (= (w64_val x) c) (exact (And.left h)))
    (have h2 (< c 256) (exact (And.right h)))
    (have hs (< (+ c k) 18446744073709551616) (arith))
    (rw (w64_val_add x c k h1 hs))
    rfl))

;; ---- a string at a word: its bytes and a 0 after them, in [lo, hi) ---------------------------------
(def str_rep ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (s (List Nat))) Prop
  (and (<= lo (w64_val q)) (and (< (+ (w64_val q) (List.length s)) hi) (str_at m (w64_val q) s))))
(theorem str_keep
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (m2 Mem)
   (q (BitVec 64))
   (s (List Nat))
   (a Nat)
   (c Nat)
   (h (str_rep lo hi m q s))
   (hs (same_outside m m2 a c))
   (hd (or (<= c lo) (<= hi a))))
  (str_rep lo hi m2 q s)
  (by
    (exact
      (And.intro (And.left h)
        (And.intro (And.left (And.right h))
          (str_at_keep m m2 lo hi a c hs hd s (w64_val q) (And.left h) (And.left (And.right h))
            (And.right (And.right h))))))))
(theorem str_load
  ((rs (List Seg) implicit)
   (lo Nat implicit)
   (hi Nat implicit)
   (m Mem implicit)
   (q (BitVec 64) implicit)
   (s (List Nat) implicit)
   (ls (List (BitVec 64)) implicit)
   (e IExp implicit)
   (hr (readable rs lo hi))
   (he (= (ieval rs ls m e) (some q)))
   (h (str_rep lo hi m q s)))
  (= (ieval rs ls m (ELoad8 e)) (some (w64 (mem_get m (w64_val q)))))
  (by
    (have h1 (<= lo (w64_val q)) (exact (And.left h)))
    (have h2 (< (+ (w64_val q) (List.length s)) hi) (exact (And.left (And.right h))))
    (have h3 (<= (+ (w64_val q) 1) hi) (arith))
    (exact (ieval_load8 rs ls m e q he (hr (w64_val q) 1 h1 h3)))))
(theorem str_nil_test ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (h (str_rep lo hi m q nil)))
  (= (icmp CLtu (w64 (mem_get m (w64_val q))) (w64 1)) true)
  (by
    (have hz (= (mem_get m (w64_val q)) 0) (exact (And.right (And.right h))))
    (have hlt (< (w64_val (w64 0)) 1) (decide))
    (rw hz)
    (exact (icmp_ltu_true (w64 0) (w64 1) hlt))))
(theorem str_cons_test
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (c Nat)
   (r (List Nat))
   (h (str_rep lo hi m q (cons c r))))
  (= (icmp CLtu (w64 (mem_get m (w64_val q))) (w64 1)) false)
  (by
    (have hs (str_at m (w64_val q) (cons c r)) (exact (And.right (And.right h))))
    (have hb (= (mem_get m (w64_val q)) c) (exact (And.left hs)))
    (have hpos (< 0 c) (exact (And.left (And.right hs))))
    (have hc256 (< c 256) (rw (<- hb)) (exact (mem_get_lt m (w64_val q))))
    (have hc64 (< c 18446744073709551616) (arith))
    (have hnl (Not (< (w64_val (w64 c)) 1)) (rw (w64_val_small c hc64)) (arith))
    (rw hb)
    (exact (icmp_ltu_false (w64 c) (w64 1) hnl))))
;; the byte read is the first character, as a word
(theorem str_cons_chr
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (c Nat)
   (r (List Nat))
   (h (str_rep lo hi m q (cons c r))))
  (chr_rep (w64 (mem_get m (w64_val q))) c)
  (by
    (have hs (str_at m (w64_val q) (cons c r)) (exact (And.right (And.right h))))
    (have hb (= (mem_get m (w64_val q)) c) (exact (And.left hs)))
    (have hc256 (< c 256) (rw (<- hb)) (exact (mem_get_lt m (w64_val q))))
    (have hc64 (< c 18446744073709551616) (arith))
    (rw hb)
    (exact (And.intro (w64_val_small c hc64) hc256))))
(theorem str_cons_tail
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (c Nat)
   (r (List Nat))
   (hhi (<= hi 140737488355328))
   (h (str_rep lo hi m q (cons c r))))
  (str_rep lo hi m (w64_add q (w64 1)) r)
  (by
    (have h1 (<= lo (w64_val q)) (exact (And.left h)))
    (have h2 (< (+ (w64_val q) (+ (List.length r) 1)) hi) (exact (And.left (And.right h))))
    (have hs (str_at m (w64_val q) (cons c r)) (exact (And.right (And.right h))))
    (have hr (str_at m (+ (w64_val q) 1) r) (exact (And.right (And.right hs))))
    (have hk (< (+ (w64_val q) 1) 18446744073709551616) (arith))
    (have e (= (w64_val (w64_add q (w64 1))) (+ (w64_val q) 1))
      (exact (w64_val_add q (w64_val q) 1 (Eq.refl (w64_val q)) hk)))
    (have g1 (<= lo (+ (w64_val q) 1)) (arith))
    (have g2 (< (+ (+ (w64_val q) 1) (List.length r)) hi) (arith))
    (show
      (and (<= lo (w64_val (w64_add q (w64 1))))
        (and (< (+ (w64_val (w64_add q (w64 1))) (List.length r)) hi)
          (str_at m (w64_val (w64_add q (w64 1))) r))))
    (rw e)
    (exact (And.intro g1 (And.intro g2 hr)))))

;; ---- n bytes at a word, in [lo, hi) ------------------------------------------------------------------
(def bytes_rep ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (n Nat) (bs (List Nat))) Prop
  (and (<= lo (w64_val q)) (and (<= (+ (w64_val q) n) hi) (= (mem_bytes m (w64_val q) n) bs))))
(theorem bytes_keep
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (m2 Mem)
   (q (BitVec 64))
   (n Nat)
   (bs (List Nat))
   (a Nat)
   (c Nat)
   (h (bytes_rep lo hi m q n bs))
   (hs (same_outside m m2 a c))
   (hd (or (<= c lo) (<= hi a))))
  (bytes_rep lo hi m2 q n bs)
  (by
    (have h1 (<= lo (w64_val q)) (exact (And.left h)))
    (have h2 (<= (+ (w64_val q) n) hi) (exact (And.left (And.right h))))
    (have h3 (= (mem_bytes m (w64_val q) n) bs) (exact (And.right (And.right h))))
    (have hx (or (<= c (w64_val q)) (<= (+ (w64_val q) n) a))
      (cases hd ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith)))))))
    (have g3 (= (mem_bytes m2 (w64_val q) n) bs)
      (rw (mem_bytes_keep m m2 a c hs n (w64_val q) hx))
      (exact h3))
    (exact (And.intro h1 (And.intro h2 g3)))))
;; a write of them: the three facts a call that writes asks for
(theorem bytes_put
  ((rs (List Seg))
   (lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (n Nat)
   (bs (List Nat))
   (hr (readable rs lo hi))
   (hhi (<= hi 140737488355328))
   (h (bytes_rep lo hi m q n bs)))
  (and (= (mapped rs (w64_val q) (w64_val (w64 n)) 4) true)
    (and (<= (+ (w64_val q) (w64_val (w64 n))) 140737488355328)
      (= (mem_bytes m (w64_val q) (w64_val (w64 n))) bs)))
  (by
    (have h1 (<= lo (w64_val q)) (exact (And.left h)))
    (have h2 (<= (+ (w64_val q) n) hi) (exact (And.left (And.right h))))
    (have h3 (= (mem_bytes m (w64_val q) n) bs) (exact (And.right (And.right h))))
    (have g3 (<= (+ (w64_val q) n) 140737488355328) (arith))
    (have hn (< n 18446744073709551616) (arith))
    (rw (w64_val_small n hn))
    (exact (And.intro (hr (w64_val q) n h1 h2) (And.intro g3 h3)))))

;; ---- a scratch word in [lo, hi): a function may store there ------------------------------------------
(def cell_rep ((lo Nat) (hi Nat) (cell (BitVec 64))) Prop
  (and (<= lo (w64_val cell)) (<= (+ (w64_val cell) 8) hi)))
;; the store is one the run may make
(theorem cell_store
  ((rs (List Seg))
   (lo Nat)
   (hi Nat)
   (cell (BitVec 64))
   (hw (writable rs lo hi))
   (h (cell_rep lo hi cell)))
  (= (mapped rs (w64_val cell) 8 2) true)
  (by (exact (hw (w64_val cell) 8 (And.left h) (And.right h)))))
;; and leaves the memory as it was outside the word
(theorem cell_frame ((m Mem) (cell (BitVec 64)) (v Nat))
  (same_outside m (mem_put64 m (w64_val cell) v) (w64_val cell) (+ (w64_val cell) 8))
  (by
    (exact
      (same_outside_put64 m m (w64_val cell) (+ (w64_val cell) 8) (w64_val cell) v
        (same_outside_refl m (w64_val cell) (+ (w64_val cell) 8))
        (Nat.le_refl (w64_val cell))
        (Nat.le_refl (+ (w64_val cell) 8))))))
;; the word is apart from every region apart from its own
(theorem cell_apart
  ((lo Nat)
   (hi Nat)
   (cell (BitVec 64))
   (lo2 Nat)
   (hi2 Nat)
   (h (cell_rep lo hi cell))
   (hd (or (<= hi lo2) (<= hi2 lo))))
  (or (<= (+ (w64_val cell) 8) lo2) (<= hi2 (w64_val cell)))
  (by
    (have h1 (<= lo (w64_val cell)) (exact (And.left h)))
    (have h2 (<= (+ (w64_val cell) 8) hi) (exact (And.right h)))
    (cases hd ((inl (hl) (apply Or.inl ((arith)))) (inr (hr) (apply Or.inr ((arith))))))))
;; a word stored there, then its first byte written: the three facts the write asks for
(theorem cell_put1
  ((rs (List Seg))
   (lo Nat)
   (hi Nat)
   (m Mem)
   (cell (BitVec 64))
   (x (BitVec 64))
   (hr (readable rs lo hi))
   (hhi (<= hi 140737488355328))
   (h (cell_rep lo hi cell)))
  (and (= (mapped rs (w64_val cell) (w64_val (w64 1)) 4) true)
    (and (<= (+ (w64_val cell) (w64_val (w64 1))) 140737488355328)
      (= (mem_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) (w64_val (w64 1)))
        (cons (% (w64_val x) 256) nil))))
  (by
    (have h1 (<= lo (w64_val cell)) (exact (And.left h)))
    (have h2 (<= (+ (w64_val cell) 8) hi) (exact (And.right h)))
    (have k1 (< 1 18446744073709551616) (decide))
    (have e1 (= (w64_val (w64 1)) 1) (exact (w64_val_small 1 k1)))
    (have g1 (<= (+ (w64_val cell) 1) hi) (arith))
    (have g2 (<= (+ (w64_val cell) 1) 140737488355328) (arith))
    (have hw8
      (= (w64 (mem_le64 (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell))) (w64 (w64_val x)))
      (rw (le64_put64_word m (w64_val cell) x))
      (rw (w64_of_val x))
      rfl)
    (have hb8
      (= (mem_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) 8) (bytes8 (w64_val x)))
      (exact
        (held_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) (w64_val x) hw8
          (w64_val_lt x))))
    (have k18 (<= 1 8) (decide))
    (have ht
      (= (List.take 1 (mem_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) 8))
        (mem_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) 1))
      (exact (mem_bytes_take (mem_put64 m (w64_val cell) (w64_val x)) 1 (w64_val cell) 8 k18)))
    (have g3
      (= (mem_bytes (mem_put64 m (w64_val cell) (w64_val x)) (w64_val cell) 1)
        (cons (% (w64_val x) 256) nil))
      (rw (<- ht))
      (rw hb8)
      rfl)
    (rw e1)
    (exact (And.intro (hr (w64_val cell) 1 h1 g1) (And.intro g2 g3)))))

;; ---- a list of strings: a count, and at a word the addresses; all in [lo, hi) ------------------------
(def argv_rep ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (n (BitVec 64)) (ss (List (List Nat))))
  Prop
  (and (= (w64_val n) (List.length ss))
    (and (<= lo (w64_val q))
      (and (<= (+ (w64_val q) (* 8 (List.length ss))) hi) (argv_at m (w64_val q) lo hi ss)))))
(theorem argv_keep
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (m2 Mem)
   (q (BitVec 64))
   (n (BitVec 64))
   (ss (List (List Nat)))
   (a Nat)
   (c Nat)
   (h (argv_rep lo hi m q n ss))
   (hs (same_outside m m2 a c))
   (hd (or (<= c lo) (<= hi a))))
  (argv_rep lo hi m2 q n ss)
  (by
    (have h1 (<= lo (w64_val q)) (exact (And.left (And.right h))))
    (have h2 (<= (+ (w64_val q) (* 8 (List.length ss))) hi)
      (exact (And.left (And.right (And.right h)))))
    (exact
      (And.intro (And.left h)
        (And.intro h1
          (And.intro h2
            (argv_at_keep m m2 lo hi a c hs hd ss (w64_val q) h1 h2
              (And.right (And.right (And.right h))))))))))
(theorem argv_nil_test
  ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (n (BitVec 64)) (h (argv_rep lo hi m q n nil)))
  (= (icmp CLtu n (w64 1)) true)
  (by
    (have hn0 (= (w64_val n) 0) (exact (And.left h)))
    (have hlt (< (w64_val n) 1) (rw hn0) (decide))
    (exact (icmp_ltu_true n (w64 1) hlt))))
(theorem argv_cons_test
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (n (BitVec 64))
   (s (List Nat))
   (r (List (List Nat)))
   (h (argv_rep lo hi m q n (cons s r))))
  (= (icmp CLtu n (w64 1)) false)
  (by
    (have hn1 (= (w64_val n) (+ (List.length r) 1)) (exact (And.left h)))
    (have hnl (Not (< (w64_val n) 1)) (rw hn1) (arith))
    (exact (icmp_ltu_false n (w64 1) hnl))))
(theorem argv_cons_load
  ((rs (List Seg) implicit)
   (lo Nat implicit)
   (hi Nat implicit)
   (m Mem implicit)
   (q (BitVec 64) implicit)
   (n (BitVec 64) implicit)
   (s (List Nat) implicit)
   (r (List (List Nat)) implicit)
   (ls (List (BitVec 64)) implicit)
   (e IExp implicit)
   (hr (readable rs lo hi))
   (he (= (ieval rs ls m e) (some q)))
   (h (argv_rep lo hi m q n (cons s r))))
  (= (ieval rs ls m (ELoad e)) (some (w64 (mem_le64 m (w64_val q)))))
  (by
    (have ha (<= lo (w64_val q)) (exact (And.left (And.right h))))
    (have hb (<= (+ (w64_val q) (* 8 (+ (List.length r) 1))) hi)
      (exact (And.left (And.right (And.right h)))))
    (have h8 (<= (+ (w64_val q) 8) hi) (arith))
    (exact (ieval_load rs ls m e q he (hr (w64_val q) 8 ha h8)))))
(theorem argv_cons_head
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (n (BitVec 64))
   (s (List Nat))
   (r (List (List Nat)))
   (hhi (<= hi 140737488355328))
   (h (argv_rep lo hi m q n (cons s r))))
  (str_rep lo hi m (w64 (mem_le64 m (w64_val q))) s)
  (by
    (have hv (argv_at m (w64_val q) lo hi (cons s r)) (exact (And.right (And.right (And.right h)))))
    (have p1 (<= lo (mem_le64 m (w64_val q))) (exact (And.left hv)))
    (have p2 (< (+ (mem_le64 m (w64_val q)) (List.length s)) hi) (exact (And.left (And.right hv))))
    (have p3 (str_at m (mem_le64 m (w64_val q)) s) (exact (And.left (And.right (And.right hv)))))
    (have hp64 (< (mem_le64 m (w64_val q)) 18446744073709551616) (arith))
    (show
      (and (<= lo (w64_val (w64 (mem_le64 m (w64_val q)))))
        (and (< (+ (w64_val (w64 (mem_le64 m (w64_val q)))) (List.length s)) hi)
          (str_at m (w64_val (w64 (mem_le64 m (w64_val q)))) s))))
    (rw (w64_val_small (mem_le64 m (w64_val q)) hp64))
    (exact (And.intro p1 (And.intro p2 p3)))))
(theorem argv_cons_tail
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (n (BitVec 64))
   (s (List Nat))
   (r (List (List Nat)))
   (hhi (<= hi 140737488355328))
   (h (argv_rep lo hi m q n (cons s r))))
  (argv_rep lo hi m (w64_add q (w64 8)) (w64_sub n (w64 1)) r)
  (by
    (have hn1 (= (w64_val n) (+ (List.length r) 1)) (exact (And.left h)))
    (have ha (<= lo (w64_val q)) (exact (And.left (And.right h))))
    (have hb (<= (+ (w64_val q) (* 8 (+ (List.length r) 1))) hi)
      (exact (And.left (And.right (And.right h)))))
    (have hv (argv_at m (w64_val q) lo hi (cons s r)) (exact (And.right (And.right (And.right h)))))
    (have p4 (argv_at m (+ (w64_val q) 8) lo hi r) (exact (And.right (And.right (And.right hv)))))
    (have hk (< (+ (w64_val q) 8) 18446744073709551616) (arith))
    (have e1 (= (w64_val (w64_add q (w64 8))) (+ (w64_val q) 8))
      (exact (w64_val_add q (w64_val q) 8 (Eq.refl (w64_val q)) hk)))
    (have k1 (< 1 18446744073709551616) (decide))
    (have e2 (= (w64_val (w64_sub n (w64 1))) (List.length r))
      (exact (w64_val_sub n (List.length r) 1 hn1 k1)))
    (have g1 (<= lo (+ (w64_val q) 8)) (arith))
    (have g2 (<= (+ (+ (w64_val q) 8) (* 8 (List.length r))) hi) (arith))
    (show
      (and (= (w64_val (w64_sub n (w64 1))) (List.length r))
        (and (<= lo (w64_val (w64_add q (w64 8))))
          (and (<= (+ (w64_val (w64_add q (w64 8))) (* 8 (List.length r))) hi)
            (argv_at m (w64_val (w64_add q (w64 8))) lo hi r)))))
    (rw e1)
    (exact (And.intro e2 (And.intro g1 (And.intro g2 p4))))))

;; ---- the kernel's argument block at a word: the count, then the addresses; in [lo, hi) --------------
(def args_rep ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (args (List (List Nat)))) Prop
  (and (= (w64_val q) lo) (args_at m lo hi args)))
(theorem args_load
  ((rs (List Seg) implicit)
   (lo Nat implicit)
   (hi Nat implicit)
   (m Mem implicit)
   (q (BitVec 64) implicit)
   (args (List (List Nat)) implicit)
   (ls (List (BitVec 64)) implicit)
   (e IExp implicit)
   (hr (readable rs lo hi))
   (he (= (ieval rs ls m e) (some q)))
   (h (args_rep lo hi m q args)))
  (= (ieval rs ls m (ELoad e)) (some (w64 (mem_le64 m (w64_val q)))))
  (by
    (have hq (= (w64_val q) lo) (exact (And.left h)))
    (have hb (<= (+ lo (* 8 (+ (List.length args) 1))) hi)
      (exact (And.left (And.right (And.right h)))))
    (have h0 (<= lo (w64_val q)) (rw hq) (exact (Nat.le_refl lo)))
    (have h8 (<= (+ (w64_val q) 8) hi) (rw hq) (arith))
    (exact (ieval_load rs ls m e q he (hr (w64_val q) 8 h0 h8)))))
(theorem args_nil_test ((lo Nat) (hi Nat) (m Mem) (q (BitVec 64)) (h (args_rep lo hi m q nil)))
  (= (icmp CLtu (w64 (mem_le64 m (w64_val q))) (w64 1)) true)
  (by
    (have hq (= (w64_val q) lo) (exact (And.left h)))
    (have hc (= (mem_le64 m lo) 0) (exact (And.left (And.right h))))
    (have hlt (< (w64_val (w64 0)) 1) (decide))
    (rw hq)
    (rw hc)
    (exact (icmp_ltu_true (w64 0) (w64 1) hlt))))
(theorem args_cons_test
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (name (List Nat))
   (r (List (List Nat)))
   (hhi (<= hi 140737488355328))
   (h (args_rep lo hi m q (cons name r))))
  (= (icmp CLtu (w64 (mem_le64 m (w64_val q))) (w64 1)) false)
  (by
    (have hq (= (w64_val q) lo) (exact (And.left h)))
    (have hc (= (mem_le64 m lo) (+ (List.length r) 1)) (exact (And.left (And.right h))))
    (have hb (<= (+ lo (* 8 (+ (+ (List.length r) 1) 1))) hi)
      (exact (And.left (And.right (And.right h)))))
    (have hn64 (< (+ (List.length r) 1) 18446744073709551616) (arith))
    (have hnl (Not (< (w64_val (w64 (+ (List.length r) 1))) 1))
      (rw (w64_val_small (+ (List.length r) 1) hn64))
      (arith))
    (rw hq)
    (rw hc)
    (exact (icmp_ltu_false (w64 (+ (List.length r) 1)) (w64 1) hnl))))
(theorem args_cons_tail
  ((lo Nat)
   (hi Nat)
   (m Mem)
   (q (BitVec 64))
   (name (List Nat))
   (r (List (List Nat)))
   (hhi (<= hi 140737488355328))
   (h (args_rep lo hi m q (cons name r))))
  (argv_rep lo hi m (w64_add q (w64 16)) (w64_sub (w64 (mem_le64 m (w64_val q))) (w64 1)) r)
  (by
    (have hq (= (w64_val q) lo) (exact (And.left h)))
    (have hc (= (mem_le64 m lo) (+ (List.length r) 1)) (exact (And.left (And.right h))))
    (have hb (<= (+ lo (* 8 (+ (+ (List.length r) 1) 1))) hi)
      (exact (And.left (And.right (And.right h)))))
    (have hv (argv_at m (+ lo 8) lo hi (cons name r)) (exact (And.right (And.right (And.right h)))))
    (have p4 (argv_at m (+ lo 16) lo hi r) (exact (And.right (And.right (And.right hv)))))
    (have hn64 (< (+ (List.length r) 1) 18446744073709551616) (arith))
    (have hnv (= (w64_val (w64 (+ (List.length r) 1))) (+ (List.length r) 1))
      (exact (w64_val_small (+ (List.length r) 1) hn64)))
    (have k1 (< 1 18446744073709551616) (decide))
    (have e2 (= (w64_val (w64_sub (w64 (+ (List.length r) 1)) (w64 1))) (List.length r))
      (exact (w64_val_sub (w64 (+ (List.length r) 1)) (List.length r) 1 hnv k1)))
    (have hk (< (+ lo 16) 18446744073709551616) (arith))
    (have e1 (= (w64_val (w64_add q (w64 16))) (+ lo 16)) (exact (w64_val_add q lo 16 hq hk)))
    (have g1 (<= lo (+ lo 16)) (arith))
    (have g2 (<= (+ (+ lo 16) (* 8 (List.length r))) hi) (arith))
    (show
      (and (= (w64_val (w64_sub (w64 (mem_le64 m (w64_val q))) (w64 1))) (List.length r))
        (and (<= lo (w64_val (w64_add q (w64 16))))
          (and (<= (+ (w64_val (w64_add q (w64 16))) (* 8 (List.length r))) hi)
            (argv_at m (w64_val (w64_add q (w64 16))) lo hi r)))))
    (rw e1)
    (rw hq)
    (rw hc)
    (exact (And.intro e2 (And.intro g1 (And.intro g2 p4))))))
