;;; v3/compile/x86/code.shard — instructions in place in a table at addresses that are
;;; variables, each instruction's rule stated for such a table — with the rules of four forms
;;; the model's laws have none for —, and a listing's place in a table as a decision K evaluates.
(import "pass.shard")
(import "seam.shard")
(import "../../models/x86/loaded.shard")
(use std.mem)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; the instructions `is` stand in the table from the address a, each with its encoding's length
(def placed ((tbl (List (Prod Nat (Prod Instr Nat)))) (a Nat) (is (List Instr))) Prop
  (measure (struct is))
  (match is
    (nil True)
    ((cons i r)
     (and (= (site tbl a) (some (Prod.mk i (List.length (encode i)))))
       (placed tbl (+ a (List.length (encode i))) r)))))
(theorem placed_head
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (a Nat)
   (i Instr)
   (r (List Instr))
   (h (placed tbl a (cons i r))))
  (= (site tbl a) (some (Prod.mk i (List.length (encode i)))))
  (exact (And.left h)))
(theorem placed_tail
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (a Nat)
   (i Instr)
   (r (List Instr))
   (h (placed tbl a (cons i r))))
  (placed tbl (+ a (List.length (encode i))) r)
  (exact (And.right h)))
(theorem placed_app ((tbl (List (Prod Nat (Prod Instr Nat)))) (xs (List Instr)))
  (forall ((a Nat) (ys (List Instr)))
    (-> (placed tbl a (List.append xs ys)) (and (placed tbl a xs) (placed tbl (+ a (isize xs)) ys))))
  (by
    (induction xs
      ((nil () (intro a ys h) (apply And.intro (exact True.intro) (exact h)))
       (cons (i r ih) (intro a ys h) (have h1 (placed tbl a (cons i (List.append r ys))) (exact h))
         (cases (ih (+ a (List.length (encode i))) ys (placed_tail tbl a i (List.append r ys) h1))
           ((intro (g1 g2)
              (apply And.intro ((exact (And.intro (placed_head tbl a i (List.append r ys) h1) g1)))
                ((have ea (= (+ a (isize (cons i r))) (+ (+ a (List.length (encode i))) (isize r)))
                   (show
                     (= (+ a (+ (List.length (encode i)) (isize r)))
                       (+ (+ a (List.length (encode i))) (isize r))))
                   (arith))
                 (rw ea)
                 (exact g2)))))))))))

;; the bytes of two listings one after the other
(theorem isize_app ((xs (List Instr)))
  (forall ((ys (List Instr))) (= (isize (List.append xs ys)) (+ (isize xs) (isize ys))))
  (by
    (induction xs
      ((nil () (intro ys) (show (= (isize ys) (+ 0 (isize ys)))) (rw (Nat.zero_add (isize ys))) rfl)
       (cons (i r ih) (intro ys)
         (show
           (= (+ (List.length (encode i)) (isize (List.append r ys)))
             (+ (+ (List.length (encode i)) (isize r)) (isize ys))))
         (rw (ih ys))
         (arith))))))
;; ---- words -------------------------------------------------------------------------------------
;; the displacement the pass computes takes the address after a call to its target
(theorem rel_ok ((next Nat) (target Nat) (h (< next 18446744073709551616)))
  (= (w64_add (w64 next) (w64 (rel target next))) (w64 target))
  (by
    (rw (w64_add_w64 next (rel target next)))
    (unfold rel)
    (cases (Nat.decLe next target)
      ((isTrue (h1) (rw (if_pos h1))
         (have e (= (+ next (- target next)) target) (arith (Nat.sub_add_cancel h1)))
         (rw e)
         rfl)
       (isFalse (h1) (rw (if_neg h1)) (have h2 (<= target next) (arith h1))
         (have e1 (= (+ (- next target) target) next) (exact (Nat.sub_add_cancel h2)))
         (have h3 (<= (- next target) 18446744073709551616) (arith e1 h))
         (have e2
           (= (+ (- 18446744073709551616 (- next target)) (- next target)) 18446744073709551616)
           (exact (Nat.sub_add_cancel h3)))
         (have e
           (= (+ next (- 18446744073709551616 (- next target))) (+ target 18446744073709551616))
           (arith e1 e2))
         (rw e)
         (apply BitVec.eq_of_toNat_eq
           ((show (= (w64_val (w64 (+ target 18446744073709551616))) (w64_val (w64 target))))
            (rw (w64_val_w64 (+ target 18446744073709551616)))
            (rw (w64_val_w64 target))
            (exact (Nat.add_mod_right target 18446744073709551616)))))))))

;; ---- the program counter at an address of the table ---------------------------------------------
(theorem rip_at
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (c Cpu)
   (pc Nat)
   (il (Prod Instr Nat))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some il))))
  (= (w64_val (Cpu.rip c)) pc)
  (by
    (cases (site_within tbl clo chi pc il hall hs)
      ((intro (h1 h2) (have hlt (< pc 18446744073709551616) (arith)) (rw hrip) (rw (w64_val_w64 pc))
         (exact (Nat.mod_eq_of_lt hlt)))))))
(theorem site_lt
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (il (Prod Instr Nat))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hs (= (site tbl pc) (some il))))
  (< pc 18446744073709551616)
  (by (cases (site_within tbl clo chi pc il hall hs) ((intro (h1 h2) (arith))))))

;; ---- each instruction's rule, for a table --------------------------------------------------------
;; Where the program counter is the word of an address pc of the table and the table holds the
;; instruction there with a length len: the state after is at the word of pc + len.
(theorem t_mov
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (a Nat)
   (b Nat)
   (len Nat)
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRmR (RmReg a) b) len))))
   (hv (= (reg c b) w))
   (hr (reaches (at_pc (set_reg c a w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hr2 (reaches (x_mov_rr c a b (w64 (+ pc len))) c2)
      (show (reaches (at_pc (set_reg c a (reg c b)) (w64 (+ pc len))) c2))
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRmR (RmReg a) b) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRmR (RmReg a) b) len) (exact (hcode pc (MovRmR (RmReg a) b) len hs)))
    (exact (do_mov_rr pc a b len (+ pc len) hn hc (Eq.refl (+ pc len)) hr2))))
(theorem t_ri64
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (n Nat)
   (len Nat)
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRI64 r n) len))))
   (hv (= (w64 n) w))
   (hr (reaches (at_pc (set_reg c r w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hr2 (reaches (x_mov_ri c r n (w64 (+ pc len))) c2)
      (show (reaches (at_pc (set_reg c r (w64 n)) (w64 (+ pc len))) c2))
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRI64 r n) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRI64 r n) len) (exact (hcode pc (MovRI64 r n) len hs)))
    (exact (do_mov_ri64 pc r n len (+ pc len) hn hc (Eq.refl (+ pc len)) hr2))))
(theorem t_ri32
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (n Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRI32 r n) len))))
   (hr (reaches (at_pc (set_reg c r (w64 n)) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hr2 (reaches (x_mov_ri c r n (w64 (+ pc len))) c2) (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRI32 r n) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRI32 r n) len) (exact (hcode pc (MovRI32 r n) len hs)))
    (exact (do_mov_ri32 pc r n len (+ pc len) hn hc (Eq.refl (+ pc len)) hr2))))
(theorem t_alu
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (op Bop)
   (a Nat)
   (b Nat)
   (len Nat)
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (AluRmR op (RmReg a) b) len))))
   (hw (= (alu_writes op) true))
   (hv (= (alu_res op (reg c a) (reg c b)) w))
   (hr
     (reaches
       (at_pc (set_reg (set_flags c (alu_flags op (reg c a) (reg c b))) a w) (w64 (+ pc len)))
       c2)))
  (reaches c c2)
  (by
    (have hr2 (reaches (x_alu_rr c op a b (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc
            (set_reg (set_flags c (alu_flags op (reg c a) (reg c b))) a
              (alu_res op (reg c a) (reg c b)))
            (w64 (+ pc len)))
          c2))
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (AluRmR op (RmReg a) b) len) hall hchi hrip hs)))
    (have hc (code_at c pc (AluRmR op (RmReg a) b) len)
      (exact (hcode pc (AluRmR op (RmReg a) b) len hs)))
    (exact (do_alu_rr pc op a b len (+ pc len) hn hc hw (Eq.refl (+ pc len)) hr2))))
(theorem t_cmp
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (a Nat)
   (b Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (AluRmR BCmp (RmReg a) b) len))))
   (hr (reaches (x_cmp_rr c a b (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (AluRmR BCmp (RmReg a) b) len) hall hchi hrip hs)))
    (have hc (code_at c pc (AluRmR BCmp (RmReg a) b) len)
      (exact (hcode pc (AluRmR BCmp (RmReg a) b) len hs)))
    (exact (do_cmp_rr pc a b len (+ pc len) hn hc (Eq.refl (+ pc len)) hr))))
(theorem t_jcc_not
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (cc Nat)
   (d Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Jcc cc d) len))))
   (hcc (= (cc_holds cc (Cpu.flags c)) (some false)))
   (hr (reaches (at_pc c (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Jcc cc d) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Jcc cc d) len) (exact (hcode pc (Jcc cc d) len hs)))
    (exact (do_jcc_not pc cc d len (+ pc len) hn hc hcc (Eq.refl (+ pc len)) hr))))
(theorem t_jcc_taken
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (cc Nat)
   (d Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Jcc cc d) len))))
   (hcc (= (cc_holds cc (Cpu.flags c)) (some true)))
   (hr (reaches (at_pc c (w64 (+ (+ pc len) d))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Jcc cc d) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Jcc cc d) len) (exact (hcode pc (Jcc cc d) len hs)))
    (exact (do_jcc_taken pc cc len d (+ (+ pc len) d) hn hc hcc (w64_add_w64 (+ pc len) d) hr))))
(theorem t_push
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Push r) len))))
   (hm (= (mapped (Cpu.segs c) (push_at c) 8 2) true))
   (hr (reaches (at_pc (pushed c (reg c r)) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Push r) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Push r) len) (exact (hcode pc (Push r) len hs)))
    (exact (do_push pc r len (+ pc len) hn hc hm (Eq.refl (+ pc len)) hr))))
(theorem t_pop
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Pop r) len))))
   (hm (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true))
   (hr (reaches (x_pop c r (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Pop r) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Pop r) len) (exact (hcode pc (Pop r) len hs)))
    (exact (do_pop pc r len (+ pc len) hn hc hm (Eq.refl (+ pc len)) hr))))
(theorem t_ret
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk Ret len))))
   (hm (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true))
   (hr (reaches (x_ret c) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk Ret len) hall hchi hrip hs)))
    (have hc (code_at c pc Ret len) (exact (hcode pc Ret len hs)))
    (exact (do_ret pc len hn hc hm hr))))
(theorem t_call
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (d Nat)
   (len Nat)
   (target Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Call d) len))))
   (hm (= (mapped (Cpu.segs c) (push_at c) 8 2) true))
   (htgt (= (w64_add (w64 (+ pc len)) (w64 d)) (w64 target)))
   (hr (reaches (at_pc (pushed c (w64 (+ pc len))) (w64 target)) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Call d) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Call d) len) (exact (hcode pc (Call d) len hs)))
    (exact (do_call pc len d (+ pc len) target hn hc hm (Eq.refl (+ pc len)) htgt hr))))

;; a load through a base register that holds the word q: the word at q's number
(theorem t_load
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (b Nat)
   (len Nat)
   (q (BitVec 64))
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRRm r (RmMem b 0)) len))))
   (hq (= (reg c b) q))
   (hm (= (mapped (Cpu.segs c) (w64_val q) 8 4) true))
   (hv (= (w64 (mem_le64 (Cpu.mem c) (w64_val q))) w))
   (hr (reaches (at_pc (set_reg c r w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hm2 (= (mapped (Cpu.segs c) (w64_val (reg c b)) 8 4) true) (rw hq) (exact hm))
    (have hr2 (reaches (x_load_b c r b (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc (set_reg c r (w64 (mem_le64 (Cpu.mem c) (w64_val (reg c b))))) (w64 (+ pc len)))
          c2))
      (rw hq)
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRRm r (RmMem b 0)) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRRm r (RmMem b 0)) len)
      (exact (hcode pc (MovRRm r (RmMem b 0)) len hs)))
    (exact (do_load_b pc r b len (+ pc len) hn hc hm2 (Eq.refl (+ pc len)) hr2))))
;; a load of one byte through a base register that holds the word q: the byte at q's number
(theorem t_load8
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (b Nat)
   (len Nat)
   (q (BitVec 64))
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Movzx8 r (RmMem b 0)) len))))
   (hq (= (reg c b) q))
   (hm (= (mapped (Cpu.segs c) (w64_val q) 1 4) true))
   (hv (= (w64 (mem_get (Cpu.mem c) (w64_val q))) w))
   (hr (reaches (at_pc (set_reg c r w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hm2 (= (mapped (Cpu.segs c) (w64_val (reg c b)) 1 4) true) (rw hq) (exact hm))
    (have hr2 (reaches (x_load8_b c r b (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc (set_reg c r (w64 (mem_get (Cpu.mem c) (w64_val (reg c b))))) (w64 (+ pc len)))
          c2))
      (rw hq)
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Movzx8 r (RmMem b 0)) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Movzx8 r (RmMem b 0)) len)
      (exact (hcode pc (Movzx8 r (RmMem b 0)) len hs)))
    (exact (do_load8_b pc r b len (+ pc len) hn hc hm2 (Eq.refl (+ pc len)) hr2))))
;; a store through a base register that holds the word q, of a register that holds v
(theorem t_store
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (b Nat)
   (r Nat)
   (len Nat)
   (q (BitVec 64))
   (v (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRmR (RmMem b 0) r) len))))
   (hq (= (reg c b) q))
   (hv (= (reg c r) v))
   (hm (= (mapped (Cpu.segs c) (w64_val q) 8 2) true))
   (hr
     (reaches (at_pc (mem_to c (mem_put64 (Cpu.mem c) (w64_val q) (w64_val v))) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hm2 (= (mapped (Cpu.segs c) (w64_val (reg c b)) 8 2) true) (rw hq) (exact hm))
    (have hr2 (reaches (x_store_b c b r (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc (mem_to c (mem_put64 (Cpu.mem c) (w64_val (reg c b)) (w64_val (reg c r))))
            (w64 (+ pc len)))
          c2))
      (rw hq)
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRmR (RmMem b 0) r) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRmR (RmMem b 0) r) len)
      (exact (hcode pc (MovRmR (RmMem b 0) r) len hs)))
    (exact (do_store_b pc b r len (+ pc len) hn hc hm2 (Eq.refl (+ pc len)) hr2))))
;; a load and a store through a base register and a displacement that come to the address q
(theorem t_load_d
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (r Nat)
   (b Nat)
   (d Nat)
   (len Nat)
   (q Nat)
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRRm r (RmMem b d)) len))))
   (hq (= (ea c b d) q))
   (hm (= (mapped (Cpu.segs c) q 8 4) true))
   (hv (= (w64 (mem_le64 (Cpu.mem c) q)) w))
   (hr (reaches (at_pc (set_reg c r w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hm2 (= (mapped (Cpu.segs c) (ea c b d) 8 4) true) (rw hq) (exact hm))
    (have hr2 (reaches (x_load_bd c r b d (w64 (+ pc len))) c2)
      (show
        (reaches (at_pc (set_reg c r (w64 (mem_le64 (Cpu.mem c) (ea c b d)))) (w64 (+ pc len))) c2))
      (rw hq)
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRRm r (RmMem b d)) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRRm r (RmMem b d)) len)
      (exact (hcode pc (MovRRm r (RmMem b d)) len hs)))
    (exact (do_load_bd pc r b d len (+ pc len) hn hc hm2 (Eq.refl (+ pc len)) hr2))))
(theorem t_store_d
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (b Nat)
   (d Nat)
   (r Nat)
   (len Nat)
   (q Nat)
   (v (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRmR (RmMem b d) r) len))))
   (hq (= (ea c b d) q))
   (hv (= (reg c r) v))
   (hm (= (mapped (Cpu.segs c) q 8 2) true))
   (hr (reaches (at_pc (mem_to c (mem_put64 (Cpu.mem c) q (w64_val v))) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hm2 (= (mapped (Cpu.segs c) (ea c b d) 8 2) true) (rw hq) (exact hm))
    (have hr2 (reaches (x_store_bd c b d r (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc (mem_to c (mem_put64 (Cpu.mem c) (ea c b d) (w64_val (reg c r)))) (w64 (+ pc len)))
          c2))
      (rw hq)
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (MovRmR (RmMem b d) r) len) hall hchi hrip hs)))
    (have hc (code_at c pc (MovRmR (RmMem b d) r) len)
      (exact (hcode pc (MovRmR (RmMem b d) r) len hs)))
    (exact (do_store_bd pc b d r len (+ pc len) hn hc hm2 (Eq.refl (+ pc len)) hr2))))
;; op r_a, imm for an operation that writes its result
(theorem t_alu_i
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (op Bop)
   (a Nat)
   (i Nat)
   (len Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (AluRmI op (RmReg a) i) len))))
   (hw (= (alu_writes op) true))
   (hr (reaches (x_alu_ri c op a i (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (AluRmI op (RmReg a) i) len) hall hchi hrip hs)))
    (have hc (code_at c pc (AluRmI op (RmReg a) i) len)
      (exact (hcode pc (AluRmI op (RmReg a) i) len hs)))
    (exact (do_alu_ri pc op a i len (+ pc len) hn hc hw (Eq.refl (+ pc len)) hr))))
(theorem t_imul
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (a Nat)
   (b Nat)
   (len Nat)
   (w (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (ImulRRm a (RmReg b)) len))))
   (hv (= (w64_mul (reg c a) (reg c b)) w))
   (hr (reaches (at_pc (set_reg (set_flags c flags_none) a w) (w64 (+ pc len))) c2)))
  (reaches c c2)
  (by
    (have hr2 (reaches (x_imul_rr c a b (w64 (+ pc len))) c2)
      (show
        (reaches
          (at_pc (set_reg (set_flags c flags_none) a (w64_mul (reg c a) (reg c b))) (w64 (+ pc len)))
          c2))
      (rw hv)
      (exact hr))
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (ImulRRm a (RmReg b)) len) hall hchi hrip hs)))
    (have hc (code_at c pc (ImulRRm a (RmReg b)) len)
      (exact (hcode pc (ImulRRm a (RmReg b)) len hs)))
    (exact (do_imul_rr pc a b len (+ pc len) hn hc (Eq.refl (+ pc len)) hr2))))
(theorem site_lt15
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (il (Prod Instr Nat))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hs (= (site tbl pc) (some il))))
  (< (+ pc 15) 18446744073709551616)
  (by (cases (site_within tbl clo chi pc il hall hs) ((intro (h1 h2) (arith))))))
(theorem t_jmp
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (d Nat)
   (len Nat)
   (target Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some (Prod.mk (Jmp d) len))))
   (htgt (= (w64_add (w64 (+ pc len)) (w64 d)) (w64 target)))
   (hr (reaches (at_pc c (w64 target)) c2)))
  (reaches c c2)
  (by
    (have hn (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at tbl clo chi c pc (Prod.mk (Jmp d) len) hall hchi hrip hs)))
    (have hc (code_at c pc (Jmp d) len) (exact (hcode pc (Jmp d) len hs)))
    (exact (do_jmp pc len d target hn hc htgt hr))))

;; ---- a listing in place, decided ------------------------------------------------------------------
;; whether the instructions stand in the table from the address a: `placed`, as a decision
(fn placedb ((tbl (List (Prod Nat (Prod Instr Nat)))) (a Nat) (is (List Instr))) Bool
  (measure (struct is))
  (match is
    (nil true)
    ((cons i r)
     (if (same_decode (site tbl a) i (List.length (encode i)))
       (placedb tbl (+ a (List.length (encode i))) r)
       false))))
(theorem placedb_ok ((tbl (List (Prod Nat (Prod Instr Nat)))) (is (List Instr)))
  (forall ((a Nat)) (-> (= (placedb tbl a is) true) (placed tbl a is)))
  (by
    (induction is
      ((nil () (intro a h) (exact True.intro))
       (cons (i r ih) (intro a)
         (cases (same_decode (site tbl a) i (List.length (encode i))) hd
           ((false () (intro h)
              (have hx (= (placedb tbl a (cons i r)) false) (rw placedb.eq_2) (rw hd) rfl)
              (exact (absurd (Eq.trans (Eq.symm hx) h) Bool.false_ne_true)))
            (true () (intro h)
              (have hx (= (placedb tbl a (cons i r)) (placedb tbl (+ a (List.length (encode i))) r))
                (rw placedb.eq_2)
                (rw hd)
                rfl)
              (have hs (= (site tbl a) (some (Prod.mk i (List.length (encode i)))))
                (exact (same_decode_true (site tbl a) i (List.length (encode i)) hd)))
              (exact (And.intro hs (ih (+ a (List.length (encode i))) (Eq.trans (Eq.symm hx) h))))))))))))
