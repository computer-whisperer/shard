;;; v3/compile/x86/total_file.shard — a function that writes, two callers above it, one file:
;;; `total` calls `both` and `dot`; `both` calls `addto` and `dot`. `dot` is the hand-written
;;; instructions of models/x86/buffers.shard, at 4194547 after the start-up; `addto`'s module
;;; (../addto_obj.shard) goes through the pass at 4194584 with no outside function; `both`'s
;;; (../both_obj.shard) after it with two — `addto` as the pass answered for it, `dot` at its
;;; entry with no stack of its own —; `total`'s (../total_obj.shard) after that with `both` as
;;; the pass answered for it, and `dot`. The start-up's call goes to label 4, before the
;;; instruction at `total`'s entry. Names begin `tt_`. That the file exits with `total`'s value
;;; is total_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "../addto_obj.shard")
(import "../both_obj.shard")
(import "../total_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/part.shard")
(use compile.addto_obj)
(use compile.both_obj)
(use compile.total_obj)
(use compile.x86.code)
(use compile.x86.startup)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.buffers)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.part)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- compiled: `addto`'s module -------------------------------------------------------------------
(fn tt_ad_listing () (List Instr)
  (match (compile nil addto_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) l)))
(fn tt_ad_entries () (List (Prod Nat Nat))
  (match (compile nil addto_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem tt_ad_compiled ()
  (= (compile nil addto_prog 4194584) (some (Prod.mk tt_ad_listing tt_ad_entries)))
  (by rfl))
;; `addto` is the second function of its program: its entry and its stack need
(fn tt_ad_at () Nat
  (match (pair_at tt_ad_entries 1)
    (none 0)
    ((some en) (Prod.fst en))))
(fn tt_ad_need () Nat
  (match (pair_at tt_ad_entries 1)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem tt_ad_entry () (= (pair_at tt_ad_entries 1) (some (Prod.mk tt_ad_at tt_ad_need))) (by rfl))

;; ---- compiled: `both`'s module --------------------------------------------------------------------
;; its outside functions, each by its entry and its stack need: `addto`, `dot`
(fn tt_bo_outs () (List (Prod Nat Nat))
  (cons (Prod.mk tt_ad_at tt_ad_need) (cons (Prod.mk 4194547 0) nil)))
(fn tt_bo_base () Nat (+ 4194584 (isize tt_ad_listing)))
(fn tt_bo_listing () (List Instr)
  (match (compile tt_bo_outs both_prog tt_bo_base)
    (none nil)
    ((some (Prod.mk l f)) l)))
(fn tt_bo_entries () (List (Prod Nat Nat))
  (match (compile tt_bo_outs both_prog tt_bo_base)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem tt_bo_compiled ()
  (= (compile tt_bo_outs both_prog tt_bo_base) (some (Prod.mk tt_bo_listing tt_bo_entries)))
  (by rfl))
(fn tt_bo_at () Nat
  (match (pair_at tt_bo_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn tt_bo_need () Nat
  (match (pair_at tt_bo_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem tt_bo_entry () (= (pair_at tt_bo_entries 0) (some (Prod.mk tt_bo_at tt_bo_need))) (by rfl))

;; ---- compiled: `total`'s module -------------------------------------------------------------------
;; its outside functions: `both`, as the pass answered for it, and `dot`
(fn tt_outs () (List (Prod Nat Nat))
  (cons (Prod.mk tt_bo_at tt_bo_need) (cons (Prod.mk 4194547 0) nil)))
(fn tt_base () Nat (+ tt_bo_base (isize tt_bo_listing)))
(fn tt_listing () (List Instr)
  (match (compile tt_outs total_prog tt_base)
    (none nil)
    ((some (Prod.mk l f)) l)))
(fn tt_entries () (List (Prod Nat Nat))
  (match (compile tt_outs total_prog tt_base)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem tt_compiled ()
  (= (compile tt_outs total_prog tt_base) (some (Prod.mk tt_listing tt_entries)))
  (by rfl))
(fn tt_at () Nat
  (match (pair_at tt_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn tt_need () Nat
  (match (pair_at tt_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem tt_entry () (= (pair_at tt_entries 0) (some (Prod.mk tt_at tt_need))) (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
(fn tt_all () (List Instr) (List.append tt_ad_listing (List.append tt_bo_listing tt_listing)))
(fn tt_lines () (List Asm) (List.append dot_asm (label_at tt_all 4194584 tt_at 4)))
(fn tt_d () Nat (rel tt_at 4194537))
(fn tt_xt () (List (Prod Nat (Prod Instr Nat))) (List.append dot_rows (layout tt_all 4194584)))
(fn tt_tbl () (List (Prod Nat (Prod Instr Nat))) (link_table tt_d tt_xt))
(fn tt_chi () Nat (+ tt_base (isize tt_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn tt_image () (List Nat)
  (match (assemble (link_listing 4 tt_lines))
    (none nil)
    ((some code) code)))
(fn tt_instrs () (List Instr)
  (match (resolve (link_listing 4 tt_lines) (link_listing 4 tt_lines) 0)
    (none nil)
    ((some is) is)))
(theorem tt_assembled () (= (assemble (link_listing 4 tt_lines)) (some tt_image)) (by rfl))
(theorem tt_resolved ()
  (= (resolve (link_listing 4 tt_lines) (link_listing 4 tt_lines) 0) (some tt_instrs))
  (by rfl))
(theorem tt_laid () (= (layout tt_instrs 4194424) tt_tbl) (by rfl))
(theorem tt_target () (= (w64_add (w64 4194537) (w64 tt_d)) (w64 tt_at)) (by rfl))
(theorem tt_within () (= (all_within tt_tbl 4194424 tt_chi) true) (by rfl))
;; the code ends at or below the table's end
(theorem tt_code_end () (<= (+ 4194424 (List.length tt_image)) tt_chi) (by decide))
(theorem tt_chi_word () (<= (+ tt_chi 15) 18446744073709551616) (by decide))
;; each module's listing stands in the table where it was compiled
(theorem tt_ad_placedb () (= (placedb tt_tbl 4194584 tt_ad_listing) true) (by decide))
(theorem tt_ad_placed () (placed tt_tbl 4194584 tt_ad_listing)
  (exact (placedb_ok tt_tbl tt_ad_listing 4194584 tt_ad_placedb)))
(theorem tt_bo_placedb () (= (placedb tt_tbl tt_bo_base tt_bo_listing) true) (by decide))
(theorem tt_bo_placed () (placed tt_tbl tt_bo_base tt_bo_listing)
  (exact (placedb_ok tt_tbl tt_bo_listing tt_bo_base tt_bo_placedb)))
(theorem tt_placedb () (= (placedb tt_tbl tt_base tt_listing) true) (by decide))
(theorem tt_placed () (placed tt_tbl tt_base tt_listing)
  (exact (placedb_ok tt_tbl tt_listing tt_base tt_placedb)))
;; and `dot`'s rows are rows of it
(theorem tt_dot_rows () (= (table_part dot_rows tt_tbl) true) (by rfl))
