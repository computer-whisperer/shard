;;; v3/compile/x86/dot_main.shard — the file of dot_file.shard written to the path given, for the
;;; model's run and the processor's. The status is the low byte of what `dot` — the function
;;; over two lists, v3/models/x86/buffers.shard — computes of the two sample buffers, as the
;;; evaluator computes it; dot_run.shard proves the file's own run exits with it.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "dot_file.shard")
(import "../../models/x86/buffers.shard")
(use std.bytes)
(use std.host)
(use compile.x86.dot_file)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.word)

(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats (elf_exec dot_image)) w)
    ((Prod.mk ok w1)
     (exit (if ok (% (w64_val (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 1) w1))))
