;;; v3/compile/x86/argsum_file.shard — `argsum` compiled, and the file it runs in. The three
;;; functions of ../argsum_ir.shard go through the pass at 4194455, the address after a start-up
;;; that pushes nothing and hands the function it calls one word: the address the kernel left
;;; the stack pointer at (startup.shard, an argument that is the address of word 0 of no data).
;;; The file's lines are that start-up, its call going to label 1, and the compiled
;;; instructions with label 1 before the one at the entry of function 2. Here are the listing,
;;; the table, the file's bytes, and every fact of the assembled file that the theorems ask for,
;;; each closed by computation. That the file exits with `argsum` of its arguments is
;;; argsum_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "../argsum_ir.shard")
(use compile.argsum_ir)
(use compile.x86.code)
(use compile.x86.startup)
(use compile.x86.startup.Arg)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the start-up -------------------------------------------------------------------------------
;; no data; one argument, the address where the data would stand: the stack pointer as the
;; kernel left it. The call returns to 4194445 and the lines after the start-up stand from
;; 4194455.
(fn argsum_data () (List (BitVec 64)) nil)
(fn argsum_argd () (List Arg) (cons (AAddr 0) nil))

;; ---- compiled -----------------------------------------------------------------------------------
(fn argsum_listing () (List Instr)
  (match (compile nil argsum_prog 4194455)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn argsum_entries () (List (Prod Nat Nat))
  (match (compile nil argsum_prog 4194455)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem argsum_compiled ()
  (= (compile nil argsum_prog 4194455) (some (Prod.mk argsum_listing argsum_entries)))
  (by rfl))
;; the entry of function 2 as the pass answered it, and the words of stack it needs
(fn argsum_at () Nat
  (match (pair_at argsum_entries 2)
    (none 0)
    ((some en) (Prod.fst en))))
(fn argsum_need () Nat
  (match (pair_at argsum_entries 2)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem argsum_entry () (= (pair_at argsum_entries 2) (some (Prod.mk argsum_at argsum_need)))
  (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
;; the compiled instructions as lines, label 1 before the one at the entry of function 2
(fn argsum_lines () (List Asm) (label_at argsum_listing 4194455 argsum_at 1))
;; the file's table: the start-up's rows, its call's displacement d, then the compiled
;; instructions laid out from 4194455
(fn argsum_d () Nat (rel argsum_at 4194445))
(fn argsum_xt () (List (Prod Nat (Prod Instr Nat))) (layout argsum_listing 4194455))
(fn argsum_tbl () (List (Prod Nat (Prod Instr Nat)))
  (start_table argsum_data argsum_argd argsum_d argsum_xt))
(fn argsum_chi () Nat (+ 4194455 (isize argsum_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn argsum_image () (List Nat)
  (match (assemble (start_listing argsum_data argsum_argd 1 argsum_lines))
    (none nil)
    ((some code) code)))
(fn argsum_instrs () (List Instr)
  (match
    (resolve (start_listing argsum_data argsum_argd 1 argsum_lines)
      (start_listing argsum_data argsum_argd 1 argsum_lines)
      0)
    (none nil)
    ((some is) is)))
(theorem argsum_assembled ()
  (= (assemble (start_listing argsum_data argsum_argd 1 argsum_lines)) (some argsum_image))
  (by rfl))
(theorem argsum_resolved ()
  (=
    (resolve (start_listing argsum_data argsum_argd 1 argsum_lines)
      (start_listing argsum_data argsum_argd 1 argsum_lines)
      0)
    (some argsum_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches function 2, and
;; the lines after it are the compiled listing, instruction for instruction
(theorem argsum_laid () (= (layout argsum_instrs 4194424) argsum_tbl) (by rfl))
(theorem argsum_target ()
  (= (w64_add (w64 (start_ret argsum_data argsum_argd)) (w64 argsum_d)) (w64 argsum_at))
  (by rfl))
(theorem argsum_within () (= (all_within argsum_tbl 4194424 argsum_chi) true) (by rfl))
;; the code ends at or below the table's end
(theorem argsum_code_end () (<= (+ 4194424 (List.length argsum_image)) argsum_chi) (by decide))
(theorem argsum_chi_word () (<= (+ argsum_chi 15) 18446744073709551616) (by decide))
;; the compiled listing stands in the table at 4194455
(theorem argsum_placedb () (= (placedb argsum_tbl 4194455 argsum_listing) true) (by decide))
(theorem argsum_placed () (placed argsum_tbl 4194455 argsum_listing)
  (exact (placedb_ok argsum_tbl argsum_listing 4194455 argsum_placedb)))
