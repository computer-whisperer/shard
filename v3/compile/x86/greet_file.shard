;;; v3/compile/x86/greet_file.shard — `greet` compiled, in a file with the platform's
;;; `write_all`. The start-up (startup.shard) pushes the text as two words and hands the
;;; function it calls the address of the first. After the start-up stand the sixteen
;;; instructions of `write_all` (put.shard), at 4194477; the module of ../greet_ir.shard goes
;;; through the pass at 4194537, the address after them, with `write_all` as its one outside
;;; function: entered at 4194477, no word of stack. Here are the listing, the table, the file's
;;; bytes, and every fact of the assembled file that the theorems ask for, each closed by
;;; computation. That the file ends as `greet` says is greet_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "put.shard")
(import "../greet_ir.shard")
(use compile.greet_ir)
(use compile.x86.code)
(use compile.x86.put)
(use compile.x86.startup)
(use compile.x86.startup.Arg)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the start-up ---------------------------------------------------------------------------------
;; the text, "hello, w" and "orld" with a line's end and three bytes of 0, as two words — the
;; first byte the least significant —; and the function's one argument, the address of the
;; first. The call returns to 4194467 and the lines after the start-up stand from 4194477.
(fn greet_data () (List (BitVec 64)) (list (w64 8583909746840200552) (w64 44634501743)))
(fn greet_argd () (List Arg) (list (AAddr 0)))

;; ---- compiled -----------------------------------------------------------------------------------
;; the module's outside functions, each by its entry and its stack need: `write_all`
(fn greet_outs () (List (Prod Nat Nat)) (cons (Prod.mk 4194477 0) nil))
(fn greet_listing () (List Instr)
  (match (compile greet_outs greet_prog 4194537)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn greet_entries () (List (Prod Nat Nat))
  (match (compile greet_outs greet_prog 4194537)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem greet_compiled ()
  (= (compile greet_outs greet_prog 4194537) (some (Prod.mk greet_listing greet_entries)))
  (by rfl))
;; `greet`'s entry as the pass answered it, and the words of stack it needs
(fn greet_at () Nat
  (match (pair_at greet_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn greet_need () Nat
  (match (pair_at greet_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem greet_entry () (= (pair_at greet_entries 0) (some (Prod.mk greet_at greet_need))) (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
;; `write_all`'s instructions as lines, then the compiled instructions, label 1 before the one
;; at `greet`'s entry
(fn greet_lines () (List Asm)
  (List.append (lines put_code) (label_at greet_listing 4194537 greet_at 1)))
;; the file's table: the start-up's rows, its call's displacement d, `write_all`'s rows, then
;; the compiled instructions laid out from 4194537
(fn greet_d () Nat (rel greet_at 4194467))
(fn greet_xt () (List (Prod Nat (Prod Instr Nat)))
  (List.append (layout put_code 4194477) (layout greet_listing 4194537)))
(fn greet_tbl () (List (Prod Nat (Prod Instr Nat)))
  (start_table greet_data greet_argd greet_d greet_xt))
(fn greet_chi () Nat (+ 4194537 (isize greet_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn greet_image () (List Nat)
  (match (assemble (start_listing greet_data greet_argd 1 greet_lines))
    (none nil)
    ((some code) code)))
(fn greet_instrs () (List Instr)
  (match
    (resolve (start_listing greet_data greet_argd 1 greet_lines)
      (start_listing greet_data greet_argd 1 greet_lines)
      0)
    (none nil)
    ((some is) is)))
(theorem greet_assembled ()
  (= (assemble (start_listing greet_data greet_argd 1 greet_lines)) (some greet_image))
  (by rfl))
(theorem greet_resolved ()
  (=
    (resolve (start_listing greet_data greet_argd 1 greet_lines)
      (start_listing greet_data greet_argd 1 greet_lines)
      0)
    (some greet_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches `greet`,
;; `write_all`'s lines are its rows, and the lines after them the compiled listing
(theorem greet_laid () (= (layout greet_instrs 4194424) greet_tbl) (by rfl))
(theorem greet_target ()
  (= (w64_add (w64 (start_ret greet_data greet_argd)) (w64 greet_d)) (w64 greet_at))
  (by rfl))
(theorem greet_within () (= (all_within greet_tbl 4194424 greet_chi) true) (by rfl))
;; the code ends at or below the table's end, and the table's end below 2^47
(theorem greet_code_end () (<= (+ 4194424 (List.length greet_image)) greet_chi) (by decide))
(theorem greet_chi_word () (<= (+ greet_chi 15) 18446744073709551616) (by decide))
(theorem greet_chi_top () (<= (+ greet_chi 15) 140737488355328) (by decide))
(theorem greet_nargs () (<= (List.length greet_argd) 6) (by decide))
;; the compiled listing stands in the table at 4194537, and `write_all`'s code at 4194477
(theorem greet_placedb () (= (placedb greet_tbl 4194537 greet_listing) true) (by decide))
(theorem greet_placed () (placed greet_tbl 4194537 greet_listing)
  (exact (placedb_ok greet_tbl greet_listing 4194537 greet_placedb)))
(theorem greet_put_placedb () (= (placedb greet_tbl 4194477 put_code) true) (by decide))
(theorem greet_put_placed () (placed greet_tbl 4194477 put_code)
  (exact (placedb_ok greet_tbl put_code 4194477 greet_put_placedb)))
