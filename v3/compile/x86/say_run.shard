;;; v3/compile/x86/say_run.shard — `say`'s file ends as `say` says: a program of its arguments
;;; that writes in a loop, through every layer (docs/COMPILE.md §5, §6, §8). The file of
;;; say_file.shard, started with its stack anywhere `stack_ok` allows, with ANY arguments the
;;; kernel leaves at the stack pointer (v3/models/x86/linux.shard `args_at`) and on ANY list of
;;; the kernel's answers, ends as the program's value on the World its process starts with says
;;; (`say_file_ends`): every argument after the first written on a line of its own and status
;;; 0; or a write failed, and it exits with that failure's status having written what was
;;; taken; or the kernel ended it. From the module's theorem for runs with what is outside
;;; (`wmodule_realizes`), whose hypothesis about the outside function is `write_all`'s own
;;; theorem (`put_wx_realizes`); the tie of the four functions' code (`say_prog_tie`); and the
;;; link over the range from the data's word to the top of the stack's range
;;; (`start_ends_top`), the memory the function is entered with being the start's from the
;;; stack pointer up. The line's end is known in the memory that holds the word the start-up
;;; pushes (`held_bytes`).
(import "say_file.shard")
(import "module.shard")
(import "link.shard")
(import "../../models/x86/bytes.shard")
(import "../../models/x86/args.shard")
(use std.mem)
(use std.world)
(use compile.say_ir)
(use compile.say_src)
(use compile.ir)
(use compile.put)
(use compile.stretch)
(use compile.x86.code)
(use compile.x86.say_file)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.put)
(use compile.x86.seam)
(use compile.x86.startup)
(use models.x86.args)
(use models.x86.bytes)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.linux.Answer)
(use models.x86.linux.Os)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.word)
(use models.x86.world)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; function 3, the one the start-up calls: its code, at the entry the pass answered, realizes
;; the answer of its intermediate code's run with what is outside, for any data ranges
(theorem say_code_is () (= (fn_at say_prog 3) (some say_code3)) (by rfl))
(theorem say_code_realizes ((rs (List Seg)))
  (wrealizes say_tbl 4194424 say_chi say_at say_need rs (wfn_ans say_prog (put_wx rs) rs say_code3))
  (exact
    (wmodule_realizes say_prog (put_wx rs) rs say_tbl 4194424 say_chi say_outs 4194542 say_listing
      say_entries
      say_within
      say_chi_word
      (one_out_realizes say_tbl 4194424 say_chi 4194482 0 rs (put_wx rs)
        (put_wx_realizes say_tbl 4194424 say_chi 4194482 rs say_within say_chi_top say_put_placed))
      say_compiled
      say_placed
      3
      say_code3
      (Prod.mk say_at say_need)
      say_code_is
      say_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the outcome of the entry's code in a memory that holds the word the start-up pushes and the
;; arguments at the stack pointer, with o outside: the file ends by it as `say`'s value on the
;; World of o says
(theorem say_answer
  ((sp Nat)
   (hi Nat)
   (m0 Mem)
   (o Os)
   (args (List (List Nat)))
   (h8 (<= 8 sp))
   (hhi (<= hi 140737488355328))
   (hh (holds m0 (start_base sp say_data) say_data))
   (ha (args_at m0 sp hi args)))
  (exists ((out Outcome))
    (and
      (wfn_ans say_prog (put_wx (args_rs (start_base sp say_data) hi))
        (args_rs (start_base sp say_data) hi)
        say_code3
        (arg_words (w64 (start_base sp say_data)) say_argd)
        m0
        o
        out)
      (= (exit_of out)
        (world_res (Prod.fst (say args (os_world o))) (Prod.snd (say args (os_world o)))))))
  (by
    ;; the data's word stands under the stack pointer
    (have hs (= (+ (start_base sp say_data) 8) sp) (exact (Nat.sub_add_cancel h8)))
    (have hab (<= (+ sp (* 8 (+ (List.length args) 1))) hi) (exact (And.left (And.right ha))))
    (have hb16 (<= (+ (start_base sp say_data) (* 8 1)) 140737488355328) (arith))
    (have h11 (<= 1 1) (decide))
    (have h01 (<= 0 1) (decide))
    ;; the two words the start-up hands over: the stack pointer's address and the data's
    (have hq (= (w64_val (w64_add (w64 (start_base sp say_data)) (w64 (* 8 1)))) sp)
      (rw (start_addr (start_base sp say_data) 1 1 hb16 h11))
      (exact hs))
    (have hn
      (= (w64_val (w64_add (w64 (start_base sp say_data)) (w64 (* 8 0)))) (start_base sp say_data))
      (exact (start_addr (start_base sp say_data) 1 0 hb16 h01)))
    (have hbsp (<= (start_base sp say_data) sp) (arith))
    (have h3 (<= (start_base sp say_data) (start_base sp say_data))
      (exact (Nat.le_refl (start_base sp say_data))))
    (have h4 (<= (+ (start_base sp say_data) 1) hi) (arith))
    ;; the line's end, from the word the memory holds
    (have k0 (< 0 (List.length say_data)) (decide))
    (have hw0 (= (w64 (mem_le64 m0 (start_base sp say_data))) (w64 10)) (exact (hh 0 k0)))
    (have v0 (< 10 18446744073709551616) (decide))
    (have h18 (<= 1 8) (decide))
    (have hnl (= (mem_bytes m0 (start_base sp say_data) 1) (list 10))
      (rw (<- (mem_bytes_take m0 1 (start_base sp say_data) 8 h18)))
      (rw (held_bytes m0 (start_base sp say_data) 10 hw0 v0))
      rfl)
    (cases
      (say_prog_tie (start_base sp say_data) sp hi m0 hbsp hhi
        (w64_add (w64 (start_base sp say_data)) (w64 (* 8 0)))
        (start_base sp say_data)
        hn
        h3
        h4
        hnl
        args
        (w64_add (w64 (start_base sp say_data)) (w64 (* 8 1)))
        o
        hq
        ha)
      ((intro (out g)
         (apply (Exists.intro out)
           ((apply And.intro ((exact (And.left g)))
              ((rw (say_status args (os_world o)))
               (exact (tied_exit out (w64 0) m0 (Prod.snd (say args (os_world o))) (And.right g))))))))))))
;; THE FILE ENDS AS `say` SAYS. Started with its stack anywhere — the data's word, the entry's
;; need and the return address under the stack pointer —, with whatever arguments the kernel
;; left at the stack pointer, and whatever the kernel answers its calls.
(theorem say_file_ends
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ say_chi 15) (+ (+ (List.length say_data) say_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem)
   (args (List (List Nat)))
   (ha (args_at m sp hi args))
   (as (List Answer)))
  (ends (elf_exec say_image) (start_at lo sp hi r f m) as (say_res args as))
  (by
    (have hfit (<= (+ lo (* 8 (+ (+ 1 say_need) 1))) sp) (exact (And.left (And.right hst))))
    (have hhi (<= hi 140737488355328) (exact (And.right (And.right (And.right hst)))))
    (have h8 (<= 8 sp) (arith))
    (have hans
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp say_data) (* 8 (List.length say_data))) 140737488355328)
          (holds m0 (start_base sp say_data) say_data)
          (same_outside m m0 0 sp)
          (exists ((out Outcome))
            (and
              (wfn_ans say_prog (put_wx (args_rs (start_base sp say_data) hi))
                (args_rs (start_base sp say_data) hi)
                say_code3
                (arg_words (w64 (start_base sp say_data)) say_argd)
                m0
                (os_start as)
                out)
              (= (exit_of out) (say_res args as))))))
      (intro m0 hb hh hsm)
      (have ha0 (args_at m0 sp hi args) (exact (args_at_same m m0 sp hi args hsm ha)))
      (exact (say_answer sp hi m0 (os_start as) args h8 hhi hh ha0)))
    (exact
      (start_ends_top say_data say_argd 1 say_lines say_image say_instrs say_d say_xt say_at say_chi
        say_need
        (wfn_ans say_prog (put_wx (args_rs (start_base sp say_data) hi))
          (args_rs (start_base sp say_data) hi)
          say_code3)
        (say_res args as)
        as
        lo
        sp
        hi
        hi
        say_assembled
        say_resolved
        say_laid
        say_target
        say_within
        say_code_end
        hst
        say_nargs
        (Nat.le_refl hi)
        r
        f
        m
        (say_code_realizes (args_rs (start_base sp say_data) hi))
        hans))))
;; run as `say hi yo`, with a kernel that takes all it is offered: two lines, and status 0
(theorem say_file_says
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ say_chi 15) (+ (+ (List.length say_data) say_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem)
   (ha (args_at m sp hi (list (list 115 97 121) (list 104 105) (list 121 111)))))
  (ends (elf_exec say_image) (start_at lo sp hi r f m) nil (RExit 0 (list 104 105 10 121 111 10)))
  (exact
    (say_file_ends lo sp hi hst r f m (list (list 115 97 121) (list 104 105) (list 121 111)) ha nil)))
