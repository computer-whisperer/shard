;;; v3/compile/x86/tail.shard — a tail call: the arguments, the six pops, a jump to the callee's
;;; entry. The callee is a function before this one, an external, or this function itself (a
;;; loop); what is known of it is a fact for the fuel of its run.
(import "pass.shard")
(import "../ir_laws.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(import "inv.shard")
(use std.mem)
(use compile.x86.code)
(use compile.x86.inv)
(use compile.ir)
(use compile.ir_laws)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use compile.ir.IStm)
(use compile.x86.mem)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use models.x86.asm)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use models.x86.x86.Instr)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(import "stmt.shard")
(import "call.shard")
(use compile.x86.call)
(use compile.x86.entry)

;; ---- what a tail call's callee is known by -------------------------------------------------------
;; the code at ea, with a need of kc words, does what the callee's run on the fuel n says: from
;; a state with the arguments, room and the data ranges, it arrives at the run's outcome — a
;; return of the run's word with the data ranges as the run's memory has them, or the
;; process's end
(def tail_fact
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (cal ICallee)
   (na Nat)
   (ea Nat)
   (kc Nat)
   (n Fuel))
  Prop
  (forall ((c Cpu) (vs (List (BitVec 64))) (m Mem) (f Nat) (o Os) (out Outcome))
    (-> (code_in c tbl) (args_in c vs) (room c clo chi f kc) (data_ok c rs clo chi f kc)
      (agree rs m (Cpu.mem c))
      (= (List.length vs) na)
      (= (wcal_run n p wx rs cal vs m o) (some out))
      (arrives rs f kc c (at_pc c (w64 ea)) o out))))
;; every callee a tail call may have is known so, for the fuel n
(def tenv_ok
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n Fuel))
  Prop
  (forall ((cal ICallee) (na Nat) (en (Prod Nat Nat)))
    (-> (= (callee_at xs ts p cal na) (some en))
      (tail_fact p wx rs tbl clo chi cal na (Prod.fst en) (Prod.snd en) n))))
;; code that realizes a callee's answer is known so for every fuel
(theorem tail_of_real
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (cal ICallee)
   (na Nat)
   (ea Nat)
   (kc Nat)
   (n Fuel)
   (hr (wrealizes tbl clo chi ea kc rs (cal_ans p wx rs cal na))))
  (tail_fact p wx rs tbl clo chi cal na ea kc n)
  (by
    (intro c vs m f o out hcode hargs hroom hdo hag hlen hq)
    (have hans (cal_ans p wx rs cal na vs m o out)
      (show
        (and (= (List.length vs) na)
          (exists ((n0 Fuel)) (= (wcal_run n0 p wx rs cal vs m o) (some out)))))
      (apply And.intro ((exact hlen)) ((apply (Exists.intro n) ((exact hq))))))
    (exact (hr c vs m f o out hcode hargs hroom hdo hag hans))))

;; ---- THE LAW OF A TAIL CALL -----------------------------------------------------------------------
;; A state ct inside a function entered in c0, its frame given back: the stack pointer at the
;; return address, the six registers c0's caller had. It holds the arguments vs, and the callee
;; needs no more than the function's k words. Where the callee's run on vs and the function's
;; run's memory comes to an outcome, the processor arrives so from the callee's entry: for a
;; return of v, at a state that has returned to c0's caller with v in rax.
(theorem tail_law
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (cal ICallee)
   (na Nat)
   (ea Nat)
   (kc Nat)
   (n1 Fuel)
   (c0 Cpu)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (ct Cpu)
   (mi Mem)
   (vs (List (BitVec 64)))
   (o Os)
   (out Outcome)
   (hT (tail_fact p wx rs tbl clo chi cal na ea kc n1))
   (wt (framed c0 tbl clo chi f k m0 ct k (cons (ret_addr c0) nil)))
   (h3 (= (reg ct 3) (reg c0 3)))
   (h5 (= (reg ct 5) (reg c0 5)))
   (h12 (= (reg ct 12) (reg c0 12)))
   (h13 (= (reg ct 13) (reg c0 13)))
   (h14 (= (reg ct 14) (reg c0 14)))
   (h15 (= (reg ct 15) (reg c0 15)))
   (hdo (data_ok c0 rs clo chi f k))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f k (Cpu.mem c0) m0))
   (hargs (args_in ct vs))
   (hlen (= (List.length vs) na))
   (hq (= (wcal_run n1 p wx rs cal vs mi o) (some out)))
   (hkc (<= kc k)))
  (arrives rs f k c0 (at_pc ct (w64 ea)) o out)
  (by
    (have ee (= (+ (- k kc) kc) k) (exact (Nat.sub_add_cancel hkc)))
    (have hf2 (= (+ (+ f (* 8 (- k kc))) (* 8 kc)) (+ f (* 8 k))) (arith ee))
    (have hlo (<= f (+ f (* 8 (- k kc)))) (arith))
    (have hroom2 (room ct clo chi (+ f (* 8 (- k kc))) kc)
      (exact
        (room_sub c0 tbl clo chi f k m0 ct k (ret_addr c0) nil (+ f (* 8 (- k kc))) kc wt hf2 hlo)))
    (have hhi (<= (+ (+ f (* 8 (- k kc))) (* 8 (+ kc 1))) (+ f (* 8 (+ k 1)))) (arith ee))
    (have hdo2 (data_ok ct rs clo chi (+ f (* 8 (- k kc))) kc)
      (exact (data_sub c0 ct rs clo chi f k (+ f (* 8 (- k kc))) kc hdo (framed_segs wt) hlo hhi)))
    (have hag2 (agree rs mi (Cpu.mem ct))
      (exact (agree_frame c0 rs clo chi f k mi m0 (Cpu.mem ct) hdo hag (framed_mem wt))))
    (have fin
      (-> (arrives rs (+ f (* 8 (- k kc))) kc ct (at_pc ct (w64 ea)) o out)
        (arrives rs f k c0 (at_pc ct (w64 ea)) o out))
      (cases out
        ((ORet (v m2 o2)
           (show
             (-> (rets rs (+ f (* 8 (- k kc))) kc ct (at_pc ct (w64 ea)) o v m2 o2)
               (rets rs f k c0 (at_pc ct (w64 ea)) o v m2 o2)))
           (intro gg)
           (cases gg
             ((intro (c2 g) (have hv (= (reg c2 0) v) (exact (And.left (And.right g))))
                (have hag6 (agree rs m2 (Cpu.mem c2)) (exact (And.left (And.right (And.right g)))))
                (have hkm6 (kept_mem rs (+ f (* 8 (- k kc))) kc (Cpu.mem ct) (Cpu.mem c2))
                  (exact (And.left (And.right (And.right (And.right g))))))
                (have hret (returned ct c2)
                  (exact (And.right (And.right (And.right (And.right g))))))
                (have kp (kept ct c2) (exact (returned_kept ct c2 hret)))
                (have hrip (= (Cpu.rip c2) (ret_addr c0))
                  (rw (returned_at ct c2 hret))
                  (exact (framed_top wt)))
                (have hf0 (= (w64_val (reg c0 4)) (+ f (* 8 k)))
                  (exact (And.left (framed_room wt))))
                (have e4 (= (reg ct 4) (reg c0 4))
                  (apply BitVec.eq_of_toNat_eq
                    ((show (= (w64_val (reg ct 4)) (w64_val (reg c0 4))))
                     (rw hf0)
                     (exact (framed_sp wt)))))
                (have hsp (= (reg c2 4) (w64_add (reg c0 4) (w64 8)))
                  (rw (kept_sp ct c2 kp))
                  (rw e4)
                  rfl)
                (have hsegs (= (Cpu.segs c2) (Cpu.segs c0))
                  (exact (Eq.trans (kept_segs ct c2 kp) (framed_segs wt))))
                (have k3 (= (reg c2 3) (reg c0 3)) (exact (Eq.trans (kept_rbx ct c2 kp) h3)))
                (have k5 (= (reg c2 5) (reg c0 5)) (exact (Eq.trans (kept_rbp ct c2 kp) h5)))
                (have k12 (= (reg c2 12) (reg c0 12)) (exact (Eq.trans (kept_r12 ct c2 kp) h12)))
                (have k13 (= (reg c2 13) (reg c0 13)) (exact (Eq.trans (kept_r13 ct c2 kp) h13)))
                (have k14 (= (reg c2 14) (reg c0 14)) (exact (Eq.trans (kept_r14 ct c2 kp) h14)))
                (have k15 (= (reg c2 15) (reg c0 15)) (exact (Eq.trans (kept_r15 ct c2 kp) h15)))
                (have hret0 (returned c0 c2)
                  (exact
                    (And.intro hrip
                      (And.intro hsp
                        (And.intro hsegs
                          (And.intro k3
                            (And.intro k5 (And.intro k12 (And.intro k13 (And.intro k14 k15))))))))))
                (have hhi2 (<= (+ (+ f (* 8 (- k kc))) (* 8 kc)) (+ f (* 8 k))) (arith ee))
                (have hkm7 (kept_mem rs f k (Cpu.mem c0) (Cpu.mem c2))
                  (exact
                    (kept_call rs f k (+ f (* 8 (- k kc))) kc (Cpu.mem c0) (Cpu.mem ct) (Cpu.mem c2)
                      (kept_frame rs f k (Cpu.mem c0) m0 (Cpu.mem ct) hkm (framed_mem wt))
                      hkm6
                      hlo
                      hhi2)))
                (apply (Exists.intro c2)
                  ((apply And.intro ((exact (And.left g)))
                     ((apply And.intro ((exact hv))
                        ((apply And.intro ((exact hag6))
                           ((apply And.intro ((exact hkm7)) ((exact hret0)))))))))))))))
         (OEnd (r) (intro gg) (exact gg)))))
    (exact
      (fin (hT ct vs mi (+ f (* 8 (- k kc))) o out (framed_code wt) hargs hroom2 hdo2 hag2 hlen hq)))))

;; ---- the machine's part of a tail call ------------------------------------------------------------
;; The six pops and the jump, from a state described as the six pushes left it that holds the
;; arguments: by the callee's run, to the function's caller.
(theorem tail_jump
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (n1 Fuel)
   (cal ICallee)
   (mi Mem)
   (o Os)
   (out Outcome)
   (cs Cpu)
   (b Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (m0 Mem)
   (vs (List (BitVec 64)))
   (ea Nat)
   (kc Nat)
   (na Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hT (tail_fact p wx rs tbl clo chi cal na ea kc n1))
   (hlen (= (List.length vs) na))
   (hq (= (wcal_run n1 p wx rs cal vs mi o) (some out)))
   (hpl (placed tbl b (pops (cons (Jmp (rel ea (+ b 15))) nil))))
   (hkc (<= kc (+ d 6)))
   (hrip (= (Cpu.rip cs) (w64 b)))
   (w1 (framed c0 tbl clo chi f (+ d 6) m0 cs d (saved c0)))
   (hargs (args_in cs vs))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 cs o out)
  (by
    (have sJ
      (= (site tbl (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1)) (some (Prod.mk (Jmp (rel ea (+ b 15))) 5)))
      (exact (And.left (And.right (And.right (And.right (And.right (And.right (And.right hpl)))))))))
    (have ej (= (+ (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1) 5) (+ b 15)) (arith))
    (have hlt (< (+ (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1) 15) 18446744073709551616)
      (exact
        (site_lt15 tbl clo chi (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1)
          (Prod.mk (Jmp (rel ea (+ b 15))) 5)
          hall
          hchi
          sJ)))
    (have hlt2 (< (+ b 15) 18446744073709551616) (arith hlt))
    (have htgt
      (= (w64_add (w64 (+ (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1) 5)) (w64 (rel ea (+ b 15))))
        (w64 ea))
      (rw ej)
      (exact (rel_ok (+ b 15) ea hlt2)))
    (have gp0
      (and (reaches cs (e6 cs b))
        (and (framed c0 tbl clo chi f (+ d 6) m0 (e6 cs b) (+ d 6) (cons (ret_addr c0) nil))
          (and (= (reg (e6 cs b) 3) (reg c0 3))
            (and (= (reg (e6 cs b) 5) (reg c0 5))
              (and (= (reg (e6 cs b) 12) (reg c0 12))
                (and (= (reg (e6 cs b) 13) (reg c0 13))
                  (and (= (reg (e6 cs b) 14) (reg c0 14)) (= (reg (e6 cs b) 15) (reg c0 15)))))))))
      (exact
        (pops_ok c0 tbl clo chi f d m0 cs b (cons (Jmp (rel ea (+ b 15))) nil) hall hchi w1 hrip hpl)))
    (have rp (reaches cs (e6 cs b)) (exact (And.left gp0)))
    (have gp
      (and (framed c0 tbl clo chi f (+ d 6) m0 (e6 cs b) (+ d 6) (cons (ret_addr c0) nil))
        (and (= (reg (e6 cs b) 3) (reg c0 3))
          (and (= (reg (e6 cs b) 5) (reg c0 5))
            (and (= (reg (e6 cs b) 12) (reg c0 12))
              (and (= (reg (e6 cs b) 13) (reg c0 13))
                (and (= (reg (e6 cs b) 14) (reg c0 14)) (= (reg (e6 cs b) 15) (reg c0 15))))))))
      (exact (And.right gp0)))
    (have wt (framed c0 tbl clo chi f (+ d 6) m0 (e6 cs b) (+ d 6) (cons (ret_addr c0) nil))
      (exact (And.left gp)))
    (have rj (reaches (e6 cs b) (at_pc (e6 cs b) (w64 ea)))
      (apply (t_jmp tbl clo chi (+ (+ (+ (+ (+ (+ b 2) 2) 2) 2) 1) 1) (rel ea (+ b 15)) 5 ea)
        ((exact hall))
        ((exact hchi))
        ((exact (framed_code wt)))
        (rfl)
        ((exact sJ))
        ((exact htgt))
        ((exact (reaches_refl (at_pc (e6 cs b) (w64 ea)))))))
    (have ha
      (= (regs_of (e6 cs b) (List.take (List.length vs) arg_regs))
        (regs_of cs (List.take (List.length vs) arg_regs)))
      (rw (regs_of_take (e6 cs b) arg_regs (List.length vs)))
      (rw (regs_of_take cs arg_regs (List.length vs)))
      rfl)
    (have hx2 (= vs (regs_of (e6 cs b) (List.take (List.length vs) arg_regs)))
      (rw ha)
      (exact (And.right hargs)))
    (have hargsT (args_in (e6 cs b) vs) (exact (And.intro (And.left hargs) hx2)))
    (exact
      (arrives_from rs f (+ d 6) c0 cs (at_pc (e6 cs b) (w64 ea)) o out
        (reaches_trans cs (e6 cs b) (at_pc (e6 cs b) (w64 ea)) rp rj)
        (tail_law p wx rs tbl clo chi cal na ea kc n1 c0 f (+ d 6) m0 (e6 cs b) mi vs o out hT wt
          (And.left (And.right gp))
          (And.left (And.right (And.right gp)))
          (And.left (And.right (And.right (And.right gp))))
          (And.left (And.right (And.right (And.right (And.right gp)))))
          (And.left (And.right (And.right (And.right (And.right (And.right gp))))))
          (And.right (And.right (And.right (And.right (And.right (And.right gp))))))
          hdo
          hag
          hkm
          hargsT
          hlen
          hq
          hkc)))))
;; a tail call's code: the arguments, the frame's locals given back, the pops and the jump
(theorem tail_core
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (c Cpu)
   (a Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (j Nat)
   (sl (List (BitVec 64)))
   (vs (List (BitVec 64)))
   (ea Nat)
   (kc Nat)
   (ca (List Instr))
   (na Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hT (tail_fact p wx rs tbl clo chi cal na ea kc n1))
   (hvs (= (ievals rs ls mi es) (some vs)))
   (hlen (= (List.length vs) na))
   (hq (= (wcal_run n1 p wx rs cal vs mi o) (some out)))
   (hca (= (cargs es 0 nl) (some ca)))
   (hpl (placed tbl a (List.append ca (tail_out nl ea (+ a (isize ca))))))
   (hkc (<= kc (+ d 6)))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0))))
   (hls (= ls (app (List.take nl (regs6 c)) sl)))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 c o out)
  (by
    (have p1 (placed tbl a ca)
      (exact (And.left (placed_app tbl ca a (tail_out nl ea (+ a (isize ca))) hpl))))
    (have p2 (placed tbl (+ a (isize ca)) (tail_out nl ea (+ a (isize ca))))
      (exact (And.right (placed_app tbl ca a (tail_out nl ea (+ a (isize ca))) hpl))))
    (have pS (placed tbl (+ a (isize ca)) (slots_out nl))
      (exact
        (And.left
          (placed_app tbl (slots_out nl) (+ a (isize ca))
            (pops (cons (Jmp (rel ea (+ (+ (+ a (isize ca)) (isize (slots_out nl))) 15))) nil))
            p2))))
    (have pP
      (placed tbl (+ (+ a (isize ca)) (isize (slots_out nl)))
        (pops (cons (Jmp (rel ea (+ (+ (+ a (isize ca)) (isize (slots_out nl))) 15))) nil)))
      (exact
        (And.right
          (placed_app tbl (slots_out nl) (+ a (isize ca))
            (pops (cons (Jmp (rel ea (+ (+ (+ a (isize ca)) (isize (slots_out nl))) 15))) nil))
            p2))))
    (have h06 (<= 0 6) (decide))
    (have hpre0 (= (regs_of c (List.take 0 arg_regs)) (@List.nil (BitVec 64))) rfl)
    (have hlc (locs c nl ls)
      (exact (locs_framed c0 tbl clo chi f (+ d 6) m0 c j (saved c0) nl ls sl w hls hsl)))
    (cases
      (cargs_ok tbl clo chi rs ls mi nl hall hchi es 0 c a ca vs nil hca hvs p1 (framed_code w) hrip
        hlc
        h06
        hpre0)
      ((intro (c1 g1) (have r1 (reaches c c1) (exact (And.left g1)))
         (have hrip1 (= (Cpu.rip c1) (w64 (+ a (isize ca)))) (exact (And.left (And.right g1))))
         (have hsc (scratch c c1) (exact (And.left (And.right (And.right g1)))))
         (have hlen6 (<= (+ 0 (List.length vs)) 6)
           (exact (And.left (And.right (And.right (And.right g1))))))
         (have hreg1 (= (regs_of c1 (List.take (+ 0 (List.length vs)) arg_regs)) (app nil vs))
           (exact (And.right (And.right (And.right (And.right g1))))))
         (have e0 (= (+ 0 (List.length vs)) (List.length vs))
           (exact (Nat.zero_add (List.length vs))))
         (have hx1 (= vs (regs_of c1 (List.take (List.length vs) arg_regs)))
           (rw (<- e0))
           (rw hreg1)
           rfl)
         (have hl6 (<= (List.length vs) 6) (arith hlen6))
         (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 j (app sl (saved c0)))
           (exact (framed_scratch c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0)) c1 w hsc)))
         (have hne (< 0 (List.length (saved c0))) (exact (Nat.zero_lt_succ 6)))
         (cases
           (slots_out_ok c0 tbl clo chi f (+ d 6) m0 c1 (+ a (isize ca)) j sl (saved c0) nl hall
             hchi
             w1
             hsl
             hne
             hrip1
             pS)
           ((intro (cs gs) (have rs1 (reaches c1 cs) (exact (And.left gs)))
              (have hrips (= (Cpu.rip cs) (w64 (+ (+ a (isize ca)) (isize (slots_out nl)))))
                (exact (And.left (And.right gs))))
              (have wS (framed c0 tbl clo chi f (+ d 6) m0 cs d (saved c0))
                (exact
                  (framed_idx c0 tbl clo chi f (+ d 6) m0 cs (+ j (List.length sl)) (saved c0) d
                    (And.left (And.right (And.right gs)))
                    hj)))
              (have hrg (= (regs_of cs arg_regs) (regs_of c1 arg_regs))
                (exact (And.left (And.right (And.right (And.right (And.right gs)))))))
              (have hxs (= vs (regs_of cs (List.take (List.length vs) arg_regs)))
                (rw (regs_of_take cs arg_regs (List.length vs)))
                (rw hrg)
                (rw (<- (regs_of_take c1 arg_regs (List.length vs))))
                (exact hx1))
              (have hargsS (args_in cs vs) (exact (And.intro hl6 hxs)))
              (exact
                (arrives_from rs f (+ d 6) c0 c cs o out (reaches_trans c c1 cs r1 rs1)
                  (tail_jump p wx rs tbl clo chi n1 cal mi o out cs
                    (+ (+ a (isize ca)) (isize (slots_out nl)))
                    c0
                    f
                    d
                    m0
                    vs
                    ea
                    kc
                    na
                    hall
                    hchi
                    hT
                    hlen
                    hq
                    pP
                    hkc
                    hrips
                    wS
                    hargsS
                    hag
                    hkm
                    hdo)))))))))))
;; ---- a tail call ------------------------------------------------------------------------------------
(theorem sim_tail
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
