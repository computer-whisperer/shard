  (arrives rs f (+ d 6) c0 c o out)
  (by
    (cases (wrun_tail_inv p wx rs n1 cal es ls mi o out hrun)
      ((intro (vs g0)
         (cases (cstm_tail_inv xs fs ts p nl a cal es code hcs)
           ((intro (en g1)
              (cases en
                ((mk (ea kc)
                   (have hcal (= (callee_at xs ts p cal (List.length es)) (some (Prod.mk ea kc)))
                     (exact (And.left g1)))
                   (cases (And.right g1)
                     ((intro (ca g2)
                        (have hcd (= code (List.append ca (tail_out nl ea (+ a (isize ca)))))
                          (exact (And.right g2)))
                        (have hpl2 (placed tbl a (List.append ca (tail_out nl ea (+ a (isize ca)))))
                          (rw (<- hcd))
                          (exact hpl))
                        (have hT (tail_fact p wx rs tbl clo chi cal (List.length es) ea kc n1)
                          (exact (ht cal (List.length es) (Prod.mk ea kc) hcal)))
                        (have hk0 (<= kc (+ (+ j (nsl nl)) 6))
                          (exact (sneed_tail xs fs ts p nl cal es (Prod.mk ea kc) j hcal hsn)))
                        (have hkc (<= kc (+ d 6)) (arith hk0 hj hsl))
                        (exact
                          (tail_core p wx rs tbl clo chi xs fs ts n1 cal es ls mi o out c a c0 f d
                            nl
                            m0
                            j
                            sl
                            vs
                            ea
                            kc
                            ca
                            (List.length es)
                            hall
                            hchi
                            hT
                            (And.left g0)
                            (ievals_len rs ls mi es vs (And.left g0))
                            (And.right g0)
                            (And.left g2)
                            hpl2
                            hkc
                            hrip
                            w
                            hls
                            hsl
                            hj
                            hag
                            hkm
                            hdo))))))))))))))))
