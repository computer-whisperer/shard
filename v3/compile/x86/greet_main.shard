;;; v3/compile/x86/greet_main.shard — `greet`'s file written, and what its theorem says. The
;;; file's bytes are greet_file.shard's `greet_image` as an executable file; for a list of the
;;; kernel's answers the theorem's right side (../greet_ir.shard `greet_res`) is evaluated and
;;; printed as the model's runner prints a run, for a test to compare.
;;;
;;;   load.shard --root v3 --init … --run compile.x86.greet_main.main v3/compile/x86/greet_main.shard -- write PATH
;;;   … -- says SPEC…     a line for each list SPEC of answers (models/x86/run_main.shard)
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "greet_file.shard")
(import "../../models/x86/run_main.shard")
(use std.bytes)
(use std.host)
(use compile.greet_ir greet_res)
(use compile.x86.greet_file)
(use models.x86.elf)
(use models.x86.run_main answers_of same show_res text)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(fn fail ((w World)) World
  (exit 2 (write_line (Bytes.ofNats (text "greet: write PATH | says SPEC…")) w)))
(fn says_each ((specs (List ByteArray)) (w World)) World
  (measure (struct specs))
  (match specs
    (nil w)
    ((cons sp r)
     (says_each r
       (write_line (Bytes.ofNats (show_res (greet_res (answers_of (Bytes.toNats sp) nil)))) w)))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       ((cons cmd rest)
        (if (same (Bytes.toNats cmd) (text "says")) (says_each rest w1)
        (match rest
          ((cons path nil)
           (if (same (Bytes.toNats cmd) (text "write"))
             (match (write_file path (Bytes.ofNats (elf_exec greet_image)) w1)
               ((Prod.mk ok w2) (if ok w2 (fail w2))))
             (fail w1)))
          (_ (fail w1)))))
       (nil (fail w1))))))
