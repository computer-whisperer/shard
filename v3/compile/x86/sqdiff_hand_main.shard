;;; v3/compile/x86/sqdiff_hand_main.shard — the file of sqdiff_hand_file.shard, `sqdiff` with the
;;; hand-written `dot`, written to the path given, for the model's run and the processor's. The
;;; status is the low byte of what `sqdiff` — the function over two lists, ../sqdiff_lo.shard —
;;; computes of the two sample buffers, as the evaluator computes it; sqdiff_hand_run.shard
;;; proves the file's own run exits with it.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "sqdiff_hand_file.shard")
(import "../sqdiff_lo.shard")
(import "../../models/x86/buffers.shard")
(use std.bytes)
(use std.host)
(use compile.sqdiff_lo)
(use compile.x86.sqdiff_hand_file)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.word)

(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats (elf_exec sqh_image)) w)
    ((Prod.mk ok w1)
     (exit (if ok (% (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 1) w1))))
