;;; v3/compile/x86/entry.shard — into a compiled function and out of it. The six
;;; pushes with the frame described after them, the first six locals set, a zero pushed for
;;; each local of the frame; the frame's locals given back, the six pops, the return.
(import "pass.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(import "inv.shard")
(use std.mem)
(use compile.ir)
(use compile.x86.code)
(use compile.x86.lists)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use models.x86.asm)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the six pushes -----------------------------------------------------------------------------
(fn q1 ((c Cpu) (a Nat)) Cpu (at_pc (pushed (at_pc c (w64 a)) (reg c 3)) (w64 (+ a 1))))
(fn q2 ((c Cpu) (a Nat)) Cpu (at_pc (pushed (q1 c a) (reg c 5)) (w64 (+ (+ a 1) 1))))
(fn q3 ((c Cpu) (a Nat)) Cpu (at_pc (pushed (q2 c a) (reg c 12)) (w64 (+ (+ (+ a 1) 1) 2))))
(fn q4 ((c Cpu) (a Nat)) Cpu (at_pc (pushed (q3 c a) (reg c 13)) (w64 (+ (+ (+ (+ a 1) 1) 2) 2))))
(fn q5 ((c Cpu) (a Nat)) Cpu
  (at_pc (pushed (q4 c a) (reg c 14)) (w64 (+ (+ (+ (+ (+ a 1) 1) 2) 2) 2))))
(fn q6 ((c Cpu) (a Nat)) Cpu
  (at_pc (pushed (q5 c a) (reg c 15)) (w64 (+ (+ (+ (+ (+ (+ a 1) 1) 2) 2) 2) 2))))
;; the address after them
(fn pa ((a Nat)) Nat (+ (+ (+ (+ (+ (+ a 1) 1) 2) 2) 2) 2))
;; From a function's first instruction: the six registers pushed, and the state after them
;; described — the six words and the return address standing from the stack pointer, d words up.
(theorem pro_push
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (c Cpu)
   (a Nat)
   (f Nat)
   (d Nat)
   (np Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hroom (room c clo chi f (+ d 6)))
   (hpl (placed tbl a (pro np))))
  (and (reaches (at_pc c (w64 a)) (q6 c a))
    (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q6 c a) d (saved c)))
  (by
    (have w0
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (at_pc c (w64 a)) (+ d 6) (cons (ret_addr c) nil))
      (exact (framed_enter c tbl clo chi f (+ d 6) hroom hall hcode)))
    (have e0 (= (+ d 6) (+ (+ d 5) 1)) (arith))
    (have w1
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q1 c a) (+ d 5)
        (cons (reg c 3) (cons (ret_addr c) nil)))
      (exact (framed_push_eq (+ d 5) (reg c 3) w0 e0)))
    (have m0 (= (mapped (Cpu.segs (at_pc c (w64 a))) (push_at (at_pc c (w64 a))) 8 2) true)
      (exact (framed_push_ok_eq (+ d 5) w0 e0)))
    (have e1 (= (+ d 5) (+ (+ d 4) 1)) (arith))
    (have w2
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q2 c a) (+ d 4)
        (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil))))
      (exact (framed_push_eq (+ d 4) (reg c 5) w1 e1)))
    (have m1 (= (mapped (Cpu.segs (q1 c a)) (push_at (q1 c a)) 8 2) true)
      (exact (framed_push_ok_eq (+ d 4) w1 e1)))
    (have e2 (= (+ d 4) (+ (+ d 3) 1)) (arith))
    (have w3
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q3 c a) (+ d 3)
        (cons (reg c 12) (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil)))))
      (exact (framed_push_eq (+ d 3) (reg c 12) w2 e2)))
    (have m2 (= (mapped (Cpu.segs (q2 c a)) (push_at (q2 c a)) 8 2) true)
      (exact (framed_push_ok_eq (+ d 3) w2 e2)))
    (have e3 (= (+ d 3) (+ (+ d 2) 1)) (arith))
    (have w4
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q4 c a) (+ d 2)
        (cons (reg c 13) (cons (reg c 12) (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil))))))
      (exact (framed_push_eq (+ d 2) (reg c 13) w3 e3)))
    (have m3 (= (mapped (Cpu.segs (q3 c a)) (push_at (q3 c a)) 8 2) true)
      (exact (framed_push_ok_eq (+ d 2) w3 e3)))
    (have e4 (= (+ d 2) (+ (+ d 1) 1)) (arith))
    (have w5
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q5 c a) (+ d 1)
        (cons (reg c 14)
          (cons (reg c 13)
            (cons (reg c 12) (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil)))))))
      (exact (framed_push_eq (+ d 1) (reg c 14) w4 e4)))
    (have m4 (= (mapped (Cpu.segs (q4 c a)) (push_at (q4 c a)) 8 2) true)
      (exact (framed_push_ok_eq (+ d 1) w4 e4)))
    (have e5 (= (+ d 1) (+ d 1)) (arith))
    (have w6
      (framed c tbl clo chi f (+ d 6) (Cpu.mem c) (q6 c a) d
        (cons (reg c 15)
          (cons (reg c 14)
            (cons (reg c 13)
              (cons (reg c 12) (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil))))))))
      (exact (framed_push_eq d (reg c 15) w5 e5)))
    (have m5 (= (mapped (Cpu.segs (q5 c a)) (push_at (q5 c a)) 8 2) true)
      (exact (framed_push_ok_eq d w5 e5)))
    (have hr (reaches (at_pc c (w64 a)) (q6 c a))
      (apply (t_push tbl clo chi a 3 1) ((exact hall)) ((exact hchi)) ((exact (framed_code w0)))
        (rfl)
        ((exact (And.left hpl)))
        ((exact m0))
        ((apply (t_push tbl clo chi (+ a 1) 5 1) ((exact hall)) ((exact hchi))
           ((exact (framed_code w1)))
           (rfl)
           ((exact (And.left (And.right hpl))))
           ((exact m1))
           ((apply (t_push tbl clo chi (+ (+ a 1) 1) 12 2) ((exact hall)) ((exact hchi))
              ((exact (framed_code w2)))
              (rfl)
              ((exact (And.left (And.right (And.right hpl)))))
              ((exact m2))
              ((apply (t_push tbl clo chi (+ (+ (+ a 1) 1) 2) 13 2) ((exact hall)) ((exact hchi))
                 ((exact (framed_code w3)))
                 (rfl)
                 ((exact (And.left (And.right (And.right (And.right hpl))))))
                 ((exact m3))
                 ((apply (t_push tbl clo chi (+ (+ (+ (+ a 1) 1) 2) 2) 14 2) ((exact hall))
                    ((exact hchi))
                    ((exact (framed_code w4)))
                    (rfl)
                    ((exact (And.left (And.right (And.right (And.right (And.right hpl)))))))
                    ((exact m4))
                    ((apply (t_push tbl clo chi (+ (+ (+ (+ (+ a 1) 1) 2) 2) 2) 15 2) ((exact hall))
                       ((exact hchi))
                       ((exact (framed_code w5)))
                       (rfl)
                       ((exact
                          (And.left (And.right (And.right (And.right (And.right (And.right hpl))))))))
                       ((exact m5))
                       ((exact (reaches_refl (q6 c a))))))))))))))))
    (exact (And.intro hr w6))))

;; ---- the six locals set -------------------------------------------------------------------------
(theorem init_ok
  ((c Cpu implicit)
   (c2 Cpu implicit)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (pc Nat)
   (i Nat)
   (np Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc))))
  (-> (= (site tbl pc) (some (Prod.mk (init i np) (List.length (encode (init i np))))))
    (reaches
      (at_pc (set_reg c (kreg i) (ival i np c)) (w64 (+ pc (List.length (encode (init i np))))))
      c2)
    (reaches c c2))
  (by
    (cases (Nat.decLt i np)
      ((isTrue (h)
         (have e1 (= (init i np) (MovRmR (RmReg (kreg i)) (areg i)))
           (rw init.eq_1)
           (rw (if_pos h))
           rfl)
         (have e2 (= (ival i np c) (reg c (areg i))) (rw ival.eq_1) (rw (if_pos h)) rfl)
         (rw e1)
         (rw e2)
         (intro hs hr)
         (exact
           (t_mov tbl clo chi pc (kreg i) (areg i)
             (List.length (encode (MovRmR (RmReg (kreg i)) (areg i))))
             (reg c (areg i))
             hall
             hchi
             hcode
             hrip
             hs
             (Eq.refl (reg c (areg i)))
             hr)))
       (isFalse (h)
         (have e1 (= (init i np) (MovRI32 (kreg i) 0)) (rw init.eq_1) (rw (if_neg h)) rfl)
         (have e2 (= (ival i np c) (w64 0)) (rw ival.eq_1) (rw (if_neg h)) rfl)
         (rw e1)
         (rw e2)
         (intro hs hr)
         (exact
           (t_ri32 tbl clo chi pc (kreg i) 0 (List.length (encode (MovRI32 (kreg i) 0))) hall hchi
             hcode
             hrip
             hs
             hr)))))))
(fn ini ((c Cpu) (i Nat) (np Nat) (pc Nat)) Cpu
  (at_pc (set_reg c (kreg i) (ival i np c)) (w64 (+ pc (List.length (encode (init i np)))))))
(fn ib ((b Nat) (i Nat) (np Nat)) Nat (+ b (List.length (encode (init i np)))))
(fn b1 ((b Nat) (np Nat)) Nat (ib b 0 np))
(fn b2 ((b Nat) (np Nat)) Nat (ib (b1 b np) 1 np))
(fn b3 ((b Nat) (np Nat)) Nat (ib (b2 b np) 2 np))
(fn b4 ((b Nat) (np Nat)) Nat (ib (b3 b np) 3 np))
(fn b5 ((b Nat) (np Nat)) Nat (ib (b4 b np) 4 np))
(fn b6 ((b Nat) (np Nat)) Nat (ib (b5 b np) 5 np))
(fn r1 ((q Cpu) (np Nat) (b Nat)) Cpu (ini q 0 np b))
(fn r2 ((q Cpu) (np Nat) (b Nat)) Cpu (ini (r1 q np b) 1 np (b1 b np)))
(fn r3 ((q Cpu) (np Nat) (b Nat)) Cpu (ini (r2 q np b) 2 np (b2 b np)))
(fn r4 ((q Cpu) (np Nat) (b Nat)) Cpu (ini (r3 q np b) 3 np (b3 b np)))
(fn r5 ((q Cpu) (np Nat) (b Nat)) Cpu (ini (r4 q np b) 4 np (b4 b np)))
(fn r6 ((q Cpu) (np Nat) (b Nat)) Cpu (ini (r5 q np b) 5 np (b5 b np)))
;; from a state q at the first of them: each local's register set from its argument register,
;; or to zero
(theorem pro_init
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (q Cpu)
   (b Nat)
   (np Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in q tbl))
   (hrip (= (Cpu.rip q) (w64 b)))
   (hpl
     (placed tbl b
       (cons (init 0 np)
         (cons (init 1 np)
           (cons (init 2 np) (cons (init 3 np) (cons (init 4 np) (cons (init 5 np) nil)))))))))
  (reaches q (r6 q np b))
  (by
    (apply (init_ok tbl clo chi b 0 np) ((exact hall)) ((exact hchi)) ((exact hcode)) ((exact hrip))
      ((exact (And.left hpl)))
      ((apply (init_ok tbl clo chi (b1 b np) 1 np) ((exact hall)) ((exact hchi)) ((exact hcode))
         (rfl)
         ((exact (And.left (And.right hpl))))
         ((apply (init_ok tbl clo chi (b2 b np) 2 np) ((exact hall)) ((exact hchi)) ((exact hcode))
            (rfl)
            ((exact (And.left (And.right (And.right hpl)))))
            ((apply (init_ok tbl clo chi (b3 b np) 3 np) ((exact hall)) ((exact hchi))
               ((exact hcode))
               (rfl)
               ((exact (And.left (And.right (And.right (And.right hpl))))))
               ((apply (init_ok tbl clo chi (b4 b np) 4 np) ((exact hall)) ((exact hchi))
                  ((exact hcode))
                  (rfl)
                  ((exact (And.left (And.right (And.right (And.right (And.right hpl)))))))
                  ((apply (init_ok tbl clo chi (b5 b np) 5 np) ((exact hall)) ((exact hchi))
                     ((exact hcode))
                     (rfl)
                     ((exact
                        (And.left (And.right (And.right (And.right (And.right (And.right hpl))))))))
                     ((exact (reaches_refl (r6 q np b)))))))))))))))))

;; ---- out of a function --------------------------------------------------------------------------
(fn e1 ((c Cpu) (pc Nat)) Cpu (x_pop c 15 (w64 (+ pc 2))))
(fn e2 ((c Cpu) (pc Nat)) Cpu (x_pop (e1 c pc) 14 (w64 (+ (+ pc 2) 2))))
(fn e3 ((c Cpu) (pc Nat)) Cpu (x_pop (e2 c pc) 13 (w64 (+ (+ (+ pc 2) 2) 2))))
(fn e4 ((c Cpu) (pc Nat)) Cpu (x_pop (e3 c pc) 12 (w64 (+ (+ (+ (+ pc 2) 2) 2) 2))))
(fn e5 ((c Cpu) (pc Nat)) Cpu (x_pop (e4 c pc) 5 (w64 (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1))))
(fn e6 ((c Cpu) (pc Nat)) Cpu (x_pop (e5 c pc) 3 (w64 (+ (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1) 1))))
(fn eout ((c Cpu) (pc Nat)) Cpu (x_ret (e6 c pc)))
;; the six pops alone, whatever follows them: the state after them is described at the return
;; address, with the six registers the function's caller had
(theorem pops_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (d Nat)
   (m0 Mem)
   (c Cpu)
   (pc Nat)
   (rest (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hpl
     (placed tbl pc
       (cons (Pop 15)
         (cons (Pop 14) (cons (Pop 13) (cons (Pop 12) (cons (Pop 5) (cons (Pop 3) rest)))))))))
  (and (reaches c (e6 c pc))
    (and (framed c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ d 6) (cons (ret_addr c0) nil))
      (and (= (reg (e6 c pc) 3) (reg c0 3))
        (and (= (reg (e6 c pc) 5) (reg c0 5))
          (and (= (reg (e6 c pc) 12) (reg c0 12))
            (and (= (reg (e6 c pc) 13) (reg c0 13))
              (and (= (reg (e6 c pc) 14) (reg c0 14)) (= (reg (e6 c pc) 15) (reg c0 15)))))))))
  (by
    (have w0
      (framed c0 tbl clo chi f (+ d 6) m0 c d
        (cons (reg c0 15)
          (cons (reg c0 14)
            (cons (reg c0 13)
              (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil))))))))
      (exact w))
    (have w1
      (framed c0 tbl clo chi f (+ d 6) m0 (e1 c pc) (+ d 1)
        (cons (reg c0 14)
          (cons (reg c0 13)
            (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil)))))))
      (apply (framed_pop 15 (w64 (+ pc 2)) w0) (rfl)))
    (have w2
      (framed c0 tbl clo chi f (+ d 6) m0 (e2 c pc) (+ (+ d 1) 1)
        (cons (reg c0 13)
          (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil))))))
      (apply (framed_pop 14 (w64 (+ (+ pc 2) 2)) w1) (rfl)))
    (have w3
      (framed c0 tbl clo chi f (+ d 6) m0 (e3 c pc) (+ (+ (+ d 1) 1) 1)
        (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil)))))
      (apply (framed_pop 13 (w64 (+ (+ (+ pc 2) 2) 2)) w2) (rfl)))
    (have w4
      (framed c0 tbl clo chi f (+ d 6) m0 (e4 c pc) (+ (+ (+ (+ d 1) 1) 1) 1)
        (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil))))
      (apply (framed_pop 12 (w64 (+ (+ (+ (+ pc 2) 2) 2) 2)) w3) (rfl)))
    (have w5
      (framed c0 tbl clo chi f (+ d 6) m0 (e5 c pc) (+ (+ (+ (+ (+ d 1) 1) 1) 1) 1)
        (cons (reg c0 3) (cons (ret_addr c0) nil)))
      (apply (framed_pop 5 (w64 (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1)) w4) (rfl)))
    (have w6
      (framed c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ (+ (+ (+ (+ (+ d 1) 1) 1) 1) 1) 1)
        (cons (ret_addr c0) nil))
      (apply (framed_pop 3 (w64 (+ (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1) 1)) w5) (rfl)))
    (have ex (= (+ (+ (+ (+ (+ (+ d 1) 1) 1) 1) 1) 1) (+ d 6)) (arith))
    (have w7 (framed c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ d 6) (cons (ret_addr c0) nil))
      (exact
        (framed_idx c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ (+ (+ (+ (+ (+ d 1) 1) 1) 1) 1) 1)
          (cons (ret_addr c0) nil)
          (+ d 6)
          w6
          ex)))
    (have h15 (= (reg (e6 c pc) 15) (reg c0 15)) (exact (framed_top w0)))
    (have h14 (= (reg (e6 c pc) 14) (reg c0 14)) (exact (framed_top w1)))
    (have h13 (= (reg (e6 c pc) 13) (reg c0 13)) (exact (framed_top w2)))
    (have h12 (= (reg (e6 c pc) 12) (reg c0 12)) (exact (framed_top w3)))
    (have h5 (= (reg (e6 c pc) 5) (reg c0 5)) (exact (framed_top w4)))
    (have h3 (= (reg (e6 c pc) 3) (reg c0 3)) (exact (framed_top w5)))
    (have hr (reaches c (e6 c pc))
      (apply (t_pop tbl clo chi pc 15 2) ((exact hall)) ((exact hchi)) ((exact (framed_code w0)))
        ((exact hrip))
        ((exact (And.left hpl)))
        ((exact (framed_top_ok w0)))
        ((apply (t_pop tbl clo chi (+ pc 2) 14 2) ((exact hall)) ((exact hchi))
           ((exact (framed_code w1)))
           (rfl)
           ((exact (And.left (And.right hpl))))
           ((exact (framed_top_ok w1)))
           ((apply (t_pop tbl clo chi (+ (+ pc 2) 2) 13 2) ((exact hall)) ((exact hchi))
              ((exact (framed_code w2)))
              (rfl)
              ((exact (And.left (And.right (And.right hpl)))))
              ((exact (framed_top_ok w2)))
              ((apply (t_pop tbl clo chi (+ (+ (+ pc 2) 2) 2) 12 2) ((exact hall)) ((exact hchi))
                 ((exact (framed_code w3)))
                 (rfl)
                 ((exact (And.left (And.right (And.right (And.right hpl))))))
                 ((exact (framed_top_ok w3)))
                 ((apply (t_pop tbl clo chi (+ (+ (+ (+ pc 2) 2) 2) 2) 5 1) ((exact hall))
                    ((exact hchi))
                    ((exact (framed_code w4)))
                    (rfl)
                    ((exact (And.left (And.right (And.right (And.right (And.right hpl)))))))
                    ((exact (framed_top_ok w4)))
                    ((apply (t_pop tbl clo chi (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1) 3 1) ((exact hall))
                       ((exact hchi))
                       ((exact (framed_code w5)))
                       (rfl)
                       ((exact
                          (And.left (And.right (And.right (And.right (And.right (And.right hpl))))))))
                       ((exact (framed_top_ok w5)))
                       ((exact (reaches_refl (e6 c pc))))))))))))))))
    (exact
      (And.intro hr
        (And.intro w7
          (And.intro h3 (And.intro h5 (And.intro h12 (And.intro h13 (And.intro h14 h15))))))))))

;; the six pops and the return: the state after them has returned to the function's caller
(theorem ret_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (d Nat)
   (m0 Mem)
   (c Cpu)
   (pc Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hpl (placed tbl pc (pops (cons Ret nil)))))
  (and (reaches c (eout c pc)) (returned c0 (eout c pc)))
  (by
    (have gp
      (and (reaches c (e6 c pc))
        (and (framed c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ d 6) (cons (ret_addr c0) nil))
          (and (= (reg (e6 c pc) 3) (reg c0 3))
            (and (= (reg (e6 c pc) 5) (reg c0 5))
              (and (= (reg (e6 c pc) 12) (reg c0 12))
                (and (= (reg (e6 c pc) 13) (reg c0 13))
                  (and (= (reg (e6 c pc) 14) (reg c0 14)) (= (reg (e6 c pc) 15) (reg c0 15)))))))))
      (exact (pops_ok c0 tbl clo chi f d m0 c pc (cons Ret nil) hall hchi w hrip hpl)))
    (have w7 (framed c0 tbl clo chi f (+ d 6) m0 (e6 c pc) (+ d 6) (cons (ret_addr c0) nil))
      (exact (And.left (And.right gp))))
    (have sR
      (= (site tbl (+ (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1) 1))
        (some (Prod.mk Ret (List.length (encode Ret)))))
      (exact (And.left (And.right (And.right (And.right (And.right (And.right (And.right hpl)))))))))
    (have rr (reaches (e6 c pc) (eout c pc))
      (apply (t_ret tbl clo chi (+ (+ (+ (+ (+ (+ pc 2) 2) 2) 2) 1) 1) (List.length (encode Ret)))
        ((exact hall))
        ((exact hchi))
        ((exact (framed_code w7)))
        (rfl)
        ((exact sR))
        ((exact (framed_top_ok w7)))
        ((exact (reaches_refl (eout c pc))))))
    (exact
      (And.intro (reaches_trans c (e6 c pc) (eout c pc) (And.left gp) rr)
        (framed_returned w7 (And.left (And.right (And.right gp)))
          (And.left (And.right (And.right (And.right gp))))
          (And.left (And.right (And.right (And.right (And.right gp)))))
          (And.left (And.right (And.right (And.right (And.right (And.right gp))))))
          (And.left (And.right (And.right (And.right (And.right (And.right (And.right gp)))))))
          (And.right (And.right (And.right (And.right (And.right (And.right (And.right gp))))))))))))

;; ---- the frame's locals made ----------------------------------------------------------------------
;; the state after rax, which holds zero, is pushed
(fn zpush ((c Cpu) (pc Nat)) Cpu
  (at_pc (pushed c (reg c 0)) (w64 (+ pc (List.length (encode (Push 0)))))))
;; n zeros pushed from a state whose rax holds zero: the state after them is described n words
;; down, the zeros standing first, the six registers as they were
(theorem pushz_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (j Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (n Nat))
  (forall ((c Cpu) (pc Nat) (ws (List (BitVec 64))))
    (-> (framed c0 tbl clo chi f k m0 c (+ j n) ws) (< 0 (List.length ws)) (= (reg c 0) (w64 0))
      (= (Cpu.rip c) (w64 pc))
      (placed tbl pc (pushz n))
      (exists ((c2 Cpu))
        (and (reaches c c2)
          (and (= (Cpu.rip c2) (w64 (+ pc (isize (pushz n)))))
            (and (framed c0 tbl clo chi f k m0 c2 j (app (zeros n) ws)) (= (regs6 c2) (regs6 c))))))))
  (by
    (induction n
      ((zero () (intro c pc ws w hne hz hrip hpl)
         (have ep (= (pushz 0) (@List.nil Instr)) (rw (pushz.eq_1 0)) rfl)
         (have w2 (framed c0 tbl clo chi f k m0 c j ws) (exact w))
         (apply (Exists.intro c)
           ((apply And.intro ((exact (reaches_refl c)))
              ((apply And.intro
                 ((show (= (Cpu.rip c) (w64 (+ pc (isize (pushz 0)))))) (rw ep) (exact hrip))
                 ((apply And.intro
                    ((show (framed c0 tbl clo chi f k m0 c j (app (zeros 0) ws)))
                     (rw zeros_zero)
                     (exact w2))
                    (rfl)))))))))
       (succ (n1 ih) (intro c pc ws w hne hz hrip hpl)
         (have hn0 (Not (= (+ n1 1) 0)) (exact (Nat.succ_ne_zero n1)))
         (have ep (= (pushz (+ n1 1)) (cons (Push 0) (pushz n1)))
           (rw (pushz.eq_1 (+ n1 1)))
           (rw (if_neg hn0))
           rfl)
         (have hpl0 (placed tbl pc (pushz (+ n1 1))) (exact hpl))
         (have hpl2 (placed tbl pc (cons (Push 0) (pushz n1))) (rw (<- ep)) (exact hpl0))
         (have ej (= (+ j (+ n1 1)) (+ (+ j n1) 1)) (arith))
         (have w0 (framed c0 tbl clo chi f k m0 c (+ j (+ n1 1)) ws) (exact w))
         (have w1 (framed c0 tbl clo chi f k m0 (zpush c pc) (+ j n1) (cons (reg c 0) ws))
           (exact (framed_push_any (+ j n1) (reg c 0) w0 ej hne)))
         (have w1z (framed c0 tbl clo chi f k m0 (zpush c pc) (+ j n1) (cons (w64 0) ws))
           (rw (<- hz))
           (exact w1))
         (have m1 (= (mapped (Cpu.segs c) (push_at c) 8 2) true)
           (exact (framed_push_ok_any (+ j n1) w0 ej hne)))
         (have hz1 (= (reg (zpush c pc) 0) (w64 0)) (exact hz))
         (have hrip1 (= (Cpu.rip (zpush c pc)) (w64 (+ pc (List.length (encode (Push 0)))))) rfl)
         (have hne1 (< 0 (List.length (cons (w64 0) ws)))
           (exact (Nat.zero_lt_succ (List.length ws))))
         (have r1 (reaches c (zpush c pc))
           (apply (t_push tbl clo chi pc 0 (List.length (encode (Push 0)))) ((exact hall))
             ((exact hchi))
             ((exact (framed_code w0)))
             ((exact hrip))
             ((exact (And.left hpl2)))
             ((exact m1))
             ((exact (reaches_refl (zpush c pc))))))
         (cases
           (ih (zpush c pc) (+ pc (List.length (encode (Push 0)))) (cons (w64 0) ws) w1z hne1 hz1
             hrip1
             (And.right hpl2))
           ((intro (c2 g)
              (have erip
                (= (+ (+ pc (List.length (encode (Push 0)))) (isize (pushz n1)))
                  (+ pc (isize (pushz (+ n1 1)))))
                (rw ep)
                (show
                  (= (+ (+ pc (List.length (encode (Push 0)))) (isize (pushz n1)))
                    (+ pc (+ (List.length (encode (Push 0))) (isize (pushz n1))))))
                (arith))
              (have g2 (= (Cpu.rip c2) (w64 (+ pc (isize (pushz (+ n1 1))))))
                (rw (<- erip))
                (exact (And.left (And.right g))))
              (have g3 (framed c0 tbl clo chi f k m0 c2 j (app (zeros (+ n1 1)) ws))
                (rw (zeros_succ n1))
                (show (framed c0 tbl clo chi f k m0 c2 j (cons (w64 0) (app (zeros n1) ws))))
                (rw (<- (zeros_cons n1 ws)))
                (exact (And.left (And.right (And.right g)))))
              (have g4 (= (regs6 c2) (regs6 c)) (exact (And.right (And.right (And.right g)))))
              (apply (Exists.intro c2)
                ((apply And.intro ((exact (reaches_trans c (zpush c pc) c2 r1 (And.left g))))
                   ((apply And.intro ((exact g2)) ((apply And.intro ((exact g3)) ((exact g4)))))))))))))))))
;; the state after rax is set to zero
(fn zset ((c Cpu) (pc Nat)) Cpu
  (at_pc (set_reg c 0 (w64 0)) (w64 (+ pc (List.length (encode (MovRI32 0 0)))))))
;; The frame's locals of a function of nl made, from a state described where the stack pointer
;; stands that many words above j: the state after is described j words up, a zero for each
;; standing first, the six registers as they were.
(theorem slots_in_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (pc Nat)
   (j Nat)
   (ws (List (BitVec 64)))
   (nl Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (w (framed c0 tbl clo chi f k m0 c (+ j (nsl nl)) ws))
   (hne (< 0 (List.length ws)))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hpl (placed tbl pc (slots_in nl))))
  (exists ((c2 Cpu))
    (and (reaches c c2)
      (and (= (Cpu.rip c2) (w64 (+ pc (isize (slots_in nl)))))
        (and (framed c0 tbl clo chi f k m0 c2 j (app (zeros (nsl nl)) ws)) (= (regs6 c2) (regs6 c))))))
  (by
    (cases (Nat.decLe nl 6)
      ((isTrue (h)
         (have es (= (slots_in nl) (@List.nil Instr)) (rw slots_in.eq_1) (rw (if_pos h)) rfl)
         (have en (= (nsl nl) 0) (exact (Nat.sub_eq_zero_of_le h)))
         (have ej (= (+ j (nsl nl)) j) (rw en) rfl)
         (have w2 (framed c0 tbl clo chi f k m0 c j ws)
           (exact (framed_idx c0 tbl clo chi f k m0 c (+ j (nsl nl)) ws j w ej)))
         (apply (Exists.intro c)
           ((apply And.intro ((exact (reaches_refl c)))
              ((apply And.intro ((rw es) (exact hrip))
                 ((apply And.intro ((rw en) (rw zeros_zero) (exact w2)) (rfl)))))))))
       (isFalse (h)
         (have es (= (slots_in nl) (cons (MovRI32 0 0) (pushz (nsl nl))))
           (rw slots_in.eq_1)
           (rw (if_neg h))
           rfl)
         (have hpl2 (placed tbl pc (cons (MovRI32 0 0) (pushz (nsl nl)))) (rw (<- es)) (exact hpl))
         (have r0 (reaches c (zset c pc))
           (apply (t_ri32 tbl clo chi pc 0 0 (List.length (encode (MovRI32 0 0)))) ((exact hall))
             ((exact hchi))
             ((exact (framed_code w)))
             ((exact hrip))
             ((exact (And.left hpl2)))
             ((exact (reaches_refl (zset c pc))))))
         (have s1 (= (Cpu.segs (zset c pc)) (Cpu.segs c)) rfl)
         (have s2 (= (Cpu.mem (zset c pc)) (Cpu.mem c)) rfl)
         (have s3 (= (reg (zset c pc) 4) (reg c 4)) rfl)
         (have s4 (= (regs6 (zset c pc)) (regs6 c)) rfl)
         (have hsc (scratch c (zset c pc)) (exact (And.intro s1 (And.intro s2 (And.intro s3 s4)))))
         (have w0 (framed c0 tbl clo chi f k m0 (zset c pc) (+ j (nsl nl)) ws)
           (exact (framed_scratch c0 tbl clo chi f k m0 c (+ j (nsl nl)) ws (zset c pc) w hsc)))
         (have hz (= (reg (zset c pc) 0) (w64 0)) rfl)
         (have hrip0 (= (Cpu.rip (zset c pc)) (w64 (+ pc (List.length (encode (MovRI32 0 0))))))
           rfl)
         (cases
           (pushz_ok c0 tbl clo chi f k m0 j hall hchi (nsl nl) (zset c pc)
             (+ pc (List.length (encode (MovRI32 0 0))))
             ws
             w0
             hne
             hz
             hrip0
             (And.right hpl2))
           ((intro (c2 g)
              (have erip
                (= (+ (+ pc (List.length (encode (MovRI32 0 0)))) (isize (pushz (nsl nl))))
                  (+ pc (isize (slots_in nl))))
                (rw es)
                (show
                  (= (+ (+ pc (List.length (encode (MovRI32 0 0)))) (isize (pushz (nsl nl))))
                    (+ pc (+ (List.length (encode (MovRI32 0 0))) (isize (pushz (nsl nl)))))))
                (arith))
              (have g2 (= (Cpu.rip c2) (w64 (+ pc (isize (slots_in nl)))))
                (rw (<- erip))
                (exact (And.left (And.right g))))
              (apply (Exists.intro c2)
                ((apply And.intro ((exact (reaches_trans c (zset c pc) c2 r0 (And.left g))))
                   ((apply And.intro ((exact g2))
                      ((apply And.intro ((exact (And.left (And.right (And.right g)))))
                         ((exact (And.right (And.right (And.right g))))))))))))))))))))

;; ---- the frame's locals given back ----------------------------------------------------------------
;; the state after the stack pointer is raised over the frame's locals of a function of nl
(fn sdrop ((c Cpu) (nl Nat) (pc Nat)) Cpu
  (x_alu_ri c BAdd 4 (* 8 (nsl nl))
    (w64 (+ pc (List.length (encode (AluRmI BAdd (RmReg 4) (* 8 (nsl nl)))))))))
;; From a state described with the frame's locals sl standing first: the state after they are
;; given back is described past them, with rax, the argument registers and memory as they were.
(theorem slots_out_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (pc Nat)
   (j Nat)
   (sl (List (BitVec 64)))
   (ws (List (BitVec 64)))
   (nl Nat)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (w (framed c0 tbl clo chi f k m0 c j (app sl ws)))
   (hsl (= (List.length sl) (nsl nl)))
   (hne (< 0 (List.length ws)))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hpl (placed tbl pc (slots_out nl))))
  (exists ((c2 Cpu))
    (and (reaches c c2)
      (and (= (Cpu.rip c2) (w64 (+ pc (isize (slots_out nl)))))
        (and (framed c0 tbl clo chi f k m0 c2 (+ j (List.length sl)) ws)
          (and (= (reg c2 0) (reg c 0))
            (and (= (regs_of c2 arg_regs) (regs_of c arg_regs)) (= (Cpu.mem c2) (Cpu.mem c))))))))
  (by
    (cases (Nat.decLe nl 6)
      ((isTrue (h)
         (have es (= (slots_out nl) (@List.nil Instr)) (rw slots_out.eq_1) (rw (if_pos h)) rfl)
         (have en (= (nsl nl) 0) (exact (Nat.sub_eq_zero_of_le h)))
         (have h0 (= (List.length sl) 0) (rw hsl) (exact en))
         (have esl (= sl (@List.nil (BitVec 64))) (exact (List.eq_nil_of_length_eq_zero h0)))
         (have eapp (= (app sl ws) ws) (rw esl) rfl)
         (have w2 (framed c0 tbl clo chi f k m0 c j ws) (rw (<- eapp)) (exact w))
         (have ej (= j (+ j (List.length sl))) (rw h0) rfl)
         (have w3 (framed c0 tbl clo chi f k m0 c (+ j (List.length sl)) ws)
           (exact (framed_idx c0 tbl clo chi f k m0 c j ws (+ j (List.length sl)) w2 ej)))
         (apply (Exists.intro c)
           ((apply And.intro ((exact (reaches_refl c)))
              ((apply And.intro ((rw es) (exact hrip))
                 ((apply And.intro ((exact w3))
                    ((apply And.intro (rfl) ((apply And.intro (rfl) (rfl)))))))))))))
       (isFalse (h)
         (have es (= (slots_out nl) (cons (AluRmI BAdd (RmReg 4) (* 8 (nsl nl))) nil))
           (rw slots_out.eq_1)
           (rw (if_neg h))
           rfl)
         (have hpl2 (placed tbl pc (cons (AluRmI BAdd (RmReg 4) (* 8 (nsl nl))) nil))
           (rw (<- es))
           (exact hpl))
         (have hw (= (alu_writes BAdd) true) rfl)
         (have r0 (reaches c (sdrop c nl pc))
           (apply
             (t_alu_i tbl clo chi pc BAdd 4 (* 8 (nsl nl))
               (List.length (encode (AluRmI BAdd (RmReg 4) (* 8 (nsl nl))))))
             ((exact hall))
             ((exact hchi))
             ((exact (framed_code w)))
             ((exact hrip))
             ((exact (And.left hpl2)))
             ((exact hw))
             ((exact (reaches_refl (sdrop c nl pc))))))
         (have s1 (= (Cpu.segs (sdrop c nl pc)) (Cpu.segs c)) rfl)
         (have s2 (= (Cpu.mem (sdrop c nl pc)) (Cpu.mem c)) rfl)
         (have s3 (= (reg (sdrop c nl pc) 4) (w64_add (reg c 4) (w64 (* 8 (List.length sl)))))
           (rw hsl)
           rfl)
         (have hh0 (holds (Cpu.mem c) (+ f (* 8 j)) (app sl ws)) (exact (framed_holds w)))
         (have ea (= (+ (+ f (* 8 j)) (* 8 (List.length sl))) (+ f (* 8 (+ j (List.length sl)))))
           (arith))
         (have hh (holds (Cpu.mem c) (+ f (* 8 (+ j (List.length sl)))) ws)
           (rw (<- ea))
           (exact (And.right (holds_app (Cpu.mem c) ws sl (+ f (* 8 j)) hh0))))
         (have hl0 (= (+ j (List.length (app sl ws))) (+ k 1)) (exact (framed_len w)))
         (have hl (= (+ (+ j (List.length sl)) (List.length ws)) (+ k 1))
           (arith hl0 (app_length sl ws)))
         (have w3 (framed c0 tbl clo chi f k m0 (sdrop c nl pc) (+ j (List.length sl)) ws)
           (exact (framed_raise (List.length sl) ws (sdrop c nl pc) w s1 s2 s3 hh hl hne)))
         (have erip
           (= (w64 (+ pc (List.length (encode (AluRmI BAdd (RmReg 4) (* 8 (nsl nl)))))))
             (w64 (+ pc (isize (slots_out nl)))))
           (rw es)
           rfl)
         (have g2 (= (Cpu.rip (sdrop c nl pc)) (w64 (+ pc (isize (slots_out nl))))) (exact erip))
         (apply (Exists.intro (sdrop c nl pc))
           ((apply And.intro ((exact r0))
              ((apply And.intro ((exact g2))
                 ((apply And.intro ((exact w3))
                    ((apply And.intro (rfl) ((apply And.intro (rfl) (rfl)))))))))))))))))

;; ---- out of a function of nl locals ---------------------------------------------------------------
;; From a state described as a statement finds it — the frame's locals standing first, then the
;; six registers pushed and the return address —, at the first instruction of the way out: the
;; state after it has returned to the function's caller, with rax and memory as they were.
(theorem epi_ok
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (d Nat)
   (m0 Mem)
   (c Cpu)
   (pc Nat)
   (nl Nat)
   (j Nat)
   (sl (List (BitVec 64)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0))))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hpl (placed tbl pc (epi nl))))
  (exists ((c2 Cpu))
    (and (reaches c c2)
      (and (returned c0 c2) (and (= (reg c2 0) (reg c 0)) (= (Cpu.mem c2) (Cpu.mem c))))))
  (by
    (have p1 (placed tbl pc (slots_out nl))
      (exact (And.left (placed_app tbl (slots_out nl) pc (pops (cons Ret nil)) hpl))))
    (have p2 (placed tbl (+ pc (isize (slots_out nl))) (pops (cons Ret nil)))
      (exact (And.right (placed_app tbl (slots_out nl) pc (pops (cons Ret nil)) hpl))))
    (have hne (< 0 (List.length (saved c0))) (exact (Nat.zero_lt_succ 6)))
    (cases
      (slots_out_ok c0 tbl clo chi f (+ d 6) m0 c pc j sl (saved c0) nl hall hchi w hsl hne hrip p1)
      ((intro (c1 g) (have r1 (reaches c c1) (exact (And.left g)))
         (have hrip1 (= (Cpu.rip c1) (w64 (+ pc (isize (slots_out nl)))))
           (exact (And.left (And.right g))))
         (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0))
           (exact
             (framed_idx c0 tbl clo chi f (+ d 6) m0 c1 (+ j (List.length sl)) (saved c0) d
               (And.left (And.right (And.right g)))
               hj)))
         (have hv1 (= (reg c1 0) (reg c 0))
           (exact (And.left (And.right (And.right (And.right g))))))
         (have hm1 (= (Cpu.mem c1) (Cpu.mem c))
           (exact (And.right (And.right (And.right (And.right (And.right g)))))))
         (have gr
           (and (reaches c1 (eout c1 (+ pc (isize (slots_out nl)))))
             (returned c0 (eout c1 (+ pc (isize (slots_out nl))))))
           (exact
             (ret_ok c0 tbl clo chi f d m0 c1 (+ pc (isize (slots_out nl))) hall hchi w1 hrip1 p2)))
         (have hv2 (= (reg (eout c1 (+ pc (isize (slots_out nl)))) 0) (reg c 0))
           (show (= (reg c1 0) (reg c 0)))
           (exact hv1))
         (have hm2 (= (Cpu.mem (eout c1 (+ pc (isize (slots_out nl))))) (Cpu.mem c))
           (show (= (Cpu.mem c1) (Cpu.mem c)))
           (exact hm1))
         (apply (Exists.intro (eout c1 (+ pc (isize (slots_out nl)))))
           ((apply And.intro
              ((exact (reaches_trans c c1 (eout c1 (+ pc (isize (slots_out nl)))) r1 (And.left gr))))
              ((apply And.intro ((exact (And.right gr)))
                 ((apply And.intro ((exact hv2)) ((exact hm2))))))))))))))
