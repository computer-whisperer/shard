;; after the callee's return: the result into its local, and the rest of the statement
(theorem call_out
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (o Os)
   (out Outcome)
   (c1 Cpu)
   (c6 Cpu)
   (a Nat)
   (ca (List Instr))
   (ck (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (j Nat)
   (sl (List (BitVec 64)))
   (v1 (BitVec 64))
   (m1 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p wx rs tbl clo chi xs fs ts n1))
   (hrk (= (wrun n1 p wx rs k (upd ls x v1) m1 o) (some out)))
   (hx (< x nl))
   (hck
     (= (cstm xs fs ts p nl (+ a (+ (isize ca) (+ 5 (List.length (encode (st_loc x)))))) k)
       (some ck)))
   (sM
     (= (site tbl (+ (+ a (isize ca)) 5))
       (some (Prod.mk (st_loc x) (List.length (encode (st_loc x)))))))
   (p3 (placed tbl (+ (+ (+ a (isize ca)) 5) (List.length (encode (st_loc x)))) ck))
   (hsn (<= (sneed xs fs ts p nl k) j))
   (hd (= (+ (- j 1) 1) j))
   (hls1 (= ls (app (List.take nl (regs6 c1)) sl)))
   (hrip6 (= (Cpu.rip c6) (w64 (+ (+ a (isize ca)) 5))))
   (hv6 (= (reg c6 0) v1))
   (kp6 (kept (pushed c1 (w64 (+ (+ a (isize ca)) 5))) c6))
   (w6 (framed c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 (+ (- j 1) 1) (app sl (saved c0))))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag6 (agree rs m1 (Cpu.mem c6)))
   (hkm6 (kept_mem rs f (+ d 6) (Cpu.mem c0) (Cpu.mem c6)))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 c6 o out)
  (by
    (have w6b (framed c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 j (app sl (saved c0)))
      (exact
        (framed_idx c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 (+ (- j 1) 1) (app sl (saved c0)) j w6
          hd)))
    (have e6 (= (regs6 c6) (regs6 c1))
      (rw (kept_regs6 (pushed c1 (w64 (+ (+ a (isize ca)) 5))) c6 kp6))
      rfl)
    (have hls6 (= ls (app (List.take nl (regs6 c6)) sl)) (rw e6) (exact hls1))
    (have ea8
      (= (+ (+ (+ a (isize ca)) 5) (List.length (encode (st_loc x))))
        (+ a (+ (isize ca) (+ 5 (List.length (encode (st_loc x)))))))
      (arith))
    (exact
      (store_k p wx rs tbl clo chi xs fs ts n1 x k ls m1 o out c6 (+ (+ a (isize ca)) 5)
        (+ a (+ (isize ca) (+ 5 (List.length (encode (st_loc x))))))
        ck
        c0
        f
        d
        nl
        (Cpu.mem c6)
        j
        sl
        v1
        hall
        hchi
        ih
        hrk
        hx
        hck
        sM
        p3
        ea8
        hsn
        hrip6
        hv6
        w6b
        hls6
        hsl
        hj
        hag6
        hkm6
        hdo))))
;; the machine's part of a call: the arguments, the law of a call, the way on
(theorem call_core
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (c Cpu)
   (a Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (j Nat)
   (sl (List (BitVec 64)))
   (vs (List (BitVec 64)))
   (q Outcome)
   (ea Nat)
   (kc Nat)
   (ca (List Instr))
   (ck (List Instr))
   (A (-> (List (BitVec 64)) Mem Os Outcome Prop))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p wx rs tbl clo chi xs fs ts n1))
   (hreal (wrealizes tbl clo chi ea kc rs A))
   (hans (A vs mi o q))
   (hvs (= (ievals rs ls mi es) (some vs)))
   (hrk (= (wnext n1 p wx rs x k ls q) (some out)))
   (hx (< x nl))
   (hca (= (cargs es 0 nl) (some ca)))
   (hck
     (= (cstm xs fs ts p nl (+ a (+ (isize ca) (+ 5 (List.length (encode (st_loc x)))))) k)
       (some ck)))
   (hpl
     (placed tbl a
       (List.append ca (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (st_loc x) ck)))))
   (hkc (<= (+ kc 1) j))
   (hsn (<= (sneed xs fs ts p nl k) j))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0))))
   (hls (= ls (app (List.take nl (regs6 c)) sl)))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 c o out)
  (by
    (have p1 (placed tbl a ca)
      (exact
        (And.left
          (placed_app tbl ca a (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (st_loc x) ck))
            hpl))))
    (have p2
      (placed tbl (+ a (isize ca))
        (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (st_loc x) ck)))
      (exact
        (And.right
          (placed_app tbl ca a (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (st_loc x) ck))
            hpl))))
    (have sC
      (= (site tbl (+ a (isize ca))) (some (Prod.mk (Call (rel ea (+ a (+ (isize ca) 5)))) 5)))
      (exact (And.left p2)))
    (have sM
      (= (site tbl (+ (+ a (isize ca)) 5))
        (some (Prod.mk (st_loc x) (List.length (encode (st_loc x))))))
      (exact (And.left (And.right p2))))
    (have p3 (placed tbl (+ (+ (+ a (isize ca)) 5) (List.length (encode (st_loc x)))) ck)
      (exact (And.right (And.right p2))))
    (have hlt (< (+ (+ a (isize ca)) 5) 18446744073709551616)
      (exact
        (site_lt tbl clo chi (+ (+ a (isize ca)) 5)
          (Prod.mk (st_loc x) (List.length (encode (st_loc x))))
          hall
          hchi
          sM)))
    (have ex (= (+ (+ a (isize ca)) 5) (+ a (+ (isize ca) 5))) (arith))
    (have hlt2 (< (+ a (+ (isize ca) 5)) 18446744073709551616) (arith hlt))
    (have htgt
      (= (w64_add (w64 (+ (+ a (isize ca)) 5)) (w64 (rel ea (+ a (+ (isize ca) 5))))) (w64 ea))
      (rw ex)
      (exact (rel_ok (+ a (+ (isize ca) 5)) ea hlt2)))
    (have h06 (<= 0 6) (decide))
    (have hpre0 (= (regs_of c (List.take 0 arg_regs)) (@List.nil (BitVec 64))) rfl)
    (have hlc (locs c nl ls)
      (exact (locs_framed c0 tbl clo chi f (+ d 6) m0 c j (saved c0) nl ls sl w hls hsl)))
    (cases
      (cargs_ok tbl clo chi rs ls mi nl hall hchi es 0 c a ca vs nil hca hvs p1 (framed_code w) hrip
        hlc
        h06
        hpre0)
      ((intro (c1 g1) (have r1 (reaches c c1) (exact (And.left g1)))
         (have hrip1 (= (Cpu.rip c1) (w64 (+ a (isize ca)))) (exact (And.left (And.right g1))))
         (have hsc (scratch c c1) (exact (And.left (And.right (And.right g1)))))
         (have hlen (<= (+ 0 (List.length vs)) 6)
           (exact (And.left (And.right (And.right (And.right g1))))))
         (have hreg1 (= (regs_of c1 (List.take (+ 0 (List.length vs)) arg_regs)) (app nil vs))
           (exact (And.right (And.right (And.right (And.right g1))))))
         (have e0 (= (+ 0 (List.length vs)) (List.length vs))
           (exact (Nat.zero_add (List.length vs))))
         (have hx1 (= vs (regs_of c1 (List.take (List.length vs) arg_regs)))
           (rw (<- e0))
           (rw hreg1)
           rfl)
         (have hl6 (<= (List.length vs) 6) (arith hlen))
         (have hargs1 (args_in c1 vs) (exact (And.intro hl6 hx1)))
         (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 j (app sl (saved c0)))
           (exact (framed_scratch c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0)) c1 w hsc)))
         (have h1d (<= 1 j) (arith hkc))
         (have hd (= (+ (- j 1) 1) j) (exact (Nat.sub_add_cancel h1d)))
         (have hkc2 (<= kc (- j 1)) (arith hkc hd))
         (have hls1 (= ls (app (List.take nl (regs6 c1)) sl))
           (rw (scratch_regs c c1 hsc))
           (exact hls))
         (have hne (< 0 (List.length (saved c0))) (exact (Nat.zero_lt_succ 6)))
         (cases (app_ne sl (saved c0) hne)
           ((intro (w5 gw)
              (cases gw
                ((intro (ws5 e5)
                   (have wfr (framed c0 tbl clo chi f (+ d 6) m0 c1 (+ (- j 1) 1) (cons w5 ws5))
                     (rw (<- e5))
                     (exact
                       (framed_idx c0 tbl clo chi f (+ d 6) m0 c1 j (app sl (saved c0))
                         (+ (- j 1) 1)
                         w1
                         (Eq.symm hd))))
                   (have hcl
                     (called c0 tbl clo chi f (+ d 6) c1 (- j 1) w5 ws5 rs (+ a (isize ca)) 5 o q)
                     (exact
                       (call_law c0 tbl clo chi f (+ d 6) m0 c1 (- j 1) w5 ws5 rs mi vs o q ea kc A
                         (+ a (isize ca))
                         (rel ea (+ a (+ (isize ca) 5)))
                         5
                         hall
                         hchi
                         wfr
                         hdo
                         hag
                         hkm
                         hreal
                         hans
                         hargs1
                         hkc2
                         hrip1
                         sC
                         htgt)))
                   (have fin
                     (->
                       (called c0 tbl clo chi f (+ d 6) c1 (- j 1) w5 ws5 rs (+ a (isize ca)) 5 o q)
                       (-> (= (wnext n1 p wx rs x k ls q) (some out))
                         (arrives rs f (+ d 6) c0 c o out)))
                     (cases q
                       ((ORet (v1 m1 o1)
                          (show
                            (->
                              (call_ret c0 tbl clo chi f (+ d 6) c1 (- j 1) w5 ws5 rs
                                (+ a (isize ca))
                                5
                                o
                                v1
                                m1
                                o1)
                              (-> (= (wrun n1 p wx rs k (upd ls x v1) m1 o1) (some out))
                                (arrives rs f (+ d 6) c0 c o out))))
                          (intro gg hrk1)
                          (cases gg
                            ((intro (c6 g6)
                               (have w6
                                 (framed c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 (+ (- j 1) 1)
                                   (app sl (saved c0)))
                                 (rw e5)
                                 (exact
                                   (And.left (And.right (And.right (And.right (And.right g6)))))))
                               (exact
                                 (arrives_comes rs f (+ d 6) c0 c o c6 o1 out
                                   (comes_trans c o c1 o c6 o1 (comes_of_reaches c c1 o r1)
                                     (And.left g6))
                                   (call_out p wx rs tbl clo chi xs fs ts n1 x k ls o1 out c1 c6 a
                                     ca
                                     ck
                                     c0
                                     f
                                     d
                                     nl
                                     j
                                     sl
                                     v1
                                     m1
                                     hall
                                     hchi
                                     ih
                                     hrk1
                                     hx
                                     hck
                                     sM
                                     p3
                                     hsn
                                     hd
                                     hls1
                                     (And.left (And.right g6))
                                     (And.left (And.right (And.right g6)))
                                     (And.left (And.right (And.right (And.right g6))))
                                     w6
                                     hsl
                                     hj
                                     (And.left
                                       (And.right (And.right (And.right (And.right (And.right g6))))))
                                     (And.right
                                       (And.right (And.right (And.right (And.right (And.right g6))))))
                                     hdo)))))))
                        (OEnd (r)
                          (show
                            (-> (ends_at c1 o r)
                              (-> (= (some (OEnd r)) (some out)) (arrives rs f (+ d 6) c0 c o out))))
                          (intro gg he)
                          (rw (<- (Option.some.inj he)))
                          (show (ends_at c o r))
                          (exact (ends_of_comes c o c1 o r (comes_of_reaches c c1 o r1) gg))))))
                   (exact (fin hcl hrk)))))))))))))
;; ---- a call -------------------------------------------------------------------------------------
(theorem sim_call
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (j Nat)
   (sl (List (BitVec 64)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (henv (env_ok p wx rs tbl clo chi xs fs))
   (ih (sim p wx rs tbl clo chi xs fs ts n1))
   (hrun (= (wrun (FS n1) p wx rs (SCall x cal es k) ls mi o) (some out)))
   (hcs (= (cstm xs fs ts p nl a (SCall x cal es k)) (some code)))
   (hpl (placed tbl a code))
   (hsn (<= (sneed xs fs ts p nl (SCall x cal es k)) j))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0))))
   (hls (= ls (app (List.take nl (regs6 c)) sl)))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 c o out)
  (by
    (have hx (< x nl) (exact (And.left (cstm_call_inv xs fs ts p nl a x cal es k code hcs))))
    (cases (wrun_call_inv p wx rs n1 x cal es k ls mi o out hrun)
      ((intro (vs g0) (have hvs (= (ievals rs ls mi es) (some vs)) (exact (And.left g0)))
         (cases (And.right g0)
           ((intro (q g1)
              (have hq (= (wcal_run n1 p wx rs cal vs mi o) (some q)) (exact (And.left g1)))
              (have hrk (= (wnext n1 p wx rs x k ls q) (some out)) (exact (And.right g1)))
              (cases (And.right (cstm_call_inv xs fs ts p nl a x cal es k code hcs))
                ((intro (en g2)
                   (cases en
                     ((mk (ea kc)
                        (have hcal
                          (= (callee_at xs fs p cal (List.length es)) (some (Prod.mk ea kc)))
                          (exact (And.left g2)))
                        (cases (And.right g2)
                          ((intro (ca g3)
                             (have hca (= (cargs es 0 nl) (some ca)) (exact (And.left g3)))
                             (cases (And.right g3)
                               ((intro (ck g4)
                                  (have hck
                                    (=
                                      (cstm xs fs ts p nl
                                        (+ a (+ (isize ca) (+ 5 (List.length (encode (st_loc x))))))
                                        k)
                                      (some ck))
                                    (exact (And.left g4)))
                                  (have hcd
                                    (= code
                                      (List.append ca
                                        (cons (Call (rel ea (+ a (+ (isize ca) 5))))
                                          (cons (st_loc x) ck))))
                                    (exact (And.right g4)))
                                  (have hpl2
                                    (placed tbl a
                                      (List.append ca
                                        (cons (Call (rel ea (+ a (+ (isize ca) 5))))
                                          (cons (st_loc x) ck))))
                                    (rw (<- hcd))
                                    (exact hpl))
                                  (have hlen (= (List.length vs) (List.length es))
                                    (exact (ievals_len rs ls mi es vs hvs)))
                                  (have hans (cal_ans p wx rs cal (List.length es) vs mi o q)
                                    (show
                                      (and (= (List.length vs) (List.length es))
                                        (exists ((n0 Fuel))
                                          (= (wcal_run n0 p wx rs cal vs mi o) (some q)))))
                                    (apply And.intro ((exact hlen))
                                      ((apply (Exists.intro n1) ((exact hq))))))
                                  (have hreal
                                    (wrealizes tbl clo chi ea kc rs
                                      (cal_ans p wx rs cal (List.length es)))
                                    (exact (henv cal (List.length es) (Prod.mk ea kc) hcal)))
                                  (have hkc (<= (+ kc 1) j)
                                    (exact
                                      (And.left
                                        (sneed_call xs fs ts p nl x cal es k (Prod.mk ea kc) j hcal
                                          hsn))))
                                  (have hsn2 (<= (sneed xs fs ts p nl k) j)
                                    (exact
                                      (And.right
                                        (sneed_call xs fs ts p nl x cal es k (Prod.mk ea kc) j hcal
                                          hsn))))
                                  (exact
                                    (call_core p wx rs tbl clo chi xs fs ts n1 x es k ls mi o out c
                                      a
                                      c0
                                      f
                                      d
                                      nl
                                      m0
                                      j
                                      sl
                                      vs
                                      q
                                      ea
                                      kc
                                      ca
                                      ck
                                      (cal_ans p wx rs cal (List.length es))
                                      hall
                                      hchi
                                      ih
                                      hreal
                                      hans
                                      hvs
                                      hrk
                                      hx
                                      hca
                                      hck
                                      hpl2
                                      hkc
                                      hsn2
                                      hrip
                                      w
                                      hls
                                      hsl
                                      hj
                                      hag
                                      hkm
                                      hdo))))))))))))))))))))))
