;; rax into a local's register, then the rest of the statement by the fact for the fuel below
(theorem store_k
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c1 Cpu)
   (pc Nat)
   (a2 Nat)
   (ck (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (w0 (BitVec 64))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hrk (= (irun n1 p ext rs k (upd ls x w0) mi) (some (Prod.mk v m2))))
   (hx (< x nl))
   (hck (= (cstm xs fs ts p nl a2 k) (some ck)))
   (hs (= (site tbl pc) (some (Prod.mk (MovRmR (RmReg (kreg x)) 0) 3))))
   (hp (placed tbl (+ pc 3) ck))
   (ea (= (+ pc 3) a2))
   (hsn (<= (sneed xs fs ts p k) d))
   (hrip (= (Cpu.rip c1) (w64 pc)))
   (hv (= (reg c1 0) w0))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0)))
   (hls (= ls (List.take nl (regs6 c1))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c1 v m2)
  (by
    (have hx6 (< x 6) (arith))
    (have r7 (reaches c1 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))))
      (apply (t_mov tbl clo chi pc (kreg x) 0 3 w0) ((exact hall)) ((exact hchi))
        ((exact (framed_code w)))
        ((exact hrip))
        ((exact hs))
        ((exact hv))
        ((exact (reaches_refl (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))))))))
    (have w7
      (framed c0 tbl clo chi f (+ d 6) m0 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))) d
        (saved c0))
      (exact (framed_kset c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0) x w0 (w64 (+ pc 3)) hx6 w)))
    (have hls7
      (= (upd ls x w0) (List.take nl (regs6 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))))))
      (rw (kset_regs c1 x w0 (w64 (+ pc 3)) hx6))
      (rw (take_upd (regs6 c1) nl x w0))
      (rw (<- hls))
      rfl)
    (have hrip7 (= (Cpu.rip (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3)))) (w64 a2))
      (rw (<- ea))
      rfl)
    (have p3 (placed tbl a2 ck) (rw (<- ea)) (exact hp))
    (exact
      (done_from rs f (+ d 6) c0 c1 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))) v m2 r7
        (ih k (upd ls x w0) mi v m2 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ pc 3))) a2 ck c0 f d nl
          m0
          hrk
          hck
          p3
          hsn
          hrip7
          w7
          hls7
          hnl
          hag
          hkm
          hdo)))))
;; after the callee's return: the result into its local, and the rest of the statement
(theorem call_out
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (v (BitVec 64))
   (m2 Mem)
   (c1 Cpu)
   (c6 Cpu)
   (a Nat)
   (ca (List Instr))
   (ck (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (v1 (BitVec 64))
   (m1 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hrk (= (irun n1 p ext rs k (upd ls x v1) m1) (some (Prod.mk v m2))))
   (hx (< x nl))
   (hck (= (cstm xs fs ts p nl (+ a (+ (isize ca) 8)) k) (some ck)))
   (sM (= (site tbl (+ (+ a (isize ca)) 5)) (some (Prod.mk (MovRmR (RmReg (kreg x)) 0) 3))))
   (p3 (placed tbl (+ (+ (+ a (isize ca)) 5) 3) ck))
   (hsn (<= (sneed xs fs ts p k) d))
   (hd (= (+ (- d 1) 1) d))
   (hls1 (= ls (List.take nl (regs6 c1))))
   (hrip6 (= (Cpu.rip c6) (w64 (+ (+ a (isize ca)) 5))))
   (hv6 (= (reg c6 0) v1))
   (kp6 (kept (pushed c1 (w64 (+ (+ a (isize ca)) 5))) c6))
   (w6
     (framed c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 (+ (- d 1) 1)
       (cons (reg c0 15)
         (cons (reg c0 14)
           (cons (reg c0 13)
             (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil)))))))))
   (hnl (<= nl 6))
   (hag6 (agree rs m1 (Cpu.mem c6)))
   (hkm6 (kept_mem rs f (+ d 6) (Cpu.mem c0) (Cpu.mem c6)))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c6 v m2)
  (by
    (have w6b (framed c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 d (saved c0))
      (exact
        (framed_idx c0 tbl clo chi f (+ d 6) (Cpu.mem c6) c6 (+ (- d 1) 1)
          (cons (reg c0 15)
            (cons (reg c0 14)
              (cons (reg c0 13)
                (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil)))))))
          d
          w6
          hd)))
    (have e6 (= (regs6 c6) (regs6 c1))
      (rw (kept_regs6 (pushed c1 (w64 (+ (+ a (isize ca)) 5))) c6 kp6))
      rfl)
    (have hls6 (= ls (List.take nl (regs6 c6))) (rw e6) (exact hls1))
    (have ea8 (= (+ (+ (+ a (isize ca)) 5) 3) (+ a (+ (isize ca) 8))) (arith))
    (exact
      (store_k p ext rs tbl clo chi xs fs ts n1 x k ls m1 v m2 c6 (+ (+ a (isize ca)) 5)
        (+ a (+ (isize ca) 8))
        ck
        c0
        f
        d
        nl
        (Cpu.mem c6)
        v1
        hall
        hchi
        ih
        hrk
        hx
        hck
        sM
        p3
        ea8
        hsn
        hrip6
        hv6
        w6b
        hls6
        hnl
        hag6
        hkm6
        hdo))))
;; the machine's part of a call: the arguments, the law of a call, the way on
(theorem call_core
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (vs (List (BitVec 64)))
   (v1 (BitVec 64))
   (m1 Mem)
   (ea Nat)
   (kc Nat)
   (ca (List Instr))
   (ck (List Instr))
   (A (-> (List (BitVec 64)) Mem (BitVec 64) Mem Prop))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hreal (realizes tbl clo chi ea kc rs A))
   (hans (A vs mi v1 m1))
   (hvs (= (ievals rs ls mi es) (some vs)))
   (hrk (= (irun n1 p ext rs k (upd ls x v1) m1) (some (Prod.mk v m2))))
   (hx (< x nl))
   (hca (= (cargs es 0 nl) (some ca)))
   (hck (= (cstm xs fs ts p nl (+ a (+ (isize ca) 8)) k) (some ck)))
   (hpl
     (placed tbl a
       (List.append ca
         (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (MovRmR (RmReg (kreg x)) 0) ck)))))
   (hkc (<= (+ kc 1) d))
   (hsn (<= (sneed xs fs ts p k) d))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have p1 (placed tbl a ca)
      (exact
        (And.left
          (placed_app tbl ca a
            (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (MovRmR (RmReg (kreg x)) 0) ck))
            hpl))))
    (have p2
      (placed tbl (+ a (isize ca))
        (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (MovRmR (RmReg (kreg x)) 0) ck)))
      (exact
        (And.right
          (placed_app tbl ca a
            (cons (Call (rel ea (+ a (+ (isize ca) 5)))) (cons (MovRmR (RmReg (kreg x)) 0) ck))
            hpl))))
    (have sC
      (= (site tbl (+ a (isize ca))) (some (Prod.mk (Call (rel ea (+ a (+ (isize ca) 5)))) 5)))
      (exact (And.left p2)))
    (have sM (= (site tbl (+ (+ a (isize ca)) 5)) (some (Prod.mk (MovRmR (RmReg (kreg x)) 0) 3)))
      (exact (And.left (And.right p2))))
    (have p3 (placed tbl (+ (+ (+ a (isize ca)) 5) 3) ck) (exact (And.right (And.right p2))))
    (have hlt (< (+ (+ a (isize ca)) 5) 18446744073709551616)
      (exact
        (site_lt tbl clo chi (+ (+ a (isize ca)) 5) (Prod.mk (MovRmR (RmReg (kreg x)) 0) 3) hall
          hchi
          sM)))
    (have ex (= (+ (+ a (isize ca)) 5) (+ a (+ (isize ca) 5))) (arith))
    (have hlt2 (< (+ a (+ (isize ca) 5)) 18446744073709551616) (arith hlt))
    (have htgt
      (= (w64_add (w64 (+ (+ a (isize ca)) 5)) (w64 (rel ea (+ a (+ (isize ca) 5))))) (w64 ea))
      (rw ex)
      (exact (rel_ok (+ a (+ (isize ca) 5)) ea hlt2)))
    (have h06 (<= 0 6) (decide))
    (have hpre0 (= (regs_of c (List.take 0 arg_regs)) (@List.nil (BitVec 64))) rfl)
    (cases
      (cargs_ok tbl clo chi rs ls mi nl hall hchi hnl es 0 c a ca vs nil hca hvs p1 (framed_code w)
        hrip
        hls
        h06
        hpre0)
      ((intro (c1 g1) (have r1 (reaches c c1) (exact (And.left g1)))
         (have hrip1 (= (Cpu.rip c1) (w64 (+ a (isize ca)))) (exact (And.left (And.right g1))))
         (have hsc (scratch c c1) (exact (And.left (And.right (And.right g1)))))
         (have hlen (<= (+ 0 (List.length vs)) 6)
           (exact (And.left (And.right (And.right (And.right g1))))))
         (have hreg1 (= (regs_of c1 (List.take (+ 0 (List.length vs)) arg_regs)) (app nil vs))
           (exact (And.right (And.right (And.right (And.right g1))))))
         (have e0 (= (+ 0 (List.length vs)) (List.length vs))
           (exact (Nat.zero_add (List.length vs))))
         (have hx1 (= vs (regs_of c1 (List.take (List.length vs) arg_regs)))
           (rw (<- e0))
           (rw hreg1)
           rfl)
         (have hl6 (<= (List.length vs) 6) (arith hlen))
         (have hargs1 (args_in c1 vs) (exact (And.intro hl6 hx1)))
         (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0))
           (exact (framed_scratch c0 tbl clo chi f (+ d 6) m0 c d (saved c0) c1 w hsc)))
         (have h1d (<= 1 d) (arith hkc))
         (have hd (= (+ (- d 1) 1) d) (exact (Nat.sub_add_cancel h1d)))
         (have wx
           (framed c0 tbl clo chi f (+ d 6) m0 c1 (+ (- d 1) 1)
             (cons (reg c0 15)
               (cons (reg c0 14)
                 (cons (reg c0 13)
                   (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil))))))))
           (exact
             (framed_idx c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0) (+ (- d 1) 1) w1 (Eq.symm hd))))
         (have hkc2 (<= kc (- d 1)) (arith hkc hd))
         (have hls1 (= ls (List.take nl (regs6 c1))) (rw (scratch_regs c c1 hsc)) (exact hls))
         (cases
           (call_law c0 tbl clo chi f (+ d 6) m0 c1 (- d 1) (reg c0 15)
             (cons (reg c0 14)
               (cons (reg c0 13)
                 (cons (reg c0 12) (cons (reg c0 5) (cons (reg c0 3) (cons (ret_addr c0) nil))))))
             rs
             mi
             vs
             v1
             m1
             ea
             kc
             A
             (+ a (isize ca))
             (rel ea (+ a (+ (isize ca) 5)))
             5
             hall
             hchi
             wx
             hdo
             hag
             hkm
             hreal
             hans
             hargs1
             hkc2
             hrip1
             sC
             htgt)
           ((intro (c6 g6)
              (exact
                (done_from rs f (+ d 6) c0 c c6 v m2 (reaches_trans c c1 c6 r1 (And.left g6))
                  (call_out p ext rs tbl clo chi xs fs ts n1 x k ls v m2 c1 c6 a ca ck c0 f d nl v1
                    m1
                    hall
                    hchi
                    ih
                    hrk
                    hx
                    hck
                    sM
                    p3
                    hsn
                    hd
                    hls1
                    (And.left (And.right g6))
                    (And.left (And.right (And.right g6)))
                    (And.left (And.right (And.right (And.right g6))))
                    (And.left (And.right (And.right (And.right (And.right g6)))))
                    hnl
                    (And.left (And.right (And.right (And.right (And.right (And.right g6))))))
                    (And.right (And.right (And.right (And.right (And.right (And.right g6))))))
                    hdo)))))))))))
;; ---- a call -------------------------------------------------------------------------------------
(theorem sim_call
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (henv (env_ok p ext rs tbl clo chi xs fs))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hrun (= (irun (FS n1) p ext rs (SCall x cal es k) ls mi) (some (Prod.mk v m2))))
   (hcs (= (cstm xs fs ts p nl a (SCall x cal es k)) (some code)))
   (hpl (placed tbl a code))
   (hsn (<= (sneed xs fs ts p (SCall x cal es k)) d))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have hx (< x nl) (exact (And.left (cstm_call_inv xs fs ts p nl a x cal es k code hcs))))
    (cases (irun_call_inv p ext rs n1 x cal es k ls mi (Prod.mk v m2) hrun)
      ((intro (vs g0) (have hvs (= (ievals rs ls mi es) (some vs)) (exact (And.left g0)))
         (cases (And.right g0)
           ((intro (q g1)
              (cases q
                ((mk (v1 m1)
                   (have hq (= (cal_run n1 p ext rs cal vs mi) (some (Prod.mk v1 m1)))
                     (exact (And.left g1)))
                   (have hrk (= (irun n1 p ext rs k (upd ls x v1) m1) (some (Prod.mk v m2)))
                     (exact (And.right g1)))
                   (cases (And.right (cstm_call_inv xs fs ts p nl a x cal es k code hcs))
                     ((intro (en g2)
                        (cases en
                          ((mk (ea kc)
                             (have hcal
                               (= (callee_at xs fs p cal (List.length es)) (some (Prod.mk ea kc)))
                               (exact (And.left g2)))
                             (cases (And.right g2)
                               ((intro (ca g3)
                                  (have hca (= (cargs es 0 nl) (some ca)) (exact (And.left g3)))
                                  (cases (And.right g3)
                                    ((intro (ck g4)
                                       (have hck
                                         (= (cstm xs fs ts p nl (+ a (+ (isize ca) 8)) k) (some ck))
                                         (exact (And.left g4)))
                                       (have hcd
                                         (= code
                                           (List.append ca
                                             (cons (Call (rel ea (+ a (+ (isize ca) 5))))
                                               (cons (MovRmR (RmReg (kreg x)) 0) ck))))
                                         (exact (And.right g4)))
                                       (have hpl2
                                         (placed tbl a
                                           (List.append ca
                                             (cons (Call (rel ea (+ a (+ (isize ca) 5))))
                                               (cons (MovRmR (RmReg (kreg x)) 0) ck))))
                                         (rw (<- hcd))
                                         (exact hpl))
                                       (have hlen (= (List.length vs) (List.length es))
                                         (exact (ievals_len rs ls mi es vs hvs)))
                                       (have hans
                                         (cal_ans p ext rs cal (List.length es) vs mi v1 m1)
                                         (show
                                           (and (= (List.length vs) (List.length es))
                                             (exists ((n0 Fuel))
                                               (= (cal_run n0 p ext rs cal vs mi)
                                                 (some (Prod.mk v1 m1))))))
                                         (apply And.intro ((exact hlen))
                                           ((apply (Exists.intro n1) ((exact hq))))))
                                       (have hreal
                                         (realizes tbl clo chi ea kc rs
                                           (cal_ans p ext rs cal (List.length es)))
                                         (exact (henv cal (List.length es) (Prod.mk ea kc) hcal)))
                                       (have hkc (<= (+ kc 1) d)
                                         (exact
                                           (And.left
                                             (sneed_call xs fs ts p x cal es k (Prod.mk ea kc) d
                                               hcal
                                               hsn))))
                                       (have hsn2 (<= (sneed xs fs ts p k) d)
                                         (exact
                                           (And.right
                                             (sneed_call xs fs ts p x cal es k (Prod.mk ea kc) d
                                               hcal
                                               hsn))))
                                       (exact
                                         (call_core p ext rs tbl clo chi xs fs ts n1 x es k ls mi v
                                           m2
                                           c
                                           a
                                           c0
                                           f
                                           d
                                           nl
                                           m0
                                           vs
                                           v1
                                           m1
                                           ea
                                           kc
                                           ca
                                           ck
                                           (cal_ans p ext rs cal (List.length es))
                                           hall
                                           hchi
                                           ih
                                           hreal
                                           hans
                                           hvs
                                           hrk
                                           hx
                                           hca
                                           hck
                                           hpl2
                                           hkc
                                           hsn2
                                           hrip
                                           w
                                           hls
                                           hnl
                                           hag
                                           hkm
                                           hdo)))))))))))))))))))))))))
