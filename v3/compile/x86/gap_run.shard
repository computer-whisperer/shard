;;; v3/compile/x86/gap_run.shard — three functions deep, through every layer (docs/COMPILE.md §5,
;;; §8): the file of gap_file.shard, started as the runner starts it, exits with the low byte of
;;; what `gap` (../gap_src.shard) — the function over two lists — computes of the two buffers the
;;; start-up pushes: 54. Each function is a module behind a view (../dot, ../sqdiff, ../gap), and
;;; this file has the three views and no body. The chain, one statement per seam: the
;;; hand-written `dot` realizes the answer of `dot`'s low form (dot_hand.shard), in this file's
;;; table since its rows are rows of it; the code the pass answers for `sqdiff`'s module
;;; realizes its run's answer where `dot`'s code realizes `dot`'s (`module_realizes`), and so
;;; the answer of `sqdiff`'s low form, by the tie in `sqdiff`'s view; the code the pass answers
;;; for `gap`'s module realizes its run's answer where `sqdiff`'s code realizes `sqdiff`'s; and
;;; a file with a function that realizes its answer exits as the answer says (`link_exits`).
(import "gap_file.shard")
(import "link.shard")
(import "module.shard")
(import "dot_hand.shard")
(import "../gap")
(import "../sample.shard")
(use std.mem)
(use compile.ir)
(use compile.two)
(use compile.sample)
(use compile.dot)
(use compile.sqdiff)
(use compile.sqdiff_obj)
(use compile.gap)
(use compile.gap_obj)
(use compile.gap_src)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use compile.x86.gap_file)
(use compile.x86.startup)
(use compile.x86.dot_hand)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- `dot`, hand-written: the answer `sqdiff`'s code runs with ------------------------------------
(theorem gp_dot_realizes ((rs (List Seg)))
  (realizes gp_tbl 4194424 gp_chi 4194547 0 rs (ext_ans (sqdiff_ext rs) 0))
  (by
    (have hr (realizes gp_tbl 4194424 gp_chi 4194547 0 rs (two_ans dot_lo rs))
      (exact
        (realizes_part dot_rows gp_tbl 4194424 gp_chi 4194547 0 rs (two_ans dot_lo rs) gp_dot_rows
          (dot_hand_realizes rs 4194424 gp_chi))))
    (exact hr)))
(theorem gp_sq_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at gp_sq_outs j) (some en))
      (realizes gp_tbl 4194424 gp_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (sqdiff_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_one (Prod.mk 4194547 0) j en h)
      ((intro (hj he) (rw hj) (rw (<- he)) (exact (gp_dot_realizes rs)))))))

;; ---- `sqdiff`, compiled: the answer `gap`'s code runs with ----------------------------------------
;; the module's theorem, met by this file: the run's answer
(theorem gp_sq_code_realizes ((rs (List Seg)))
  (realizes gp_tbl 4194424 gp_chi gp_sq_at gp_sq_need rs
    (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code))
  (exact
    (module_realizes sqdiff_prog (sqdiff_ext rs) rs gp_tbl 4194424 gp_chi gp_sq_outs 4194584
      gp_sq_listing
      gp_sq_entries
      gp_within
      gp_chi_word
      (gp_sq_outs_realize rs)
      gp_sq_compiled
      gp_sq_placed
      0
      sqdiff_code
      (Prod.mk gp_sq_at gp_sq_need)
      sqdiff_code_is
      gp_sq_entry)))
;; and so the answer of `sqdiff`'s low form: whatever it says, the run answers (`sqdiff_ans_tie`)
(theorem gp_sq_realizes ((rs (List Seg)))
  (realizes gp_tbl 4194424 gp_chi gp_sq_at gp_sq_need rs (ext_ans (gap_ext rs) 0))
  (by
    (have hr (realizes gp_tbl 4194424 gp_chi gp_sq_at gp_sq_need rs (two_ans sqdiff_lo rs))
      (exact
        (realizes_sub gp_tbl 4194424 gp_chi gp_sq_at gp_sq_need rs
          (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code)
          (two_ans sqdiff_lo rs)
          (fun
            ((vs (List (BitVec 64)))
             (m Mem)
             (v (BitVec 64))
             (m2 Mem)
             (h (two_ans sqdiff_lo rs vs m v m2)))
            (sqdiff_ans_tie rs vs m v m2 h))
          (gp_sq_code_realizes rs))))
    (exact hr)))
(theorem gp_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at gp_outs j) (some en))
      (realizes gp_tbl 4194424 gp_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (gap_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_one (Prod.mk gp_sq_at gp_sq_need) j en h)
      ((intro (hj he) (rw hj) (rw (<- he)) (exact (gp_sq_realizes rs)))))))

;; ---- `gap`, compiled ------------------------------------------------------------------------------
(theorem gp_code_realizes ((rs (List Seg)))
  (realizes gp_tbl 4194424 gp_chi gp_at gp_need rs (fn_ans gap_prog (gap_ext rs) rs gap_code))
  (exact
    (module_realizes gap_prog (gap_ext rs) rs gp_tbl 4194424 gp_chi gp_outs gp_base gp_listing
      gp_entries
      gp_within
      gp_chi_word
      (gp_outs_realize rs)
      gp_compiled
      gp_placed
      0
      gap_code
      (Prod.mk gp_at gp_need)
      gap_code_is
      gp_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the answer of `gap`'s code on the buffers the start-up pushes: what `gap` computes of them
(theorem gp_sample
  ((m0 Mem) (hx (holds m0 140737488347112 link_xs)) (hy (holds m0 140737488347088 link_ys)))
  (exists ((m2 Mem))
    (fn_ans gap_prog (gap_ext link_rs) link_rs gap_code link_args m0
      (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)
      m2))
  (exact (Exists.intro m0 (sample_gap_answer m0 hx hy))))
(theorem gap_file_exits ((r Regs) (f Flags) (m Mem))
  (exits (elf_exec gp_image) (runner_start r f m) 54)
  (by
    (have hv (= (% (w64_val (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 54)
      (rw sample_gap)
      (decide))
    (have e
      (exits (elf_exec gp_image) (runner_start r f m)
        (% (w64_val (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256))
      (exact
        (link_exits 4 gp_lines gp_image gp_instrs gp_d gp_xt gp_at gp_chi gp_need
          (fn_ans gap_prog (gap_ext link_rs) link_rs gap_code)
          (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)
          gp_assembled
          gp_resolved
          gp_laid
          gp_target
          gp_within
          gp_size
          gp_chi_stack
          gp_need_fits
          (gp_code_realizes link_rs)
          gp_sample
          r
          f
          m)))
    (rw (<- hv))
    (exact e)))
