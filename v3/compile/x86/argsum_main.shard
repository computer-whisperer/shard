;;; v3/compile/x86/argsum_main.shard — the file of argsum_file.shard written to the path given,
;;; for the model's run and the processor's; and, for each list of arguments given after the
;;; path — the lists separated by an argument `/`, the first of each the name the program is
;;; run by —, a line with the low byte of `argsum` (../argsum_src.shard) of the list, as the
;;; evaluator computes it. argsum_run.shard proves the file's own run exits with it, whatever
;;; the arguments.
(import "../../std/bytes.shard")
(import "../../std/derive.shard")
(import "../../std/host.shard")
(import "argsum_file.shard")
(use std.bytes)
(use std.derive)
(use std.host)
(use compile.argsum_src)
(use compile.x86.argsum_file)
(use models.x86.elf)
(use models.x86.word)
(use Init.Bool false true)
(use Init.List cons nil)

;; whether an argument is the separator, one byte `/`
(fn is_sep ((bs (List Nat))) Bool
  (match bs
    ((cons b nil) (if (= b 47) true false))
    (_ false)))
;; a line for each list: the lists in `rest`, the one being read in `cur`, its arguments the
;; last first
(fn lines ((rest (List ByteArray)) (cur (List (List Nat))) (w World)) World
  (measure (struct rest))
  (match rest
    (nil
      (write_line (Bytes.ofNats (Nat.renderOnto (% (w64_val (argsum (List.reverse cur))) 256) nil))
        w))
    ((cons b r)
     (if (is_sep (Bytes.toNats b))
       (lines r nil
         (write_line
           (Bytes.ofNats (Nat.renderOnto (% (w64_val (argsum (List.reverse cur))) 256) nil))
           w))
       (lines r (cons (Bytes.toNats b) cur) w)))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       (nil (exit 1 w1))
       ((cons path rest)
        (match (write_file path (Bytes.ofNats (elf_exec argsum_image)) w1)
          ((Prod.mk ok w2) (if ok (lines rest nil w2) (exit 1 w2)))))))))
