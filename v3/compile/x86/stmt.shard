;;; v3/compile/x86/stmt.shard — the statement proven of every statement of the fragment,
;;; a local set from rax, and the cases for a return and for a local set.
(import "pass.shard")
(import "../ir_world.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(import "inv.shard")
(use std.mem)
(use compile.x86.code)
(use compile.x86.inv)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir_world)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use compile.ir.IStm)
(use compile.x86.lists)
(use compile.x86.mem)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use models.x86.asm)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
