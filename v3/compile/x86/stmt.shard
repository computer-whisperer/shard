;;; v3/compile/x86/stmt.shard — the statement proven of every statement of the fragment,
;;; and its cases for a local set and for a return.
(import "pass.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(import "inv.shard")
(use std.mem)
(use compile.x86.code)
(use compile.x86.inv)
(use compile.ir)
(use compile.ir.IStm)
(use compile.x86.lists)
(use compile.x86.mem)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(import "expr.shard")
(import "entry.shard")
(use compile.x86.expr)
(use compile.x86.entry)

;; THE STATEMENT-LEVEL FACT, for runs of the fuel n. A statement s of a function of nl locals
;; whose code stands in the table at a: from a state c at a, inside a function entered in c0
;; with room for d + 6 words above f — the six saved registers and the return address standing
;; from the stack pointer, d words up, the locals in their registers, the base memory m0 as the
;; run's memory mi on the data ranges and as c0's memory wherever the run may not write — where
;; the run of s returns v and the memory m2, the processor comes to a state that has returned
;; to c0's caller with v in rax, the data ranges as m2 has them and every other byte outside
;; the d + 6 words as c0 had it.
(def sim
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n Fuel))
  Prop
  (forall
    ((s IStm)
     (ls (List (BitVec 64)))
     (mi Mem)
     (v (BitVec 64))
     (m2 Mem)
     (c Cpu)
     (a Nat)
     (code (List Instr))
     (c0 Cpu)
     (f Nat)
     (d Nat)
     (nl Nat)
     (m0 Mem))
    (-> (= (irun n p ext rs s ls mi) (some (Prod.mk v m2))) (= (cstm xs fs ts p nl a s) (some code))
      (placed tbl a code)
      (<= (sneed xs fs ts p s) d)
      (= (Cpu.rip c) (w64 a))
      (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0))
      (= ls (List.take nl (regs6 c)))
      (<= nl 6)
      (agree rs mi m0)
      (kept_mem rs f (+ d 6) (Cpu.mem c0) m0)
      (data_ok c0 rs clo chi f (+ d 6))
      (done rs f (+ d 6) c0 c v m2))))

;; ---- a return -----------------------------------------------------------------------------------
(theorem sim_ret
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hrun (= (irun (FS n1) p ext rs (SRet e) ls mi) (some (Prod.mk v m2))))
   (hcs (= (cstm xs fs ts p nl a (SRet e)) (some code)))
   (hpl (placed tbl a code))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have hev (= (ieval rs ls mi e) (some v))
      (exact (And.left (irun_ret_inv p ext rs n1 e ls mi v m2 hrun))))
    (have hm2 (= m2 mi) (exact (And.right (irun_ret_inv p ext rs n1 e ls mi v m2 hrun))))
    (cases (cstm_ret_inv xs fs ts p nl a e code hcs)
      ((intro (ce g) (have hce (= (cexp 0 e nl) (some ce)) (exact (And.left g)))
         (have hcd (= code (List.append ce epi)) (exact (And.right g)))
         (have hpl2 (placed tbl a (List.append ce epi)) (rw (<- hcd)) (exact hpl))
         (have p1 (placed tbl a ce) (exact (And.left (placed_app tbl ce a epi hpl2))))
         (have p2 (placed tbl (+ a (isize ce)) epi)
           (exact (And.right (placed_app tbl ce a epi hpl2))))
         (have hst (est tbl rs ls mi nl c)
           (exact (est_framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0) rs ls mi nl w hls hag hdo)))
         (cases (cexp_ok tbl clo chi rs ls mi nl c a e ce v hall hchi hnl hrip hst hce hev p1)
           ((intro (c1 g1) (have r1 (reaches c c1) (exact (And.left g1)))
              (have hv1 (= (reg c1 0) v) (exact (And.left (And.right g1))))
              (have hrip1 (= (Cpu.rip c1) (w64 (+ a (isize ce))))
                (exact (And.left (And.right (And.right g1)))))
              (have hsc (scratch c c1) (exact (And.right (And.right (And.right g1)))))
              (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0))
                (exact (framed_scratch c0 tbl clo chi f (+ d 6) m0 c d (saved c0) c1 w hsc)))
              (have r2 (reaches c1 (eout c1 (+ a (isize ce))))
                (exact
                  (And.left (epi_ok c0 tbl clo chi f d m0 c1 (+ a (isize ce)) hall hchi w1 hrip1 p2))))
              (have hret (returned c0 (eout c1 (+ a (isize ce))))
                (exact
                  (And.right
                    (epi_ok c0 tbl clo chi f d m0 c1 (+ a (isize ce)) hall hchi w1 hrip1 p2))))
              (have hmem (= (Cpu.mem (eout c1 (+ a (isize ce)))) (Cpu.mem c))
                (show (= (Cpu.mem c1) (Cpu.mem c)))
                (exact (And.left (And.right hsc))))
              (have hag2 (agree rs m2 (Cpu.mem (eout c1 (+ a (isize ce)))))
                (rw hmem)
                (rw hm2)
                (exact
                  (agree_frame c0 rs clo chi f (+ d 6) mi m0 (Cpu.mem c) hdo hag (framed_mem w))))
              (have hkm2 (kept_mem rs f (+ d 6) (Cpu.mem c0) (Cpu.mem (eout c1 (+ a (isize ce)))))
                (rw hmem)
                (exact (kept_frame rs f (+ d 6) (Cpu.mem c0) m0 (Cpu.mem c) hkm (framed_mem w))))
              (have hv2 (= (reg (eout c1 (+ a (isize ce))) 0) v)
                (show (= (reg c1 0) v))
                (exact hv1))
              (apply (Exists.intro (eout c1 (+ a (isize ce))))
                ((apply And.intro ((exact (reaches_trans c c1 (eout c1 (+ a (isize ce))) r1 r2)))
                   ((apply And.intro ((exact hv2))
                      ((apply And.intro ((exact hag2))
                         ((apply And.intro ((exact hkm2)) ((exact hret)))))))))))))))))))

;; ---- a local set --------------------------------------------------------------------------------
;; the machine's part: the expression's code, the move into the local's register, and the rest
;; of the statement by the fact for runs of the fuel below
(theorem let_core
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (w0 (BitVec 64))
   (ce (List Instr))
   (ck (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hev (= (ieval rs ls mi e) (some w0)))
   (hrk (= (irun n1 p ext rs k (upd ls x w0) mi) (some (Prod.mk v m2))))
   (hx (< x nl))
   (hce (= (cexp 0 e nl) (some ce)))
   (hck (= (cstm xs fs ts p nl (+ a (+ (isize ce) 3)) k) (some ck)))
   (hpl (placed tbl a (List.append ce (cons (MovRmR (RmReg (kreg x)) 0) ck))))
   (hsn (<= (sneed xs fs ts p k) d))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have p1 (placed tbl a ce)
      (exact (And.left (placed_app tbl ce a (cons (MovRmR (RmReg (kreg x)) 0) ck) hpl))))
    (have p2 (placed tbl (+ a (isize ce)) (cons (MovRmR (RmReg (kreg x)) 0) ck))
      (exact (And.right (placed_app tbl ce a (cons (MovRmR (RmReg (kreg x)) 0) ck) hpl))))
    (have s (= (site tbl (+ a (isize ce))) (some (Prod.mk (MovRmR (RmReg (kreg x)) 0) 3)))
      (exact (And.left p2)))
    (have ea (= (+ (+ a (isize ce)) 3) (+ a (+ (isize ce) 3))) (arith))
    (have p3 (placed tbl (+ a (+ (isize ce) 3)) ck) (rw (<- ea)) (exact (And.right p2)))
    (have hx6 (< x 6) (arith))
    (have hst (est tbl rs ls mi nl c)
      (exact (est_framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0) rs ls mi nl w hls hag hdo)))
    (cases (cexp_ok tbl clo chi rs ls mi nl c a e ce w0 hall hchi hnl hrip hst hce hev p1)
      ((intro (c1 g1) (have r1 (reaches c c1) (exact (And.left g1)))
         (have hv1 (= (reg c1 0) w0) (exact (And.left (And.right g1))))
         (have hrip1 (= (Cpu.rip c1) (w64 (+ a (isize ce))))
           (exact (And.left (And.right (And.right g1)))))
         (have hsc (scratch c c1) (exact (And.right (And.right (And.right g1)))))
         (have w1 (framed c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0))
           (exact (framed_scratch c0 tbl clo chi f (+ d 6) m0 c d (saved c0) c1 w hsc)))
         (have r7 (reaches c1 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3))))
           (apply (t_mov tbl clo chi (+ a (isize ce)) (kreg x) 0 3 w0) ((exact hall)) ((exact hchi))
             ((exact (framed_code w1)))
             ((exact hrip1))
             ((exact s))
             ((exact hv1))
             ((exact (reaches_refl (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3))))))))
         (have w7
           (framed c0 tbl clo chi f (+ d 6) m0
             (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3)))
             d
             (saved c0))
           (exact
             (framed_kset c0 tbl clo chi f (+ d 6) m0 c1 d (saved c0) x w0
               (w64 (+ (+ a (isize ce)) 3))
               hx6
               w1)))
         (have hls1 (= ls (List.take nl (regs6 c1))) (rw (scratch_regs c c1 hsc)) (exact hls))
         (have hls7
           (= (upd ls x w0)
             (List.take nl (regs6 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3))))))
           (rw (kset_regs c1 x w0 (w64 (+ (+ a (isize ce)) 3)) hx6))
           (rw (take_upd (regs6 c1) nl x w0))
           (rw (<- hls1))
           rfl)
         (have hrip7
           (= (Cpu.rip (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3))))
             (w64 (+ a (+ (isize ce) 3))))
           (rw (<- ea))
           rfl)
         (exact
           (done_from rs f (+ d 6) c0 c
             (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3)))
             v
             m2
             (reaches_trans c c1 (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3))) r1 r7)
             (ih k (upd ls x w0) mi v m2
               (at_pc (set_reg c1 (kreg x) w0) (w64 (+ (+ a (isize ce)) 3)))
               (+ a (+ (isize ce) 3))
               ck
               c0
               f
               d
               nl
               m0
               hrk
               hck
               p3
               hsn
               hrip7
               w7
               hls7
               hnl
               hag
               hkm
               hdo))))))))
(theorem sim_let
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hrun (= (irun (FS n1) p ext rs (SLet x e k) ls mi) (some (Prod.mk v m2))))
   (hcs (= (cstm xs fs ts p nl a (SLet x e k)) (some code)))
   (hpl (placed tbl a code))
   (hsn (<= (sneed xs fs ts p (SLet x e k)) d))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have hsn2 (<= (sneed xs fs ts p k) d) (exact hsn))
    (have hx (< x nl) (exact (And.left (cstm_let_inv xs fs ts p nl a x e k code hcs))))
    (cases (irun_let_inv p ext rs n1 x e k ls mi (Prod.mk v m2) hrun)
      ((intro (w0 g0) (have hev (= (ieval rs ls mi e) (some w0)) (exact (And.left g0)))
         (have hrk (= (irun n1 p ext rs k (upd ls x w0) mi) (some (Prod.mk v m2)))
           (exact (And.right g0)))
         (cases (And.right (cstm_let_inv xs fs ts p nl a x e k code hcs))
           ((intro (ce g1) (have hce (= (cexp 0 e nl) (some ce)) (exact (And.left g1)))
              (cases (And.right g1)
                ((intro (ck g2)
                   (have hck (= (cstm xs fs ts p nl (+ a (+ (isize ce) 3)) k) (some ck))
                     (exact (And.left g2)))
                   (have hcd (= code (List.append ce (cons (MovRmR (RmReg (kreg x)) 0) ck)))
                     (exact (And.right g2)))
                   (have hpl2 (placed tbl a (List.append ce (cons (MovRmR (RmReg (kreg x)) 0) ck)))
                     (rw (<- hcd))
                     (exact hpl))
                   (exact
                     (let_core p ext rs tbl clo chi xs fs ts n1 x e k ls mi v m2 c a c0 f d nl m0 w0
                       ce ck hall hchi ih hev hrk hx hce hck hpl2 hsn2 hrip w hls hnl hag hkm hdo)))))))))))))
