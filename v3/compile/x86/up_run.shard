;;; v3/compile/x86/up_run.shard — `up`'s file ends as `up` says: a program whose code STORES,
;;; through every layer (docs/COMPILE.md §5, §6, §8). The file of up_file.shard, started with
;;; its stack anywhere `stack_ok` allows, with ANY arguments the kernel leaves at the stack
;;; pointer (v3/models/x86/linux.shard `args_at`) and on ANY list of the kernel's answers, ends
;;; as the program's value on the World its process starts with says (`up_file_ends`): every
;;; argument after the first written with each character replaced by the next, one write a
;;; character, a line's end after it, and status 0; or a write failed, and it exits with that
;;; failure's status having written what was taken; or the kernel ended it. From the module's
;;; theorem for runs with what is outside (`wmodule_realizes`), whose hypothesis about the
;;; outside function is `write_all`'s own theorem (`put_wx_realizes`); the tie of the four
;;; functions' code (`up_prog_tie`), whose regions are here the start-up's layout; and the
;;; link over the range from the data's first word to the top of the stack's range
;;; (`start_ends_top`), the memory the function is entered with being the start's from the
;;; stack pointer up. What the tie's condition says of the memory left — the memory given but
;;; for the scratch word — the file's end does not ask for (`tied_exit`).
(import "up_file.shard")
(import "module.shard")
(import "link.shard")
(import "../../models/x86/bytes.shard")
(import "../../models/x86/args.shard")
(use std.mem)
(use std.world)
(use compile.up_ir)
(use compile.up_src)
(use compile.ir)
(use compile.put)
(use compile.rep)
(use compile.stretch)
(use compile.tie)
(use compile.x86.code)
(use compile.x86.up_file)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.put)
(use compile.x86.seam)
(use compile.x86.startup)
(use models.x86.args)
(use models.x86.bytes)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.linux.Answer)
(use models.x86.linux.Os)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.word)
(use models.x86.world)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; function 3, the one the start-up calls: its code, at the entry the pass answered, realizes
;; the answer of its intermediate code's run with what is outside, for any data ranges
(theorem up_code_is () (= (fn_at up_prog 3) (some up_code3)) (by rfl))
(theorem up_code_realizes ((rs (List Seg)))
  (wrealizes up_tbl 4194424 up_chi up_at up_need rs (wfn_ans up_prog (put_wx rs) rs up_code3))
  (exact
    (wmodule_realizes up_prog (put_wx rs) rs up_tbl 4194424 up_chi up_outs 4194569 up_listing
      up_entries
      up_within
      up_chi_word
      (one_out_realizes up_tbl 4194424 up_chi 4194509 0 rs (put_wx rs)
        (put_wx_realizes up_tbl 4194424 up_chi 4194509 rs up_within up_chi_top up_put_placed))
      up_compiled
      up_placed
      3
      up_code3
      (Prod.mk up_at up_need)
      up_code_is
      up_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the outcome of the entry's code in a memory that holds the two words the start-up pushes and
;; the arguments at the stack pointer, with o outside: the file ends by it as `up`'s value on
;; the World of o says. The regions the tie asks for are the start-up's layout: the line's end
;; in the data's first word, the scratch word the data's second, the arguments from the stack
;; pointer up — the scratch word's region ends where the arguments' begins and begins where the
;; line's end's ends.
(theorem up_answer
  ((sp Nat)
   (hi Nat)
   (m0 Mem)
   (o Os)
   (args (List (List Nat)))
   (h16 (<= 16 sp))
   (hhi (<= hi 140737488355328))
   (hh (holds m0 (start_base sp up_data) up_data))
   (ha (args_at m0 sp hi args)))
  (exists ((out Outcome))
    (and
      (wfn_ans up_prog (put_wx (args_rs (start_base sp up_data) hi))
        (args_rs (start_base sp up_data) hi)
        up_code3
        (arg_words (w64 (start_base sp up_data)) up_argd)
        m0
        o
        out)
      (= (exit_of out)
        (world_res (Prod.fst (up args (os_world o))) (Prod.snd (up args (os_world o)))))))
  (by
    ;; the data's two words stand under the stack pointer
    (have hs (= (+ (start_base sp up_data) 16) sp) (exact (Nat.sub_add_cancel h16)))
    (have hab (<= (+ sp (* 8 (+ (List.length args) 1))) hi) (exact (And.left (And.right ha))))
    (have hb (<= (+ (start_base sp up_data) (* 8 2)) 140737488355328) (arith))
    (have h22 (<= 2 2) (decide))
    (have h12 (<= 1 2) (decide))
    (have h02 (<= 0 2) (decide))
    ;; the three words the start-up hands over: the stack pointer's address, the scratch word's
    ;; and the line's end's
    (have hq (= (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 2)))) sp)
      (rw (start_addr (start_base sp up_data) 2 2 hb h22))
      (exact hs))
    (have hcv
      (= (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1))))
        (+ (start_base sp up_data) 8))
      (exact (start_addr (start_base sp up_data) 2 1 hb h12)))
    (have hnv
      (= (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))) (start_base sp up_data))
      (exact (start_addr (start_base sp up_data) 2 0 hb h02)))
    ;; the regions, and what the run may do in each
    (have hbsp (<= (start_base sp up_data) sp) (arith))
    (have hb8 (<= (start_base sp up_data) (+ (start_base sp up_data) 8)) (arith))
    (have h8sp (<= (+ (+ (start_base sp up_data) 8) 8) sp) (arith))
    (have hsphi (<= sp hi) (arith))
    (have h8hi (<= (+ (start_base sp up_data) 8) hi) (arith))
    (have h18b (<= (+ (start_base sp up_data) 1) (+ (start_base sp up_data) 8)) (arith))
    (have hrs (readable (args_rs (start_base sp up_data) hi) sp hi)
      (exact
        (readable_in (args_rs (start_base sp up_data) hi) (start_base sp up_data) hi sp hi
          (args_rs_readable (start_base sp up_data) hi)
          hbsp
          (Nat.le_refl hi))))
    (have hrc (readable (args_rs (start_base sp up_data) hi) (+ (start_base sp up_data) 8) sp)
      (exact
        (readable_in (args_rs (start_base sp up_data) hi) (start_base sp up_data) hi
          (+ (start_base sp up_data) 8)
          sp
          (args_rs_readable (start_base sp up_data) hi)
          hb8
          hsphi)))
    (have hwc (writable (args_rs (start_base sp up_data) hi) (+ (start_base sp up_data) 8) sp)
      (exact
        (writable_in (args_rs (start_base sp up_data) hi) (start_base sp up_data) hi
          (+ (start_base sp up_data) 8)
          sp
          (args_rs_writable (start_base sp up_data) hi)
          hb8
          hsphi)))
    (have hrn
      (readable (args_rs (start_base sp up_data) hi) (start_base sp up_data)
        (+ (start_base sp up_data) 8))
      (exact
        (readable_in (args_rs (start_base sp up_data) hi) (start_base sp up_data) hi
          (start_base sp up_data)
          (+ (start_base sp up_data) 8)
          (args_rs_readable (start_base sp up_data) hi)
          (Nat.le_refl (start_base sp up_data))
          h8hi)))
    (have hchi (<= sp 140737488355328) (arith))
    (have hnhi (<= (+ (start_base sp up_data) 8) 140737488355328) (arith))
    (have hc
      (cell_rep (+ (start_base sp up_data) 8) sp
        (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1))))
      (show
        (and
          (<= (+ (start_base sp up_data) 8)
            (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1)))))
          (<= (+ (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1)))) 8) sp)))
      (rw hcv)
      (exact (And.intro (Nat.le_refl (+ (start_base sp up_data) 8)) h8sp)))
    (have hAC (or (<= sp sp) (<= hi (+ (start_base sp up_data) 8)))
      (apply Or.inl ((exact (Nat.le_refl sp)))))
    (have hNC
      (or (<= sp (start_base sp up_data))
        (<= (+ (start_base sp up_data) 8) (+ (start_base sp up_data) 8)))
      (apply Or.inr ((exact (Nat.le_refl (+ (start_base sp up_data) 8))))))
    ;; the line's end, from the word the memory holds
    (have k0 (< 0 (List.length up_data)) (decide))
    (have hw0 (= (w64 (mem_le64 m0 (start_base sp up_data))) (w64 10)) (exact (hh 0 k0)))
    (have v0 (< 10 18446744073709551616) (decide))
    (have h18 (<= 1 8) (decide))
    (have hbytes (= (mem_bytes m0 (start_base sp up_data) 1) (list 10))
      (rw (<- (mem_bytes_take m0 1 (start_base sp up_data) 8 h18)))
      (rw (held_bytes m0 (start_base sp up_data) 10 hw0 v0))
      rfl)
    (have hnl
      (bytes_rep (start_base sp up_data) (+ (start_base sp up_data) 8) m0
        (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))
        1
        (list 10))
      (show
        (and
          (<= (start_base sp up_data)
            (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))))
          (and
            (<= (+ (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))) 1)
              (+ (start_base sp up_data) 8))
            (= (mem_bytes m0 (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))) 1)
              (list 10)))))
      (rw hnv)
      (exact (And.intro (Nat.le_refl (start_base sp up_data)) (And.intro h18b hbytes))))
    (have har (args_rep sp hi m0 (w64_add (w64 (start_base sp up_data)) (w64 (* 8 2))) args)
      (exact (And.intro hq ha)))
    (cases
      (up_prog_tie (args_rs (start_base sp up_data) hi) (start_base sp up_data)
        (+ (start_base sp up_data) 8)
        (+ (start_base sp up_data) 8)
        sp
        sp
        hi
        (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1)))
        hrs
        hhi
        hrc
        hwc
        hchi
        hc
        hAC
        hrn
        hnhi
        hNC
        (w64_add (w64 (start_base sp up_data)) (w64 (* 8 0)))
        (w64_add (w64 (start_base sp up_data)) (w64 (* 8 2)))
        m0
        o
        args
        har
        hnl)
      ((intro (out g)
         (apply (Exists.intro out)
           ((apply And.intro ((exact (And.left g)))
              ((rw (up_status args (os_world o)))
               (exact
                 (tied_exit out (w64 0)
                   (changed_in m0 (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1))))
                     (+ (w64_val (w64_add (w64 (start_base sp up_data)) (w64 (* 8 1)))) 8))
                   (Prod.snd (up args (os_world o)))
                   (And.right g))))))))))))
;; THE FILE ENDS AS `up` SAYS. Started with its stack anywhere — the data's two words, the entry's
;; need and the return address under the stack pointer —, with whatever arguments the kernel
;; left at the stack pointer, and whatever the kernel answers its calls.
(theorem up_file_ends
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ up_chi 15) (+ (+ (List.length up_data) up_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem)
   (args (List (List Nat)))
   (ha (args_at m sp hi args))
   (as (List Answer)))
  (ends (elf_exec up_image) (start_at lo sp hi r f m) as (up_res args as))
  (by
    (have hfit (<= (+ lo (* 8 (+ (+ 2 up_need) 1))) sp) (exact (And.left (And.right hst))))
    (have hhi (<= hi 140737488355328) (exact (And.right (And.right (And.right hst)))))
    (have h16 (<= 16 sp) (arith))
    (have hans
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp up_data) (* 8 (List.length up_data))) 140737488355328)
          (holds m0 (start_base sp up_data) up_data)
          (same_outside m m0 0 sp)
          (exists ((out Outcome))
            (and
              (wfn_ans up_prog (put_wx (args_rs (start_base sp up_data) hi))
                (args_rs (start_base sp up_data) hi)
                up_code3
                (arg_words (w64 (start_base sp up_data)) up_argd)
                m0
                (os_start as)
                out)
              (= (exit_of out) (up_res args as))))))
      (intro m0 hb hh hsm)
      (have ha0 (args_at m0 sp hi args) (exact (args_at_same m m0 sp hi args hsm ha)))
      (exact (up_answer sp hi m0 (os_start as) args h16 hhi hh ha0)))
    (exact
      (start_ends_top up_data up_argd 1 up_lines up_image up_instrs up_d up_xt up_at up_chi up_need
        (wfn_ans up_prog (put_wx (args_rs (start_base sp up_data) hi))
          (args_rs (start_base sp up_data) hi)
          up_code3)
        (up_res args as)
        as
        lo
        sp
        hi
        hi
        up_assembled
        up_resolved
        up_laid
        up_target
        up_within
        up_code_end
        hst
        up_nargs
        (Nat.le_refl hi)
        r
        f
        m
        (up_code_realizes (args_rs (start_base sp up_data) hi))
        hans))))
;; run as `up HAL`, with a kernel that takes all it is offered: IBM on a line, and status 0
(theorem up_file_says
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ up_chi 15) (+ (+ (List.length up_data) up_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem)
   (ha (args_at m sp hi (list (list 117 112) (list 72 65 76)))))
  (ends (elf_exec up_image) (start_at lo sp hi r f m) nil (RExit 0 (list 73 66 77 10)))
  (exact (up_file_ends lo sp hi hst r f m (list (list 117 112) (list 72 65 76)) ha nil)))
