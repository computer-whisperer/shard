;;; v3/compile/x86/say_main.shard — `say`'s file written, and what its theorem says. The file's
;;; bytes are say_file.shard's `say_image` as an executable file; for a case — a list of the
;;; kernel's answers and the arguments a process is given, the first the name it is run by —
;;; the theorem's right side (../say_ir.shard `say_res`) is evaluated and printed as the
;;; model's runner prints a run, for a test to compare.
;;;
;;;   load.shard --root v3 --init … --run compile.x86.say_main.main v3/compile/x86/say_main.shard -- write PATH
;;;   … -- says SPEC ARG… / SPEC ARG… …   a line for each case: the answers SPEC
;;;                                       (models/x86/run_main.shard), then the arguments
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "say_file.shard")
(import "../../models/x86/run_main.shard")
(use std.bytes)
(use std.host)
(use compile.say_ir say_res)
(use compile.x86.say_file)
(use models.x86.elf)
(use models.x86.run_main answers_of cases_of nats_each same show_res text)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(fn fail ((w World)) World
  (exit 2 (write_line (Bytes.ofNats (text "say: write PATH | says SPEC ARG… / …")) w)))
(fn says_each ((cs (List (List (List Nat)))) (w World)) World
  (measure (struct cs))
  (match cs
    (nil w)
    ((cons c r)
     (match c
       (nil (says_each r w))
       ((cons spec argv)
        (says_each r (write_line (Bytes.ofNats (show_res (say_res argv (answers_of spec nil)))) w)))))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       ((cons cmd rest)
        (if (same (Bytes.toNats cmd) (text "says")) (says_each (cases_of (nats_each rest) nil) w1)
        (match rest
          ((cons path nil)
           (if (same (Bytes.toNats cmd) (text "write"))
             (match (write_file path (Bytes.ofNats (elf_exec say_image)) w1)
               ((Prod.mk ok w2) (if ok w2 (fail w2))))
             (fail w1)))
          (_ (fail w1)))))
       (nil (fail w1))))))
