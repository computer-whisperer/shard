;;; v3/compile/x86/lists.shard — facts of lists of words the pass's proof uses.
(import "../ir.shard")
(use compile.ir)
(use models.x86.word)
(use models.x86.words)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; the word at an index below n is the same in the first n words
(theorem nth_take ((xs (List (BitVec 64))))
  (forall ((n Nat) (i Nat)) (-> (< i n) (= (nth (List.take n xs) i) (nth xs i))))
  (by
    (induction xs
      ((nil () (intro n i h) (rw (@List.take_nil (BitVec 64) n)) rfl)
       (cons (x r ih) (intro n i h)
         (cases n
           ((zero () (exact (absurd h (Nat.not_lt_zero i))))
            (succ (n1) (show (= (nth (cons x (List.take n1 r)) i) (nth (cons x r) i)))
              (cases (Nat.decEq i 0)
                ((isTrue (h0) (rw nth.eq_2) (rw nth.eq_2) (rw (if_pos h0)) (rw (if_pos h0)) rfl)
                 (isFalse (h0) (have h1 (<= 1 i) (exact (Nat.pos_of_ne_zero h0)))
                   (have h2 (< (- i 1) n1) (arith (Nat.sub_add_cancel h1)))
                   (rw nth.eq_2)
                   (rw nth.eq_2)
                   (rw (if_neg h0))
                   (rw (if_neg h0))
                   (exact (ih n1 (- i 1) h2)))))))))))))
;; a word replaced, then the first n words: the first n words, then the word replaced
(theorem take_upd ((xs (List (BitVec 64))))
  (forall ((n Nat) (k Nat) (v (BitVec 64)))
    (= (List.take n (upd xs k v)) (upd (List.take n xs) k v)))
  (by
    (induction xs
      ((nil () (intro n k v)
         (show
           (= (List.take n (@List.nil (BitVec 64))) (upd (List.take n (@List.nil (BitVec 64))) k v)))
         (rw (@List.take_nil (BitVec 64) n))
         rfl)
       (cons (x r ih) (intro n k v)
         (cases n
           ((zero () rfl)
            (succ (n1)
              (cases (Nat.decEq k 0)
                ((isTrue (h0)
                   (show
                     (= (List.take (+ n1 1) (upd (cons x r) k v))
                       (upd (cons x (List.take n1 r)) k v)))
                   (rw upd.eq_2)
                   (rw upd.eq_2)
                   (rw (if_pos h0))
                   (rw (if_pos h0))
                   rfl)
                 (isFalse (h0)
                   (show
                     (= (List.take (+ n1 1) (upd (cons x r) k v))
                       (upd (cons x (List.take n1 r)) k v)))
                   (rw upd.eq_2)
                   (rw upd.eq_2)
                   (rw (if_neg h0))
                   (rw (if_neg h0))
                   (show
                     (= (cons x (List.take n1 (upd r (- k 1) v)))
                       (cons x (upd (List.take n1 r) (- k 1) v))))
                   (rw (ih n1 (- k 1) v))
                   rfl)))))))))))
(theorem app_nil ((xs (List (BitVec 64)))) (= (app xs nil) xs)
  (by
    (induction xs
      ((nil () rfl) (cons (x r ih) (show (= (cons x (app r nil)) (cons x r))) (rw ih) rfl)))))
(theorem app_snoc ((xs (List (BitVec 64))))
  (forall ((v (BitVec 64)) (ys (List (BitVec 64))))
    (= (app (app xs (cons v nil)) ys) (app xs (cons v ys))))
  (by
    (induction xs
      ((nil () (intro v ys) rfl)
       (cons (x r ih) (intro v ys)
         (show (= (cons x (app (app r (cons v nil)) ys)) (cons x (app r (cons v ys)))))
         (rw (ih v ys))
         rfl)))))
(theorem zeros_zero () (= (zeros 0) nil) (by (rw (zeros.eq_1 0)) rfl))
(theorem zeros_succ ((n Nat)) (= (zeros (+ n 1)) (cons (w64 0) (zeros n)))
  (by
    (have hn (Not (= (+ n 1) 0)) (exact (Nat.succ_ne_zero n)))
    (rw (zeros.eq_1 (+ n 1)))
    (rw (if_neg hn))
    rfl))
(theorem take_zeros ((e Nat)) (forall ((z Nat)) (-> (<= e z) (= (List.take e (zeros z)) (zeros e))))
  (by
    (induction e
      ((zero () (intro z h) (show (= (@List.nil (BitVec 64)) (zeros 0))) (rw zeros_zero) rfl)
       (succ (e1 ih) (intro z h) (have h1 (<= 1 z) (arith h))
         (have hz (= (+ (- z 1) 1) z) (exact (Nat.sub_add_cancel h1)))
         (have hle (<= e1 (- z 1)) (arith h hz))
         (rw (<- hz))
         (show (= (List.take (+ e1 1) (zeros (+ (- z 1) 1))) (zeros (+ e1 1))))
         (rw (zeros_succ (- z 1)))
         (rw (zeros_succ e1))
         (show (= (cons (w64 0) (List.take e1 (zeros (- z 1)))) (cons (w64 0) (zeros e1))))
         (rw (ih (- z 1) hle))
         rfl)))))
(theorem take_app ((vs (List (BitVec 64))))
  (forall ((e Nat) (ys (List (BitVec 64))))
    (= (List.take (+ (List.length vs) e) (app vs ys)) (app vs (List.take e ys))))
  (by
    (induction vs
      ((nil () (intro e ys) (show (= (List.take (+ 0 e) ys) (List.take e ys))) (rw (Nat.zero_add e))
         rfl)
       (cons (x r ih) (intro e ys)
         (have ea (= (+ (List.length (cons x r)) e) (+ (+ (List.length r) e) 1))
           (show (= (+ (+ (List.length r) 1) e) (+ (+ (List.length r) e) 1)))
           (arith))
         (rw ea)
         (show
           (= (cons x (List.take (+ (List.length r) e) (app r ys)))
             (cons x (app r (List.take e ys)))))
         (rw (ih e ys))
         rfl)))))
;; a function's locals at entry are the first of its arguments followed by zeros
(theorem enter_take ((vs (List (BitVec 64))) (e Nat) (z Nat) (h (<= e z)))
  (= (List.take (+ (List.length vs) e) (app vs (zeros z))) (app vs (zeros e)))
  (by (rw (take_app vs e (zeros z))) (rw (take_zeros e z h)) rfl))

;; ---- two lists, one after the other -------------------------------------------------------------
(theorem app_length ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))))
    (= (List.length (app xs ys)) (+ (List.length xs) (List.length ys))))
  (by
    (induction xs
      ((nil () (intro ys) (show (= (List.length ys) (+ 0 (List.length ys))))
         (rw (Nat.zero_add (List.length ys)))
         rfl)
       (cons (x r ih) (intro ys)
         (show (= (+ (List.length (app r ys)) 1) (+ (+ (List.length r) 1) (List.length ys))))
         (rw (ih ys))
         (arith))))))
(theorem app_assoc ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))) (zs (List (BitVec 64))))
    (= (app (app xs ys) zs) (app xs (app ys zs))))
  (by
    (induction xs
      ((nil () (intro ys zs) rfl)
       (cons (x r ih) (intro ys zs)
         (show (= (cons x (app (app r ys) zs)) (cons x (app r (app ys zs)))))
         (rw (ih ys zs))
         rfl)))))
;; a word of the first list, and of the second
(theorem nth_app_lo ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))) (i Nat))
    (-> (< i (List.length xs)) (= (nth (app xs ys) i) (nth xs i))))
  (by
    (induction xs
      ((nil () (intro ys i h) (exact (absurd h (Nat.not_lt_zero i))))
       (cons (x r ih) (intro ys i h) (show (= (nth (cons x (app r ys)) i) (nth (cons x r) i)))
         (cases (Nat.decEq i 0)
           ((isTrue (h0) (rw nth.eq_2) (rw nth.eq_2) (rw (if_pos h0)) (rw (if_pos h0)) rfl)
            (isFalse (h0) (have h1 (<= 1 i) (exact (Nat.pos_of_ne_zero h0)))
              (have hl (< i (+ (List.length r) 1)) (exact h))
              (have h2 (< (- i 1) (List.length r)) (arith (Nat.sub_add_cancel h1)))
              (rw nth.eq_2)
              (rw nth.eq_2)
              (rw (if_neg h0))
              (rw (if_neg h0))
              (exact (ih ys (- i 1) h2))))))))))
(theorem nth_app_hi ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))) (i Nat)) (= (nth (app xs ys) (+ (List.length xs) i)) (nth ys i)))
  (by
    (induction xs
      ((nil () (intro ys i) (show (= (nth ys (+ 0 i)) (nth ys i))) (rw (Nat.zero_add i)) rfl)
       (cons (x r ih) (intro ys i)
         (have e0 (= (+ (+ (List.length r) 1) i) (+ (+ (List.length r) i) 1)) (arith))
         (have h0 (Not (= (+ (+ (List.length r) i) 1) 0))
           (exact (Nat.succ_ne_zero (+ (List.length r) i))))
         (show (= (nth (cons x (app r ys)) (+ (+ (List.length r) 1) i)) (nth ys i)))
         (rw e0)
         (rw nth.eq_2)
         (rw (if_neg h0))
         (show (= (nth (app r ys) (+ (List.length r) i)) (nth ys i)))
         (exact (ih ys i)))))))
;; a word of the first list replaced, and of the second
(theorem upd_app_lo ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))) (i Nat) (v (BitVec 64)))
    (-> (< i (List.length xs)) (= (upd (app xs ys) i v) (app (upd xs i v) ys))))
  (by
    (induction xs
      ((nil () (intro ys i v h) (exact (absurd h (Nat.not_lt_zero i))))
       (cons (x r ih) (intro ys i v h)
         (show (= (upd (cons x (app r ys)) i v) (app (upd (cons x r) i v) ys)))
         (cases (Nat.decEq i 0)
           ((isTrue (h0) (rw upd.eq_2) (rw upd.eq_2) (rw (if_pos h0)) (rw (if_pos h0)) rfl)
            (isFalse (h0) (have h1 (<= 1 i) (exact (Nat.pos_of_ne_zero h0)))
              (have hl (< i (+ (List.length r) 1)) (exact h))
              (have h2 (< (- i 1) (List.length r)) (arith (Nat.sub_add_cancel h1)))
              (rw upd.eq_2)
              (rw upd.eq_2)
              (rw (if_neg h0))
              (rw (if_neg h0))
              (show (= (cons x (upd (app r ys) (- i 1) v)) (cons x (app (upd r (- i 1) v) ys))))
              (rw (ih ys (- i 1) v h2))
              rfl))))))))
(theorem upd_app_hi ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))) (i Nat) (v (BitVec 64)))
    (= (upd (app xs ys) (+ (List.length xs) i) v) (app xs (upd ys i v))))
  (by
    (induction xs
      ((nil () (intro ys i v) (show (= (upd ys (+ 0 i) v) (upd ys i v))) (rw (Nat.zero_add i)) rfl)
       (cons (x r ih) (intro ys i v)
         (have e0 (= (+ (+ (List.length r) 1) i) (+ (+ (List.length r) i) 1)) (arith))
         (have h0 (Not (= (+ (+ (List.length r) i) 1) 0))
           (exact (Nat.succ_ne_zero (+ (List.length r) i))))
         (show
           (= (upd (cons x (app r ys)) (+ (+ (List.length r) 1) i) v) (cons x (app r (upd ys i v)))))
         (rw e0)
         (rw upd.eq_2)
         (rw (if_neg h0))
         (show (= (cons x (upd (app r ys) (+ (List.length r) i) v)) (cons x (app r (upd ys i v)))))
         (rw (ih ys i v))
         rfl)))))
;; a list before a list that is not empty has a first word
(theorem app_ne ((xs (List (BitVec 64))))
  (forall ((ys (List (BitVec 64))))
    (-> (< 0 (List.length ys))
      (exists ((w (BitVec 64))) (exists ((ws (List (BitVec 64)))) (= (app xs ys) (cons w ws))))))
  (by
    (intro ys)
    (cases xs
      ((nil ()
         (cases ys
           ((nil () (intro h) (exact (absurd h (Nat.lt_irrefl 0))))
            (cons (y r) (intro h) (apply (Exists.intro y) ((apply (Exists.intro r) (rfl))))))))
       (cons (x r) (intro h) (apply (Exists.intro x) ((apply (Exists.intro (app r ys)) (rfl)))))))))
;; the two for an index at or past the first list's length
(theorem nth_app_ge
  ((xs (List (BitVec 64))) (ys (List (BitVec 64))) (i Nat) (h (<= (List.length xs) i)))
  (= (nth (app xs ys) i) (nth ys (- i (List.length xs))))
  (by
    (have e (= (+ (List.length xs) (- i (List.length xs))) i) (arith (Nat.sub_add_cancel h)))
    (have g1 (= (nth (app xs ys) i) (nth (app xs ys) (+ (List.length xs) (- i (List.length xs)))))
      (rw e)
      rfl)
    (exact (Eq.trans g1 (nth_app_hi xs ys (- i (List.length xs)))))))
(theorem upd_app_ge
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (i Nat)
   (v (BitVec 64))
   (h (<= (List.length xs) i)))
  (= (upd (app xs ys) i v) (app xs (upd ys (- i (List.length xs)) v)))
  (by
    (have e (= (+ (List.length xs) (- i (List.length xs))) i) (arith (Nat.sub_add_cancel h)))
    (have g1
      (= (upd (app xs ys) i v) (upd (app xs ys) (+ (List.length xs) (- i (List.length xs))) v))
      (rw e)
      rfl)
    (exact (Eq.trans g1 (upd_app_hi xs ys (- i (List.length xs)) v)))))
;; the first n words of a list no longer than n are the list; an index below n and below a
;; list's length is below the length of its first n words
(theorem take_all ((xs (List (BitVec 64))))
  (forall ((n Nat)) (-> (<= (List.length xs) n) (= (List.take n xs) xs)))
  (by
    (induction xs
      ((nil () (intro n h) (rw (@List.take_nil (BitVec 64) n)) rfl)
       (cons (x r ih) (intro n h) (have hl (<= (+ (List.length r) 1) n) (exact h))
         (have h1 (<= 1 n) (arith))
         (have hn (= (+ (- n 1) 1) n) (exact (Nat.sub_add_cancel h1)))
         (have h2 (<= (List.length r) (- n 1)) (arith))
         (rw (<- hn))
         (show (= (cons x (List.take (- n 1) r)) (cons x r)))
         (rw (ih (- n 1) h2))
         rfl)))))
(theorem take_lt ((xs (List (BitVec 64))))
  (forall ((n Nat) (i Nat))
    (-> (< i n) (< i (List.length xs)) (< i (List.length (List.take n xs)))))
  (by
    (induction xs
      ((nil () (intro n i h1 h2) (exact (absurd h2 (Nat.not_lt_zero i))))
       (cons (x r ih) (intro n i h1 h2)
         (cases n
           ((zero () (exact (absurd h1 (Nat.not_lt_zero i))))
            (succ (n1) (show (< i (+ (List.length (List.take n1 r)) 1)))
              (cases (Nat.decEq i 0)
                ((isTrue (h0) (arith))
                 (isFalse (h0) (have g1 (<= 1 i) (exact (Nat.pos_of_ne_zero h0)))
                   (have hc (= (+ (- i 1) 1) i) (exact (Nat.sub_add_cancel g1)))
                   (have hl (< i (+ (List.length r) 1)) (exact h2))
                   (have a1 (< (- i 1) n1) (arith))
                   (have a2 (< (- i 1) (List.length r)) (arith))
                   (have g (< (- i 1) (List.length (List.take n1 r))) (exact (ih n1 (- i 1) a1 a2)))
                   (arith))))))))))))
;; zeros
(theorem zeros_length ((n Nat)) (= (List.length (zeros n)) n)
  (by
    (induction n
      ((zero () (show (= (List.length (zeros 0)) 0)) (rw zeros_zero) rfl)
       (succ (n1 ih) (show (= (List.length (zeros (+ n1 1))) (+ n1 1))) (rw (zeros_succ n1))
         (show (= (+ (List.length (zeros n1)) 1) (+ n1 1)))
         (rw ih)
         rfl)))))
(theorem zeros_app ((a Nat)) (forall ((b Nat)) (= (app (zeros a) (zeros b)) (zeros (+ a b))))
  (by
    (induction a
      ((zero () (intro b) (show (= (app (zeros 0) (zeros b)) (zeros (+ 0 b)))) (rw zeros_zero)
         (rw (Nat.zero_add b))
         rfl)
       (succ (a1 ih) (intro b) (have e (= (+ (+ a1 1) b) (+ (+ a1 b) 1)) (arith))
         (show (= (app (zeros (+ a1 1)) (zeros b)) (zeros (+ (+ a1 1) b))))
         (rw e)
         (rw (zeros_succ a1))
         (rw (zeros_succ (+ a1 b)))
         (show (= (cons (w64 0) (app (zeros a1) (zeros b))) (cons (w64 0) (zeros (+ a1 b)))))
         (rw (ih b))
         rfl)))))
;; a zero under a list of zeros is a zero over it
(theorem zeros_cons ((n Nat))
  (forall ((ys (List (BitVec 64))))
    (= (app (zeros n) (cons (w64 0) ys)) (cons (w64 0) (app (zeros n) ys))))
  (by
    (induction n
      ((zero () (intro ys)
         (show (= (app (zeros 0) (cons (w64 0) ys)) (cons (w64 0) (app (zeros 0) ys))))
         (rw zeros_zero)
         rfl)
       (succ (n1 ih) (intro ys)
         (show (= (app (zeros (+ n1 1)) (cons (w64 0) ys)) (cons (w64 0) (app (zeros (+ n1 1)) ys))))
         (rw (zeros_succ n1))
         (show
           (= (cons (w64 0) (app (zeros n1) (cons (w64 0) ys)))
             (cons (w64 0) (cons (w64 0) (app (zeros n1) ys)))))
         (rw (ih ys))
         rfl)))))

;; A function's locals at entry — its arguments, then zeros — are the first of the six
;; registers' words as the prologue sets them, then a zero for each local of the frame.
(theorem enter_slots ((vs (List (BitVec 64))) (e Nat) (h (<= (List.length vs) 6)))
  (= (app vs (zeros e))
    (app (List.take (+ (List.length vs) e) (app vs (zeros (- 6 (List.length vs)))))
      (zeros (- (+ (List.length vs) e) 6))))
  (by
    (cases (Nat.decLe (+ (List.length vs) e) 6)
      ((isTrue (h1) (have hle (<= e (- 6 (List.length vs))) (arith (Nat.sub_add_cancel h)))
         (rw (Nat.sub_eq_zero_of_le h1))
         (rw zeros_zero)
         (rw (app_nil (List.take (+ (List.length vs) e) (app vs (zeros (- 6 (List.length vs)))))))
         (rw (enter_take vs e (- 6 (List.length vs)) hle))
         rfl)
       (isFalse (h1)
         (have hl (= (List.length (app vs (zeros (- 6 (List.length vs))))) 6)
           (rw (app_length vs (zeros (- 6 (List.length vs)))))
           (rw (zeros_length (- 6 (List.length vs))))
           (arith (Nat.sub_add_cancel h)))
         (have hle2
           (<= (List.length (app vs (zeros (- 6 (List.length vs))))) (+ (List.length vs) e))
           (rw hl)
           (arith))
         (have h6e (<= 6 (+ (List.length vs) e)) (arith))
         (have es (= (+ (- 6 (List.length vs)) (- (+ (List.length vs) e) 6)) e)
           (arith (Nat.sub_add_cancel h) (Nat.sub_add_cancel h6e)))
         (rw (take_all (app vs (zeros (- 6 (List.length vs)))) (+ (List.length vs) e) hle2))
         (rw (app_assoc vs (zeros (- 6 (List.length vs))) (zeros (- (+ (List.length vs) e) 6))))
         (rw (zeros_app (- 6 (List.length vs)) (- (+ (List.length vs) e) 6)))
         (rw es)
         rfl)))))
