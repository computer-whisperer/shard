;;; v3/compile/x86/module.shard — a call of a function of lower index, and THE MODULE'S THEOREM:
;;; every function of a compiled module realizes its answer, given that each function the
;;; module calls from outside realizes its own (`module_realizes`).
(import "pass.shard")
(import "../ir_world.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(use std.mem)
(use compile.x86.code)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir_world)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use compile.ir.ICallee)
(use compile.x86.pass)
(use compile.x86.seam)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(import "stmt.shard")
(import "call.shard")
(import "function.shard")
(use compile.x86.function)
(use compile.x86.call)

;; ---- lists of entries -------------------------------------------------------------------------------
(theorem pair_inj2
  ((a (List Instr))
   (b (List (Prod Nat Nat)))
   (c (List Instr))
   (d (List (Prod Nat Nat)))
   (h (= (Prod.mk a b) (Prod.mk c d))))
  (and (= a c) (= b d))
  (by
    (have e1 (= (Prod.fst (Prod.mk a b)) (Prod.fst (Prod.mk c d))) (rw h) rfl)
    (have e2 (= (Prod.snd (Prod.mk a b)) (Prod.snd (Prod.mk c d))) (rw h) rfl)
    (exact (And.intro e1 e2))))
(theorem len_snoc ((fs (List (Prod Nat Nat))) (x (Prod Nat Nat)))
  (= (List.length (List.append fs (cons x nil))) (+ (List.length fs) 1))
  (by
    (induction fs
      ((nil () rfl)
       (cons (y r ih)
         (show (= (+ (List.length (List.append r (cons x nil))) 1) (+ (+ (List.length r) 1) 1)))
         (rw ih)
         rfl)))))

;; ---- the functions compiled so far --------------------------------------------------------------------
;; every function with an entry in fs realizes its answer there
(def fs_ok
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (fs (List (Prod Nat Nat))))
  Prop
  (forall ((i Nat) (g IFn) (en (Prod Nat Nat)))
    (-> (= (fn_at p i) (some g)) (= (pair_at fs i) (some en))
      (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wfn_ans p wx rs g)))))
;; the functions gs are the program p from the index k on
(def suffix_at ((p (List IFn)) (k Nat) (gs (List IFn))) Prop
  (forall ((i Nat) (g IFn)) (-> (= (fn_at gs i) (some g)) (= (fn_at p (+ k i)) (some g)))))
;; A CALL OF A FUNCTION OF THE MODULE: with the externals and the functions compiled so far
;; realized, every callee the pass has an entry for realizes what a statement's run takes
;; from it
(theorem env_of
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)))))
   (hfs (fs_ok p wx rs tbl clo chi fs)))
  (env_ok p wx rs tbl clo chi xs fs)
  (by
    (intro cal n en)
    (cases cal
      ((CFn (i) (unfold callee_at)
         (cases (fn_at p i) hf
           ((none () (reduce) (intro h)
              (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact h))
              (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
            (some (g) (reduce)
              (cases (Nat.decEq (IFn.params g) n)
                ((isFalse (e) (intro h)
                   (have hn (= (@Option.none (Prod Nat Nat)) (some en))
                     (rw (<- h))
                     (rw (if_neg e))
                     rfl)
                   (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
                 (isTrue (e) (intro h)
                   (have hp (= (pair_at fs i) (some en)) (rw (<- h)) (rw (if_pos e)) rfl)
                   (apply
                     (wrealizes_sub tbl clo chi (Prod.fst en) (Prod.snd en) rs (wfn_ans p wx rs g)
                       (cal_ans p wx rs (CFn i) n))
                     ((intro vs m o out ha)
                      (cases (And.right ha)
                        ((intro (n1 hn)
                           (have hl (= (List.length vs) (IFn.params g))
                             (rw e)
                             (exact (And.left ha)))
                           (have hr2 (= (wfn_run n1 p wx rs (some g) vs m o) (some out))
                             (rw (<- hf))
                             (exact hn))
                           (have hr (= (wrun n1 p wx rs (IFn.body g) (enter g vs) m o) (some out))
                             (exact hr2))
                           (show
                             (and (= (List.length vs) (IFn.params g))
                               (wends p wx rs (IFn.body g) (enter g vs) m o out)))
                           (apply And.intro ((exact hl)) ((apply (Exists.intro n1) ((exact hr)))))))))
                     ((exact (hfs i g en hf hp)))))))))))
       (CExt (j) (intro h) (have hj (= (pair_at xs j) (some en)) (exact h))
         (apply
           (wrealizes_sub tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)
             (cal_ans p wx rs (CExt j) n))
           ((intro vs m o out ha) (cases (And.right ha) ((intro (n1 hn) (exact hn)))))
           ((exact (hx j en hj)))))))))

;; ---- the module ---------------------------------------------------------------------------------------
(theorem cmod_nil
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (p (List IFn))
   (a Nat)
   (code (List Instr))
   (fo (List (Prod Nat Nat)))
   (h (= (cmod xs fs p a nil) (some (Prod.mk code fo)))))
  (= fo fs)
  (by
    (have g (= (some (Prod.mk (@List.nil Instr) fs)) (some (Prod.mk code fo))) (exact h))
    (have hp (= (Prod.mk (@List.nil Instr) fs) (Prod.mk code fo)) (exact (Option.some.inj g)))
    (exact (Eq.symm (And.right (pair_inj2 nil fs code fo hp))))))
(theorem cmod_cons_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (p (List IFn))
   (a Nat)
   (g IFn)
   (r (List IFn))
   (code (List Instr))
   (fo (List (Prod Nat Nat)))
   (h (= (cmod xs fs p a (cons g r)) (some (Prod.mk code fo)))))
  (exists ((cg (List Instr)))
    (and (= (cfn xs fs p a g) (some cg))
      (exists ((cr (List Instr)))
        (and
          (=
            (cmod xs (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)) p (+ a (isize cg)) r)
            (some (Prod.mk cr fo)))
          (= code (List.append cg cr))))))
  (by
    (have g0
      (-> (= (cmod xs fs p a (cons g r)) (some (Prod.mk code fo)))
        (exists ((cg (List Instr)))
          (and (= (cfn xs fs p a g) (some cg))
            (exists ((cr (List Instr)))
              (and
                (=
                  (cmod xs (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)) p
                    (+ a (isize cg))
                    r)
                  (some (Prod.mk cr fo)))
                (= code (List.append cg cr)))))))
      (rw cmod.eq_2)
      (cases (cfn xs fs p a g) hc
        ((none () (reduce) (intro h0)
           (exact (absurd (Eq.symm h0) (Option.some_ne_none (Prod.mk code fo)))))
         (some (cg1) (reduce)
           (cases
             (cmod xs (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)) p (+ a (isize cg1))
               r)
             hm
             ((none () (reduce) (intro h0)
                (exact (absurd (Eq.symm h0) (Option.some_ne_none (Prod.mk code fo)))))
              (some (q)
                (cases q
                  ((mk (cr1 fr1) (reduce) (intro h0)
                     (have hp (= (Prod.mk (List.append cg1 cr1) fr1) (Prod.mk code fo))
                       (exact (Option.some.inj h0)))
                     (have e1 (= (List.append cg1 cr1) code)
                       (exact (And.left (pair_inj2 (List.append cg1 cr1) fr1 code fo hp))))
                     (have e2 (= fr1 fo)
                       (exact (And.right (pair_inj2 (List.append cg1 cr1) fr1 code fo hp))))
                     (apply (Exists.intro cg1)
                       ((apply And.intro (rfl)
                          ((apply (Exists.intro cr1)
                             ((apply And.intro ((rw (<- e2)) (exact hm)) ((exact (Eq.symm e1))))))))))))))))))))
    (exact (g0 h))))
;; The functions gs, compiled from the address a after functions with the entries fs: where the
;; code stands in the table, gs are the program from the index |fs| on, and the functions
;; before them are realized, every function of the answer's entries is.
(def mod_fact
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (gs (List IFn)))
  Prop
  (forall ((fs (List (Prod Nat Nat))) (a Nat) (code (List Instr)) (fo (List (Prod Nat Nat))))
    (-> (= (cmod xs fs p a gs) (some (Prod.mk code fo))) (placed tbl a code)
      (suffix_at p (List.length fs) gs)
      (fs_ok p wx rs tbl clo chi fs)
      (fs_ok p wx rs tbl clo chi fo))))
(theorem mod_step
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (g IFn)
   (r (List IFn))
   (fs (List (Prod Nat Nat)))
   (a Nat)
   (code (List Instr))
   (fo (List (Prod Nat Nat)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)))))
   (ih (mod_fact p wx rs tbl clo chi xs r))
   (h (= (cmod xs fs p a (cons g r)) (some (Prod.mk code fo))))
   (hp (placed tbl a code))
   (hsuf (suffix_at p (List.length fs) (cons g r)))
   (hfs (fs_ok p wx rs tbl clo chi fs)))
  (fs_ok p wx rs tbl clo chi fo)
  (by
    (cases (cmod_cons_inv xs fs p a g r code fo h)
      ((intro (cg g1) (have hcg (= (cfn xs fs p a g) (some cg)) (exact (And.left g1)))
         (cases (And.right g1)
           ((intro (cr g2)
              (have hcr
                (=
                  (cmod xs (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)) p
                    (+ a (isize cg))
                    r)
                  (some (Prod.mk cr fo)))
                (exact (And.left g2)))
              (have hp2 (placed tbl a (List.append cg cr)) (rw (<- (And.right g2))) (exact hp))
              (have p1 (placed tbl a cg) (exact (And.left (placed_app tbl cg a cr hp2))))
              (have p2 (placed tbl (+ a (isize cg)) cr)
                (exact (And.right (placed_app tbl cg a cr hp2))))
              (have h0 (= (fn_at (cons g r) 0) (some g)) rfl)
              (have hg0 (= (fn_at p (List.length fs)) (some g)) (exact (hsuf 0 g h0)))
              (have hreal (wrealizes tbl clo chi a (fneed xs fs p g) rs (wfn_ans p wx rs g))
                (exact
                  (cfn_ok p wx rs tbl clo chi xs fs a g cg hall hchi
                    (env_of p wx rs tbl clo chi xs fs hx hfs)
                    hg0
                    hcg
                    p1)))
              (have hfs2
                (fs_ok p wx rs tbl clo chi (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)))
                (intro i g2x en hf hpa)
                (cases (pair_at_snoc fs (Prod.mk a (fneed xs fs p g)) i en hpa)
                  ((inl (hold) (exact (hfs i g2x en hf hold)))
                   (inr (hnew) (have ei (= i (List.length fs)) (exact (And.left hnew)))
                     (have een (= en (Prod.mk a (fneed xs fs p g))) (exact (And.right hnew)))
                     (have hf2 (= (fn_at p (List.length fs)) (some g2x)) (rw (<- ei)) (exact hf))
                     (have hgg (= (some g) (some g2x)) (exact (Eq.trans (Eq.symm hg0) hf2)))
                     (have eg (= g g2x) (exact (Option.some.inj hgg)))
                     (rw een)
                     (rw (<- eg))
                     (exact hreal)))))
              (have hsuf2
                (suffix_at p (List.length (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)))
                  r)
                (intro i g2x hf)
                (have h1 (= (fn_at (cons g r) (+ i 1)) (some g2x))
                  (have hne (Not (= (+ i 1) 0)) (exact (Nat.succ_ne_zero i)))
                  (rw fn_at.eq_2)
                  (rw (if_neg hne))
                  (show (= (fn_at r i) (some g2x)))
                  (exact hf))
                (have e2
                  (= (+ (List.length (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil))) i)
                    (+ (List.length fs) (+ i 1)))
                  (rw (len_snoc fs (Prod.mk a (fneed xs fs p g))))
                  (arith))
                (rw e2)
                (exact (hsuf (+ i 1) g2x h1)))
              (exact
                (ih (List.append fs (cons (Prod.mk a (fneed xs fs p g)) nil)) (+ a (isize cg)) cr fo
                  hcr
                  p2
                  hsuf2
                  hfs2))))))))))
(theorem mod_all
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)))))
   (gs (List IFn)))
  (mod_fact p wx rs tbl clo chi xs gs)
  (by
    (induction gs
      ((nil () (intro fs a code fo h hp hsuf hfs) (rw (cmod_nil xs fs p a code fo h)) (exact hfs))
       (cons (g r ih) (intro fs a code fo h hp hsuf hfs)
         (exact (mod_step p wx rs tbl clo chi xs g r fs a code fo hall hchi hx ih h hp hsuf hfs)))))))
;; THE MODULE'S THEOREM, for runs with what is outside the process (`wrun`): an external's
;; answer and a function's are outcomes, a return or the process's end (seam.shard
;; `wrealizes`). A program p compiled from the address base, given each external's
;; entry and need (xs): where the pass answers a listing and the functions' entries and needs
;; (fo), the listing stands in a table that lies in [clo, chi) below 2^64, and every external
;; realizes its answer at its entry with its need, every function i of p realizes its answer
;; at its entry with its need.
(theorem wmodule_realizes
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (base Nat)
   (listing (List Instr))
   (fo (List (Prod Nat Nat)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)))))
   (hc (= (compile xs p base) (some (Prod.mk listing fo))))
   (hpl (placed tbl base listing)))
  (forall ((i Nat) (g IFn) (en (Prod Nat Nat)))
    (-> (= (fn_at p i) (some g)) (= (pair_at fo i) (some en))
      (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wfn_ans p wx rs g))))
  (by
    (have hc2 (= (cmod xs nil p base p) (some (Prod.mk listing fo))) (exact hc))
    (have hsuf (suffix_at p (List.length (@List.nil (Prod Nat Nat))) p)
      (intro i g h)
      (show (= (fn_at p (+ 0 i)) (some g)))
      (rw (Nat.zero_add i))
      (exact h))
    (have hfs0 (fs_ok p wx rs tbl clo chi nil)
      (intro i g en hf hpa)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact hpa))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
    (exact (mod_all p wx rs tbl clo chi xs hall hchi hx p nil base listing fo hc2 hpl hsuf hfs0))))


;; ---- one function alone: its callees are externals -----------------------------------------------
;; The first function of a program, compiled with no function before it, its code in the table
;; at a: where every external realizes its answer, the function realizes its own. Its calls are
;; of externals; its tail calls of externals or of itself.
(theorem wfn_realizes_ext
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (a Nat)
   (g IFn)
   (code (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j)))))
   (hself (= (fn_at p 0) (some g)))
   (hc (= (cfn xs nil p a g) (some code)))
   (hpl (placed tbl a code)))
  (wrealizes tbl clo chi a (fneed xs nil p g) rs (wfn_ans p wx rs g))
  (by
    (have hfs0 (fs_ok p wx rs tbl clo chi nil)
      (intro i g0 en hf hpa)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact hpa))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
    (have hs (= (fn_at p (List.length (@List.nil (Prod Nat Nat)))) (some g)) (exact hself))
    (exact
      (cfn_ok p wx rs tbl clo chi xs nil a g code hall hchi
        (env_of p wx rs tbl clo chi xs nil hx hfs0)
        hs
        hc
        hpl))))

;; ---- code that calls nothing outside ------------------------------------------------------------
;; An external that realizes an answer which names nothing outside the process realizes the
;; lifted answer; and code that realizes the answer of a function's run with such externals
;; realizes the answer of its run by `irun`. By these the theorems for a module whose answers
;; name nothing outside are the ones above.
(theorem lift_ext
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (e Nat)
   (k Nat)
   (j Nat)
   (hr (realizes tbl clo chi e k rs (ext_ans ext j))))
  (wrealizes tbl clo chi e k rs (wext_ans (wlift ext) j))
  (by
    (intro c vs m f o out hcode hargs hroom hdo hag)
    (show (-> (= (wlift ext j vs m o) (some out)) (arrives rs f k c (at_pc c (w64 e)) o out)))
    (unfold wlift)
    (reduce)
    (cases (ext j vs m) hq
      ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none out))))
       (some (q) (reduce) (intro h0)
         (have ha (ext_ans ext j vs m (Prod.fst q) (Prod.snd q))
           (show (= (ext j vs m) (some (Prod.mk (Prod.fst q) (Prod.snd q)))))
           (exact hq))
         (rw (<- (Option.some.inj h0)))
         (show (rets rs f k c (at_pc c (w64 e)) o (Prod.fst q) (Prod.snd q) o))
         (exact (hr c vs (Prod.fst q) m (Prod.snd q) f o hcode hargs hroom hdo hag ha)))))))
(theorem lift_exts
  ((ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (realizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (ext_ans ext j))))))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at xs j) (some en))
      (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans (wlift ext) j))))
  (by
    (intro j en h)
    (exact (lift_ext ext rs tbl clo chi (Prod.fst en) (Prod.snd en) j (hx j en h)))))
(theorem unlift_fn
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (e Nat)
   (k Nat)
   (g IFn)
   (hr (wrealizes tbl clo chi e k rs (wfn_ans p (wlift ext) rs g))))
  (realizes tbl clo chi e k rs (fn_ans p ext rs g))
  (by
    (intro c vs v m m2 f o hcode hargs hroom hdo hag hans)
    (cases (And.right hans)
      ((intro (n hn)
         (have hw (wfn_ans p (wlift ext) rs g vs m o (ORet v m2 o))
           (show
             (and (= (List.length vs) (IFn.params g))
               (wends p (wlift ext) rs (IFn.body g) (enter g vs) m o (ORet v m2 o))))
           (apply And.intro ((exact (And.left hans)))
             ((apply (Exists.intro n)
                ((exact (wrun_of_irun p ext rs n (IFn.body g) (enter g vs) m o v m2 hn)))))))
         (exact (hr c vs m f o (ORet v m2 o) hcode hargs hroom hdo hag hw)))))))
;; THE MODULE'S THEOREM for answers that name nothing outside the process
(theorem module_realizes
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (base Nat)
   (listing (List Instr))
   (fo (List (Prod Nat Nat)))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (realizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (ext_ans ext j)))))
   (hc (= (compile xs p base) (some (Prod.mk listing fo))))
   (hpl (placed tbl base listing)))
  (forall ((i Nat) (g IFn) (en (Prod Nat Nat)))
    (-> (= (fn_at p i) (some g)) (= (pair_at fo i) (some en))
      (realizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (fn_ans p ext rs g))))
  (by
    (intro i g en hf hp)
    (exact
      (unlift_fn p ext rs tbl clo chi (Prod.fst en) (Prod.snd en) g
        (wmodule_realizes p (wlift ext) rs tbl clo chi xs base listing fo hall hchi
          (lift_exts ext rs tbl clo chi xs hx)
          hc
          hpl
          i
          g
          en
          hf
          hp)))))
;; one function alone, the same
(theorem fn_realizes_ext
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (a Nat)
   (g IFn)
   (code (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hx
     (forall ((j Nat) (en (Prod Nat Nat)))
       (-> (= (pair_at xs j) (some en))
         (realizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (ext_ans ext j)))))
   (hself (= (fn_at p 0) (some g)))
   (hc (= (cfn xs nil p a g) (some code)))
   (hpl (placed tbl a code)))
  (realizes tbl clo chi a (fneed xs nil p g) rs (fn_ans p ext rs g))
  (exact
    (unlift_fn p ext rs tbl clo chi a (fneed xs nil p g) g
      (wfn_realizes_ext p (wlift ext) rs tbl clo chi xs a g code hall hchi
        (lift_exts ext rs tbl clo chi xs hx)
        hself
        hc
        hpl))))

;; ---- a module with one outside function ------------------------------------------------------------
;; a list of one entry has it at index 0 and nothing at any other: what meets the theorem's
;; hypothesis about outside functions for such a module
(theorem pair_at_one
  ((x (Prod Nat Nat)) (j Nat) (en (Prod Nat Nat)) (h (= (pair_at (cons x nil) j) (some en))))
  (and (= j 0) (= x en))
  (by
    (cases (Nat.decEq j 0)
      ((isTrue (h0)
         (have h1 (= (some x) (some en)) (rw (<- h)) (rw pair_at.eq_2) (rw (if_pos h0)) rfl)
         (exact (And.intro h0 (Option.some.inj h1))))
       (isFalse (h0)
         (have h1 (= (@Option.none (Prod Nat Nat)) (some en))
           (rw (<- h))
           (rw pair_at.eq_2)
           (rw (if_neg h0))
           rfl)
         (exact (absurd (Eq.symm h1) (Option.some_ne_none en))))))))
;; so code that realizes the answer of a module's one outside function, at the entry E with
;; the need k, meets the theorem's hypothesis about outside functions
(theorem one_out_realizes
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (E Nat)
   (k Nat)
   (rs (List Seg))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (h (wrealizes tbl clo chi E k rs (wext_ans wx 0))))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at (cons (Prod.mk E k) nil) j) (some en))
      (wrealizes tbl clo chi (Prod.fst en) (Prod.snd en) rs (wext_ans wx j))))
  (by
    (intro j en hj)
    (cases (pair_at_one (Prod.mk E k) j en hj) ((intro (h0 he) (rw h0) (rw (<- he)) (exact h))))))

;; ---- a module with two outside functions ------------------------------------------------------------
;; a list of two entries has the first at index 0, the second at index 1, and nothing at any other
(theorem pair_at_two
  ((x (Prod Nat Nat))
   (y (Prod Nat Nat))
   (j Nat)
   (en (Prod Nat Nat))
   (h (= (pair_at (cons x (cons y nil)) j) (some en))))
  (or (and (= j 0) (= x en)) (and (= j 1) (= y en)))
  (by
    (cases (Nat.decEq j 0)
      ((isTrue (h0)
         (have h1 (= (some x) (some en)) (rw (<- h)) (rw pair_at.eq_2) (rw (if_pos h0)) rfl)
         (exact (Or.inl (And.intro h0 (Option.some.inj h1)))))
       (isFalse (h0)
         (have h2 (= (pair_at (cons x (cons y nil)) j) (pair_at (cons y nil) (- j 1)))
           (rw pair_at.eq_2 (occ 1))
           (rw (if_neg h0))
           rfl)
         (cases (pair_at_one y (- j 1) en (Eq.trans (Eq.symm h2) h))
           ((intro (hj he)
              (have e (= (+ (- j 1) 1) j) (exact (Nat.sub_add_cancel (Nat.pos_of_ne_zero h0))))
              (have hj1 (= j 1)
                (exact (Eq.trans (Eq.symm e) (congrArg (fun ((q Nat)) (+ q 1)) hj))))
              (exact (Or.inr (And.intro hj1 he)))))))))))
