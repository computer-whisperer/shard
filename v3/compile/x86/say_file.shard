;;; v3/compile/x86/say_file.shard — `say` compiled, in a file with the platform's `write_all`.
;;; The start-up (startup.shard) pushes one word, the byte of a line's end, and hands the
;;; function it calls two addresses: of the word after that one — the stack pointer as the
;;; kernel left it, where a process's arguments stand — and of the word itself. After the
;;; start-up stand the sixteen instructions of `write_all` (put.shard), at 4194482; the four
;;; functions of ../say_ir.shard go through the pass at 4194542, the address after them, with
;;; `write_all` as the module's one outside function: entered at 4194482, no word of stack.
;;; Here are the listing, the table, the file's bytes, and every fact of the assembled file
;;; that the theorems ask for, each closed by computation. That the file ends as `say` says is
;;; say_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "put.shard")
(import "../say_ir.shard")
(use compile.say_ir)
(use compile.x86.code)
(use compile.x86.put)
(use compile.x86.startup)
(use compile.x86.startup.Arg)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the start-up ---------------------------------------------------------------------------------
;; one word of data, a line's end and seven bytes of 0 — the first byte the least significant —;
;; and the function's two arguments: the address of the word after the data, where the kernel
;; left the stack pointer, and the address of the data's word. The call returns to 4194472 and
;; the lines after the start-up stand from 4194482.
(fn say_data () (List (BitVec 64)) (list (w64 10)))
(fn say_argd () (List Arg) (list (AAddr 1) (AAddr 0)))

;; ---- compiled -----------------------------------------------------------------------------------
;; the module's outside functions, each by its entry and its stack need: `write_all`
(fn say_outs () (List (Prod Nat Nat)) (cons (Prod.mk 4194482 0) nil))
(fn say_listing () (List Instr)
  (match (compile say_outs say_prog 4194542)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn say_entries () (List (Prod Nat Nat))
  (match (compile say_outs say_prog 4194542)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem say_compiled ()
  (= (compile say_outs say_prog 4194542) (some (Prod.mk say_listing say_entries)))
  (by rfl))
;; the entry of function 3 as the pass answered it, and the words of stack it needs
(fn say_at () Nat
  (match (pair_at say_entries 3)
    (none 0)
    ((some en) (Prod.fst en))))
(fn say_need () Nat
  (match (pair_at say_entries 3)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem say_entry () (= (pair_at say_entries 3) (some (Prod.mk say_at say_need))) (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
;; `write_all`'s instructions as lines, then the compiled instructions, label 1 before the one
;; at the entry of function 3
(fn say_lines () (List Asm) (List.append (lines put_code) (label_at say_listing 4194542 say_at 1)))
;; the file's table: the start-up's rows, its call's displacement d, `write_all`'s rows, then
;; the compiled instructions laid out from 4194542
(fn say_d () Nat (rel say_at 4194472))
(fn say_xt () (List (Prod Nat (Prod Instr Nat)))
  (List.append (layout put_code 4194482) (layout say_listing 4194542)))
(fn say_tbl () (List (Prod Nat (Prod Instr Nat))) (start_table say_data say_argd say_d say_xt))
(fn say_chi () Nat (+ 4194542 (isize say_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn say_image () (List Nat)
  (match (assemble (start_listing say_data say_argd 1 say_lines))
    (none nil)
    ((some code) code)))
(fn say_instrs () (List Instr)
  (match
    (resolve (start_listing say_data say_argd 1 say_lines)
      (start_listing say_data say_argd 1 say_lines)
      0)
    (none nil)
    ((some is) is)))
(theorem say_assembled ()
  (= (assemble (start_listing say_data say_argd 1 say_lines)) (some say_image))
  (by rfl))
(theorem say_resolved ()
  (=
    (resolve (start_listing say_data say_argd 1 say_lines)
      (start_listing say_data say_argd 1 say_lines)
      0)
    (some say_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches function 3,
;; `write_all`'s lines are its rows, and the lines after them the compiled listing
(theorem say_laid () (= (layout say_instrs 4194424) say_tbl) (by rfl))
(theorem say_target () (= (w64_add (w64 (start_ret say_data say_argd)) (w64 say_d)) (w64 say_at))
  (by rfl))
(theorem say_within () (= (all_within say_tbl 4194424 say_chi) true) (by rfl))
;; the code ends at or below the table's end, and the table's end below 2^47
(theorem say_code_end () (<= (+ 4194424 (List.length say_image)) say_chi) (by decide))
(theorem say_chi_word () (<= (+ say_chi 15) 18446744073709551616) (by decide))
(theorem say_chi_top () (<= (+ say_chi 15) 140737488355328) (by decide))
(theorem say_nargs () (<= (List.length say_argd) 6) (by decide))
;; the compiled listing stands in the table at 4194542, and `write_all`'s code at 4194482
(theorem say_placedb () (= (placedb say_tbl 4194542 say_listing) true) (by decide))
(theorem say_placed () (placed say_tbl 4194542 say_listing)
  (exact (placedb_ok say_tbl say_listing 4194542 say_placedb)))
(theorem say_put_placedb () (= (placedb say_tbl 4194482 put_code) true) (by decide))
(theorem say_put_placed () (placed say_tbl 4194482 put_code)
  (exact (placedb_ok say_tbl put_code 4194482 say_put_placedb)))
