;;; v3/compile/x86/link.shard — LINKING (docs/COMPILE.md §5): a file is a start-up and then ANY
;;; lines. The start-up (startup.shard) is data — the words it pushes and the argument words —
;;; and it calls ONE function and exits with the word the function returns. Proven once, for any
;;; data, any argument words, any lines after the start-up and any label its call names
;;; (`start_exits`): where code that `realizes` an answer stands at the call's target, the file,
;;; started with its stack wherever `stack_ok` allows (models/x86/linux.shard), exits with the
;;; low byte of the answer's word on the argument words, in any memory that holds the data. No
;;; address of the stack is a number here: the stack's range is [lo, hi) and the stack pointer
;;; starts at sp, all three unknown. Nothing is known here of the lines
;;; appended. What the assembler answers for the listing and the table its instructions lay out
;;; to are hypotheses, which a concrete file meets by computation. The start-up's run is derived
;;; from the table's rows by the rules of `laws.shard`: by induction on the data, then on the
;;; argument words. `start_exits_top` is the theorem with the function's data range reaching from
;;; the data to any address of the stack's range, the answer asked on a memory that is the
;;; start's from the stack pointer up: what a file that reads what its kernel left is linked by.
;;; `link_exits` is `start_exits` for the sample of the tree's files.
(import "seam_laws.shard")
(import "startup.shard")
(import "regs.shard")
(import "../../models/x86/loaded.shard")
(import "../../models/x86/process.shard")
(use std.mem)
(use compile.ir)
(use compile.x86.lists)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use compile.stretch)
(use compile.x86.startup)
(use models.x86.asm)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.loaded)
(use models.x86.process)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Fuel)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use models.x86.x86.Seg)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the first state, and what is mapped ----------------------------------------------------------
;; the first state of the process of a code's file, started with the stack's range [lo, hi) and
;; the stack pointer sp
(fn link_first ((code (List Nat)) (lo Nat) (sp Nat) (hi Nat) (r Regs) (f Flags) (m Mem)) Cpu
  (boot (image_of code m) (start_at lo sp hi r f m)))
;; the first state's memory is the start's above the file's image: the stack's contents
(theorem first_above
  ((code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem)
   (x Nat)
   (h (<= (+ 4194424 (List.length code)) x)))
  (= (mem_get (Cpu.mem (link_first code lo sp hi r f m)) x) (mem_get m x))
  (by
    (have hx (<= (+ 4194304 (+ 120 (List.length code))) x) (arith))
    (show
      (= (mem_get (put_bytes m 4194304 (elf_exec code) (+ 120 (List.length code))) x) (mem_get m x)))
    (exact (put_bytes_above (elf_exec code) m 4194304 (+ 120 (List.length code)) x hx))))
;; so a push is mapped, in a state with that mapping whose stack pointer stands in the stack
(theorem push_mapped
  ((code (List Nat))
   (lo Nat)
   (hi Nat)
   (c Cpu)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hsegs (= (Cpu.segs c) (loaded_segs code (MkSeg lo hi 6))))
   (h1 (<= lo (push_at c)))
   (h2 (<= (+ (push_at c) 8) hi)))
  (= (mapped (Cpu.segs c) (push_at c) 8 2) true)
  (by
    (have b2 (= (band 6 2) 2) (decide))
    (rw hsegs)
    (exact (stack_access code lo hi (push_at c) 8 2 hsz h1 h2 b2))))
;; a push changes memory in the word it stores at alone
(theorem pushed_outside ((c Cpu) (v (BitVec 64)))
  (same_outside (Cpu.mem c) (Cpu.mem (pushed c v)) (push_at c) (+ (push_at c) 8))
  (by
    (show
      (same_outside (Cpu.mem c) (mem_put64 (Cpu.mem c) (push_at c) (w64_val v)) (push_at c)
        (+ (push_at c) 8)))
    (exact
      (same_outside_put64 (Cpu.mem c) (Cpu.mem c) (push_at c) (+ (push_at c) 8) (push_at c)
        (w64_val v)
        (same_outside_refl (Cpu.mem c) (push_at c) (+ (push_at c) 8))
        (Nat.le_refl (push_at c))
        (Nat.le_refl (+ (push_at c) 8))))))
;; and leaves a table in place where the word pushed lies in the stack and the code ends below
;; the stack
(theorem code_in_pushed
  ((c Cpu)
   (v (BitVec 64))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (lo Nat)
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (ha (<= lo (push_at c)))
   (hc (code_in c tbl)))
  (code_in (pushed c v) tbl)
  (by
    (have hsegs (= (Cpu.segs (pushed c v)) (Cpu.segs c)) rfl)
    (have hclear (or (<= (+ chi 15) (push_at c)) (<= (+ (push_at c) 8) 4194424))
      (apply Or.inl ((arith))))
    (exact
      (code_in_after c (pushed c v) tbl 4194424 chi (push_at c) (+ (push_at c) 8) hall hsegs
        (pushed_outside c v)
        hclear
        hc))))
;; a program counter that a table has a row for is the number it is written as: the code ends
;; below the stack's range, which begins below 2^47
(theorem rip_at
  ((c Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (lo Nat)
   (pc Nat)
   (il (Prod Instr Nat))
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs (= (site tbl pc) (some il))))
  (= (w64_val (Cpu.rip c)) pc)
  (by
    (have w (and (<= 4194424 pc) (< pc chi)) (exact (site_within tbl 4194424 chi pc il hall hs)))
    (have w2 (< pc chi) (exact (And.right w)))
    (rw hrip)
    (show (= (Nat.mod pc 18446744073709551616) pc))
    (apply Nat.mod_eq_of_lt (arith))))

;; ---- the table from an address on -------------------------------------------------------------------
;; From the address pc on, a table is found as the rows `rows` are. A table's rows are found
;; first match first: the start-up's rows stand before whatever the lines appended lay out to.
(def tail_at
  ((tbl (List (Prod Nat (Prod Instr Nat)))) (pc Nat) (rows (List (Prod Nat (Prod Instr Nat)))))
  Prop
  (forall ((a Nat)) (-> (<= pc a) (= (site tbl a) (site rows a)))))
(theorem tail_at_all ((tbl (List (Prod Nat (Prod Instr Nat)))) (pc Nat)) (tail_at tbl pc tbl)
  (by (intro a h) rfl))
;; the first of the rows is the table's at its address
(theorem tail_at_row
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (pc Nat)
   (il (Prod Instr Nat))
   (rest (List (Prod Nat (Prod Instr Nat))))
   (h (tail_at tbl pc (cons (Prod.mk pc il) rest))))
  (= (site tbl pc) (some il))
  (by (rw (h pc (Nat.le_refl pc))) (rw site.eq_2) (rw (if_pos (Eq.refl pc))) rfl))
;; and from any address past it the table is found as the rows after it are
(theorem tail_at_next
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (pc Nat)
   (q Nat)
   (il (Prod Instr Nat))
   (rest (List (Prod Nat (Prod Instr Nat))))
   (hq (< pc q))
   (h (tail_at tbl pc (cons (Prod.mk pc il) rest))))
  (tail_at tbl q rest)
  (by
    (intro a ha)
    (have hlt (< pc a) (arith))
    (have hle (<= pc a) (arith))
    (rw (h a hle))
    (rw site.eq_2)
    (rw (if_neg (Nat.ne_of_lt hlt)))
    rfl))

;; ---- the data pushed ------------------------------------------------------------------------------
;; `mov rax, x` then `push rax` at pc: a word pushed
(fn push1 ((c Cpu) (x (BitVec 64)) (pc Nat)) Cpu
  (at_pc (pushed (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) x) (w64 (+ pc 11))))
;; the state after the data's pushes, which stand from pc
(fn push_state ((xs (List (BitVec 64))) (c Cpu) (pc Nat)) Cpu
  (measure (struct xs))
  (match xs
    (nil c)
    ((cons x r) (push1 (push_state r c pc) x (+ pc (* 11 (List.length r)))))))
;; ONE WORD PUSHED. From a state c with the table in place, at pc, where the table has the two
;; instructions, whose stack pointer stands a word above the address s in the stack's range:
;; two steps, the table still in place, the stack pointer at s, and memory c's with the word at s.
(theorem push_one
  ((code (List Nat))
   (lo Nat)
   (hi Nat)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (c Cpu)
   (x (BitVec 64))
   (pc Nat)
   (s Nat)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (hc (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (hs1 (= (site tbl pc) (some (Prod.mk (MovRI64 0 (w64_val x)) 10))))
   (hs2 (= (site tbl (+ pc 10)) (some (Prod.mk (Push 0) 1))))
   (hsegs (= (Cpu.segs c) (loaded_segs code (MkSeg lo hi 6))))
   (hsp (= (w64_val (reg c 4)) (+ s 8)))
   (hlo (<= lo s))
   (hhi (<= (+ s 8) hi)))
  (and (reaches c (push1 c x pc))
    (and (code_in (push1 c x pc) tbl)
      (and (= (w64_val (reg (push1 c x pc) 4)) s)
        (= (Cpu.mem (push1 c x pc)) (mem_put64 (Cpu.mem c) s (w64_val x))))))
  (by
    (have k8 (< 8 18446744073709551616) (decide))
    (have hpa (= (push_at c) s) (exact (w64_val_sub (reg c 4) s 8 hsp k8)))
    (have hpa1 (= (push_at (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10)))) s) (exact hpa))
    (have pcv (= (w64_val (Cpu.rip c)) pc)
      (exact (rip_at c tbl chi lo pc (Prod.mk (MovRI64 0 (w64_val x)) 10) hall hchi htop hrip hs1)))
    (have hrip1 (= (Cpu.rip (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10)))) (w64 (+ pc 10))) rfl)
    (have pcv1 (= (w64_val (Cpu.rip (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))))) (+ pc 10))
      (exact
        (rip_at (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) tbl chi lo (+ pc 10) (Prod.mk (Push 0) 1)
          hall
          hchi
          htop
          hrip1
          hs2)))
    (have hm
      (=
        (mapped (Cpu.segs (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))))
          (push_at (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))))
          8
          2)
        true)
      (apply (push_mapped code lo hi (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) hsz) ((exact hsegs))
        ((rw hpa1) (exact hlo))
        ((rw hpa1) (exact hhi))))
    (have hc1 (code_in (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) tbl)
      (exact (code_in_mov_ri c 0 (w64_val x) (w64 (+ pc 10)) tbl hc)))
    (have ha1 (<= lo (push_at (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))))) (rw hpa1) (exact hlo))
    (have hc2 (code_in (push1 c x pc) tbl)
      (exact
        (code_in_pushed (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) x tbl chi lo hall hchi ha1 hc1)))
    (have hr (reaches c (push1 c x pc))
      (apply (do_mov_ri64 pc 0 (w64_val x) 10 (+ pc 10)) ((exact pcv))
        ((exact (hc pc (MovRI64 0 (w64_val x)) 10 hs1)))
        (rfl)
        ((apply (do_push (+ pc 10) 0 1 (+ pc 11)) ((exact pcv1))
           ((exact (hc1 (+ pc 10) (Push 0) 1 hs2)))
           ((exact hm))
           ((arith))
           ((show
              (reaches
                (at_pc (pushed (x_mov_ri c 0 (w64_val x) (w64 (+ pc 10))) (w64 (w64_val x)))
                  (w64 (+ pc 11)))
                (push1 c x pc)))
            (rw (w64_of_val x))
            (exact (reaches_refl (push1 c x pc))))))))
    (have hsp2 (= (w64_val (reg (push1 c x pc) 4)) s) (exact hpa))
    (have hmem (= (Cpu.mem (push1 c x pc)) (mem_put64 (Cpu.mem c) s (w64_val x))) (rw (<- hpa)) rfl)
    (exact (And.intro hr (And.intro hc2 (And.intro hsp2 hmem))))))
;; What a run of pushes comes to, from the state c: a state c2 at pc2 with the table in place
;; and found from pc2 on as `rest`; what is mapped is the file's process's; the stack pointer
;; stands at s; the words xs are held from s; and memory is c's outside those words.
(def pushed_to
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (code (List Nat))
   (lo Nat)
   (hi Nat)
   (c Cpu)
   (c2 Cpu)
   (pc2 Nat)
   (rest (List (Prod Nat (Prod Instr Nat))))
   (s Nat)
   (xs (List (BitVec 64))))
  Prop
  (and (reaches c c2)
    (and (code_in c2 tbl)
      (and (= (Cpu.rip c2) (w64 pc2))
        (and (tail_at tbl pc2 rest)
          (and (= (Cpu.segs c2) (loaded_segs code (MkSeg lo hi 6)))
            (and (= (w64_val (reg c2 4)) s)
              (and (holds (Cpu.mem c2) s xs)
                (same_outside (Cpu.mem c) (Cpu.mem c2) s (+ s (* 8 (List.length xs))))))))))))
;; THE DATA PUSHED. From a state c with the table in place, at pc, where the table from pc on is
;; the rows of the data's pushes and then `rest`, whose stack pointer stands the data's words
;; above the address s in the stack's range: the pushes come to a state past them with the
;; data held from s. By induction on the data: the tail's pushes, then one word's.
(theorem pushes_run
  ((code (List Nat))
   (lo Nat)
   (hi Nat)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (xs (List (BitVec 64))))
  (forall ((c Cpu) (pc Nat) (rest (List (Prod Nat (Prod Instr Nat)))) (s Nat))
    (-> (code_in c tbl) (= (Cpu.rip c) (w64 pc)) (tail_at tbl pc (push_rows xs pc rest))
      (= (Cpu.segs c) (loaded_segs code (MkSeg lo hi 6)))
      (= (w64_val (reg c 4)) (+ s (* 8 (List.length xs))))
      (<= lo s)
      (<= (+ s (* 8 (List.length xs))) hi)
      (pushed_to tbl code lo hi c (push_state xs c pc) (+ pc (* 11 (List.length xs))) rest s xs)))
  (by
    (induction xs
      ((nil () (intro c pc rest s hc hrip ht hsegs hsp hlo hhi)
         (show (pushed_to tbl code lo hi c c pc rest s nil))
         (exact
           (And.intro (reaches_refl c)
             (And.intro hc
               (And.intro hrip
                 (And.intro ht
                   (And.intro hsegs
                     (And.intro hsp
                       (And.intro (holds_nil (Cpu.mem c) s) (same_outside_refl (Cpu.mem c) s s))))))))))
       (cons (x r ih) (intro c pc rest s hc hrip ht hsegs hsp hlo hhi)
         (have ht1
           (tail_at tbl pc (push_rows r pc (push_pair x (+ pc (* 11 (List.length r))) rest)))
           (exact ht))
         (have hsp0 (= (w64_val (reg c 4)) (+ s (* 8 (+ (List.length r) 1)))) (exact hsp))
         (have hsp1 (= (w64_val (reg c 4)) (+ (+ s 8) (* 8 (List.length r)))) (rw hsp0) (arith))
         (have hhi0 (<= (+ s (* 8 (+ (List.length r) 1))) hi) (exact hhi))
         (have hlo1 (<= lo (+ s 8)) (arith))
         (have hhi1 (<= (+ (+ s 8) (* 8 (List.length r))) hi) (arith))
         ;; the tail's words pushed
         (have g
           (pushed_to tbl code lo hi c (push_state r c pc) (+ pc (* 11 (List.length r)))
             (push_pair x (+ pc (* 11 (List.length r))) rest)
             (+ s 8)
             r)
           (exact
             (ih c pc (push_pair x (+ pc (* 11 (List.length r))) rest) (+ s 8) hc hrip ht1 hsegs
               hsp1
               hlo1
               hhi1)))
         (have a4
           (tail_at tbl (+ pc (* 11 (List.length r)))
             (cons (Prod.mk (+ pc (* 11 (List.length r))) (Prod.mk (MovRI64 0 (w64_val x)) 10))
               (cons (Prod.mk (+ (+ pc (* 11 (List.length r))) 10) (Prod.mk (Push 0) 1)) rest)))
           (exact (And.left (And.right (And.right (And.right g))))))
         (have s1
           (= (site tbl (+ pc (* 11 (List.length r)))) (some (Prod.mk (MovRI64 0 (w64_val x)) 10)))
           (exact
             (tail_at_row tbl (+ pc (* 11 (List.length r))) (Prod.mk (MovRI64 0 (w64_val x)) 10)
               (cons (Prod.mk (+ (+ pc (* 11 (List.length r))) 10) (Prod.mk (Push 0) 1)) rest)
               a4)))
         (have hq1 (< (+ pc (* 11 (List.length r))) (+ (+ pc (* 11 (List.length r))) 10)) (arith))
         (have t2
           (tail_at tbl (+ (+ pc (* 11 (List.length r))) 10)
             (cons (Prod.mk (+ (+ pc (* 11 (List.length r))) 10) (Prod.mk (Push 0) 1)) rest))
           (exact
             (tail_at_next tbl (+ pc (* 11 (List.length r))) (+ (+ pc (* 11 (List.length r))) 10)
               (Prod.mk (MovRI64 0 (w64_val x)) 10)
               (cons (Prod.mk (+ (+ pc (* 11 (List.length r))) 10) (Prod.mk (Push 0) 1)) rest)
               hq1
               a4)))
         (have s2 (= (site tbl (+ (+ pc (* 11 (List.length r))) 10)) (some (Prod.mk (Push 0) 1)))
           (exact
             (tail_at_row tbl (+ (+ pc (* 11 (List.length r))) 10) (Prod.mk (Push 0) 1) rest t2)))
         (have hq2 (< (+ (+ pc (* 11 (List.length r))) 10) (+ (+ pc (* 11 (List.length r))) 11))
           (arith))
         (have t3 (tail_at tbl (+ (+ pc (* 11 (List.length r))) 11) rest)
           (exact
             (tail_at_next tbl (+ (+ pc (* 11 (List.length r))) 10)
               (+ (+ pc (* 11 (List.length r))) 11)
               (Prod.mk (Push 0) 1)
               rest
               hq2
               t2)))
         (have hhi2 (<= (+ s 8) hi) (arith))
         ;; then the head
         (have b
           (and (reaches (push_state r c pc) (push_state (cons x r) c pc))
             (and (code_in (push_state (cons x r) c pc) tbl)
               (and (= (w64_val (reg (push_state (cons x r) c pc) 4)) s)
                 (= (Cpu.mem (push_state (cons x r) c pc))
                   (mem_put64 (Cpu.mem (push_state r c pc)) s (w64_val x))))))
           (exact
             (push_one code lo hi tbl chi (push_state r c pc) x (+ pc (* 11 (List.length r))) s hsz
               hall
               hchi
               htop
               (And.left (And.right g))
               (And.left (And.right (And.right g)))
               s1
               s2
               (And.left (And.right (And.right (And.right (And.right g)))))
               (And.left (And.right (And.right (And.right (And.right (And.right g))))))
               hlo
               hhi2)))
         (have b4
           (= (Cpu.mem (push_state (cons x r) c pc))
             (mem_put64 (Cpu.mem (push_state r c pc)) s (w64_val x)))
           (exact (And.right (And.right (And.right b)))))
         (have e1 (= (+ (+ pc (* 11 (List.length r))) 11) (+ pc (* 11 (+ (List.length r) 1))))
           (arith))
         (have so1
           (same_outside (Cpu.mem (push_state r c pc)) (Cpu.mem (push_state (cons x r) c pc)) s
             (+ s 8))
           (rw b4)
           (exact
             (same_outside_put64 (Cpu.mem (push_state r c pc)) (Cpu.mem (push_state r c pc)) s
               (+ s 8)
               s
               (w64_val x)
               (same_outside_refl (Cpu.mem (push_state r c pc)) s (+ s 8))
               (Nat.le_refl s)
               (Nat.le_refl (+ s 8)))))
         (have hd (= (w64 (mem_le64 (Cpu.mem (push_state (cons x r) c pc)) s)) x)
           (rw b4)
           (exact (le64_put64_word (Cpu.mem (push_state r c pc)) s x)))
         (have q2 (holds (Cpu.mem (push_state (cons x r) c pc)) (+ s 8) r)
           (exact
             (holds_same (Cpu.mem (push_state r c pc)) (Cpu.mem (push_state (cons x r) c pc)) s
               (+ s 8)
               (+ s 8)
               r
               (And.left (And.right (And.right (And.right (And.right (And.right (And.right g)))))))
               so1
               (Or.inr (Nat.le_refl (+ s 8))))))
         (have w0
           (same_outside (Cpu.mem c) (Cpu.mem (push_state r c pc)) s
             (+ s (* 8 (+ (List.length r) 1))))
           (apply
             (same_outside_widen (Cpu.mem c) (Cpu.mem (push_state r c pc)) (+ s 8)
               (+ (+ s 8) (* 8 (List.length r)))
               s
               (+ s (* 8 (+ (List.length r) 1)))
               (And.right (And.right (And.right (And.right (And.right (And.right (And.right g))))))))
             ((arith))
             ((arith))))
         (have w1
           (same_outside (Cpu.mem (push_state r c pc)) (Cpu.mem (push_state (cons x r) c pc)) s
             (+ s (* 8 (+ (List.length r) 1))))
           (apply
             (same_outside_widen (Cpu.mem (push_state r c pc))
               (Cpu.mem (push_state (cons x r) c pc))
               s
               (+ s 8)
               s
               (+ s (* 8 (+ (List.length r) 1)))
               so1)
             ((exact (Nat.le_refl s)))
             ((arith))))
         (have g3
           (= (Cpu.rip (push_state (cons x r) c pc)) (w64 (+ pc (* 11 (+ (List.length r) 1)))))
           (rw (<- e1))
           rfl)
         (have g4 (tail_at tbl (+ pc (* 11 (+ (List.length r) 1))) rest) (rw (<- e1)) (exact t3))
         (show
           (pushed_to tbl code lo hi c (push_state (cons x r) c pc)
             (+ pc (* 11 (+ (List.length r) 1)))
             rest
             s
             (cons x r)))
         (exact
           (And.intro
             (reaches_trans c (push_state r c pc) (push_state (cons x r) c pc) (And.left g)
               (And.left b))
             (And.intro (And.left (And.right b))
               (And.intro g3
                 (And.intro g4
                   (And.intro (And.left (And.right (And.right (And.right (And.right g)))))
                     (And.intro (And.left (And.right (And.right b)))
                       (And.intro (holds_cons (Cpu.mem (push_state (cons x r) c pc)) s x r hd q2)
                         (same_outside_trans (Cpu.mem c) (Cpu.mem (push_state r c pc))
                           (Cpu.mem (push_state (cons x r) c pc))
                           s
                           (+ s (* 8 (+ (List.length r) 1)))
                           w0
                           w1))))))))))))))

;; ---- the arguments moved --------------------------------------------------------------------------
;; one argument moved to the register of argument i, by the instructions at pc
(fn arg1 ((a Arg) (i Nat) (c Cpu) (pc Nat)) Cpu
  (match a
    ((AWord w) (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))))
    ((AAddr k)
     (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13))) BAdd
       (areg i)
       0
       (w64 (+ pc 16))))))
;; the state after the moves of the arguments from argument i on, which stand from pc
(fn arg_state ((vs (List Arg)) (i Nat) (c Cpu) (pc Nat)) Cpu
  (measure (struct vs))
  (match vs
    (nil c)
    ((cons a r) (arg_state r (+ i 1) (arg1 a i c pc) (+ pc (arg_size a))))))
;; an address taken from the stack pointer: the argument registers before it as they were and
;; one word more, and the stack pointer as it was
(theorem addr_args
  ((c Cpu) (i Nat) (v Nat) (p1 (BitVec 64)) (p2 (BitVec 64)) (p3 (BitVec 64)) (h (< i 6)))
  (=
    (regs_of (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 p1) 0 v p2) BAdd (areg i) 0 p3)
      (List.take (+ i 1) arg_regs))
    (app (regs_of c (List.take i arg_regs)) (cons (w64_add (reg c 4) (w64 v)) nil)))
  (by
    (apply
      (six_all
        (fun ((i Nat))
          (=
            (regs_of (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 p1) 0 v p2) BAdd (areg i) 0 p3)
              (List.take (+ i 1) arg_regs))
            (app (regs_of c (List.take i arg_regs)) (cons (w64_add (reg c 4) (w64 v)) nil)))))
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
(theorem addr_sp
  ((c Cpu) (i Nat) (v Nat) (p1 (BitVec 64)) (p2 (BitVec 64)) (p3 (BitVec 64)) (h (< i 6)))
  (= (reg (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 p1) 0 v p2) BAdd (areg i) 0 p3) 4) (reg c 4))
  (by
    (apply
      (six_all
        (fun ((i Nat))
          (= (reg (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 p1) 0 v p2) BAdd (areg i) 0 p3) 4)
            (reg c 4))))
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
;; What a run of moves to registers comes to, from the state c: a state c2 at pc2 with the
;; table in place and found from pc2 on as `rest`; what is mapped, memory and the stack pointer
;; are c's; and the first n argument registers hold the words ws.
(def moved_to
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (c Cpu)
   (c2 Cpu)
   (pc2 Nat)
   (rest (List (Prod Nat (Prod Instr Nat))))
   (n Nat)
   (ws (List (BitVec 64))))
  Prop
  (and (reaches c c2)
    (and (code_in c2 tbl)
      (and (= (Cpu.rip c2) (w64 pc2))
        (and (tail_at tbl pc2 rest)
          (and (= (Cpu.segs c2) (Cpu.segs c))
            (and (= (Cpu.mem c2) (Cpu.mem c))
              (and (= (reg c2 4) (reg c 4)) (= (regs_of c2 (List.take n arg_regs)) ws)))))))))
;; ONE ARGUMENT MOVED. From a state c with the table in place, at pc, where the table from pc on
;; is the argument's rows and then `rest`: the argument registers before it as they were, and
;; the register of argument i holds the argument's word — the word itself, or the stack pointer
;; and eight times its index.
(theorem arg_one
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (lo Nat)
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (rest (List (Prod Nat (Prod Instr Nat))))
   (i Nat)
   (c Cpu)
   (pc Nat)
   (hi6 (< i 6))
   (hc (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 pc)))
   (a Arg))
  (-> (tail_at tbl pc (arg_row a i pc rest))
    (moved_to tbl c (arg1 a i c pc) (+ pc (arg_size a)) rest (+ i 1)
      (app (regs_of c (List.take i arg_regs)) (cons (arg_word (reg c 4) a) nil))))
  (by
    (cases a
      ((AWord (w) (intro ht)
         (have ht0
           (tail_at tbl pc (cons (Prod.mk pc (Prod.mk (MovRI64 (areg i) (w64_val w)) 10)) rest))
           (exact ht))
         (have s1 (= (site tbl pc) (some (Prod.mk (MovRI64 (areg i) (w64_val w)) 10)))
           (exact (tail_at_row tbl pc (Prod.mk (MovRI64 (areg i) (w64_val w)) 10) rest ht0)))
         (have hq (< pc (+ pc 10)) (arith))
         (have pcv (= (w64_val (Cpu.rip c)) pc)
           (exact
             (rip_at c tbl chi lo pc (Prod.mk (MovRI64 (areg i) (w64_val w)) 10) hall hchi htop hrip
               s1)))
         (have r1 (reaches c (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))))
           (apply (do_mov_ri64 pc (areg i) (w64_val w) 10 (+ pc 10)) ((exact pcv))
             ((exact (hc pc (MovRI64 (areg i) (w64_val w)) 10 s1)))
             (rfl)
             ((exact (reaches_refl (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))))))))
         (have e0
           (=
             (regs_of (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))) (List.take (+ i 1) arg_regs))
             (app (regs_of c (List.take i arg_regs)) (cons (w64 (w64_val w)) nil)))
           (exact (aset_args c i (w64 (w64_val w)) (w64 (+ pc 10)) hi6)))
         (have g8
           (=
             (regs_of (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))) (List.take (+ i 1) arg_regs))
             (app (regs_of c (List.take i arg_regs)) (cons w nil)))
           (rw e0)
           (rw (w64_of_val w))
           rfl)
         (show
           (moved_to tbl c (x_mov_ri c (areg i) (w64_val w) (w64 (+ pc 10))) (+ pc 10) rest (+ i 1)
             (app (regs_of c (List.take i arg_regs)) (cons w nil))))
         (exact
           (And.intro r1
             (And.intro hc
               (And.intro (Eq.refl (w64 (+ pc 10)))
                 (And.intro
                   (tail_at_next tbl pc (+ pc 10) (Prod.mk (MovRI64 (areg i) (w64_val w)) 10) rest
                     hq
                     ht0)
                   (And.intro (Eq.refl (Cpu.segs c))
                     (And.intro (Eq.refl (Cpu.mem c))
                       (And.intro (aset_sp c i (w64 (w64_val w)) (w64 (+ pc 10)) hi6) g8)))))))))
       (AAddr (k) (intro ht)
         (have ht0
           (tail_at tbl pc
             (cons (Prod.mk pc (Prod.mk (MovRmR (RmReg (areg i)) 4) 3))
               (cons (Prod.mk (+ pc 3) (Prod.mk (MovRI64 0 (* 8 k)) 10))
                 (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest))))
           (exact ht))
         (have s1 (= (site tbl pc) (some (Prod.mk (MovRmR (RmReg (areg i)) 4) 3)))
           (exact
             (tail_at_row tbl pc (Prod.mk (MovRmR (RmReg (areg i)) 4) 3)
               (cons (Prod.mk (+ pc 3) (Prod.mk (MovRI64 0 (* 8 k)) 10))
                 (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest))
               ht0)))
         (have q1 (< pc (+ pc 3)) (arith))
         (have t1
           (tail_at tbl (+ pc 3)
             (cons (Prod.mk (+ pc 3) (Prod.mk (MovRI64 0 (* 8 k)) 10))
               (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest)))
           (exact
             (tail_at_next tbl pc (+ pc 3) (Prod.mk (MovRmR (RmReg (areg i)) 4) 3)
               (cons (Prod.mk (+ pc 3) (Prod.mk (MovRI64 0 (* 8 k)) 10))
                 (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest))
               q1
               ht0)))
         (have s2 (= (site tbl (+ pc 3)) (some (Prod.mk (MovRI64 0 (* 8 k)) 10)))
           (exact
             (tail_at_row tbl (+ pc 3) (Prod.mk (MovRI64 0 (* 8 k)) 10)
               (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest)
               t1)))
         (have q2 (< (+ pc 3) (+ pc 13)) (arith))
         (have t2
           (tail_at tbl (+ pc 13)
             (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest))
           (exact
             (tail_at_next tbl (+ pc 3) (+ pc 13) (Prod.mk (MovRI64 0 (* 8 k)) 10)
               (cons (Prod.mk (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)) rest)
               q2
               t1)))
         (have s3 (= (site tbl (+ pc 13)) (some (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)))
           (exact (tail_at_row tbl (+ pc 13) (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3) rest t2)))
         (have q3 (< (+ pc 13) (+ pc 16)) (arith))
         (have pcv (= (w64_val (Cpu.rip c)) pc)
           (exact
             (rip_at c tbl chi lo pc (Prod.mk (MovRmR (RmReg (areg i)) 4) 3) hall hchi htop hrip s1)))
         (have hc1 (code_in (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) tbl) (exact hc))
         (have hr1 (= (Cpu.rip (x_mov_rr c (areg i) 4 (w64 (+ pc 3)))) (w64 (+ pc 3))) rfl)
         (have pcv1 (= (w64_val (Cpu.rip (x_mov_rr c (areg i) 4 (w64 (+ pc 3))))) (+ pc 3))
           (exact
             (rip_at (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) tbl chi lo (+ pc 3)
               (Prod.mk (MovRI64 0 (* 8 k)) 10)
               hall
               hchi
               htop
               hr1
               s2)))
         (have hc2
           (code_in (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13))) tbl)
           (exact hc))
         (have hr2
           (= (Cpu.rip (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13))))
             (w64 (+ pc 13)))
           rfl)
         (have pcv2
           (=
             (w64_val
               (Cpu.rip (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13)))))
             (+ pc 13))
           (exact
             (rip_at (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13))) tbl
               chi
               lo
               (+ pc 13)
               (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)
               hall
               hchi
               htop
               hr2
               s3)))
         (have r1
           (reaches c
             (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13)))
               BAdd
               (areg i)
               0
               (w64 (+ pc 16))))
           (apply (do_mov_rr pc (areg i) 4 3 (+ pc 3)) ((exact pcv))
             ((exact (hc pc (MovRmR (RmReg (areg i)) 4) 3 s1)))
             (rfl)
             ((apply (do_mov_ri64 (+ pc 3) 0 (* 8 k) 10 (+ pc 13)) ((exact pcv1))
                ((exact (hc1 (+ pc 3) (MovRI64 0 (* 8 k)) 10 s2)))
                ((arith))
                ((apply (do_alu_rr (+ pc 13) BAdd (areg i) 0 3 (+ pc 16)) ((exact pcv2))
                   ((exact (hc2 (+ pc 13) (AluRmR BAdd (RmReg (areg i)) 0) 3 s3)))
                   (rfl)
                   ((arith))
                   ((exact
                      (reaches_refl
                        (x_alu_rr
                          (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13)))
                          BAdd
                          (areg i)
                          0
                          (w64 (+ pc 16))))))))))))
         (have hc3
           (code_in
             (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13)))
               BAdd
               (areg i)
               0
               (w64 (+ pc 16)))
             tbl)
           (exact hc))
         (show
           (moved_to tbl c
             (x_alu_rr (x_mov_ri (x_mov_rr c (areg i) 4 (w64 (+ pc 3))) 0 (* 8 k) (w64 (+ pc 13)))
               BAdd
               (areg i)
               0
               (w64 (+ pc 16)))
             (+ pc 16)
             rest
             (+ i 1)
             (app (regs_of c (List.take i arg_regs)) (cons (w64_add (reg c 4) (w64 (* 8 k))) nil))))
         (exact
           (And.intro r1
             (And.intro hc3
               (And.intro (Eq.refl (w64 (+ pc 16)))
                 (And.intro
                   (tail_at_next tbl (+ pc 13) (+ pc 16)
                     (Prod.mk (AluRmR BAdd (RmReg (areg i)) 0) 3)
                     rest
                     q3
                     t2)
                   (And.intro (Eq.refl (Cpu.segs c))
                     (And.intro (Eq.refl (Cpu.mem c))
                       (And.intro
                         (addr_sp c i (* 8 k) (w64 (+ pc 3)) (w64 (+ pc 13)) (w64 (+ pc 16)) hi6)
                         (addr_args c i (* 8 k) (w64 (+ pc 3)) (w64 (+ pc 13)) (w64 (+ pc 16)) hi6))))))))))))))
;; THE ARGUMENTS MOVED. From a state c with the table in place, at pc, where the table from pc on
;; is the rows of the moves and then `rest`, the first i argument registers hold the words `pre`
;; and the stack pointer is the word spw: the moves come to a state past them where the argument
;; registers hold `pre` and then the arguments' words. By induction on the arguments.
(theorem args_run
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (lo Nat)
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (rest (List (Prod Nat (Prod Instr Nat))))
   (spw (BitVec 64))
   (vs (List Arg)))
  (forall ((c Cpu) (pc Nat) (i Nat) (pre (List (BitVec 64))))
    (-> (code_in c tbl) (= (Cpu.rip c) (w64 pc)) (tail_at tbl pc (arg_rows vs i pc rest))
      (<= (+ i (List.length vs)) 6)
      (= (regs_of c (List.take i arg_regs)) pre)
      (= (reg c 4) spw)
      (moved_to tbl c (arg_state vs i c pc) (+ pc (args_size vs)) rest (+ i (List.length vs))
        (app pre (arg_words spw vs)))))
  (by
    (induction vs
      ((nil () (intro c pc i pre hc hrip ht hle hpre hsp)
         (have g8 (= (regs_of c (List.take i arg_regs)) (app pre nil))
           (rw (app_nil pre))
           (exact hpre))
         (show (moved_to tbl c c pc rest i (app pre nil)))
         (exact
           (And.intro (reaches_refl c)
             (And.intro hc
               (And.intro hrip
                 (And.intro ht
                   (And.intro (Eq.refl (Cpu.segs c))
                     (And.intro (Eq.refl (Cpu.mem c)) (And.intro (Eq.refl (reg c 4)) g8)))))))))
       (cons (a r ih) (intro c pc i pre hc hrip ht hle hpre hsp)
         (have ht0 (tail_at tbl pc (arg_row a i pc (arg_rows r (+ i 1) (+ pc (arg_size a)) rest)))
           (exact ht))
         (have hle0 (<= (+ i (+ (List.length r) 1)) 6) (exact hle))
         (have hi6 (< i 6) (arith))
         (have hle1 (<= (+ (+ i 1) (List.length r)) 6) (arith))
         ;; this argument
         (have b
           (moved_to tbl c (arg1 a i c pc) (+ pc (arg_size a))
             (arg_rows r (+ i 1) (+ pc (arg_size a)) rest)
             (+ i 1)
             (app (regs_of c (List.take i arg_regs)) (cons (arg_word (reg c 4) a) nil)))
           (exact
             (arg_one tbl chi lo hall hchi htop (arg_rows r (+ i 1) (+ pc (arg_size a)) rest) i c pc
               hi6
               hc
               hrip
               a
               ht0)))
         (have b8
           (= (regs_of (arg1 a i c pc) (List.take (+ i 1) arg_regs))
             (app (regs_of c (List.take i arg_regs)) (cons (arg_word (reg c 4) a) nil)))
           (exact
             (And.right (And.right (And.right (And.right (And.right (And.right (And.right b)))))))))
         (have pre1
           (= (regs_of (arg1 a i c pc) (List.take (+ i 1) arg_regs))
             (app pre (cons (arg_word spw a) nil)))
           (rw b8)
           (rw hpre)
           (rw hsp)
           rfl)
         (have b7 (= (reg (arg1 a i c pc) 4) (reg c 4))
           (exact
             (And.left (And.right (And.right (And.right (And.right (And.right (And.right b)))))))))
         (have b6 (= (Cpu.mem (arg1 a i c pc)) (Cpu.mem c))
           (exact (And.left (And.right (And.right (And.right (And.right (And.right b))))))))
         (have b5 (= (Cpu.segs (arg1 a i c pc)) (Cpu.segs c))
           (exact (And.left (And.right (And.right (And.right (And.right b)))))))
         ;; the arguments after it
         (have g
           (moved_to tbl (arg1 a i c pc) (arg_state (cons a r) i c pc)
             (+ (+ pc (arg_size a)) (args_size r))
             rest
             (+ (+ i 1) (List.length r))
             (app (app pre (cons (arg_word spw a) nil)) (arg_words spw r)))
           (exact
             (ih (arg1 a i c pc) (+ pc (arg_size a)) (+ i 1) (app pre (cons (arg_word spw a) nil))
               (And.left (And.right b))
               (And.left (And.right (And.right b)))
               (And.left (And.right (And.right (And.right b))))
               hle1
               pre1
               (Eq.trans b7 hsp))))
         (have e1 (= (+ (+ pc (arg_size a)) (args_size r)) (+ pc (+ (arg_size a) (args_size r))))
           (arith))
         (have e2 (= (+ (+ i 1) (List.length r)) (+ i (+ (List.length r) 1))) (arith))
         (have g3
           (= (Cpu.rip (arg_state (cons a r) i c pc)) (w64 (+ pc (+ (arg_size a) (args_size r)))))
           (rw (<- e1))
           (exact (And.left (And.right (And.right g)))))
         (have g4 (tail_at tbl (+ pc (+ (arg_size a) (args_size r))) rest)
           (rw (<- e1))
           (exact (And.left (And.right (And.right (And.right g))))))
         (have g8
           (=
             (regs_of (arg_state (cons a r) i c pc) (List.take (+ i (+ (List.length r) 1)) arg_regs))
             (app pre (cons (arg_word spw a) (arg_words spw r))))
           (rw (<- e2))
           (rw (<- (app_snoc pre (arg_word spw a) (arg_words spw r))))
           (exact
             (And.right (And.right (And.right (And.right (And.right (And.right (And.right g)))))))))
         (show
           (moved_to tbl c (arg_state (cons a r) i c pc) (+ pc (+ (arg_size a) (args_size r))) rest
             (+ i (+ (List.length r) 1))
             (app pre (cons (arg_word spw a) (arg_words spw r)))))
         (exact
           (And.intro
             (reaches_trans c (arg1 a i c pc) (arg_state (cons a r) i c pc) (And.left b)
               (And.left g))
             (And.intro (And.left (And.right g))
               (And.intro g3
                 (And.intro g4
                   (And.intro
                     (Eq.trans (And.left (And.right (And.right (And.right (And.right g))))) b5)
                     (And.intro
                       (Eq.trans
                         (And.left (And.right (And.right (And.right (And.right (And.right g))))))
                         b6)
                       (And.intro
                         (Eq.trans
                           (And.left
                             (And.right
                               (And.right (And.right (And.right (And.right (And.right g)))))))
                           b7)
                         g8)))))))))))))
;; an argument a word
(theorem arg_words_length ((sp (BitVec 64)) (vs (List Arg)))
  (= (List.length (arg_words sp vs)) (List.length vs))
  (by
    (induction vs
      ((nil () rfl)
       (cons (a r ih) (show (= (+ (List.length (arg_words sp r)) 1) (+ (List.length r) 1))) (rw ih)
         rfl)))))

;; ---- the state the function is entered in -------------------------------------------------------
;; The hypotheses of `realizes`, in any state of the file's process whose stack pointer stands
;; in the stack's range.
;; ROOM for a frame of k words under the return address, f0 the lowest address of the k words
(theorem stack_room
  ((code (List Nat))
   (lo Nat)
   (hi Nat)
   (c Cpu)
   (chi Nat)
   (f0 Nat)
   (k Nat)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hchi (<= (+ chi 15) lo))
   (hsegs (= (Cpu.segs c) (loaded_segs code (MkSeg lo hi 6))))
   (hsp (= (w64_val (reg c 4)) (+ f0 (* 8 k))))
   (hlo (<= lo f0))
   (hhi (<= (+ (+ f0 (* 8 k)) 8) hi)))
  (room c 4194424 chi f0 k)
  (by
    (have b4 (= (band 6 4) 4) (decide))
    (have b2 (= (band 6 2) 2) (decide))
    (have hrd (mapped_words (Cpu.segs c) f0 (+ k 1) 4)
      (intro j hj)
      (have h1 (<= lo (+ f0 (* 8 j))) (arith))
      (have h2 (<= (+ (+ f0 (* 8 j)) 8) hi) (arith))
      (rw hsegs)
      (exact (stack_access code lo hi (+ f0 (* 8 j)) 8 4 hsz h1 h2 b4)))
    (have hwr (mapped_words (Cpu.segs c) f0 k 2)
      (intro j hj)
      (have h1 (<= lo (+ f0 (* 8 j))) (arith))
      (have h2 (<= (+ (+ f0 (* 8 j)) 8) hi) (arith))
      (rw hsegs)
      (exact (stack_access code lo hi (+ f0 (* 8 j)) 8 2 hsz h1 h2 b2)))
    (have hc (or (<= (+ chi 15) f0) (<= (+ f0 (* 8 k)) 4194424)) (apply Or.inl ((arith))))
    (exact (And.intro hsp (And.intro hrd (And.intro hwr hc))))))
;; A DATA RANGE [dlo, dhi) of the stack above the return address: mapped as asked, clear of the
;; frame and of the code
(theorem stack_data
  ((code (List Nat))
   (lo Nat)
   (hi Nat)
   (c Cpu)
   (chi Nat)
   (f0 Nat)
   (k Nat)
   (dlo Nat)
   (dhi Nat)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hchi (<= (+ chi 15) lo))
   (hsegs (= (Cpu.segs c) (loaded_segs code (MkSeg lo hi 6))))
   (h0 (<= lo f0))
   (h1 (<= (+ f0 (* 8 (+ k 1))) dlo))
   (h2 (<= dhi hi)))
  (data_ok c (cons (MkSeg dlo dhi 6) nil) 4194424 chi f0 k)
  (by
    (intro a n need hm)
    (cases (seg_holds (MkSeg dlo dhi 6) a n need) hs
      ((false ()
         (have hx (= (mapped (cons (MkSeg dlo dhi 6) nil) a n need) false)
           (rw (mapped_skip (MkSeg dlo dhi 6) nil a n need hs))
           rfl)
         (exact (absurd (Eq.trans (Eq.symm hx) hm) Bool.false_ne_true)))
       (true ()
         (cases (seg_holds_true (MkSeg dlo dhi 6) a n need hs)
           ((intro (g1 g23)
              (cases g23
                ((intro (g2 g3) (have k1 (<= dlo a) (exact g1))
                   (have k2 (<= (+ a n) dhi) (exact g2))
                   (have k3 (= (band 6 need) need) (exact g3))
                   (have j1 (<= lo a) (arith))
                   (have j2 (<= (+ a n) hi) (arith))
                   (apply And.intro
                     ((rw hsegs) (exact (stack_access code lo hi a n need hsz j1 j2 k3)))
                     ((apply And.intro ((apply Or.inr ((arith)))) ((apply Or.inr ((arith))))))))))))))))))

;; ---- from the function's return to the exit -----------------------------------------------------
;; a run from a file's first state that ends is the file's end
(theorem ends_first
  ((code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem)
   (as (List Answer))
   (res Res)
   (hsize (<= (+ 4194424 (List.length code)) 140737488355328))
   (h (ends_at (link_first code lo sp hi r f m) (os_start as) res)))
  (ends (elf_exec code) (start_at lo sp hi r f m) as res)
  (by
    (cases h
      ((intro (n hn)
         (apply (Exists.intro n)
           ((show (= (run_file n (elf_exec code) (start_at lo sp hi r f m) as) res))
            (rw (run_file_exec n code (start_at lo sp hi r f m) as hsize))
            (show (= (run n (link_first code lo sp hi r f m) (os_start as)) res))
            (exact hn))))))))
;; From any state c2 the file's run comes to, with o2 outside, that stands at the address after
;; the call, the word v in rax and the table in place, where the table from the call on is the
;; call's row and the exit's: three instructions more, and the process has exited with v's low
;; byte, having written what o2 has.
(theorem exit_ends
  ((code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (c2 Cpu)
   (o2 Os)
   (as (List Answer))
   (v (BitVec 64))
   (pc Nat)
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (htop (<= lo 140737488355328))
   (hrun (comes (link_first code lo sp hi r f m) (os_start as) c2 o2))
   (hv (= (reg c2 0) v))
   (hcode2 (code_in c2 tbl))
   (hrip (= (Cpu.rip c2) (w64 (+ pc 5))))
   (ht (tail_at tbl pc (exit_rows pc d xt))))
  (ends (elf_exec code) (start_at lo sp hi r f m) as (RExit (% (w64_val v) 256) (Os.out o2)))
  (by
    (have hsize (<= (+ 4194424 (List.length code)) 140737488355328) (arith))
    (have ht0
      (tail_at tbl pc
        (cons (Prod.mk pc (Prod.mk (Call d) 5))
          (cons (Prod.mk (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3))
            (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
              (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)))))
      (exact ht))
    (have q5 (< pc (+ pc 5)) (arith))
    (have t5
      (tail_at tbl (+ pc 5)
        (cons (Prod.mk (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3))
          (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
            (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt))))
      (exact
        (tail_at_next tbl pc (+ pc 5) (Prod.mk (Call d) 5)
          (cons (Prod.mk (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3))
            (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
              (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)))
          q5
          ht0)))
    (have s1 (= (site tbl (+ pc 5)) (some (Prod.mk (MovRmR (RmReg 7) 0) 3)))
      (exact
        (tail_at_row tbl (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3)
          (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
            (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt))
          t5)))
    (have q8 (< (+ pc 5) (+ pc 8)) (arith))
    (have t8
      (tail_at tbl (+ pc 8)
        (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
          (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)))
      (exact
        (tail_at_next tbl (+ pc 5) (+ pc 8) (Prod.mk (MovRmR (RmReg 7) 0) 3)
          (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
            (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt))
          q8
          t5)))
    (have s2 (= (site tbl (+ pc 8)) (some (Prod.mk (MovRI32 0 60) 5)))
      (exact
        (tail_at_row tbl (+ pc 8) (Prod.mk (MovRI32 0 60) 5)
          (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)
          t8)))
    (have q13 (< (+ pc 8) (+ pc 13)) (arith))
    (have t13 (tail_at tbl (+ pc 13) (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt))
      (exact
        (tail_at_next tbl (+ pc 8) (+ pc 13) (Prod.mk (MovRI32 0 60) 5)
          (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)
          q13
          t8)))
    (have s3 (= (site tbl (+ pc 13)) (some (Prod.mk Syscall 2)))
      (exact (tail_at_row tbl (+ pc 13) (Prod.mk Syscall 2) xt t13)))
    (have hrip2 (= (w64_val (Cpu.rip c2)) (+ pc 5))
      (exact (rip_at c2 tbl chi lo (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3) hall hchi htop hrip s1)))
    (have hcode3 (code_in (x_mov_rr c2 7 0 (w64 (+ pc 8))) tbl) (exact hcode2))
    (have hcode4 (code_in (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) tbl)
      (exact hcode2))
    (have hr3 (= (Cpu.rip (x_mov_rr c2 7 0 (w64 (+ pc 8)))) (w64 (+ pc 8))) rfl)
    (have hrip3 (= (w64_val (Cpu.rip (x_mov_rr c2 7 0 (w64 (+ pc 8))))) (+ pc 8))
      (exact
        (rip_at (x_mov_rr c2 7 0 (w64 (+ pc 8))) tbl chi lo (+ pc 8) (Prod.mk (MovRI32 0 60) 5) hall
          hchi
          htop
          hr3
          s2)))
    (have hr4
      (= (Cpu.rip (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13)))) (w64 (+ pc 13)))
      rfl)
    (have hrip4
      (= (w64_val (Cpu.rip (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13)))))
        (+ pc 13))
      (exact
        (rip_at (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) tbl chi lo
          (+ pc 13)
          (Prod.mk Syscall 2)
          hall
          hchi
          htop
          hr4
          s3)))
    (have hreach (reaches c2 (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))))
      (apply (do_mov_rr (+ pc 5) 7 0 3 (+ pc 8)) ((exact hrip2))
        ((exact (hcode2 (+ pc 5) (MovRmR (RmReg 7) 0) 3 s1)))
        ((arith))
        ((apply (do_mov_ri32 (+ pc 8) 0 60 5 (+ pc 13)) ((exact hrip3))
           ((exact (hcode3 (+ pc 8) (MovRI32 0 60) 5 s2)))
           ((arith))
           ((exact (reaches_refl (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))))))))))
    (have h60
      (= (w64_val (reg (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) 0)) 60)
      rfl)
    (have hexit
      (= (run (FS FZ) (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) o2)
        (RExit (% (w64_val (reg c2 0)) 256) (Os.out o2)))
      (exact
        (run_exit (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) (+ pc 13) 2 o2
          hrip4
          (hcode4 (+ pc 13) Syscall 2 s3)
          h60)))
    (have hexit2
      (= (run (FS FZ) (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) o2)
        (RExit (% (w64_val v) 256) (Os.out o2)))
      (rw (<- hv))
      (exact hexit))
    (have he2
      (ends_at (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) o2
        (RExit (% (w64_val v) 256) (Os.out o2)))
      (apply (Exists.intro (FS FZ)) ((exact hexit2))))
    (exact
      (ends_first code lo sp hi r f m as (RExit (% (w64_val v) 256) (Os.out o2)) hsize
        (ends_of_comes (link_first code lo sp hi r f m) (os_start as) c2 o2
          (RExit (% (w64_val v) 256) (Os.out o2))
          hrun
          (ends_of_comes c2 o2 (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) o2
            (RExit (% (w64_val v) 256) (Os.out o2))
            (comes_of_reaches c2 (x_mov_ri (x_mov_rr c2 7 0 (w64 (+ pc 8))) 0 60 (w64 (+ pc 13))) o2
              hreach)
            he2))))))

;; the call's row is the first of them
(theorem exit_rows_call
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (pc Nat)
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (h (tail_at tbl pc (exit_rows pc d xt))))
  (= (site tbl pc) (some (Prod.mk (Call d) 5)))
  (exact
    (tail_at_row tbl pc (Prod.mk (Call d) 5)
      (cons (Prod.mk (+ pc 5) (Prod.mk (MovRmR (RmReg 7) 0) 3))
        (cons (Prod.mk (+ pc 8) (Prod.mk (MovRI32 0 60) 5))
          (cons (Prod.mk (+ pc 13) (Prod.mk Syscall 2)) xt)))
      h)))

;; ---- a stretch of the data ------------------------------------------------------------------------
;; a list between two others is held where the first ends (`holds_app`, regs.shard): the words
;; `pre` before it, the words `post` after it
(theorem holds_mid
  ((m Mem)
   (pre (List (BitVec 64)))
   (xs (List (BitVec 64)))
   (post (List (BitVec 64)))
   (b Nat)
   (h (holds m b (app pre (app xs post)))))
  (holds m (+ b (* 8 (List.length pre))) xs)
  (exact
    (And.left
      (holds_app m post xs (+ b (* 8 (List.length pre)))
        (And.right (holds_app m (app xs post) pre b h))))))

;; ---- THE START-UP'S RUN ---------------------------------------------------------------------------
;; the states of a file's start-up: the data pushed; the argument words moved; and the call's
;; return address pushed, the state the function is entered in
(fn start_pushed
  ((data (List (BitVec 64)))
   (code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem))
  Cpu
  (push_state data (link_first code lo sp hi r f m) 4194424))
(fn start_moved
  ((data (List (BitVec 64)))
   (args (List Arg))
   (code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem))
  Cpu
  (arg_state args 0 (start_pushed data code lo sp hi r f m) (start_moves data)))
(fn start_in
  ((data (List (BitVec 64)))
   (args (List Arg))
   (code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem))
  Cpu
  (pushed (start_moved data args code lo sp hi r f m) (w64 (start_ret data args))))
;; What the start-up's run comes to, from the first state c0: the call's target, in a state cin
;; that meets the hypotheses of `realizes` — the table in place, the argument words in their
;; registers, room for k words above f0 under the return address, the range from the data's
;; address s to `top` as `data_ok` asks — and whose memory holds the data from s; the table from
;; the call's address pc on is found as `rest`; and the memory is the first state's but in the
;; words pushed, the return address and the data.
(def entered
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (c0 Cpu)
   (cin Cpu)
   (entry Nat)
   (args (List (BitVec 64)))
   (chi Nat)
   (f0 Nat)
   (k Nat)
   (s Nat)
   (data (List (BitVec 64)))
   (top Nat)
   (pc Nat)
   (rest (List (Prod Nat (Prod Instr Nat)))))
  Prop
  (and (reaches c0 (at_pc cin (w64 entry)))
    (and (code_in cin tbl)
      (and (args_in cin args)
        (and (room cin 4194424 chi f0 k)
          (and (data_ok cin (cons (MkSeg s top 6) nil) 4194424 chi f0 k)
            (and (holds (Cpu.mem cin) s data)
              (and (tail_at tbl pc rest)
                (same_outside (Cpu.mem c0) (Cpu.mem cin) (+ f0 (* 8 k))
                  (+ s (* 8 (List.length data))))))))))))
;; From the first state of the process of ANY code's file where the table is in place and is
;; found, from its first address on, as the start-up's rows: the data's pushes, the moves of the
;; argument words and the call, each by its theorem.
(theorem start_enters
  ((data (List (BitVec 64)))
   (args (List Arg))
   (code (List Nat))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (r Regs)
   (f Flags)
   (m Mem)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (chi Nat)
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (s Nat)
   (f0 Nat)
   (k Nat)
   (top Nat)
   (htp (<= top hi))
   (hsz (< (+ 4194424 (List.length code)) lo))
   (hall (= (all_within tbl 4194424 chi) true))
   (hchi (<= (+ chi 15) lo))
   (hsp (<= sp hi))
   (hhi (<= hi 140737488355328))
   (hn (<= (List.length args) 6))
   (hs (= (+ s (* 8 (List.length data))) sp))
   (hf (= (+ (+ f0 (* 8 k)) 8) s))
   (hlo (<= lo f0))
   (he (= (w64_add (w64 (start_ret data args)) (w64 d)) (w64 entry)))
   (ht (tail_at tbl 4194424 (start_table data args d xt)))
   (hc0 (code_in (link_first code lo sp hi r f m) tbl)))
  (entered tbl (link_first code lo sp hi r f m) (start_in data args code lo sp hi r f m) entry
    (arg_words (w64 s) args)
    chi
    f0
    k
    s
    data
    top
    (start_call data args)
    (exit_rows (start_call data args) d xt))
  (by
    (have r0 (= (Cpu.rip (link_first code lo sp hi r f m)) (w64 4194424)) rfl)
    (have g0 (= (Cpu.segs (link_first code lo sp hi r f m)) (loaded_segs code (MkSeg lo hi 6))) rfl)
    (have htop (<= lo 140737488355328) (arith))
    (have hsp64 (< sp 18446744073709551616) (arith))
    (have v0 (= (w64_val (reg (link_first code lo sp hi r f m) 4)) sp)
      (show (= (Nat.mod sp 18446744073709551616) sp))
      (exact (Nat.mod_eq_of_lt hsp64)))
    (have sp0 (= (w64_val (reg (link_first code lo sp hi r f m) 4)) (+ s (* 8 (List.length data))))
      (rw hs)
      (exact v0))
    (have ht1
      (tail_at tbl 4194424
        (push_rows data 4194424
          (arg_rows args 0 (start_moves data) (exit_rows (start_call data args) d xt))))
      (exact ht))
    (have lo_s (<= lo s) (arith))
    (have hi_s (<= (+ s (* 8 (List.length data))) hi) (rw hs) (exact hsp))
    ;; the data pushed
    (have gp
      (pushed_to tbl code lo hi (link_first code lo sp hi r f m)
        (start_pushed data code lo sp hi r f m)
        (start_moves data)
        (arg_rows args 0 (start_moves data) (exit_rows (start_call data args) d xt))
        s
        data)
      (exact
        (pushes_run code lo hi tbl chi hsz hall hchi htop data (link_first code lo sp hi r f m)
          4194424
          (arg_rows args 0 (start_moves data) (exit_rows (start_call data args) d xt))
          s
          hc0
          r0
          ht1
          g0
          sp0
          lo_s
          hi_s)))
    (have hle (<= (+ 0 (List.length args)) 6) (rw (Nat.zero_add (List.length args))) (exact hn))
    (have hpre (= (regs_of (start_pushed data code lo sp hi r f m) (List.take 0 arg_regs)) nil) rfl)
    ;; the argument words moved
    (have e6 (= (w64_val (reg (start_pushed data code lo sp hi r f m) 4)) s)
      (exact (And.left (And.right (And.right (And.right (And.right (And.right gp))))))))
    (have hspw (= (reg (start_pushed data code lo sp hi r f m) 4) (w64 s))
      (exact (w64_eq_of_val (reg (start_pushed data code lo sp hi r f m) 4) s e6)))
    (have gq
      (moved_to tbl (start_pushed data code lo sp hi r f m)
        (start_moved data args code lo sp hi r f m)
        (start_call data args)
        (exit_rows (start_call data args) d xt)
        (+ 0 (List.length args))
        (app nil (arg_words (w64 s) args)))
      (exact
        (args_run tbl chi lo hall hchi htop (exit_rows (start_call data args) d xt) (w64 s) args
          (start_pushed data code lo sp hi r f m)
          (start_moves data)
          0
          nil
          (And.left (And.right gp))
          (And.left (And.right (And.right gp)))
          (And.left (And.right (And.right (And.right gp))))
          hle
          hpre
          hspw)))
    (have q4 (tail_at tbl (start_call data args) (exit_rows (start_call data args) d xt))
      (exact (And.left (And.right (And.right (And.right gq))))))
    (have sc (= (site tbl (start_call data args)) (some (Prod.mk (Call d) 5)))
      (exact (exit_rows_call tbl (start_call data args) d xt q4)))
    (have pcv
      (= (w64_val (Cpu.rip (start_moved data args code lo sp hi r f m))) (start_call data args))
      (exact
        (rip_at (start_moved data args code lo sp hi r f m) tbl chi lo (start_call data args)
          (Prod.mk (Call d) 5)
          hall
          hchi
          htop
          (And.left (And.right (And.right gq)))
          sc)))
    (have e7
      (= (reg (start_moved data args code lo sp hi r f m) 4)
        (reg (start_pushed data code lo sp hi r f m) 4))
      (exact (And.left (And.right (And.right (And.right (And.right (And.right (And.right gq)))))))))
    (have spA (= (w64_val (reg (start_moved data args code lo sp hi r f m) 4)) (+ (+ f0 (* 8 k)) 8))
      (rw e7)
      (rw e6)
      (exact (Eq.symm hf)))
    (have k8 (< 8 18446744073709551616) (decide))
    (have paA (= (push_at (start_moved data args code lo sp hi r f m)) (+ f0 (* 8 k)))
      (exact
        (w64_val_sub (reg (start_moved data args code lo sp hi r f m) 4) (+ f0 (* 8 k)) 8 spA k8)))
    (have e5
      (= (Cpu.segs (start_moved data args code lo sp hi r f m))
        (Cpu.segs (start_pushed data code lo sp hi r f m)))
      (exact (And.left (And.right (And.right (And.right (And.right gq)))))))
    (have gA
      (= (Cpu.segs (start_moved data args code lo sp hi r f m)) (loaded_segs code (MkSeg lo hi 6)))
      (rw e5)
      (exact (And.left (And.right (And.right (And.right (And.right gp)))))))
    (have loA (<= lo (push_at (start_moved data args code lo sp hi r f m))) (rw paA) (arith))
    (have hiA (<= (+ (push_at (start_moved data args code lo sp hi r f m)) 8) hi) (rw paA) (arith))
    (have mA
      (=
        (mapped (Cpu.segs (start_moved data args code lo sp hi r f m))
          (push_at (start_moved data args code lo sp hi r f m))
          8
          2)
        true)
      (exact (push_mapped code lo hi (start_moved data args code lo sp hi r f m) hsz gA loA hiA)))
    ;; the call
    (have rc
      (reaches (start_moved data args code lo sp hi r f m)
        (at_pc (start_in data args code lo sp hi r f m) (w64 entry)))
      (apply (do_call (start_call data args) 5 d (start_ret data args) entry) ((exact pcv))
        ((exact ((And.left (And.right gq)) (start_call data args) (Call d) 5 sc)))
        ((exact mA))
        (rfl)
        ((exact he))
        ((exact (reaches_refl (at_pc (start_in data args code lo sp hi r f m) (w64 entry)))))))
    ;; the state the function is entered in
    (have cIn (code_in (start_in data args code lo sp hi r f m) tbl)
      (exact
        (code_in_pushed (start_moved data args code lo sp hi r f m) (w64 (start_ret data args)) tbl
          chi
          lo
          hall
          hchi
          loA
          (And.left (And.right gq)))))
    (have gIn
      (= (Cpu.segs (start_in data args code lo sp hi r f m)) (loaded_segs code (MkSeg lo hi 6)))
      (exact gA))
    (have spIn (= (w64_val (reg (start_in data args code lo sp hi r f m) 4)) (+ f0 (* 8 k)))
      (exact paA))
    (have hi2 (<= (+ (+ f0 (* 8 k)) 8) hi) (arith))
    (have d1 (<= (+ f0 (* 8 (+ k 1))) s) (arith))
    (have ra
      (= (regs_of (start_in data args code lo sp hi r f m) arg_regs)
        (regs_of (start_moved data args code lo sp hi r f m) arg_regs))
      rfl)
    (have q8
      (=
        (regs_of (start_moved data args code lo sp hi r f m) (List.take (List.length args) arg_regs))
        (arg_words (w64 s) args))
      (rw (<- (Nat.zero_add (List.length args))))
      (exact (And.right (And.right (And.right (And.right (And.right (And.right (And.right gq)))))))))
    (have hargs (args_in (start_in data args code lo sp hi r f m) (arg_words (w64 s) args))
      (apply And.intro ((rw (arg_words_length (w64 s) args)) (exact hn))
        ((show
           (= (arg_words (w64 s) args)
             (regs_of (start_in data args code lo sp hi r f m)
               (List.take (List.length (arg_words (w64 s) args)) arg_regs))))
         (rw (arg_words_length (w64 s) args))
         (rw (regs_of_take (start_in data args code lo sp hi r f m) arg_regs (List.length args)))
         (rw ra)
         (rw
           (<-
             (regs_of_take (start_moved data args code lo sp hi r f m) arg_regs (List.length args))))
         (exact (Eq.symm q8)))))
    (have e8
      (= (Cpu.mem (start_moved data args code lo sp hi r f m))
        (Cpu.mem (start_pushed data code lo sp hi r f m)))
      (exact (And.left (And.right (And.right (And.right (And.right (And.right gq))))))))
    (have hA (holds (Cpu.mem (start_moved data args code lo sp hi r f m)) s data)
      (rw e8)
      (exact (And.left (And.right (And.right (And.right (And.right (And.right (And.right gp)))))))))
    (have hcl (<= (+ (push_at (start_moved data args code lo sp hi r f m)) 8) s) (rw paA) (arith))
    ;; memory: the data's pushes wrote the data's words, the call's the return address
    (have hko
      (same_outside (Cpu.mem (link_first code lo sp hi r f m))
        (Cpu.mem (start_in data args code lo sp hi r f m))
        (+ f0 (* 8 k))
        (+ s (* 8 (List.length data))))
      (intro x hx)
      (have x1
        (or (< x (push_at (start_moved data args code lo sp hi r f m)))
          (<= (+ (push_at (start_moved data args code lo sp hi r f m)) 8) x))
        (rw paA)
        (cases hx ((inl (h1) (exact (Or.inl h1))) (inr (h2) (apply Or.inr ((arith)))))))
      (have x2 (or (< x s) (<= (+ s (* 8 (List.length data))) x))
        (cases hx ((inl (h1) (apply Or.inl ((arith)))) (inr (h2) (exact (Or.inr h2))))))
      (have i1
        (= (mem_get (Cpu.mem (start_in data args code lo sp hi r f m)) x)
          (mem_get (Cpu.mem (start_moved data args code lo sp hi r f m)) x))
        (exact
          (pushed_outside (start_moved data args code lo sp hi r f m) (w64 (start_ret data args)) x
            x1)))
      (have i2
        (= (mem_get (Cpu.mem (start_pushed data code lo sp hi r f m)) x)
          (mem_get (Cpu.mem (link_first code lo sp hi r f m)) x))
        (exact
          ((And.right (And.right (And.right (And.right (And.right (And.right (And.right gp)))))))
           x
           x2)))
      (rw i1)
      (rw e8)
      (exact i2))
    (exact
      (And.intro
        (reaches_trans (link_first code lo sp hi r f m) (start_moved data args code lo sp hi r f m)
          (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
          (reaches_trans (link_first code lo sp hi r f m) (start_pushed data code lo sp hi r f m)
            (start_moved data args code lo sp hi r f m)
            (And.left gp)
            (And.left gq))
          rc)
        (And.intro cIn
          (And.intro hargs
            (And.intro
              (stack_room code lo hi (start_in data args code lo sp hi r f m) chi f0 k hsz hchi gIn
                spIn
                hlo
                hi2)
              (And.intro
                (stack_data code lo hi (start_in data args code lo sp hi r f m) chi f0 k s top hsz
                  hchi
                  gIn
                  hlo
                  d1
                  htp)
                (And.intro
                  (holds_same (Cpu.mem (start_moved data args code lo sp hi r f m))
                    (Cpu.mem (start_in data args code lo sp hi r f m))
                    (push_at (start_moved data args code lo sp hi r f m))
                    (+ (push_at (start_moved data args code lo sp hi r f m)) 8)
                    s
                    data
                    hA
                    (pushed_outside (start_moved data args code lo sp hi r f m)
                      (w64 (start_ret data args)))
                    (Or.inr hcl))
                  (And.intro q4 hko))))))))))
;; the table in place in the first state: the assembler answered `code` for the listing, and
;; the code ends below the stack
(theorem start_code_first
  ((data (List (BitVec 64)))
   (args (List Arg))
   (l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (ha (= (assemble (start_listing data args l extra)) (some code)))
   (hr (= (resolve (start_listing data args l extra) (start_listing data args l extra) 0) (some is)))
   (hl (= (layout is 4194424) (start_table data args d xt)))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (hsz (< (+ 4194424 (List.length code)) lo))
   (r Regs)
   (f Flags)
   (m Mem))
  (code_in (link_first code lo sp hi r f m) (start_table data args d xt))
  (by
    (have hstk
      (= (seg_holds (Start.stack (start_at lo sp hi r f m)) (+ 4194424 (List.length code)) 1 1)
        false)
      (exact (seg_holds_before lo hi 6 (+ 4194424 (List.length code)) 1 1 hsz)))
    (rw (<- hl))
    (exact
      (listing_loaded (start_listing data args l extra) code is (start_at lo sp hi r f m) ha hr hstk))))

;; ---- THE LINK -------------------------------------------------------------------------------------
;; For ANY data, ANY arguments — at most six —, any lines `extra` after the start-up and
;; any label l its call names. Where the assembler answers `code` for the listing and its
;; instructions lay out to the table with the start-up's rows first (three facts a concrete file
;; gives by computation), the call's displacement leads to `entry`, the table lies in
;; [4194424, chi) and the code ends at or below chi; and the process is started with ANY stack
;; `stack_ok` allows — its range beginning at or above chi + 15, with the data's words, the k
;; words of the function's stack need and the return address under the stack pointer: whatever
;; code realizes an answer at `entry` over that table, for the range from the data's first word
;; to `top` — any address in the stack's range: the data's end, or with what the kernel left
;; above it —, if the answer gives the word v on the arguments' words in any memory that holds
;; the data — at an address where the data ends at or below 2^47, which the theorem gives — and
;; is the start's from the stack pointer up, the code's file exits with v's low byte. The answer
;; is taken on the machine's own memory, which agrees with itself. That the start-up's code is
;; still in place after the call follows from the statement's own memory clause (`kept_code`).
(theorem start_ends_top
  ((data (List (BitVec 64)))
   (args (List Arg))
   (l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (chi Nat)
   (k Nat)
   (ans (-> (List (BitVec 64)) Mem Os Outcome Prop))
   (res Res)
   (as (List Answer))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (top Nat)
   (ha (= (assemble (start_listing data args l extra)) (some code)))
   (hr (= (resolve (start_listing data args l extra) (start_listing data args l extra) 0) (some is)))
   (hl (= (layout is 4194424) (start_table data args d xt)))
   (he (= (w64_add (w64 (start_ret data args)) (w64 d)) (w64 entry)))
   (hw (= (all_within (start_table data args d xt) 4194424 chi) true))
   (hce (<= (+ 4194424 (List.length code)) chi))
   (hst (stack_ok lo sp hi (+ chi 15) (+ (+ (List.length data) k) 1)))
   (hn (<= (List.length args) 6))
   (htp (<= top hi))
   (r Regs)
   (f Flags)
   (m Mem)
   (hreal
     (wrealizes (start_table data args d xt) 4194424 chi entry k
       (cons (MkSeg (start_base sp data) top 6) nil)
       ans))
   (hans
     (forall ((m0 Mem))
       (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
         (holds m0 (start_base sp data) data)
         (same_outside m m0 0 sp)
         (exists ((out Outcome))
           (and (ans (arg_words (w64 (start_base sp data)) args) m0 (os_start as) out)
             (= (exit_of out) res)))))))
  (ends (elf_exec code) (start_at lo sp hi r f m) as res)
  (by
    ;; what `stack_ok` says, a fact at a time
    (have hchi (<= (+ chi 15) lo) (exact (And.left hst)))
    (have hfit (<= (+ lo (* 8 (+ (+ (List.length data) k) 1))) sp)
      (exact (And.left (And.right hst))))
    (have hsp (<= sp hi) (exact (And.left (And.right (And.right hst)))))
    (have hhi (<= hi 140737488355328) (exact (And.right (And.right (And.right hst)))))
    (have hsz (< (+ 4194424 (List.length code)) lo) (arith))
    (have htop (<= lo 140737488355328) (arith))
    (have hc0 (code_in (link_first code lo sp hi r f m) (start_table data args d xt))
      (exact (start_code_first data args l extra code is d xt ha hr hl lo sp hi hsz r f m)))
    ;; the data stands under the first stack pointer, the return address under the data, and the
    ;; function's k words, the lowest at f0, under that
    (have le1 (<= (* 8 (List.length data)) sp) (arith))
    (have hs (= (+ (start_base sp data) (* 8 (List.length data))) sp)
      (exact (Nat.sub_add_cancel le1)))
    (have le2 (<= (+ (* 8 (List.length data)) (+ (* 8 k) 8)) sp) (arith))
    (have hf0
      (=
        (+ (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
          (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
        sp)
      (exact (Nat.sub_add_cancel le2)))
    (have hf
      (= (+ (+ (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8))) (* 8 k)) 8) (start_base sp data))
      (arith hs hf0))
    (have hlo (<= lo (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))) (arith hf0))
    (have ge
      (entered (start_table data args d xt) (link_first code lo sp hi r f m)
        (start_in data args code lo sp hi r f m)
        entry
        (arg_words (w64 (start_base sp data)) args)
        chi
        (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
        k
        (start_base sp data)
        data
        top
        (start_call data args)
        (exit_rows (start_call data args) d xt))
      (exact
        (start_enters data args code lo sp hi r f m (start_table data args d xt) chi d xt entry
          (start_base sp data)
          (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
          k
          top
          htp
          hsz
          hw
          hchi
          hsp
          hhi
          hn
          hs
          hf
          hlo
          he
          (tail_at_all (start_table data args d xt) 4194424)
          hc0)))
    (have hroom
      (room (start_in data args code lo sp hi r f m) 4194424 chi
        (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
        k)
      (exact (And.left (And.right (And.right (And.right ge))))))
    (have hdata
      (data_ok (start_in data args code lo sp hi r f m)
        (cons (MkSeg (start_base sp data) top 6) nil)
        4194424
        chi
        (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
        k)
      (exact (And.left (And.right (And.right (And.right (And.right ge)))))))
    (have hag
      (agree (cons (MkSeg (start_base sp data) top 6) nil)
        (Cpu.mem (start_in data args code lo sp hi r f m))
        (Cpu.mem (start_in data args code lo sp hi r f m)))
      (intro x need h)
      rfl)
    (have hbnd (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
      (rw hs)
      (arith))
    ;; from the stack pointer up the memory is the start's: the image lies below the stack, and
    ;; the start-up wrote below the stack pointer
    (have hsame (same_outside m (Cpu.mem (start_in data args code lo sp hi r f m)) 0 sp)
      (intro x hx)
      (cases hx
        ((inl (h1) (exact (absurd h1 (Nat.not_lt_zero x))))
         (inr (h2)
           (have y1
             (or (< x (+ (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8))) (* 8 k)))
               (<= (+ (start_base sp data) (* 8 (List.length data))) x))
             (apply Or.inr ((rw hs) (exact h2))))
           (have y2 (<= (+ 4194424 (List.length code)) x) (arith))
           (have i1
             (= (mem_get (Cpu.mem (start_in data args code lo sp hi r f m)) x)
               (mem_get (Cpu.mem (link_first code lo sp hi r f m)) x))
             (exact
               ((And.right
                  (And.right (And.right (And.right (And.right (And.right (And.right ge)))))))
                x
                y1)))
           (rw i1)
           (exact (first_above code lo sp hi r f m x y2))))))
    (have hsize (<= (+ 4194424 (List.length code)) 140737488355328) (arith))
    (have hcall
      (comes (link_first code lo sp hi r f m) (os_start as)
        (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
        (os_start as))
      (exact
        (comes_of_reaches (link_first code lo sp hi r f m)
          (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
          (os_start as)
          (And.left ge))))
    (cases
      (hans (Cpu.mem (start_in data args code lo sp hi r f m)) hbnd
        (And.left (And.right (And.right (And.right (And.right (And.right ge))))))
        hsame)
      ((intro (out hma)
         (have hd
           (arrives (cons (MkSeg (start_base sp data) top 6) nil)
             (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
             k
             (start_in data args code lo sp hi r f m)
             (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
             (os_start as)
             out)
           (exact
             (hreal (start_in data args code lo sp hi r f m)
               (arg_words (w64 (start_base sp data)) args)
               (Cpu.mem (start_in data args code lo sp hi r f m))
               (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
               (os_start as)
               out
               (And.left (And.right ge))
               (And.left (And.right (And.right ge)))
               hroom
               hdata
               hag
               (And.left hma))))
         (have fin
           (->
             (arrives (cons (MkSeg (start_base sp data) top 6) nil)
               (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
               k
               (start_in data args code lo sp hi r f m)
               (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
               (os_start as)
               out)
             (-> (= (exit_of out) res) (ends (elf_exec code) (start_at lo sp hi r f m) as res)))
           (cases out
             ((ORet (v m2 o2)
                (show
                  (->
                    (rets (cons (MkSeg (start_base sp data) top 6) nil)
                      (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
                      k
                      (start_in data args code lo sp hi r f m)
                      (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
                      (os_start as)
                      v
                      m2
                      o2)
                    (-> (= (RExit (% (w64_val v) 256) (Os.out o2)) res)
                      (ends (elf_exec code) (start_at lo sp hi r f m) as res))))
                (intro gg hres)
                (cases gg
                  ((intro (c2 h)
                     (have hrun (comes (link_first code lo sp hi r f m) (os_start as) c2 o2)
                       (exact
                         (comes_trans (link_first code lo sp hi r f m) (os_start as)
                           (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
                           (os_start as)
                           c2
                           o2
                           hcall
                           (And.left h))))
                     (have hv (= (reg c2 0) v) (exact (And.left (And.right h))))
                     (have hkm
                       (kept_mem (cons (MkSeg (start_base sp data) top 6) nil)
                         (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
                         k
                         (Cpu.mem (start_in data args code lo sp hi r f m))
                         (Cpu.mem c2))
                       (exact (And.left (And.right (And.right (And.right h))))))
                     (have hret (returned (start_in data args code lo sp hi r f m) c2)
                       (exact (And.right (And.right (And.right (And.right h))))))
                     (have hcode2 (code_in c2 (start_table data args d xt))
                       (exact
                         (kept_code (start_in data args code lo sp hi r f m) c2
                           (start_table data args d xt)
                           (cons (MkSeg (start_base sp data) top 6) nil)
                           4194424
                           chi
                           (- sp (+ (* 8 (List.length data)) (+ (* 8 k) 8)))
                           k
                           hw
                           hroom
                           hdata
                           hkm
                           hret
                           (And.left (And.right ge)))))
                     (have hra
                       (= (ret_addr (start_in data args code lo sp hi r f m))
                         (w64 (start_ret data args)))
                       (exact
                         (ret_addr_pushed (start_moved data args code lo sp hi r f m)
                           (w64 (start_ret data args)))))
                     (have hrip2 (= (Cpu.rip c2) (w64 (+ (start_call data args) 5)))
                       (rw (returned_at (start_in data args code lo sp hi r f m) c2 hret))
                       (exact hra))
                     (rw (<- hres))
                     (exact
                       (exit_ends code lo sp hi r f m (start_table data args d xt) chi c2 o2 as v
                         (start_call data args)
                         d
                         xt
                         hsz
                         hw
                         hchi
                         htop
                         hrun
                         hv
                         hcode2
                         hrip2
                         (And.left
                           (And.right (And.right (And.right (And.right (And.right (And.right ge)))))))))))))
              (OEnd (e0)
                (show
                  (->
                    (ends_at (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
                      (os_start as)
                      e0)
                    (-> (= e0 res) (ends (elf_exec code) (start_at lo sp hi r f m) as res))))
                (intro gg hres)
                (rw (<- hres))
                (exact
                  (ends_first code lo sp hi r f m as e0 hsize
                    (ends_of_comes (link_first code lo sp hi r f m) (os_start as)
                      (at_pc (start_in data args code lo sp hi r f m) (w64 entry))
                      (os_start as)
                      e0
                      hcall
                      gg)))))))
         (exact (fin hd (And.right hma))))))))

;; The same for an answer that names nothing outside the process: whatever the kernel would
;; answer a call, the file exits with v's low byte and writes nothing.
(theorem start_exits_top
  ((data (List (BitVec 64)))
   (args (List Arg))
   (l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (chi Nat)
   (k Nat)
   (ans (-> (List (BitVec 64)) Mem (BitVec 64) Mem Prop))
   (v (BitVec 64))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (top Nat)
   (ha (= (assemble (start_listing data args l extra)) (some code)))
   (hr (= (resolve (start_listing data args l extra) (start_listing data args l extra) 0) (some is)))
   (hl (= (layout is 4194424) (start_table data args d xt)))
   (he (= (w64_add (w64 (start_ret data args)) (w64 d)) (w64 entry)))
   (hw (= (all_within (start_table data args d xt) 4194424 chi) true))
   (hce (<= (+ 4194424 (List.length code)) chi))
   (hst (stack_ok lo sp hi (+ chi 15) (+ (+ (List.length data) k) 1)))
   (hn (<= (List.length args) 6))
   (htp (<= top hi))
   (r Regs)
   (f Flags)
   (m Mem)
   (hreal
     (realizes (start_table data args d xt) 4194424 chi entry k
       (cons (MkSeg (start_base sp data) top 6) nil)
       ans))
   (hans
     (forall ((m0 Mem))
       (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
         (holds m0 (start_base sp data) data)
         (same_outside m m0 0 sp)
         (exists ((m2 Mem)) (ans (arg_words (w64 (start_base sp data)) args) m0 v m2))))))
  (exits (elf_exec code) (start_at lo sp hi r f m) (% (w64_val v) 256))
  (by
    (intro as)
    (have hans2
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
          (holds m0 (start_base sp data) data)
          (same_outside m m0 0 sp)
          (exists ((out Outcome))
            (and (lift_ans ans (arg_words (w64 (start_base sp data)) args) m0 (os_start as) out)
              (= (exit_of out) (RExit (% (w64_val v) 256) nil))))))
      (intro m0 hb hh hs)
      (cases (hans m0 hb hh hs)
        ((intro (m2 hma)
           (apply (Exists.intro (ORet v m2 (os_start as)))
             ((apply And.intro
                ((apply (Exists.intro v) ((apply (Exists.intro m2) ((exact (And.intro hma rfl)))))))
                (rfl))))))))
    (exact
      (start_ends_top data args l extra code is d xt entry chi k (lift_ans ans)
        (RExit (% (w64_val v) 256) nil)
        as
        lo
        sp
        hi
        top
        ha
        hr
        hl
        he
        hw
        hce
        hst
        hn
        htp
        r
        f
        m
        (realizes_lift (start_table data args d xt) 4194424 chi entry k
          (cons (MkSeg (start_base sp data) top 6) nil)
          ans
          hreal)
        hans2))))

;; The same for the data's range alone, the answer asked of nothing above the data: what a file
;; that takes no arguments from its kernel is linked by.
(theorem start_exits
  ((data (List (BitVec 64)))
   (args (List Arg))
   (l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (chi Nat)
   (k Nat)
   (ans (-> (List (BitVec 64)) Mem (BitVec 64) Mem Prop))
   (v (BitVec 64))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (ha (= (assemble (start_listing data args l extra)) (some code)))
   (hr (= (resolve (start_listing data args l extra) (start_listing data args l extra) 0) (some is)))
   (hl (= (layout is 4194424) (start_table data args d xt)))
   (he (= (w64_add (w64 (start_ret data args)) (w64 d)) (w64 entry)))
   (hw (= (all_within (start_table data args d xt) 4194424 chi) true))
   (hce (<= (+ 4194424 (List.length code)) chi))
   (hst (stack_ok lo sp hi (+ chi 15) (+ (+ (List.length data) k) 1)))
   (hn (<= (List.length args) 6))
   (hreal (realizes (start_table data args d xt) 4194424 chi entry k (start_rs sp data) ans))
   (hans
     (forall ((m0 Mem))
       (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
         (holds m0 (start_base sp data) data)
         (exists ((m2 Mem)) (ans (arg_words (w64 (start_base sp data)) args) m0 v m2)))))
   (r Regs)
   (f Flags)
   (m Mem))
  (exits (elf_exec code) (start_at lo sp hi r f m) (% (w64_val v) 256))
  (by
    (have hfit (<= (+ lo (* 8 (+ (+ (List.length data) k) 1))) sp)
      (exact (And.left (And.right hst))))
    (have hsp (<= sp hi) (exact (And.left (And.right (And.right hst)))))
    (have le1 (<= (* 8 (List.length data)) sp) (arith))
    (have hs (= (+ (start_base sp data) (* 8 (List.length data))) sp)
      (exact (Nat.sub_add_cancel le1)))
    (have htp (<= (+ (start_base sp data) (* 8 (List.length data))) hi) (rw hs) (exact hsp))
    (have hreal2
      (realizes (start_table data args d xt) 4194424 chi entry k
        (cons (MkSeg (start_base sp data) (+ (start_base sp data) (* 8 (List.length data))) 6) nil)
        ans)
      (exact hreal))
    (have hans2
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
          (holds m0 (start_base sp data) data)
          (same_outside m m0 0 sp)
          (exists ((m2 Mem)) (ans (arg_words (w64 (start_base sp data)) args) m0 v m2))))
      (intro m0 hb hh hsm)
      (exact (hans m0 hb hh)))
    (exact
      (start_exits_top data args l extra code is d xt entry chi k ans v lo sp hi
        (+ (start_base sp data) (* 8 (List.length data)))
        ha
        hr
        hl
        he
        hw
        hce
        hst
        hn
        htp
        r
        f
        m
        hreal2
        hans2))))


;; The same for a function whose answer is given on what is outside the process as well: the
;; file ends as the outcome of the function's code says.
(theorem start_ends
  ((data (List (BitVec 64)))
   (args (List Arg))
   (l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (chi Nat)
   (k Nat)
   (ans (-> (List (BitVec 64)) Mem Os Outcome Prop))
   (res Res)
   (as (List Answer))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (ha (= (assemble (start_listing data args l extra)) (some code)))
   (hr (= (resolve (start_listing data args l extra) (start_listing data args l extra) 0) (some is)))
   (hl (= (layout is 4194424) (start_table data args d xt)))
   (he (= (w64_add (w64 (start_ret data args)) (w64 d)) (w64 entry)))
   (hw (= (all_within (start_table data args d xt) 4194424 chi) true))
   (hce (<= (+ 4194424 (List.length code)) chi))
   (hst (stack_ok lo sp hi (+ chi 15) (+ (+ (List.length data) k) 1)))
   (hn (<= (List.length args) 6))
   (hreal (wrealizes (start_table data args d xt) 4194424 chi entry k (start_rs sp data) ans))
   (hans
     (forall ((m0 Mem))
       (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
         (holds m0 (start_base sp data) data)
         (exists ((out Outcome))
           (and (ans (arg_words (w64 (start_base sp data)) args) m0 (os_start as) out)
             (= (exit_of out) res))))))
   (r Regs)
   (f Flags)
   (m Mem))
  (ends (elf_exec code) (start_at lo sp hi r f m) as res)
  (by
    (have hfit (<= (+ lo (* 8 (+ (+ (List.length data) k) 1))) sp)
      (exact (And.left (And.right hst))))
    (have hsp (<= sp hi) (exact (And.left (And.right (And.right hst)))))
    (have le1 (<= (* 8 (List.length data)) sp) (arith))
    (have hs (= (+ (start_base sp data) (* 8 (List.length data))) sp)
      (exact (Nat.sub_add_cancel le1)))
    (have htp (<= (+ (start_base sp data) (* 8 (List.length data))) hi) (rw hs) (exact hsp))
    (have hreal2
      (wrealizes (start_table data args d xt) 4194424 chi entry k
        (cons (MkSeg (start_base sp data) (+ (start_base sp data) (* 8 (List.length data))) 6) nil)
        ans)
      (exact hreal))
    (have hans2
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp data) (* 8 (List.length data))) 140737488355328)
          (holds m0 (start_base sp data) data)
          (same_outside m m0 0 sp)
          (exists ((out Outcome))
            (and (ans (arg_words (w64 (start_base sp data)) args) m0 (os_start as) out)
              (= (exit_of out) res)))))
      (intro m0 hb hh hsm)
      (exact (hans m0 hb hh)))
    (exact
      (start_ends_top data args l extra code is d xt entry chi k ans res as lo sp hi
        (+ (start_base sp data) (* 8 (List.length data)))
        ha
        hr
        hl
        he
        hw
        hce
        hst
        hn
        htp
        r
        f
        m
        hreal2
        hans2))))
;; ---- the sample -----------------------------------------------------------------------------------
;; THE LINK for the sample's two buffers (startup.shard): a stack with seven words more than
;; the function needs — the data's six and the return address —; the answer is asked on the
;; sample's argument words in any memory that holds the two buffers, the second from the data's
;; address `link_base` and the first three words above it.
(theorem link_exits
  ((l Nat)
   (extra (List Asm))
   (code (List Nat))
   (is (List Instr))
   (d Nat)
   (xt (List (Prod Nat (Prod Instr Nat))))
   (entry Nat)
   (chi Nat)
   (k Nat)
   (ans (-> (List (BitVec 64)) Mem (BitVec 64) Mem Prop))
   (v (BitVec 64))
   (lo Nat)
   (sp Nat)
   (hi Nat)
   (ha (= (assemble (link_listing l extra)) (some code)))
   (hr (= (resolve (link_listing l extra) (link_listing l extra) 0) (some is)))
   (hl (= (layout is 4194424) (link_table d xt)))
   (he (= (w64_add (w64 4194537) (w64 d)) (w64 entry)))
   (hw (= (all_within (link_table d xt) 4194424 chi) true))
   (hce (<= (+ 4194424 (List.length code)) chi))
   (hst (stack_ok lo sp hi (+ chi 15) (+ k 7)))
   (hreal (realizes (link_table d xt) 4194424 chi entry k (link_rs sp) ans))
   (hans
     (forall ((m0 Mem))
       (-> (<= (+ (link_base sp) 48) 140737488355328) (holds m0 (+ (link_base sp) 24) link_xs)
         (holds m0 (link_base sp) link_ys)
         (exists ((m2 Mem)) (ans (link_args sp) m0 v m2)))))
   (r Regs)
   (f Flags)
   (m Mem))
  (exits (elf_exec code) (start_at lo sp hi r f m) (% (w64_val v) 256))
  (by
    (have hn (<= (List.length link_argd) 6) (decide))
    (have hfit (<= (+ lo (* 8 (+ k 7))) sp) (exact (And.left (And.right hst))))
    (have hfit2 (<= (+ lo (* 8 (+ (+ 6 k) 1))) sp) (arith))
    (have hst2 (stack_ok lo sp hi (+ chi 15) (+ (+ (List.length link_data) k) 1))
      (exact (And.intro (And.left hst) (And.intro hfit2 (And.right (And.right hst))))))
    (have hans2
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp link_data) (* 8 (List.length link_data))) 140737488355328)
          (holds m0 (start_base sp link_data) link_data)
          (exists ((m2 Mem)) (ans (arg_words (w64 (start_base sp link_data)) link_argd) m0 v m2))))
      (intro m0 hb h)
      (have h6 (holds m0 (link_base sp) (app link_ys link_xs)) (exact h))
      (cases (holds_app m0 link_xs link_ys (link_base sp) h6)
        ((intro (hy hx0) (have hx (holds m0 (+ (link_base sp) 24) link_xs) (exact hx0))
           (exact (hans m0 hb hx hy))))))
    (exact
      (start_exits link_data link_argd l extra code is d xt entry chi k ans v lo sp hi ha hr hl he
        hw hce hst2 hn hreal hans2 r f m))))
