;;; v3/compile/x86/sqdiff_hand_file.shard — `sqdiff` compiled, in a file with the HAND-WRITTEN
;;; `dot` (docs/COMPILE.md §5, linking). After the start-up (startup.shard) stand `dot`'s ten
;;; instructions as an author wrote them (v3/models/x86/buffers.shard `dot_asm`), at 4194547,
;;; where its contract was proven; the module of ../sqdiff_obj.shard goes through the pass at
;;; 4194584, the address after them, with `dot` as its one outside function: entered at
;;; 4194547, a stack need of no word. The start-up's call goes to label 4 — `dot`'s lines have
;;; 1 to 3 —, before the instruction at `sqdiff`'s entry. Here are the listing, the table, the
;;; file's bytes, and every fact of the assembled file that the theorems ask for, each closed
;;; by computation; names begin `sqh_`. That the file exits with `sqdiff`'s value is
;;; sqdiff_hand_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "../sqdiff_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/part.shard")
(use compile.sqdiff_obj)
(use compile.x86.code)
(use compile.x86.startup)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.buffers)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.part)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- compiled -----------------------------------------------------------------------------------
;; the module's outside functions, each by its entry and its stack need: `dot`
(fn sqh_outs () (List (Prod Nat Nat)) (cons (Prod.mk 4194547 0) nil))
(fn sqh_listing () (List Instr)
  (match (compile sqh_outs sqdiff_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn sqh_entries () (List (Prod Nat Nat))
  (match (compile sqh_outs sqdiff_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem sqh_compiled ()
  (= (compile sqh_outs sqdiff_prog 4194584) (some (Prod.mk sqh_listing sqh_entries)))
  (by rfl))
;; `sqdiff`'s entry as the pass answered it, and the words of stack it needs
(fn sqh_at () Nat
  (match (pair_at sqh_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn sqh_need () Nat
  (match (pair_at sqh_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem sqh_entry () (= (pair_at sqh_entries 0) (some (Prod.mk sqh_at sqh_need))) (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
;; `dot`'s lines, then the compiled instructions as lines, label 4 before the one at `sqdiff`'s
;; entry
(fn sqh_lines () (List Asm) (List.append dot_asm (label_at sqh_listing 4194584 sqh_at 4)))
;; the file's table: the start-up's rows, its call's displacement d, `dot`'s rows, then the
;; compiled instructions laid out from 4194584
(fn sqh_d () Nat (rel sqh_at 4194537))
(fn sqh_xt () (List (Prod Nat (Prod Instr Nat)))
  (List.append dot_rows (layout sqh_listing 4194584)))
(fn sqh_tbl () (List (Prod Nat (Prod Instr Nat))) (link_table sqh_d sqh_xt))
(fn sqh_chi () Nat (+ 4194584 (isize sqh_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn sqh_image () (List Nat)
  (match (assemble (link_listing 4 sqh_lines))
    (none nil)
    ((some code) code)))
(fn sqh_instrs () (List Instr)
  (match (resolve (link_listing 4 sqh_lines) (link_listing 4 sqh_lines) 0)
    (none nil)
    ((some is) is)))
(theorem sqh_assembled () (= (assemble (link_listing 4 sqh_lines)) (some sqh_image)) (by rfl))
(theorem sqh_resolved ()
  (= (resolve (link_listing 4 sqh_lines) (link_listing 4 sqh_lines) 0) (some sqh_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches `sqdiff`,
;; `dot`'s lines are `dot`'s rows, and the lines after them the compiled listing
(theorem sqh_laid () (= (layout sqh_instrs 4194424) sqh_tbl) (by rfl))
(theorem sqh_target () (= (w64_add (w64 4194537) (w64 sqh_d)) (w64 sqh_at)) (by rfl))
(theorem sqh_within () (= (all_within sqh_tbl 4194424 sqh_chi) true) (by rfl))
;; the code ends at or below the table's end
(theorem sqh_code_end () (<= (+ 4194424 (List.length sqh_image)) sqh_chi) (by decide))
(theorem sqh_chi_word () (<= (+ sqh_chi 15) 18446744073709551616) (by decide))
;; the compiled listing stands in the table at 4194584
(theorem sqh_placedb () (= (placedb sqh_tbl 4194584 sqh_listing) true) (by decide))
(theorem sqh_placed () (placed sqh_tbl 4194584 sqh_listing)
  (exact (placedb_ok sqh_tbl sqh_listing 4194584 sqh_placedb)))
;; and `dot`'s rows are rows of it, so what was proven over them holds in this file
(theorem sqh_dot_rows () (= (table_part dot_rows sqh_tbl) true) (by rfl))
