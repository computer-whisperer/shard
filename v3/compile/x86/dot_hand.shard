;;; v3/compile/x86/dot_hand.shard — the hand-written `dot` at a module's seam (docs/COMPILE.md
;;; §5): the ten instructions of v3/models/x86/buffers.shard, as an author proved them
;;; (`dot_contract`, buffers_facts.shard), realize the answer a caller outside runs with —
;;; `dot_ans` (../dot_lo.shard), the low form's value where the evidence about the two buffers
;;; exists — with no stack of their own, in any file whose table has their rows. The contract
;;; speaks of two lists held in the machine's memory; the answer is taken on any memory the
;;; machine's agrees with on the data ranges. So the contract is given the lists read out of
;;; the machine's memory; the low form on that memory is the meaning of those lists
;;; (`dot_lo_means`, ../dot_mean.shard); and the low form reads nothing outside the ranges, so
;;; its value is the same on both memories.
(import "seam_laws.shard")
(import "../dot_mean.shard")
(import "../../models/x86/buffers_facts.shard")
(use std.mem)
(use compile.dot_lo)
(use compile.dot_mean)
(use compile.lo)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use models.x86.buffers)
(use models.x86.buffers_facts)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the low form reads the ranges alone ----------------------------------------------------------
;; a read is the same in two memories that agree on the ranges
(theorem rd64_agree
  ((rs (List Seg))
   (m Mem)
   (mc Mem)
   (a (BitVec 64))
   (h (= (mapped rs (w64_val a) 8 4) true))
   (hag (agree rs m mc)))
  (= (rd64 rs mc a h) (rd64 rs m a h))
  (by
    (show (= (w64 (mem_le64 mc (w64_val a))) (w64 (mem_le64 m (w64_val a)))))
    (rw (agree_le64 rs m mc (w64_val a) 4 hag h))
    rfl))
;; and so is the loop's value, and `dot_lo`'s
(theorem dot_lo_go_agree
  ((rs (List Seg))
   (m Mem)
   (mc Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (hag (agree rs m mc))
   (k Nat))
  (forall ((i (BitVec 64)) (acc (BitVec 64)))
    (-> (= (- (w64_val n) (w64_val i)) k)
      (= (dot_lo_go rs mc px py n ex ey i acc) (dot_lo_go rs m px py n ex ey i acc))))
  (by
    (wf k k ih (intro i acc hk)
      (cases (Nat.decLt (w64_val i) (w64_val n))
        ((isFalse (h) (rw (dot_lo_go_done rs mc px py n ex ey i acc h))
           (rw (dot_lo_go_done rs m px py n ex ey i acc h))
           rfl)
         (isTrue (h)
           (have hdec (< (- (w64_val n) (w64_val (w64_add i (w64 1)))) k)
             (rw (<- hk))
             (exact (loop_descends n i h)))
           (rw (dot_lo_go_turn rs mc px py n ex ey i acc h))
           (rw (dot_lo_go_turn rs m px py n ex ey i acc h))
           (rw (rd64_agree rs m mc (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h) hag))
           (rw (rd64_agree rs m mc (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h) hag))
           (exact
             (ih (- (w64_val n) (w64_val (w64_add i (w64 1)))) hdec (w64_add i (w64 1))
               (w64_add acc
                 (w64_mul (rd64 rs m (w64_add px (w64_mul (w64 8) i)) (at8_ok rs px n 4 i ex h))
                   (rd64 rs m (w64_add py (w64_mul (w64 8) i)) (at8_ok rs py n 4 i ey h))))
               (Eq.refl (- (w64_val n) (w64_val (w64_add i (w64 1)))))))))))))
(theorem dot_lo_agree
  ((rs (List Seg))
   (m Mem)
   (mc Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (hag (agree rs m mc)))
  (= (dot_lo rs mc px py n ex ey) (dot_lo rs m px py n ex ey))
  (exact
    (dot_lo_go_agree rs m mc px py n ex ey hag (- (w64_val n) (w64_val (w64 0))) (w64 0) (w64 0)
      (Eq.refl (- (w64_val n) (w64_val (w64 0)))))))

;; ---- the statement, on three words that have the evidence -----------------------------------------
(theorem dot_hand_core
  ((rs (List Seg))
   (clo Nat)
   (chi Nat)
   (c Cpu)
   (vs (List (BitVec 64)))
   (m Mem)
   (f Nat)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (hcode (code_in c dot_rows))
   (hargs (args_in c vs))
   (hroom (room c clo chi f 0))
   (hdata (data_ok c rs clo chi f 0))
   (hag (agree rs m (Cpu.mem c)))
   (hvs (= vs (cons px (cons py (cons n nil))))))
  (exists ((c2 Cpu))
    (and (reaches (at_pc c (w64 4194489)) c2)
      (and (= (reg c2 0) (dot_lo rs m px py n ex ey))
        (and (agree rs m (Cpu.mem c2))
          (and (kept_mem rs f 0 (Cpu.mem c) (Cpu.mem c2)) (returned c c2))))))
  (by
    ;; the three words are the three argument registers'
    (have ha (args_in c (cons px (cons py (cons n nil)))) (rw (<- hvs)) (exact hargs))
    (have he
      (= (cons px (cons py (cons n nil))) (cons (reg c 7) (cons (reg c 6) (cons (reg c 2) nil))))
      (exact (And.right ha)))
    (have e0 (= px (reg c 7)) (exact (congrArg (fun ((l (List (BitVec 64)))) (nth l 0)) he)))
    (have e1 (= py (reg c 6)) (exact (congrArg (fun ((l (List (BitVec 64)))) (nth l 1)) he)))
    (have e2 (= n (reg c 2)) (exact (congrArg (fun ((l (List (BitVec 64)))) (nth l 2)) he)))
    ;; the lists the contract is given: the n words the machine's memory has at each address
    (have zx
      (holds (Cpu.mem c) (w64_val (reg c 7)) (read_words (Cpu.mem c) (w64_val px) (w64_val n)))
      (rw (<- e0))
      (exact (holds_read_words (Cpu.mem c) (w64_val n) (w64_val px))))
    (have zy
      (holds (Cpu.mem c) (w64_val (reg c 6)) (read_words (Cpu.mem c) (w64_val py) (w64_val n)))
      (rw (<- e1))
      (exact (holds_read_words (Cpu.mem c) (w64_val n) (w64_val py))))
    ;; the ranges' evidence, in the machine's own mapping
    (have mx (mapped_words rs (w64_val px) (w64_val n) 4) (exact (And.left ex)))
    (have my (mapped_words rs (w64_val py) (w64_val n) 4) (exact (And.left ey)))
    (have hmx (mapped_words (Cpu.segs c) (w64_val (reg c 7)) (w64_val n) 4)
      (rw (<- e0))
      (intro k hk)
      (exact (And.left (hdata (+ (w64_val px) (* 8 k)) 8 4 (mx k hk)))))
    (have hmy (mapped_words (Cpu.segs c) (w64_val (reg c 6)) (w64_val n) 4)
      (rw (<- e1))
      (intro k hk)
      (exact (And.left (hdata (+ (w64_val py) (* 8 k)) 8 4 (my k hk)))))
    (have hwx (<= (+ (w64_val (reg c 7)) (* 8 (w64_val n))) 18446744073709551616)
      (rw (<- e0))
      (exact (And.right ex)))
    (have hwy (<= (+ (w64_val (reg c 6)) (* 8 (w64_val n))) 18446744073709551616)
      (rw (<- e1))
      (exact (And.right ey)))
    ;; the return address is mapped to read
    (have hsp0 (= (w64_val (reg c 4)) (+ f (* 8 0))) (exact (And.left hroom)))
    (have hrd (mapped_words (Cpu.segs c) f (+ 0 1) 4) (exact (And.left (And.right hroom))))
    (have h01 (< 0 (+ 0 1)) (decide))
    (have hsp (= (mapped (Cpu.segs c) (w64_val (reg c 4)) 8 4) true) (rw hsp0) (exact (hrd 0 h01)))
    ;; what the code computes of the machine's memory is the low form's value on m
    (have hmean
      (= (dot_lo rs (Cpu.mem c) px py n ex ey)
        (dot (read_words (Cpu.mem c) (w64_val px) (w64_val n))
          (read_words (Cpu.mem c) (w64_val py) (w64_val n))
          n
          (read_words_room (Cpu.mem c) (w64_val px) (w64_val n))
          (read_words_room (Cpu.mem c) (w64_val py) (w64_val n))))
      (exact
        (dot_lo_means rs (Cpu.mem c) px py n ex ey (read_words (Cpu.mem c) (w64_val px) (w64_val n))
          (read_words (Cpu.mem c) (w64_val py) (w64_val n))
          (read_words_room (Cpu.mem c) (w64_val px) (w64_val n))
          (read_words_room (Cpu.mem c) (w64_val py) (w64_val n))
          (holds_read_words (Cpu.mem c) (w64_val n) (w64_val px))
          (holds_read_words (Cpu.mem c) (w64_val n) (w64_val py)))))
    (have hsame (= (dot_lo rs (Cpu.mem c) px py n ex ey) (dot_lo rs m px py n ex ey))
      (exact (dot_lo_agree rs m (Cpu.mem c) px py n ex ey hag)))
    (cases
      (dot_contract (read_words (Cpu.mem c) (w64_val px) (w64_val n))
        (read_words (Cpu.mem c) (w64_val py) (w64_val n))
        n
        (read_words_room (Cpu.mem c) (w64_val px) (w64_val n))
        (read_words_room (Cpu.mem c) (w64_val py) (w64_val n))
        c
        hcode
        (Eq.symm e2)
        zx
        zy
        hmx
        hmy
        hwx
        hwy
        hsp)
      ((intro (c2 hc)
         (have hv2
           (= (reg c2 0)
             (dot (read_words (Cpu.mem c) (w64_val px) (w64_val n))
               (read_words (Cpu.mem c) (w64_val py) (w64_val n))
               n
               (read_words_room (Cpu.mem c) (w64_val px) (w64_val n))
               (read_words_room (Cpu.mem c) (w64_val py) (w64_val n))))
           (exact (And.left (And.right hc))))
         (have hmem (= (Cpu.mem c2) (Cpu.mem c)) (exact (And.left (And.right (And.right hc)))))
         (have hag2 (agree rs m (Cpu.mem c2)) (rw hmem) (exact hag))
         (have hkm (kept_mem rs f 0 (Cpu.mem c) (Cpu.mem c2))
           (rw hmem)
           (exact (kept_refl rs f 0 (Cpu.mem c))))
         (apply (Exists.intro c2)
           ((exact
              (And.intro (And.left hc)
                (And.intro (Eq.trans hv2 (Eq.trans (Eq.symm hmean) hsame))
                  (And.intro hag2 (And.intro hkm (And.right (And.right (And.right hc)))))))))))))))

;; ---- THE HAND-WRITTEN `dot` REALIZES `dot_ans` ---------------------------------------------------
;; its own rows, at their addresses, with a stack need of no word, for any data ranges and in any
;; code range
(theorem dot_hand_realizes ((rs (List Seg)) (clo Nat) (chi Nat))
  (realizes dot_rows clo chi 4194489 0 rs (dot_ans rs))
  (by
    (intro c vs v m m2 f hcode hargs hroom hdata hag hans)
    (cases (dot_ans_inv rs vs m v m2 hans)
      ((intro (ok hh) (rw (And.left hh)) (rw (And.right hh))
         (exact
           (dot_hand_core rs clo chi c vs m f (nth vs 0) (nth vs 1) (nth vs 2)
             (And.left (And.right ok))
             (And.right (And.right ok))
             hcode
             hargs
             hroom
             hdata
             hag
             (And.left ok))))))))
