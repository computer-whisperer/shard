;;; v3/compile/x86/gap_file.shard — three functions deep in one file (docs/COMPILE.md §5,
;;; linking): `gap` calls `sqdiff`, which calls `dot`. `dot` is the hand-written instructions of
;;; v3/models/x86/buffers.shard, at 4194547 after the start-up, where its rows have them;
;;; `sqdiff`'s module (../sqdiff_obj.shard) goes through the pass at 4194584 with `dot` as its
;;; one outside function, at its entry with no stack of its own; `gap`'s module
;;; (../gap_obj.shard) goes through the pass at the address after it, with `sqdiff` as its one
;;; outside function: the entry and the stack need the pass answered for `sqdiff`. The
;;; start-up's call goes to label 4, before the instruction at `gap`'s entry. Here are the
;;; listings, the table, the file's bytes, and every fact of the assembled file that the
;;; theorems ask for, each closed by computation; names begin `gp_`. That the file exits with
;;; `gap`'s value is gap_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "../sqdiff_obj.shard")
(import "../gap_obj.shard")
(import "../../models/x86/buffers.shard")
(import "../../models/x86/part.shard")
(use compile.sqdiff_obj)
(use compile.gap_obj)
(use compile.x86.code)
(use compile.x86.startup)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.buffers)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.part)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- compiled: `sqdiff`'s module ------------------------------------------------------------------
;; its outside functions, each by its entry and its stack need: `dot`
(fn gp_sq_outs () (List (Prod Nat Nat)) (cons (Prod.mk 4194547 0) nil))
(fn gp_sq_listing () (List Instr)
  (match (compile gp_sq_outs sqdiff_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) l)))
(fn gp_sq_entries () (List (Prod Nat Nat))
  (match (compile gp_sq_outs sqdiff_prog 4194584)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem gp_sq_compiled ()
  (= (compile gp_sq_outs sqdiff_prog 4194584) (some (Prod.mk gp_sq_listing gp_sq_entries)))
  (by rfl))
;; `sqdiff`'s entry as the pass answered it, and the words of stack it needs
(fn gp_sq_at () Nat
  (match (pair_at gp_sq_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn gp_sq_need () Nat
  (match (pair_at gp_sq_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem gp_sq_entry () (= (pair_at gp_sq_entries 0) (some (Prod.mk gp_sq_at gp_sq_need))) (by rfl))

;; ---- compiled: `gap`'s module ---------------------------------------------------------------------
;; its outside functions: `sqdiff`, as the pass answered for it; `sqdiff`'s module ends where
;; this one begins
(fn gp_outs () (List (Prod Nat Nat)) (cons (Prod.mk gp_sq_at gp_sq_need) nil))
(fn gp_base () Nat (+ 4194584 (isize gp_sq_listing)))
(fn gp_listing () (List Instr)
  (match (compile gp_outs gap_prog gp_base)
    (none nil)
    ((some (Prod.mk l f)) l)))
(fn gp_entries () (List (Prod Nat Nat))
  (match (compile gp_outs gap_prog gp_base)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem gp_compiled ()
  (= (compile gp_outs gap_prog gp_base) (some (Prod.mk gp_listing gp_entries)))
  (by rfl))
(fn gp_at () Nat
  (match (pair_at gp_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn gp_need () Nat
  (match (pair_at gp_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem gp_entry () (= (pair_at gp_entries 0) (some (Prod.mk gp_at gp_need))) (by rfl))
(theorem gp_need_fits () (<= gp_need 1048057) (by decide))

;; ---- the file's lines -----------------------------------------------------------------------------
;; `dot`'s lines, then the two modules' instructions as lines, label 4 before the one at `gap`'s
;; entry
(fn gp_lines () (List Asm)
  (List.append dot_asm (label_at (List.append gp_sq_listing gp_listing) 4194584 gp_at 4)))
;; the file's table: the start-up's rows, its call's displacement d, `dot`'s rows, then the two
;; listings laid out from 4194584
(fn gp_d () Nat (rel gp_at 4194537))
(fn gp_xt () (List (Prod Nat (Prod Instr Nat)))
  (List.append dot_rows (layout (List.append gp_sq_listing gp_listing) 4194584)))
(fn gp_tbl () (List (Prod Nat (Prod Instr Nat))) (link_table gp_d gp_xt))
(fn gp_chi () Nat (+ gp_base (isize gp_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn gp_image () (List Nat)
  (match (assemble (link_listing 4 gp_lines))
    (none nil)
    ((some code) code)))
(fn gp_instrs () (List Instr)
  (match (resolve (link_listing 4 gp_lines) (link_listing 4 gp_lines) 0)
    (none nil)
    ((some is) is)))
(theorem gp_assembled () (= (assemble (link_listing 4 gp_lines)) (some gp_image)) (by rfl))
(theorem gp_resolved ()
  (= (resolve (link_listing 4 gp_lines) (link_listing 4 gp_lines) 0) (some gp_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches `gap`, `dot`'s
;; lines are `dot`'s rows, and the lines after them the two listings
(theorem gp_laid () (= (layout gp_instrs 4194424) gp_tbl) (by rfl))
(theorem gp_target () (= (w64_add (w64 4194537) (w64 gp_d)) (w64 gp_at)) (by rfl))
(theorem gp_within () (= (all_within gp_tbl 4194424 gp_chi) true) (by rfl))
(theorem gp_size () (< (+ 4194424 (List.length gp_image)) 140737479962624) (by decide))
(theorem gp_chi_stack () (<= (+ gp_chi 15) 140737479962624) (by decide))
(theorem gp_chi_word () (<= (+ gp_chi 15) 18446744073709551616) (by decide))
;; each module's listing stands in the table where it was compiled
(theorem gp_sq_placedb () (= (placedb gp_tbl 4194584 gp_sq_listing) true) (by decide))
(theorem gp_sq_placed () (placed gp_tbl 4194584 gp_sq_listing)
  (exact (placedb_ok gp_tbl gp_sq_listing 4194584 gp_sq_placedb)))
(theorem gp_placedb () (= (placedb gp_tbl gp_base gp_listing) true) (by decide))
(theorem gp_placed () (placed gp_tbl gp_base gp_listing)
  (exact (placedb_ok gp_tbl gp_listing gp_base gp_placedb)))
;; and `dot`'s rows are rows of it, so what was proven over them holds in this file
(theorem gp_dot_rows () (= (table_part dot_rows gp_tbl) true) (by rfl))
