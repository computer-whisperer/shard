;;; v3/compile/x86/stmt_if.shard — the statement-level case of a two-way branch.
(import "pass.shard")
(import "../ir_laws.shard")
(import "lists.shard")
(import "code.shard")
(import "mem.shard")
(import "regs.shard")
(import "inv.shard")
(use std.mem)
(use compile.x86.code)
(use compile.x86.inv)
(use compile.ir)
(use compile.ir_laws)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use compile.ir.ICmp)
(use compile.ir.IStm)
(use compile.x86.pass)
(use compile.x86.regs)
(use compile.x86.seam)
(use models.x86.asm)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use models.x86.x86.Bop)
(use models.x86.x86.Fuel)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(import "stmt.shard")
(use compile.x86.expr)
