(theorem sim_if
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (v (BitVec 64))
   (m2 Mem)
   (c Cpu)
   (a Nat)
   (code (List Instr))
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p ext rs tbl clo chi xs fs ts n1))
   (hrun (= (irun (FS n1) p ext rs (SIf x cc y t e) ls mi) (some (Prod.mk v m2))))
   (hcs (= (cstm xs fs ts p nl a (SIf x cc y t e)) (some code)))
   (hpl (placed tbl a code))
   (hsn (<= (sneed xs fs ts p (SIf x cc y t e)) d))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c d (saved c0)))
   (hls (= ls (List.take nl (regs6 c))))
   (hnl (<= nl 6))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (done rs f (+ d 6) c0 c v m2)
  (by
    (have hm (<= (mx (sneed xs fs ts p t) (sneed xs fs ts p e)) d) (exact hsn))
    (have hsnt (<= (sneed xs fs ts p t) d)
      (exact (And.left (mx_le (sneed xs fs ts p t) (sneed xs fs ts p e) d hm))))
    (have hsne (<= (sneed xs fs ts p e) d)
      (exact (And.right (mx_le (sneed xs fs ts p t) (sneed xs fs ts p e) d hm))))
    (cases (irun_if_inv p ext rs n1 x cc y t e ls mi (Prod.mk v m2) hrun)
      ((intro (vx g0)
         (cases g0
           ((intro (vy g1)
              (cases (cstm_if_inv xs fs ts p nl a x cc y t e code hcs)
                ((intro (j g2)
                   (cases (And.right g2)
                     ((intro (ix g3)
                        (cases (And.right g3)
                          ((intro (iy g4)
                             (cases (And.right g4)
                               ((intro (ct g5)
                                  (cases (And.right g5)
                                    ((intro (ce g6)
                                       (have hpl2
                                         (placed tbl a
                                           (cons ix
                                             (cons iy
                                               (cons (AluRmR BCmp (RmReg 0) 1)
                                                 (cons (Jcc j (isize ct)) (List.append ct ce))))))
                                         (rw (<- (And.right g6)))
                                         (exact hpl))
                                       (exact
                                         (if_core p ext rs tbl clo chi xs fs ts n1 x cc y t e ls mi
                                           v
                                           m2
                                           c
                                           a
                                           c0
                                           f
                                           d
                                           nl
                                           m0
                                           vx
                                           vy
                                           j
                                           ix
                                           iy
                                           ct
                                           ce
                                           hall
                                           hchi
                                           ih
                                           (And.left g1)
                                           (And.left (And.right g1))
                                           (And.right (And.right g1))
                                           (And.left g2)
                                           (And.left g3)
                                           (And.left g4)
                                           (And.left g5)
                                           (And.left g6)
                                           hpl2
                                           hsnt
                                           hsne
                                           hrip
                                           w
                                           hls
                                           hnl
                                           hag
                                           hkm
                                           hdo)))))))))))))))))))))))))
