;; ---- the parts of a branch ----------------------------------------------------------------------
(theorem cstm_if_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (SIf x cc y t e)) (some code))))
  (exists ((jc Nat))
    (and (= (jcc_not cc) (some jc))
      (exists ((ix Instr))
        (and (= (ld_atom 0 x nl) (some ix))
          (exists ((iy Instr))
            (and (= (ld_atom 1 y nl) (some iy))
              (exists ((ct (List Instr)))
                (and
                  (=
                    (cstm xs fs ts p nl
                      (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))
                      t)
                    (some ct))
                  (exists ((ce (List Instr)))
                    (and
                      (=
                        (cstm xs fs ts p nl
                          (+ (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))
                            (isize ct))
                          e)
                        (some ce))
                      (= code
                        (cons ix
                          (cons iy
                            (cons (AluRmR BCmp (RmReg 0) 1)
                              (cons (Jcc jc (isize ct)) (List.append ct ce))))))))))))))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (SIf x cc y t e)) (some code))
        (exists ((jc Nat))
          (and (= (jcc_not cc) (some jc))
            (exists ((ix Instr))
              (and (= (ld_atom 0 x nl) (some ix))
                (exists ((iy Instr))
                  (and (= (ld_atom 1 y nl) (some iy))
                    (exists ((ct (List Instr)))
                      (and
                        (=
                          (cstm xs fs ts p nl
                            (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))
                            t)
                          (some ct))
                        (exists ((ce (List Instr)))
                          (and
                            (=
                              (cstm xs fs ts p nl
                                (+
                                  (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))
                                  (isize ct))
                                e)
                              (some ce))
                            (= code
                              (cons ix
                                (cons iy
                                  (cons (AluRmR BCmp (RmReg 0) 1)
                                    (cons (Jcc jc (isize ct)) (List.append ct ce)))))))))))))))))
      (unfold cstm)
      (cases (jcc_not cc) hjq
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (some (j1) (reduce)
           (cases (ld_atom 0 x nl) hix
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
              (some (ix1) (reduce)
                (cases (ld_atom 1 y nl) hiy
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                   (some (iy1) (reduce)
                     (cases
                       (cstm xs fs ts p nl
                         (+ a (+ (+ (List.length (encode ix1)) (List.length (encode iy1))) 9))
                         t)
                       hct
                       ((none () (reduce) (intro h0)
                          (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                        (some (ct1) (reduce)
                          (cases
                            (cstm xs fs ts p nl
                              (+
                                (+ a (+ (+ (List.length (encode ix1)) (List.length (encode iy1))) 9))
                                (isize ct1))
                              e)
                            hce
                            ((none () (reduce) (intro h0)
                               (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                             (some (ce1) (reduce) (intro h0)
                               (apply (Exists.intro j1)
                                 ((apply And.intro (rfl)
                                    ((apply (Exists.intro ix1)
                                       ((apply And.intro (rfl)
                                          ((apply (Exists.intro iy1)
                                             ((apply And.intro (rfl)
                                                ((apply (Exists.intro ct1)
                                                   ((apply And.intro ((exact hct))
                                                      ((apply (Exists.intro ce1)
                                                         ((apply And.intro ((exact hce))
                                                            ((exact (Eq.symm (Option.some.inj h0)))))))))))))))))))))))))))))))))))))))
    (exact (g h))))
;; after cmp r_a, r_b the condition `b` (2) holds where r_a is below r_b, and does not where it
;; is not
(theorem cmp_b_yes
  ((c Cpu) (a Nat) (b Nat) (pc (BitVec 64)) (h (< (w64_val (reg c a)) (w64_val (reg c b)))))
  (= (cc_holds 2 (Cpu.flags (x_cmp_rr c a b pc))) (some true))
  (by
    (show (= (some (if (< (w64_val (reg c a)) (w64_val (reg c b))) true false)) (some true)))
    (rw (if_pos h))
    rfl))
(theorem cmp_b_no
  ((c Cpu) (a Nat) (b Nat) (pc (BitVec 64)) (h (Not (< (w64_val (reg c a)) (w64_val (reg c b))))))
  (= (cc_holds 2 (Cpu.flags (x_cmp_rr c a b pc))) (some false))
  (by
    (show (= (some (if (< (w64_val (reg c a)) (w64_val (reg c b))) true false)) (some false)))
    (rw (if_neg h))
    rfl))

;; ---- one branch ---------------------------------------------------------------------------------
;; from a state C at the jump: where the jump's rule leads to the branch's code at ab, the
;; branch's run is the statement's
(theorem if_branch
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (sb IStm)
   (cb (List Instr))
   (ab Nat)
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (C Cpu)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (j Nat)
   (sl (List (BitVec 64)))
   (ih (sim p wx rs tbl clo chi xs fs ts n1))
   (hjmp (forall ((c2 Cpu)) (-> (reaches (at_pc C (w64 ab)) c2) (reaches C c2))))
   (hrb (= (wrun n1 p wx rs sb ls mi o) (some out)))
   (hcb (= (cstm xs fs ts p nl ab sb) (some cb)))
   (hpb (placed tbl ab cb))
   (hsn (<= (sneed xs fs ts p nl sb) j))
   (w (framed c0 tbl clo chi f (+ d 6) m0 C j (app sl (saved c0))))
   (hls (= ls (app (List.take nl (regs6 C)) sl)))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 C o out)
  (by
    (have w2 (framed c0 tbl clo chi f (+ d 6) m0 (at_pc C (w64 ab)) j (app sl (saved c0)))
      (exact w))
    (have hls2 (= ls (app (List.take nl (regs6 (at_pc C (w64 ab)))) sl)) (exact hls))
    (have hrip2 (= (Cpu.rip (at_pc C (w64 ab))) (w64 ab)) rfl)
    (exact
      (arrives_from rs f (+ d 6) c0 C (at_pc C (w64 ab)) o out
        (hjmp (at_pc C (w64 ab)) (reaches_refl (at_pc C (w64 ab))))
        (ih sb ls mi o out (at_pc C (w64 ab)) ab cb c0 f d nl m0 j sl hrb hcb hpb hsn hrip2 w2 hls2
          hsl
          hj
          hag
          hkm
          hdo)))))
;; ---- the comparison -----------------------------------------------------------------------------
;; the state after the two atoms are in rax and rcx and compared
(fn i_s3 ((c Cpu) (vx (BitVec 64)) (vy (BitVec 64)) (a Nat) (ix Instr) (iy Instr)) Cpu
  (x_cmp_rr
    (at_pc (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
      (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
    0
    1
    (w64 (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3))))
(theorem if_head
  ((tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (rs (List Seg))
   (ls (List (BitVec 64)))
   (mi Mem)
   (nl Nat)
   (c Cpu)
   (a Nat)
   (x IExp)
   (y IExp)
   (ix Instr)
   (iy Instr)
   (vx (BitVec 64))
   (vy (BitVec 64))
   (rest (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (hcode (code_in c tbl))
   (hrip (= (Cpu.rip c) (w64 a)))
   (hls (locs c nl ls))
   (hix (= (ld_atom 0 x nl) (some ix)))
   (hiy (= (ld_atom 1 y nl) (some iy)))
   (hvx (= (ieval rs ls mi x) (some vx)))
   (hvy (= (ieval rs ls mi y) (some vy)))
   (hpl (placed tbl a (cons ix (cons iy (cons (AluRmR BCmp (RmReg 0) 1) rest))))))
  (reaches c (i_s3 c vx vy a ix iy))
  (by
    (have s1 (= (site tbl a) (some (Prod.mk ix (List.length (encode ix))))) (exact (And.left hpl)))
    (have r1 (reaches c (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))))
      (exact (ld_ok tbl clo chi rs ls mi nl c a 0 x ix vx hall hchi hcode hrip hls hix hvx s1)))
    (have hc1 (code_in (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) tbl)
      (exact hcode))
    (have hrip1
      (= (Cpu.rip (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))))
        (w64 (+ a (List.length (encode ix)))))
      rfl)
    (have t1
      (= (Cpu.segs (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))) (Cpu.segs c))
      rfl)
    (have t2
      (= (Cpu.mem (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))) (Cpu.mem c))
      rfl)
    (have t3 (= (reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 4) (reg c 4))
      rfl)
    (have t4 (= (regs6 (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))) (regs6 c))
      rfl)
    (have hls1 (locs (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) nl ls)
      (exact
        (locs_of c (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) nl ls hls t1 t2 t3
          t4)))
    (have s2
      (= (site tbl (+ a (List.length (encode ix)))) (some (Prod.mk iy (List.length (encode iy)))))
      (exact (And.left (And.right hpl))))
    (have r2
      (reaches (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))
        (at_pc (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
          (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy))))))
      (exact
        (ld_ok tbl clo chi rs ls mi nl
          (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))
          (+ a (List.length (encode ix)))
          1
          y
          iy
          vy
          hall
          hchi
          hc1
          hrip1
          hls1
          hiy
          hvy
          s2)))
    (have s3
      (= (site tbl (+ (+ a (List.length (encode ix))) (List.length (encode iy))))
        (some (Prod.mk (AluRmR BCmp (RmReg 0) 1) 3)))
      (exact (And.left (And.right (And.right hpl)))))
    (have r3
      (reaches
        (at_pc (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
          (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
        (i_s3 c vx vy a ix iy))
      (apply (t_cmp tbl clo chi (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 0 1 3)
        ((exact hall))
        ((exact hchi))
        ((exact hcode))
        (rfl)
        ((exact s3))
        ((exact (reaches_refl (i_s3 c vx vy a ix iy))))))
    (exact
      (reaches_trans c (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))
        (i_s3 c vx vy a ix iy)
        r1
        (reaches_trans (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix)))))
          (at_pc (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
            (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
          (i_s3 c vx vy a ix iy)
          r2
          r3)))))
;; ---- the machine's part of a branch -------------------------------------------------------------
(theorem if_core
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (n1 Fuel)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (mi Mem)
   (o Os)
   (out Outcome)
   (c Cpu)
   (a Nat)
   (c0 Cpu)
   (f Nat)
   (d Nat)
   (nl Nat)
   (m0 Mem)
   (j Nat)
   (sl (List (BitVec 64)))
   (vx (BitVec 64))
   (vy (BitVec 64))
   (jc Nat)
   (ix Instr)
   (iy Instr)
   (ct (List Instr))
   (ce (List Instr))
   (hall (= (all_within tbl clo chi) true))
   (hchi (<= (+ chi 15) 18446744073709551616))
   (ih (sim p wx rs tbl clo chi xs fs ts n1))
   (hvx (= (ieval rs ls mi x) (some vx)))
   (hvy (= (ieval rs ls mi y) (some vy)))
   (hrb (= (wrun n1 p wx rs (if (icmp cc vx vy) t e) ls mi o) (some out)))
   (hjq (= (jcc_not cc) (some jc)))
   (hix (= (ld_atom 0 x nl) (some ix)))
   (hiy (= (ld_atom 1 y nl) (some iy)))
   (hct
     (= (cstm xs fs ts p nl (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9)) t)
       (some ct)))
   (hce
     (=
       (cstm xs fs ts p nl
         (+ (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9)) (isize ct))
         e)
       (some ce)))
   (hpl
     (placed tbl a
       (cons ix
         (cons iy (cons (AluRmR BCmp (RmReg 0) 1) (cons (Jcc jc (isize ct)) (List.append ct ce)))))))
   (hsnt (<= (sneed xs fs ts p nl t) j))
   (hsne (<= (sneed xs fs ts p nl e) j))
   (hrip (= (Cpu.rip c) (w64 a)))
   (w (framed c0 tbl clo chi f (+ d 6) m0 c j (app sl (saved c0))))
   (hls (= ls (app (List.take nl (regs6 c)) sl)))
   (hsl (= (List.length sl) (nsl nl)))
   (hj (= (+ j (List.length sl)) d))
   (hag (agree rs mi m0))
   (hkm (kept_mem rs f (+ d 6) (Cpu.mem c0) m0))
   (hdo (data_ok c0 rs clo chi f (+ d 6))))
  (arrives rs f (+ d 6) c0 c o out)
  (by
    (have hlc (locs c nl ls)
      (exact (locs_framed c0 tbl clo chi f (+ d 6) m0 c j (saved c0) nl ls sl w hls hsl)))
    (have r03 (reaches c (i_s3 c vx vy a ix iy))
      (exact
        (if_head tbl clo chi rs ls mi nl c a x y ix iy vx vy
          (cons (Jcc jc (isize ct)) (List.append ct ce))
          hall
          hchi
          (framed_code w)
          hrip
          hlc
          hix
          hiy
          hvx
          hvy
          hpl)))
    (have w3 (framed c0 tbl clo chi f (+ d 6) m0 (i_s3 c vx vy a ix iy) j (app sl (saved c0)))
      (exact w))
    (have hls3 (= ls (app (List.take nl (regs6 (i_s3 c vx vy a ix iy))) sl)) (exact hls))
    (have s4
      (= (site tbl (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3))
        (some (Prod.mk (Jcc jc (isize ct)) 6)))
      (exact (And.left (And.right (And.right (And.right hpl))))))
    (have pte
      (placed tbl (+ (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3) 6)
        (List.append ct ce))
      (exact (And.right (And.right (And.right (And.right hpl))))))
    (have eA
      (= (+ (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3) 6)
        (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9)))
      (arith))
    (have ptt2 (placed tbl (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9)) ct)
      (rw (<- eA))
      (exact
        (And.left
          (placed_app tbl ct
            (+ (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3) 6)
            ce
            pte))))
    (have pee2
      (placed tbl (+ (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9)) (isize ct))
        ce)
      (rw (<- eA))
      (exact
        (And.right
          (placed_app tbl ct
            (+ (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3) 6)
            ce
            pte))))
    (cases (Nat.decLt (w64_val vx) (w64_val vy))
      ((isTrue (hlt)
         (cases cc
           ((CLtu () (have hjx (= (some 3) (some jc)) (exact hjq))
              (have hj3 (= jc 3) (exact (Eq.symm (Option.some.inj hjx))))
              (have hl2
                (<
                  (w64_val
                    (reg
                      (at_pc
                        (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                        (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                      0))
                  (w64_val
                    (reg
                      (at_pc
                        (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                        (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                      1)))
                (exact hlt))
              (have hcc (= (cc_holds jc (Cpu.flags (i_s3 c vx vy a ix iy))) (some false))
                (rw hj3)
                (exact
                  (cmp_below
                    (at_pc
                      (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                      (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                    0
                    1
                    (w64 (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3))
                    hl2)))
              (have eb (= (icmp CLtu vx vy) true)
                (show (= (if (< (w64_val vx) (w64_val vy)) true false) true))
                (rw (if_pos hlt))
                rfl)
              (have e2 (= (if (icmp CLtu vx vy) t e) t) (rw eb) rfl)
              (have hrx (= (wrun n1 p wx rs t ls mi o) (some out)) (rw (<- e2)) (exact hrb))
              (have hjmp
                (forall ((c2 Cpu))
                  (->
                    (reaches
                      (at_pc (i_s3 c vx vy a ix iy)
                        (w64 (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))))
                      c2)
                    (reaches (i_s3 c vx vy a ix iy) c2)))
                (intro c2 hr)
                (apply
                  (t_jcc_not tbl clo chi
                    (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3)
                    jc
                    (isize ct)
                    6)
                  ((exact hall))
                  ((exact hchi))
                  ((exact (framed_code w3)))
                  (rfl)
                  ((exact s4))
                  ((exact hcc))
                  ((rw eA) (exact hr))))
              (exact
                (arrives_from rs f (+ d 6) c0 c (i_s3 c vx vy a ix iy) o out r03
                  (if_branch p wx rs tbl clo chi xs fs ts n1 t ct
                    (+ a (+ (+ (List.length (encode ix)) (List.length (encode iy))) 9))
                    ls
                    mi
                    o
                    out
                    (i_s3 c vx vy a ix iy)
                    c0
                    f
                    d
                    nl
                    m0
                    j
                    sl
                    ih
                    hjmp
                    hrx
                    hct
                    ptt2
                    hsnt
                    w3
                    hls3
                    hsl
                    hj
                    hag
                    hkm
                    hdo))))
            (CGeu () (have hjx (= (some 2) (some jc)) (exact hjq))
              (have hj3 (= jc 2) (exact (Eq.symm (Option.some.inj hjx))))
              (have hl2
                (<
                  (w64_val
                    (reg
                      (at_pc
                        (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                        (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                      0))
                  (w64_val
                    (reg
                      (at_pc
                        (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                        (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                      1)))
                (exact hlt))
              (have hcc (= (cc_holds jc (Cpu.flags (i_s3 c vx vy a ix iy))) (some true))
                (rw hj3)
                (exact
                  (cmp_b_yes
                    (at_pc
                      (set_reg (at_pc (set_reg c 0 vx) (w64 (+ a (List.length (encode ix))))) 1 vy)
                      (w64 (+ (+ a (List.length (encode ix))) (List.length (encode iy)))))
                    0
                    1
                    (w64 (+ (+ (+ a (List.length (encode ix))) (List.length (encode iy))) 3))
                    hl2)))
              (have eb (= (icmp CGeu vx vy) false)
                (show (= (if (if (< (w64_val vx) (w64_val vy)) true false) false true) false))
