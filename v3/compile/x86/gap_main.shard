;;; v3/compile/x86/gap_main.shard — the file of gap_file.shard written to the path given, for the
;;; model's run and the processor's. The status is the low byte of what `gap` — the function
;;; over two lists, ../gap_src.shard — computes of the two sample buffers, as the evaluator
;;; computes it; gap_run.shard proves the file's own run exits with it.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "gap_file.shard")
(import "../gap_src.shard")
(import "../../models/x86/buffers.shard")
(use std.bytes)
(use std.host)
(use compile.gap_src)
(use compile.x86.gap_file)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.word)

(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats (elf_exec gp_image)) w)
    ((Prod.mk ok w1)
     (exit (if ok (% (w64_val (gap sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 1) w1))))
