;;; v3/compile/x86/calls_file.shard — the first program compiled, and the file it runs in. The
;;; six functions of calls_ir.shard go through the pass at 4194547, the address after the
;;; start-up (startup.shard); the file's lines are the start-up, its call going to label 1, and
;;; the compiled instructions with label 1 before the one at the entry of function 5. Here are
;;; the listing, the table, the file's bytes, and every fact of the assembled file that the
;;; theorems ask for, each closed by computation. That the file exits with the function's value
;;; is calls_run.shard's.
(import "pass.shard")
(import "code.shard")
(import "startup.shard")
(import "../calls_ir.shard")
(use compile.calls_ir)
(use compile.x86.code)
(use compile.x86.startup)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- compiled -----------------------------------------------------------------------------------
(fn calls_listing () (List Instr)
  (match (compile nil calls_prog 4194547)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn calls_entries () (List (Prod Nat Nat))
  (match (compile nil calls_prog 4194547)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem calls_compiled ()
  (= (compile nil calls_prog 4194547) (some (Prod.mk calls_listing calls_entries)))
  (by rfl))
;; the entry of function 5 as the pass answered it, and the words of stack it needs
(fn calls_at () Nat
  (match (pair_at calls_entries 5)
    (none 0)
    ((some en) (Prod.fst en))))
(fn calls_need () Nat
  (match (pair_at calls_entries 5)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem calls_entry () (= (pair_at calls_entries 5) (some (Prod.mk calls_at calls_need))) (by rfl))

;; ---- the file's lines -----------------------------------------------------------------------------
;; the compiled instructions as lines, label 1 before the one at the entry of function 5
(fn calls_lines () (List Asm) (label_at calls_listing 4194547 calls_at 1))
;; the file's table: the start-up's rows, its call's displacement d, then the compiled
;; instructions laid out from 4194547
(fn calls_d () Nat (rel calls_at 4194537))
(fn calls_xt () (List (Prod Nat (Prod Instr Nat))) (layout calls_listing 4194547))
(fn calls_tbl () (List (Prod Nat (Prod Instr Nat))) (link_table calls_d calls_xt))
(fn calls_chi () Nat (+ 4194547 (isize calls_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn calls_image () (List Nat)
  (match (assemble (link_listing 1 calls_lines))
    (none nil)
    ((some code) code)))
(fn calls_instrs () (List Instr)
  (match (resolve (link_listing 1 calls_lines) (link_listing 1 calls_lines) 0)
    (none nil)
    ((some is) is)))
(theorem calls_assembled () (= (assemble (link_listing 1 calls_lines)) (some calls_image)) (by rfl))
(theorem calls_resolved ()
  (= (resolve (link_listing 1 calls_lines) (link_listing 1 calls_lines) 0) (some calls_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches function 5, and the
;; lines after it are the compiled listing, instruction for instruction
(theorem calls_laid () (= (layout calls_instrs 4194424) calls_tbl) (by rfl))
(theorem calls_target () (= (w64_add (w64 4194537) (w64 calls_d)) (w64 calls_at)) (by rfl))
(theorem calls_within () (= (all_within calls_tbl 4194424 calls_chi) true) (by rfl))
;; the code ends at or below the table's end
(theorem calls_code_end () (<= (+ 4194424 (List.length calls_image)) calls_chi) (by decide))
(theorem calls_chi_word () (<= (+ calls_chi 15) 18446744073709551616) (by decide))
;; the compiled listing stands in the table at 4194547
(theorem calls_placedb () (= (placedb calls_tbl 4194547 calls_listing) true) (by decide))
(theorem calls_placed () (placed calls_tbl 4194547 calls_listing)
  (exact (placedb_ok calls_tbl calls_listing 4194547 calls_placedb)))
