;;; v3/compile/x86/inv.shard — what the pass's answer for a statement says of the statement's
;;; parts.
(import "pass.shard")
(import "seam.shard")
(import "../../models/x86/loaded.shard")
(use compile.ir)
(use compile.ir.IStm)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.x86)
(use models.x86.x86.Instr)
(use models.x86.x86.Rm)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
;; ---- the pass ---------------------------------------------------------------------------------
(theorem cstm_ret_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (e IExp)
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (SRet e)) (some code))))
  (exists ((ce (List Instr))) (and (= (cexp 0 e nl) (some ce)) (= code (List.append ce epi))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (SRet e)) (some code))
        (exists ((ce (List Instr))) (and (= (cexp 0 e nl) (some ce)) (= code (List.append ce epi)))))
      (unfold cstm)
      (cases (cexp 0 e nl) hc
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (some (ce1) (reduce) (intro h0)
           (apply (Exists.intro ce1)
             ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0)))))))))))
    (exact (g h))))
(theorem cstm_let_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (x Nat)
   (e IExp)
   (k IStm)
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (SLet x e k)) (some code))))
  (and (< x nl)
    (exists ((ce (List Instr)))
      (and (= (cexp 0 e nl) (some ce))
        (exists ((ck (List Instr)))
          (and (= (cstm xs fs ts p nl (+ a (+ (isize ce) 3)) k) (some ck))
            (= code (List.append ce (cons (MovRmR (RmReg (kreg x)) 0) ck))))))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (SLet x e k)) (some code))
        (and (< x nl)
          (exists ((ce (List Instr)))
            (and (= (cexp 0 e nl) (some ce))
              (exists ((ck (List Instr)))
                (and (= (cstm xs fs ts p nl (+ a (+ (isize ce) 3)) k) (some ck))
                  (= code (List.append ce (cons (MovRmR (RmReg (kreg x)) 0) ck)))))))))
      (unfold cstm)
      (cases (Nat.decLt x nl)
        ((isFalse (hx) (rw (if_neg hx)) (intro h0)
           (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (isTrue (hx) (rw (if_pos hx))
           (cases (cexp 0 e nl) hc
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
              (some (ce1) (reduce)
                (cases (cstm xs fs ts p nl (+ a (+ (isize ce1) 3)) k) hk
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                   (some (ck1) (reduce) (intro h0)
                     (apply And.intro ((exact hx))
                       ((apply (Exists.intro ce1)
                          ((apply And.intro (rfl)
                             ((apply (Exists.intro ck1)
                                ((apply And.intro ((exact hk))
                                   ((exact (Eq.symm (Option.some.inj h0)))))))))))))))))))))))
    (exact (g h))))

;; a store's code: the address into rax, the word into rcx, the store, the rest
(theorem cstm_store_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (q IExp)
   (e IExp)
   (k IStm)
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (SStore q e k)) (some code))))
  (exists ((cq (List Instr)))
    (and (= (cexp 0 q nl) (some cq))
      (exists ((ce (List Instr)))
        (and (= (cexp 1 e nl) (some ce))
          (exists ((ck (List Instr)))
            (and (= (cstm xs fs ts p nl (+ a (+ (+ (isize cq) (isize ce)) 3)) k) (some ck))
              (= code (List.append cq (List.append ce (cons (MovRmR (RmMem 0 0) 1) ck))))))))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (SStore q e k)) (some code))
        (exists ((cq (List Instr)))
          (and (= (cexp 0 q nl) (some cq))
            (exists ((ce (List Instr)))
              (and (= (cexp 1 e nl) (some ce))
                (exists ((ck (List Instr)))
                  (and (= (cstm xs fs ts p nl (+ a (+ (+ (isize cq) (isize ce)) 3)) k) (some ck))
                    (= code (List.append cq (List.append ce (cons (MovRmR (RmMem 0 0) 1) ck)))))))))))
      (unfold cstm)
      (cases (cexp 0 q nl) hq
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (some (cq1) (reduce)
           (cases (cexp 1 e nl) he
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
              (some (ce1) (reduce)
                (cases (cstm xs fs ts p nl (+ a (+ (+ (isize cq1) (isize ce1)) 3)) k) hk
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                   (some (ck1) (reduce) (intro h0)
                     (apply (Exists.intro cq1)
                       ((apply And.intro (rfl)
                          ((apply (Exists.intro ce1)
                             ((apply And.intro (rfl)
                                ((apply (Exists.intro ck1)
                                   ((apply And.intro ((exact hk))
                                      ((exact (Eq.symm (Option.some.inj h0)))))))))))))))))))))))))
    (exact (g h))))
;; ---- a call -------------------------------------------------------------------------------------
(theorem mx_le ((a Nat) (b Nat) (d Nat)) (-> (<= (mx a b) d) (and (<= a d) (<= b d)))
  (by
    (unfold mx)
    (cases (Nat.decLt a b)
      ((isTrue (h) (rw (if_pos h)) (intro g) (apply And.intro ((arith)) ((exact g))))
       (isFalse (h) (rw (if_neg h)) (intro g) (apply And.intro ((exact g)) ((arith))))))))
;; a call's need is within the statement's
(theorem sneed_call
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (en (Prod Nat Nat))
   (d Nat)
   (hc (= (callee_at xs fs p cal (List.length es)) (some en)))
   (hs (<= (sneed xs fs ts p (SCall x cal es k)) d)))
  (and (<= (+ (Prod.snd en) 1) d) (<= (sneed xs fs ts p k) d))
  (by
    (have e (= (sneed xs fs ts p (SCall x cal es k)) (mx (+ (Prod.snd en) 1) (sneed xs fs ts p k)))
      (rw sneed.eq_3)
      (rw hc)
      rfl)
    (have g2 (<= (mx (+ (Prod.snd en) 1) (sneed xs fs ts p k)) d) (rw (<- e)) (exact hs))
    (exact (mx_le (+ (Prod.snd en) 1) (sneed xs fs ts p k) d g2))))
(theorem cargs_nil_inv ((i Nat) (nl Nat) (ca (List Instr)) (h (= (cargs nil i nl) (some ca))))
  (= ca nil)
  (by
    (have g (= (some (@List.nil Instr)) (some ca)) (exact h))
    (exact (Eq.symm (Option.some.inj g)))))
(theorem cargs_cons_inv
  ((e IExp)
   (r (List IExp))
   (i Nat)
   (nl Nat)
   (ca (List Instr))
   (h (= (cargs (cons e r) i nl) (some ca))))
  (and (< i 6)
    (exists ((ia Instr))
      (exists ((ir (List Instr)))
        (and (= (ld_atom (areg i) e nl) (some ia))
          (and (= (cargs r (+ i 1) nl) (some ir)) (= ca (cons ia ir)))))))
  (by
    (have g
      (-> (= (cargs (cons e r) i nl) (some ca))
        (and (< i 6)
          (exists ((ia Instr))
            (exists ((ir (List Instr)))
              (and (= (ld_atom (areg i) e nl) (some ia))
                (and (= (cargs r (+ i 1) nl) (some ir)) (= ca (cons ia ir))))))))
      (rw cargs.eq_2)
      (cases (Nat.decLt i 6)
        ((isFalse (h6) (rw (if_neg h6)) (intro h0)
           (exact (absurd (Eq.symm h0) (Option.some_ne_none ca))))
         (isTrue (h6) (rw (if_pos h6))
           (cases (ld_atom (areg i) e nl) hl
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none ca))))
              (some (ia0) (reduce)
                (cases (cargs r (+ i 1) nl) hc
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none ca))))
                   (some (ir0) (reduce) (intro h0)
                     (apply And.intro ((exact h6))
                       ((apply (Exists.intro ia0)
                          ((apply (Exists.intro ir0)
                             ((apply And.intro (rfl)
                                ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0)))))))))))))))))))))))
    (exact (g h))))
(theorem cstm_call_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (SCall x cal es k)) (some code))))
  (and (< x nl)
    (exists ((en (Prod Nat Nat)))
      (and (= (callee_at xs fs p cal (List.length es)) (some en))
        (exists ((ca (List Instr)))
          (and (= (cargs es 0 nl) (some ca))
            (exists ((ck (List Instr)))
              (and (= (cstm xs fs ts p nl (+ a (+ (isize ca) 8)) k) (some ck))
                (= code
                  (List.append ca
                    (cons (Call (rel (Prod.fst en) (+ a (+ (isize ca) 5))))
                      (cons (MovRmR (RmReg (kreg x)) 0) ck)))))))))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (SCall x cal es k)) (some code))
        (and (< x nl)
          (exists ((en (Prod Nat Nat)))
            (and (= (callee_at xs fs p cal (List.length es)) (some en))
              (exists ((ca (List Instr)))
                (and (= (cargs es 0 nl) (some ca))
                  (exists ((ck (List Instr)))
                    (and (= (cstm xs fs ts p nl (+ a (+ (isize ca) 8)) k) (some ck))
                      (= code
                        (List.append ca
                          (cons (Call (rel (Prod.fst en) (+ a (+ (isize ca) 5))))
                            (cons (MovRmR (RmReg (kreg x)) 0) ck))))))))))))
      (unfold cstm)
      (cases (Nat.decLt x nl)
        ((isFalse (hx) (rw (if_neg hx)) (intro h0)
           (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (isTrue (hx) (rw (if_pos hx))
           (cases (callee_at xs fs p cal (List.length es)) hc
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
              (some (en1) (reduce)
                (cases (cargs es 0 nl) ha
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                   (some (ca1) (reduce)
                     (cases (cstm xs fs ts p nl (+ a (+ (isize ca1) 8)) k) hk
                       ((none () (reduce) (intro h0)
                          (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
                        (some (ck1) (reduce) (intro h0)
                          (apply And.intro ((exact hx))
                            ((apply (Exists.intro en1)
                               ((apply And.intro (rfl)
                                  ((apply (Exists.intro ca1)
                                     ((apply And.intro (rfl)
                                        ((apply (Exists.intro ck1)
                                           ((apply And.intro ((exact hk))
                                              ((exact (Eq.symm (Option.some.inj h0))))))))))))))))))))))))))))))
    (exact (g h))))
;; ---- a tail call ----------------------------------------------------------------------------------
(theorem cstm_tail_inv
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (nl Nat)
   (a Nat)
   (cal ICallee)
   (es (List IExp))
   (code (List Instr))
   (h (= (cstm xs fs ts p nl a (STail cal es)) (some code))))
  (exists ((en (Prod Nat Nat)))
    (and (= (callee_at xs ts p cal (List.length es)) (some en))
      (exists ((ca (List Instr)))
        (and (= (cargs es 0 nl) (some ca))
          (= code (List.append ca (tail_out (Prod.fst en) (+ a (isize ca)))))))))
  (by
    (have g
      (-> (= (cstm xs fs ts p nl a (STail cal es)) (some code))
        (exists ((en (Prod Nat Nat)))
          (and (= (callee_at xs ts p cal (List.length es)) (some en))
            (exists ((ca (List Instr)))
              (and (= (cargs es 0 nl) (some ca))
                (= code (List.append ca (tail_out (Prod.fst en) (+ a (isize ca))))))))))
      (unfold cstm)
      (cases (callee_at xs ts p cal (List.length es)) hc
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
         (some (en1) (reduce)
           (cases (cargs es 0 nl) ha
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none code))))
              (some (ca1) (reduce) (intro h0)
                (apply (Exists.intro en1)
                  ((apply And.intro (rfl)
                     ((apply (Exists.intro ca1)
                        ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0))))))))))))))))))
    (exact (g h))))
;; a tail call's callee needs no more than the function's whole frame
(theorem sneed_tail
  ((xs (List (Prod Nat Nat)))
   (fs (List (Prod Nat Nat)))
   (ts (List (Prod Nat Nat)))
   (p (List IFn))
   (cal ICallee)
   (es (List IExp))
   (en (Prod Nat Nat))
   (d Nat)
   (hc (= (callee_at xs ts p cal (List.length es)) (some en)))
   (hs (<= (sneed xs fs ts p (STail cal es)) d)))
  (<= (Prod.snd en) (+ d 6))
  (by
    (have e (= (sneed xs fs ts p (STail cal es)) (- (Prod.snd en) 6)) (rw sneed.eq_6) (rw hc) rfl)
    (have g2 (<= (- (Prod.snd en) 6) d) (rw (<- e)) (exact hs))
    (exact (Nat.le_add_of_sub_le g2))))
