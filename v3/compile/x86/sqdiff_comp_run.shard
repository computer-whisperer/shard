;;; v3/compile/x86/sqdiff_comp_run.shard — a caller of `dot` through every layer, with the
;;; COMPILED `dot` (docs/COMPILE.md §5, §8): the file of sqdiff_comp_file.shard, started as the
;;; runner starts it, exits with the low byte of what `sqdiff` (../sqdiff_src.shard) — the
;;; function over two lists — computes of the two buffers the start-up pushes: 27. The chain:
;;; `sqdiff`'s low form computes its meaning, and its intermediate code, written by hand,
;;; answers with the low form's value, a call of `dot` by `dot`'s answer (the view `../sqdiff`);
;;; the code the pass answers for `dot`'s module realizes its run's answer (`module_realizes`),
;;; and so that answer, which the run gives by `dot`'s own tie (`dot_ans_tie`, the view `../dot`);
;;; the code the pass answers for `sqdiff`'s module realizes its answer where `dot`'s code
;;; realizes `dot`'s (`module_realizes`); and a file with a function that realizes its answer
;;; exits as the answer says (`link_exits`). Of `dot` the caller's side uses one statement, the
;;; same in both files.
(import "sqdiff_comp_file.shard")
(import "link.shard")
(import "module.shard")
(import "../sqdiff")
(use std.mem)
(use compile.dot)
(use compile.two)
(use compile.ir)
(use compile.sqdiff_obj)
(use compile.sqdiff)
(use compile.sqdiff_src)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use compile.x86.sqdiff_comp_file)
(use compile.x86.startup)
(use compile.dot_obj)
(use compile.x86.dot_file)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the outside function, in this file -------------------------------------------------------------
;; `dot`'s module, where this file has it, realizes the run of `dot`'s intermediate code: the
;; module's theorem, for a module that calls nothing from outside
(theorem sqc_dot_code_realizes ((rs (List Seg)))
  (realizes sqc_tbl 4194424 sqc_chi dot_at dot_need rs (fn_ans dot_prog no_ext rs dot_code))
  (by
    (have hx
      (forall ((j Nat) (en (Prod Nat Nat)))
        (-> (= (pair_at (@List.nil (Prod Nat Nat)) j) (some en))
          (realizes sqc_tbl 4194424 sqc_chi (Prod.fst en) (Prod.snd en) rs (ext_ans no_ext j))))
      (intro j en h)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact h))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
    (exact
      (module_realizes dot_prog no_ext rs sqc_tbl 4194424 sqc_chi nil 4194489 dot_listing
        dot_entries
        sqc_within
        sqc_chi_word
        hx
        dot_compiled
        sqc_dot_placed
        1
        dot_code
        (Prod.mk dot_at dot_need)
        dot_code_is
        dot_entry))))
;; and so the answer of `dot`'s low form, the answer `sqdiff`'s code runs with: whatever it says, the run
;; answers (`dot_ans_tie`)
(theorem sqc_dot_realizes ((rs (List Seg)))
  (realizes sqc_tbl 4194424 sqc_chi dot_at dot_need rs (ext_ans (sqdiff_ext rs) 0))
  (by
    (have hr (realizes sqc_tbl 4194424 sqc_chi dot_at dot_need rs (two_ans dot_lo rs))
      (exact
        (realizes_sub sqc_tbl 4194424 sqc_chi dot_at dot_need rs
          (fn_ans dot_prog no_ext rs dot_code)
          (two_ans dot_lo rs)
          (fun
            ((vs (List (BitVec 64)))
             (m Mem)
             (v (BitVec 64))
             (m2 Mem)
             (h (two_ans dot_lo rs vs m v m2)))
            (dot_ans_tie no_ext rs vs m v m2 h))
          (sqc_dot_code_realizes rs))))
    (exact hr)))
;; the module's one outside function realizes the answer the module's code runs with
(theorem sqc_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at sqc_outs j) (some en))
      (realizes sqc_tbl 4194424 sqc_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (sqdiff_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_one (Prod.mk dot_at dot_need) j en h)
      ((intro (hj he) (rw hj) (rw (<- he)) (exact (sqc_dot_realizes rs)))))))

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; `sqdiff`'s code, at the entry the pass answered, realizes the answer of `sqdiff`'s
;; intermediate code, for any data ranges
(theorem sqc_code_realizes ((rs (List Seg)))
  (realizes sqc_tbl 4194424 sqc_chi sqc_at sqc_need rs
    (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code))
  (exact
    (module_realizes sqdiff_prog (sqdiff_ext rs) rs sqc_tbl 4194424 sqc_chi sqc_outs sqc_base
      sqc_listing
      sqc_entries
      sqc_within
      sqc_chi_word
      (sqc_outs_realize rs)
      sqc_compiled
      sqc_placed
      0
      sqdiff_code
      (Prod.mk sqc_at sqc_need)
      sqdiff_code_is
      sqc_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the answer of `sqdiff`'s code on the buffers the start-up pushes: what `sqdiff` computes of
;; them
(theorem sqc_sample
  ((m0 Mem) (hx (holds m0 140737488347112 link_xs)) (hy (holds m0 140737488347088 link_ys)))
  (exists ((m2 Mem))
    (fn_ans sqdiff_prog (sqdiff_ext link_rs) link_rs sqdiff_code link_args m0
      (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)
      m2))
  (exact (Exists.intro m0 (sample_sqdiff_answer m0 hx hy))))
(theorem sqdiff_comp_exits ((r Regs) (f Flags) (m Mem))
  (exits (elf_exec sqc_image) (runner_start r f m) 27)
  (by
    (have hv (= (% (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 27)
      (rw sample_sqdiff)
      (decide))
    (have e
      (exits (elf_exec sqc_image) (runner_start r f m)
        (% (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256))
      (exact
        (link_exits 1 sqc_lines sqc_image sqc_instrs sqc_d sqc_xt sqc_at sqc_chi sqc_need
          (fn_ans sqdiff_prog (sqdiff_ext link_rs) link_rs sqdiff_code)
          (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)
          sqc_assembled
          sqc_resolved
          sqc_laid
          sqc_target
          sqc_within
          sqc_size
          sqc_chi_stack
          sqc_need_fits
          (sqc_code_realizes link_rs)
          sqc_sample
          r
          f
          m)))
    (rw (<- hv))
    (exact e)))
