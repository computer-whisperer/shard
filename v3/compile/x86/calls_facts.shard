;;; v3/compile/x86/calls_facts.shard — the module's theorem met by one module: for the five
;;; functions of calls.shard, compiled at 4194449, every hypothesis of `module_realizes` is closed
;;; by computation, so each function realizes its answer at the entry the pass gave it — the
;;; loop among them, and for any data ranges, the module calling nothing from outside.
(import "module.shard")
(import "calls.shard")
(use compile.ir)
(use compile.x86.calls)
(use compile.x86.code)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(fn calls_table () (List (Prod Nat (Prod Instr Nat))) (layout calls_listing 4194449))
(fn calls_end () Nat (+ 4194449 (isize calls_listing)))
(theorem calls_compiled ()
  (= (compile nil calls_prog 4194449) (some (Prod.mk calls_listing calls_entries)))
  (by rfl))
(theorem calls_placedb () (= (placedb calls_table 4194449 calls_listing) true) (by decide))
(theorem calls_placed () (placed calls_table 4194449 calls_listing)
  (exact (placedb_ok calls_table calls_listing 4194449 calls_placedb)))
(theorem calls_within () (= (all_within calls_table 4194449 calls_end) true) (by decide))
(theorem calls_below () (<= (+ calls_end 15) 18446744073709551616) (by decide))
;; every function of the module realizes its answer at its entry with its need, for any data
;; ranges (the module calls nothing from outside)
(theorem calls_module
  ((rs (List Seg))
   (i Nat)
   (g IFn)
   (en (Prod Nat Nat))
   (hf (= (fn_at calls_prog i) (some g)))
   (he (= (pair_at calls_entries i) (some en))))
  (realizes calls_table 4194449 calls_end (Prod.fst en) (Prod.snd en) rs
    (fn_ans calls_prog no_ext rs g))
  (by
    (have hx
      (forall ((j Nat) (en0 (Prod Nat Nat)))
        (-> (= (pair_at (@List.nil (Prod Nat Nat)) j) (some en0))
          (realizes calls_table 4194449 calls_end (Prod.fst en0) (Prod.snd en0) rs
            (ext_ans no_ext j))))
      (intro j en0 h)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en0)) (exact h))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en0))))
    (exact
      (module_realizes calls_prog no_ext rs calls_table 4194449 calls_end nil 4194449 calls_listing
        calls_entries calls_within calls_below hx calls_compiled calls_placed i g en hf he))))
