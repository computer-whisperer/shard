;;; v3/compile/x86/total_run.shard — a function that writes, two callers above it, through every
;;; layer: the file of total_file.shard, started as the runner starts it, exits with the low
;;; byte of the word `total` (../total_src.shard) — the function over two lists — computes of the
;;; two buffers the start-up pushes: 75. Each function is a module behind a view (../dot,
;;; ../addto, ../both, ../total), and this file has the views and no body. One statement per
;;; seam: the hand-written `dot` realizes the answer of `dot`'s low form; `addto`'s compiled
;;; module realizes its run's answer and so the answer of `addto`'s low form, by the tie in its
;;; view; `both`'s compiled module realizes its run's answer where `addto`'s and `dot`'s code
;;; realize theirs, and so the answer of `both`'s low form; `total`'s likewise over `both` and
;;; `dot`; and a file with a function that realizes its answer exits as the answer says.
(import "total_file.shard")
(import "link.shard")
(import "module.shard")
(import "dot_hand.shard")
(import "../total")
(import "../sample.shard")
(use std.mem)
(use compile.ir)
(use compile.two)
(use compile.upd)
(use compile.sample)
(use compile.dot)
(use compile.addto)
(use compile.addto_obj)
(use compile.both)
(use compile.both_obj)
(use compile.total)
(use compile.total_obj)
(use compile.total_src)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use compile.x86.total_file)
(use compile.x86.startup)
(use compile.x86.dot_hand)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- `dot`, hand-written ----------------------------------------------------------------------------
(theorem tt_dot_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi 4194547 0 rs (two_ans dot_lo rs))
  (exact
    (realizes_part dot_rows tt_tbl 4194424 tt_chi 4194547 0 rs (two_ans dot_lo rs) tt_dot_rows
      (dot_hand_realizes rs 4194424 tt_chi))))

;; ---- `addto`, compiled ------------------------------------------------------------------------------
;; the module's theorem, for a module that calls nothing from outside: the run's answer
(theorem tt_ad_code_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi tt_ad_at tt_ad_need rs (fn_ans addto_prog no_ext rs addto_code))
  (by
    (have hx
      (forall ((j Nat) (en (Prod Nat Nat)))
        (-> (= (pair_at (@List.nil (Prod Nat Nat)) j) (some en))
          (realizes tt_tbl 4194424 tt_chi (Prod.fst en) (Prod.snd en) rs (ext_ans no_ext j))))
      (intro j en h)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact h))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
    (exact
      (module_realizes addto_prog no_ext rs tt_tbl 4194424 tt_chi nil 4194584 tt_ad_listing
        tt_ad_entries
        tt_within
        tt_chi_word
        hx
        tt_ad_compiled
        tt_ad_placed
        1
        addto_code
        (Prod.mk tt_ad_at tt_ad_need)
        addto_code_is
        tt_ad_entry))))
;; and so the answer of `addto`'s low form: whatever it says, the run answers (`addto_ans_tie`)
(theorem tt_ad_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi tt_ad_at tt_ad_need rs (upd_ans addto_lo rs))
  (exact
    (realizes_sub tt_tbl 4194424 tt_chi tt_ad_at tt_ad_need rs
      (fn_ans addto_prog no_ext rs addto_code)
      (upd_ans addto_lo rs)
      (fun
        ((vs (List (BitVec 64)))
         (m Mem)
         (v (BitVec 64))
         (m2 Mem)
         (h (upd_ans addto_lo rs vs m v m2)))
        (addto_ans_tie no_ext rs vs m v m2 h))
      (tt_ad_code_realizes rs))))

;; ---- `both`, compiled -------------------------------------------------------------------------------
(theorem tt_bo_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at tt_bo_outs j) (some en))
      (realizes tt_tbl 4194424 tt_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (both_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_two (Prod.mk tt_ad_at tt_ad_need) (Prod.mk 4194547 0) j en h)
      ((inl (h0)
         (cases h0
           ((intro (hj he) (rw hj) (rw (<- he))
              (have hr (realizes tt_tbl 4194424 tt_chi tt_ad_at tt_ad_need rs (upd_ans addto_lo rs))
                (exact (tt_ad_realizes rs)))
              (exact hr)))))
       (inr (h1)
         (cases h1
           ((intro (hj he) (rw hj) (rw (<- he))
              (have hr (realizes tt_tbl 4194424 tt_chi 4194547 0 rs (two_ans dot_lo rs))
                (exact (tt_dot_realizes rs)))
              (exact hr)))))))))
(theorem tt_bo_code_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi tt_bo_at tt_bo_need rs
    (fn_ans both_prog (both_ext rs) rs both_code))
  (exact
    (module_realizes both_prog (both_ext rs) rs tt_tbl 4194424 tt_chi tt_bo_outs tt_bo_base
      tt_bo_listing
      tt_bo_entries
      tt_within
      tt_chi_word
      (tt_bo_outs_realize rs)
      tt_bo_compiled
      tt_bo_placed
      0
      both_code
      (Prod.mk tt_bo_at tt_bo_need)
      both_code_is
      tt_bo_entry)))
(theorem tt_bo_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi tt_bo_at tt_bo_need rs (upd_ans both_lo rs))
  (exact
    (realizes_sub tt_tbl 4194424 tt_chi tt_bo_at tt_bo_need rs
      (fn_ans both_prog (both_ext rs) rs both_code)
      (upd_ans both_lo rs)
      (fun
        ((vs (List (BitVec 64)))
         (m Mem)
         (v (BitVec 64))
         (m2 Mem)
         (h (upd_ans both_lo rs vs m v m2)))
        (both_ans_tie rs vs m v m2 h))
      (tt_bo_code_realizes rs))))

;; ---- `total`, compiled ------------------------------------------------------------------------------
(theorem tt_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at tt_outs j) (some en))
      (realizes tt_tbl 4194424 tt_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (total_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_two (Prod.mk tt_bo_at tt_bo_need) (Prod.mk 4194547 0) j en h)
      ((inl (h0)
         (cases h0
           ((intro (hj he) (rw hj) (rw (<- he))
              (have hr (realizes tt_tbl 4194424 tt_chi tt_bo_at tt_bo_need rs (upd_ans both_lo rs))
                (exact (tt_bo_realizes rs)))
              (exact hr)))))
       (inr (h1)
         (cases h1
           ((intro (hj he) (rw hj) (rw (<- he))
              (have hr (realizes tt_tbl 4194424 tt_chi 4194547 0 rs (two_ans dot_lo rs))
                (exact (tt_dot_realizes rs)))
              (exact hr)))))))))
(theorem tt_code_realizes ((rs (List Seg)))
  (realizes tt_tbl 4194424 tt_chi tt_at tt_need rs (fn_ans total_prog (total_ext rs) rs total_code))
  (exact
    (module_realizes total_prog (total_ext rs) rs tt_tbl 4194424 tt_chi tt_outs tt_base tt_listing
      tt_entries
      tt_within
      tt_chi_word
      (tt_outs_realize rs)
      tt_compiled
      tt_placed
      0
      total_code
      (Prod.mk tt_at tt_need)
      total_code_is
      tt_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
(theorem tt_sample
  ((m0 Mem) (hx (holds m0 140737488347112 link_xs)) (hy (holds m0 140737488347088 link_ys)))
  (exists ((m2 Mem))
    (fn_ans total_prog (total_ext link_rs) link_rs total_code link_args m0
      (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))
      m2))
  (exact (sample_total_answer m0 hx hy)))
(theorem total_file_exits ((r Regs) (f Flags) (m Mem))
  (exits (elf_exec tt_image) (runner_start r f m) 75)
  (by
    (have hv
      (= (% (w64_val (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))) 256) 75)
      (rw sample_total)
      (decide))
    (have e
      (exits (elf_exec tt_image) (runner_start r f m)
        (% (w64_val (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))) 256))
      (exact
        (link_exits 4 tt_lines tt_image tt_instrs tt_d tt_xt tt_at tt_chi tt_need
          (fn_ans total_prog (total_ext link_rs) link_rs total_code)
          (Prod.fst (total sample_xs sample_ys (w64 3) sample_rx sample_ry))
          tt_assembled
          tt_resolved
          tt_laid
          tt_target
          tt_within
          tt_size
          tt_chi_stack
          tt_need_fits
          (tt_code_realizes link_rs)
          tt_sample
          r
          f
          m)))
    (rw (<- hv))
    (exact e)))
