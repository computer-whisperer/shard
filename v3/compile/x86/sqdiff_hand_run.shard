;;; v3/compile/x86/sqdiff_hand_run.shard — a caller of `dot` through every layer, with the
;;; HAND-WRITTEN `dot` (docs/COMPILE.md §5, §8): the file of sqdiff_hand_file.shard, started as the
;;; runner starts it, exits with the low byte of what `sqdiff` (../sqdiff_lo.shard) — the
;;; function over two lists — computes of the two buffers the start-up pushes: 27. The chain:
;;; `sqdiff`'s low form computes its meaning, and its intermediate code, written by hand,
;;; answers with the low form's value, a call of `dot` by `dot`'s answer (../sqdiff_ir.shard);
;;; `dot`'s ten hand-written instructions realize that answer, by their author's proof
;;; (dot_hand.shard);
;;; the code the pass answers for `sqdiff`'s module realizes its answer where `dot`'s code
;;; realizes `dot`'s (`module_realizes`); and a file with a function that realizes its answer
;;; exits as the answer says (`link_exits`). Of `dot` the caller's side uses one statement, the
;;; same in both files.
(import "sqdiff_hand_file.shard")
(import "link.shard")
(import "module.shard")
(import "dot_hand.shard")
(use std.mem)
(use compile.dot_lo)
(use compile.ir)
(use compile.sqdiff_ir)
(use compile.sqdiff_lo)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use compile.x86.sqdiff_hand_file)
(use compile.x86.startup)
(use compile.x86.dot_hand)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the outside function, in this file -------------------------------------------------------------
;; the hand-written `dot` realizes `dot_ans` over its own rows (`dot_hand_realizes`), and those
;; are rows of this file's table
(theorem sqh_dot_realizes ((rs (List Seg)))
  (realizes sqh_tbl 4194424 sqh_chi 4194489 0 rs (ext_ans (sqdiff_ext rs) 0))
  (by
    (have hr (realizes sqh_tbl 4194424 sqh_chi 4194489 0 rs (dot_ans rs))
      (exact
        (realizes_part dot_rows sqh_tbl 4194424 sqh_chi 4194489 0 rs (dot_ans rs) sqh_dot_rows
          (dot_hand_realizes rs 4194424 sqh_chi))))
    (exact hr)))
;; the module's one outside function realizes the answer the module's code runs with
(theorem sqh_outs_realize ((rs (List Seg)))
  (forall ((j Nat) (en (Prod Nat Nat)))
    (-> (= (pair_at sqh_outs j) (some en))
      (realizes sqh_tbl 4194424 sqh_chi (Prod.fst en) (Prod.snd en) rs (ext_ans (sqdiff_ext rs) j))))
  (by
    (intro j en h)
    (cases (pair_at_one (Prod.mk 4194489 0) j en h)
      ((intro (hj he) (rw hj) (rw (<- he)) (exact (sqh_dot_realizes rs)))))))

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; `sqdiff`'s code, at the entry the pass answered, realizes the answer of `sqdiff`'s
;; intermediate code, for any data ranges
(theorem sqh_code_realizes ((rs (List Seg)))
  (realizes sqh_tbl 4194424 sqh_chi sqh_at sqh_need rs
    (fn_ans sqdiff_prog (sqdiff_ext rs) rs sqdiff_code))
  (exact
    (module_realizes sqdiff_prog (sqdiff_ext rs) rs sqh_tbl 4194424 sqh_chi sqh_outs 4194526
      sqh_listing
      sqh_entries
      sqh_within
      sqh_chi_word
      (sqh_outs_realize rs)
      sqh_compiled
      sqh_placed
      0
      sqdiff_code
      (Prod.mk sqh_at sqh_need)
      sqdiff_code_is
      sqh_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the answer of `sqdiff`'s code on the buffers the start-up pushes: what `sqdiff` computes of
;; them
(theorem sqh_sample
  ((m0 Mem) (hx (holds m0 140737488347112 link_xs)) (hy (holds m0 140737488347088 link_ys)))
  (exists ((m2 Mem))
    (fn_ans sqdiff_prog (sqdiff_ext link_rs) link_rs sqdiff_code link_args m0
      (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)
      m2))
  (exact (Exists.intro m0 (sample_sqdiff_answer m0 hx hy))))
(theorem sqdiff_hand_exits ((r Regs) (f Flags) (m Mem))
  (exits (elf_exec sqh_image) (runner_start r f m) 27)
  (by
    (have hv (= (% (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 27)
      (rw sample_sqdiff)
      (decide))
    (have e
      (exits (elf_exec sqh_image) (runner_start r f m)
        (% (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256))
      (exact
        (link_exits 4 sqh_lines sqh_image sqh_instrs sqh_d sqh_xt sqh_at sqh_chi sqh_need
          (fn_ans sqdiff_prog (sqdiff_ext link_rs) link_rs sqdiff_code)
          (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)
          sqh_assembled
          sqh_resolved
          sqh_laid
          sqh_target
          sqh_within
          sqh_size
          sqh_chi_stack
          sqh_need_fits
          (sqh_code_realizes link_rs)
          sqh_sample
          r
          f
          m)))
    (rw (<- hv))
    (exact e)))
