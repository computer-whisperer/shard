;;; v3/compile/x86/mem.shard — memories that agree on a range; what the data ranges are clear
;;; of; the frame law of a callee that `realizes` an answer: after it returns, the caller's
;;; description holds again; and a word read from the data ranges, a word stored in them, and
;;; the frame law of a store.
(import "pass.shard")
(import "seam_laws.shard")
(use std.mem)
(use compile.x86.seam)
(use compile.x86.seam_laws)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- two memories that agree inside a range (`same_on`, seam_laws.shard) ----------------------------
(theorem le32_on
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (x Nat)
   (h (same_on m m2 lo hi))
   (h1 (<= lo x))
   (h2 (<= (+ x 4) hi)))
  (= (mem_le32 m2 x) (mem_le32 m x))
  (by
    (have a0 (< x hi) (arith))
    (have b1 (<= lo (+ x 1)) (arith))
    (have a1 (< (+ x 1) hi) (arith))
    (have b2 (<= lo (+ x 2)) (arith))
    (have a2 (< (+ x 2) hi) (arith))
    (have b3 (<= lo (+ x 3)) (arith))
    (have a3 (< (+ x 3) hi) (arith))
    (unfold mem_le32)
    (rw (h x h1 a0))
    (rw (h (+ x 1) b1 a1))
    (rw (h (+ x 2) b2 a2))
    (rw (h (+ x 3) b3 a3))
    rfl))
(theorem le64_on
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (x Nat)
   (h (same_on m m2 lo hi))
   (h1 (<= lo x))
   (h2 (<= (+ x 8) hi)))
  (= (mem_le64 m2 x) (mem_le64 m x))
  (by
    (have c1 (<= (+ x 4) hi) (arith))
    (have c2 (<= lo (+ x 4)) (arith))
    (have c3 (<= (+ (+ x 4) 4) hi) (arith))
    (unfold mem_le64)
    (rw (le32_on m m2 lo hi x h h1 c1))
    (rw (le32_on m m2 lo hi (+ x 4) h c2 c3))
    rfl))
(theorem holds_on
  ((m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (q Nat)
   (ys (List (BitVec 64)))
   (h (holds m q ys))
   (hso (same_on m m2 lo hi))
   (h1 (<= lo q))
   (h2 (<= (+ q (* 8 (List.length ys))) hi)))
  (holds m2 q ys)
  (by
    (intro j hj)
    (have b1 (<= lo (+ q (* 8 j))) (arith))
    (have b2 (<= (+ (+ q (* 8 j)) 8) hi) (arith))
    (rw (le64_on m m2 lo hi (+ q (* 8 j)) hso b1 b2))
    (exact (h j hj))))
;; ---- what the data ranges are clear of ----------------------------------------------------------
;; no byte of the frame's words or of the return address is a byte of the data ranges
(theorem frame_not_data
  ((c Cpu)
   (rs (List Seg))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (hdo (data_ok c rs clo chi f k))
   (x Nat)
   (need Nat)
   (h1 (<= f x))
   (h2 (< x (+ f (* 8 (+ k 1))))))
  (= (mapped rs x 1 need) false)
  (by
    (cases (mapped rs x 1 need) hm
      ((false () rfl)
       (true ()
         (cases (And.left (And.right (hdo x 1 need hm)))
           ((inl (a) (have hf False (arith)) (exact (False.elim hf)))
            (inr (b) (have hf False (arith)) (exact (False.elim hf))))))))))
;; a memory that agrees with m on the data ranges, changed in the frame's words alone, agrees
(theorem agree_frame
  ((c Cpu)
   (rs (List Seg))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m Mem)
   (m0 Mem)
   (mc Mem)
   (hdo (data_ok c rs clo chi f k))
   (hag (agree rs m m0))
   (hso (same_outside m0 mc f (+ f (* 8 k)))))
  (agree rs m mc)
  (by
    (intro x need h)
    (cases (And.left (And.right (hdo x 1 need h)))
      ((inl (a) (have o (or (< x f) (<= (+ f (* 8 k)) x)) (apply Or.inl ((arith)))) (rw (hso x o))
         (exact (hag x need h)))
       (inr (b) (have o (or (< x f) (<= (+ f (* 8 k)) x)) (apply Or.inr ((arith)))) (rw (hso x o))
         (exact (hag x need h)))))))
(theorem kept_refl ((rs (List Seg)) (f Nat) (k Nat) (m Mem)) (kept_mem rs f k m m)
  (by (intro x hx hm) rfl))
;; what was kept, then the frame's words changed
(theorem kept_frame
  ((rs (List Seg))
   (f Nat)
   (k Nat)
   (m1 Mem)
   (m0 Mem)
   (mc Mem)
   (hk (kept_mem rs f k m1 m0))
   (hso (same_outside m0 mc f (+ f (* 8 k)))))
  (kept_mem rs f k m1 mc)
  (by (intro x hx hm) (rw (hso x hx)) (exact (hk x hx hm))))
;; what was kept, then what a callee kept whose words lie inside the frame's
(theorem kept_call
  ((rs (List Seg))
   (f Nat)
   (k Nat)
   (f2 Nat)
   (k2 Nat)
   (m1 Mem)
   (mb Mem)
   (mc Mem)
   (hk1 (kept_mem rs f k m1 mb))
   (hk2 (kept_mem rs f2 k2 mb mc))
   (hlo (<= f f2))
   (hhi (<= (+ f2 (* 8 k2)) (+ f (* 8 k)))))
  (kept_mem rs f k m1 mc)
  (by
    (intro x hx hm)
    (have o (or (< x f2) (<= (+ f2 (* 8 k2)) x))
      (cases hx ((inl (a) (apply Or.inl ((arith)))) (inr (b) (apply Or.inr ((arith)))))))
    (rw (hk2 x o hm))
    (exact (hk1 x hx hm))))

;; ---- a callee inside a caller's frame -----------------------------------------------------------
;; The state c a callee is entered in, described j words up with the return address first: the
;; callee has room for k2 words that end where the return address stands, k2 no more than j.
(theorem room_sub
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ra (BitVec 64))
   (ws (List (BitVec 64)))
   (f2 Nat)
   (k2 Nat)
   (h (framed c0 tbl clo chi f k m0 c j (cons ra ws)))
   (hf2 (= (+ f2 (* 8 k2)) (+ f (* 8 j))))
   (hlo (<= f f2)))
  (room c clo chi f2 k2)
  (by
    (have hr (room c0 clo chi f k) (exact (framed_room h)))
    (have hrd (mapped_words (Cpu.segs c0) f (+ k 1) 4) (exact (And.left (And.right hr))))
    (have hwr (mapped_words (Cpu.segs c0) f k 2) (exact (And.left (And.right (And.right hr)))))
    (have hclear (or (<= (+ chi 15) f) (<= (+ f (* 8 k)) clo))
      (exact (And.right (And.right (And.right hr)))))
    (have hl (= (+ j (+ (List.length ws) 1)) (+ k 1)) (exact (framed_len h)))
    (have hkj (<= k2 j) (arith))
    (have ee (= (+ (- j k2) k2) j) (exact (Nat.sub_add_cancel hkj)))
    (have hsp (= (w64_val (reg c 4)) (+ f2 (* 8 k2))) (rw hf2) (exact (framed_sp h)))
    (have m1 (mapped_words (Cpu.segs c) f2 (+ k2 1) 4)
      (intro i hi)
      (have ei (= (+ f2 (* 8 i)) (+ f (* 8 (+ (- j k2) i)))) (arith ee hf2))
      (have hb (< (+ (- j k2) i) (+ k 1)) (arith ee hl))
      (rw ei)
      (rw (framed_segs h))
      (exact (hrd (+ (- j k2) i) hb)))
    (have m2 (mapped_words (Cpu.segs c) f2 k2 2)
      (intro i hi)
      (have ei (= (+ f2 (* 8 i)) (+ f (* 8 (+ (- j k2) i)))) (arith ee hf2))
      (have hb (< (+ (- j k2) i) k) (arith ee hl))
      (rw ei)
      (rw (framed_segs h))
      (exact (hwr (+ (- j k2) i) hb)))
    (have cl (or (<= (+ chi 15) f2) (<= (+ f2 (* 8 k2)) clo))
      (cases hclear ((inl (a) (apply Or.inl ((arith)))) (inr (b) (apply Or.inr ((arith hl)))))))
    (exact (And.intro hsp (And.intro m1 (And.intro m2 cl))))))
;; and the data ranges are as the callee's statement asks
(theorem data_sub
  ((c0 Cpu)
   (c Cpu)
   (rs (List Seg))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (f2 Nat)
   (k2 Nat)
   (hdo (data_ok c0 rs clo chi f k))
   (hsegs (= (Cpu.segs c) (Cpu.segs c0)))
   (hlo (<= f f2))
   (hhi (<= (+ f2 (* 8 (+ k2 1))) (+ f (* 8 (+ k 1))))))
  (data_ok c rs clo chi f2 k2)
  (by
    (intro a n need h)
    (cases (hdo a n need h)
      ((intro (g1 g23)
         (cases g23
           ((intro (g2 g3)
              (apply And.intro ((rw hsegs) (exact g1))
                ((apply And.intro
                   ((cases g2
                      ((inl (x) (apply Or.inl ((arith)))) (inr (y) (apply Or.inr ((arith)))))))
                   ((exact g3)))))))))))))

;; ---- THE FRAME LAW: a callee that kept memory has returned ---------------------------------------
;; A callee entered in the described state c, its return address the first of the words, has
;; returned in c2, having left every byte as it was outside its own k2 words — which end where
;; the return address stands — and outside what the data ranges map to write: c2 is described,
;; a word up, and the base memory is c2's.
(theorem framed_back_kept
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ra (BitVec 64))
   (w (BitVec 64))
   (ws (List (BitVec 64)))
   (c2 Cpu)
   (rs (List Seg))
   (f2 Nat)
   (k2 Nat)
   (h (framed c0 tbl clo chi f k m0 c j (cons ra (cons w ws))))
   (hdo (data_ok c0 rs clo chi f k))
   (hret (returned c c2))
   (hkm (kept_mem rs f2 k2 (Cpu.mem c) (Cpu.mem c2)))
   (hf2 (= (+ f2 (* 8 k2)) (+ f (* 8 j))))
   (hlo (<= f f2)))
  (framed c0 tbl clo chi f k (Cpu.mem c2) c2 (+ j 1) (cons w ws))
  (by
    (have kp (kept c c2) (exact (returned_kept c c2 hret)))
    (have hr (room c0 clo chi f k) (exact (framed_room h)))
    (have hclear (or (<= (+ chi 15) f) (<= (+ f (* 8 k)) clo))
      (exact (And.right (And.right (And.right hr)))))
    (have hl (= (+ j (+ (+ (List.length ws) 1) 1)) (+ k 1)) (exact (framed_len h)))
    (have son1 (same_on (Cpu.mem c) (Cpu.mem c2) (+ f (* 8 (+ j 1))) (+ f (* 8 (+ k 1))))
      (intro x h1 h2)
      (have o (or (< x f2) (<= (+ f2 (* 8 k2)) x)) (apply Or.inr ((arith))))
      (have g1 (<= f x) (arith))
      (have hm (= (mapped rs x 1 2) false) (exact (frame_not_data c0 rs clo chi f k hdo x 2 g1 h2)))
      (exact (hkm x o hm)))
    (have ht (holds (Cpu.mem c) (+ (+ f (* 8 j)) 8) (cons w ws))
      (exact (holds_tail (Cpu.mem c) (+ f (* 8 j)) ra (cons w ws) (framed_holds h))))
    (have ea (= (+ f (* 8 (+ j 1))) (+ (+ f (* 8 j)) 8)) (arith))
    (have hh (holds (Cpu.mem c2) (+ f (* 8 (+ j 1))) (cons w ws))
      (rw ea)
      (apply
        (holds_on (Cpu.mem c) (Cpu.mem c2) (+ f (* 8 (+ j 1))) (+ f (* 8 (+ k 1)))
          (+ (+ f (* 8 j)) 8)
          (cons w ws)
          ht
          son1)
        ((arith))
        ((show (<= (+ (+ (+ f (* 8 j)) 8) (* 8 (+ (List.length ws) 1))) (+ f (* 8 (+ k 1)))))
         (arith))))
    (have son2 (same_on (Cpu.mem c) (Cpu.mem c2) clo (+ chi 15))
      (intro x h1 h2)
      (have o (or (< x f2) (<= (+ f2 (* 8 k2)) x))
        (cases hclear ((inl (a) (apply Or.inl ((arith)))) (inr (b) (apply Or.inr ((arith)))))))
      (have hm (= (mapped rs x 1 2) false) (exact (code_not_data c0 rs clo chi f k hdo x 2 h1 h2)))
      (exact (hkm x o hm)))
    (have hc2 (code_in c2 tbl)
      (exact (code_in_on c c2 tbl clo chi (framed_all h) (kept_segs c c2 kp) son2 (framed_code h))))
    (exact
      (framed_up h (kept_segs c c2 kp) (kept_sp c c2 kp) hh hc2
        (same_outside_refl (Cpu.mem c2) f (+ f (* 8 k)))))))

;; ---- a load and a store in the data ranges ------------------------------------------------------
;; memories that agree on the data ranges agree on a range the data ranges map
(theorem agree_on
  ((rs (List Seg))
   (m Mem)
   (mc Mem)
   (a Nat)
   (n Nat)
   (need Nat)
   (h (agree rs m mc))
   (hm (= (mapped rs a n need) true)))
  (same_on m mc a (+ a n))
  (by
    (intro x h1 h2)
    (have h3 (<= (+ x 1) (+ a n)) (arith))
    (exact (h x need (mapped_part rs a n x 1 need h1 h3 hm)))))
;; so a word read there is the same in both
(theorem agree_le64
  ((rs (List Seg))
   (m Mem)
   (mc Mem)
   (a Nat)
   (need Nat)
   (h (agree rs m mc))
   (hm (= (mapped rs a 8 need) true)))
  (= (mem_le64 mc a) (mem_le64 m a))
  (exact
    (le64_on m mc a (+ a 8) a (agree_on rs m mc a 8 need h hm) (Nat.le_refl a) (Nat.le_refl (+ a 8)))))
;; a byte two memories agree on, they agree on after the same store: of a byte, of four, of eight
(theorem set_agree ((m Mem) (mc Mem) (k Nat) (v Nat) (x Nat) (h (= (mem_get mc x) (mem_get m x))))
  (= (mem_get (mem_set mc k v) x) (mem_get (mem_set m k v) x))
  (by
    (cases (Nat.decEq x k)
      ((isTrue (e) (rw e) (rw (mem_set_same mc k v)) (rw (mem_set_same m k v)) rfl)
       (isFalse (ne) (rw (mem_set_other mc k v x ne)) (rw (mem_set_other m k v x ne)) (exact h))))))
(theorem put32_agree ((m Mem) (mc Mem) (a Nat) (v Nat) (x Nat) (h (= (mem_get mc x) (mem_get m x))))
  (= (mem_get (mem_put32 mc a v) x) (mem_get (mem_put32 m a v) x))
  (by
    (unfold mem_put32)
    (exact
      (set_agree (mem_set (mem_set (mem_set m a v) (+ a 1) (/ v 256)) (+ a 2) (/ v 65536))
        (mem_set (mem_set (mem_set mc a v) (+ a 1) (/ v 256)) (+ a 2) (/ v 65536))
        (+ a 3)
        (/ v 16777216)
        x
        (set_agree (mem_set (mem_set m a v) (+ a 1) (/ v 256))
          (mem_set (mem_set mc a v) (+ a 1) (/ v 256))
          (+ a 2)
          (/ v 65536)
          x
          (set_agree (mem_set m a v) (mem_set mc a v) (+ a 1) (/ v 256) x (set_agree m mc a v x h)))))))
(theorem put64_agree ((m Mem) (mc Mem) (a Nat) (v Nat) (x Nat) (h (= (mem_get mc x) (mem_get m x))))
  (= (mem_get (mem_put64 mc a v) x) (mem_get (mem_put64 m a v) x))
  (by
    (unfold mem_put64)
    (exact
      (put32_agree (mem_put32 m a v) (mem_put32 mc a v) (+ a 4) (/ v 4294967296) x
        (put32_agree m mc a v x h)))))
;; a word stored in each of two memories that agree on the data ranges: they agree
(theorem agree_put64 ((rs (List Seg)) (m Mem) (mc Mem) (a Nat) (v Nat) (h (agree rs m mc)))
  (agree rs (mem_put64 m a v) (mem_put64 mc a v))
  (by (intro x need hm) (exact (put64_agree m mc a v x (h x need hm)))))
;; what was kept, then a word stored where the data ranges map to write
(theorem kept_put64
  ((rs (List Seg))
   (f Nat)
   (k Nat)
   (m1 Mem)
   (mc Mem)
   (a Nat)
   (v Nat)
   (hk (kept_mem rs f k m1 mc))
   (hm (= (mapped rs a 8 2) true)))
  (kept_mem rs f k m1 (mem_put64 mc a v))
  (by
    (intro x hx hf)
    (have ho (or (< x a) (<= (+ a 8) x))
      (cases (Nat.decLt x a)
        ((isTrue (h1) (apply Or.inl ((exact h1))))
         (isFalse (h1)
           (cases (Nat.decLe (+ a 8) x)
             ((isTrue (h2) (apply Or.inr ((exact h2))))
              (isFalse (h2) (have g1 (<= a x) (arith)) (have g2 (<= (+ x 1) (+ a 8)) (arith))
                (have ht (= (mapped rs x 1 2) true) (exact (mapped_part rs a 8 x 1 2 g1 g2 hm)))
                (exact (absurd (Eq.trans (Eq.symm hf) ht) Bool.false_ne_true)))))))))
    (rw (mem_put64_other mc a v x ho))
    (exact (hk x hx hf))))

;; ---- THE FRAME LAW OF A STORE -------------------------------------------------------------------
;; A word stored, in the described state c, where the data ranges map to write: the state after
;; is described as c was, and the base memory is its own. The data ranges are clear of the
;; frame's words and of the code.
(theorem framed_store
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ws (List (BitVec 64)))
   (rs (List Seg))
   (q Nat)
   (v Nat)
   (pc (BitVec 64))
   (h (framed c0 tbl clo chi f k m0 c j ws))
   (hdo (data_ok c0 rs clo chi f k))
   (hm (= (mapped rs q 8 2) true)))
  (framed c0 tbl clo chi f k (mem_put64 (Cpu.mem c) q v)
    (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc)
    j
    ws)
  (by
    (have hl (= (+ j (List.length ws)) (+ k 1)) (exact (framed_len h)))
    (have hso (same_outside (Cpu.mem c) (mem_put64 (Cpu.mem c) q v) q (+ q 8))
      (exact
        (same_outside_put64 (Cpu.mem c) (Cpu.mem c) q (+ q 8) q v
          (same_outside_refl (Cpu.mem c) q (+ q 8))
          (Nat.le_refl q)
          (Nat.le_refl (+ q 8)))))
    (have hcl (or (<= (+ (+ f (* 8 j)) (* 8 (List.length ws))) q) (<= (+ q 8) (+ f (* 8 j))))
      (cases (And.left (And.right (hdo q 8 2 hm)))
        ((inl (a) (apply Or.inr ((arith)))) (inr (b) (apply Or.inl ((arith hl)))))))
    (have g3 (holds (Cpu.mem (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc)) (+ f (* 8 j)) ws)
      (exact
        (holds_same (Cpu.mem c) (mem_put64 (Cpu.mem c) q v) q (+ q 8) (+ f (* 8 j)) ws
          (framed_holds h)
          hso
          hcl)))
    (have hcc (or (<= (+ chi 15) q) (<= (+ q 8) clo))
      (cases (And.right (And.right (hdo q 8 2 hm)))
        ((inl (a) (apply Or.inr ((exact a)))) (inr (b) (apply Or.inl ((exact b)))))))
    (have g4 (code_in (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc) tbl)
      (exact
        (code_in_same c (mem_put64 (Cpu.mem c) q v) tbl clo chi q (+ q 8) (framed_all h) hso hcc
          (framed_code h))))
    (have g1 (= (Cpu.segs (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc)) (Cpu.segs c0))
      (exact (framed_segs h)))
    (have g2 (= (w64_val (reg (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc) 4)) (+ f (* 8 j)))
      (exact (framed_sp h)))
    (have g5
      (same_outside (mem_put64 (Cpu.mem c) q v)
        (Cpu.mem (at_pc (mem_to c (mem_put64 (Cpu.mem c) q v)) pc))
        f
        (+ f (* 8 k)))
      (exact (same_outside_refl (mem_put64 (Cpu.mem c) q v) f (+ f (* 8 k)))))
    (exact
      (And.intro (framed_room h)
        (And.intro (framed_all h)
          (And.intro g1 (And.intro g2 (And.intro g3 (And.intro hl (And.intro g4 g5))))))))))
