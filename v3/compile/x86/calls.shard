;;; v3/compile/x86/calls.shard — a module of five functions with calls, an `if` and a loop, and
;;; the listing the pass answers for it. That each function's code realizes its answer is
;;; calls_facts.shard's; the module as a file the processor runs is calls_main.shard's.
(import "pass.shard")
(use std.mem)
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use compile.x86.pass)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; f0(a, b) = a + (b + b)
;; f1(a, b) = ((a - b) xor 5) and 255
;; f2(a, b) = if a < b then f0(b, a) + 1 else f1(a, b) or 1024
;; f3(n, acc) = if n < 1 then acc else f3(n - 1, acc + n)   — a loop: a tail call of itself
;; f4(a, b) = f0(b, a)                                      — a tail call of another function
(fn calls_prog () (List IFn)
  (cons (MkIFn 2 1 (SLet 2 (EOp OAdd (EVar 1) (EVar 1)) (SRet (EOp OAdd (EVar 0) (EVar 2)))))
    (cons
      (MkIFn 2 0
        (SLet 0 (EOp OSub (EVar 0) (EVar 1))
          (SLet 0 (EOp OXor (EVar 0) (ENum (w64 5))) (SRet (EOp OAnd (EVar 0) (ENum (w64 255)))))))
      (cons
        (MkIFn 2 1
          (SIf (EVar 0) CLtu (EVar 1)
            (SCall 2 (CFn 0) (cons (EVar 1) (cons (EVar 0) nil))
              (SRet (EOp OAdd (EVar 2) (ENum (w64 1)))))
            (SCall 2 (CFn 1) (cons (EVar 0) (cons (EVar 1) nil))
              (SRet (EOp OOr (EVar 2) (ENum (w64 1024)))))))
        (cons
          (MkIFn 2 0
            (SIf (EVar 0) CLtu (ENum (w64 1)) (SRet (EVar 1))
              (SLet 1 (EOp OAdd (EVar 1) (EVar 0))
                (SLet 0 (EOp OSub (EVar 0) (ENum (w64 1)))
                  (STail (CFn 3) (cons (EVar 0) (cons (EVar 1) nil)))))))
          (cons (MkIFn 2 0 (STail (CFn 0) (cons (EVar 1) (cons (EVar 0) nil)))) nil))))))
;; function i of the module on the words a and b, as the intermediate machine runs it
(fn calls_value ((i Nat) (a Nat) (b Nat)) (Option Nat)
  (match (fn_at calls_prog i)
    (none none)
    ((some g)
     (match
       (irun (fuel_of 10000) calls_prog no_ext nil (IFn.body g)
         (enter g (cons (w64 a) (cons (w64 b) nil)))
         mem_empty)
       (none none)
       ((some r) (some (w64_val (Prod.fst r))))))))

;; ---- compiled at 4194449, the address after calls_main.shard's six first instructions ----------
(fn calls_listing () (List Instr)
  (match (compile nil calls_prog 4194449)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn calls_entries () (List (Prod Nat Nat))
  (match (compile nil calls_prog 4194449)
    (none nil)
    ((some (Prod.mk l f)) f)))
