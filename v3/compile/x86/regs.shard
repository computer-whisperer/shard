;;; v3/compile/x86/regs.shard — the six registers the locals live in and the nine temporaries
;;; an expression goes through, and what a move into one of them, or into an argument register,
;;; leaves as it was.
(import "pass.shard")
(import "lists.shard")
(use std.mem)
(use compile.ir)
(use compile.x86.lists)
(use compile.x86.pass)
(use compile.x86.seam)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; a fact of each number below six is a fact of every number below six
(theorem six_all
  ((P (-> Nat Prop))
   (h0 (P 0))
   (h1 (P 1))
   (h2 (P 2))
   (h3 (P 3))
   (h4 (P 4))
   (h5 (P 5))
   (x Nat)
   (h (< x 6)))
  (P x)
  (by
    (cases x
      ((zero () (exact h0))
       (succ (x1)
         (cases x1
           ((zero () (exact h1))
            (succ (x2)
              (cases x2
                ((zero () (exact h2))
                 (succ (x3)
                   (cases x3
                     ((zero () (exact h3))
                      (succ (x4)
                        (cases x4
                          ((zero () (exact h4))
                           (succ (x5)
                             (cases x5
                               ((zero () (exact h5))
                                (succ (x6) (have hf False (arith h)) (exact (False.elim hf))))))))))))))))))))))
;; the words of the six registers of the locals, in the locals' order
(fn regs6 ((c Cpu)) (List (BitVec 64))
  (cons (reg c 3)
    (cons (reg c 5) (cons (reg c 12) (cons (reg c 13) (cons (reg c 14) (cons (reg c 15) nil)))))))
(theorem reg_k ((c Cpu) (i Nat) (h (< i 6))) (= (nth (regs6 c) i) (reg c (kreg i)))
  (by
    (apply (six_all (fun ((i Nat)) (= (nth (regs6 c) i) (reg c (kreg i))))) (rfl) (rfl) (rfl) (rfl)
      (rfl)
      (rfl)
      (exact h))))
;; a local's register holds the local
(theorem loc_reg
  ((c Cpu)
   (ls (List (BitVec 64)))
   (nl Nat)
   (i Nat)
   (hls (= ls (List.take nl (regs6 c))))
   (hi (< i nl))
   (hnl (<= nl 6)))
  (= (reg c (kreg i)) (nth ls i))
  (by
    (have h6 (< i 6) (arith))
    (rw hls)
    (rw (nth_take (regs6 c) nl i hi))
    (exact (Eq.symm (reg_k c i h6)))))
;; a local's register set: the six words with that one replaced
(theorem kset_regs ((c Cpu) (x Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< x 6)))
  (= (regs6 (at_pc (set_reg c (kreg x) w) pc)) (upd (regs6 c) x w))
  (by
    (apply
      (six_all (fun ((x Nat)) (= (regs6 (at_pc (set_reg c (kreg x) w) pc)) (upd (regs6 c) x w))))
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
;; and the frame's description stands
(theorem framed_kset
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ws (List (BitVec 64)))
   (x Nat)
   (v (BitVec 64))
   (pc (BitVec 64))
   (hx (< x 6))
   (w (framed c0 tbl clo chi f k m0 c j ws)))
  (framed c0 tbl clo chi f k m0 (at_pc (set_reg c (kreg x) v) pc) j ws)
  (by
    (apply
      (six_all (fun ((x Nat)) (framed c0 tbl clo chi f k m0 (at_pc (set_reg c (kreg x) v) pc) j ws)))
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact hx))))
;; an argument register set: the six words as they were, the description too, and the argument
;; registers up to it hold one word more
(theorem aset_regs ((c Cpu) (i Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< i 6)))
  (= (regs6 (at_pc (set_reg c (areg i) w) pc)) (regs6 c))
  (by
    (apply (six_all (fun ((i Nat)) (= (regs6 (at_pc (set_reg c (areg i) w) pc)) (regs6 c)))) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
(theorem framed_aset
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ws (List (BitVec 64)))
   (i Nat)
   (v (BitVec 64))
   (pc (BitVec 64))
   (hi (< i 6))
   (w (framed c0 tbl clo chi f k m0 c j ws)))
  (framed c0 tbl clo chi f k m0 (at_pc (set_reg c (areg i) v) pc) j ws)
  (by
    (apply
      (six_all (fun ((i Nat)) (framed c0 tbl clo chi f k m0 (at_pc (set_reg c (areg i) v) pc) j ws)))
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact w)
      (exact hi))))
(theorem aset_args ((c Cpu) (i Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< i 6)))
  (= (regs_of (at_pc (set_reg c (areg i) w) pc) (List.take (+ i 1) arg_regs))
    (app (regs_of c (List.take i arg_regs)) (cons w nil)))
  (by
    (apply
      (six_all
        (fun ((i Nat))
          (= (regs_of (at_pc (set_reg c (areg i) w) pc) (List.take (+ i 1) arg_regs))
            (app (regs_of c (List.take i arg_regs)) (cons w nil)))))
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))

;; ---- a state that differs in scratch registers, flags and program counter alone -----------------
(def scratch ((c Cpu) (c1 Cpu)) Prop
  (and (= (Cpu.segs c1) (Cpu.segs c))
    (and (= (Cpu.mem c1) (Cpu.mem c)) (and (= (reg c1 4) (reg c 4)) (= (regs6 c1) (regs6 c))))))
(theorem framed_scratch
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ws (List (BitVec 64)))
   (c1 Cpu)
   (w (framed c0 tbl clo chi f k m0 c j ws))
   (h (scratch c c1)))
  (framed c0 tbl clo chi f k m0 c1 j ws)
  (by
    (have hsegs (= (Cpu.segs c1) (Cpu.segs c)) (exact (And.left h)))
    (have hmem (= (Cpu.mem c1) (Cpu.mem c)) (exact (And.left (And.right h))))
    (have hsp (= (reg c1 4) (reg c 4)) (exact (And.left (And.right (And.right h)))))
    (have g1 (= (Cpu.segs c1) (Cpu.segs c0)) (exact (Eq.trans hsegs (framed_segs w))))
    (have g2 (= (w64_val (reg c1 4)) (+ f (* 8 j))) (rw hsp) (exact (framed_sp w)))
    (have g3 (holds (Cpu.mem c1) (+ f (* 8 j)) ws) (rw hmem) (exact (framed_holds w)))
    (have g4 (code_in c1 tbl) (exact (code_in_of c c1 tbl hsegs hmem (framed_code w))))
    (have g5 (same_outside m0 (Cpu.mem c1) f (+ f (* 8 k))) (rw hmem) (exact (framed_mem w)))
    (exact
      (And.intro (framed_room w)
        (And.intro (framed_all w)
          (And.intro g1 (And.intro g2 (And.intro g3 (And.intro (framed_len w) (And.intro g4 g5))))))))))
(theorem scratch_regs ((c Cpu) (c1 Cpu) (h (scratch c c1))) (= (regs6 c1) (regs6 c))
  (exact (And.right (And.right (And.right h)))))
(theorem scratch_trans ((c Cpu) (c1 Cpu) (c2 Cpu) (h1 (scratch c c1)) (h2 (scratch c1 c2)))
  (scratch c c2)
  (by
    (have g1 (= (Cpu.segs c2) (Cpu.segs c)) (exact (Eq.trans (And.left h2) (And.left h1))))
    (have g2 (= (Cpu.mem c2) (Cpu.mem c))
      (exact (Eq.trans (And.left (And.right h2)) (And.left (And.right h1)))))
    (have g3 (= (reg c2 4) (reg c 4))
      (exact (Eq.trans (And.left (And.right (And.right h2))) (And.left (And.right (And.right h1))))))
    (have g4 (= (regs6 c2) (regs6 c))
      (exact (Eq.trans (scratch_regs c1 c2 h2) (scratch_regs c c1 h1))))
    (exact (And.intro g1 (And.intro g2 (And.intro g3 g4))))))

;; ---- the nine temporaries -----------------------------------------------------------------------
;; a fact of each number below nine is a fact of every number below nine
(theorem nine_all
  ((P (-> Nat Prop))
   (h0 (P 0))
   (h1 (P 1))
   (h2 (P 2))
   (h3 (P 3))
   (h4 (P 4))
   (h5 (P 5))
   (h6 (P 6))
   (h7 (P 7))
   (h8 (P 8))
   (x Nat)
   (h (< x 9)))
  (P x)
  (by
    (cases x
      ((zero () (exact h0))
       (succ (x1)
         (cases x1
           ((zero () (exact h1))
            (succ (x2)
              (cases x2
                ((zero () (exact h2))
                 (succ (x3) (have hx (< x3 6) (arith h))
                   (exact (six_all (fun ((y Nat)) (P (+ (+ (+ y 1) 1) 1))) h3 h4 h5 h6 h7 h8 x3 hx)))))))))))))
;; the words of the temporaries, in the temporaries' order
(fn tregs ((c Cpu)) (List (BitVec 64))
  (cons (reg c 0)
    (cons (reg c 1)
      (cons (reg c 2)
        (cons (reg c 6)
          (cons (reg c 7) (cons (reg c 8) (cons (reg c 9) (cons (reg c 10) (cons (reg c 11) nil))))))))))
(theorem treg_nth ((c Cpu) (j Nat) (h (< j 9))) (= (nth (tregs c) j) (reg c (treg j)))
  (by
    (apply (nine_all (fun ((j Nat)) (= (nth (tregs c) j) (reg c (treg j))))) (rfl) (rfl) (rfl) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
;; a temporary set: it holds the word; the temporaries below it, the stack pointer and the six
;; registers of the locals are as they were
(theorem tset_self ((c Cpu) (k Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< k 9)))
  (= (reg (at_pc (set_reg c (treg k) w) pc) (treg k)) w)
  (by
    (apply (nine_all (fun ((k Nat)) (= (reg (at_pc (set_reg c (treg k) w) pc) (treg k)) w))) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
(theorem tset_take ((c Cpu) (k Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< k 9)))
  (= (List.take k (tregs (at_pc (set_reg c (treg k) w) pc))) (List.take k (tregs c)))
  (by
    (apply
      (nine_all
        (fun ((k Nat))
          (= (List.take k (tregs (at_pc (set_reg c (treg k) w) pc))) (List.take k (tregs c)))))
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
(theorem tset_low
  ((c Cpu) (k Nat) (j Nat) (w (BitVec 64)) (pc (BitVec 64)) (hk (< k 9)) (hj (< j k)))
  (= (reg (at_pc (set_reg c (treg k) w) pc) (treg j)) (reg c (treg j)))
  (by
    (have hj9 (< j 9) (arith))
    (have e1
      (= (nth (List.take k (tregs (at_pc (set_reg c (treg k) w) pc))) j)
        (nth (tregs (at_pc (set_reg c (treg k) w) pc)) j))
      (exact (nth_take (tregs (at_pc (set_reg c (treg k) w) pc)) k j hj)))
    (have e2 (= (nth (List.take k (tregs c)) j) (nth (tregs c) j))
      (exact (nth_take (tregs c) k j hj)))
    (rw (<- (treg_nth (at_pc (set_reg c (treg k) w) pc) j hj9)))
    (rw (<- (treg_nth c j hj9)))
    (rw (<- e1))
    (rw (<- e2))
    (rw (tset_take c k w pc hk))
    rfl))
(theorem tset_sp ((c Cpu) (k Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< k 9)))
  (= (reg (at_pc (set_reg c (treg k) w) pc) 4) (reg c 4))
  (by
    (apply (nine_all (fun ((k Nat)) (= (reg (at_pc (set_reg c (treg k) w) pc) 4) (reg c 4)))) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
(theorem tset_regs ((c Cpu) (k Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< k 9)))
  (= (regs6 (at_pc (set_reg c (treg k) w) pc)) (regs6 c))
  (by
    (apply (nine_all (fun ((k Nat)) (= (regs6 (at_pc (set_reg c (treg k) w) pc)) (regs6 c)))) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))

;; ---- a state that differs in the temporaries from k on, flags and program counter alone ---------
(def tstep ((k Nat) (c Cpu) (c1 Cpu)) Prop
  (and (scratch c c1) (forall ((j Nat)) (-> (< j k) (= (reg c1 (treg j)) (reg c (treg j)))))))
(theorem tstep_scratch ((k Nat) (c Cpu) (c1 Cpu) (h (tstep k c c1))) (scratch c c1)
  (exact (And.left h)))
(theorem tstep_low ((k Nat) (c Cpu) (c1 Cpu) (j Nat) (h (tstep k c c1)) (hj (< j k)))
  (= (reg c1 (treg j)) (reg c (treg j)))
  (by
    (have hl (forall ((i Nat)) (-> (< i k) (= (reg c1 (treg i)) (reg c (treg i)))))
      (exact (And.right h)))
    (exact (hl j hj))))
(theorem tstep_trans ((k Nat) (c Cpu) (c1 Cpu) (c2 Cpu) (h1 (tstep k c c1)) (h2 (tstep k c1 c2)))
  (tstep k c c2)
  (by
    (apply And.intro ((exact (scratch_trans c c1 c2 (And.left h1) (And.left h2))))
      ((intro j hj) (exact (Eq.trans (tstep_low k c1 c2 j h2 hj) (tstep_low k c c1 j h1 hj)))))))
;; what leaves the temporaries below k + 1 leaves those below k
(theorem tstep_down ((k Nat) (c Cpu) (c1 Cpu) (h (tstep (+ k 1) c c1))) (tstep k c c1)
  (by
    (apply And.intro ((exact (And.left h)))
      ((intro j hj) (have hj1 (< j (+ k 1)) (arith)) (exact (tstep_low (+ k 1) c c1 j h hj1))))))
(theorem tstep_set ((k Nat) (c Cpu) (w (BitVec 64)) (pc (BitVec 64)) (h (< k 9)))
  (tstep k c (at_pc (set_reg c (treg k) w) pc))
  (by
    (have s1 (= (Cpu.segs (at_pc (set_reg c (treg k) w) pc)) (Cpu.segs c)) rfl)
    (have s2 (= (Cpu.mem (at_pc (set_reg c (treg k) w) pc)) (Cpu.mem c)) rfl)
    (apply And.intro
      ((exact (And.intro s1 (And.intro s2 (And.intro (tset_sp c k w pc h) (tset_regs c k w pc h))))))
      ((intro j hj) (exact (tset_low c k j w pc h hj))))))
(theorem tstep_flags ((k Nat) (c Cpu) (fl Flags)) (tstep k c (set_flags c fl))
  (by
    (have s1 (= (Cpu.segs (set_flags c fl)) (Cpu.segs c)) rfl)
    (have s2 (= (Cpu.mem (set_flags c fl)) (Cpu.mem c)) rfl)
    (have s3 (= (reg (set_flags c fl) 4) (reg c 4)) rfl)
    (have s4 (= (regs6 (set_flags c fl)) (regs6 c)) rfl)
    (apply And.intro ((exact (And.intro s1 (And.intro s2 (And.intro s3 s4))))) ((intro j hj) rfl))))
;; a description at an index that is the same number
(theorem framed_idx
  ((c0 Cpu)
   (tbl (List (Prod Nat (Prod Instr Nat))))
   (clo Nat)
   (chi Nat)
   (f Nat)
   (k Nat)
   (m0 Mem)
   (c Cpu)
   (j Nat)
   (ws (List (BitVec 64)))
   (j2 Nat)
   (w (framed c0 tbl clo chi f k m0 c j ws))
   (e (= j j2)))
  (framed c0 tbl clo chi f k m0 c j2 ws)
  (by (rw (<- e)) (exact w)))

;; ---- a function's entry -------------------------------------------------------------------------
;; local i as the prologue sets it: the i-th argument, or zero
(fn ival ((i Nat) (np Nat) (c Cpu)) (BitVec 64) (if (< i np) (reg c (areg i)) (w64 0)))
(theorem ivals ((c Cpu) (np Nat) (h (<= np 6)))
  (=
    (cons (ival 0 np c)
      (cons (ival 1 np c)
        (cons (ival 2 np c) (cons (ival 3 np c) (cons (ival 4 np c) (cons (ival 5 np c) nil))))))
    (app (regs_of c (List.take np arg_regs)) (zeros (- 6 np))))
  (by
    (cases np
      ((zero () (reduce) rfl)
       (succ (n1)
         (cases n1
           ((zero () (reduce) rfl)
            (succ (n2)
              (cases n2
                ((zero () (reduce) rfl)
                 (succ (n3)
                   (cases n3
                     ((zero () (reduce) rfl)
                      (succ (n4)
                        (cases n4
                          ((zero () (reduce) rfl)
                           (succ (n5)
                             (cases n5
                               ((zero () (reduce) rfl)
                                (succ (n6)
                                  (cases n6
                                    ((zero () (reduce) rfl)
                                     (succ (n7) (have hf False (arith h)) (exact (False.elim hf)))))))))))))))))))))))))
;; the words a function saves, as they stand from the stack pointer after its six pushes
(fn saved ((c Cpu)) (List (BitVec 64))
  (cons (reg c 15)
    (cons (reg c 14)
      (cons (reg c 13) (cons (reg c 12) (cons (reg c 5) (cons (reg c 3) (cons (ret_addr c) nil))))))))

;; ---- what a statement's code comes to -----------------------------------------------------------
;; from the state c inside a function entered in c0 with room for k words above f: the
;; processor comes to a state that has returned to c0's caller with v in rax, the data ranges
;; as m2 has them, and every other byte outside the k words as c0 had it
(def done ((rs (List Seg)) (f Nat) (k Nat) (c0 Cpu) (c Cpu) (v (BitVec 64)) (m2 Mem)) Prop
  (exists ((c2 Cpu))
    (and (reaches c c2)
      (and (= (reg c2 0) v)
        (and (agree rs m2 (Cpu.mem c2))
          (and (kept_mem rs f k (Cpu.mem c0) (Cpu.mem c2)) (returned c0 c2)))))))
(theorem done_from
  ((rs (List Seg))
   (f Nat)
   (k Nat)
   (c0 Cpu)
   (c Cpu)
   (c1 Cpu)
   (v (BitVec 64))
   (m2 Mem)
   (h (reaches c c1))
   (g (done rs f k c0 c1 v m2)))
  (done rs f k c0 c v m2)
  (by
    (cases g
      ((intro (c2 g2)
         (apply (Exists.intro c2)
           ((apply And.intro ((exact (reaches_trans c c1 c2 h (And.left g2))))
              ((exact (And.right g2)))))))))))

;; ---- more of the argument registers, for a call -------------------------------------------------
(theorem aset_sp ((c Cpu) (i Nat) (w (BitVec 64)) (pc (BitVec 64)) (h (< i 6)))
  (= (reg (at_pc (set_reg c (areg i) w) pc) 4) (reg c 4))
  (by
    (apply (six_all (fun ((i Nat)) (= (reg (at_pc (set_reg c (areg i) w) pc) 4) (reg c 4)))) (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (rfl)
      (exact h))))
;; the words of the first n registers of a list are the first n words of the list's
(theorem regs_of_take ((c Cpu) (l (List Nat)))
  (forall ((n Nat)) (= (regs_of c (List.take n l)) (List.take n (regs_of c l))))
  (by
    (induction l
      ((nil () (intro n) (rw (@List.take_nil Nat n))
         (show (= (@List.nil (BitVec 64)) (List.take n (@List.nil (BitVec 64)))))
         (rw (@List.take_nil (BitVec 64) n))
         rfl)
       (cons (x r ih) (intro n)
         (cases n
           ((zero () rfl)
            (succ (n1)
              (show
                (= (cons (reg c x) (regs_of c (List.take n1 r)))
                  (cons (reg c x) (List.take n1 (regs_of c r)))))
              (rw (ih n1))
              rfl))))))))
;; a callee keeps the six registers of the locals
(theorem kept_regs6 ((c Cpu) (c2 Cpu) (h (kept c c2))) (= (regs6 c2) (regs6 c))
  (by
    (show
      (=
        (cons (reg c2 3)
          (cons (reg c2 5)
            (cons (reg c2 12) (cons (reg c2 13) (cons (reg c2 14) (cons (reg c2 15) nil))))))
        (cons (reg c 3)
          (cons (reg c 5)
            (cons (reg c 12) (cons (reg c 13) (cons (reg c 14) (cons (reg c 15) nil))))))))
    (rw (kept_rbx c c2 h))
    (rw (kept_rbp c c2 h))
    (rw (kept_r12 c c2 h))
    (rw (kept_r13 c c2 h))
    (rw (kept_r14 c c2 h))
    (rw (kept_r15 c c2 h))
    rfl))
