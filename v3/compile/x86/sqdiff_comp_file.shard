;;; v3/compile/x86/sqdiff_comp_file.shard — `sqdiff` compiled, in a file with the COMPILED `dot`
;;; (docs/COMPILE.md §5, linking): two modules, each through the pass on its own. `dot`'s module
;;; (../dot_obj.shard) stands at 4194489, after the start-up, as dot_file.shard compiled it; the
;;; module of ../sqdiff_obj.shard goes through the pass at the address after it, with `dot` as its
;;; one outside function: the entry and the stack need the pass answered for `dot`. The
;;; start-up's call goes to label 1, before the instruction at `sqdiff`'s entry. Here are the
;;; listing, the table, the file's bytes, and every fact of the assembled file that the
;;; theorems ask for, each closed by computation; names begin `sqc_`. That the file exits with
;;; `sqdiff`'s value is sqdiff_comp_run.shard's.
(import "dot_file.shard")
(import "../sqdiff_obj.shard")
(use compile.sqdiff_obj)
(use compile.x86.code)
(use compile.x86.dot_file)
(use compile.x86.startup)
(use compile.x86.pass)
(use models.x86.asm)
(use models.x86.laws)
(use models.x86.loaded)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- compiled -----------------------------------------------------------------------------------
;; the module's outside functions, each by its entry and its stack need: `dot`, as the pass
;; answered for it
(fn sqc_outs () (List (Prod Nat Nat)) (cons (Prod.mk dot_at dot_need) nil))
;; `dot`'s module ends where this one begins
(fn sqc_base () Nat (+ 4194489 (isize dot_listing)))
(fn sqc_listing () (List Instr)
  (match (compile sqc_outs sqdiff_prog sqc_base)
    (none nil)
    ((some (Prod.mk l f)) l)))
;; each function's entry and its stack need
(fn sqc_entries () (List (Prod Nat Nat))
  (match (compile sqc_outs sqdiff_prog sqc_base)
    (none nil)
    ((some (Prod.mk l f)) f)))
(theorem sqc_compiled ()
  (= (compile sqc_outs sqdiff_prog sqc_base) (some (Prod.mk sqc_listing sqc_entries)))
  (by rfl))
;; `sqdiff`'s entry as the pass answered it, and the words of stack it needs
(fn sqc_at () Nat
  (match (pair_at sqc_entries 0)
    (none 0)
    ((some en) (Prod.fst en))))
(fn sqc_need () Nat
  (match (pair_at sqc_entries 0)
    (none 0)
    ((some en) (Prod.snd en))))
(theorem sqc_entry () (= (pair_at sqc_entries 0) (some (Prod.mk sqc_at sqc_need))) (by rfl))
(theorem sqc_need_fits () (<= sqc_need 1048057) (by decide))

;; ---- the file's lines -----------------------------------------------------------------------------
;; the two modules' instructions as lines, label 1 before the one at `sqdiff`'s entry
(fn sqc_lines () (List Asm) (label_at (List.append dot_listing sqc_listing) 4194489 sqc_at 1))
;; the file's table: the start-up's rows, its call's displacement d, then the two listings laid
;; out from 4194489
(fn sqc_d () Nat (rel sqc_at 4194479))
(fn sqc_xt () (List (Prod Nat (Prod Instr Nat)))
  (layout (List.append dot_listing sqc_listing) 4194489))
(fn sqc_tbl () (List (Prod Nat (Prod Instr Nat))) (link_table sqc_d sqc_xt))
(fn sqc_chi () Nat (+ sqc_base (isize sqc_listing)))

;; ---- assembled: the facts of the file, each by computation ----------------------------------------
(fn sqc_image () (List Nat)
  (match (assemble (link_listing 1 sqc_lines))
    (none nil)
    ((some code) code)))
(fn sqc_instrs () (List Instr)
  (match (resolve (link_listing 1 sqc_lines) (link_listing 1 sqc_lines) 0)
    (none nil)
    ((some is) is)))
(theorem sqc_assembled () (= (assemble (link_listing 1 sqc_lines)) (some sqc_image)) (by rfl))
(theorem sqc_resolved ()
  (= (resolve (link_listing 1 sqc_lines) (link_listing 1 sqc_lines) 0) (some sqc_instrs))
  (by rfl))
;; the assembler's instructions lay out to the table: the start-up's call reaches `sqdiff`, and
;; the lines after it are the two listings, instruction for instruction
(theorem sqc_laid () (= (layout sqc_instrs 4194424) sqc_tbl) (by rfl))
(theorem sqc_target () (= (w64_add (w64 4194479) (w64 sqc_d)) (w64 sqc_at)) (by rfl))
(theorem sqc_within () (= (all_within sqc_tbl 4194424 sqc_chi) true) (by rfl))
(theorem sqc_size () (< (+ 4194424 (List.length sqc_image)) 140737479962624) (by decide))
(theorem sqc_chi_stack () (<= (+ sqc_chi 15) 140737479962624) (by decide))
(theorem sqc_chi_word () (<= (+ sqc_chi 15) 18446744073709551616) (by decide))
;; each module's listing stands in the table where it was compiled
(theorem sqc_dot_placedb () (= (placedb sqc_tbl 4194489 dot_listing) true) (by decide))
(theorem sqc_dot_placed () (placed sqc_tbl 4194489 dot_listing)
  (exact (placedb_ok sqc_tbl dot_listing 4194489 sqc_dot_placedb)))
(theorem sqc_placedb () (= (placedb sqc_tbl sqc_base sqc_listing) true) (by decide))
(theorem sqc_placed () (placed sqc_tbl sqc_base sqc_listing)
  (exact (placedb_ok sqc_tbl sqc_listing sqc_base sqc_placedb)))
