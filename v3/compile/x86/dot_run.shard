;;; v3/compile/x86/dot_run.shard — one function through every layer (docs/COMPILE.md §5, §8): the
;;; file of dot_file.shard, started as the runner starts it, exits with the low byte of what
;;; `dot` — the function over two lists of words, v3/models/x86/buffers.shard — computes of the
;;; two buffers the start-up pushes: 68. The chain: `dot`'s low form computes its meaning
;;; (the view `../dot`); its intermediate code, written by hand, answers with the low form's value
;;; (the same view); the code the pass answers for it realizes that answer (`module_realizes`);
;;; and a file with a function that realizes its answer exits as the answer says (`link_exits`).
(import "dot_file.shard")
(import "link.shard")
(import "module.shard")
(import "../dot")
(import "../sample.shard")
(use std.mem)
(use compile.dot_obj)
(use compile.dot)
(use compile.sample)
(use compile.ir)
(use compile.x86.dot_file)
(use compile.x86.link)
(use compile.x86.startup)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.seam)
(use models.x86.buffers)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.linux)
(use models.x86.word)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; `dot`'s code, at the entry the pass answered, realizes the answer of `dot`'s intermediate
;; code, for any data ranges: the module calls nothing from outside
(theorem dot_code_realizes ((rs (List Seg)))
  (realizes dot_tbl 4194424 dot_chi dot_at dot_need rs (fn_ans dot_prog no_ext rs dot_code))
  (by
    (have hx
      (forall ((j Nat) (en (Prod Nat Nat)))
        (-> (= (pair_at (@List.nil (Prod Nat Nat)) j) (some en))
          (realizes dot_tbl 4194424 dot_chi (Prod.fst en) (Prod.snd en) rs (ext_ans no_ext j))))
      (intro j en h)
      (have hn (= (@Option.none (Prod Nat Nat)) (some en)) (exact h))
      (exact (absurd (Eq.symm hn) (Option.some_ne_none en))))
    (exact
      (module_realizes dot_prog no_ext rs dot_tbl 4194424 dot_chi nil 4194489 dot_listing
        dot_entries
        dot_within
        dot_chi_word
        hx
        dot_compiled
        dot_placed
        1
        dot_code
        (Prod.mk dot_at dot_need)
        dot_code_is
        dot_entry))))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the answer of `dot`'s code on the buffers the start-up pushes: what `dot` computes of them
(theorem dot_sample
  ((m0 Mem) (hx (holds m0 140737488347112 link_xs)) (hy (holds m0 140737488347088 link_ys)))
  (exists ((m2 Mem))
    (fn_ans dot_prog no_ext link_rs dot_code link_args m0
      (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)
      m2))
  (exact (Exists.intro m0 (sample_answer no_ext m0 hx hy))))
(theorem dot_file_exits ((r Regs) (f Flags) (m Mem))
  (exits (elf_exec dot_image) (runner_start r f m) 68)
  (by
    (have hv (= (% (w64_val (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256) 68)
      (rw sample_dot)
      (decide))
    (have e
      (exits (elf_exec dot_image) (runner_start r f m)
        (% (w64_val (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)) 256))
      (exact
        (link_exits 1 dot_lines dot_image dot_instrs dot_d dot_xt dot_at dot_chi dot_need
          (fn_ans dot_prog no_ext link_rs dot_code)
          (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)
          dot_assembled
          dot_resolved
          dot_laid
          dot_target
          dot_within
          dot_size
          dot_chi_stack
          dot_need_fits
          (dot_code_realizes link_rs)
          dot_sample
          r
          f
          m)))
    (rw (<- hv))
    (exact e)))
