;;; v3/compile/x86/greet_run.shard — `greet`'s file ends as `greet` says. The file of
;;; greet_file.shard, started with its stack anywhere `stack_ok` allows and on any list of the
;;; kernel's answers, ends as the program's value on the World its process starts with says
;;; (`greet_file_ends`): it has written the text and exits with 0; or a write failed, and it
;;; exits with that failure's status having written what was taken; or the kernel ended it.
;;; From the module's theorem for runs with what is outside (`wmodule_realizes`), whose
;;; hypothesis about the outside function is `write_all`'s own theorem (`put_wx_realizes`); the
;;; tie of `greet`'s code (`greet_tie`); and the link (`start_ends`). The text is known byte
;;; for byte in the memory that holds the two words the start-up pushes (`held_bytes`).
(import "greet_file.shard")
(import "module.shard")
(import "link.shard")
(import "../../models/x86/bytes.shard")
(import "../../models/x86/args.shard")
(use std.mem)
(use std.world)
(use compile.greet_ir)
(use compile.greet_src)
(use compile.ir)
(use compile.put)
(use compile.stretch)
(use compile.x86.code)
(use compile.x86.greet_file)
(use compile.x86.link)
(use compile.x86.module)
(use compile.x86.pass)
(use compile.x86.put)
(use compile.x86.seam)
(use compile.x86.startup)
(use models.x86.args)
(use models.x86.bytes)
(use models.x86.elf)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.linux)
(use models.x86.linux.Answer)
(use models.x86.linux.Os)
(use models.x86.linux.Outcome)
(use models.x86.linux.Res)
(use models.x86.word)
(use models.x86.world)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the module's theorem, met by this file ---------------------------------------------------------
;; `greet`'s code, at the entry the pass answered, realizes the answer of its intermediate
;; code's run with what is outside, for any data ranges
(theorem greet_code_realizes ((rs (List Seg)))
  (wrealizes greet_tbl 4194424 greet_chi greet_at greet_need rs
    (wfn_ans greet_prog (put_wx rs) rs greet_code))
  (exact
    (wmodule_realizes greet_prog (put_wx rs) rs greet_tbl 4194424 greet_chi greet_outs 4194537
      greet_listing
      greet_entries
      greet_within
      greet_chi_word
      (one_out_realizes greet_tbl 4194424 greet_chi 4194477 0 rs (put_wx rs)
        (put_wx_realizes greet_tbl 4194424 greet_chi 4194477 rs greet_within greet_chi_top
          greet_put_placed))
      greet_compiled
      greet_placed
      0
      greet_code
      (Prod.mk greet_at greet_need)
      greet_code_is
      greet_entry)))

;; ---- the file, end to end ---------------------------------------------------------------------------
;; the outcome of `greet`'s code on the text the start-up pushes, with o outside: the file ends
;; by it as `greet`'s value on the World of o says
(theorem greet_answer
  ((sp Nat)
   (m0 Mem)
   (o Os)
   (hb (<= (+ (start_base sp greet_data) (* 8 (List.length greet_data))) 140737488355328))
   (hh (holds m0 (start_base sp greet_data) greet_data)))
  (exists ((out Outcome))
    (and
      (wfn_ans greet_prog (put_wx (start_rs sp greet_data)) (start_rs sp greet_data) greet_code
        (arg_words (w64 (start_base sp greet_data)) greet_argd)
        m0
        o
        out)
      (= (exit_of out) (world_res (Prod.fst (greet (os_world o))) (Prod.snd (greet (os_world o)))))))
  (by
    (have hb16 (<= (+ (start_base sp greet_data) (* 8 2)) 140737488355328) (exact hb))
    (have h02 (<= 0 2) (decide))
    (have hp
      (= (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0))))
        (start_base sp greet_data))
      (exact (start_addr (start_base sp greet_data) 2 0 hb16 h02)))
    ;; the two pieces lie in the data's range
    (have l1 (<= (start_base sp greet_data) (start_base sp greet_data))
      (exact (Nat.le_refl (start_base sp greet_data))))
    (have l2 (<= (+ (start_base sp greet_data) 8) (+ (start_base sp greet_data) (* 8 2))) (arith))
    (have l3 (<= (start_base sp greet_data) (+ (start_base sp greet_data) 8)) (arith))
    (have l4 (<= (+ (+ (start_base sp greet_data) 8) 5) (+ (start_base sp greet_data) (* 8 2)))
      (arith))
    (have h1
      (=
        (mapped (start_rs sp greet_data)
          (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0))))
          8
          4)
        true)
      (rw hp)
      (exact
        (args_rs_mapped (start_base sp greet_data) (+ (start_base sp greet_data) (* 8 2))
          (start_base sp greet_data)
          8
          l1
          l2)))
    (have h2
      (=
        (mapped (start_rs sp greet_data)
          (+ (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0)))) 8)
          5
          4)
        true)
      (rw hp)
      (exact
        (args_rs_mapped (start_base sp greet_data) (+ (start_base sp greet_data) (* 8 2))
          (+ (start_base sp greet_data) 8)
          5
          l3
          l4)))
    (have hb13
      (<= (+ (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0)))) 13) 140737488355328)
      (rw hp)
      (arith))
    ;; the text, byte for byte, from the two words the memory holds
    (have k0 (< 0 (List.length greet_data)) (decide))
    (have k1 (< 1 (List.length greet_data)) (decide))
    (have hw0 (= (w64 (mem_le64 m0 (start_base sp greet_data))) (w64 8583909746840200552))
      (exact (hh 0 k0)))
    (have hw1 (= (w64 (mem_le64 m0 (+ (start_base sp greet_data) 8))) (w64 44634501743))
      (exact (hh 1 k1)))
    (have v0 (< 8583909746840200552 18446744073709551616) (decide))
    (have v1 (< 44634501743 18446744073709551616) (decide))
    (have hone
      (= (mem_bytes m0 (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0)))) 8)
        greet_one)
      (rw hp)
      (rw (held_bytes m0 (start_base sp greet_data) 8583909746840200552 hw0 v0))
      rfl)
    (have h58 (<= 5 8) (decide))
    (have htwo
      (= (mem_bytes m0 (+ (w64_val (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0)))) 8) 5)
        greet_two)
      (rw hp)
      (rw (<- (mem_bytes_take m0 5 (+ (start_base sp greet_data) 8) 8 h58)))
      (rw (held_bytes m0 (+ (start_base sp greet_data) 8) 44634501743 hw1 v1))
      rfl)
    (cases
      (greet_tie (start_rs sp greet_data) (w64_add (w64 (start_base sp greet_data)) (w64 (* 8 0)))
        m0
        o
        h1
        h2
        hb13
        hone
        htwo)
      ((intro (out g)
         (apply (Exists.intro out)
           ((apply And.intro ((exact (And.left g)))
              ((exact
                 (tied_exit out (w64 0) m0 (write_all greet_two (write_all greet_one (os_world o)))
                   (And.right g))))))))))))
;; THE FILE ENDS AS `greet` SAYS. Started with its stack anywhere — the data's two words, the
;; function's need and the return address under the stack pointer — and whatever the kernel
;; answers its calls.
(theorem greet_file_ends
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ greet_chi 15) (+ (+ (List.length greet_data) greet_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem)
   (as (List Answer)))
  (ends (elf_exec greet_image) (start_at lo sp hi r f m) as (greet_res as))
  (by
    (have hans
      (forall ((m0 Mem))
        (-> (<= (+ (start_base sp greet_data) (* 8 (List.length greet_data))) 140737488355328)
          (holds m0 (start_base sp greet_data) greet_data)
          (exists ((out Outcome))
            (and
              (wfn_ans greet_prog (put_wx (start_rs sp greet_data)) (start_rs sp greet_data)
                greet_code
                (arg_words (w64 (start_base sp greet_data)) greet_argd)
                m0
                (os_start as)
                out)
              (= (exit_of out) (greet_res as))))))
      (intro m0 hb hh)
      (exact (greet_answer sp m0 (os_start as) hb hh)))
    (exact
      (start_ends greet_data greet_argd 1 greet_lines greet_image greet_instrs greet_d greet_xt
        greet_at
        greet_chi
        greet_need
        (wfn_ans greet_prog (put_wx (start_rs sp greet_data)) (start_rs sp greet_data) greet_code)
        (greet_res as)
        as
        lo
        sp
        hi
        greet_assembled
        greet_resolved
        greet_laid
        greet_target
        greet_within
        greet_code_end
        hst
        greet_nargs
        (greet_code_realizes (start_rs sp greet_data))
        hans
        r
        f
        m))))
;; with a kernel that takes all it is offered: the text, and status 0
(theorem greet_file_writes
  ((lo Nat)
   (sp Nat)
   (hi Nat)
   (hst (stack_ok lo sp hi (+ greet_chi 15) (+ (+ (List.length greet_data) greet_need) 1)))
   (r Regs)
   (f Flags)
   (m Mem))
  (ends (elf_exec greet_image) (start_at lo sp hi r f m) nil
    (RExit 0 (list 104 101 108 108 111 44 32 119 111 114 108 100 10)))
  (exact (greet_file_ends lo sp hi hst r f m nil)))
