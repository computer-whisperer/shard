;;; v3/compile/x86/calls_main.shard — the file of calls_file.shard written to the path given,
;;; for the model's run and the processor's. The status is the low byte of what `calls_f5`
;;; (../calls_lo.shard) computes of the words the start-up hands over, as the evaluator computes
;;; it; calls_run.shard proves the file's own run exits with it.
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(import "calls_file.shard")
(use std.bytes)
(use std.host)
(use compile.calls_lo)
(use compile.x86.calls_file)
(use models.x86.elf)
(use models.x86.word)

(fn main ((path ByteArray) (w World)) World
  (match (write_file path (Bytes.ofNats (elf_exec calls_image)) w)
    ((Prod.mk ok w1)
     (exit
       (if ok (% (w64_val (calls_f5 (w64 140737488347112) (w64 140737488347088) (w64 3))) 256) 1)
       w1))))
