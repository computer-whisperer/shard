;;; v3/compile/sqdiff_lo.shard — a caller of `dot` (docs/COMPILE.md §5, §8): the difference of
;;; two buffers' sums of squares. Its meaning is a function over two lists, each `dot` of a
;;; list with itself (`dot`, v3/models/x86/buffers.shard); its low form a function over words
;;; and a memory, each `dot_lo` of a buffer with itself (`dot_lo.shard`). Then the first fact:
;;; where memory holds the two lists, the low form's value is the meaning's; and the sample.
(import "dot_mean.shard")
(use std.mem)
(use compile.dot_lo)
(use compile.dot_mean)
(use compile.lo)
(use models.x86.buffers)
(use models.x86.frame)
(use models.x86.word)
(use models.x86.x86)

;; ---- the meaning, and the low form ----------------------------------------------------------------
(fn sqdiff
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (BitVec 64)
  (w64_sub (dot xs xs n rx rx) (dot ys ys n ry ry)))
(fn sqdiff_lo
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4)))
  (BitVec 64)
  (w64_sub (dot_lo rs m px px n ex ex) (dot_lo rs m py py n ey ey)))

;; ---- the low form's value is the meaning's --------------------------------------------------------
;; by the same fact of `dot`, once for each buffer
(theorem sqdiff_lo_means
  ((rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ey (buf_ok rs py n 4))
   (xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys)))
   (hx (holds m (w64_val px) xs))
   (hy (holds m (w64_val py) ys)))
  (= (sqdiff_lo rs m px py n ex ey) (sqdiff xs ys n rx ry))
  (by
    (show
      (= (w64_sub (dot_lo rs m px px n ex ex) (dot_lo rs m py py n ey ey))
        (w64_sub (dot xs xs n rx rx) (dot ys ys n ry ry))))
    (rw (dot_lo_means rs m px px n ex ex xs xs rx rx hx hx))
    (rw (dot_lo_means rs m py py n ey ey ys ys ry ry hy hy))
    rfl))

;; ---- the sample ----------------------------------------------------------------------------------
;; of 3 5 7 and 2 4 6: 9 + 25 + 49 less 4 + 16 + 36
(theorem sample_sqdiff () (= (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 27)
  (by decide))
