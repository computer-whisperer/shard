;;; v3/compile/sample.shard — the two buffers the fixed start-up pushes (x86/startup.shard)
;;; as a function's arguments see them: one data range of six words at the top of the stack,
;;; the words 3 5 7 at 140737488347112 and 2 4 6 at 140737488347088, a memory that holds them,
;;; and the evidence about each buffer that a low form over them asks for. The lists themselves
;;; are the model's (`sample_xs`, `sample_ys`, v3/models/x86/buffers.shard).
(import "lo.shard")
(import "../models/x86/buffers.shard")
(use std.mem)
(use compile.lo)
(use models.x86.buffers)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Seg)
(use Init.List cons nil)

;; One range of six words mapped to read and write, the last 48 bytes below 140737488347136.
(fn sample_rs () (List Seg) (cons (MkSeg 140737488347088 140737488347136 6) nil))
(fn sample_m () Mem
  (mem_put64
    (mem_put64
      (mem_put64
        (mem_put64 (mem_put64 (mem_put64 mem_empty 140737488347112 3) 140737488347120 5)
          140737488347128
          7)
        140737488347088
        2)
      140737488347096
      4)
    140737488347104
    6))
;; the evidence about each buffer, by computation
(theorem sample_ex () (buf_ok sample_rs (w64 140737488347112) (w64 3) 4)
  (by
    (apply And.intro
      ((apply (mapped_words_of sample_rs (w64_val (w64 140737488347112)) (w64_val (w64 3)) 4)
         (decide)))
      ((decide)))))
(theorem sample_ey () (buf_ok sample_rs (w64 140737488347088) (w64 3) 4)
  (by
    (apply And.intro
      ((apply (mapped_words_of sample_rs (w64_val (w64 140737488347088)) (w64_val (w64 3)) 4)
         (decide)))
      ((decide)))))
;; the sum of the products of 3 5 7 and 2 4 6
(theorem sample_dot () (= (w64_val (dot sample_xs sample_ys (w64 3) sample_rx sample_ry)) 68)
  (by decide))
