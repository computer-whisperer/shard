;;; v3/compile/addto_obj.shard — the intermediate code of `addto`'s module: the code as data, which
;;; the pass reads and a file's writer runs. Written by hand from the low form in the directory
;;; `addto`, whose view states what the code's run answers.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use models.x86.word)
(use Init.List cons nil)
(use Init.Option none some)

;; The loop: 0 px, 1 py, 2 n, 3 i. Word i of the first buffer is stored as its sum with word i
;; of the second, then the index goes on. The loop is function 0 of the program, `addto`
;; function 1; a function with no value of its own returns 0.
(fn addto_go_code () IFn
  (MkIFn 4 0
    (SIf (EVar 3) CLtu (EVar 2)
      (SStore (EOp OAdd (EVar 0) (EOp OMul (ENum (w64 8)) (EVar 3)))
        (EOp OAdd (ELoad (EOp OAdd (EVar 0) (EOp OMul (ENum (w64 8)) (EVar 3))))
          (ELoad (EOp OAdd (EVar 1) (EOp OMul (ENum (w64 8)) (EVar 3)))))
        (SLet 3 (EOp OAdd (EVar 3) (ENum (w64 1)))
          (STail (CFn 0) (list (EVar 0) (EVar 1) (EVar 2) (EVar 3)))))
      (SRet (ENum (w64 0))))))
(fn addto_code () IFn (MkIFn 3 0 (STail (CFn 0) (list (EVar 0) (EVar 1) (EVar 2) (ENum (w64 0))))))
(fn addto_prog () (List IFn) (list addto_go_code addto_code))
;; `addto` is the program's second function
(theorem addto_code_is () (= (fn_at addto_prog 1) (some addto_code)) (by rfl))
