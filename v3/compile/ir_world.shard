;;; v3/compile/ir_world.shard — the laws of a run with what is outside a process (`wrun`,
;;; ir.shard): what such a run of a statement says of its parts and a run from its parts, as
;;; ir_laws.shard has them for `irun`; that a run of code which calls nothing outside is one of
;;; these, the outside left as it was (`wrun_of_irun`); that a run with an outcome has it on any
;;; fuel above (`wrun_more`); and a rule of `wends` for each statement form a proof above the
;;; pass uses.
(import "ir_laws.shard")
(use std.mem)
(use compile.ir)
(use compile.ir_laws)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IStm)
(use models.x86.linux)
(use models.x86.linux.Outcome)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use models.x86.x86.Fuel)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- what a run says of its parts ---------------------------------------------------------------
;; a callee's run, as a statement's run takes it: an external's answer on what is outside, or
;; the run of a function's body on the fuel below
(def wfn_run
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (og (Option IFn))
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (match og
    (none none)
    ((some g) (wrun n p wx rs (IFn.body g) (enter g vs) m o))))
(def wcal_run
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os))
  (Option Outcome)
  (match cal
    ((CExt j) (wx j vs m o))
    ((CFn i) (wfn_run n p wx rs (fn_at p i) vs m o))))
;; what follows a call, by the callee's outcome: the rest of the statement with the local set,
;; on the memory and the outside the callee left; or, the process ended in the callee, the end
(def wnext
  ((n Fuel)
   (p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (q Outcome))
  (Option Outcome)
  (match q
    ((ORet v m1 o1) (wrun n p wx rs k (upd ls x v) m1 o1))
    ((OEnd e) (some (OEnd e)))))
(theorem wrun_ret_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SRet e) ls m o) (some r))))
  (exists ((v (BitVec 64))) (and (= (ieval rs ls m e) (some v)) (= r (ORet v m o))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SRet e) ls m o) (some r))
        (exists ((v (BitVec 64))) (and (= (ieval rs ls m e) (some v)) (= r (ORet v m o)))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (x) (reduce) (intro h0)
           (apply (Exists.intro x)
             ((apply And.intro (rfl) ((exact (Eq.symm (Option.some.inj h0)))))))))))
    (exact (g h))))
(theorem wrun_let_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SLet x e k) ls m o) (some r))))
  (exists ((w (BitVec 64)))
    (and (= (ieval rs ls m e) (some w)) (= (wrun n1 p wx rs k (upd ls x w) m o) (some r))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SLet x e k) ls m o) (some r))
        (exists ((w (BitVec 64)))
          (and (= (ieval rs ls m e) (some w)) (= (wrun n1 p wx rs k (upd ls x w) m o) (some r)))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m e) he
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (w1) (reduce) (intro h0)
           (apply (Exists.intro w1) ((apply And.intro (rfl) ((exact h0)))))))))
    (exact (g h))))
(theorem wrun_store_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SStore a e k) ls m o) (some r))))
  (exists ((q (BitVec 64)))
    (exists ((w (BitVec 64)))
      (and (= (ieval rs ls m a) (some q))
        (and (= (ieval rs ls m e) (some w))
          (and (= (mapped rs (w64_val q) 8 2) true)
            (= (wrun n1 p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r)))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SStore a e k) ls m o) (some r))
        (exists ((q (BitVec 64)))
          (exists ((w (BitVec 64)))
            (and (= (ieval rs ls m a) (some q))
              (and (= (ieval rs ls m e) (some w))
                (and (= (mapped rs (w64_val q) 8 2) true)
                  (= (wrun n1 p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r))))))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m a) ha
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (q1) (reduce)
           (cases (ieval rs ls m e) he
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (w1) (reduce)
                (cases (mapped rs (w64_val q1) 8 2) hm
                  ((false () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (true () (reduce) (intro h0)
                     (apply (Exists.intro q1)
                       ((apply (Exists.intro w1)
                          ((apply And.intro (rfl)
                             ((apply And.intro (rfl) ((apply And.intro ((exact hm)) ((exact h0)))))))))))))))))))))
    (exact (g h))))
(theorem wrun_if_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x IExp)
   (cc ICmp)
   (y IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SIf x cc y t e) ls m o) (some r))))
  (exists ((vx (BitVec 64)))
    (exists ((vy (BitVec 64)))
      (and (= (ieval rs ls m x) (some vx))
        (and (= (ieval rs ls m y) (some vy))
          (= (wrun n1 p wx rs (if (icmp cc vx vy) t e) ls m o) (some r))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SIf x cc y t e) ls m o) (some r))
        (exists ((vx (BitVec 64)))
          (exists ((vy (BitVec 64)))
            (and (= (ieval rs ls m x) (some vx))
              (and (= (ieval rs ls m y) (some vy))
                (= (wrun n1 p wx rs (if (icmp cc vx vy) t e) ls m o) (some r)))))))
      (unfold wrun)
      (reduce)
      (cases (ieval rs ls m x) hx
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vx0) (reduce)
           (cases (ieval rs ls m y) hy
             ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
              (some (vy0) (reduce) (intro h0)
                (apply (Exists.intro vx0)
                  ((apply (Exists.intro vy0)
                     ((apply And.intro (rfl) ((apply And.intro (rfl) ((exact h0))))))))))))))))
    (exact (g h))))
(theorem wrun_tail_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (STail cal es) ls m o) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs)) (= (wcal_run n1 p wx rs cal vs m o) (some r))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (STail cal es) ls m o) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs)) (= (wcal_run n1 p wx rs cal vs m o) (some r)))))
      (unfold wrun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((show (= (wfn_run n1 p wx rs (fn_at p i) vs0 m o) (some r)))
                           (rw hf)
                           (exact h0)))))))))
              (CExt (j) (reduce) (intro h0)
                (apply (Exists.intro vs0) ((apply And.intro (rfl) ((exact h0))))))))))))
    (exact (g h))))
(theorem wrun_call_inv
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n1 Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (h (= (wrun (FS n1) p wx rs (SCall x cal es k) ls m o) (some r))))
  (exists ((vs (List (BitVec 64))))
    (and (= (ievals rs ls m es) (some vs))
      (exists ((q Outcome))
        (and (= (wcal_run n1 p wx rs cal vs m o) (some q)) (= (wnext n1 p wx rs x k ls q) (some r))))))
  (by
    (have g
      (-> (= (wrun (FS n1) p wx rs (SCall x cal es k) ls m o) (some r))
        (exists ((vs (List (BitVec 64))))
          (and (= (ievals rs ls m es) (some vs))
            (exists ((q Outcome))
              (and (= (wcal_run n1 p wx rs cal vs m o) (some q))
                (= (wnext n1 p wx rs x k ls q) (some r)))))))
      (unfold wrun)
      (reduce)
      (cases (ievals rs ls m es) hvs
        ((none () (reduce) (intro h0) (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
         (some (vs0) (reduce)
           (cases cal
             ((CFn (i) (reduce)
                (cases (fn_at p i) hf
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (g0) (reduce)
                     (cases (wrun n1 p wx rs (IFn.body g0) (enter g0 vs0) m o) hb
                       ((none () (reduce) (intro h0)
                          (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                        (some (q0) (reduce) (intro h0)
                          (apply (Exists.intro vs0)
                            ((apply And.intro (rfl)
                               ((apply (Exists.intro q0)
                                  ((apply And.intro
                                     ((show (= (wfn_run n1 p wx rs (fn_at p i) vs0 m o) (some q0)))
                                      (rw hf)
                                      (exact hb))
                                     ((exact h0))))))))))))))))
              (CExt (j) (reduce)
                (cases (wx j vs0 m o) hx
                  ((none () (reduce) (intro h0)
                     (exact (absurd (Eq.symm h0) (Option.some_ne_none r))))
                   (some (q0) (reduce) (intro h0)
                     (apply (Exists.intro vs0)
                       ((apply And.intro (rfl)
                          ((apply (Exists.intro q0) ((apply And.intro ((exact hx)) ((exact h0)))))))))))))))))))
    (exact (g h))))

;; ---- a run from its parts -----------------------------------------------------------------------
(theorem wrun_ret
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (e IExp)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (v (BitVec 64))
   (he (= (ieval rs ls m e) (some v))))
  (= (wrun (FS n) p wx rs (SRet e) ls m o) (some (ORet v m o)))
  (by (unfold wrun) (reduce) (rw he) rfl))
(theorem wrun_let
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (w (BitVec 64))
   (r Outcome)
   (he (= (ieval rs ls m e) (some w)))
   (hk (= (wrun n p wx rs k (upd ls x w) m o) (some r))))
  (= (wrun (FS n) p wx rs (SLet x e k) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw he) (reduce) (exact hk)))
(theorem wrun_store
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (e IExp)
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (q (BitVec 64))
   (w (BitVec 64))
   (r Outcome)
   (ha (= (ieval rs ls m a) (some q)))
   (he (= (ieval rs ls m e) (some w)))
   (hm (= (mapped rs (w64_val q) 8 2) true))
   (hk (= (wrun n p wx rs k ls (mem_put64 m (w64_val q) (w64_val w)) o) (some r))))
  (= (wrun (FS n) p wx rs (SStore a e k) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw ha) (reduce) (rw he) (reduce) (rw hm) (reduce) (exact hk)))
(theorem wrun_if
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (a IExp)
   (cc ICmp)
   (b IExp)
   (t IStm)
   (e IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (x (BitVec 64))
   (y (BitVec 64))
   (r Outcome)
   (ha (= (ieval rs ls m a) (some x)))
   (hb (= (ieval rs ls m b) (some y)))
   (hk (= (wrun n p wx rs (if (icmp cc x y) t e) ls m o) (some r))))
  (= (wrun (FS n) p wx rs (SIf a cc b t e) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw ha) (reduce) (rw hb) (reduce) (exact hk)))
(theorem wrun_tail
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (cal ICallee)
   (es (List IExp))
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (vs (List (BitVec 64)))
   (r Outcome)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wcal_run n p wx rs cal vs m o) (some r))))
  (= (wrun (FS n) p wx rs (STail cal es) ls m o) (some r))
  (by (unfold wrun) (reduce) (rw hes) (reduce) (exact hc)))
(theorem wrun_call
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (x Nat)
   (cal ICallee)
   (es (List IExp))
   (k IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (vs (List (BitVec 64)))
   (q Outcome)
   (r Outcome)
   (hes (= (ievals rs ls m es) (some vs)))
   (hc (= (wcal_run n p wx rs cal vs m o) (some q)))
   (hk (= (wnext n p wx rs x k ls q) (some r))))
  (= (wrun (FS n) p wx rs (SCall x cal es k) ls m o) (some r))
  (by
    (unfold wrun)
    (reduce)
    (rw hes)
    (reduce)
    (cases cal
      ((CFn (i) (reduce)
         (cases (fn_at p i) hf
           ((none ()
              (have h1 (= (wfn_run n p wx rs (@Option.none IFn) vs m o) (some q))
                (rw (<- hf))
                (exact hc))
              (have h2 (= (@Option.none Outcome) (some q)) (exact h1))
              (exact (absurd (Eq.symm h2) (Option.some_ne_none q))))
            (some (g0)
              (have h1 (= (wfn_run n p wx rs (some g0) vs m o) (some q)) (rw (<- hf)) (exact hc))
              (have h2 (= (wrun n p wx rs (IFn.body g0) (enter g0 vs) m o) (some q)) (exact h1))
              (reduce)
              (rw h2)
              (exact hk)))))
       (CExt (j) (reduce) (have h1 (= (wx j vs m o) (some q)) (exact hc)) (rw h1) (exact hk))))))

;; ---- code that calls nothing outside ------------------------------------------------------------
;; A run of `irun` is a run of `wrun` on the same externals, each leaving what is outside as it
;; was: the same word, the same memory, the outside unchanged. A callee's run first, given it of
;; every statement on the same fuel.
(theorem wcal_of_cal
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (v (BitVec 64)) (m2 Mem))
       (-> (= (irun n p ext rs s ls m) (some (Prod.mk v m2)))
         (= (wrun n p (wlift ext) rs s ls m o) (some (ORet v m2 o))))))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (v (BitVec 64))
   (m2 Mem)
   (h (= (cal_run n p ext rs cal vs m) (some (Prod.mk v m2)))))
  (= (wcal_run n p (wlift ext) rs cal vs m o) (some (ORet v m2 o)))
  (by
    (have g
      (-> (= (cal_run n p ext rs cal vs m) (some (Prod.mk v m2)))
        (= (wcal_run n p (wlift ext) rs cal vs m o) (some (ORet v m2 o))))
      (cases cal
        ((CFn (i)
           (show
             (-> (= (fn_run n p ext rs (fn_at p i) vs m) (some (Prod.mk v m2)))
               (= (wfn_run n p (wlift ext) rs (fn_at p i) vs m o) (some (ORet v m2 o)))))
           (cases (fn_at p i) hf
             ((none () (intro h0)
                (have h2 (= (@Option.none (Prod (BitVec 64) Mem)) (some (Prod.mk v m2))) (exact h0))
                (exact (absurd (Eq.symm h2) (Option.some_ne_none (Prod.mk v m2)))))
              (some (g0) (intro h0) (exact (ih (IFn.body g0) (enter g0 vs) m o v m2 h0))))))
         (CExt (j)
           (show
             (-> (= (ext j vs m) (some (Prod.mk v m2)))
               (= (wlift ext j vs m o) (some (ORet v m2 o)))))
           (intro h0)
           (unfold wlift)
           (reduce)
           (rw h0)
           rfl))))
    (exact (g h))))
(theorem wrun_of_irun
  ((p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (n Fuel))
  (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (v (BitVec 64)) (m2 Mem))
    (-> (= (irun n p ext rs s ls m) (some (Prod.mk v m2)))
      (= (wrun n p (wlift ext) rs s ls m o) (some (ORet v m2 o)))))
  (by
    (induction n
      ((FZ () (intro s ls m o v m2 h)
         (have hn (= (irun FZ p ext rs s ls m) (@Option.none (Prod (BitVec 64) Mem))) rfl)
         (exact (absurd (Eq.symm (Eq.trans (Eq.symm hn) h)) (Option.some_ne_none (Prod.mk v m2)))))
       (FS (n1 ih) (intro s)
         (cases s
           ((SLet (x e k) (intro ls m o v m2 h)
              (cases (irun_let_inv p ext rs n1 x e k ls m (Prod.mk v m2) h)
                ((intro (w hw)
                   (exact
                     (wrun_let p (wlift ext) rs n1 x e k ls m o w (ORet v m2 o) (And.left hw)
                       (ih k (upd ls x w) m o v m2 (And.right hw))))))))
            (SStore (a e k) (intro ls m o v m2 h)
              (cases (irun_store_inv p ext rs n1 a e k ls m (Prod.mk v m2) h)
                ((intro (q hq)
                   (cases hq
                     ((intro (w hw)
                        (exact
                          (wrun_store p (wlift ext) rs n1 a e k ls m o q w (ORet v m2 o)
                            (And.left hw)
                            (And.left (And.right hw))
                            (And.left (And.right (And.right hw)))
                            (ih k ls (mem_put64 m (w64_val q) (w64_val w)) o v m2
                              (And.right (And.right (And.right hw)))))))))))))
            (SCall (x cal es k) (intro ls m o v m2 h)
              (cases (irun_call_inv p ext rs n1 x cal es k ls m (Prod.mk v m2) h)
                ((intro (vs hv)
                   (cases (And.right hv)
                     ((intro (q hq)
                        (have hc1
                          (= (cal_run n1 p ext rs cal vs m)
                            (some (Prod.mk (Prod.fst q) (Prod.snd q))))
                          (exact (And.left hq)))
                        (have hc2
                          (= (wcal_run n1 p (wlift ext) rs cal vs m o)
                            (some (ORet (Prod.fst q) (Prod.snd q) o)))
                          (exact
                            (wcal_of_cal p ext rs n1 ih cal vs m o (Prod.fst q) (Prod.snd q) hc1)))
                        (have hk2
                          (= (wnext n1 p (wlift ext) rs x k ls (ORet (Prod.fst q) (Prod.snd q) o))
                            (some (ORet v m2 o)))
                          (exact (ih k (upd ls x (Prod.fst q)) (Prod.snd q) o v m2 (And.right hq))))
                        (exact
                          (wrun_call p (wlift ext) rs n1 x cal es k ls m o vs
                            (ORet (Prod.fst q) (Prod.snd q) o)
                            (ORet v m2 o)
                            (And.left hv)
                            hc2
                            hk2)))))))))
            (SIf (x cc y t e) (intro ls m o v m2 h)
              (cases (irun_if_inv p ext rs n1 x cc y t e ls m (Prod.mk v m2) h)
                ((intro (vx hx)
                   (cases hx
                     ((intro (vy hy)
                        (exact
                          (wrun_if p (wlift ext) rs n1 x cc y t e ls m o vx vy (ORet v m2 o)
                            (And.left hy)
                            (And.left (And.right hy))
                            (ih (if (icmp cc vx vy) t e) ls m o v m2 (And.right (And.right hy))))))))))))
            (SRet (e) (intro ls m o v m2 h)
              (cases (irun_ret_inv p ext rs n1 e ls m v m2 h)
                ((intro (he hm) (rw hm) (exact (wrun_ret p (wlift ext) rs n1 e ls m o v he))))))
            (STail (cal es) (intro ls m o v m2 h)
              (cases (irun_tail_inv p ext rs n1 cal es ls m (Prod.mk v m2) h)
                ((intro (vs hv)
                   (exact
                     (wrun_tail p (wlift ext) rs n1 cal es ls m o vs (ORet v m2 o) (And.left hv)
                       (wcal_of_cal p ext rs n1 ih cal vs m o v m2 (And.right hv)))))))))))))))

;; ---- more fuel ------------------------------------------------------------------------------------
(theorem wcal_run_more
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
       (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r)))))
   (cal ICallee)
   (vs (List (BitVec 64)))
   (m Mem)
   (o Os)
   (q Outcome)
   (h (= (wcal_run n p wx rs cal vs m o) (some q))))
  (= (wcal_run (FS n) p wx rs cal vs m o) (some q))
  (by
    (have g
      (-> (= (wcal_run n p wx rs cal vs m o) (some q))
        (= (wcal_run (FS n) p wx rs cal vs m o) (some q)))
      (cases cal
        ((CFn (i)
           (show
             (-> (= (wfn_run n p wx rs (fn_at p i) vs m o) (some q))
               (= (wfn_run (FS n) p wx rs (fn_at p i) vs m o) (some q))))
           (cases (fn_at p i) hf
             ((none () (intro h0) (exact h0))
              (some (g0) (intro h0) (exact (ih (IFn.body g0) (enter g0 vs) m o q h0))))))
         (CExt (j) (intro h0) (exact h0)))))
    (exact (g h))))
(theorem wnext_more
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (n Fuel)
   (ih
     (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
       (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r)))))
   (x Nat)
   (k IStm)
   (ls (List (BitVec 64)))
   (q Outcome)
   (r Outcome))
  (-> (= (wnext n p wx rs x k ls q) (some r)) (= (wnext (FS n) p wx rs x k ls q) (some r)))
  (by
    (cases q
      ((ORet (v m1 o1)
         (show
           (-> (= (wrun n p wx rs k (upd ls x v) m1 o1) (some r))
             (= (wrun (FS n) p wx rs k (upd ls x v) m1 o1) (some r))))
         (exact (ih k (upd ls x v) m1 o1 r)))
       (OEnd (e) (intro h0) (exact h0))))))
(theorem wrun_more
  ((p (List IFn)) (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome))) (rs (List Seg)) (n Fuel))
  (forall ((s IStm) (ls (List (BitVec 64))) (m Mem) (o Os) (r Outcome))
    (-> (= (wrun n p wx rs s ls m o) (some r)) (= (wrun (FS n) p wx rs s ls m o) (some r))))
  (by
    (induction n
      ((FZ () (intro s ls m o r h)
         (have hn (= (wrun FZ p wx rs s ls m o) (@Option.none Outcome)) rfl)
         (exact (absurd (Eq.symm (Eq.trans (Eq.symm hn) h)) (Option.some_ne_none r))))
       (FS (n1 ih) (intro s)
         (cases s
           ((SLet (x e k) (intro ls m o r h)
              (cases (wrun_let_inv p wx rs n1 x e k ls m o r h)
                ((intro (w hw)
                   (exact
                     (wrun_let p wx rs (FS n1) x e k ls m o w r (And.left hw)
                       (ih k (upd ls x w) m o r (And.right hw))))))))
            (SStore (a e k) (intro ls m o r h)
              (cases (wrun_store_inv p wx rs n1 a e k ls m o r h)
                ((intro (q hq)
                   (cases hq
                     ((intro (w hw)
                        (exact
                          (wrun_store p wx rs (FS n1) a e k ls m o q w r (And.left hw)
                            (And.left (And.right hw))
                            (And.left (And.right (And.right hw)))
                            (ih k ls (mem_put64 m (w64_val q) (w64_val w)) o r
                              (And.right (And.right (And.right hw)))))))))))))
            (SCall (x cal es k) (intro ls m o r h)
              (cases (wrun_call_inv p wx rs n1 x cal es k ls m o r h)
                ((intro (vs hv)
                   (cases (And.right hv)
                     ((intro (q hq)
                        (exact
                          (wrun_call p wx rs (FS n1) x cal es k ls m o vs q r (And.left hv)
                            (wcal_run_more p wx rs n1 ih cal vs m o q (And.left hq))
                            (wnext_more p wx rs n1 ih x k ls q r (And.right hq)))))))))))
            (SIf (x cc y t e) (intro ls m o r h)
              (cases (wrun_if_inv p wx rs n1 x cc y t e ls m o r h)
                ((intro (vx hx)
                   (cases hx
                     ((intro (vy hy)
                        (exact
                          (wrun_if p wx rs (FS n1) x cc y t e ls m o vx vy r (And.left hy)
                            (And.left (And.right hy))
                            (ih (if (icmp cc vx vy) t e) ls m o r (And.right (And.right hy))))))))))))
            (SRet (e) (intro ls m o r h) (exact h))
            (STail (cal es) (intro ls m o r h)
              (cases (wrun_tail_inv p wx rs n1 cal es ls m o r h)
                ((intro (vs hv)
                   (exact
                     (wrun_tail p wx rs (FS n1) cal es ls m o vs r (And.left hv)
                       (wcal_run_more p wx rs n1 ih cal vs m o r (And.right hv)))))))))))))))
;; a run with an outcome has it with any fuel put before its own, and with any after
(theorem wrun_front
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (n Fuel)
   (h (= (wrun n p wx rs s ls m o) (some r)))
   (d Fuel))
  (= (wrun (fadd d n) p wx rs s ls m o) (some r))
  (by
    (induction d
      ((FZ () (exact h)) (FS (d1 ih) (exact (wrun_more p wx rs (fadd d1 n) s ls m o r ih)))))))
(theorem wrun_back
  ((p (List IFn))
   (wx (-> Nat (List (BitVec 64)) Mem Os (Option Outcome)))
   (rs (List Seg))
   (s IStm)
   (ls (List (BitVec 64)))
   (m Mem)
   (o Os)
   (r Outcome)
   (n Fuel)
   (h (= (wrun n p wx rs s ls m o) (some r)))
   (d Fuel))
  (= (wrun (fadd n d) p wx rs s ls m o) (some r))
  (by
    (induction d
      ((FZ () (rw (fadd_zero n)) (exact h))
       (FS (d1 ih) (rw (fadd_succ n d1)) (exact (wrun_more p wx rs (fadd n d1) s ls m o r ih)))))))
