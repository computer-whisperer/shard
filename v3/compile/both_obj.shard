;;; v3/compile/both_obj.shard — the intermediate code of `both`'s module: the code as data. It calls
;;; `addto` and `dot` as functions OUTSIDE its module: of each the code has an index and no code.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use Init.List cons nil)
(use Init.Option none some)

;; Locals: 0 px, 1 py, 2 n, then the two calls' words. Outside function 0 is `addto`, 1 `dot`.
(fn both_code () IFn
  (MkIFn 3 2
    (SCall 3 (CExt 0) (list (EVar 0) (EVar 1) (EVar 2))
      (SCall 4 (CExt 1) (list (EVar 0) (EVar 0) (EVar 2)) (SRet (EVar 4))))))
(fn both_prog () (List IFn) (list both_code))
(theorem both_code_is () (= (fn_at both_prog 0) (some both_code)) (by rfl))
