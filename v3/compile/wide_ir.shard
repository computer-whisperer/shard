;;; v3/compile/wide_ir.shard — intermediate code of five functions that have more than six
;;; locals each, so that some of them live in the function's frame (`x86/pass.shard`): the
;;; cases a compiled file is run on to compare the pass's code with the intermediate machine
;;; (x86/calls_cases_main.shard). Each takes two words. No function here is tied to a meaning:
;;; what is held is that the three runs agree.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use models.x86.word)
(use Init.Bool false true)
(use Init.List cons nil)

;; eight locals: the seventh and eighth set, read and set again
(fn wide_code0 () IFn
  (MkIFn 2 6
    (SLet 2 (EOp OAdd (EVar 0) (EVar 1))
      (SLet 6 (EOp OAdd (EVar 0) (ENum (w64 7)))
        (SLet 7 (EOp OMul (EVar 6) (EVar 1))
          (SLet 6 (EOp OXor (EVar 6) (EVar 7))
            (SRet (EOp OAdd (EVar 6) (EOp OSub (EVar 7) (EVar 2))))))))))
;; twenty-six locals: a local far enough up the frame that its place takes the long form of an
;; address, and one never set, which is zero
(fn wide_code1 () IFn
  (MkIFn 2 24
    (SLet 25 (EOp OAdd (EVar 0) (ENum (w64 1)))
      (SLet 22 (EOp OXor (EVar 1) (EVar 25))
        (SRet (EOp OAdd (EVar 22) (EOp OSub (EVar 25) (EVar 6))))))))
;; a comparison of two locals of the frame, a call each way with them as arguments, its word
;; into one of them
(fn wide_code2 () IFn
  (MkIFn 2 6
    (SLet 6 (EVar 0)
      (SLet 7 (EVar 1)
        (SIf (EVar 6) CLtu (EVar 7)
          (SCall 7 (CFn 0) (list (EVar 7) (EVar 6)) (SRet (EOp OAdd (EVar 7) (EVar 6))))
          (SCall 6 (CFn 1) (list (EVar 6) (ENum (w64 3))) (SRet (EOp OOr (EVar 6) (EVar 7)))))))))
;; a loop as a tail call of itself, the sum kept in a local of the frame
(fn wide_code3 () IFn
  (MkIFn 2 5
    (SIf (EVar 0) CLtu (ENum (w64 1)) (SRet (EVar 1))
      (SLet 6 (EOp OAdd (EVar 1) (EVar 0))
        (SLet 0 (EOp OSub (EVar 0) (ENum (w64 1))) (STail (CFn 3) (list (EVar 0) (EVar 6))))))))
;; a tail call of another function, an argument from the frame
(fn wide_code4 () IFn
  (MkIFn 2 7 (SLet 8 (EOp OAdd (EVar 0) (EVar 1)) (STail (CFn 0) (list (EVar 8) (EVar 0))))))
(fn wide_prog () (List IFn) (list wide_code0 wide_code1 wide_code2 wide_code3 wide_code4))
