;;; v3/compile/upd.shard — functions of two buffers of one count that write the first (`addto` and
;;; its callers): the type of a low form over them — the data ranges, the memory, the two
;;; addresses and the count as words, and the evidence that the first buffer is in the ranges to
;;; read and to write, the second to read, and that the two lie apart — whose value is a word
;;; and the memory after; and such a function as the answer of a function called from outside its
;;; module: what it gives where the argument words have the evidence, and no answer elsewhere.
;;; Stated once for every such low form. And what a caller of such a function uses after the
;;; call: the other buffer is as it was.
(import "lo.shard")
(import "../models/x86/frame.shard")
(use std.mem)
(use compile.ir)
(use compile.lo)
(use models.x86.frame)
(use models.x86.laws)
(use models.x86.word)
(use models.x86.words)
(use models.x86.x86)
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

;; two buffers of n words lie apart
(def apart ((p (BitVec 64)) (q (BitVec 64)) (n (BitVec 64))) Prop
  (or (<= (+ (w64_val p) (* 8 (w64_val n))) (w64_val q))
    (<= (+ (w64_val q) (* 8 (w64_val n))) (w64_val p))))

(abbrev Upd2 () Type
  (forall
    ((rs (List Seg))
     (m Mem)
     (px (BitVec 64))
     (py (BitVec 64))
     (n (BitVec 64))
     (ex (buf_ok rs px n 4))
     (ew (buf_ok rs px n 2))
     (ey (buf_ok rs py n 4))
     (ea (apart px py n)))
    (Prod (BitVec 64) Mem)))

;; ---- a writing function as the answer of a function called from outside ---------------------------
;; what such a low form asks of the argument words: three of them, and the four pieces of evidence
(def upd_ok ((rs (List Seg)) (vs (List (BitVec 64)))) Prop
  (and (= vs (cons (nth vs 0) (cons (nth vs 1) (cons (nth vs 2) nil))))
    (and (buf_ok rs (nth vs 0) (nth vs 2) 4)
      (and (buf_ok rs (nth vs 0) (nth vs 2) 2)
        (and (buf_ok rs (nth vs 1) (nth vs 2) 4) (apart (nth vs 0) (nth vs 1) (nth vs 2)))))))
(theorem upd_ok_x ((rs (List Seg)) (vs (List (BitVec 64))) (h (upd_ok rs vs)))
  (buf_ok rs (nth vs 0) (nth vs 2) 4)
  (exact (And.left (And.right h))))
(theorem upd_ok_w ((rs (List Seg)) (vs (List (BitVec 64))) (h (upd_ok rs vs)))
  (buf_ok rs (nth vs 0) (nth vs 2) 2)
  (exact (And.left (And.right (And.right h)))))
(theorem upd_ok_y ((rs (List Seg)) (vs (List (BitVec 64))) (h (upd_ok rs vs)))
  (buf_ok rs (nth vs 1) (nth vs 2) 4)
  (exact (And.left (And.right (And.right (And.right h))))))
(theorem upd_ok_a ((rs (List Seg)) (vs (List (BitVec 64))) (h (upd_ok rs vs)))
  (apart (nth vs 0) (nth vs 1) (nth vs 2))
  (exact (And.right (And.right (And.right (And.right h))))))
;; the answer: where that holds, the function's word and memory
(def upd_ext ((f Upd2) (rs (List Seg)) (vs (List (BitVec 64))) (m Mem))
  (Option (Prod (BitVec 64) Mem))
  (ans_on (upd_ok rs vs)
    (fun ((h (upd_ok rs vs)))
      (f rs m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs h) (upd_ok_w rs vs h)
        (upd_ok_y rs vs h)
        (upd_ok_a rs vs h)))))
;; the same as a relation, which is what code realizes (`x86/seam.shard`)
(def upd_ans ((f Upd2) (rs (List Seg)) (vs (List (BitVec 64))) (m Mem) (v (BitVec 64)) (m2 Mem))
  Prop
  (= (upd_ext f rs vs m) (some (Prod.mk v m2))))
;; on two addresses and a count, with the evidence, it is the function
(theorem upd_ext_is
  ((f Upd2)
   (rs (List Seg))
   (m Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (ex (buf_ok rs px n 4))
   (ew (buf_ok rs px n 2))
   (ey (buf_ok rs py n 4))
   (ea (apart px py n)))
  (= (upd_ext f rs (cons px (cons py (cons n nil))) m)
    (some (Prod.mk (Prod.fst (f rs m px py n ex ew ey ea)) (Prod.snd (f rs m px py n ex ew ey ea)))))
  (exact
    (ans_on_pos (upd_ok rs (cons px (cons py (cons n nil))))
      (fun ((h (upd_ok rs (cons px (cons py (cons n nil))))))
        (f rs m px py n (upd_ok_x rs (cons px (cons py (cons n nil))) h)
          (upd_ok_w rs (cons px (cons py (cons n nil))) h)
          (upd_ok_y rs (cons px (cons py (cons n nil))) h)
          (upd_ok_a rs (cons px (cons py (cons n nil))) h)))
      (And.intro (Eq.refl (cons px (cons py (cons n nil))))
        (And.intro ex (And.intro ew (And.intro ey ea)))))))
;; and whatever it answers is the function's on three words that have the evidence
(theorem upd_ans_inv
  ((f Upd2)
   (rs (List Seg))
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (upd_ans f rs vs m v m2)))
  (exists ((ok (upd_ok rs vs)))
    (= (Prod.mk v m2)
      (f rs m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs ok) (upd_ok_w rs vs ok)
        (upd_ok_y rs vs ok)
        (upd_ok_a rs vs ok))))
  (exact
    (ans_on_inv (upd_ok rs vs)
      (fun ((h (upd_ok rs vs)))
        (f rs m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs h) (upd_ok_w rs vs h)
          (upd_ok_y rs vs h)
          (upd_ok_a rs vs h)))
      (Prod.mk v m2)
      h)))
;; code whose run answers the function's word and memory on every two addresses and count that
;; have the evidence answers whatever the answer says: so code that realizes the run's answer
;; realizes `upd_ans`, the answer a caller outside the module runs with
(theorem upd_ans_tie
  ((f Upd2)
   (p (List IFn))
   (ext (-> Nat (List (BitVec 64)) Mem (Option (Prod (BitVec 64) Mem))))
   (rs (List Seg))
   (g IFn)
   (ht
     (forall
       ((m Mem)
        (px (BitVec 64))
        (py (BitVec 64))
        (n (BitVec 64))
        (ex (buf_ok rs px n 4))
        (ew (buf_ok rs px n 2))
        (ey (buf_ok rs py n 4))
        (ea (apart px py n)))
       (fn_ans p ext rs g (cons px (cons py (cons n nil))) m (Prod.fst (f rs m px py n ex ew ey ea))
         (Prod.snd (f rs m px py n ex ew ey ea)))))
   (vs (List (BitVec 64)))
   (m Mem)
   (v (BitVec 64))
   (m2 Mem)
   (h (upd_ans f rs vs m v m2)))
  (fn_ans p ext rs g vs m v m2)
  (by
    (cases (upd_ans_inv f rs vs m v m2 h)
      ((intro (ok e)
         (have ev
           (= v
             (Prod.fst
               (f rs m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs ok) (upd_ok_w rs vs ok)
                 (upd_ok_y rs vs ok)
                 (upd_ok_a rs vs ok))))
           (exact (congrArg (fun ((q (Prod (BitVec 64) Mem))) (Prod.fst q)) e)))
         (have em
           (= m2
             (Prod.snd
               (f rs m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs ok) (upd_ok_w rs vs ok)
                 (upd_ok_y rs vs ok)
                 (upd_ok_a rs vs ok))))
           (exact (congrArg (fun ((q (Prod (BitVec 64) Mem))) (Prod.snd q)) e)))
         (rw ev)
         (rw em)
         (rw (And.left ok) (occ 1))
         (exact
           (ht m (nth vs 0) (nth vs 1) (nth vs 2) (upd_ok_x rs vs ok) (upd_ok_w rs vs ok)
             (upd_ok_y rs vs ok)
             (upd_ok_a rs vs ok))))))))

;; ---- across a call that writes ----------------------------------------------------------------------
;; a read clear of what was written reads what it read before
(theorem rd_same
  ((rs (List Seg))
   (m Mem)
   (m2 Mem)
   (lo Nat)
   (hi Nat)
   (a (BitVec 64))
   (hm (= (mapped rs (w64_val a) 8 4) true))
   (hso (same_outside m m2 lo hi))
   (hx (or (<= (+ (w64_val a) 8) lo) (<= hi (w64_val a)))))
  (= (rd64 rs m2 a hm) (rd64 rs m a hm))
  (by
    (show (= (w64 (mem_le64 m2 (w64_val a))) (w64 (mem_le64 m (w64_val a)))))
    (rw (le64_same m m2 lo hi (w64_val a) hso hx))
    rfl))
;; after a write into the n words at px, a buffer of n words apart from them is as it was: the
;; two memories agree on its words. With `two.shard`'s `reads_on`, what a reading function gave
;; of that buffer before the write it gives after it
(theorem kept_apart
  ((m Mem)
   (m2 Mem)
   (px (BitVec 64))
   (py (BitVec 64))
   (n (BitVec 64))
   (hso (same_outside m m2 (w64_val px) (+ (w64_val px) (* 8 (w64_val n)))))
   (ea (apart px py n)))
  (same_on m m2 (w64_val py) (+ (w64_val py) (* 8 (w64_val n))))
  (by
    (intro x h1 h2)
    (apply (hso x)
      ((cases ea ((inl (h) (apply Or.inr ((arith)))) (inr (h) (apply Or.inl ((arith))))))))))
