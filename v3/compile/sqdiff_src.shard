;;; v3/compile/sqdiff_src.shard — the meaning of `sqdiff` (docs/COMPILE.md §5): the difference of two
;;; buffers' sums of squares, each `dot` of a list with itself.
;;; A function over two lists and a count, as `dot` is (v3/models/x86/buffers.shard); and its
;;; value on the sample lists.
(import "../models/x86/buffers.shard")
(use models.x86.buffers)
(use models.x86.word)

(fn sqdiff
  ((xs (List (BitVec 64)))
   (ys (List (BitVec 64)))
   (n (BitVec 64))
   (rx (<= (w64_val n) (List.length xs)))
   (ry (<= (w64_val n) (List.length ys))))
  (BitVec 64)
  (w64_sub (dot xs xs n rx rx) (dot ys ys n ry ry)))
;; of 3 5 7 and 2 4 6: 9 + 25 + 49 less 4 + 16 + 36
(theorem sample_sqdiff () (= (w64_val (sqdiff sample_xs sample_ys (w64 3) sample_rx sample_ry)) 27)
  (by decide))
