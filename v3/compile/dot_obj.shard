;;; v3/compile/dot_obj.shard — the intermediate code of `dot`'s module (docs/COMPILE.md §5): the
;;; code as data, which the pass reads and a file's writer runs. It is written by hand from
;;; the low form in the directory `dot`, whose view states what the code's run answers; nothing
;;; here is a proof about it.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.ICmp)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use models.x86.word)
(use Init.List cons nil)
(use Init.Option none some)

;; ---- the code ----------------------------------------------------------------------------------
;; Locals are the low form's parameters in order, the evidence left out. The loop: 0 px, 1 py,
;; 2 n, 3 i, 4 acc; the sum is set before the index, which it reads. The loop is function 0 of
;; the program, `dot` function 1.
(fn dot_go_code () IFn
  (MkIFn 5 0
    (SIf (EVar 3) CLtu (EVar 2)
      (SLet 4
        (EOp OAdd (EVar 4)
          (EOp OMul (ELoad (EOp OAdd (EVar 0) (EOp OMul (ENum (w64 8)) (EVar 3))))
            (ELoad (EOp OAdd (EVar 1) (EOp OMul (ENum (w64 8)) (EVar 3))))))
        (SLet 3 (EOp OAdd (EVar 3) (ENum (w64 1)))
          (STail (CFn 0) (list (EVar 0) (EVar 1) (EVar 2) (EVar 3) (EVar 4)))))
      (SRet (EVar 4)))))
(fn dot_code () IFn
  (MkIFn 3 0 (STail (CFn 0) (list (EVar 0) (EVar 1) (EVar 2) (ENum (w64 0)) (ENum (w64 0))))))
(fn dot_prog () (List IFn) (list dot_go_code dot_code))
;; `dot` is the program's second function
(theorem dot_code_is () (= (fn_at dot_prog 1) (some dot_code)) (by rfl))
