;;; v3/compile/total_obj.shard — the intermediate code of `total`'s module: the code as data. It
;;; calls `both` and `dot` as functions OUTSIDE its module.
(import "ir.shard")
(use compile.ir)
(use compile.ir.ICallee)
(use compile.ir.IExp)
(use compile.ir.IFn)
(use compile.ir.IOp)
(use compile.ir.IStm)
(use Init.List cons nil)
(use Init.Option none some)

;; Locals: 0 px, 1 py, 2 n, then the two calls' words. Outside function 0 is `both`, 1 `dot`.
(fn total_code () IFn
  (MkIFn 3 2
    (SCall 3 (CExt 0) (list (EVar 0) (EVar 1) (EVar 2))
      (SCall 4 (CExt 1) (list (EVar 1) (EVar 1) (EVar 2)) (SRet (EOp OAdd (EVar 3) (EVar 4)))))))
(fn total_prog () (List IFn) (list total_code))
(theorem total_code_is () (= (fn_at total_prog 0) (some total_code)) (by rfl))
