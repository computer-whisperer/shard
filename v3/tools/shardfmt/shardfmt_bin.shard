;;; v3/tools/shardfmt/shardfmt_bin.shard — the formatter's contract: the artifact declaration
;;; beside the program (`shardfmt.shard`), as calc's is (`examples/calc/calc_bin.shard`). Two
;;; requirements:
;;;
;;;   fmt_gate            whatever `fmt` returns for a source, the reader reads as it read the
;;;                       source — by `fmt`'s last step, whatever the printer did
;;;   fmt_main_contract   from a world with nothing read and nothing written, the run ends in an
;;;                       exit, and exit 0 means: exactly one file was read, `fmt` accepted its
;;;                       bytes, and exactly one chunk was written — `fmt`'s text for them.
;;;                       A nonzero exit promises nothing more
;;;
;;; Together: a run that exits 0 wrote a text the reader reads as it reads the file. The printer
;;; and the reader are the two views' opaque functions (`print`, `reads_same`), so both theorems
;;; hold for any printer and any reader: their assumption closures name those parameters, and
;;; the bolts below.
;;;
;;; A World's observables — the results of the files read, the chunks written, the exit — are
;;; opaque constants over it, given meaning by the bolts: one axiom per extern and observable
;;; the proof needs, nine in all (`get_args`, `read_file` and `write` on the exit are not
;;; needed: every path ends in `exit`). The proof is the program's cases walked once: the
;;; lemmas `exitN_ok`, `usage_ok`, `refuse_ok`, `wrote_ok`, `run_fmt_ok`, then `main`.
;;;
;;;   load.shard --root v3 --init … v3/tools/shardfmt/shardfmt_bin.shard v3/tools/shardfmt/print v3/tools/shardfmt/reads
;;;     → BIN tools.shardfmt.shardfmt_bin.shardfmt entry tools.shardfmt.shardfmt.main externs 4 trusts 9 requires 2/2

(import Init List.nil_append)
(import "shardfmt.shard")
(trusts get_args_reads get_args_output read_file_reads read_file_output write_reads write_output
  exit_reads exit_output exit_exit)
(use tools.shardfmt.shardfmt)
(use tools.shardfmt.fmt)
(use tools.shardfmt.print)
(use tools.shardfmt.reads)
(use std.bytes)
(use std.host)
(use Init.Bool)
(use Init.List)
(use Init.Option)

;; ---- the observables ---------------------------------------------------------------------------
;; the results of the files read so far, the chunks written so far, the exit code once called
(opaque w_reads ((w World)) (List (Option ByteArray)) nil)
(opaque w_output ((w World)) (List ByteArray) nil)
(opaque w_exit ((w World)) (Option Int) none)

;; ---- the bolts ---------------------------------------------------------------------------------
;; get_args: nothing read, nothing written (the premise form: the pair it returns)
(axiom get_args_reads ((w World) (args (List ByteArray)) (w1 World))
  (-> (= (get_args w) (Prod.mk args w1)) (= (w_reads w1) (w_reads w))))
(axiom get_args_output ((w World) (args (List ByteArray)) (w1 World))
  (-> (= (get_args w) (Prod.mk args w1)) (= (w_output w1) (w_output w))))
;; read_file: its result joins the files read; nothing written
(axiom read_file_reads ((p ByteArray) (w World) (r (Option ByteArray)) (w1 World))
  (-> (= (read_file p w) (Prod.mk r w1)) (= (w_reads w1) (List.append (w_reads w) (cons r nil)))))
(axiom read_file_output ((p ByteArray) (w World) (r (Option ByteArray)) (w1 World))
  (-> (= (read_file p w) (Prod.mk r w1)) (= (w_output w1) (w_output w))))
;; write: one more chunk written; nothing read
(axiom write_reads ((bs ByteArray) (w World)) (= (w_reads (write bs w)) (w_reads w)))
(axiom write_output ((bs ByteArray) (w World))
  (= (w_output (write bs w)) (List.append (w_output w) (cons bs nil))))
;; exit: the code recorded; nothing read, nothing written
(axiom exit_reads ((c Int) (w World)) (= (w_reads (exit c w)) (w_reads w)))
(axiom exit_output ((c Int) (w World)) (= (w_output (exit c w)) (w_output w)))
(axiom exit_exit ((c Int) (w World)) (= (w_exit (exit c w)) (some c)))

;; ---- the gate -----------------------------------------------------------------------------------
;; a total statement: no text is vacuously fine; a text reads as the source does
(fn gate_holds ((r (Option ByteArray)) (src ByteArray)) Bool
  (match r
    (none true)
    ((some out) (reads_same src out))))
(theorem fmt_gate ((src ByteArray)) (= (gate_holds (fmt src) src) true)
  (by
    (rw fmt.eq_1)
    (cases (print src)
      ((none () (reduce) rfl)
       (some (out)
         (cases (reads_same src out) hr
           ((false () (reduce) (rw hr) (reduce) rfl)
            (true () (reduce) (rw hr) (reduce) (rw hr) rfl))))))))

;; ---- the run -------------------------------------------------------------------------------------
;; the contract over the three observables of a finished run
(fn run_ok ((reads (List (Option ByteArray))) (outs (List ByteArray)) (ex (Option Int))) Bool
  (match ex
    (none false)
    ((some c)
     (if (= c 0)
       (match reads
         (nil false)
         ((cons r more)
          (match more
            ((cons _ _) false)
            (nil
              (match r
                (none false)
                ((some src)
                 (match (fmt src)
                   (none false)
                   ((some out)
                    (match outs
                      (nil false)
                      ((cons o more_o)
                       (match more_o
                         ((cons _ _) false)
                         (nil (same_bytes (Bytes.toList o) (Bytes.toList out))))))))))))))
       true))))

;; the program's byte comparison holds of a text and itself
(theorem same_bytes_refl ((a (List UInt8))) (= (same_bytes a a) true)
  (by
    (induction a
      ((nil () (reduce) rfl)
       (cons (x xs ih) (reduce) (rw ih) (rw (if_pos (Eq.refl (UInt8.toNat x)))) rfl)))))

;; a nonzero exit satisfies the contract, whatever was read and written
(theorem exit2_ok ((w World))
  (= (run_ok (w_reads (exit 2 w)) (w_output (exit 2 w)) (w_exit (exit 2 w))) true)
  (by (rw exit_exit) (reduce) rfl))
(theorem exit1_ok ((w World))
  (= (run_ok (w_reads (exit 1 w)) (w_output (exit 1 w)) (w_exit (exit 1 w))) true)
  (by (rw exit_exit) (reduce) rfl))
(theorem exit3_ok ((w World))
  (= (run_ok (w_reads (exit 3 w)) (w_output (exit 3 w)) (w_exit (exit 3 w))) true)
  (by (rw exit_exit) (reduce) rfl))

(theorem usage_ok ((w World))
  (= (run_ok (w_reads (usage w)) (w_output (usage w)) (w_exit (usage w))) true)
  (by (rw usage.eq_1) (apply exit2_ok)))

(theorem refuse_ok ((src ByteArray) (w World))
  (= (run_ok (w_reads (refuse src w)) (w_output (refuse src w)) (w_exit (refuse src w))) true)
  (by
    (rw refuse.eq_1)
    (cases (read_error src)
      ((none () (reduce)
         (cases (print src)
           ((none () (reduce) (apply exit2_ok)) (some (out) (reduce) (apply exit3_ok)))))
       (some (why) (reduce) (apply exit2_ok))))))

;; the one way to exit 0: after one read that gave `src`, `fmt src` gave `out`, and `out` is the
;; one chunk written
(theorem wrote_ok ((path ByteArray) (w World) (src ByteArray) (w2 World) (out ByteArray))
  (-> (= (read_file path w) (Prod.mk (some src) w2))
    (-> (= (fmt src) (some out))
      (-> (= (w_reads w) nil)
        (-> (= (w_output w) nil)
          (=
            (run_ok (w_reads (exit 0 (write out w2))) (w_output (exit 0 (write out w2)))
              (w_exit (exit 0 (write out w2))))
            true)))))
  (by
    (intro hr hf h1 h2)
    (rw exit_reads)
    (rw write_reads)
    (rw (read_file_reads path w (some src) w2 hr))
    (rw h1)
    (rw List.nil_append)
    (rw exit_output)
    (rw write_output)
    (rw (read_file_output path w (some src) w2 hr))
    (rw h2)
    (rw List.nil_append)
    (rw exit_exit)
    (reduce)
    (rw hf)
    (reduce)
    (rw same_bytes_refl)
    rfl))

;; the read, the format, the write: every branch is one of the above
(theorem run_fmt_ok ((path ByteArray) (check Bool) (w World))
  (-> (= (w_reads w) nil)
    (-> (= (w_output w) nil)
      (=
        (run_ok (w_reads (run_fmt path check w)) (w_output (run_fmt path check w))
          (w_exit (run_fmt path check w)))
        true)))
  (by
    (intro h1 h2)
    (rw run_fmt.eq_1)
    (cases (read_file path w) hr
      ((Prod.mk (r w2) (reduce)
         (cases r
           ((none () (reduce) (apply exit2_ok))
            (some (src) (reduce)
              (cases (fmt src) hf
                ((none () (reduce) (apply refuse_ok))
                 (some (out) (reduce)
                   (cases check
                     ((false () (reduce) (exact (wrote_ok path w src w2 out hr hf h1 h2)))
                      (true () (reduce)
                        (cases (same_bytes (Bytes.toList out) (Bytes.toList src))
                          ((false () (reduce) (apply exit1_ok))
                           (true () (reduce) (exact (wrote_ok path w src w2 out hr hf h1 h2)))))))))))))))))))

;; ---- the requirements' second: main ------------------------------------------------------------
(theorem fmt_main_contract ((w World))
  (-> (= (w_reads w) nil)
    (-> (= (w_output w) nil)
      (= (run_ok (w_reads (main w)) (w_output (main w)) (w_exit (main w))) true)))
  (by
    (intro h1 h2)
    (rw main.eq_1)
    (cases (get_args w) hg
      ((Prod.mk (args w1) (reduce)
         (have hr1 (= (w_reads w1) nil) (rw (get_args_reads w args w1 hg)) (exact h1))
         (have ho1 (= (w_output w1) nil) (rw (get_args_output w args w1 hg)) (exact h2))
         (cases args
           ((nil () (reduce) (apply usage_ok))
            (cons (a0 more) (reduce)
              (cases more
                ((nil () (reduce)
                   (cases (is_check a0)
                     ((false () (reduce) (exact (run_fmt_ok a0 false w1 hr1 ho1)))
                      (true () (reduce) (apply usage_ok)))))
                 (cons (a1 more2) (reduce)
                   (cases more2
                     ((nil () (reduce)
                        (cases (is_check a0)
                          ((false () (reduce) (apply usage_ok))
                           (true () (reduce) (exact (run_fmt_ok a1 true w1 hr1 ho1))))))
                      (cons (a2 more3) (reduce) (apply usage_ok)))))))))))))))

;; ---- the artifact ---------------------------------------------------------------------------------
(bin shardfmt
  (entry main)
  (externs get_args read_file write exit)
  (trusts get_args_reads get_args_output read_file_reads read_file_output write_reads write_output
    exit_reads exit_output exit_exit)
  (requires fmt_gate fmt_main_contract))
