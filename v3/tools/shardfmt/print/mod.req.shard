;;; v3/tools/shardfmt/print — the printer as the formatter sees it (LANGUAGE.md §8.7 slice 5.1
;;; rule 2; CANON.md §3): one function from a source's bytes to its text in the canonical
;;; layout, or none where the printer has no reading of the source. It is opaque here on
;;; purpose. The formatter's contract never says the printer is right — it says the binary
;;; refuses output the reader reads differently (`fmt.shard`) — so every theorem about the
;;; formatter holds for any printer, and this view is all a consumer may know of this one.
;;; What the layout is, is pinned by worked examples run against the binary
;;; (`test/scenarios`); they become requirements of this view when the printer's functions
;;; have definitions (`print/layout.shard`'s header).
(import Init UInt8.toNat)

(sig fn print ((src ByteArray)) (Option ByteArray))
