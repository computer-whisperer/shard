;;; v3/tools/shardfmt/print — the printer as the formatter sees it: one function from a
;;; source's bytes to its text in the canonical layout, or none where the printer has no
;;; reading of the source. It is opaque here on purpose. The formatter's contract never says
;;; the printer is right — it says the binary refuses output the reader reads differently
;;; (`fmt.shard`) — so every theorem about the formatter holds for any printer, and this view
;;; is all a consumer may know of this one. What the layout is, is pinned by worked examples
;;; run against the binary (`test/scenarios`). The implementation's `print` is a definition
;;; (`print/layout.shard`'s header), so this parameter is discharged by it, not linked. The
;;; examples are not requirements of this view: K's evaluation of a closed call through a
;;; measured definition does not reach their size.
(import Init UInt8.toNat)

(sig fn print ((src ByteArray)) (Option ByteArray))
