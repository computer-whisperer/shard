;;; v3/tools/shardfmt/print/print.shard — the view's implementation: read the source as a
;;; tree that keeps its layout (`cst.shard`), print the tree (`layout.shard`).
(import "layout.shard")
(use tools.shardfmt.print.cst)
(use tools.shardfmt.print.layout)
(use std.bytes)
(use Init.Option)

(fn print ((src ByteArray)) (Option ByteArray)
  (match (cst_read (Bytes.toNats src))
    (none none)
    ((some ns) (some (Bytes.ofNats (pp_top ns))))))
