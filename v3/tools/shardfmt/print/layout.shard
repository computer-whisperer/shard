;;; v3/tools/shardfmt/print/layout.shard — the printer: a tree (`cst.shard`) as text in the
;;; canonical layout (CANON.md §3 as ruled 2026-11-13; LANGUAGE.md §8.7 slice 5.1 rule 3 and
;;; landing 3). The layout follows structure, and the width — 100 columns — is the backstop: a
;;; form prints flat when it fits its line, except a `match` and an `if` whose else-branch is
;;; an `if`, which never do; a form that breaks keeps arguments on its head line while they
;;; fit and puts the rest one a line, two columns in — a head of the table below keeps at most
;;; its count, so a declaration's body, a match's arms and a let's body always start a line; a
;;; list of atoms fills; a broken `if` cascade holds one column, a comment after the condition
;;; or the then-branch riding its line; closers pack; comments, the `'x` sugar and the raw
;;; bytes of atoms and strings are printed as read.
;;;
;;; The renderers are `meta/format`'s of the old tree, carried function for function on Nat
;;; columns (a width that does not fit is `none`, where the old code went negative) with the
;;; universe list added; what the ruling changed is three places: `width`, `keep_n`'s default
;;; and `is_chain`. Every renderer threads a reversed byte accumulator and fitting is decided
;;; by `flat_w`, a width probe over a budget — no intermediate text, no re-rendering. The
;;; renderers `em_pp em_list em_head em_kids em_if em_if_deep em_chain` recurse through one
;;; another, as do the probe and the flat printer with their list halves: programs without a
;;; definition until V3 compiles mutual recursion (`callee_runnable`). Nothing here is
;;; trusted: the gate compares what the reader makes of the output with what it made of the
;;; input (`fmt.shard`).
(import "cst.shard")
(import "../../../std/bytes.shard")
(use tools.shardfmt.print.cst)
(use std.bytes)
(use Init.Bool)
(use Init.List)
(use Init.Option)
(use tools.shardfmt.print.cst.CNode)

;; ---- sizes and text ----------------------------------------------------------------------------
;; the line's width: the backstop, not the rule (CANON.md §3)
(fn width () Nat 100)
(fn blen ((b (List Nat))) Nat
  (measure (struct b))
  (match b
    (nil 0)
    ((cons _ t) (+ 1 (blen t)))))
;; n spaces onto the accumulator
(fn sp ((n Nat) (acc (List Nat))) (List Nat)
  (measure n)
  (if (= n 0) acc (sp (Nat.sub n 1) (cons 32 acc))))
(fulfills sp.dec_1
  (by (intro p h) (exact (Nat.sub_lt (Nat.pos_of_ne_zero h) (Nat.lt_succ_self 0)))))
;; a width taken from a budget: what is left, or none when it does not fit
(fn fit ((b Nat) (w Nat)) (Option Nat) (if (<= w b) (some (Nat.sub b w)) none))
;; an atom's bytes against a word
(fn codes_are ((a (List Nat)) (w (List UInt8))) Bool
  (measure (struct a))
  (match a
    (nil
      (match w
        (nil true)
        (_ false)))
    ((cons x xs)
     (match w
       (nil false)
       ((cons y ys) (if (= x (UInt8.toNat y)) (codes_are xs ys) false))))))
(fn is_word ((a (List Nat)) (w String)) Bool (codes_are a (Bytes.toList (Bytes.ofString w))))

;; ---- the heads -------------------------------------------------------------------------------
;; the most arguments a head keeps on its line — they stay while they fit, the rest go one a
;; line (CANON.md §3's table). A head with no row keeps all that fit (1000: no bound)
(fn keep_n ((h (List Nat))) Nat
  (if (is_word h "fn") 3  ; name, binders, result
  (if (is_word h "sig") 4  ; fn, name, binders, result
  (if (is_word h "extern") 3
  (if (is_word h "def") 3  ; name, binders, type
  (if (is_word h "abbrev") 3
  (if (is_word h "opaque") 3
  (if (is_word h "theorem") 3  ; name, binders, proposition
  (if (is_word h "axiom") 3
  (if (is_word h "inductive") 3
  (if (is_word h "structure") 2  ; name, binders
  (if (is_word h "realize") 3  ; name, binders, result
  (if (is_word h "requirement") 2
  (if (is_word h "fulfills") 1  ; name
  (if (is_word h "derive") 1000
  (if (is_word h "import") 1000
  (if (is_word h "use") 1000
  (if (is_word h "trusts") 1000
  (if (is_word h "measure") 1
  (if (is_word h "fun") 1  ; the binders
  (if (is_word h "forall") 1
  (if (is_word h "exact") 1
  (if (is_word h "by") 0  ; each step on its own line
  (if (is_word h "match") 1  ; the scrutinee
  (if (is_word h "if") 1  ; the condition
  (if (is_word h "let") 1  ; the bindings
  (if (is_word h "type") 1  ; name
  (if (is_word h "have") 2  ; name, statement
  (if (is_word h "bin") 1  ; name
  1000)))))))))))))))))))))))))))))

;; a match with at least two items after its head never prints flat: arms on their own lines
(fn is_match ((items (List CNode))) Bool
  (match items
    (nil false)
    ((cons h t)
     (match h
       ((CAtom a)
        (if (is_word a "match")
          (match t
            (nil false)
            ((cons _ r) (has_node r)))
          false))
       (_ false)))))
(fn is_if ((n CNode)) Bool
  (match n
    ((CList items)
     (match items
       (nil false)
       ((cons h _)
        (match h
          ((CAtom a) (is_word a "if"))
          (_ false)))))
    (_ false)))
(fn last_is_if ((ns (List CNode))) Bool
  (measure (struct ns))
  (match ns
    (nil false)
    ((cons h t)
     (match t
       (nil (is_if h))
       (_ (last_is_if t))))))
;; an if whose last item — its else-branch — is an if: a chain, which never prints flat
(fn is_chain ((items (List CNode))) Bool
  (match items
    (nil false)
    ((cons h t)
     (match h
       ((CAtom a) (if (is_word a "if") (last_is_if t) false))
       (_ false)))))
(fn all_atoms ((ns (List CNode))) Bool
  (measure (struct ns))
  (match ns
    (nil true)
    ((cons h t)
     (match h
       ((CAtom _) (all_atoms t))
       (_ false)))))
(fn drop_lead_blanks ((ns (List CNode))) (List CNode) (drop_blanks ns))

;; ---- the width probe: the budget left after a flat render, none when it does not fit -------------
;; (none also says "has no flat form": a comment, a blank line, a match, an if chain)
(fn flat_w ((n CNode) (b Nat)) (Option Nat)
  (measure (struct n))
  (match n
    ((CAtom a) (fit b (blen a)))
    ((CStr s) (fit b (+ 2 (blen s))))
    ((CQuote m)
     (match (fit b 1)
       (none none)
       ((some b1) (flat_w m b1))))
    ((CList items)
     (if (if (is_match items) true (is_chain items)) none
     (match (fit b 2)
       (none none)
       ((some b1) (flat_items_w items b1)))))
    ((CLevels s items)
     (match (fit b (+ 2 (blen s)))
       (none none)
       ((some b1) (flat_items_w items b1))))
    (_ none)))
(fn flat_items_w ((ns (List CNode)) (b Nat)) (Option Nat)
  (measure (struct ns))
  (match ns
    (nil (some b))
    ((cons h t)
     (match (flat_w h b)
       (none none)
       ((some b1)
        (match t
          (nil (some b1))
          (_
            (match (fit b1 1)  ; the separating space
              (none none)
              ((some b2) (flat_items_w t b2))))))))))
(fn fits ((n CNode) (b Nat)) Bool
  (match (flat_w n b)
    (none false)
    ((some _) true)))

;; ---- flat emission (called where the probe said it fits, and for what cannot break) --------------
(fn em_flat ((n CNode) (acc (List Nat))) (List Nat)
  (measure (struct n))
  (match n
    ((CAtom a) (em a acc))
    ((CStr s) (cons 34 (em s (cons 34 acc))))
    ((CQuote m) (em_flat m (cons 39 acc)))
    ((CList items) (cons 41 (em_flat_items items (cons 40 acc))))
    ((CLevels s items) (cons 125 (em_flat_items items (cons 123 (em s acc)))))
    ((CComment t) (em t acc))  ; no flat form: the probe never sends one here
    ((CTrail t) (em t acc))
    (CBlank acc)))
(fn em_flat_items ((ns (List CNode)) (acc (List Nat))) (List Nat)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons h t)
     (match t
       (nil (em_flat h acc))
       (_ (em_flat_items t (cons 32 (em_flat h acc))))))))

;; ---- the head line: up to k flat arguments while they fit ---------------------------------------
(type EmK (EmK Nat (List Nat) (List CNode)))  ; the column after, the accumulator, what is left
(fn em_keep ((ns (List CNode)) (k Nat) (cur Nat) (acc (List Nat))) EmK
  (measure (struct ns))
  (if (= k 0) (EmK cur acc ns)
  (match ns
    (nil (EmK cur acc nil))
    ((cons h t)
     (match (fit (width) (+ cur 1))
       (none (EmK cur acc ns))
       ((some b)
        (match (flat_w h b)
          (none (EmK cur acc ns))
          ((some b1) (em_keep t (Nat.sub k 1) (Nat.sub (width) b1) (em_flat h (cons 32 acc)))))))))))

;; a trailing comment at the front of a list, split off
(type Trail (Trail (Option (List Nat)) (List CNode)))
(fn opt_trail ((ns (List CNode))) Trail
  (match ns
    (nil (Trail none ns))
    ((cons h t)
     (match h
       ((CTrail txt) (Trail (some txt) t))
       (_ (Trail none ns))))))
(fn em_trail ((tr (Option (List Nat))) (acc (List Nat))) (List Nat)
  (match tr
    (none acc)
    ((some txt) (em txt (cons 32 (cons 32 acc))))))

;; ---- the break renderers -----------------------------------------------------------------------
;; each child on its own line at `ind`; a trailing comment joins the line before it, a comment
;; takes its own line, a blank node is one empty line; the `)` packs onto the last child's
;; line — its own line at `pcol` only after a comment
(fn em_kids ((ns (List CNode)) (ind Nat) (pcol Nat) (acc (List Nat))) (List Nat)
  (match ns
    (nil (cons 41 acc))
    ((cons h t)
     (match h
       ((CTrail txt)
        (let ((acc1 (em txt (cons 32 (cons 32 acc)))))
          (match t
            (nil (cons 41 (sp pcol (cons 10 acc1))))
            (_ (em_kids t ind pcol acc1)))))
       ((CComment txt)
        (let ((acc1 (em txt (sp ind (cons 10 acc)))))
          (match t
            (nil (cons 41 (sp pcol (cons 10 acc1))))
            (_ (em_kids t ind pcol acc1)))))
       (CBlank (em_kids t ind pcol (cons 10 acc)))
       (_
         (let ((acc1 (em_pp h ind (sp ind (cons 10 acc)))))
           (match t
             (nil (cons 41 acc1))
             (_ (em_kids t ind pcol acc1)))))))))

;; a list of atoms: as many per line as fit, wrapped at `ind`
(fn em_fill_go ((ns (List CNode)) (cur Nat) (ind Nat) (acc (List Nat))) (List Nat)
  (measure (struct ns))
  (match ns
    (nil (cons 41 acc))
    ((cons h t)
     (match h
       ((CAtom a)
        (let ((wd (blen a)))
          (if (<= (+ (+ cur 1) wd) (width)) (em_fill_go t (+ (+ cur 1) wd) ind (em a (cons 32 acc)))
          (em_fill_go t (+ ind wd) ind (em a (sp ind (cons 10 acc)))))))
       (_ (cons 41 acc))))))  ; not reached: the caller checked all_atoms
(fn em_fill ((ns (List CNode)) (col Nat) (acc (List Nat))) (List Nat)
  (match ns
    (nil (cons 41 (cons 40 acc)))
    ((cons h t)
     (match h
       ((CAtom a) (em_fill_go t (+ (+ col 1) (blen a)) (+ col 2) (em a (cons 40 acc))))
       (_ acc)))))  ; not reached

;; "(head kept…" and the rest as children at col+2
(fn em_head ((hb (List Nat)) (t (List CNode)) (col Nat) (acc (List Nat))) (List Nat)
  (match (em_keep t (keep_n hb) (+ (+ col 1) (blen hb)) (em hb (cons 40 acc)))
    ((EmK _ acc2 rest)
     (match rest
       (nil (cons 41 acc2))
       (_ (em_kids (drop_lead_blanks rest) (+ col 2) col acc2))))))

;; the if cascade: a guard chain prints every else at the if's own column, the closers packing
;; at the end —
;;   (if (= c 32) true   ; space
;;   (if (= c 9) true
;;   false))
;; The shape is (if C T E), a trailing comment allowed after C and after T. When C fits the
;; head line: T rides it when T fits too, else T breaks to col+2; E renders at col — a chained
;; if broken in turn (em_chain), anything else packed there. With T on its own line a
;; non-if E goes to col+2 beside it. Any other shape is the generic break after the head.
(fn em_if_deep ((thn CNode) (ttr (Option (List Nat))) (els CNode) (col Nat) (acc (List Nat)))
  (List Nat)
  (let ((acc3 (em_trail ttr (em_pp thn (+ col 2) (sp (+ col 2) (cons 10 acc))))))
    (if (is_if els) (cons 41 (em_chain els col (sp col (cons 10 acc3))))
    (cons 41 (em_pp els (+ col 2) (sp (+ col 2) (cons 10 acc3)))))))
;; a chained if in else position breaks without the flat check; anything else is fit-or-break
(fn em_chain ((els CNode) (col Nat) (acc (List Nat))) (List Nat)
  (match els
    ((CList items)
     (match items
       (nil (em_pp els col acc))
       ((cons h t)
        (match h
          ((CAtom hb) (if (is_word hb "if") (em_if hb t col acc) (em_pp els col acc)))
          (_ (em_pp els col acc))))))
    (_ (em_pp els col acc))))
(fn em_if ((hb (List Nat)) (t (List CNode)) (col Nat) (acc (List Nat))) (List Nat)
  (match t
    (nil (em_head hb t col acc))
    ((cons cnd r1)
     (match (opt_trail r1)
       ((Trail ctr r2)
        (match r2
          (nil (em_head hb t col acc))
          ((cons thn r3)
           (match (opt_trail r3)
             ((Trail ttr r4)
              (match r4
                (nil (em_head hb t col acc))
                ((cons els r5)
                 (match r5
                   (nil
                     (match (fit (width) (+ col 4))
                       (none (em_head hb t col acc))
                       ((some b)
                        (match (flat_w cnd b)
                          (none (em_head hb t col acc))
                          ((some bc)
                           (let ((acc1 (em_flat cnd (cons 32 (cons 102 (cons 105 (cons 40 acc)))))))
                             (match ctr
                               ((some ctxt)
                                (em_if_deep thn ttr els col (em ctxt (cons 32 (cons 32 acc1)))))
                               (none
                                 (match (fit bc 1)
                                   (none (em_if_deep thn ttr els col acc1))
                                   ((some bt0)
                                    (if (fits thn bt0)
                                      (cons 41
                                        (em_chain els col
                                          (sp col
                                            (cons 10 (em_trail ttr (em_flat thn (cons 32 acc1)))))))
                                      (em_if_deep thn ttr els col acc1))))))))))))
                   (_ (em_head hb t col acc))))))))))))))
(fn em_list ((items (List CNode)) (col Nat) (acc (List Nat))) (List Nat)
  (match items
    (nil (cons 41 (cons 40 acc)))
    ((cons h t)
     (match h
       ((CAtom hb)
        (if (is_word hb "if") (em_if hb t col acc)
        (if (all_atoms items) (em_fill items col acc)
        (em_head hb t col acc))))
       (_  ; no head atom: the items align under the first
         (em_kids (drop_lead_blanks t) (+ col 1) col (em_pp h (+ col 1) (cons 40 acc))))))))
;; one node at column `col`: flat when it fits, else broken
(fn em_pp ((n CNode) (col Nat) (acc (List Nat))) (List Nat)
  (if (fits n (Nat.sub (width) col)) (em_flat n acc)
  (match n
    ((CList items) (em_list items col acc))
    ((CQuote m) (em_pp m (+ col 1) (cons 39 acc)))
    (_ (em_flat n acc)))))  ; an atom, a string or a universe list too wide: as it is

;; ---- the top level ------------------------------------------------------------------------------
(fn pp_tops ((ns (List CNode)) (acc (List Nat))) (List Nat)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons h t)
     (match h
       (CBlank (pp_tops t (cons 10 acc)))
       ((CComment txt) (pp_tops t (cons 10 (em txt acc))))
       ((CTrail txt) (pp_tops t (cons 10 (em txt acc))))  ; a trailing comment with nothing before it
       (_
         (let ((acc1 (em_pp h 0 acc)))
           (match t
             (nil (cons 10 acc1))
             ((cons h2 t2)
              (match h2
                ((CTrail txt) (pp_tops t2 (cons 10 (em txt (cons 32 (cons 32 acc1))))))
                (_ (pp_tops t (cons 10 acc1))))))))))))
;; a file's nodes as its text
(fn pp_top ((ns (List CNode))) (List Nat) (em (pp_tops ns nil) nil))
