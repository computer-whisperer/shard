;;; v3/tools/shardfmt/fmt.shard — the formatter as a function, and its one promise
;;; (LANGUAGE.md §8.7 slice 5.1 rule 2; CANON.md §3 "The gate is the contract"): print the
;;; source, then ask the reader whether the output reads as the source did, and return the
;;; output only if it does. A printer defect can cost a file its looks or get it refused; it
;;; cannot change what the file means. The printer and the reader are the two views' opaque
;;; functions, so `fmt` is a definition and the promise a statement about it.
(import "print")
(import "reads")
(use tools.shardfmt.print)
(use tools.shardfmt.reads)
(use Init.Option)

(fn fmt ((src ByteArray)) (Option ByteArray)
  (match (print src)
    (none none)
    ((some out) (if (reads_same src out) (some out) none))))
