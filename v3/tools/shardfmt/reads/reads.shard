;;; v3/tools/shardfmt/reads/reads.shard — the view's implementation: the loader's reader itself
;;; (`kernel/sexpr.shard`), called over the bytes as the toolchain holds them (a list of
;;; integers). Two texts read the same when both read and their trees print alike under
;;; the reader's own printer (`show_sexprs`: numerals by value, strings by their decoded bytes,
;;; symbols by name, a universe list in its braces) — the comparison of the parity dump. The
;;; view's two signatures are what a consumer reasons with.
(import "../../../kernel/sexpr.shard")
(import "../../../std/bytes.shard")
(use kernel.sexpr)
(use kernel.sym)
(use kernel.util)
(use std.bytes)
(use kernel.sexpr.RAll)

;; a text's bytes as the toolchain's integers, and a toolchain text back
(fn to_codes ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (List.nil List.nil)
    ((List.cons b t) (List.cons (Int.ofNat (UInt8.toNat b)) (to_codes t)))))
(fn of_codes ((cs (List Int))) (List UInt8)
  (measure (struct cs))
  (match cs
    (List.nil List.nil)
    ((List.cons c t) (List.cons (Byte.ofNat (Int.natAbs c)) (of_codes t)))))
(fn read_text ((src ByteArray)) RAll (read_all (to_codes (Bytes.toList src))))

(fn reads_same ((a ByteArray) (b ByteArray)) Bool
  (match (read_text a)
    ((RAErr _ _) Bool.false)
    ((RAOk xs)
     (match (read_text b)
       ((RAErr _ _) Bool.false)
       ((RAOk ys) (if (int_list_eq (show_sexprs xs) (show_sexprs ys)) Bool.true Bool.false))))))

(fn read_error ((src ByteArray)) (Option ByteArray)
  (match (read_text src)
    ((RAOk _) Option.none)
    ((RAErr why at)
     (Option.some
       (Bytes.ofList
         (of_codes
           (append (chars_of_sym why)
             (append (to_codes (Bytes.toList (Bytes.ofString " at byte "))) (show_int at)))))))))
