;;; v3/tools/shardfmt/reads — the reader as the formatter's judge (LANGUAGE.md §8.7 slice 5.1
;;; rule 2; CANON.md §3 "The gate is the contract"). What a file means is what the loader's own
;;; reader makes of it (`kernel/sexpr.shard` `read_all`); the formatter may never change that.
;;; This view is the whole of what the formatter knows of the reader: two functions, opaque —
;;; a theorem about the formatter holds for any reader, and the binary links this one.
(import Init UInt8.toNat)

;; both texts read, and to the same trees
(sig fn reads_same ((a ByteArray) (b ByteArray)) Bool)
;; the reader's refusal of a text — `REASON at byte N` — or none when it reads
(sig fn read_error ((src ByteArray)) (Option ByteArray))
