;;; v3/kernel/spelling.shard — the one spelling. Init states its lemmas through
;;; class methods under its instances — `HAdd.hAdd Nat Nat Nat (instHAdd Nat
;;; instAddNat) a b` — and the operator rows spell the functions — `Nat.add a
;;; b`. K's conversion proves the two one where a closed
;;; term is used; where a metavariable stands between them (the unifier under
;;; `apply`, the rewriter's matcher) and where a certificate reads a row
;;; (`arith`), the method under Init's instance is read as its function first:
;;; `sp_canon`. The instance table `sp_instance` is the other direction — an
;;; instance-implicit binder at one of the library's types takes the pin's
;;; instance constant, or a term composed of them; a class or a type the table
;;; lacks is `instance_needed` (there is no instance search). Both are fixed
;;; tables over the pin's names: no environment is consulted, and K rechecks
;;; every term they shape.

(import "kw.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.expr)
(use kernel.kw)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.level.Level)
(use kernel.name.Name)

(fn sp_c ((n Name)) Expr (mk_const n nil))
(fn sp_cast ((n Expr)) Expr (mk_app (sp_c (nm_int_of_nat)) n))
(fn sp_not ((p Expr)) Expr (mk_app (sp_c (n1 (sym "Not"))) p))
(fn sp_lit ((k Int)) Expr (mk_lit (LitNat k)))

;; ---- the method's function -------------------------------------------------------------------
;; a class method at Int or Nat under Init's instance is its function, throughout the term:
;; HAdd.hAdd Int Int Int _ a b is Int.add a b, OfNat.ofNat Int 5 _ is Int.ofNat 5, Nat.cast n is
;; Int.ofNat n, GE.ge a b is the ≤ reversed, Ne a b is Not (a = b), HAnd.hAnd Nat Nat Nat _ a b
;; is Nat.land a b (the bitwise five likewise), HAppend.hAppend (List α) … _ a b is List.append
;; a b. K's conversion proves the two one where the term is used (the instances unfold; Init's
;; are the only instances). A term with no class method in it comes
;; back as it is
(fn sp_canon ((t Expr)) Expr
  (measure (struct t))
  (match t
    ((App _ _ _) (sp_canon_app (sp_canon (get_app_fn t)) (sp_canon_list (get_app_args t) nil)))
    ((Lam _ n bi d b) (mk_lam n bi (sp_canon d) (sp_canon b)))
    ((Pi _ n bi d b) (mk_pi n bi (sp_canon d) (sp_canon b)))
    ((Let _ n ty v b) (mk_let n (sp_canon ty) (sp_canon v) (sp_canon b)))
    ((Proj _ sn i x) (mk_proj sn i (sp_canon x)))
    (_ t)))
(fn sp_canon_list ((ts (List Expr)) (acc (List Expr))) (List Expr)
  (measure (struct ts))
  (match ts
    (nil (rev acc))
    ((cons x r) (sp_canon_list r (cons (sp_canon x) acc)))))
(fn sp_carrier ((ty Expr)) (Option Symbol)
  (match ty
    ((Const _ n _)
     (if (name_eq n (nm_int_ty)) (some (sym "Int"))
     (if (name_eq n (nm_nat)) (some (sym "Nat"))
     none)))
    (_ none)))
;; `List α` with List's universe level
(fn sp_list_of ((ty Expr)) (Option (Prod (List Level) Expr))
  (match ty
    ((App _ (Const _ n ls) a) (if (name_eq n (n1 (sym "List"))) (some (Prod.mk ls a)) none))
    (_ none)))
(fn sp_canon_app ((f Expr) (args (List Expr))) Expr
  (match f
    ((Const _ n ls)
     (match (sp_class_op n)
       (none (mk_app_n f args))
       ((some (Prod.mk op k))
        (match (if (sp_inst_closed op k args) (sp_canon_op op k ls args) none)
          ((some r) r)
          (none (mk_app_n f args))))))
    (_ (mk_app_n f args))))
;; a class method: the function it names and the number of arguments before its operands
(fn sp_class_op ((n Name)) (Option (Prod Symbol Int))
  (match n
    ((Str (Str Anon c) m)
     (let ((cs (chars_of_sym c)) (ms (chars_of_sym m)))
       (if (bool_and (int_list_eq cs (utf8 "HAdd")) (int_list_eq ms (utf8 "hAdd")))
         (some (Prod.mk (sym "add") 4))
       (if (bool_and (int_list_eq cs (utf8 "HSub")) (int_list_eq ms (utf8 "hSub")))
         (some (Prod.mk (sym "sub") 4))
       (if (bool_and (int_list_eq cs (utf8 "HMul")) (int_list_eq ms (utf8 "hMul")))
         (some (Prod.mk (sym "mul") 4))
       (if (bool_and (int_list_eq cs (utf8 "HDiv")) (int_list_eq ms (utf8 "hDiv")))
         (some (Prod.mk (sym "div") 4))
       (if (bool_and (int_list_eq cs (utf8 "HMod")) (int_list_eq ms (utf8 "hMod")))
         (some (Prod.mk (sym "mod") 4))
       (if (bool_and (int_list_eq cs (utf8 "HAnd")) (int_list_eq ms (utf8 "hAnd")))
         (some (Prod.mk (sym "land") 4))
       (if (bool_and (int_list_eq cs (utf8 "HOr")) (int_list_eq ms (utf8 "hOr")))
         (some (Prod.mk (sym "lor") 4))
       (if (bool_and (int_list_eq cs (utf8 "HXor")) (int_list_eq ms (utf8 "hXor")))
         (some (Prod.mk (sym "xor") 4))
       (if (bool_and (int_list_eq cs (utf8 "HShiftLeft")) (int_list_eq ms (utf8 "hShiftLeft")))
         (some (Prod.mk (sym "shiftLeft") 4))
       (if (bool_and (int_list_eq cs (utf8 "HShiftRight")) (int_list_eq ms (utf8 "hShiftRight")))
         (some (Prod.mk (sym "shiftRight") 4))
       (if (bool_and (int_list_eq cs (utf8 "HAppend")) (int_list_eq ms (utf8 "hAppend")))
         (some (Prod.mk (sym "append") 4))
       (if (bool_and (int_list_eq cs (utf8 "HPow")) (int_list_eq ms (utf8 "hPow")))
         (some (Prod.mk (sym "pow") 4))
       (if (bool_and (int_list_eq cs (utf8 "Add")) (int_list_eq ms (utf8 "add")))
         (some (Prod.mk (sym "add") 2))
       (if (bool_and (int_list_eq cs (utf8 "Sub")) (int_list_eq ms (utf8 "sub")))
         (some (Prod.mk (sym "sub") 2))
       (if (bool_and (int_list_eq cs (utf8 "Mul")) (int_list_eq ms (utf8 "mul")))
         (some (Prod.mk (sym "mul") 2))
       (if (bool_and (int_list_eq cs (utf8 "Div")) (int_list_eq ms (utf8 "div")))
         (some (Prod.mk (sym "div") 2))
       (if (bool_and (int_list_eq cs (utf8 "Mod")) (int_list_eq ms (utf8 "mod")))
         (some (Prod.mk (sym "mod") 2))
       (if (bool_and (int_list_eq cs (utf8 "AndOp")) (int_list_eq ms (utf8 "and")))
         (some (Prod.mk (sym "land") 2))
       (if (bool_and (int_list_eq cs (utf8 "OrOp")) (int_list_eq ms (utf8 "or")))
         (some (Prod.mk (sym "lor") 2))
       (if (bool_and (int_list_eq cs (utf8 "XorOp")) (int_list_eq ms (utf8 "xor")))
         (some (Prod.mk (sym "xor") 2))
       (if (bool_and (int_list_eq cs (utf8 "ShiftLeft")) (int_list_eq ms (utf8 "shiftLeft")))
         (some (Prod.mk (sym "shiftLeft") 2))
       (if (bool_and (int_list_eq cs (utf8 "ShiftRight")) (int_list_eq ms (utf8 "shiftRight")))
         (some (Prod.mk (sym "shiftRight") 2))
       (if (bool_and (int_list_eq cs (utf8 "Append")) (int_list_eq ms (utf8 "append")))
         (some (Prod.mk (sym "append") 2))
       (if (bool_and (int_list_eq cs (utf8 "Pow")) (int_list_eq ms (utf8 "pow")))
         (some (Prod.mk (sym "pow") 2))
       (if (bool_and (int_list_eq cs (utf8 "Neg")) (int_list_eq ms (utf8 "neg")))
         (some (Prod.mk (sym "neg") 2))
       (if (bool_and (int_list_eq cs (utf8 "LE")) (int_list_eq ms (utf8 "le")))
         (some (Prod.mk (sym "le") 2))
       (if (bool_and (int_list_eq cs (utf8 "LT")) (int_list_eq ms (utf8 "lt")))
         (some (Prod.mk (sym "lt") 2))
       (if (bool_and (int_list_eq cs (utf8 "GE")) (int_list_eq ms (utf8 "ge")))
         (some (Prod.mk (sym "ge") 2))
       (if (bool_and (int_list_eq cs (utf8 "GT")) (int_list_eq ms (utf8 "gt")))
         (some (Prod.mk (sym "gt") 2))
       (if (bool_and (int_list_eq cs (utf8 "OfNat")) (int_list_eq ms (utf8 "ofNat")))
         (some (Prod.mk (sym "lit") 1))
       (if (bool_and (int_list_eq cs (utf8 "Nat")) (int_list_eq ms (utf8 "cast")))
         (some (Prod.mk (sym "cast") 2))
       (if (bool_and (int_list_eq cs (utf8 "NatCast")) (int_list_eq ms (utf8 "natCast")))
         (some (Prod.mk (sym "cast") 2))
         none))))))))))))))))))))))))))))))))))
    ((Str Anon c)
     (if (int_list_eq (chars_of_sym c) (utf8 "Ne")) (some (Prod.mk (sym "ne") 1)) none))
    (_ none)))
;; the instance a class method is applied at is Init's: a closed term — a local instance (a
;; theorem quantified over an `Add Nat`) is no arithmetic, and the method stays as written
(fn sp_inst_closed ((op Symbol) (k Int) (args (List Expr))) Bool
  (if (sym_eq op (sym "ne")) true
  (match (nth args (if (sym_eq op (sym "lit")) 2 (- k 1)))
    ((some inst) (bool_not (has_fvar inst)))
    (none false))))
(fn sp_bitwise ((op Symbol)) Bool
  (bool_or (sym_eq op (sym "land"))
    (bool_or (sym_eq op (sym "lor"))
      (bool_or (sym_eq op (sym "xor"))
        (bool_or (sym_eq op (sym "shiftLeft")) (sym_eq op (sym "shiftRight")))))))
;; `ls`: the method's own universe levels (Ne.{u} α a b is Not (Eq.{u} α a b), at any sort)
(fn sp_canon_op ((op Symbol) (k Int) (ls (List Level)) (args (List Expr))) (Option Expr)
  (match args
    (nil none)
    ((cons ty _)
     (if (sym_eq op (sym "ne"))
       (match args
         ((cons t1 (cons a (cons b nil)))
          (some (sp_not (mk_app_n (mk_const (nm_eq) ls) (list t1 a b)))))
         (_ none))
     (if (sym_eq op (sym "append"))
       (match (sp_list_of ty)
         (none none)
         ((some (Prod.mk lls el))
          (match (drop k args)
            ((cons a (cons b nil))
             (some (mk_app_n (mk_const (n2 (sym "List") (sym "append")) lls) (list el a b))))
            (_ none))))
       (match (sp_carrier ty)
         (none none)
         ((some car)
          (match (drop k args)
            ((cons a (cons b nil))
             (if (sym_eq op (sym "lit"))
               (if (is_lit a) (some (if (sym_eq car (sym "Int")) (sp_cast a) a)) none)
             (if (sym_eq op (sym "add")) (some (sp_car2 car (sym "add") a b))
             (if (sym_eq op (sym "sub")) (some (sp_car2 car (sym "sub") a b))
             (if (sym_eq op (sym "mul")) (some (sp_car2 car (sym "mul") a b))
             (if (sym_eq op (sym "div"))
               (some (sp_car2 car (if (sym_eq car (sym "Int")) (sym "ediv") (sym "div")) a b))
             (if (sym_eq op (sym "mod"))
               (some (sp_car2 car (if (sym_eq car (sym "Int")) (sym "emod") (sym "mod")) a b))
             (if (sym_eq op (sym "le")) (some (sp_car2 car (sym "le") a b))
             (if (sym_eq op (sym "lt")) (some (sp_car2 car (sym "lt") a b))
             (if (sym_eq op (sym "ge")) (some (sp_car2 car (sym "le") b a))
             (if (sym_eq op (sym "gt")) (some (sp_car2 car (sym "lt") b a))
             (if (bool_and (sp_bitwise op) (sym_eq car (sym "Nat"))) (some (sp_car2 car op a b))
             (if (bool_and (sym_eq op (sym "pow")) (sym_eq car (sym "Nat")))
               (some (sp_car2 car (sym "pow") a b))  ; `2 ^ k` is Nat.pow 2 k
               none)))))))))))))
            ((cons a nil)
             (if (bool_and (sym_eq op (sym "neg")) (sym_eq car (sym "Int")))
               (some (mk_app (sp_c (n2 (sym "Int") (sym "neg"))) a))
             (if (bool_and (sym_eq op (sym "cast")) (sym_eq car (sym "Int"))) (some (sp_cast a))
             none)))
            (_ none)))))))))
(fn sp_car2 ((car Symbol) (op Symbol) (a Expr) (b Expr)) Expr
  (mk_app_n (mk_const (n2 car op) nil) (list a b)))

;; ---- the instance table ----------------------------------------------------------------------
;; the term for an instance-implicit binder's type, closed and at one of the library's types:
;; the pin's instance constant (`Add Nat` is instAddNat), or a composition the table spells
;; (`HAdd α α α` is instHAdd over the table's `Add α`, `BEq α` is instBEqOfDecidableEq over
;; its `DecidableEq α`, `Zero Int` is Zero.ofOfNat0 over instOfNat 0, `Append (List α)` is
;; List.instAppend); None where the table has no row — the refusal instance_needed, with the
;; pointer to `@` and the instance written
(fn sp_instance ((ty Expr)) (Option Expr) (sp_instance_go ty 8))
(fn sp_instance_go ((ty Expr) (fuel Int)) (Option Expr)
  (measure fuel)
  (if (< fuel 1) none
  (match (get_app_fn ty)
    ((Const _ cls ls)
     (match cls
       ((Str Anon c)
        (match (get_app_args ty)
          ((cons car nil) (sp_inst1 (chars_of_sym c) ls car fuel))
          ((cons car (cons n nil))
           (if (int_list_eq (chars_of_sym c) (utf8 "OfNat")) (sp_inst_ofnat car n) none))
          ((cons a (cons b (cons d nil)))
           (if (bool_and (expr_eq a b) (expr_eq b d)) (sp_inst_h (chars_of_sym c) ls a fuel) none))
          (_ none)))
       (_ none)))
    (_ none))))
(fn sp_inst1 ((cls (List Int)) (ls (List Level)) (car Expr) (fuel Int)) (Option Expr)
  (match (sp_inst_typed cls ls car fuel)
    ((some v) (some v))
    (none (sp_inst_any cls ls car fuel))))
;; the type's own rows; None falls through to sp_inst_any (the Int rows hold no `BEq Int`)
(fn sp_inst_typed ((cls (List Int)) (ls (List Level)) (car Expr) (fuel Int)) (Option Expr)
  (match (sp_carrier car)
    ((some c) (if (sym_eq c (sym "Nat")) (sp_inst_nat cls car) (sp_inst_int cls car)))
    (none
      (if (is_const_named car (n1 (sym "Bool"))) (sp_inst_bool cls)
      (match (sp_list_of car)
        ((some (Prod.mk lls a)) (sp_inst_list cls lls a fuel))
        (none none))))))
(fn sp_zero ((car Expr) (ofnat Expr)) Expr
  (mk_app_n (mk_const (n2 (sym "Zero") (sym "ofOfNat0")) (list LZero)) (list car ofnat)))
(fn sp_inst_nat ((cls (List Int)) (car Expr)) (Option Expr)
  (if (int_list_eq cls (utf8 "Add")) (some (sp_c (n1 (sym "instAddNat"))))
  (if (int_list_eq cls (utf8 "Sub")) (some (sp_c (n1 (sym "instSubNat"))))
  (if (int_list_eq cls (utf8 "Mul")) (some (sp_c (n1 (sym "instMulNat"))))
  (if (int_list_eq cls (utf8 "Div")) (some (sp_c (n2 (sym "Nat") (sym "instDiv"))))
  (if (int_list_eq cls (utf8 "Mod")) (some (sp_c (n2 (sym "Nat") (sym "instMod"))))
  (if (int_list_eq cls (utf8 "LT")) (some (sp_c (n1 (sym "instLTNat"))))
  (if (int_list_eq cls (utf8 "LE")) (some (sp_c (n1 (sym "instLENat"))))
  (if (int_list_eq cls (utf8 "Min")) (some (sp_c (n1 (sym "instMinNat"))))
  (if (int_list_eq cls (utf8 "Max")) (some (sp_c (n2 (sym "Nat") (sym "instMax"))))
  (if (int_list_eq cls (utf8 "DecidableEq")) (some (sp_c (n1 (sym "instDecidableEqNat"))))
  (if (int_list_eq cls (utf8 "AndOp")) (some (sp_c (n2 (sym "Nat") (sym "instAndOp"))))
  (if (int_list_eq cls (utf8 "OrOp")) (some (sp_c (n2 (sym "Nat") (sym "instOrOp"))))
  (if (int_list_eq cls (utf8 "XorOp")) (some (sp_c (n2 (sym "Nat") (sym "instXorOp"))))
  (if (int_list_eq cls (utf8 "ShiftLeft")) (some (sp_c (n2 (sym "Nat") (sym "instShiftLeft"))))
  (if (int_list_eq cls (utf8 "ShiftRight")) (some (sp_c (n2 (sym "Nat") (sym "instShiftRight"))))
  (if (int_list_eq cls (utf8 "Zero"))
    (some (sp_zero car (mk_app (sp_c (n1 (sym "instOfNatNat"))) (sp_lit 0))))
    none)))))))))))))))))
(fn sp_inst_int ((cls (List Int)) (car Expr)) (Option Expr)
  (if (int_list_eq cls (utf8 "Add")) (some (sp_c (n2 (sym "Int") (sym "instAdd"))))
  (if (int_list_eq cls (utf8 "Sub")) (some (sp_c (n2 (sym "Int") (sym "instSub"))))
  (if (int_list_eq cls (utf8 "Mul")) (some (sp_c (n2 (sym "Int") (sym "instMul"))))
  (if (int_list_eq cls (utf8 "Div")) (some (sp_c (n2 (sym "Int") (sym "instDiv"))))
  (if (int_list_eq cls (utf8 "Mod")) (some (sp_c (n2 (sym "Int") (sym "instMod"))))
  (if (int_list_eq cls (utf8 "Neg")) (some (sp_c (n2 (sym "Int") (sym "instNegInt"))))
  (if (int_list_eq cls (utf8 "LT")) (some (sp_c (n2 (sym "Int") (sym "instLTInt"))))
  (if (int_list_eq cls (utf8 "LE")) (some (sp_c (n2 (sym "Int") (sym "instLEInt"))))
  (if (int_list_eq cls (utf8 "Min")) (some (sp_c (n2 (sym "Int") (sym "instMin"))))
  (if (int_list_eq cls (utf8 "Max")) (some (sp_c (n2 (sym "Int") (sym "instMax"))))
  (if (int_list_eq cls (utf8 "DecidableEq")) (some (sp_c (n2 (sym "Int") (sym "instDecidableEq"))))
  (if (int_list_eq cls (utf8 "Zero"))
    (some (sp_zero car (mk_app (sp_c (n1 (sym "instOfNat"))) (sp_lit 0))))
    none)))))))))))))
(fn sp_inst_bool ((cls (List Int))) (Option Expr)
  (if (int_list_eq cls (utf8 "DecidableEq")) (some (sp_c (n1 (sym "instDecidableEqBool")))) none))
;; `List α`: Append is List.instAppend; DecidableEq is instDecidableEqList over the element's
(fn sp_inst_list ((cls (List Int)) (lls (List Level)) (a Expr) (fuel Int)) (Option Expr)
  (if (int_list_eq cls (utf8 "Append"))
    (some (mk_app (mk_const (n2 (sym "List") (sym "instAppend")) lls) a))
  (if (int_list_eq cls (utf8 "DecidableEq"))
    (match
      (sp_instance_go (mk_app (mk_const (n1 (sym "DecidableEq")) (list (LSucc (sp_level1 lls)))) a)
        (- fuel 1))
      ((some d) (some (mk_app_n (mk_const (n1 (sym "instDecidableEqList")) lls) (list a d))))
      (none none))
    (sp_inst_any cls (list (LSucc (sp_level1 lls))) (mk_app (mk_const (n1 (sym "List")) lls) a) fuel))))
(fn sp_level1 ((ls (List Level))) Level
  (match ls
    ((cons l _) l)
    (nil LZero)))
;; at any type: BEq from its decidable equality
(fn sp_inst_any ((cls (List Int)) (ls (List Level)) (car Expr) (fuel Int)) (Option Expr)
  (if (int_list_eq cls (utf8 "BEq"))
    (match (sp_instance_go (mk_app (mk_const (n1 (sym "DecidableEq")) ls) car) (- fuel 1))
      ((some d) (some (mk_app_n (mk_const (n1 (sym "instBEqOfDecidableEq")) ls) (list car d))))
      (none none))
    none))
;; the heterogeneous classes at one type: the homogeneous instance lifted
(fn sp_inst_h ((cls (List Int)) (ls (List Level)) (a Expr) (fuel Int)) (Option Expr)
  (match (sp_h_row cls)
    (none none)
    ((some (Prod.mk lift base))
     (let ((u (List Level) (list (sp_level1 ls))))
       (match (sp_instance_go (mk_app (mk_const (n1 base) u) a) (- fuel 1))
         ((some d) (some (mk_app_n (mk_const (n1 lift) u) (list a d))))
         (none none))))))
(fn sp_h_row ((cls (List Int))) (Option (Prod Symbol Symbol))
  (if (int_list_eq cls (utf8 "HAdd")) (some (Prod.mk (sym "instHAdd") (sym "Add")))
  (if (int_list_eq cls (utf8 "HSub")) (some (Prod.mk (sym "instHSub") (sym "Sub")))
  (if (int_list_eq cls (utf8 "HMul")) (some (Prod.mk (sym "instHMul") (sym "Mul")))
  (if (int_list_eq cls (utf8 "HDiv")) (some (Prod.mk (sym "instHDiv") (sym "Div")))
  (if (int_list_eq cls (utf8 "HMod")) (some (Prod.mk (sym "instHMod") (sym "Mod")))
  (if (int_list_eq cls (utf8 "HAnd")) (some (Prod.mk (sym "instHAndOfAndOp") (sym "AndOp")))
  (if (int_list_eq cls (utf8 "HOr")) (some (Prod.mk (sym "instHOrOfOrOp") (sym "OrOp")))
  (if (int_list_eq cls (utf8 "HXor")) (some (Prod.mk (sym "instHXorOfXorOp") (sym "XorOp")))
  (if (int_list_eq cls (utf8 "HShiftLeft"))
    (some (Prod.mk (sym "instHShiftLeftOfShiftLeft") (sym "ShiftLeft")))
  (if (int_list_eq cls (utf8 "HShiftRight"))
    (some (Prod.mk (sym "instHShiftRightOfShiftRight") (sym "ShiftRight")))
  (if (int_list_eq cls (utf8 "HAppend")) (some (Prod.mk (sym "instHAppendOfAppend") (sym "Append")))
  none))))))))))))
;; a numeral's instance: OfNat Nat n is instOfNatNat n, OfNat Int n is instOfNat n
(fn sp_inst_ofnat ((car Expr) (n Expr)) (Option Expr)
  (match (sp_carrier car)
    ((some c)
     (some (mk_app (sp_c (n1 (if (sym_eq c (sym "Nat")) (sym "instOfNatNat") (sym "instOfNat")))) n)))
    (none none)))

;; ---- the kit ---------------------------------------------------------------------------------
;; every constant the two tables can write, for the loader's demand (loader.shard init_kit):
;; an instance the table spells and the operator rows' Min.min, Max.max and
;; Int.ediv are no token of the file that needs them. Each is fetched for every module
(fn sp_kit () (List Name)
  (list (n1 (sym "instAddNat")) (n1 (sym "instSubNat")) (n1 (sym "instMulNat"))
    (n2 (sym "Nat") (sym "instDiv"))
    (n2 (sym "Nat") (sym "instMod"))
    (n1 (sym "instLTNat"))
    (n1 (sym "instLENat"))
    (n1 (sym "instMinNat"))
    (n2 (sym "Nat") (sym "instMax"))
    (n1 (sym "instDecidableEqNat"))
    (n2 (sym "Nat") (sym "instAndOp"))
    (n2 (sym "Nat") (sym "instOrOp"))
    (n2 (sym "Nat") (sym "instXorOp"))
    (n2 (sym "Nat") (sym "instShiftLeft"))
    (n2 (sym "Nat") (sym "instShiftRight"))
    (n1 (sym "instOfNatNat"))
    (n1 (sym "instOfNat"))
    (n2 (sym "Zero") (sym "ofOfNat0"))
    (n2 (sym "Int") (sym "instAdd"))
