;;; v3/kernel/load.shard — the loader's driver:
;;;   eval direct v3/kernel/load.shard --root DIR [--init CHUNK]… [--route N] [--engine S] FILE…
;;;   eval direct v3/kernel/load.shard --root DIR [--init CHUNK]… [--fuel N] --run MODULE.FN FILE… [-- ARG…]
;;; loads each FILE (under DIR, spelled from the same base) as a module with
;;; its imports (loader.shard) and prints the records (LANGUAGE.md §3.2) —
;;; one line per module, Init load and declaration — then the counts; the
;;; exit code is refused + errors. `--init` names the export chunks in
;;; order (v3/README.md's pin; `(import Init NAME)` streams them through
;;; NAME); `--route`/`--engine` stamp the header line with the route the
;;; driver runs on (3 the bootstrap, 1 compiled K) and the engine.
;;; `--run` (§6.7): after a clean load, the program the load yielded is run
;;; from MODULE.FN on the World with ARG… as its arguments, its externs
;;; performed (ev.shard's run_prog); nothing is printed but the program's
;;; own output. A load failure prints the records and exits 2 before any
;;; run; out of fuel exits 3, stuck 4, a link failure 5; the program's own
;;; `exit` is the host's.

(import "loader.shard")
(import "ev.shard")

(type Args (Args (List Int) (List (List Int)) (List Int) (List Int) (List (List Int)) (Option Name) Int (List (List Int))))   ; root, chunks, route, engine, files, the entry to run, fuel, the program's arguments
(fn parse_args ((args (List (List Int))) (a Args)) Args
  (measure (struct args))
  (match a
    ((Args root chunks route engine files run fuel argv)
     (match args
       (Nil (Args root (rev chunks) route engine (rev files) run fuel argv))
       ((Cons x r)
        (if (int_list_eq x "--") (Args root (rev chunks) route engine (rev files) run fuel r)
        (if (int_list_eq x "--root") (match r ((Cons v r2) (parse_args r2 (Args v chunks route engine files run fuel argv))) (Nil (parse_args Nil a)))
        (if (int_list_eq x "--init") (match r ((Cons v r2) (parse_args r2 (Args root (Cons v chunks) route engine files run fuel argv))) (Nil (parse_args Nil a)))
        (if (int_list_eq x "--route") (match r ((Cons v r2) (parse_args r2 (Args root chunks v engine files run fuel argv))) (Nil (parse_args Nil a)))
        (if (int_list_eq x "--engine") (match r ((Cons v r2) (parse_args r2 (Args root chunks route v files run fuel argv))) (Nil (parse_args Nil a)))
        (if (int_list_eq x "--run") (match r ((Cons v r2) (parse_args r2 (Args root chunks route engine files (name_of_sym (sym_of_chars v)) fuel argv))) (Nil (parse_args Nil a)))
        (if (int_list_eq x "--fuel") (match r ((Cons v r2) (parse_args r2 (Args root chunks route engine files run (digits_val v 0) argv))) (Nil (parse_args Nil a)))
          (parse_args r (Args root chunks route engine (Cons x files) run fuel argv))))))))))))))
(fn default_fuel () Int 1000000000000)

(fn load_files ((l Load) (files (List (List Int))) (w World)) (Pair Load World)
  (measure (struct files))
  (match files
    (Nil (Pair l w))
    ((Cons f r) (match (load_root_file l f w) ((Pair l1 w1) (load_files l1 r w1))))))

(fn print_recs ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs (Nil w) ((Cons x r) (print_recs r (write_line (show_rec x) w)))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match (parse_args args (Args Nil Nil "3" "bootstrap" Nil None (default_fuel) Nil))
       ((Args root chunks route engine files run fuel argv)
        (match (parts_of root)
          (None (exit 2 (write_line "load: --root DIR is required" w1)))
          ((Some rootp)
           (if (int_eq (len rootp) 0)
             (exit 2 (write_line "load: --root DIR is required" w1))
             (match run
               (None (main_records rootp chunks route engine files w1))
               ((Some entry) (main_run rootp chunks files entry argv fuel w1)))))))))))
;; the records and the counts; the exit code is refused + errors
(fn main_records ((rootp (List (List Int))) (chunks (List (List Int))) (route (List Int)) (engine (List Int)) (files (List (List Int))) (w World)) World
  (match (load_files (load0 rootp chunks) files (write_line (append "LOAD root=" (append (join_path rootp) (append " route=" (append route (append " engine=" engine))))) w))
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (exit (load_failures cs) (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))))))
;; a clean load, then the program run from the entry; a failed load prints its records and exits 2
(fn main_run ((rootp (List (List Int))) (chunks (List (List Int))) (files (List (List Int))) (entry Name) (argv (List (List Int))) (fuel Int) (w World)) World
  (match (load_files (load0 rootp chunks) files w)
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (lt 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (match (run_prog (es_prog (ld_e l)) entry argv fuel w2)
           ((Pair RunOk w3) w3)
           ((Pair (RunOut n) w3) (exit 3 (write_line (append "RUN: out of fuel in " (show_name n)) w3)))
           ((Pair (RunStuck r n) w3) (exit 4 (write_line (append "RUN: stuck " (append (chars_of_sym r) (append " in " (show_name n)))) w3)))
           ((Pair (RunLink e m) w3) (exit 5 (write_line (append "RUN: link " (append (chars_of_sym e) (append ": " m))) w3)))))))))
