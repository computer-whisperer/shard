;;; v3/kernel/load.shard — the loader's driver:
;;;   eval direct v3/kernel/load.shard COMMON FILE…
;;;   eval direct v3/kernel/load.shard COMMON --dump FILE…
;;;   eval direct v3/kernel/load.shard COMMON --emit DIR FILE…
;;;   eval direct v3/kernel/load.shard COMMON --run MODULE.FN [--fuel N] [--trace FILE]
;;;     [--lowered] FILE… [-- ARG…]
;;;   COMMON = --root DIR [--init EXPORT --init-index INDEX] [--instance-budget N] [--state]
;;;            [--facts OUT]
;;; loads each FILE (under DIR, spelled from the same base) as a module with
;;; its imports (loader.shard) and prints the records (docs/LANGUAGE.md "What
;;; the loader prints") — one line per module and declaration —
;;; then the counts; the exit code is refused + errors. `--dump` wins over
;;; `--emit`, which wins over `--run`.
;;; `--init` names the pinned export in one file and `--init-index` its index
;;; (kernel/test/init_index.sh): every module sees the export's declarations,
;;; and the ones it needs are loaded from the export on demand. A load given
;;; none loads no file (`init_unavailable`).
;;; `--state`: each function that takes or returns the checker's state is
;;; judged as well (STATE records).
;;; `--run`: after a clean load, the program the load yielded is run
;;; from MODULE.FN on the World with ARG… as its arguments, its externs
;;; performed (run.shard's run_load); nothing is printed but the program's
;;; own output. ARG… are the checked entry's: validated
;;; against the entry's parameters before the World — Int, Nat, a byte list
;;; — before ev runs; a malformed one is refused by position and text
;;; (`RUN: argument N REASON: TEXT`), never by a file span. A load failure
;;; prints the records and exits 2 before any run; out of fuel exits 3,
;;; stuck 4, a link failure 5, a refused argument 6; the program's own
;;; `exit` is the host's. `--fuel N` is the run's fuel (default_fuel unless
;;; given); `--trace FILE` writes the run's effect trace to FILE.
;;; `--instance-budget N`: the instances of one template
;;; this load may build, 1,024 unless given; past it a demand is refused
;;; `specialization_budget`, naming the template.
;;; `--dump`: after a clean load, the program the load yielded is
;;; printed as dump.shard's canonical text — the V3 side of frontend parity
;;; (kernel/test/parity_test.sh) — and nothing else; a load failure prints the
;;; records and exits as above.
;;; `--facts OUT`: a clean load — printing its records, or under `--dump` its program — also
;;; writes to OUT the facts the plain reading takes from K about the constants of Init the
;;; closure's files cite (facts.shard), one line each: what the Rust bootstrap reads an
;;; ordinary closure by (`eval dump --root DIR --facts OUT …`).
;;; `--lowered` with `--run`: the program's restricted form (lower.shard) is run in its place —
;;; the same output or the lowering is wrong.
;;; `--emit DIR`: after a clean load, the
;;; program the load yielded is lowered and written under DIR as the C text of its binary
;;; (emit.shard: lower.shard, then cgen.shard) — DIR/main.c and its parts, DIR/map (each
;;; declaration against its identity and source) and DIR/sources (each module's source file
;;; and hash); `EMIT: DIR entry=FILE modules=N declarations=M` names the file `cc` compiles.
;;; What the back end cannot take is refused (`EMIT: …`, exit 2) and nothing is written.

(import "loader.shard")
(import "ev.shard")
(import "dump.shard")
(import "facts.shard")
(import "emit.shard")
(import "lower.shard")
(import "run.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.dump)
(use kernel.emit)
(use kernel.emit.EmitRes)
(use kernel.etable)
(use kernel.facts)
(use kernel.ev)
(use kernel.host)
(use kernel.loader)
(use kernel.loader.Cited)
(use kernel.lower)
(use kernel.lower.LwRes)
(use kernel.name)
(use kernel.name.Name)
(use kernel.scope)
(use kernel.run)
(use kernel.sexpr)
(use kernel.util)
(use kernel.ev.RunRes)
(use kernel.host.World)
(use kernel.loader.ModPath)
(use kernel.loader.Rec)

(record Args (root (List Int)) (export (List Int)) (index (List Int)) (files (List (List Int)))
  (run (Option Name))
  (fuel Int)
  (argv (List (List Int)))  ; the program's arguments
  (dump Bool)
  (facts (List Int))  ; the file the facts are written to
  (budget Int)  ; the instance budget
  (emit (List Int))  ; the emit directory
  (trace (List Int))  ; the trace file
  (state Bool)  ; the state check
  (lowered Bool)  ; the lowered run
  (both Bool))  ; the two readings' comparison
(fn parse_args ((args (List (List Int))) (a Args)) Args
  (measure (struct args))
  (match args
    (nil (with Args a (files (rev (Args.files a)))))
    ((cons x r)
     (if (int_list_eq x "--") (with Args a (files (rev (Args.files a))) (argv r))
     (if (int_list_eq x "--state") (parse_args r (with Args a (state true)))
     (if (int_list_eq x "--both") (parse_args r (with Args a (both true)))
     (if (int_list_eq x "--dump") (parse_args r (with Args a (dump true)))
     (if (int_list_eq x "--lowered") (parse_args r (with Args a (lowered true)))
     (if (valued_flag x)
       (match r
         ((cons v r2) (parse_args r2 (flag_value a x v)))
         (nil (parse_args nil a)))
       (parse_args r (with Args a (files (cons x (Args.files a))))))))))))))
;; the flags that take the argument after them
(fn valued_flag ((x (List Int))) Bool
  (bool_or (int_list_eq x "--root")
    (bool_or (int_list_eq x "--init")
      (bool_or (int_list_eq x "--init-index")
        (bool_or (int_list_eq x "--run")
          (bool_or (int_list_eq x "--fuel")
            (bool_or (int_list_eq x "--emit")
              (bool_or (int_list_eq x "--instance-budget")
                (bool_or (int_list_eq x "--trace") (int_list_eq x "--facts"))))))))))
(fn flag_value ((a Args) (x (List Int)) (v (List Int))) Args
  (if (int_list_eq x "--root") (with Args a (root v))
  (if (int_list_eq x "--init") (with Args a (export v))
  (if (int_list_eq x "--init-index") (with Args a (index v))
  (if (int_list_eq x "--run") (with Args a (run (name_of_sym (sym_of_chars v))))
  (if (int_list_eq x "--fuel") (with Args a (fuel (digits_val v 0)))
  (if (int_list_eq x "--emit") (with Args a (emit v))
  (if (int_list_eq x "--instance-budget") (with Args a (budget (digits_val v 0)))
  (if (int_list_eq x "--facts") (with Args a (facts v))
  (with Args a (trace v)))))))))))

(fn load_files ((l Load) (files (List (List Int))) (w World)) (Prod Load World)
  (measure (struct files))
  (match files
    (nil (Prod.mk l w))
    ((cons f r)
     (match (load_root_file l f w)
       ((Prod.mk l1 w1) (load_files l1 r w1))))))

(fn print_recs ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs
    (nil w)
    ((cons x r) (print_recs r (write_line (show_rec x) w)))))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (let
       ((a
          (parse_args args
            (make Args (root nil) (export nil) (index nil) (files nil) (run none)
              (fuel (default_fuel))
              (argv nil)
              (dump false)
              (facts nil)
              (budget (instance_budget))
              (emit nil)
              (trace nil)
              (state false)
              (lowered false)
              (both false)))))
       (match (parts_of (Args.root a))
         (none (exit 2 (write_line "load: --root DIR is required" w1)))
         ((some rootp)
          (if (= (len rootp) 0) (exit 2 (write_line "load: --root DIR is required" w1))
          (let
            ((l0
               (load_flags a
                 (ld_with_budget (ld_start rootp (Args.export a) (Args.index a)) (Args.budget a)))))
            (if (Args.dump a) (main_dump l0 (Args.files a) (Args.facts a) w1)
            (if (< 0 (len (Args.emit a))) (main_emit l0 (Args.files a) (Args.emit a) w1)
            (match (Args.run a)
              (none (main_records l0 (Args.files a) (Args.facts a) w1))
              ((some entry)
               (main_run l0 (Args.files a) entry (Args.argv a) (Args.fuel a) (Args.trace a)
                 (Args.lowered a)
                 w1)))))))))))))
;; the load under the driver's --state and --both
(fn load_flags ((a Args) (l Load)) Load
  (let ((l1 (if (Args.state a) (ld_with_states l) l))) (if (Args.both a) (ld_with_both l1) l1)))

;; a clean load, then the canonical text of the program it yielded
(fn main_dump ((l0 Load) (files (List (List Int))) (facts (List Int)) (w World)) World
  (match (load_files l0 files w)
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (print_lines (dump_prog (Load.etab l) (es_prog (Load.etab l))) (write_facts l facts w2)))))))
;; under --facts FILE: what the plain reading asks K about the constants of Init the closure's
;; files cite (facts.shard), written to FILE — the table the Rust bootstrap reads an ordinary
;; closure by
(fn write_facts ((l Load) (file (List Int)) (w World)) World
  (if (= (len file) 0) w
  (match (write_file file (join_lines (facts_of (ld_cited l) nil)) w)
    ((Prod.mk true w1) w1)
    ((Prod.mk false w1) (exit 2 (write_line (append "FACTS: cannot write " file) w1))))))
(fn facts_of ((cs (List Cited)) (acc (List (List Int)))) (List (List Int))
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons (Cited es env names) r) (facts_of r (facts_join acc (facts_lines es env names))))))
(fn print_lines ((ls (List (List Int))) (w World)) World
  (measure (struct ls))
  (match ls
    (nil w)
    ((cons x r) (print_lines r (write_line x w)))))
;; a clean load, then the closure's C text written under DIR
(fn main_emit ((l0 Load) (files (List (List Int))) (dir (List Int)) (w World)) World
  (match (load_files l0 files w)
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (match
           (emit_prog (Load.etab l) (es_prog (Load.etab l)) (root_module l0 files)
             (module_files (ld_recs l)))
           ((EmitFail msg) (exit 2 (write_line (append "EMIT: " msg) w2)))
           ((EmitOk fs mp entry nmod)
            (match
              (write_under dir
                (append fs
                  (list (Prod.mk "map" (join_lines mp))
                    (Prod.mk "sources" (join_lines (source_lines (ld_recs l))))))
                w2)
              ((Prod.mk (some p) w3) (exit 2 (write_line (append "EMIT: cannot write " p) w3)))
              ((Prod.mk none w3)
               (write_line
                 (append "EMIT: "
                   (append dir
                     (append " entry="
                       (append entry
                         (append " modules="
                           (append (show_nat nmod) (append " declarations=" (show_nat (len mp)))))))))
                 w3))))))))))
;; the first file's module: the root whose `main` the binary starts from
(fn root_module ((l Load) (files (List (List Int)))) Name
  (match files
    (nil Anon)
    ((cons f _)
     (match (parts_of f)
       (none Anon)
       ((some parts)
        (match (strip_parts (Load.root l) parts)
          (none Anon)
          ((some rel)
           (match (module_of rel)
             ((MPOk mp) mp)
             (_ Anon)))))))))
;; each loaded module's source file, from the MODULE records
(fn module_files ((rs (List Rec))) (List (Prod Name (List Int)))
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (RModule m file _ _) r) (cons (Prod.mk m file) (module_files r)))
    ((cons _ r) (module_files r))))
(fn source_lines ((rs (List Rec))) (List (List Int))
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (RModule m file h _) r)
     (cons (append (show_name m) (append " " (append file (append " " (show_nat h)))))
       (source_lines r)))
    ((cons _ r) (source_lines r))))
(fn join_lines ((ls (List (List Int)))) (List Int)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons x r) (append x (cons 10 (join_lines r))))))
;; every file written under DIR; the first path that cannot be written
(fn write_under ((dir (List Int)) (fs (List (Prod (List Int) (List Int)))) (w World))
  (Prod (Option (List Int)) World)
  (measure (struct fs))
  (match fs
    (nil (Prod.mk none w))
    ((cons (Prod.mk name text) r)
     (let ((path (append dir (cons 47 name))))
       (match (write_file path text w)
         ((Prod.mk true w2) (write_under dir r w2))
         ((Prod.mk false w2) (Prod.mk (some path) w2)))))))
;; the records and the counts; the exit code is refused + errors; a clean load's facts under
;; --facts
(fn main_records ((l0 Load) (files (List (List Int))) (facts (List Int)) (w World)) World
  (match (load_files l0 files (write_line (append "LOAD root=" (join_path (Load.root l0))) w))
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (exit (load_failures cs)
         (write_line (append "LOAD: " (show_counts_load cs))
           (print_recs (ld_recs l) (if (< 0 (load_failures cs)) w2 (write_facts l facts w2)))))))))
;; the program the load yielded, or under --lowered its restricted form (lower.shard) in its place:
;; the lowering's own gate — the two runs print the same (kernel/test/lower_test.sh)
(fn run_as
  ((l Load)
   (low Bool)
   (entry Name)
   (argv (List (List Int)))
   (fuel Int)
   (trace (List Int))
   (w World))
  (Prod RunRes World)
  (if low
    (match (lw_prog (es_prog (Load.etab l)))
      ((LwRefused errs)
       (Prod.mk
         (RunLink (quote lowering)
           (match errs
             ((cons m _) m)
             (nil "refused")))
         w))
      ((LwProg rs) (run_load_as l rs entry argv fuel trace w)))
    (run_load l entry argv fuel trace w)))
;; a clean load, then the program run from the entry; a failed load prints its records and exits 2;
;; `--trace FILE` writes the run's effect trace. The run is run.shard's door on this load
;; (run_load): ev.shard's checked entry, and what the load's environment shows of the entry that
;; its program does not state — an evidence binder, a proposition field — refused `RUN: link
;; preconditioned`
(fn main_run
  ((l0 Load)
   (files (List (List Int)))
   (entry Name)
   (argv (List (List Int)))
   (fuel Int)
   (trace (List Int))
   (low Bool)
   (w World))
  World
  (match (load_files l0 files w)
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (match (run_as l low entry argv fuel trace w2)
           ((Prod.mk RunOk w3) w3)
           ((Prod.mk (RunOut n) w3)
            (exit 3 (write_line (append "RUN: out of fuel in " (show_name n)) w3)))
           ((Prod.mk (RunExhausted r n) w3)
            (exit 3
              (write_line
                (append "RUN: exhausted " (append (chars_of_sym r) (append " in " (show_name n))))
                w3)))
           ((Prod.mk (RunStuck r n) w3)
            (exit 4
              (write_line
                (append "RUN: stuck " (append (chars_of_sym r) (append " in " (show_name n))))
                w3)))
           ((Prod.mk (RunLink e m) w3)
            (exit 5 (write_line (append "RUN: link " (append (chars_of_sym e) (append ": " m))) w3)))
           ((Prod.mk (RunArg i r txt) w3)
            (exit 6
              (write_line
                (append "RUN: argument "
                  (append (show_nat i) (append " " (append (chars_of_sym r) (append ": " txt)))))
                w3)))))))))
