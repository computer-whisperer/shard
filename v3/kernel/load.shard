;;; v3/kernel/load.shard — the loader's driver:
;;;   eval direct v3/kernel/load.shard COMMON FILE…
;;;   eval direct v3/kernel/load.shard COMMON --dump FILE…
;;;   eval direct v3/kernel/load.shard COMMON --emit DIR FILE…
;;;   eval direct v3/kernel/load.shard COMMON --run MODULE.FN [--fuel N] [--trace FILE]
;;;     [--lowered] FILE… [-- ARG…]
;;;   COMMON = --root DIR [--init EXPORT --init-index INDEX] [--instance-budget N] [--state]
;;; loads each FILE (under DIR, spelled from the same base) as a module with
;;; its imports (loader.shard) and prints the records (docs/LANGUAGE.md "What
;;; the loader prints") — one line per module, Init load and declaration —
;;; then the counts; the exit code is refused + errors. `--dump` wins over
;;; `--emit`, which wins over `--run`.
;;; `--init` names the pinned export in one file and `--init-index` its index
;;; (kernel/test/init_index.sh): `(import Init NAME)` sets a module's horizon
;;; just past NAME's ordinal and the declarations it cites are loaded from the
;;; export on demand.
;;; `--state`: each function that takes or returns the checker's state is
;;; judged as well (STATE records).
;;; `--run`: after a clean load, the program the load yielded is run
;;; from MODULE.FN on the World with ARG… as its arguments, its externs
;;; performed (run.shard's run_load); nothing is printed but the program's
;;; own output. ARG… are the checked entry's: validated
;;; against the entry's parameters before the World — Int, Nat, a byte list
;;; — before ev runs; a malformed one is refused by position and text
;;; (`RUN: argument N REASON: TEXT`), never by a file span. A load failure
;;; prints the records and exits 2 before any run; out of fuel exits 3,
;;; stuck 4, a link failure 5, a refused argument 6; the program's own
;;; `exit` is the host's. `--fuel N` is the run's fuel (default_fuel unless
;;; given); `--trace FILE` writes the run's effect trace to FILE.
;;; `--instance-budget N`: the instances of one template
;;; this load may build, 1,024 unless given; past it a demand is refused
;;; `specialization_budget`, naming the template.
;;; `--dump`: after a clean load, the program the load yielded is
;;; printed as dump.shard's canonical text — the V3 side of frontend parity
;;; (kernel/test/parity_test.sh) — and nothing else; a load failure prints the
;;; records and exits as above.
;;; `--lowered` with `--run`: the program's restricted form (lower.shard) is run in its place —
;;; the same output or the lowering is wrong.
;;; `--emit DIR`: after a clean load, the
;;; program the load yielded is lowered and written under DIR as the C text of its binary
;;; (emit.shard: lower.shard, then cgen.shard) — DIR/main.c and its parts, DIR/map (each
;;; declaration against its identity and source) and DIR/sources (each module's source file
;;; and hash); `EMIT: DIR entry=FILE modules=N declarations=M` names the file `cc` compiles.
;;; What the back end cannot take is refused (`EMIT: …`, exit 2) and nothing is written.

(import "loader.shard")
(import "ev.shard")
(import "dump.shard")
(import "emit.shard")
(import "lower.shard")
(import "run.shard")
(use kernel.dump)
(use kernel.emit)
(use kernel.emit.EmitRes)
(use kernel.etable)
(use kernel.ev)
(use kernel.host)
(use kernel.loader)
(use kernel.lower)
(use kernel.lower.LwRes)
(use kernel.name)
(use kernel.name.Name)
(use kernel.prelude)
(use kernel.scope)
(use kernel.run)
(use kernel.sexpr)
(use kernel.util)
(use kernel.ev.RunRes)
(use kernel.host.World)
(use kernel.loader.ModPath)
(use kernel.loader.Rec)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

(type Args
  (Args (List Int) (List Int) (List Int) (List (List Int)) (Option Name) Int (List (List Int)) Bool
    Int
    (List Int)
    (List Int)
    Bool
    Bool))  ; root, the export, its index, files, the entry to run, fuel, the program's arguments, dump, the instance budget, the emit directory, the trace file, the state check, the lowered run
(fn parse_args ((args (List (List Int))) (a Args)) Args
  (measure (struct args))
  (match a
    ((Args root export index files run fuel argv dump budget emit trace stc low)
     (match args
       (Nil (Args root export index (rev files) run fuel argv dump budget emit trace stc low))
       ((Cons x r)
        (if (int_list_eq x "--")
          (Args root export index (rev files) run fuel r dump budget emit trace stc low)
        (if (int_list_eq x "--root")
          (match r
            ((Cons v r2)
             (parse_args r2 (Args v export index files run fuel argv dump budget emit trace stc low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--init")
          (match r
            ((Cons v r2)
             (parse_args r2 (Args root v index files run fuel argv dump budget emit trace stc low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--init-index")
          (match r
            ((Cons v r2)
             (parse_args r2 (Args root export v files run fuel argv dump budget emit trace stc low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--run")
          (match r
            ((Cons v r2)
             (parse_args r2
               (Args root export index files (name_of_sym (sym_of_chars v)) fuel argv dump budget
                 emit
                 trace
                 stc
                 low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--fuel")
          (match r
            ((Cons v r2)
             (parse_args r2
               (Args root export index files run (digits_val v 0) argv dump budget emit trace stc
                 low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--state")
          (parse_args r (Args root export index files run fuel argv dump budget emit trace True low))
        (if (int_list_eq x "--dump")
          (parse_args r (Args root export index files run fuel argv True budget emit trace stc low))
        (if (int_list_eq x "--lowered")
          (parse_args r (Args root export index files run fuel argv dump budget emit trace stc True))
        (if (int_list_eq x "--emit")
          (match r
            ((Cons v r2)
             (parse_args r2 (Args root export index files run fuel argv dump budget v trace stc low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--instance-budget")
          (match r
            ((Cons v r2)
             (parse_args r2
               (Args root export index files run fuel argv dump (digits_val v 0) emit trace stc low)))
            (Nil (parse_args Nil a)))
        (if (int_list_eq x "--trace")
          (match r
            ((Cons v r2)
             (parse_args r2 (Args root export index files run fuel argv dump budget emit v stc low)))
            (Nil (parse_args Nil a)))
          (parse_args r
            (Args root export index (Cons x files) run fuel argv dump budget emit trace stc low)))))))))))))))))))

(fn load_files ((l Load) (files (List (List Int))) (w World)) (Pair Load World)
  (measure (struct files))
  (match files
    (Nil (Pair l w))
    ((Cons f r)
     (match (load_root_file l f w)
       ((Pair l1 w1) (load_files l1 r w1))))))

(fn print_recs ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs
    (Nil w)
    ((Cons x r) (print_recs r (write_line (show_rec x) w)))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match
       (parse_args args
         (Args Nil Nil Nil Nil None (default_fuel) Nil False (instance_budget) Nil Nil False False))
       ((Args root export index files run fuel argv dump budget emit trace stc low)
        (match (parts_of root)
          (None (exit 2 (write_line "load: --root DIR is required" w1)))
          ((Some rootp)
           (if (= (len rootp) 0) (exit 2 (write_line "load: --root DIR is required" w1))
           (let
             ((l0
                (if stc (ld_with_states (ld_with_budget (ld_start rootp export index) budget))
                (ld_with_budget (ld_start rootp export index) budget))))
             (if dump (main_dump l0 files w1)
             (if (< 0 (len emit)) (main_emit l0 files emit w1)
             (match run
               (None (main_records l0 files w1))
               ((Some entry) (main_run l0 files entry argv fuel trace low w1))))))))))))))

;; a clean load, then the canonical text of the program it yielded
(fn main_dump ((l0 Load) (files (List (List Int))) (w World)) World
  (match (load_files l0 files w)
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (print_lines (dump_prog (Load.etab l) (es_prog (Load.etab l))) w2))))))
(fn print_lines ((ls (List (List Int))) (w World)) World
  (measure (struct ls))
  (match ls
    (Nil w)
    ((Cons x r) (print_lines r (write_line x w)))))
;; a clean load, then the closure's C text written under DIR
(fn main_emit ((l0 Load) (files (List (List Int))) (dir (List Int)) (w World)) World
  (match (load_files l0 files w)
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (match
           (emit_prog (Load.etab l) (es_prog (Load.etab l)) (root_module l0 files)
             (module_files (ld_recs l)))
           ((EmitFail msg) (exit 2 (write_line (append "EMIT: " msg) w2)))
           ((EmitOk fs mp entry nmod)
            (match
              (write_under dir
                (append fs
                  (list (Pair "map" (join_lines mp))
                    (Pair "sources" (join_lines (source_lines (ld_recs l))))))
                w2)
              ((Pair (Some p) w3) (exit 2 (write_line (append "EMIT: cannot write " p) w3)))
              ((Pair None w3)
               (write_line
                 (append "EMIT: "
                   (append dir
                     (append " entry="
                       (append entry
                         (append " modules="
                           (append (show_nat nmod) (append " declarations=" (show_nat (len mp)))))))))
                 w3))))))))))
;; the first file's module: the root whose `main` the binary starts from
(fn root_module ((l Load) (files (List (List Int)))) Name
  (match files
    (Nil Anon)
    ((Cons f _)
     (match (parts_of f)
       (None Anon)
       ((Some parts)
        (match (strip_parts (Load.root l) parts)
          (None Anon)
          ((Some rel)
           (match (module_of rel)
             ((MPOk mp) mp)
             (_ Anon)))))))))
;; each loaded module's source file, from the MODULE records
(fn module_files ((rs (List Rec))) (List (Pair Name (List Int)))
  (measure (struct rs))
  (match rs
    (Nil Nil)
    ((Cons (RModule m file _ _) r) (Cons (Pair m file) (module_files r)))
    ((Cons _ r) (module_files r))))
(fn source_lines ((rs (List Rec))) (List (List Int))
  (measure (struct rs))
  (match rs
    (Nil Nil)
    ((Cons (RModule m file h _) r)
     (Cons (append (show_name m) (append " " (append file (append " " (show_nat h)))))
       (source_lines r)))
    ((Cons _ r) (source_lines r))))
(fn join_lines ((ls (List (List Int)))) (List Int)
  (measure (struct ls))
  (match ls
    (Nil Nil)
    ((Cons x r) (append x (Cons 10 (join_lines r))))))
;; every file written under DIR; the first path that cannot be written
(fn write_under ((dir (List Int)) (fs (List (Pair (List Int) (List Int)))) (w World))
  (Pair (Option (List Int)) World)
  (measure (struct fs))
  (match fs
    (Nil (Pair None w))
    ((Cons (Pair name text) r)
     (let ((path (append dir (Cons 47 name))))
       (match (write_file path text w)
         ((Pair True w2) (write_under dir r w2))
         ((Pair False w2) (Pair (Some path) w2)))))))
;; the records and the counts; the exit code is refused + errors
(fn main_records ((l0 Load) (files (List (List Int))) (w World)) World
  (match (load_files l0 files (write_line (append "LOAD root=" (join_path (Load.root l0))) w))
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (exit (load_failures cs)
         (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))))))
;; the program the load yielded, or under --lowered its restricted form (lower.shard) in its place:
;; the lowering's own gate — the two runs print the same (kernel/test/lower_test.sh)
(fn run_as
  ((l Load)
   (low Bool)
   (entry Name)
   (argv (List (List Int)))
   (fuel Int)
   (trace (List Int))
   (w World))
  (Pair RunRes World)
  (if low
    (match (lw_prog (es_prog (Load.etab l)))
      ((LwRefused errs)
       (Pair
         (RunLink (quote lowering)
           (match errs
             ((Cons m _) m)
             (Nil "refused")))
         w))
      ((LwProg rs) (run_load_as l rs entry argv fuel trace w)))
    (run_load l entry argv fuel trace w)))
;; a clean load, then the program run from the entry; a failed load prints its records and exits 2;
;; `--trace FILE` writes the run's effect trace. The run is run.shard's door on this load
;; (run_load): ev.shard's checked entry, and what the load's environment shows of the entry that
;; its program does not state — an evidence binder, a proposition field — refused `RUN: link
;; preconditioned`
(fn main_run
  ((l0 Load)
   (files (List (List Int)))
   (entry Name)
   (argv (List (List Int)))
   (fuel Int)
   (trace (List Int))
   (low Bool)
   (w World))
  World
  (match (load_files l0 files w)
    ((Pair l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (if (< 0 (load_failures cs))
         (exit 2 (write_line (append "LOAD: " (show_counts_load cs)) (print_recs (ld_recs l) w2)))
         (match (run_as l low entry argv fuel trace w2)
           ((Pair RunOk w3) w3)
           ((Pair (RunOut n) w3)
            (exit 3 (write_line (append "RUN: out of fuel in " (show_name n)) w3)))
           ((Pair (RunExhausted r n) w3)
            (exit 3
              (write_line
                (append "RUN: exhausted " (append (chars_of_sym r) (append " in " (show_name n))))
                w3)))
           ((Pair (RunStuck r n) w3)
            (exit 4
              (write_line
                (append "RUN: stuck " (append (chars_of_sym r) (append " in " (show_name n))))
                w3)))
           ((Pair (RunLink e m) w3)
            (exit 5 (write_line (append "RUN: link " (append (chars_of_sym e) (append ": " m))) w3)))
           ((Pair (RunArg i r txt) w3)
            (exit 6
              (write_line
                (append "RUN: argument "
                  (append (show_nat i) (append " " (append (chars_of_sym r) (append ": " txt)))))
                w3)))))))))
