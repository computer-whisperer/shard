;;; v3/kernel/dump.shard — a Prog as the canonical text of reader parity:
;;; one line per declaration, the lines sorted bytewise, so that the V3
;;; loader's Prog over a closure
;;; and the bootstrap's reading of the same files (`eval dump FILE`,
;;; rust_bootstrap/src/plain/out.rs) compare byte for byte
;;; (kernel/test/parity_test.sh, plain_test.sh). `load.shard --dump FILE` prints it.
;;;
;;;   type NAME n (CTOR T…)…        n type parameters; a name its last component, a constructor
;;;                                 its type's and its own (Prod.mk, Tok.TPlus)
;;;   fn NAME n (T…) T BODY         n = the distinct type variables of the signature,
;;;   extern NAME n (T…) T            numbered ?i by first occurrence across the binders then the result
;;;   T   ::= Int | NAME | (NAME T…) | ?i
;;;   E   ::= #i | INT | (NAME E…)                   a constructor (TYPE.CTOR), a call, an extern,
;;;         | (match E (PAT E)…) | (let (E…) E) | (if E E E)   a primitive (its full spelling)
;;;   PAT ::= _ | NAME | (NAME PAT…) | INT
;;; A string and a `(list …)` are the constructor chains both loaders build;
;;; `#i` is the sequential index (the bootstrap's dump converts its parallel
;;; `let`); the measure clause is outside the text.
;;;
;;; The text is a PROJECTION of the Prog:
;;; a name prints as its last component, a constructor under its type's, and a call and an
;;; extern print alike, so two dumps agreeing byte for byte is evidence of
;;; agreement exactly where the projection is injective — parity_test.sh
;;; checks every closure for one declaration per short name among the heads
;;; (fn, extern, sig), among the types and among the constructors, and no
;;; constructor named like a head, and fails a closure that is not. Outside
;;; the text by design: the measure clause (a runtime-only comparison —
;;; recursion obligations are the definer's) and a literal's kind (LNat and LInt
;;; print alike; the bootstrap has one integer type and the profile's
;;; literals are Int in both loaders). Nothing reads this text back.

(import "prog.shard")
(import "etable.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.name.Name)
(use kernel.etable)
(use kernel.etable.ESt)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.Prog)

(fn dump_prog ((es ESt) (p Prog)) (List (List Int))
  (match p
    ((Prog ds) (dm_sort (dm_decls es ds)))))
(fn dm_decls ((es ESt) (ds (List EDecl))) (List (List Int))
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r) (cons (dm_decl es d) (dm_decls es r)))))

(fn dm_decl ((es ESt) (d EDecl)) (List Int)
  (match d
    ((EInd n np ctors)
     (append (utf8 "type ")
       (append (dm_short n) (append (utf8 " ") (append (show_int np) (dm_ctors ctors))))))
    ((EFn n _ ps rt _ body)
     (let ((sig (dm_sig ps rt)))
       (append (utf8 "fn ")
         (append (dm_head es n)
           (append (utf8 " ") (append sig (append (utf8 " ") (dm_term es body))))))))
    ((EExtern n _ ps rt)
     (append (utf8 "extern ") (append (dm_head es n) (append (utf8 " ") (dm_sig ps rt)))))
    ((ESig n _ ps rt)
     (append (utf8 "sig ") (append (dm_head es n) (append (utf8 " ") (dm_sig ps rt)))))
    ((ESigType n k)
     (append (utf8 "sigtype ") (append (dm_short n) (append (utf8 " ") (show_int k)))))))
;; a head prints as its identity beyond the module it was declared in — the declared
;; spelling: `hex_val`, or `Load.env` for a record's accessor — the components
;; past the longest prefix the identity shares with the module tag (a sealed file's identity
;; prefix is the directory's, above its own tag)
(fn dm_head ((es ESt) (n Name)) (List Int)
  (match (es_module es n)
    (none (dm_short n))
    ((some m) (dm_join (dm_drop_common (dm_comps m) (dm_comps n))))))
(fn dm_comps ((n Name)) (List (List Int))
  (measure (struct n))
  (match n
    (Anon nil)
    ((Str p s) (append (dm_comps p) (list (chars_of_sym s))))
    ((Num p k) (append (dm_comps p) (list (show_int k))))))
(fn dm_drop_common ((m (List (List Int))) (n (List (List Int)))) (List (List Int))
  (measure (struct m))
  (match m
    (nil n)
    ((cons x r)
     (match n
       ((cons y s) (if (int_list_eq x y) (dm_drop_common r s) n))
       (nil nil)))))
(fn dm_join ((cs (List (List Int)))) (List Int)
  (measure (struct cs))
  (match cs
    (nil (utf8 "anon"))
    ((cons c nil) c)
    ((cons c r) (append c (append (utf8 ".") (dm_join r))))))
(fn dm_ctors ((cs (List ECtorDef))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (ECtorDef c fs) r)
     (append (utf8 " (")
       (append (dm_ctor c) (append (dm_types fs nil) (append (utf8 ")") (dm_ctors r))))))))
;; the signature: `n (T…) T` with the type variables renumbered by first occurrence
(fn dm_sig ((ps (List EType)) (rt EType)) (List Int)
  (let ((order (dm_vars_of rt (dm_vars_all ps nil))))
    (append (show_int (len order))
      (append (utf8 " (")
        (append (dm_types_sp ps order true) (append (utf8 ") ") (dm_type rt order)))))))
;; type variables in order of first occurrence
(fn dm_vars_all ((ts (List EType)) (acc (List Int))) (List Int)
  (measure (List_EType.size ts))
  (match ts
    (nil acc)
    ((cons t r) (dm_vars_all r (dm_vars_of t acc)))))
(fn dm_vars_of ((t EType) (acc (List Int))) (List Int)
  (measure (EType.size t))
  (match t
    ((ETVar i) (if (mem_int i acc) acc (append acc (list i))))
    ((ETCon _ args) (dm_vars_all args acc))))
(fulfills dm_vars_all.dec_1 (by (intro ts acc t r h) (rw h) (rw List_EType.size.eq_2) (arith)))
(fulfills dm_vars_all.dec_2 (by (intro ts acc t r h) (rw h) (rw List_EType.size.eq_2) (arith)))
(fulfills dm_vars_of.dec_1 (by (intro t acc w args h) (rw h) (rw EType.size.eq_1) (arith)))
(fn dm_type ((t EType) (order (List Int))) (List Int)
  (measure (EType.size t))
  (match t
    ((ETVar i) (append (utf8 "?") (show_int (dm_index i order 0))))
    ((ETCon n nil) (dm_short n))
    ((ETCon n args)
     (append (utf8 "(") (append (dm_short n) (append (dm_types args order) (utf8 ")")))))))
(fn dm_index ((i Int) (order (List Int)) (k Int)) Int
  (measure (struct order))
  (match order
    (nil i)
    ((cons x r) (if (= x i) k (dm_index i r (+ k 1))))))
;; " T T …" (each preceded by a space), and the same without the leading space
(fn dm_types ((ts (List EType)) (order (List Int))) (List Int)
  (measure (List_EType.size ts))
  (match ts
    (nil nil)
    ((cons t r) (append (utf8 " ") (append (dm_type t order) (dm_types r order))))))
(fn dm_types_sp ((ts (List EType)) (order (List Int)) (first Bool)) (List Int)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r)
     (append (if first nil (utf8 " ")) (append (dm_type t order) (dm_types_sp r order false))))))

(fn dm_term ((es ESt) (t ETerm)) (List Int)
  (measure (* 2 (ETerm.size t)))
  (match t
    ((EBVar i) (append (utf8 "#") (show_int i)))
    ((ELit l) (dm_lit l))
    ((ECtor n args) (dm_app es (dm_ctor n) args))
    ((ECall n args) (dm_app es (dm_head es n) args))
    ((EPrim n args) (dm_app es (show_name n) args))
    ((EExt n args) (dm_app es (dm_head es n) args))
    ((EMatch s arms)
     (append (utf8 "(match ") (append (dm_term es s) (append (dm_arms es arms) (utf8 ")")))))
    ((ELet rs body)
     (append (utf8 "(let (")
       (append (dm_terms_sp es rs true) (append (utf8 ") ") (append (dm_term es body) (utf8 ")"))))))
    ((EIf c a b)
     (append (utf8 "(if ")
       (append (dm_term es c)
         (append (utf8 " ")
           (append (dm_term es a) (append (utf8 " ") (append (dm_term es b) (utf8 ")"))))))))
    ((ELam ts _ b)
     (append (utf8 "(fun (")
       (append (dm_types_sp ts nil true) (append (utf8 ") ") (append (dm_term es b) (utf8 ")"))))))
    (EAbsurd (utf8 "(absurd)"))))
(fn dm_app ((es ESt) (head (List Int)) (args (List ETerm))) (List Int)
  (measure (+ (* 2 (List_ETerm.size args)) 1))
  (append (utf8 "(") (append head (append (dm_terms es args) (utf8 ")")))))
(fn dm_terms ((es ESt) (ts (List ETerm))) (List Int)
  (measure (* 2 (List_ETerm.size ts)))
  (match ts
    (nil nil)
    ((cons t r) (append (utf8 " ") (append (dm_term es t) (dm_terms es r))))))
(fn dm_terms_sp ((es ESt) (ts (List ETerm)) (first Bool)) (List Int)
  (measure (* 2 (List_ETerm.size ts)))
  (match ts
    (nil nil)
    ((cons t r) (append (if first nil (utf8 " ")) (append (dm_term es t) (dm_terms_sp es r false))))))
(fn dm_arms ((es ESt) (arms (List EArm))) (List Int)
  (measure (* 2 (List_EArm.size arms)))
  (match arms
    (nil nil)
    ((cons (EArm p b) r)
     (append (utf8 " (")
       (append (dm_pat p)
         (append (utf8 " ") (append (dm_term es b) (append (utf8 ")") (dm_arms es r)))))))))
(fn dm_pat ((p EPat)) (List Int)
  (measure (EPat.size p))
  (match p
    (PVar (utf8 "_"))
    ((PCtor n nil) (dm_ctor n))
    ((PCtor n subs) (append (utf8 "(") (append (dm_ctor n) (append (dm_pats subs) (utf8 ")")))))
    ((PLit l) (dm_lit l))))
(fn dm_pats ((ps (List EPat))) (List Int)
  (measure (List_EPat.size ps))
  (match ps
    (nil nil)
    ((cons p r) (append (utf8 " ") (append (dm_pat p) (dm_pats r))))))
;; a literal: a string is the chain of Init's List cells over its bytes
(fn dm_lit ((l ELit)) (List Int)
  (match l
    ((LNat k) (show_int k))
    ((LInt k) (show_int k))
    ((LStr bs) (dm_bytes (dm_ctor (cell_nil)) (dm_ctor (cell_cons)) bs))))
(fn dm_bytes ((nl (List Int)) (cs (List Int)) (bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (nil (append (utf8 "(") (append nl (utf8 ")"))))
    ((cons b r)
     (append (utf8 "(")
       (append cs
         (append (utf8 " ")
           (append (show_int b) (append (utf8 " ") (append (dm_bytes nl cs r) (utf8 ")"))))))))))

(fn dm_short ((n Name)) (List Int)
  (match n
    ((Str _ s) (chars_of_sym s))
    ((Num _ k) (show_int k))
    (Anon (utf8 "anon"))))
;; a constructor: its type's last component and its own — Init has several named `mk`
(fn dm_ctor ((n Name)) (List Int)
  (match n
    ((Str Anon _) (dm_short n))
    ((Str p _) (append (dm_short p) (append (utf8 ".") (dm_short n))))
    (_ (dm_short n))))
;; the descents of the walkers above that print through `dm_short` and `dm_ctor`
(fulfills dm_type.dec_1 (by (intro t order n args h) (rw h) (rw EType.size.eq_1) (arith)))
(fulfills dm_types.dec_1 (by (intro ts order t r h) (rw h) (rw List_EType.size.eq_2) (arith)))
(fulfills dm_types.dec_2 (by (intro ts order t r h) (rw h) (rw List_EType.size.eq_2) (arith)))
(fulfills dm_pat.dec_1 (by (intro p n subs h) (rw h) (rw EPat.size.eq_2) (arith)))
(fulfills dm_pats.dec_1 (by (intro ps p r h) (rw h) (rw List_EPat.size.eq_2) (arith)))
(fulfills dm_pats.dec_2 (by (intro ps p r h) (rw h) (rw List_EPat.size.eq_2) (arith)))
;; `dm_app` hands its arguments on whole to `dm_terms`, paid by the 1 in its measure
(fulfills dm_term.dec_1 (by (intro es t n args h) (rw h) (rw ETerm.size.eq_3) (arith)))
(fulfills dm_term.dec_2 (by (intro es t n args h) (rw h) (rw ETerm.size.eq_4) (arith)))
(fulfills dm_term.dec_3 (by (intro es t n args h) (rw h) (rw ETerm.size.eq_5) (arith)))
(fulfills dm_term.dec_4 (by (intro es t n args h) (rw h) (rw ETerm.size.eq_6) (arith)))
(fulfills dm_term.dec_5 (by (intro es t s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills dm_term.dec_6 (by (intro es t s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills dm_term.dec_7 (by (intro es t rs body h) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills dm_term.dec_8 (by (intro es t rs body h) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills dm_term.dec_9 (by (intro es t c a b h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills dm_term.dec_10 (by (intro es t c a b h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills dm_term.dec_11 (by (intro es t c a b h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills dm_term.dec_12 (by (intro es t ts w b h) (rw h) (rw ETerm.size.eq_10) (arith)))
(fulfills dm_app.dec_1 (by (intro es head args) (arith)))
(fulfills dm_terms.dec_1 (by (intro es ts t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills dm_terms.dec_2 (by (intro es ts t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills dm_terms_sp.dec_1 (by (intro es ts first t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills dm_terms_sp.dec_2 (by (intro es ts first t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills dm_arms.dec_1
  (by (intro es arms p b r h) (rw h) (rw List_EArm.size.eq_2) (rw EArm.size.eq_1) (arith)))
(fulfills dm_arms.dec_2 (by (intro es arms p b r h) (rw h) (rw List_EArm.size.eq_2) (arith)))

;; bytewise sort (merge)
(fn dm_sort ((xs (List (List Int)))) (List (List Int))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x nil) (list x))
    (_
      (match (dm_split xs nil nil)
        ((Prod.mk a b) (dm_merge (dm_sort a) (dm_sort b)))))))
(fn dm_split ((xs (List (List Int))) (a (List (List Int))) (b (List (List Int))))
  (Prod (List (List Int)) (List (List Int)))
  (measure (struct xs))
  (match xs
    (nil (Prod.mk a b))
    ((cons x nil) (Prod.mk (cons x a) b))
    ((cons x (cons y r)) (dm_split r (cons x a) (cons y b)))))
(fn dm_merge ((a (List (List Int))) (b (List (List Int)))) (List (List Int))
  (measure (+ (List.length a) (List.length b)))
  (match a
    (nil b)
    ((cons x ar)
     (match b
       (nil a)
       ((cons y br) (if (int_list_lt y x) (cons y (dm_merge a br)) (cons x (dm_merge ar b))))))))
(fulfills dm_merge.dec_1 (by (intro p x ar ha y br hb h) (rw ha) (rw List.length_cons) (arith)))
(fulfills dm_merge.dec_2 (by (intro p x ar ha y br hb h) (rw hb) (rw List.length_cons) (arith)))
