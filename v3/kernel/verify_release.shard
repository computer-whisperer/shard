;;; v3/kernel/verify_release.shard — the release gate (LANGUAGE.md §8.4 slice 3.22
;;; rule 7; law §7.5): `eval direct v3/kernel/verify_release.shard [-v] DIR EXPORT INDEX`
;;; K replays the store DIR holds (store.shard: DIR/order lists `ID NAME` in
;;; admission order, DIR/ID.ndjson the declaration's records) after the closure of
;;; the pinned Init EXPORT the store cites, read through its INDEX (slice 3.26:
;;; every constant the store's records cite by name, their records' closure walked
;;; by range reads and checked — never admitted — in export order), with no
;;; elaborator loaded — this file imports K, the host, the JSON reader and the
;;; walk alone: the T0 machinery over a second stream. A stored declaration
;;; bearing a name the export declares is refused (`TAKEN`: Init's names are
;;; Init's, slice 3.25 rule 2). Every non-ACCEPT verdict prints (ACCEPT too with
;;; -v), then `INIT: counts` after the closure and `RELEASE: declarations N
;;; accepted A rejected … malformed X  mistied Y  missing Z  taken T` for the
;;; store — mistied: a declaration accepted under a name or with a content
;;; fingerprint other than its order line's (a dropped name record lands a theorem
;;; under a shorter name: the import reads a missing table index as anonymous);
;;; each file is its own stream, fresh tables over the environment so far, as it
;;; was written. The exit code is the declarations not accepted + malformed +
;;; mistied + missing + taken + the closure's failures.

(import "host.shard")
(import "json.shard")
(import "k")
(import "initload.shard")
(use kernel.k)
(use kernel.host)
(use kernel.initload)
(use kernel.initload.OdLoad)
(use kernel.initload.OdOpen)
(use kernel.json)
(use kernel.prelude)
(use kernel.util)
(use kernel.host.World)
(use kernel.json.JRes)
(use kernel.name)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.verdict.Verdict)

;; the records of one stream, each through K: the run, the malformed count and the
;; mistied count — a declaration accepted under a name other than WANT's (empty: any
;; name) or with a content fingerprint other than FP (0: any), which a dropped name
;; record produces (the import reads a missing table index as anonymous) and which
;; ties a replayed constant to the build's ACCEPT record (identity_hash is the
;; report's fingerprint, never an authority: K's acceptance is the gate's guarantee,
;; the tie says the bundle is the build's)
(type VL (VL Run Int Int))
(fn vr_lines ((v VL) (bs0 (List Int)) (verbose Bool) (want (List Int)) (fp Int) (w World)) (Pair VL World)
  (measure (struct bs0))
  (let ((bs (skip_ws bs0)))
    (match bs
      (Nil (Pair v w))
      (_
       (match v
         ((VL r bad wrong)
          (match (json_parse bs)
            (JErr (Pair (VL r (+ bad 1) wrong) (write_line "MALFORMED json (stream)" w)))
            ((JRes j rest)
             (match (process_record r j)
               ((Pair r1 vd)
                (match vd
                  ((VMalformed k) (vr_lines (VL r1 (+ bad 1) wrong) rest verbose want fp (write_line (append "MALFORMED " k) w)))
                  ((VAccept n)
                   (if (bool_and (bool_or (int_eq (len want) 0) (int_list_eq want (show_name n)))
                                 (bool_or (int_eq fp 0) (vr_fp_is (run_env r1) n fp)))
                     (vr_lines (VL r1 bad wrong) rest verbose want fp (if verbose (write_line (append "ACCEPT " (show_name n)) w) w))
                     (vr_lines (VL r1 bad (+ wrong 1)) rest verbose want fp
                       (write_line (append "MISTIED " (append want (append " accepted as " (append (show_name n) (append " fp=" (vr_fp_text (run_env r1) n)))))) w))))
                  (VSkip (vr_lines (VL r1 bad wrong) rest verbose want fp w))
                  (_ (vr_lines (VL r1 bad wrong) rest verbose want fp (match (show_verdict vd) ((Some x) (write_line x w)) (None w)))))))))))))))
(fn vr_fp_is ((env CheckedEnv) (n Name) (fp Int)) Bool
  (match (identity_hash env n) ((Some h) (int_eq h fp)) (None False)))
(fn vr_fp_text ((env CheckedEnv) (n Name)) (List Int)
  (match (identity_hash env n) ((Some h) (show_nat h)) (None "none")))

;; the store's demand on Init (slice 3.26 rule 3, the gate's side): every constant its
;; files' expression lines cite by name, and every stored name that the export declares
;; (taken); the files are read once here and again through K
(type VD (VD OdIx (List Int) (List (List Int)) Int))   ; the handle, the ordinals demanded, the names taken, the files missing
(fn vr_demand ((x OdIx) (dir (List Int)) (order (List Int)) (ords (List Int)) (taken (List (List Int))) (missing Int) (w World)) (Pair VD World)
  (measure (struct order))
  (match order
    (Nil (Pair (VD x ords taken missing) w))
    (_
     (match (take_line order Nil)
       ((Pair ln rest)
        (match (vr_id ln)
          (Nil (vr_demand x dir rest ords taken missing w))
          (fid
           (match (read_file (append dir (Cons 47 (append fid ".ndjson"))) w)
             ((Pair None w1) (vr_demand x dir rest ords taken (+ missing 1) w1))
             ((Pair (Some bs) w1)
              (match (vr_resolve x (od_consts_of_stream bs) ords w1)
                ((Pair (Pair x1 ords1) w2)
                 (match (vr_taken x1 (vr_name ln) w2)
                   ((Pair (Pair x2 tk) w3) (vr_demand x2 dir rest ords1 (append tk taken) missing w3))))))))))))))
(fn vr_resolve ((x OdIx) (ns (List Name)) (acc (List Int)) (w World)) (Pair (Pair OdIx (List Int)) World)
  (measure (struct ns))
  (match ns
    (Nil (Pair (Pair x acc) w))
    ((Cons n r)
     (match (od_lookup x n w)
       ((Pair (Pair x1 (Some o)) w1) (vr_resolve x1 r (Cons o acc) w1))
       ((Pair (Pair x1 None) w1) (vr_resolve x1 r acc w1))))))
;; an order line's name, when the export declares it (the name table is keyed by the rendering)
(fn vr_taken ((x OdIx) (nm (List Int)) (w World)) (Pair (Pair OdIx (List (List Int))) World)
  (match (od_lookup_text x nm w)
    ((Pair (Pair x1 (Some _)) w1) (Pair (Pair x1 (list nm)) w1))
    ((Pair (Pair x1 None) w1) (Pair (Pair x1 Nil) w1))))
(fn vr_print_taken ((ts (List (List Int))) (w World)) World
  (measure (struct ts))
  (match ts (Nil w) ((Cons t r) (vr_print_taken r (write_line (append "TAKEN " (append t " is a declaration of the export")) w)))))

;; the store's declarations in order, each file its own stream over the environment
;; so far — fresh tables, as a file is written (store.shard): a record a file lacks is
;; malformed there, never read from an earlier file's table. The state: the
;; environment, K's five counts summed, declarations, malformed, mistied, missing.
(type VR (VR CheckedEnv (List Int) Int Int Int Int))
(fn vr_store ((v VR) (dir (List Int)) (order (List Int)) (verbose Bool) (w World)) (Pair VR World)
  (measure (struct order))
  (match order
    (Nil (Pair v w))
    (_
     (match (take_line order Nil)
       ((Pair ln rest)
        (match (vr_id ln)
          (Nil (vr_store v dir rest verbose w))
          (fid
           (match v
             ((VR env counts n bad wrong missing)
              (match (read_file (append dir (Cons 47 (append fid ".ndjson"))) w)
                ((Pair None w1) (vr_store (VR env counts (+ n 1) bad wrong (+ missing 1)) dir rest verbose (write_line (append "MISSING " ln) w1)))
                ((Pair (Some bs) w1)
                 (match (vr_lines (VL (run_with_env (empty_run False False) env (st_for env)) 0 0) bs verbose (vr_name ln) (vr_digits fid 0) w1)
                   ((Pair (VL r1 bad1 wrong1) w2)
                    (vr_store (VR (run_env r1) (vr_sum counts (run_counts r1)) (+ n 1) (+ bad bad1) (+ wrong wrong1) missing) dir rest verbose w2))))))))))))))
;; an order line's name: what follows the first space
(fn vr_name ((ln (List Int))) (List Int)
  (measure (struct ln))
  (match ln (Nil Nil) ((Cons 32 r) r) ((Cons _ r) (vr_name r))))
;; an id's fingerprint: its leading digits (FP, or FP-K past a collision)
(fn vr_digits ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs
    ((Cons c r) (if (bool_and (le 48 c) (le c 57)) (vr_digits r (+ (* acc 10) (- c 48))) acc))
    (Nil acc)))
(fn vr_sum ((a (List Int)) (b (List Int))) (List Int)
  (measure (struct a))
  (match a
    (Nil Nil)
    ((Cons x r) (match b ((Cons y r2) (Cons (+ x y) (vr_sum r r2))) (Nil (Cons x (vr_sum r Nil)))))))
(fn vr_id ((ln (List Int))) (List Int)
  (measure (struct ln))
  (match ln (Nil Nil) ((Cons 32 _) Nil) ((Cons c r) (Cons c (vr_id r)))))

(fn vr_failures ((r Run)) Int (match (run_counts r) ((Cons _ (Cons b (Cons c (Cons d _)))) (+ b (+ c d))) (_ 0)))

(fn vr_args ((args (List (List Int))) (verbose Bool)) (Pair Bool (List (List Int)))
  (measure (struct args))
  (match args
    ((Cons x r) (if (int_list_eq x "-v") (vr_args r True) (Pair verbose args)))
    (Nil (Pair verbose Nil))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match (vr_args args False)
       ((Pair verbose (Cons dir (Cons export (Cons index Nil))))
        (match (od_open export index w1)
          ((Pair (OdOpenErr e m) w2) (exit 2 (write_line (append "verify_release: " (append export (append ": " (append (chars_of_sym e) (append ": " m))))) w2)))
          ((Pair (OdOpened x) w2)
           (match (read_file (append dir "/order") w2)
             ((Pair None w3) (exit 2 (write_line (append "verify_release: cannot read " (append dir "/order")) w3)))
             ((Pair (Some order) w3)
              (match (vr_demand x dir order Nil Nil 0 w3)
                ((Pair (VD x1 ords taken _) w4)
                 (match (od_load x1 (empty_run False False) (odd0) ords w4)
                   ((Pair (OdLoadErr _ e m) w5) (exit 2 (write_line (append "INIT: " (append (chars_of_sym e) (append ": " m))) w5)))
                   ((Pair (OdLoaded _ r0 _ _ _ _) w5)
                    (let ((w6 (vr_print_taken taken (write_line (append "INIT: " (show_counts r0)) w5))))
                      (match (vr_store (VR (run_env r0) (list 0 0 0 0 0) 0 0 0 0) dir order verbose w6)
                        ((Pair (VR _ counts n bad wrong missing) w7)
                         (let ((accepted (nth_int counts 0)))
                           (exit (+ (- n accepted) (+ bad (+ wrong (+ missing (+ (len taken) (vr_failures r0))))))
                             (write_line (append "RELEASE: declarations " (append (show_nat n) (append "  accepted " (append (show_nat accepted)
                                           (append "  rejected " (append (show_nat (nth_int counts 1)) (append "  exhausted " (append (show_nat (nth_int counts 2))
                                           (append "  mismatched " (append (show_nat (nth_int counts 3)) (append "  unsupported " (append (show_nat (nth_int counts 4))
                                           (append "  malformed " (append (show_nat bad) (append "  mistied " (append (show_nat wrong) (append "  missing " (append (show_nat missing) (append "  taken " (show_nat (len taken)))))))))))))))))))))
                               w7)))))))))))))))
       (_ (exit 2 (write_line "verify_release: [-v] DIR EXPORT INDEX" w1)))))))
(fn nth_int ((xs (List Int)) (i Int)) Int
  (measure (struct xs))
  (match xs (Nil 0) ((Cons x r) (if (int_eq i 0) x (nth_int r (- i 1))))))
