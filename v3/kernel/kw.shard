;;; v3/kernel/kw.shard — a walk over K's terms from outside the seal: the
;;; environment, a local context and the checker state, with K's procedures
;;; through the view (whnf, infer, is_def_eq, is_prop, mk_local, mk_binding).
;;; Every translator and the elaborator build terms over fvars with these and
;;; close them with K's own mk_binding. K's outcome survives this first
;;; wrapper: `w_infer_r`, `w_whnf_r`,
;;; `w_is_def_eq_r` answer a value or K's own failure — a refusal with its
;;; reason, or exhaustion — and the unifier and the elaborator read those; the
;;; Option forms below them are the erasure's and the translators', where any
;;; failure is one refusal the caller names. `w_admit` checks a generated
;;; declaration into the walk's environment (a matcher).

(import "k")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.verdict)
(use kernel.decl)
(use kernel.decl.DefinitionSafety)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.St)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)

(type W (W CheckedEnv (List LDecl) St))
(fn w_env ((w W)) CheckedEnv
  (match w
    ((W e _ _) e)))
(fn w_lctx ((w W)) (List LDecl)
  (match w
    ((W _ l _) l)))
(fn w_st ((w W)) St
  (match w
    ((W _ _ s) s)))
(fn w_ctx ((w W)) Ctx
  (match w
    ((W e l _) (ctx_new e l (some nil) Safe false (budget_ticks)))))
(fn w0 ((env CheckedEnv)) W (W env nil (st_for env)))
(fn w_set_st ((w W) (st St)) W
  (match w
    ((W e l _) (W e l st))))
;; a fresh local of type ty, without and with a value; with a binder info
(fn w_local ((w W) (n Name) (ty Expr)) (Prod W Expr) (w_local_bi w n ty BDefault))
(fn w_local_bi ((w W) (n Name) (ty Expr) (bi BinderInfo)) (Prod W Expr)
  (let ((x (mk_local (w_ctx w) (w_st w) n ty none bi)))
    (Prod.mk (W (w_env w) (ctx_lctx (loc_ctx x)) (loc_st x)) (loc_fvar x))))
(fn w_local_val ((w W) (n Name) (ty Expr) (v Expr)) (Prod W Expr)
  (let ((x (mk_local (w_ctx w) (w_st w) n ty (some v) BDefault)))
    (Prod.mk (W (w_env w) (ctx_lctx (loc_ctx x)) (loc_st x)) (loc_fvar x))))
;; the type of a local by its fvar id
(fn w_local_type ((w W) (id Int)) (Option Expr)
  (match (lctx_find (w_lctx w) id)
    ((some d) (some (ldecl_type d)))
    (none none)))
;; K's procedures with K's outcome: a value, or K's failure (FRej reason / FOut resource site)
(type (WOut A) (WVal A) (WFail Failure))
(fn w_whnf_r ((w W) (e Expr)) (Prod W (WOut Expr))
  (match (whnf (w_ctx w) (w_st w) (budget_depth) e)
    ((KOk st r) (Prod.mk (w_set_st w st) (WVal r)))
    ((KFail f) (Prod.mk w (WFail f)))))
(fn w_infer_r ((w W) (e Expr)) (Prod W (WOut Expr))
  (match (infer (w_ctx w) (w_st w) (budget_depth) e true)
    ((KOk st r) (Prod.mk (w_set_st w st) (WVal r)))
    ((KFail f) (Prod.mk w (WFail f)))))
(fn w_is_def_eq_r ((w W) (a Expr) (b Expr)) (Prod W (WOut Bool))
  (match (is_def_eq (w_ctx w) (w_st w) (budget_depth) a b)
    ((KOk st r) (Prod.mk (w_set_st w st) (WVal r)))
    ((KFail f) (Prod.mk w (WFail f)))))
;; exhaustion against refusal: the site of a spent resource, None for a refusal
(fn failure_spent ((f Failure)) (Option Symbol)
  (match f
    ((FOut _ site) (some site))
    ((FRej _) none)))
;; the Option forms: any failure is None
(fn w_whnf ((w W) (e Expr)) (Prod W (Option Expr))
  (match (w_whnf_r w e)
    ((Prod.mk w1 (WVal r)) (Prod.mk w1 (some r)))
    ((Prod.mk w1 (WFail _)) (Prod.mk w1 none))))
(fn w_infer ((w W) (e Expr)) (Prod W (Option Expr))
  (match (w_infer_r w e)
    ((Prod.mk w1 (WVal r)) (Prod.mk w1 (some r)))
    ((Prod.mk w1 (WFail _)) (Prod.mk w1 none))))
;; K's inference with every rule checking (infer's io = False): the type of a term that is type
;; correct, None of one that is not. `w_infer` computes a type and checks no application's
;; argument — a term built by abstraction is asked here whether it is a term at all (a
;; rewrite's motive)
(fn w_infer_checked ((w W) (e Expr)) (Prod W (Option Expr))
  (match (infer (w_ctx w) (w_st w) (budget_depth) e false)
    ((KOk st r) (Prod.mk (w_set_st w st) (some r)))
    ((KFail _) (Prod.mk w none))))
(fn w_is_prop ((w W) (e Expr)) (Prod W (Option Bool))
  (match (is_prop (w_ctx w) (w_st w) (budget_depth) e)
    ((KOk st r) (Prod.mk (w_set_st w st) (some r)))
    ((KFail _) (Prod.mk w none))))
;; a generated declaration checked into the walk's environment: K's check seeded above this
;; walk's node ids (st_seed), the walk's ids then raised above the new environment's, so no
;; node of the walk shares an id with one of the environment (the memo tables key on them)
(fn w_admit ((w W) (d Declaration)) (Prod W (Option Symbol))
  (match (check (w_env w) (w_st w) d)
    ((Accepted env1) (Prod.mk (W env1 (w_lctx w) (st_above (w_st w) (st_node (st_for env1)))) none))
    ((Rejected reason _) (Prod.mk w (some (reason_of reason))))
    ((Exhausted _ site) (Prod.mk w (some site)))))
(fn reason_of ((r Reason)) Symbol
  (match r
    ((Malformed t) t)
    ((RuleViolation t) t)
    ((Unsupported t) t)
    (ConversionNotEstablished (sym "conversion"))))
(fn st_above ((st St) (k Int)) St
  (match st
    ((St g t n m) (St g t (max_int n k) m))))
(fn w_inst1 ((w W) (e Expr) (v Expr)) (Prod W Expr)
  (match (instantiate1 (w_st w) e v)
    ((Prod.mk st r) (Prod.mk (w_set_st w st) r))))
(fn w_apps ((w W) (f Expr) (args (List Expr))) (Prod W Expr)
  (match (mk_app_list (w_st w) f args)
    ((Prod.mk st r) (Prod.mk (w_set_st w st) r))))
(fn w_inst_lparams ((w W) (e Expr) (ps (List Name)) (ls (List Level))) (Prod W Expr)
  (match (expr_inst_lparams (w_st w) e ps ls)
    ((Prod.mk st r) (Prod.mk (w_set_st w st) r))))
;; the binders and lambdas over fvars (K's mk_binding; a let-local becomes a Let)
(fn w_pis ((w W) (fvars (List Expr)) (b Expr)) (Prod W Expr)
  (match (mk_binding (w_ctx w) (w_st w) false fvars b false)
    ((Prod.mk st r) (Prod.mk (w_set_st w st) r))))
(fn w_lams ((w W) (fvars (List Expr)) (b Expr)) (Prod W Expr)
  (match (mk_binding (w_ctx w) (w_st w) true fvars b false)
    ((Prod.mk st r) (Prod.mk (w_set_st w st) r))))
;; a type as a table key (the derivation table): whnf at the head, then its
;; arguments' — a definition that stands for a type is the type, wherever it is written
(fn w_norm_ty ((w W) (t Expr) (fuel Int)) (Prod W Expr)
  (measure fuel)
  (if (< fuel 1) (Prod.mk w t)
  (match (w_whnf w t)
    ((Prod.mk w1 none) (Prod.mk w1 t))
    ((Prod.mk w1 (some tw))
     (match (get_app_args tw)
       (nil (Prod.mk w1 tw))
       (args
         (match (get_app_fn tw)
           ((Const d n ls)
            (match (w_norm_tys w1 args (- fuel 1) nil)
              ((Prod.mk w2 as) (w_apps w2 (Const d n ls) as))))
           (_ (Prod.mk w1 tw)))))))))
(fn w_norm_tys ((w W) (ts (List Expr)) (fuel Int) (acc (List Expr))) (Prod W (List Expr))
  (measure (struct ts))
  (match ts
    (nil (Prod.mk w (rev acc)))
    ((cons t r)
     (match (w_norm_ty w t fuel)
       ((Prod.mk w1 t1) (w_norm_tys w1 r fuel (cons t1 acc)))))))
;; e with the fvar id replaced by v
(fn w_subst ((w W) (e Expr) (id Int) (v Expr)) (Prod W Expr)
  (match (abstract_fvars (w_st w) e (list id))
    ((Prod.mk st1 e1)
     (match (instantiate1 st1 e1 v)
       ((Prod.mk st2 e2) (Prod.mk (w_set_st w st2) e2))))))
(fn fvar_index ((id Int) (fvs (List Expr)) (i Int)) (Option Int)
  (measure (struct fvs))
  (match fvs
    (nil none)
    ((cons (FVar _ j) r) (if (= id j) (some i) (fvar_index id r (+ i 1))))
    ((cons _ r) (fvar_index id r (+ i 1)))))
(fn fvar_id_of ((e Expr)) Int
  (match e
    ((FVar _ id) id)
    (_ -1)))
;; Init's Int and the two constructors the numeral rule states
(fn nm_int_ty () Name (n1 (sym "Int")))
(fn nm_int_of_nat () Name (n2 (sym "Int") (sym "ofNat")))
(fn nm_int_neg_succ () Name (n2 (sym "Int") (sym "negSucc")))
