;;; v3/kernel/util.shard — list, integer and name utilities for the
;;; toolchain (first-order, every traversal its own fn, no function
;;; values: what the bootstrap runs).

(import "name.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.name)
(use kernel.name.Name)

;; ---- lists ------------------------------------------------------------

(fn len ((T Type) (xs (List T))) Int
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ r) (+ 1 (len r)))))

(fn append ((T Type) (xs (List T)) (ys (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))

(fn rev_onto ((T Type) (xs (List T)) (acc (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil acc)
    ((cons x r) (rev_onto r (cons x acc)))))

(fn rev ((T Type) (xs (List T))) (List T) (rev_onto xs nil))

;; the i-th element (0-based), None past the end or for i < 0
(fn nth ((T Type) (xs (List T)) (i Int)) (Option T)
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons x r)
     (if (= i 0) (some x)
     (if (< i 0) none
     (nth r (- i 1)))))))

(fn take ((T Type) (n Int) (xs (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (<= n 0) nil (cons x (take (- n 1) r))))))

(fn drop ((T Type) (n Int) (xs (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (<= n 0) xs (drop (- n 1) r)))))

;; ---- text ---------------------------------------------------------------
;; Text here is a list of bytes, and a literal is a `String`: `(utf8 "…")` is the literal's
;; bytes. A String is represented by its bytes, so what runs is one copy of the list
(fn utf8 ((s String)) (List Int) (byte_ints (Array.toList (ByteArray.data (String.toByteArray s)))))
(fn byte_ints ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Int.ofNat (Fin.val (BitVec.toFin (UInt8.toBitVec b)))) (byte_ints r)))))
(fn utf8_all ((ss (List String))) (List (List Int))
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s r) (cons (utf8 s) (utf8_all r)))))

(fn int_list_eq ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (= x y) (int_list_eq ar br) false))))))

;; lexicographic order on byte lists
(fn int_list_lt ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil false)
        (_ true)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br)
        (if (< x y) true
        (if (< y x) false
        (int_list_lt ar br))))))))

(fn mem_int ((x Int) (xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (= x y) true (mem_int x r)))))

;; ---- bytes ------------------------------------------------------------

(fn is_ws ((c Int)) Bool (bool_or (= c 32) (bool_or (= c 10) (bool_or (= c 13) (= c 9)))))
(fn is_digit ((c Int)) Bool (bool_and (<= 48 c) (<= c 57)))

;; the rest after a literal prefix, or None
(fn starts_with_lit ((lit (List Int)) (bs (List Int))) (Option (List Int))
  (measure (struct lit))
  (match lit
    (nil (some bs))
    ((cons c lr)
     (match bs
       ((cons b br) (if (= c b) (starts_with_lit lr br) none))
       (nil none)))))

(fn bool_and ((a Bool) (b Bool)) Bool (if a b false))
(fn bool_or ((a Bool) (b Bool)) Bool (if a true b))
(fn bool_not ((a Bool)) Bool (if a false true))

(fn max_int ((a Int) (b Int)) Int (if (< a b) b a))

;; ---- decimal rendering ---------------------------------------------------

(fn show_nat_go ((n Int) (acc (List Int))) (List Int)
  (measure n)
  (if (< n 10) (cons (+ 48 n) acc) (show_nat_go (ediv n 10) (cons (+ 48 (mod n 10)) acc))))

(fn show_nat ((n Int)) (List Int) (show_nat_go n nil))

(fn show_int ((n Int)) (List Int) (if (< n 0) (cons 45 (show_nat (- 0 n))) (show_nat n)))

;; ---- names -----------------------------------------------------------------

(fn name_eq ((a Name) (b Name)) Bool
  (measure (struct a))
  (match a
    (Anon
      (match b
        (Anon true)
        (_ false)))
    ((Str ap as)
     (match b
       ((Str bp bs) (if (sym_eq as bs) (name_eq ap bp) false))
       (_ false)))
    ((Num ap an)
     (match b
       ((Num bp bn) (if (= an bn) (name_eq ap bp) false))
       (_ false)))))

;; Name.cmp's order (Lean `Name.cmp`; util/name.cpp `cmp`): compare the
;; prefixes first, then the last component, numerals before strings.
;; Only used to order universe levels in `normalize` (level.shard), where
;; ANY fixed total order yields the same equivalence verdicts.
(fn name_lt ((a Name) (b Name)) Bool
  (measure (struct a))
  (match a
    (Anon
      (match b
        (Anon false)
        (_ true)))
    ((Str ap as)
     (match b
       (Anon false)
       ((Num _ _) false)
       ((Str bp bs)
        (if (name_lt ap bp) true
        (if (name_lt bp ap) false
        (int_list_lt (chars_of_sym as) (chars_of_sym bs)))))))
    ((Num ap an)
     (match b
       (Anon false)
       ((Str _ _) true)
       ((Num bp bn)
        (if (name_lt ap bp) true
        (if (name_lt bp ap) false
        (< an bn))))))))

(fn names_eq ((a (List Name)) (b (List Name))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (name_eq x y) (names_eq ar br) false))))))

(fn mem_name ((x Name) (xs (List Name))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (name_eq x y) true (mem_name x r)))))

;; `a.b.c` rendering; numeric components in decimal
(fn show_name ((n Name)) (List Int)
  (measure (struct n))
  (match n
    (Anon "[anonymous]")
    ((Str Anon s) (chars_of_sym s))
    ((Str p s) (append (show_name p) (cons 46 (chars_of_sym s))))
    ((Num Anon k) (show_nat k))
    ((Num p k) (append (show_name p) (cons 46 (show_nat k))))))

;; convenience constructors
(fn n1 ((a Symbol)) Name (Str Anon a))
(fn n2 ((a Symbol) (b Symbol)) Name (Str (Str Anon a) b))
;; a hex digit's value, -1 for a non-digit (json.shard's escapes, sexpr.shard's)
(fn hex_val ((c Int)) Int
  (if (is_digit c) (- c 48)
  (if (bool_and (<= 97 c) (<= c 102)) (+ 10 (- c 97))
  (if (bool_and (<= 65 c) (<= c 70)) (+ 10 (- c 65))
  -1))))
;; UTF-8 validity of a byte list (no overlong form, no surrogate, nothing past U+10FFFF):
;; `ev`'s guard on sym_of_chars, the erasure's on a string literal
(fn utf8_ok ((bs (List Int))) Bool
  (measure (struct bs))
  (match bs
    (nil true)
    ((cons b r)
     (if (bool_and (<= 0 b) (<= b 127)) (utf8_ok r)
     (if (bool_and (<= 194 b) (<= b 223)) (utf8_tail r 1 128 191)
     (if (= b 224) (utf8_tail r 2 160 191)
     (if (bool_and (<= 225 b) (<= b 239)) (utf8_tail r 2 128 (if (= b 237) 159 191))
     (if (= b 240) (utf8_tail r 3 144 191)
     (if (bool_and (<= 241 b) (<= b 243)) (utf8_tail r 3 128 191)
     (if (= b 244) (utf8_tail r 3 128 143)
     false))))))))))
;; k continuation bytes, the first within [lo, hi], the rest 128..191; then the rest of the text
(fn utf8_tail ((bs (List Int)) (k Int) (lo Int) (hi Int)) Bool
  (measure k)
  (if (<= k 0) (utf8_ok bs)
  (match bs
    (nil false)
    ((cons b r) (if (bool_and (<= lo b) (<= b hi)) (utf8_tail r (- k 1) 128 191) false)))))
