;;; v3/kernel/util.shard — list, text and integer utilities for the
;;; toolchain (first-order, every traversal its own fn, no function
;;; values: what the bootstrap runs). The lowest file: sym.shard and
;;; name.shard stand on it.

(import "descent.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.descent)

;; ---- lists ------------------------------------------------------------

(fn len ((T Type) (xs (List T))) Int
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ r) (+ 1 (len r)))))

(fn append ((T Type) (xs (List T)) (ys (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (append r ys)))))

(fn rev_onto ((T Type) (xs (List T)) (acc (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil acc)
    ((cons x r) (rev_onto r (cons x acc)))))

(fn rev ((T Type) (xs (List T))) (List T) (rev_onto xs nil))

;; the i-th element (0-based), None past the end or for i < 0
(fn nth ((T Type) (xs (List T)) (i Int)) (Option T)
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons x r)
     (if (= i 0) (some x)
     (if (< i 0) none
     (nth r (- i 1)))))))

(fn take ((T Type) (n Int) (xs (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (<= n 0) nil (cons x (take (- n 1) r))))))

(fn drop ((T Type) (n Int) (xs (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (<= n 0) xs (drop (- n 1) r)))))

;; a list dealt into two piles, the first element onto the first: what a merge sort halves by
;; (`(halves xs nil nil)`)
(fn halves ((T Type) (xs (List T)) (a (List T)) (b (List T))) (Prod (List T) (List T))
  (measure (struct xs))
  (match xs
    (nil (Prod.mk a b))
    ((cons x nil) (Prod.mk (cons x a) b))
    ((cons x (cons y r)) (halves r (cons x a) (cons y b)))))
;; neither pile takes more than its half, so each half of a list of two or more is shorter
;; than the list: a merge sort's descent (`halves_fst_lt`, `halves_snd_lt`)
(theorem halves_fst_le ((T Type) (xs (List T)))
  (forall ((a (List T)) (b (List T)) (p (List T)) (q (List T)))
    (-> (= (halves xs a b) (Prod.mk p q))
      (<= (* 2 (List.length p)) (+ (+ (* 2 (List.length a)) (List.length xs)) 1))))
  (by
    (wf xs (List.length xs) ih
      (cases xs
        ((nil () (intro a b p q h) (have e (= (Prod.mk a b) (Prod.mk p q)) (exact h))
           (have ep (= a p) (exact (congrArg Prod.fst e)))
           (rw (<- ep))
           (arith))
         (cons (x r)
           (cases r
             ((nil () (intro a b p q h) (have e (= (Prod.mk (cons x a) b) (Prod.mk p q)) (exact h))
                (have ep (= (cons x a) p) (exact (congrArg Prod.fst e)))
                (rw (<- ep))
                (simp_only List.length_cons)
                (arith))
              (cons (y r2) (intro a b p q h)
                (have l (< (List.length r2) (List.length (cons x (cons y r2))))
                  (simp_only List.length_cons)
                  (arith))
                (have g
                  (<= (* 2 (List.length p))
                    (+ (+ (* 2 (List.length (cons x a))) (List.length r2)) 1))
                  (exact (ih r2 l (cons x a) (cons y b) p q h)))
                (have ea (= (List.length (cons x a)) (+ (List.length a) 1))
                  (rw List.length_cons)
                  rfl)
                (simp_only List.length_cons)
                (arith))))))))))
(theorem halves_snd_le ((T Type) (xs (List T)))
  (forall ((a (List T)) (b (List T)) (p (List T)) (q (List T)))
    (-> (= (halves xs a b) (Prod.mk p q))
      (<= (* 2 (List.length q)) (+ (* 2 (List.length b)) (List.length xs)))))
  (by
    (wf xs (List.length xs) ih
      (cases xs
        ((nil () (intro a b p q h) (have e (= (Prod.mk a b) (Prod.mk p q)) (exact h))
           (have eq (= b q) (exact (congrArg Prod.snd e)))
           (rw (<- eq))
           (arith))
         (cons (x r)
           (cases r
             ((nil () (intro a b p q h) (have e (= (Prod.mk (cons x a) b) (Prod.mk p q)) (exact h))
                (have eq (= b q) (exact (congrArg Prod.snd e)))
                (rw (<- eq))
                (arith))
              (cons (y r2) (intro a b p q h)
                (have l (< (List.length r2) (List.length (cons x (cons y r2))))
                  (simp_only List.length_cons)
                  (arith))
                (have g
                  (<= (* 2 (List.length q)) (+ (* 2 (List.length (cons y b))) (List.length r2)))
                  (exact (ih r2 l (cons x a) (cons y b) p q h)))
                (have eb (= (List.length (cons y b)) (+ (List.length b) 1))
                  (rw List.length_cons)
                  rfl)
                (simp_only List.length_cons)
                (arith))))))))))
(theorem halves_fst_lt
  ((T Type)
   (xs (List T))
   (x T)
   (y T)
   (r (List T))
   (p (List T))
   (q (List T))
   (hx (= xs (cons x (cons y r))))
   (h (= (halves xs nil nil) (Prod.mk p q))))
  (< (List.length p) (List.length xs))
  (by
    (have g (<= (* 2 (List.length p)) (+ (+ (* 2 (List.length (@nil T))) (List.length xs)) 1))
      (exact (halves_fst_le T xs nil nil p q h)))
    (have e0 (= (List.length (@nil T)) 0) rfl)
    (have e2 (= (List.length xs) (+ (+ (List.length r) 1) 1))
      (rw hx)
      (simp_only List.length_cons)
      rfl)
    (arith)))
(theorem halves_snd_lt
  ((T Type)
   (xs (List T))
   (x T)
   (y T)
   (r (List T))
   (p (List T))
   (q (List T))
   (hx (= xs (cons x (cons y r))))
   (h (= (halves xs nil nil) (Prod.mk p q))))
  (< (List.length q) (List.length xs))
  (by
    (have g (<= (* 2 (List.length q)) (+ (* 2 (List.length (@nil T))) (List.length xs)))
      (exact (halves_snd_le T xs nil nil p q h)))
    (have e0 (= (List.length (@nil T)) 0) rfl)
    (have e2 (= (List.length xs) (+ (+ (List.length r) 1) 1))
      (rw hx)
      (simp_only List.length_cons)
      rfl)
    (arith)))

;; ---- text---------------------------------------------------------------
;; Text here is a list of bytes, and a literal is a `String`: `(utf8 "…")` is the literal's
;; bytes. A String is represented by its bytes, so what runs is one copy of the list
(fn utf8 ((s String)) (List Int) (byte_ints (Array.toList (ByteArray.data (String.toByteArray s)))))
(fn byte_ints ((bs (List UInt8))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (Int.ofNat (Fin.val (BitVec.toFin (UInt8.toBitVec b)))) (byte_ints r)))))
(fn utf8_all ((ss (List String))) (List (List Int))
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s r) (cons (utf8 s) (utf8_all r)))))

(fn int_list_eq ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (= x y) (int_list_eq ar br) false))))))

;; lexicographic order on byte lists
(fn int_list_lt ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil false)
        (_ true)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br)
        (if (< x y) true
        (if (< y x) false
        (int_list_lt ar br))))))))

(fn mem_int ((x Int) (xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (= x y) true (mem_int x r)))))

;; ---- booleans ---------------------------------------------------------
;; Above every function of this file that passes one a comparison: the reading of a program
;; alone knows the parameter types of a function declared above the call, and makes a
;; comparison a Bool where the parameter is one (docs/OPEN.md §1).

(fn bool_and ((a Bool) (b Bool)) Bool (if a b false))
(fn bool_or ((a Bool) (b Bool)) Bool (if a true b))
(fn bool_not ((a Bool)) Bool (if a false true))

;; ---- bytes ------------------------------------------------------------

(fn is_ws ((c Int)) Bool (bool_or (= c 32) (bool_or (= c 10) (bool_or (= c 13) (= c 9)))))
(fn is_digit ((c Int)) Bool (bool_and (<= 48 c) (<= c 57)))

;; the rest after a literal prefix, or None
(fn starts_with_lit ((lit (List Int)) (bs (List Int))) (Option (List Int))
  (measure (struct lit))
  (match lit
    (nil (some bs))
    ((cons c lr)
     (match bs
       ((cons b br) (if (= c b) (starts_with_lit lr br) none))
       (nil none)))))

(fn max_int ((a Int) (b Int)) Int (if (< a b) b a))

;; ---- decimal rendering ---------------------------------------------------

(fn show_nat_go ((n Int) (acc (List Int))) (List Int)
  (measure (Int.natAbs n))
  (if (< n 10) (cons (+ 48 n) acc) (show_nat_go (/ n 10) (cons (+ 48 (mod n 10)) acc))))

(fulfills show_nat_go.dec_1 (by (intro p h) (exact (natAbs_div10 (proj PProd 0 p) h))))

(fn show_nat ((n Int)) (List Int) (show_nat_go n nil))

(fn show_int ((n Int)) (List Int) (if (< n 0) (cons 45 (show_nat (- 0 n))) (show_nat n)))

;; a hex digit's value, -1 for a non-digit (json.shard's escapes, sexpr.shard's)
(fn hex_val ((c Int)) Int
  (if (is_digit c) (- c 48)
  (if (bool_and (<= 97 c) (<= c 102)) (+ 10 (- c 97))
  (if (bool_and (<= 65 c) (<= c 70)) (+ 10 (- c 65))
  -1))))
;; UTF-8 validity of a byte list (no overlong form, no surrogate, nothing past U+10FFFF):
;; `ev`'s guard on sym_of_chars, the erasure's on a string literal
(fn utf8_ok ((bs (List Int))) Bool
  (measure (* 2 (List.length bs)))
  (match bs
    (nil true)
    ((cons b r)
     (if (bool_and (<= 0 b) (<= b 127)) (utf8_ok r)
     (if (bool_and (<= 194 b) (<= b 223)) (utf8_tail r 1 128 191)
     (if (= b 224) (utf8_tail r 2 160 191)
     (if (bool_and (<= 225 b) (<= b 239)) (utf8_tail r 2 128 (if (= b 237) 159 191))
     (if (= b 240) (utf8_tail r 3 144 191)
     (if (bool_and (<= 241 b) (<= b 243)) (utf8_tail r 3 128 191)
     (if (= b 244) (utf8_tail r 3 128 143)
     false))))))))))
;; k continuation bytes, the first within [lo, hi], the rest 128..191; then the rest of the text
(fn utf8_tail ((bs (List Int)) (k Int) (lo Int) (hi Int)) Bool
  (measure (+ (* 2 (List.length bs)) 1))
  (if (<= k 0) (utf8_ok bs)
  (match bs
    (nil false)
    ((cons b r) (if (bool_and (<= lo b) (<= b hi)) (utf8_tail r (- k 1) 128 191) false)))))
(fulfills utf8_ok.dec_1
  (by (intro bs b r h h1 h2 h3 h4 h5 h6 h7) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_2
  (by (intro bs b r h h1 h2 h3 h4 h5 h6) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_3 (by (intro bs b r h h1 h2 h3 h4 h5) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_4 (by (intro bs b r h h1 h2 h3 h4) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_5 (by (intro bs b r h h1 h2 h3) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_6 (by (intro bs b r h h1 h2) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_ok.dec_7 (by (intro bs b r h h1) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_tail.dec_1 (by (intro bs k lo hi hk b r h hb) (rw h) (rw List.length_cons) (arith)))
(fulfills utf8_tail.dec_2 (by (intro bs k lo hi hk) (arith)))
