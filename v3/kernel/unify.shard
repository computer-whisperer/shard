;;; v3/kernel/unify.shard — metavariables and first-order unification for
;;; the elaborator.
;;;
;;; A metavariable is an `MVar` node (expr.shard) with a declaration here:
;;; its type, the fvars in scope where it was made (its telescope — an
;;; assignment may mention no other local: the scope check), the binder
;;; name it stands for and a kind, for the refusal that names it when it
;;; stays unsolved. Assignments live in this state, never in a term K reads:
;;; `inst_mvars` (instantiate, Lean's instantiateMVars) replaces every
;;; assigned metavariable, and a declaration reaches K only through it.
;;;
;;; `unify` is first-order: structural descent assigning a
;;; metavariable on either side after an occurs check and the scope check;
;;; levels likewise, structurally, with `is_equivalent` on two closed levels;
;;; a closed mismatch (no metavariable on either side) is decided by K's own
;;; is_def_eq through the view, and a mismatch under a metavariable is
;;; retried once after K's whnf of both sides. It is transactional: a
;;; failure returns the state it was given. An over-eager assignment can
;;; never make a theorem — K rechecks the closed term — so incompleteness
;;; here costs a refusal with a pointer, never soundness.
;;;
;;; Outcomes: `UYes`; `UNo` — this attempt
;;; failed, which is never inequality; `UStuck i` — blocked on the unassigned
;;; metavariable i (a non-pattern application of it), to retry after it is
;;; assigned; `UExhausted site` — the depth here or a resource of K's. An
;;; assignment is typed when its value's type was unified with the
;;; metavariable's, **tentative** when the value has a metavariable inside
;;; and no type could be given yet: the id is kept and `tentative_bad`
;;; validates it once the value has closed (el_finish asks). A closed value
;;; K refuses to type is never installed — unless it cites a constant the
;;; form is still declaring, which K cannot type before the admission.

(import "kw.shard")
(import "spelling.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.kw)
(use kernel.descent)
(use kernel.expr)
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.spelling)
(use kernel.sym)
(use kernel.util)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.intmap.IntMap)
(use kernel.kw.W)
(use kernel.kw.WOut)
(use kernel.level.Level)

;; a metavariable's declaration: the binder name it stands for, its type, the
;; fvar ids in scope at its creation, its kind (implicit, inst, numeral, hole)
(type MDecl (MDecl Name Expr (List Int) Symbol))
(fn md_name ((d MDecl)) Name
  (match d
    ((MDecl n _ _ _) n)))
(fn md_type ((d MDecl)) Expr
  (match d
    ((MDecl _ t _ _) t)))
(fn md_lctx ((d MDecl)) (List Int)
  (match d
    ((MDecl _ _ l _) l)))
(fn md_kind ((d MDecl)) Symbol
  (match d
    ((MDecl _ _ _ k) k)))

;; the state: next term id, next level id, the assignments, the level
;; assignments, the declarations, the ids in creation order, the tentatively
;; assigned ids
(type MCtx (MCtx Int Int (IntMap Expr) (IntMap Level) (IntMap MDecl) (List Int) (List Int)))
(fn mc0 () MCtx (MCtx 1 1 IMEmpty IMEmpty IMEmpty nil nil))
(fn mc_assigned ((mc MCtx) (i Int)) (Option Expr)
  (match mc
    ((MCtx _ _ a _ _ _ _) (im_find a i))))
(fn mc_lassigned ((mc MCtx) (i Int)) (Option Level)
  (match mc
    ((MCtx _ _ _ la _ _ _) (im_find la i))))
(fn mc_decl ((mc MCtx) (i Int)) (Option MDecl)
  (match mc
    ((MCtx _ _ _ _ ds _ _) (im_find ds i))))
(fn mc_ids ((mc MCtx)) (List Int)
  (match mc
    ((MCtx _ _ _ _ _ ids _) ids)))
(fn mc_fresh ((mc MCtx) (n Name) (ty Expr) (lctx (List Int)) (kind Symbol)) (Prod MCtx Expr)
  (match mc
    ((MCtx k lk a la ds ids tn)
     (Prod.mk (MCtx (+ k 1) lk a la (im_insert ds k (MDecl n ty lctx kind)) (cons k ids) tn)
       (mk_mvar k)))))
(fn mc_fresh_level ((mc MCtx)) (Prod MCtx Level)
  (match mc
    ((MCtx k lk a la ds ids tn) (Prod.mk (MCtx k (+ lk 1) a la ds ids tn) (LMVar lk)))))
(fn mc_set ((mc MCtx) (i Int) (v Expr)) MCtx
  (match mc
    ((MCtx k lk a la ds ids tn) (MCtx k lk (im_insert a i v) la ds ids tn))))
(fn mc_lset ((mc MCtx) (i Int) (l Level)) MCtx
  (match mc
    ((MCtx k lk a la ds ids tn) (MCtx k lk a (im_insert la i l) ds ids tn))))
(fn mc_tentative ((mc MCtx)) (List Int)
  (match mc
    ((MCtx _ _ _ _ _ _ tn) tn)))
(fn mc_set_tentative ((mc MCtx) (i Int) (v Expr)) MCtx
  (match mc
    ((MCtx k lk a la ds ids tn) (MCtx k lk (im_insert a i v) la ds ids (cons i tn)))))
(fn mc_set_decl ((mc MCtx) (i Int) (d MDecl)) MCtx
  (match mc
    ((MCtx k lk a la ds ids tn) (MCtx k lk a la (im_insert ds i d) ids tn))))
;; closing binders over the fvars `ids`: every unassigned metavariable loses
;; them from its telescope, so a later assignment cannot capture a variable
;; that is no longer in scope (Lean's delayed assignment, refused instead)
(fn mc_drop_fvars ((mc MCtx) (ids (List Int))) MCtx (drop_fvars_go mc (mc_ids mc) ids))
(fn drop_fvars_go ((mc MCtx) (ms (List Int)) (ids (List Int))) MCtx
  (measure (struct ms))
  (match ms
    (nil mc)
    ((cons m r)
     (drop_fvars_go
       (match (mc_assigned mc m)
         ((some _) mc)
         (none
           (match (mc_decl mc m)
             ((some (MDecl n t l k)) (mc_set_decl mc m (MDecl n t (remove_ints l ids) k)))
             (none mc))))
       r
       ids))))
(fn remove_ints ((xs (List Int)) (ids (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (mem_int x ids) (remove_ints r ids) (cons x (remove_ints r ids))))))

;; ---- instantiation (instantiateMVars) ------------------------------------------------
(fn inst_level ((mc MCtx) (l Level)) Level (inst_level_go mc l 1000))
(fn inst_level_go ((mc MCtx) (l Level) (d Int)) Level
  (measure (Int.natAbs d))
  (if (< d 1) l
  (if (bool_not (level_has_mvar l)) l
  (match l
    ((LMVar i)
     (match (mc_lassigned mc i)
       ((some v) (inst_level_go mc v (- d 1)))
       (none l)))
    ((LSucc x) (LSucc (inst_level_go mc x (- d 1))))
    ((LMax x y) (LMax (inst_level_go mc x (- d 1)) (inst_level_go mc y (- d 1))))
    ((LIMax x y) (LIMax (inst_level_go mc x (- d 1)) (inst_level_go mc y (- d 1))))
    (_ l)))))
(fulfills inst_level_go.dec_1 (by (intro p h hb i hm v hs) (apply natAbs_pred (arith))))
(fulfills inst_level_go.dec_2 (by (intro p h hb x hm) (apply natAbs_pred (arith))))
(fulfills inst_level_go.dec_3 (by (intro p h hb x y hm) (apply natAbs_pred (arith))))
(fulfills inst_level_go.dec_4 (by (intro p h hb x y hm) (apply natAbs_pred (arith))))
(fn inst_levels ((mc MCtx) (ls (List Level))) (List Level)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons l r) (cons (inst_level mc l) (inst_levels mc r)))))
(fn inst_mvars ((mc MCtx) (e Expr)) Expr (inst_go mc e 100000))
(fn inst_go ((mc MCtx) (e Expr) (d Int)) Expr
  (measure (Int.natAbs d))
  (if (< d 1) e
  (if (bool_not (has_mvar e)) e
  (match e
    ((MVar _ i)
     (match (mc_assigned mc i)
       ((some v) (inst_go mc v (- d 1)))
       (none e)))
    ((Sort _ u) (mk_sort (inst_level mc u)))
    ((Const _ n ls) (mk_const n (inst_levels mc ls)))
    ((App _ f a) (mk_app (inst_go mc f (- d 1)) (inst_go mc a (- d 1))))
    ((Lam _ n bi t b) (mk_lam n bi (inst_go mc t (- d 1)) (inst_go mc b (- d 1))))
    ((Pi _ n bi t b) (mk_pi n bi (inst_go mc t (- d 1)) (inst_go mc b (- d 1))))
    ((Let _ n t v b)
     (mk_let n (inst_go mc t (- d 1)) (inst_go mc v (- d 1)) (inst_go mc b (- d 1))))
    ((Proj _ s i x) (mk_proj s i (inst_go mc x (- d 1))))
    (_ e)))))
(fulfills inst_go.dec_1 (by (intro p h hb w i hm v hs) (apply natAbs_pred (arith))))
(fulfills inst_go.dec_2 (by (intro p h hb w f a hm) (apply natAbs_pred (arith))))
(fulfills inst_go.dec_3 (by (intro p h hb w n bi t b hm) (apply natAbs_pred (arith))))
(fulfills inst_go.dec_4 (by (intro p h hb w n bi t b hm) (apply natAbs_pred (arith))))
(fulfills inst_go.dec_5 (by (intro p h hb w n t v b hm) (apply natAbs_pred (arith))))
(fulfills inst_go.dec_6 (by (intro p h hb w s i x hm) (apply natAbs_pred (arith))))

;; ---- the unsolved ----------------------------------------------------------------------
;; the first unassigned metavariable of an instantiated term, and the first level one
(fn first_mvar ((e Expr)) (Option Int)
  (measure (struct e))
  (if (bool_not (has_mvar e)) none
  (match e
    ((MVar _ i) (some i))
    ((App _ f a)
     (match (first_mvar f)
       ((some i) (some i))
       (none (first_mvar a))))
    ((Lam _ _ _ t b)
     (match (first_mvar t)
       ((some i) (some i))
       (none (first_mvar b))))
    ((Pi _ _ _ t b)
     (match (first_mvar t)
       ((some i) (some i))
       (none (first_mvar b))))
    ((Let _ _ t v b)
     (match (first_mvar t)
       ((some i) (some i))
       (none
         (match (first_mvar v)
           ((some i) (some i))
           (none (first_mvar b))))))
    ((Proj _ _ _ x) (first_mvar x))
    (_ none))))
(fn first_lmvar ((e Expr)) (Option Int)
  (measure (struct e))
  (if (bool_not (has_mvar e)) none
  (match e
    ((Sort _ u) (level_first_mvar u))
    ((Const _ _ ls) (levels_first_mvar ls))
    ((App _ f a)
     (match (first_lmvar f)
       ((some i) (some i))
       (none (first_lmvar a))))
    ((Lam _ _ _ t b)
     (match (first_lmvar t)
       ((some i) (some i))
       (none (first_lmvar b))))
    ((Pi _ _ _ t b)
     (match (first_lmvar t)
       ((some i) (some i))
       (none (first_lmvar b))))
    ((Let _ _ t v b)
     (match (first_lmvar t)
       ((some i) (some i))
       (none
         (match (first_lmvar v)
           ((some i) (some i))
           (none (first_lmvar b))))))
    ((Proj _ _ _ x) (first_lmvar x))
    (_ none))))
(fn level_first_mvar ((l Level)) (Option Int)
  (measure (struct l))
  (match l
    ((LMVar i) (some i))
    ((LSucc x) (level_first_mvar x))
    ((LMax x y)
     (match (level_first_mvar x)
       ((some i) (some i))
       (none (level_first_mvar y))))
    ((LIMax x y)
     (match (level_first_mvar x)
       ((some i) (some i))
       (none (level_first_mvar y))))
    (_ none)))
(fn levels_first_mvar ((ls (List Level))) (Option Int)
  (measure (struct ls))
  (match ls
    (nil none)
    ((cons l r)
     (match (level_first_mvar l)
       ((some i) (some i))
       (none (levels_first_mvar r))))))

;; ---- occurrence and scope ----------------------------------------------------------------
(fn mvar_occurs ((i Int) (e Expr)) Bool
  (measure (struct e))
  (if (bool_not (has_mvar e)) false
  (match e
    ((MVar _ j) (= i j))
    ((App _ f a) (bool_or (mvar_occurs i f) (mvar_occurs i a)))
    ((Lam _ _ _ t b) (bool_or (mvar_occurs i t) (mvar_occurs i b)))
    ((Pi _ _ _ t b) (bool_or (mvar_occurs i t) (mvar_occurs i b)))
    ((Let _ _ t v b) (bool_or (mvar_occurs i t) (bool_or (mvar_occurs i v) (mvar_occurs i b))))
    ((Proj _ _ _ x) (mvar_occurs i x))
    (_ false))))
(fn lmvar_occurs ((i Int) (l Level)) Bool
  (measure (struct l))
  (match l
    ((LMVar j) (= i j))
    ((LSucc x) (lmvar_occurs i x))
    ((LMax x y) (bool_or (lmvar_occurs i x) (lmvar_occurs i y)))
    ((LIMax x y) (bool_or (lmvar_occurs i x) (lmvar_occurs i y)))
    (_ false)))
;; the fvar ids of a term
(fn expr_fvars ((e Expr) (acc (List Int))) (List Int)
  (measure (struct e))
  (if (bool_not (has_fvar e)) acc
  (match e
    ((FVar _ id) (cons id acc))
    ((App _ f a) (expr_fvars f (expr_fvars a acc)))
    ((Lam _ _ _ t b) (expr_fvars t (expr_fvars b acc)))
    ((Pi _ _ _ t b) (expr_fvars t (expr_fvars b acc)))
    ((Let _ _ t v b) (expr_fvars t (expr_fvars v (expr_fvars b acc))))
    ((Proj _ _ _ x) (expr_fvars x acc))
    (_ acc))))
(fn all_in ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r) (if (mem_int x ys) (all_in r ys) false))))

;; ---- unification -------------------------------------------------------------------------
(type URes (UYes W MCtx) (UNo) (UStuck Int) (UExhausted Symbol))

;; transactional: a failure hands back nothing new
(fn unify ((w W) (mc MCtx) (t Expr) (s Expr)) URes (unify_go w mc t s 64))
(fn unify_depth ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes (unify_go w mc t s d))

(fn unify_go ((w W) (mc MCtx) (t0 Expr) (s0 Expr) (d Int)) URes
  (measure (Int.natAbs d) 0 0)
  (if (< d 1) (UExhausted (sym "unify_depth"))
  (let ((t (inst_mvars mc t0)) (s (inst_mvars mc s0)))
    (if (expr_eq t s) (UYes w mc)
    (match t
      ((MVar _ i) (assign w mc i s d))
      (_
        (match s
          ((MVar _ j) (assign w mc j t d))
          (_
            (match (pattern_of t)
              ((some (Prod.mk i xs)) (assign_pattern w mc i xs s d))
              (none
                (match (pattern_of s)
                  ((some (Prod.mk j ys)) (assign_pattern w mc j ys t d))
                  (none (stuck_or (unify_struct w mc t s d) t s)))))))))))))
;; a failure under an unassigned metavariable applied to something that is no pattern is
;; blocked on it, not refuted
(fn stuck_or ((r URes) (t Expr) (s Expr)) URes
  (match r
    (UNo
      (match (flex_head t)
        ((some i) (UStuck i))
        (none
          (match (flex_head s)
            ((some i) (UStuck i))
            (none UNo)))))
    (other other)))
(fn flex_head ((e Expr)) (Option Int)
  (match e
    ((App _ _ _)
     (match (get_app_fn e)
       ((MVar _ i) (some i))
       (_ none)))
    (_ none)))

;; a Miller pattern: a metavariable applied to distinct locals — `?motive t` against `Bool`
;; assigns `?motive := λ t. Bool` (the case a recursor's implicit motive needs, from the
;; expected type); the locals abstracted by K's mk_binding, the scope check on what remains
(fn pattern_of ((e Expr)) (Option (Prod Int (List Expr)))
  (match e
    ((App _ _ _)
     (match (get_app_fn e)
       ((MVar _ i)
        (let ((xs (get_app_args e)))
          (if (bool_and (all_fvars xs) (distinct_fvars xs nil)) (some (Prod.mk i xs)) none)))
       (_ none)))
    (_ none)))
(fn all_fvars ((xs (List Expr))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons (FVar _ _) r) (all_fvars r))
    (_ false)))
(fn distinct_fvars ((xs (List Expr)) (seen (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons (FVar _ id) r) (if (mem_int id seen) false (distinct_fvars r (cons id seen))))
    ((cons _ r) (distinct_fvars r seen))))
(fn assign_pattern ((w W) (mc MCtx) (i Int) (xs (List Expr)) (v Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 5 0)
  (if (mvar_occurs i v) UNo
  (match (w_lams w xs v)
    ((Prod.mk w1 lam) (assign w1 mc i lam d)))))

;; ?i := v: the same metavariable is trivial; an occurrence refuses; a local
;; outside the telescope refuses; the assignment is typed — the value's type
;; (K's, when the value is closed enough for K to type) against the
;; metavariable's, which is where a universe is inferred (`?α := α` with
;; `?α : Sort ?v` and `α : Sort u` gives `?v := u`). A closed value K refuses
;; is refused here; one K cannot type *yet* — a metavariable inside, or a
;; constant the form is still declaring — is typed by the light walk, else
;; installed tentatively
(fn assign ((w W) (mc MCtx) (i Int) (v Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 4 0)
  (match v
    ((MVar _ j) (if (= i j) (UYes w mc) (assign_checked w mc i v d)))
    (_ (assign_checked w mc i v d))))
(fn assign_checked ((w W) (mc MCtx) (i Int) (v Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 3 0)
  (if (mvar_occurs i v) UNo
  (match (mc_decl mc i)
    (none UNo)
    ((some dcl)
     (if (bool_not (all_in (expr_fvars v nil) (md_lctx dcl))) UNo
     (if (has_mvar v) (assign_light w mc i v dcl d)
     (match (w_infer_r w v)
       ((Prod.mk w1 (WVal vty)) (assign_typed w1 mc i v vty dcl d))
       ((Prod.mk w1 (WFail f))
        (match (failure_spent f)
          ((some site) (UExhausted site))
          (none (if (cites_undeclared w1 v) (assign_light w1 mc i v dcl d) UNo)))))))))))
(fn assign_light ((w W) (mc MCtx) (i Int) (v Expr) (dcl MDecl) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 2 0)
  (match (infer_light w mc v)
    ((Prod.mk w1 none) (UYes w1 (mc_set_tentative mc i v)))
    ((Prod.mk w1 (some vty)) (assign_typed w1 mc i v vty dcl d))))
(fn assign_typed ((w W) (mc MCtx) (i Int) (v Expr) (vty Expr) (dcl MDecl) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 1 0)
  (match (unify_go w mc vty (md_type dcl) (- d 1))
    ((UYes w2 mc2) (UYes w2 (mc_set mc2 i v)))
    (other other)))
;; does the term cite a constant the environment does not hold — directly, as a projection's
;; structure, or in the type of one of its locals? Then the form is still declaring it (an
;; inductive's own name in its constructors, a structure's in its projections) and K's
;; refusal to type the term says nothing yet: the declaration's admission checks it
(fn cites_undeclared ((w W) (v Expr)) Bool
  (bool_or (undeclared_in w v 4096) (undeclared_locals w (expr_fvars v nil))))
(fn undeclared_locals ((w W) (ids (List Int))) Bool
  (measure (struct ids))
  (match ids
    (nil false)
    ((cons id r)
     (let
       ((open Bool
          (match (w_local_type w id)
            ((some t) (undeclared_in w t 4096))
            (none false))))
       (if open true (undeclared_locals w r))))))
(fn undeclared_in ((w W) (e Expr) (fuel Int)) Bool
  (measure (Int.natAbs fuel))
  (if (< fuel 1) false
  (match e
    ((Const _ n _)
     (match (env_find (w_env w) n)
       ((some _) false)
       (none true)))
    ((App _ f a) (bool_or (undeclared_in w f (- fuel 1)) (undeclared_in w a (- fuel 1))))
    ((Lam _ _ _ t b) (bool_or (undeclared_in w t (- fuel 1)) (undeclared_in w b (- fuel 1))))
    ((Pi _ _ _ t b) (bool_or (undeclared_in w t (- fuel 1)) (undeclared_in w b (- fuel 1))))
    ((Let _ _ t x b)
     (bool_or (undeclared_in w t (- fuel 1))
       (bool_or (undeclared_in w x (- fuel 1)) (undeclared_in w b (- fuel 1)))))
    ((Proj _ sn _ x)
     (bool_or
       (match (env_find (w_env w) sn)
         ((some _) false)
         (none true))
       (undeclared_in w x (- fuel 1))))
    (_ false))))
(fulfills undeclared_in.dec_1 (by (intro p h d f a hm) (apply natAbs_pred (arith))))
(fulfills undeclared_in.dec_2 (by (intro p h d n bi t b hm) (apply natAbs_pred (arith))))
(fulfills undeclared_in.dec_3 (by (intro p h d n bi t b hm) (apply natAbs_pred (arith))))
(fulfills undeclared_in.dec_4 (by (intro p h d n t x b hm) (apply natAbs_pred (arith))))
(fulfills undeclared_in.dec_5 (by (intro p h d sn i x hm) (apply natAbs_pred (arith))))

;; the tentative assignments validated (el_finish asks): each whose value has closed is typed
;; by K against its metavariable's type; the first that fails, by id. One K cannot type for a
;; constant still being declared stays the declaration's admission's to check
(fn tentative_bad ((w W) (mc MCtx)) (Option Int) (tentative_go w mc (mc_tentative mc)))
(fn tentative_go ((w W) (mc MCtx) (ids (List Int))) (Option Int)
  (measure (struct ids))
  (match ids
    (nil none)
    ((cons i r)
     (match (mc_assigned mc i)
       (none (tentative_go w mc r))
       ((some v0)
        (let ((v (inst_mvars mc v0)))
          (if (has_mvar v) (tentative_go w mc r)
          (match (w_infer_r w v)
            ((Prod.mk w1 (WFail _)) (if (cites_undeclared w1 v) (tentative_go w1 mc r) (some i)))
            ((Prod.mk w1 (WVal vty))
             (match (mc_decl mc i)
               (none (some i))
               ((some dcl)
                (match (unify_go w1 mc vty (md_type dcl) 64)
                  ((UYes _ _) (tentative_go w1 mc r))
                  (_ (some i))))))))))))))

;; the type of a term K cannot type yet (a metavariable inside): a constant,
;; a local or a metavariable head applied to arguments, its telescope
;; instantiated by them (Meta.inferType's shape); a sort; a literal; else None
;; and the assignment is tentative
(fn infer_light ((w W) (mc MCtx) (e Expr)) (Prod W (Option Expr))
  (let ((h (get_app_fn e)) (args (get_app_args e)))
    (match (head_type w mc h)
      ((Prod.mk w1 none) (Prod.mk w1 none))
      ((Prod.mk w1 (some hty)) (walk_args w1 mc hty args)))))
(fn head_type ((w W) (mc MCtx) (h Expr)) (Prod W (Option Expr))
  (match h
    ((Const _ n ls)
     (match (env_find (w_env w) n)
       (none (Prod.mk w none))
       ((some info)
        (match (w_inst_lparams w (ci_type info) (ci_lparams info) ls)
          ((Prod.mk w1 t) (Prod.mk w1 (some t)))))))
    ((FVar _ id) (Prod.mk w (w_local_type w id)))
    ((MVar _ i)
     (Prod.mk w
       (match (mc_decl mc i)
         ((some d) (some (inst_mvars mc (md_type d))))
         (none none))))
    ((Sort _ u) (Prod.mk w (some (mk_sort (LSucc u)))))
    ((Lit _ (LitNat _)) (Prod.mk w (some (mk_const (nm_nat) nil))))
    ((Lit _ (LitStr _)) (Prod.mk w (some (mk_const (nm_string) nil))))
    (_ (Prod.mk w none))))
(fn walk_args ((w W) (mc MCtx) (fty Expr) (args (List Expr))) (Prod W (Option Expr))
  (measure (struct args))
  (match args
    (nil (Prod.mk w (some fty)))
    ((cons a r)
     (match (inst_mvars mc fty)
       ((Pi _ _ _ _ body)
        (match (w_inst1 w body a)
          ((Prod.mk w1 b1) (walk_args w1 mc b1 r))))
       (t
         (match (w_whnf w t)
           ((Prod.mk w1 (some (Pi _ _ _ _ body)))
            (match (w_inst1 w1 body a)
              ((Prod.mk w2 b1) (walk_args w2 mc b1 r))))
           ((Prod.mk w1 _) (Prod.mk w1 none))))))))

;; a structural failure falls back (K on a closed pair, else whnf and one retry); a blocked
;; or exhausted sub-problem is the answer
(fn or_fallback ((r URes) (w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 2 0)
  (match r
    (UNo (unify_fallback w mc t s d))
    (other other)))
(fn unify_struct ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 3 0)
  (match t
    ((Sort _ u)
     (match s
       ((Sort _ v)
        (match (unify_level mc u v 64)
          ((some mc1) (UYes w mc1))
          (none UNo)))
       (_ (unify_fallback w mc t s d))))
    ((Const _ n ls)
     (match s
       ((Const _ m ms)
        (if (name_eq n m)
          (match (unify_levels mc ls ms)
            ((some mc1) (UYes w mc1))
            (none (unify_fallback w mc t s d)))
          (unify_fallback w mc t s d)))
       (_ (unify_fallback w mc t s d))))
    ((Lit _ a)
     (match s
       ((Lit _ b) (if (lit_eq a b) (UYes w mc) (unify_fallback w mc t s d)))
       (_ (unify_fallback w mc t s d))))
    ;; two applications are taken apart only while one of them holds something to solve. A
    ;; pair with no metavariable is K's whole (unify_fallback): descending would put its parts
    ;; to K one by one, and a part K must refute — two different functions as the heads, whose
    ;; bodies K then unfolds to the bottom of both — costs what the whole pair never does (K
    ;; unfolds the one side as far as the other's head)
    ((App _ _ _)
     (match s
       ((App _ _ _)
        (let ((fa (get_app_args t)) (sa (get_app_args s)))
          (if (bool_and (= (len fa) (len sa)) (bool_or (has_mvar t) (has_mvar s)))
            (match (unify_go w mc (get_app_fn t) (get_app_fn s) (- d 1))
              ((UYes w1 mc1) (or_fallback (unify_args w1 mc1 fa sa (- d 1)) w mc t s d))
              (other (or_fallback other w mc t s d)))
            (unify_fallback w mc t s d))))
       (_ (unify_fallback w mc t s d))))
    ((Lam _ n _ d1 b1)
     (match s
       ((Lam _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
       (_ (unify_fallback w mc t s d))))
    ((Pi _ n _ d1 b1)
     (match s
       ((Pi _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
       (_ (unify_fallback w mc t s d))))
    ((Proj _ sn i x)
     (match s
       ((Proj _ sn2 i2 y)
        (if (bool_and (name_eq sn sn2) (= i i2))
          (or_fallback (unify_go w mc x y (- d 1)) w mc t s d)
          (unify_fallback w mc t s d)))
       (_ (unify_fallback w mc t s d))))
    (_ (unify_fallback w mc t s d))))

(fn unify_args ((w W) (mc MCtx) (ts (List Expr)) (ss (List Expr)) (d Int)) URes
  (measure (Int.natAbs d) 1 (List.length ts))
  (match ts
    (nil (UYes w mc))
    ((cons a ar)
     (match ss
       (nil UNo)
       ((cons b br)
        (match (unify_go w mc a b d)
          ((UYes w1 mc1) (unify_args w1 mc1 ar br d))
          (other other)))))))

;; the domains, then the bodies under one shared local (not in any
;; metavariable's telescope: an assignment mentioning it is refused)
(fn unify_binding ((w W) (mc MCtx) (n Name) (d1 Expr) (b1 Expr) (d2 Expr) (b2 Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 1 0)
  (match (unify_go w mc d1 d2 (- d 1))
    ((UYes w1 mc1)
     (match (w_local w1 n (inst_mvars mc1 d1))
       ((Prod.mk w2 fv)
        (match (w_inst1 w2 b1 fv)
          ((Prod.mk w3 b1i)
           (match (w_inst1 w3 b2 fv)
             ((Prod.mk w4 b2i) (unify_go w4 mc1 b1i b2i (- d 1)))))))))
    (other other)))

;; closed on both sides: K decides — its refusal or `false` is UNo (never inequality),
;; its exhaustion UExhausted; else the one spelling first (a class method
;; under Init's instance read as its function on either side, so `0 &&& ?n` meets `Nat.land 0
;; b` structurally — K's whnf of the two would compute `Nat.land 0 b` to 0 and leave ?n open),
;; then whnf both through K and retry once on a change — the retry is what unfolds a
;; definition that hides a constructor or a Pi
(fn unify_fallback ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure (Int.natAbs (- d 1)) 1 0)
  (if (bool_and (bool_not (has_mvar t)) (bool_not (has_mvar s)))
    (match (w_is_def_eq_r w t s)
      ((Prod.mk w1 (WVal true)) (UYes w1 mc))
      ((Prod.mk _ (WVal false)) UNo)
      ((Prod.mk _ (WFail f))
       (match (failure_spent f)
         ((some site) (UExhausted site))
         (none UNo))))
    (let ((tc (sp_canon t)) (sc (sp_canon s)))
      (if (bool_or (bool_not (expr_eq tc t)) (bool_not (expr_eq sc s)))
        (unify_go w mc tc sc (- d 1))
        (match (w_whnf w t)
          ((Prod.mk w1 t1o)
           (match (w_whnf w1 s)
             ((Prod.mk w2 s1o)
              (let
                ((t1 Expr
                   (match t1o
                     ((some x) x)
                     (none t)))
                 (s1 Expr
                   (match s1o
                     ((some x) x)
                     (none s))))
                (if (bool_and (expr_eq t1 t) (expr_eq s1 s)) UNo
                (unify_after_whnf w2 mc t1 s1 (- d 1))))))))))))
;; after whnf: only the structural cases, never the fallback again on the same shapes
(fn unify_after_whnf ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure (Int.natAbs d) 0 0)
  (if (< d 1) (UExhausted (sym "unify_depth"))
  (if (expr_eq t s) (UYes w mc)
  (match t
    ((MVar _ i) (assign w mc i s d))
    (_
      (match s
        ((MVar _ j) (assign w mc j t d))
        (_
          (match t
            ((App _ _ _)
             (match s
               ((App _ _ _)
                (let ((fa (get_app_args t)) (sa (get_app_args s)))
                  (if (= (len fa) (len sa))
                    (match (unify_go w mc (get_app_fn t) (get_app_fn s) (- d 1))
                      ((UYes w1 mc1) (unify_args w1 mc1 fa sa (- d 1)))
                      (other other))
                    UNo)))
               (_ UNo)))
            ((Pi _ n _ d1 b1)
             (match s
               ((Pi _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
               (_ UNo)))
            ((Lam _ n _ d1 b1)
             (match s
               ((Lam _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
               (_ UNo)))
            ((Sort _ u)
             (match s
               ((Sort _ v)
                (match (unify_level mc u v 64)
                  ((some mc1) (UYes w mc1))
                  (none UNo)))
               (_ UNo)))
            ((Const _ n ls)
             (match s
               ((Const _ m ms)
                (if (name_eq n m)
                  (match (unify_levels mc ls ms)
                    ((some mc1) (UYes w mc1))
                    (none UNo))
                  UNo))
               (_ UNo)))
            (_ UNo)))))))))

;; ---- levels ------------------------------------------------------------------------------
(fn unify_level ((mc MCtx) (u0 Level) (v0 Level) (d Int)) (Option MCtx)
  (measure (Int.natAbs d))
  (if (< d 1) none
  (let ((u (inst_level mc u0)) (v (inst_level mc v0)))
    (if (level_eq u v) (some mc)
    (match u
      ((LMVar i) (lassign mc i v))
      (_
        (match v
          ((LMVar j) (lassign mc j u))
          (_
            (if (bool_and (bool_not (level_has_mvar u)) (bool_not (level_has_mvar v)))
              (if (is_equivalent u v) (some mc) none)
              ;; one side closed: in normal form, so `max 1 1` meets `succ ?u` (the type
              ;; of `(Prod Nat Nat)` where a `Type ?u` is expected — `(@List.nil (Prod Nat Nat))`)
              (if (bool_and (bool_not (level_has_mvar v)) (bool_not (level_eq (normalize v) v)))
                (unify_level mc u (normalize v) (- d 1))
              (if (bool_and (bool_not (level_has_mvar u)) (bool_not (level_eq (normalize u) u)))
                (unify_level mc (normalize u) v (- d 1))
                (match u
                  ((LSucc a)
                   (match v
                     ((LSucc b) (unify_level mc a b (- d 1)))
                     (_ none)))
                  ((LMax a b)
                   (match v
                     ((LMax a2 b2)
                      (match (unify_level mc a a2 (- d 1))
                        ((some mc1) (unify_level mc1 b b2 (- d 1)))
                        (none none)))
                     (_ none)))
                  ((LIMax a b)
                   (match v
                     ((LIMax a2 b2)
                      (match (unify_level mc a a2 (- d 1))
                        ((some mc1) (unify_level mc1 b b2 (- d 1)))
                        (none none)))
                     (_ none)))
                  (_ none)))))))))))))
(fn lassign ((mc MCtx) (i Int) (v Level)) (Option MCtx)
  (match v
    ((LMVar j) (if (= i j) (some mc) (some (mc_lset mc i v))))
    (_ (if (lmvar_occurs i v) none (some (mc_lset mc i v))))))
;; `unify_level` steps its depth at every call, past the test that it is at least 1
(fulfills unify_level.dec_1
  (by (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14) (apply natAbs_pred (arith))))
(fulfills unify_level.dec_2
  (by (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16) (apply natAbs_pred (arith))))
(fulfills unify_level.dec_3
  (by
    (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17)
    (apply natAbs_pred (arith))))
(fulfills unify_level.dec_4
  (by (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16) (apply natAbs_pred (arith))))
(fulfills unify_level.dec_5
  (by
    (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17)
    (apply natAbs_pred (arith))))
(fulfills unify_level.dec_6 (by (intro x1 x2 x3 x4 x5 x6 x7 x8 x9 x10) (apply natAbs_pred (arith))))
(fulfills unify_level.dec_7 (by (intro x1 x2 x3 x4 x5 x6 x7 x8 x9) (apply natAbs_pred (arith))))
(fn unify_levels ((mc MCtx) (us (List Level)) (vs (List Level))) (Option MCtx)
  (measure (struct us))
  (match us
    (nil
      (match vs
        (nil (some mc))
        (_ none)))
    ((cons u ur)
     (match vs
       (nil none)
       ((cons v vr)
        (match (unify_level mc u v 64)
          ((some mc1) (unify_levels mc1 ur vr))
          (none none)))))))
