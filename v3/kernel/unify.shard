;;; v3/kernel/unify.shard — metavariables and first-order unification for
;;; the elaborator (v3/LANGUAGE.md §8.4 slice 3.15; law §5.1 Stage 1, §6).
;;;
;;; A metavariable is an `MVar` node (expr.shard) with a declaration here:
;;; its type, the fvars in scope where it was made (its telescope — an
;;; assignment may mention no other local: the scope check), the binder
;;; name it stands for and a kind, for the refusal that names it when it
;;; stays unsolved. Assignments live in this state, never in a term K reads:
;;; `inst_mvars` (instantiate, Lean's instantiateMVars) replaces every
;;; assigned metavariable, and a declaration reaches K only through it.
;;;
;;; `unify` is first-order (law §5.1): structural descent assigning a
;;; metavariable on either side after an occurs check and the scope check;
;;; levels likewise, structurally, with `is_equivalent` on two closed levels;
;;; a closed mismatch (no metavariable on either side) is decided by K's own
;;; is_def_eq through the view, and a mismatch under a metavariable is
;;; retried once after K's whnf of both sides. It is transactional: a
;;; failure returns the state it was given. An over-eager assignment can
;;; never make a theorem — K rechecks the closed term — so incompleteness
;;; here costs a refusal with a pointer, never soundness.
;;;
;;; Outcomes (slice 3.16 rule 9, GPT-6 R67): `UYes`; `UNo` — this attempt
;;; failed, which is never inequality; `UStuck i` — blocked on the unassigned
;;; metavariable i (a non-pattern application of it), to retry after it is
;;; assigned; `UExhausted site` — the depth here or a resource of K's. An
;;; assignment is typed when its value's type was unified with the
;;; metavariable's, **tentative** when the value has a metavariable inside
;;; and no type could be given yet: the id is kept and `tentative_bad`
;;; validates it once the value has closed (el_finish asks). A closed value
;;; K refuses to type is never installed — unless it cites a constant the
;;; form is still declaring, which K cannot type before the admission.

(import "kw.shard")
(use kernel.k)
(use kernel.kw)
(use kernel.expr)
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.intmap.IntMap)
(use kernel.kw.W)
(use kernel.kw.WOut)
(use kernel.level.Level)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

;; a metavariable's declaration: the binder name it stands for, its type, the
;; fvar ids in scope at its creation, its kind (implicit, inst, numeral, hole)
(type MDecl (MDecl Name Expr (List Int) Symbol))
(fn md_name ((d MDecl)) Name (match d ((MDecl n _ _ _) n)))
(fn md_type ((d MDecl)) Expr (match d ((MDecl _ t _ _) t)))
(fn md_lctx ((d MDecl)) (List Int) (match d ((MDecl _ _ l _) l)))
(fn md_kind ((d MDecl)) Symbol (match d ((MDecl _ _ _ k) k)))

;; the state: next term id, next level id, the assignments, the level
;; assignments, the declarations, the ids in creation order, the tentatively
;; assigned ids
(type MCtx (MCtx Int Int (IntMap Expr) (IntMap Level) (IntMap MDecl) (List Int) (List Int)))
(fn mc0 () MCtx (MCtx 1 1 IMEmpty IMEmpty IMEmpty Nil Nil))
(fn mc_assigned ((mc MCtx) (i Int)) (Option Expr) (match mc ((MCtx _ _ a _ _ _ _) (im_find a i))))
(fn mc_lassigned ((mc MCtx) (i Int)) (Option Level) (match mc ((MCtx _ _ _ la _ _ _) (im_find la i))))
(fn mc_decl ((mc MCtx) (i Int)) (Option MDecl) (match mc ((MCtx _ _ _ _ ds _ _) (im_find ds i))))
(fn mc_ids ((mc MCtx)) (List Int) (match mc ((MCtx _ _ _ _ _ ids _) ids)))
(fn mc_fresh ((mc MCtx) (n Name) (ty Expr) (lctx (List Int)) (kind Symbol)) (Pair MCtx Expr)
  (match mc
    ((MCtx k lk a la ds ids tn)
     (Pair (MCtx (+ k 1) lk a la (im_insert ds k (MDecl n ty lctx kind)) (Cons k ids) tn) (mk_mvar k)))))
(fn mc_fresh_level ((mc MCtx)) (Pair MCtx Level)
  (match mc ((MCtx k lk a la ds ids tn) (Pair (MCtx k (+ lk 1) a la ds ids tn) (LMVar lk)))))
(fn mc_set ((mc MCtx) (i Int) (v Expr)) MCtx
  (match mc ((MCtx k lk a la ds ids tn) (MCtx k lk (im_insert a i v) la ds ids tn))))
(fn mc_lset ((mc MCtx) (i Int) (l Level)) MCtx
  (match mc ((MCtx k lk a la ds ids tn) (MCtx k lk a (im_insert la i l) ds ids tn))))
(fn mc_tentative ((mc MCtx)) (List Int) (match mc ((MCtx _ _ _ _ _ _ tn) tn)))
(fn mc_set_tentative ((mc MCtx) (i Int) (v Expr)) MCtx
  (match mc ((MCtx k lk a la ds ids tn) (MCtx k lk (im_insert a i v) la ds ids (Cons i tn)))))
(fn mc_set_decl ((mc MCtx) (i Int) (d MDecl)) MCtx
  (match mc ((MCtx k lk a la ds ids tn) (MCtx k lk a la (im_insert ds i d) ids tn))))
;; closing binders over the fvars `ids`: every unassigned metavariable loses
;; them from its telescope, so a later assignment cannot capture a variable
;; that is no longer in scope (Lean's delayed assignment, refused instead)
(fn mc_drop_fvars ((mc MCtx) (ids (List Int))) MCtx (drop_fvars_go mc (mc_ids mc) ids))
(fn drop_fvars_go ((mc MCtx) (ms (List Int)) (ids (List Int))) MCtx
  (measure (struct ms))
  (match ms
    (Nil mc)
    ((Cons m r)
     (drop_fvars_go
       (match (mc_assigned mc m)
         ((Some _) mc)
         (None (match (mc_decl mc m)
                 ((Some (MDecl n t l k)) (mc_set_decl mc m (MDecl n t (remove_ints l ids) k)))
                 (None mc))))
       r ids))))
(fn remove_ints ((xs (List Int)) (ids (List Int))) (List Int)
  (measure (struct xs))
  (match xs (Nil Nil) ((Cons x r) (if (mem_int x ids) (remove_ints r ids) (Cons x (remove_ints r ids))))))

;; ---- instantiation (instantiateMVars) ------------------------------------------------
(fn inst_level ((mc MCtx) (l Level)) Level (inst_level_go mc l 1000))
(fn inst_level_go ((mc MCtx) (l Level) (d Int)) Level
  (measure d)
  (if (lt d 1) l
  (if (bool_not (level_has_mvar l)) l
  (match l
    ((LMVar i) (match (mc_lassigned mc i) ((Some v) (inst_level_go mc v (- d 1))) (None l)))
    ((LSucc x) (LSucc (inst_level_go mc x (- d 1))))
    ((LMax x y) (LMax (inst_level_go mc x (- d 1)) (inst_level_go mc y (- d 1))))
    ((LIMax x y) (LIMax (inst_level_go mc x (- d 1)) (inst_level_go mc y (- d 1))))
    (_ l)))))
(fn inst_levels ((mc MCtx) (ls (List Level))) (List Level)
  (measure (struct ls))
  (match ls (Nil Nil) ((Cons l r) (Cons (inst_level mc l) (inst_levels mc r)))))
(fn inst_mvars ((mc MCtx) (e Expr)) Expr (inst_go mc e 100000))
(fn inst_go ((mc MCtx) (e Expr) (d Int)) Expr
  (measure d)
  (if (lt d 1) e
  (if (bool_not (has_mvar e)) e
  (match e
    ((MVar _ i) (match (mc_assigned mc i) ((Some v) (inst_go mc v (- d 1))) (None e)))
    ((Sort _ u) (mk_sort (inst_level mc u)))
    ((Const _ n ls) (mk_const n (inst_levels mc ls)))
    ((App _ f a) (mk_app (inst_go mc f (- d 1)) (inst_go mc a (- d 1))))
    ((Lam _ n bi t b) (mk_lam n bi (inst_go mc t (- d 1)) (inst_go mc b (- d 1))))
    ((Pi _ n bi t b) (mk_pi n bi (inst_go mc t (- d 1)) (inst_go mc b (- d 1))))
    ((Let _ n t v b) (mk_let n (inst_go mc t (- d 1)) (inst_go mc v (- d 1)) (inst_go mc b (- d 1))))
    ((Proj _ s i x) (mk_proj s i (inst_go mc x (- d 1))))
    (_ e)))))
(fn inst_all ((mc MCtx) (es (List Expr))) (List Expr)
  (measure (struct es))
  (match es (Nil Nil) ((Cons e r) (Cons (inst_mvars mc e) (inst_all mc r)))))

;; ---- the unsolved ----------------------------------------------------------------------
;; the first unassigned metavariable of an instantiated term, and the first level one
(fn first_mvar ((e Expr)) (Option Int)
  (measure (struct e))
  (if (bool_not (has_mvar e)) None
  (match e
    ((MVar _ i) (Some i))
    ((App _ f a) (match (first_mvar f) ((Some i) (Some i)) (None (first_mvar a))))
    ((Lam _ _ _ t b) (match (first_mvar t) ((Some i) (Some i)) (None (first_mvar b))))
    ((Pi _ _ _ t b) (match (first_mvar t) ((Some i) (Some i)) (None (first_mvar b))))
    ((Let _ _ t v b) (match (first_mvar t) ((Some i) (Some i)) (None (match (first_mvar v) ((Some i) (Some i)) (None (first_mvar b))))))
    ((Proj _ _ _ x) (first_mvar x))
    (_ None))))
(fn first_lmvar ((e Expr)) (Option Int)
  (measure (struct e))
  (if (bool_not (has_mvar e)) None
  (match e
    ((Sort _ u) (level_first_mvar u))
    ((Const _ _ ls) (levels_first_mvar ls))
    ((App _ f a) (match (first_lmvar f) ((Some i) (Some i)) (None (first_lmvar a))))
    ((Lam _ _ _ t b) (match (first_lmvar t) ((Some i) (Some i)) (None (first_lmvar b))))
    ((Pi _ _ _ t b) (match (first_lmvar t) ((Some i) (Some i)) (None (first_lmvar b))))
    ((Let _ _ t v b) (match (first_lmvar t) ((Some i) (Some i)) (None (match (first_lmvar v) ((Some i) (Some i)) (None (first_lmvar b))))))
    ((Proj _ _ _ x) (first_lmvar x))
    (_ None))))
(fn level_first_mvar ((l Level)) (Option Int)
  (measure (struct l))
  (match l
    ((LMVar i) (Some i))
    ((LSucc x) (level_first_mvar x))
    ((LMax x y) (match (level_first_mvar x) ((Some i) (Some i)) (None (level_first_mvar y))))
    ((LIMax x y) (match (level_first_mvar x) ((Some i) (Some i)) (None (level_first_mvar y))))
    (_ None)))
(fn levels_first_mvar ((ls (List Level))) (Option Int)
  (measure (struct ls))
  (match ls (Nil None) ((Cons l r) (match (level_first_mvar l) ((Some i) (Some i)) (None (levels_first_mvar r))))))

;; ---- occurrence and scope ----------------------------------------------------------------
(fn mvar_occurs ((i Int) (e Expr)) Bool
  (measure (struct e))
  (if (bool_not (has_mvar e)) False
  (match e
    ((MVar _ j) (int_eq i j))
    ((App _ f a) (bool_or (mvar_occurs i f) (mvar_occurs i a)))
    ((Lam _ _ _ t b) (bool_or (mvar_occurs i t) (mvar_occurs i b)))
    ((Pi _ _ _ t b) (bool_or (mvar_occurs i t) (mvar_occurs i b)))
    ((Let _ _ t v b) (bool_or (mvar_occurs i t) (bool_or (mvar_occurs i v) (mvar_occurs i b))))
    ((Proj _ _ _ x) (mvar_occurs i x))
    (_ False))))
(fn lmvar_occurs ((i Int) (l Level)) Bool
  (measure (struct l))
  (match l
    ((LMVar j) (int_eq i j))
    ((LSucc x) (lmvar_occurs i x))
    ((LMax x y) (bool_or (lmvar_occurs i x) (lmvar_occurs i y)))
    ((LIMax x y) (bool_or (lmvar_occurs i x) (lmvar_occurs i y)))
    (_ False)))
;; the fvar ids of a term
(fn expr_fvars ((e Expr) (acc (List Int))) (List Int)
  (measure (struct e))
  (if (bool_not (has_fvar e)) acc
  (match e
    ((FVar _ id) (Cons id acc))
    ((App _ f a) (expr_fvars f (expr_fvars a acc)))
    ((Lam _ _ _ t b) (expr_fvars t (expr_fvars b acc)))
    ((Pi _ _ _ t b) (expr_fvars t (expr_fvars b acc)))
    ((Let _ _ t v b) (expr_fvars t (expr_fvars v (expr_fvars b acc))))
    ((Proj _ _ _ x) (expr_fvars x acc))
    (_ acc))))
(fn all_in ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs (Nil True) ((Cons x r) (if (mem_int x ys) (all_in r ys) False))))

;; ---- unification -------------------------------------------------------------------------
(type URes (UYes W MCtx) (UNo) (UStuck Int) (UExhausted Symbol))

;; transactional: a failure hands back nothing new
(fn unify ((w W) (mc MCtx) (t Expr) (s Expr)) URes (unify_go w mc t s 64))
(fn unify_depth ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes (unify_go w mc t s d))

(fn unify_go ((w W) (mc MCtx) (t0 Expr) (s0 Expr) (d Int)) URes
  (measure d)
  (if (lt d 1) (UExhausted (quote unify_depth))
  (let ((t (inst_mvars mc t0)) (s (inst_mvars mc s0)))
    (if (expr_eq t s) (UYes w mc)
    (match t
      ((MVar _ i) (assign w mc i s d))
      (_
       (match s
         ((MVar _ j) (assign w mc j t d))
         (_
          (match (pattern_of t)
            ((Some (Pair i xs)) (assign_pattern w mc i xs s d))
            (None
             (match (pattern_of s)
               ((Some (Pair j ys)) (assign_pattern w mc j ys t d))
               (None (stuck_or (unify_struct w mc t s d) t s)))))))))))))
;; a failure under an unassigned metavariable applied to something that is no pattern is
;; blocked on it, not refuted
(fn stuck_or ((r URes) (t Expr) (s Expr)) URes
  (match r
    (UNo (match (flex_head t) ((Some i) (UStuck i)) (None (match (flex_head s) ((Some i) (UStuck i)) (None UNo)))))
    (other other)))
(fn flex_head ((e Expr)) (Option Int)
  (match e ((App _ _ _) (match (get_app_fn e) ((MVar _ i) (Some i)) (_ None))) (_ None)))

;; a Miller pattern: a metavariable applied to distinct locals — `?motive t` against `Bool`
;; assigns `?motive := λ t. Bool` (the case a recursor's implicit motive needs, from the
;; expected type); the locals abstracted by K's mk_binding, the scope check on what remains
(fn pattern_of ((e Expr)) (Option (Pair Int (List Expr)))
  (match e
    ((App _ _ _)
     (match (get_app_fn e)
       ((MVar _ i) (let ((xs (get_app_args e))) (if (bool_and (all_fvars xs) (distinct_fvars xs Nil)) (Some (Pair i xs)) None)))
       (_ None)))
    (_ None)))
(fn all_fvars ((xs (List Expr))) Bool
  (measure (struct xs))
  (match xs (Nil True) ((Cons (FVar _ _) r) (all_fvars r)) (_ False)))
(fn distinct_fvars ((xs (List Expr)) (seen (List Int))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons (FVar _ id) r) (if (mem_int id seen) False (distinct_fvars r (Cons id seen))))
    ((Cons _ r) (distinct_fvars r seen))))
(fn assign_pattern ((w W) (mc MCtx) (i Int) (xs (List Expr)) (v Expr) (d Int)) URes
  (if (mvar_occurs i v) UNo
    (match (w_lams w xs v)
      ((Pair w1 lam) (assign w1 mc i lam d)))))

;; ?i := v: the same metavariable is trivial; an occurrence refuses; a local
;; outside the telescope refuses; the assignment is typed — the value's type
;; (K's, when the value is closed enough for K to type) against the
;; metavariable's, which is where a universe is inferred (`?α := α` with
;; `?α : Sort ?v` and `α : Sort u` gives `?v := u`). A closed value K refuses
;; is refused here; one K cannot type *yet* — a metavariable inside, or a
;; constant the form is still declaring — is typed by the light walk, else
;; installed tentatively
(fn assign ((w W) (mc MCtx) (i Int) (v Expr) (d Int)) URes
  (match v
    ((MVar _ j) (if (int_eq i j) (UYes w mc) (assign_checked w mc i v d)))
    (_ (assign_checked w mc i v d))))
(fn assign_checked ((w W) (mc MCtx) (i Int) (v Expr) (d Int)) URes
  (if (mvar_occurs i v) UNo
  (match (mc_decl mc i)
    (None UNo)
    ((Some dcl)
     (if (bool_not (all_in (expr_fvars v Nil) (md_lctx dcl))) UNo
     (if (has_mvar v) (assign_light w mc i v dcl d)
       (match (w_infer_r w v)
         ((Pair w1 (WVal vty)) (assign_typed w1 mc i v vty dcl d))
         ((Pair w1 (WFail f))
          (match (failure_spent f)
            ((Some site) (UExhausted site))
            (None (if (cites_undeclared w1 v) (assign_light w1 mc i v dcl d) UNo)))))))))))
(fn assign_light ((w W) (mc MCtx) (i Int) (v Expr) (dcl MDecl) (d Int)) URes
  (match (infer_light w mc v)
    ((Pair w1 None) (UYes w1 (mc_set_tentative mc i v)))
    ((Pair w1 (Some vty)) (assign_typed w1 mc i v vty dcl d))))
(fn assign_typed ((w W) (mc MCtx) (i Int) (v Expr) (vty Expr) (dcl MDecl) (d Int)) URes
  (match (unify_go w mc vty (md_type dcl) (- d 1))
    ((UYes w2 mc2) (UYes w2 (mc_set mc2 i v)))
    (other other)))
;; does the term cite a constant the environment does not hold — directly, as a projection's
;; structure, or in the type of one of its locals? Then the form is still declaring it (an
;; inductive's own name in its constructors, a structure's in its projections) and K's
;; refusal to type the term says nothing yet: the declaration's admission checks it
(fn cites_undeclared ((w W) (v Expr)) Bool
  (bool_or (undeclared_in w v 4096) (undeclared_locals w (expr_fvars v Nil))))
(fn undeclared_locals ((w W) (ids (List Int))) Bool
  (measure (struct ids))
  (match ids
    (Nil False)
    ((Cons id r) (if (match (w_local_type w id) ((Some t) (undeclared_in w t 4096)) (None False)) True (undeclared_locals w r)))))
(fn undeclared_in ((w W) (e Expr) (fuel Int)) Bool
  (measure fuel)
  (if (lt fuel 1) False
  (match e
    ((Const _ n _) (match (env_find (w_env w) n) ((Some _) False) (None True)))
    ((App _ f a) (bool_or (undeclared_in w f (- fuel 1)) (undeclared_in w a (- fuel 1))))
    ((Lam _ _ _ t b) (bool_or (undeclared_in w t (- fuel 1)) (undeclared_in w b (- fuel 1))))
    ((Pi _ _ _ t b) (bool_or (undeclared_in w t (- fuel 1)) (undeclared_in w b (- fuel 1))))
    ((Let _ _ t x b) (bool_or (undeclared_in w t (- fuel 1)) (bool_or (undeclared_in w x (- fuel 1)) (undeclared_in w b (- fuel 1)))))
    ((Proj _ sn _ x) (bool_or (match (env_find (w_env w) sn) ((Some _) False) (None True)) (undeclared_in w x (- fuel 1))))
    (_ False))))

;; the tentative assignments validated (el_finish asks): each whose value has closed is typed
;; by K against its metavariable's type; the first that fails, by id. One K cannot type for a
;; constant still being declared stays the declaration's admission's to check
(fn tentative_bad ((w W) (mc MCtx)) (Option Int) (tentative_go w mc (mc_tentative mc)))
(fn tentative_go ((w W) (mc MCtx) (ids (List Int))) (Option Int)
  (measure (struct ids))
  (match ids
    (Nil None)
    ((Cons i r)
     (match (mc_assigned mc i)
       (None (tentative_go w mc r))
       ((Some v0)
        (let ((v (inst_mvars mc v0)))
          (if (has_mvar v) (tentative_go w mc r)
            (match (w_infer_r w v)
              ((Pair w1 (WFail _)) (if (cites_undeclared w1 v) (tentative_go w1 mc r) (Some i)))
              ((Pair w1 (WVal vty))
               (match (mc_decl mc i)
                 (None (Some i))
                 ((Some dcl)
                  (match (unify_go w1 mc vty (md_type dcl) 64)
                    ((UYes _ _) (tentative_go w1 mc r))
                    (_ (Some i))))))))))))))

;; the type of a term K cannot type yet (a metavariable inside): a constant,
;; a local or a metavariable head applied to arguments, its telescope
;; instantiated by them (Meta.inferType's shape); a sort; a literal; else None
;; and the assignment is tentative
(fn infer_light ((w W) (mc MCtx) (e Expr)) (Pair W (Option Expr))
  (let ((h (get_app_fn e)) (args (get_app_args e)))
    (match (head_type w mc h)
      ((Pair w1 None) (Pair w1 None))
      ((Pair w1 (Some hty)) (walk_args w1 mc hty args)))))
(fn head_type ((w W) (mc MCtx) (h Expr)) (Pair W (Option Expr))
  (match h
    ((Const _ n ls)
     (match (env_find (w_env w) n)
       (None (Pair w None))
       ((Some info) (match (w_inst_lparams w (ci_type info) (ci_lparams info) ls) ((Pair w1 t) (Pair w1 (Some t)))))))
    ((FVar _ id) (Pair w (w_local_type w id)))
    ((MVar _ i) (Pair w (match (mc_decl mc i) ((Some d) (Some (inst_mvars mc (md_type d)))) (None None))))
    ((Sort _ u) (Pair w (Some (mk_sort (LSucc u)))))
    ((Lit _ (LitNat _)) (Pair w (Some (mk_const (nm_nat) Nil))))
    ((Lit _ (LitStr _)) (Pair w (Some (mk_const (nm_string) Nil))))
    (_ (Pair w None))))
(fn walk_args ((w W) (mc MCtx) (fty Expr) (args (List Expr))) (Pair W (Option Expr))
  (measure (struct args))
  (match args
    (Nil (Pair w (Some fty)))
    ((Cons a r)
     (match (inst_mvars mc fty)
       ((Pi _ _ _ _ body) (match (w_inst1 w body a) ((Pair w1 b1) (walk_args w1 mc b1 r))))
       (t
        (match (w_whnf w t)
          ((Pair w1 (Some (Pi _ _ _ _ body))) (match (w_inst1 w1 body a) ((Pair w2 b1) (walk_args w2 mc b1 r))))
          ((Pair w1 _) (Pair w1 None))))))))

;; a structural failure falls back (K on a closed pair, else whnf and one retry); a blocked
;; or exhausted sub-problem is the answer
(fn or_fallback ((r URes) (w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (match r (UNo (unify_fallback w mc t s d)) (other other)))
(fn unify_struct ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure d)
  (match t
    ((Sort _ u) (match s ((Sort _ v) (match (unify_level mc u v 64) ((Some mc1) (UYes w mc1)) (None UNo))) (_ (unify_fallback w mc t s d))))
    ((Const _ n ls)
     (match s
       ((Const _ m ms) (if (name_eq n m) (match (unify_levels mc ls ms) ((Some mc1) (UYes w mc1)) (None (unify_fallback w mc t s d))) (unify_fallback w mc t s d)))
       (_ (unify_fallback w mc t s d))))
    ((Lit _ a) (match s ((Lit _ b) (if (lit_eq a b) (UYes w mc) (unify_fallback w mc t s d))) (_ (unify_fallback w mc t s d))))
    ((App _ _ _)
     (match s
       ((App _ _ _)
        (let ((fa (get_app_args t)) (sa (get_app_args s)))
          (if (int_eq (len fa) (len sa))
            (match (unify_go w mc (get_app_fn t) (get_app_fn s) (- d 1))
              ((UYes w1 mc1) (or_fallback (unify_args w1 mc1 fa sa (- d 1)) w mc t s d))
              (other (or_fallback other w mc t s d)))
            (unify_fallback w mc t s d))))
       (_ (unify_fallback w mc t s d))))
    ((Lam _ n _ d1 b1)
     (match s
       ((Lam _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
       (_ (unify_fallback w mc t s d))))
    ((Pi _ n _ d1 b1)
     (match s
       ((Pi _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d))
       (_ (unify_fallback w mc t s d))))
    ((Proj _ sn i x)
     (match s
       ((Proj _ sn2 i2 y) (if (bool_and (name_eq sn sn2) (int_eq i i2)) (or_fallback (unify_go w mc x y (- d 1)) w mc t s d) (unify_fallback w mc t s d)))
       (_ (unify_fallback w mc t s d))))
    (_ (unify_fallback w mc t s d))))

(fn unify_args ((w W) (mc MCtx) (ts (List Expr)) (ss (List Expr)) (d Int)) URes
  (measure (struct ts))
  (match ts
    (Nil (UYes w mc))
    ((Cons a ar)
     (match ss
       (Nil UNo)
       ((Cons b br)
        (match (unify_go w mc a b d)
          ((UYes w1 mc1) (unify_args w1 mc1 ar br d))
          (other other)))))))

;; the domains, then the bodies under one shared local (not in any
;; metavariable's telescope: an assignment mentioning it is refused)
(fn unify_binding ((w W) (mc MCtx) (n Name) (d1 Expr) (b1 Expr) (d2 Expr) (b2 Expr) (d Int)) URes
  (measure d)
  (match (unify_go w mc d1 d2 (- d 1))
    ((UYes w1 mc1)
     (match (w_local w1 n (inst_mvars mc1 d1))
       ((Pair w2 fv)
        (match (w_inst1 w2 b1 fv)
          ((Pair w3 b1i)
           (match (w_inst1 w3 b2 fv)
             ((Pair w4 b2i) (unify_go w4 mc1 b1i b2i (- d 1)))))))))
    (other other)))

;; closed on both sides: K decides — its refusal or `false` is UNo (never inequality: §3.3),
;; its exhaustion UExhausted; else whnf both through K and retry once on a change — the
;; retry is what unfolds a definition that hides a constructor or a Pi
(fn unify_fallback ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure d)
  (if (bool_and (bool_not (has_mvar t)) (bool_not (has_mvar s)))
    (match (w_is_def_eq_r w t s)
      ((Pair w1 (WVal True)) (UYes w1 mc))
      ((Pair _ (WVal False)) UNo)
      ((Pair _ (WFail f)) (match (failure_spent f) ((Some site) (UExhausted site)) (None UNo))))
    (match (w_whnf w t)
      ((Pair w1 t1o)
       (match (w_whnf w1 s)
         ((Pair w2 s1o)
          (let ((t1 (match t1o ((Some x) x) (None t))) (s1 (match s1o ((Some x) x) (None s))))
            (if (bool_and (expr_eq t1 t) (expr_eq s1 s)) UNo
              (unify_after_whnf w2 mc t1 s1 (- d 1))))))))))
;; after whnf: only the structural cases, never the fallback again on the same shapes
(fn unify_after_whnf ((w W) (mc MCtx) (t Expr) (s Expr) (d Int)) URes
  (measure d)
  (if (lt d 1) (UExhausted (quote unify_depth))
  (if (expr_eq t s) (UYes w mc)
  (match t
    ((MVar _ i) (assign w mc i s d))
    (_ (match s
         ((MVar _ j) (assign w mc j t d))
         (_ (match t
              ((App _ _ _)
               (match s
                 ((App _ _ _)
                  (let ((fa (get_app_args t)) (sa (get_app_args s)))
                    (if (int_eq (len fa) (len sa))
                      (match (unify_go w mc (get_app_fn t) (get_app_fn s) (- d 1))
                        ((UYes w1 mc1) (unify_args w1 mc1 fa sa (- d 1)))
                        (other other))
                      UNo)))
                 (_ UNo)))
              ((Pi _ n _ d1 b1) (match s ((Pi _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d)) (_ UNo)))
              ((Lam _ n _ d1 b1) (match s ((Lam _ _ _ d2 b2) (unify_binding w mc n d1 b1 d2 b2 d)) (_ UNo)))
              ((Sort _ u) (match s ((Sort _ v) (match (unify_level mc u v 64) ((Some mc1) (UYes w mc1)) (None UNo))) (_ UNo)))
              ((Const _ n ls) (match s ((Const _ m ms) (if (name_eq n m) (match (unify_levels mc ls ms) ((Some mc1) (UYes w mc1)) (None UNo)) UNo)) (_ UNo)))
              (_ UNo)))))))))

;; ---- levels ------------------------------------------------------------------------------
(fn unify_level ((mc MCtx) (u0 Level) (v0 Level) (d Int)) (Option MCtx)
  (measure d)
  (if (lt d 1) None
  (let ((u (inst_level mc u0)) (v (inst_level mc v0)))
    (if (level_eq u v) (Some mc)
    (match u
      ((LMVar i) (lassign mc i v))
      (_
       (match v
         ((LMVar j) (lassign mc j u))
         (_
          (if (bool_and (bool_not (level_has_mvar u)) (bool_not (level_has_mvar v)))
            (if (is_equivalent u v) (Some mc) None)
          (match u
            ((LSucc a) (match v ((LSucc b) (unify_level mc a b (- d 1))) (_ None)))
            ((LMax a b) (match v ((LMax a2 b2) (match (unify_level mc a a2 (- d 1)) ((Some mc1) (unify_level mc1 b b2 (- d 1))) (None None))) (_ None)))
            ((LIMax a b) (match v ((LIMax a2 b2) (match (unify_level mc a a2 (- d 1)) ((Some mc1) (unify_level mc1 b b2 (- d 1))) (None None))) (_ None)))
            (_ None)))))))))))
(fn lassign ((mc MCtx) (i Int) (v Level)) (Option MCtx)
  (match v
    ((LMVar j) (if (int_eq i j) (Some mc) (Some (mc_lset mc i v))))
    (_ (if (lmvar_occurs i v) None (Some (mc_lset mc i v))))))
(fn unify_levels ((mc MCtx) (us (List Level)) (vs (List Level))) (Option MCtx)
  (measure (struct us))
  (match us
    (Nil (match vs (Nil (Some mc)) (_ None)))
    ((Cons u ur)
     (match vs
       (Nil None)
       ((Cons v vr) (match (unify_level mc u v 64) ((Some mc1) (unify_levels mc1 ur vr)) (None None)))))))
