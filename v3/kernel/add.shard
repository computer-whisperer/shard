;;; v3/kernel/add.shard — `check(env, decl, limits)` (FOUNDATION §3.3):
;;; environment-level admission after src/kernel/environment.cpp
;;; (`environment::add_*`, l. 127–262) and quot.cpp (`add_quot`, l. 40).
;;; The standard profile (§3.2) admits `Safe` declarations only: unsafe /
;;; partial declarations and mutual definition blocks are Unsupported.

(import "nested.shard")
(import "accel_pins.shard")

(fn nm_quot () Name (n1 (quote Quot)))
(fn nm_eq () Name (n1 (quote Eq)))
(fn nm_eq_refl () Name (n2 (quote Eq) (quote refl)))

(fn cv_name ((v ConstantVal)) Name (match v ((ConstantVal n _ _) n)))
(fn cv_lparams ((v ConstantVal)) (List Name) (match v ((ConstantVal _ ps _) ps)))
(fn cv_type ((v ConstantVal)) Expr (match v ((ConstantVal _ _ t) t)))

;; the limits of §3.3: recursion depth and heartbeats
(type Limits (Limits Int Int))
(fn lim_depth ((l Limits)) Int (match l ((Limits d _) d)))
(fn lim_ticks ((l Limits)) Int (match l ((Limits _ t) t)))
(fn default_limits () Limits (Limits (budget_depth) (budget_ticks)))

(fn ctx_for ((env CheckedEnv) (ps (List Name)) (safety DefinitionSafety) (lim Limits)) Ctx
  (Ctx env Nil (Some ps) safety False (lim_ticks lim)))

;; check_constant_val (environment.cpp l. 127): name free, level params
;; distinct, no fvar in the type, the type checks and is a sort
(fn check_constant_val ((env CheckedEnv) (st St) (v ConstantVal) (safety DefinitionSafety) (lim Limits)) (KRes Int)
  (match (env_check_name env (cv_name v))
    ((Some f) (KFail f))
    (None
     (if (bool_not (check_duplicated_univ_params (cv_lparams v))) (KFail (FRej (RuleViolation (quote duplicate_univ_param))))
     (if (has_fvar (cv_type v)) (KFail (FRej (Malformed (quote fvar_in_type))))
     (match (infer (ctx_for env (cv_lparams v) safety lim) st (lim_depth lim) (cv_type v) False)
       ((KFail f) (KFail f))
       ((KOk st1 s)
        (match (ensure_sort (ctx_for env (cv_lparams v) safety lim) st1 (lim_depth lim) s)
          ((KFail f) (KFail f))
          ((KOk st2 _) (KOk st2 0))))))))))

;; a value checks and its type is definitionally the declared type
(fn check_value ((env CheckedEnv) (st St) (v ConstantVal) (value Expr) (safety DefinitionSafety) (lim Limits)) (KRes Int)
  (if (has_fvar value) (KFail (FRej (Malformed (quote fvar_in_value))))
  (match (infer (ctx_for env (cv_lparams v) safety lim) st (lim_depth lim) value False)
    ((KFail f) (KFail f))
    ((KOk st1 vty)
     (match (is_def_eq (ctx_for env (cv_lparams v) safety lim) st1 (lim_depth lim) vty (cv_type v))
       ((KFail f) (KFail f))
       ((KOk st2 ok) (if ok (KOk st2 0) (KFail (FRej (ConversionNotEstablished))))))))))

;; the four quotient constants (quot.cpp l. 40–95), levels u and v; built
;; once, anonymous, with explicit de Bruijn indices
(fn quot_u () Level (LParam (n1 (quote u))))
(fn quot_v () Level (LParam (n1 (quote v))))
;; α → α → Prop for the α bound just outside: (x : #0) → (y : #1) → Prop
(fn rel_type () Expr
  (mk_pi (n1 (quote x)) BDefault (mk_bvar 0) (mk_pi (n1 (quote y)) BDefault (mk_bvar 1) (mk_sort LZero))))

(fn quot_type () Expr
  (mk_pi (n1 (quote a)) BImplicit (mk_sort (quot_u)) (mk_pi (n1 (quote r)) BDefault (rel_type) (mk_sort (quot_u)))))

(fn quot_mk_type () Expr
  (mk_pi (n1 (quote a)) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (quote r)) BDefault (rel_type)
      (mk_pi (n1 (quote a)) BDefault (mk_bvar 1) (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 2)) (mk_bvar 1))))))

(fn quot_lift_type () Expr
  (mk_pi (n1 (quote a)) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (quote r)) BImplicit (rel_type)
      (mk_pi (n1 (quote b)) BImplicit (mk_sort (quot_v))
        (mk_pi (n1 (quote f)) BDefault (mk_pi (n1 (quote x)) BDefault (mk_bvar 2) (mk_bvar 1))
          (mk_pi (n1 (quote h)) BDefault
            (mk_pi (n1 (quote a)) BDefault (mk_bvar 3)
              (mk_pi (n1 (quote b)) BDefault (mk_bvar 4)
                (mk_pi (n1 (quote h)) BDefault (mk_app (mk_app (mk_bvar 4) (mk_bvar 1)) (mk_bvar 0))
                  (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (quot_v))) (mk_bvar 4)) (mk_app (mk_bvar 3) (mk_bvar 2))) (mk_app (mk_bvar 3) (mk_bvar 1))))))
            (mk_pi (n1 (quote q)) BDefault (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 4)) (mk_bvar 3)) (mk_bvar 3))))))))

(fn quot_ind_type () Expr
  (mk_pi (n1 (quote a)) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (quote r)) BImplicit (rel_type)
      (mk_pi (n1 (quote b)) BImplicit (mk_pi (n1 (quote q)) BDefault (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 1)) (mk_bvar 0)) (mk_sort LZero))
        (mk_pi (n1 (quote mk)) BDefault
          (mk_pi (n1 (quote a)) BDefault (mk_bvar 2) (mk_app (mk_bvar 1) (mk_app (mk_app (mk_app (mk_const (nm_quot_mk) (list (quot_u))) (mk_bvar 3)) (mk_bvar 2)) (mk_bvar 0))))
          (mk_pi (n1 (quote q)) BDefault (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 3)) (mk_bvar 2)) (mk_app (mk_bvar 2) (mk_bvar 0))))))))

;; check_eq_type (quot.cpp l. 13): Eq is an inductive with one level
;; parameter u, one constructor, type {α : Sort u} → α → α → Prop, and
;; Eq.refl : ∀ {α : Sort u} (a : α), Eq α a a — structurally
(fn check_eq_type ((env CheckedEnv)) Bool
  (match (env_find env (nm_eq))
    ((Some (InductInfo (ConstantVal _ (Cons up Nil) ty) _ _ _ (Cons ctor Nil) _ _ _ _))
     (let ((u (LParam up)))
       (if (bool_not (expr_eq ty (mk_pi (n1 (quote a)) BImplicit (mk_sort u) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0) (mk_pi (n1 (quote b)) BDefault (mk_bvar 1) (mk_sort LZero)))))) False
       (match (env_find env ctor)
         ((Some (CtorInfo (ConstantVal _ (Cons cp Nil) cty) _ _ _ _ _))
          (expr_eq cty (mk_pi (n1 (quote a)) BImplicit (mk_sort (LParam cp)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0)
                          (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (LParam cp))) (mk_bvar 1)) (mk_bvar 0)) (mk_bvar 0))))))
         (_ False)))))
    (_ False)))

(fn add_quot ((env CheckedEnv) (st St)) (KRes CheckedEnv)
  (if (env_quot_init env) (KOk st env)
  (if (bool_not (check_eq_type env)) (KFail (FRej (RuleViolation (quote quot_eq_shape))))
  (match (env_check_name env (nm_quot))
    ((Some f) (KFail f))
    (None
     (match (env_check_name env (nm_quot_mk))
       ((Some f) (KFail f))
       (None
        (match (env_check_name env (nm_quot_lift))
          ((Some f) (KFail f))
          (None
           (match (env_check_name env (nm_quot_ind))
             ((Some f) (KFail f))
             (None
              (let ((u (list (n1 (quote u)))) (uv (list (n1 (quote u)) (n1 (quote v)))))
                (match (env_add (env_add (env_add (env_add env
                          (nm_quot) (QuotInfo (ConstantVal (nm_quot) u (quot_type)) QType))
                          (nm_quot_mk) (QuotInfo (ConstantVal (nm_quot_mk) u (quot_mk_type)) QCtor))
                          (nm_quot_lift) (QuotInfo (ConstantVal (nm_quot_lift) uv (quot_lift_type)) QLift))
                          (nm_quot_ind) (QuotInfo (ConstantVal (nm_quot_ind) u (quot_ind_type)) QInd))
                  ((CheckedEnv xs _ p w) (KOk st (CheckedEnv xs True p w))))))))))))))))

;; environment::add (l. 262) — the procedure of §3.3
(fn check_decl ((env CheckedEnv) (st St) (d Declaration)) (KRes CheckedEnv)
  (check_decl_lim env st (default_limits) d))

;; the node ids of a check are minted above the env's watermark and the
;; caller's counter; the accepted env carries the final counter
(fn check_decl_lim ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match (check_decl_core env (st_seed env st) lim d)
    ((KFail f) (KFail f))
    ((KOk st1 env1) (KOk (st_clear_memo st1) (env_set_watermark env1 (st_node st1))))))

(fn check_decl_core ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match d
    ((AxiomDecl v unsafe)
     (if unsafe (KFail (FRej (Unsupported (quote unsafe_declaration))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _) (KOk st1 (env_add env (cv_name v) (AxiomInfo v False)))))))
    ((DefnDecl v value hints safety all)
     (if (bool_not (safety_is_safe safety)) (KFail (FRej (Unsupported (quote unsafe_declaration))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (check_value env st1 v value Safe lim)
          ((KFail f) (KFail f))
          ((KOk st2 _) (KOk st2 (env_add env (cv_name v) (DefnInfo v value hints safety all)))))))))
    ((ThmDecl v value all)
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (is_prop (ctx_for env (cv_lparams v) Safe lim) st1 (lim_depth lim) (cv_type v))
          ((KFail f) (KFail f))
          ((KOk st2 p)
           (if (bool_not p) (KFail (FRej (RuleViolation (quote theorem_type_not_prop))))
           (match (check_value env st2 v value Safe lim)
             ((KFail f) (KFail f))
             ((KOk st3 _) (KOk st3 (env_add env (cv_name v) (ThmInfo v value all)))))))))))
    ((OpaqueDecl v value unsafe all)
     (if unsafe (KFail (FRej (Unsupported (quote unsafe_declaration))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (check_value env st1 v value Safe lim)
          ((KFail f) (KFail f))
          ((KOk st2 _) (KOk st2 (env_add env (cv_name v) (OpaqueInfo v value False all)))))))))
    (QuotDecl (add_quot env st))
    ((MutualDefnDecl _) (KFail (FRej (Unsupported (quote mutual_unsafe_block)))))
    ((InductDecl lps nparams types unsafe)
     (if unsafe (KFail (FRej (Unsupported (quote unsafe_declaration))))
     (add_inductive env st lps nparams types False)))))

;; §3.3's outcome, from a KRes
(fn outcome_of ((r (KRes CheckedEnv)) (subject Name)) Outcome
  (match r
    ((KOk _ e) (Accepted e))
    ((KFail (FRej reason)) (Rejected reason subject))
    ((KFail (FOut res site)) (Exhausted res site))))

(fn decl_name ((d Declaration)) Name
  (match d
    ((AxiomDecl v _) (cv_name v)) ((DefnDecl v _ _ _ _) (cv_name v)) ((ThmDecl v _ _) (cv_name v))
    ((OpaqueDecl v _ _ _) (cv_name v)) (QuotDecl (nm_quot)) ((MutualDefnDecl _) Anon)
    ((InductDecl _ _ (Cons t _) _) (it_name t)) ((InductDecl _ _ Nil _) Anon)))

;; the identity FINGERPRINT of an admitted constant (reports, the fuel-monotonicity
;; test): its type and, for definitions, its value; for an inductive type, its
;; type and every constructor's type (in order). A 61-bit structural hash —
;; NEVER an authority: it is affine in a trailing literal, so a preimage is one
;; subtraction, and it collides on ordinary Init terms (`List.cons`'s type
;; against `List α → α → List α`) (GPT-6 R42, 2026-09-12; records §4.7).
;; Nothing enables a shortcut on it; see `pin_if_matches`.
(fn identity_hash ((env CheckedEnv) (n Name)) (Option Int)
  (match (env_find env n)
    ((Some (DefnInfo (ConstantVal _ _ ty) v _ _ _)) (Some (mix (hash_expr ty) (hash_expr v))))
    ((Some (InductInfo (ConstantVal _ _ ty) _ _ _ ctors _ _ _ _)) (Some (hash_ctor_types env ctors (hash_expr ty))))
    ((Some info) (Some (hash_expr (ci_type info))))
    (None None)))

(fn hash_ctor_types ((env CheckedEnv) (ctors (List Name)) (acc Int)) Int
  (measure (struct ctors))
  (match ctors
    (Nil acc)
    ((Cons c r) (match (env_find env c) ((Some info) (hash_ctor_types env r (mix acc (hash_expr (ci_type info))))) (None acc)))))

;; ---- the accelerator pins (FOUNDATION §3.2) --------------------------------------------
;; A shortcut (a Nat operation on literals, a literal's typing rule, the string
;; literal expansion) is enabled for a candidate name only when its IDENTITY
;; CLOSURE matches the reference table generated from the pinned export
;; (accel_pins.shard `accel_ref`): the declaration itself and, transitively,
;; every definition, opaque, axiom and inductive type that its type and value
;; cite. Compared exactly, by `expr_eq` (binder names and infos ignored): the
;; kind, the level parameters, the type, the value; for an inductive its
;; parameter count, its block and each constructor's name and type in order.
;; Not compared: theorems (proof irrelevance — a different proof can only make
;; a reduction stick, never change a value); constructors and recursors (K
;; generated them from their inductive, which IS compared); quotients (K fixes
;; them itself); reducibility hints and `all` lists (no effect on a value).
;; Never a hash and never a name: a same-spelled `Nat.add` with a different
;; body, or the pinned body over a different `Nat.pred`, is admitted as an
;; ordinary definition and reaches no shortcut. The walk is fuel-bounded; out
;; of fuel = no pin, never a wrong pin.
(fn ref_fuel () Int 100000)

(fn pin_if_matches ((env CheckedEnv) (n Name)) CheckedEnv
  (if (is_pin_candidate n)
    (if (ref_closure_ok env (Cons n Nil) Nil (ref_fuel)) (env_pin env n) env)
    env))

(fn ref_closure_ok ((env CheckedEnv) (todo (List Name)) (seen (List Name)) (fuel Int)) Bool
  (measure fuel)
  (if (lt fuel 0) False
  (match todo
    (Nil True)
    ((Cons c r)
     (if (mem_name c seen) (ref_closure_ok env r seen (- fuel 1))
     (match (env_find env c)
       (None False)
       ((Some info)
        (if (ref_matches env c info)
          (ref_closure_ok env (append (ref_edges env info) r) (Cons c seen) (- fuel 1))
          False))))))))

;; the identity closure's edges out of an entry (the generator walks the same edges)
(fn ref_edges ((env CheckedEnv) (info ConstantInfo)) (List Name)
  (match info
    ((DefnInfo cv v _ _ _) (append (expr_consts (cv_type cv)) (expr_consts v)))
    ((OpaqueInfo cv v _ _) (append (expr_consts (cv_type cv)) (expr_consts v)))
    ((AxiomInfo cv _) (expr_consts (cv_type cv)))
    ((InductInfo cv _ _ all ctors _ _ _ _) (append (expr_consts (cv_type cv)) (append (ctor_types_consts env ctors) all)))
    ((CtorInfo _ induct _ _ _ _) (Cons induct Nil))
    ((RecInfo _ all _ _ _ _ _ _ _) all)
    (_ Nil)))

(fn ctor_types_consts ((env CheckedEnv) (ctors (List Name))) (List Name)
  (measure (struct ctors))
  (match ctors
    (Nil Nil)
    ((Cons c r) (append (match (env_find env c) ((Some info) (expr_consts (ci_type info))) (None Nil)) (ctor_types_consts env r)))))

;; an entry against its reference row
(fn ref_matches ((env CheckedEnv) (c Name) (info ConstantInfo)) Bool
  (match info
    ((ThmInfo _ _ _) True)
    ((QuotInfo _ _) True)
    ((CtorInfo _ _ _ _ _ _) True)
    ((RecInfo _ _ _ _ _ _ _ _ _) True)
    ((DefnInfo cv v _ _ _)
     (match (accel_ref c) ((Some (DefnDecl rcv rv _ _ _)) (bool_and (cval_eq cv rcv) (expr_eq v rv))) (_ False)))
    ((OpaqueInfo cv v _ _)
     (match (accel_ref c) ((Some (OpaqueDecl rcv rv _ _)) (bool_and (cval_eq cv rcv) (expr_eq v rv))) (_ False)))
    ((AxiomInfo cv _)
     (match (accel_ref c) ((Some (AxiomDecl rcv _)) (cval_eq cv rcv)) (_ False)))
    ((InductInfo cv np _ all ctors _ _ _ _)
     (match (accel_ref c)
       ((Some (InductDecl lps rnp types _))
        (bool_and (names_eq (cv_lparams cv) lps)
        (bool_and (int_eq np rnp)
        (bool_and (names_eq all (all_names types))
          (match (find_it types c)
            ((Some it) (bool_and (expr_eq (cv_type cv) (it_type it)) (ctors_match env ctors (it_ctors it))))
            (None False))))))
       (_ False)))))

(fn cval_eq ((a ConstantVal) (b ConstantVal)) Bool
  (bool_and (name_eq (cv_name a) (cv_name b))
  (bool_and (names_eq (cv_lparams a) (cv_lparams b)) (expr_eq (cv_type a) (cv_type b)))))

(fn find_it ((ts (List InductiveType)) (n Name)) (Option InductiveType)
  (measure (struct ts))
  (match ts (Nil None) ((Cons t r) (if (name_eq (it_name t) n) (Some t) (find_it r n)))))

;; the admitted constructors (names, in order) against the reference's, type by type
(fn ctors_match ((env CheckedEnv) (ns (List Name)) (cs (List Constructor))) Bool
  (measure (struct ns))
  (match ns
    (Nil (match cs (Nil True) (_ False)))
    ((Cons n r)
     (match cs
       (Nil False)
       ((Cons c cr)
        (if (name_eq n (ctor_name c))
          (match (env_find env n)
            ((Some info) (if (expr_eq (ci_type info) (ctor_type c)) (ctors_match env r cr) False))
            (None False))
          False))))))

(fn env_pin ((env CheckedEnv) (n Name)) CheckedEnv
  (match env ((CheckedEnv xs q p w) (CheckedEnv xs q (Cons n p) w))))

;; check + pin (the environment K clients use)
(fn check_decl_pinning ((env CheckedEnv) (st St) (d Declaration)) (KRes CheckedEnv)
  (check_decl_pinning_lim env st (default_limits) d))

(fn check_decl_pinning_lim ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match (check_decl_lim env st lim d)
    ((KFail f) (KFail f))
    ((KOk st1 env1) (KOk st1 (pin_names env1 (decl_pin_candidates d))))))

(fn pin_names ((env CheckedEnv) (ns (List Name))) CheckedEnv
  (measure (struct ns))
  (match ns (Nil env) ((Cons n r) (pin_names (pin_if_matches env n) r))))

;; the names a declaration may pin: its own, or an inductive block's types
(fn decl_pin_candidates ((d Declaration)) (List Name)
  (match d
    ((InductDecl _ _ types _) (all_names types))
    (_ (Cons (decl_name d) Nil))))

(fn check ((env CheckedEnv) (st St) (d Declaration)) Outcome
  (outcome_of (check_decl_pinning env st d) (decl_name d)))

;; check(env, decl, limits) — §3.3's signature
(fn check_with ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) Outcome
  (outcome_of (check_decl_pinning_lim env st lim d) (decl_name d)))
