;; ---- paths ---------------------------------------------------------------------------
;; a path as its components on `/`
(fn split_path ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil (rev (cons (rev cur) acc)))
    ((cons c r)
     (if (= c 47) (split_path r nil (cons (rev cur) acc)) (split_path r (cons c cur) acc)))))
;; normalized: empty and `.` components dropped, `..` pops; None if `..` would climb above the start
(fn norm_parts ((parts (List (List Int))) (acc (List (List Int)))) (Option (List (List Int)))
  (measure (struct parts))
  (match parts
    (nil (some (rev acc)))
    ((cons p r)
     (if (int_list_eq p nil) (norm_parts r acc)
     (if (int_list_eq p (utf8 ".")) (norm_parts r acc)
     (if (int_list_eq p (utf8 ".."))
       (match acc
         (nil none)
         ((cons _ a2) (norm_parts r a2)))
       (norm_parts r (cons p acc))))))))
(fn parts_of ((bs (List Int))) (Option (List (List Int))) (norm_parts (split_path bs nil nil) nil))
(fn join_path ((parts (List (List Int)))) (List Int)
  (measure (struct parts))
  (match parts
    (nil nil)
    ((cons p nil) p)
    ((cons p r) (append p (cons 47 (join_path r))))))
(fn dir_of ((parts (List (List Int)))) (List (List Int))
  (measure (struct parts))
  (match parts
    (nil nil)
    ((cons _ nil) nil)
    ((cons p r) (cons p (dir_of r)))))
;; the rest of `parts` after the prefix `pre`, or None
(fn strip_parts ((pre (List (List Int))) (parts (List (List Int)))) (Option (List (List Int)))
  (measure (struct pre))
  (match pre
    (nil (some parts))
    ((cons p pr)
     (match parts
       ((cons q qr) (if (int_list_eq p q) (strip_parts pr qr) none))
       (nil none)))))
(fn strip_suffix ((suf (List Int)) (bs (List Int))) (Option (List Int))
  (let ((n (- (len bs) (len suf))))
    (if (< n 0) none
    (if (int_list_eq (drop n bs) suf) (some (take n bs))
    none))))

;; the module path of a root-relative file: `.shard` dropped from the last
;; component, each component one name component. A path whose last
;; component lacks `.shard` names a directory module (its view);
;; `DIR/mod.req.shard` and the dir form `DIR/mod.req/mod.req.shard` are
;; DIR's view and carry DIR's path (MPView); other files under `mod.req/`
;; are refused.
(type ModPath (MPOk Name) (MPView Name) (MPDir) (MPBad (List Int)))
(fn module_of ((parts (List (List Int)))) ModPath (module_rest Anon parts))
(fn module_rest ((m Name) (parts (List (List Int)))) ModPath
  (measure (* 2 (List.length parts)))
  (match parts
    (nil (MPBad (utf8 "empty path")))
    ((cons p nil)
     (if (int_list_eq p (utf8 "mod.req.shard"))
       (match m
         (Anon (MPBad (utf8 "a view at the root: no directory")))
         (_ (MPView m)))
       (match (strip_suffix (utf8 ".shard") p)
         (none
           (if (int_list_eq p (utf8 "mod.req"))
             (MPBad (utf8 "mod.req/ names the dir form's directory, not a module"))
             MPDir))
         ((some stem) (module_comp m stem nil)))))
    ((cons p (cons q nil))
     (if (bool_and (int_list_eq p (utf8 "mod.req")) (int_list_eq q (utf8 "mod.req.shard")))
       (match m
         (Anon (MPBad (utf8 "a view at the root: no directory")))
         (_ (MPView m)))
       (module_step m p (list q))))
    ((cons p r) (module_step m p r))))
(fn module_step ((m Name) (p (List Int)) (r (List (List Int)))) ModPath
  (measure (+ (* 2 (List.length r)) 1))
  (if (int_list_eq p (utf8 "mod.req"))
    (MPBad
      (utf8 "a file under mod.req/ other than mod.req.shard: mod.req/ holds the view file alone"))
    (match (module_comp m p nil)
      ((MPOk m2) (module_rest m2 r))
      (x x))))
;; a directory's module path: each component one name component
(fn dir_module ((parts (List (List Int)))) ModPath (dir_module_go Anon parts))
(fn dir_module_go ((m Name) (parts (List (List Int)))) ModPath
  (measure (struct parts))
  (match parts
    (nil
      (match m
        (Anon (MPBad (utf8 "empty path")))
        (_ (MPOk m))))
    ((cons p r)
     (if (int_list_eq p (utf8 "mod.req"))
       (MPBad (utf8 "mod.req/ is the dir form's directory, not a module"))
       (match (module_comp m p nil)
         ((MPOk m2) (dir_module_go m2 r))
         (x x))))))
;; the view file of a directory module, dir form first, then flat
(fn view_candidates ((dir (List (List Int)))) (List (List (List Int)))
  (list (append dir (utf8_all (list "mod.req" "mod.req.shard")))
    (append dir (utf8_all (list "mod.req.shard")))))
;; the implementation file: DIR/BASE.shard, BASE being DIR's last component
(fn impl_file ((dir (List (List Int)))) (Option (List (List Int)))
  (match (rev dir)
    (nil none)
    ((cons base _) (some (append dir (list (append base (utf8 ".shard"))))))))
;; one component; a dot inside it would split a citation, so it is refused
(fn module_comp ((m Name) (comp (List Int)) (seen (List Int))) ModPath
  (measure (struct comp))
  (match comp
    (nil
      (match (name_push m (rev seen))
        (none (MPBad (utf8 "empty component")))
        ((some n)
         (if (bool_and (name_eq m Anon) (name_eq n (n1 (sym "Init"))))
           (MPBad (utf8 "Init is the import's prefix, never a module"))
           (MPOk n)))))
    ((cons c r)
     (if (= c 46) (MPBad (append (utf8 "a dot in a file name: ") (rev_onto seen comp)))
     (module_comp m r (cons c seen))))))
(fulfills module_rest.dec_1
  (by
    (intro m parts p q h hb)
    (rw h)
    (rw List.length_cons)
    (rw List.length_cons)
    (rw List.length_cons)
    (arith)))
(fulfills module_rest.dec_2 (by (intro m parts p r h) (rw h) (rw List.length_cons) (arith)))
(fulfills module_step.dec_1 (by (intro m p r hi m2 hm) (arith)))

;; ---- the state -------------------------------------------------------------------------
;; a loaded module: path, root-relative file, hash (over its accepted
;; declarations' fingerprints, in order), its closure (the module paths
;; visible in it, itself included);
;; a view's module also keeps its fork point for the implementation
;; check, which may come after a consumer loaded the view
(record Module (path Name) (file (List Int)) (hash Int) (closure (List Name)) (fork (Option ForkPt))
  (ok Bool))
;; ok False: its loading failed — a later import fails the same way, never re-reads it
;; a file whose loading failed after its heads were pre-registered: recorded so that a
;; later import of it reports import_failed instead of re-reading it into duplicate_name
(fn ld_add_failed ((l Load) (mp Name) (rel (List (List Int)))) Load
  (ld_add_mod l
    (make Module (path mp) (file (join_path rel)) (hash 0) (closure nil) (fork none) (ok false))))

;; Init alone: an environment no native declaration entered, the records it holds, its ordinal
;; table. While a load has declared nothing its environment IS the base, and a demand enters
;; both; after the first declaration a demand enters the load's environment alone
(type InitBase (InitBase CheckedEnv OdDone (IntMap (List (Prod Name Int)))))
;; the Init load: none given; the export
;; and its index the driver named, opened at the first need; opened — the export and index
;; handle, the records the load's environment holds, and the base a re-rooted load starts from
(type InitSt (InitNone) (InitPaths (List Int) (List Int)) (InitSt OdIx OdDone InitBase))

(type Rec
  (RModule Name (List Int) Int (List Name))  ; a module loaded: path, file, hash, its closure
  (RAccept Name Name Int (List Name) (List Name) (Option Req))  ; declaration, module, content fingerprint, axiom closure, the view parameters it rests on, a theorem's resolved requirement
  (RParam Name Symbol Int)  ; a parameter admitted: a view's (kind type / fn / requirement; a sig type's arity), a measured fn's obligation, a trusted axiom (kind axiom)
  (RRefuse Name Symbol)  ; K refused
  (RPolicy Name (List Name))  ; outside the file's policy: the axioms it reaches that the policy lacks
  (RPending Name Symbol)  ; a pending proof and its cause (sorry, auto_missing, …): read, admits nothing
  (RRun Symbol Name Symbol Symbol (List Int))  ; an E declaration without a definition, RUNNABLE: kind (fn / extern / type); a fn's reason for having none (none = not applicable); its route (typed — its types were checked and its program is the erasure —, e_first — the classifier's program); the reason's sentence, where the definer gave one
  (RDefine Name (List Name) (List Name))  ; a fn defined: its equations' identities, the pending roots it carries
  (RClassify Name Symbol (List Int))  ; the classifier refused: reason, message (counts as refused)
  (RRealize Name Symbol (List Name) (List Name))  ; a realization attached: kind (supplied / view), its equations' identities, the pending roots it carries
  (RDischarge Name Symbol)  ; the implementation check: a parameter discharged (type / fn / proved) or pending
  (RImplErr Name Symbol (List Int))  ; the implementation check: a parameter without its implementation, a mismatch
  (RImplRec Rec)  ; a record of the implementation's fork (its own declarations)
  (RReadErr (List Int) Symbol (List Int))  ; file, reason, message — the file's reading ends here
  (RLoadErr (List Int) Symbol (List Int))  ; file, reason, detail — the file's loading ends here
  (RUnused Name (List Name))  ; the file's `use` lines no citation could need: module, prefixes
  (RProved Name Name (List Int) Req (List SExpr))  ; mode solve: the engine's block for an auto proof — the theorem, the name its sidecar entry bears (the theorem's, or the obligation's a discharge proves, as the source writes it), the file the proof stands in (its sidecar is beside it), the requirement's key, the block
  (RSidecar (List Int) Int Int)  ; a sidecar of an older schema replayed: the file, its schema, the current one
  (RRecon (List Int) Int Int)  ; a sidecar replayed under another reconstruction version: the file, its version (-1: none stated), the current one
  (REngine Name Bool)  ; mode measure: the engine closes the statement unaided, or not
  (RTactic Name Name Bool)  ; mode measure: the tactic the delegation names closes the statement, or not
  (RDerive Name Expr Symbol Symbol (List Name))  ; a derivation registered: the procedure, the type, the capability, the policy, the field procedures it selected
  (RTemplate Name (List Name) (List Name))  ; a template defined: its static parameters, its equations' identities — no program of its own
  (RInstance Name Name (List (List Int)) (List Name))  ; an instance built: the template, the shapes (identity/captured count), its equations' identities
  (RThread Name Symbol (List Int))  ; the well-threadedness verdict of a token-handling function: ok, or world_twice / world_unsupported / world_forged with its detail
  (RState Name Symbol (List Int))  ; the state's check on a function that takes or returns the checker's state, under --state: ok (with its resumptions), primitive, reused or unsupported with its detail
  (RBoth Name Symbol (List Int))  ; under --both, a fn the typed route gave a program: the classifier's reading of the same form gives the same program (same), another (differs, with both), or none (unread, with its refusal)
  (RBin Name Name (List Name) Int (List Name) Int)  ; a bin checked: its name, entry, externs, trusted axioms' count, requirements, requirements met
  (RBinErr Name Symbol (List Int)))  ; a bin's failure, an error: unmet (the requirement), unthreaded (the function and its verdict), bad_entry, extern_undeclared, extern_outside, unknown_requirement, unknown_trust, untrusted

;; the caches the load keeps beside its checked environment, each of a function of what the
;; environment holds of a declaration: K's closures of axioms, and the declarations' parts of
;; the requirement keys (reader.shard `ReqMemo`). One field of the load, so that the two are
;; kept, advanced and emptied together
(type Memos (Memos AxMemo ReqMemo))
(fn memos_empty () Memos (Memos (ax_memo_empty) (req_memo_empty)))
(fn memos_ax ((m Memos)) AxMemo
  (match m
    ((Memos a _) a)))
;; root, environment, the memos, modules, the Init load, declaration →
;; module, pending names, the loading stack (cycles), records newest first,
;; the view parameters admitted,
;; the E table (etable.shard: every E declaration by identity and suffix),
;; the pending roots each realization carries
(record Load (root (List (List Int))) (env CheckedEnv) (memo Memos) (mods (List Module))
  (init InitSt)
  (tbl (IntMap (List (Prod Name Name))))
  (inits (IntMap (List (Prod Name Int))))  ; declaration → ordinal for every imported declaration
  (missed (List (List Int)))  ; the words of the refusals recorded since the reading of the present declaration began that may name a constant of Init the load has not fetched (settle_missed)
  (beyond (List Int))  ; the ordinals of the records of Init the load fetched after its first declaration: its own environment holds them and the base does not (ld_reroot starts without them)
  (mode Symbol)  ; the proofs' mode: off (the build), solve (prove), measure
  (pending (List Name))
  (stack (List Name))
  (recs (List Rec))
  (params (List Name))
  (etab ESt)
  (parked (List Parked))
  (later (List SExpr))  ; the forms of the file being read that stand below the declaration being read: a type whose field cites a type declared below it is admitted with it (load_unheld_type)
  (tahead (List Name))  ; the types admitted ahead of their form, with a type above that cites them: at its form such a type has its program's declaration and nothing more
  (reads Reads)  ; how the readings of the parked fns ended, kept by the search for a group while they hold (settle_groups)
  (pm (List (Prod Name (List Name))))
  (forms (IntMap (List (Prod Name (Prod Scope SExpr)))))
  (discharged (List (Prod Name (List Name))))  ; a descent obligation proved: the axioms and parameters its proof rests on, which stand in its place in every closure
  (typed (List (Prod Name (Prod Scope SExpr))))  ; the fns RUNNABLE on the typed route: a later body binds one as a callee-local
  (derived (List Derived))  ; the derivation table: an entry is visible where its procedure is
  (templates (List (Prod Name Template)))  ; the templates defined, for the instances a body demands
  (instances (List Demand))  ; the instances built, by name — a second taking at other arguments under one name is refused
  (budget Int)  ; the instances of one template this load may build: instance_budget, or the driver's --instance-budget
  (fuel Int)  ; the fuel for a run under ev the load performs itself: a tactic named by a delegation under prove; default_fuel, or the driver's --fuel
  (both Bool)  ; the driver's --both: each fn the typed route gives a program is read by the classifier too, and the two programs compared (BOTH records)
  (unchecked Bool)  ; the driver's --unchecked: a fn is read as a program alone and never enters the typed route — nothing checks its types or defines it (load_e_form)
  (cited (List Name))  ; every candidate the loaded files' tokens asked the export for (init_demand), found or not: what the driver's --facts prints the facts of (facts.shard)
  (linked (List Load))  ; the fork of each implementation checked, as it ended: the main line merges its programs and drops the rest, and --facts prints the facts those programs are read by, which rest on what the fork fetched of Init
  (states (Option (IntMap (List (Prod Name Int))))))  ; the state's check (thread.shard): None in a plain load; under the driver's --state the modes of the functions judged so far
(fn load0 ((root (List (List Int)))) Load
  (make Load (root root) (env (env_empty)) (memo (memos_empty)) (mods nil) (init InitNone)
    (tbl IMEmpty)
    (inits IMEmpty)
    (missed nil)
    (beyond nil)
    (mode (sym "off"))
    (pending nil)
    (stack nil)
    (recs nil)
    (params nil)
    (etab (es0))
    (pm nil)
    (forms IMEmpty)
    (parked nil)
    (later nil)
    (tahead nil)
    (reads (Reads nil nil))
    (typed nil)
    (discharged nil)
    (derived nil)
    (templates nil)
    (instances nil)
    (budget (instance_budget))
    (fuel (default_fuel))
    (both false)
    (unchecked false)
    (cited nil)
    (linked nil)
    (states none)))
;; a fresh root load from a load's Init state: the Init load carried — the
;; base's environment of Init alone, its records and ordinals, the export and index handle;
;; everything of the old root reset to load0's, the old root's own declarations gone, and with
;; them what the old root demanded of Init after its first declaration (demanded again, it is
;; checked again). A load that never opened Init re-roots to an empty one
(fn ld_reroot ((l Load) (root (List (List Int)))) Load
  (match (Load.init l)
    ((InitSt x _ (InitBase env done inits))
     (with Load (load0 root) (env env) (init (InitSt x done (InitBase env done inits)))
       (inits inits)
       (budget (Load.budget l))))
    (i (with Load (load0 root) (init i) (budget (Load.budget l))))))
;; has the load declared nothing? Every admission of a native declaration enters the
;; declaration table (tbl) with the environment it extends
(fn ld_undeclared ((l Load)) Bool
  (match (Load.tbl l)
    (IMEmpty true)
    (_ false)))
(fn ld_recs ((l Load)) (List Rec) (rev (Load.recs l)))
(fn ld_with_env ((l Load) (e CheckedEnv) (m Memos)) Load (with Load l (env e) (memo m)))
(fn ld_add_mod ((l Load) (md Module)) Load (with Load l (mods (cons md (Load.mods l)))))
(fn ld_with_init ((l Load) (i InitSt)) Load (with Load l (init i)))
(fn ld_with_tbl ((l Load) (t (IntMap (List (Prod Name Name))))) Load (with Load l (tbl t)))
;; the fuel for a run the load performs itself (a tactic under prove)
(fn default_fuel () Int 1000000000000)
(fn ld_with_fuel ((l Load) (n Int)) Load (with Load l (fuel n)))
(fn ld_with_mode ((l Load) (m Symbol)) Load (with Load l (mode m)))
;; an RDSolved or RDMeasured read: its record, and the plain RDOk. `under` is the obligation a
;; discharge's theorem proves — the sidecar's entry bears its name — and Anon for a theorem,
;; entered under its own; `file` is the file the proof stands in
(fn rd_plain ((l Load) (sc Scope) (file (List Int)) (under Name) (rd RDecl)) (Prod Load RDecl)
  (match rd
    ((RDSolved n k steps ds)
     (Prod.mk
       (ld_rec l
         (RProved n
           (name_after (sc_module sc)
             (match under
               (Anon n)
               (_ under)))
           file
           k
           steps))
       (RDOk ds)))
    ((RDMeasured n ok tac ds)
     (Prod.mk
       (match tac
         ((some (Prod.mk tfn tok)) (ld_rec (ld_rec l (REngine n ok)) (RTactic n tfn tok)))
         (none (ld_rec l (REngine n ok))))
       (RDOk ds)))
    (_ (Prod.mk l rd))))
;; the producers' inputs for a file's proofs: its sidecar's entries, the
;; programs loaded so far (a named tactic runs on them under prove), the fuel, and the file's
;; parts of the requirement's key
(fn producers_of ((l Load) (f Fx)) Producers
  (Producers (Fx.autos f) (Load.etab l) (Load.fuel l) (req_ctx l f)))
;; the file's parts of the key: its scope, the policy's fingerprint — the trusts' candidates
;; through the scope and the parameters the file can see, what `permitted` can be asked about
;; for a declaration of the file beyond the standard axioms: a parameter of a module outside
;; the file's closure reaches none of its declarations, so what another root admitted is no
;; part of the key —, the environment's — the export's identity
;; as the index's header states it (its record count and byte length)
(fn req_ctx ((l Load) (f Fx)) ReqCtx
  (let ((sc (fx_scope l f)))
    (ReqCtx sc
      (req_names (append (trust_candidates sc (Fx.trusts f)) (params_seen sc (Load.params l))) 0)
      (match (Load.init l)
        ((InitSt x _ _) (mix (ix_hdr_records (odx_hdr x)) (ix_hdr_bytes (odx_hdr x))))
        (_ (mix 0 0))))))
(fn params_seen ((sc Scope) (ps (List Name))) (List Name)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r) (if (visible sc p) (cons p (params_seen sc r)) (params_seen sc r)))))
(fn trust_candidates ((sc Scope) (ts (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (append (scope_candidates sc t) (trust_candidates sc r)))))
(fn ordinals_onto ((cs (List (Prod Name Int))) (acc (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons (Prod.mk _ o) r) (ordinals_onto r (cons o acc)))))
(fn ld_add_inits ((l Load) (cs (List (Prod Name Int)))) Load
  (measure (struct cs))
  (match cs
    (nil l)
    ((cons (Prod.mk n o) r) (ld_add_inits (with Load l (inits (ords_add (Load.inits l) n o))) r))))
;; the sidecar FILE.auto.shard beside a file whose forms hold an `auto` proof — a module's
;; file, or the implementation file of a view, read where its check begins (check_impl):
;; its (proof-for NAME FINGERPRINT (by STEP…)) forms as entries; absent = no entries; a sidecar
;; that does not read, or a form of another shape, is the file's load error and no entries.
;; Its first form may be the schema (sidecar N) the entries are written in (no form = schema
;; 1): an older schema is replayed and reported SIDECAR; a newer one is the load error
;; sidecar_schema (this loader cannot read it).
;; At schema 3 an entry's key is (req S D P E), the resolved requirement's; a bare
;; FINGERPRINT (schemas 1 and 2) is the statement's alone and still stands on replay. The form's
;; second number, (sidecar N RECON), is the reconstruction version the entries were last replayed
;; under (tactic.shard): another one is replayed and reported RECON
(fn sidecar_schema () Int 3)
(fn read_sidecar ((l Load) (rel (List (List Int))) (forms (List SExpr)) (w World))
  (Prod (Prod Load (List Auto)) World)
  (if (bool_not (forms_want_auto forms)) (Prod.mk (Prod.mk l nil) w)
  (let
    ((path (append (drop_shard_suffix (join_path (append (Load.root l) rel))) (utf8 ".auto.shard"))))
    (match (read_file path w)
      ((Prod.mk none w1) (Prod.mk (Prod.mk l nil) w1))
      ((Prod.mk (some src) w1)
       (match (read_all src)
         ((RAErr e off)
          (Prod.mk
            (Prod.mk
              (ld_rec l
                (RLoadErr (join_path rel) (sym "sidecar_malformed")
                  (append path
                    (append (utf8 ": ")
                      (append (chars_of_sym e) (append (utf8 " at byte ") (show_nat off)))))))
              nil)
            w1))
         ((RAOk es)
          (match (sidecar_split es)
            ((Prod.mk none m)
             (Prod.mk
               (Prod.mk
                 (ld_rec l
                   (RLoadErr (join_path rel) (sym "sidecar_malformed")
                     (append path (append (utf8 ": ") m))))
                 nil)
               w1))
            ((Prod.mk (some (Prod.mk (Prod.mk schema recon) rest)) _)
             (if (< (sidecar_schema) schema)
               (Prod.mk
                 (Prod.mk
                   (ld_rec l
                     (RLoadErr (join_path rel) (sym "sidecar_schema")
                       (append path
                         (append (utf8 ": schema ")
                           (append (show_nat schema)
                             (append (utf8 " is past this loader's ")
                               (append (show_nat (sidecar_schema))
                                 (utf8 " — regenerate the sidecar with prove.shard"))))))))
                   nil)
                 w1)
               (match (sidecar_entries rest nil)
                 ((Prod.mk (some autos) _)
                  (Prod.mk (Prod.mk (sidecar_reports l (join_path rel) schema recon) autos) w1))
                 ((Prod.mk none m)
                  (Prod.mk
                    (Prod.mk
                      (ld_rec l
                        (RLoadErr (join_path rel) (sym "sidecar_malformed")
                          (append path (append (utf8 ": ") m))))
                      nil)
                    w1)))))))))))))
;; the reports of a sidecar read — an older schema; at the current schema, another
;; reconstruction version —: reports, never refusals, the entries standing on replay
(fn sidecar_reports ((l Load) (file (List Int)) (schema Int) (recon Int)) Load
  (if (< schema (sidecar_schema)) (ld_rec l (RSidecar file schema (sidecar_schema)))
  (if (= recon (reconstruction_version)) l
  (ld_rec l (RRecon file recon (reconstruction_version))))))
;; the schema form at the head of a sidecar — (sidecar N), or (sidecar N RECON) with the
;; reconstruction version its entries were last replayed under (-1 when not stated) —, and the
;; forms after it; no form = schema 1
(fn sidecar_split ((es (List SExpr))) (Prod (Option (Prod (Prod Int Int) (List SExpr))) (List Int))
  (match es
    ((cons (SList (cons (SSym h) more)) r)
     (if (sym_eq h (sym "sidecar"))
       (match more
         ((cons (SNum n) nil)
          (if (< n 1) (Prod.mk none (utf8 "(sidecar N): N counts from 1"))
          (Prod.mk (some (Prod.mk (Prod.mk n -1) r)) nil)))
         ((cons (SNum n) (cons (SNum v) nil))
          (if (< n 1) (Prod.mk none (utf8 "(sidecar N RECON): N counts from 1"))
          (Prod.mk (some (Prod.mk (Prod.mk n v) r)) nil)))
         (_ (Prod.mk none (utf8 "the schema form is (sidecar N) or (sidecar N RECON)"))))
       (Prod.mk (some (Prod.mk (Prod.mk 1 -1) es)) nil)))
    (_ (Prod.mk (some (Prod.mk (Prod.mk 1 -1) es)) nil))))
;; FILE.shard → FILE (the sidecar is FILE.auto.shard); another suffix is kept
(fn drop_shard_suffix ((path (List Int))) (List Int)
  (let ((n (len path)))
    (if (bool_and (< 6 n) (int_list_eq (drop (- n 6) path) (utf8 ".shard"))) (take (- n 6) path)
    path)))
;; a form whose proof is delegated: (theorem NAME BINDERS PROP auto), (fulfills NAME auto)
(fn forms_want_auto ((forms (List SExpr))) Bool
  (measure (struct forms))
  (match forms
    (nil false)
    ((cons (SList (cons (SSym h) args)) r)
     (let
       ((auto Bool
          (match args
            ((cons _ (cons _ (cons _ (cons p nil))))
             (bool_and (sym_eq h (sym "theorem")) (proof_is_auto p)))
            ((cons _ (cons p nil)) (bool_and (sym_eq h (sym "fulfills")) (proof_is_auto p)))
            (_ false))))
       (if auto true (forms_want_auto r))))
    ((cons _ r) (forms_want_auto r))))
(fn proof_is_auto ((p SExpr)) Bool
  (match p
    ((SSym x) (sym_eq x (sym "auto")))
    ((SList (cons (SSym x) _)) (sym_eq x (sym "auto")))
    (_ false)))
(fn sidecar_entries ((es (List SExpr)) (acc (List Auto))) (Prod (Option (List Auto)) (List Int))
  (measure (struct es))
  (match es
    (nil (Prod.mk (some (rev acc)) nil))
    ((cons
       (SList (cons (SSym h) (cons (SSym nm) (cons key (cons (SList (cons (SSym by) steps)) nil)))))
       r)
     (if (bool_and (sym_eq h (sym "proof-for")) (sym_eq by (sym "by")))
       (match (name_of_sym nm)
         ((some n)
          (match (sidecar_key key)
            ((some k) (sidecar_entries r (cons (Auto n k steps) acc)))
            (none (Prod.mk none (utf8 "an entry's key is (req S D P E) or a FINGERPRINT")))))
         (none (Prod.mk none (append (utf8 "not a name: ") (chars_of_sym nm)))))
       (Prod.mk none (utf8 "an entry is (proof-for NAME (req S D P E) (by STEP…))"))))
    ((cons _ r) (Prod.mk none (utf8 "an entry is (proof-for NAME (req S D P E) (by STEP…))")))))
;; an entry's key: (req S D P E), or a bare fingerprint (the statement's; schemas 1 and 2)
(fn sidecar_key ((s SExpr)) (Option Req)
  (match s
    ((SNum fp) (some (ReqStmt fp)))
    ((SList (cons (SSym h) (cons (SNum a) (cons (SNum b) (cons (SNum c) (cons (SNum d) nil))))))
     (if (sym_eq h (sym "req")) (some (ReqFull a b c d)) none))
    (_ none)))
(fn ld_add_pending ((l Load) (n Name)) Load (with Load l (pending (cons n (Load.pending l)))))
(fn ld_with_stack ((l Load) (s (List Name))) Load (with Load l (stack s)))
;; a record added. The words of a refusal that may name a constant are kept beside it until
;; the declaration being read is settled: one may be a constant of Init the load has not
;; fetched
(fn ld_rec ((l Load) (x Rec)) Load
  (let
    ((l1 Load
       (match (rec_refusal x)
         ((some (Prod.mk e m)) (ld_miss l e m))
         (none l))))
    (with Load l1 (recs (cons x (Load.recs l1))))))
;; a reading error and a refusal with their reason; under prove, a delegation no producer
;; closed (its text holds the refusal of the block the producer answered)
(fn rec_refusal ((x Rec)) (Option (Prod Symbol (List Int)))
  (match x
    ((RReadErr _ e m) (some (Prod.mk e m)))
    ((RClassify _ e m) (some (Prod.mk e m)))
    ((RPending _ r)
     (match (starts_with_lit (utf8 "auto_unsolved") (chars_of_sym r))
       ((some rest) (some (Prod.mk (sym "auto_unsolved") rest)))
       (none none)))
    (_ none)))
;; the words of a message that may name a constant the environment lacks. The refusal of a
;; citation (citation_reason) is a name, or names: the elaborator and the classifier show the
;; name as written (alone, or inside a step's message), K's refusal lists the constants the
;; declaration cites. Under
;; any other reason — a case analysis without its casesOn, a derivation without a
;; constructor's injectivity, a recursion without its below — the constant is one the
;; toolchain built from a name it met, the owner's name and a suffix: a dotted word. The rest
;; of a message is prose and is not looked up. An obstacle that leaves no refusal — a body
;; read E-first after the typed route — states what it met through here as a refusal does
(fn ld_miss ((l Load) (e Symbol) (m (List Int))) Load
  (with Load l (missed (naming_words (citation_reason e) (msg_tokens m nil nil) (Load.missed l)))))
(fn naming_words ((all Bool) (ws (List (List Int))) (acc (List (List Int)))) (List (List Int))
  (measure (struct ws))
  (match ws
    (nil acc)
    ((cons t r) (naming_words all r (if (bool_or all (has_dot t)) (cons t acc) acc)))))
(fn has_dot ((t (List Int))) Bool
  (measure (struct t))
  (match t
    (nil false)
    ((cons c r) (if (= c 46) true (has_dot r)))))
(fn ld_settled ((l Load)) Load (with Load l (missed nil)))
(fn ld_add_param ((l Load) (n Name)) Load (with Load l (params (cons n (Load.params l)))))
(fn ld_with_e ((l Load) (es ESt)) Load (with Load l (etab es)))
(fn ld_add_typed ((l Load) (n Name) (sc Scope) (s SExpr)) Load
  (with Load l (typed (cons (Prod.mk n (Prod.mk sc s)) (Load.typed l)))))
(fn ld_add_template ((l Load) (n Name) (tm Template)) Load
  (with Load l (templates (cons (Prod.mk n tm) (Load.templates l)))))
(fn ld_add_instance ((l Load) (d Demand)) Load
  (with Load l (instances (cons d (Load.instances l)))))
;; the instance budget: the instances of one template a load may build, past which a
;; demand is refused naming the template — a refusal, never a proof; the driver's
;; --instance-budget N sets another for a load (the pins harness runs one case at 2)
(fn instance_budget () Int 1024)
(fn ld_with_budget ((l Load) (n Int)) Load (with Load l (budget n)))
;; the state's check asked for: every file loaded from here records its functions' verdicts
(fn ld_with_states ((l Load)) Load (with Load l (states (some IMEmpty))))
;; the two readings' comparison asked for
(fn ld_with_both ((l Load)) Load (with Load l (both true)))
;; the load of a build asked for: every fn a program alone (load_e_form)
(fn ld_with_unchecked ((l Load)) Load (with Load l (unchecked true)))
(fn instances_of ((c Name) (ds (List Demand))) Int
  (measure (struct ds))
  (match ds
    (nil 0)
    ((cons d r) (+ (if (name_eq (demand_template d) c) 1 0) (instances_of c r)))))
(fn ld_with_parked ((l Load) (p (List Parked))) Load (with Load l (parked p)))
(fn ld_with_later ((l Load) (forms (List SExpr))) Load (with Load l (later forms)))
(fn ld_with_tahead ((l Load) (ns (List Name))) Load (with Load l (tahead ns)))
;; a type to admit with others: its name, its form, and the types its fields cite that K does
;; not hold
(type TWait (TWait Name SExpr (List Name)))
;; a fn whose definition waits on a callee not yet defined (a forward reference, or a
;; callee itself parked): the fn, its form, the obstacle and the callee named
(type Parked (Parked Name SExpr Symbol (List Int)))
;; What the search for a group keeps of its readings. It reads a parked fn once more for each
;; callee-local, on every walk that reaches it, after every later fn of the file; how one
;; reading ended is the same until something it rests on changes, so it is kept: for a fn,
;; under the callee-locals it was read with — their names, in order —, whether the form read
;; whole, stopped at a name the environment lacks, or did not read. A reading is of the form
;; in the file's scope and the environment, with those locals. Parking a fn changes none: a
;; parked fn has no constant. A function that gets its definition puts constants under its
;; own name alone, so it changes the readings of the forms that name it, and those are
;; forgotten (reads_forget); a form other than a fn, a `use`, an import and a fetch from Init
;; can change any, and all are forgotten (ld_forget_all). What a callee is — parked, a
;; program, nothing yet — is never kept: the search asks it anew each time
(type ReadEnd (ReWhole) (ReStops (List Int)) (ReNo))
(type Kept (Kept (List Name) ReadEnd))
;; a parked fn's readings, with the components of the names its form cites
(type Known (Known Name (List Symbol) (List Kept)))
;; the parked fns at the last search, and what is kept
(type Reads (Reads (List Name) (List Known)))
(fn ld_with_reads ((l Load) (r Reads)) Load (with Load l (reads r)))
(fn ld_forget_all ((l Load)) Load (with Load l (reads (Reads nil nil))))
(fn ids_eq ((a (List Name)) (b (List Name))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (name_eq x y) (ids_eq ar br) false))))))
(fn kept_find ((ss (List Kept)) (ids (List Name))) (Option ReadEnd)
  (measure (struct ss))
  (match ss
    (nil none)
    ((cons (Kept is e) r) (if (ids_eq is ids) (some e) (kept_find r ids)))))
(fn reads_find ((ks (List Known)) (k Name) (ids (List Name))) (Option ReadEnd)
  (measure (struct ks))
  (match ks
    (nil none)
    ((cons (Known n _ ss) r) (if (name_eq n k) (kept_find ss ids) (reads_find r k ids)))))
;; the components of a name, and of the names a form cites, each once
(fn part_in ((c Symbol) (xs (List Symbol))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (sym_eq x c) true (part_in c r)))))
(fn name_parts ((n Name) (acc (List Symbol))) (List Symbol)
  (measure (struct n))
  (match n
    (Anon acc)
    ((Str p c) (name_parts p (if (part_in c acc) acc (cons c acc))))
    ((Num p _) (name_parts p acc))))
(fn sym_parts ((x Symbol) (acc (List Symbol))) (List Symbol)
  (match (name_of_sym x)
    ((some n) (name_parts n acc))
    (none acc)))
(fn form_parts ((s SExpr) (acc (List Symbol))) (List Symbol)
  (measure (SExpr.size s))
  (match s
    ((SSym x) (sym_parts x acc))
    ((SSymU x us) (sym_parts x (forms_parts us acc)))
    ((SList items) (forms_parts items acc))
    (_ acc)))
(fn forms_parts ((ss (List SExpr)) (acc (List Symbol))) (List Symbol)
  (measure (List_SExpr.size ss))
  (match ss
    (nil acc)
    ((cons s r) (forms_parts r (form_parts s acc)))))
(fulfills form_parts.dec_1 (by (intro s acc x us h) (rw h) (rw SExpr.size.eq_3) (arith)))
(fulfills form_parts.dec_2 (by (intro s acc items h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills forms_parts.dec_1 (by (intro ss acc s r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills forms_parts.dec_2 (by (intro ss acc s r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fn reads_add ((ks (List Known)) (k Name) (s SExpr) (ids (List Name)) (e ReadEnd)) (List Known)
  (measure (struct ks))
  (match ks
    (nil (list (Known k (form_parts s nil) (list (Kept ids e)))))
    ((cons (Known n ps ss) r)
     (if (name_eq n k) (cons (Known n ps (cons (Kept ids e) ss)) r)
     (cons (Known n ps ss) (reads_add r k s ids e))))))
(fn parts_meet ((ps (List Symbol)) (xs (List Symbol))) Bool
  (measure (struct ps))
  (match ps
    (nil false)
    ((cons c r) (if (part_in c xs) true (parts_meet r xs)))))
;; without the fns whose form cites a name with one of the components
(fn reads_forget ((ks (List Known)) (xs (List Symbol))) (List Known)
  (measure (struct ks))
  (match ks
    (nil nil)
    ((cons (Known n ps ss) r)
     (if (parts_meet ps xs) (reads_forget r xs) (cons (Known n ps ss) (reads_forget r xs))))))
;; the readings of the named fns alone
(fn reads_only ((ks (List Known)) (ns (List Name))) (List Known)
  (measure (struct ks))
  (match ks
    (nil nil)
    ((cons (Known n ps ss) r)
     (if (mem_name n ns) (cons (Known n ps ss) (reads_only r ns)) (reads_only r ns)))))
(fn last_parts ((ns (List Name))) (List Symbol)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r) (cons (last_component n) (last_parts r)))))
(fn names_gone ((was (List Name)) (now (List Name))) (List Name)
  (measure (struct was))
  (match was
    (nil nil)
    ((cons n r) (if (mem_name n now) (names_gone r now) (cons n (names_gone r now))))))
;; a function has its definition: the readings of the forms that name it are forgotten
(fn ld_forget ((l Load) (n Name)) Load
  (match (Load.reads l)
    ((Reads seen ks) (ld_with_reads l (Reads seen (reads_forget ks (list (last_component n))))))))
(fn ld_with_recs_raw ((l Load) (rs (List Rec))) Load (with Load l (recs rs)))
(fn ld_add_form ((l Load) (n Name) (sc Scope) (s SExpr)) Load
  (let ((k (name_key n)) (fo (Load.forms l)))
    (with Load l
      (forms
        (im_insert fo k
          (cons (Prod.mk n (Prod.mk sc s))
            (match (im_find fo k)
              ((some b) b)
              (none nil))))))))
;; a private file's (fn NAME …) / (type NAME …) form by its identity, with the scope it was
;; read in
(fn form_for ((l Load) (n Name)) (Option (Prod Scope SExpr))
  (match (im_find (Load.forms l) (name_key n))
    (none none)
    ((some b) (form_assoc b n))))
(fn form_assoc ((b (List (Prod Name (Prod Scope SExpr)))) (n Name)) (Option (Prod Scope SExpr))
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk k v) r) (if (name_eq k n) (some v) (form_assoc r n)))))
(fn ld_add_pm ((l Load) (n Name) (roots (List Name))) Load
  (with Load l (pm (cons (Prod.mk n roots) (Load.pm l)))))
(fn ld_find_mod ((ms (List Module)) (p Name)) (Option Module)
  (measure (struct ms))
  (match ms
    (nil none)
    ((cons m r) (if (name_eq (Module.path m) p) (some m) (ld_find_mod r p)))))

;; the file being loaded: module, root-relative parts, opened prefixes, the
;; visible modules (itself included), trusted names, hash so
;; far, whether it is a view (the forms it may hold, the req-scope gate), the sidecar's
;; entries (FILE.auto.shard beside the file, read when a theorem or a fulfills says auto),
;; whether it is the implementation file of a view (its
;; forms stand after the view's declarations), the names of Init under its identity, which
;; none of its declarations may take
(record Fx (module Name) (ident Name) (parts (List (List Int))) (opened (List Open))
  (vis (List Name))
  (trusts (List Name))
  (hash Int)
  (view Bool)
  (autos (List Auto))
  (impl Bool)
  (taken (List (List Int)))
  (ecount Int)
  (bins (List SExpr)))
;; the prefix the file's declarations take: its module, or the sealed directory's for a file
;; directly inside one (the K seal: one module across the directory's files)
(fn fx_private ((f Fx)) Bool (bool_not (name_eq (Fx.ident f) (Fx.module f))))
(fn fx_file ((f Fx)) (List Int) (join_path (Fx.parts f)))
(fn fx_open ((f Fx) (o Open)) Fx (with Fx f (opened (append (Fx.opened f) (list o)))))
;; an import of a module that sees `mods`: the importer sees them too
(fn fx_see ((f Fx) (mods (List Name))) Fx (with Fx f (vis (names_union (Fx.vis f) mods))))
(fn fx_trust ((f Fx) (ns (List Name))) Fx (with Fx f (trusts (append (Fx.trusts f) ns))))
(fn fx_mix ((f Fx) (x Int)) Fx (with Fx f (hash (mix (Fx.hash f) x))))
(fn fx_add_bin ((f Fx) (s SExpr)) Fx (with Fx f (bins (append (Fx.bins f) (list s)))))
;; the fork's file context for the implementation: the view's after its directives, as no
;; view, under the implementation file with its own sidecar's entries
(fn fx_as_impl ((f Fx) (ifile (List (List Int))) (autos (List Auto))) Fx
  (with Fx f (view false) (impl true) (parts ifile) (autos autos)))
(fn fx_scope ((l Load) (f Fx)) Scope
  (scope_of (Fx.ident f) (Fx.module f) (Fx.opened f)
    (VisOnly (Fx.vis f) (Load.tbl l) (Load.pending l) (Load.derived l) (Load.inits l))))

;; ---- the forms -------------------------------------------------------------------------
(type Form
  (FImportFile (List Int))
  (FUse Name (List Symbol))
  (FTrusts (List Name))
  (FDecl)
  (FBad Symbol (List Int)))
(fn form_of ((s SExpr)) Form
  (match s
    ((SList (cons (SSym h) args))
     (if (sym_eq h (sym "import")) (import_form args)
     (if (sym_eq h (sym "use")) (use_form args)
     (if (sym_eq h (sym "trusts")) (trusts_form args nil)
     FDecl))))
    (_ FDecl)))
(fn import_form ((args (List SExpr))) Form
  (match args
    ((cons (SStr p) nil) (FImportFile p))
    ((cons (SSym i) _)
     (if (sym_eq i (sym "Init"))
       (FBad (sym "bad_import")
         (utf8 "(import Init): every file sees Init, and no line says so — delete the line"))
       (FBad (sym "bad_import") (utf8 "(import \"FILE\")"))))
    (_ (FBad (sym "bad_import") (utf8 "(import \"FILE\")")))))
;; (use P) opens P; (use P a b) opens P for the names a… and b…; a leading
;; `Init` is dropped (reader.shard's drop_init) — imported names are bare in
;; K, so (use Init) opens nothing new and (use Init.List) opens `List`
(fn use_form ((args (List SExpr))) Form
  (match args
    ((cons (SSym p) ms)
     (match (name_of_sym p)
       (none (FBad (sym "bad_use") (utf8 "(use PREFIX NAME…)")))
       ((some n)
        (match (use_members ms nil)
          ((some syms) (FUse (drop_init n) syms))
          (none (FBad (sym "bad_use") (utf8 "(use PREFIX NAME…)")))))))
    (_ (FBad (sym "bad_use") (utf8 "(use PREFIX NAME…)")))))
(fn use_members ((ms (List SExpr)) (acc (List Symbol))) (Option (List Symbol))
  (measure (struct ms))
  (match ms
    (nil (some (rev acc)))
    ((cons (SSym s) r) (use_members r (cons s acc)))
    (_ none)))
(fn trusts_form ((args (List SExpr)) (acc (List Name))) Form
  (measure (struct args))
  (match args
    (nil (FTrusts (rev acc)))
    ((cons (SSym s) r)
     (match (name_of_sym s)
       ((some n) (trusts_form r (cons n acc)))
       (none (FBad (sym "bad_trusts") (utf8 "(trusts NAME…)")))))
    (_ (FBad (sym "bad_trusts") (utf8 "(trusts NAME…)")))))
(fn form_head ((s SExpr)) Symbol
  (match s
    ((SList (cons (SSym h) _)) h)
    (_ (sym "form"))))
(fn form_name ((sc Scope) (s SExpr)) Name
  (match s
    ((SList (cons _ (cons (SSym n) _)))
     (match (name_of_sym n)
       ((some m) (qualify sc m))
       (none Anon)))
    (_ Anon)))

;; ---- the policy ----------------------------------------------------------------------------
(fn std_axioms () (List Name)
  (list (n1 (sym "propext")) (n2 (sym "Quot") (sym "sound")) (n2 (sym "Classical") (sym "choice"))))
;; the axioms of a closure the file's policy lacks; a view parameter is a
;; parameter of the load: permitted, named on the record
(fn outside_policy ((sc Scope) (trusts (List Name)) (params (List Name)) (axs (List Name)))
  (List Name)
  (measure (struct axs))
  (match axs
    (nil nil)
    ((cons a r)
     (if (permitted sc trusts params a) (outside_policy sc trusts params r)
     (cons a (outside_policy sc trusts params r))))))
;; a standard axiom is Init's own: the constant under that name is one the load imported (its
;; ordinal table holds it), never a declaration of the load's — a name is no warrant
(fn permitted ((sc Scope) (trusts (List Name)) (params (List Name)) (a Name)) Bool
  (if (bool_and (mem_name a (std_axioms)) (imported_decl sc a)) true
  (if (mem_name a params) true
  (trusted sc trusts a))))
(fn imported_decl ((sc Scope) (a Name)) Bool
  (match (sc_vis sc)
    (VisAll true)
    ((VisOnly _ _ _ _ inits)
     (match (ords_find inits a)
       ((some _) true)
       (none false)))))
(fn params_of ((params (List Name)) (axs (List Name))) (List Name)
  (measure (struct axs))
  (match axs
    (nil nil)
    ((cons a r) (if (mem_name a params) (cons a (params_of params r)) (params_of params r)))))
;; a trusted name is spelled as a citation would be: it resolves through the scope
(fn trusted ((sc Scope) (ts (List Name)) (a Name)) Bool
  (measure (struct ts))
  (match ts
    (nil false)
    ((cons t r) (if (mem_name a (scope_candidates sc t)) true (trusted sc r a)))))

;; ---- admission of one form's declarations --------------------------------------------------
;; every constant a declaration adds to the environment, for the table
(fn decl_declares ((env CheckedEnv) (d Declaration)) (List Name)
  (match d
    ((InductDecl _ _ ts _) (block_names env (all_names ts)))
    (_ (list (decl_name d)))))
(fn block_names ((env CheckedEnv) (ts (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r)
     (cons t (append (induct_ctors env t) (cons (Str t (sym "rec")) (block_names env r)))))))
(fn decls_declare ((env CheckedEnv) (ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r) (append (decl_declares env d) (decls_declare env r)))))
(fn tbl_add_all ((tbl (IntMap (List (Prod Name Name)))) (ns (List Name)) (m Name))
  (IntMap (List (Prod Name Name)))
  (measure (struct ns))
  (match ns
    (nil tbl)
    ((cons n r) (tbl_add_all (tbl_add tbl n m) r m))))

(type Admit (AdOk CheckedEnv) (AdRefused Name Symbol))
;; an exhaustion's refusal symbol names the budget and K's site: a bare `exhausted` says
;; nothing of which budget, nor where
(fn resource_chars ((res Resource)) (List Int)  ; the constructors by their `use`: unresolved, they read as variable patterns (the arms all irrefutable, the C of the dead ones uncompilable)
  (match res
    (RHeartbeats (utf8 "heartbeats"))
    (RRecDepth (utf8 "rec_depth"))
    (RNatSize (utf8 "nat_size"))
    (RNatCount (utf8 "nat_count"))))
(fn exhausted_sym ((res Resource) (site Symbol)) Symbol
  (sym_of_chars
    (append (utf8 "exhausted_")
      (append (resource_chars res) (append (utf8 "_at_") (chars_of_sym site))))))
(fn admit_decls ((env CheckedEnv) (ds (List Declaration))) Admit
  (measure (struct ds))
  (match ds
    (nil (AdOk env))
    ((cons d r)
     (match (check env (st_init) d)
       ((Accepted e2) (admit_decls e2 r))
       ((Rejected reason subject) (AdRefused subject (reason_of reason)))
       ((Exhausted res site) (AdRefused (decl_name d) (exhausted_sym res site)))))))
;; the naming law for every name a file's declarations state — a constructor's and a
;; recursor's with the rest: none is a name of Init under the file's identity (Fx.taken) —
;; then K's admission into the load's environment. The law is asked of the export's name
;; table and before K, so its refusal is the same whether or not the load holds Init's
;; constant: where it does K's own refusal would be `already_declared`, and where it does
;; not, a file `Classical.shard` declaring `(axiom choice …)` would take the standard
;; axiom's identity and pass the policy by its name (pin init_name_taken_l). A `fn`, an
;; `extern` and a derivation are refused by their form's name before (name_taken); this is
;; every other declaration's
(fn admit_under ((l Load) (f Fx) (ds (List Declaration))) Admit
  (match (first_taken (Fx.taken f) (decls_state ds))
    ((some n) (AdRefused n (sym "name_taken")))
    (none (admit_decls (Load.env l) ds))))
;; the names the declarations state before K has them: each one's own, an inductive block's
;; types, constructors and recursors
(fn decls_state ((ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r)
     (append
       (match d
         ((InductDecl _ _ ts _) (append (induct_names ts) (rec_names (all_names ts))))
         (_ (list (decl_name d))))
       (decls_state r)))))
;; an inductive block's types, each with its constructors
(fn induct_names ((ts (List InductiveType))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons (InductiveType n _ cs) r) (cons n (append (induct_ctor_names cs) (induct_names r))))))
(fn induct_ctor_names ((cs (List Constructor))) (List Name)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (Constructor n _) r) (cons n (induct_ctor_names r)))))
(fn rec_names ((ts (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (cons (Str t (sym "rec")) (rec_names r)))))
(fn first_taken ((ts (List (List Int))) (ns (List Name))) (Option Name)
  (measure (struct ns))
  (match ns
    (nil none)
    ((cons n r) (if (taken_has ts (show_name n)) (some n) (first_taken ts r)))))

;; the closures of the declared names against the policy: the first
;; declaration outside it, or the records to add
(type Pol (PolOk Memos (List Rec)) (PolOut Name (List Name)) (PolBound Name))
;; a theorem's resolved requirement, for its acceptance; the walk's memo with it
(fn accept_key ((l Load) (f Fx) (env CheckedEnv) (rq ReqMemo) (n Name)) (Prod (Option Req) ReqMemo)
  (match (env_find env n)
    ((some (ThmInfo (ConstantVal _ _ ty) _ _))
     (match (req_key env (req_ctx l f) rq ty)
       ((Prod.mk k rq1) (Prod.mk (some k) rq1))))
    (_ (Prod.mk none rq))))
(fn policy_pass
  ((l Load) (f Fx) (env CheckedEnv) (memo Memos) (ds (List Declaration)) (acc (List Rec)))
  Pol
  (policy_names l f env memo (decls_subjects ds) acc))
;; what the declarations are accepted under: a declaration's name, and each type of a block of
;; types — every one has its closure checked and its record
(fn decls_subjects ((ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons (InductDecl _ _ ts _) r) (append (all_names ts) (decls_subjects r)))
    ((cons d r) (cons (decl_name d) (decls_subjects r)))))
(fn policy_names ((l Load) (f Fx) (env CheckedEnv) (memo Memos) (ns (List Name)) (acc (List Rec)))
  Pol
  (measure (struct ns))
  (match ns
    (nil (PolOk memo (rev acc)))
    ((cons n r)
     (match memo
       ((Memos ax rq)
        (match (axioms_of env ax n)
          ((Prod.mk _ none) (PolBound n))
          ((Prod.mk ax1 (some axs0))
           (let ((axs (discharge_axs (Load.discharged l) axs0 (+ 1 (len (Load.discharged l))))))
             (match (outside_policy (fx_scope l f) (Fx.trusts f) (Load.params l) axs)
               (nil
                 (match (accept_key l f env rq n)
                   ((Prod.mk q rq1)
                    (policy_names l f env (Memos ax1 rq1) r
                      (cons
                        (RAccept n (Fx.module f)
                          (match (identity_hash env n)
                            ((some h) h)
                            (none 0))
                          axs
                          (params_of (Load.params l) axs)
                          q)
                        acc)))))
               (out (PolOut n out)))))))))))
;; a closure with each discharged obligation replaced by what its proof rests on (to a
;; fixpoint: a proof may rest on another discharged obligation)
(fn discharge_axs ((ds (List (Prod Name (List Name)))) (axs (List Name)) (fuel Int)) (List Name)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) axs
  (match (first_discharged ds axs)
    (none axs)
    ((some (Prod.mk k rest)) (discharge_axs ds (names_union (names_without axs k) rest) (- fuel 1))))))
(fn first_discharged ((ds (List (Prod Name (List Name)))) (axs (List Name)))
  (Option (Prod Name (List Name)))
  (measure (struct ds))
  (match ds
    (nil none)
    ((cons (Prod.mk k rest) r)
     (if (mem_name k axs) (some (Prod.mk k rest)) (first_discharged r axs)))))
(fn names_without ((ns (List Name)) (k Name)) (List Name)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r) (if (name_eq n k) (names_without r k) (cons n (names_without r k))))))
(fulfills discharge_axs.dec_1 (by (intro p h k rest hm) (apply natAbs_pred (arith))))

(fn mix_recs ((f Fx) (rs (List Rec))) Fx
  (measure (struct rs))
  (match rs
    (nil f)
    ((cons (RAccept _ _ h _ _ _) r) (mix_recs (fx_mix f h) r))
    ((cons _ r) (mix_recs f r))))
(fn recs_add ((l Load) (rs (List Rec))) Load
  (measure (struct rs))
  (match rs
    (nil l)
    ((cons x r) (recs_add (ld_rec l x) r))))

;; a `fulfills` naming no obligation of the load: the cause is named — a declaration that is no
;; obligation, a prefix of the name refused above (its obligations were never stated), or
;; nothing of the load, where a requirement's fulfills belongs to an implementation. One
;; message for the three ("give the loader the directory") sends an author whose fn was
;; refused above to restructure the root
(fn fulfills_misnamed ((l Load) (f Fx) (sc Scope) (s SExpr)) Load
  (match s
    ((SList (cons _ (cons (SSym x) (cons _ nil))))
     (match (name_of_sym x)
       (none (ld_rec l (RLoadErr (fx_file f) (sym "bad_name") (chars_of_sym x))))
       ((some n)
        (match (resolve (cx0 sc (Load.env l) nil nil) n)
          ((RName k _)
           (ld_rec l
             (RLoadErr (fx_file f) (sym "fulfills_not_obligation")
               (append (show_name k)
                 (utf8
                   " is a declaration, not an obligation: a measured fn's obligations are its PARAM NAME.dec_N obligation records; a requirement's fulfills belongs to an implementation — give the loader the directory")))))
          (_
            (let ((q (qualify sc n)))
              (match (refused_parent (Load.recs l) q)
                ((some p)
                 (ld_rec l
                   (RLoadErr (fx_file f) (sym "fulfills_refused")
                     (append (show_name q)
                       (append (utf8 ": no obligation of that name — ")
                         (append (show_name p)
                           (utf8
                             " was refused above, so its obligations were never stated; mend the refusal first")))))))
                (none
                  (ld_rec l
                    (RLoadErr (fx_file f) (sym "fulfills_outside_impl")
                      (append (show_name q)
                        (utf8
                          ": no obligation of that name in this load — a measured fn states its obligations as PARAM NAME.dec_N records above its definition; a requirement's fulfills belongs to an implementation — give the loader the directory"))))))))))))
    (_ (ld_rec l (RLoadErr (fx_file f) (sym "bad_shape") (utf8 "(fulfills NAME PROOF)"))))))
;; the nearest prefix of k that a REFUSE record of the load names
(fn refused_parent ((rs (List Rec)) (k Name)) (Option Name)
  (measure (struct k))
  (match k
    ((Str p _) (if (refused_named rs p) (some p) (refused_parent rs p)))
    ((Num p _) (if (refused_named rs p) (some p) (refused_parent rs p)))
    (Anon none)))
(fn refused_named ((rs (List Rec)) (k Name)) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RRefuse n _) r) (if (name_eq n k) true (refused_named r k)))
    ((cons (RClassify n _ _) r) (if (name_eq n k) true (refused_named r k)))
    ((cons _ r) (refused_named r k))))
;; one declared form: read, admit, check the policy, record. A view holds
;; L forms and parameters, never E bodies; a parameter belongs in a view. `fn`
;; and `extern` are read by the classifier; `type` and `sig` gain their E
;; twins beside K's — a `type` over E's built-in types alone is E only
;; (type_is_e_only). K checks any L form in any file.
(fn load_decl_at ((l Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (let ((sc (fx_scope l f)) (h (form_head s)))
    (load_decl_go
      (if (bool_and (fx_private f) (bool_or (sym_eq h (sym "fn")) (sym_eq h (sym "type"))))
        (ld_add_form l (form_name sc s) sc s)
        l)
      f
      s)))
(fn load_decl ((l0 Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (let ((h (form_head s)))
    ;; a form other than a fn can change any reading the search for a group keeps (a type, a
    ;; proof, a derivation — which writes its table after the fns it generates): none is kept
    ;; across one
    (if (sym_eq h (sym "fn")) (load_decl_at l0 f s)
    (match (load_decl_at (ld_forget_all l0) f s)
      ((Prod.mk l1 f1) (Prod.mk (ld_forget_all l1) f1))))))
;; under the driver's --unchecked a load reads programs, and a proof is no part of one: a
;; theorem and a fulfills are passed over, as the bootstrap's reader passes them. (A proof
;; written inside a fn is refused there, `unchecked_proof`: a value would rest on it.)
(fn passed_over ((l Load) (h Symbol)) Bool
  (bool_and (Load.unchecked l) (bool_or (sym_eq h (sym "theorem")) (sym_eq h (sym "fulfills")))))
;; the forms of a file that such a load reads: what the export is asked for is what their
;; tokens name, so a build fetches no constant that only a proof cites, and the driver's
;; --facts lists none
(fn forms_read ((l Load) (forms (List SExpr))) (List SExpr)
  (measure (struct forms))
  (match forms
    (nil nil)
    ((cons s r) (if (passed_over l (form_head s)) (forms_read l r) (cons s (forms_read l r))))))
(fn load_decl_go ((l Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (let ((sc (fx_scope l f)) (h (form_head s)))
    (if
      (bool_and (Fx.view f)
        (bool_or (sym_eq h (sym "fn"))
          (bool_or (sym_eq h (sym "extern"))
            (bool_or (sym_eq h (sym "realize"))
              (bool_or (sym_eq h (sym "derive"))
                (bool_or (sym_eq h (sym "fulfills")) (sym_eq h (sym "bin"))))))))
      (Prod.mk
        (ld_rec l
          (RLoadErr (fx_file f) (sym "view_form")
            (append (chars_of_sym h)
              (utf8 ": a view holds declarations and parameters, never bodies"))))
        f)
      (if
        (bool_and (bool_not (Fx.view f))
          (bool_or (sym_eq h (sym "sig")) (sym_eq h (sym "requirement"))))
        (Prod.mk
          (ld_rec l
            (RLoadErr (fx_file f) (sym "sig_outside_view")
              (append (chars_of_sym h) (utf8 ": a parameter belongs in a view (mod.req.shard)"))))
          f)
        (if (passed_over l h) (Prod.mk l f)
        (if (sym_eq h (sym "bin")) (Prod.mk l (fx_add_bin f s))  ; stashed; checked at the file's end, after every fn settled (rec_bins)
        (if (bool_or (sym_eq h (sym "fn")) (sym_eq h (sym "extern"))) (load_e_form l f s)
        (if (bool_and (sym_eq h (sym "type")) (mem_name (type_name sc s) (Load.tahead l)))
          ;; admitted with a type above it that cites it: the program's declaration, here
          (Prod.mk
            (add_e_twin_now (ld_with_tahead l (names_without (Load.tahead l) (type_name sc s))) f s)
            f)
          (if (bool_and (sym_eq h (sym "type")) (type_is_e_only (Load.etab l) sc (Load.env l) s))
            (load_e_form l f s)  ; E only (its namespace was opened at pre-registration, as every type's)
          (if (sym_eq h (sym "realize")) (Prod.mk (load_realize l f s) f)
          (if (sym_eq h (sym "derive")) (load_derive l f s)
          (if (sym_eq h (sym "fulfills"))
            (match (obligation_named l sc s)
              ((some (Prod.mk k proof)) (Prod.mk (load_discharge l f k proof) f))
              (none (Prod.mk (fulfills_misnamed l f sc s) f)))
          (if (program_named l (form_name sc s))
            (Prod.mk
              (ld_rec l
                (RClassify (form_name sc s) (sym "name_taken")
                  (append (show_name (form_name sc s))
                    (utf8
                      " is a fn or an extern of the program with no constant of K behind it: a declaration under its name would give the name a meaning its program does not have — declare another name"))))
              f)
          (if (bool_and (sym_eq h (sym "def")) (def_measured s)) (load_ldef l f s 2)  ; a def that recurses: the fn pipeline's K half
          (match
            (rd_plain l sc (fx_file f) Anon
              (read_decl_autos sc (Load.env l) s (producers_of l f) (Load.mode l)))
            ((Prod.mk l rd)
             (match rd
               ((RDErr e m)
                (if (bool_and (sym_eq h (sym "sig")) (Fx.view f)) (sig_e_only l f s e m)
                (Prod.mk (ld_rec l (read_refusal f e m)) f)))
               ((RDPending n r) (Prod.mk (ld_rec (ld_add_pending l n) (RPending n r)) f))
               ((RDParam d kind arity)
                (match (admit_param l f d kind arity)
                  ((Prod.mk l1 f1) (Prod.mk (add_e_twin l1 f1 s) f1))))
               ((RDOk ds) (admit_read l f s ds))
               (_
                 (Prod.mk
                   (ld_rec l
                     (RLoadErr (fx_file f) (sym "bad_directive") (utf8 "an unhandled reading")))
                   f)))))))))))))))))))
;; a name the E table holds a program for — a fn, an extern — while K holds no constant of it:
;; a fn with no L meaning. The other direction is name_taken's: a fn or an extern may not take
;; an admitted constant's name. Were a `def` after such a fn to take its name, a typed fn
;; citing it would be defined against the def and run the fn (pin def_takes_fn)
(fn program_named ((l Load) (n Name)) Bool
  (if (env_has (Load.env l) n) false
  (match (es_find_decl (Load.etab l) n)
    ((some (EFn _ _ _ _ _ _)) true)
    ((some (EExtern _ _ _ _)) true)
    (_ false))))

;; ---- a derivation (derive.shard) -----------------------------------------------------------
;; the forms a capability generated are loaded as the file's own at this point — the one front
;; end, their ordinary records — and the procedure is registered once K has its definition:
;; the table's entry and the DERIVE record. A generated function that was not defined (its own
;; record says why) registers nothing, and the capabilities after it are not attempted
(fn load_derive ((l Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (match (derive_form (fx_scope l f) (Load.env l) s)
    ((DvErr e m)
     (Prod.mk (ld_rec l (RClassify (qualify (fx_scope l f) (n1 (sym "derive"))) e m)) f))
    ((DvOk gens) (load_derived l f gens))))
(fn load_derived ((l Load) (f Fx) (gens (List DvGen))) (Prod Load Fx)
  (measure (struct gens))
  (match gens
    (nil (Prod.mk l f))
    ((cons (DvGen ty cap p policy procs forms) r)
     (match (load_derived_forms l f forms)
       ((Prod.mk (Prod.mk l1 f1) ok)
        (if (bool_and ok (derive_defined (Load.env l1) p (sym_eq policy (sym "by"))))
          (load_derived
            (ld_rec
              (with Load l1 (derived (cons (Derived ty cap p (Fx.module f1)) (Load.derived l1))))
              (RDerive p ty cap policy procs))
            (fx_mix f1 (name_key p))
            r)
          (Prod.mk
            (ld_rec l1
              (RClassify p (sym "derive_failed")
                (utf8
                  "the generated function was not defined (its own record says why): nothing is registered, and the capabilities after it are not attempted")))
            f1)))))))
;; a generated procedure is a definition K admitted; one the file named (`by`) is any constant
;; of the capability's type — a view's sig fn is a parameter in its consumer
(fn derive_defined ((env CheckedEnv) (p Name) (by Bool)) Bool
  (match (env_find env p)
    ((some (DefnInfo _ _ _ _ _)) true)
    ((some _) by)
    (none false)))
;; a generated form's head is registered as the file's own heads were before its first body,
;; so an E-first body finds the function too
;; False: a form's name is taken — a constant of the file's already bears it, which is never
;; the derivation's (else a hand-written `T.compare` is registered as the structural
;; ordering) — or its head could not be registered
(fn load_derived_forms ((l Load) (f Fx) (forms (List SExpr))) (Prod (Prod Load Fx) Bool)
  (measure (struct forms))
  (match forms
    (nil (Prod.mk (Prod.mk l f) true))
    ((cons s r)
     (let ((k (form_name (fx_scope l f) s)))
       (if (name_taken l f k)
         (Prod.mk
           (Prod.mk
             (ld_rec l
               (RClassify k (sym "name_taken")
                 (append (show_name k)
                   (utf8 " is already declared: a derivation generates this name"))))
             f)
           false)
         (match (pre_register (Load.etab l) (fx_scope l f) (list s))
           ((PreErr e m) (Prod.mk (Prod.mk (ld_rec l (RClassify k e m)) f) false))
           ((PreOk es)
            (match (load_decl (ld_with_e l es) f s)
              ((Prod.mk l1 f1) (load_derived_forms l1 f1 r))))))))))

;; ---- a descent obligation discharged -------------------------------------------------------
;; (fulfills f.dec_N PROOF) after the function, outside a view: PROOF elaborated against the
;; obligation's statement and checked by K as the theorem f.dec_N.proof. Its axiom closure —
;; every discharged obligation in it already replaced by what *its* proof rests on — is the
;; acyclicity check: a proof that reaches its own obligation, directly, through the function
;; (whose value cites it), through a theorem or through a second obligation, is
;; `fulfills_cycle` and closes nothing. On success DISCHARGE, and the account is recomputed:
;; every record that named the obligation names what the proof rests on instead, and a
;; function with no obligation left is no longer PENDING nor anyone's pending root
(fn obligation_named ((l Load) (sc Scope) (s SExpr)) (Option (Prod Name SExpr))
  (match s
    ((SList (cons _ (cons (SSym x) (cons proof nil))))
     (match (name_of_sym x)
       (none none)
       ((some n)
        (match (resolve (cx0 sc (Load.env l) nil nil) n)
          ((RName k _) (if (is_obligation (Load.recs l) k) (some (Prod.mk k proof)) none))
          (_ none)))))
    (_ none)))
(fn is_obligation ((rs (List Rec)) (k Name)) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RParam n kind _) r)
     (if (bool_and (name_eq n k) (sym_eq kind (sym "obligation"))) true (is_obligation r k)))
    ((cons _ r) (is_obligation r k))))
(fn load_discharge ((l Load) (f Fx) (k Name) (proof SExpr)) Load
  (if (has_discharged (Load.discharged l) k)
    (ld_rec l
      (RClassify k (sym "fulfills_twice") (append (show_name k) (utf8 " is already discharged"))))
    (match (env_find (Load.env l) k)
      (none l)
      ((some info)
       (let ((thm (name_append k (n1 (sym "proof")))))
         (match
           (rd_plain l (fx_scope l f) (fx_file f) k
             (read_discharge (fx_scope l f) (Load.env l) thm (ci_type info) proof (producers_of l f)
               (Load.mode l)))
           ((Prod.mk l rd)
            (match rd
              ((RDErr e m) (ld_rec l (read_refusal f e m)))
              ((RDPending nn r) (ld_rec (ld_add_pending l nn) (RPending nn r)))
              ((RDOk ds)
               (match (admit_under l f ds)
                 ((AdRefused subj reason) (ld_rec l (refusal_rec l ds subj reason)))
                 ((AdOk env1)
                  (match (policy_pass l f env1 (Load.memo l) ds nil)
                    ((PolBound n)
                     (ld_rec l (RLoadErr (fx_file f) (sym "closure_bound") (show_name n))))
                    ((PolOut n out)
                     (ld_rec (ld_with_env l (Load.env l) (memos_empty)) (RPolicy n out)))
                    ((PolOk memo1 recs)
                     (let ((rests (thm_closure_of recs thm)))
                       (if (mem_name k rests)
                         (ld_rec l
                           (RClassify k (sym "fulfills_cycle")
                             (append (utf8 "the proof of ")
                               (append (show_name k)
                                 (utf8
                                   " rests on the obligation it discharges — through the function, a theorem or another obligation; nothing is closed")))))
                         (let
                           ((l1
                              (recs_add
                                (ld_with_tbl (ld_with_env l env1 memo1)
                                  (tbl_add_all (Load.tbl l) (decls_declare env1 ds) (Fx.module f)))
                                recs)))
                           (settle_discharge
                             (ld_rec
                               (with Load l1
                                 (discharged (cons (Prod.mk k rests) (Load.discharged l1))))
                               (RDischarge k (sym "proved")))
                             k
                             rests)))))))))
              (_ l)))))))))
(fn has_discharged ((ds (List (Prod Name (List Name)))) (k Name)) Bool
  (measure (struct ds))
  (match ds
    (nil false)
    ((cons (Prod.mk n _) r) (if (name_eq n k) true (has_discharged r k)))))
(fn thm_closure_of ((recs (List Rec)) (n Name)) (List Name)
  (measure (struct recs))
  (match recs
    (nil nil)
    ((cons (RAccept m _ _ axs _ _) r) (if (name_eq m n) axs (thm_closure_of r n)))
    ((cons _ r) (thm_closure_of r n))))
;; the account recomputed: k replaced in every ACCEPT record's closure and parameters; its
;; function, once none of its obligations is open, out of every pending= and no longer PENDING
(fn settle_discharge ((l Load) (k Name) (rests (List Name))) Load
  (let ((rs1 (rewrite_closures (Load.recs l) k rests (Load.params l))) (g (obligation_owner k)))
    (if (open_obligation rs1 g (Load.discharged l)) (ld_with_recs_raw l rs1)
    (with Load (ld_with_recs_raw l (drop_root rs1 g)) (pm (pm_without (Load.pm l) g))))))
(fn obligation_owner ((n Name)) Name
  (match n
    ((Str p _) p)
    ((Num p _) p)
    (Anon Anon)))
(fn rewrite_closures ((rs (List Rec)) (k Name) (rests (List Name)) (params (List Name))) (List Rec)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (RAccept n m h axs ps q) r)
     (cons
       (if (mem_name k axs)
         (let ((axs1 (names_union (names_without axs k) rests)))
           (RAccept n m h axs1 (params_of params axs1) q))
         (RAccept n m h axs ps q))
       (rewrite_closures r k rests params)))
    ((cons x r) (cons x (rewrite_closures r k rests params)))))
;; an obligation of g — a parameter g.dec_N — not yet discharged
(fn open_obligation ((rs (List Rec)) (g Name) (ds (List (Prod Name (List Name))))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RParam n kind _) r)
     (if
       (bool_and (sym_eq kind (sym "obligation"))
         (bool_and (name_eq (obligation_owner n) g) (bool_not (has_discharged ds n))))
       true
       (open_obligation r g ds)))
    ((cons _ r) (open_obligation r g ds))))
(fn drop_root ((rs (List Rec)) (g Name)) (List Rec)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (RPending n why) r)
     (if (bool_and (name_eq n g) (sym_eq why (sym "measure"))) (drop_root r g)
     (cons (RPending n why) (drop_root r g))))
    ((cons (RDefine n eqs roots) r) (cons (RDefine n eqs (names_without roots g)) (drop_root r g)))
    ((cons (RRealize n kind eqs roots) r)
     (cons (RRealize n kind eqs (names_without roots g)) (drop_root r g)))
    ((cons x r) (cons x (drop_root r g)))))
(fn pm_without ((pm (List (Prod Name (List Name)))) (g Name)) (List (Prod Name (List Name)))
  (measure (struct pm))
  (match pm
    (nil nil)
    ((cons (Prod.mk n roots) r) (cons (Prod.mk n (names_without roots g)) (pm_without r g)))))
;; an axiom the file trusts is a declared parameter: recorded PARAM NAME axiom — the manifest's
;; `param` line, every theorem resting on it verified conditional on a named parameter, its
;; discharge an obligation's — and not entered in the load's parameters, so the policy stays
;; per file (pin policy_cross: a file that rests on it trusts it). An axiom the file does not
;; trust takes the ordinary path and is refused by the policy (pin policy_axiom).
(fn admit_read ((l Load) (f Fx) (s SExpr) (ds (List Declaration))) (Prod Load Fx)
  (match ds
    ((cons (AxiomDecl cv u) nil)
     (if (trusted (fx_scope l f) (Fx.trusts f) (decl_name (AxiomDecl cv u)))
       (admit_axiom_param l f (AxiomDecl cv u))
       (admit_forms l f s ds)))
    (_ (admit_forms l f s ds))))
(fn admit_axiom_param ((l Load) (f Fx) (d Declaration)) (Prod Load Fx)
  (let ((n (decl_name d)))
    (match (check (Load.env l) (st_init) d)
      ((Accepted env1)
       (Prod.mk
         (ld_rec
           (ld_with_tbl (ld_with_env l env1 (Load.memo l)) (tbl_add (Load.tbl l) n (Fx.module f)))
           (RParam n (sym "axiom") 0))
         (fx_mix f
           (match (identity_hash env1 n)
             ((some h) h)
             (none 0)))))
      ((Rejected reason subject) (Prod.mk (ld_rec l (RRefuse subject (reason_of reason))) f))
      ((Exhausted res site) (Prod.mk (ld_rec l (RRefuse n (exhausted_sym res site))) f)))))
;; L declarations admitted, checked against the policy, recorded; a type's or a sig's E twin
(fn admit_forms ((l Load) (f Fx) (s SExpr) (ds (List Declaration))) (Prod Load Fx)
  (match (admit_core l f ds)
    ((Prod.mk l1 none) (Prod.mk l1 f))
    ((Prod.mk l1 (some recs)) (bundle_after (add_e_twin l1 f s) (mix_recs f recs) ds))))
(fn admit_core ((l Load) (f Fx) (ds (List Declaration))) (Prod Load (Option (List Rec)))
  (match (admit_under l f ds)
    ((AdRefused subj reason) (Prod.mk (ld_rec l (refusal_rec l ds subj reason)) none))
    ((AdOk env1)
     (match (policy_pass l f env1 (Load.memo l) ds nil)
       ((PolBound n)
        (Prod.mk
          (ld_rec (ld_with_env l (Load.env l) (memos_empty))
            (RLoadErr (fx_file f) (sym "closure_bound") (show_name n)))
          none))
       ((PolOut n out)
        (Prod.mk (ld_rec (ld_with_env l (Load.env l) (memos_empty)) (RPolicy n out)) none))
       ((PolOk memo1 recs)
        (Prod.mk
          (recs_add
            (ld_with_tbl (ld_with_env l env1 memo1)
              (tbl_add_all (Load.tbl l) (decls_declare env1 ds) (Fx.module f)))
            recs)
          (some recs)))))))
;; a native inductive just admitted gets its constructor-structure bundle (define.shard's
;; confusion_bundle): casesOn, and with Init's Eq in scope noConfusionType,
;; noConfusion and the c.inj theorems — ACCEPT records of their own, checked by K; each type
;; of a block has its own
(fn bundle_after ((l Load) (f Fx) (ds (List Declaration))) (Prod Load Fx)
  (bundle_each l f (inducts_in ds)))
(fn bundle_each ((l Load) (f Fx) (inds (List Name))) (Prod Load Fx)
  (measure (struct inds))
  (match inds
    (nil (Prod.mk l f))
    ((cons ind r)
     (match (confusion_bundle (Load.etab l) (fx_scope l f) (Load.env l) ind)
       (nil (bundle_each l f r))
       (bs
         (match (admit_core l f bs)
           ((Prod.mk l1 none) (bundle_each l1 f r))
           ((Prod.mk l1 (some recs)) (bundle_each l1 (mix_recs f recs) r))))))))
;; the types of the blocks among the declarations, in order
(fn inducts_in ((ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons (InductDecl _ _ ts _) r) (append (all_names ts) (inducts_in r)))
    ((cons _ r) (inducts_in r))))
;; a realization: the E body under an admitted constant's identity; its equations admitted
;; as theorems through the same path as any declaration — one refused, nothing attached
(fn load_realize ((l0 Load) (f Fx) (s SExpr)) Load
  (let ((l (scan_form l0 f s)) (sc (fx_scope l0 f)))
    (match (realize_dispatch (Load.etab l) sc (Load.env l) s)
      ((RzErr e m) (ld_rec l (RClassify (realize_subject sc (Load.env l) s) e m)))
      ((RzOk es1 d aux thms pending lifted demands)
       (match (admit_matchers l f s aux)
         ((Prod.mk l9 none) l9)
         ((Prod.mk l9 (some f9))
          (both_realized (load_realized l9 f9 s es1 d thms pending lifted demands) l sc s d lifted))))
      ((RzTemplate k e body prec binds rt rl ls aux thms pending)
       (match (admit_matchers l f s aux)
         ((Prod.mk l9 none) l9)
         ((Prod.mk l9 (some f9))
          (load_realize_template l9 f9
            (Template k e body prec binds rt (TmRealize rl ls (decl_names thms)))
            thms
            pending)))))))
(fn decl_names ((ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r) (cons (decl_name d) (decl_names r)))))
;; the realization's theorems admitted and checked against the policy: the loader after them
;; with the environment, or the loader with the refusal recorded
(type AtRes (AtOk Load CheckedEnv) (AtDone Load))
(fn admit_theorems ((l Load) (f Fx) (thms (List Declaration))) AtRes
  (match (admit_under l f thms)
    ((AdRefused subj reason) (AtDone (ld_rec l (refusal_rec l thms subj reason))))
    ((AdOk env1)
     (match (policy_pass l f env1 (Load.memo l) thms nil)
       ((PolBound n)
        (AtDone
          (ld_rec (ld_with_env l (Load.env l) (memos_empty))
            (RLoadErr (fx_file f) (sym "closure_bound") (show_name n)))))
       ((PolOut n out) (AtDone (ld_rec (ld_with_env l (Load.env l) (memos_empty)) (RPolicy n out))))
       ((PolOk memo1 recs)
        (AtOk
          (recs_add
            (ld_with_tbl (ld_with_env l env1 memo1)
              (tbl_add_all (Load.tbl l) (decls_declare env1 thms) (Fx.module f)))
            recs)
          env1))))))
;; the lambdas a realize body lifted and the instances it demands are built before its program
;; is added (as a fn's); a demand refused leaves the realization unrecorded
(fn load_realized
  ((l Load)
   (f Fx)
   (s SExpr)
   (es1 ESt)
   (d EDecl)
   (thms (List Declaration))
   (pending Bool)
   (lifted (List Lifted))
   (demands (List Demand)))
  Load
  (let ((k (edecl_name d)))
    (match (admit_theorems l f thms)
      ((AtDone l1) l1)
      ((AtOk l1 env1)
       (match (admit_lifted (ld_with_e l1 es1) f lifted)
         ((Prod.mk l1a none) l1a)
         ((Prod.mk l1a (some f1a))
          (match (build_demands l1a f1a k demands 64)
            ((Prod.mk l1b none) l1b)
            ((Prod.mk l1b (some _))
             (let ((roots (realize_roots l1b k d pending)))
               (let
                 ((l2
                    (ld_rec
                      (ld_with_e (ld_add_pm l1b k roots)
                        (es_add_decl (es_register_all (Load.etab l1b) (Fx.module f) (decl_infos d))
                          d))
                      (RRealize k (realize_kind s) (decls_declare env1 thms) roots))))
                 (if pending (ld_rec l2 (RPending k (sym "measure"))) l2)))))))))))
;; a realize template: the body checked once at placeholder shapes, its equations
;; admitted, the template registered with its binders' roles; no program, no REALIZE: TEMPLATE
(fn load_realize_template ((l Load) (f Fx) (tm Template) (thms (List Declaration)) (pending Bool))
  Load
  (let ((k (tm_name tm)))
    (match (check_template (Load.etab l) (fx_scope l f) tm)
      ((some (Prod.mk e m)) (ld_rec l (RClassify k e m)))
      (none
        (match (admit_theorems l f thms)
          ((AtDone l1) l1)
          ((AtOk l1 env1)
           (match (register_template l1 (Fx.module f) (fx_scope l f) tm (decls_declare env1 thms))
             ((Prod.mk l2 ok)
              (if (bool_and ok pending) (ld_rec l2 (RPending k (sym "measure"))) l2)))))))))
;; the pending obligations a realization carries: its own measure when
;; it is not structural, and every root a callee's realization already carries — an obligation is
;; recorded once, at its constant (PENDING), and every realization that reaches it names it
;; (REALIZE … pending=), so a retained candidate is never mistaken for a completed realization
;; through a caller
(fn realize_roots ((l Load) (k Name) (d EDecl) (pending Bool)) (List Name)
  (let
    ((inherited
       (roots_of (Load.pm l)
         (match d
           ((EFn _ _ _ _ _ body) (calls_of body))
           (_ nil))
         nil)))
    (if (bool_and pending (bool_not (mem_name k inherited))) (cons k inherited) inherited)))  ; a member of a group inherits itself from its group (load_group)
(fn roots_of ((pm (List (Prod Name (List Name)))) (calls (List Name)) (acc (List Name))) (List Name)
  (measure (struct calls))
  (match calls
    (nil (rev acc))
    ((cons c r)
     (roots_of pm r
       (match (pm_find pm c)
         ((some rs) (names_union acc rs))
         (none acc))))))  ; k/axioms.shard's union
(fn pm_find ((pm (List (Prod Name (List Name)))) (n Name)) (Option (List Name))
  (measure (struct pm))
  (match pm
    (nil none)
    ((cons (Prod.mk k rs) r) (if (name_eq k n) (some rs) (pm_find r n)))))
;; the refusal's subject: the target's identity when it resolves, else the form's name
(fn realize_subject ((sc Scope) (env CheckedEnv) (s SExpr)) Name
  (match s
    ((SList (cons _ (cons (SSym x) _)))
     (match (name_of_sym x)
       ((some n)
        (match (resolve (cx0 sc env nil nil) n)
          ((RName k _) k)
          (_ (form_name sc s))))
       (none (form_name sc s))))
    (_ (form_name sc s))))
(fn realize_dispatch ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (cons _ (cons _ (cons (SList (cons (SSym v) nil)) nil))))
     (if (sym_eq v (sym "view")) (realize_view es sc env s) (realize_supplied es sc env s)))
    (_ (realize_supplied es sc env s))))
(fn realize_kind ((s SExpr)) Symbol
  (match s
    ((SList (cons _ (cons _ (cons (SList (cons (SSym v) nil)) nil))))
     (if (sym_eq v (sym "view")) (sym "view") (sym "supplied")))
    (_ (sym "supplied"))))
;; an E declaration. An extern or an E-only type is classified and RUNNABLE. A `fn` is read
;; once as a pre-definition (predef.shard): its program is the erasure, its
;; definition K's projection — DEFINE with its equations, RUNNABLE `route=typed` with the
;; obstacle named when K's half cannot be reached, or refused. A `fn` whose signature has no L
;; reading never enters the route: the classifier's program, `route=e_first`. Under the
;; driver's --unchecked no `fn` enters it: each is the classifier's program, `why=unchecked`
;; — what a build reads its sources by, the check of the same sources being a load without
;; the flag. A type error is then compiled, not refused, and no `fn` has a definition
(fn load_e_form ((l Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (let ((sc (fx_scope l f)) (l1 (scan_form l f s)))
    (if (name_taken l1 f (form_name sc s))
      (Prod.mk
        (ld_rec l1
          (RClassify (form_name sc s) (sym "name_taken")
            (append (show_name (form_name sc s))
              (utf8 " is an admitted constant: realize it, or declare another name"))))
        f)
    (if (sym_eq (form_head s) (sym "fn"))
      (if (Load.unchecked l1) (load_e_first l1 f s (sym "unchecked") (sym "e_first"))
      (match (load_fn l1 f s 2)
        ((Prod.mk l2 f2)
         (if (= (len (Load.parked l2)) (len (Load.parked l1)))
           ;; loaded, not parked: the readings kept of the forms that name it hold no longer
           (match (retry_parked (ld_forget l2 (form_name sc s)) f2 (+ 1 (len (Load.parked l2))))
             ((Prod.mk l3 f3) (settle_groups l3 f3 (+ 1 (len (Load.parked l3))))))
           (settle_groups l2 f2 (+ 1 (len (Load.parked l2))))))))
    (if (sym_eq (form_head s) (sym "type")) (load_unheld_type l1 f s)
    (load_extern l1 f s))))))
;; a type with a field over a type K does not hold. When each such type stands below in the
;; file, with the types it needs in turn — types that name each other, or a type cited above
;; its form — they are admitted here, where the first of them stands: of those not yet
;; admitted, the one that needs the fewest with those it needs, as one block, again and again
;; (types that name each other are a block; a type that cites them without being named back
;; follows, alone). Their records stand here; the program's declaration of each stands where
;; its form does (load_decl_go). Otherwise one of the types is a program only, and so is this
;; one: the classifier's declaration, RUNNABLE `why=e_only_type`
(fn load_unheld_type ((l Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (match
    (gather_types l (fx_scope l f) (type_unheld (Load.etab l) (fx_scope l f) (Load.env l) s)
      (list (Prod.mk (type_name (fx_scope l f) s) s))
      (wait_fuel))
    (none (load_e_first l f s (sym "e_only_type") (sym "none")))
    ((some have)
     (match (classify_form (Load.etab l) (fx_scope l f) (Load.env l) s)
       ((CErr e m) (Prod.mk (ld_rec l (RClassify (form_name (fx_scope l f) s) e m)) f))
       ((COk d)
        (admit_gathered (ld_with_e l (es_add_decl (Load.etab l) d)) f (edecl_name d)
          (cons (Prod.mk (edecl_name d) s) (types_in_order (fx_scope l f) (Load.later l) have))
          (+ 1 (len have))))
       ((COkT _ _ _)
        (Prod.mk
          (ld_rec l (RLoadErr (fx_file f) (sym "bad_shape") (utf8 "a type takes no instance")))
          f))))))
(fn wait_fuel () Int 100000)
;; the types named and the types below that they need, each with its form: None when one of
;; them does not stand below — it is a program only, or no type
(fn gather_types ((l Load) (sc Scope) (todo (List Name)) (have (List (Prod Name SExpr))) (fuel Int))
  (Option (List (Prod Name SExpr)))
  (measure (Int.natAbs fuel))
  (if (< fuel 1) none
  (match todo
    (nil (some have))
    ((cons n r)
     (if (waits_has have n) (gather_types l sc r have (- fuel 1))
     (match (below_type sc (Load.later l) n)
       (none none)
       ((some s)
        (gather_types l sc (append (type_unheld (Load.etab l) sc (Load.env l) s) r)
          (cons (Prod.mk n s) have)
          (- fuel 1)))))))))
;; the form of a type among those below the declaration being read, as far as the scope they
;; are read in is this one's: up to the next `use`, `trusts` or import
(fn below_type ((sc Scope) (forms (List SExpr)) (n Name)) (Option SExpr)
  (measure (struct forms))
  (match forms
    (nil none)
    ((cons s r)
     (match (form_of s)
       (FDecl
         (if (bool_and (sym_eq (form_head s) (sym "type")) (name_eq (type_name sc s) n)) (some s)
         (below_type sc r n)))
       (_ none)))))
;; those of the forms below that are among the gathered types, in the file's order
(fn types_in_order ((sc Scope) (forms (List SExpr)) (have (List (Prod Name SExpr))))
  (List (Prod Name SExpr))
  (measure (struct forms))
  (match forms
    (nil nil)
    ((cons s r)
     (match (form_of s)
       (FDecl
         (if (bool_and (sym_eq (form_head s) (sym "type")) (waits_has have (type_name sc s)))
           (cons (Prod.mk (type_name sc s) s) (types_in_order sc r have))
           (types_in_order sc r have)))
       (_ nil)))))
(fn waits_has ((ws (List (Prod Name SExpr))) (n Name)) Bool
  (measure (struct ws))
  (match ws
    (nil false)
    ((cons (Prod.mk m _) r) (if (name_eq m n) true (waits_has r n)))))
;; the gathered types admitted block by block. K's refusal of a block, or a block that does
;; not read, ends it: the types left are read where their forms stand
(fn admit_gathered ((l Load) (f Fx) (self Name) (ws (List (Prod Name SExpr))) (fuel Int))
  (Prod Load Fx)
  (measure fuel)
  (if (< fuel 1) (Prod.mk l f)
  (match (twaits_cited l (fx_scope l f) ws)
    (nil (Prod.mk l f))
    (c
      (match (admit_types l f self (wait_group c c (wait_fuel) nil))
        ((Prod.mk (Prod.mk l1 f1) none) (Prod.mk l1 f1))
        ((Prod.mk (Prod.mk l1 f1) (some done))
         (admit_gathered l1 f1 self (waits_without ws done) (- fuel 1))))))))
;; each type with what its fields cite that K does not hold, as things stand
(fn twaits_cited ((l Load) (sc Scope) (ws (List (Prod Name SExpr)))) (List TWait)
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons (Prod.mk n s) r)
     (cons (TWait n s (type_unheld (Load.etab l) sc (Load.env l) s)) (twaits_cited l sc r)))))
(fn waits_without ((ws (List (Prod Name SExpr))) (ns (List Name))) (List (Prod Name SExpr))
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons (Prod.mk n s) r)
     (if (mem_name n ns) (waits_without r ns) (cons (Prod.mk n s) (waits_without r ns))))))
(fn twait_names ((ws (List TWait))) (List Name)
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons (TWait n _ _) r) (cons n (twait_names r)))))
;; of the types, the one that needs the fewest with those it needs, in the file's order
(fn wait_group ((c (List TWait)) (left (List TWait)) (fuel Int) (best (List Name))) (List TWait)
  (measure (struct left))
  (match left
    (nil (waits_named c best))
    ((cons (TWait n _ _) r) (wait_group c r fuel (fewer best (wait_reach c (list n) nil fuel))))))
(fn fewer ((best (List Name)) (g (List Name))) (List Name)
  (match best
    (nil g)
    (_ (if (< (len g) (len best)) g best))))
;; a type and the types it needs among them, through what each cites
(fn wait_reach ((c (List TWait)) (todo (List Name)) (seen (List Name)) (fuel Int)) (List Name)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) seen
  (match todo
    (nil seen)
    ((cons n r)
     (if (mem_name n seen) (wait_reach c r seen (- fuel 1))
     (wait_reach c (append (twait_cites c n) r) (cons n seen) (- fuel 1)))))))
(fn twait_cites ((c (List TWait)) (n Name)) (List Name)
  (measure (struct c))
  (match c
    (nil nil)
    ((cons (TWait m _ cites) r) (if (name_eq m n) cites (twait_cites r n)))))
(fulfills wait_reach.dec_1 (by (intro p hf n r ht hm) (apply natAbs_pred (arith))))
(fulfills wait_reach.dec_2 (by (intro p hf n r ht hm) (apply natAbs_pred (arith))))
(fn waits_named ((c (List TWait)) (ns (List Name))) (List TWait)
  (measure (struct c))
  (match c
    (nil nil)
    ((cons (TWait n s cites) r)
     (if (mem_name n ns) (cons (TWait n s cites) (waits_named r ns)) (waits_named r ns)))))
(fn twait_forms ((g (List TWait))) (List (List SExpr))
  (measure (struct g))
  (match g
    (nil nil)
    ((cons (TWait _ s _) r) (cons (form_args s) (twait_forms r)))))
;; a block read and admitted, each of its types with its bundle; those that are not the type
;; being read are admitted ahead of their forms. The names admitted, or None: a block that
;; does not read is refused as a type that does not read is, and K's refusal is the block's
(fn admit_types ((l Load) (f Fx) (self Name) (g (List TWait)))
  (Prod (Prod Load Fx) (Option (List Name)))
  (if (bool_not (one_arity (fx_scope l f) g))
    ;; a block's types share their parameters: types that name each other at different
    ;; numbers of them are no block, and the type being read is a program only — for that, or
    ;; for citing them
    (Prod.mk
      (Prod.mk
        (ld_rec l
          (if (mem_name self (twait_names g))
            (RRun (sym "type") self (sym "block_parameters") (sym "none")
              (utf8
                "the types that name each other take different numbers of parameters, and the types of a block share theirs"))
            (RRun (sym "type") self (sym "e_only_type") (sym "none") nil)))
        f)
      none)
    (match (read_types (fx_scope l f) (Load.env l) (twait_forms g))
      ((RDOk ds)
       (match (admit_core l f ds)
         ((Prod.mk l1 none) (Prod.mk (Prod.mk l1 f) none))
         ((Prod.mk l1 (some recs))
          (match
            (bundle_after
              (ld_with_tahead l1 (append (names_without (twait_names g) self) (Load.tahead l1)))
              (mix_recs f recs)
              ds)
            ((Prod.mk l2 f2) (Prod.mk (Prod.mk l2 f2) (some (twait_names g))))))))
      ((RDErr e m) (Prod.mk (Prod.mk (ld_rec l (read_refusal f e m)) f) none))
      (_
        (Prod.mk
          (Prod.mk
            (ld_rec l (RLoadErr (fx_file f) (sym "bad_directive") (utf8 "an unhandled reading")))
            f)
          none)))))
;; the types take one number of parameters
(fn one_arity ((sc Scope) (g (List TWait))) Bool
  (match g
    (nil true)
    ((cons (TWait _ s _) r) (arity_all sc r (type_arity sc s)))))
(fn arity_all ((sc Scope) (g (List TWait)) (k Int)) Bool
  (measure (struct g))
  (match g
    (nil true)
    ((cons (TWait _ s _) r) (if (= (type_arity sc s) k) (arity_all sc r k) false))))
;; a `type` form's number of parameters
(fn type_arity ((sc Scope) (s SExpr)) Int
  (match s
    ((SList (cons _ (cons hd _)))
     (match (type_head sc hd)
       ((Prod.mk (some (Prod.mk _ ps)) _) (len ps))
       (_ 0)))
    (_ 0)))

;; an extern: its L constant first — an opaque of the declared type with the type's default
;; witness (reader.shard read_extern), an ACCEPT — then the classifier's EExtern, RUNNABLE.
;; The L reading refused — a
;; binder's type unknown to L, no witness — keeps the extern E-only with the obstacle on its
;; record, its callers E-first
(fn load_extern ((l1 Load) (f Fx) (s SExpr)) (Prod Load Fx)
  (match (read_extern (fx_scope l1 f) (Load.env l1) (form_args s))
    ((RDOk ds)
     (match (admit_core l1 f ds)
       ((Prod.mk l2 none) (load_e_first l2 f s (sym "none") (sym "none")))
       ((Prod.mk l2 (some recs)) (load_e_first l2 (mix_recs f recs) s (sym "none") (sym "none")))))
    ((RDErr r _) (load_e_first l1 f s r (sym "none")))
    (_ (load_e_first l1 f s (sym "no_l_reading") (sym "none")))))
(fn form_args ((s SExpr)) (List SExpr)
  (match s
    ((SList (cons _ args)) args)
    (_ nil)))
;; the classifier's program alone
(fn load_e_first ((l1 Load) (f Fx) (s SExpr) (why Symbol) (route Symbol)) (Prod Load Fx)
  (match (classify_form (Load.etab l1) (fx_scope l1 f) (Load.env l1) s)
    ((CErr e m) (Prod.mk (ld_rec l1 (RClassify (form_name (fx_scope l1 f) s) e m)) f))
    ((COk d)
     (Prod.mk
       (ld_rec (ld_with_e l1 (es_add_decl (Load.etab l1) d))
         (RRun (form_head s) (edecl_name d) why route nil))
       f))
    ;; the lambdas the body lifted added, then the instances it takes built — programs, no L half
    ((COkT d lifted eds)
     (match (build_e_demands (add_e_lifted l1 f lifted why route) f (edecl_name d) eds)
       ((Prod.mk l2 none) (Prod.mk l2 f))
       ((Prod.mk l2 (some f2))
        (Prod.mk
          (ld_rec (ld_with_e l2 (es_add_decl (Load.etab l2) d))
            (RRun (form_head s) (edecl_name d) why route nil))
          f2))))))
;; the lambdas a body read by the classifier lifted: each a program alone, added once
(fn add_e_lifted ((l Load) (f Fx) (ls (List EDecl)) (why Symbol) (route Symbol)) Load
  (measure (struct ls))
  (match ls
    (nil l)
    ((cons d r)
     (add_e_lifted
       (if (es_has (Load.etab l) (edecl_name d)) l
       (ld_rec
         (ld_with_e l (es_add_decl (es_register_all (Load.etab l) (Fx.module f) (decl_infos d)) d))
         (RRun (sym "fn") (edecl_name d) why route nil)))
       f
       r
       why
       route))))
;; the classifier's program for a fn whose signature did elaborate: a later body may still bind
;; it as a callee-local and stay on the typed route
(fn load_e_sig ((l1 Load) (f Fx) (s SExpr) (why Symbol)) (Prod Load Fx)
  (match (load_e_first l1 f s why (sym "e_first"))
    ((Prod.mk l2 f2)
     (Prod.mk
       (if (ld_last_runnable l2) (ld_add_typed l2 (form_name (fx_scope l1 f) s) (fx_scope l1 f) s)
       l2)
       f2))))
;; the same after an obstacle on the typed route (`no_l_reading`). When the classifier
;; refuses the body too, its refusal carries the obstacle: the body was read E-first only
;; because of it, and the classifier's own reason may be a consequence (a row's constructor,
;; which no E-first body cites, behind a callee with no realization)
(fn load_e_after ((l1 Load) (f Fx) (s SExpr) (r Symbol) (m (List Int))) (Prod Load Fx)
  (match (classify_form (Load.etab l1) (fx_scope l1 f) (Load.env l1) s)
    ((CErr e m2)
     (Prod.mk
       (ld_rec l1
         (match (name_pointer r m)
           ((some (Prod.mk r2 p)) (RClassify (form_name (fx_scope l1 f) s) r2 p))
           (none
             (RClassify (form_name (fx_scope l1 f) s) e
               ;; the two readings' one refusal is said once
               (if (bool_and (sym_eq e r) (int_list_eq m2 m)) m2
               (append m2
                 (append (utf8 " — read E-first after the typed route's ")
                   (append (chars_of_sym r) (append (utf8 ": ") m)))))))))
       f))
    ((COk _) (load_e_sig (ld_miss l1 r m) f s (sym "no_l_identity")))
    ((COkT _ _ _) (load_e_sig (ld_miss l1 r m) f s (sym "no_l_identity")))))
;; a signature with no L reading: the classifier's program alone. When the classifier
;; refuses the form too, its refusal carries what the signature's reading met — a result type
;; the elaborator could not read is `unknown_type` to the classifier, which names the symbol
;; and not the cause
(fn load_e_skipped ((l1 Load) (f Fx) (s SExpr) (r Symbol) (m (List Int))) (Prod Load Fx)
  (match (classify_form (Load.etab l1) (fx_scope l1 f) (Load.env l1) s)
    ((CErr e m2)
     (Prod.mk
       (ld_rec l1
         (RClassify (form_name (fx_scope l1 f) s) e
           (append m2
             (append (utf8 " — its signature has no L reading: ")
               (append (chars_of_sym r) (append (utf8 ": ") m))))))
       f))
    ((COk _) (load_e_first (unread_noted l1 r m) f s (sym "e_only_type") (sym "e_first")))
    ((COkT _ _ _) (load_e_first (unread_noted l1 r m) f s (sym "e_only_type") (sym "e_first")))))
;; what a signature's reading met, noted (settle_missed)
(fn unread_noted ((l Load) (e Symbol) (m (List Int))) Load (ld_miss l e m))
(fn ld_last_runnable ((l Load)) Bool
  (match (ld_recs_head l)
    ((some (RRun _ _ _ _ _)) true)
    (_ false)))
;; a `def` with a recursion clause — `(def NAME ((x TYPE)…) TYPE (measure (struct x)) BODY)` —
;; is the fn pipeline's K half alone: read once as a pre-definition with
;; its self-local, defined by K's projection with its equations — structural recursion by brecOn,
;; a measure by WellFounded.fix with its obligations —, its matchers and the auxiliaries a native
;; inductive needs admitted as a fn's are; no classifier, no program, no callee-locals: an L
;; definition that recurses, a specification over data into Prop among them. Its binders are E
;; types, as the pre-definition reads them
(fn def_measured ((s SExpr)) Bool
  (match s
    ((SList (cons _ (cons _ (cons _ (cons _ rest)))))
     (match (fn_measure rest)
       ((some _) true)
       (none false)))
    (_ false)))
(fn load_ldef ((l1 Load) (f Fx) (s SExpr) (fuel Int)) (Prod Load Fx)
  (measure fuel)
  (let ((sc (fx_scope l1 f)) (k (form_name (fx_scope l1 f) s)))
    (match (read_predef sc (Load.env l1) s nil)
      ((PdSkip r m) (Prod.mk (ld_rec l1 (RClassify k r m)) f))
      ((PdErr r m) (Prod.mk (ld_rec l1 (RClassify k r m)) f))
      ((PdOk pd)
       (match (define_pd (Load.etab l1) sc pd)
         ((DfSkip why m) (Prod.mk (ld_rec l1 (RClassify k why m)) f))
         ((DfAux es2 auxs)
          (if (< fuel 1)
            (Prod.mk
              (ld_rec l1 (RClassify k (sym "define_loop") (utf8 "the auxiliaries did not settle")))
              f)
            (match (admit_forms (ld_with_e l1 es2) f s auxs)
              ((Prod.mk l2 f2)
               (if (ld_last_accepted l2) (load_ldef l2 f2 s (- fuel 1)) (Prod.mk l2 f2))))))
         ((DfOk es2 obls dd eqs wf)
          (match (admit_matchers (ld_with_e l1 es2) f s (pd_aux pd))
            ((Prod.mk l2 (some f2)) (load_ldefined l2 f2 k obls dd eqs wf))
            ((Prod.mk l2 none) (Prod.mk l2 f)))))))))
;; the definition, its equations and its obligations admitted; DEFINE with no program roots
(fn load_ldefined
  ((l0 Load)
   (f0 Fx)
   (k Name)
   (obls (List Declaration))
   (dd Declaration)
   (thms (List Declaration))
   (wf Bool))
  (Prod Load Fx)
  (match (admit_obligations l0 f0 obls)
    ((Prod.mk l f)
     (match (admit_core l f (list dd))
       ((Prod.mk l1 none) (Prod.mk l1 f))
       ((Prod.mk l1 (some recs))
        (match (admit_core l1 (mix_recs f recs) thms)
          ((Prod.mk l2 none) (Prod.mk l2 f))
          ((Prod.mk l2 (some recs2))
           (let
             ((l3
                (ld_rec (ld_add_pm l2 k (if wf (list k) nil))
                  (RDefine k (decls_declare (Load.env l2) thms) (if wf (list k) nil)))))
             (Prod.mk (if wf (ld_rec l3 (RPending k (sym "measure"))) l3)
               (mix_recs (mix_recs f recs) recs2))))))))))
;; one attempt at a fn. A callee that is not loaded yet or is itself parked (the elaborator's
;; unknown_constant on a function head of the E table without a declaration) parks the fn — no
;; record yet; it is retried after every later fn and settled at the file's end. The
;; auxiliaries a native inductive needs (its below and brecOn; ACCEPT records) are admitted
;; first and the fn read again, at most twice
(fn load_fn ((l1 Load) (f Fx) (s SExpr) (fuel Int)) (Prod Load Fx)
  (load_fn_with l1 f s fuel nil 1024))
;; `callees`: the RUNNABLE callees bound as locals so far — the body is read again with one
;; more each time the elaborator names one (never by the classifier). The readings end with
;; the body's distinct callees; `cfuel` bounds the loop, and a body of more RUNNABLE callees
;; than 1,024 is refused `define_loop`
(fn load_fn_with ((l1 Load) (f Fx) (s SExpr) (fuel Int) (callees (List Callee)) (cfuel Int))
  (Prod Load Fx)
  (measure cfuel)
  (let ((sc (fx_scope l1 f)) (k (form_name (fx_scope l1 f) s)))
    (match (read_predef sc (Load.env l1) s callees)
      ((PdSkip r m) (load_e_skipped l1 f s r m))
      ((PdErr r m)
       (if (sym_eq r (sym "unknown_constant"))
         ;; a name the environment lacks: a function still to come parks the fn; a RUNNABLE one
         ;; or an extern has no L meaning; anything else — a toolchain spelling, a constant of
         ;; Init the load has yet to fetch (load_e_after notes it for settle_missed) — has no L
         ;; identity, and a name that is nothing at all is the classifier's refusal
         (match (callee_state l1 sc m)
           (CsPark
             (Prod.mk
               (ld_with_parked l1
                 (append (Load.parked l1) (list (Parked k s (sym "callee_undeclared") m))))
               f))
           ((CsTyped c)
            (if (< cfuel 1)
              (Prod.mk
                (ld_rec l1
                  (RClassify k (sym "define_loop") (utf8 "the callee-locals did not settle")))
                f)
              (load_fn_with l1 f s fuel (append callees (list c)) (- cfuel 1))))
           (CsRunnable (load_e_sig l1 f s (sym "no_l_meaning")))
           (CsNone (load_e_after l1 f s r m)))
         (if (no_l_reading r) (load_e_after l1 f s r m) (Prod.mk (ld_rec l1 (RClassify k r m)) f))))
      ((PdOk pd)
       (match (erase_predef (Load.etab l1) sc pd)
         ((PdEraseErr r m)
          (if (no_l_reading r) (load_e_after l1 f s r m) (Prod.mk (ld_rec l1 (RClassify k r m)) f)))
         ((PdEraseTemplate es1 binds rt) (load_template l1 f s pd es1 binds rt fuel callees cfuel))
         ((PdEraseOk es1 d lifted demands)
          ;; the lambdas the body lifted and the instances it demands first:
          ;; their definitions in K, their programs in the table — the body's program calls them
          (match (admit_lifted (ld_with_e l1 es1) f lifted)
            ((Prod.mk l1a none) (Prod.mk l1a f))
            ((Prod.mk l1a (some f1a))
             (match (build_demands l1a f1a k demands 64)
               ((Prod.mk l1b none) (Prod.mk l1b f))
               ((Prod.mk l1b (some f1b))
                (match (define_pd (Load.etab l1b) sc pd)
                  ;; no definition: the fn read and its types checked, so it has its program —
                  ;; the erasure — and the reason with its sentence (LAW.md rule 25)
                  ((DfSkip why m)
                   (both_noted
                     (Prod.mk
                       (ld_rec (ld_add_typed (ld_with_e l1b (es_add_decl (Load.etab l1b) d)) k sc s)
                         (RRun (sym "fn") k why (sym "typed") m))
                       f1b)
                     l1
                     sc
                     s
                     d
                     lifted))
                  ((DfAux es2 auxs)
                   (if (< fuel 1)
                     (Prod.mk
                       (ld_rec l1b
                         (RClassify k (sym "define_loop") (utf8 "the auxiliaries did not settle")))
                       f1b)
                     (match (admit_forms (ld_with_e l1b es2) f1b s auxs)
                       ((Prod.mk l2 f2)
                        (if (ld_last_accepted l2) (load_fn_with l2 f2 s (- fuel 1) callees cfuel)
                        (Prod.mk l2 f2))))))
                  ((DfOk es2 obls dd eqs wf)
                   (match (admit_matchers (ld_with_e l1b (es_add_decl es2 d)) f1b s (pd_aux pd))
                     ((Prod.mk l2 (some f2))
                      (both_noted (load_defined l2 f2 d obls dd eqs wf) l1 sc s d lifted))
                     ((Prod.mk l2 none) (Prod.mk l2 f1b)))))))))))))))
;; under --both: the classifier's reading of a fn the typed route gave a program, over the
;; same form in the state the typed route began in, compared with the erasure by the dump's
;; text (dump.shard: a projection — a literal's kind and the recursion clause are outside it);
;; then the lambdas the two readings lifted out of the body, name by name
(fn both_noted ((r (Prod Load Fx)) (l1 Load) (sc Scope) (s SExpr) (d EDecl) (lifted (List Lifted)))
  (Prod Load Fx)
  (if (bool_not (Load.both l1)) r
  (match r
    ((Prod.mk l2 f2) (Prod.mk (ld_rec_all l2 (both_recs l1 sc s d lifted)) f2)))))
(fn ld_rec_all ((l Load) (rs (List Rec))) Load
  (measure (struct rs))
  (match rs
    (nil l)
    ((cons x r) (ld_rec_all (ld_rec l x) r))))
(fn both_recs ((l1 Load) (sc Scope) (s SExpr) (d EDecl) (lifted (List Lifted))) (List Rec)
  (both_of (Load.etab l1) (form_name sc s) d lifted
    (classify_checked (Load.etab l1) sc (Load.env l1) s)))
(fn both_of ((es ESt) (k Name) (d EDecl) (lifted (List Lifted)) (res CRes)) (List Rec)
  (match res
    ((CErr e m) (list (RBoth k (sym "unread") (append (chars_of_sym e) (append (utf8 ": ") m)))))
    ((COk d2) (cons (both_cmp k (dm_decl es d) (dm_decl es d2)) (both_lifted es lifted nil)))
    ((COkT d2 ls _) (cons (both_cmp k (dm_decl es d) (dm_decl es d2)) (both_lifted es lifted ls)))))
;; a supplied realize is compared as a fn is: the classifier's reading of its body under the
;; realized constant's identity, in the state the typed route began in
(fn both_realized ((l2 Load) (l1 Load) (sc Scope) (s SExpr) (d EDecl) (lifted (List Lifted))) Load
  (if (bool_not (Load.both l1)) l2
  (match (classify_realize (Load.etab l1) sc (Load.env l1) (edecl_name d) s)
    (none l2)
    ((some res) (ld_rec_all l2 (both_of (Load.etab l1) (edecl_name d) d lifted res))))))
(fn both_cmp ((k Name) (t (List Int)) (p (List Int))) Rec
  (if (int_list_eq t p) (RBoth k (sym "same") nil)
  (RBoth k (sym "differs") (append (utf8 "typed: ") (append t (append (utf8 " | plain: ") p))))))
;; each lambda of the typed route beside the classifier's of its name, then the classifier's
;; the typed route has none of
(fn both_lifted ((es ESt) (typed (List Lifted)) (plain (List EDecl))) (List Rec)
  (measure (struct typed))
  (match typed
    (nil (both_plain_only es plain))
    ((cons (Lifted n prog _) r)
     (cons
       (match (edecl_named n plain)
         ((some d2) (both_cmp n (dm_decl es prog) (dm_decl es d2)))
         (none
           (RBoth n (sym "differs")
             (append (utf8 "typed: ") (append (dm_decl es prog) (utf8 " | plain: no such lambda"))))))
       (both_lifted es r (edecls_without n plain))))))
(fn both_plain_only ((es ESt) (plain (List EDecl))) (List Rec)
  (measure (struct plain))
  (match plain
    (nil nil)
    ((cons d r)
     (cons
       (RBoth (edecl_name d) (sym "differs")
         (append (utf8 "typed: no such lambda | plain: ") (dm_decl es d)))
       (both_plain_only es r)))))
(fn edecl_named ((n Name) (ds (List EDecl))) (Option EDecl)
  (measure (struct ds))
  (match ds
    (nil none)
    ((cons d r) (if (name_eq (edecl_name d) n) (some d) (edecl_named n r)))))
(fn edecls_without ((n Name) (ds (List EDecl))) (List EDecl)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r) (if (name_eq (edecl_name d) n) (edecls_without n r) (cons d (edecls_without n r))))))
;; a template: defined in K as any fn — the definition, its equations
;; — and kept with its binders' roles for the instances later bodies demand; no program of its
;; own, so no RUNNABLE and no DEFINE: TEMPLATE. One that K cannot define has no L half to
;; instantiate from and is refused with the obstacle
(fn load_template
  ((l1 Load)
   (f Fx)
   (s SExpr)
   (pd PreDef)
   (es1 ESt)
   (binds (List TBind))
   (rt EType)
   (fuel Int)
   (callees (List Callee))
   (cfuel Int))
  (Prod Load Fx)
  (let ((sc (fx_scope l1 f)) (k (pd_name pd)))
    (match (check_template es1 sc (tm_of_fn pd binds rt))
      ((some (Prod.mk e m)) (Prod.mk (ld_rec l1 (RClassify k e m)) f))
      (none
        (match (define_pd es1 sc pd)
          ((DfSkip why m)
           (Prod.mk
             (ld_rec l1
               (RClassify k why
                 (append m
                   (utf8
                     " — a template (a fn with a function-typed binder) needs its definition in K, which its instances unfold to"))))
             f))
          ((DfAux es2 auxs)
           (if (< fuel 1)
             (Prod.mk
               (ld_rec l1 (RClassify k (sym "define_loop") (utf8 "the auxiliaries did not settle")))
               f)
             (match (admit_forms (ld_with_e l1 es2) f s auxs)
               ((Prod.mk l2 f2)
                (if (ld_last_accepted l2) (load_fn_with l2 f2 s (- fuel 1) callees cfuel)
                (Prod.mk l2 f2))))))
          ((DfOk es2 obls dd eqs wf)
           (match (admit_matchers (ld_with_e l1 es2) f s (pd_aux pd))
             ((Prod.mk l2 none) (Prod.mk l2 f))
             ((Prod.mk l2 (some f2))
              (match (admit_obligations l2 f2 obls)
                ((Prod.mk l3 f3)
                 (match (admit_core l3 f3 (list dd))
                   ((Prod.mk l4 none) (Prod.mk l4 f3))
                   ((Prod.mk l4 (some recs))
                    (match (admit_core l4 (mix_recs f3 recs) eqs)
                      ((Prod.mk l5 none) (Prod.mk l5 f3))
                      ((Prod.mk l5 (some recs2))
                       (let ((tm (tm_of_fn pd binds rt)))
                         (match
                           (register_template l5 (Fx.module f3) sc tm
                             (decls_declare (Load.env l5) eqs))
                           ((Prod.mk l6 ok)
                            (Prod.mk
                              (if (bool_and ok wf) (ld_rec l6 (RPending k (sym "measure"))) l6)
                              (mix_recs (mix_recs f3 recs) recs2)))))))))))))))))))
;; a template registered in the E table with its written binders' E signatures (template.shard's
;; tm_ebinds) — for the instances an E-first body takes — and recorded TEMPLATE; one
;; whose static parameter's E signature cannot be read is refused (binder_role read the same type)
(fn register_template ((l Load) (m Name) (sc Scope) (tm Template) (eqs (List Name)))
  (Prod Load Bool)
  (let ((k (tm_name tm)) (binds (tm_binds tm)))
    (match (tm_ebinds (Load.etab l) sc tm)
      ((Prod.mk es1 none)
       (Prod.mk
         (ld_rec (ld_with_e l es1)
           (RClassify k (sym "function_value")
             (utf8 "a static parameter whose E signature could not be read")))
         false))
      ((Prod.mk es1 (some ebs))
       (Prod.mk
         (ld_rec
           (ld_add_template
             (ld_with_e l
               (es_register es1 k m
                 (EITemplate (count_static binds) ebs (tm_rt tm) (count_types binds))))
             k
             tm)
           (RTemplate k (template_statics tm) eqs))
         true)))))
;; the lambdas a body lifted: each generated fn's definition admitted — once; a
;; body read again regenerates the same — and its program added, DEFINE with no equation
(fn admit_lifted ((l Load) (f Fx) (ls (List Lifted))) (Prod Load (Option Fx))
  (measure (struct ls))
  (match ls
    (nil (Prod.mk l (some f)))
    ((cons (Lifted n prog dd) r)
     (if (env_has (Load.env l) n) (admit_lifted l f r)
     (match (admit_core l f (list dd))
       ((Prod.mk l1 none) (Prod.mk l1 none))
       ((Prod.mk l1 (some recs))
        (admit_lifted
          (ld_rec
            (ld_with_e l1
              (es_add_decl (es_register_all (Load.etab l1) (Fx.module f) (decl_infos prog)) prog))
            (RDefine n nil nil))
          (mix_recs f recs)
          r)))))))
;; the instances a body demands: each built from its template (template.shard) — its
;; definition and its equations admitted, its program added, INSTANCE recorded —, then the
;; lambdas and instances its own body lifted and demanded, to a fixpoint. One already built
;; is reused when the demand's arguments are the same, refused when they differ — under the
;; taker's name, the body that demanded it; a template at its budget refuses the next
(fn build_demands ((l Load) (f Fx) (taker Name) (ds (List Demand)) (fuel Int))
  (Prod Load (Option Fx))
  (measure fuel)
  (if (< fuel 1)
    (Prod.mk (ld_rec l (RClassify taker (sym "define_loop") (utf8 "the instances did not settle")))
      none)
    (match ds
      (nil (Prod.mk l (some f)))
      ((cons d r)
       (let ((name (demand_name d)))
         (match (assoc_demand name (Load.instances l))
           ((some d0)
            (if (demand_same d d0) (build_demands l f taker r fuel)
            (Prod.mk (ld_rec l (instance_clash taker name)) none)))
           (none
             (match (over_budget l taker (demand_template d))
               ((some l1) (Prod.mk l1 none))
               (none
                 (match (assoc_template (demand_template d) (Load.templates l))
                   (none
                     (Prod.mk
                       (ld_rec l
                         (RClassify taker (sym "unknown_template") (show_name (demand_template d))))
                       none))
                   ((some tm)
                    (match (build_instance (Load.etab l) (fx_scope l f) (Load.env l) tm d)
                      ((InstErr e m) (Prod.mk (ld_rec l (RClassify name e m)) none))
                      ((InstOk es1 prog dd eqs lifted demands)
                       (match (admit_lifted (ld_with_e l es1) f lifted)
                         ((Prod.mk l1 none) (Prod.mk l1 none))
                         ((Prod.mk l1 (some f1))
                          (match (admit_core l1 f1 (list dd))
                            ((Prod.mk l2 none) (Prod.mk l2 none))
                            ((Prod.mk l2 (some recs))
                             (match (admit_core l2 (mix_recs f1 recs) eqs)
                               ((Prod.mk l3 none) (Prod.mk l3 none))
                               ((Prod.mk l3 (some recs2))
                                (let
                                  ((l4
                                     (ld_rec
                                       (ld_add_instance
                                         (ld_with_e l3
                                           (es_add_decl
                                             (es_register_all (Load.etab l3) (Fx.module f1)
                                               (decl_infos prog))
                                             prog))
                                         d)
                                       (RInstance name (demand_template d)
                                         (shape_records (demand_shapes d))
                                         (decls_declare (Load.env l3) eqs)))))
                                  (match
                                    (build_demands l4 (mix_recs (mix_recs f1 recs) recs2) name
                                      demands
                                      (- fuel 1))
                                    ((Prod.mk l5 none) (Prod.mk l5 none))
                                    ((Prod.mk l5 (some f5))
                                     (build_demands l5 f5 taker r (- fuel 1))))))))))))))))))))))))
(fn instance_clash ((taker Name) (name Name)) Rec
  (RClassify taker (sym "instance_clash")
    (append (show_name name)
      (utf8
        " is built at other arguments — a static argument's type arguments or captured types differ under the same shapes"))))
;; the instance budget at a demand: the load with the refusal recorded when the template is at it
(fn over_budget ((l Load) (taker Name) (c Name)) (Option Load)
  (if (<= (Load.budget l) (instances_of c (Load.instances l)))
    (some
      (ld_rec l
        (RClassify taker (sym "specialization_budget")
          (append (show_name c)
            (append (utf8 ": ")
              (append (show_nat (Load.budget l))
                (utf8
                  " instances in this load already — the budget is a refusal, never a proof of anything; take fewer shapes, or raise it with --instance-budget")))))))
    none))
;; the instances an E-first body takes: each a program alone —
;; no definition, no equations — built from its template at the demand's E types; one already
;; built under the name is reused when the arguments agree (as the typed route's), the budget
;; holds, and what the template's body lifts or demands is built as any
(fn build_e_demands ((l Load) (f Fx) (taker Name) (eds (List EDemand))) (Prod Load (Option Fx))
  (measure (struct eds))
  (match eds
    (nil (Prod.mk l (some f)))
    ((cons ed r)
     (let ((name (edemand_name ed)) (c (edemand_template ed)))
       (match (assoc_demand name (Load.instances l))
         ((some d0)
          (match (edemand_to_demand (Load.etab l) (Load.env l) ed)
            (none
              (Prod.mk
                (ld_rec l
                  (RClassify taker (sym "function_value")
                    (append (show_name name) (utf8 ": a type argument with no L reading"))))
                none))
            ((some d)
             (if (demand_same d d0) (build_e_demands l f taker r)
             (Prod.mk (ld_rec l (instance_clash taker name)) none)))))
         (none
           (match (over_budget l taker c)
             ((some l1) (Prod.mk l1 none))
             (none
               (match (assoc_template c (Load.templates l))
                 (none
                   (Prod.mk (ld_rec l (RClassify taker (sym "unknown_template") (show_name c))) none))
                 ((some tm)
                  (match (build_instance_e (Load.etab l) (fx_scope l f) (Load.env l) tm ed)
                    ((IEErr e m) (Prod.mk (ld_rec l (RClassify name e m)) none))
                    ((IEOk es1 prog d lifted demands)
                     (match (admit_lifted (ld_with_e l es1) f lifted)
                       ((Prod.mk l1 none) (Prod.mk l1 none))
                       ((Prod.mk l1 (some f1))
                        (let
                          ((l2
                             (ld_rec
                               (ld_add_instance
                                 (ld_with_e l1
                                   (es_add_decl
                                     (es_register_all (Load.etab l1) (Fx.module f1)
                                       (decl_infos prog))
                                     prog))
                                 d)
                               (RInstance name c (shape_records (demand_shapes d)) nil))))
                          (match (build_demands l2 f1 name demands 64)
                            ((Prod.mk l3 none) (Prod.mk l3 none))
                            ((Prod.mk l3 (some f3)) (build_e_demands l3 f3 taker r))))))))))))))))))
(fn assoc_demand ((n Name) (ds (List Demand))) (Option Demand)
  (measure (struct ds))
  (match ds
    (nil none)
    ((cons d r) (if (name_eq (demand_name d) n) (some d) (assoc_demand n r)))))
(fn assoc_template ((n Name) (ts (List (Prod Name Template)))) (Option Template)
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons (Prod.mk k tm) r) (if (name_eq k n) (some tm) (assoc_template n r)))))
(fn shape_records ((ss (List Shape))) (List (List Int))
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s r) (cons (shape_record s) (shape_records r)))))
;; the body's heads that have no L reading — a symbol, a literal under a constructor
;; pattern, a toolchain spelling: the function falls to the E-first route whole, flagged
(fn no_l_reading ((r Symbol)) Bool
  (bool_or (sym_eq r (sym "no_l_identity"))
    (bool_or (sym_eq r (sym "literal_pattern"))
      (bool_or (sym_eq r (sym "unknown_head"))
        (bool_or (sym_eq r (sym "match_eliminator")) (sym_eq r (sym "no_realization")))))))
;; the name the elaborator did not find, as a function head of the E table: CsPark — no
;; declaration yet (later in the file, or parked); CsTyped — RUNNABLE on the typed route, its
;; form at hand: a callee-local; CsRunnable — RUNNABLE otherwise, an extern, or a view's sig fn
;; whose signature has no L reading; CsNone — not a function at all
(type CalleeState (CsPark) (CsTyped Callee) (CsRunnable) (CsNone))
(fn callee_state ((l Load) (sc Scope) (m (List Int))) CalleeState
  (match (name_of_sym (sym_of_chars m))
    (none CsNone)
    ((some n) (callee_hits l n (only_values (eresolve (Load.etab l) sc n))))))
(fn callee_hits ((l Load) (written Name) (hs (List EHit))) CalleeState
  (measure (struct hs))
  (match hs
    (nil CsNone)
    ((cons (EHit id _ (EIFn _)) r)
     (match (assoc_typed id (Load.typed l))
       ((some (Prod.mk csc form)) (CsTyped (Callee written id csc form)))
       (none
         (match (es_find_decl (Load.etab l) id)
           ((some _) CsRunnable)
           (none CsPark)))))
    ((cons (EHit _ _ (EIExt _)) r) CsRunnable)
    ((cons (EHit _ _ (EISig _)) r) CsRunnable)  ; a view's sig fn the environment lacks: its signature has no L reading
    ((cons _ r) (callee_hits l written r))))
(fn assoc_typed ((id Name) (xs (List (Prod Name (Prod Scope SExpr))))) (Option (Prod Scope SExpr))
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons (Prod.mk n v) r) (if (name_eq n id) (some v) (assoc_typed id r)))))
;; the matchers a body generated, admitted before their owner (ACCEPT records)
(fn admit_matchers ((l Load) (f Fx) (s SExpr) (ds (List Declaration))) (Prod Load (Option Fx))
  (match ds
    (nil (Prod.mk l (some f)))
    (_
      (match (admit_core l f ds)
        ((Prod.mk l1 none) (Prod.mk l1 none))
        ((Prod.mk l1 (some recs)) (Prod.mk l1 (some (mix_recs f recs))))))))
;; the parked fns tried again, to a fixpoint: each attempt re-parks or settles
(fn retry_parked ((l Load) (f Fx) (fuel Int)) (Prod Load Fx)
  (measure fuel)
  (if (< fuel 1) (Prod.mk l f)
  (let ((ps (Load.parked l)))
    (match ps
      (nil (Prod.mk l f))
      (_
        (match (retry_each (ld_with_parked l nil) f ps false)
          ((Prod.mk (Prod.mk l1 f1) progressed)
           (if progressed (retry_parked l1 f1 (- fuel 1)) (Prod.mk l1 f1)))))))))
(fn retry_each ((l Load) (f Fx) (ps (List Parked)) (progressed Bool)) (Prod (Prod Load Fx) Bool)
  (measure (struct ps))
  (match ps
    (nil (Prod.mk (Prod.mk l f) progressed))
    ((cons (Parked k s why m) r)
     ;; a fn parked on a callee that still has no declaration is not read again: its reading
     ;; would end at that callee as it did
     (if (bool_and (sym_eq why (sym "callee_undeclared")) (callee_awaited l (fx_scope l f) m))
       (retry_each (ld_with_parked l (append (Load.parked l) (list (Parked k s why m)))) f r
         progressed)
       (match (load_fn l f s 2)
         ((Prod.mk l1 f1)
          (retry_each l1 f1 r (bool_or progressed (= (len (Load.parked l1)) (len (Load.parked l)))))))))))
;; the name a fn was parked on names a function with no declaration yet
(fn callee_awaited ((l Load) (sc Scope) (m (List Int))) Bool
  (match (callee_state l sc m)
    (CsPark true)
    (_ false)))
;; the fns still parked at a file's end — a forward reference that never settled. Each is
;; read with every other one a callee-local. One that parks even so calls a function of the
;; file that got no declaration, because that one was refused: it does not read, and is
;; refused with the callee named (`callee_undeclared`) — and is no callee-local of the rest,
;; which are read again without it, until none parks. The rest are loaded: RUNNABLE
;; route=typed with callee_runnable
(fn flush_parked ((l Load) (f Fx)) Load
  (let ((ps (Load.parked l))) (flush_settle (ld_with_parked l nil) f ps (+ 1 (len ps)))))
(fn flush_settle ((l Load) (f Fx) (ps (List Parked)) (fuel Int)) Load
  (measure fuel)
  (let ((lt (typed_all l (fx_scope l f) ps)))
    (match (flush_unread lt f ps)
      (nil (flush_each lt f ps))
      (bad
        (if (< fuel 1) (flush_each lt f ps)
        (flush_settle (flush_refuse l bad) f (parked_without ps (parked_names bad)) (- fuel 1)))))))
(fn typed_all ((l Load) (sc Scope) (ps (List Parked))) Load
  (measure (struct ps))
  (match ps
    (nil l)
    ((cons (Parked k s _ _) r) (typed_all (ld_add_typed l k sc s) sc r))))
;; the parked that park again in `lt`, each with the name it waits on; nothing of a reading is kept
(fn flush_unread ((lt Load) (f Fx) (ps (List Parked))) (List Parked)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked k s _ _) r)
     (match (load_fn lt f s 2)
       ((Prod.mk l1 _)
        (match (Load.parked l1)
          (nil (flush_unread lt f r))
          ((cons (Parked _ _ why m) _) (cons (Parked k s why m) (flush_unread lt f r)))))))))
(fn flush_refuse ((l Load) (bad (List Parked))) Load
  (measure (struct bad))
  (match bad
    (nil l)
    ((cons (Parked k _ why m) r)
     (flush_refuse
       (ld_rec l
         (RClassify k why
           (append m
             (utf8
               ": a function of this file that has no declaration — it was refused, so this one does not read"))))
       r))))
(fn flush_each ((l Load) (f Fx) (ps (List Parked))) Load
  (measure (struct ps))
  (match ps
    (nil l)
    ((cons (Parked k s _ _) r)
     (match (load_fn l f s 2)
       ((Prod.mk l1 _)
        (match (Load.parked l1)
          (nil (flush_each l1 f r))
          ((cons (Parked _ _ why m) _)
           (flush_each (flush_refuse (ld_with_parked l1 nil) (list (Parked k s why m))) f r))))))))
;; ---- a group of functions that call each other, settled when its last member is read ------
;; After every fn the parked are looked at once more: a parked fn whose
;; wait leads round to itself is read with the parked as callee-locals, and so is every parked
;; fn it reaches; when all of them read, and none calls a fn outside them that has no
;; definition, the set is closed. Its lowest cycle is then one definition by well-founded
;; recursion (define.shard define_group) — DEFINE for each member — or, where the group does
;; not compile, RUNNABLE for each with the reason. The retry settles their callers.

;; a parked fn as the settlement reads it: its name, its form, the parked callees its body binds
(type Probe (Probe Name SExpr (List Callee)))
(type Probed (ProbedOk (List Callee)) (ProbedWaits (List Int)) (ProbedNo))
(fn probe_name ((p Probe)) Name
  (match p
    ((Probe k _ _) k)))
(fn probe_names ((ps (List Probe))) (List Name)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r) (cons (probe_name p) (probe_names r)))))
(fn callee_ids ((cs (List Callee))) (List Name)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (Callee _ id _ _) r) (cons id (callee_ids r)))))
(fn probe_find ((ps (List Probe)) (k Name)) (Option Probe)
  (measure (struct ps))
  (match ps
    (nil none)
    ((cons p r) (if (name_eq (probe_name p) k) (some p) (probe_find r k)))))
(fn parked_find ((ps (List Parked)) (k Name)) (Option Parked)
  (measure (struct ps))
  (match ps
    (nil none)
    ((cons (Parked n s why m) r) (if (name_eq n k) (some (Parked n s why m)) (parked_find r k)))))
(fn parked_names ((ps (List Parked))) (List Name)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked n _ _ _) r) (cons n (parked_names r)))))
(fn parked_without ((ps (List Parked)) (ks (List Name))) (List Parked)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked n s why m) r)
     (if (mem_name n ks) (parked_without r ks) (cons (Parked n s why m) (parked_without r ks))))))
(fn parked_only ((ps (List Parked)) (ks (List Name))) (List Parked)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked n s why m) r)
     (if (mem_name n ks) (cons (Parked n s why m) (parked_only r ks)) (parked_only r ks)))))
;; a parked fn waiting on another name from now on (the name its last reading did not find)
(fn parked_waits ((ps (List Parked)) (k Name) (m (List Int))) (List Parked)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked n s why m0) r)
     (if (name_eq n k) (cons (Parked n s why m) r) (cons (Parked n s why m0) (parked_waits r k m))))))
;; the parked fn the name a parked fn waits on stands for, if it is one (lt: the parked as typed)
(fn waited_parked ((lt Load) (sc Scope) (m (List Int))) (Option Name)
  (match (callee_state lt sc m)
    ((CsTyped (Callee _ id _ _)) (if (mem_name id (parked_names (Load.parked lt))) (some id) none))
    (_ none)))
;; a parked fn's wait leads round to a fn already on the way: a cycle by the recorded waits
;; alone, no body read. A wait on a name not declared yet ends the walk: nothing can close
(fn waits_round ((lt Load) (sc Scope) (k Name) (seen (List Name)) (fuel Int)) Bool
  (measure (Int.natAbs fuel))
  (if (< fuel 1) false
  (match (parked_find (Load.parked lt) k)
    (none false)
    ((some (Parked _ _ _ m))
     (match (waited_parked lt sc m)
       (none false)
       ((some next)
        (if (bool_or (name_eq next k) (mem_name next seen)) true
        (waits_round lt sc next (cons k seen) (- fuel 1)))))))))
(fulfills waits_round.dec_1 (by (intro p hf w1 w2 w3 m hp next hw hb) (apply natAbs_pred (arith))))
;; how a reading ends, as the search takes it
(fn read_end ((r PdRes)) ReadEnd
  (match r
    ((PdOk _) ReWhole)
    ((PdSkip _ _) ReNo)
    ((PdErr e m) (if (sym_eq e (sym "unknown_constant")) (ReStops m) ReNo))))
;; one reading of a parked fn under callee-locals: the one kept, or read now and kept
(fn reading ((lt Load) (sc Scope) (k Name) (s SExpr) (callees (List Callee)) (ks (List Known)))
  (Prod ReadEnd (List Known))
  (let ((ids (callee_ids callees)))
    (match (reads_find ks k ids)
      ((some e) (Prod.mk e ks))
      (none
        (let ((e (read_end (read_predef sc (Load.env lt) s callees))))
          (Prod.mk e (reads_add ks k s ids e)))))))
;; a parked fn read with the parked as callee-locals — the retry's loop without a load: its
;; callees; or the name it still waits on; or an obstacle of its own (settled at the file's end)
(fn probe_fn
  ((lt Load) (sc Scope) (k Name) (s SExpr) (callees (List Callee)) (cfuel Int) (ks (List Known)))
  (Prod Probed (List Known))
  (measure cfuel)
  (match (reading lt sc k s callees ks)
    ((Prod.mk ReWhole ks1) (Prod.mk (ProbedOk callees) ks1))
    ((Prod.mk ReNo ks1) (Prod.mk ProbedNo ks1))
    ((Prod.mk (ReStops m) ks1)
     (match (callee_state lt sc m)
       ((CsTyped c)
        (if (< cfuel 1) (Prod.mk ProbedNo ks1)
        (probe_fn lt sc k s (append callees (list c)) (- cfuel 1) ks1)))
       (CsPark (Prod.mk (ProbedWaits m) ks1))
       (_ (Prod.mk ProbedNo ks1))))))
;; every parked fn the start reaches through parked callees, each read: the probes, or the
;; first that does not read — with the name it waits on, kept on its entry so the next look
;; ends at the recorded waits
(type ProbeReach (ReachOk (List Probe)) (ReachWaits Name (List Int)) (ReachNo))
(fn probe_reach
  ((lt Load) (sc Scope) (todo (List Name)) (done (List Probe)) (fuel Int) (ks (List Known)))
  (Prod ProbeReach (List Known))
  (measure fuel)
  (if (< fuel 1) (Prod.mk ReachNo ks)
  (match todo
    (nil (Prod.mk (ReachOk (rev done)) ks))
    ((cons k r)
     (match (probe_find done k)
       ((some _) (probe_reach lt sc r done (- fuel 1) ks))
       (none
         (match (parked_find (Load.parked lt) k)
           (none (Prod.mk ReachNo ks))  ; a callee with a program and no definition, outside the parked: callee_runnable at the file's end
           ((some (Parked _ s _ _))
            (match (probe_fn lt sc k s nil 16 ks)
              ((Prod.mk (ProbedOk callees) ks1)
               (probe_reach lt sc (append r (callee_ids callees)) (cons (Probe k s callees) done)
                 (- fuel 1)
                 ks1))
              ((Prod.mk (ProbedWaits m) ks1) (Prod.mk (ReachWaits k m) ks1))
              ((Prod.mk ProbedNo ks1) (Prod.mk ReachNo ks1)))))))))))
;; the names a name reaches through one call or more, among the probes
(fn reach_names ((ps (List Probe)) (todo (List Name)) (seen (List Name)) (fuel Int)) (List Name)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) seen
  (match todo
    (nil seen)
    ((cons k r)
     (if (mem_name k seen) (reach_names ps r seen (- fuel 1))
     (reach_names ps
       (append r
         (match (probe_find ps k)
           ((some (Probe _ _ cs)) (callee_ids cs))
           (none nil)))
       (cons k seen)
       (- fuel 1)))))))
(fulfills reach_names.dec_1 (by (intro p h k r hm hs) (apply natAbs_pred (arith))))
(fulfills reach_names.dec_2 (by (intro p h k r hm hs) (apply natAbs_pred (arith))))
(fn probe_reaches ((ps (List Probe)) (k Name)) (List Name)
  (match (probe_find ps k)
    ((some (Probe _ _ cs)) (reach_names ps (callee_ids cs) nil (* 4 (+ 1 (len ps)))))
    (none nil)))
;; a lowest cycle among the probes: a fn that reaches itself and nothing that does not reach it back
(fn lowest_cycle ((ps (List Probe)) (cands (List Probe))) (Option (List Name))
  (measure (struct cands))
  (match cands
    (nil none)
    ((cons (Probe k _ _) r)
     (let ((rk (probe_reaches ps k)))
       (if (bool_and (mem_name k rk) (all_reach_back ps rk k)) (some rk) (lowest_cycle ps r))))))
(fn all_reach_back ((ps (List Probe)) (xs (List Name)) (k Name)) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r) (if (mem_name k (probe_reaches ps x)) (all_reach_back ps r k) false))))
;; the probes of the named, in the parked's order (the file's)
(fn probes_in_order ((ps (List Parked)) (probes (List Probe)) (ks (List Name))) (List Probe)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Parked n _ _ _) r)
     (if (mem_name n ks)
       (match (probe_find probes n)
         ((some p) (cons p (probes_in_order r probes ks)))
         (none (probes_in_order r probes ks)))
       (probes_in_order r probes ks)))))
;; what is kept, brought to the parked of now: a fn that is parked no longer was loaded —
;; the readings of the forms that name it are forgotten, and its own
(fn reads_settled ((l Load)) Load
  (match (Load.reads l)
    ((Reads seen kept)
     (let ((now (parked_names (Load.parked l))))
       (ld_with_reads l
         (Reads now (reads_only (reads_forget kept (last_parts (names_gone seen now))) now)))))))
;; the parked looked at from the last one back: a closed set's lowest cycle, settled; then the
;; retry, and again
(fn settle_groups ((l0 Load) (f Fx) (fuel Int)) (Prod Load Fx)
  (measure fuel)
  (if (< fuel 1) (Prod.mk l0 f)
  (match (Load.parked l0)
    (nil (Prod.mk (ld_forget_all l0) f))
    (ps
      (let ((l (reads_settled l0)) (sc (fx_scope l0 f)))
        (match (find_group (typed_all l sc ps) sc l (rev ps) (+ 1 (len ps)))
          ((Prod.mk l1 none) (Prod.mk l1 f))
          ((Prod.mk l1 (some g))
           (match (load_group l1 f g)
             ((Prod.mk l2 f2)
              (match (retry_parked l2 f2 (+ 1 (len (Load.parked l2))))
                ((Prod.mk l3 f3) (settle_groups l3 f3 (- fuel 1)))))))))))))
;; `l`: the load, whose parked entries take the name a reading still waits on
(fn find_group ((lt Load) (sc Scope) (l Load) (starts (List Parked)) (fuel Int))
  (Prod Load (Option (List Probe)))
  (measure (struct starts))
  (match starts
    (nil (Prod.mk l none))
    ((cons (Parked k _ _ _) r)
     (if (bool_not (waits_round lt sc k nil fuel)) (find_group lt sc l r fuel)
     (match (Load.reads l)
       ((Reads seen kept)
        (match (probe_reach lt sc (list k) nil (* 4 fuel) kept)
          ((Prod.mk reach kept1)
           (let ((l1 (ld_with_reads l (Reads seen kept1))))
             (match reach
               ((ReachOk probes)
                (match (lowest_cycle probes probes)
                  ((some ks) (Prod.mk l1 (some (probes_in_order (Load.parked l1) probes ks))))
                  (none (find_group lt sc l1 r fuel))))
               ((ReachWaits n m)
                (find_group (ld_with_parked lt (parked_waits (Load.parked lt) n m)) sc
                  (ld_with_parked l1 (parked_waits (Load.parked l1) n m))
                  r
                  fuel))
               (ReachNo (find_group lt sc l1 r fuel))))))))))))
;; the group's members read one after the other in one state (predef.shard read_predef_from)
(fn read_group ((sc Scope) (env CheckedEnv) (g (List Probe)) (base (Option El)) (acc (List PreDef)))
  (Option (List PreDef))
  (measure (struct g))
  (match g
    (nil (some (rev acc)))
    ((cons (Probe _ s callees) r)
     (match (read_predef_from base sc env s callees)
       ((PdOk pd) (read_group sc env r (some (pd_state pd)) (cons pd acc)))
       (_ none)))))
;; every member has a program by erasure alone (no template)
(fn group_erases ((es ESt) (sc Scope) (pds (List PreDef))) Bool
  (measure (struct pds))
  (match pds
    (nil true)
    ((cons pd r)
     (match (erase_predef es sc pd)
       ((PdEraseOk _ _ _ _) (group_erases es sc r))
       (_ false)))))
;; the members' programs: each erasure, the lambdas it lifted and the instances it demands
;; admitted first (load_fn_with's order); None when one of those is refused
(fn erase_group ((l Load) (f Fx) (sc Scope) (pds (List PreDef)) (acc (List EDecl)))
  (Prod (Prod Load Fx) (Option (List EDecl)))
  (measure (struct pds))
  (match pds
    (nil (Prod.mk (Prod.mk l f) (some (rev acc))))
    ((cons pd r)
     (match (erase_predef (Load.etab l) sc pd)
       ((PdEraseOk es1 d lifted demands)
        (match (admit_lifted (ld_with_e l es1) f lifted)
          ((Prod.mk l1 none) (Prod.mk (Prod.mk l1 f) none))
          ((Prod.mk l1 (some f1))
           (match (build_demands l1 f1 (pd_name pd) demands 64)
             ((Prod.mk l2 none) (Prod.mk (Prod.mk l2 f1) none))
             ((Prod.mk l2 (some f2)) (erase_group l2 f2 sc r (cons d acc)))))))
       (_ (Prod.mk (Prod.mk l f) none))))))
;; a closed cycle settled: read in one state, erased, projected
(fn load_group ((l0 Load) (f0 Fx) (g (List Probe))) (Prod Load Fx)
  (let
    ((sc (fx_scope l0 f0))
     (mine (parked_only (Load.parked l0) (probe_names g)))
     (l (ld_with_parked l0 (parked_without (Load.parked l0) (probe_names g)))))
    (match (read_group sc (Load.env l) g none nil)
      (none (group_as_programs l f0 sc mine))
      ((some pds)
       (if (bool_not (group_erases (Load.etab l) sc pds)) (group_as_programs l f0 sc mine)
       (match (erase_group l f0 sc pds nil)
         ((Prod.mk (Prod.mk l1 f1) none) (Prod.mk l1 f1))
         ((Prod.mk (Prod.mk l1 f1) (some ds))
          (match (define_group (Load.etab l1) sc pds)
            ((GrpSkip why m) (Prod.mk (group_runnable l1 sc g ds why m) f1))
            ((GrpOk es2 obls core defs)
             (match (admit_matchers (ld_with_e l1 es2) f1 (group_form g) (group_aux pds))
               ((Prod.mk l2 none) (Prod.mk l2 f1))
               ((Prod.mk l2 (some f2))
                (match (admit_obligations l2 f2 obls)
                  ((Prod.mk l3 f3)
                   (match (admit_core l3 f3 core)
                     ((Prod.mk l4 none) (Prod.mk l4 f3))
                     ((Prod.mk l4 (some recs))
                      (group_defined (group_roots l4 (probe_names g) (probe_names g))
                        (mix_recs f3 recs)
                        ds
                        defs))))))))))))))))
(fn group_form ((g (List Probe))) SExpr
  (match g
    ((cons (Probe _ s _) _) s)
    (nil (SList nil))))
;; the matchers the group's bodies generated: the last member's state holds them all
(fn group_aux ((pds (List PreDef))) (List Declaration)
  (measure (struct pds))
  (match pds
    (nil nil)
    ((cons pd nil) (pd_aux pd))
    ((cons _ r) (group_aux r))))
;; every member carries every member's measure until its obligations are discharged: the
;; fixpoint is one, and each member's closure holds it
(fn group_roots ((l Load) (ks (List Name)) (all (List Name))) Load
  (measure (struct ks))
  (match ks
    (nil l)
    ((cons k r) (group_roots (ld_add_pm l k all) r all))))
;; the members' programs into the table and their definitions admitted, all of them; then
;; each member's equations — which cite the other members — with its records (load_defined's:
;; DEFINE, and PENDING for the measure)
(fn group_defined ((l Load) (f Fx) (ds (List EDecl)) (defs (List GrpDef))) (Prod Load Fx)
  (match (group_definitions l f ds defs)
    ((Prod.mk l1 none) (Prod.mk l1 f))
    ((Prod.mk l1 (some f1)) (group_equations l1 f1 ds defs))))
(fn group_definitions ((l Load) (f Fx) (ds (List EDecl)) (defs (List GrpDef)))
  (Prod Load (Option Fx))
  (measure (struct defs))
  (match defs
    (nil (Prod.mk l (some f)))
    ((cons (GrpDef _ dd _) r)
     (match ds
       ((cons d dr)
        (match (admit_core (ld_with_e l (es_add_decl (Load.etab l) d)) f (list dd))
          ((Prod.mk l1 none) (Prod.mk l1 none))
          ((Prod.mk l1 (some recs)) (group_definitions l1 (mix_recs f recs) dr r))))
       (nil (Prod.mk l (some f)))))))
(fn group_equations ((l Load) (f Fx) (ds (List EDecl)) (defs (List GrpDef))) (Prod Load Fx)
  (measure (struct defs))
  (match defs
    (nil (Prod.mk l f))
    ((cons (GrpDef k _ eqs) r)
     (match ds
       ((cons d dr)
        (match (admit_core l f eqs)
          ((Prod.mk l1 none) (group_equations l1 f dr r))
          ((Prod.mk l1 (some recs))
           (let ((roots (realize_roots l1 k d true)))
             (group_equations
               (ld_rec
                 (ld_rec (ld_add_pm l1 k roots) (RDefine k (decls_declare (Load.env l1) eqs) roots))
                 (RPending k (sym "measure")))
               (mix_recs f recs)
               dr
               r)))))
       (nil (Prod.mk l f))))))
;; no definition for the group: each member its program, RUNNABLE with the reason and its
;; sentence, a callee-local of later bodies as any typed fn without a definition
(fn group_runnable
  ((l Load) (sc Scope) (g (List Probe)) (ds (List EDecl)) (why Symbol) (m (List Int)))
  Load
  (measure (struct g))
  (match g
    (nil l)
    ((cons (Probe k s _) r)
     (match ds
       ((cons d dr)
        (group_runnable
          (ld_rec (ld_add_typed (ld_with_e l (es_add_decl (Load.etab l) d)) k sc s)
            (RRun (sym "fn") k why (sym "typed") m))
          sc
          r
          dr
          why
          m))
       (nil l)))))
;; a group that does not read as one — a member's program is a template, a second reading
;; differs —: its members as the file's end settles the parked, each other's callee-locals
(fn group_as_programs ((l Load) (f Fx) (sc Scope) (mine (List Parked))) (Prod Load Fx)
  (let ((others (Load.parked l)))
    (match (programs_each (ld_with_parked (typed_all l sc mine) nil) f mine)
      ((Prod.mk l1 f1) (Prod.mk (ld_with_parked l1 others) f1)))))
(fn programs_each ((l Load) (f Fx) (ps (List Parked))) (Prod Load Fx)
  (measure (struct ps))
  (match ps
    (nil (Prod.mk l f))
    ((cons (Parked _ s why _) r)
     (match (load_fn l f s 2)
       ((Prod.mk l1 f1)
        (match (Load.parked l1)
          (nil (programs_each l1 f1 r))
          (_
            (match (load_e_first (ld_with_parked l1 nil) f1 s why (sym "e_first"))
              ((Prod.mk l2 f2) (programs_each l2 f2 r))))))))))
(fn ld_last_accepted ((l Load)) Bool
  (match (ld_recs_head l)
    ((some (RAccept _ _ _ _ _ _)) true)
    (_ false)))
;; a defined fn: its obligations (a measure's decreasing facts) admitted as parameters,
;; the definition admitted and checked against the policy, then its equations
;; the same way, the program (the erasure, already in the E table) its realization; DEFINE
;; recorded, PENDING for a measure
(fn load_defined
  ((l0 Load)
   (f0 Fx)
   (d EDecl)
   (obls (List Declaration))
   (dd Declaration)
   (thms (List Declaration))
   (wf Bool))
  (Prod Load Fx)
  (match (admit_obligations l0 f0 obls)
    ((Prod.mk l f)
     (let ((k (edecl_name d)))
       (match (admit_core l f (list dd))
         ((Prod.mk l1 none) (Prod.mk l1 f))
         ((Prod.mk l1 (some recs))
          (match (admit_core l1 (mix_recs f recs) thms)
            ((Prod.mk l2 none) (Prod.mk l2 f))
            ((Prod.mk l2 (some recs2))
             (let ((roots (realize_roots l2 k d wf)))
               (let
                 ((l3
                    (ld_rec (ld_add_pm l2 k roots)
                      (RDefine k (decls_declare (Load.env l2) thms) roots))))
                 (Prod.mk (if wf (ld_rec l3 (RPending k (sym "measure"))) l3)
                   (mix_recs (mix_recs f recs) recs2))))))))))))
;; a measured fn's decreasing facts: each an axiom-kind constant, a parameter of the
;; load — PARAM NAME obligation
(fn admit_obligations ((l Load) (f Fx) (obls (List Declaration))) (Prod Load Fx)
  (measure (struct obls))
  (match obls
    (nil (Prod.mk l f))
    ((cons d r)
     (match (admit_param l f d (sym "obligation") 0)
       ((Prod.mk l1 f1) (admit_obligations l1 f1 r))))))
;; a fn or extern may not take an admitted constant's identity: only a realize attaches
;; an E body under one, and the equations are its warrant
;; a name a declaration of the file may not take: an Init constant's the
;; name table holds under the file's identity (Fx.taken), or one the environment holds
(fn name_taken ((l Load) (f Fx) (n Name)) Bool
  (if (env_has (Load.env l) n) true (taken_has (Fx.taken f) (show_name n))))
(fn env_has ((env CheckedEnv) (n Name)) Bool
  (match (env_find env n)
    ((some _) true)
    (none false)))
(fn taken_has ((ts (List (List Int))) (s (List Int))) Bool
  (measure (struct ts))
  (match ts
    (nil false)
    ((cons t r) (if (int_list_eq t s) true (taken_has r s)))))
;; an S form's citations of the environment's E-eligible inductives enter the E table first
(fn scan_form ((l Load) (f Fx) (s SExpr)) Load
  (ld_with_e l (es_scan_init (Load.etab l) (fx_scope l f) (Load.env l) s)))
;; a `type` enters K when its field types are L types; a field that cites a type K does not
;; hold keeps it out, unless that type stands below it in the file and is admitted with it
;; (load_unheld_type). Never the directory and never the file's imports: K checks any L form
;; in any file.
(fn type_is_e_only ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) Bool
  (match (type_unheld es sc env s)
    (nil false)
    ((cons _ _) true)))
;; the types a `type` form's fields cite that K does not hold, each once, the type being
;; declared excepted; Anon for an `Int` or a `Nat` the scope makes another's too
(fn type_unheld ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) (List Name)
  (match s
    ((SList (cons _ (cons hd ctors))) (ctors_unheld es sc env (type_name sc s) ctors nil))
    (_ nil)))
;; a `type` form's qualified name: (type NAME …) or (type (NAME T…) …)
(fn type_name ((sc Scope) (s SExpr)) Name
  (match s
    ((SList (cons _ (cons hd _)))
     (match (type_head sc hd)
       ((Prod.mk (some (Prod.mk n _)) _) n)
       (_ Anon)))
    (_ Anon)))
(fn ctors_unheld
  ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (cs (List SExpr)) (acc (List Name)))
  (List Name)
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons (SList (cons _ fields)) r)
     (ctors_unheld es sc env self r (fields_unheld es sc env self fields acc)))
    ((cons _ r) (ctors_unheld es sc env self r acc))))
(fn fields_unheld
  ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (fs (List SExpr)) (acc (List Name)))
  (List Name)
  (measure (List_SExpr.size fs))
  (match fs
    (nil acc)
    ((cons t r) (fields_unheld es sc env self r (etype_unheld es sc env self t acc)))))
(fn etype_unheld ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (t SExpr) (acc (List Name)))
  (List Name)
  (measure (SExpr.size t))
  (match t
    ((SSym x) (head_unheld es sc env self x acc))
    ((SList (cons (SSym x) args))
     (fields_unheld es sc env self args (head_unheld es sc env self x acc)))
    (_ acc)))
;; a field type's head: Int and Nat are Init's unless the scope makes the name another's too;
;; a type of the E table is unheld iff K does not hold it — the type being declared excepted
(fn head_unheld ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (x Symbol) (acc (List Name)))
  (List Name)
  (match (name_of_sym x)
    (none acc)
    ((some n)
     (if (bool_or (name_eq n (n1 (sym "Int"))) (name_eq n (n1 (sym "Nat"))))
       (match (resolve (cx0 sc env nil nil) n)
         ((RName _ _) acc)
         (_ (cons Anon acc)))
       (match (only_types (eresolve es sc n))
         ((cons (EHit id _ _) nil)
          (if (name_eq id self) acc
          (match (env_find env id)
            (none (if (mem_name id acc) acc (cons id acc)))
            (_ acc))))
         (_ acc))))))
(fulfills fields_unheld.dec_1
  (by (intro es sc env self fs acc t r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills fields_unheld.dec_2
  (by (intro es sc env self fs acc t r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills etype_unheld.dec_1
  (by
    (intro es sc env self t acc x args h)
    (rw h)
    (rw SExpr.size.eq_5)
    (rw List_SExpr.size.eq_2)
    (arith)))
(fulfills gather_types.dec_1 (by (intro p hf n r ht hw s hb) (apply natAbs_pred (arith))))
(fulfills gather_types.dec_2 (by (intro p hf n r ht hw) (apply natAbs_pred (arith))))
;; the E twin of an admitted type / sig fn / sig type
(fn add_e_twin ((l Load) (f Fx) (s SExpr)) Load
  (let ((h (form_head s)))
    (if (bool_or (sym_eq h (sym "type")) (sym_eq h (sym "sig")))
      (match (ld_recs_head l)
        ((some (RAccept _ _ _ _ _ _)) (add_e_twin_now l f s))
        ((some (RParam _ _ _)) (add_e_twin_now l f s))
        (_ l))
      l)))
(fn add_e_twin_now ((l0 Load) (f Fx) (s SExpr)) Load
  (let ((l (scan_form l0 f s)))
    (match (classify_form (Load.etab l) (fx_scope l f) (Load.env l) s)
      ((CErr e m) (ld_rec l (RLoadErr (fx_file f) e m)))
      ((COk d) (ld_with_e l (es_add_decl (Load.etab l) d)))
      ((COkT _ _ _)
       (ld_rec l (RLoadErr (fx_file f) (sym "bad_shape") (utf8 "a twin takes no instance")))))))
;; a view's `sig fn` whose signature names an E-only type (K holds no constant
;; for it) is an E parameter only — the head `run` links to the implementation's fn, no
;; axiom in K; the K seal's view is such a view
;; (`Expr`, `Name`, `Declaration` are E-only data). Recorded as PARAM NAME fn like any.
(fn sig_e_only ((l0 Load) (f Fx) (s SExpr) (e Symbol) (m (List Int))) (Prod Load Fx)
  (let ((l (scan_form l0 f s)))
    (match (classify_form (Load.etab l) (fx_scope l f) (Load.env l) s)
      ((COk (ESig n nt ps rt))
       (Prod.mk
         (ld_rec (ld_with_e l (es_add_decl (Load.etab l) (ESig n nt ps rt))) (RParam n (sym "fn") 0))
         (fx_mix f (hash_name n))))
      ((COk _) (Prod.mk (ld_rec l (RReadErr (fx_file f) e m)) f))
      ((COkT _ _ _) (Prod.mk (ld_rec l (RReadErr (fx_file f) e m)) f))
      ((CErr _ _) (Prod.mk (ld_rec l (RReadErr (fx_file f) e m)) f)))))
;; a view parameter: an axiom-kind constant to K, a parameter of the load to the policy
(fn admit_param ((l Load) (f Fx) (d Declaration) (kind Symbol) (arity Int)) (Prod Load Fx)
  (let ((n (decl_name d)))
    (match (check (Load.env l) (st_init) d)
      ((Accepted env1)
       (Prod.mk
         (ld_rec
           (ld_add_param
             (ld_with_tbl (ld_with_env l env1 (Load.memo l)) (tbl_add (Load.tbl l) n (Fx.module f)))
             n)
           (RParam n kind arity))
         (fx_mix f
           (match (identity_hash env1 n)
             ((some h) h)
             (none 0)))))
      ((Rejected reason subject) (Prod.mk (ld_rec l (RRefuse subject (reason_of reason))) f))
      ((Exhausted res site) (Prod.mk (ld_rec l (RRefuse n (exhausted_sym res site))) f)))))

;; ---- the Init load on demand ---------------------------------------------------------------
;; The export and its index are opened at the first need from the paths the driver gave
;; (initload.shard od_open: the meta line against the pin, the index's header, the export's
;; size the header's). The base holds Init alone — its environment never a native
;; declaration's — so a process loading many roots carries it (ld_reroot); the loader's own
;; environment holds Init beside the natives, and a demand enters it (init_load).
;;
;; What a file is given of Init does not depend on what the load fetched for another file.
;; A file has, before its first declaration, the closure of every name it can
;; ask the environment for by itself: each token of its forms and of its sidecar's blocks
;; under every candidate resolution tries (init_demand), the kits — the constants the
;; toolchain builds by name (init_kit) — and the satellites of the inductives among them. A
;; name asked for beyond those — one a proof step or the definer builds from a type met in a
;; term — is refused by a message that names it, and the declaration is read again with the
;; name fetched (settle_missed)
(fn init_opened ((l Load) (w World)) (Prod (Prod Load (Option (Prod Symbol (List Int)))) World)
  (match (Load.init l)
    ((InitSt _ _ _) (Prod.mk (Prod.mk l none) w))
    (InitNone
      (Prod.mk
        (Prod.mk l
          (some
            (Prod.mk (sym "init_unavailable")
              (utf8 "no export was given (load.shard --init EXPORT --init-index INDEX)"))))
        w))
    ((InitPaths export index)
     (match (od_open export index w)
       ((Prod.mk (OdOpenErr e m) w1) (Prod.mk (Prod.mk l (some (Prod.mk e m))) w1))
       ((Prod.mk (OdOpened x) w1)
        (Prod.mk
          (Prod.mk (ld_with_init l (InitSt x (odd0) (InitBase (env_empty) (odd0) IMEmpty))) none)
          w1))))))
;; a reading error as the file's record. An `unknown_constant` on one of Lean's spellings is
;; refused with what to write (lean_pointer): the elaborator shows the name as written, the
;; first token of its message
(fn read_refusal ((f Fx) (e Symbol) (m (List Int))) Rec
  (match (name_pointer e m)
    ((some (Prod.mk r p)) (RReadErr (fx_file f) r p))
    (none (RReadErr (fx_file f) e m))))
(fn name_pointer ((e Symbol) (m (List Int))) (Option (Prod Symbol (List Int)))
  (if (sym_eq e (sym "unknown_constant")) (lean_pointer m) none))
;; K's refusal of a file's declarations as its record. K's `unknown_constant` names no
;; constant: the ones the declarations cite that the environment lacks are found here and
;; named, each once — an instance or a function a table spelled, the lemmas a proof step
;; builds on
(fn refusal_rec ((l Load) (ds (List Declaration)) (subj Name) (reason Symbol)) Rec
  (if (bool_not (sym_eq reason (sym "unknown_constant"))) (RRefuse subj reason)
  (match (all_unknown (Load.env l) (decl_names ds) (decls_cite ds) nil)
    (nil (RRefuse subj reason))
    (ks (RClassify subj reason (names_spaced ks))))))
(fn names_spaced ((ns (List Name))) (List Int)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n nil) (show_name n))
    ((cons n r) (append (show_name n) (cons 32 (names_spaced r))))))
(fn decls_cite ((ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r)
     (append
       (match d
         ((AxiomDecl (ConstantVal _ _ ty) _) (expr_consts ty))
         ((DefnDecl (ConstantVal _ _ ty) v _ _ _) (append (expr_consts ty) (expr_consts v)))
         ((ThmDecl (ConstantVal _ _ ty) v _) (append (expr_consts ty) (expr_consts v)))
         ((OpaqueDecl (ConstantVal _ _ ty) v _ _) (append (expr_consts ty) (expr_consts v)))
         (_ nil))
       (decls_cite r)))))
;; those of the names that are neither in the environment nor among `own`, each once, in order
(fn all_unknown ((env CheckedEnv) (own (List Name)) (ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil (rev acc))
    ((cons n r)
     (if (bool_or (env_has env n) (bool_or (mem_name n own) (mem_name n acc)))
       (all_unknown env own r acc)
       (all_unknown env own r (cons n acc))))))
;; Lean's spellings the elaborator does not know, each refused with its pointer whatever
;; the file sees (docs/LEAN.md "Refused, and what to write instead" lists the rows). The name is the
;; first token of the elaborator's `unknown_constant` message. A name ending in `!` reads a
;; default from an Inhabited instance — get!-style sugar: inhabited_default with the Option
;; form and the supplied-default form; `==`, `&&`, `||` are lexed as symbols and are no
;; operators; `by` inside a term is no term: lean_symbol with the spelling
(fn lean_pointer ((m (List Int))) (Option (Prod Symbol (List Int)))
  (match (msg_tokens m nil nil)
    (nil none)
    ((cons t _)
     (let
       ((last Int
          (match (nth t (- (len t) 1))
            ((some c) c)
            (none 0))))
       (if (= last 33)
         (let ((base (take (- (len t) 1) t)))
           (some
             (Prod.mk (sym "inhabited_default")
               (append t
                 (append
                   (utf8 " reads a default from an Inhabited instance: write the Option form ")
                   (append base
                     (append
                       (utf8 "? where the export declares it (List's is List.get?Internal), or ")
                       (append base (utf8 "D with a supplied default")))))))))
         (let
           ((first Int
              (match t
                ((cons c _) c)
                (nil 0))))
           (if (bool_and (< 1 (len t)) (= first 33))
             (some
               (Prod.mk (sym "lean_symbol")
                 (append t
                   (utf8 " is Lean's spelling: write (not a) at a Bool operand — Bool.not"))))
             (match (lean_symbol_pointer t)
               ((some p)
                (some
                  (Prod.mk (sym "lean_symbol")
                    (append t (append (utf8 " is Lean's spelling: write ") p)))))
               (none
                 (if (bool_or (int_list_eq t (utf8 "true")) (int_list_eq t (utf8 "false")))
                   (some
                     (Prod.mk (sym "unknown_constant")
                       (append t
                         (append (utf8 ": Init's constructor is Bool.")
                           (append t
                             (append (utf8 " — write Bool.")
                               (append t (utf8 ", or open the namespace with (use Init.Bool)"))))))))
                   none))))))))))
(fn lean_symbol_pointer ((t (List Int))) (Option (List Int))
  (if (int_list_eq t (utf8 "=="))
    (some (utf8 "(BEq.beq a b) at Nat or Int, or the proposition (= a b)"))
  (if (int_list_eq t (utf8 "&&")) (some (utf8 "(and a b) at Bool operands — Bool.and"))
  (if (int_list_eq t (utf8 "||")) (some (utf8 "(or a b) at Bool operands — Bool.or"))
  (if (int_list_eq t (utf8 "by"))
    (some (utf8 "a named theorem and cite it — by is a theorem's proof, not a term"))
  (if (int_list_eq t (utf8 "∀")) (some (utf8 "(forall ((x T)) P)"))
  (if (int_list_eq t (utf8 "∃")) (some (utf8 "(exists ((x T)) P)"))
  (if (int_list_eq t (utf8 "λ")) (some (utf8 "(fun ((x T)) e)"))
  (if (int_list_eq t (utf8 "→")) (some (utf8 "(-> A B)"))
  (if (int_list_eq t (utf8 "↔")) (some (utf8 "(iff P Q)"))
  (if (int_list_eq t (utf8 "¬")) (some (utf8 "(not P)"))
  (if (int_list_eq t (utf8 "∧")) (some (utf8 "(and P Q)"))
  (if (int_list_eq t (utf8 "∨")) (some (utf8 "(or P Q)"))
  (if (int_list_eq t (utf8 "≤")) (some (utf8 "(<= a b)"))
  (if (int_list_eq t (utf8 "≥")) (some (utf8 "(>= a b)"))
  (if (int_list_eq t (utf8 "≠")) (some (utf8 "(!= a b)"))
  (if (int_list_eq t (utf8 "ℕ")) (some (utf8 "Nat"))
  (if (int_list_eq t (utf8 "ℤ")) (some (utf8 "Int"))
  (if (int_list_eq t (utf8 "×")) (some (utf8 "(Prod A B)"))
  none)))))))))))))))))))
;; the message's words: maximal runs without a space, a parenthesis, a colon, a comma, a
;; semicolon or a quote
(fn msg_tokens ((m (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct m))
  (match m
    (nil
      (match cur
        (nil (rev acc))
        (_ (rev (cons (rev cur) acc)))))
    ((cons c r)
     (if (msg_separator c)
       (msg_tokens r nil
         (match cur
           (nil acc)
           (_ (cons (rev cur) acc))))
       (msg_tokens r (cons c cur) acc)))))
(fn msg_separator ((c Int)) Bool
  (bool_or (= c 32)
    (bool_or (= c 40)
      (bool_or (= c 41)
        (bool_or (= c 58) (bool_or (= c 44) (bool_or (= c 59) (bool_or (= c 34) (= c 96)))))))))
(fn init_err ((l Load) (file (List Int)) (reason Symbol) (detail (List Int))) Load
  (ld_rec l (RLoadErr file reason detail)))
;; a file prepared after its leading directives: the export opened (a load given none ends
;; the file here, `init_unavailable`), the names of Init under its identity, which none of
;; its declarations may take, then its demand fetched. None: the file fails here, its
;; record says why
(fn init_prepare ((l Load) (f Fx) (forms (List SExpr)) (w World))
  (Prod (Prod Load (Option Fx)) World)
  (match (init_opened l w)
    ((Prod.mk (Prod.mk l1 (some (Prod.mk e m))) w1)
     (Prod.mk (Prod.mk (init_err l1 (fx_file f) e m) none) w1))
    ((Prod.mk (Prod.mk l1 none) w1)
     (match (init_taken l1 f w1)
       ((Prod.mk f2 w2)
        (match (init_demand l1 f2 forms w2)
          ((Prod.mk (Prod.mk l2 true) w3) (Prod.mk (Prod.mk l2 (some f2)) w3))
          ((Prod.mk (Prod.mk l2 false) w3) (Prod.mk (Prod.mk l2 none) w3))))))))
(fn init_taken ((l Load) (f Fx) (w World)) (Prod Fx World)
  (match (Load.init l)
    ((InitSt x _ _)
     (match (od_names_under x (append (show_name (Fx.ident f)) (utf8 ".")) w)
       ((Prod.mk ns w1) (Prod.mk (with Fx f (taken ns)) w1))))
    (_ (Prod.mk f w))))
;; a file's demand of Init, for these forms: every token of the forms and of the
;; sidecar's blocks under the candidates resolution tries — under the prefixes the file has
;; opened and each one a `use` among the forms opens further down, so that no candidate of
;; a later citation is left to what another file fetched —, and the kits. False: the load
;; failed, its error recorded
(fn init_demand ((l Load) (f Fx) (forms (List SExpr)) (w World)) (Prod (Prod Load Bool) World)
  (match (Load.init l)
    ((InitSt x done base)
     (let ((sc (fx_scope l (with Fx f (opened (append (Fx.opened f) (later_opens forms)))))))
       (match (init_empty x (init_prefixes sc) nil w)
         ((Prod.mk (Prod.mk xe empty) we)
          (let
            ((cands
               (init_candidates sc
                 (tok_names
                   (autos_tokens (Fx.autos f)
                     (form_tokens (if (Load.unchecked l) (forms_read l forms) forms)
                       (Toks IMEmpty nil))))
                 empty
                 nil)))
            (match
              (init_fetch
                (with Load (ld_with_init l (InitSt xe done base))
                  (cited (rev_onto cands (Load.cited l))))
                (append cands (init_kit))
                we)
              ((Prod.mk (Prod.mk l1 (some _)) w1) (Prod.mk (Prod.mk l1 true) w1))
              ((Prod.mk (Prod.mk l1 none) w1) (Prod.mk (Prod.mk l1 false) w1))))))))
    (_ (Prod.mk (Prod.mk l true) w))))
;; the prefixes the `use` forms among these open
(fn later_opens ((forms (List SExpr))) (List Open)
  (measure (struct forms))
  (match forms
    (nil nil)
    ((cons s r)
     (match (form_of s)
       ((FUse p ms) (cons (open_of p ms) (later_opens r)))
       (_ (later_opens r))))))
;; those of the names the export declares, the satellites of the inductives among them, and
;; their closure admitted into the load's environment: the records admitted — 0 when the
;; environment held them all. None: the load failed, its error recorded
(fn init_fetch ((l Load) (ns (List Name)) (w World)) (Prod (Prod Load (Option Int)) World)
  (match (Load.init l)
    ((InitSt x done base)
     (match (init_resolve x ns nil nil w)
       ((Prod.mk (Prod.mk x1 (Prod.mk ords inds)) w1)
        (match (init_resolve x1 (init_satellites inds nil) ords nil w1)
          ((Prod.mk (Prod.mk x2 (Prod.mk ords2 _)) w2)
           (init_load (ld_with_init l (InitSt x2 done base)) ords2 w2))))))
    (_ (Prod.mk (Prod.mk l (some 0)) w))))

;; ---- a name the environment was asked for and did not hold -----------------------------------
;; One declaration has been read from the load `l0` into `l1`, and the words of its refusals
;; that may name a constant are at hand (Load.missed, ld_miss).
;; Every one of them that names — under the candidates resolution tries — a declaration of
;; the export the environment lacks is fetched with its closure into `l0`, and the caller reads the
;; declaration again from there (True): so a constant a proof step, the definer, a derivation
;; or K asked for by a name it built is there on the second reading, and a file's record
;; never says that Init's constant is unknown. When nothing was fetched the reading stands
;; (False). The words `l0`
;; carried stay with the result: an enclosing reading settles them
(fn settle_missed ((l0 Load) (l1 Load) (f Fx) (fuel Int) (w World)) (Prod (Prod Load Bool) World)
  (let ((stands (with Load l1 (missed (Load.missed l0)))))
    (match (Load.missed l1)
      (nil (Prod.mk (Prod.mk stands false) w))
      (ms
        (match (Load.init l0)
          ((InitSt _ _ _)
           (if (< fuel 1) (Prod.mk (Prod.mk stands false) w)
           (match (init_fetch l0 (words_names (fx_scope l1 f) ms) w)
             ((Prod.mk (Prod.mk l2 none) w1)
              (Prod.mk (Prod.mk (with Load l2 (missed (Load.missed l0))) false) w1))  ; the fetch failed: its load error stands in the reading's place and ends the file
             ((Prod.mk (Prod.mk l2 (some n)) w1)
              (if (< 0 n) (Prod.mk (Prod.mk (ld_forget_all l2) true) w1)  ; constants fetched: no reading kept holds
              (Prod.mk (Prod.mk (ld_with_init stands (Load.init l2)) false) w1))))))
          (_ (Prod.mk (Prod.mk stands false) w)))))))
;; the names the words can stand for: each under the candidates resolution tries
(fn words_names ((sc Scope) (ws (List (List Int)))) (List Name)
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons t r)
     (match (name_of_sym (sym_of_chars t))
       ((some n) (append (scope_candidates sc (init_strip_at n)) (words_names sc r)))
       (none (words_names sc r))))))
;; the refusals that say a name written in the source names nothing: the elaborator's
;; `unknown_constant` (K's is the same word), the classifier's `unknown_type`, `unknown_head`
;; and `unbound_name`
(fn citation_reason ((e Symbol)) Bool
  (bool_or (sym_eq e (sym "unknown_constant"))
    (bool_or (sym_eq e (sym "unknown_type"))
      (bool_or (sym_eq e (sym "unknown_head")) (sym_eq e (sym "unbound_name"))))))
;; every candidate of every token (its `@` sigil of an explicit application dropped), except
;; those under a prefix the export declares nothing under (the file's own identity, an
;; opened native module): resolution's candidates, pruned
(fn init_candidates ((sc Scope) (toks (List Name)) (empty (List (List Int))) (acc (List Name)))
  (List Name)
  (measure (struct toks))
  (match toks
    (nil acc)
    ((cons t r)
     (init_candidates sc r empty (init_prune (scope_candidates sc (init_strip_at t)) empty acc)))))
(fn init_strip_at ((t Name)) Name
  (match (starts_with_lit (utf8 "@") (show_name t))
    ((some r)
     (match (name_of_sym (sym_of_chars r))
       ((some n) n)
       (none t)))
    (none t)))
(fn init_prune ((cs (List Name)) (empty (List (List Int))) (acc (List Name))) (List Name)
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons c r) (init_prune r empty (if (init_under_any (show_name c) empty) acc (cons c acc))))))
(fn init_under_any ((s (List Int)) (ps (List (List Int)))) Bool
  (measure (struct ps))
  (match ps
    (nil false)
    ((cons p r) (if (ix_starts s p) true (init_under_any s r)))))
;; the prefixes resolution puts above a token here: the file's identity, the opened ones
(fn init_prefixes ((sc Scope)) (List Name) (cons (sc_module sc) (open_prefixes (sc_opened sc))))
;; those of them the export declares nothing under, rendered with their dot
(fn init_empty ((x OdIx) (ps (List Name)) (acc (List (List Int))) (w World))
  (Prod (Prod OdIx (List (List Int))) World)
  (measure (struct ps))
  (match ps
    (nil (Prod.mk (Prod.mk x acc) w))
    ((cons p r)
     (match (od_has_under x p w)
       ((Prod.mk (Prod.mk x1 true) w1) (init_empty x1 r acc w1))
       ((Prod.mk (Prod.mk x1 false) w1)
        (init_empty x1 r (cons (append (show_name p) (utf8 ".")) acc) w1))))))
;; the ordinals of the names the export declares, and those names among them whose record
;; is an inductive block (kind i)
(fn init_resolve ((x OdIx) (ns (List Name)) (acc (List Int)) (inds (List Name)) (w World))
  (Prod (Prod OdIx (Prod (List Int) (List Name))) World)
  (measure (struct ns))
  (match ns
    (nil (Prod.mk (Prod.mk x (Prod.mk acc inds)) w))
    ((cons n r)
     (match (od_lookup x n w)
       ((Prod.mk (Prod.mk x1 none) w1) (init_resolve x1 r acc inds w1))
       ((Prod.mk (Prod.mk x1 (some o)) w1)
        (match (od_kind_of x1 o w1)
          ((Prod.mk (Prod.mk x2 k) w2)
           (init_resolve x2 r (cons o acc) (if (= k 105) (cons n inds) inds) w2))))))))
;; what the elaborator, the tactics and the definer construct from an inductive name: its
;; case analysis, no-confusion, below, brecOn, a constructor's injectivity
(fn init_satellites ((ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r)
     (init_satellites r
       (append
         (list (nm_cases_on n) (nm_nct n) (nm_nc n) (name_append n (n1 (sym "below")))
           (name_append n (n1 (sym "brecOn")))
           (name_append n (n1 (sym "inj"))))
         acc)))))
;; the names the gates construct: K's own and the pins, the elaborator's,
;; the tactics', arith's, the derivations', the definer's, the spelling tables' — fetched
;; for every module, so that a gate's question "is this constant there" has one answer
(fn init_kit () (List Name)
  (append (k_kit)
    (append (el_kit)
      (append (tc_kit) (append (ar_all_kit) (append (dv_kit) (append (df_kit) (sp_kit))))))))
(fn k_kit () (List Name)
  (append (pin_candidates)
    (list (nm_nat) (nm_nat_zero) (nm_nat_succ) (nm_string) (n2 (sym "String") (sym "ofList"))
      (n1 (sym "Char"))
      (n2 (sym "Char") (sym "ofNat"))
      (n1 (sym "Bool"))
      (n2 (sym "Bool") (sym "true"))
      (n2 (sym "Bool") (sym "false"))
      (n1 (sym "eagerReduce"))
      (n2 (sym "Lean") (sym "reduceBool"))
      (n2 (sym "Lean") (sym "reduceNat"))
      (nm_list)
      (nm_list_cons)
      (nm_list_nil)
      (nm_eq)
      (nm_eq_refl)
      (n1 (sym "Quot"))
      (nm_quot_mk)
      (nm_quot_lift)
      (nm_quot_ind)
      (n2 (sym "Quot") (sym "sound"))
      (nm_int_ty)
      (nm_int_of_nat)
      (nm_int_neg_succ))))
;; the demanded records' closure through K (initload.shard od_load): checked into the load's own
;; environment on a fresh run over it (one environment, one counter: no second
;; environment, nothing transferred); every constant admitted entered in the ordinal table with
;; its ordinal. While the load has declared nothing, what it holds is Init alone and becomes the
;; base (ld_reroot)
(fn init_load ((l Load) (ords (List Int)) (w World)) (Prod (Prod Load (Option Int)) World)
  (match (Load.init l)
    ((InitSt x done base)
     (match (od_load x (Load.env l) done ords w)
       ((Prod.mk (OdLoadErr x1 e m) w1)
        (Prod.mk (Prod.mk (init_err (ld_with_init l (InitSt x1 done base)) (utf8 "Init") e m) none)
          w1))
       ((Prod.mk (OdLoaded x1 run1 done1 cs n) w1)
        (let ((l1 (ld_add_inits (ld_with_env l (run_env run1) (Load.memo l)) cs)))
          (Prod.mk
            (Prod.mk
              (if (ld_undeclared l)
                (ld_with_init l1 (InitSt x1 done1 (InitBase (Load.env l1) done1 (Load.inits l1))))
                (with Load (ld_with_init l1 (InitSt x1 done1 base))
                  (beyond (ordinals_onto cs (Load.beyond l1)))))
              (some n))
            w1)))))
    (_ (Prod.mk (Prod.mk l (some 0)) w))))

;; the constants of Init a token of the loaded files can resolve to: the candidates the files'
;; demands asked the export for that the load imported, each once
(fn ld_cited_init ((l Load)) (List Name) (cited_init (Load.inits l) (Load.cited l) IMEmpty nil))
;; the tables a closure's programs were read by and the constants of Init its files cite: the
;; load's own, then each linked implementation's — its fork's, which held what the
;; implementation's files demanded of Init and the main line never fetched
(type Cited (Cited ESt CheckedEnv (List Name)))
(fn ld_cited ((l Load)) (List Cited) (cons (cited_of l) (cited_each (Load.linked l))))
(fn cited_of ((l Load)) Cited (Cited (Load.etab l) (Load.env l) (ld_cited_init l)))
(fn cited_each ((ls (List Load))) (List Cited)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons l r) (cons (cited_of l) (cited_each r)))))
(fn ld_keep_fork ((l Load) (fork Load)) Load (with Load l (linked (cons fork (Load.linked l)))))
(fn cited_init
  ((inits (IntMap (List (Prod Name Int))))
   (ns (List Name))
   (seen (IntMap (List Name)))
   (acc (List Name)))
  (List Name)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r)
     (let ((h (name_key n)))
       (let
         ((b (List Name)
            (match (im_find seen h)
              ((some x) x)
              (none nil))))
         (if (mem_name n b) (cited_init inits r seen acc)
         (cited_init inits r (im_insert seen h (cons n b))
           (match (ords_find inits n)
             ((some _) (cons n acc))
             (none acc)))))))))

;; the load a driver starts from: the export and its index named (`--init EXPORT --init-index
;; INDEX`), opened at the first file (init_opened); neither named: no file loads
(fn ld_start ((rootp (List (List Int))) (export (List Int)) (index (List Int))) Load
  (if (= (len export) 0) (load0 rootp) (ld_with_init (load0 rootp) (InitPaths export index))))

;; ---- files and modules -----------------------------------------------------------------------
(fn import_depth () Int 1000)

;; a file named on the command line: under the root, spelled from the same base as the root
(fn load_root_file ((l Load) (file (List Int)) (w World)) (Prod Load World)
  (match (parts_of file)
    (none (Prod.mk (ld_rec l (RLoadErr file (sym "bad_path") (utf8 ""))) w))
    ((some parts)
     (match (strip_parts (Load.root l) parts)
       (none (Prod.mk (ld_rec l (RLoadErr file (sym "outside_root") (join_path (Load.root l)))) w))
       ((some rel)
        (match (module_of rel)
          (MPDir (load_dir_checked l rel (import_depth) w))
          (_ (load_module l rel (import_depth) w))))))))

;; a root-relative file as a module: once; a cycle refused; the records
;; of its forms; its MODULE record when its forms are done
(fn load_module ((l Load) (rel (List (List Int))) (fuel Int) (w World)) (Prod Load World)
  (measure fuel)
  (if (base_reserved rel)
    (Prod.mk
      (ld_rec l
        (RLoadErr (join_path rel) (sym "reserved_module")
          (utf8 "the module `shard` is the system's own: the base every file sees")))
      w)
    (match (module_of rel)
      ((MPBad m) (Prod.mk (ld_rec l (RLoadErr (join_path rel) (sym "bad_module_name") m)) w))
      (MPDir (load_dir l rel fuel w))
      ((MPView mp)
       (match (load_file_module l rel mp true fuel w)
         ((Prod.mk (Prod.mk l1 _) w1) (Prod.mk l1 w1))))
      ((MPOk mp)
       (match (load_file_module l rel mp false fuel w)
         ((Prod.mk (Prod.mk l1 _) w1) (Prod.mk l1 w1)))))))

;; the base (base.shard) before a file whose forms use one of its operators: read once in a
;; load, as the module `shard.int`, and seen by the file that asked; then the file's demand
;; of Init. The E count is taken after both: the file's own declarations from here (rec_threads)
;; the base module in the load: as it stands, or loaded now
(fn base_loaded ((l Load) (fuel Int) (w World)) (Prod (Prod Load (Option ForkPt)) World)
  (match (ld_find_mod (Load.mods l) (base_module))
    ((some _) (Prod.mk (Prod.mk l none) w))
    (none (load_source_module l (base_rel) (base_module) false (- fuel 1) (base_source) w))))
(fn init_prepare_base ((l Load) (f Fx) (forms (List SExpr)) (fuel Int) (w World))
  (Prod (Prod Load (Option Fx)) World)
  (measure fuel)
  (if (bool_not (uses_base (Load.unchecked l) forms))
    (init_prepare l (with Fx f (ecount (es_count (Load.etab l)))) forms w)
    (match (base_loaded l fuel w)
      ((Prod.mk (Prod.mk l1 _) w1)
       (init_prepare l1 (with Fx (fx_see f (list (base_module))) (ecount (es_count (Load.etab l1))))
         forms
         w1)))))
;; one file as the module `mp`; a view when `view`. Returns, for a view, the
;; fork point: the loader's state after the view's leading
;; directives, the file's context then, and the forms after them
(type ForkPt (ForkPt Load Fx (List SExpr)))
(fn load_file_module ((l Load) (rel (List (List Int))) (mp Name) (view Bool) (fuel Int) (w World))
  (Prod (Prod Load (Option ForkPt)) World)
  (measure fuel)
  (match (ld_find_mod (Load.mods l) mp)
    ((some m)
     (if (int_list_eq (Module.file m) (join_path rel)) (Prod.mk (Prod.mk l none) w)  ; loaded, or failed: the importer reads mod_ok
     (Prod.mk
       (Prod.mk
         (ld_rec l
           (RLoadErr (join_path rel) (sym "module_collision")
             (append (show_name mp) (append (utf8 " is already ") (Module.file m)))))
         none)
       w)))
    (none
      (if (mem_name mp (Load.stack l))
        (Prod.mk
          (Prod.mk (ld_rec l (RLoadErr (join_path rel) (sym "import_cycle") (show_name mp))) none)
          w)
      (if (< fuel 0)
        (Prod.mk (Prod.mk (ld_rec l (RLoadErr (join_path rel) (sym "import_depth") (utf8 ""))) none)
          w)
        (match (read_file (join_path (append (Load.root l) rel)) w)
          ((Prod.mk none w1)
           (Prod.mk
             (Prod.mk
               (ld_rec l
                 (RLoadErr (join_path rel) (sym "missing_file")
                   (join_path (append (Load.root l) rel))))
               none)
             w1))
          ((Prod.mk (some src) w1) (load_source_module l rel mp view fuel src w1))))))))
;; a module's text as the module `mp`: a file's that load_file_module read, or the base's
;; (base.shard), which no file holds
(fn load_source_module
  ((l Load) (rel (List (List Int))) (mp Name) (view Bool) (fuel Int) (src (List Int)) (w1 World))
  (Prod (Prod Load (Option ForkPt)) World)
  (measure fuel)
  (match (read_all src)
    ((RAErr e off)
     (Prod.mk
       (Prod.mk (ld_rec l (RReadErr (join_path rel) e (append (utf8 "at byte ") (show_nat off))))
         none)
       w1))
    ((RAOk forms0)
     (match (expand_records forms0)
       ((RxErr e m) (Prod.mk (Prod.mk (ld_rec l (RReadErr (join_path rel) e m)) none) w1))
       ((RxOk forms)
        (match (sealed_ident l rel mp view w1)
          ((Prod.mk ip w1s)
           (match (split_directives forms nil)
             ((Prod.mk dirs rest)
              (match (read_sidecar l rel rest w1s)
                ((Prod.mk (Prod.mk l0a autos) w1s2)
                 (match
                   (pre_register_file l0a
                     (make Fx (module mp) (ident ip) (parts rel) (opened nil) (vis (list mp))
                       (trusts nil)
                       (hash (hash_name mp))
                       (view view)
                       (autos autos)
                       (impl false)
                       (taken nil)
                       (ecount 0)
                       (bins nil))
                     rest)
                   ((Prod.mk none l0) (Prod.mk (Prod.mk (ld_add_failed l0 mp rel) none) w1s2))  ; the World after the sidecar's read, not the one sealed_ident consumed
                   ((Prod.mk (some f0) l0)
                    (match
                      (load_forms (ld_with_stack l0 (cons mp (Load.stack l))) f0 dirs fuel w1s2)
                      ((Prod.mk (Prod.mk l1 none) w2)
                       (Prod.mk
                         (Prod.mk (ld_add_failed (ld_with_stack l1 (Load.stack l)) mp rel) none)
                         w2))
                      ((Prod.mk (Prod.mk l1p (some f1p)) w2p)
                       (match (init_prepare_base l1p f1p rest fuel w2p)  ; the E count after the imports: the file's own declarations from here (rec_threads)   ; the Init demand of the file's forms, its taken names
                         ((Prod.mk (Prod.mk l1 none) w2)
                          (Prod.mk
                            (Prod.mk (ld_add_failed (ld_with_stack l1 (Load.stack l)) mp rel) none)
                            w2))
                         ((Prod.mk (Prod.mk l1a (some f1)) w2)
                          (match (pre_register_late l1a f1 rest)
                            ((Prod.mk none l1)
                             (Prod.mk
                               (Prod.mk (ld_add_failed (ld_with_stack l1 (Load.stack l)) mp rel)
                                 none)
                               w2))
                            ((Prod.mk (some _) l1)
                             (match (load_forms l1 f1 rest fuel w2)
                               ((Prod.mk (Prod.mk l2 (some f)) w3)
                                (let
                                  ((fp
                                     (if view
                                       (some
                                         (ForkPt.ForkPt (ld_with_stack l1 (Load.stack l)) f1 rest))
                                       none)))
                                  (Prod.mk
                                    (Prod.mk
                                      (ld_rec
                                        (rec_bins
                                          (rec_states
                                            (rec_threads
                                              (rec_unused
                                                (ld_add_mod (ld_with_stack l2 (Load.stack l))
                                                  (make Module (path mp) (file (join_path rel))
                                                    (hash (Fx.hash f))
                                                    (closure (Fx.vis f))
                                                    (fork fp)
                                                    (ok true)))
                                                f
                                                dirs
                                                rest)
                                              f)
                                            f)
                                          f)
                                        (RModule mp (join_path rel) (Fx.hash f) (Fx.vis f)))
                                      fp)
                                    w3)))
                               ((Prod.mk (Prod.mk l2 none) w3)
                                (Prod.mk
                                  (Prod.mk (ld_add_failed (ld_with_stack l2 (Load.stack l)) mp rel)
                                    none)
                                  w3))))))))))))))))))))))
;; the prefix a file's declarations take: its own module, or the sealed directory's for a file
;; directly inside a directory that has a view (one module across the directory's files; the
;; view and the implementation already carry it)
(fn sealed_ident ((l Load) (rel (List (List Int))) (mp Name) (view Bool) (w World))
  (Prod Name World)
  (if view (Prod.mk mp w)
  (let ((d (dir_of rel)))
    (match d
      (nil (Prod.mk mp w))
      (_
        (match (has_view l d w)
          ((Prod.mk true w1)
           (match (dir_module d)
             ((MPOk dm) (Prod.mk dm w1))
             (_ (Prod.mk mp w1))))
          ((Prod.mk false w1) (Prod.mk mp w1))))))))
;; the realize heads, once the directives made their targets visible and the demand of Init
;; is in the environment
(fn pre_register_late ((l Load) (f Fx) (forms (List SExpr))) (Prod (Option Fx) Load)
  (match (pre_register_realize (Load.etab l) (fx_scope l f) (Load.env l) forms)
    ((PreErr e m) (Prod.mk none (ld_rec l (RLoadErr (fx_file f) e m))))
    ((PreOk es) (Prod.mk (some f) (ld_with_e l es)))))
;; the file's E heads registered before any body; a duplicate ends the file
(fn pre_register_file ((l Load) (f Fx) (forms (List SExpr))) (Prod (Option Fx) Load)
  (match (pre_register (Load.etab l) (fx_scope l f) forms)
    ((PreErr e m) (Prod.mk none (ld_rec l (RLoadErr (fx_file f) e m))))
    ((PreOk es) (Prod.mk (some (open_types f (fx_scope l f) forms)) (ld_with_e l es)))))
;; every `type` of the file opens its constructors for the whole file: they are pre-registered
;; like the file's heads, so a body cites them before the declaration as it calls a function
;; declared later. The constructors only — not every declaration under the type's prefix: a
;; record's accessors (`Load.env`) are cited qualified, or opened by `(use M.T)` where a file
;; wants them bare, else every field name would be refused as a pattern variable of the file
;; (pattern_name)
(fn open_types ((f Fx) (sc Scope) (forms (List SExpr))) Fx
  (measure (struct forms))
  (match forms
    (nil f)
    ((cons s r)
     (open_types
       (if (sym_eq (form_head s) (sym "type"))
         (fx_open f (open_some (type_name sc s) (type_ctor_syms s)))
         f)
       sc
       r))))
;; the constructor names of a (type HEAD (C …) …) form
(fn type_ctor_syms ((s SExpr)) (List Symbol)
  (match s
    ((SList (cons _ (cons _ ctors))) (ctor_syms ctors))
    (_ nil)))
(fn ctor_syms ((cs (List SExpr))) (List Symbol)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (SList (cons (SSym c) _)) r) (cons c (ctor_syms r)))
    ((cons _ r) (ctor_syms r))))
;; the leading directives (import / use / trusts) and the rest
(fn split_directives ((forms (List SExpr)) (acc (List SExpr))) (Prod (List SExpr) (List SExpr))
  (measure (struct forms))
  (match forms
    (nil (Prod.mk (rev acc) nil))
    ((cons s r)
     (match (form_of s)
       (FDecl (Prod.mk (rev acc) forms))
       (_ (split_directives r (cons s acc)))))))

;; ---- the well-threadedness verdicts (thread.shard) -----------------------------------------
;; the file's own E functions (those the table gained since the file began), each that handles
;; a token recorded THREAD with its verdict — a report; the refusal is the bin form's, on its
;; closure (bin_threads)
(fn rec_threads ((l Load) (f Fx)) Load
  (let ((es (Load.etab l)))
    (rt_go es (th_kinds es) (rev (es_newest es (- (es_count es) (Fx.ecount f)))) l)))
(fn rt_go ((es ESt) (wk Wk) (ds (List EDecl)) (l Load)) Load
  (measure (struct ds))
  (match ds
    (nil l)
    ((cons d r)
     (rt_go es wk r
       (match (th_fn es wk d)
         (none l)
         ((some (Prod.mk k m)) (ld_rec l (RThread (edecl_name d) k m))))))))
;; ---- the state's check (thread.shard) --------------------------------------------------------
;; under --state: the file's own E functions judged with the modes of the files before, a
;; STATE record for each that takes or returns the checker's state; the modes kept for the
;; files after. A fork carries its fork point's modes and its own are dropped with it
(fn rec_states ((l Load) (f Fx)) Load
  (match (Load.states l)
    (none l)
    ((some md)
     (let ((es (Load.etab l)))
       (match (sv_file es md (rev (es_newest es (- (es_count es) (Fx.ecount f)))))
         ((Prod.mk md1 vs) (rs_go (with Load l (states (some md1))) vs)))))))
(fn rs_go ((l Load) (vs (List (Prod Name (Prod Symbol (List Int)))))) Load
  (measure (struct vs))
  (match vs
    (nil l)
    ((cons (Prod.mk n (Prod.mk k m)) r) (rs_go (ld_rec l (RState n k m)) r))))
;; ---- the bin form ----------------------------------------------------------------------------
;; (bin NAME (entry F) (externs E…) (trusts A…) (requires R…)), stashed at its form and
;; checked at the file's end once every fn settled: the entry a fn in scope with a World last
;; and checked parameters before it; the roster every extern the entry's E closure calls, each
;; listed one declared; the trusts the axioms beyond the standard profile that the requirements
;; and the closure's definitions rest on; each requirement an accepted theorem (or a discharged
;; requirement's proof), MET, a pending one UNMET; every function of the closure THREAD ok, else
;; UNTHREADED. The record `BIN NAME entry F externs N trusts N requires MET/TOTAL`, then the
;; `UNMET`, `UNTHREADED` and `BAD-BIN` lines, each an error: an unmet requirement, an unthreaded
;; function, an extern outside the roster or an untrusted axiom fails the load (pending is
;; never silent). The verdicts are re-derived by every load of the file
(fn rec_bins ((l Load) (f Fx)) Load (rb_go l f (Fx.bins f)))
(fn rb_go ((l Load) (f Fx) (ss (List SExpr))) Load
  (measure (struct ss))
  (match ss
    (nil l)
    ((cons s r) (rb_go (check_bin l f s) f r))))
(type BfRes (BfOk Name Name (List Name) (List Name) (List Name)) (BfErr (List Int)))  ; name, entry, externs, trusts, requires — as written
(fn check_bin ((l Load) (f Fx) (s SExpr)) Load
  (let ((sc (fx_scope l f)))
    (match (bin_form sc s)
      ((BfErr m) (ld_rec l (RLoadErr (fx_file f) (sym "bad_shape") m)))
      ((BfOk n fw exts trusts reqs)
       (match (bin_entry l sc fw)
         ((Prod.mk none m) (ld_rec l (RBinErr n (sym "bad_entry") m)))
         ((Prod.mk (some fid) _)
          (let ((es (Load.etab l)))
            (let ((wk (th_kinds es)))
              (match (bin_shape es wk fid)
                ((some m) (ld_rec l (RBinErr n (sym "bad_entry") m)))
                (none
                  (match (bin_externs l sc exts nil nil)
                    ((Prod.mk ids ext_errs)
                     (match (bin_closure es (list fid) nil 100000)
                       (fns
                         (match (bin_requires l sc reqs nil 0 nil)
                           ((Prod.mk (Prod.mk rnames met) req_errs)
                            (rb_errs (ld_rec l (RBin n fid ids (len trusts) rnames met)) n
                              (append ext_errs
                                (append (bin_outside es fns ids)
                                  (append req_errs
                                    (append (bin_trusts l sc trusts (append rnames fns))
                                      (bin_threads es wk fns))))))))))))))))))))))
(fn rb_errs ((l Load) (n Name) (errs (List (Prod Symbol (List Int))))) Load
  (measure (struct errs))
  (match errs
    (nil l)
    ((cons (Prod.mk k m) r) (rb_errs (ld_rec l (RBinErr n k m)) n r))))
;; the form's clauses, each at most once, the entry required
(fn bin_form ((sc Scope) (s SExpr)) BfRes
  (match s
    ((SList (cons _ (cons (SSym nm) clauses)))
     (match (name_of_sym nm)
       (none (BfErr (utf8 "(bin NAME …): NAME is a symbol")))
       ((some n) (bin_clauses (qualify sc n) clauses none nil nil nil))))
    (_ (BfErr (utf8 "(bin NAME (entry F) (externs E…) (trusts A…) (requires R…))")))))
(fn bin_clauses
  ((n Name)
   (cs (List SExpr))
   (entry (Option Name))
   (exts (List Name))
   (trusts (List Name))
   (reqs (List Name)))
  BfRes
  (measure (struct cs))
  (match cs
    (nil
      (match entry
        (none (BfErr (append (show_name n) (utf8 ": no (entry F) clause"))))
        ((some f) (BfOk n f exts trusts reqs))))
    ((cons (SList (cons (SSym k) args)) r)
     (if (sym_eq k (sym "entry"))
       (match (bin_syms args nil)
         ((some (cons f nil))
          (match entry
            (none (bin_clauses n r (some f) exts trusts reqs))
            (_ (BfErr (append (show_name n) (utf8 ": two entry clauses"))))))
         (_ (BfErr (append (show_name n) (utf8 ": (entry F) names one fn")))))
     (if (sym_eq k (sym "externs"))
       (match (bin_syms args nil)
         ((some xs) (bin_clauses n r entry (append exts xs) trusts reqs))
         (none (BfErr (append (show_name n) (utf8 ": (externs E…) names externs")))))
     (if (sym_eq k (sym "trusts"))
       (match (bin_syms args nil)
         ((some xs) (bin_clauses n r entry exts (append trusts xs) reqs))
         (none (BfErr (append (show_name n) (utf8 ": (trusts A…) names axioms")))))
     (if (sym_eq k (sym "requires"))
       (match (bin_syms args nil)
         ((some xs) (bin_clauses n r entry exts trusts (append reqs xs)))
         (none (BfErr (append (show_name n) (utf8 ": (requires R…) names theorems")))))
       (BfErr (append (show_name n) (append (utf8 ": unknown clause ") (chars_of_sym k)))))))))
    ((cons _ _)
     (BfErr
       (append (show_name n)
         (utf8 ": a clause is (entry F), (externs E…), (trusts A…) or (requires R…)"))))))
(fn bin_syms ((ss (List SExpr)) (acc (List Name))) (Option (List Name))
  (measure (struct ss))
  (match ss
    (nil (some (rev acc)))
    ((cons (SSym x) r)
     (match (name_of_sym x)
       ((some m) (bin_syms r (cons m acc)))
       (none none)))
    (_ none)))
;; the entry: one fn the scope resolves the written name to
(fn bin_entry ((l Load) (sc Scope) (fw Name)) (Prod (Option Name) (List Int))
  (match (only_values (eresolve (Load.etab l) sc fw))
    (nil (Prod.mk none (append (show_name fw) (utf8 " is not a fn in scope"))))
    ((cons (EHit id _ (EIFn _)) nil) (Prod.mk (some id) nil))
    ((cons (EHit _ _ (EIFn _)) _)
     (Prod.mk none (append (show_name fw) (utf8 " is ambiguous: write the qualified name"))))
    ((cons (EHit id _ _) _) (Prod.mk none (append (show_name id) (utf8 " is not a fn"))))))
;; the entry's shape: the World last, every parameter before it one a command-line
;; argument supplies — Int, Nat, a byte-list codec by identity
(fn bin_shape ((es ESt) (wk Wk) (fid Name)) (Option (List Int))
  (match (es_find_decl es fid)
    ((some (EFn _ _ ps _ _ _))
     (match (last_ty ps)
       ((some (ETCon n _))
        (if (mem_name n (wk_worlds wk)) (bin_params ps 1)
        (some (append (show_name fid) (utf8 " does not take a World last")))))
       (_ (some (append (show_name fid) (utf8 " does not take a World last"))))))
    (_ (some (append (show_name fid) (utf8 " is not a fn of the closure"))))))
(fn bin_params ((ps (List EType)) (i Int)) (Option (List Int))
  (measure (struct ps))
  (match ps
    (nil none)
    ((cons _ nil) none)
    ((cons t r)
     (if (bin_entry_param t) (bin_params r (+ i 1))
     (some
       (append (utf8 "parameter ")
         (append (show_nat i)
           (append (utf8 " has the type ")
             (append (flat_ety t)
               (utf8
                 ", which no command-line argument supplies (one supplies Int, Nat, (List Nat) or (List Int), ByteArray)"))))))))))
(fn bin_entry_param ((t EType)) Bool
  (match t
    ((ETCon n _)
     (if (name_eq n (n1 (sym "Int"))) true
     (if (name_eq n (n1 (sym "Nat"))) true
     (match (list_ctors t)
       ((some _) true)
       (none false)))))
    (_ false)))
;; the roster: every listed name an extern in scope, by identity
(fn bin_externs
  ((l Load) (sc Scope) (xs (List Name)) (ids (List Name)) (errs (List (Prod Symbol (List Int)))))
  (Prod (List Name) (List (Prod Symbol (List Int))))
  (measure (struct xs))
  (match xs
    (nil (Prod.mk (rev ids) (rev errs)))
    ((cons x r)
     (match (bin_extern_hit (eresolve (Load.etab l) sc x))
       ((some id) (bin_externs l sc r (if (mem_name id ids) ids (cons id ids)) errs))
       (none
         (bin_externs l sc r ids
           (cons
             (Prod.mk (sym "extern_undeclared")
               (append (show_name x) (utf8 " is not an extern in scope")))
             errs)))))))
(fn bin_extern_hit ((hs (List EHit))) (Option Name)
  (measure (struct hs))
  (match hs
    (nil none)
    ((cons (EHit id _ (EIExt _)) _) (some id))
    ((cons _ r) (bin_extern_hit r))))
;; the entry's E closure: the fns reached through calls, the entry first
(fn bin_closure ((es ESt) (todo (List Name)) (seen (List Name)) (fuel Int)) (List Name)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (rev seen)
  (match todo
    (nil (rev seen))
    ((cons g r)
     (if (mem_name g seen) (bin_closure es r seen (- fuel 1))
     (match (es_find_decl es g)
       ((some (EFn _ _ _ _ _ body))
        (match (bin_heads body (Prod.mk nil nil))
          ((Prod.mk cs _) (bin_closure es (append (rev cs) r) (cons g seen) (- fuel 1)))))
       (_ (bin_closure es r (cons g seen) (- fuel 1)))))))))
;; the heads a body calls: the fns and the externs, each once
(fn bin_heads ((t ETerm) (acc (Prod (List Name) (List Name)))) (Prod (List Name) (List Name))
  (measure (ETerm.size t))
  (match t
    ((EBVar _) acc)
    ((ELit _) acc)
    (EAbsurd acc)
    ((ELam _ _ b) (bin_heads b acc))
    ((ECtor _ as) (bin_heads_all as acc))
    ((EPrim _ as) (bin_heads_all as acc))
    ((ECall g as)
     (bin_heads_all as
       (match acc
         ((Prod.mk cs xs) (Prod.mk (if (mem_name g cs) cs (cons g cs)) xs)))))
    ((EExt x as)
     (bin_heads_all as
       (match acc
         ((Prod.mk cs xs) (Prod.mk cs (if (mem_name x xs) xs (cons x xs)))))))
    ((EMatch s arms) (bin_heads_arms arms (bin_heads s acc)))
    ((ELet rs b) (bin_heads b (bin_heads_all rs acc)))
    ((EIf a b c) (bin_heads c (bin_heads b (bin_heads a acc))))))
(fn bin_heads_all ((ts (List ETerm)) (acc (Prod (List Name) (List Name))))
  (Prod (List Name) (List Name))
  (measure (List_ETerm.size ts))
  (match ts
    (nil acc)
    ((cons t r) (bin_heads_all r (bin_heads t acc)))))
(fn bin_heads_arms ((arms (List EArm)) (acc (Prod (List Name) (List Name))))
  (Prod (List Name) (List Name))
  (measure (List_EArm.size arms))
  (match arms
    (nil acc)
    ((cons (EArm _ b) r) (bin_heads_arms r (bin_heads b acc)))))
(fulfills bin_heads.dec_1 (by (intro t acc w1 w2 b h) (rw h) (rw ETerm.size.eq_10) (arith)))
(fulfills bin_heads.dec_2 (by (intro t acc w as h) (rw h) (rw ETerm.size.eq_3) (arith)))
(fulfills bin_heads.dec_3 (by (intro t acc w as h) (rw h) (rw ETerm.size.eq_5) (arith)))
(fulfills bin_heads.dec_4 (by (intro t acc g as h) (rw h) (rw ETerm.size.eq_4) (arith)))
(fulfills bin_heads.dec_5 (by (intro t acc x as h) (rw h) (rw ETerm.size.eq_6) (arith)))
(fulfills bin_heads.dec_6 (by (intro t acc s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills bin_heads.dec_7 (by (intro t acc s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills bin_heads.dec_8 (by (intro t acc rs b h) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills bin_heads.dec_9 (by (intro t acc rs b h) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills bin_heads.dec_10 (by (intro t acc a b c h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills bin_heads.dec_11 (by (intro t acc a b c h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills bin_heads.dec_12 (by (intro t acc a b c h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills bin_heads_all.dec_1 (by (intro ts acc t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills bin_heads_all.dec_2 (by (intro ts acc t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills bin_heads_arms.dec_1
  (by (intro arms acc w b r h) (rw h) (rw List_EArm.size.eq_2) (rw EArm.size.eq_1) (arith)))
(fulfills bin_heads_arms.dec_2
  (by (intro arms acc w b r h) (rw h) (rw List_EArm.size.eq_2) (rw EArm.size.eq_1) (arith)))
(fulfills bin_closure.dec_1
  (by (intro p hf g r ht hm w1 w2 w3 w4 w5 body hd cs w6 hb) (apply natAbs_pred (arith))))
(fulfills bin_closure.dec_2 (by (intro p hf g r ht hm w hd) (apply natAbs_pred (arith))))
(fulfills bin_closure.dec_3 (by (intro p hf g r ht hm) (apply natAbs_pred (arith))))
;; an extern a function of the closure calls outside the roster, named with the function
(fn bin_outside ((es ESt) (fns (List Name)) (ids (List Name))) (List (Prod Symbol (List Int)))
  (measure (struct fns))
  (match fns
    (nil nil)
    ((cons g r)
     (append
       (match (es_find_decl es g)
         ((some (EFn _ _ _ _ _ body))
          (match (bin_heads body (Prod.mk nil nil))
            ((Prod.mk _ xs) (bin_outside_x g (rev xs) ids))))
         (_ nil))
       (bin_outside es r ids)))))
(fn bin_outside_x ((g Name) (xs (List Name)) (ids (List Name))) (List (Prod Symbol (List Int)))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r)
     (if (mem_name x ids) (bin_outside_x g r ids)
     (cons
       (Prod.mk (sym "extern_outside")
         (append (show_name x)
           (append (utf8 " is called in ") (append (show_name g) (utf8 " and is not in the roster")))))
       (bin_outside_x g r ids))))))
;; the requirements: each an accepted theorem in scope — its own name, or a discharged
;; requirement's proof NAME.proof — MET; one read and pending UNMET, counted; else unknown
(fn bin_requires
  ((l Load)
   (sc Scope)
   (rs (List Name))
   (names (List Name))
   (met Int)
   (errs (List (Prod Symbol (List Int)))))
  (Prod (Prod (List Name) Int) (List (Prod Symbol (List Int))))
  (measure (struct rs))
  (match rs
    (nil (Prod.mk (Prod.mk (rev names) met) (rev errs)))
    ((cons r rest)
     (match (bin_theorem (Load.env l) sc (scope_candidates sc r))
       ((some c) (bin_requires l sc rest (cons c names) (+ met 1) errs))
       (none
         (match (bin_pending (Load.pending l) (scope_candidates sc r))
           ((some c)
            (bin_requires l sc rest (cons c names) met
              (cons (Prod.mk (sym "unmet") (show_name c)) errs)))
           (none
             (bin_requires l sc rest names met
               (cons
                 (Prod.mk (sym "unknown_requirement")
                   (append (show_name r) (utf8 ": no theorem of that name in scope")))
                 errs)))))))))
;; a candidate counts where the file can cite it (`visible`), whatever the environment holds
(fn bin_theorem ((env CheckedEnv) (sc Scope) (cs (List Name))) (Option Name)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons c r)
     (if (bool_not (visible sc c)) (bin_theorem env sc r)
     (match (env_find env c)
       ((some (ThmInfo _ _ _)) (some c))
       (_
         (match (env_find env (Str c (sym "proof")))
           ((some (ThmInfo _ _ _)) (some c))
           (_ (bin_theorem env sc r)))))))))
(fn bin_pending ((pending (List Name)) (cs (List Name))) (Option Name)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons c r) (if (mem_name c pending) (some c) (bin_pending pending r)))))
;; the trusts: each an axiom in scope; then every named declaration's assumption closure within
;; the policy the roster states — the standard profile, the load's parameters (a view's, a
;; measured function's pending descent: the manifest's `param` lines) and the roster's axioms
(fn bin_trusts ((l Load) (sc Scope) (ts (List Name)) (decls (List Name)))
  (List (Prod Symbol (List Int)))
  (match (bin_axioms (Load.env l) sc ts nil nil)
    ((Prod.mk _ errs) (append errs (bin_rests l sc ts decls)))))
(fn bin_axioms
  ((env CheckedEnv)
   (sc Scope)
   (ts (List Name))
   (acc (List Name))
   (errs (List (Prod Symbol (List Int)))))
  (Prod (List Name) (List (Prod Symbol (List Int))))
  (measure (struct ts))
  (match ts
    (nil (Prod.mk acc (rev errs)))
    ((cons t r)
     (match (bin_axiom env sc (scope_candidates sc t))
       ((some a) (bin_axioms env sc r (cons a acc) errs))
       (none
         (bin_axioms env sc r acc
           (cons
             (Prod.mk (sym "unknown_trust")
               (append (show_name t) (utf8 " is not an axiom in scope")))
             errs)))))))
(fn bin_axiom ((env CheckedEnv) (sc Scope) (cs (List Name))) (Option Name)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons c r)
     (match (if (visible sc c) (env_find env c) none)
       ((some (AxiomInfo _ _)) (some c))
       (_ (bin_axiom env sc r))))))
(fn bin_rests ((l Load) (sc Scope) (ts (List Name)) (ds (List Name)))
  (List (Prod Symbol (List Int)))
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r)
     (append
       (match (env_find (Load.env l) d)
         (none nil)  ; no L constant (a program without a definition): nothing rests on anything
         ((some _)
          (match (axioms_of (Load.env l) (memos_ax (Load.memo l)) d)
            ((Prod.mk _ none)
             (list
               (Prod.mk (sym "untrusted")
                 (append (show_name d) (utf8 ": its assumptions could not be walked")))))
            ((Prod.mk _ (some axs)) (bin_rests_axs d (outside_policy sc ts (Load.params l) axs))))))
       (bin_rests l sc ts r)))))
(fn bin_rests_axs ((d Name) (axs (List Name))) (List (Prod Symbol (List Int)))
  (measure (struct axs))
  (match axs
    (nil nil)
    ((cons a r)
     (cons
       (Prod.mk (sym "untrusted")
         (append (show_name d)
           (append (utf8 " rests on ")
             (append (show_name a) (utf8 ", which the bin does not trust")))))
       (bin_rests_axs d r)))))
;; the closure's threading: every function's verdict ok
(fn bin_threads ((es ESt) (wk Wk) (fns (List Name))) (List (Prod Symbol (List Int)))
  (measure (struct fns))
  (match fns
    (nil nil)
    ((cons g r)
     (append
       (match (es_find_decl es g)
         ((some d)
          (match (th_fn es wk d)
            ((some (Prod.mk k m))
             (if (sym_eq k (sym "ok")) nil
             (list
               (Prod.mk (sym "unthreaded")
                 (append (show_name g)
                   (append (utf8 " ") (append (chars_of_sym k) (append (utf8 ": ") m))))))))
            (none nil)))
         (none nil))
       (bin_threads es wk r)))))

;; ---- unused use lines ------------------------------------------------------------------------
;; A `(use P)` no citation of the file could need: no symbol token of the file's forms
;; names, under P, a declaration K or the E table holds once the file is loaded. The test
;; is the flat mirror of resolution — a citation is a suffix of its identity and the opened
;; prefix is what stands above it (etable.shard cited_in_scope) — over every token rather
;; than every citation, so a binder or a pattern variable spelled like a declaration can
;; keep a line, never drop one; a line for the file's own module is never needed. Selective
;; opens `(use P a b)` are not judged. Recorded as UNUSED, never a refusal.
;; Cost: the E table's suffix index answers each token with its hits, and the native K
;; declarations are bucketed by last component once per file; only a prefix neither marks
;; pays the token scan against K's environment (`Init`'s bare names under `(use Init.T)`,
;; a view's parameters) — nothing in a file whose lines are all needed.
(fn rec_unused ((l Load) (f Fx) (dirs (List SExpr)) (forms (List SExpr))) Load
  (match (unused_uses l f dirs forms)
    (nil l)
    (ps (ld_rec l (RUnused (Fx.module f) ps)))))
(fn unused_uses ((l Load) (f Fx) (dirs (List SExpr)) (forms (List SExpr))) (List Name)
  (let ((toks (tok_names (form_tokens forms (Toks IMEmpty nil)))) (sc (fx_scope l f)))
    (let
      ((needed
         (needed_k sc (Load.tbl l) (tok_buckets toks IMEmpty)
           (needed_e sc (Load.etab l) toks IMEmpty))))
      (unused_go l sc (Fx.ident f) (uses_of dirs) toks needed nil))))
(fn uses_of ((dirs (List SExpr))) (List Name)
  (measure (struct dirs))
  (match dirs
    (nil nil)
    ((cons s r)
     (match (form_of s)
       ((FUse p nil) (cons p (uses_of r)))
       (_ (uses_of r))))))
(fn unused_go
  ((l Load)
   (sc Scope)
   (m Name)
   (ps (List Name))
   (toks (List Name))
   (needed (IntMap Bool))
   (acc (List Name)))
  (List Name)
  (measure (struct ps))
  (match ps
    (nil (rev acc))
    ((cons p r)
     (unused_go l sc m r toks needed
       (if (name_eq p m) (cons p acc)
       (if (im_has needed (name_key p)) acc
       (if (use_needed l sc p toks) acc
       (cons p acc))))))))
;; the fallback: some token names, under P, a declaration of K the file can cite,
;; whatever the environment holds
(fn use_needed ((l Load) (sc Scope) (p Name) (toks (List Name))) Bool
  (measure (struct toks))
  (match toks
    (nil false)
    ((cons t r)
     (if (bool_and (env_has (Load.env l) (name_append p t)) (visible sc (name_append p t))) true
     (use_needed l sc p r)))))
;; E: every hit of a token by suffix marks the prefix above the token in its identity, and the
;; module that registered the entry — a realization of Init's `List.append` is `std.list`'s, and
;; a program that runs it needs that module open. An entry counts where the file sees the
;; module that registered it (Init's inductives: everywhere), whatever another
;; root of the load put in the table
(fn needed_e ((sc Scope) (es ESt) (toks (List Name)) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct toks))
  (match toks
    (nil needed)
    ((cons t r) (needed_e sc es r (mark_hits sc (es_hits es t) t needed)))))
(fn mark_hits ((sc Scope) (hs (List EEnt)) (t Name) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct hs))
  (match hs
    (nil needed)
    ((cons (EEnt _ id m _) r)
     (mark_hits sc r t
       (if (mod_visible sc m) (im_insert (mark_above id t needed) (name_key m) true) needed)))))
(fn mark_above ((id Name) (t Name) (needed (IntMap Bool))) (IntMap Bool)
  (match (name_above id t)
    ((some pre) (im_insert needed (name_key pre) true))
    (none needed)))
;; K: every native declaration of a module the file sees against the tokens sharing its last
;; component
(fn needed_k
  ((sc Scope)
   (tbl (IntMap (List (Prod Name Name))))
   (buckets (IntMap (List Name)))
   (needed (IntMap Bool)))
  (IntMap Bool)
  (measure (struct tbl))
  (match tbl
    (IMEmpty needed)
    ((IMLeaf _ ds) (mark_decls sc ds buckets needed))
    ((IMNode v c0 c1 c2 c3)
     (needed_k sc c3 buckets
       (needed_k sc c2 buckets
         (needed_k sc c1 buckets
           (needed_k sc c0 buckets
             (match v
               ((some ds) (mark_decls sc ds buckets needed))
               (none needed)))))))))
(fn mark_decls
  ((sc Scope) (ds (List (Prod Name Name))) (buckets (IntMap (List Name))) (needed (IntMap Bool)))
  (IntMap Bool)
  (measure (struct ds))
  (match ds
    (nil needed)
    ((cons (Prod.mk id m) r)
     (mark_decls sc r buckets
       (match (im_find buckets (last_key id))
         ((some ts) (if (mod_visible sc m) (mark_tokens id ts needed) needed))
         (none needed))))))
(fn mark_tokens ((id Name) (ts (List Name)) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct ts))
  (match ts
    (nil needed)
    ((cons t r) (mark_tokens id r (mark_above id t needed)))))
;; the tokens bucketed by their last component's key
(fn tok_buckets ((toks (List Name)) (b (IntMap (List Name)))) (IntMap (List Name))
  (measure (struct toks))
  (match toks
    (nil b)
    ((cons t r)
     (let ((k (last_key t)))
       (tok_buckets r
         (im_insert b k
           (cons t
             (match (im_find b k)
               ((some ts) ts)
               (none nil)))))))))
(fn last_key ((n Name)) Int
  (match n
    ((Str _ s) (name_key (n1 s)))
    ((Num _ k) (name_key (Num Anon k)))
    (Anon 0)))
;; the distinct dotted-name tokens of the forms, keyed by hash
(type Toks (Toks (IntMap Bool) (List Name)))
(fn tok_names ((t Toks)) (List Name)
  (match t
    ((Toks _ ns) ns)))
(fn tok_add ((t Toks) (x Symbol)) Toks
  (match (name_of_sym x)
    (none t)
    ((some n)
     (match t
       ((Toks seen ns)
        (let ((k (name_key n))) (if (im_has seen k) t (Toks (im_insert seen k true) (cons n ns)))))))))
(fn form_tokens ((forms (List SExpr)) (t Toks)) Toks
  (measure (struct forms))
  (match forms
    (nil t)
    ((cons s r) (form_tokens r (sexpr_tokens s t)))))
(fn sexpr_tokens ((s SExpr) (t Toks)) Toks
  (measure (SExpr.size s))
  (match s
    ((SSym x) (tok_add t x))
    ((SSymU x us) (tok_add (sexprs_tokens us t) x))
    ((SList items) (sexprs_tokens items t))
    (_ t)))
(fn sexprs_tokens ((ss (List SExpr)) (t Toks)) Toks
  (measure (List_SExpr.size ss))
  (match ss
    (nil t)
    ((cons s r) (sexprs_tokens r (sexpr_tokens s t)))))
(fulfills sexpr_tokens.dec_1 (by (intro s t x us h) (rw h) (rw SExpr.size.eq_3) (arith)))
(fulfills sexpr_tokens.dec_2 (by (intro s t items h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills sexprs_tokens.dec_1 (by (intro ss t s r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills sexprs_tokens.dec_2 (by (intro ss t s r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
;; the tokens of a sidecar's blocks: a block cites lemmas the source does not spell
(fn autos_tokens ((xs (List Auto)) (t Toks)) Toks
  (measure (struct xs))
  (match xs
    (nil t)
    ((cons (Auto _ _ steps) r) (autos_tokens r (sexprs_tokens steps t)))))

;; ---- directory modules ------------------------------------------------------------------
;; (import "DIR"): the view — DIR/mod.req/mod.req.shard, else DIR/mod.req.shard
(fn load_dir ((l Load) (dir (List (List Int))) (fuel Int) (w World)) (Prod Load World)
  (match (load_dir_view l dir fuel w)
    ((Prod.mk (Prod.mk l1 _) w1) (Prod.mk l1 w1))))
(fn load_dir_view ((l Load) (dir (List (List Int))) (fuel Int) (w World))
  (Prod (Prod Load (Option ForkPt)) World)
  (match (dir_module dir)
    ((MPOk mp) (load_view_candidates l dir mp (view_candidates dir) fuel w))
    ((MPBad m)
     (Prod.mk (Prod.mk (ld_rec l (RLoadErr (join_path dir) (sym "bad_module_name") m)) none) w))
    (_
      (Prod.mk
        (Prod.mk (ld_rec l (RLoadErr (join_path dir) (sym "bad_module_name") (utf8 ""))) none)
        w))))
(fn load_view_candidates
  ((l Load) (dir (List (List Int))) (mp Name) (cands (List (List (List Int)))) (fuel Int) (w World))
  (Prod (Prod Load (Option ForkPt)) World)
  (measure (struct cands))
  (match cands
    (nil
      (Prod.mk
        (Prod.mk
          (ld_rec l
            (RLoadErr (join_path dir) (sym "missing_interface")
              (utf8 "no mod.req.shard (nor mod.req/mod.req.shard)")))
          none)
        w))
    ((cons c r)
     (match (read_file (join_path (append (Load.root l) c)) w)
       ((Prod.mk none w1) (load_view_candidates l dir mp r fuel w1))
       ((Prod.mk (some _) w1) (load_file_module l c mp true fuel w1))))))

;; the loader given DIR itself: the view, then the implementation checked
;; against it in a fork from the view's fork point
(fn load_dir_checked ((l Load) (dir (List (List Int))) (fuel Int) (w World)) (Prod Load World)
  (match (load_dir_view l dir fuel w)
    ((Prod.mk (Prod.mk l1 fp) w1)
     (check_impl l1 dir
       (match fp
         ((some x) (some x))
         (none (stored_fork l1 dir)))
       w1))))
;; the fork point of a view a consumer loaded earlier
(fn stored_fork ((l Load) (dir (List (List Int)))) (Option ForkPt)
  (match (dir_module dir)
    ((MPOk mp)
     (match (ld_find_mod (Load.mods l) mp)
       ((some m) (Module.fork m))
       (none none)))
    (_ none)))
(fn check_impl ((l1 Load) (dir (List (List Int))) (fp (Option ForkPt)) (w1 World)) (Prod Load World)
  (match fp
    (none (Prod.mk l1 w1))
    ((some (ForkPt lf f rest))
     (match (impl_file dir)
       (none (Prod.mk (ld_rec l1 (RLoadErr (join_path dir) (sym "bad_module_name") (utf8 ""))) w1))
       ((some ifile)
        (match (read_file (join_path (append (Load.root l1) ifile)) w1)
          ((Prod.mk none w2)
           (Prod.mk
             (ld_rec l1
               (RLoadErr (join_path ifile) (sym "missing_implementation")
                 (join_path (append (Load.root l1) ifile))))
             w2))
          ((Prod.mk (some src) w2)
           (match (read_all src)
             ((RAErr e off)
              (Prod.mk
                (ld_rec l1 (RReadErr (join_path ifile) e (append (utf8 "at byte ") (show_nat off))))
                w2))
             ((RAOk iforms0)
              (match (expand_records iforms0)
                ((RxErr e m) (Prod.mk (ld_rec l1 (RReadErr (join_path ifile) e m)) w2))
                ((RxOk iforms)
                 (match (read_sidecar (ld_with_recs_raw lf nil) ifile iforms w2)
                   ((Prod.mk (Prod.mk lfs autos) w2s)
                    (match (ld_recs_head lfs)
                      ((some (RLoadErr _ _ _)) (Prod.mk (merge_impl_recs l1 (ld_recs lfs)) w2s))  ; the implementation's sidecar does not read: its load error, and the check ends
                      (_
                        (match (pre_register_file lfs (fx_as_impl f ifile autos) iforms)
                          ((Prod.mk none lf0) (Prod.mk (merge_impl_recs l1 (ld_recs lf0)) w2s))
                          ((Prod.mk (some f0) lf0)
                           (match (impl_demand lf0 f0 iforms w2s)
                             ((Prod.mk (Prod.mk lf1 false) w2d)
                              (Prod.mk (merge_impl_recs l1 (ld_recs lf1)) w2d))
                             ((Prod.mk (Prod.mk lf1 true) w2d)
                              (match
                                (impl_replay lf1
                                  (make Im (view rest) (impl iforms) (done nil) (fx f0) (file ifile)
                                    (vparts (Fx.parts f))
                                    (all rest))
                                  (import_depth)
                                  w2d)
                                ((Prod.mk (Prod.mk lf2 im) w3)
                                 (Prod.mk
                                   (ld_keep_fork
                                     (ld_with_e (merge_impl_recs l1 (ld_recs lf2))
                                       (es_merge (Load.etab l1) (Load.etab lf2)))
                                     lf2)
                                   w3))))))))))))))))))))))
;; the implementation's own demand of Init, fetched into the fork before its first form: the
;; fork starts from what was fetched for the view's forms, and the implementation cites
;; names its view does not; then its realize heads, as a file's after its own demand
(fn impl_demand ((l Load) (f Fx) (iforms (List SExpr)) (w World)) (Prod (Prod Load Bool) World)
  (match (init_demand l f iforms w)
    ((Prod.mk (Prod.mk l1 true) w1)
     (match (pre_register_late l1 f iforms)
       ((Prod.mk none l2) (Prod.mk (Prod.mk l2 false) w1))
       ((Prod.mk (some _) l2) (Prod.mk (Prod.mk l2 true) w1))))
    (r r)))
;; the fork's records under IMPL; DISCHARGE and IMPL-ERROR as themselves
(fn merge_impl_recs ((l Load) (rs (List Rec))) Load
  (measure (struct rs))
  (match rs
    (nil l)
    ((cons (RDischarge n k) r) (merge_impl_recs (ld_rec l (RDischarge n k)) r))
    ((cons (RImplErr n e m) r) (merge_impl_recs (ld_rec l (RImplErr n e m)) r))
    ((cons x r) (merge_impl_recs (ld_rec l (RImplRec x)) r))))

;; the implementation check's state: the view's forms still to replay, the
;; implementation's forms not yet consumed (file order), the parameters
;; discharged so far, the fork's file context, the implementation file, the view's
(record Im (view (List SExpr)) (impl (List SExpr)) (done (List (Prod Symbol Name))) (fx Fx)
  (file (List (List Int)))
  (vparts (List (List Int)))
  (all (List SExpr)))
(fn im_file ((i Im)) (List Int) (join_path (Im.file i)))
;; the fork's file context for a form of the implementation file, and for a form of the view
;; replayed: a record names the file its form stands in, and an import resolves from there
(fn im_fx_impl ((i Im)) Fx (with Fx (Im.fx i) (parts (Im.file i))))
(fn im_fx_view ((i Im)) Fx (with Fx (Im.fx i) (parts (Im.vparts i))))
(fn im_with_fx ((i Im) (f Fx)) Im (with Im i (fx f)))
(fn im_with_impl ((i Im) (p (List SExpr))) Im (with Im i (impl p)))
(fn im_with_view ((i Im) (v (List SExpr))) Im (with Im i (view v)))
(fn im_mark ((i Im) (k Symbol) (n Name)) Im (with Im i (done (cons (Prod.mk k n) (Im.done i)))))
(fn im_marked ((i Im) (k Symbol) (n Name)) Bool (marked (Im.done i) k n))
(fn marked ((d (List (Prod Symbol Name))) (k Symbol) (n Name)) Bool
  (measure (struct d))
  (match d
    (nil false)
    ((cons (Prod.mk k2 nn) r) (if (bool_and (sym_eq k k2) (name_eq n nn)) true (marked r k n)))))

;; the view's forms in order, then the implementation's rest
(fn impl_replay ((l Load) (im Im) (fuel Int) (w World)) (Prod (Prod Load Im) World)
  (measure fuel)
  (if (< fuel 0)
    (Prod.mk (Prod.mk (ld_rec l (RLoadErr (im_file im) (sym "import_depth") (utf8 ""))) im) w)
    (match (Im.view im)
      (nil (impl_rest l im fuel w))
      ((cons s r)
       (let ((im1 (im_with_view im r)))
         (match (form_of s)
           (FDecl
             (match (replay_decl_fetching (ld_settled l) im1 s fuel (refetches) w)
               ((Prod.mk (Prod.mk l2 im2) w2) (impl_replay l2 im2 (- fuel 1) w2))))
           (_
             (match (load_forms l (im_fx_view im1) (list s) fuel w)
               ((Prod.mk (Prod.mk l2 (some f2)) w2)
                (impl_replay l2 (im_with_fx im1 f2) (- fuel 1) w2))
               ((Prod.mk (Prod.mk l2 none) w2) (Prod.mk (Prod.mk l2 im1) w2))))))))))
;; a view form replayed, or an implementation form read, and read again with what it asked
;; of Init fetched into the fork (settle_missed)
(fn replay_decl_fetching ((l Load) (im Im) (s SExpr) (fuel Int) (rf Int) (w World))
  (Prod (Prod Load Im) World)
  (measure rf)
  (match (replay_decl l im s fuel w)
    ((Prod.mk (Prod.mk l1 im1) w1)
     (match (settle_missed l l1 (im_fx_view im) rf w1)
       ((Prod.mk (Prod.mk l2 true) w2) (replay_decl_fetching l2 im s fuel (- rf 1) w2))
       ((Prod.mk (Prod.mk l2 false) w2) (Prod.mk (Prod.mk l2 im1) w2))))))
(fn impl_form_fetching ((l Load) (im Im) (s SExpr) (fuel Int) (rf Int) (w World))
  (Prod (Prod Load Im) World)
  (measure rf)
  (match (impl_form l im s fuel w)
    ((Prod.mk (Prod.mk l1 im1) w1)
     (match (settle_missed l l1 (im_fx_impl im) rf w1)
       ((Prod.mk (Prod.mk l2 true) w2) (impl_form_fetching l2 im s fuel (- rf 1) w2))
       ((Prod.mk (Prod.mk l2 false) w2) (Prod.mk (Prod.mk l2 im1) w2))))))
;; one view form in the fork: a parameter is discharged by the implementation's form
(fn replay_decl ((l Load) (im Im) (s SExpr) (fuel Int) (w World)) (Prod (Prod Load Im) World)
  (let ((sc (fx_scope l (Im.fx im))) (h (form_head s)))
    (if (sym_eq h (sym "theorem")) (Prod.mk (Prod.mk l im) w)  ; checked once, against the parameters; bound by its closure
    (if (sym_eq h (sym "sig"))
      (match (sig_kind_name sc s)
        (none
          (Prod.mk
            (Prod.mk
              (ld_rec l
                (RReadErr (im_file im) (sym "bad_shape")
                  (utf8 "(sig fn NAME …) or (sig type NAME)")))
              im)
            w))
        ((some (Prod.mk k n)) (discharge l im k n s fuel w)))
    (if (sym_eq h (sym "requirement"))
      (match (form_name sc s)
        (Anon
          (Prod.mk
            (Prod.mk
              (ld_rec l (RReadErr (im_file im) (sym "bad_shape") (utf8 "(requirement NAME …)")))
              im)
            w))
        (n (discharge l im (sym "requirement") n s fuel w)))
      (match (load_decl l (im_fx_view im) s)
        ((Prod.mk l2 f2) (Prod.mk (Prod.mk l2 (im_with_fx im f2)) w))))))))
;; (sig type (NAME …)) / (sig type NAME) / (sig fn NAME …): its kind and qualified name
(fn sig_kind_name ((sc Scope) (s SExpr)) (Option (Prod Symbol Name))
  (match s
    ((SList (cons _ (cons (SSym k) (cons hd _))))
     (if (sym_eq k (sym "type"))
       (match (type_head sc hd)
         ((Prod.mk (some (Prod.mk n _)) _) (some (Prod.mk (sym "type") n)))
         (_ none))
     (if (sym_eq k (sym "fn"))
       (match hd
         ((SSym x)
          (match (name_of_sym x)
            ((some n) (some (Prod.mk (sym "fn") (qualify sc n))))
            (none none)))
         (_ none))
       none)))
    (_ none)))
;; a parameter's discharge: the implementation's form for it — consumed
;; already (checked when consumed), or reached now by consuming the
;; implementation's forms in file order up to it — else missing
(fn discharge ((l Load) (im Im) (k Symbol) (n Name) (s SExpr) (fuel Int) (w World))
  (Prod (Prod Load Im) World)
  (if (im_marked im k n) (Prod.mk (Prod.mk l im) w)
  (match (match_private l im k n s)
    ((Prod.mk l0 im0)
     (if (im_marked im0 k n) (Prod.mk (Prod.mk l0 im0) w)
     (match (advance l0 im0 k n s fuel w)
       ((Prod.mk (Prod.mk l1 im1) w1)
        (if (im_marked im1 k n) (Prod.mk (Prod.mk l1 im1) w1)
        (Prod.mk (Prod.mk (ld_rec l1 (RImplErr n (missing_reason k) (im_file im1))) im1) w1)))))))))
;; a parameter implemented by a private file of the sealed directory (its form recorded at load,
;; ld_add_form): the same checks as for the implementation file's own form
(fn match_private ((l Load) (im Im) (k Symbol) (n Name) (sig SExpr)) (Prod Load Im)
  (if (bool_not (bool_or (sym_eq k (sym "type")) (sym_eq k (sym "fn")))) (Prod.mk l im)
  (match (form_for l n)
    (none (Prod.mk l im))
    ((some (Prod.mk _ _))
     (if (sym_eq k (sym "type")) (Prod.mk (check_arity l n sig) (im_mark im (sym "type") n))
     (check_signature l im sig n))))))
(fn missing_reason ((k Symbol)) Symbol
  (if (sym_eq k (sym "type")) (sym "impl_missing_type")
  (if (sym_eq k (sym "fn")) (sym "impl_missing_fn")
  (sym "impl_missing_fulfills"))))
;; consume the implementation's forms in order through the one that
;; implements (k, n); every form consumed is processed as the implementation's
(fn advance ((l Load) (im Im) (k Symbol) (n Name) (sig SExpr) (fuel Int) (w World))
  (Prod (Prod Load Im) World)
  (measure fuel)
  (if (< fuel 0) (Prod.mk (Prod.mk l im) w)
  (match (Im.impl im)
    (nil (Prod.mk (Prod.mk l im) w))
    ((cons s r)
     (match (impl_form_fetching (ld_with_later l r) (im_with_impl im r) s fuel (refetches) w)
       ((Prod.mk (Prod.mk l1 im1) w1)
        (if (im_marked im1 k n) (Prod.mk (Prod.mk l1 im1) w1)
        (match (ld_recs_head l1)
          ((some (RReadErr _ _ _)) (Prod.mk (Prod.mk l1 im1) w1))
          ((some (RLoadErr _ _ _)) (Prod.mk (Prod.mk l1 im1) w1))
          (_
            (match (match_private l1 im1 k n sig)  ; a directive may have loaded the private file that declares it
              ((Prod.mk l2 im2)
               (if (im_marked im2 k n) (Prod.mk (Prod.mk l2 im2) w1)
               (advance l2 im2 k n sig (- fuel 1) w1)))))))))))))
;; the implementation's remaining forms after the view's
(fn impl_rest ((l Load) (im Im) (fuel Int) (w World)) (Prod (Prod Load Im) World)
  (measure fuel)
  (if (< fuel 0) (Prod.mk (Prod.mk l im) w)
  (match (Im.impl im)
    (nil (Prod.mk (Prod.mk l im) w))
    ((cons s r)
     (match
       (impl_form_fetching (ld_settled (ld_with_later l r)) (im_with_impl im r) s fuel (refetches) w)
       ((Prod.mk (Prod.mk l1 im1) w1)
        (match (ld_recs_head l1)
          ((some (RReadErr _ _ _)) (Prod.mk (Prod.mk l1 im1) w1))
          ((some (RLoadErr _ _ _)) (Prod.mk (Prod.mk l1 im1) w1))
          (_ (impl_rest l1 im1 (- fuel 1) w1)))))))))
;; one implementation form: a directive as any; (type NAME …) implementing a
;; sig type — its parameter count checked; (fn NAME …) implementing a sig fn
;; — the E signatures compared, the parameter then admitted; (fulfills NAME
;; PROOF) — the requirement's statement re-read here, the proof checked or
;; pending; anything else the implementation's own
(fn impl_form ((la Load) (im Im) (s SExpr) (fuel Int) (w World)) (Prod (Prod Load Im) World)
  (let
    ((sc (fx_scope la (im_fx_impl im)))
     (h (form_head s))
     ;; as in a plain file, no reading of a parked fn is kept across a form other than a fn
     (l (if (sym_eq (form_head s) (sym "fn")) la (ld_forget_all la))))
    (match (form_of s)
      (FDecl
        (if (sym_eq h (sym "type"))
          (match (load_decl l (im_fx_impl im) s)
            ((Prod.mk l1 f1)
             (let ((n (form_name sc s)))
               (match (find_sig (Im.all im) sc (sym "type") n)
                 (none (Prod.mk (Prod.mk l1 (im_with_fx im f1)) w))
                 ((some sig)
                  (match (ld_recs_head l1)
                    ((some (RReadErr _ _ _)) (Prod.mk (Prod.mk l1 (im_with_fx im f1)) w))
                    ((some (RLoadErr _ _ _)) (Prod.mk (Prod.mk l1 (im_with_fx im f1)) w))
                    (_
                      (Prod.mk
                        (Prod.mk (check_arity l1 n sig) (im_mark (im_with_fx im f1) (sym "type") n))
                        w))))))))
        (if (sym_eq h (sym "fn"))
          (let ((n (form_name sc s)))
            (match (load_e_form l (im_fx_impl im) s)
              ((Prod.mk l0 f0)
               (match (find_sig (Im.all im) sc (sym "fn") n)
                 (none (Prod.mk (Prod.mk l0 (im_with_fx im f0)) w))
                 ((some sig)
                  (match (check_signature l0 (im_with_fx im f0) sig n)
                    ((Prod.mk l1 im1) (Prod.mk (Prod.mk (ld_forget l1 n) im1) w))))))))  ; the view's parameter of this name is met: the forms that name it read anew
        (if (sym_eq h (sym "fulfills"))
          (match s
            ((SList (cons _ (cons (SSym x) (cons proof nil))))
             (match (name_of_sym x)
               (none
                 (Prod.mk
                   (Prod.mk (ld_rec l (RReadErr (im_file im) (sym "bad_name") (chars_of_sym x))) im)
                   w))
               ((some short)
                (let ((n (qualify sc short)))
                  (match (find_sig (Im.all im) sc (sym "requirement") n)
                    (none  ; no requirement: an obligation of a measured fn of the implementation discharges as in a plain file
                      (match (obligation_named l sc s)
                        ((some (Prod.mk k proof))
                         (let ((l1 (load_discharge l (im_fx_impl im) k proof)))
                           (Prod.mk (Prod.mk l1 im) w)))
                        (none
                          (Prod.mk
                            (Prod.mk
                              (ld_rec l
                                (RImplErr n (sym "fulfills_unknown")
                                  (utf8
                                    "no such requirement in the view, and no obligation of a measured fn of the implementation")))
                              im)
                            w))))
                    ((some (SList (cons _ rargs)))
                     (match (fulfil l im n rargs proof)
                       ((Prod.mk l1 im1) (Prod.mk (Prod.mk l1 im1) w))))
                    (_ (Prod.mk (Prod.mk l im) w)))))))
            (_
              (Prod.mk
                (Prod.mk
                  (ld_rec l (RReadErr (im_file im) (sym "bad_shape") (utf8 "(fulfills NAME PROOF)")))
                  im)
                w)))
          (match (load_decl l (im_fx_impl im) s)
            ((Prod.mk l1 f1) (Prod.mk (Prod.mk l1 (im_with_fx im f1)) w)))))))
      (_
        (match (load_forms l (im_fx_impl im) (list s) fuel w)
          ((Prod.mk (Prod.mk l1 (some f1)) w1) (Prod.mk (Prod.mk l1 (im_with_fx im f1)) w1))
          ((Prod.mk (Prod.mk l1 none) w1) (Prod.mk (Prod.mk l1 im) w1)))))))
;; the view's (sig K NAME …) / (requirement NAME …) form for (k, n)
(fn find_sig ((forms (List SExpr)) (sc Scope) (k Symbol) (n Name)) (Option SExpr)
  (measure (struct forms))
  (match forms
    (nil none)
    ((cons s r)
     (let ((h (form_head s)))
       (if (bool_and (sym_eq h (sym "sig")) (bool_not (sym_eq k (sym "requirement"))))
         (match (sig_kind_name sc s)
           ((some (Prod.mk k2 nn))
            (if (bool_and (sym_eq k k2) (name_eq n nn)) (some s) (find_sig r sc k n)))
           (none (find_sig r sc k n)))
       (if (bool_and (sym_eq h (sym "requirement")) (sym_eq k (sym "requirement")))
         (if (name_eq (form_name sc s) n) (some s) (find_sig r sc k n))
         (find_sig r sc k n)))))))
;; (sig type (NAME T…)) against the implementation's (type (NAME T…) …): the parameter count
;; — of the admitted inductive, or of the E-only type where the fields cite a built-in with no
;; L constant in scope: such a type is an E parameter, as the sealed types of K are
(fn check_arity ((l Load) (n Name) (sig SExpr)) Load
  (match sig
    ((SList (cons _ (cons _ (cons hd _))))
     (let
       ((want Int
          (match hd
            ((SList (cons _ ps)) (len ps))
            (_ 0))))
       (match (impl_type_arity (Load.env l) (Load.etab l) n)
         ((some np)
          (if (= np want) (ld_rec l (RDischarge n (sym "type")))
          (ld_rec l
            (RImplErr n (sym "impl_type_arity")
              (append (utf8 "the view's ")
                (append (show_nat want) (append (utf8 ", the implementation's ") (show_nat np))))))))
         (none l))))
    (_ l)))
(fn impl_type_arity ((env CheckedEnv) (es ESt) (n Name)) (Option Int)
  (match (env_find env n)
    ((some (InductInfo _ _ np _ _ _ _ _ _)) (some np))
    (_
      (match (es_info es n)
        ((some (EIInd np _)) (some np))
        (_ none)))))
;; (sig fn NAME BINDERS RET) against the implementation's fn: the E signatures — the sig's,
;; classified here in the fork where the sealed types are concrete, and the fn's E declaration
;; (the implementation file's, just loaded; a private file's, loaded by an import) — then the
;; parameter admitted to K where K can read the signature, an E parameter only where it cannot
(fn check_signature ((l Load) (im Im) (sig SExpr) (n Name)) (Prod Load Im)
  (let ((sc (fx_scope l (im_fx_impl im))))
    (match (classify_form (Load.etab l) sc (Load.env l) sig)
      ((CErr e m) (Prod.mk (ld_rec l (RReadErr (im_file im) e m)) im))
      ((COk (ESig _ snt sps srt))
       (match (es_find_decl (Load.etab l) n)
         ((some (EFn _ fnt fps frt _ _))
          (if (bool_and (= snt fnt) (bool_and (etypes_eq sps fps) (etype_eq srt frt)))
            (match (read_decl sc (Load.env l) sig)
              ((RDParam d k a)
               (match (env_find (Load.env l) n)
                 ((some _)
                  (Prod.mk (ld_rec l (RDischarge n (sym "defined"))) (im_mark im (sym "fn") n)))  ; the implementation's definition stands in the parameter's place
                 (none
                   (match (admit_param l (im_fx_view im) d k a)
                     ((Prod.mk l1 f1)
                      (Prod.mk (ld_rec l1 (RDischarge n (sym "fn")))
                        (im_mark (im_with_fx im f1) (sym "fn") n)))))))
              (_ (Prod.mk (ld_rec l (RDischarge n (sym "fn"))) (im_mark im (sym "fn") n))))
            (Prod.mk
              (ld_rec l
                (RImplErr n (sym "impl_signature")
                  (utf8 "the implementation's E signature differs from the view's")))
              (im_mark im (sym "fn") n))))
         (_
           (Prod.mk
             (ld_rec l
               (RImplErr n (sym "impl_signature")
                 (utf8 "the implementation declares no fn of that name")))
             (im_mark im (sym "fn") n)))))
      ((COk _) (Prod.mk l im))
      ((COkT _ _ _) (Prod.mk l im)))))
;; (fulfills NAME PROOF): the requirement's statement here, the proof a theorem or pending
(fn fulfil ((l Load) (im Im) (n Name) (rargs (List SExpr)) (proof SExpr)) (Prod Load Im)
  (let ((sc (fx_scope l (im_fx_impl im))))
    (match
      (rd_plain l sc (im_file im) Anon
        (read_fulfills sc (Load.env l) rargs proof (producers_of l (im_fx_impl im)) (Load.mode l)))
      ((Prod.mk l rd)
       (match rd
         ((RDErr e m) (Prod.mk (ld_rec l (read_refusal (im_fx_impl im) e m)) im))
         ((RDPending nn r)
          (Prod.mk
            (ld_rec (ld_rec (ld_add_pending l nn) (RPending nn r)) (RDischarge n (sym "pending")))
            (im_mark im (sym "requirement") n)))
         ((RDOk ds)
          (match (admit_under l (im_fx_impl im) ds)
            ((AdRefused subj reason)
             (Prod.mk (ld_rec l (refusal_rec l ds subj reason)) (im_mark im (sym "requirement") n)))
            ((AdOk env1)
             (match (policy_pass l (im_fx_impl im) env1 (Load.memo l) ds nil)
               ((PolBound _)
                (Prod.mk (ld_rec l (RLoadErr (im_file im) (sym "closure_bound") (show_name n))) im))
               ((PolOut nn out)
                (Prod.mk (ld_rec (ld_with_env l (Load.env l) (memos_empty)) (RPolicy nn out))
                  (im_mark im (sym "requirement") n)))
               ((PolOk memo1 recs)
                (Prod.mk
                  (ld_rec
                    (recs_add
                      (ld_with_tbl (ld_with_env l env1 memo1)
                        (tbl_add_all (Load.tbl l) (decls_declare env1 ds)
                          (Fx.module (im_fx_impl im))))
                      recs)
                    (RDischarge n (sym "proved")))
                  (im_mark (im_with_fx im (mix_recs (im_fx_impl im) recs)) (sym "requirement") n)))))))
         (_ (Prod.mk l im)))))))

;; the forms in order; None when the file's loading ended in an error
(fn load_forms ((l Load) (f Fx) (forms (List SExpr)) (fuel Int) (w World))
  (Prod (Prod Load (Option Fx)) World)
  (measure fuel)
  (match forms
    (nil
      (match (flush_fetching (ld_settled (ld_forget_all l)) f (refetches) w)  ; the fns parked on a forward reference that never came
        ((Prod.mk l1 w1) (Prod.mk (Prod.mk l1 (some f)) w1))))
    ((cons s r)
     (match (form_of s)
       ((FBad e m) (Prod.mk (Prod.mk (ld_rec l (RLoadErr (fx_file f) e m)) none) w))
       ;; a `use`, a `trusts` and an import change the scope the fns after them are read in:
       ;; no reading is kept across one (ld_forget_all)
       ((FUse p ms) (load_forms (ld_forget_all l) (fx_open f (open_of p ms)) r fuel w))
       ((FTrusts ns) (load_forms (ld_forget_all l) (fx_trust f ns) r fuel w))
       ((FImportFile p)
        (match (import_file (ld_forget_all l) f p (- fuel 1) w)
          ((Prod.mk (Prod.mk l1 (some f1)) w1) (load_forms (ld_forget_all l1) f1 r fuel w1))
          ((Prod.mk (Prod.mk l1 none) w1) (Prod.mk (Prod.mk l1 none) w1))))
       (FDecl
         (match (load_decl_fetching (ld_settled (ld_with_later l r)) f s (refetches) w)
           ((Prod.mk (Prod.mk l1 f1) w1)
            (match (ld_recs_head l1)
              ((some (RReadErr _ _ _)) (Prod.mk (Prod.mk l1 none) w1))
              ((some (RLoadErr _ _ _)) (Prod.mk (Prod.mk l1 none) w1))
              (_ (load_forms l1 f1 r fuel w1))))))))))
;; the readings of one declaration: the first, and one more for each round of names it asked
;; of Init that were fetched for it (settle_missed) — a round fetches every name the reading's
;; refusals name, so a declaration settles in two or three
(fn refetches () Int 8)
(fn load_decl_fetching ((l Load) (f Fx) (s SExpr) (fuel Int) (w World)) (Prod (Prod Load Fx) World)
  (measure fuel)
  (match (load_decl l f s)
    ((Prod.mk l1 f1)
     (match (settle_missed l l1 f fuel w)
       ((Prod.mk (Prod.mk l2 true) w1) (load_decl_fetching l2 f s (- fuel 1) w1))
       ((Prod.mk (Prod.mk l2 false) w1) (Prod.mk (Prod.mk l2 f1) w1))))))
;; the same for what a file's end settles (flush_parked reads the parked fns again)
(fn flush_fetching ((l Load) (f Fx) (fuel Int) (w World)) (Prod Load World)
  (measure fuel)
  (match (settle_missed l (flush_parked l f) f fuel w)
    ((Prod.mk (Prod.mk l2 true) w1) (flush_fetching l2 f (- fuel 1) w1))
    ((Prod.mk (Prod.mk l2 false) w1) (Prod.mk l2 w1))))
(fn ld_recs_head ((l Load)) (Option Rec)
  (match (Load.recs l)
    (nil none)
    ((cons x _) (some x))))

;; (import "PATH"): relative to the importing file's directory, under the root
(fn import_file ((l Load) (f Fx) (p (List Int)) (fuel Int) (w World))
  (Prod (Prod Load (Option Fx)) World)
  (match (starts_with_lit (utf8 "/") p)
    ((some _)
     (Prod.mk (Prod.mk (ld_rec l (RLoadErr (fx_file f) (sym "absolute_import") p)) none) w))
    (none
      (match (norm_parts (append (dir_of (Fx.parts f)) (split_path p nil nil)) nil)
        (none
          (Prod.mk (Prod.mk (ld_rec l (RLoadErr (fx_file f) (sym "import_outside_root") p)) none) w))
        ((some rel)
         (match (sealed_above l (dir_of (Fx.parts f)) (seal_target rel) w)
           ((Prod.mk (some d) w1)
            (Prod.mk
              (Prod.mk
                (ld_rec l
                  (RLoadErr (fx_file f) (sym "private_module")
                    (append (join_path rel)
                      (append (utf8 " is inside the sealed directory ")
                        (append (join_path d) (utf8 " — import the directory"))))))
                none)
              w1))
           ((Prod.mk none w1)
            (match (module_of rel)
              ((MPOk _)
               (if (bool_and (Fx.view f) (parts_under (dir_of rel) (view_dir (Fx.parts f))))
                 (Prod.mk
                   (Prod.mk
                     (ld_rec l
                       (RLoadErr (fx_file f) (sym "req_scope")
                         (append (join_path rel)
                           (utf8
                             ": a view imports directory modules, Init and plain files outside its own directory, never its implementation's"))))
                     none)
                   w1)
                 (import_loaded l f rel fuel w1)))
              (_ (import_loaded l f rel fuel w1))))))))))
;; The sealed-directory rule: what lies inside a directory that has a view —
;; DIR/mod.req.shard or DIR/mod.req/mod.req.shard — is private to that directory: a file, and
;; a directory module nested in it with its own view. Each is importable from a file under DIR
;; and refused as `private_module` from anywhere else; the directory module `(import "DIR")`
;; is the way in. The directories above the target are tried from the root down; the
;; importer's own directory and its ancestors are never sealed against it.
;; what an import path names for the rule: a file, a directory module, or — for a view file
;; named directly — the directory the view belongs to
(fn seal_target ((rel (List (List Int)))) (List (List Int))
  (match (module_of rel)
    ((MPView _) (view_dir rel))
    (_ rel)))
;; the directory a view belongs to: its own, or the one above `mod.req/` for the dir form
(fn view_dir ((parts (List (List Int)))) (List (List Int))
  (let ((d (dir_of parts)))
    (match (rev d)
      ((cons last above) (if (int_list_eq last (utf8 "mod.req")) (rev above) d))
      (nil d))))
(fn sealed_above ((l Load) (importer (List (List Int))) (target (List (List Int))) (w World))
  (Prod (Option (List (List Int))) World)
  (sealed_go l importer nil target w))
(fn sealed_go
  ((l Load) (importer (List (List Int))) (acc (List (List Int))) (rest (List (List Int))) (w World))
  (Prod (Option (List (List Int))) World)
  (measure (struct rest))
  (match rest
    (nil (Prod.mk none w))
    ((cons _ nil) (Prod.mk none w))
    ((cons p r)
     (let ((d (append acc (list p))))
       (if (parts_under importer d) (sealed_go l importer d r w)
       (match (has_view l d w)
         ((Prod.mk true w1) (Prod.mk (some d) w1))
         ((Prod.mk false w1) (sealed_go l importer d r w1))))))))
;; `a` is `d` or below it
(fn parts_under ((a (List (List Int))) (d (List (List Int)))) Bool
  (measure (struct d))
  (match d
    (nil true)
    ((cons x r)
     (match a
       ((cons y s) (if (int_list_eq x y) (parts_under s r) false))
       (nil false)))))
(fn has_view ((l Load) (d (List (List Int))) (w World)) (Prod Bool World)
  (view_any l (view_candidates d) w))
(fn view_any ((l Load) (cands (List (List (List Int)))) (w World)) (Prod Bool World)
  (measure (struct cands))
  (match cands
    (nil (Prod.mk false w))
    ((cons c r)
     (match (read_file (join_path (append (Load.root l) c)) w)
       ((Prod.mk (some _) w1) (Prod.mk true w1))
       ((Prod.mk none w1) (view_any l r w1))))))
(fn import_loaded ((l Load) (f Fx) (rel (List (List Int))) (fuel Int) (w World))
  (Prod (Prod Load (Option Fx)) World)
  (match (load_module l rel fuel w)
    ((Prod.mk l1 w1)
     (match (import_target rel)
       ((some mp)
        (match (ld_find_mod (Load.mods l1) mp)
          ((some m)
           (if (Module.ok m) (Prod.mk (Prod.mk l1 (some (fx_see f (Module.closure m)))) w1)
           (Prod.mk
             (Prod.mk (ld_rec l1 (RLoadErr (fx_file f) (sym "import_failed") (join_path rel))) none)
             w1)))
          (none
            (Prod.mk
              (Prod.mk (ld_rec l1 (RLoadErr (fx_file f) (sym "import_failed") (join_path rel))) none)
              w1))))
       (none
         (Prod.mk
           (Prod.mk (ld_rec l1 (RLoadErr (fx_file f) (sym "import_failed") (join_path rel))) none)
           w1))))))
;; the module an import path names: a file's path, a view's directory, a directory's
(fn import_target ((rel (List (List Int)))) (Option Name)
  (match (module_of rel)
    ((MPOk mp) (some mp))
    ((MPView mp) (some mp))
    (MPDir
      (match (dir_module rel)
        ((MPOk mp) (some mp))
        (_ none)))
    (_ none)))

;; ---- printing (the driver; the pins) --------------------------------------------------------
(fn show_names_c ((ns (List Name))) (List Int)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n nil) (show_name n))
    ((cons n r) (append (show_name n) (cons 44 (show_names_c r))))))
(fn show_rec ((x Rec)) (List Int)
  (measure (struct x))
  (match x
    ((RModule m file h cl)
     (append (utf8 "MODULE ")
       (append (show_name m)
         (append (utf8 " file=")
           (append file
             (append (utf8 " hash=")
               (append (show_nat h) (append (utf8 " sees=") (show_names_c cl)))))))))
    ((RUnused m ps)
     (append (utf8 "UNUSED ") (append (show_name m) (append (utf8 " use=") (show_names_c ps)))))
    ((RAccept n m h axs ps q)
     (append (utf8 "ACCEPT ")
       (append (show_name n)
         (append (utf8 " module=")
           (append (show_name m)
             (append (utf8 " hash=")
               (append (show_nat h)
                 (append (utf8 " axioms=")
                   (append (show_names_c axs)
                     (append (utf8 " params=")
                       (append (show_names_c ps)
                         (match q
                           ((some k) (append (utf8 " req=") (req_show k)))
                           (none nil)))))))))))))
    ((RParam n k a)
     (append (utf8 "PARAM ")
       (append (show_name n)
         (append (utf8 " ")
           (append (chars_of_sym k)
             (if (sym_eq k (sym "type")) (append (utf8 " arity=") (show_nat a)) nil))))))
    ((RDischarge n k)
     (append (utf8 "DISCHARGE ") (append (show_name n) (append (utf8 " ") (chars_of_sym k)))))
    ((RImplErr n e m)
     (append (utf8 "IMPL-ERROR ")
       (append (show_name n) (append (utf8 " ") (append (chars_of_sym e) (append (utf8 ": ") m))))))
    ((RImplRec y) (append (utf8 "IMPL ") (show_rec y)))
    ((RRefuse n r)
     (append (utf8 "REFUSE ") (append (show_name n) (append (utf8 " ") (chars_of_sym r)))))
    ((RPolicy n out)
     (append (utf8 "POLICY ")
       (append (show_name n) (append (utf8 " outside the policy: ") (show_names_c out)))))
    ((RPending n r)
     (append (utf8 "PENDING ") (append (show_name n) (append (utf8 " ") (chars_of_sym r)))))
    ((RRun k n why route m)
     (append (utf8 "RUNNABLE ")
       (append (chars_of_sym k)
         (append (utf8 " ")
           (append (show_name n)
             (append
               (if (sym_eq why (sym "none")) (utf8 "") (append (utf8 " why=") (chars_of_sym why)))
               (append
                 (if (sym_eq route (sym "none")) (utf8 "")
                 (append (utf8 " route=") (chars_of_sym route)))
                 (if (= (len m) 0) (utf8 "") (append (utf8 ": ") m)))))))))
    ((RDefine n eqs roots)
     (append (utf8 "DEFINE ")
       (append (show_name n)
         (append (utf8 " equations=")
           (append (show_names_c eqs)
             (match roots
               (nil (utf8 ""))
               (_ (append (utf8 " pending=") (show_names_c roots)))))))))
    ((RClassify n e m)
     (append (utf8 "REFUSE ")
       (append (show_name n) (append (utf8 " ") (append (chars_of_sym e) (append (utf8 ": ") m))))))
    ((RRealize n k eqs roots)
     (append (utf8 "REALIZE ")
       (append (show_name n)
         (append (utf8 " ")
           (append (chars_of_sym k)
             (append (utf8 " equations=")
               (append (show_names_c eqs)
                 (match roots
                   (nil (utf8 ""))
                   (_ (append (utf8 " pending=") (show_names_c roots)))))))))))
    ((RReadErr file e m)
     (append (utf8 "READ-ERROR ")
       (append file (append (utf8 " ") (append (chars_of_sym e) (append (utf8 ": ") m))))))
    ((RLoadErr file e m)
     (append (utf8 "LOAD-ERROR ")
       (append file (append (utf8 " ") (append (chars_of_sym e) (append (utf8 ": ") m))))))
    ((RProved n _ _ k steps)
     (append (utf8 "PROVED ")
       (append (show_name n)
         (append (utf8 " req=")
           (append (req_show k) (append (utf8 " (by ") (append (show_sexprs steps) (utf8 ")"))))))))
    ((RSidecar file schema cur)
     (append (utf8 "SIDECAR ")
       (append file
         (append (utf8 " schema=")
           (append (show_nat schema) (append (utf8 " current=") (show_nat cur)))))))
    ((RRecon file v cur)
     (append (utf8 "RECON ")
       (append file
         (append (utf8 " version=")
           (append (if (< v 0) (utf8 "-") (show_nat v)) (append (utf8 " current=") (show_nat cur)))))))
    ((REngine n ok)
     (append (utf8 "ENGINE ") (append (show_name n) (if ok (utf8 " solved") (utf8 " unsolved")))))
    ((RTactic n tfn ok)
     (append (utf8 "TACTIC ")
       (append (show_name n)
         (append (utf8 " ") (append (show_name tfn) (if ok (utf8 " solved") (utf8 " unsolved")))))))
    ((RDerive p ty cap policy procs)
     (append (utf8 "DERIVE ")
       (append (show_name p)
         (append (utf8 " type=")
           (append (dv_show_ty ty)
             (append (utf8 " cap=")
               (append (chars_of_sym cap)
                 (append (utf8 " policy=")
                   (append (chars_of_sym policy) (append (utf8 " fields=") (show_names_c procs)))))))))))
    ((RTemplate n statics eqs)
     (append (utf8 "TEMPLATE ")
       (append (show_name n)
         (append (utf8 " static=")
           (append (show_names_c statics) (append (utf8 " equations=") (show_names_c eqs)))))))
    ((RThread n k m)
     (append (utf8 "THREAD ")
       (append (show_name n)
         (append (utf8 " ")
           (append (chars_of_sym k)
             (match m
               (nil (utf8 ""))
               (_ (append (utf8 ": ") m))))))))
    ((RState n k m)
     (append (utf8 "STATE ")
       (append (show_name n)
         (append (utf8 " ")
           (append (chars_of_sym k)
             (match m
               (nil (utf8 ""))
               (_ (append (utf8 ": ") m))))))))
    ((RBoth n k m)
     (append (utf8 "BOTH ")
       (append (show_name n)
         (append (utf8 " ")
           (append (chars_of_sym k)
             (match m
               (nil (utf8 ""))
               (_ (append (utf8 ": ") m))))))))
    ((RBin n f exts nt reqs met)
     (append (utf8 "BIN ")
       (append (show_name n)
         (append (utf8 " entry ")
           (append (show_name f)
             (append (utf8 " externs ")
               (append (show_nat (len exts))
                 (append (utf8 " trusts ")
                   (append (show_nat nt)
                     (append (utf8 " requires ")
                       (append (show_nat met) (append (utf8 "/") (show_nat (len reqs))))))))))))))
    ((RBinErr n k m)
     (if (sym_eq k (sym "unmet")) (append (utf8 "UNMET ") m)
     (if (sym_eq k (sym "unthreaded")) (append (utf8 "UNTHREADED ") m)
     (append (utf8 "BAD-BIN ")
       (append (show_name n) (append (utf8 " ") (append (chars_of_sym k) (append (utf8 ": ") m))))))))
    ((RInstance n c shapes eqs)
     (append (utf8 "INSTANCE ")
       (append (show_name n)
         (append (utf8 " of=")
           (append (show_name c)
             (append (utf8 " shapes=")
               (append (join_commas shapes) (append (utf8 " equations=") (show_names_c eqs)))))))))))
(fn join_commas ((ss (List (List Int)))) (List Int)
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s nil) s)
    ((cons s r) (append s (cons 44 (join_commas r))))))

;; counts: modules accepted runnable refused pending realized defined errors
(fn rec_counts ((rs (List Rec)) (acc (List Int))) (List Int)
  (measure (struct rs))
  (match rs
    (nil acc)
    ((cons x r) (rec_counts r (rec_count x acc)))))
(fn zero_counts () (List Int) (list 0 0 0 0 0 0 0 0))
(fn rec_count ((x Rec) (acc (List Int))) (List Int)
  (measure (struct x))
  (match acc
    ((cons a (cons b (cons u (cons c (cons d (cons e (cons f (cons g nil))))))))
     (match x
       ((RModule _ _ _ _) (list (+ a 1) b u c d e f g))
       ((RAccept _ _ _ _ _ _) (list a (+ b 1) u c d e f g))
       ((RParam _ _ _) (list a (+ b 1) u c d e f g))
       ((RRun _ _ _ _ _) (list a b (+ u 1) c d e f g))
       ((RClassify _ _ _) (list a b u (+ c 1) d e f g))
       ((RRefuse _ _) (list a b u (+ c 1) d e f g))
       ((RPolicy _ _) (list a b u (+ c 1) d e f g))
       ((RPending _ _) (list a b u c (+ d 1) e f g))
       ((RRealize _ _ _ _) (list a b u c d (+ e 1) f g))
       ((RDefine _ _ _) (list a b u c d e (+ f 1) g))
       ((RDischarge _ _) acc)
       ((RImplErr _ _ _) (list a b u c d e f (+ g 1)))
       ((RImplRec y) (rec_count y acc))
       ((RReadErr _ _ _) (list a b u c d e f (+ g 1)))
       ((RLoadErr _ _ _) (list a b u c d e f (+ g 1)))
       ((RUnused _ _) acc)
       ((RProved _ _ _ _ _) acc)
       ((RSidecar _ _ _) acc)
       ((RRecon _ _ _) acc)
       ((REngine _ _) acc)
       ((RTactic _ _ _) acc)
       ((RDerive _ _ _ _ _) acc)
       ((RTemplate _ _ _) (list a b u c d e (+ f 1) g))
       ((RThread _ _ _) acc)
       ((RState _ _ _) acc)
       ((RBoth _ _ _) acc)
       ((RBin _ _ _ _ _ _) acc)
       ((RBinErr _ _ _) (list a b u c d e f (+ g 1)))
       ((RInstance _ _ _ _) (list a b u c d e (+ f 1) g))))
    (_ acc)))
(fn show_counts_load ((cs (List Int))) (List Int)
  (match cs
    ((cons a (cons b (cons u (cons c (cons d (cons e (cons f (cons g nil))))))))
     (append (utf8 "modules ")
       (append (show_nat a)
         (append (utf8 "  accepted ")
           (append (show_nat b)
             (append (utf8 "  runnable ")
               (append (show_nat u)
                 (append (utf8 "  refused ")
                   (append (show_nat c)
                     (append (utf8 "  pending ")
                       (append (show_nat d)
                         (append (utf8 "  realized ")
                           (append (show_nat e)
                             (append (utf8 "  defined ")
                               (append (show_nat f) (append (utf8 "  errors ") (show_nat g)))))))))))))))))
    (_ nil)))
;; the exit code: refused (policy included) plus errors
(fn load_failures ((cs (List Int))) Int
  (match cs
    ((cons _ (cons _ (cons _ (cons c (cons _ (cons _ (cons _ (cons g nil)))))))) (+ c g))
    (_ 1)))
