;;; v3/kernel/loader.shard — the loader (v3/LANGUAGE.md §3, §3.1, §3.2, §9).
;;; Phase 2, slice 3. A package root and its files: each file is a module
;;; named by its path from the root; `import` loads a file once (a cycle is
;;; refused) and makes the imported module's closure visible, opening
;;; nothing; `(import Init NAME)` streams the pinned export through NAME
;;; into K, checking the export's meta line against the pin, the larger of
;;; two nested prefixes loaded once; `use` opens a prefix for the rest of
;;; the file; `trusts` widens the file's assumption policy; every declared
;;; form goes through the reader (reader.shard) into K's raw entry
;;; (add.shard `check`, which ingests), and an admitted declaration's
;;; axiom closure (axioms.shard) is checked against the file's policy —
;;; outside it, the declaration is reported and dropped, the environment
;;; kept as it was. What the loader records per declaration is §3.2's
;;; acceptance record at phase 2 (the driver load.shard prints it): the
;;; identity (K name and content fingerprint), the module, the axiom
;;; closure, and the environment revision (the Init prefix, the visible
;;; modules and their hashes on their MODULE lines). Nothing here is
;;; authority: K's verdicts are K's.

(import "host.shard")
(import "reader.shard")
(import "k")
(import "realize.shard")
(import "record.shard")
(use kernel.k)
(use kernel.classify)
(use kernel.decl)
(use kernel.erase)
(use kernel.etable)
(use kernel.etable.EEnt)
(use kernel.etable.EHit)
(use kernel.etable.EInfo)
(use kernel.expr)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.name)
(use kernel.prelude)
(use kernel.prog)
(use kernel.reader)
(use kernel.realize)
(use kernel.record)
(use kernel.record.RxRes)
(use kernel.sexpr)
(use kernel.util)
(use kernel.classify.CRes)
(use kernel.classify.PreRes)
(use kernel.decl.ConstantInfo)
(use kernel.decl.Declaration)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.etable.ESt)
(use kernel.host.World)
(use kernel.verdict.Verdict)
(use kernel.intmap.IntMap)
(use kernel.json.JRes)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EDecl)
(use kernel.reader.Open)
(use kernel.reader.RDecl)
(use kernel.reader.Resolved)
(use kernel.reader.Scope)
(use kernel.reader.Vis)
(use kernel.realize.RzRes)
(use kernel.sexpr.RAll)
(use kernel.sexpr.SExpr)

;; ---- paths ---------------------------------------------------------------------------
;; a path as its components on `/`
(fn split_path ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (Nil (rev (Cons (rev cur) acc)))
    ((Cons c r) (if (int_eq c 47) (split_path r Nil (Cons (rev cur) acc)) (split_path r (Cons c cur) acc)))))
;; normalized: empty and `.` components dropped, `..` pops; None if `..` would climb above the start
(fn norm_parts ((parts (List (List Int))) (acc (List (List Int)))) (Option (List (List Int)))
  (measure (struct parts))
  (match parts
    (Nil (Some (rev acc)))
    ((Cons p r)
     (if (int_list_eq p Nil) (norm_parts r acc)
     (if (int_list_eq p ".") (norm_parts r acc)
     (if (int_list_eq p "..") (match acc (Nil None) ((Cons _ a2) (norm_parts r a2)))
       (norm_parts r (Cons p acc))))))))
(fn parts_of ((bs (List Int))) (Option (List (List Int))) (norm_parts (split_path bs Nil Nil) Nil))
(fn join_path ((parts (List (List Int)))) (List Int)
  (measure (struct parts))
  (match parts (Nil Nil) ((Cons p Nil) p) ((Cons p r) (append p (Cons 47 (join_path r))))))
(fn dir_of ((parts (List (List Int)))) (List (List Int))
  (measure (struct parts))
  (match parts (Nil Nil) ((Cons _ Nil) Nil) ((Cons p r) (Cons p (dir_of r)))))
;; the rest of `parts` after the prefix `pre`, or None
(fn strip_parts ((pre (List (List Int))) (parts (List (List Int)))) (Option (List (List Int)))
  (measure (struct pre))
  (match pre
    (Nil (Some parts))
    ((Cons p pr) (match parts ((Cons q qr) (if (int_list_eq p q) (strip_parts pr qr) None)) (Nil None)))))
(fn parts_eq ((a (List (List Int))) (b (List (List Int)))) Bool
  (measure (struct a))
  (match a
    (Nil (match b (Nil True) (_ False)))
    ((Cons x ar) (match b (Nil False) ((Cons y br) (if (int_list_eq x y) (parts_eq ar br) False))))))
(fn strip_suffix ((suf (List Int)) (bs (List Int))) (Option (List Int))
  (let ((n (- (len bs) (len suf))))
    (if (lt n 0) None (if (int_list_eq (drop n bs) suf) (Some (take n bs)) None))))

;; the module path of a root-relative file: `.shard` dropped from the last
;; component, each component one name component (§3). A path whose last
;; component lacks `.shard` names a directory module (§6.6: its view);
;; `DIR/mod.req.shard` and the dir form `DIR/mod.req/mod.req.shard` are
;; DIR's view and carry DIR's path (MPView); other files under `mod.req/`
;; wait for a consumer.
(type ModPath (MPOk Name) (MPView Name) (MPDir) (MPBad (List Int)))
(fn module_of ((parts (List (List Int)))) ModPath (module_rest Anon parts))
(fn module_rest ((m Name) (parts (List (List Int)))) ModPath
  (measure (struct parts))
  (match parts
    (Nil (MPBad "empty path"))
    ((Cons p Nil)
     (if (int_list_eq p "mod.req.shard") (match m (Anon (MPBad "a view at the root: no directory")) (_ (MPView m)))
     (match (strip_suffix ".shard" p)
       (None (if (int_list_eq p "mod.req") (MPBad "mod.req/ names the dir form's directory, not a module") MPDir))
       ((Some stem) (module_comp m stem Nil)))))
    ((Cons p (Cons q Nil)) (if (bool_and (int_list_eq p "mod.req") (int_list_eq q "mod.req.shard")) (match m (Anon (MPBad "a view at the root: no directory")) (_ (MPView m))) (module_step m p (list q))))
    ((Cons p r) (module_step m p r))))
(fn module_step ((m Name) (p (List Int)) (r (List (List Int)))) ModPath
  (if (int_list_eq p "mod.req") (MPBad "a file under mod.req/ other than mod.req.shard: not at slice 4")
    (match (module_comp m p Nil) ((MPOk m2) (module_rest m2 r)) (x x))))
;; a directory's module path: each component one name component
(fn dir_module ((parts (List (List Int)))) ModPath (dir_module_go Anon parts))
(fn dir_module_go ((m Name) (parts (List (List Int)))) ModPath
  (measure (struct parts))
  (match parts
    (Nil (match m (Anon (MPBad "empty path")) (_ (MPOk m))))
    ((Cons p r) (if (int_list_eq p "mod.req") (MPBad "mod.req/ is the dir form's directory, not a module") (match (module_comp m p Nil) ((MPOk m2) (dir_module_go m2 r)) (x x))))))
;; the view file of a directory module, dir form first, then flat
(fn view_candidates ((dir (List (List Int)))) (List (List (List Int)))
  (list (append dir (list "mod.req" "mod.req.shard")) (append dir (list "mod.req.shard"))))
;; the implementation file: DIR/BASE.shard (the old tree's rule; §6.6)
(fn impl_file ((dir (List (List Int)))) (Option (List (List Int)))
  (match (rev dir) (Nil None) ((Cons base _) (Some (append dir (list (append base ".shard")))))))
;; one component; a dot inside it would split a citation, so it is refused
(fn module_comp ((m Name) (comp (List Int)) (seen (List Int))) ModPath
  (measure (struct comp))
  (match comp
    (Nil
     (match (name_push m (rev seen))
       (None (MPBad "empty component"))
       ((Some n) (if (bool_and (name_eq m Anon) (name_eq n (n1 (quote Init)))) (MPBad "Init is the import's prefix, never a module") (MPOk n)))))
    ((Cons c r) (if (int_eq c 46) (MPBad (append "a dot in a file name: " (rev_onto seen comp))) (module_comp m r (Cons c seen))))))

;; ---- the state -------------------------------------------------------------------------
;; a loaded module: path, root-relative file, hash (over its accepted
;; declarations' fingerprints, in order), its closure (the module paths
;; visible in it, itself included), whether the Init prefix is visible in it
;; a view's module also keeps its fork point (§6.6) for the implementation
;; check, which may come after a consumer loaded the view
(record Mod (path Name) (file (List Int)) (hash Int) (closure (List Name)) (init Bool) (fork (Option ForkPt)) (ok Bool))
  ;; ok False: its loading failed — a later import fails the same way, never re-reads it
;; a file whose loading failed after its heads were pre-registered: recorded so that a
;; later import of it reports import_failed instead of re-reading it into duplicate_name
(fn ld_add_failed ((l Load) (mp Name) (rel (List (List Int)))) Load
  (ld_add_mod l (make Mod (path mp) (file (join_path rel)) (hash 0) (closure Nil) (init False) (fork None) (ok False))))

;; the Init stream: the import run (its tables persist across chunks), the
;; rest of the current chunk, the chunk files still unread, the prefix
;; reached (the last target), declarations admitted so far
(type InitSt (InitNone) (InitSt Run (List Int) (List (List Int)) Name Int))

(type Rec
  (RModule Name (List Int) Int (List Name))   ; a module loaded: path, file, hash, its closure
  (RInit Name Int)                            ; the Init prefix loaded through NAME: declarations admitted so far
  (RAccept Name Name Int (List Name) Name (List Name))  ; declaration, module, content fingerprint, axiom closure, the Init prefix at the check (Anon = none), the view parameters it rests on
  (RParam Name Symbol Int)                    ; a view parameter admitted: kind (type / fn / requirement), a sig type's arity
  (RRefuse Name Symbol)                       ; K refused
  (RPolicy Name (List Name))                  ; outside the file's policy: the axioms it reaches that the policy lacks
  (RPending Name Symbol)                      ; sorry: read, admits nothing
  (RRun Symbol Name)                          ; an E declaration classified (§6.7): kind (fn / extern / type), R45's runnable status
  (RClassify Name Symbol (List Int))          ; the classifier refused: reason, message (counts as refused)
  (RRealize Name Symbol (List Name) (List Name))   ; a realization attached (§7.5): kind (supplied / view), its equations' identities, the pending roots it carries (R58)
  (RDischarge Name Symbol)                    ; the implementation check: a parameter discharged (type / fn / proved) or pending
  (RImplErr Name Symbol (List Int))           ; the implementation check: a parameter without its implementation, a mismatch
  (RImplRec Rec)                              ; a record of the implementation's fork (its own declarations)
  (RReadErr (List Int) Symbol (List Int))     ; file, reason, message — the file's reading ends here
  (RLoadErr (List Int) Symbol (List Int))     ; file, reason, detail — the file's loading ends here
  (RUnused Name (List Name)))                 ; the file's `use` lines no citation could need (§8.1 rule 4): module, prefixes

;; root, environment, closure memo, modules, the Init stream, declaration →
;; module, pending names, the loading stack (cycles), records newest first,
;; the export chunk files the driver named, the view parameters admitted (§6.6),
;; the E table (classify.shard: every E declaration by identity and suffix),
;; the pending roots each realization carries (§7.5; R58)
(record Load
  (root (List (List Int)))
  (env CheckedEnv)
  (memo AxMemo)
  (mods (List Mod))
  (init InitSt)
  (tbl (IntMap (List (Pair Name Name))))
  (pending (List Name))
  (stack (List Name))
  (recs (List Rec))
  (chunks (List (List Int)))
  (params (List Name))
  (etab ESt)
  (pm (List (Pair Name (List Name))))
  (forms (IntMap (List (Pair Name (Pair Scope SExpr))))))
(fn load0 ((root (List (List Int))) (chunks (List (List Int)))) Load
  (make Load (root root) (env (env_empty)) (memo (ax_memo_empty)) (mods Nil) (init InitNone) (tbl IMEmpty)
             (pending Nil) (stack Nil) (recs Nil) (chunks chunks) (params Nil) (etab (es0)) (pm Nil) (forms IMEmpty)))
(fn ld_recs ((l Load)) (List Rec) (rev (Load.recs l)))
(fn ld_with_env ((l Load) (e CheckedEnv) (m AxMemo)) Load (with Load l (env e) (memo m)))
(fn ld_add_mod ((l Load) (md Mod)) Load (with Load l (mods (Cons md (Load.mods l)))))
(fn ld_with_init ((l Load) (i InitSt)) Load (with Load l (init i)))
(fn ld_with_tbl ((l Load) (t (IntMap (List (Pair Name Name))))) Load (with Load l (tbl t)))
(fn ld_add_pending ((l Load) (n Name)) Load (with Load l (pending (Cons n (Load.pending l)))))
(fn ld_with_stack ((l Load) (s (List Name))) Load (with Load l (stack s)))
(fn ld_rec ((l Load) (x Rec)) Load (with Load l (recs (Cons x (Load.recs l)))))
(fn ld_add_param ((l Load) (n Name)) Load (with Load l (params (Cons n (Load.params l)))))
(fn ld_with_e ((l Load) (es ESt)) Load (with Load l (etab es)))
(fn ld_with_recs_raw ((l Load) (rs (List Rec))) Load (with Load l (recs rs)))
(fn ld_add_form ((l Load) (n Name) (sc Scope) (s SExpr)) Load
  (let ((k (name_key n)) (fo (Load.forms l)))
    (with Load l (forms (im_insert fo k (Cons (Pair n (Pair sc s)) (match (im_find fo k) ((Some b) b) (None Nil))))))))
;; a private file's (fn NAME …) / (type NAME …) form by its identity, with the scope it was read in
(fn form_for ((l Load) (n Name)) (Option (Pair Scope SExpr))
  (match (im_find (Load.forms l) (name_key n)) (None None) ((Some b) (form_assoc b n))))
(fn form_assoc ((b (List (Pair Name (Pair Scope SExpr)))) (n Name)) (Option (Pair Scope SExpr))
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair k v) r) (if (name_eq k n) (Some v) (form_assoc r n)))))
(fn ld_add_pm ((l Load) (n Name) (roots (List Name))) Load (with Load l (pm (Cons (Pair n roots) (Load.pm l)))))
(fn ld_find_mod ((ms (List Mod)) (p Name)) (Option Mod)
  (measure (struct ms))
  (match ms (Nil None) ((Cons m r) (if (name_eq (Mod.path m) p) (Some m) (ld_find_mod r p)))))
(fn init_prefix ((l Load)) Name (match (Load.init l) (InitNone Anon) ((InitSt _ _ _ p _) p)))

;; the file being loaded: module, root-relative parts, opened prefixes, the
;; visible modules (itself included), Init visible?, trusted names, hash so
;; far, whether it is a view (§6.6: the forms it may hold, the req-scope gate)
(record Fx (module Name) (ident Name) (parts (List (List Int))) (opened (List Open)) (vis (List Name)) (init Bool) (trusts (List Name)) (hash Int) (view Bool))
;; the prefix the file's declarations take: its module, or the sealed directory's for a file
;; directly inside one (the K seal: one module across the directory's files, §13 item 26)
(fn fx_private ((f Fx)) Bool (bool_not (name_eq (Fx.ident f) (Fx.module f))))
(fn fx_file ((f Fx)) (List Int) (join_path (Fx.parts f)))
(fn fx_open ((f Fx) (o Open)) Fx (with Fx f (opened (append (Fx.opened f) (list o)))))
(fn fx_see ((f Fx) (mods (List Name)) (init Bool)) Fx (with Fx f (vis (names_union (Fx.vis f) mods)) (init (bool_or (Fx.init f) init))))
(fn fx_trust ((f Fx) (ns (List Name))) Fx (with Fx f (trusts (append (Fx.trusts f) ns))))
(fn fx_mix ((f Fx) (x Int)) Fx (with Fx f (hash (mix (Fx.hash f) x))))
(fn fx_as_impl ((f Fx)) Fx (with Fx f (view False)))
(fn fx_scope ((l Load) (f Fx)) Scope
  (Scope (Fx.ident f) (Fx.module f) (Fx.opened f) (VisOnly (Fx.vis f) (Fx.init f) (Load.tbl l) (Load.pending l))))

;; ---- the forms -------------------------------------------------------------------------
(type Form
  (FImportFile (List Int))
  (FImportInit Name)
  (FUse Name (List Symbol))
  (FTrusts (List Name))
  (FDecl)
  (FBad Symbol (List Int)))
(fn form_of ((s SExpr)) Form
  (match s
    ((SList (Cons (SSym h) args))
     (if (sym_eq h (quote import)) (import_form args)
     (if (sym_eq h (quote use)) (use_form args)
     (if (sym_eq h (quote trusts)) (trusts_form args Nil)
       FDecl))))
    (_ FDecl)))
(fn import_form ((args (List SExpr))) Form
  (match args
    ((Cons (SStr p) Nil) (FImportFile p))
    ((Cons (SSym i) (Cons (SSym n) Nil))
     (if (sym_eq i (quote Init))
       (match (name_of_sym n) ((Some m) (FImportInit m)) (None (FBad (quote bad_import) "(import Init NAME)")))
       (FBad (quote bad_import) "(import \"FILE\") or (import Init NAME)")))
    (_ (FBad (quote bad_import) "(import \"FILE\") or (import Init NAME)"))))
;; (use P) opens P; (use P a b) opens P for the names a… and b…; a leading
;; `Init` is dropped (reader.shard's drop_init) — imported names are bare in
;; K (§3), so (use Init) opens nothing new and (use Init.List) opens `List`
(fn use_form ((args (List SExpr))) Form
  (match args
    ((Cons (SSym p) ms)
     (match (name_of_sym p)
       (None (FBad (quote bad_use) "(use PREFIX NAME…)"))
       ((Some n) (match (use_members ms Nil) ((Some syms) (FUse (drop_init n) syms)) (None (FBad (quote bad_use) "(use PREFIX NAME…)"))))))
    (_ (FBad (quote bad_use) "(use PREFIX NAME…)"))))
(fn use_members ((ms (List SExpr)) (acc (List Symbol))) (Option (List Symbol))
  (measure (struct ms))
  (match ms
    (Nil (Some (rev acc)))
    ((Cons (SSym s) r) (use_members r (Cons s acc)))
    (_ None)))
(fn trusts_form ((args (List SExpr)) (acc (List Name))) Form
  (measure (struct args))
  (match args
    (Nil (FTrusts (rev acc)))
    ((Cons (SSym s) r) (match (name_of_sym s) ((Some n) (trusts_form r (Cons n acc))) (None (FBad (quote bad_trusts) "(trusts NAME…)"))))
    (_ (FBad (quote bad_trusts) "(trusts NAME…)"))))
(fn form_head ((s SExpr)) Symbol (match s ((SList (Cons (SSym h) _)) h) (_ (quote form))))
(fn form_name ((sc Scope) (s SExpr)) Name
  (match s
    ((SList (Cons _ (Cons (SSym n) _))) (match (name_of_sym n) ((Some m) (qualify sc m)) (None Anon)))
    (_ Anon)))

;; ---- the policy (§9) -----------------------------------------------------------------------
(fn std_axioms () (List Name) (list (n1 (quote propext)) (n2 (quote Quot) (quote sound)) (n2 (quote Classical) (quote choice))))
;; the axioms of a closure the file's policy lacks; a view parameter is the
;; third class (§9, §6.6): permitted, named on the record
(fn outside_policy ((sc Scope) (trusts (List Name)) (params (List Name)) (axs (List Name))) (List Name)
  (measure (struct axs))
  (match axs
    (Nil Nil)
    ((Cons a r) (if (permitted sc trusts params a) (outside_policy sc trusts params r) (Cons a (outside_policy sc trusts params r))))))
(fn permitted ((sc Scope) (trusts (List Name)) (params (List Name)) (a Name)) Bool
  (if (mem_name a (std_axioms)) True (if (mem_name a params) True (trusted sc trusts a))))
(fn params_of ((params (List Name)) (axs (List Name))) (List Name)
  (measure (struct axs))
  (match axs (Nil Nil) ((Cons a r) (if (mem_name a params) (Cons a (params_of params r)) (params_of params r)))))
;; a trusted name is spelled as a citation would be: it resolves through the scope
(fn trusted ((sc Scope) (ts (List Name)) (a Name)) Bool
  (measure (struct ts))
  (match ts (Nil False) ((Cons t r) (if (mem_name a (scope_candidates sc t)) True (trusted sc r a)))))

;; ---- admission of one form's declarations --------------------------------------------------
;; every constant a declaration adds to the environment, for the table
(fn decl_declares ((env CheckedEnv) (d Declaration)) (List Name)
  (match d
    ((InductDecl _ _ ts _) (block_names env (all_names ts)))
    (_ (list (decl_name d)))))
(fn block_names ((env CheckedEnv) (ts (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (Nil Nil)
    ((Cons t r) (Cons t (append (induct_ctors env t) (Cons (Str t (quote rec)) (block_names env r)))))))
(fn decls_declare ((env CheckedEnv) (ds (List Declaration))) (List Name)
  (measure (struct ds))
  (match ds (Nil Nil) ((Cons d r) (append (decl_declares env d) (decls_declare env r)))))
(fn tbl_add_all ((tbl (IntMap (List (Pair Name Name)))) (ns (List Name)) (m Name)) (IntMap (List (Pair Name Name)))
  (measure (struct ns))
  (match ns (Nil tbl) ((Cons n r) (tbl_add_all (tbl_add tbl n m) r m))))

(type Admit (AdOk CheckedEnv) (AdRefused Name Symbol))
(fn admit_decls ((env CheckedEnv) (ds (List Declaration))) Admit
  (measure (struct ds))
  (match ds
    (Nil (AdOk env))
    ((Cons d r)
     (match (check env (st_init) d)
       ((Accepted e2) (admit_decls e2 r))
       ((Rejected reason subject) (AdRefused subject (reason_of reason)))
       ((Exhausted _ _) (AdRefused (decl_name d) (quote exhausted)))))))
(fn reason_of ((r Reason)) Symbol
  (match r
    ((Malformed t) t) ((RuleViolation t) t) ((Unsupported t) t) ((UnresolvedObligation t) t)
    (ConversionNotEstablished (quote conversion))))

;; the closures of the declared names against the policy: the first
;; declaration outside it, or the records to add
(type Pol (PolOk AxMemo (List Rec)) (PolOut Name (List Name)) (PolBound Name))
(fn policy_pass ((l Load) (f Fx) (env CheckedEnv) (memo AxMemo) (ds (List Declaration)) (acc (List Rec))) Pol
  (measure (struct ds))
  (match ds
    (Nil (PolOk memo (rev acc)))
    ((Cons d r)
     (let ((n (decl_name d)))
       (match (axioms_of env memo n)
         ((Pair memo1 None) (PolBound n))
         ((Pair memo1 (Some axs))
          (match (outside_policy (fx_scope l f) (Fx.trusts f) (Load.params l) axs)
            (Nil (policy_pass l f env memo1 r
                   (Cons (RAccept n (Fx.module f) (match (identity_hash env n) ((Some h) h) (None 0)) axs (init_prefix l) (params_of (Load.params l) axs)) acc)))
            (out (PolOut n out)))))))))

(fn mix_recs ((f Fx) (rs (List Rec))) Fx
  (measure (struct rs))
  (match rs
    (Nil f)
    ((Cons (RAccept _ _ h _ _ _) r) (mix_recs (fx_mix f h) r))
    ((Cons _ r) (mix_recs f r))))
(fn recs_add ((l Load) (rs (List Rec))) Load
  (measure (struct rs))
  (match rs (Nil l) ((Cons x r) (recs_add (ld_rec l x) r))))

;; one declared form: read, admit, check the policy, record. A view holds
;; L forms and parameters, never E bodies; a parameter belongs in a view. `fn`
;; and `extern` are read by the classifier (§6.7); `type` and `sig` gain their E
;; twins beside K's — a `type` over E's built-in types alone is E only
;; (type_is_e_only, §8.1 rule 1). K checks any L form in any file.
(fn load_decl ((l Load) (f Fx) (s SExpr)) (Pair Load Fx)
  (let ((sc (fx_scope l f)) (h (form_head s)))
    (load_decl_go (if (bool_and (fx_private f) (bool_or (sym_eq h (quote fn)) (sym_eq h (quote type)))) (ld_add_form l (form_name sc s) sc s) l) f s)))
(fn load_decl_go ((l Load) (f Fx) (s SExpr)) (Pair Load Fx)
  (let ((sc (fx_scope l f)) (h (form_head s)))
    (if (bool_and (Fx.view f) (bool_or (sym_eq h (quote fn)) (bool_or (sym_eq h (quote extern)) (bool_or (sym_eq h (quote realize)) (sym_eq h (quote fulfills))))))
      (Pair (ld_rec l (RLoadErr (fx_file f) (quote view_form) (append (chars_of_sym h) ": a view holds declarations and parameters, never bodies"))) f)
    (if (bool_and (bool_not (Fx.view f)) (bool_or (sym_eq h (quote sig)) (sym_eq h (quote requirement))))
      (Pair (ld_rec l (RLoadErr (fx_file f) (quote sig_outside_view) (append (chars_of_sym h) ": a parameter belongs in a view (mod.req.shard)"))) f)
    (if (bool_or (sym_eq h (quote fn)) (sym_eq h (quote extern))) (Pair (load_e_form l f s) f)
    (if (bool_and (sym_eq h (quote type)) (type_is_e_only (Load.etab l) sc (Load.env l) s)) (Pair (load_e_form l f s) f)   ; E only (its namespace was opened at pre-registration, as every type's)
    (if (sym_eq h (quote realize)) (Pair (load_realize l f s) f)
    (match (read_decl sc (Load.env l) s)
      ((RDErr e m)
       (if (bool_and (sym_eq h (quote sig)) (Fx.view f))
         (sig_e_only l f s e m)
         (Pair (ld_rec l (RReadErr (fx_file f) e m)) f)))
      ((RDPending n r) (Pair (ld_rec (ld_add_pending l n) (RPending n r)) f))
      ((RDDirective _) (Pair (ld_rec l (RLoadErr (fx_file f) (quote bad_directive) (chars_of_sym (form_head s)))) f))
      ((RDLater k) (Pair (ld_rec l (RLoadErr (fx_file f) (quote fulfills_outside_impl) (append (chars_of_sym k) ": a fulfills belongs to an implementation — give the loader the directory (§6.6)"))) f))
      ((RDParam d kind arity)
       (match (admit_param l f d kind arity)
         ((Pair l1 f1) (Pair (add_e_twin l1 f1 s) f1))))
      ((RDOk ds)
       (match (admit_decls (Load.env l) ds)
         ((AdRefused subj reason) (Pair (ld_rec l (RRefuse subj reason)) f))
         ((AdOk env1)
          (match (policy_pass l f env1 (Load.memo l) ds Nil)
            ((PolBound n) (Pair (ld_rec (ld_with_env l (Load.env l) (ax_memo_empty)) (RLoadErr (fx_file f) (quote closure_bound) (show_name n))) f))
            ((PolOut n out) (Pair (ld_rec (ld_with_env l (Load.env l) (ax_memo_empty)) (RPolicy n out)) f))
            ((PolOk memo1 recs)
             (let ((l1 (recs_add (ld_with_tbl (ld_with_env l env1 memo1) (tbl_add_all (Load.tbl l) (decls_declare env1 ds) (Fx.module f))) recs)))
               (Pair (add_e_twin l1 f s) (mix_recs f recs))))))))))))))))
;; a realization (§7.5): the E body under an admitted constant's identity; its equations admitted
;; as theorems through the same path as any declaration — one refused, nothing attached
(fn load_realize ((l0 Load) (f Fx) (s SExpr)) Load
  (let ((l (scan_form l0 f s)) (sc (fx_scope l0 f)))
    (match (realize_dispatch (Load.etab l) sc (Load.env l) s)
      ((RzErr e m) (ld_rec l (RClassify (realize_subject sc (Load.env l) s) e m)))
      ((RzOk es1 d thms pending)
       (let ((k (edecl_name d)))
         (match (admit_decls (Load.env l) thms)
           ((AdRefused subj reason) (ld_rec l (RRefuse subj reason)))
           ((AdOk env1)
            (match (policy_pass l f env1 (Load.memo l) thms Nil)
              ((PolBound n) (ld_rec (ld_with_env l (Load.env l) (ax_memo_empty)) (RLoadErr (fx_file f) (quote closure_bound) (show_name n))))
              ((PolOut n out) (ld_rec (ld_with_env l (Load.env l) (ax_memo_empty)) (RPolicy n out)))
              ((PolOk memo1 recs)
               (let ((l1 (recs_add (ld_with_tbl (ld_with_env l env1 memo1) (tbl_add_all (Load.tbl l) (decls_declare env1 thms) (Fx.module f))) recs)))
                 (let ((roots (realize_roots l1 k d pending)))
                   (let ((l2 (ld_rec (ld_with_e (ld_add_pm l1 k roots) (es_add_decl (es_register_all es1 (Fx.module f) (decl_infos d)) d)) (RRealize k (realize_kind s) (decls_declare env1 thms) roots))))
                     (if pending (ld_rec l2 (RPending k (quote measure))) l2)))))))))))))
;; the pending obligations a realization carries (§7.5; GPT-6 R58, slice 10): its own measure when
;; it is not structural, and every root a callee's realization already carries — an obligation is
;; recorded once, at its constant (PENDING), and every realization that reaches it names it
;; (REALIZE … pending=), so a retained candidate is never mistaken for a completed realization
;; through a caller
(fn realize_roots ((l Load) (k Name) (d EDecl) (pending Bool)) (List Name)
  (let ((inherited (roots_of (Load.pm l) (match d ((EFn _ _ _ _ _ body) (calls_of body)) (_ Nil)) Nil)))
    (if pending (Cons k inherited) inherited)))
(fn roots_of ((pm (List (Pair Name (List Name)))) (calls (List Name)) (acc (List Name))) (List Name)
  (measure (struct calls))
  (match calls
    (Nil (rev acc))
    ((Cons c r) (roots_of pm r (match (pm_find pm c) ((Some rs) (names_union acc rs)) (None acc))))))   ; axioms.shard's union
(fn pm_find ((pm (List (Pair Name (List Name)))) (n Name)) (Option (List Name))
  (measure (struct pm))
  (match pm (Nil None) ((Cons (Pair k rs) r) (if (name_eq k n) (Some rs) (pm_find r n)))))
;; the refusal's subject: the target's identity when it resolves, else the form's name
(fn realize_subject ((sc Scope) (env CheckedEnv) (s SExpr)) Name
  (match s
    ((SList (Cons _ (Cons (SSym x) _)))
     (match (name_of_sym x)
       ((Some n) (match (resolve (cx0 sc env Nil Nil) n) ((RName k _) k) (_ (form_name sc s))))
       (None (form_name sc s))))
    (_ (form_name sc s))))
(fn realize_dispatch ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (Cons _ (Cons _ (Cons (SList (Cons (SSym v) Nil)) Nil)))) (if (sym_eq v (quote view)) (realize_view es sc env s) (realize_supplied es sc env s)))
    (_ (realize_supplied es sc env s))))
(fn realize_kind ((s SExpr)) Symbol
  (match s
    ((SList (Cons _ (Cons _ (Cons (SList (Cons (SSym v) Nil)) Nil)))) (if (sym_eq v (quote view)) (quote view) (quote supplied)))
    (_ (quote supplied))))
;; an E declaration (fn / extern; a profile type): classified, recorded RUNNABLE or refused
(fn load_e_form ((l Load) (f Fx) (s SExpr)) Load
  (let ((sc (fx_scope l f)) (l1 (scan_form l f s)))
    (if (name_taken (Load.env l1) (form_name sc s))
      (ld_rec l1 (RClassify (form_name sc s) (quote name_taken) (append (show_name (form_name sc s)) " is an admitted constant: realize it, or declare another name (§7.5)")))
      (match (classify_form (Load.etab l1) sc (Load.env l1) s)
        ((CErr e m) (ld_rec l1 (RClassify (form_name sc s) e m)))
        ((COk d) (ld_rec (ld_with_e l1 (es_add_decl (Load.etab l1) d)) (RRun (form_head s) (edecl_name d))))))))
;; a fn or extern may not take an admitted constant's identity (§7.5): only a realize attaches
;; an E body under one, and the equations are its warrant
(fn name_taken ((env CheckedEnv) (n Name)) Bool (match (env_find env n) ((Some _) True) (None False)))
;; an S form's citations of the environment's E-eligible inductives enter the E table first (§7.5)
(fn scan_form ((l Load) (f Fx) (s SExpr)) Load
  (if (bool_not (Fx.init f)) l (ld_with_e l (es_scan_init (Load.etab l) (fx_scope l f) (Load.env l) s))))   ; an optimization: Init's inductives are citable only where Init is visible
;; a `type` enters K when its field types are L types (§4); it is E only when a field cites a
;; built-in E type with no L constant in scope — Int or Nat without Init, Symbol until its String
;; identity (phase 3) — or another E-only type, transitively (§8.1 rule 1; §13 item 35). Never
;; the directory and never the file's imports: K checks any L form in any file.
(fn type_is_e_only ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) Bool
  (match s
    ((SList (Cons _ (Cons hd ctors))) (ctors_e_only es sc env (type_name sc s) ctors))
    (_ False)))
;; a `type` form's qualified name: (type NAME …) or (type (NAME T…) …)
(fn type_name ((sc Scope) (s SExpr)) Name
  (match s
    ((SList (Cons _ (Cons hd _))) (match (type_head sc hd) ((Pair (Some (Pair n _)) _) n) (_ Anon)))
    (_ Anon)))
(fn ctors_e_only ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (cs (List SExpr))) Bool
  (measure (struct cs))
  (match cs
    (Nil False)
    ((Cons (SList (Cons _ fields)) r) (if (fields_e_only es sc env self fields) True (ctors_e_only es sc env self r)))
    ((Cons _ r) (ctors_e_only es sc env self r))))
(fn fields_e_only ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (fs (List SExpr))) Bool
  (measure (struct fs))
  (match fs
    (Nil False)
    ((Cons t r) (if (etype_e_only es sc env self t) True (fields_e_only es sc env self r)))))
(fn etype_e_only ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (t SExpr)) Bool
  (match t
    ((SSym x) (head_e_only es sc env self x))
    ((SList (Cons (SSym x) args)) (if (head_e_only es sc env self x) True (fields_e_only es sc env self args)))
    (_ False)))
;; a field type's head: Symbol has no L constant at Stage 0; Int and Nat have one iff Init is in
;; scope; a type of the E table is E-only iff K does not hold it — the type being declared excepted
(fn head_e_only ((es ESt) (sc Scope) (env CheckedEnv) (self Name) (x Symbol)) Bool
  (match (name_of_sym x)
    (None False)
    ((Some n)
     (if (name_eq n (n1 (quote Symbol))) True
     (if (bool_or (name_eq n (n1 (quote Int))) (name_eq n (n1 (quote Nat))))
       (match (resolve (cx0 sc env Nil Nil) n) ((RName _ _) False) (_ True))
       (match (only_types (eresolve es sc n))
         ((Cons (EHit id _ _) Nil) (if (name_eq id self) False (match (env_find env id) (None True) (_ False))))
         (_ False)))))))
;; the E twin of an admitted type / sig fn / sig type (§4's table: K and E)
(fn add_e_twin ((l Load) (f Fx) (s SExpr)) Load
  (let ((h (form_head s)))
    (if (bool_or (sym_eq h (quote type)) (sym_eq h (quote sig)))
      (match (ld_recs_head l)
        ((Some (RAccept _ _ _ _ _ _)) (add_e_twin_now l f s))
        ((Some (RParam _ _ _)) (add_e_twin_now l f s))
        (_ l))
      l)))
(fn add_e_twin_now ((l0 Load) (f Fx) (s SExpr)) Load
  (let ((l (scan_form l0 f s)))
    (match (classify_form (Load.etab l) (fx_scope l f) (Load.env l) s)
      ((CErr e m) (ld_rec l (RLoadErr (fx_file f) e m)))
      ((COk d) (ld_with_e l (es_add_decl (Load.etab l) d))))))
;; a view's `sig fn` whose signature names an E-only type (§8.1 rule 1: K holds no constant
;; for it) is an E parameter only — the head `run` links to the implementation's fn, no
;; axiom in K (a fn has no L meaning at Stage 0, §0); the K seal's view is such a view
;; (`Expr`, `Name`, `Declaration` are E-only data). Recorded as PARAM NAME fn like any.
(fn sig_e_only ((l0 Load) (f Fx) (s SExpr) (e Symbol) (m (List Int))) (Pair Load Fx)
  (let ((l (scan_form l0 f s)))
    (match (classify_form (Load.etab l) (fx_scope l f) (Load.env l) s)
      ((COk (ESig n nt ps rt))
       (Pair (ld_rec (ld_with_e l (es_add_decl (Load.etab l) (ESig n nt ps rt))) (RParam n (quote fn) 0)) (fx_mix f (hash_name n))))
      ((COk _) (Pair (ld_rec l (RReadErr (fx_file f) e m)) f))
      ((CErr _ _) (Pair (ld_rec l (RReadErr (fx_file f) e m)) f)))))
;; a view parameter: an axiom-kind constant to K, the third class to the policy
(fn admit_param ((l Load) (f Fx) (d Declaration) (kind Symbol) (arity Int)) (Pair Load Fx)
  (let ((n (decl_name d)))
    (match (check (Load.env l) (st_init) d)
      ((Accepted env1)
       (Pair (ld_rec (ld_add_param (ld_with_tbl (ld_with_env l env1 (Load.memo l)) (tbl_add (Load.tbl l) n (Fx.module f))) n) (RParam n kind arity))
             (fx_mix f (match (identity_hash env1 n) ((Some h) h) (None 0)))))
      ((Rejected reason subject) (Pair (ld_rec l (RRefuse subject (reason_of reason))) f))
      ((Exhausted _ _) (Pair (ld_rec l (RRefuse n (quote exhausted))) f)))))

;; ---- the Init prefix (§3.1) ----------------------------------------------------------------
;; the pin (v3/README.md): the export's meta line must say so
(fn init_pin_githash () (List Int) "819816b2e0a3bf405af45ae5c7af2491d8f5bee6")
(fn init_pin_exporter () (List Int) "lean4export")
(fn init_pin_exporter_version () (List Int) "3.1.0")
(fn init_pin_format () (List Int) "3.1.0")
(fn init_budget () Int 100000000)

;; the first record must be the meta line matching the pin; the rest of the chunk follows
(fn check_meta ((bs (List Int))) (Pair (Option (List Int)) (List Int))
  (match (json_parse bs)
    (JErr (Pair None "the export's first record is not JSON"))
    ((JRes j rest)
     (match (jget j "meta")
       (None (Pair None "the export's first record is not its meta line"))
       ((Some m)
        (let ((githash (jpath m "lean" "githash"))
              (exporter (jpath m "exporter" "name"))
              (exv (jpath m "exporter" "version"))
              (fmt (jpath m "format" "version")))
          (if (bool_not (opt_str_eq githash (init_pin_githash))) (Pair None (append "lean githash " (append (show_opt_str githash) (append ", the pin is " (init_pin_githash)))))
          (if (bool_not (opt_str_eq exporter (init_pin_exporter))) (Pair None (append "exporter " (show_opt_str exporter)))
          (if (bool_not (opt_str_eq exv (init_pin_exporter_version))) (Pair None (append "exporter version " (append (show_opt_str exv) (append ", the pin is " (init_pin_exporter_version)))))
          (if (bool_not (opt_str_eq fmt (init_pin_format))) (Pair None (append "format version " (append (show_opt_str fmt) (append ", the pin is " (init_pin_format)))))
            (Pair (Some rest) Nil)))))))))))
(fn jpath ((j Json) (a (List Int)) (b (List Int))) (Option (List Int))
  (match (jget j a) ((Some x) (match (jget x b) ((Some y) (jstr y)) (None None))) (None None)))
(fn opt_str_eq ((o (Option (List Int))) (s (List Int))) Bool (match o ((Some x) (int_list_eq x s)) (None False)))
(fn show_opt_str ((o (Option (List Int)))) (List Int) (match o ((Some x) x) (None "(missing)")))

;; the Init stream saved: its environment becomes the loader's
(fn init_save ((l Load) (run Run) (rest (List Int)) (files (List (List Int))) (pfx Name) (n Int)) Load
  (ld_with_init (ld_with_env l (run_env run) (Load.memo l)) (InitSt run rest files pfx n)))
(fn init_err ((l Load) (file (List Int)) (reason Symbol) (detail (List Int))) (Pair Load Bool)
  (Pair (ld_rec l (RLoadErr file reason detail)) False))

;; load the export through `target`: already admitted = within the loaded
;; prefix (two nested prefixes, the larger once); else stream on from where
;; the last import stopped
(fn init_through ((l Load) (target Name) (w World)) (Pair (Pair Load Bool) World)
  (match (env_find (Load.env l) target)
    ((Some _) (Pair (Pair l True) w))
    (None
     (match (Load.init l)
       (InitNone
        (match (Load.chunks l)
          (Nil (Pair (init_err l "Init" (quote init_unavailable) "no export chunks were given (load.shard --init CHUNK…)") w))
          ((Cons f rest)
           (match (read_file f w)
             ((Pair None w1) (Pair (init_err l f (quote missing_file) "the export chunk") w1))
             ((Pair (Some bs) w1)
              (match (check_meta bs)
                ((Pair None msg) (Pair (init_err l f (quote export_pin_mismatch) msg) w1))
                ((Pair (Some after) _)
                 (init_stream l (run_with_env (empty_run False False) (Load.env l) (st_for (Load.env l))) after rest target 0 (init_budget) w1))))))))
       ((InitSt run rest files _ n)
        (init_stream l (run_with_env run (Load.env l) (st_for (Load.env l))) rest files target n (init_budget) w))))))

(fn init_stream ((l Load) (run Run) (bs0 (List Int)) (files (List (List Int))) (target Name) (n Int) (fuel Int) (w World)) (Pair (Pair Load Bool) World)
  (measure fuel)
  (if (lt fuel 0) (Pair (init_err (init_save l run bs0 files (init_prefix l) n) "Init" (quote init_budget) "the record budget") w)
  (let ((bs (skip_ws bs0)))
    (match bs
      (Nil
       (match files
         (Nil (Pair (init_err (init_save l run Nil Nil (init_prefix l) n) "Init" (quote init_name_not_found) (append (show_name target) " is not in the export chunks given")) w))
         ((Cons f rest)
          (match (read_file f w)
            ((Pair None w1) (Pair (init_err (init_save l run Nil rest (init_prefix l) n) f (quote missing_file) "the export chunk") w1))
            ((Pair (Some bs2) w1) (init_stream l run bs2 rest target n (- fuel 1) w1))))))
      (_
       (match (json_parse bs)
         (JErr (Pair (init_err (init_save l run Nil files (init_prefix l) n) "Init" (quote init_malformed) "a record is not JSON") w))
         ((JRes j rest)
          (match (process_record run j)
            ((Pair run1 v)
             (match v
               (VSkip (init_stream l run1 rest files target n (- fuel 1) w))
               ((VAccept _)
                (if (mem_name target (record_constants (run_tabs run1) j v))
                  (Pair (Pair (ld_rec (init_save l run1 rest files target (+ n 1)) (RInit target (+ n 1))) True) w)
                  (init_stream l run1 rest files target (+ n 1) (- fuel 1) w)))
               (_ (Pair (init_err (init_save l run1 rest files (init_prefix l) n) "Init" (quote init_refused) (match (show_verdict v) ((Some t) t) (None "?"))) w))))))))))))

;; ---- files and modules -----------------------------------------------------------------------
(fn import_depth () Int 1000)

;; a file named on the command line: under the root, spelled from the same base as the root
(fn load_root_file ((l Load) (file (List Int)) (w World)) (Pair Load World)
  (match (parts_of file)
    (None (Pair (ld_rec l (RLoadErr file (quote bad_path) "")) w))
    ((Some parts)
     (match (strip_parts (Load.root l) parts)
       (None (Pair (ld_rec l (RLoadErr file (quote outside_root) (join_path (Load.root l)))) w))
       ((Some rel)
        (match (module_of rel)
          (MPDir (load_dir_checked l rel (import_depth) w))
          (_ (load_module l rel (import_depth) w))))))))

;; a root-relative file as a module: once; a cycle refused; the records
;; of its forms; its MODULE record when its forms are done
(fn load_module ((l Load) (rel (List (List Int))) (fuel Int) (w World)) (Pair Load World)
  (measure fuel)
  (match (module_of rel)
    ((MPBad m) (Pair (ld_rec l (RLoadErr (join_path rel) (quote bad_module_name) m)) w))
    (MPDir (load_dir l rel fuel w))
    ((MPView mp) (match (load_file_module l rel mp True fuel w) ((Pair (Pair l1 _) w1) (Pair l1 w1))))
    ((MPOk mp) (match (load_file_module l rel mp False fuel w) ((Pair (Pair l1 _) w1) (Pair l1 w1))))))

;; one file as the module `mp`; a view when `view`. Returns, for a view, the
;; fork point of §6.6: the loader's state after the view's leading
;; directives, the file's context then, and the forms after them
(type ForkPt (ForkPt Load Fx (List SExpr)))
(fn load_file_module ((l Load) (rel (List (List Int))) (mp Name) (view Bool) (fuel Int) (w World)) (Pair (Pair Load (Option ForkPt)) World)
  (measure fuel)
  (match (ld_find_mod (Load.mods l) mp)
    ((Some m)
     (if (int_list_eq (Mod.file m) (join_path rel)) (Pair (Pair l None) w)   ; loaded, or failed: the importer reads mod_ok
       (Pair (Pair (ld_rec l (RLoadErr (join_path rel) (quote module_collision) (append (show_name mp) (append " is already " (Mod.file m))))) None) w)))
    (None
     (if (mem_name mp (Load.stack l)) (Pair (Pair (ld_rec l (RLoadErr (join_path rel) (quote import_cycle) (show_name mp))) None) w)
     (if (lt fuel 0) (Pair (Pair (ld_rec l (RLoadErr (join_path rel) (quote import_depth) "")) None) w)
     (match (read_file (join_path (append (Load.root l) rel)) w)
       ((Pair None w1) (Pair (Pair (ld_rec l (RLoadErr (join_path rel) (quote missing_file) (join_path (append (Load.root l) rel)))) None) w1))
       ((Pair (Some src) w1)
        (match (read_all src)
          ((RAErr e off) (Pair (Pair (ld_rec l (RReadErr (join_path rel) e (append "at byte " (show_nat off)))) None) w1))
          ((RAOk forms0)
           (match (expand_records forms0)
            ((RxErr e m) (Pair (Pair (ld_rec l (RReadErr (join_path rel) e m)) None) w1))
            ((RxOk forms)
           (match (sealed_ident l rel mp view w1)
            ((Pair ip w1s)
           (match (split_directives forms Nil)
             ((Pair dirs rest)
              (match (pre_register_file l (make Fx (module mp) (ident ip) (parts rel) (opened Nil) (vis (list mp)) (init False) (trusts Nil) (hash (hash_name mp)) (view view)) rest)
                ((Pair None l0) (Pair (Pair (ld_add_failed l0 mp rel) None) w1))
                ((Pair (Some f0) l0)
              (match (load_forms (ld_with_stack l0 (Cons mp (Load.stack l))) f0 dirs fuel w1s)
                ((Pair (Pair l1 None) w2) (Pair (Pair (ld_add_failed (ld_with_stack l1 (Load.stack l)) mp rel) None) w2))
                ((Pair (Pair l1a (Some f1)) w2)
                 (match (pre_register_late l1a f1 rest)
                 ((Pair None l1) (Pair (Pair (ld_add_failed (ld_with_stack l1 (Load.stack l)) mp rel) None) w2))
                 ((Pair (Some _) l1)
                 (match (load_forms l1 f1 rest fuel w2)
                   ((Pair (Pair l2 (Some f)) w3)
                    (let ((fp (if view (Some (ForkPt (ld_with_stack l1 (Load.stack l)) f1 rest)) None)))
                      (Pair (Pair (ld_rec (rec_unused (ld_add_mod (ld_with_stack l2 (Load.stack l)) (make Mod (path mp) (file (join_path rel)) (hash (Fx.hash f)) (closure (Fx.vis f)) (init (Fx.init f)) (fork fp) (ok True))) f dirs rest)
                                          (RModule mp (join_path rel) (Fx.hash f) (Fx.vis f)))
                                  fp)
                            w3)))
                   ((Pair (Pair l2 None) w3) (Pair (Pair (ld_add_failed (ld_with_stack l2 (Load.stack l)) mp rel) None) w3))))))))))))))))))))))))
;; the prefix a file's declarations take: its own module, or the sealed directory's for a file
;; directly inside a directory that has a view (one module across the directory's files; the
;; view and the implementation already carry it)
(fn sealed_ident ((l Load) (rel (List (List Int))) (mp Name) (view Bool) (w World)) (Pair Name World)
  (if view (Pair mp w)
    (let ((d (dir_of rel)))
      (match d
        (Nil (Pair mp w))
        (_
         (match (has_view l d w)
           ((Pair True w1) (match (dir_module d) ((MPOk dm) (Pair dm w1)) (_ (Pair mp w1))))
           ((Pair False w1) (Pair mp w1))))))))
;; the realize heads, once the directives made their targets visible (§7.5)
(fn pre_register_late ((l Load) (f Fx) (forms (List SExpr))) (Pair (Option Fx) Load)
  (match (pre_register_realize (Load.etab l) (fx_scope l f) (Load.env l) forms)
    ((PreErr e m) (Pair None (ld_rec l (RLoadErr (fx_file f) e m))))
    ((PreOk es) (Pair (Some f) (ld_with_e l es)))))
;; the file's E heads registered before any body (§6.7); a duplicate ends the file
(fn pre_register_file ((l Load) (f Fx) (forms (List SExpr))) (Pair (Option Fx) Load)
  (match (pre_register (Load.etab l) (fx_scope l f) (Load.env l) forms)
    ((PreErr e m) (Pair None (ld_rec l (RLoadErr (fx_file f) e m))))
    ((PreOk es) (Pair (Some (open_types f (fx_scope l f) forms)) (ld_with_e l es)))))
;; every `type` of the file opens its constructors for the whole file (§13 item 7, amended at
;; slice 3.4 and at 3.9): they are pre-registered like the file's heads, so a body cites them
;; before the declaration as it calls a function declared later. The constructors only — not
;; every declaration under the type's prefix: a record's accessors (`Load.env`, slice 3.9) are
;; cited qualified, or opened by `(use M.T)` where a file wants them bare, else every field
;; name would be refused as a pattern variable of the file (pattern_name)
(fn open_types ((f Fx) (sc Scope) (forms (List SExpr))) Fx
  (measure (struct forms))
  (match forms
    (Nil f)
    ((Cons s r) (open_types (if (sym_eq (form_head s) (quote type)) (fx_open f (OpenSome (type_name sc s) (type_ctor_syms s))) f) sc r))))
;; the constructor names of a (type HEAD (C …) …) form
(fn type_ctor_syms ((s SExpr)) (List Symbol)
  (match s ((SList (Cons _ (Cons _ ctors))) (ctor_syms ctors)) (_ Nil)))
(fn ctor_syms ((cs (List SExpr))) (List Symbol)
  (measure (struct cs))
  (match cs
    (Nil Nil)
    ((Cons (SList (Cons (SSym c) _)) r) (Cons c (ctor_syms r)))
    ((Cons _ r) (ctor_syms r))))
;; the leading directives (import / use / trusts) and the rest
(fn split_directives ((forms (List SExpr)) (acc (List SExpr))) (Pair (List SExpr) (List SExpr))
  (measure (struct forms))
  (match forms
    (Nil (Pair (rev acc) Nil))
    ((Cons s r) (match (form_of s) (FDecl (Pair (rev acc) forms)) (_ (split_directives r (Cons s acc)))))))

;; ---- unused use lines (§8.1 rule 4; the prune, slice 3.7) --------------------------------
;; A `(use P)` no citation of the file could need: no symbol token of the file's forms
;; names, under P, a declaration K or the E table holds once the file is loaded. The test
;; is the flat mirror of resolution — a citation is a suffix of its identity and the opened
;; prefix is what stands above it (etable.shard cited_in_scope) — over every token rather
;; than every citation, so a binder or a pattern variable spelled like a declaration can
;; keep a line, never drop one; a line for the file's own module is never needed. Selective
;; opens `(use P a b)` are not judged. Recorded as UNUSED, never a refusal.
;; Cost: the E table's suffix index answers each token with its hits, and the native K
;; declarations are bucketed by last component once per file; only a prefix neither marks
;; pays the token scan against K's environment (`Init`'s bare names under `(use Init.T)`,
;; a view's parameters) — nothing in a file whose lines are all needed.
(fn rec_unused ((l Load) (f Fx) (dirs (List SExpr)) (forms (List SExpr))) Load
  (match (unused_uses l f dirs forms) (Nil l) (ps (ld_rec l (RUnused (Fx.module f) ps)))))
(fn unused_uses ((l Load) (f Fx) (dirs (List SExpr)) (forms (List SExpr))) (List Name)
  (let ((toks (tok_names (form_tokens forms (Toks IMEmpty Nil)))))
    (let ((needed (needed_k (Load.tbl l) (tok_buckets toks IMEmpty) (needed_e (Load.etab l) toks IMEmpty))))
      (unused_go l (Fx.ident f) (uses_of dirs) toks needed Nil))))
(fn uses_of ((dirs (List SExpr))) (List Name)
  (measure (struct dirs))
  (match dirs
    (Nil Nil)
    ((Cons s r) (match (form_of s) ((FUse p Nil) (Cons p (uses_of r))) (_ (uses_of r))))))
(fn unused_go ((l Load) (m Name) (ps (List Name)) (toks (List Name)) (needed (IntMap Bool)) (acc (List Name))) (List Name)
  (measure (struct ps))
  (match ps
    (Nil (rev acc))
    ((Cons p r)
     (unused_go l m r toks needed
       (if (name_eq p m) (Cons p acc)
       (if (im_has needed (name_key p)) acc
       (if (use_needed l p toks) acc (Cons p acc))))))))
;; the fallback: some token names a declaration of K under P
(fn use_needed ((l Load) (p Name) (toks (List Name))) Bool
  (measure (struct toks))
  (match toks
    (Nil False)
    ((Cons t r) (if (name_taken (Load.env l) (name_append p t)) True (use_needed l p r)))))
;; E: every hit of a token by suffix marks the prefix above the token in its identity
(fn needed_e ((es ESt) (toks (List Name)) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct toks))
  (match toks
    (Nil needed)
    ((Cons t r) (needed_e es r (mark_hits (es_hits es t) t needed)))))
(fn mark_hits ((hs (List EEnt)) (t Name) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct hs))
  (match hs
    (Nil needed)
    ((Cons (EEnt _ id _ _) r) (mark_hits r t (mark_above id t needed)))))
(fn mark_above ((id Name) (t Name) (needed (IntMap Bool))) (IntMap Bool)
  (match (name_above id t) ((Some pre) (im_insert needed (name_key pre) True)) (None needed)))
;; K: every native declaration against the tokens sharing its last component
(fn needed_k ((tbl (IntMap (List (Pair Name Name)))) (buckets (IntMap (List Name))) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct tbl))
  (match tbl
    (IMEmpty needed)
    ((IMLeaf _ ds) (mark_decls ds buckets needed))
    ((IMNode v c0 c1 c2 c3)
     (needed_k c3 buckets (needed_k c2 buckets (needed_k c1 buckets (needed_k c0 buckets
       (match v ((Some ds) (mark_decls ds buckets needed)) (None needed)))))))))
(fn mark_decls ((ds (List (Pair Name Name))) (buckets (IntMap (List Name))) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct ds))
  (match ds
    (Nil needed)
    ((Cons (Pair id _) r)
     (mark_decls r buckets
       (match (im_find buckets (last_key id)) ((Some ts) (mark_tokens id ts needed)) (None needed))))))
(fn mark_tokens ((id Name) (ts (List Name)) (needed (IntMap Bool))) (IntMap Bool)
  (measure (struct ts))
  (match ts
    (Nil needed)
    ((Cons t r) (mark_tokens id r (mark_above id t needed)))))
;; the tokens bucketed by their last component's key
(fn tok_buckets ((toks (List Name)) (b (IntMap (List Name)))) (IntMap (List Name))
  (measure (struct toks))
  (match toks
    (Nil b)
    ((Cons t r)
     (let ((k (last_key t)))
       (tok_buckets r (im_insert b k (Cons t (match (im_find b k) ((Some ts) ts) (None Nil)))))))))
(fn last_key ((n Name)) Int
  (match n ((Str _ s) (name_key (n1 s))) ((Num _ k) (name_key (Num Anon k))) (Anon 0)))
;; the distinct dotted-name tokens of the forms, keyed by hash
(type Toks (Toks (IntMap Bool) (List Name)))
(fn tok_names ((t Toks)) (List Name) (match t ((Toks _ ns) ns)))
(fn tok_add ((t Toks) (x Symbol)) Toks
  (match (name_of_sym x)
    (None t)
    ((Some n)
     (match t
       ((Toks seen ns)
        (let ((k (name_key n)))
          (if (im_has seen k) t (Toks (im_insert seen k True) (Cons n ns)))))))))
(fn form_tokens ((forms (List SExpr)) (t Toks)) Toks
  (measure (struct forms))
  (match forms
    (Nil t)
    ((Cons s r) (form_tokens r (sexpr_tokens s t)))))
(fn sexpr_tokens ((s SExpr) (t Toks)) Toks
  (measure (struct s))
  (match s
    ((SSym x) (tok_add t x))
    ((SSymU x us) (tok_add (sexprs_tokens us t) x))
    ((SList items) (sexprs_tokens items t))
    (_ t)))
(fn sexprs_tokens ((ss (List SExpr)) (t Toks)) Toks
  (measure (struct ss))
  (match ss
    (Nil t)
    ((Cons s r) (sexprs_tokens r (sexpr_tokens s t)))))

;; ---- directory modules (§6.5, §6.6) ------------------------------------------------------
;; (import "DIR"): the view — DIR/mod.req/mod.req.shard, else DIR/mod.req.shard
(fn load_dir ((l Load) (dir (List (List Int))) (fuel Int) (w World)) (Pair Load World)
  (match (load_dir_view l dir fuel w) ((Pair (Pair l1 _) w1) (Pair l1 w1))))
(fn load_dir_view ((l Load) (dir (List (List Int))) (fuel Int) (w World)) (Pair (Pair Load (Option ForkPt)) World)
  (match (dir_module dir)
    ((MPOk mp) (load_view_candidates l dir mp (view_candidates dir) fuel w))
    ((MPBad m) (Pair (Pair (ld_rec l (RLoadErr (join_path dir) (quote bad_module_name) m)) None) w))
    (_ (Pair (Pair (ld_rec l (RLoadErr (join_path dir) (quote bad_module_name) "")) None) w))))
(fn load_view_candidates ((l Load) (dir (List (List Int))) (mp Name) (cands (List (List (List Int)))) (fuel Int) (w World)) (Pair (Pair Load (Option ForkPt)) World)
  (measure (struct cands))
  (match cands
    (Nil (Pair (Pair (ld_rec l (RLoadErr (join_path dir) (quote missing_interface) "no mod.req.shard (nor mod.req/mod.req.shard)")) None) w))
    ((Cons c r)
     (match (read_file (join_path (append (Load.root l) c)) w)
       ((Pair None w1) (load_view_candidates l dir mp r fuel w1))
       ((Pair (Some _) w1) (load_file_module l c mp True fuel w1))))))

;; the loader given DIR itself: the view, then the implementation checked
;; against it in a fork from the view's fork point (§6.6)
(fn load_dir_checked ((l Load) (dir (List (List Int))) (fuel Int) (w World)) (Pair Load World)
  (match (load_dir_view l dir fuel w)
    ((Pair (Pair l1 fp) w1) (check_impl l1 dir (match fp ((Some x) (Some x)) (None (stored_fork l1 dir))) w1))))
;; the fork point of a view a consumer loaded earlier
(fn stored_fork ((l Load) (dir (List (List Int)))) (Option ForkPt)
  (match (dir_module dir)
    ((MPOk mp) (match (ld_find_mod (Load.mods l) mp) ((Some m) (Mod.fork m)) (None None)))
    (_ None)))
(fn check_impl ((l1 Load) (dir (List (List Int))) (fp (Option ForkPt)) (w1 World)) (Pair Load World)
  (match fp
    (None (Pair l1 w1))
    ((Some (ForkPt lf f rest))
     (match (impl_file dir)
       (None (Pair (ld_rec l1 (RLoadErr (join_path dir) (quote bad_module_name) "")) w1))
       ((Some ifile)
        (match (read_file (join_path (append (Load.root l1) ifile)) w1)
          ((Pair None w2) (Pair (ld_rec l1 (RLoadErr (join_path ifile) (quote missing_implementation) (join_path (append (Load.root l1) ifile)))) w2))
          ((Pair (Some src) w2)
           (match (read_all src)
             ((RAErr e off) (Pair (ld_rec l1 (RReadErr (join_path ifile) e (append "at byte " (show_nat off)))) w2))
             ((RAOk iforms0)
              (match (expand_records iforms0)
               ((RxErr e m) (Pair (ld_rec l1 (RReadErr (join_path ifile) e m)) w2))
               ((RxOk iforms)
              (match (pre_register_file (ld_with_recs_raw lf Nil) (fx_as_impl f) iforms)
                ((Pair None lf0) (Pair (merge_impl_recs l1 (ld_recs lf0)) w2))
                ((Pair (Some f0) lf0)
                 (match (impl_replay lf0 (make Im (view rest) (impl iforms) (done Nil) (fx f0) (file ifile) (all rest)) (import_depth) w2)
                   ((Pair (Pair lf2 im) w3)
                    (Pair (ld_with_e (merge_impl_recs l1 (ld_recs lf2)) (es_merge (Load.etab l1) (Load.etab lf2))) w3))))))))))))))))
;; the fork's records under IMPL; DISCHARGE and IMPL-ERROR as themselves
(fn merge_impl_recs ((l Load) (rs (List Rec))) Load
  (measure (struct rs))
  (match rs
    (Nil l)
    ((Cons (RDischarge n k) r) (merge_impl_recs (ld_rec l (RDischarge n k)) r))
    ((Cons (RImplErr n e m) r) (merge_impl_recs (ld_rec l (RImplErr n e m)) r))
    ((Cons x r) (merge_impl_recs (ld_rec l (RImplRec x)) r))))

;; the implementation check's state: the view's forms still to replay, the
;; implementation's forms not yet consumed (file order), the parameters
;; discharged so far, the fork's file context, the implementation file
(record Im (view (List SExpr)) (impl (List SExpr)) (done (List (Pair Symbol Name))) (fx Fx) (file (List (List Int))) (all (List SExpr)))
(fn im_file ((i Im)) (List Int) (join_path (Im.file i)))
(fn im_with_fx ((i Im) (f Fx)) Im (with Im i (fx f)))
(fn im_with_impl ((i Im) (p (List SExpr))) Im (with Im i (impl p)))
(fn im_with_view ((i Im) (v (List SExpr))) Im (with Im i (view v)))
(fn im_mark ((i Im) (k Symbol) (n Name)) Im (with Im i (done (Cons (Pair k n) (Im.done i)))))
(fn im_marked ((i Im) (k Symbol) (n Name)) Bool (marked (Im.done i) k n))
(fn marked ((d (List (Pair Symbol Name))) (k Symbol) (n Name)) Bool
  (measure (struct d))
  (match d (Nil False) ((Cons (Pair k2 nn) r) (if (bool_and (sym_eq k k2) (name_eq n nn)) True (marked r k n)))))

;; the view's forms in order, then the implementation's rest
(fn impl_replay ((l Load) (im Im) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (measure fuel)
  (if (lt fuel 0) (Pair (Pair (ld_rec l (RLoadErr (im_file im) (quote import_depth) "")) im) w)
  (match (Im.view im)
    (Nil (impl_rest l im fuel w))
    ((Cons s r)
     (let ((im1 (im_with_view im r)))
       (match (form_of s)
         (FDecl (match (replay_decl l im1 s fuel w) ((Pair (Pair l2 im2) w2) (impl_replay l2 im2 (- fuel 1) w2))))
         (_ (match (load_forms l (Im.fx im1) (list s) fuel w)
              ((Pair (Pair l2 (Some f2)) w2) (impl_replay l2 (im_with_fx im1 f2) (- fuel 1) w2))
              ((Pair (Pair l2 None) w2) (Pair (Pair l2 im1) w2))))))))))
;; one view form in the fork: a parameter is discharged by the implementation's form
(fn replay_decl ((l Load) (im Im) (s SExpr) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (let ((sc (fx_scope l (Im.fx im))) (h (form_head s)))
    (if (sym_eq h (quote theorem)) (Pair (Pair l im) w)              ; checked once, against the parameters; bound by its closure
    (if (sym_eq h (quote sig))
      (match (sig_kind_name sc s)
        (None (Pair (Pair (ld_rec l (RReadErr (im_file im) (quote bad_shape) "(sig fn NAME …) or (sig type NAME)")) im) w))
        ((Some (Pair k n)) (discharge l im k n s fuel w)))
    (if (sym_eq h (quote requirement))
      (match (form_name sc s) (Anon (Pair (Pair (ld_rec l (RReadErr (im_file im) (quote bad_shape) "(requirement NAME …)")) im) w))
        (n (discharge l im (quote requirement) n s fuel w)))
      (match (load_decl l (Im.fx im) s) ((Pair l2 f2) (Pair (Pair l2 (im_with_fx im f2)) w))))))))
;; (sig type (NAME …)) / (sig type NAME) / (sig fn NAME …): its kind and qualified name
(fn sig_kind_name ((sc Scope) (s SExpr)) (Option (Pair Symbol Name))
  (match s
    ((SList (Cons _ (Cons (SSym k) (Cons hd _))))
     (if (sym_eq k (quote type))
       (match (type_head sc hd) ((Pair (Some (Pair n _)) _) (Some (Pair (quote type) n))) (_ None))
     (if (sym_eq k (quote fn))
       (match hd ((SSym x) (match (name_of_sym x) ((Some n) (Some (Pair (quote fn) (qualify sc n)))) (None None))) (_ None))
       None)))
    (_ None)))
;; a parameter's discharge: the implementation's form for it — consumed
;; already (checked when consumed), or reached now by consuming the
;; implementation's forms in file order up to it — else missing
(fn discharge ((l Load) (im Im) (k Symbol) (n Name) (s SExpr) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (if (im_marked im k n) (Pair (Pair l im) w)
  (match (match_private l im k n s)
    ((Pair l0 im0)
     (if (im_marked im0 k n) (Pair (Pair l0 im0) w)
     (match (advance l0 im0 k n s fuel w)
       ((Pair (Pair l1 im1) w1)
        (if (im_marked im1 k n) (Pair (Pair l1 im1) w1)
          (Pair (Pair (ld_rec l1 (RImplErr n (missing_reason k) (im_file im1))) im1) w1)))))))))
;; a parameter implemented by a private file of the sealed directory (its form recorded at load,
;; ld_forms): the same checks as for the implementation file's own form
(fn match_private ((l Load) (im Im) (k Symbol) (n Name) (sig SExpr)) (Pair Load Im)
  (if (bool_not (bool_or (sym_eq k (quote type)) (sym_eq k (quote fn)))) (Pair l im)
  (match (form_for l n)
    (None (Pair l im))
    ((Some (Pair _ _))
     (if (sym_eq k (quote type))
       (Pair (check_arity l n sig) (im_mark im (quote type) n))
       (check_signature l im sig n))))))
(fn missing_reason ((k Symbol)) Symbol
  (if (sym_eq k (quote type)) (quote impl_missing_type)
  (if (sym_eq k (quote fn)) (quote impl_missing_fn)
    (quote impl_missing_fulfills))))
;; consume the implementation's forms in order through the one that
;; implements (k, n); every form consumed is processed as the implementation's
(fn advance ((l Load) (im Im) (k Symbol) (n Name) (sig SExpr) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (measure fuel)
  (if (lt fuel 0) (Pair (Pair l im) w)
  (match (Im.impl im)
    (Nil (Pair (Pair l im) w))
    ((Cons s r)
     (match (impl_form l (im_with_impl im r) s fuel w)
       ((Pair (Pair l1 im1) w1)
        (if (im_marked im1 k n) (Pair (Pair l1 im1) w1)
          (match (ld_recs_head l1)
            ((Some (RReadErr _ _ _)) (Pair (Pair l1 im1) w1))
            ((Some (RLoadErr _ _ _)) (Pair (Pair l1 im1) w1))
            (_
             (match (match_private l1 im1 k n sig)   ; a directive may have loaded the private file that declares it
               ((Pair l2 im2)
                (if (im_marked im2 k n) (Pair (Pair l2 im2) w1)
                  (advance l2 im2 k n sig (- fuel 1) w1)))))))))))))
;; the implementation's remaining forms after the view's
(fn impl_rest ((l Load) (im Im) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (measure fuel)
  (if (lt fuel 0) (Pair (Pair l im) w)
  (match (Im.impl im)
    (Nil (Pair (Pair l im) w))
    ((Cons s r)
     (match (impl_form l (im_with_impl im r) s fuel w)
       ((Pair (Pair l1 im1) w1)
        (match (ld_recs_head l1)
          ((Some (RReadErr _ _ _)) (Pair (Pair l1 im1) w1))
          ((Some (RLoadErr _ _ _)) (Pair (Pair l1 im1) w1))
          (_ (impl_rest l1 im1 (- fuel 1) w1)))))))))
;; one implementation form: a directive as any; (type NAME …) implementing a
;; sig type — its parameter count checked; (fn NAME …) implementing a sig fn
;; — the E signatures compared, the parameter then admitted; (fulfills NAME
;; PROOF) — the requirement's statement re-read here, the proof checked or
;; pending; anything else the implementation's own
(fn impl_form ((l Load) (im Im) (s SExpr) (fuel Int) (w World)) (Pair (Pair Load Im) World)
  (let ((sc (fx_scope l (Im.fx im))) (h (form_head s)))
    (match (form_of s)
      (FDecl
       (if (sym_eq h (quote type))
         (match (load_decl l (Im.fx im) s)
           ((Pair l1 f1)
            (let ((n (form_name sc s)))
              (match (find_sig (Im.all im) sc (quote type) n)
                (None (Pair (Pair l1 (im_with_fx im f1)) w))
                ((Some sig)
                 (match (ld_recs_head l1)
                   ((Some (RReadErr _ _ _)) (Pair (Pair l1 (im_with_fx im f1)) w))
                   ((Some (RLoadErr _ _ _)) (Pair (Pair l1 (im_with_fx im f1)) w))
                   (_ (Pair (Pair (check_arity l1 n sig) (im_mark (im_with_fx im f1) (quote type) n)) w))))))))
       (if (sym_eq h (quote fn))
         (let ((n (form_name sc s)) (l0 (load_e_form l (Im.fx im) s)))
           (match (find_sig (Im.all im) sc (quote fn) n)
             (None (Pair (Pair l0 im) w))
             ((Some sig) (match (check_signature l0 im sig n) ((Pair l1 im1) (Pair (Pair l1 im1) w))))))
       (if (sym_eq h (quote fulfills))
         (match s
           ((SList (Cons _ (Cons (SSym x) (Cons proof Nil))))
            (match (name_of_sym x)
              (None (Pair (Pair (ld_rec l (RReadErr (im_file im) (quote bad_name) (chars_of_sym x))) im) w))
              ((Some short)
               (let ((n (qualify sc short)))
                 (match (find_sig (Im.all im) sc (quote requirement) n)
                   (None (Pair (Pair (ld_rec l (RImplErr n (quote fulfills_unknown) "no such requirement in the view")) im) w))
                   ((Some (SList (Cons _ rargs))) (match (fulfil l im n rargs proof) ((Pair l1 im1) (Pair (Pair l1 im1) w))))
                   (_ (Pair (Pair l im) w)))))))
           (_ (Pair (Pair (ld_rec l (RReadErr (im_file im) (quote bad_shape) "(fulfills NAME PROOF)")) im) w)))
         (match (load_decl l (Im.fx im) s) ((Pair l1 f1) (Pair (Pair l1 (im_with_fx im f1)) w)))))))
      (_ (match (load_forms l (Im.fx im) (list s) fuel w)
           ((Pair (Pair l1 (Some f1)) w1) (Pair (Pair l1 (im_with_fx im f1)) w1))
           ((Pair (Pair l1 None) w1) (Pair (Pair l1 im) w1)))))))
;; the view's (sig K NAME …) / (requirement NAME …) form for (k, n)
(fn find_sig ((forms (List SExpr)) (sc Scope) (k Symbol) (n Name)) (Option SExpr)
  (measure (struct forms))
  (match forms
    (Nil None)
    ((Cons s r)
     (let ((h (form_head s)))
       (if (bool_and (sym_eq h (quote sig)) (bool_not (sym_eq k (quote requirement))))
         (match (sig_kind_name sc s)
           ((Some (Pair k2 nn)) (if (bool_and (sym_eq k k2) (name_eq n nn)) (Some s) (find_sig r sc k n)))
           (None (find_sig r sc k n)))
       (if (bool_and (sym_eq h (quote requirement)) (sym_eq k (quote requirement)))
         (if (name_eq (form_name sc s) n) (Some s) (find_sig r sc k n))
         (find_sig r sc k n)))))))
;; (sig type (NAME T…)) against the implementation's (type (NAME T…) …): the parameter count —
;; of the admitted inductive, or of the E-only type where the fields cite a built-in with no L
;; constant in scope (§8.1 rule 1): such a type is an E parameter, as the sealed types of K are
(fn check_arity ((l Load) (n Name) (sig SExpr)) Load
  (match sig
    ((SList (Cons _ (Cons _ (Cons hd _))))
     (let ((want (match hd ((SList (Cons _ ps)) (len ps)) (_ 0))))
       (match (impl_type_arity (Load.env l) (Load.etab l) n)
         ((Some np)
          (if (int_eq np want) (ld_rec l (RDischarge n (quote type)))
            (ld_rec l (RImplErr n (quote impl_type_arity) (append "the view's " (append (show_nat want) (append ", the implementation's " (show_nat np))))))))
         (None l))))
    (_ l)))
(fn impl_type_arity ((env CheckedEnv) (es ESt) (n Name)) (Option Int)
  (match (env_find env n)
    ((Some (InductInfo _ _ np _ _ _ _ _ _)) (Some np))
    (_ (match (es_info es n) ((Some (EIInd np _)) (Some np)) (_ None)))))
;; (sig fn NAME BINDERS RET) against the implementation's fn: the E signatures — the sig's,
;; classified here in the fork where the sealed types are concrete, and the fn's E declaration
;; (the implementation file's, just loaded; a private file's, loaded by an import) — then the
;; parameter admitted to K where K can read the signature, an E parameter only where it cannot
(fn check_signature ((l Load) (im Im) (sig SExpr) (n Name)) (Pair Load Im)
  (let ((sc (fx_scope l (Im.fx im))))
    (match (classify_form (Load.etab l) sc (Load.env l) sig)
      ((CErr e m) (Pair (ld_rec l (RReadErr (im_file im) e m)) im))
      ((COk (ESig _ snt sps srt))
       (match (es_find_decl (Load.etab l) n)
         ((Some (EFn _ fnt fps frt _ _))
          (if (bool_and (int_eq snt fnt) (bool_and (etypes_eq sps fps) (etype_eq srt frt)))
            (match (read_decl sc (Load.env l) sig)
              ((RDParam d k a) (match (admit_param l (Im.fx im) d k a) ((Pair l1 f1) (Pair (ld_rec l1 (RDischarge n (quote fn))) (im_mark (im_with_fx im f1) (quote fn) n)))))
              (_ (Pair (ld_rec l (RDischarge n (quote fn))) (im_mark im (quote fn) n))))
            (Pair (ld_rec l (RImplErr n (quote impl_signature) "the implementation's E signature differs from the view's")) (im_mark im (quote fn) n))))
         (_ (Pair (ld_rec l (RImplErr n (quote impl_signature) "the implementation declares no fn of that name")) (im_mark im (quote fn) n)))))
      ((COk _) (Pair l im)))))
;; (fulfills NAME PROOF): the requirement's statement here, the proof a theorem or pending
(fn fulfil ((l Load) (im Im) (n Name) (rargs (List SExpr)) (proof SExpr)) (Pair Load Im)
  (let ((sc (fx_scope l (Im.fx im))))
    (match (read_fulfills sc (Load.env l) rargs proof)
      ((RDErr e m) (Pair (ld_rec l (RReadErr (im_file im) e m)) im))
      ((RDPending nn r) (Pair (ld_rec (ld_rec (ld_add_pending l nn) (RPending nn r)) (RDischarge n (quote pending))) (im_mark im (quote requirement) n)))
      ((RDOk ds)
       (match (admit_decls (Load.env l) ds)
         ((AdRefused subj reason) (Pair (ld_rec l (RRefuse subj reason)) (im_mark im (quote requirement) n)))
         ((AdOk env1)
          (match (policy_pass l (Im.fx im) env1 (Load.memo l) ds Nil)
            ((PolBound _) (Pair (ld_rec l (RLoadErr (im_file im) (quote closure_bound) (show_name n))) im))
            ((PolOut nn out) (Pair (ld_rec (ld_with_env l (Load.env l) (ax_memo_empty)) (RPolicy nn out)) (im_mark im (quote requirement) n)))
            ((PolOk memo1 recs)
             (Pair (ld_rec (recs_add (ld_with_tbl (ld_with_env l env1 memo1) (tbl_add_all (Load.tbl l) (decls_declare env1 ds) (Fx.module (Im.fx im)))) recs) (RDischarge n (quote proved)))
                   (im_mark (im_with_fx im (mix_recs (Im.fx im) recs)) (quote requirement) n)))))))
      (_ (Pair l im)))))

;; the forms in order; None when the file's loading ended in an error
(fn load_forms ((l Load) (f Fx) (forms (List SExpr)) (fuel Int) (w World)) (Pair (Pair Load (Option Fx)) World)
  (measure fuel)
  (match forms
    (Nil (Pair (Pair l (Some f)) w))
    ((Cons s r)
     (match (form_of s)
       ((FBad e m) (Pair (Pair (ld_rec l (RLoadErr (fx_file f) e m)) None) w))
       ((FUse p ms) (load_forms l (fx_open f (if (int_eq (len ms) 0) (OpenAll p) (OpenSome p ms))) r fuel w))
       ((FTrusts ns) (load_forms l (fx_trust f ns) r fuel w))
       ((FImportInit n)
        (match (init_through l n w)
          ((Pair (Pair l1 True) w1) (load_forms l1 (fx_see f Nil True) r fuel w1))
          ((Pair (Pair l1 False) w1) (Pair (Pair l1 None) w1))))
       ((FImportFile p)
        (match (import_file l f p (- fuel 1) w)
          ((Pair (Pair l1 (Some f1)) w1) (load_forms l1 f1 r fuel w1))
          ((Pair (Pair l1 None) w1) (Pair (Pair l1 None) w1))))
       (FDecl
        (match (load_decl l f s)
          ((Pair l1 f1)
           (match (ld_recs_head l1)
             ((Some (RReadErr _ _ _)) (Pair (Pair l1 None) w))
             ((Some (RLoadErr _ _ _)) (Pair (Pair l1 None) w))
             (_ (load_forms l1 f1 r fuel w))))))))))
(fn ld_recs_head ((l Load)) (Option Rec) (match (Load.recs l) (Nil None) ((Cons x _) (Some x))))

;; (import "PATH"): relative to the importing file's directory, under the root
(fn import_file ((l Load) (f Fx) (p (List Int)) (fuel Int) (w World)) (Pair (Pair Load (Option Fx)) World)
  (match p
    ((Cons 47 _) (Pair (Pair (ld_rec l (RLoadErr (fx_file f) (quote absolute_import) p)) None) w))
    (_
     (match (norm_parts (append (dir_of (Fx.parts f)) (split_path p Nil Nil)) Nil)
       (None (Pair (Pair (ld_rec l (RLoadErr (fx_file f) (quote import_outside_root) p)) None) w))
       ((Some rel)
        (match (module_of rel)
          ((MPOk _)
           (match (sealed_above l (dir_of (Fx.parts f)) rel w)
             ((Pair (Some d) w1)
              (Pair (Pair (ld_rec l (RLoadErr (fx_file f) (quote private_module) (append (join_path rel) (append " is inside the sealed directory " (append (join_path d) " — import the directory"))))) None) w1))
             ((Pair None w1)
              (if (bool_and (Fx.view f) (parts_under (dir_of rel) (view_dir (Fx.parts f))))
                (Pair (Pair (ld_rec l (RLoadErr (fx_file f) (quote req_scope) (append (join_path rel) ": a view imports directory modules, Init and plain files outside its own directory, never its implementation's"))) None) w1)
                (import_loaded l f rel fuel w1)))))
          (_ (import_loaded l f rel fuel w))))))))
;; The sealed-directory rule (§13 item 26, the K seal): a file inside a directory that has a
;; view — DIR/mod.req.shard or DIR/mod.req/mod.req.shard — is private to that directory,
;; importable from a file under DIR and refused as `private_module` from anywhere else; the
;; directory module `(import "DIR")` is the way in. The directories above the target are
;; tried from the root down; the importer's own directory and its ancestors are never sealed
;; against it.
;; the directory a view belongs to: its own, or the one above `mod.req/` for the dir form
(fn view_dir ((parts (List (List Int)))) (List (List Int))
  (let ((d (dir_of parts)))
    (match (rev d)
      ((Cons last above) (if (int_list_eq last "mod.req") (rev above) d))
      (Nil d))))
(fn sealed_above ((l Load) (importer (List (List Int))) (target (List (List Int))) (w World)) (Pair (Option (List (List Int))) World)
  (sealed_go l importer Nil target w))
(fn sealed_go ((l Load) (importer (List (List Int))) (acc (List (List Int))) (rest (List (List Int))) (w World)) (Pair (Option (List (List Int))) World)
  (measure (struct rest))
  (match rest
    (Nil (Pair None w))
    ((Cons _ Nil) (Pair None w))
    ((Cons p r)
     (let ((d (append acc (list p))))
       (if (parts_under importer d) (sealed_go l importer d r w)
         (match (has_view l d w)
           ((Pair True w1) (Pair (Some d) w1))
           ((Pair False w1) (sealed_go l importer d r w1))))))))
;; `a` is `d` or below it
(fn parts_under ((a (List (List Int))) (d (List (List Int)))) Bool
  (measure (struct d))
  (match d
    (Nil True)
    ((Cons x r) (match a ((Cons y s) (if (int_list_eq x y) (parts_under s r) False)) (Nil False)))))
(fn has_view ((l Load) (d (List (List Int))) (w World)) (Pair Bool World)
  (view_any l (view_candidates d) w))
(fn view_any ((l Load) (cands (List (List (List Int)))) (w World)) (Pair Bool World)
  (measure (struct cands))
  (match cands
    (Nil (Pair False w))
    ((Cons c r)
     (match (read_file (join_path (append (Load.root l) c)) w)
       ((Pair (Some _) w1) (Pair True w1))
       ((Pair None w1) (view_any l r w1))))))
(fn import_loaded ((l Load) (f Fx) (rel (List (List Int))) (fuel Int) (w World)) (Pair (Pair Load (Option Fx)) World)
  (match (load_module l rel fuel w)
    ((Pair l1 w1)
     (match (import_target rel)
       ((Some mp)
        (match (ld_find_mod (Load.mods l1) mp)
          ((Some m)
           (if (Mod.ok m)
             (Pair (Pair l1 (Some (fx_see f (Mod.closure m) (Mod.init m)))) w1)
             (Pair (Pair (ld_rec l1 (RLoadErr (fx_file f) (quote import_failed) (join_path rel))) None) w1)))
          (None (Pair (Pair (ld_rec l1 (RLoadErr (fx_file f) (quote import_failed) (join_path rel))) None) w1))))
       (None (Pair (Pair (ld_rec l1 (RLoadErr (fx_file f) (quote import_failed) (join_path rel))) None) w1))))))
;; the module an import path names: a file's path, a view's directory, a directory's
(fn import_target ((rel (List (List Int)))) (Option Name)
  (match (module_of rel)
    ((MPOk mp) (Some mp))
    ((MPView mp) (Some mp))
    (MPDir (match (dir_module rel) ((MPOk mp) (Some mp)) (_ None)))
    (_ None)))

;; ---- printing (the driver; the pins) --------------------------------------------------------
(fn show_names_c ((ns (List Name))) (List Int)
  (measure (struct ns))
  (match ns (Nil Nil) ((Cons n Nil) (show_name n)) ((Cons n r) (append (show_name n) (Cons 44 (show_names_c r))))))
(fn show_rec ((x Rec)) (List Int)
  (measure (struct x))
  (match x
    ((RModule m file h cl) (append "MODULE " (append (show_name m) (append " file=" (append file (append " hash=" (append (show_nat h) (append " sees=" (show_names_c cl)))))))))
    ((RUnused m ps) (append "UNUSED " (append (show_name m) (append " use=" (show_names_c ps)))))
    ((RInit n k) (append "INIT " (append (show_name n) (append ": " (append (show_nat k) " declarations admitted")))))
    ((RAccept n m h axs pfx ps)
     (append "ACCEPT " (append (show_name n) (append " module=" (append (show_name m) (append " hash=" (append (show_nat h)
       (append " axioms=" (append (show_names_c axs) (append " init=" (append (match pfx (Anon "-") (_ (show_name pfx))) (append " params=" (show_names_c ps)))))))))))))
    ((RParam n k a) (append "PARAM " (append (show_name n) (append " " (append (chars_of_sym k) (if (sym_eq k (quote type)) (append " arity=" (show_nat a)) Nil))))))
    ((RDischarge n k) (append "DISCHARGE " (append (show_name n) (append " " (chars_of_sym k)))))
    ((RImplErr n e m) (append "IMPL-ERROR " (append (show_name n) (append " " (append (chars_of_sym e) (append ": " m))))))
    ((RImplRec y) (append "IMPL " (show_rec y)))
    ((RRefuse n r) (append "REFUSE " (append (show_name n) (append " " (chars_of_sym r)))))
    ((RPolicy n out) (append "POLICY " (append (show_name n) (append " outside the policy: " (show_names_c out)))))
    ((RPending n r) (append "PENDING " (append (show_name n) (append " " (chars_of_sym r)))))
    ((RRun k n) (append "RUNNABLE " (append (chars_of_sym k) (append " " (show_name n)))))
    ((RClassify n e m) (append "REFUSE " (append (show_name n) (append " " (append (chars_of_sym e) (append ": " m))))))
    ((RRealize n k eqs roots) (append "REALIZE " (append (show_name n) (append " " (append (chars_of_sym k) (append " equations=" (append (show_names_c eqs) (match roots (Nil "") (_ (append " pending=" (show_names_c roots)))))))))))
    ((RReadErr file e m) (append "READ-ERROR " (append file (append " " (append (chars_of_sym e) (append ": " m))))))
    ((RLoadErr file e m) (append "LOAD-ERROR " (append file (append " " (append (chars_of_sym e) (append ": " m))))))))

;; counts: modules accepted runnable refused pending realized errors
(fn rec_counts ((rs (List Rec)) (acc (List Int))) (List Int)
  (measure (struct rs))
  (match rs
    (Nil acc)
    ((Cons x r) (rec_counts r (rec_count x acc)))))
(fn zero_counts () (List Int) (list 0 0 0 0 0 0 0))
(fn rec_count ((x Rec) (acc (List Int))) (List Int)
  (measure (struct x))
  (match acc
    ((Cons a (Cons b (Cons u (Cons c (Cons d (Cons e (Cons g Nil)))))))
     (match x
       ((RModule _ _ _ _) (list (+ a 1) b u c d e g))
       ((RAccept _ _ _ _ _ _) (list a (+ b 1) u c d e g))
       ((RParam _ _ _) (list a (+ b 1) u c d e g))
       ((RRun _ _) (list a b (+ u 1) c d e g))
       ((RClassify _ _ _) (list a b u (+ c 1) d e g))
       ((RRefuse _ _) (list a b u (+ c 1) d e g))
       ((RPolicy _ _) (list a b u (+ c 1) d e g))
       ((RPending _ _) (list a b u c (+ d 1) e g))
       ((RRealize _ _ _ _) (list a b u c d (+ e 1) g))
       ((RDischarge _ _) acc)
       ((RImplErr _ _ _) (list a b u c d e (+ g 1)))
       ((RImplRec y) (rec_count y acc))
       ((RReadErr _ _ _) (list a b u c d e (+ g 1)))
       ((RLoadErr _ _ _) (list a b u c d e (+ g 1)))
       ((RInit _ _) acc)
       ((RUnused _ _) acc)))
    (_ acc)))
(fn show_counts_load ((cs (List Int))) (List Int)
  (match cs
    ((Cons a (Cons b (Cons u (Cons c (Cons d (Cons e (Cons g Nil)))))))
     (append "modules " (append (show_nat a) (append "  accepted " (append (show_nat b) (append "  runnable " (append (show_nat u) (append "  refused " (append (show_nat c)
       (append "  pending " (append (show_nat d) (append "  realized " (append (show_nat e) (append "  errors " (show_nat g)))))))))))))))
    (_ "")))
;; the exit code: refused (policy included) plus errors
(fn load_failures ((cs (List Int))) Int
  (match cs ((Cons _ (Cons _ (Cons _ (Cons c (Cons _ (Cons _ (Cons g Nil))))))) (+ c g)) (_ 1)))
