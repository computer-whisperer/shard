;;; v3/kernel/json.shard — a JSON reader over UTF-8 bytes, for the
;;; lean4export NDJSON (format 3.1.0): K's record import, the Init index
;;; and load on demand. With K's import it is
;;; in the trust base (docs/KERNEL.md "The trust base, file by file").
;;; Numbers are kept as their digit strings (natVal literals can exceed
;;; any fixed width); objects keep their key order.

(import "util.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.util)

(type Json
  (JNull)
  (JBool Bool)
  (JNum (List Int))  ; the number's characters
  (JStr (List Int))  ; UTF-8 bytes, escapes decoded
  (JArr (List Json))
  (JObj (List (Prod (List Int) Json))))

;; the parse result: value and the remaining input, or None on malformed input
(type JRes (JRes Json (List Int)) (JErr))

(fn skip_ws ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    ((cons c r) (if (is_ws c) (skip_ws r) bs))
    (nil nil)))

;; one value from the input. The three functions that read a value, an array and an object go
;; on from the rest a call of their own returned, so what bounds them is handed down beside the
;; input: `fuel`, the input as `json_parse` was given it, less a byte at each call made after a
;; byte was read (a value's call of its array or object, an array's or an object's call of
;; itself for the next member). What is left to read is never longer than `fuel`: where it is
;; empty so is the input, which is no value, and no input is refused for it.
(fn json_parse ((bs (List Int))) JRes (parse_value bs bs))

(fn parse_value ((bs0 (List Int)) (fuel (List Int))) JRes
  (measure (* 2 (List.length fuel)))
  (match fuel
    (nil JErr)
    ((cons _ fl)
     (let ((bs (skip_ws bs0)))
       (match bs
         (nil JErr)
         ((cons c r)
          (if (= c 123) (parse_object r nil fl)
          (if (= c 91) (parse_array r nil fl)
          (if (= c 34)
            (match (parse_string r nil)
              ((some (Prod.mk s rest)) (JRes (JStr s) rest))
              (none JErr))
          (if (bool_or (is_digit c) (= c 45)) (parse_number bs nil)
          (match (starts_with_lit (utf8 "true") bs)
            ((some rest) (JRes (JBool true) rest))
            (none
              (match (starts_with_lit (utf8 "false") bs)
                ((some rest) (JRes (JBool false) rest))
                (none
                  (match (starts_with_lit (utf8 "null") bs)
                    ((some rest) (JRes JNull rest))
                    (none JErr))))))))))))))))

(fn parse_number ((bs (List Int)) (acc (List Int))) JRes
  (measure (struct bs))
  (match bs
    ((cons c r)
     (if
       (bool_or (is_digit c)
         (bool_or (= c 45) (bool_or (= c 46) (bool_or (= c 101) (bool_or (= c 69) (= c 43))))))
       (parse_number r (cons c acc))
       (JRes (JNum (rev acc)) bs)))
    (nil (JRes (JNum (rev acc)) nil))))

;; after the opening quote; escapes decoded; \uXXXX (with surrogate pairs) to UTF-8
(fn parse_string ((bs (List Int)) (acc (List Int))) (Option (Prod (List Int) (List Int)))
  (measure (List.length bs))
  (match bs
    (nil none)
    ((cons c r)
     (if (= c 34) (some (Prod.mk (rev acc) r))
     (if (= c 92)
       (match r
         (nil none)
         ((cons e r2)
          (if (= e 117)
            (match (parse_hex4 r2)
              (none none)
              ((some (Prod.mk cp r3))
               (if (bool_and (<= 55296 cp) (<= cp 56319))
                 ;; high surrogate: expect \uDCxx
                 (match r3
                   ((cons b1 (cons b2 r4))
                    (if (bool_and (= b1 92) (= b2 117))
                      (match (parse_hex4 r4)
                        ((some (Prod.mk lo r5))
                         (parse_string r5
                           (rev_onto (utf8_encode (+ 65536 (+ (* (- cp 55296) 1024) (- lo 56320))))
                             acc)))
                        (none none))
                      none))
                   (_ none))
                 (parse_string r3 (rev_onto (utf8_encode cp) acc)))))
            (parse_string r2 (cons (unescape e) acc)))))
       (parse_string r (cons c acc)))))))

(fn unescape ((e Int)) Int
  (if (= e 110) 10
  (if (= e 116) 9
  (if (= e 114) 13
  (if (= e 98) 8
  (if (= e 102) 12
  e))))))

(fn parse_hex4 ((bs (List Int))) (Option (Prod Int (List Int)))
  (match bs
    ((cons a (cons b (cons c (cons d r))))
     (let ((v (+ (* (hex_val a) 4096) (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))))
       (if (< v 0) none (some (Prod.mk v r)))))
    (_ none)))
;; the rest `parse_hex4` leaves is no longer than what it was given: `parse_string` goes on
;; from it after a `\u` escape
(theorem parse_hex4_le
  ((bs (List Int)) (cp Int) (rest (List Int)) (h (= (parse_hex4 bs) (some (Prod.mk cp rest)))))
  (<= (List.length rest) (List.length bs))
  (by
    (cases bs
      ((nil () (exact (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl false)))))
       (cons (a t1)
         (cases t1
           ((nil ()
              (exact (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl false)))))
            (cons (b t2)
              (cases t2
                ((nil ()
                   (exact (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl false)))))
                 (cons (c t3)
                   (cases t3
                     ((nil ()
                        (exact
                          (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl false)))))
                      (cons (d r)
                        (have e0
                          (= (parse_hex4 (cons a (cons b (cons c (cons d r)))))
                            (if
                              (<
                                (+ (* (hex_val a) 4096)
                                  (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                                0)
                              none
                              (some
                                (Prod.mk
                                  (+ (* (hex_val a) 4096)
                                    (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                                  r))))
                          rfl)
                        (cases
                          (Int.decLt
                            (+ (* (hex_val a) 4096)
                              (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                            0)
                          ((isFalse (hn)
                             (have e1
                               (= (parse_hex4 (cons a (cons b (cons c (cons d r)))))
                                 (some
                                   (Prod.mk
                                     (+ (* (hex_val a) 4096)
                                       (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                                     r)))
                               (rw e0)
                               (rw (if_neg hn))
                               rfl)
                             (have e2
                               (=
                                 (some
                                   (Prod.mk
                                     (+ (* (hex_val a) 4096)
                                       (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                                     r))
                                 (some (Prod.mk cp rest)))
                               (rw (<- e1))
                               (exact h))
                             (have e3
                               (=
                                 (Prod.mk
                                   (+ (* (hex_val a) 4096)
                                     (+ (* (hex_val b) 256) (+ (* (hex_val c) 16) (hex_val d))))
                                   r)
                                 (Prod.mk cp rest))
                               (exact (Option.some.inj e2)))
                             (have er (= r rest) (exact (congrArg Prod.snd e3)))
                             (rw (<- er))
                             (simp_only List.length_cons)
                             (arith))
                           (isTrue (hc)
                             (have e1 (= (parse_hex4 (cons a (cons b (cons c (cons d r))))) none)
                               (rw e0)
                               (rw (if_pos hc))
                               rfl)
                             (have e2 (= (@none (Prod Int (List Int))) (some (Prod.mk cp rest)))
                               (rw (<- e1))
                               (exact h))
                             (exact
                               (absurd (congrArg Option.isSome e2)
                                 (ne_true_of_eq_false (Eq.refl false)))))))))))))))))))))

(fn utf8_encode ((cp Int)) (List Int)
  (if (< cp 128) (list cp)
  (if (< cp 2048) (list (+ 192 (/ cp 64)) (+ 128 (mod cp 64)))
  (if (< cp 65536) (list (+ 224 (/ cp 4096)) (+ 128 (mod (/ cp 64) 64)) (+ 128 (mod cp 64)))
  (list (+ 240 (/ cp 262144)) (+ 128 (mod (/ cp 4096) 64)) (+ 128 (mod (/ cp 64) 64))
    (+ 128 (mod cp 64)))))))
(fulfills parse_string.dec_1 (by (intro p c r h n1 n2) (rw h) (rw List.length_cons) (arith)))
(fulfills parse_string.dec_2
  (by (intro p c r h n1 hc e r2 h2 ne) (rw h) (rw h2) (simp_only List.length_cons) (arith)))
(fulfills parse_string.dec_3
  (by
    (intro p c r h n1 hc e r2 h2 he cp r3 hp hs)
    (have g (<= (List.length r3) (List.length r2)) (exact (parse_hex4_le r2 cp r3 hp)))
    (rw h)
    (rw h2)
    (simp_only List.length_cons)
    (arith)))
(fulfills parse_string.dec_4
  (by
    (intro p c r h n1 hc e r2 h2 he cp r3 hp hs b1 b2 r4 h3 hb lo r5 hq)
    (have g (<= (List.length r3) (List.length r2)) (exact (parse_hex4_le r2 cp r3 hp)))
    (have g2 (<= (List.length r5) (List.length r4)) (exact (parse_hex4_le r4 lo r5 hq)))
    (have g3 (= (List.length r3) (+ (+ (List.length r4) 1) 1))
      (rw h3)
      (simp_only List.length_cons)
      rfl)
    (rw h)
    (rw h2)
    (simp_only List.length_cons)
    (arith)))

(fn parse_array ((bs0 (List Int)) (acc (List Json)) (fuel (List Int))) JRes
  (measure (+ (* 2 (List.length fuel)) 1))
  (match fuel
    (nil JErr)
    ((cons _ fl)
     (let ((bs (skip_ws bs0)))
       (match (starts_with_lit (utf8 "]") bs)
         ((some r) (JRes (JArr (rev acc)) r))
         (none
           (match (parse_value bs fuel)
             (JErr JErr)
             ((JRes v rest)
              (match (skip_ws rest)
                ((cons c r2)
                 (if (= c 44) (parse_array r2 (cons v acc) fl)
                 (if (= c 93) (JRes (JArr (rev (cons v acc))) r2)
                 JErr)))
                (nil JErr))))))))))

(fn parse_object ((bs0 (List Int)) (acc (List (Prod (List Int) Json))) (fuel (List Int))) JRes
  (measure (+ (* 2 (List.length fuel)) 1))
  (match fuel
    (nil JErr)
    ((cons _ fl)
     (let ((bs (skip_ws bs0)))
       (match bs
         ((cons c r)
          (if (= c 125) (JRes (JObj (rev acc)) r)
          (if (= c 34)
            (match (parse_string r nil)
              (none JErr)
              ((some (Prod.mk key rest))
               (match (skip_ws rest)
                 ((cons c2 r2)
                  (if (= c2 58)
                    (match (parse_value r2 fuel)
                      (JErr JErr)
                      ((JRes v rest2)
                       (match (skip_ws rest2)
                         ((cons c3 r3)
                          (if (= c3 44) (parse_object r3 (cons (Prod.mk key v) acc) fl)
                          (if (= c3 125) (JRes (JObj (rev (cons (Prod.mk key v) acc))) r3)
                          JErr)))
                         (nil JErr))))
                    JErr))
                 (nil JErr))))
            JErr)))
         (nil JErr))))))
(fulfills parse_value.dec_1
  (by (intro bs0 fuel w fl hf c r h n1 hc) (rw hf) (rw List.length_cons) (arith)))
(fulfills parse_value.dec_2
  (by (intro bs0 fuel w fl hf c r h hc) (rw hf) (rw List.length_cons) (arith)))
(fulfills parse_array.dec_1 (by (intro bs0 acc fuel w fl hf hn) (arith)))
(fulfills parse_array.dec_2
  (by (intro bs0 acc fuel w fl hf hn v rest c r2 h hc) (rw hf) (rw List.length_cons) (arith)))
(fulfills parse_object.dec_1
  (by (intro bs0 acc fuel w fl hf c r h n1 hc key rest hp c2 r2 h2 hc2) (arith)))
(fulfills parse_object.dec_2
  (by
    (intro bs0 acc fuel w fl hf c r h n1 hc key rest hp c2 r2 h2 hc2 v rest2 c3 r3 h3 hc3)
    (rw hf)
    (rw List.length_cons)
    (arith)))

;; ---- what a parse leaves ----------------------------------------------------
;; A parsed value leaves less input than it was given (`json_parse_lt`, the last of these):
;; what a reader descends by that parses record after record off one input (k/import.shard
;; `process_lines`). Each proof follows its function branch by branch with the call standing in
;; the target, so a result is measured by one number: `jres_room`, the length of what was left
;; and one more, 0 for an error. "The room is at most the input's length" then says that the
;; rest is shorter, and holds of an error too.
(def jres_room ((r JRes)) Nat
  (match r
    ((JRes j rest) (+ (List.length rest) 1))
    (JErr 0)))
(theorem jres_room_res ((j Json) (rest (List Int)))
  (= (jres_room (JRes j rest)) (+ (List.length rest) 1))
  (by rfl))
;; the comparison a room states, for a result known by its equation
(theorem jres_room_at
  ((res JRes)
   (v Json)
   (rest (List Int))
   (n Nat)
   (h (= res (JRes v rest)))
   (g (<= (jres_room res) n)))
  (<= (+ (List.length rest) 1) n)
  (by (have g2 (<= (jres_room (JRes v rest)) n) (rw (<- h)) (exact g)) (exact g2)))
;; blanks skipped: no longer, and where a byte is left the tail is shorter
(theorem skip_ws_le ((bs (List Int))) (<= (List.length (skip_ws bs)) (List.length bs))
  (by
    (induction bs
      ((nil () (rw skip_ws.eq_1) (arith))
       (cons (c r ih) (rw skip_ws.eq_2)
         (cases (is_ws c)
           ((false () (reduce) (arith)) (true () (reduce) (rw List.length_cons) (arith)))))))))
(theorem skip_ws_cons ((bs (List Int)) (c Int) (r (List Int)) (h (= (skip_ws bs) (cons c r))))
  (<= (+ (List.length r) 1) (List.length bs))
  (by
    (have g (<= (List.length (cons c r)) (List.length bs)) (rw (<- h)) (exact (skip_ws_le bs)))
    (have e (= (List.length (cons c r)) (+ (List.length r) 1)) (rw List.length_cons) rfl)
    (arith)))
;; a number leaves no more than it was given — it may read nothing —, and less where its first
;; byte is one a value takes for a number's (`num_start`: such a byte is one the number reads)
(theorem parse_number_room ((bs (List Int)))
  (forall ((acc (List Int))) (<= (jres_room (parse_number bs acc)) (+ (List.length bs) 1)))
  (by
    (induction bs
      ((nil () (intro acc) (rw parse_number.eq_1) (rw jres_room_res) (arith))
       (cons (c r ih) (intro acc) (rw parse_number.eq_2)
         (cases
           (bool_or (is_digit c)
             (bool_or (= c 45) (bool_or (= c 46) (bool_or (= c 101) (bool_or (= c 69) (= c 43))))))
           ((false () (reduce) (rw jres_room_res) (arith))
            (true () (reduce) (rw List.length_cons) (arith (ih (cons c acc)))))))))))
(theorem num_start ((c Int))
  (-> (= (bool_or (is_digit c) (= c 45)) true)
    (=
      (bool_or (is_digit c)
        (bool_or (= c 45) (bool_or (= c 46) (bool_or (= c 101) (bool_or (= c 69) (= c 43))))))
      true))
  (by
    (cases (is_digit c)
      ((false ()
         (cases (Int.decEq c 45)
           ((isFalse (hn) (intro h) (exact (absurd h (ne_true_of_eq_false (Eq.refl false)))))
            (isTrue (hc) (intro h) rfl))))
       (true () (intro h) rfl)))))
;; a string leaves less than it was given: its closing quote at least. `pstr_room` is
;; `jres_room` for its result
(def pstr_room ((o (Option (Prod (List Int) (List Int))))) Nat
  (match o
    (none 0)
    ((some (Prod.mk s rest)) (+ (List.length rest) 1))))
(theorem pstr_room_some ((s (List Int)) (rest (List Int)))
  (= (pstr_room (some (Prod.mk s rest))) (+ (List.length rest) 1))
  (by rfl))
(theorem pstr_room_at
  ((o (Option (Prod (List Int) (List Int))))
   (s (List Int))
   (rest (List Int))
   (n Nat)
   (h (= o (some (Prod.mk s rest))))
   (g (<= (pstr_room o) n)))
  (<= (+ (List.length rest) 1) n)
  (by (have g2 (<= (pstr_room (some (Prod.mk s rest))) n) (rw (<- h)) (exact g)) (exact g2)))
(theorem parse_string_room ((bs (List Int)))
  (forall ((acc (List Int))) (<= (pstr_room (parse_string bs acc)) (List.length bs)))
  (by
    (wf bs (List.length bs) ih (intro acc)
      (cases bs
        ((nil () (rw parse_string.eq_1) (reduce) (arith))
         (cons (c r) (rw parse_string.eq_2)
           (have l1 (< (List.length r) (List.length (cons c r))) (rw List.length_cons) (arith))
           (cases (Int.decEq c 34)
             ((isTrue (hq) (reduce) (rw pstr_room_some) (rw List.length_cons) (arith))
              (isFalse (hq) (reduce)
                (cases (Int.decEq c 92)
                  ((isFalse (hb) (reduce) (arith (ih r l1 (cons c acc))))
                   (isTrue (hb) (reduce)
                     (cases r
                       ((nil () (reduce) (arith))
                        (cons (e r2) (reduce)
                          (cases (Int.decEq e 117)
                            ((isFalse (hu) (reduce)
                               (have l2 (< (List.length r2) (List.length (cons c (cons e r2))))
                                 (simp_only List.length_cons)
                                 (arith))
                               (arith (ih r2 l2 (cons (unescape e) acc))))
                             (isTrue (hu) (reduce)
                               (cases (parse_hex4 r2) hp
                                 ((none () (reduce) (arith))
                                  (some (p)
                                    (cases p
                                      ((mk (cp r3) (reduce)
                                         (have g (<= (List.length r3) (List.length r2))
                                           (exact (parse_hex4_le r2 cp r3 hp)))
                                         (cases (bool_and (<= 55296 cp) (<= cp 56319))
                                           ((false () (reduce)
                                              (have l3
                                                (< (List.length r3)
                                                  (List.length (cons c (cons e r2))))
                                                (simp_only List.length_cons)
                                                (arith))
                                              (arith (ih r3 l3 (rev_onto (utf8_encode cp) acc))))
                                            (true () (reduce)
                                              (cases r3
                                                ((nil () (reduce) (arith))
                                                 (cons (b1 t)
                                                   (cases t
                                                     ((nil () (reduce) (arith))
                                                      (cons (b2 r4) (reduce)
                                                        (cases (bool_and (= b1 92) (= b2 117))
                                                          ((false () (reduce) (arith))
                                                           (true () (reduce)
                                                             (cases (parse_hex4 r4) hq2
                                                               ((none () (reduce) (arith))
                                                                (some (q)
                                                                  (cases q
                                                                    ((mk (lo r5) (reduce)
                                                                       (have g2
                                                                         (<= (List.length r5)
                                                                           (List.length r4))
                                                                         (exact
                                                                           (parse_hex4_le r4 lo r5
                                                                             hq2)))
                                                                       (have g3
                                                                         (=
                                                                           (List.length
                                                                             (cons b1 (cons b2 r4)))
                                                                           (+ (+ (List.length r4) 1)
                                                                             1))
                                                                         (simp_only List.length_cons)
                                                                         rfl)
                                                                       (have l4
                                                                         (< (List.length r5)
                                                                           (List.length
                                                                             (cons c (cons e r2))))
                                                                         (simp_only List.length_cons)
                                                                         (arith))
                                                                       (arith
                                                                         (ih r5 l4
                                                                           (rev_onto
                                                                             (utf8_encode
                                                                               (+ 65536
                                                                                 (+
                                                                                   (* (- cp 55296)
                                                                                     1024)
                                                                                   (- lo 56320))))
                                                                             acc)))))))))))))))))))))))))))))))))))))))))))))
;; the three functions, one step of the fuel each: a value by what an array and an object leave
;; at the fuel less a byte; an array and an object by what a value leaves at the fuel they have
;; (its call is kept as written while the body around it is run: `reduce` would unfold it by its
;; equation) and by themselves at the fuel less a byte
(theorem parse_value_step
  ((x Int)
   (fl (List Int))
   (ha
     (forall ((bs0 (List Int)) (acc (List Json)))
       (<= (jres_room (parse_array bs0 acc fl)) (List.length bs0))))
   (ho
     (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
       (<= (jres_room (parse_object bs0 acc fl)) (List.length bs0)))))
  (forall ((bs0 (List Int))) (<= (jres_room (parse_value bs0 (cons x fl))) (List.length bs0)))
  (by
    (intro bs0)
    (rw parse_value.eq_2)
    (cases (skip_ws bs0) hs
      ((nil () (reduce) (arith))
       (cons (c r) (reduce (keep starts_with_lit))
         (have g0 (<= (+ (List.length r) 1) (List.length bs0)) (exact (skip_ws_cons bs0 c r hs)))
         (have e0 (= (List.length (cons c r)) (+ (List.length r) 1)) (rw List.length_cons) rfl)
         (cases (Int.decEq c 123)
           ((isTrue (h1) (reduce) (arith (ho r nil)))
            (isFalse (h1) (reduce (keep starts_with_lit))
              (cases (Int.decEq c 91)
                ((isTrue (h2) (reduce) (arith (ha r nil)))
                 (isFalse (h2) (reduce (keep starts_with_lit))
                   (cases (Int.decEq c 34)
                     ((isTrue (h3) (reduce)
                        (cases (parse_string r nil) hp
                          ((none () (reduce) (arith))
                           (some (p)
                             (cases p
                               ((mk (s rest) (reduce) (rw jres_room_res)
                                  (arith
                                    (pstr_room_at (parse_string r nil) s rest (List.length r) hp
                                      (parse_string_room r nil))))))))))
                      (isFalse (h3) (reduce (keep starts_with_lit))
                        (cases (bool_or (is_digit c) (= c 45)) hd
                          ((true () (reduce)
                             (cases
                               (bool_or (is_digit c)
                                 (bool_or (= c 45)
                                   (bool_or (= c 46) (bool_or (= c 101) (bool_or (= c 69) (= c 43))))))
                               hb
                               ((false () (exact (absurd (num_start c hd) (ne_true_of_eq_false hb))))
                                (true () (reduce) (arith (parse_number_room r (cons c nil)))))))
                           (false () (reduce (keep starts_with_lit))
                             (cases (starts_with_lit (list 116 114 117 101) (cons c r)) hl
                               ((some (rest) (reduce) (rw jres_room_res)
                                  (arith
                                    (starts_with_lit_lt 116 (list 114 117 101) (cons c r) rest hl)))
                                (none () (reduce (keep starts_with_lit))
                                  (cases (starts_with_lit (list 102 97 108 115 101) (cons c r)) hl2
                                    ((some (rest) (reduce) (rw jres_room_res)
                                       (arith
                                         (starts_with_lit_lt 102 (list 97 108 115 101) (cons c r)
                                           rest
                                           hl2)))
                                     (none () (reduce (keep starts_with_lit))
                                       (cases (starts_with_lit (list 110 117 108 108) (cons c r))
                                         hl3
                                         ((some (rest) (reduce) (rw jres_room_res)
                                            (arith
                                              (starts_with_lit_lt 110 (list 117 108 108) (cons c r)
                                                rest
                                                hl3)))
                                          (none () (reduce) (arith)))))))))))))))))))))))))))
(theorem parse_array_step
  ((x Int)
   (fl (List Int))
   (hv (forall ((bs0 (List Int))) (<= (jres_room (parse_value bs0 (cons x fl))) (List.length bs0))))
   (ha
     (forall ((bs0 (List Int)) (acc (List Json)))
       (<= (jres_room (parse_array bs0 acc fl)) (List.length bs0)))))
  (forall ((bs0 (List Int)) (acc (List Json)))
    (<= (jres_room (parse_array bs0 acc (cons x fl))) (List.length bs0)))
  (by
    (intro bs0 acc)
    (rw parse_array.eq_2)
    (reduce (keep parse_value))
    (cases (starts_with_lit (list 93) (skip_ws bs0)) hl
      ((some (r) (reduce) (rw jres_room_res)
         (arith (starts_with_lit_lt 93 nil (skip_ws bs0) r hl) (skip_ws_le bs0)))
       (none () (reduce (keep parse_value))
         (cases (parse_value (skip_ws bs0) (cons x fl)) hpv
           ((JErr () (reduce) (arith))
            (JRes (v rest) (reduce)
              (have g1 (<= (+ (List.length rest) 1) (List.length (skip_ws bs0)))
                (exact
                  (jres_room_at (parse_value (skip_ws bs0) (cons x fl)) v rest
                    (List.length (skip_ws bs0))
                    hpv
                    (hv (skip_ws bs0)))))
              (cases (skip_ws rest) hs2
                ((nil () (reduce) (arith))
                 (cons (c2 r2) (reduce)
                   (have g2 (<= (+ (List.length r2) 1) (List.length rest))
                     (exact (skip_ws_cons rest c2 r2 hs2)))
                   (cases (Int.decEq c2 44)
                     ((isTrue (h1) (reduce) (arith (ha r2 (cons v acc)) (skip_ws_le bs0)))
                      (isFalse (h1) (reduce)
                        (cases (Int.decEq c2 93)
                          ((isTrue (h2) (reduce) (rw jres_room_res) (arith (skip_ws_le bs0)))
                           (isFalse (h2) (reduce) (arith))))))))))))))))))
(theorem parse_object_step
  ((x Int)
   (fl (List Int))
   (hv (forall ((bs0 (List Int))) (<= (jres_room (parse_value bs0 (cons x fl))) (List.length bs0))))
   (ho
     (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
       (<= (jres_room (parse_object bs0 acc fl)) (List.length bs0)))))
  (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
    (<= (jres_room (parse_object bs0 acc (cons x fl))) (List.length bs0)))
  (by
    (intro bs0 acc)
    (rw parse_object.eq_2)
    (cases (skip_ws bs0) hs
      ((nil () (reduce) (arith))
       (cons (c r) (reduce)
         (have g0 (<= (+ (List.length r) 1) (List.length bs0)) (exact (skip_ws_cons bs0 c r hs)))
         (cases (Int.decEq c 125)
           ((isTrue (h1) (reduce) (rw jres_room_res) (arith))
            (isFalse (h1) (reduce)
              (cases (Int.decEq c 34)
                ((isFalse (h2) (reduce) (arith))
                 (isTrue (h2) (reduce)
                   (cases (parse_string r nil) hp
                     ((none () (reduce) (arith))
                      (some (p)
                        (cases p
                          ((mk (key rest) (reduce)
                             (have g1 (<= (+ (List.length rest) 1) (List.length r))
                               (exact
                                 (pstr_room_at (parse_string r nil) key rest (List.length r) hp
                                   (parse_string_room r nil))))
                             (cases (skip_ws rest) hs2
                               ((nil () (reduce) (arith))
                                (cons (c2 r2) (reduce (keep parse_value))
                                  (have g2 (<= (+ (List.length r2) 1) (List.length rest))
                                    (exact (skip_ws_cons rest c2 r2 hs2)))
                                  (cases (Int.decEq c2 58)
                                    ((isFalse (h3) (reduce) (arith))
                                     (isTrue (h3) (reduce (keep parse_value))
                                       (cases (parse_value r2 (cons x fl)) hpv
                                         ((JErr () (reduce) (arith))
                                          (JRes (v rest2) (reduce)
                                            (have g3 (<= (+ (List.length rest2) 1) (List.length r2))
                                              (exact
                                                (jres_room_at (parse_value r2 (cons x fl)) v rest2
                                                  (List.length r2)
                                                  hpv
                                                  (hv r2))))
                                            (cases (skip_ws rest2) hs3
                                              ((nil () (reduce) (arith))
                                               (cons (c3 r3) (reduce)
                                                 (have g4
                                                   (<= (+ (List.length r3) 1) (List.length rest2))
                                                   (exact (skip_ws_cons rest2 c3 r3 hs3)))
                                                 (cases (Int.decEq c3 44)
                                                   ((isTrue (h4) (reduce)
                                                      (arith (ho r3 (cons (Prod.mk key v) acc))))
                                                    (isFalse (h4) (reduce)
                                                      (cases (Int.decEq c3 125)
                                                        ((isTrue (h5) (reduce) (rw jres_room_res)
                                                           (arith))
                                                         (isFalse (h5) (reduce) (arith))))))))))))))))))))))))))))))))))))
;; a value, an array and an object each leave less than they were given, whatever the fuel: by
;; induction on the fuel, the three together
(theorem parse_room ((fuel (List Int)))
  (And (forall ((bs0 (List Int))) (<= (jres_room (parse_value bs0 fuel)) (List.length bs0)))
    (And
      (forall ((bs0 (List Int)) (acc (List Json)))
        (<= (jres_room (parse_array bs0 acc fuel)) (List.length bs0)))
      (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
        (<= (jres_room (parse_object bs0 acc fuel)) (List.length bs0)))))
  (by
    (induction fuel
      ((nil ()
         (apply And.intro ((intro bs0) (rw parse_value.eq_1) (reduce) (arith))
           ((apply And.intro ((intro bs0 acc) (rw parse_array.eq_1) (reduce) (arith))
              ((intro bs0 acc) (rw parse_object.eq_1) (reduce) (arith))))))
       (cons (x fl ih)
         (have hv
           (forall ((bs0 (List Int)))
             (<= (jres_room (parse_value bs0 (cons x fl))) (List.length bs0)))
           (exact (parse_value_step x fl (And.left (And.right ih)) (And.right (And.right ih)))))
         (apply And.intro (exact hv)
           (apply And.intro (exact (parse_array_step x fl hv (And.left (And.right ih))))
             (exact (parse_object_step x fl hv (And.right (And.right ih)))))))))))
(theorem parse_value_room ((fuel (List Int)) (bs0 (List Int)))
  (<= (jres_room (parse_value bs0 fuel)) (List.length bs0))
  (by
    (have g (forall ((bs (List Int))) (<= (jres_room (parse_value bs fuel)) (List.length bs)))
      (exact (And.left (parse_room fuel))))
    (exact (g bs0))))
;; a parsed value leaves less input than it was given: what a reader that parses record after
;; record off one input descends by
(theorem json_parse_lt
  ((bs (List Int)) (j Json) (rest (List Int)) (h (= (json_parse bs) (JRes j rest))))
  (< (List.length rest) (List.length bs))
  (by
    (have h2 (= (parse_value bs bs) (JRes j rest)) (exact h))
    (arith (jres_room_at (parse_value bs bs) j rest (List.length bs) h2 (parse_value_room bs bs)))))

;; ---- the fuel ---------------------------------------------------------------
;; The parse of an input is its parse at every fuel as long as the input or longer
;; (`json_parse_fuel`, the last of these): the fuel `json_parse` hands down is never what an
;; answer turns on. Two fuels are compared with both calls in the target, unfolded side by
;; side: where the two bodies agree `rfl` closes the branch, and where they call on at the fuel
;; less a byte, what they call on is short enough for both by the facts above.
;; an input no longer than the empty fuel is empty, and of the empty input every fuel makes an
;; error
(theorem nil_of_len ((bs (List Int)) (h (<= (List.length bs) (List.length (@nil Int))))) (= bs nil)
  (by
    (cases bs
      ((nil () rfl)
       (cons (c r)
         (have e1 (= (List.length (cons c r)) (+ (List.length r) 1)) (rw List.length_cons) rfl)
         (have e2 (= (List.length (@nil Int)) 0) (rw List.length_nil) rfl)
         (have ff False (arith))
         (exact (False.elim ff)))))))
(theorem parse_value_nil ((g (List Int))) (= (parse_value nil g) JErr)
  (by
    (cases g ((nil () (rw parse_value.eq_1) rfl) (cons (y gl) (rw parse_value.eq_2) (reduce) rfl)))))
(theorem parse_array_nil ((acc (List Json)) (g (List Int))) (= (parse_array nil acc g) JErr)
  (by
    (cases g ((nil () (rw parse_array.eq_1) rfl) (cons (y gl) (rw parse_array.eq_2) (reduce) rfl)))))
(theorem parse_object_nil ((acc (List (Prod (List Int) Json))) (g (List Int)))
  (= (parse_object nil acc g) JErr)
  (by
    (cases g ((nil () (rw parse_object.eq_1) rfl) (cons (y gl) (rw parse_object.eq_2) (reduce) rfl)))))
;; the three functions, one step of both fuels each, as the steps above
(theorem fuel_step_value
  ((x Int)
   (fl (List Int))
   (y Int)
   (gl (List Int))
   (ha
     (forall ((bs0 (List Int)) (acc (List Json)))
       (-> (<= (List.length bs0) (List.length fl))
         (-> (<= (List.length bs0) (List.length gl))
           (= (parse_array bs0 acc fl) (parse_array bs0 acc gl))))))
   (ho
     (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
       (-> (<= (List.length bs0) (List.length fl))
         (-> (<= (List.length bs0) (List.length gl))
           (= (parse_object bs0 acc fl) (parse_object bs0 acc gl)))))))
  (forall ((bs0 (List Int)))
    (-> (<= (List.length bs0) (List.length (cons x fl)))
      (-> (<= (List.length bs0) (List.length (cons y gl)))
        (= (parse_value bs0 (cons x fl)) (parse_value bs0 (cons y gl))))))
  (by
    (intro bs0 h1 h2)
    (rw parse_value.eq_2)
    (rw parse_value.eq_2)
    (have e1 (= (List.length (cons x fl)) (+ (List.length fl) 1)) (rw List.length_cons) rfl)
    (have e2 (= (List.length (cons y gl)) (+ (List.length gl) 1)) (rw List.length_cons) rfl)
    (cases (skip_ws bs0) hs
      ((nil () (reduce) rfl)
       (cons (c r) (reduce)
         (have g0 (<= (+ (List.length r) 1) (List.length bs0)) (exact (skip_ws_cons bs0 c r hs)))
         (have l1 (<= (List.length r) (List.length fl)) (arith))
         (have l2 (<= (List.length r) (List.length gl)) (arith))
         (cases (Int.decEq c 123)
           ((isTrue (k1) (reduce) (exact (ho r nil l1 l2)))
            (isFalse (k1) (reduce)
              (cases (Int.decEq c 91)
                ((isTrue (k2) (reduce) (exact (ha r nil l1 l2))) (isFalse (k2) (reduce) rfl)))))))))))
(theorem fuel_step_array
  ((x Int)
   (fl (List Int))
   (y Int)
   (gl (List Int))
   (hv
     (forall ((bs0 (List Int)))
       (-> (<= (List.length bs0) (List.length (cons x fl)))
         (-> (<= (List.length bs0) (List.length (cons y gl)))
           (= (parse_value bs0 (cons x fl)) (parse_value bs0 (cons y gl)))))))
   (ha
     (forall ((bs0 (List Int)) (acc (List Json)))
       (-> (<= (List.length bs0) (List.length fl))
         (-> (<= (List.length bs0) (List.length gl))
           (= (parse_array bs0 acc fl) (parse_array bs0 acc gl)))))))
  (forall ((bs0 (List Int)) (acc (List Json)))
    (-> (<= (List.length bs0) (List.length (cons x fl)))
      (-> (<= (List.length bs0) (List.length (cons y gl)))
        (= (parse_array bs0 acc (cons x fl)) (parse_array bs0 acc (cons y gl))))))
  (by
    (intro bs0 acc h1 h2)
    (rw parse_array.eq_2)
    (rw parse_array.eq_2)
    (have ef (= (List.length (cons x fl)) (+ (List.length fl) 1)) (rw List.length_cons) rfl)
    (have eg (= (List.length (cons y gl)) (+ (List.length gl) 1)) (rw List.length_cons) rfl)
    (have s0 (<= (List.length (skip_ws bs0)) (List.length bs0)) (exact (skip_ws_le bs0)))
    (have l1 (<= (List.length (skip_ws bs0)) (List.length (cons x fl))) (arith))
    (have l2 (<= (List.length (skip_ws bs0)) (List.length (cons y gl))) (arith))
    (reduce (keep parse_value))
    (cases (starts_with_lit (list 93) (skip_ws bs0)) hl
      ((some (r) (reduce) rfl)
       (none () (reduce (keep parse_value)) (rw (hv (skip_ws bs0) l1 l2))
         (cases (parse_value (skip_ws bs0) (cons y gl)) hpv
           ((JErr () (reduce) rfl)
            (JRes (v rest) (reduce)
              (have g1 (<= (+ (List.length rest) 1) (List.length (skip_ws bs0)))
                (exact
                  (jres_room_at (parse_value (skip_ws bs0) (cons y gl)) v rest
                    (List.length (skip_ws bs0))
                    hpv
                    (parse_value_room (cons y gl) (skip_ws bs0)))))
              (cases (skip_ws rest) hs2
                ((nil () (reduce) rfl)
                 (cons (c2 r2) (reduce)
                   (have g2 (<= (+ (List.length r2) 1) (List.length rest))
                     (exact (skip_ws_cons rest c2 r2 hs2)))
                   (have m1 (<= (List.length r2) (List.length fl)) (arith))
                   (have m2 (<= (List.length r2) (List.length gl)) (arith))
                   (cases (Int.decEq c2 44)
                     ((isTrue (k1) (reduce) (exact (ha r2 (cons v acc) m1 m2)))
                      (isFalse (k1) (reduce) rfl))))))))))))))
(theorem fuel_step_object
  ((x Int)
   (fl (List Int))
   (y Int)
   (gl (List Int))
   (hv
     (forall ((bs0 (List Int)))
       (-> (<= (List.length bs0) (List.length (cons x fl)))
         (-> (<= (List.length bs0) (List.length (cons y gl)))
           (= (parse_value bs0 (cons x fl)) (parse_value bs0 (cons y gl)))))))
   (ho
     (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
       (-> (<= (List.length bs0) (List.length fl))
         (-> (<= (List.length bs0) (List.length gl))
           (= (parse_object bs0 acc fl) (parse_object bs0 acc gl)))))))
  (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
    (-> (<= (List.length bs0) (List.length (cons x fl)))
      (-> (<= (List.length bs0) (List.length (cons y gl)))
        (= (parse_object bs0 acc (cons x fl)) (parse_object bs0 acc (cons y gl))))))
  (by
    (intro bs0 acc h1 h2)
    (rw parse_object.eq_2)
    (rw parse_object.eq_2)
    (have ef (= (List.length (cons x fl)) (+ (List.length fl) 1)) (rw List.length_cons) rfl)
    (have eg (= (List.length (cons y gl)) (+ (List.length gl) 1)) (rw List.length_cons) rfl)
    (cases (skip_ws bs0) hs
      ((nil () (reduce) rfl)
       (cons (c r) (reduce)
         (have g0 (<= (+ (List.length r) 1) (List.length bs0)) (exact (skip_ws_cons bs0 c r hs)))
         (cases (Int.decEq c 125)
           ((isTrue (k1) (reduce) rfl)
            (isFalse (k1) (reduce)
              (cases (Int.decEq c 34)
                ((isFalse (k2) (reduce) rfl)
                 (isTrue (k2) (reduce)
                   (cases (parse_string r nil) hp
                     ((none () (reduce) rfl)
                      (some (p)
                        (cases p
                          ((mk (key rest) (reduce)
                             (have g1 (<= (+ (List.length rest) 1) (List.length r))
                               (exact
                                 (pstr_room_at (parse_string r nil) key rest (List.length r) hp
                                   (parse_string_room r nil))))
                             (cases (skip_ws rest) hs2
                               ((nil () (reduce) rfl)
                                (cons (c2 r2) (reduce (keep parse_value))
                                  (have g2 (<= (+ (List.length r2) 1) (List.length rest))
                                    (exact (skip_ws_cons rest c2 r2 hs2)))
                                  (cases (Int.decEq c2 58)
                                    ((isFalse (k3) (reduce) rfl)
                                     (isTrue (k3) (reduce (keep parse_value))
                                       (have l1 (<= (List.length r2) (List.length (cons x fl)))
                                         (arith))
                                       (have l2 (<= (List.length r2) (List.length (cons y gl)))
                                         (arith))
                                       (rw (hv r2 l1 l2))
                                       (cases (parse_value r2 (cons y gl)) hpv
                                         ((JErr () (reduce) rfl)
                                          (JRes (v rest2) (reduce)
                                            (have g3 (<= (+ (List.length rest2) 1) (List.length r2))
                                              (exact
                                                (jres_room_at (parse_value r2 (cons y gl)) v rest2
                                                  (List.length r2)
                                                  hpv
                                                  (parse_value_room (cons y gl) r2))))
                                            (cases (skip_ws rest2) hs3
                                              ((nil () (reduce) rfl)
                                               (cons (c3 r3) (reduce)
                                                 (have g4
                                                   (<= (+ (List.length r3) 1) (List.length rest2))
                                                   (exact (skip_ws_cons rest2 c3 r3 hs3)))
                                                 (have m1 (<= (List.length r3) (List.length fl))
                                                   (arith))
                                                 (have m2 (<= (List.length r3) (List.length gl))
                                                   (arith))
                                                 (cases (Int.decEq c3 44)
                                                   ((isTrue (k4) (reduce)
                                                      (exact
                                                        (ho r3 (cons (Prod.mk key v) acc) m1 m2)))
                                                    (isFalse (k4) (reduce) rfl))))))))))))))))))))))))))))))))
;; by induction on one fuel, for every other, the three together
(theorem parse_fuel ((f (List Int)))
  (forall ((g (List Int)))
    (And
      (forall ((bs0 (List Int)))
        (-> (<= (List.length bs0) (List.length f))
          (-> (<= (List.length bs0) (List.length g)) (= (parse_value bs0 f) (parse_value bs0 g)))))
      (And
        (forall ((bs0 (List Int)) (acc (List Json)))
          (-> (<= (List.length bs0) (List.length f))
            (-> (<= (List.length bs0) (List.length g))
              (= (parse_array bs0 acc f) (parse_array bs0 acc g)))))
        (forall ((bs0 (List Int)) (acc (List (Prod (List Int) Json))))
          (-> (<= (List.length bs0) (List.length f))
            (-> (<= (List.length bs0) (List.length g))
              (= (parse_object bs0 acc f) (parse_object bs0 acc g))))))))
  (by
    (induction f
      ((nil () (intro g)
         (apply And.intro
           ((intro bs0 h1 h2)
            (rw (nil_of_len bs0 h1))
            (rw (parse_value_nil (@nil Int)))
            (rw (parse_value_nil g))
            rfl)
           ((apply And.intro
              ((intro bs0 acc h1 h2)
               (rw (nil_of_len bs0 h1))
               (rw (parse_array_nil acc (@nil Int)))
               (rw (parse_array_nil acc g))
               rfl)
              ((intro bs0 acc h1 h2)
               (rw (nil_of_len bs0 h1))
               (rw (parse_object_nil acc (@nil Int)))
               (rw (parse_object_nil acc g))
               rfl)))))
       (cons (x fl ih) (intro g)
         (cases g
           ((nil ()
              (apply And.intro
                ((intro bs0 h1 h2)
                 (rw (nil_of_len bs0 h2))
                 (rw (parse_value_nil (cons x fl)))
                 (rw (parse_value_nil (@nil Int)))
                 rfl)
                ((apply And.intro
                   ((intro bs0 acc h1 h2)
                    (rw (nil_of_len bs0 h2))
                    (rw (parse_array_nil acc (cons x fl)))
                    (rw (parse_array_nil acc (@nil Int)))
                    rfl)
                   ((intro bs0 acc h1 h2)
                    (rw (nil_of_len bs0 h2))
                    (rw (parse_object_nil acc (cons x fl)))
                    (rw (parse_object_nil acc (@nil Int)))
                    rfl)))))
            (cons (y gl)
              (have hv
                (forall ((bs0 (List Int)))
                  (-> (<= (List.length bs0) (List.length (cons x fl)))
                    (-> (<= (List.length bs0) (List.length (cons y gl)))
                      (= (parse_value bs0 (cons x fl)) (parse_value bs0 (cons y gl))))))
                (exact
                  (fuel_step_value x fl y gl (And.left (And.right (ih gl)))
                    (And.right (And.right (ih gl))))))
              (apply And.intro (exact hv)
                (apply And.intro
                  (exact (fuel_step_array x fl y gl hv (And.left (And.right (ih gl)))))
                  (exact (fuel_step_object x fl y gl hv (And.right (And.right (ih gl)))))))))))))))
;; the fuel `json_parse` hands down, the input itself, against any other as long or longer
(theorem json_parse_fuel ((bs (List Int)) (g (List Int)) (h (<= (List.length bs) (List.length g))))
  (= (json_parse bs) (parse_value bs g))
  (by
    (have v
      (forall ((bs0 (List Int)))
        (-> (<= (List.length bs0) (List.length bs))
          (-> (<= (List.length bs0) (List.length g)) (= (parse_value bs0 bs) (parse_value bs0 g)))))
      (exact (And.left (parse_fuel bs g))))
    (have e (= (parse_value bs bs) (parse_value bs g))
      (exact (v bs (Nat.le_refl (List.length bs)) h)))
    (exact e)))

;; ---- accessors --------------------------------------------------------------

(fn jget ((j Json) (key (List Int))) (Option Json)
  (match j
    ((JObj fields) (jget_fields fields key))
    (_ none)))
(fn jget_fields ((fs (List (Prod (List Int) Json))) (key (List Int))) (Option Json)
  (measure (struct fs))
  (match fs
    (nil none)
    ((cons (Prod.mk k v) r) (if (int_list_eq k key) (some v) (jget_fields r key)))))

(fn jint ((j Json)) (Option Int)
  (match j
    ((JNum cs) (parse_int cs))
    (_ none)))

(fn parse_int ((cs (List Int))) (Option Int)
  (match (starts_with_lit (utf8 "-") cs)
    ((some r)
     (match (parse_nat r 0)
       ((some n) (some (- 0 n)))
       (none none)))
    (none (parse_nat cs 0))))
(fn parse_nat ((cs (List Int)) (acc Int)) (Option Int)
  (measure (struct cs))
  (match cs
    (nil (some acc))
    ((cons c r) (if (is_digit c) (parse_nat r (+ (* acc 10) (- c 48))) none))))

(fn jstr ((j Json)) (Option (List Int))
  (match j
    ((JStr s) (some s))
    (_ none)))
(fn jbool ((j Json)) (Option Bool)
  (match j
    ((JBool b) (some b))
    (_ none)))
(fn jarr ((j Json)) (Option (List Json))
  (match j
    ((JArr xs) (some xs))
    (_ none)))

;; the record kind of an export line: the key that is not "in"/"il"/"ie"
(fn jkind_of_record ((j Json)) (Option (List Int))
  (match j
    ((JObj fs) (jkind_go fs))
    (_ none)))
(fn jkind_go ((fs (List (Prod (List Int) Json)))) (Option (List Int))
  (measure (struct fs))
  (match fs
    (nil none)
    ((cons (Prod.mk k _) r)
     (if
       (bool_or (int_list_eq k (utf8 "in"))
         (bool_or (int_list_eq k (utf8 "il")) (int_list_eq k (utf8 "ie"))))
       (jkind_go r)
       (some k)))))

;; split a byte list at newlines: (line, rest) — the line without its newline
(fn take_line ((bs (List Int)) (acc (List Int))) (Prod (List Int) (List Int))
  (measure (struct bs))
  (match bs
    (nil (Prod.mk (rev acc) nil))
    ((cons c r) (if (= c 10) (Prod.mk (rev acc) r) (take_line r (cons c acc))))))
;; the rest `take_line` leaves is no longer than what it was given, and shorter where there
;; was a byte: what a walk of a block line by line descends by
(theorem take_line_le ((bs (List Int)))
  (forall ((acc (List Int)) (line (List Int)) (rest (List Int)))
    (-> (= (take_line bs acc) (Prod.mk line rest)) (<= (List.length rest) (List.length bs))))
  (by
    (induction bs
      ((nil () (intro acc line rest h)
         (have e (= (Prod.mk (rev acc) (@nil Int)) (Prod.mk line rest)) (exact h))
         (have er (= (@nil Int) rest) (exact (congrArg Prod.snd e)))
         (rw (<- er))
         (arith))
       (cons (c r ih) (intro acc line rest h)
         (cases (Int.decEq c 10)
           ((isFalse (hn)
              (have e (= (take_line (cons c r) acc) (take_line r (cons c acc)))
                (rw take_line.eq_2)
                (rw (if_neg hn))
                rfl)
              (have h2 (= (take_line r (cons c acc)) (Prod.mk line rest)) (rw (<- e)) (exact h))
              (have g (<= (List.length rest) (List.length r))
                (exact (ih (cons c acc) line rest h2)))
              (rw List.length_cons)
              (arith))
            (isTrue (hc)
              (have e (= (take_line (cons c r) acc) (Prod.mk (rev acc) r))
                (rw take_line.eq_2)
                (rw (if_pos hc))
                rfl)
              (have e2 (= (Prod.mk (rev acc) r) (Prod.mk line rest)) (rw (<- e)) (exact h))
              (have er (= r rest) (exact (congrArg Prod.snd e2)))
              (rw (<- er))
              (rw List.length_cons)
              (arith)))))))))
(theorem take_line_lt
  ((bs (List Int))
   (c Int)
   (r (List Int))
   (acc (List Int))
   (line (List Int))
   (rest (List Int))
   (hb (= bs (cons c r)))
   (h (= (take_line bs acc) (Prod.mk line rest))))
  (< (List.length rest) (List.length bs))
  (by
    (have h1 (= (take_line (cons c r) acc) (Prod.mk line rest)) (rw (<- hb)) (exact h))
    (rw hb)
    (rw List.length_cons)
    (cases (Int.decEq c 10)
      ((isFalse (hn)
         (have e (= (take_line (cons c r) acc) (take_line r (cons c acc)))
           (rw take_line.eq_2)
           (rw (if_neg hn))
           rfl)
         (have h2 (= (take_line r (cons c acc)) (Prod.mk line rest)) (rw (<- e)) (exact h1))
         (arith (take_line_le r (cons c acc) line rest h2)))
       (isTrue (hc)
         (have e (= (take_line (cons c r) acc) (Prod.mk (rev acc) r))
           (rw take_line.eq_2)
           (rw (if_pos hc))
           rfl)
         (have e2 (= (Prod.mk (rev acc) r) (Prod.mk line rest)) (rw (<- e)) (exact h1))
         (have er (= r rest) (exact (congrArg Prod.snd e2)))
         (rw (<- er))
         (arith))))))
