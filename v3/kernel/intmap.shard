;;; v3/kernel/intmap.shard — a persistent map keyed by nonnegative Int: a
;;; binary trie over the key's bits (LSB first), O(log key) lookup and
;;; insert, no rebalancing. Used for the export tables (names, levels,
;;; terms by index) and, later, for K's memo tables.

(import "prelude.shard")

(type (IntMap V)
  (IMEmpty)
  (IMNode (Option V) (IntMap V) (IntMap V)))   ; value at this key; children for bit 0 / bit 1

(fn im_find ((m (IntMap V)) (k Int)) (Option V)
  (measure k)
  (match m
    (IMEmpty None)
    ((IMNode v z o)
     (if (int_eq k 0) v
       (if (int_eq (mod k 2) 0) (im_find z (ediv k 2)) (im_find o (ediv k 2)))))))

;; keys are read as: bit 0 selects the child, the remaining bits index into it;
;; key 0 is stored at the node itself. Only keys ≥ 0 are ever used.
(fn im_insert ((m (IntMap V)) (k Int) (v V)) (IntMap V)
  (measure k)
  (match m
    (IMEmpty
     (if (int_eq k 0) (IMNode (Some v) IMEmpty IMEmpty)
       (if (int_eq (mod k 2) 0) (IMNode None (im_insert IMEmpty (ediv k 2) v) IMEmpty)
         (IMNode None IMEmpty (im_insert IMEmpty (ediv k 2) v)))))
    ((IMNode w z o)
     (if (int_eq k 0) (IMNode (Some v) z o)
       (if (int_eq (mod k 2) 0) (IMNode w (im_insert z (ediv k 2) v) o)
         (IMNode w z (im_insert o (ediv k 2) v)))))))
