;;; v3/kernel/index.shard — the Init index: three tables over the export in one file,
;;; built by one pass and read by range, never loaded whole. A 128-byte HEADER row,
;;; `#INDEX records=R bytes=B meta=M names=N decls=D`: the record count, the export's
;;; byte count (an index over another export is refused), the meta line's length (block
;;; 0 begins after it), the name rows and the declaration rows. Then the RECORD TABLE:
;;; one 62-byte row per record in export order, `ORDINAL KIND OFFSET LENGTH IN IL IE` —
;;; the ordinal (8 digits), the kind (one byte: a axiom, d definition, t theorem, o
;;; opaque, i inductive block, q quotient), the byte offset (12) and length (10) of the
;;; record's block (the lines it emits before its own line, then its line), and the
;;; first name, level and expression id (8 each) the block holds — holding none, the
;;; next id the export assigns — so the block holding an id is the LAST row whose first
;;; id is at most it (ids are assigned in emission order). Then the NAME TABLE: one
;;; 218-byte row per declaration name (a definition's, a theorem's, an axiom's, an
;;; opaque's, a quotient's; an inductive block's types, constructors and recursors),
;;; sorted bytewise: the name as show_name renders it padded with spaces to 208 bytes, a
;;; space, the ordinal (8 digits); a name is a binary search of range reads, the names
;;; under a prefix one search and a forward read. Then the DECLARATION TABLE: one 9-byte
;;; row per name id the export assigns, the ordinal (8 digits) of the record declaring
;;; the constant of that name, blank for a name that is no declaration's — a constant an
;;; expression line cites by its name id finds its record in one read (initload.shard's
;;; walk). Every row ends in a newline. The pass refuses two names rendering alike (the
;;; name table would be ambiguous) and a name past the row's width.
;;; `ix_verify` reads the tables back against the export: every record line at the row's
;;; offset and length with the row's kind and first ids, every name of it at its ordinal
;;; in the name table and in the declaration table, the name table sorted without a
;;; duplicate, the file's size the header's. The driver is initindex.shard; the loader
;;; reads the tables through initload.shard.

(import "host.shard")
(import "json.shard")
(import "intmap.shard")
(import "name.shard")
(import "util.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.host)
(use kernel.descent)
(use kernel.json)
(use kernel.intmap)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.json.JRes)
(use kernel.intmap.IntMap)
(use kernel.name.Name)

;; ---- the formats ----------------------------------------------------------------------

(fn ix_hdr_w () Int 128)  ; the header row
(fn ix_row_w () Int 62)  ; a record row
(fn ix_name_w () Int 208)  ; the name field of a name row
(fn ix_nrow_w () Int 218)  ; a name row: the name, a space, the ordinal, a newline
(fn ix_drow_w () Int 9)  ; a declaration row: the ordinal, a newline
(fn ix_window () Int 4000000)  ; the pass reads the export in windows of this many bytes

;; a record row parsed: ordinal, kind byte, block offset, block length, first name, level
;; and expression id
(type IxRow (IxRow Int Int Int Int Int Int Int))
;; the header parsed: records, the export's bytes, the meta line's length, name rows,
;; declaration rows
(type IxHdr (IxHdr Int Int Int Int Int))
(fn ix_hdr_records ((h IxHdr)) Int
  (match h
    ((IxHdr a _ _ _ _) a)))
(fn ix_hdr_bytes ((h IxHdr)) Int
  (match h
    ((IxHdr _ a _ _ _) a)))
(fn ix_hdr_meta ((h IxHdr)) Int
  (match h
    ((IxHdr _ _ a _ _) a)))
(fn ix_hdr_names ((h IxHdr)) Int
  (match h
    ((IxHdr _ _ _ a _) a)))
(fn ix_hdr_decls ((h IxHdr)) Int
  (match h
    ((IxHdr _ _ _ _ a) a)))
;; where the tables sit: record row k, name row k, declaration row k, the file's size
(fn ix_rec_at ((h IxHdr) (k Int)) Int (+ (ix_hdr_w) (* (ix_row_w) k)))
(fn ix_nrow_at ((h IxHdr) (k Int)) Int (+ (ix_rec_at h (ix_hdr_records h)) (* (ix_nrow_w) k)))
(fn ix_drow_at ((h IxHdr) (k Int)) Int (+ (ix_nrow_at h (ix_hdr_names h)) (* (ix_drow_w) k)))
(fn ix_total ((h IxHdr)) Int (ix_drow_at h (ix_hdr_decls h)))

(fn ix_zeros ((n Int)) (List Int)
  (measure (Int.natAbs n))
  (if (<= n 0) nil (cons 48 (ix_zeros (- n 1)))))
(fulfills ix_zeros.dec_1 (by (intro n h) (apply natAbs_pred (arith))))
(fn ix_spaces ((n Int)) (List Int)
  (measure (Int.natAbs n))
  (if (<= n 0) nil (cons 32 (ix_spaces (- n 1)))))
(fulfills ix_spaces.dec_1 (by (intro n h) (apply natAbs_pred (arith))))
;; a number zero-padded to w digits
(fn ix_num ((v Int) (w Int)) (List Int)
  (let ((d (show_nat v))) (append (ix_zeros (- w (len d))) d)))
;; text space-padded to w bytes
(fn ix_pad ((s (List Int)) (w Int)) (List Int) (append s (ix_spaces (- w (len s)))))
;; text space-padded to w - 1 bytes and a newline: a header row
(fn ix_pad_nl ((s (List Int)) (w Int)) (List Int) (append (ix_pad s (- w 1)) (list 10)))

(fn ix_render_row ((o Int) (k Int) (off Int) (n Int) (a Int) (b Int) (c Int)) (List Int)
  (append (ix_num o 8)
    (cons 32
      (cons k
        (cons 32
          (append (ix_num off 12)
            (cons 32
              (append (ix_num n 10)
                (cons 32
                  (append (ix_num a 8)
                    (cons 32 (append (ix_num b 8) (cons 32 (append (ix_num c 8) (list 10)))))))))))))))
(fn ix_header ((records Int) (bytes Int) (meta Int) (names Int) (decls Int)) (List Int)
  (ix_pad_nl
    (append (utf8 "#INDEX records=")
      (append (ix_num records 8)
        (append (utf8 " bytes=")
          (append (ix_num bytes 12)
            (append (utf8 " meta=")
              (append (ix_num meta 8)
                (append (utf8 " names=")
                  (append (ix_num names 8) (append (utf8 " decls=") (ix_num decls 8))))))))))
    (ix_hdr_w)))
(fn ix_render_nrow ((key (List Int)) (o Int)) (List Int)
  (append key (cons 32 (append (ix_num o 8) (list 10)))))
(fn ix_render_drow ((o Int)) (List Int) (append (ix_num o 8) (list 10)))
(fn ix_blank_drow () (List Int) (append (ix_spaces 8) (list 10)))

;; the digits at start, width wide, as a number
(fn ix_field ((bs (List Int)) (start Int) (width Int)) (Option Int)
  (parse_nat (take width (drop start bs)) 0))
(fn ix_byte ((bs (List Int)) (at Int)) Int
  (match (drop at bs)
    ((cons c _) c)
    (nil 0)))
(fn ix_parse_row ((bs (List Int))) (Option IxRow)
  (if (bool_not (= (len bs) (ix_row_w))) none
  (match (ix_field bs 0 8)
    (none none)
    ((some o)
     (match (ix_field bs 11 12)
       (none none)
       ((some off)
        (match (ix_field bs 24 10)
          (none none)
          ((some n)
           (match (ix_field bs 35 8)
             (none none)
             ((some a)
              (match (ix_field bs 44 8)
                (none none)
                ((some b)
                 (match (ix_field bs 53 8)
                   (none none)
                   ((some c) (some (IxRow o (ix_byte bs 9) off n a b c))))))))))))))))
(fn ix_parse_header ((bs (List Int))) (Option IxHdr)
  (if (bool_not (int_list_eq (take 15 bs) (utf8 "#INDEX records="))) none
  (match (ix_field bs 15 8)
    (none none)
    ((some r)
     (match (ix_field bs 30 12)
       (none none)
       ((some b)
        (match (ix_field bs 48 8)
          (none none)
          ((some m)
           (match (ix_field bs 63 8)
             (none none)
             ((some nn)
              (match (ix_field bs 78 8)
                (none none)
                ((some d) (some (IxHdr r b m nn d))))))))))))))

;; ---- reading the tables (the loader's side) ----------------------------------------------

(fn ix_read_header ((index (List Int)) (w World)) (Prod (Option IxHdr) World)
  (match (read_range index 0 (ix_hdr_w) w)
    ((Prod.mk none w1) (Prod.mk none w1))
    ((Prod.mk (some bs) w1) (Prod.mk (ix_parse_header bs) w1))))
;; record row k
(fn ix_read_row ((index (List Int)) (h IxHdr) (k Int) (w World)) (Prod (Option IxRow) World)
  (if (bool_or (< k 0) (<= (ix_hdr_records h) k)) (Prod.mk none w)
  (match (read_range index (ix_rec_at h k) (ix_row_w) w)
    ((Prod.mk none w1) (Prod.mk none w1))
    ((Prod.mk (some bs) w1) (Prod.mk (ix_parse_row bs) w1)))))
;; name row k, raw
(fn ix_read_nrow ((index (List Int)) (h IxHdr) (k Int) (w World)) (Prod (Option (List Int)) World)
  (if (bool_or (< k 0) (<= (ix_hdr_names h) k)) (Prod.mk none w)
  (match (read_range index (ix_nrow_at h k) (ix_nrow_w) w)
    ((Prod.mk none w1) (Prod.mk none w1))
    ((Prod.mk (some bs) w1) (if (= (len bs) (ix_nrow_w)) (Prod.mk (some bs) w1) (Prod.mk none w1))))))
;; a name's ordinal: the binary search of the name table
(fn ix_lookup ((index (List Int)) (h IxHdr) (nm Name) (w World)) (Prod (Option Int) World)
  (ix_search index h (ix_pad (show_name nm) (ix_name_w)) 0 (- (ix_hdr_names h) 1) 64 w))
(fn ix_search ((index (List Int)) (h IxHdr) (key (List Int)) (lo Int) (hi Int) (fuel Int) (w World))
  (Prod (Option Int) World)
  (measure (Int.natAbs fuel))
  (if (bool_or (<= fuel 0) (< hi lo)) (Prod.mk none w)
  (let ((mid (/ (+ lo hi) 2)))
    (match (ix_read_nrow index h mid w)
      ((Prod.mk none w1) (Prod.mk none w1))
      ((Prod.mk (some row) w1)
       (let ((k (take (ix_name_w) row)))
         (if (int_list_eq k key) (Prod.mk (ix_field row (+ (ix_name_w) 1) 8) w1)
         (if (int_list_lt k key) (ix_search index h key (+ mid 1) hi (- fuel 1) w1)
         (ix_search index h key lo (- mid 1) (- fuel 1) w1)))))))))
(fulfills ix_search.dec_1
  (by
    (intro p h row w1 hm he hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
(fulfills ix_search.dec_2
  (by
    (intro p h row w1 hm he hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
;; every name rendering with the prefix, as rendered: the first row at or past the prefix,
;; then forward while the prefix holds
(fn ix_names_under ((index (List Int)) (h IxHdr) (prefix (List Int)) (w World))
  (Prod (List (List Int)) World)
  (match (ix_lower index h prefix 0 (ix_hdr_names h) 64 w)
    ((Prod.mk k w1) (ix_prefix_rows index h prefix k 1000000 nil w1))))
;; the first row in [lo, hi) whose key is at or past key; hi when none
(fn ix_lower ((index (List Int)) (h IxHdr) (key (List Int)) (lo Int) (hi Int) (fuel Int) (w World))
  (Prod Int World)
  (measure (Int.natAbs fuel))
  (if (bool_or (<= fuel 0) (<= hi lo)) (Prod.mk lo w)
  (let ((mid (/ (+ lo hi) 2)))
    (match (ix_read_nrow index h mid w)
      ((Prod.mk none w1) (Prod.mk hi w1))
      ((Prod.mk (some row) w1)
       (if (int_list_lt (take (ix_name_w) row) key)
         (ix_lower index h key (+ mid 1) hi (- fuel 1) w1)
         (ix_lower index h key lo mid (- fuel 1) w1)))))))
(fulfills ix_lower.dec_1
  (by
    (intro p h row w1 hm hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
(fulfills ix_lower.dec_2
  (by
    (intro p h row w1 hm hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
(fn ix_prefix_rows
  ((index (List Int))
   (h IxHdr)
   (prefix (List Int))
   (k Int)
   (fuel Int)
   (acc (List (List Int)))
   (w World))
  (Prod (List (List Int)) World)
  (measure (Int.natAbs fuel))
  (if (bool_or (<= fuel 0) (<= (ix_hdr_names h) k)) (Prod.mk (rev acc) w)
  (match (ix_read_nrow index h k w)
    ((Prod.mk none w1) (Prod.mk (rev acc) w1))
    ((Prod.mk (some row) w1)
     (if (ix_starts row prefix)
       (ix_prefix_rows index h prefix (+ k 1) (- fuel 1) (cons (ix_trim (take (ix_name_w) row)) acc)
         w1)
       (Prod.mk (rev acc) w1))))))
;; the ordinal of the record declaring the constant with name id i; None for a name that
;; is no declaration's, or past the table
(fn ix_decl_of ((index (List Int)) (h IxHdr) (i Int) (w World)) (Prod (Option Int) World)
  (if (bool_or (< i 0) (<= (ix_hdr_decls h) i)) (Prod.mk none w)
  (match (read_range index (ix_drow_at h i) (ix_drow_w) w)
    ((Prod.mk none w1) (Prod.mk none w1))
    ((Prod.mk (some bs) w1) (Prod.mk (ix_field bs 0 8) w1)))))
(fn ix_row_first ((row IxRow) (which Int)) Int
  (match row
    ((IxRow _ _ _ _ a b c)
     (if (= which 0) a
     (if (= which 1) b
     c)))))
(fn ix_row_ord ((row IxRow)) Int
  (match row
    ((IxRow o _ _ _ _ _ _) o)))
(fn ix_row_kind ((row IxRow)) Int
  (match row
    ((IxRow _ k _ _ _ _ _) k)))
(fn ix_row_off ((row IxRow)) Int
  (match row
    ((IxRow _ _ off _ _ _ _) off)))
(fn ix_row_len ((row IxRow)) Int
  (match row
    ((IxRow _ _ _ n _ _ _) n)))

;; ---- the pass ---------------------------------------------------------------------------------
;; its state: the names so far (by id), the next ordinal, the block's offset, the block's first
;; name, level and expression id (-1: none yet), the last of each, the record rows (newest
;; first), the name rows (padded name, ordinal), the declaration pairs (name id, ordinal), the
;; meta line's length, the export's size, the first failure, the mode (0 build, 1 verify), the
;; index verified against and its header, the names checked
(type IxSt
  (IxSt (IntMap Name) Int Int Int Int Int Int Int Int (List (List Int)) (List (Prod (List Int) Int))
    (List (Prod Int Int))
    Int
    Int
    (List Int)
    Int
    (List Int)
    IxHdr
    Int))
(fn ixs_names ((st IxSt)) (IntMap Name)
  (match st
    ((IxSt a _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_ord ((st IxSt)) Int
  (match st
    ((IxSt _ a _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_boff ((st IxSt)) Int
  (match st
    ((IxSt _ _ a _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_fin ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ a _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_fil ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ a _ _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_fie ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ a _ _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_lin ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ a _ _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_lil ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ a _ _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_lie ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ _ a _ _ _ _ _ _ _ _ _ _) a)))
(fn ixs_rows ((st IxSt)) (List (List Int))
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ a _ _ _ _ _ _ _ _ _) a)))
(fn ixs_nrows ((st IxSt)) (List (Prod (List Int) Int))
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ a _ _ _ _ _ _ _ _) a)))
(fn ixs_drows ((st IxSt)) (List (Prod Int Int))
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ a _ _ _ _ _ _ _) a)))
(fn ixs_meta ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ a _ _ _ _ _ _) a)))
(fn ixs_size ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ a _ _ _ _ _) a)))
(fn ixs_bad ((st IxSt)) (List Int)
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ a _ _ _ _) a)))
(fn ixs_mode ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ a _ _ _) a)))
(fn ixs_vindex ((st IxSt)) (List Int)
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ a _ _) a)))
(fn ixs_vhdr ((st IxSt)) IxHdr
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ a _) a)))
(fn ixs_checked ((st IxSt)) Int
  (match st
    ((IxSt _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ a) a)))
(fn ixs_set_names ((st IxSt) (v (IntMap Name))) IxSt
  (match st
    ((IxSt _ f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt v f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_ord ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 _ f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 v f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_boff ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 _ f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 v f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_fin ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 _ f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 v f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_fil ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 _ f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 v f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_fie ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 _ f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 v f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_lin ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 _ f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 v f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_lil ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 _ f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 v f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_lie ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 _ f9 f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 v f9 f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_rows ((st IxSt) (v (List (List Int)))) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 _ f10 f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 v f10 f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_nrows ((st IxSt) (v (List (Prod (List Int) Int)))) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 _ f11 f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 v f11 f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_drows ((st IxSt) (v (List (Prod Int Int)))) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 _ f12 f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 v f12 f13 f14 f15 f16 f17 f18))))
(fn ixs_set_meta ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 _ f13 f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 v f13 f14 f15 f16 f17 f18))))
(fn ixs_set_size ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 _ f14 f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 v f14 f15 f16 f17 f18))))
(fn ixs_set_bad ((st IxSt) (v (List Int))) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 _ f15 f16 f17 f18)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 v f15 f16 f17 f18))))
(fn ixs_set_checked ((st IxSt) (v Int)) IxSt
  (match st
    ((IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 _)
     (IxSt f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 f16 f17 v))))

(fn ix_st0 ((mode Int) (vindex (List Int)) (vhdr IxHdr)) IxSt
  (IxSt IMEmpty 0 0 -1 -1 -1 -1 -1 -1 nil nil nil 0 0 nil mode vindex vhdr 0))
;; a name line entered: the names, the block's first name id, the last
(fn ixs_name_in ((st IxSt) (i Int) (nm Name)) IxSt
  (ixs_set_lin
    (ixs_set_fin (ixs_set_names st (im_insert (ixs_names st) i nm))
      (if (< (ixs_fin st) 0) i (ixs_fin st)))
    i))
(fn ixs_level ((st IxSt) (i Int)) IxSt
  (ixs_set_lil (ixs_set_fil st (if (< (ixs_fil st) 0) i (ixs_fil st))) i))
(fn ixs_expr ((st IxSt) (i Int)) IxSt
  (ixs_set_lie (ixs_set_fie st (if (< (ixs_fie st) 0) i (ixs_fie st))) i))
;; the meta line of n bytes: block 0 begins after it
(fn ixs_meta_line ((st IxSt) (n Int)) IxSt (ixs_set_meta (ixs_set_boff st n) n))
;; a record closed: the next ordinal, the next block from the byte after the record line's newline, no first ids
(fn ixs_close ((st IxSt) (boff Int)) IxSt
  (ixs_set_fie
    (ixs_set_fil (ixs_set_fin (ixs_set_boff (ixs_set_ord st (+ (ixs_ord st) 1)) boff) -1) -1)
    -1))
(fn ixs_rows_add
  ((st IxSt) (row (List Int)) (nrs (List (Prod (List Int) Int))) (drs (List (Prod Int Int))))
  IxSt
  (ixs_set_drows
    (ixs_set_nrows (ixs_set_rows st (cons row (ixs_rows st))) (append nrs (ixs_nrows st)))
    (append drs (ixs_drows st))))
(fn ixs_checked_one ((st IxSt)) IxSt (ixs_set_checked st (+ (ixs_checked st) 1)))
(fn ix_fail ((st IxSt) (msg (List Int))) IxSt
  (match (ixs_bad st)
    ((cons _ _) st)
    (nil (ixs_set_bad st msg))))

;; windows of the export from off; carry = the partial last line of the window before
(fn ix_scan ((path (List Int)) (off Int) (carry (List Int)) (st IxSt) (fuel Int) (w World))
  (Prod IxSt World)
  (measure fuel)
  (if (<= fuel 0) (Prod.mk (ix_fail st (utf8 "the window budget")) w)
  (match (ixs_bad st)
    ((cons _ _) (Prod.mk st w))
    (nil
      (match (read_range path off (ix_window) w)
        ((Prod.mk none w1) (Prod.mk (ix_fail st (append (utf8 "cannot read ") path)) w1))
        ((Prod.mk (some nil) w1)
         (match carry
           (nil (Prod.mk (ixs_set_size st off) w1))
           (_
             (match (ix_line st (- off (len carry)) carry w1)  ; a last line without its newline
               ((Prod.mk st1 w2) (Prod.mk (ixs_set_size st1 off) w2))))))
        ((Prod.mk (some bs) w1)
         (match
           (ix_lines st (append carry bs) (- off (len carry)) (+ (len bs) (+ (len carry) 1)) w1)
           ((Prod.mk (Prod.mk st1 rest) w2) (ix_scan path (+ off (len bs)) rest st1 (- fuel 1) w2)))))))))
;; every complete line of buf, the first at byte pos; the remainder returned
(fn ix_lines ((st IxSt) (buf (List Int)) (pos Int) (fuel Int) (w World))
  (Prod (Prod IxSt (List Int)) World)
  (measure fuel)
  (if (<= fuel 0) (Prod.mk (Prod.mk (ix_fail st (utf8 "the line budget")) nil) w)
  (match (ixs_bad st)
    ((cons _ _) (Prod.mk (Prod.mk st nil) w))
    (nil
      (match (ix_take_line buf nil)
        (none (Prod.mk (Prod.mk st buf) w))
        ((some (Prod.mk line rest))
         (match (ix_line st pos line w)
           ((Prod.mk st1 w1) (ix_lines st1 rest (+ pos (+ (len line) 1)) (- fuel 1) w1)))))))))
;; the line before the first newline (without it) and the rest; None when no newline
(fn ix_take_line ((bs (List Int)) (acc (List Int))) (Option (Prod (List Int) (List Int)))
  (measure (struct bs))
  (match bs
    (nil none)
    ((cons c r) (if (= c 10) (some (Prod.mk (rev acc) r)) (ix_take_line r (cons c acc))))))
;; one line at byte pos, n bytes long: a name, level or expression line by its id key, the
;; meta line at the start, else a record
(fn ix_line ((st IxSt) (pos Int) (line (List Int)) (w World)) (Prod IxSt World)
  (let ((n (len line)))
    (match (ix_id_in line (utf8 "in"))
      ((some i) (Prod.mk (ix_name st line i) w))
      (none
        (match (ix_id_in line (utf8 "il"))
          ((some i) (Prod.mk (ixs_level st i) w))
          (none
            (match (ix_id_in line (utf8 "ie"))
              ((some i) (Prod.mk (ixs_expr st i) w))
              (none
                (if (= pos 0) (Prod.mk (ixs_meta_line st (+ n 1)) w)
                (match (json_parse line)
                  (JErr
                    (Prod.mk
                      (ix_fail st (append (utf8 "a record is not JSON at byte ") (show_nat pos)))
                      w))
                  ((JRes j _) (ix_record st j pos n w))))))))))))
;; the id under KEY — `"in":N` at the line's start or after a comma — read without parsing
(fn ix_id_in ((line (List Int)) (key (List Int))) (Option Int)
  (ix_find_key line (append (cons 34 key) (utf8 "\":")) (len line)))
(fn ix_find_key ((bs (List Int)) (pat (List Int)) (fuel Int)) (Option Int)
  (measure (Int.natAbs fuel))
  (if (<= fuel 0) none
  (match bs
    (nil none)
    ((cons c r)
     (if (bool_and (= c 44) (ix_starts r pat)) (ix_digits (drop (len pat) r) 0 false)
     (if (bool_and (= c 123) (ix_starts r pat)) (ix_digits (drop (len pat) r) 0 false)
     (ix_find_key r pat (- fuel 1))))))))
(fn ix_starts ((bs (List Int)) (pat (List Int))) Bool
  (measure (struct pat))
  (match pat
    (nil true)
    ((cons p pr)
     (match bs
       ((cons c cr) (if (= c p) (ix_starts cr pr) false))
       (nil false)))))
(fn ix_digits ((bs (List Int)) (acc Int) (seen Bool)) (Option Int)
  (measure (struct bs))
  (match bs
    (nil (if seen (some acc) none))
    ((cons c r)
     (if (is_digit c) (ix_digits r (+ (* acc 10) (- c 48)) true)
     (if seen (some acc)
     none)))))
(fulfills ix_find_key.dec_1 (by (intro p h c r hm h1 h2) (apply natAbs_pred (arith))))

;; a name line: the name entered, the block's first name id
(fn ix_name ((st IxSt) (line (List Int)) (i Int)) IxSt
  (match (json_parse line)
    (JErr (ix_fail st (append (utf8 "a name line is not JSON: id ") (show_nat i))))
    ((JRes j _)
     (match (ix_name_of st j)
       (none (ix_fail st (append (utf8 "a malformed name line: id ") (show_nat i))))
       ((some nm) (ixs_name_in st i nm))))))
(fn ix_name_of ((st IxSt) (j Json)) (Option Name)
  (match (jget j (utf8 "str"))
    ((some o)
     (match (ix_int_field o (utf8 "pre"))
       (none none)
       ((some pre)
        (match (jget o (utf8 "str"))
          (none none)
          ((some sv)
           (match (jstr sv)
             (none none)
             ((some s)
              (match (ix_name_at st pre)
                (none none)
                ((some p) (some (Str p (sym_of_chars s))))))))))))
    (none
      (match (jget j (utf8 "num"))
        (none none)
        ((some o)
         (match (ix_int_field o (utf8 "pre"))
           (none none)
           ((some pre)
            (match (ix_int_field o (utf8 "i"))
              (none none)
              ((some k)
               (match (ix_name_at st pre)
                 (none none)
                 ((some p) (some (Num p k)))))))))))))
(fn ix_int_field ((o Json) (key (List Int))) (Option Int)
  (match (jget o key)
    (none none)
    ((some v) (jint v))))
(fn ix_name_at ((st IxSt) (i Int)) (Option Name)
  (if (= i 0) (some Anon) (im_find (ixs_names st) i)))

;; a record line: its row rendered (mode 0) or checked against the table (mode 1); the
;; block closed
(fn ix_record ((st IxSt) (j Json) (pos Int) (n Int) (w World)) (Prod IxSt World)
  (match (jkind_of_record j)
    (none (Prod.mk (ix_fail st (append (utf8 "a record without a kind at byte ") (show_nat pos))) w))
    ((some kind)
     (match (ix_record_names st j kind)
       (none
         (Prod.mk (ix_fail st (append (utf8 "a record without its names at byte ") (show_nat pos)))
           w))
       ((some ns)
        (let ((o (ixs_ord st)))
          (let
            ((row
               (IxRow.IxRow o (ix_kind_code kind) (ixs_boff st) (- (+ pos n) (ixs_boff st))
                 (ix_first (ixs_fin st) (ixs_lin st))
                 (ix_first (ixs_fil st) (ixs_lil st))
                 (ix_first (ixs_fie st) (ixs_lie st)))))
            (match
              (if (= (ixs_mode st) 0) (Prod.mk (ix_record_build st row ns) w)
              (ix_record_check st row ns w))
              ((Prod.mk st1 w1) (Prod.mk (ixs_close st1 (+ (+ pos n) 1)) w1))))))))))
(fn ix_first ((f Int) (l Int)) Int (if (< f 0) (+ l 1) f))
(fn ix_kind_code ((kind (List Int))) Int
  (match kind
    ((cons c _) c)
    (nil 63)))
(fn ix_record_build ((st IxSt) (row IxRow) (ns (List (Prod Int Name)))) IxSt
  (match (ix_name_rows ns (ix_row_ord row) nil)
    (none
      (ix_fail st
        (append (utf8 "a name past the row's width at ordinal ") (show_nat (ix_row_ord row)))))
    ((some nrs)
     (match row
       ((IxRow o k off n a b c)
        (ixs_rows_add st (ix_render_row o k off n a b c) nrs (ix_decl_pairs ns o nil)))))))
(fn ix_name_rows ((ns (List (Prod Int Name))) (o Int) (acc (List (Prod (List Int) Int))))
  (Option (List (Prod (List Int) Int)))
  (measure (struct ns))
  (match ns
    (nil (some acc))
    ((cons (Prod.mk _ nm) r)
     (let ((s (show_name nm)))
       (if (< (ix_name_w) (len s)) none
       (ix_name_rows r o (cons (Prod.mk (ix_pad s (ix_name_w)) o) acc)))))))
(fn ix_decl_pairs ((ns (List (Prod Int Name))) (o Int) (acc (List (Prod Int Int))))
  (List (Prod Int Int))
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons (Prod.mk i _) r) (ix_decl_pairs r o (cons (Prod.mk i o) acc)))))
;; verify: the table's row for this ordinal is this row, and every name of the record is
;; at this ordinal in the name table and in the declaration table
(fn ix_record_check ((st IxSt) (row IxRow) (ns (List (Prod Int Name))) (w World)) (Prod IxSt World)
  (match (ix_read_row (ixs_vindex st) (ixs_vhdr st) (ix_row_ord row) w)
    ((Prod.mk none w1)
     (Prod.mk (ix_fail st (append (utf8 "no row at ordinal ") (show_nat (ix_row_ord row)))) w1))
    ((Prod.mk (some have) w1)
     (if (bool_not (ix_row_eq have row))
       (Prod.mk
         (ix_fail st
           (append (utf8 "row differs at ordinal ")
             (append (show_nat (ix_row_ord row))
               (append (utf8 ": table ")
                 (append (ix_show_row have) (append (utf8 ", export ") (ix_show_row row)))))))
         w1)
       (ix_names_check st ns (ix_row_ord row) w1)))))
(fn ix_row_eq ((a IxRow) (b IxRow)) Bool
  (match a
    ((IxRow o k off n x y z)
     (match b
       ((IxRow ob kb offb nb xb yb zb)
        (bool_and (= o ob)
          (bool_and (= k kb)
            (bool_and (= off offb)
              (bool_and (= n nb) (bool_and (= x xb) (bool_and (= y yb) (= z zb))))))))))))
(fn ix_show_row ((r IxRow)) (List Int)
  (match r
    ((IxRow o k off n a b c) (take 61 (ix_render_row o k off n a b c)))))
(fn ix_names_check ((st IxSt) (ns (List (Prod Int Name))) (o Int) (w World)) (Prod IxSt World)
  (measure (struct ns))
  (match ns
    (nil (Prod.mk st w))
    ((cons (Prod.mk i nm) r)
     (match (ix_lookup (ixs_vindex st) (ixs_vhdr st) nm w)
       ((Prod.mk (some found) w1)
        (if (bool_not (= found o))
          (Prod.mk
            (ix_fail st
              (append (show_name nm)
                (append (utf8 " is at ordinal ")
                  (append (show_nat found) (append (utf8 ", the export says ") (show_nat o))))))
            w1)
          (match (ix_decl_of (ixs_vindex st) (ixs_vhdr st) i w1)
            ((Prod.mk (some d) w2)
             (if (= d o) (ix_names_check (ixs_checked_one st) r o w2)
             (Prod.mk
               (ix_fail st
                 (append (show_name nm)
                   (append (utf8 " declares ordinal ")
                     (append (show_nat d)
                       (append (utf8 " by its name id, the export says ") (show_nat o))))))
               w2)))
            ((Prod.mk none w2)
             (Prod.mk (ix_fail st (append (show_name nm) (utf8 " has no declaration row"))) w2)))))
       ((Prod.mk none w1)
        (Prod.mk (ix_fail st (append (show_name nm) (utf8 " is not in the name table"))) w1))))))

;; the names a record declares, with their ids: an inductive block's types, constructors
;; and recursors; every other record its one name
(fn ix_record_names ((st IxSt) (j Json) (kind (List Int))) (Option (List (Prod Int Name)))
  (if (int_list_eq kind (utf8 "inductive"))
    (match (jget j (utf8 "inductive"))
      (none none)
      ((some o)
       (match (ix_names_in st o (utf8 "types"))
         (none none)
         ((some ts)
          (match (ix_names_in st o (utf8 "ctors"))
            (none none)
            ((some cs)
             (match (ix_names_in st o (utf8 "recs"))
               (none none)
               ((some rs) (some (append ts (append cs rs)))))))))))
    (match (jget j kind)
      (none none)
      ((some o)
       (match (ix_name_field st o)
         (none none)
         ((some p) (some (list p))))))))
(fn ix_names_in ((st IxSt) (o Json) (key (List Int))) (Option (List (Prod Int Name)))
  (match (jget o key)
    (none (some nil))
    ((some v)
     (match (jarr v)
       (none none)
       ((some xs) (ix_names_of st xs nil))))))
(fn ix_names_of ((st IxSt) (xs (List Json)) (acc (List (Prod Int Name))))
  (Option (List (Prod Int Name)))
  (measure (struct xs))
  (match xs
    (nil (some (rev acc)))
    ((cons x r)
     (match (ix_name_field st x)
       (none none)
       ((some p) (ix_names_of st r (cons p acc)))))))
(fn ix_name_field ((st IxSt) (o Json)) (Option (Prod Int Name))
  (match (ix_int_field o (utf8 "name"))
    (none none)
    ((some i)
     (match (ix_name_at st i)
       (none none)
       ((some nm) (some (Prod.mk i nm)))))))

;; ---- the name table sorted, the declaration table laid out -----------------------------------

(fn ix_sort ((xs (List (Prod (List Int) Int)))) (List (Prod (List Int) Int))
  (measure (List.length xs))
  (match xs
    (nil nil)
    ((cons x nil) (list x))
    ((cons _ (cons _ _))
     (match (halves xs nil nil)
       ((Prod.mk a b) (ix_merge (ix_sort a) (ix_sort b)))))))
(fn ix_merge ((a (List (Prod (List Int) Int))) (b (List (Prod (List Int) Int))))
  (List (Prod (List Int) Int))
  (measure (+ (List.length a) (List.length b)))
  (match a
    (nil b)
    ((cons (Prod.mk ka va) ar)
     (match b
       (nil a)
       ((cons (Prod.mk kb vb) br)
        (if (int_list_lt kb ka) (cons (Prod.mk kb vb) (ix_merge a br))
        (cons (Prod.mk ka va) (ix_merge ar b))))))))
(fulfills ix_merge.dec_1
  (by (intro p ka va ar ha kb vb br hb hl) (rw ha) (rw List.length_cons) (arith)))
(fulfills ix_merge.dec_2
  (by (intro p ka va ar ha kb vb br hb hl) (rw hb) (rw List.length_cons) (arith)))
(fulfills ix_sort.dec_1 (by (intro xs x y r hx a b h) (apply halves_fst_lt (exact hx) (exact h))))
(fulfills ix_sort.dec_2 (by (intro xs x y r hx a b h) (apply halves_snd_lt (exact hx) (exact h))))
;; two adjacent equal keys in a sorted list: the first such key
(fn ix_dup ((xs (List (Prod (List Int) Int)))) (Option (List Int))
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons _ nil) none)
    ((cons (Prod.mk ka _) (cons (Prod.mk kb vb) r))
     (if (int_list_eq ka kb) (some ka) (ix_dup (cons (Prod.mk kb vb) r))))))
;; the declaration pairs sorted by name id
(fn ix_dsort ((xs (List (Prod Int Int)))) (List (Prod Int Int))
  (measure (List.length xs))
  (match xs
    (nil nil)
    ((cons x nil) (list x))
    ((cons _ (cons _ _))
     (match (halves xs nil nil)
       ((Prod.mk a b) (ix_dmerge (ix_dsort a) (ix_dsort b)))))))
(fn ix_dmerge ((a (List (Prod Int Int))) (b (List (Prod Int Int)))) (List (Prod Int Int))
  (measure (+ (List.length a) (List.length b)))
  (match a
    (nil b)
    ((cons (Prod.mk ka va) ar)
     (match b
       (nil a)
       ((cons (Prod.mk kb vb) br)
        (if (< kb ka) (cons (Prod.mk kb vb) (ix_dmerge a br))
        (cons (Prod.mk ka va) (ix_dmerge ar b))))))))
(fulfills ix_dmerge.dec_1
  (by (intro p ka va ar ha kb vb br hb hl) (rw ha) (rw List.length_cons) (arith)))
(fulfills ix_dmerge.dec_2
  (by (intro p ka va ar ha kb vb br hb hl) (rw hb) (rw List.length_cons) (arith)))
(fulfills ix_dsort.dec_1 (by (intro xs x y r hx a b h) (apply halves_fst_lt (exact hx) (exact h))))
(fulfills ix_dsort.dec_2 (by (intro xs x y r hx a b h) (apply halves_snd_lt (exact hx) (exact h))))
;; the declaration rows 0..d-1 from the sorted pairs, newest first
(fn ix_decl_rows ((ps (List (Prod Int Int))) (k Int) (d Int) (acc (List (List Int))))
  (List (List Int))
  (measure (+ (Int.natAbs (- d k)) (List.length ps)))
  (if (<= d k) acc
  (match ps
    ((cons (Prod.mk i o) r)
     (if (= i k) (ix_decl_rows r (+ k 1) d (cons (ix_render_drow o) acc))
     (if (< i k) (ix_decl_rows r k d acc)
     (ix_decl_rows ps (+ k 1) d (cons (ix_blank_drow) acc)))))
    (nil (ix_decl_rows nil (+ k 1) d (cons (ix_blank_drow) acc))))))
(fulfills ix_decl_rows.dec_1
  (by
    (intro p h i o r hm hi hlt)
    (have e
      (<
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (+ (proj PProd 0 (proj PProd 1 p)) 1)))
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (proj PProd 0 (proj PProd 1 p)))))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills ix_decl_rows.dec_2 (by (intro p h i o r hm hi hlt) (rw hm) (rw List.length_cons) (arith)))
(fulfills ix_decl_rows.dec_3
  (by
    (intro p h i o r hm he)
    (have e
      (<
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (+ (proj PProd 0 (proj PProd 1 p)) 1)))
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (proj PProd 0 (proj PProd 1 p)))))
      (apply natAbs_lt (arith) (arith)))
    (rw hm)
    (rw List.length_cons)
    (arith)))
(fulfills ix_decl_rows.dec_4
  (by
    (intro p h hm)
    (have e
      (<
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (+ (proj PProd 0 (proj PProd 1 p)) 1)))
        (Int.natAbs
          (- (proj PProd 0 (proj PProd 1 (proj PProd 1 p))) (proj PProd 0 (proj PProd 1 p)))))
      (apply natAbs_lt (arith) (arith)))
    (rw hm)
    (arith)))
;; rows newest first, concatenated oldest first
(fn ix_cat ((rows (List (List Int))) (acc (List Int))) (List Int)
  (measure (struct rows))
  (match rows
    (nil acc)
    ((cons r rest) (ix_cat rest (append r acc)))))
(fn ix_cat_names ((rows (List (Prod (List Int) Int))) (acc (List (List Int)))) (List (List Int))
  (measure (struct rows))
  (match rows
    (nil acc)
    ((cons (Prod.mk k o) rest) (ix_cat_names rest (cons (ix_render_nrow k o) acc)))))

;; ---- build and verify -------------------------------------------------------------------------

;; the index's bytes with its counts — records, names, declaration rows — or a message
(type IxOut (IxTables (List Int) Int Int Int) (IxBad (List Int)))
(fn ix_build ((export (List Int)) (w World)) (Prod IxOut World)
  (match (ix_scan export 0 nil (ix_st0 0 nil (IxHdr 0 0 0 0 0)) 100000000 w)
    ((Prod.mk st w1)
     (match (ixs_bad st)
       ((cons _ _) (Prod.mk (IxBad (ixs_bad st)) w1))
       (nil
         (let ((sorted (ix_sort (ixs_nrows st))))
           (match (ix_dup sorted)
             ((some k) (Prod.mk (IxBad (append (utf8 "two names render alike: ") (ix_trim k))) w1))
             (none
               (let ((decls (+ (ixs_lin st) 1)))
                 (Prod.mk
                   (IxTables
                     (append (ix_header (ixs_ord st) (ixs_size st) (ixs_meta st) (len sorted) decls)
                       (append (ix_cat (ixs_rows st) nil)
                         (append (ix_cat (ix_cat_names sorted nil) nil)
                           (ix_cat (ix_decl_rows (ix_dsort (ixs_drows st)) 0 decls nil) nil))))
                     (ixs_ord st)
                     (len sorted)
                     decls)
                   w1))))))))))
(fn ix_trim ((s (List Int))) (List Int) (rev (ix_trim_sp (rev s))))
(fn ix_trim_sp ((s (List Int))) (List Int)
  (measure (struct s))
  (match s
    ((cons c r) (if (= c 32) (ix_trim_sp r) s))
    (nil s)))
(fulfills ix_prefix_rows.dec_1
  (by
    (intro p h row w1 hr hs)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))

;; the tables against the export: the export's bytes as the header says, the index's size
;; the header's, every record's row and names, the name table sorted without a duplicate
(fn ix_verify ((export (List Int)) (index (List Int)) (w World)) (Prod (Option (List Int)) World)
  (match (ix_read_header index w)
    ((Prod.mk none w1) (Prod.mk (some (utf8 "the index has no header")) w1))
    ((Prod.mk (some h) w1)
     (match (ix_verify_size export (ix_hdr_bytes h) w1)
       ((Prod.mk false w2)
        (Prod.mk
          (some
            (append (utf8 "the export is not ") (append (show_nat (ix_hdr_bytes h)) (utf8 " bytes"))))
          w2))
       ((Prod.mk true w2)
        (match (ix_verify_size index (ix_total h) w2)
          ((Prod.mk false w3)
           (Prod.mk
             (some
               (append (utf8 "the index is not ") (append (show_nat (ix_total h)) (utf8 " bytes"))))
             w3))
          ((Prod.mk true w3)
           (match (ix_scan export 0 nil (ix_st0 1 index h) 100000000 w3)
             ((Prod.mk st w4)
              (match (ixs_bad st)
                ((cons _ _) (Prod.mk (some (ixs_bad st)) w4))
                (nil
                  (if (bool_not (= (ixs_ord st) (ix_hdr_records h)))
                    (Prod.mk
                      (some
                        (append (utf8 "the export has ")
                          (append (show_nat (ixs_ord st))
                            (append (utf8 " records, the table ") (show_nat (ix_hdr_records h))))))
                      w4)
                  (if (bool_not (= (ixs_meta st) (ix_hdr_meta h)))
                    (Prod.mk (some (utf8 "the meta line's length differs")) w4)
                  (if (bool_not (= (ixs_checked st) (ix_hdr_names h)))
                    (Prod.mk
                      (some
                        (append (utf8 "the export declares ")
                          (append (show_nat (ixs_checked st))
                            (append (utf8 " names, the table holds ") (show_nat (ix_hdr_names h))))))
                      w4)
                  (if (bool_not (= (+ (ixs_lin st) 1) (ix_hdr_decls h)))
                    (Prod.mk
                      (some
                        (append (utf8 "the export assigns ")
                          (append (show_nat (+ (ixs_lin st) 1))
                            (append (utf8 " name ids, the declaration table has ")
                              (show_nat (ix_hdr_decls h))))))
                      w4)
                    (ix_verify_sorted index h 0 nil w4))))))))))))))))
;; the file is exactly `bytes` long: a byte at bytes - 1, none at bytes
(fn ix_verify_size ((path (List Int)) (bytes Int) (w World)) (Prod Bool World)
  (match (read_range path bytes 1 w)
    ((Prod.mk (some nil) w1)
     (match (read_range path (- bytes 1) 1 w1)
       ((Prod.mk (some (cons _ nil)) w2) (Prod.mk true w2))
       ((Prod.mk _ w2) (Prod.mk false w2))))
    ((Prod.mk _ w1) (Prod.mk false w1))))
(fn ix_verify_sorted ((index (List Int)) (h IxHdr) (k Int) (prev (List Int)) (w World))
  (Prod (Option (List Int)) World)
  (measure (Int.natAbs (- (ix_hdr_names h) k)))
  (if (<= (ix_hdr_names h) k) (Prod.mk none w)
  (match (ix_read_nrow index h k w)
    ((Prod.mk none w1) (Prod.mk (some (append (utf8 "no name row ") (show_nat k))) w1))
    ((Prod.mk (some row) w1)
     (let ((key (take (ix_name_w) row)))
       (if (bool_and (< 0 k) (bool_not (int_list_lt prev key)))
         (Prod.mk (some (append (utf8 "the name table is not sorted at row ") (show_nat k))) w1)
         (ix_verify_sorted index h (+ k 1) key w1)))))))
(fulfills ix_verify_sorted.dec_1 (by (intro p h row w1 hm hb) (apply natAbs_lt (arith) (arith))))
