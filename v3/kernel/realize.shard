;;; v3/kernel/realize.shard — `realize` (v3/LANGUAGE.md §7, §7.5; §8.4 slice 3.16 rule 7;
;;; law §4.4): an E body attached to an existing admitted L constant under its own identity.
;;; The supplied form checks the E signature against the erasure of the constant's L type
;;; (erase.shard's roles), binds the signature's names to the constant's own telescope,
;;; elaborates the body once at the result's L type (elab.shard), takes its erasure as the
;;; program (erasure.shard), checks descent and callee order on it, and states one equation
;;; per leaf of the body's leading matchers — each a theorem `NAME.realize_N` the loader
;;; admits (proven by `Eq.refl`, or by the `equations` clause). The derived view erases the
;;; constant's L value. The equations' leaves are shared with define.shard's `fn`. Phase 2,
;;; slice 5b; rebuilt over the elaborator at slice 3.16 (the upward translation `tr` deleted).
(import "erasure.shard")
(import "classify.shard")
(use kernel.k)
(use kernel.classify)
(use kernel.decl)
(use kernel.erase)
(use kernel.erasure)
(use kernel.kw)
(use kernel.elab El el_w el0 el_set_w el_set_cx el_cx el_aux elab el_finish)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.predef.Either5)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.matcher)
(use kernel.name)
(use kernel.predef)
(use kernel.prelude)
(use kernel.prog)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.classify.PmRes)
(use kernel.classify.TyRes)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.kw.W)
(use kernel.kw.WOut)
(use kernel.etable.EHit)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtInd)
(use kernel.matcher.MtPat)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.sexpr.SExpr)
(use kernel.erasure.ErRes)
(use kernel.erasure.Either5r)
(fn nm_realize_n ((k Int)) Name (n1 (sym_of_chars (append "realize_" (show_nat k)))))
(fn nm_eq_n ((k Int)) Name (n1 (sym_of_chars (append "eq_" (show_nat k)))))

;; ---- substitution helpers of the equations' splits ---------------------------------------------
;; the metas are locals of the callee's telescope; a solved meta is compared structurally
(fn assoc_int_expr ((id Int) (sub (List (Pair Int Expr)))) (Option Expr)
  (measure (struct sub))
  (match sub (Nil None) ((Cons (Pair j e) r) (if (int_eq id j) (Some e) (assoc_int_expr id r)))))
;; the leaves of a body under the outer environment, with the columns the leading match may split
;; the first row all variables: a leaf (later rows are unreachable for these shapes); else split
;; the first column some row constrains
;; the first column index at which some row has a constructor pattern
;; every column bound to the row's variable at it
;; the slots as the body's variables: slot 0 outermost, slot n-1 innermost — capture order
;; column i split over the constructors of its inductive
(fn subst_all ((t Tr) (es (List Expr)) (id Int) (v Expr) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct es))
  (match es
    (Nil (Pair t (rev acc)))
    ((Cons e r) (match (tr_subst t e id v) ((Pair t1 e1) (subst_all t1 r id v (Cons e1 acc)))))))
;; a kept binder whose type mentions the split variable (an erased binder over a data parameter)
;; is re-opened at the substituted type; the pairs (old id, new local) apply to everything after
(fn refresh_kept ((t Tr) (kept (List Expr)) (vid Int) (cterm Expr) (acc (List Expr)) (pairs (List (Pair Int Expr)))) (Pair Tr (Pair (List Expr) (List (Pair Int Expr))))
  (measure (struct kept))
  (match kept
    (Nil (Pair t (Pair (rev acc) (rev pairs))))
    ((Cons fv r)
     (match (tr_type_of_local t fv)
       (None (refresh_kept t r vid cterm (Cons fv acc) pairs))
       ((Some ty)
        (match (tr_subst t ty vid cterm)
          ((Pair t1 ty1)
           (match (subst_pairs t1 ty1 (rev pairs))
             ((Pair t2 ty2)
              (if (expr_eq ty ty2) (refresh_kept t2 r vid cterm (Cons fv acc) pairs)
                (match (tr_local t2 (n1 (quote h)) ty2)
                  ((Pair t3 fv1) (refresh_kept t3 r vid cterm (Cons fv1 acc) (Cons (Pair (fvar_id_of fv) fv1) pairs))))))))))))))
(fn subst_pairs ((t Tr) (e Expr) (pairs (List (Pair Int Expr)))) (Pair Tr Expr)
  (measure (struct pairs))
  (match pairs
    (Nil (Pair t e))
    ((Cons (Pair id v) r) (match (tr_subst t e id v) ((Pair t1 e1) (subst_pairs t1 e1 r))))))
(fn without_id ((fvs (List Expr)) (id Int)) (List Expr)
  (measure (struct fvs))
  (match fvs
    (Nil Nil)
    ((Cons fv r) (if (int_eq (fvar_id_of fv) id) (without_id r id) (Cons fv (without_id r id))))))

;; ---- descent and order (§7.5) --------------------------------------------------------------
;; flags per variable (innermost first): 2 the structural parameter, 1 a proper subterm of it, 0 other
;; a realization cannot wait for a callee (the loader parks a fn's definition, never a realize):
;; the pending callee is the obstacle no_l_meaning here
(fn pending_as_runnable ((r (Option (Pair Symbol (List Int))))) (Option (Pair Symbol (List Int)))
  (match r
    ((Some (Pair e m)) (if (sym_eq e (quote callee_pending)) (Some (Pair (quote no_l_meaning) (append m ": a fn has no L meaning (RUNNABLE, §0)"))) r))
    (None None)))
(fn check_calls ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (e ETerm)) (Option (Pair Symbol (List Int)))
  (measure (struct e))
  (match e
    ((EBVar _) None)
    ((ELit _) None)
    ((ECtor _ as) (check_all es env id rec flags as))
    ((EPrim _ as) (check_all es env id rec flags as))
    ((EExt f _) (Some (Pair (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
    ((ECall f as)
     (match (check_all es env id rec flags as)
       ((Some x) (Some x))
       (None
        (if (name_eq f id)
          (match rec
            (RecNone (Some (Pair (quote realize_recursion) (append (show_name id) " calls itself without a measure"))))
            ((RecStruct i)
             (match (nth as i)
               ((Some (EBVar j)) (if (int_eq (flag_at flags j) 1) None (Some (Pair (quote realize_descent) (append (show_name id) ": a recursive call does not pass a proper subterm of the structural parameter")))))
               (_ (Some (Pair (quote realize_descent) (append (show_name id) ": a recursive call does not pass a proper subterm of the structural parameter"))))))
            ((RecMeasure _)
             (if (args_are_params as (len flags) 0)
               (Some (Pair (quote realize_descent) (append (show_name id) " calls itself on its own parameters — no measure decreases (§7.5)")))
               None)))
          (match (es_find_decl es f)
            ((Some (EFn _ _ _ _ _ _)) (match (env_find env f) ((Some _) None) (None (Some (Pair (quote callee_pending) (show_name f))))))   ; the loader parks a definition on a callee still parked; otherwise the obstacle no_l_meaning (§8.4 rule 1)
            ((Some (ESig _ _ _ _)) None)
            ((Some (EExtern _ _ _ _)) (Some (Pair (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
            (_ (Some (Pair (quote realize_order) (append (show_name f) ": cited before its realization is attached (§7.5)")))))))))
    ((EMatch s arms)
     (match (check_calls es env id rec flags s)
       ((Some x) (Some x))
       (None (check_arms es env id rec flags (match s ((EBVar j) (flag_at flags j)) (_ 0)) arms))))
    ((ELet rs b) (check_let es env id rec flags rs b))
    ((EIf a b c)
     (match (check_calls es env id rec flags a)
       ((Some x) (Some x))
       (None (match (check_calls es env id rec flags b) ((Some x) (Some x)) (None (check_calls es env id rec flags c))))))))
(fn check_all ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (ts (List ETerm))) (Option (Pair Symbol (List Int)))
  (measure (struct ts))
  (match ts (Nil None) ((Cons x r) (match (check_calls es env id rec flags x) ((Some y) (Some y)) (None (check_all es env id rec flags r))))))
(fn check_arms ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (sflag Int) (arms (List EArm))) (Option (Pair Symbol (List Int)))
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm p b) r)
     (match (check_calls es env id rec (rev_onto (pat_flags p sflag) flags) b)
       ((Some x) (Some x))
       (None (check_arms es env id rec flags sflag r))))))
;; a pattern's variables' flags in capture order: a variable at the top keeps the scrutinee's,
;; one under a constructor is a proper subterm when the scrutinee is the parameter or under it
(fn pat_flags ((p EPat) (sflag Int)) (List Int)
  (match p
    (PVar (list sflag))
    ((PLit _) Nil)
    ((PCtor _ subs) (sub_flags subs (if (lt 0 sflag) 1 0)))))
(fn sub_flags ((ps (List EPat)) (f Int)) (List Int)
  (measure (struct ps))
  (match ps
    (Nil Nil)
    ((Cons PVar r) (Cons f (sub_flags r f)))
    ((Cons (PLit _) r) (sub_flags r f))
    ((Cons (PCtor _ subs) r) (append (sub_flags subs f) (sub_flags r f)))))
(fn check_let ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (rs (List ETerm)) (b ETerm)) (Option (Pair Symbol (List Int)))
  (measure (struct rs))
  (match rs
    (Nil (check_calls es env id rec flags b))
    ((Cons x r)
     (match (check_calls es env id rec flags x)
       ((Some y) (Some y))
       (None (check_let es env id rec (Cons 0 flags) r b))))))
(fn flag_at ((flags (List Int)) (j Int)) Int (match (nth flags j) ((Some f) f) (None 0)))
;; the arguments are the parameters in order: argument i is the variable at depth n-1-i
(fn args_are_params ((as (List ETerm)) (n Int) (i Int)) Bool
  (measure (struct as))
  (match as
    (Nil True)
    ((Cons (EBVar j) r) (if (int_eq j (- (- n 1) i)) (args_are_params r n (+ i 1)) False))
    (_ False)))
;; the parameters' flags, innermost first: the structural parameter (0-based in binder order) is 2
(fn param_flags ((n Int) (rec ERec)) (List Int)
  (match rec
    ((RecStruct i) (rev (flags_upto n i 0)))
    (_ (zeros_int n))))
(fn flags_upto ((n Int) (i Int) (k Int)) (List Int)
  (measure (- n k))
  (if (le n k) Nil (Cons (if (int_eq k i) 2 0) (flags_upto n i (+ k 1)))))
(fn zeros_int ((n Int)) (List Int) (measure n) (if (lt n 1) Nil (Cons 0 (zeros_int (- n 1)))))

;; ---- the supplied form (§7.2, §7.5; slice 3.16 rule 7) ---------------------------------------
;; the result: the E table (Init inductives the walk registered), the EFn to attach once the
;; equations are admitted, the equations as theorem declarations in order, a pending measure
(type RzRes (RzOk ESt EDecl (List Declaration) (List Declaration) Bool) (RzErr Symbol (List Int)))
;; NAME's identity resolved through the scope: a definition of the environment
(type RtRes (RtOk Name ConstantInfo) (RtErr Symbol (List Int)))
(fn realize_target ((sc Scope) (env CheckedEnv) (n Name)) RtRes
  (match (resolve (cx0 sc env Nil Nil) n)
    (RNone (RtErr (quote unknown_constant) (show_name n)))
    ((RAmbiguous a b) (RtErr (quote ambiguous_name) (ambiguous_msg n a b)))
    ((RPend k) (RtErr (quote pending_obligation) (show_name k)))
    ((RName k _)
     (match (env_find env k)
       ((Some info)
        (match info
          ((DefnInfo _ _ _ _ _)
           (match (prim_l_identity k)
             ((Some _) (RtErr (quote realize_primitive) (append (show_name k) " is an entry of the primitive table (§6.4): K's own rule realizes it, and a body cites it as a primitive")))
             (None (RtOk k info))))
          (_ (RtErr (quote realize_kind) (append (show_name k) " is not a definition (an axiom, a theorem, a constructor or a type has no realization at Stage 0)")))))
       (None (RtErr (quote unknown_constant) (show_name n)))))))
;; the E signature read from BINDERS RET, compared with the erasure of the L type
(fn signature_matches ((es ESt) (sc Scope) (env CheckedEnv) (binds (List TBind)) (rt EType) (bs (List SExpr)) (ret SExpr)) (Option (List Int))
  (match (read_params es sc env Nil bs Nil Nil)
    ((PmErr e m) (Some (append (chars_of_sym e) (append ": " m))))
    ((PmOk _ ptypes tps)
     (match (read_ety es sc env tps ret)
       ((TyErr e m) (Some (append (chars_of_sym e) (append ": " m))))
       ((TyOk ert _)
        (if (bool_not (int_eq (len tps) (count_types binds))) (Some (append "the L type has " (append (show_nat (count_types binds)) (append " type parameters, the E signature " (show_nat (len tps))))))
        (match (data_mismatch binds ptypes 0)
          ((Some m) (Some m))
          (None (if (etype_eq ert rt) None (Some "the result type differs from the L type's erasure"))))))))))
(fn data_mismatch ((binds (List TBind)) (ptypes (List EType)) (i Int)) (Option (List Int))
  (measure (struct binds))
  (match binds
    (Nil (match ptypes (Nil None) (_ (Some "the E signature has more binders than the L type's erasure"))))
    ((Cons (TBind n (BData ety) _) r)
     (match ptypes
       (Nil (Some (append "the E signature lacks the binder " (show_name n))))
       ((Cons p pr) (if (etype_eq p ety) (data_mismatch r pr (+ i 1)) (Some (append "the binder " (append (show_name n) " has another type than the L type's erasure")))))))
    ((Cons _ r) (data_mismatch r ptypes i))))
(fn etype_eq ((a EType) (b EType)) Bool
  (measure (struct a))
  (match a
    ((ETVar i) (match b ((ETVar j) (int_eq i j)) (_ False)))
    ((ETCon n as) (match b ((ETCon m bs) (bool_and (name_eq n m) (etypes_eq as bs))) (_ False)))))
(fn etypes_eq ((as (List EType)) (bs (List EType))) Bool
  (measure (struct as))
  (match as
    (Nil (match bs (Nil True) (_ False)))
    ((Cons a ar) (match bs ((Cons b br) (bool_and (etype_eq a b) (etypes_eq ar br))) (Nil False)))))
;; the forms after RET without a trailing (equations THM…), and the clause's theorems
(type Either4 (Left4 Symbol (List Int)) (Right4 (List Name)))
(fn split_equations ((sc Scope) (env CheckedEnv) (rest (List SExpr))) (Pair (List SExpr) Either4)
  (match (rev rest)
    ((Cons (SList (Cons (SSym e) thms)) r)
     (if (sym_eq e (quote equations))
       (Pair (rev r) (thm_names sc env thms Nil))
       (Pair rest (Right4 Nil))))
    (_ (Pair rest (Right4 Nil)))))
(fn thm_names ((sc Scope) (env CheckedEnv) (ss (List SExpr)) (acc (List Name))) Either4
  (measure (struct ss))
  (match ss
    (Nil (Right4 (rev acc)))
    ((Cons (SSym x) r)
     (match (name_of_sym x)
       (None (Left4 (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (resolve (cx0 sc env Nil Nil) n)
          ((RName k _) (thm_names sc env r (Cons k acc)))
          ((RAmbiguous a b) (Left4 (quote ambiguous_name) (ambiguous_msg n a b)))
          ((RPend k) (Left4 (quote pending_obligation) (show_name k)))
          (RNone (Left4 (quote unknown_constant) (append (show_name n) " (the equations clause)")))))))
    (_ (Left4 (quote bad_shape) "(equations THM…) names theorems"))))
;; the theorem's identity for equation k: NAME.realize_k in the realizing module — a native
;; NAME already carries its module, an imported one is prefixed; NAME.eq_k for a definition
(fn eq_name ((sc Scope) (k Name) (dm Bool) (i Int)) Name
  (let ((suffix (if dm (nm_eq_n i) (nm_realize_n i))))
    (match (sc_vis sc)
      ((VisOnly _ _ tbl _)
       (match (tbl_find tbl k)
         ((Some m) (if (name_eq m (sc_tag sc)) (name_append k suffix) (qualify sc (name_append k suffix))))
         (None (qualify sc (name_append k suffix)))))
      (VisAll (name_append k suffix)))))
(fn realize_supplied ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (Cons _ (Cons (SSym x) (Cons (SList bs) (Cons ret rest0)))))
     (match (name_of_sym x)
       (None (RzErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info)
           (match (split_equations sc env rest0)
             ((Pair _ (Left4 e m)) (RzErr e m))
             ((Pair rest (Right4 thms))
              (match (tele_of (w0 env) es sc info)
                ((TeleErr e m) (RzErr e m))
                ((TeleOk w1 es1 (Tele ls binds rt rl))
                 (match (signature_matches es1 sc env binds rt bs ret)
                   ((Some m) (RzErr (quote realize_signature) (append (show_name k) (append ": " m))))
                   (None
                    (realize_body (ensure_head es1 sc k (count_data binds)) sc env k w1 ls binds rt rl bs rest thms))))))))))))
    (_ (RzErr (quote bad_shape) "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?) or (realize NAME (view))"))))
;; the body, elaborated once against the constant's own telescope (slice 3.16 rule 7): the
;; signature's names bound to the telescope's locals — a type or data binder each, an erased
;; binder none —, the body at the result's L type; its program the erasure, its equations the
;; leaves of its leading matchers, the matchers it generated admitted before them
(fn realize_body ((es ESt) (sc Scope) (env CheckedEnv) (k Name) (w W) (ls (List Level)) (binds (List TBind)) (rt EType) (rl Expr) (bs (List SExpr)) (rest (List SExpr)) (thms (List Name))) RzRes
  (match (fn_body rest)
    (None (RzErr (quote bad_shape) "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?)"))
    ((Some body)
     (let ((e0 (bind_tele (el_set_w (el0 sc env Nil Nil (qualify sc (name_append k (n1 (quote realize))))) w) binds bs)))
       (match (fn_rec e0 (fn_measure rest) (tbind_fvars binds))
         ((Pair _ (Left5 r m)) (RzErr r m))
         ((Pair e1 (Right5 prec))
          (match (elab e1 body (Some rl))
            ((EErr r m) (if (sym_eq r (quote unknown_constant)) (unknown_in_body es sc m) (RzErr r m)))
            ((EOk e2 v _)
             (match (el_finish e2 v)
               ((FinErr r m) (RzErr r m))
               ((FinOk b)
                (let ((t (tr_new (el_w e2) es sc k (tbind_types binds))) (ents (binder_ents binds)))
                  (match (predef_rec t ents prec binds)
                    ((Pair _ (Left5r r m)) (RzErr r m))
                    ((Pair t0 (Right5r rec))
                     (match (erase t0 ents b (budget_depth))
                       ((ErErr r m) (RzErr r m))
                       ((ErOk t1 ebody)
                        (match (pending_as_runnable (check_calls (Tr.es t1) env k rec (param_flags (count_data binds) rec) ebody))
                          ((Some (Pair r m)) (RzErr r m))
                          (None
                           (match (pj_equations t1 (mk_const k ls) (- 0 1) (tbind_fvars binds) rl b thms False)
                             ((Pair _ (Left3 r m)) (RzErr r m))
                             ((Pair t2 (Right3 decls))
                              (RzOk (Tr.es t2) (EFn k (count_types binds) (bind_ptypes binds) rt rec ebody) (el_aux e2) decls (match rec ((RecMeasure _) True) (_ False))))))))))))))))))))))
;; a name the environment lacks, in a realization's body: a RUNNABLE function has no L meaning
;; (a realization cannot wait for it, §7.5); an E primitive has no L identity (§6.4)
(fn unknown_in_body ((es ESt) (sc Scope) (m (List Int))) RzRes
  (match (name_of_sym (sym_of_chars m))
    (None (RzErr (quote unknown_constant) m))
    ((Some n)
     (match (only_values (eresolve es sc n))
       ((Cons (EHit id _ _) _) (RzErr (quote no_l_meaning) (append (show_name id) ": a fn has no L meaning (RUNNABLE, §0) — realize it, or make it a def")))
       (Nil (match (prim_find n)
              ((Some _) (RzErr (quote no_l_identity) (append m ": an E primitive with no L identity (§6.4) — cite the L constant")))
              (None (RzErr (quote unknown_constant) m))))))))
(fn bind_tele ((e El) (binds (List TBind)) (bs (List SExpr))) El
  (measure (struct binds))
  (match binds
    (Nil e)
    ((Cons (TBind _ BErased _) r) (bind_tele e r bs))
    ((Cons (TBind _ _ fv) r)
     (match bs
       ((Cons (SList (Cons (SSym x) _)) br)
        (bind_tele (match (name_of_sym x) ((Some n) (el_set_cx e (cx_bind (el_cx e) n fv))) (None e)) r br))
       (_ e)))))
;; the realized constant as a function head of the E table, when pre-registration could not resolve it
(fn ensure_head ((es ESt) (sc Scope) (k Name) (arity Int)) ESt
  (match (es_info es k) ((Some _) es) (None (es_register es k (sc_tag sc) (EIFn arity)))))

;; ---- the equations (§7.5; slice 3.16 landing 3) ----------------------------------------------
(type Either3 (Left3 Symbol (List Int)) (Right3 (List Declaration)))
;; the data binders as the body's variables in binder order (the caller reverses), with their flags
;; (param_flags gives them innermost first, so they are consumed reversed)
;; Eq.refl, or the clause's theorem applied to the binders — at the constant's solved levels
;; when it has as many universe parameters, at none when it has none
(fn proof_of ((t Tr) (kept (List Expr)) (rl Expr) (lhs Expr) (thm (Option Name)) (ls (List Level))) (Pair Tr (Option Expr))
  (match thm
    (None (match (tr_apps t (mk_const (nm_eq_refl) (list (level_one))) (list rl lhs)) ((Pair t1 e) (Pair t1 (Some e)))))
    ((Some th)
     (let ((arity (match (env_find (tr_env t) th) ((Some info) (len (ci_lparams info))) (None 0))))
       (if (int_eq arity 0) (match (tr_apps t (mk_const th Nil) kept) ((Pair t1 e) (Pair t1 (Some e))))
       (if (int_eq arity (len ls)) (match (tr_apps t (mk_const th ls) kept) ((Pair t1 e) (Pair t1 (Some e))))
         (Pair t None)))))))
;; the leaves of the body's leading matchers, read off the rows without reduction: a row
;; against the scrutinee term binds, clashes, or is stuck on a local — a universally quantified
;; one is split over its constructors, in order, the first row that does not clash deciding —
;; so the leaves and their numbering are the case tree's, a fall-through row one equation per
;; leaf it reaches. `∀ kept, f lhs = rhs`, the self-local the constant, by Eq.refl
(type PjLeaf (PjLeaf (List Expr) (List Expr) Expr Expr))   ; the left-hand side's arguments, the binders, the result type, the body
(type PjFo (FoBind (List (Pair Int Expr))) (FoClash) (FoStuck Int))
(fn pj_equations ((t Tr) (head Expr) (selfid Int) (binders (List Expr)) (rl Expr) (body Expr) (thms (List Name)) (dm Bool)) (Pair Tr Either3)
  (match (pj_leaves t binders binders rl body 256 Nil)
    ((Pair t1 None) (Pair t1 (Left3 (quote equation_form) "a constructor no row covers")))
    ((Pair t1 (Some lvs))
     (if (bool_and (lt 0 (len thms)) (bool_not (int_eq (len thms) (len lvs))))
       (Pair t1 (Left3 (quote equations_count) (append "the body has " (append (show_nat (len lvs)) (append " equations, the clause names " (show_nat (len thms)))))))
       (pj_equation_decls t1 head selfid (rev lvs) thms dm 1 Nil)))))
(fn pj_leaves ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure fuel)
  (if (lt fuel 1) (Pair t None)
  (match (get_app_fn body)
    ((Const _ c _)
     (match (mt_is_matcher (tr_env t) c)
       ((Some (MtDesc np 1 rows))
        (let ((args (get_app_args body)))
          (if (bool_not (int_eq (len args) (+ np (+ 2 (len rows))))) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))
            (match (nth args (+ np 1))
              (None (Pair t None))
              ((Some s) (pj_rows t lhs kept rl body s rows (drop (+ np 2) args) fuel acc))))))
       (_ (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc))))))
    (_ (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))))))
(fn pj_rows ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (s Expr) (rows (List (List MtPat))) (alts (List Expr)) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure (struct rows))
  (match rows
    (Nil (Pair t None))
    ((Cons row rr)
     (match alts
       (Nil (Pair t None))
       ((Cons alt ar)
        (match (pj_fo_all (tr_env t) row (list s) (FoBind Nil))
          (FoClash (pj_rows t lhs kept rl body s rr ar fuel acc))
          ((FoBind binds)
           (match (pj_inst_lams t alt (pj_slot_args binds (len binds) 0))
             ((Pair t1 b1) (pj_leaves t1 lhs kept rl b1 (- fuel 1) acc))))
          ((FoStuck vid)
           (if (bool_not (mem_int vid (fvar_ids kept))) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))
             (pj_split t lhs kept rl body vid fuel acc)))))))))
(fn pj_slot_args ((binds (List (Pair Int Expr))) (n Int) (i Int)) (List Expr)
  (measure (- n i))
  (if (le n i) Nil
    (Cons (match (assoc_int_expr i binds) ((Some v) v) (None (mk_const Anon Nil))) (pj_slot_args binds n (+ i 1)))))
;; a row's patterns against terms: a clash anywhere decides (the row is gone from the
;; specialized matrix), else the first stuck local, else the bindings
(fn pj_fo_all ((env CheckedEnv) (ps (List MtPat)) (ts (List Expr)) (st PjFo)) PjFo
  (measure (struct ps))
  (match ps
    (Nil st)
    ((Cons p pr)
     (match ts
       (Nil st)
       ((Cons x xr)
        (match (pj_fo env p x st)
          (FoClash FoClash)
          (st1 (pj_fo_all env pr xr st1))))))))
(fn pj_fo ((env CheckedEnv) (p MtPat) (x Expr) (st PjFo)) PjFo
  (measure (struct p))
  (match p
    ((MtVar slot) (match st ((FoBind binds) (FoBind (Cons (Pair slot x) binds))) (other other)))
    ((MtCtor c subs)
     (match (get_app_fn x)
       ((FVar _ id) (match st ((FoBind _) (FoStuck id)) (other other)))
       ((Const _ c2 _)
        (if (name_eq c c2) (pj_fo_all env subs (drop (- (len (get_app_args x)) (len subs)) (get_app_args x)) st)
          (if (pj_is_ctor env c2) FoClash (match st ((FoBind _) (FoStuck (- 0 1))) (other other)))))
       (_ (match st ((FoBind _) (FoStuck (- 0 1))) (other other)))))))
(fn pj_is_ctor ((env CheckedEnv) (c Name)) Bool
  (match (env_find env c) ((Some (CtorInfo _ _ _ _ _ _)) True) (_ False)))
;; the local split over its inductive's constructors: the constructor term for it in the
;; left-hand side, the result type and the body, its fields new binders
(fn pj_split ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (vid Int) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (match (w_local_type (Tr.w t) vid)
    (None (Pair t None))
    ((Some vty)
     (match (mt_ind_of (Tr.w t) vty)
       ((Pair _ (MtNoInd _ _)) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc))))
       ((Pair w1 (MtInd _ ls largs ctors)) (pj_split_ctors (tr_set_w t w1) lhs kept rl body vid ctors ls largs fuel acc))))))
(fn pj_split_ctors ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (vid Int) (ctors (List Name)) (ls (List Level)) (largs (List Expr)) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some acc)))
    ((Cons c r)
     (match (rz_open_ctor t c ls largs)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fields cterm)))
        (match (subst_all t1 lhs vid cterm Nil)
          ((Pair t2 lhs1)
           (match (tr_subst t2 rl vid cterm)
             ((Pair t3 rl1)
              (match (tr_subst t3 body vid cterm)
                ((Pair t4 body1)
                 (match (refresh_kept t4 (without_id kept vid) vid cterm Nil Nil)
                   ((Pair t5 (Pair kept0 pairs))
                    (match (pj_subst_pairs_all t5 lhs1 pairs Nil)
                      ((Pair t6 lhs2)
                       (match (subst_pairs t6 rl1 pairs)
                         ((Pair t7 rl2)
                          (match (subst_pairs t7 body1 pairs)
                            ((Pair t8 body2)
                             (match (pj_leaves t8 lhs2 (append kept0 (field_fvars fields)) rl2 body2 (- fuel 1) acc)
                               ((Pair t9 None) (Pair t9 None))
                               ((Pair t9 (Some acc1)) (pj_split_ctors t9 lhs kept rl body vid r ls largs fuel acc1))))))))))))))))))))))
(fn pj_subst_pairs_all ((t Tr) (es (List Expr)) (pairs (List (Pair Int Expr))) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct es))
  (match es
    (Nil (Pair t (rev acc)))
    ((Cons e r) (match (subst_pairs t e pairs) ((Pair t1 e1) (pj_subst_pairs_all t1 r pairs (Cons e1 acc)))))))
;; a fn's leaf is stated where K decides it by conversion — the definition is in the walk's
;; environment (define.shard). A structural recursion whose leaf leaves the structural
;; argument a local, or keeps a self-call under a matcher that is still stuck, unfolds only by
;; a case analysis: that equation is I's, and the leaf keeps its number. A realization's
;; equations are all stated (its clause may prove them; a wrong one is K's refusal)
(fn pj_decided ((t Tr) (dm Bool) (lhs Expr) (rhs Expr)) (Pair Tr Bool)
  (if (bool_not dm) (Pair t True)
    (match (w_is_def_eq_r (Tr.w t) lhs rhs)
      ((Pair w1 (WVal True)) (Pair (tr_set_w t w1) True))
      ((Pair w1 _) (Pair (tr_set_w t w1) False)))))
;; a leaf's theorem: the self-local (a fn's) the constant; Eq.refl, or the equations clause's
;; theorem applied to the binders (a realize's); a fn's equation under its identity (dm), a
;; realization's under the realizing module (eq_name)
(fn pj_equation_decls ((t Tr) (head Expr) (selfid Int) (lvs (List PjLeaf)) (thms (List Name)) (dm Bool) (i Int) (acc (List Declaration))) (Pair Tr Either3)
  (measure (struct lvs))
  (match lvs
    (Nil (Pair t (Right3 (rev acc))))
    ((Cons (PjLeaf lhs kept rl body) r)
     (match (tr_subst t body selfid head)
       ((Pair t1 rhs)
        (match (tr_apps t1 head lhs)
          ((Pair t2a lhs1)
           (match (pj_decided t2a dm lhs1 rhs)
             ((Pair t2 False) (pj_equation_decls t2 head selfid r thms dm (+ i 1) acc))
             ((Pair t2 True)
           (match (tr_apps t2 (mk_const (nm_eq) (list (level_one))) (list rl lhs1 rhs))
             ((Pair t3 stmt)
              (match (tr_pis t3 kept stmt)
                ((Pair t4 ty)
                 (match (proof_of t4 kept rl lhs1 (nth thms (- i 1)) (match head ((Const _ _ ls) ls) (_ Nil)))
                   ((Pair t5 None) (Pair t5 (Left3 (quote universe_arity) "a theorem of the equations clause takes neither no universe arguments nor the constant's")))
                   ((Pair t5 (Some proof))
                    (match (tr_lams t5 kept proof)
                      ((Pair t6 value)
                       (let ((name (if dm (name_append (Tr.id t6) (nm_eq_n i)) (eq_name (Tr.sc t6) (Tr.id t6) False i))))
                         (pj_equation_decls t6 head selfid r thms dm (+ i 1) (Cons (ThmDecl (ConstantVal name Nil ty) value (list name)) acc))))))))))))))))))))

;; ---- the derived view (§7.1, §7.5) --------------------------------------------------------------
(fn realize_view ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (Cons _ (Cons (SSym x) _)))
     (match (name_of_sym x)
       (None (RzErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info)
           (match (tele_of (w0 env) es sc info)
             ((TeleErr e m) (RzErr e m))
             ((TeleOk w1 es1 (Tele ls binds rt _))
              (match (ci_value info)
                (None (RzErr (quote realize_kind) (append (show_name k) " has no value")))
                ((Some v0)
                 (match (w_inst_lparams w1 v0 (ci_lparams info) ls)
                   ((Pair w2 v)
                    (let ((t (tr_new w2 es1 sc k (tbind_types binds))))
                      (match (peel_binders t v binds)
                        ((Pair t1 body)
                         (match (erase t1 (binder_ents binds) body (budget_depth))
                           ((ErErr e m) (RzErr e m))
                           ((ErOk t2 ebody)
                            (let ((ptypes (bind_ptypes binds)))
                              (match (classify_both (Tr.es t2) k (some_all (rev ptypes)) ebody RecNone)
                                ((Some (Pair e m)) (RzErr e m))
                                (None (RzOk (Tr.es t2) (EFn k (count_types binds) ptypes rt RecNone ebody) Nil Nil False))))))))))))))))))))
    (_ (RzErr (quote bad_shape) "(realize NAME (view))"))))
;; the value's leading lambdas instantiated with the binders' locals; fewer lambdas than binders: applied to the rest
(fn peel_binders ((t Tr) (v Expr) (binds (List TBind))) (Pair Tr Expr)
  (measure (struct binds))
  (match binds
    (Nil (Pair t v))
    ((Cons (TBind _ _ fv) r)
     (match v
       ((Lam _ _ _ _ body) (match (tr_inst1 t body fv) ((Pair t1 body1) (peel_binders t1 body1 r))))
       (_ (match (tr_apps t v (list fv)) ((Pair t1 v1) (peel_binders t1 v1 r))))))))
