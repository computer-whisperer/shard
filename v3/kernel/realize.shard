;;; v3/kernel/realize.shard — `realize` (v3/LANGUAGE.md §7, §7.5; law §4.4):
;;; an E body attached to an existing admitted L constant under its own
;;; identity. The supplied form reads the body as a `fn`'s, checks the E
;;; signature against the erasure of the constant's L type (erase.shard's
;;; roles), checks descent and callee order, and states one equation per
;;; leaf of the body's case tree — the E body translated into L head for
;;; head, the constant's telescope filled by first-order matching — each a
;;; theorem `NAME.realize_N` the loader admits (proven by `Eq.refl`, or by
;;; the `equations` clause). The derived view erases the constant's L value
;;; into an E body by the same roles. Phase 2, slice 5b.
(import "classify.shard")
(use kernel.accel_pins)
(use kernel.add)
(use kernel.classify)
(use kernel.decl)
(use kernel.env)
(use kernel.erase)
(use kernel.etable)
(use kernel.expr)
(use kernel.inductive)
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.nested)
(use kernel.prelude)
(use kernel.prog)
(use kernel.reader)
(use kernel.sexpr)
(use kernel.tc)
(use kernel.util)
(use kernel.classify.CRes)
(use kernel.classify.PmRes)
(use kernel.classify.TyRes)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.env.CheckedEnv)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.erase.W)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.reader.Resolved)
(use kernel.reader.Scope)
(use kernel.reader.Vis)
(use kernel.sexpr.SExpr)

;; ---- the translation state ------------------------------------------------------------
;; the walk (environment, locals, checker state), the E table, the scope, the realized
;; constant's identity and its type parameters' locals (an ETVar of the body is one of them)
(type Tr (Tr W ESt Scope Name (List Expr)))
(fn tr_w ((t Tr)) W (match t ((Tr w _ _ _ _) w)))
(fn tr_es ((t Tr)) ESt (match t ((Tr _ e _ _ _) e)))
(fn tr_sc ((t Tr)) Scope (match t ((Tr _ _ s _ _) s)))
(fn tr_id ((t Tr)) Name (match t ((Tr _ _ _ n _) n)))
(fn tr_tps ((t Tr)) (List Expr) (match t ((Tr _ _ _ _ p) p)))
(fn tr_set_w ((t Tr) (w W)) Tr (match t ((Tr _ e s n p) (Tr w e s n p))))
(fn tr_set_es ((t Tr) (es ESt)) Tr (match t ((Tr w _ s n p) (Tr w es s n p))))
(fn tr_env ((t Tr)) CheckedEnv (w_env (tr_w t)))
(type TrRes (TrOk Tr Expr) (TrErr Symbol (List Int)))
;; an E variable's meaning: its L term, its static E type, its descent flag
;; (2 the structural parameter itself, 1 a proper subterm of it, 0 other)
(type EV (EV Expr (Option EType) Int))
(fn evt_term ((v EV)) Expr (match v ((EV e _ _) e)))
(fn ev_type ((v EV)) (Option EType) (match v ((EV _ t _) t)))
(fn env_types ((env (List EV))) (List (Option EType))
  (measure (struct env))
  (match env (Nil Nil) ((Cons v r) (Cons (ev_type v) (env_types r)))))
;; K through the state
(fn tr_infer ((t Tr) (e Expr)) (Pair Tr (Option Expr))
  (match (w_infer (tr_w t) e) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_whnf ((t Tr) (e Expr)) (Pair Tr (Option Expr))
  (match (w_whnf (tr_w t) e) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_local ((t Tr) (n Name) (ty Expr)) (Pair Tr Expr)
  (match (w_local (tr_w t) n ty) ((Pair w1 fv) (Pair (tr_set_w t w1) fv))))
(fn tr_local_val ((t Tr) (n Name) (ty Expr) (v Expr)) (Pair Tr Expr)
  (match (w_local_val (tr_w t) n ty v) ((Pair w1 fv) (Pair (tr_set_w t w1) fv))))
(fn tr_inst1 ((t Tr) (e Expr) (v Expr)) (Pair Tr Expr)
  (match (w_inst1 (tr_w t) e v) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_apps ((t Tr) (f Expr) (args (List Expr))) (Pair Tr Expr)
  (match (w_apps (tr_w t) f args) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_lams ((t Tr) (fvs (List Expr)) (b Expr)) (Pair Tr Expr)
  (match (w_lams (tr_w t) fvs b) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_pis ((t Tr) (fvs (List Expr)) (b Expr)) (Pair Tr Expr)
  (match (w_pis (tr_w t) fvs b) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_subst ((t Tr) (e Expr) (id Int) (v Expr)) (Pair Tr Expr)
  (match (w_subst (tr_w t) e id v) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_type_of_local ((t Tr) (fv Expr)) (Option Expr)
  (match fv
    ((FVar _ id) (match (lctx_find (w_lctx (tr_w t)) id) ((Some d) (Some (ldecl_type d))) (None None)))
    (_ None)))
;; the telescope of a constant, its binders opened in the state
(fn tr_tele ((t Tr) (info ConstantInfo)) (Pair Tr (Option Tele))
  (match (tele_of (tr_w t) (tr_es t) (tr_sc t) info)
    ((TeleErr _ _) (Pair t None))
    ((TeleOk w1 es1 tele) (Pair (Tr w1 es1 (tr_sc t) (tr_id t) (tr_tps t)) (Some tele)))))
(fn level_one () Level (LSucc LZero))
(fn nm_realize_n ((k Int)) Name (n1 (sym_of_chars (append "realize_" (show_nat k)))))

;; ---- first-order matching (§7.5): a binder's declared type against an inferred one ----
;; the metas are locals of the callee's telescope; a solved meta is compared structurally
(fn fo_match ((pat Expr) (term Expr) (metas (List Int)) (sub (List (Pair Int Expr)))) (Option (List (Pair Int Expr)))
  (measure (struct pat))
  (match pat
    ((FVar _ id)
     (if (mem_int id metas)
       (match (assoc_int_expr id sub)
         ((Some bound) (if (expr_eq bound term) (Some sub) None))
         (None (Some (Cons (Pair id term) sub))))
       (if (expr_eq pat term) (Some sub) None)))
    ((App _ f a)
     (match term
       ((App _ g b) (match (fo_match f g metas sub) (None None) ((Some s1) (fo_match a b metas s1))))
       (_ None)))
    ((Lam _ _ _ d b)
     (match term ((Lam _ _ _ d2 b2) (match (fo_match d d2 metas sub) (None None) ((Some s1) (fo_match b b2 metas s1)))) (_ None)))
    ((Pi _ _ _ d b)
     (match term ((Pi _ _ _ d2 b2) (match (fo_match d d2 metas sub) (None None) ((Some s1) (fo_match b b2 metas s1)))) (_ None)))
    ((Let _ _ ty v b)
     (match term
       ((Let _ _ ty2 v2 b2)
        (match (fo_match ty ty2 metas sub)
          (None None)
          ((Some s1) (match (fo_match v v2 metas s1) (None None) ((Some s2) (fo_match b b2 metas s2))))))
       (_ None)))
    ((Proj _ sn i x) (match term ((Proj _ sn2 i2 x2) (if (bool_and (name_eq sn sn2) (int_eq i i2)) (fo_match x x2 metas sub) None)) (_ None)))
    (_ (if (expr_eq pat term) (Some sub) None))))
(fn assoc_int_expr ((id Int) (sub (List (Pair Int Expr)))) (Option Expr)
  (measure (struct sub))
  (match sub (Nil None) ((Cons (Pair j e) r) (if (int_eq id j) (Some e) (assoc_int_expr id r)))))
;; the match with the term in weak-head normal form as the fallback
(fn tr_match ((t Tr) (pat Expr) (term Expr) (metas (List Int)) (sub (List (Pair Int Expr)))) (Pair Tr (Option (List (Pair Int Expr))))
  (match (fo_match pat term metas sub)
    ((Some s1) (Pair t (Some s1)))
    (None
     (match (tr_whnf t term)
       ((Pair t1 (Some term2)) (if (expr_eq term term2) (Pair t1 None) (Pair t1 (fo_match pat term2 metas sub))))
       ((Pair t1 None) (Pair t1 None))))))

;; ---- an E type as an L type (§7.5): the fallback for a bare constructor's type arguments ----
(fn tr_type ((t Tr) (ety EType)) (Pair Tr (Option Expr))
  (match ety
    ((ETVar i) (Pair t (nth (tr_tps t) i)))
    ((ETCon n args)
     (if (is_nat_or_int n) (if (int_eq (len args) 0) (Pair t (Some (mk_const n Nil))) (Pair t None))
       (match (env_find (tr_env t) n)
         ((Some info)
          (match info
            ((InductInfo _ nparams _ _ _ _ _ _ _)
             (if (bool_not (int_eq nparams (len args))) (Pair t None)   ; an erased parameter: not expressible from E
               (match (solve_levels info)
                 (None (Pair t None))
                 ((Some ls)
                  (match (tr_types t args Nil)
                    ((Pair t1 None) (Pair t1 None))
                    ((Pair t1 (Some largs)) (match (tr_apps t1 (mk_const n ls) largs) ((Pair t2 e) (Pair t2 (Some e))))))))))
            (_ (Pair t None))))
         (None (Pair t None)))))))
(fn tr_types ((t Tr) (ts (List EType)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ts))
  (match ts
    (Nil (Pair t (Some (rev acc))))
    ((Cons x r) (match (tr_type t x) ((Pair t1 None) (Pair t1 None)) ((Pair t1 (Some e)) (tr_types t1 r (Cons e acc)))))))

;; ---- a constant applied through its telescope (§7.5) ----------------------------------------
;; the runtime binders take the E arguments (translated with their expected E types), the
;; type parameters and erased binders are metas solved by matching each runtime binder's
;; declared type against its argument's inferred type; a type parameter still open is read
;; off the E type argument; anything still open names the position
(type Ap (Ap (List (Pair Bool Expr)) (List (Pair Int Expr)) (List Int)))   ; the arguments so far (reversed; True = a meta), the solutions, the metas
(type Either (Left Symbol (List Int)) (Right Ap))
;; the expected E types of the runtime arguments: the declared parameter types under the type arguments
(fn expected_of ((etargs (List EType)) (eptypes (List EType))) (List EType) (subst_tys etargs eptypes))
(fn apply_binds ((t Tr) (env (List EV)) (head Name) (binds (List TBind)) (eargs (List ETerm)) (exps (List EType)) (ap Ap) (i Int)) (Pair Tr Either)
  (measure (struct binds))
  (match binds
    (Nil (match eargs (Nil (Pair t (Right ap))) (_ (Pair t (Left (quote unsaturated) (append (show_name head) " is given too many arguments"))))))
    ((Cons (TBind n role fv) rest)
     (match ap
       ((Ap rargs sub metas)
        (match role
          ((BData _)
           (match eargs
             (Nil (Pair t (Left (quote unsaturated) (append (show_name head) " is given too few arguments"))))
             ((Cons a ar)
              (match (tr t env (expected_at exps i) a)
                ((TrErr e m) (Pair t (Left e m)))
                ((TrOk t1 a1)
                 (match (tr_infer t1 a1)
                   ((Pair t2 None) (Pair t2 (Left (quote untyped_subterm) (append (show_name head) ": K could not type an argument"))))
                   ((Pair t2 (Some aty))
                    (match (tr_type_of_local t2 fv)
                      (None (Pair t2 (Left (quote realize_signature) (show_name head))))
                      ((Some pat)
                       (match (tr_match t2 pat aty metas sub)
                         ((Pair t3 None) (Pair t3 (Left (quote untyped_subterm) (append (show_name head) (append ": the argument for " (append (show_name n) " has another type than the binder's"))))))
                         ((Pair t3 (Some sub1)) (apply_binds t3 env head rest ar exps (Ap (Cons (Pair False a1) rargs) sub1 metas) (+ i 1)))))))))))))
          (_ (apply_binds t env head rest eargs exps (Ap (Cons (Pair True fv) rargs) sub (Cons (fvar_id_of fv) metas)) i))))))))
(fn expected_at ((exps (List EType)) (i Int)) (Option EType) (nth exps i))
;; the arguments with every meta replaced by its solution; an unsolved meta is None
(fn fill_metas ((t Tr) (head Name) (args (List (Pair Bool Expr))) (sub (List (Pair Int Expr))) (acc (List Expr)) (i Int)) (Pair Tr (Option (List Expr)))
  (measure (struct args))
  (match args
    (Nil (Pair t (Some (rev acc))))
    ((Cons (Pair is_meta a) r)
     (if is_meta
       (match (assoc_int_expr (fvar_id_of a) sub)
         ((Some v) (fill_metas t head r sub (Cons v acc) (+ i 1)))
         (None (Pair t None)))
       (fill_metas t head r sub (Cons a acc) (+ i 1))))))

;; ---- the translation of a body (§7.5) -----------------------------------------------------
(fn tr ((t Tr) (env (List EV)) (expected (Option EType)) (e ETerm)) TrRes
  (measure (struct e))
  (match e
    ((EBVar i) (match (nth env i) ((Some v) (TrOk t (evt_term v))) (None (TrErr (quote unbound_name) "a variable the translation does not know"))))
    ((ELit (LNat n)) (TrOk t (nat_lit n)))
    ((ELit _) (TrErr (quote no_l_identity) "a literal of the toolchain profile has no L meaning (§7.5)"))
    ((ECtor c args) (tr_ctor t env expected c args))
    ((ECall f args) (tr_call t env expected f args))
    ((EPrim n args)
     (match (prim_l_identity n)
       (None (TrErr (quote no_l_identity) (append (show_name n) ": the profile's spelling has no L identity — write the naming-law spelling (Nat.add, Nat.decLt, …; §6.4, §7.5)")))
       ((Some ident)
        (match (env_find (tr_env t) ident)
          (None (TrErr (quote unknown_constant) (append (show_name ident) ": the Init prefix does not reach the primitive's L identity")))
          ((Some info) (apply_const_e t env ident info args Nil Nil))))))
    ((EExt f _) (TrErr (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning")))
    ((ELet rs b) (tr_let t env expected rs b Nil))
    ((EIf c a b) (tr_if t env expected c a b))
    ((EMatch s arms) (tr_match_rec t env expected s arms))))
;; a constructor: its E type's arguments from the classifier as the fallback for the metas
(fn tr_ctor ((t Tr) (env (List EV)) (expected (Option EType)) (c Name) (args (List ETerm))) TrRes
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ ind _ _ _ _)
        (apply_const_e t env c info args (ctor_etargs t env expected c args ind) (ctor_eptypes t c ind)))
       (_ (TrErr (quote unknown_head) (show_name c)))))
    (None (TrErr (quote unknown_constant) (show_name c)))))
;; the E type arguments a constructor application has: the expected type's when it names the
;; inductive, else the classifier's inference from the arguments
(fn ctor_etargs ((t Tr) (env (List EV)) (expected (Option EType)) (c Name) (args (List ETerm)) (ind Name)) (List EType)
  (match expected
    ((Some (ETCon n eargs)) (if (name_eq n ind) eargs (etargs_inferred t env c args)))
    (_ (etargs_inferred t env c args))))
(fn etargs_inferred ((t Tr) (env (List EV)) (c Name) (args (List ETerm))) (List EType)
  (match (c_type (tr_es t) (env_types env) (ECtor c args))
    ((Some (ETCon _ eargs)) eargs)
    (_ Nil)))
;; a constructor's runtime field types over its inductive's type parameters
(fn ctor_eptypes ((t Tr) (c Name) (ind Name)) (List EType)
  (match (es_find_decl (tr_es t) ind)
    ((Some (EInd _ _ cs)) (match (fields_of cs c) ((Some fts) fts) (None Nil)))
    (_ Nil)))
;; apply_const with the type-parameter metas pre-solved from E types where the arguments leave them open
(fn apply_const_e ((t Tr) (env (List EV)) (head Name) (info ConstantInfo) (eargs (List ETerm)) (etargs (List EType)) (eptypes (List EType))) TrRes
  (match (tr_tele t info)
    ((Pair t1 None) (TrErr (quote realize_signature) (append (show_name head) ": its type is not an E signature")))
    ((Pair t1 (Some (Tele ls binds _ _)))
     (match (apply_binds t1 env head binds eargs (expected_of etargs eptypes) (Ap Nil Nil Nil) 0)
       ((Pair t2 (Left e m)) (TrErr e m))
       ((Pair t2 (Right (Ap rargs sub metas)))
        (match (presolve_types t2 binds etargs sub)
          ((Pair t3 sub1)
           (match (fill_metas t3 head (rev rargs) sub1 Nil 0)
             ((Pair t4 None) (TrErr (quote untyped_subterm) (append (show_name head) ": a type parameter no argument determines — annotate the binder or match on a typed value")))
             ((Pair t4 (Some args)) (match (tr_apps t4 (mk_const head ls) args) ((Pair t5 e) (TrOk t5 e))))))))))))
;; the type-parameter binders of the telescope, in order, matched with the E type arguments: an open one takes its E type's L form
(fn presolve_types ((t Tr) (binds (List TBind)) (etargs (List EType)) (sub (List (Pair Int Expr)))) (Pair Tr (List (Pair Int Expr)))
  (measure (struct binds))
  (match binds
    (Nil (Pair t sub))
    ((Cons (TBind _ BType fv) rest)
     (match etargs
       (Nil (Pair t sub))
       ((Cons ety er)
        (match (assoc_int_expr (fvar_id_of fv) sub)
          ((Some _) (presolve_types t rest er sub))
          (None
           (match (tr_type t ety)
             ((Pair t1 None) (presolve_types t1 rest er sub))
             ((Pair t1 (Some l)) (presolve_types t1 rest er (Cons (Pair (fvar_id_of fv) l) sub)))))))))
    ((Cons _ rest) (presolve_types t rest etargs sub))))
;; a call: the realized constant itself, an L constant with a realization attached, a view's sig fn
(fn tr_call ((t Tr) (env (List EV)) (expected (Option EType)) (f Name) (args (List ETerm))) TrRes
  (match (env_find (tr_env t) f)
    (None (TrErr (quote no_l_meaning) (append (show_name f) ": a fn has no L meaning (RUNNABLE, §0) — realize it, or make it a def")))
    ((Some info)
     (match (es_find_decl (tr_es t) f)
       ((Some (EFn _ _ ps _ _ _)) (apply_const_e t env f info args (call_etargs t env expected f args) ps))
       ((Some (ESig _ _ ps _)) (apply_const_e t env f info args (call_etargs t env expected f args) ps))
       (_ (if (name_eq f (tr_id t))
            (apply_const_e t env f info args (call_etargs t env expected f args) Nil)
            (TrErr (quote realize_order) (append (show_name f) ": cited before its realization is attached (§7.5)"))))))))
(fn call_etargs ((t Tr) (env (List EV)) (expected (Option EType)) (f Name) (args (List ETerm))) (List EType)
  (match (es_find_decl (tr_es t) f)
    ((Some (EFn _ _ ps rt _ _)) (params_from (unify_all (tr_es t) (env_types env) ps args (expect_binding expected rt)) (max_int (tvar_count rt) (tvar_count_all ps)) 0))
    ((Some (ESig _ _ ps rt)) (params_from (unify_all (tr_es t) (env_types env) ps args (expect_binding expected rt)) (max_int (tvar_count rt) (tvar_count_all ps)) 0))
    (_ Nil)))
;; the result type against the expected type binds type parameters too
(fn expect_binding ((expected (Option EType)) (rt EType)) (List (Pair Int EType))
  (match expected ((Some ety) (unify_ty rt ety Nil)) (None Nil)))
;; let: sequential, each value's type inferred
(fn tr_let ((t Tr) (env (List EV)) (expected (Option EType)) (rs (List ETerm)) (b ETerm) (fvs (List Expr))) TrRes
  (measure (struct rs))
  (match rs
    (Nil
     (match (tr t env expected b)
       ((TrErr e m) (TrErr e m))
       ((TrOk t1 b1) (match (tr_lams t1 (rev fvs) b1) ((Pair t2 e) (TrOk t2 e))))))
    ((Cons v r)
     (match (tr t env None v)
       ((TrErr e m) (TrErr e m))
       ((TrOk t1 v1)
        (match (tr_infer t1 v1)
          ((Pair t2 None) (TrErr (quote untyped_subterm) "K could not type a let binding"))
          ((Pair t2 (Some ty))
           (match (tr_local_val t2 (n1 (quote x)) ty v1)
             ((Pair t3 fv) (tr_let t3 (Cons (EV fv (c_type (tr_es t3) (env_types env) v) 0) env) expected r b (Cons fv fvs)))))))))))
;; if: the condition's two-constructor inductive's recursor with a constant motive
(fn tr_if ((t Tr) (env (List EV)) (expected (Option EType)) (c ETerm) (a ETerm) (b ETerm)) TrRes
  (match (tr t env None c)
    ((TrErr e m) (TrErr e m))
    ((TrOk t1 c1)
     (match (scrutinee_type t1 c1)
       ((Pair t2 None) (TrErr (quote untyped_subterm) "the condition of an if is not a value of a two-constructor E inductive"))
       ((Pair t2 (Some (Pair ind (Pair ls largs))))
        (match (ind_ctor_names t2 ind)
          ((Cons c0 (Cons c1n Nil))
           (tr_rec t2 env expected ind ls largs c1 (list (Pair c0 (EArm PVar b)) (Pair c1n (EArm PVar a))) (quote if)))
          (_ (TrErr (quote untyped_subterm) (append (show_name ind) ": an if needs a two-constructor type")))))))))
;; a match not on a variable: the recursor over flat constructor patterns, a variable arm expanded
(fn tr_match_rec ((t Tr) (env (List EV)) (expected (Option EType)) (s ETerm) (arms (List EArm))) TrRes
  (match (tr t env None s)
    ((TrErr e m) (TrErr e m))
    ((TrOk t1 s1)
     (match (scrutinee_type t1 s1)
       ((Pair t2 None) (TrErr (quote untyped_subterm) "the scrutinee of a match is not a value of an E inductive"))
       ((Pair t2 (Some (Pair ind (Pair ls largs))))
        (match (arms_by_ctor arms (ind_ctor_names t2 ind) Nil)
          (None (TrErr (quote equation_form) "a nested or numeral pattern in a match the recursor states: lift it into the leading case tree or its own realization (§7.5)"))
          ((Some by_ctor) (tr_rec t2 env expected ind ls largs s1 by_ctor (quote match)))))))))
;; the scrutinee's inductive, levels and parameters from its inferred type
(fn scrutinee_type ((t Tr) (s Expr)) (Pair Tr (Option (Pair Name (Pair (List Level) (List Expr)))))
  (match (tr_infer t s)
    ((Pair t1 None) (Pair t1 None))
    ((Pair t1 (Some ty))
     (match (tr_whnf t1 ty)
       ((Pair t2 None) (Pair t2 None))
       ((Pair t2 (Some ty1))
        (match (get_app_fn ty1)
          ((Const _ ind ls)
           (match (es_info (tr_es t2) ind)
             ((Some (EIInd _ _)) (Pair t2 (Some (Pair ind (Pair ls (get_app_args ty1))))))
             (_ (Pair t2 None))))
          (_ (Pair t2 None))))))))
(fn ind_ctor_names ((t Tr) (ind Name)) (List Name)
  (match (es_info (tr_es t) ind) ((Some (EIInd _ cs)) cs) (_ Nil)))
;; for each constructor in order, the first arm that covers it: a flat constructor pattern
;; (its sub-patterns variables) or a variable arm; None for a nested or numeral pattern
(fn arms_by_ctor ((arms (List EArm)) (ctors (List Name)) (acc (List (Pair Name EArm)))) (Option (List (Pair Name EArm)))
  (measure (struct ctors))
  (match ctors
    (Nil (Some (rev acc)))
    ((Cons c r)
     (match (first_arm arms c)
       (None None)
       ((Some arm) (arms_by_ctor arms r (Cons (Pair c arm) acc)))))))
(fn first_arm ((arms (List EArm)) (c Name)) (Option EArm)
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm (PCtor d subs) b) r) (if (name_eq c d) (if (all_pvars subs) (Some (EArm (PCtor d subs) b)) None) (first_arm r c)))
    ((Cons (EArm PVar b) _) (Some (EArm PVar b)))
    ((Cons (EArm (PLit _) _) _) None)))
(fn all_pvars ((ps (List EPat))) Bool
  (measure (struct ps))
  (match ps (Nil True) ((Cons PVar r) (all_pvars r)) (_ False)))
;; T.rec params motive minors major — the motive constant, each minor a lambda over the
;; constructor's fields and induction hypotheses
(fn tr_rec ((t Tr) (env (List EV)) (expected (Option EType)) (ind Name) (ls (List Level)) (largs (List Expr)) (major Expr) (by_ctor (List (Pair Name EArm))) (what Symbol)) TrRes
  (match (env_find (tr_env t) (Str ind (quote rec)))
    (None (TrErr (quote equation_form) (append (show_name ind) " has no recursor")))
    ((Some rinfo)
     (match rinfo
       ((RecInfo _ _ _ _ nmotives _ _ _ _)
        (if (bool_not (int_eq nmotives 1)) (TrErr (quote equation_form) (append (show_name ind) ": a nested inductive's recursor has no Stage-0 translation"))
        (if (bool_not (int_eq (len (ci_lparams rinfo)) (+ 1 (len ls)))) (TrErr (quote equation_form) (append (show_name ind) " eliminates into Prop only"))
          (match (tr_minors t env expected ind ls largs by_ctor Nil None what)
            ((Pair t1 (Left2 e m)) (TrErr e m))
            ((Pair t1 (Right2 (Pair minors rty)))
             (match (tr_apps t1 (mk_const ind ls) largs)
               ((Pair t2 tyapp)
                (match (tr_local t2 (n1 (quote x)) tyapp)
                  ((Pair t3 mv)
                   (match (tr_lams t3 (list mv) rty)
                     ((Pair t4 motive)
                      (match (tr_apps t4 (mk_const (Str ind (quote rec)) (Cons (level_one) ls)) (append largs (Cons motive (append minors (list major)))))
                        ((Pair t5 e) (TrOk t5 e))))))))))))))
       (_ (TrErr (quote equation_form) (append (show_name ind) ": no recursor")))))))
;; the minors in constructor order; the result type from the expected E type, else inferred from
;; the first arm's body; the induction hypotheses opened at that type after the body (unused there)
(fn tr_minors ((t Tr) (env (List EV)) (expected (Option EType)) (ind Name) (ls (List Level)) (largs (List Expr)) (by_ctor (List (Pair Name EArm))) (acc (List Expr)) (rty (Option Expr)) (what Symbol)) (Pair Tr Either2)
  (measure (struct by_ctor))
  (match by_ctor
    (Nil (match rty ((Some r) (Pair t (Right2 (Pair (rev acc) r)))) (None (Pair t (Left2 (quote equation_form) "a match without arms")))))
    ((Cons (Pair c arm) r)
     (match (rz_open_ctor t c ls largs)
       ((Pair t1 None) (Pair t1 (Left2 (quote equation_form) (append (show_name c) ": K could not open the constructor"))))
       ((Pair t1 (Some (Pair fields cterm)))
        (match (arm_env t1 env arm fields cterm ind what)
          ((Pair t2 env1)
           (match (tr t2 env1 expected (arm_body arm))
             ((TrErr e m) (Pair t2 (Left2 e m)))
             ((TrOk t3 body)
              (match (minor_result t3 expected body fields rty)
                ((Pair t4 None) (Pair t4 (Left2 (quote untyped_subterm) "the arms' result type depends on the pattern's variables")))
                ((Pair t4 (Some rty1))
                 (match (open_ihs t4 fields rty1 Nil)
                   ((Pair t5 ihs)
                    (match (tr_lams t5 (append (field_fvars fields) ihs) body)
                      ((Pair t6 minor) (tr_minors t6 env expected ind ls largs r (Cons minor acc) (Some rty1) what))))))))))))))))
(type Either2 (Left2 Symbol (List Int)) (Right2 (Pair (List Expr) Expr)))
(fn arm_body ((a EArm)) ETerm (match a ((EArm _ b) b)))
;; a constructor opened at the scrutinee's type: its fields as locals — each with its runtime
;; E type, or None for an erased one — and the constructor term
(type Field (Field Expr (Option EType) Bool))   ; the local, its E type (None = erased), recursive?
(fn field_fvars ((fs (List Field))) (List Expr)
  (measure (struct fs))
  (match fs (Nil Nil) ((Cons (Field fv _ _) r) (Cons fv (field_fvars r)))))
(fn rz_open_ctor ((t Tr) (c Name) (ls (List Level)) (largs (List Expr))) (Pair Tr (Option (Pair (List Field) Expr)))
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (w_inst_lparams (tr_w t) (ci_type info) (ci_lparams info) ls)
          ((Pair w1 cty)
           (match (inst_params w1 cty largs)
             ((Pair w2 None) (Pair (tr_set_w t w2) None))
             ((Pair w2 (Some fty))
              (match (open_fields (tr_set_w t w2) ind fty Nil (budget_depth))
                ((Pair t1 None) (Pair t1 None))
                ((Pair t1 (Some fields))
                 (match (tr_apps t1 (mk_const c ls) (append largs (field_fvars fields)))
                   ((Pair t2 cterm) (Pair t2 (Some (Pair fields cterm))))))))))))
       (_ (Pair t None))))   ; not a constructor: the wildcard arm belongs to `info`'s match (it sat one level too deep until the parity test classified the driver's closure, slice 6)
    (None (Pair t None))))
(fn open_fields ((t Tr) (ind Name) (ty Expr) (acc (List Field)) (fuel Int)) (Pair Tr (Option (List Field)))
  (measure fuel)
  (if (lt fuel 0) (Pair t None)
  (match (tr_whnf t ty)
    ((Pair t1 (Some (Pi _ n _ dom body)))
     (match (w_is_prop (tr_w t1) dom)
       ((Pair w2 (Some True))
        (match (w_local w2 n dom)
          ((Pair w3 fv) (match (w_inst1 w3 body fv) ((Pair w4 body1) (open_fields (tr_set_w t1 w4) ind body1 (Cons (Field fv None False) acc) (- fuel 1)))))))
       ((Pair w2 _)
        (match (l_to_etype w2 (tr_es t1) (tr_sc t1) dom (tr_tps t1) Nil)
          ((Pair (Pair w3 es3) fety)
           (match (w_local w3 n dom)
             ((Pair w4 fv)
              (match (w_inst1 w4 body fv)
                ((Pair w5 body1) (open_fields (tr_set_es (tr_set_w t1 w5) es3) ind body1 (Cons (Field fv fety (is_head_const dom ind)) acc) (- fuel 1)))))))))))
    ((Pair t1 (Some _)) (Pair t1 (Some (rev acc))))
    ((Pair t1 None) (Pair t1 None)))))
(fn is_head_const ((e Expr) (n Name)) Bool (match (get_app_fn e) ((Const _ c _) (name_eq c n)) (_ False)))
;; one induction hypothesis per recursive field: a local of the motive's (constant) result type
(fn open_ihs ((t Tr) (fields (List Field)) (rty Expr) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct fields))
  (match fields
    (Nil (Pair t (rev acc)))
    ((Cons (Field _ _ True) r)
     (match (tr_local t (n1 (quote ih)) rty) ((Pair t1 fv) (open_ihs t1 r rty (Cons fv acc)))))
    ((Cons _ r) (open_ihs t r rty acc))))
;; the arm's variables: a constructor pattern binds the runtime fields in order, a variable arm
;; binds the constructor term; an if's branches bind nothing
(fn arm_env ((t Tr) (env (List EV)) (arm EArm) (fields (List Field)) (cterm Expr) (ind Name) (what Symbol)) (Pair Tr (List EV))
  (if (sym_eq what (quote if)) (Pair t env)
  (match arm
    ((EArm (PCtor _ _) _) (Pair t (rev_onto (runtime_evs fields) env)))
    ((EArm _ _) (Pair t (Cons (EV cterm (match (es_find_decl (tr_es t) ind) ((Some (EInd _ np _)) (Some (ETCon ind (params_from Nil np 0)))) (_ None)) 0) env))))))
(fn runtime_evs ((fields (List Field))) (List EV)
  (measure (struct fields))
  (match fields
    (Nil Nil)
    ((Cons (Field fv (Some ety) _) r) (Cons (EV fv (Some ety) 0) (runtime_evs r)))
    ((Cons _ r) (runtime_evs r))))
;; the minors' shared result type: the expected E type's L form, else the first body's inferred type,
;; which must not mention the fields
(fn minor_result ((t Tr) (expected (Option EType)) (body Expr) (fields (List Field)) (rty (Option Expr))) (Pair Tr (Option Expr))
  (match rty
    ((Some r) (Pair t (Some r)))
    (None
     (match expected
       ((Some ety)
        (match (tr_type t ety)
          ((Pair t1 (Some r)) (Pair t1 (Some r)))
          ((Pair t1 None) (infer_result t1 body fields))))
       (None (infer_result t body fields))))))
(fn infer_result ((t Tr) (body Expr) (fields (List Field))) (Pair Tr (Option Expr))
  (match (tr_infer t body)
    ((Pair t1 None) (Pair t1 None))
    ((Pair t1 (Some r)) (if (mentions_any r (fvar_ids (field_fvars fields))) (Pair t1 None) (Pair t1 (Some r))))))
(fn mentions_any ((e Expr) (ids (List Int))) Bool
  (measure (struct e))
  (if (bool_not (has_fvar e)) False
  (match e
    ((FVar _ id) (mem_int id ids))
    ((App _ f a) (bool_or (mentions_any f ids) (mentions_any a ids)))
    ((Lam _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Pi _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Let _ _ ty v b) (bool_or (mentions_any ty ids) (bool_or (mentions_any v ids) (mentions_any b ids))))
    ((Proj _ _ _ x) (mentions_any x ids))
    (_ False))))

;; ---- the case tree (§7.5): the body's leading matches on variables, compiled column by column ----
;; a pattern with its variables numbered in capture order
(type NPat (NPVar Int) (NPCtor Name (List NPat)) (NPLit) (NPWild))
(fn annotate ((p EPat) (k Int)) (Pair NPat Int)
  (measure (struct p))
  (match p
    (PVar (Pair (NPVar k) (+ k 1)))
    ((PLit _) (Pair NPLit k))
    ((PCtor c subs) (match (annotate_all subs k Nil) ((Pair nsubs k1) (Pair (NPCtor c nsubs) k1))))))
(fn annotate_all ((ps (List EPat)) (k Int) (acc (List NPat))) (Pair (List NPat) Int)
  (measure (struct ps))
  (match ps
    (Nil (Pair (rev acc) k))
    ((Cons p r) (match (annotate p k) ((Pair np k1) (annotate_all r k1 (Cons np acc)))))))
;; a column: its variable's local, E type and descent flag
(type Col (Col Expr EType Int))
;; a row: its patterns over the columns, its body, its slots bound so far, its slot count
(type Row (Row (List NPat) ETerm (List (Pair Int EV)) Int))
;; the leaf state: the left-hand side's arguments and result type (the specialized terms
;; substituted), the theorem's binders (reversed), the body's environment, the body
(type Leaf (Leaf (List Expr) Expr (List Expr) (List EV) ETerm))
(type LeavesRes (LvOk Tr (List Leaf)) (LvErr Symbol (List Int)))
;; the leaves of a body under the outer environment, with the columns the leading match may split
(fn leaves ((t Tr) (env (List EV)) (body ETerm) (lhs (List Expr)) (rl Expr) (kept (List Expr))) LeavesRes
  (match body
    ((EMatch (EBVar j) arms)
     (match (nth env j)
       ((Some (EV (FVar d id) (Some (ETCon ind eargs)) flag))
        (match (es_info (tr_es t) ind)
          ((Some (EIInd _ _))
           (match (rows_of arms Nil)
             (None (LvErr (quote equation_form) "a numeral pattern has no Stage-0 equation (§7.5)"))
             ((Some rows) (compile t env (list (Col (FVar d id) (ETCon ind eargs) flag)) rows lhs rl kept Nil))))
          (_ (LvOk t (list (Leaf lhs rl kept env body))))))
       (_ (LvOk t (list (Leaf lhs rl kept env body))))))
    (_ (LvOk t (list (Leaf lhs rl kept env body))))))
(fn rows_of ((arms (List EArm)) (acc (List Row))) (Option (List Row))
  (measure (struct arms))
  (match arms
    (Nil (Some (rev acc)))
    ((Cons (EArm p b) r)
     (match (annotate p 0)
       ((Pair np k) (if (has_lit np) None (rows_of r (Cons (Row (list np) b Nil k) acc))))))))
(fn has_lit ((p NPat)) Bool
  (measure (struct p))
  (match p (NPLit True) ((NPCtor _ subs) (any_lit subs)) (_ False)))
(fn any_lit ((ps (List NPat))) Bool
  (measure (struct ps))
  (match ps (Nil False) ((Cons p r) (bool_or (has_lit p) (any_lit r)))))
;; the first row all variables: a leaf (later rows are unreachable for these shapes); else split
;; the first column some row constrains
(fn compile ((t Tr) (env (List EV)) (cols (List Col)) (rows (List Row)) (lhs (List Expr)) (rl Expr) (kept (List Expr)) (acc (List Leaf))) LeavesRes
  (measure (struct rows))
  (match rows
    (Nil (LvErr (quote equation_form) "a constructor no arm covers (the matrix is not exhaustive)"))
    ((Cons (Row pats rhs slots n) _)
     (match (ctor_column pats cols 0)
       (None
        (let ((slots1 (rz_bind_all pats cols slots)))
          (let ((env1 (rev_onto (slot_evs slots1 n 0) env)))
            (match (leaves t env1 rhs lhs rl kept)
              ((LvErr e m) (LvErr e m))
              ((LvOk t1 ls) (LvOk t1 (append acc ls)))))))
       ((Some i)
        (match (nth cols i)
          (None (LvErr (quote equation_form) "column"))
          ((Some (Col v ety flag))
           (match ety
             ((ETCon ind eargs)
              (match (es_info (tr_es t) ind)
                ((Some (EIInd _ ctors))
                 (match (scrutinee_type t v)
                   ((Pair t1 None) (LvErr (quote untyped_subterm) "K could not type a matched variable"))
                   ((Pair t1 (Some (Pair _ (Pair ls largs))))
                    (split t1 env cols rows lhs rl kept acc i (Col v ety flag) ctors ls largs))))
                (_ (LvErr (quote untyped_subterm) (append (show_name ind) " is not an E inductive")))))
             (_ (LvErr (quote untyped_subterm) "a matched variable whose type is a type parameter (specialization is phase 3)"))))))))))
;; the first column index at which some row has a constructor pattern
(fn ctor_column ((pats (List NPat)) (cols (List Col)) (i Int)) (Option Int)
  (measure (struct pats))
  (match pats
    (Nil None)
    ((Cons (NPCtor _ _) _) (Some i))
    ((Cons _ r) (ctor_column r (drop 1 cols) (+ i 1)))))
;; every column bound to the row's variable at it
(fn rz_bind_all ((pats (List NPat)) (cols (List Col)) (slots (List (Pair Int EV)))) (List (Pair Int EV))
  (measure (struct pats))
  (match pats
    (Nil slots)
    ((Cons (NPVar s) r) (match cols ((Cons (Col v ety flag) cr) (rz_bind_all r cr (Cons (Pair s (EV v (Some ety) flag)) slots))) (Nil slots)))
    ((Cons _ r) (rz_bind_all r (drop 1 cols) slots))))
;; the slots as the body's variables: slot 0 outermost, slot n-1 innermost — capture order
(fn slot_evs ((slots (List (Pair Int EV))) (n Int) (i Int)) (List EV)
  (measure (- n i))
  (if (le n i) Nil
    (Cons (match (assoc_slot i slots) ((Some v) v) (None (EV (mk_const Anon Nil) None 0))) (slot_evs slots n (+ i 1)))))
(fn assoc_slot ((i Int) (slots (List (Pair Int EV)))) (Option EV)
  (measure (struct slots))
  (match slots (Nil None) ((Cons (Pair j v) r) (if (int_eq i j) (Some v) (assoc_slot i r)))))
;; column i split over the constructors of its inductive
(fn split ((t Tr) (env (List EV)) (cols (List Col)) (rows (List Row)) (lhs (List Expr)) (rl Expr) (kept (List Expr)) (acc (List Leaf)) (i Int) (col Col) (ctors (List Name)) (ls (List Level)) (largs (List Expr))) LeavesRes
  (measure (struct ctors))
  (match ctors
    (Nil (LvOk t acc))
    ((Cons c r)
     (match col
       ((Col v ety flag)
        (match (rz_open_ctor t c ls largs)
          ((Pair t1 None) (LvErr (quote equation_form) (append (show_name c) ": K could not open the constructor")))
          ((Pair t1 (Some (Pair fields cterm)))
           (let ((vid (fvar_id_of v)) (fflag (if (lt 0 flag) 1 0)))
             (match (subst_all t1 lhs vid cterm Nil)
               ((Pair t2 lhs1)
                (match (tr_subst t2 rl vid cterm)
                  ((Pair t3 rl1)
                   (match (subst_rows t3 rows vid cterm Nil)
                     ((Pair t4 rows1)
                      (match (subst_env t4 env vid cterm Nil)
                        ((Pair t5 env1)
                         (match (refresh_kept t5 (without_id kept vid) vid cterm Nil Nil)
                           ((Pair t6 (Pair kept0 pairs))
                            (match (apply_pairs t6 pairs lhs1 rl1 rows1 env1)
                              ((Pair t7 (Pair (Pair lhs2 rl2) (Pair rows3 env2)))
                               (let ((kept1 (append kept0 (field_fvars fields)))
                                     (cols1 (append (take i cols) (append (field_cols fields fflag) (drop (+ i 1) cols))))
                                     (rows2 (specialize_rows rows3 i c (len (runtime_fields fields)) (EV cterm (Some ety) flag) Nil)))
                                 (match (compile t7 env2 cols1 rows2 lhs2 rl2 kept1 acc)
                                   ((LvErr e m) (LvErr e m))
                                   ((LvOk t8 acc1) (split t8 env cols rows lhs rl kept acc1 i col r ls largs))))))))))))))))))))))))
(fn subst_all ((t Tr) (es (List Expr)) (id Int) (v Expr) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct es))
  (match es
    (Nil (Pair t (rev acc)))
    ((Cons e r) (match (tr_subst t e id v) ((Pair t1 e1) (subst_all t1 r id v (Cons e1 acc)))))))
(fn subst_rows ((t Tr) (rows (List Row)) (id Int) (v Expr) (acc (List Row))) (Pair Tr (List Row))
  (measure (struct rows))
  (match rows
    (Nil (Pair t (rev acc)))
    ((Cons (Row pats rhs slots n) r)
     (match (subst_slots t slots id v Nil)
       ((Pair t1 slots1) (subst_rows t1 r id v (Cons (Row pats rhs slots1 n) acc)))))))
(fn subst_slots ((t Tr) (slots (List (Pair Int EV))) (id Int) (v Expr) (acc (List (Pair Int EV)))) (Pair Tr (List (Pair Int EV)))
  (measure (struct slots))
  (match slots
    (Nil (Pair t (rev acc)))
    ((Cons (Pair s (EV e ety flag)) r)
     (match (tr_subst t e id v) ((Pair t1 e1) (subst_slots t1 r id v (Cons (Pair s (EV e1 ety flag)) acc)))))))
(fn subst_env ((t Tr) (env (List EV)) (id Int) (v Expr) (acc (List EV))) (Pair Tr (List EV))
  (measure (struct env))
  (match env
    (Nil (Pair t (rev acc)))
    ((Cons (EV e ety flag) r) (match (tr_subst t e id v) ((Pair t1 e1) (subst_env t1 r id v (Cons (EV e1 ety flag) acc)))))))
;; a kept binder whose type mentions the split variable (an erased binder over a data parameter)
;; is re-opened at the substituted type; the pairs (old id, new local) apply to everything after
(fn refresh_kept ((t Tr) (kept (List Expr)) (vid Int) (cterm Expr) (acc (List Expr)) (pairs (List (Pair Int Expr)))) (Pair Tr (Pair (List Expr) (List (Pair Int Expr))))
  (measure (struct kept))
  (match kept
    (Nil (Pair t (Pair (rev acc) (rev pairs))))
    ((Cons fv r)
     (match (tr_type_of_local t fv)
       (None (refresh_kept t r vid cterm (Cons fv acc) pairs))
       ((Some ty)
        (match (tr_subst t ty vid cterm)
          ((Pair t1 ty1)
           (match (subst_pairs t1 ty1 (rev pairs))
             ((Pair t2 ty2)
              (if (expr_eq ty ty2) (refresh_kept t2 r vid cterm (Cons fv acc) pairs)
                (match (tr_local t2 (n1 (quote h)) ty2)
                  ((Pair t3 fv1) (refresh_kept t3 r vid cterm (Cons fv1 acc) (Cons (Pair (fvar_id_of fv) fv1) pairs))))))))))))))
(fn subst_pairs ((t Tr) (e Expr) (pairs (List (Pair Int Expr)))) (Pair Tr Expr)
  (measure (struct pairs))
  (match pairs
    (Nil (Pair t e))
    ((Cons (Pair id v) r) (match (tr_subst t e id v) ((Pair t1 e1) (subst_pairs t1 e1 r))))))
(fn apply_pairs ((t Tr) (pairs (List (Pair Int Expr))) (lhs (List Expr)) (rl Expr) (rows (List Row)) (env (List EV))) (Pair Tr (Pair (Pair (List Expr) Expr) (Pair (List Row) (List EV))))
  (measure (struct pairs))
  (match pairs
    (Nil (Pair t (Pair (Pair lhs rl) (Pair rows env))))
    ((Cons (Pair id v) r)
     (match (subst_all t lhs id v Nil)
       ((Pair t1 lhs1)
        (match (tr_subst t1 rl id v)
          ((Pair t2 rl1)
           (match (subst_rows t2 rows id v Nil)
             ((Pair t3 rows1)
              (match (subst_env t3 env id v Nil)
                ((Pair t4 env1) (apply_pairs t4 r lhs1 rl1 rows1 env1))))))))))))
(fn without_id ((fvs (List Expr)) (id Int)) (List Expr)
  (measure (struct fvs))
  (match fvs
    (Nil Nil)
    ((Cons fv r) (if (int_eq (fvar_id_of fv) id) (without_id r id) (Cons fv (without_id r id))))))
(fn runtime_fields ((fields (List Field))) (List Field)
  (measure (struct fields))
  (match fields
    (Nil Nil)
    ((Cons (Field fv (Some ety) rc) r) (Cons (Field fv (Some ety) rc) (runtime_fields r)))
    ((Cons _ r) (runtime_fields r))))
(fn field_cols ((fields (List Field)) (flag Int)) (List Col)
  (measure (struct fields))
  (match fields
    (Nil Nil)
    ((Cons (Field fv (Some ety) _) r) (Cons (Col fv ety flag) (field_cols r flag)))
    ((Cons _ r) (field_cols r flag))))
;; the rows specialized to constructor c at column i: its sub-patterns, or wildcards for a
;; variable row (its slot bound to the constructor term); a row with another constructor drops
(fn specialize_rows ((rows (List Row)) (i Int) (c Name) (k Int) (bound EV) (acc (List Row))) (List Row)
  (measure (struct rows))
  (match rows
    (Nil (rev acc))
    ((Cons (Row pats rhs slots n) r)
     (match (nth pats i)
       ((Some (NPCtor d subs))
        (if (name_eq c d)
          (specialize_rows r i c k bound (Cons (Row (append (take i pats) (append subs (drop (+ i 1) pats))) rhs slots n) acc))
          (specialize_rows r i c k bound acc)))
       ((Some (NPVar s))
        (specialize_rows r i c k bound (Cons (Row (append (take i pats) (append (wilds k) (drop (+ i 1) pats))) rhs (Cons (Pair s bound) slots) n) acc)))
       ((Some NPWild)
        (specialize_rows r i c k bound (Cons (Row (append (take i pats) (append (wilds k) (drop (+ i 1) pats))) rhs slots n) acc)))
       (_ (specialize_rows r i c k bound acc))))))
(fn wilds ((k Int)) (List NPat) (measure k) (if (lt k 1) Nil (Cons NPWild (wilds (- k 1)))))

;; ---- descent and order (§7.5) --------------------------------------------------------------
;; flags per variable (innermost first): 2 the structural parameter, 1 a proper subterm of it, 0 other
(fn check_calls ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (e ETerm)) (Option (Pair Symbol (List Int)))
  (measure (struct e))
  (match e
    ((EBVar _) None)
    ((ELit _) None)
    ((ECtor _ as) (check_all es env id rec flags as))
    ((EPrim _ as) (check_all es env id rec flags as))
    ((EExt f _) (Some (Pair (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
    ((ECall f as)
     (match (check_all es env id rec flags as)
       ((Some x) (Some x))
       (None
        (if (name_eq f id)
          (match rec
            (RecNone (Some (Pair (quote realize_recursion) (append (show_name id) " calls itself without a measure"))))
            ((RecStruct i)
             (match (nth as i)
               ((Some (EBVar j)) (if (int_eq (flag_at flags j) 1) None (Some (Pair (quote realize_descent) (append (show_name id) ": a recursive call does not pass a proper subterm of the structural parameter")))))
               (_ (Some (Pair (quote realize_descent) (append (show_name id) ": a recursive call does not pass a proper subterm of the structural parameter"))))))
            ((RecMeasure _)
             (if (args_are_params as (len flags) 0)
               (Some (Pair (quote realize_descent) (append (show_name id) " calls itself on its own parameters — no measure decreases (§7.5)")))
               None)))
          (match (es_find_decl es f)
            ((Some (EFn _ _ _ _ _ _)) (match (env_find env f) ((Some _) None) (None (Some (Pair (quote no_l_meaning) (append (show_name f) ": a fn has no L meaning (RUNNABLE, §0)"))))))
            ((Some (ESig _ _ _ _)) None)
            ((Some (EExtern _ _ _ _)) (Some (Pair (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
            (_ (Some (Pair (quote realize_order) (append (show_name f) ": cited before its realization is attached (§7.5)")))))))))
    ((EMatch s arms)
     (match (check_calls es env id rec flags s)
       ((Some x) (Some x))
       (None (check_arms es env id rec flags (match s ((EBVar j) (flag_at flags j)) (_ 0)) arms))))
    ((ELet rs b) (check_let es env id rec flags rs b))
    ((EIf a b c)
     (match (check_calls es env id rec flags a)
       ((Some x) (Some x))
       (None (match (check_calls es env id rec flags b) ((Some x) (Some x)) (None (check_calls es env id rec flags c))))))))
(fn check_all ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (ts (List ETerm))) (Option (Pair Symbol (List Int)))
  (measure (struct ts))
  (match ts (Nil None) ((Cons x r) (match (check_calls es env id rec flags x) ((Some y) (Some y)) (None (check_all es env id rec flags r))))))
(fn check_arms ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (sflag Int) (arms (List EArm))) (Option (Pair Symbol (List Int)))
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm p b) r)
     (match (check_calls es env id rec (rev_onto (pat_flags p sflag) flags) b)
       ((Some x) (Some x))
       (None (check_arms es env id rec flags sflag r))))))
;; a pattern's variables' flags in capture order: a variable at the top keeps the scrutinee's,
;; one under a constructor is a proper subterm when the scrutinee is the parameter or under it
(fn pat_flags ((p EPat) (sflag Int)) (List Int)
  (match p
    (PVar (list sflag))
    ((PLit _) Nil)
    ((PCtor _ subs) (sub_flags subs (if (lt 0 sflag) 1 0)))))
(fn sub_flags ((ps (List EPat)) (f Int)) (List Int)
  (measure (struct ps))
  (match ps
    (Nil Nil)
    ((Cons PVar r) (Cons f (sub_flags r f)))
    ((Cons (PLit _) r) (sub_flags r f))
    ((Cons (PCtor _ subs) r) (append (sub_flags subs f) (sub_flags r f)))))
(fn check_let ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (rs (List ETerm)) (b ETerm)) (Option (Pair Symbol (List Int)))
  (measure (struct rs))
  (match rs
    (Nil (check_calls es env id rec flags b))
    ((Cons x r)
     (match (check_calls es env id rec flags x)
       ((Some y) (Some y))
       (None (check_let es env id rec (Cons 0 flags) r b))))))
(fn flag_at ((flags (List Int)) (j Int)) Int (match (nth flags j) ((Some f) f) (None 0)))
;; the arguments are the parameters in order: argument i is the variable at depth n-1-i
(fn args_are_params ((as (List ETerm)) (n Int) (i Int)) Bool
  (measure (struct as))
  (match as
    (Nil True)
    ((Cons (EBVar j) r) (if (int_eq j (- (- n 1) i)) (args_are_params r n (+ i 1)) False))
    (_ False)))
;; the parameters' flags, innermost first: the structural parameter (0-based in binder order) is 2
(fn param_flags ((n Int) (rec ERec)) (List Int)
  (match rec
    ((RecStruct i) (rev (flags_upto n i 0)))
    (_ (zeros_int n))))
(fn flags_upto ((n Int) (i Int) (k Int)) (List Int)
  (measure (- n k))
  (if (le n k) Nil (Cons (if (int_eq k i) 2 0) (flags_upto n i (+ k 1)))))
(fn zeros_int ((n Int)) (List Int) (measure n) (if (lt n 1) Nil (Cons 0 (zeros_int (- n 1)))))

;; ---- the supplied form (§7.2, §7.5) ---------------------------------------------------------
;; the result: the E table (Init inductives the walk registered), the EFn to attach once the
;; equations are admitted, the equations as theorem declarations in order, a pending measure
(type RzRes (RzOk ESt EDecl (List Declaration) Bool) (RzErr Symbol (List Int)))
;; NAME's identity resolved through the scope: a definition of the environment
(type RtRes (RtOk Name ConstantInfo) (RtErr Symbol (List Int)))
(fn realize_target ((sc Scope) (env CheckedEnv) (n Name)) RtRes
  (match (resolve (cx0 sc env Nil Nil) n)
    (RNone (RtErr (quote unknown_constant) (show_name n)))
    ((RAmbiguous a b) (RtErr (quote ambiguous_name) (ambiguous_msg n a b)))
    ((RPend k) (RtErr (quote pending_obligation) (show_name k)))
    ((RName k _)
     (match (env_find env k)
       ((Some info)
        (match info
          ((DefnInfo _ _ _ _ _)
           (match (prim_l_identity k)
             ((Some _) (RtErr (quote realize_primitive) (append (show_name k) " is an entry of the primitive table (§6.4): K's own rule realizes it, and a body cites it as a primitive")))
             (None (RtOk k info))))
          (_ (RtErr (quote realize_kind) (append (show_name k) " is not a definition (an axiom, a theorem, a constructor or a type has no realization at Stage 0)")))))
       (None (RtErr (quote unknown_constant) (show_name n)))))))
;; the E signature read from BINDERS RET, compared with the erasure of the L type
(fn signature_matches ((es ESt) (sc Scope) (env CheckedEnv) (binds (List TBind)) (rt EType) (bs (List SExpr)) (ret SExpr)) (Option (List Int))
  (match (read_params es sc env False Nil bs Nil Nil)
    ((PmErr e m) (Some (append (chars_of_sym e) (append ": " m))))
    ((PmOk _ ptypes tps)
     (match (read_ety es sc env False tps ret)
       ((TyErr e m) (Some (append (chars_of_sym e) (append ": " m))))
       ((TyOk ert _)
        (if (bool_not (int_eq (len tps) (count_types binds))) (Some (append "the L type has " (append (show_nat (count_types binds)) (append " type parameters, the E signature " (show_nat (len tps))))))
        (match (data_mismatch binds ptypes 0)
          ((Some m) (Some m))
          (None (if (etype_eq ert rt) None (Some "the result type differs from the L type's erasure"))))))))))
(fn count_types ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds (Nil 0) ((Cons (TBind _ BType _) r) (+ 1 (count_types r))) ((Cons _ r) (count_types r))))
(fn data_mismatch ((binds (List TBind)) (ptypes (List EType)) (i Int)) (Option (List Int))
  (measure (struct binds))
  (match binds
    (Nil (match ptypes (Nil None) (_ (Some "the E signature has more binders than the L type's erasure"))))
    ((Cons (TBind n (BData ety) _) r)
     (match ptypes
       (Nil (Some (append "the E signature lacks the binder " (show_name n))))
       ((Cons p pr) (if (etype_eq p ety) (data_mismatch r pr (+ i 1)) (Some (append "the binder " (append (show_name n) " has another type than the L type's erasure")))))))
    ((Cons _ r) (data_mismatch r ptypes i))))
(fn etype_eq ((a EType) (b EType)) Bool
  (measure (struct a))
  (match a
    ((ETVar i) (match b ((ETVar j) (int_eq i j)) (_ False)))
    ((ETCon n as) (match b ((ETCon m bs) (bool_and (name_eq n m) (etypes_eq as bs))) (_ False)))))
(fn etypes_eq ((as (List EType)) (bs (List EType))) Bool
  (measure (struct as))
  (match as
    (Nil (match bs (Nil True) (_ False)))
    ((Cons a ar) (match bs ((Cons b br) (bool_and (etype_eq a b) (etypes_eq ar br))) (Nil False)))))
;; the forms after RET without a trailing (equations THM…), and the clause's theorems
(type Either4 (Left4 Symbol (List Int)) (Right4 (List Name)))
(fn split_equations ((sc Scope) (env CheckedEnv) (rest (List SExpr))) (Pair (List SExpr) Either4)
  (match (rev rest)
    ((Cons (SList (Cons (SSym e) thms)) r)
     (if (sym_eq e (quote equations))
       (Pair (rev r) (thm_names sc env thms Nil))
       (Pair rest (Right4 Nil))))
    (_ (Pair rest (Right4 Nil)))))
(fn thm_names ((sc Scope) (env CheckedEnv) (ss (List SExpr)) (acc (List Name))) Either4
  (measure (struct ss))
  (match ss
    (Nil (Right4 (rev acc)))
    ((Cons (SSym x) r)
     (match (name_of_sym x)
       (None (Left4 (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (resolve (cx0 sc env Nil Nil) n)
          ((RName k _) (thm_names sc env r (Cons k acc)))
          ((RAmbiguous a b) (Left4 (quote ambiguous_name) (ambiguous_msg n a b)))
          ((RPend k) (Left4 (quote pending_obligation) (show_name k)))
          (RNone (Left4 (quote unknown_constant) (append (show_name n) " (the equations clause)")))))))
    (_ (Left4 (quote bad_shape) "(equations THM…) names theorems"))))
;; the theorem's identity for equation k: NAME.realize_k in the realizing module — a native
;; NAME already carries its module, an imported one is prefixed
(fn eq_name ((sc Scope) (k Name) (i Int)) Name
  (match (sc_vis sc)
    ((VisOnly _ _ tbl _)
     (match (tbl_find tbl k)
       ((Some m) (if (name_eq m (sc_module sc)) (name_append k (nm_realize_n i)) (qualify sc (name_append k (nm_realize_n i)))))
       (None (qualify sc (name_append k (nm_realize_n i))))))
    (VisAll (name_append k (nm_realize_n i)))))
(fn realize_supplied ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (Cons _ (Cons (SSym x) (Cons (SList bs) (Cons ret rest0)))))
     (match (name_of_sym x)
       (None (RzErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info)
           (match (split_equations sc env rest0)
             ((Pair _ (Left4 e m)) (RzErr e m))
             ((Pair rest (Right4 thms))
              (match (tele_of (w0 env) es sc info)
                ((TeleErr e m) (RzErr e m))
                ((TeleOk w1 es1 (Tele ls binds rt rl))
                 (match (signature_matches es1 sc env binds rt bs ret)
                   ((Some m) (RzErr (quote realize_signature) (append (show_name k) (append ": " m))))
                   (None
                    (match (read_fn_rest (ensure_head es1 sc k (count_data binds)) sc env False k Nil bs ret rest)
                      ((CErr e m) (RzErr e m))
                      ((COk d)
                       (match d
                         ((EFn _ ntp ptypes ert rec body)
                          (match (check_calls es1 env k rec (param_flags (len ptypes) rec) body)
                            ((Some (Pair e m)) (RzErr e m))
                            (None
                             (match (equations (Tr w1 es1 sc k (tbind_types binds)) binds ls rl rt body rec thms)
                               ((Pair _ (Left3 e m)) (RzErr e m))
                               ((Pair t1 (Right3 decls)) (RzOk (tr_es t1) d decls (match rec ((RecMeasure _) True) (_ False))))))))
                         (_ (RzErr (quote bad_shape) "realize"))))))))))))))))
    (_ (RzErr (quote bad_shape) "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?) or (realize NAME (view))"))))
;; the realized constant as a function head of the E table, when pre-registration could not resolve it
(fn ensure_head ((es ESt) (sc Scope) (k Name) (arity Int)) ESt
  (match (es_info es k) ((Some _) es) (None (es_register es k (sc_module sc) (EIFn arity)))))
(fn tbind_types ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ BType fv) r) (Cons fv (tbind_types r))) ((Cons _ r) (tbind_types r))))
(type Either3 (Left3 Symbol (List Int)) (Right3 (List Declaration)))
;; the equations: the leaves of the case tree over the data binders, each a theorem
(fn equations ((t Tr) (binds (List TBind)) (ls (List Level)) (rl Expr) (rt EType) (body ETerm) (rec ERec) (thms (List Name))) (Pair Tr Either3)
  (let ((env (rev (data_evs binds (param_flags (count_data binds) rec) 0)))
        (lhs (tbind_fvars binds))
        (kept (tbind_fvars binds)))
    (match (leaves t env body lhs rl kept)
      ((LvErr e m) (Pair t (Left3 e m)))
      ((LvOk t1 lvs)
       (if (bool_and (lt 0 (len thms)) (bool_not (int_eq (len thms) (len lvs))))
         (Pair t1 (Left3 (quote equations_count) (append "the body has " (append (show_nat (len lvs)) (append " equations, the clause names " (show_nat (len thms)))))))
         (equation_decls t1 ls rt lvs thms 1 Nil))))))
(fn count_data ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds (Nil 0) ((Cons (TBind _ (BData _) _) r) (+ 1 (count_data r))) ((Cons _ r) (count_data r))))
(fn tbind_fvars ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ _ fv) r) (Cons fv (tbind_fvars r)))))
;; the data binders as the body's variables in binder order (the caller reverses), with their flags
;; (param_flags gives them innermost first, so they are consumed reversed)
(fn data_evs ((binds (List TBind)) (flags (List Int)) (i Int)) (List EV)
  (measure (struct binds))
  (match binds
    (Nil Nil)
    ((Cons (TBind _ (BData ety) fv) r) (Cons (EV fv (Some ety) (flag_at (rev flags) i)) (data_evs r flags (+ i 1))))
    ((Cons _ r) (data_evs r flags i))))
(fn equation_decls ((t Tr) (ls (List Level)) (rt EType) (lvs (List Leaf)) (thms (List Name)) (i Int) (acc (List Declaration))) (Pair Tr Either3)
  (measure (struct lvs))
  (match lvs
    (Nil (Pair t (Right3 (rev acc))))
    ((Cons (Leaf lhs rl kept env body) r)
     (match (tr t env (Some rt) body)
       ((TrErr e m) (Pair t (Left3 e m)))
       ((TrOk t1 rhs)
        (match (tr_apps t1 (mk_const (tr_id t1) ls) lhs)
          ((Pair t2 lhs1)
           (match (tr_apps t2 (mk_const (nm_eq) (list (level_one))) (list rl lhs1 rhs))
             ((Pair t3 stmt)
              (match (tr_pis t3 kept stmt)
                ((Pair t4 ty)
                 (let ((name (eq_name (tr_sc t4) (tr_id t4) i)))
                   (match (proof_of t4 kept rl lhs1 (nth thms (- i 1)) ls)
                     ((Pair t5 None) (Pair t5 (Left3 (quote universe_arity) "a theorem of the equations clause takes neither no universe arguments nor the constant's")))
                     ((Pair t5 (Some proof))
                      (match (tr_lams t5 kept proof)
                        ((Pair t6 value)
                         (equation_decls t6 ls rt r thms (+ i 1) (Cons (ThmDecl (ConstantVal name Nil ty) value (list name)) acc))))))))))))))))))
;; Eq.refl, or the clause's theorem applied to the binders — at the constant's solved levels
;; when it has as many universe parameters, at none when it has none
(fn proof_of ((t Tr) (kept (List Expr)) (rl Expr) (lhs Expr) (thm (Option Name)) (ls (List Level))) (Pair Tr (Option Expr))
  (match thm
    (None (match (tr_apps t (mk_const (nm_eq_refl) (list (level_one))) (list rl lhs)) ((Pair t1 e) (Pair t1 (Some e)))))
    ((Some th)
     (let ((arity (match (env_find (tr_env t) th) ((Some info) (len (ci_lparams info))) (None 0))))
       (if (int_eq arity 0) (match (tr_apps t (mk_const th Nil) kept) ((Pair t1 e) (Pair t1 (Some e))))
       (if (int_eq arity (len ls)) (match (tr_apps t (mk_const th ls) kept) ((Pair t1 e) (Pair t1 (Some e))))
         (Pair t None)))))))

;; ---- the derived view (§7.1, §7.5) --------------------------------------------------------------
;; the body's variables in the erasure: a local is a runtime variable (its E index counted among
;; those), a static or erased one, or an induction hypothesis
(type EKind (EKVar) (EKStatic) (EKErased) (EKIH))
(type ErEnt (ErEnt Int EKind))
(fn er_index ((env (List ErEnt)) (id Int) (k Int)) (Option (Pair EKind Int))
  (measure (struct env))
  (match env
    (Nil None)
    ((Cons (ErEnt j kind) r)
     (if (int_eq id j) (Some (Pair kind k))
       (er_index r id (match kind (EKVar (+ k 1)) (_ k)))))))
(type ErRes (ErOk Tr ETerm) (ErErr Symbol (List Int)))
(fn realize_view ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (Cons _ (Cons (SSym x) _)))
     (match (name_of_sym x)
       (None (RzErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info)
           (match (tele_of (w0 env) es sc info)
             ((TeleErr e m) (RzErr e m))
             ((TeleOk w1 es1 (Tele ls binds rt _))
              (match (ci_value info)
                (None (RzErr (quote realize_kind) (append (show_name k) " has no value")))
                ((Some v0)
                 (match (w_inst_lparams w1 v0 (ci_lparams info) ls)
                   ((Pair w2 v)
                    (let ((t (Tr w2 es1 sc k (tbind_types binds))))
                      (match (peel_binders t v binds)
                        ((Pair t1 body)
                         (match (erase t1 (binder_ents binds) body (budget_depth))
                           ((ErErr e m) (RzErr e m))
                           ((ErOk t2 ebody)
                            (let ((ptypes (bind_ptypes binds)))
                              (match (classify_both (tr_es t2) k (some_all (rev ptypes)) ebody RecNone)
                                ((Some (Pair e m)) (RzErr e m))
                                (None (RzOk (tr_es t2) (EFn k (count_types binds) ptypes rt RecNone ebody) Nil False))))))))))))))))))))
    (_ (RzErr (quote bad_shape) "(realize NAME (view))"))))
(fn bind_ptypes ((binds (List TBind))) (List EType)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ (BData ety) _) r) (Cons ety (bind_ptypes r))) ((Cons _ r) (bind_ptypes r))))
;; the binders' entries, innermost first
(fn binder_ents ((binds (List TBind))) (List ErEnt) (rev (binder_ents_fwd binds)))
(fn binder_ents_fwd ((binds (List TBind))) (List ErEnt)
  (measure (struct binds))
  (match binds
    (Nil Nil)
    ((Cons (TBind _ role fv) r) (Cons (ErEnt (fvar_id_of fv) (match role (BType EKStatic) (BErased EKErased) ((BData _) EKVar))) (binder_ents_fwd r)))))
;; the value's leading lambdas instantiated with the binders' locals; fewer lambdas than binders: applied to the rest
(fn peel_binders ((t Tr) (v Expr) (binds (List TBind))) (Pair Tr Expr)
  (measure (struct binds))
  (match binds
    (Nil (Pair t v))
    ((Cons (TBind _ _ fv) r)
     (match v
       ((Lam _ _ _ _ body) (match (tr_inst1 t body fv) ((Pair t1 body1) (peel_binders t1 body1 r))))
       (_ (match (tr_apps t v (list fv)) ((Pair t1 v1) (peel_binders t1 v1 r))))))))
;; the erasure of an L term in a runtime position (§7.5)
(fn erase ((t Tr) (env (List ErEnt)) (e Expr) (fuel Int)) ErRes
  (measure fuel)
  (if (lt fuel 0) (ErErr (quote erased_in_runtime) "the body is too deep")
  (match e
    ((FVar _ id)
     (match (er_index env id 0)
       ((Some (Pair EKVar i)) (ErOk t (EBVar i)))
       ((Some (Pair EKIH _)) (ErErr (quote recursion_structure) "a recursive definition's executable structure is not readable off the recursor: supply the body (§7.1, §7.3)"))
       ((Some (Pair _ _)) (ErErr (quote erased_in_runtime) "a type or a proof in a runtime position (law §4.2)"))
       (None (ErErr (quote erased_in_runtime) "a variable the erasure does not know"))))
    ((Lit _ (LitNat n)) (ErOk t (ELit (LNat n))))
    ((Lit _ (LitStr _)) (ErErr (quote string_literal) "phase 3 (§12.6): S has no string realization at Stage 0"))
    ((Let _ n ty v b) (erase_let t env n ty v b fuel))
    ((Lam _ _ _ _ _) (ErErr (quote function_value) "a lambda in a runtime position (law §4.3)"))
    ((Pi _ _ _ _ _) (ErErr (quote erased_in_runtime) "a type in a runtime position"))
    ((Sort _ _) (ErErr (quote erased_in_runtime) "a sort in a runtime position"))
    ((BVar _ _) (ErErr (quote erased_in_runtime) "a loose variable"))
    ((Proj _ sn i x) (erase_proj t env sn i x fuel))
    (_ (erase_app t env (get_app_fn e) (get_app_args e) fuel)))))
(fn erase_all ((t Tr) (env (List ErEnt)) (es (List Expr)) (fuel Int) (acc (List ETerm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List ETerm)))
  (measure (struct es))
  (match es
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons e r)
     (match (erase t env e fuel)
       ((ErErr x m) (Pair (Some (Pair x m)) (Pair t Nil)))
       ((ErOk t1 e1) (erase_all t1 env r fuel (Cons e1 acc)))))))
;; a let: a proposition or a type vanishes (its variable erased), a value is an E let
(fn erase_let ((t Tr) (env (List ErEnt)) (n Name) (ty Expr) (v Expr) (b Expr) (fuel Int)) ErRes
  (match (w_is_prop (tr_w t) ty)
    ((Pair w1 (Some True))
     (match (tr_local_val (tr_set_w t w1) n ty v)
       ((Pair t1 fv) (match (tr_inst1 t1 b fv) ((Pair t2 b1) (erase t2 (Cons (ErEnt (fvar_id_of fv) EKErased) env) b1 (- fuel 1)))))))
    ((Pair w1 _)
     (match (tr_whnf (tr_set_w t w1) ty)
       ((Pair t1 (Some (Sort _ _)))
        (match (tr_local_val t1 n ty v)
          ((Pair t2 fv) (match (tr_inst1 t2 b fv) ((Pair t3 b1) (erase t3 (Cons (ErEnt (fvar_id_of fv) EKStatic) env) b1 (- fuel 1)))))))
       ((Pair t1 _)
        (match (erase t1 env v (- fuel 1))
          ((ErErr e m) (ErErr e m))
          ((ErOk t2 v1)
           (match (tr_local_val t2 n ty v)
             ((Pair t3 fv)
              (match (tr_inst1 t3 b fv)
                ((Pair t4 b1)
                 (match (erase t4 (Cons (ErEnt (fvar_id_of fv) EKVar) env) b1 (- fuel 1))
                   ((ErErr e m) (ErErr e m))
                   ((ErOk t5 b2) (ErOk t5 (ELet (list v1) b2)))))))))))))))
;; a projection: a match on the structure's constructor, the field's variable
(fn erase_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (fuel Int)) ErRes
  (match (erase t env x (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 x1)
     (match (ind_eligible (tr_w t1) (tr_es t1) (tr_sc t1) sn Nil)
       ((Pair (Pair w2 es2) False) (ErErr (quote no_realization) (append (show_name sn) " is not an E type")))
       ((Pair (Pair w2 es2) True)
        (let ((t2 (tr_set_es (tr_set_w t1 w2) es2)))
          (match (ind_ctor_names t2 sn)
            ((Cons c Nil)
             (match (field_roles t2 c)
               ((Pair t3 None) (ErErr (quote no_realization) (show_name c)))
               ((Pair t3 (Some roles))
                (match (runtime_index roles i 0 0)
                  (None (ErErr (quote erased_in_runtime) (append (show_name sn) ": a projection of an erased field")))
                  ((Some (Pair j nrt)) (ErOk t3 (EMatch x1 (list (EArm (PCtor c (pvars nrt)) (EBVar (- (- nrt 1) j)))))))))))
            (_ (ErErr (quote no_realization) (append (show_name sn) " is not a structure"))))))))))
;; the field roles of a constructor: True for a runtime field, False for an erased one
(fn field_roles ((t Tr) (c Name)) (Pair Tr (Option (List Bool)))
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ _ _ nparams _ _)
        (match (tr_tele t info)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some (Tele _ binds _ _))) (Pair t1 (Some (data_flags (drop nparams binds)))))))
       (_ (Pair t None))))
    (None (Pair t None))))
(fn data_flags ((binds (List TBind))) (List Bool)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ (BData _) _) r) (Cons True (data_flags r))) ((Cons _ r) (Cons False (data_flags r)))))
;; field i's index among the runtime fields, and their count
(fn runtime_index ((roles (List Bool)) (i Int) (k Int) (j Int)) (Option (Pair Int Int))
  (measure (struct roles))
  (match roles
    (Nil None)
    ((Cons rt r)
     (if (int_eq k i)
       (if rt (Some (Pair j (+ j (count_true roles)))) None)
       (runtime_index r i (+ k 1) (if rt (+ j 1) j))))))
(fn count_true ((bs (List Bool))) Int
  (measure (struct bs))
  (match bs (Nil 0) ((Cons True r) (+ 1 (count_true r))) ((Cons _ r) (count_true r))))
;; an application by its head
(fn erase_app ((t Tr) (env (List ErEnt)) (head Expr) (args (List Expr)) (fuel Int)) ErRes
  (match head
    ((Const _ c _) (erase_const t env c args fuel))
    ((FVar _ id)
     (match (er_index env id 0)
       ((Some (Pair EKVar i)) (erase_erased_args t env (EBVar i) args fuel))
       ((Some (Pair EKIH _)) (ErErr (quote recursion_structure) "a recursive definition's executable structure is not readable off the recursor: supply the body (§7.1, §7.3)"))
       (_ (ErErr (quote function_value) "an application whose head is not a constant (law §4.3)"))))
    (_ (ErErr (quote function_value) "an application whose head is not a constant (law §4.3)"))))
;; a runtime variable applied to proofs (dite's branches): the variable itself; to anything else, a function value
(fn erase_erased_args ((t Tr) (env (List ErEnt)) (v ETerm) (args (List Expr)) (fuel Int)) ErRes
  (measure (struct args))
  (match args
    (Nil (ErOk t v))
    ((Cons a r)
     (match (tr_infer t a)
       ((Pair t1 (Some aty))
        (match (w_is_prop (tr_w t1) aty)
          ((Pair w2 (Some True)) (erase_erased_args (tr_set_w t1 w2) env v r fuel))
          ((Pair w2 _) (ErErr (quote function_value) "a variable applied to a runtime value (law §4.3)"))))
       ((Pair t1 None) (ErErr (quote function_value) "a variable applied to an argument K could not type"))))))
(fn last_component ((n Name)) Symbol (match n ((Str _ s) s) (_ (quote anon))))
(fn erase_const ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (let ((lc (last_component c)))
    (if (name_eq c (n2 (quote OfNat) (quote ofNat)))
      (match args ((Cons (Const _ nn _) (Cons (Lit _ (LitNat n)) _)) (if (name_eq nn (nm_nat)) (ErOk t (ELit (LNat n))) (ErErr (quote no_realization) "OfNat.ofNat off Nat"))) (_ (ErErr (quote no_realization) "OfNat.ofNat")))
    (if (name_eq c (nm_nat_zero)) (ErOk t (ELit (LNat 0)))
    (if (name_eq c (nm_nat_succ))
      (match args
        ((Cons x Nil) (match (erase t env x (- fuel 1)) ((ErErr e m) (ErErr e m)) ((ErOk t1 x1) (ErOk t1 (EPrim (n2 (quote Nat) (quote add)) (list x1 (ELit (LNat 1))))))))
        (_ (ErErr (quote function_value) "Nat.succ unapplied")))
    (if (bool_or (name_eq c (n1 (quote ite))) (name_eq c (n1 (quote dite))))
      (match args
        ((Cons _ (Cons _ (Cons h (Cons a (Cons b Nil))))) (erase_ite t env h a b (name_eq c (n1 (quote dite))) fuel))
        (_ (ErErr (quote function_value) "ite unapplied")))
    (if (bool_or (sym_eq lc (quote brecOn)) (bool_or (sym_eq lc (quote below)) (bool_or (sym_eq lc (quote fix)) (sym_eq lc (quote binductionOn)))))
      (ErErr (quote recursion_structure) (append (show_name c) ": a recursive definition's executable structure is not readable off the kernel term — supply the body (§7.1, §7.3)"))
    (if (bool_or (name_eq c (n2 (quote Classical) (quote choice))) (bool_or (name_eq c (n2 (quote Acc) (quote rec))) (bool_or (name_eq c (nm_quot_lift)) (bool_or (name_eq c (nm_quot_mk)) (name_eq c (nm_quot_ind))))))
      (ErErr (quote noncomputable) (append (show_name c) " in a runtime position (law §4.2)"))
    (match (env_find (tr_env t) c)
      (None (ErErr (quote unknown_constant) (show_name c)))
      ((Some info)
       (match info
         ((CtorInfo _ ind _ nparams _ _) (erase_ctor t env c ind nparams args fuel))
         ((RecInfo _ _ nparams _ nmotives nminors _ _ _) (erase_rec t env c nparams nmotives nminors args fuel))
         (_
          (if (sym_eq lc (quote casesOn))
            (erase_cases t env c args fuel)
            (match (es_find_decl (tr_es t) c)
              ((Some (EFn _ _ ps _ _ _)) (erase_call t env c info args fuel))
              ((Some (ESig _ _ ps _)) (erase_call t env c info args fuel))
              (_
               (match (prim_l_identity c)
                 ((Some _) (match (erase_all t env args fuel Nil) ((Pair (Some (Pair e m)) _) (ErErr e m)) ((Pair None (Pair t1 as)) (ErOk t1 (EPrim c as)))))
                 (None (ErErr (quote no_realization) (append (show_name c) ": no realization attached — realize it first (§7.1)")))))))))))))))))))
;; a constructor: its inductive E-eligible, the static and erased arguments dropped
(fn erase_ctor ((t Tr) (env (List ErEnt)) (c Name) (ind Name) (nparams Int) (args (List Expr)) (fuel Int)) ErRes
  (match (ind_eligible (tr_w t) (tr_es t) (tr_sc t) ind Nil)
    ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
    ((Pair (Pair w1 es1) True)
     (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
       (match (field_roles t1 c)
         ((Pair t2 None) (ErErr (quote no_realization) (show_name c)))
         ((Pair t2 (Some roles))
          (if (bool_not (int_eq (len args) (+ nparams (len roles)))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
            (match (erase_roles t2 env roles (drop nparams args) fuel Nil)
              ((Pair (Some (Pair e m)) _) (ErErr e m))
              ((Pair None (Pair t3 as)) (ErOk t3 (ECtor c as)))))))))))
(fn erase_roles ((t Tr) (env (List ErEnt)) (roles (List Bool)) (args (List Expr)) (fuel Int) (acc (List ETerm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List ETerm)))
  (measure (struct roles))
  (match roles
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons rt r)
     (match args
       (Nil (Pair (Some (Pair (quote function_value) "partially applied")) (Pair t Nil)))
       ((Cons a ar)
        (if rt
          (match (erase t env a (- fuel 1))
            ((ErErr e m) (Pair (Some (Pair e m)) (Pair t Nil)))
            ((ErOk t1 a1) (erase_roles t1 env r ar fuel (Cons a1 acc))))
          (erase_roles t env r ar fuel acc)))))))
;; a call of a realized constant: its binders' roles select the runtime arguments
(fn erase_call ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int)) ErRes
  (match (tr_tele t info)
    ((Pair t1 None) (ErErr (quote no_realization) (show_name c)))
    ((Pair t1 (Some (Tele _ binds _ _)))
     (let ((roles (data_flags binds)))
       (if (bool_not (int_eq (len args) (len roles))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
         (match (erase_roles t1 env roles args fuel Nil)
           ((Pair (Some (Pair e m)) _) (ErErr e m))
           ((Pair None (Pair t2 as)) (ErOk t2 (ECall c as)))))))))
;; ite / dite: an if on the decision; dite's branches applied to their proof
(fn erase_ite ((t Tr) (env (List ErEnt)) (h Expr) (a Expr) (b Expr) (dep Bool) (fuel Int)) ErRes
  (match (erase t env h (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 h1)
     (match (erase_branch t1 env a dep fuel)
       ((ErErr e m) (ErErr e m))
       ((ErOk t2 a1)
        (match (erase_branch t2 env b dep fuel)
          ((ErErr e m) (ErErr e m))
          ((ErOk t3 b1) (ErOk t3 (EIf h1 a1 b1)))))))))
(fn erase_branch ((t Tr) (env (List ErEnt)) (br Expr) (dep Bool) (fuel Int)) ErRes
  (if (bool_not dep) (erase t env br (- fuel 1))
    (match br
      ((Lam _ n _ dom body)
       (match (tr_local t n dom)
         ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (erase t2 (Cons (ErEnt (fvar_id_of fv) EKErased) env) body1 (- fuel 1)))))))
      (_ (erase t env br (- fuel 1))))))
;; T.casesOn params motive major minors: a match, each minor's field lambdas the pattern's variables
(fn erase_cases ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match c
    ((Str ind _)
     (match (env_find (tr_env t) ind)
       ((Some (InductInfo _ nparams _ _ ctors _ _ _ _))
        (match (ind_eligible (tr_w t) (tr_es t) (tr_sc t) ind Nil)
          ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
          ((Pair (Pair w1 es1) True)
           (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
             (if (bool_not (int_eq (len args) (+ nparams (+ 2 (len ctors))))) (ErErr (quote function_value) (append (show_name c) " partially applied"))
               (match (nth args (+ nparams 1))
                 (None (ErErr (quote function_value) (show_name c)))
                 ((Some major)
                  (match (erase t1 env major (- fuel 1))
                    ((ErErr e m) (ErErr e m))
                    ((ErOk t2 major1)
                     (match (erase_minors t2 env ctors (drop (+ nparams 2) args) False fuel Nil)
                       ((Pair (Some (Pair e m)) _) (ErErr e m))
                       ((Pair None (Pair t3 arms)) (ErOk t3 (EMatch major1 arms)))))))))))))
       (_ (ErErr (quote no_realization) (show_name c)))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; T.rec params motive minors major with no use of an induction hypothesis: a match
(fn erase_rec ((t Tr) (env (List ErEnt)) (c Name) (nparams Int) (nmotives Int) (nminors Int) (args (List Expr)) (fuel Int)) ErRes
  (match c
    ((Str ind _)
     (if (bool_not (int_eq nmotives 1)) (ErErr (quote recursion_structure) (append (show_name c) ": a nested inductive's recursor"))
     (match (env_find (tr_env t) ind)
       ((Some (InductInfo _ _ _ _ ctors _ _ _ _))
        (match (ind_eligible (tr_w t) (tr_es t) (tr_sc t) ind Nil)
          ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
          ((Pair (Pair w1 es1) True)
           (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
             (if (bool_not (int_eq (len args) (+ nparams (+ 2 nminors)))) (ErErr (quote function_value) (append (show_name c) " partially applied"))
               (match (nth args (+ nparams (+ 1 nminors)))
                 (None (ErErr (quote function_value) (show_name c)))
                 ((Some major)
                  (match (erase t1 env major (- fuel 1))
                    ((ErErr e m) (ErErr e m))
                    ((ErOk t2 major1)
                     (match (erase_minors t2 env ctors (take nminors (drop (+ nparams 1) args)) True fuel Nil)
                       ((Pair (Some (Pair e m)) _) (ErErr e m))
                       ((Pair None (Pair t3 arms)) (ErOk t3 (EMatch major1 arms)))))))))))))
       (_ (ErErr (quote no_realization) (show_name c))))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; the minors in constructor order: each a lambda over the fields (and, for a recursor, the hypotheses)
(fn erase_minors ((t Tr) (env (List ErEnt)) (ctors (List Name)) (minors (List Expr)) (with_ihs Bool) (fuel Int) (acc (List EArm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List EArm)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons c r)
     (match minors
       (Nil (Pair (Some (Pair (quote function_value) "a case analysis with too few alternatives")) (Pair t Nil)))
       ((Cons m mr)
        (match (field_roles t c)
          ((Pair t1 None) (Pair (Some (Pair (quote no_realization) (show_name c))) (Pair t1 Nil)))
          ((Pair t1 (Some roles))
           (match (erase_minor t1 env m roles (if with_ihs (ih_count t1 c) 0) fuel)
             ((Pair (Some (Pair e msg)) _) (Pair (Some (Pair e msg)) (Pair t1 Nil)))
             ((Pair None (Pair t2 body))
              (erase_minors t2 env r mr with_ihs fuel (Cons (EArm (PCtor c (pvars (count_true roles))) body) acc)))))))))))
;; the induction hypotheses of a constructor: one per field whose type's head is its inductive
(fn ih_count ((t Tr) (c Name)) Int
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (tr_tele t info)
          ((Pair _ None) 0)
          ((Pair t1 (Some (Tele _ binds _ _))) (count_recursive t1 (drop nparams binds) ind))))
       (_ 0)))
    (None 0)))
(fn count_recursive ((t Tr) (binds (List TBind)) (ind Name)) Int
  (measure (struct binds))
  (match binds
    (Nil 0)
    ((Cons (TBind _ _ fv) r)
     (+ (match (tr_type_of_local t fv) ((Some ty) (if (is_head_const ty ind) 1 0)) (None 0)) (count_recursive t r ind)))))
;; one minor: a lambda per field (erased fields and hypotheses as erased entries), then its body
(fn erase_minor ((t Tr) (env (List ErEnt)) (m Expr) (roles (List Bool)) (nihs Int) (fuel Int)) (Pair (Option (Pair Symbol (List Int))) (Pair Tr ETerm))
  (measure (struct roles))
  (match roles
    (Nil
     (match (open_ihs_lams t env m nihs fuel)
       ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a case alternative K could not open as a function of its hypotheses")) (Pair t1 (EBVar 0))))
       ((Pair t1 (Some (Pair env1 body)))
        (match (erase t1 env1 body (- fuel 1))
          ((ErErr e msg) (Pair (Some (Pair e msg)) (Pair t1 (EBVar 0))))
          ((ErOk t2 b) (Pair None (Pair t2 b)))))))
    ((Cons rt r)
     (match (open_lam t m)
       ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a case alternative K could not open as a function of its fields")) (Pair t1 (EBVar 0))))
       ((Pair t1 (Some (Pair fv body))) (erase_minor t1 (Cons (ErEnt (fvar_id_of fv) (if rt EKVar EKErased)) env) body r nihs fuel))))))
;; a lambda's binder opened as a local (a non-lambda is applied to the local — eta)
(fn open_lam ((t Tr) (m Expr)) (Pair Tr (Option (Pair Expr Expr)))
  (match m
    ((Lam _ n _ dom body)
     (match (tr_local t n dom) ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (Pair t2 (Some (Pair fv body1))))))))
    (_
     (match (tr_infer t m)
       ((Pair t1 (Some ty))
        (match (tr_whnf t1 ty)
          ((Pair t2 (Some (Pi _ n _ dom _)))
           (match (tr_local t2 n dom) ((Pair t3 fv) (match (tr_apps t3 m (list fv)) ((Pair t4 m1) (Pair t4 (Some (Pair fv m1))))))))
          ((Pair t2 _) (Pair t2 None))))
       ((Pair t1 None) (Pair t1 None))))))
(fn open_ihs_lams ((t Tr) (env (List ErEnt)) (m Expr) (k Int) (fuel Int)) (Pair Tr (Option (Pair (List ErEnt) Expr)))
  (measure k)
  (if (lt k 1) (Pair t (Some (Pair env m)))
    (match (open_lam t m)
      ((Pair t1 None) (Pair t1 None))
      ((Pair t1 (Some (Pair fv body))) (open_ihs_lams t1 (Cons (ErEnt (fvar_id_of fv) EKIH) env) body (- k 1) fuel)))))
