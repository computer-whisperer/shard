;;; v3/kernel/realize.shard — `realize`: an E body attached to an existing admitted L constant
;;; under its own identity.
;;; The supplied form checks the E signature against the erasure of the constant's L type
;;; (erase.shard's roles), binds the signature's names to the constant's own telescope,
;;; elaborates the body once at the result's L type (elab.shard), takes its erasure as the
;;; program (erasure.shard), checks descent and callee order on it, and states one equation
;;; per leaf of the body's leading matchers — each a theorem `NAME.realize_N` the loader
;;; admits (proven by `Eq.refl`, or by the `equations` clause). The derived view erases the
;;; constant's L value. The equations' leaves are shared with define.shard's `fn`.
(import Init)
(import "erasure.shard")
(import "classify.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.classify)
(use kernel.decl)
(use kernel.erase)
(use kernel.erasure)
(use kernel.kw)
(use kernel.elab El el_w el0 el_set_w el_set_cx el_cx el_aux elab el_finish)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.predef.Either5)
(use kernel.predef.PdRec)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.matcher)
(use kernel.name)
(use kernel.predef)
(use kernel.prog)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.classify.PmRes)
(use kernel.classify.TyRes)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.kw.W)
(use kernel.kw.WOut)
(use kernel.etable.EHit)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtInd)
(use kernel.matcher.MtPat)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.sexpr.SExpr)
(use kernel.erasure.ErRes)
(use kernel.erasure.Either5r)
(fn nm_realize_n ((k Int)) Name (n1 (sym_of_chars (append "realize_" (show_nat k)))))
(fn nm_eq_n ((k Int)) Name (n1 (sym_of_chars (append "eq_" (show_nat k)))))

;; ---- substitution helpers of the equations' splits ---------------------------------------------
;; the metas are locals of the callee's telescope; a solved meta is compared structurally
(fn assoc_int_expr ((id Int) (sub (List (Prod Int Expr)))) (Option Expr)
  (measure (struct sub))
  (match sub
    (nil none)
    ((cons (Prod.mk j e) r) (if (= id j) (some e) (assoc_int_expr id r)))))
(fn subst_all ((t Tr) (es (List Expr)) (id Int) (v Expr) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk t (rev acc)))
    ((cons e r)
     (match (tr_subst t e id v)
       ((Prod.mk t1 e1) (subst_all t1 r id v (cons e1 acc)))))))
;; a kept binder whose type mentions the split variable (an erased binder over a data parameter)
;; is re-opened at the substituted type; the pairs (old id, new local) apply to everything after
(fn refresh_kept
  ((t Tr)
   (kept (List Expr))
   (vid Int)
   (cterm Expr)
   (acc (List Expr))
   (pairs (List (Prod Int Expr))))
  (Prod Tr (Prod (List Expr) (List (Prod Int Expr))))
  (measure (struct kept))
  (match kept
    (nil (Prod.mk t (Prod.mk (rev acc) (rev pairs))))
    ((cons fv r)
     (match (tr_type_of_local t fv)
       (none (refresh_kept t r vid cterm (cons fv acc) pairs))
       ((some ty)
        (match (tr_subst t ty vid cterm)
          ((Prod.mk t1 ty1)
           (match (subst_pairs t1 ty1 (rev pairs))
             ((Prod.mk t2 ty2)
              (if (expr_eq ty ty2) (refresh_kept t2 r vid cterm (cons fv acc) pairs)
              (match (tr_local t2 (n1 (quote h)) ty2)
                ((Prod.mk t3 fv1)
                 (refresh_kept t3 r vid cterm (cons fv1 acc)
                   (cons (Prod.mk (fvar_id_of fv) fv1) pairs))))))))))))))
(fn subst_pairs ((t Tr) (e Expr) (pairs (List (Prod Int Expr)))) (Prod Tr Expr)
  (measure (struct pairs))
  (match pairs
    (nil (Prod.mk t e))
    ((cons (Prod.mk id v) r)
     (match (tr_subst t e id v)
       ((Prod.mk t1 e1) (subst_pairs t1 e1 r))))))
(fn without_id ((fvs (List Expr)) (id Int)) (List Expr)
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r) (if (= (fvar_id_of fv) id) (without_id r id) (cons fv (without_id r id))))))

;; ---- descent and order --------------------------------------------------------------
;; flags per variable (innermost first): 2 the structural parameter, 1 a proper subterm of it, 0 other
;; a realization cannot wait for a callee (the loader parks a fn's definition, never a realize):
;; the pending callee is the obstacle no_l_meaning here
(fn pending_as_runnable ((r (Option (Prod Symbol (List Int))))) (Option (Prod Symbol (List Int)))
  (match r
    ((some (Prod.mk e m))
     (if (sym_eq e (quote callee_pending))
       (some
         (Prod.mk (quote no_l_meaning)
           (append m ": a fn without a definition has no L meaning (RUNNABLE)")))
       r))
    (none none)))
(fn check_calls ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (e ETerm))
  (Option (Prod Symbol (List Int)))
  (measure (struct e))
  (match e
    ((EBVar _) none)
    ((ELit _) none)
    ((ECtor _ as) (check_all es env id rec flags as))
    ((EPrim _ as) (check_all es env id rec flags as))
    ((EExt f _)
     (some (Prod.mk (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
    ((ECall f as)
     (match (check_all es env id rec flags as)
       ((some x) (some x))
       (none
         (if (name_eq f id)
           (match rec
             (RecNone
               (some
                 (Prod.mk (quote realize_recursion)
                   (append (show_name id) " calls itself without a measure"))))
             ((RecStruct i)
              (match (nth as i)
                ((some (EBVar j))
                 (if (= (flag_at flags j) 1) none
                 (some
                   (Prod.mk (quote realize_descent)
                     (append (show_name id)
                       ": a recursive call does not pass a proper subterm of the structural parameter")))))
                (_
                  (some
                    (Prod.mk (quote realize_descent)
                      (append (show_name id)
                        ": a recursive call does not pass a proper subterm of the structural parameter"))))))
             (_  ; a measure: the program's own term, or K's alone (RecLogical)
               (if (args_are_params as (len flags) 0)
                 (some
                   (Prod.mk (quote realize_descent)
                     (append (show_name id)
                       " calls itself on its own parameters — no measure decreases")))
                 none)))
           (match (es_find_decl es f)
             ((some (EFn _ _ _ _ _ _))
              (match (env_find env f)
                ((some _) none)
                ;; a fn K holds no constant for: pending_as_runnable makes it no_l_meaning
                (none (some (Prod.mk (quote callee_pending) (show_name f))))))
             ((some (ESig _ _ _ _)) none)
             ((some (EExtern _ _ _ _))
              (some
                (Prod.mk (quote no_l_meaning) (append (show_name f) ": an extern has no L meaning"))))
             (_
               (some
                 (Prod.mk (quote realize_order)
                   (append (show_name f) ": cited before its realization is attached")))))))))
    ((EMatch s arms)
     (match (check_calls es env id rec flags s)
       ((some x) (some x))
       (none
         (check_arms es env id rec flags
           (match s
             ((EBVar j) (flag_at flags j))
             (_ 0))
           arms))))
    ((ELet rs b) (check_let es env id rec flags rs b))
    ((EIf a b c)
     (match (check_calls es env id rec flags a)
       ((some x) (some x))
       (none
         (match (check_calls es env id rec flags b)
           ((some x) (some x))
           (none (check_calls es env id rec flags c))))))
    ((ELam _ _ _) none)
    (EAbsurd none)))
(fn check_all ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (ts (List ETerm)))
  (Option (Prod Symbol (List Int)))
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons x r)
     (match (check_calls es env id rec flags x)
       ((some y) (some y))
       (none (check_all es env id rec flags r))))))
(fn check_arms
  ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (sflag Int) (arms (List EArm)))
  (Option (Prod Symbol (List Int)))
  (measure (struct arms))
  (match arms
    (nil none)
    ((cons (EArm p b) r)
     (match (check_calls es env id rec (rev_onto (pat_flags p sflag) flags) b)
       ((some x) (some x))
       (none (check_arms es env id rec flags sflag r))))))
;; a pattern's variables' flags in capture order: a variable at the top keeps the scrutinee's,
;; one under a constructor is a proper subterm when the scrutinee is the parameter or under it
(fn pat_flags ((p EPat) (sflag Int)) (List Int)
  (match p
    (PVar (list sflag))
    ((PLit _) nil)
    ((PCtor _ subs) (sub_flags subs (if (< 0 sflag) 1 0)))))
(fn sub_flags ((ps (List EPat)) (f Int)) (List Int)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons PVar r) (cons f (sub_flags r f)))
    ((cons (PLit _) r) (sub_flags r f))
    ((cons (PCtor _ subs) r) (append (sub_flags subs f) (sub_flags r f)))))
(fn check_let
  ((es ESt) (env CheckedEnv) (id Name) (rec ERec) (flags (List Int)) (rs (List ETerm)) (b ETerm))
  (Option (Prod Symbol (List Int)))
  (measure (struct rs))
  (match rs
    (nil (check_calls es env id rec flags b))
    ((cons x r)
     (match (check_calls es env id rec flags x)
       ((some y) (some y))
       (none (check_let es env id rec (cons 0 flags) r b))))))
(fn flag_at ((flags (List Int)) (j Int)) Int
  (match (nth flags j)
    ((some f) f)
    (none 0)))
;; the arguments are the parameters in order: argument i is the variable at depth n-1-i
(fn args_are_params ((as (List ETerm)) (n Int) (i Int)) Bool
  (measure (struct as))
  (match as
    (nil true)
    ((cons (EBVar j) r) (if (= j (- (- n 1) i)) (args_are_params r n (+ i 1)) false))
    (_ false)))
;; the parameters' flags, innermost first: the structural parameter (0-based in binder order) is 2
(fn param_flags ((n Int) (rec ERec)) (List Int)
  (match rec
    ((RecStruct i) (rev (flags_upto n i 0)))
    (_ (zeros_int n))))
(fn flags_upto ((n Int) (i Int) (k Int)) (List Int)
  (measure (- n k))
  (if (<= n k) nil (cons (if (= k i) 2 0) (flags_upto n i (+ k 1)))))
(fn zeros_int ((n Int)) (List Int) (measure n) (if (< n 1) nil (cons 0 (zeros_int (- n 1)))))

;; ---- the supplied form ---------------------------------------
;; a realization: the E table (Init inductives the walk registered), the program to attach once
;; the equations are admitted, the matchers to admit, the equations as theorem declarations in
;; order, pending?, the lambdas it lifted and the instances it demands; or a realize template:
;; the constant, the elaboration state, the body, the recursion clause, the binders, the
;; result's E and L types, the levels, the matchers, the equations, pending?
(type RzRes
  (RzOk ESt EDecl (List Declaration) (List Declaration) Bool (List Lifted) (List Demand))
  (RzTemplate Name El Expr PdRec (List TBind) EType Expr (List Level) (List Declaration)
    (List Declaration)
    Bool)
  (RzErr Symbol (List Int)))
;; NAME's identity resolved through the scope: a definition of the environment
(type RtRes (RtOk Name ConstantInfo) (RtErr Symbol (List Int)))
(fn realize_target ((sc Scope) (env CheckedEnv) (n Name)) RtRes
  (match (resolve (cx0 sc env nil nil) n)
    (RNone (RtErr (quote unknown_constant) (show_name n)))
    ((RAmbiguous a b) (RtErr (quote ambiguous_name) (ambiguous_msg n a b)))
    ((RPend k) (RtErr (quote pending_obligation) (show_name k)))
    ((RName k _) (realize_info env k))))
;; the constant of identity k as a realization's target: a definition, no primitive
(fn realize_info ((env CheckedEnv) (k Name)) RtRes
  (match (env_find env k)
    ((some info)
     (match info
       ((DefnInfo _ _ _ _ _)
        (match (prim_l_identity k)
          ((some _)
           (RtErr (quote realize_primitive)
             (append (show_name k)
               " is an entry of the primitive table: K's own rule realizes it, and a body cites it as a primitive")))
          (none (RtOk k info))))
       (_
         (RtErr (quote realize_kind)
           (append (show_name k)
             " is not a definition (an axiom, a theorem, a constructor or a type has no realization)")))))
    (none (RtErr (quote unknown_constant) (show_name k)))))
;; the E signature read from BINDERS RET, compared with the erasure of the L type
(fn signature_matches
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (binds (List TBind))
   (rt EType)
   (bs (List SExpr))
   (ret SExpr))
  (Option (List Int))
  (match (read_params es sc env false nil bs nil nil nil nil)
    ((PmErr e m) (some (append (chars_of_sym e) (append ": " m))))
    ((PmOk _ ptypes tps _ _)
     (match (read_ety es sc env tps ret)
       ((TyErr e m) (some (append (chars_of_sym e) (append ": " m))))
       ((TyOk ert _)
        (if (bool_not (= (len tps) (count_types binds)))
          (some
            (append "the L type has "
              (append (show_nat (count_types binds))
                (append " type parameters, the E signature " (show_nat (len tps))))))
          (match (data_mismatch binds ptypes 0)
            ((some m) (some m))
            (none
              (if (etype_eq ert rt) none (some "the result type differs from the L type's erasure"))))))))))
(fn data_mismatch ((binds (List TBind)) (ptypes (List EType)) (i Int)) (Option (List Int))
  (measure (struct binds))
  (match binds
    (nil
      (match ptypes
        (nil none)
        (_ (some "the E signature has more binders than the L type's erasure"))))
    ((cons (TBind n (BData ety) _) r)
     (match ptypes
       (nil (some (append "the E signature lacks the binder " (show_name n))))
       ((cons p pr)
        (if (etype_eq p ety) (data_mismatch r pr (+ i 1))
        (some
          (append "the binder " (append (show_name n) " has another type than the L type's erasure")))))))
    ((cons _ r) (data_mismatch r ptypes i))))
;; the forms after RET without a trailing (equations THM…), and the clause's theorems
(type Either4 (Left4 Symbol (List Int)) (Right4 (List Name)))
(fn split_equations ((sc Scope) (env CheckedEnv) (rest (List SExpr))) (Prod (List SExpr) Either4)
  (match (rev rest)
    ((cons (SList (cons (SSym e) thms)) r)
     (if (sym_eq e (quote equations)) (Prod.mk (rev r) (thm_names sc env thms nil))
     (Prod.mk rest (Right4 nil))))
    (_ (Prod.mk rest (Right4 nil)))))
(fn thm_names ((sc Scope) (env CheckedEnv) (ss (List SExpr)) (acc (List Name))) Either4
  (measure (struct ss))
  (match ss
    (nil (Right4 (rev acc)))
    ((cons (SSym x) r)
     (match (name_of_sym x)
       (none (Left4 (quote bad_name) (chars_of_sym x)))
       ((some n)
        (match (resolve (cx0 sc env nil nil) n)
          ((RName k _) (thm_names sc env r (cons k acc)))
          ((RAmbiguous a b) (Left4 (quote ambiguous_name) (ambiguous_msg n a b)))
          ((RPend k) (Left4 (quote pending_obligation) (show_name k)))
          (RNone (Left4 (quote unknown_constant) (append (show_name n) " (the equations clause)")))))))
    (_ (Left4 (quote bad_shape) "(equations THM…) names theorems"))))
;; the theorem's identity for equation k: NAME.realize_k in the realizing module — a native
;; NAME already carries its module, an imported one is prefixed
(fn eq_name ((sc Scope) (k Name) (i Int)) Name
  (let ((suffix (nm_realize_n i)))
    (match (sc_vis sc)
      ((VisOnly _ _ tbl _ _ _)
       (match (tbl_find tbl k)
         ((some m)
          (if (name_eq m (sc_tag sc)) (name_append k suffix) (qualify sc (name_append k suffix))))
         (none (qualify sc (name_append k suffix)))))
      (VisAll (name_append k suffix)))))
(fn realize_supplied ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (cons _ (cons (SSym x) (cons (SList bs) (cons ret rest0)))))
     (match (name_of_sym x)
       (none (RzErr (quote bad_name) (chars_of_sym x)))
       ((some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info)
           (match (split_equations sc env rest0)
             ((Prod.mk _ (Left4 e m)) (RzErr e m))
             ((Prod.mk rest (Right4 thms))
              (match (tele_of (w0 env) es sc info)
                ((TeleErr e m) (RzErr e m))
                ((TeleOk w1 es1 (Tele ls binds rt rl))
                 (match (signature_matches es1 sc env binds rt (static_free binds bs) ret)
                   ((some m)
                    (RzErr (quote realize_signature) (append (show_name k) (append ": " m))))
                   (none
                     (match (static_signature w1 es1 sc env binds bs)
                       ((Prod.mk (Prod.mk w2 es2) (some m))
                        (RzErr (quote realize_signature) (append (show_name k) (append ": " m))))
                       ((Prod.mk (Prod.mk w2 es2) none)
                        (if (has_static binds)
                          (realize_template es2 sc env k w2 ls binds rt rl bs rest thms)
                          (realize_body (ensure_head es2 sc k (count_data binds)) sc env k w2 ls
                            binds
                            rt
                            rl
                            bs
                            rest
                            thms)))))))))))))))
    (_
      (RzErr (quote bad_shape)
        "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?) or (realize NAME (view))"))))
;; the written binders without the static ones: the data binders' E types are compared
;; with the L type's erasure; a static binder's written type is checked by static_signature
(fn static_free ((binds (List TBind)) (bs (List SExpr))) (List SExpr)
  (measure (struct binds))
  (match binds
    (nil bs)
    ((cons (TBind _ BErased _) r) (static_free r bs))
    ((cons (TBind _ (BStatic _) _) r)
     (match bs
       ((cons _ br) (static_free r br))
       (nil nil)))
    ((cons _ r)
     (match bs
       ((cons b br) (cons b (static_free r br)))
       (nil nil)))))
;; each static binder's written type `(-> D… R)` against the L type's domains and result as E types
(fn static_signature
  ((w W) (es ESt) (sc Scope) (env CheckedEnv) (binds (List TBind)) (bs (List SExpr)))
  (Prod (Prod W ESt) (Option (List Int)))
  (match (read_params es sc env false nil (static_free binds bs) nil nil nil nil)
    ((PmErr _ _) (Prod.mk (Prod.mk w es) none))  ; signature_matches reported it
    ((PmOk _ _ tps _ _) (static_signature_go w es sc env tps (tbind_types binds) binds bs))))
(fn static_signature_go
  ((w W)
   (es ESt)
   (sc Scope)
   (env CheckedEnv)
   (tps (List Name))
   (tpl (List Expr))
   (binds (List TBind))
   (bs (List SExpr)))
  (Prod (Prod W ESt) (Option (List Int)))
  (measure (struct binds))
  (match binds
    (nil (Prod.mk (Prod.mk w es) none))
    ((cons (TBind _ BErased _) r) (static_signature_go w es sc env tps tpl r bs))
    ((cons (TBind n (BStatic _) fv) r)
     (match bs
       ((cons (SList (cons _ (cons (SList (cons (SSym arrow) wtys)) nil))) br)
        (if (bool_not (sym_eq arrow (quote ->)))
          (Prod.mk (Prod.mk w es)
            (some
              (append "the binder "
                (append (show_name n) " is a function in the L type: write (-> D… R)"))))
          (match (read_etys es sc env tps wtys nil)
            ((Prod.mk (TyErr e m) _)
             (Prod.mk (Prod.mk w es) (some (append (chars_of_sym e) (append ": " m)))))
            ((Prod.mk (TyOk _ _) written)
             (match (w_local_type w (fvar_id_of fv))
               (none (Prod.mk (Prod.mk w es) (some "a bound variable without a local")))
               ((some lty)
                (match (static_etypes w es sc lty tpl nil (budget_depth))
                  ((Prod.mk (Prod.mk w1 es1) none)
                   (Prod.mk (Prod.mk w1 es1)
                     (some
                       (append "the binder "
                         (append (show_name n) " has no function type over E types in the L type")))))
                  ((Prod.mk (Prod.mk w1 es1) (some ltys))
                   (if (etypes_same written ltys) (static_signature_go w1 es1 sc env tps tpl r br)
                   (Prod.mk (Prod.mk w1 es1)
                     (some
                       (append "the binder "
                         (append (show_name n) " has another type than the L type's erasure")))))))))))))
       (_
         (Prod.mk (Prod.mk w es)
           (some
             (append "the binder "
               (append (show_name n) " is a function in the L type: write (-> D… R)")))))))
    ((cons _ r)
     (match bs
       ((cons _ br) (static_signature_go w es sc env tps tpl r br))
       (nil (Prod.mk (Prod.mk w es) none))))))
(fn etypes_same ((as (List EType)) (bs (List EType))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a ar)
     (match bs
       ((cons b br) (bool_and (etype_eq a b) (etypes_same ar br)))
       (nil false)))))
;; a realize template: the body elaborated as any supplied body's and its equations
;; proven over the arbitrary static binder — the L half, once —; no program: the loader checks
;; the body at placeholder shapes (template.shard's check_template) and builds the instances
;; later bodies demand
(fn realize_template
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (k Name)
   (w W)
   (ls (List Level))
   (binds (List TBind))
   (rt EType)
   (rl Expr)
   (bs (List SExpr))
   (rest (List SExpr))
   (thms (List Name)))
  RzRes
  (match (fn_body rest)
    (none
      (RzErr (quote bad_shape)
        "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?)"))
    ((some body)
     (let
       ((e0
          (bind_tele
            (el_set_w (el0 sc env nil nil (qualify sc (name_append k (n1 (quote realize))))) w)
            binds
            bs)))
       (match (fn_rec e0 (fn_measure rest) (tbind_fvars binds))
         ((Prod.mk _ (Left5 r m)) (RzErr r m))
         ((Prod.mk e1 (Right5 prec))
          (match (elab e1 body (some rl))
            ((EErr r m)
             (if (sym_eq r (quote unknown_constant)) (unknown_in_body es sc m) (RzErr r m)))
            ((EOk e2 v _)
             (match (el_finish e2 v)
               ((FinErr r m) (RzErr r m))
               ((FinOk b)
                (match
                  (pj_equations (tr_new (el_w e2) es sc k (tbind_types binds)) (mk_const k ls) -1
                    (tbind_fvars binds)
                    rl
                    b
                    thms
                    false
                    none)
                  ((Prod.mk _ (Left3 r m)) (RzErr r m))
                  ((Prod.mk _ (Right3 decls))
                   (RzTemplate k e2 b prec binds rt rl ls (el_aux e2) decls
                     (match prec
                       ((PdMeasure _) true)
                       (_ false)))))))))))))))
;; the body, elaborated once against the constant's own telescope: the
;; signature's names bound to the telescope's locals — a type or data binder each, an erased
;; binder none —, the body at the result's L type; its program the erasure, its equations the
;; leaves of its leading matchers, the matchers it generated admitted before them
(fn realize_body
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (k Name)
   (w W)
   (ls (List Level))
   (binds (List TBind))
   (rt EType)
   (rl Expr)
   (bs (List SExpr))
   (rest (List SExpr))
   (thms (List Name)))
  RzRes
  (match (fn_body rest)
    (none
      (RzErr (quote bad_shape)
        "(realize NAME ((x TYPE)…) RET (measure M)? BODY (equations THM…)?)"))
    ((some body)
     (let
       ((e0
          (bind_tele
            (el_set_w (el0 sc env nil nil (qualify sc (name_append k (n1 (quote realize))))) w)
            binds
            bs)))
       (match (fn_rec e0 (fn_measure rest) (tbind_fvars binds))
         ((Prod.mk _ (Left5 r m)) (RzErr r m))
         ((Prod.mk e1 (Right5 prec))
          (match (elab e1 body (some rl))
            ((EErr r m)
             (if (sym_eq r (quote unknown_constant)) (unknown_in_body es sc m) (RzErr r m)))
            ((EOk e2 v _)
             (match (el_finish e2 v)
               ((FinErr r m) (RzErr r m))
               ((FinOk b)
                (let ((t (tr_new (el_w e2) es sc k (tbind_types binds))) (ents (binder_ents binds)))
                  (match (predef_rec t ents prec binds)
                    ((Prod.mk _ (Left5r r m)) (RzErr r m))
                    ((Prod.mk t0 (Right5r rec))
                     (match (erase t0 ents b (budget_depth))
                       ((ErErr r m) (RzErr r m))
                       ((ErOk t1 ebody)
                        (match
                          (pending_as_runnable
                            (check_calls (Tr.es t1) env k rec (param_flags (count_data binds) rec)
                              ebody))
                          ((some (Prod.mk r m)) (RzErr r m))
                          (none
                            (match
                              (pj_equations t1 (mk_const k ls) -1 (tbind_fvars binds) rl b thms
                                false
                                none)
                              ((Prod.mk _ (Left3 r m)) (RzErr r m))
                              ((Prod.mk t2 (Right3 decls))
                               (RzOk (Tr.es t2)
                                 (EFn k (count_types binds) (bind_ptypes binds) rt rec ebody)
                                 (el_aux e2)
                                 decls
                                 (match rec
                                   ((RecMeasure _) true)
                                   (RecLogical true)
                                   (_ false))
                                 (Tr.lifted t2)
                                 (Tr.demands t2)))))))))))))))))))))
;; a body that lifted a lambda or demanded an instance: a fn's and a supplied realize's do; a
;; derived view's cannot
(fn takes_instances ((t Tr)) Bool (bool_or (< 0 (len (Tr.lifted t))) (< 0 (len (Tr.demands t)))))
;; a name the environment lacks, in a realization's body: a RUNNABLE function has no L meaning
;; (a realization cannot wait for it); an E primitive has no L identity
(fn unknown_in_body ((es ESt) (sc Scope) (m (List Int))) RzRes
  (match (name_of_sym (sym_of_chars m))
    (none (RzErr (quote unknown_constant) m))
    ((some n)
     (match (only_values (eresolve es sc n))
       ((cons (EHit id _ _) _)
        (RzErr (quote no_l_meaning)
          (append (show_name id)
            ": a fn without a definition has no L meaning (RUNNABLE) — realize it, or make it a def")))
       (nil
         (match (prim_find n)
           ((some _)
            (RzErr (quote no_l_identity)
              (append m ": an E primitive with no L identity — cite the L constant")))
           (none (RzErr (quote unknown_constant) m))))))))
(fn bind_tele ((e El) (binds (List TBind)) (bs (List SExpr))) El
  (measure (struct binds))
  (match binds
    (nil e)
    ((cons (TBind _ BErased _) r) (bind_tele e r bs))
    ((cons (TBind _ _ fv) r)
     (match bs
       ((cons (SList (cons (SSym x) _)) br)
        (bind_tele
          (match (name_of_sym x)
            ((some n) (el_set_cx e (cx_bind (el_cx e) n fv)))
            (none e))
          r
          br))
       (_ e)))))
;; the realized constant as a function head of the E table, when pre-registration could not resolve it
(fn ensure_head ((es ESt) (sc Scope) (k Name) (arity Int)) ESt
  (match (es_info es k)
    ((some _) es)
    (none (es_register es k (sc_tag sc) (EIFn arity)))))

;; ---- the equations ----------------------------------------------
(type Either3 (Left3 Symbol (List Int)) (Right3 (List Declaration)))
;; Eq.refl, or the clause's theorem applied to the binders — at the constant's solved levels
;; when it has as many universe parameters, at none when it has none
(fn proof_of ((t Tr) (kept (List Expr)) (rl Expr) (lhs Expr) (thm (Option Name)) (ls (List Level)))
  (Prod Tr (Option Expr))
  (match thm
    (none
      (match (tr_apps t (mk_const (nm_eq_refl) (list (level_one))) (list rl lhs))
        ((Prod.mk t1 e) (Prod.mk t1 (some e)))))
    ((some th)
     (let
       ((arity
          (match (env_find (tr_env t) th)
            ((some info) (len (ci_lparams info)))
            (none 0))))
       (if (= arity 0)
         (match (tr_apps t (mk_const th nil) kept)
           ((Prod.mk t1 e) (Prod.mk t1 (some e))))
       (if (= arity (len ls))
         (match (tr_apps t (mk_const th ls) kept)
           ((Prod.mk t1 e) (Prod.mk t1 (some e))))
         (Prod.mk t none)))))))
;; the leaves of the body's leading matchers, read off the rows without reduction: a row
;; against the scrutinee term binds, clashes, or is stuck on a local — a universally quantified
;; one is split over its constructors, in order, the first row that does not clash deciding —
;; so the leaves and their numbering are the case tree's, a fall-through row one equation per
;; leaf it reaches. `∀ kept, f lhs = rhs`, the self-local the constant, by Eq.refl
(type PjLeaf (PjLeaf (List Expr) (List Expr) Expr Expr))  ; the left-hand side's arguments, the binders, the result type, the body
(type PjFo (FoBind (List (Prod Int Expr))) (FoClash) (FoStuck Int))
;; `wfv`: a measured definition's value, `λ binders. WellFounded.fix α C r hwf F (tuple data)` —
;; then every leaf is an equation and its proof is Lean's `WellFounded.fix_eq` at the
;; instance (K decides `F t (λ y _. fix y)` against the leaf's body by conversion)
(fn pj_equations
  ((t Tr)
   (head Expr)
   (selfid Int)
   (binders (List Expr))
   (rl Expr)
   (body Expr)
   (thms (List Name))
   (dm Bool)
   (wfv (Option Expr)))
  (Prod Tr Either3)
  (match (pj_leaves t binders binders rl body 256 nil)
    ((Prod.mk t1 none) (Prod.mk t1 (Left3 (quote equation_form) "a constructor no row covers")))
    ((Prod.mk t1 (some lvs))
     (if (bool_and (< 0 (len thms)) (bool_not (= (len thms) (len lvs))))
       (Prod.mk t1
         (Left3 (quote equations_count)
           (append "the body has "
             (append (show_nat (len lvs))
               (append " equations, the clause names " (show_nat (len thms)))))))
       (pj_equation_decls t1 head selfid (rev lvs) thms dm wfv 1 nil)))))
(fn pj_leaves
  ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (fuel Int) (acc (List PjLeaf)))
  (Prod Tr (Option (List PjLeaf)))
  (measure fuel)
  (if (< fuel 1) (Prod.mk t none)
  (match (get_app_fn body)
    ((Const _ c _)
     (match (mt_is_matcher (tr_env t) c)
       ((some (MtDesc np 1 rows))
        ;; a matcher that carries its equation (a measured function's, define.shard's pj_match_eq)
        ;; has one argument more, `Eq.refl s`: the alternative's last binder at a leaf. Past
        ;; the alternatives stand that Eq.refl and a dependent match's generalized locals
        (let ((args (get_app_args body)) (n0 (+ np (+ 2 (len rows)))))
          (if (< (len args) n0) (Prod.mk t (some (cons (PjLeaf lhs kept rl body) acc)))
          (match (nth args (+ np 1))
            (none (Prod.mk t none))
            ((some s)
             (pj_rows t lhs kept rl body s rows (drop (+ np 2) args) (drop n0 args) fuel acc))))))
       (_ (Prod.mk t (some (cons (PjLeaf lhs kept rl body) acc))))))
    (_ (Prod.mk t (some (cons (PjLeaf lhs kept rl body) acc)))))))
(fn pj_rows
  ((t Tr)
   (lhs (List Expr))
   (kept (List Expr))
   (rl Expr)
   (body Expr)
   (s Expr)
   (rows (List (List MtPat)))
   (alts (List Expr))
   (extra (List Expr))
   (fuel Int)
   (acc (List PjLeaf)))
  (Prod Tr (Option (List PjLeaf)))
  (measure (struct rows))
  (match rows
    (nil (Prod.mk t none))
    ((cons row rr)
     (match alts
       (nil (Prod.mk t none))
       ((cons alt ar)
        (match (pj_fo_all (tr_env t) row (list s) (FoBind nil))
          (FoClash (pj_rows t lhs kept rl body s rr ar extra fuel acc))
          ((FoBind binds)
           (match (pj_inst_lams t alt (append (pj_slot_args binds (len binds) 0) extra))
             ((Prod.mk t1 b1) (pj_leaves t1 lhs kept rl b1 (- fuel 1) acc))))
          ((FoStuck vid)
           (if (bool_not (mem_int vid (fvar_ids kept)))
             (Prod.mk t (some (cons (PjLeaf lhs kept rl body) acc)))
             (pj_split t lhs kept rl body vid fuel acc)))))))))
(fn pj_slot_args ((binds (List (Prod Int Expr))) (n Int) (i Int)) (List Expr)
  (measure (- n i))
  (if (<= n i) nil
  (cons
    (match (assoc_int_expr i binds)
      ((some v) v)
      (none (mk_const Anon nil)))
    (pj_slot_args binds n (+ i 1)))))
;; a row's patterns against terms: a clash anywhere decides (the row is gone from the
;; specialized matrix), else the first stuck local, else the bindings
(fn pj_fo_all ((env CheckedEnv) (ps (List MtPat)) (ts (List Expr)) (st PjFo)) PjFo
  (measure (struct ps))
  (match ps
    (nil st)
    ((cons p pr)
     (match ts
       (nil st)
       ((cons x xr)
        (match (pj_fo env p x st)
          (FoClash FoClash)
          (st1 (pj_fo_all env pr xr st1))))))))
(fn pj_fo ((env CheckedEnv) (p MtPat) (x Expr) (st PjFo)) PjFo
  (measure (struct p))
  (match p
    ((MtVar slot)
     (match st
       ((FoBind binds) (FoBind (cons (Prod.mk slot x) binds)))
       (other other)))
    ((MtCtor c subs)
     (match (get_app_fn x)
       ((FVar _ id)
        (match st
          ((FoBind _) (FoStuck id))
          (other other)))
       ((Const _ c2 _)
        (if (name_eq c c2)
          (pj_fo_all env subs (drop (- (len (get_app_args x)) (len subs)) (get_app_args x)) st)
        (if (pj_is_ctor env c2) FoClash
        (match st
          ((FoBind _) (FoStuck -1))
          (other other)))))
       (_
         (match st
           ((FoBind _) (FoStuck -1))
           (other other)))))))
(fn pj_is_ctor ((env CheckedEnv) (c Name)) Bool
  (match (env_find env c)
    ((some (CtorInfo _ _ _ _ _ _)) true)
    (_ false)))
;; the local split over its inductive's constructors: the constructor term for it in the
;; left-hand side, the result type and the body, its fields new binders
(fn pj_split
  ((t Tr)
   (lhs (List Expr))
   (kept (List Expr))
   (rl Expr)
   (body Expr)
   (vid Int)
   (fuel Int)
   (acc (List PjLeaf)))
  (Prod Tr (Option (List PjLeaf)))
  (match (w_local_type (Tr.w t) vid)
    (none (Prod.mk t none))
    ((some vty)
     (match (mt_ind_of (Tr.w t) vty)
       ((Prod.mk _ (MtNoInd _ _)) (Prod.mk t (some (cons (PjLeaf lhs kept rl body) acc))))
       ((Prod.mk w1 (MtInd _ ls largs ctors))
        (pj_split_ctors (tr_set_w t w1) lhs kept rl body vid ctors ls largs fuel acc))))))
(fn pj_split_ctors
  ((t Tr)
   (lhs (List Expr))
   (kept (List Expr))
   (rl Expr)
   (body Expr)
   (vid Int)
   (ctors (List Name))
   (ls (List Level))
   (largs (List Expr))
   (fuel Int)
   (acc (List PjLeaf)))
  (Prod Tr (Option (List PjLeaf)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some acc)))
    ((cons c r)
     (match (rz_open_ctor t c ls largs)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fields cterm)))
        (match (subst_all t1 lhs vid cterm nil)
          ((Prod.mk t2 lhs1)
           (match (tr_subst t2 rl vid cterm)
             ((Prod.mk t3 rl1)
              (match (tr_subst t3 body vid cterm)
                ((Prod.mk t4 body1)
                 (match (refresh_kept t4 (without_id kept vid) vid cterm nil nil)
                   ((Prod.mk t5 (Prod.mk kept0 pairs))
                    (match (pj_subst_pairs_all t5 lhs1 pairs nil)
                      ((Prod.mk t6 lhs2)
                       (match (subst_pairs t6 rl1 pairs)
                         ((Prod.mk t7 rl2)
                          (match (subst_pairs t7 body1 pairs)
                            ((Prod.mk t8 body2)
                             (match
                               (pj_leaves t8 lhs2 (leaf_binders kept0 pairs (field_fvars fields))
                                 rl2
                                 body2
                                 (- fuel 1)
                                 acc)
                               ((Prod.mk t9 none) (Prod.mk t9 none))
                               ((Prod.mk t9 (some acc1))
                                (pj_split_ctors t9 lhs kept rl body vid r ls largs fuel acc1))))))))))))))))))))))
;; the leaf's binders after a split: the kept binders the split left as they were, the
;; constructor's fields, then the kept binders re-opened at a type mentioning the fields
;; (`i : Fin (List.length xs)` under `match xs`) — each after what its type names
(fn leaf_binders ((kept (List Expr)) (pairs (List (Prod Int Expr))) (fields (List Expr)))
  (List Expr)
  (append (kept_unrefreshed kept pairs) (append fields (kept_refreshed kept pairs))))
(fn kept_refreshed ((kept (List Expr)) (pairs (List (Prod Int Expr)))) (List Expr)
  (measure (struct kept))
  (match kept
    (nil nil)
    ((cons fv r)
     (if (is_refreshed fv pairs) (cons fv (kept_refreshed r pairs)) (kept_refreshed r pairs)))))
(fn kept_unrefreshed ((kept (List Expr)) (pairs (List (Prod Int Expr)))) (List Expr)
  (measure (struct kept))
  (match kept
    (nil nil)
    ((cons fv r)
     (if (is_refreshed fv pairs) (kept_unrefreshed r pairs) (cons fv (kept_unrefreshed r pairs))))))
(fn is_refreshed ((fv Expr) (pairs (List (Prod Int Expr)))) Bool
  (measure (struct pairs))
  (match pairs
    (nil false)
    ((cons (Prod.mk _ v) r) (if (= (fvar_id_of v) (fvar_id_of fv)) true (is_refreshed fv r)))))
(fn pj_subst_pairs_all ((t Tr) (es (List Expr)) (pairs (List (Prod Int Expr))) (acc (List Expr)))
  (Prod Tr (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk t (rev acc)))
    ((cons e r)
     (match (subst_pairs t e pairs)
       ((Prod.mk t1 e1) (pj_subst_pairs_all t1 r pairs (cons e1 acc)))))))
;; a fn's leaf is stated where K decides it by conversion — the definition is in the walk's
;; environment (define.shard). A structural recursion whose leaf leaves the structural
;; argument a local, or keeps a self-call under a matcher that is still stuck, unfolds only by
;; a case analysis: that equation is I's, and the leaf keeps its number. A realization's
;; equations are all stated (its clause may prove them; a wrong one is K's refusal)
(fn pj_decided ((t Tr) (dm Bool) (lhs Expr) (rhs Expr)) (Prod Tr Bool)
  (if (bool_not dm) (Prod.mk t true)
  (match (w_is_def_eq_r (Tr.w t) lhs rhs)
    ((Prod.mk w1 (WVal true)) (Prod.mk (tr_set_w t w1) true))
    ((Prod.mk w1 _) (Prod.mk (tr_set_w t w1) false)))))
;; a leaf's theorem: the self-local (a fn's) the constant; Eq.refl, or the equations clause's
;; theorem applied to the binders (a realize's); a fn's equation under its identity (dm), a
;; realization's under the realizing module (eq_name)
(fn pj_equation_decls
  ((t Tr)
   (head Expr)
   (selfid Int)
   (lvs (List PjLeaf))
   (thms (List Name))
   (dm Bool)
   (wfv (Option Expr))
   (i Int)
   (acc (List Declaration)))
  (Prod Tr Either3)
  (measure (struct lvs))
  (match lvs
    (nil (Prod.mk t (Right3 (rev acc))))
    ((cons (PjLeaf lhs kept rl body) r)
     (match (tr_subst t body selfid head)
       ((Prod.mk t1 rhs)
        (match (tr_apps t1 head lhs)
          ((Prod.mk t2a lhs1)
           (match
             (match wfv
               ((some _) (Prod.mk t2a true))
               (none (pj_decided t2a dm lhs1 rhs)))
             ((Prod.mk t2 false) (pj_equation_decls t2 head selfid r thms dm wfv (+ i 1) acc))
             ((Prod.mk t2 true)
              (match (tr_apps t2 (mk_const (nm_eq) (list (level_one))) (list rl lhs1 rhs))
                ((Prod.mk t3 stmt)
                 (match (tr_pis t3 kept stmt)
                   ((Prod.mk t4 ty)
                    (match
                      (match wfv
                        ((some v) (fix_eq_proof t4 v lhs))
                        (none
                          (proof_of t4 kept rl lhs1 (nth thms (- i 1))
                            (match head
                              ((Const _ _ ls) ls)
                              (_ nil)))))
                      ((Prod.mk t5 none)
                       (Prod.mk t5
                         (Left3 (quote universe_arity)
                           "a theorem of the equations clause takes neither no universe arguments nor the constant's")))
                      ((Prod.mk t5 (some proof))
                       (match (tr_lams t5 kept proof)
                         ((Prod.mk t6 value)
                          (let
                            ((name
                               (if dm (name_append (Tr.id t6) (nm_eq_n i))
                               (eq_name (Tr.sc t6) (Tr.id t6) i))))
                            (pj_equation_decls t6 head selfid r thms dm wfv (+ i 1)
                              (cons (ThmDecl (ConstantVal name nil ty) value (list name)) acc))))))))))))))))))))
;; the measured definition's value at the leaf's arguments is `WellFounded.fix α C r hwf F t`;
;; `WellFounded.fix_eq α C r hwf F t : fix … t = F t (λ y _. fix … y)` is the equation's proof,
;; its two sides K-convertible to the leaf's (the left by delta, the right by beta, the tuple's
;; projections and the matcher at a constructor, each self-call `f args` delta to `fix … (tuple args)`).
;; A member of a group (define.shard) is its group's fixpoint at the member's tagged
;; tuple, `g.mutual x`, and the proof is the fixpoint's unfolding theorem there, `g.mutual.eq x`
(fn fix_eq_proof ((t Tr) (v Expr) (lhs (List Expr))) (Prod Tr (Option Expr))
  (match (beta_head (w_st (Tr.w t)) v lhs)
    ((Prod.mk st1 inst)
     (let ((t1 (tr_set_w t (w_set_st (Tr.w t) st1))))
       (match (get_app_fn inst)
         ((Const _ n ls)
          (if (name_eq n (n2 (quote WellFounded) (quote fix)))
            (Prod.mk t1
              (some
                (mk_app_n (mk_const (n2 (quote WellFounded) (quote fix_eq)) ls) (get_app_args inst))))
          (if (group_fixpoint n)
            (match (get_app_args inst)
              ((cons x nil)
               (Prod.mk t1 (some (mk_app (mk_const (name_append n (n1 (quote eq))) nil) x))))
              (_ (Prod.mk t1 none)))
            (Prod.mk t1 none))))
         (_ (Prod.mk t1 none)))))))
;; a group's fixpoint by its name, `FIRST.mutual` (define.shard grp_fix)
(fn group_fixpoint ((n Name)) Bool
  (match n
    ((Str _ c) (sym_eq c (quote mutual)))
    (_ false)))

;; ---- the derived view --------------------------------------------------------------
(fn realize_view ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) RzRes
  (match s
    ((SList (cons _ (cons (SSym x) _)))
     (match (name_of_sym x)
       (none (RzErr (quote bad_name) (chars_of_sym x)))
       ((some n)
        (match (realize_target sc env n)
          ((RtErr e m) (RzErr e m))
          ((RtOk k info) (view_of es sc env k info))))))
    (_ (RzErr (quote bad_shape) "(realize NAME (view))"))))
;; the program of the definition k: its value erased under its binders' roles
(fn view_of ((es ESt) (sc Scope) (env CheckedEnv) (k Name) (info ConstantInfo)) RzRes
  (match (tele_of (w0 env) es sc info)
    ((TeleErr e m) (RzErr e m))
    ((TeleOk w1 es1 (Tele ls binds rt _))
     (if (has_static binds)
       (RzErr (quote realize_signature)
         (append (show_name k)
           ": a function-typed binder — a realize template is supplied, never a view: write (realize NAME BINDERS RET BODY)"))
       (match (ci_value info)
         (none (RzErr (quote realize_kind) (append (show_name k) " has no value")))
         ((some v0)
          (match (w_inst_lparams w1 v0 (ci_lparams info) ls)
            ((Prod.mk w2 v)
             (let ((t (tr_new w2 es1 sc k (tbind_types binds))))
               (match (peel_binders t v binds)
                 ((Prod.mk t1 body)
                  (match (erase t1 (binder_ents binds) body (budget_depth))
                    ((ErErr e m) (RzErr e m))
                    ((ErOk t2 ebody)
                     (if (takes_instances t2)
                       (RzErr (quote function_value)
                         (append (show_name k)
                           ": a derived view lifting a lambda or taking an instance — supply the body"))
                       (let ((ptypes (bind_ptypes binds)))
                         (match (classify_both (Tr.es t2) k (some_all (rev ptypes)) ebody RecNone)
                           ((some (Prod.mk e m)) (RzErr e m))
                           (none
                             (RzOk (Tr.es t2) (EFn k (count_types binds) ptypes rt RecNone ebody)
                               nil
                               nil
                               false
                               nil
                               nil))))))))))))))))))
;; the value's leading lambdas instantiated with the binders' locals; fewer lambdas than binders: applied to the rest
(fn peel_binders ((t Tr) (v Expr) (binds (List TBind))) (Prod Tr Expr)
  (measure (struct binds))
  (match binds
    (nil (Prod.mk t v))
    ((cons (TBind _ _ fv) r)
     (match v
       ((Lam _ _ _ _ body)
        (match (tr_inst1 t body fv)
          ((Prod.mk t1 body1) (peel_binders t1 body1 r))))
       (_
         (match (tr_apps t v (list fv))
           ((Prod.mk t1 v1) (peel_binders t1 v1 r))))))))
