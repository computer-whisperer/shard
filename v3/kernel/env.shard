;;; v3/kernel/env.shard — environments, raw versus checked, and outcomes.
;;;
;;; FOUNDATION §3.3, §3.5. Reconciled against src/kernel/environment.cpp
;;; (v4.33.1). Phase 1 replaces the association list by a map keyed on
;;; Name; the interface stays.

(import "decl.shard")

;; A RAW environment: whatever a client or the import built. Nothing is
;; assumed about it; `check` validates the dependent context in order
;; (§3.5) and produces a CheckedEnv, which is a different type — never
;; forgeable from a similarly shaped record or a deserialized receipt.
(type RawEnv (RawEnv (List (Pair Name ConstantInfo)) Bool))   ; entries, quotInitialized (pins are never raw)

(type CheckedEnv (CheckedEnv (List (Pair Name ConstantInfo)) Bool (List Name)))   ; entries, quotInitialized, pinned identities (§3.2)
;; Invariant (K-internal, established only by admission): every entry
;; passed `check` against the entries before it; names are unique;
;; quotInitialized is set only by QuotDecl admission.

(type Resource
  (RHeartbeats)     ; max_heartbeat — the checker's step budget
  (RRecDepth)       ; max_rec_depth — nesting of is_def_eq / whnf
  (RNatSize)        ; LEAN_NAT_MAX_SIZE — a numeral too large
  (RNatCount)       ; a Nat.pow / shiftLeft count beyond 32 bits
  (RDecode)         ; import decoding limits (§9.4)
  (RAlloc))         ; allocation / term depth limits (§9.4)

(type Reason
  (Malformed Symbol)               ; not a well-formed input: loose bvar, fvar/mvar, bad index, unknown name in a shape
  (RuleViolation Symbol)           ; a rule refused it: the kernel_exception message class
  (Unsupported Symbol)             ; outside the standard profile: unsafe/partial, native reduction, mutual unsafe
  (UnresolvedObligation Symbol)    ; the procedure could not establish a side condition it needed
  (ConversionNotEstablished))      ; is_def_eq returned false — NOT inequality (§3.3)

(type Outcome
  (Accepted CheckedEnv)            ; the receipt is the extended checked environment
  (Rejected Reason Name)           ; reason, the subject declaration
  (Exhausted Resource Symbol))     ; resource, site

;; RULES (§3.3): Exhausted is never acceptance and never rejection;
;; Malformed and RuleViolation are definitive for the submitted input;
;; the other three say only that this procedure did not establish the
;; judgment. Every negative names its subject. Exhaustion never mutates
;; committed state and is never cached (§9.4).
;;
;; MAPPING of the pin's throws (validated by T0's hostile battery):
;;   kernel_exception "already declared" / "duplicate …" / "incorrect
;;     number of universe levels" / "undefined universe" / "function
;;     expected" / "application type mismatch" / "definition type
;;     mismatch" / "theorem type is not Prop" / "invalid projection" /
;;     every inductive.cpp message in decl.shard         → RuleViolation
;;   "does not support meta variables" / free variables / loose bvars /
;;     auxiliary-name reference / malformed export shapes → Malformed
;;   unsafe/partial declarations, mutual unsafe blocks,
;;     Lean.reduceBool/reduceNat sites                     → Unsupported
;;   heartbeat / recursion depth / nat size / count limits → Exhausted
;;   is_def_eq false at an admission site                  → ConversionNotEstablished
;;     (reported as the Rejected reason of a definition/theorem whose
;;     value type did not match — definitive for THIS procedure and
;;     budget, revisitable under another; §3.3)
;;
;; FIXED-IDENTITY ACCELERATORS (§3.2): the Nat operations of
;; expr.shard's reduce_nat are bound at admission of `Nat.add` etc. to
;; the admitted declaration's identity (name AND checked signature AND
;; defining equations validated against the export); a same-spelled
;; non-core `Nat.add` (T0's battery) never reaches the shortcut.
