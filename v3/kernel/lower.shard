;;; v3/kernel/lower.shard — a program lowered to the restricted form RS: the first of the
;;; back end's two stages. Every body is rewritten to a shape the generator (cgen.shard)
;;; transcribes without a decision of its own.
;;; The input is the program the load yielded — a Prog, every name an identity, every head
;;; classified, every variable an index —, so there is no text to print and read back and
;;; no second reader, loader or resolver between a loaded program and its binary.
;;;
;;; RS IS A PROG. `lw_prog : Prog → Prog` (or the refusals), and in the result
;;;
;;;   atom ::= EBVar | ELit of a numeral
;;;   rhs  ::= atom | ECtor/ECall/EPrim/EExt over atoms | EAbsurd
;;;   body ::= rhs | ELet (rhs) body | EIf atom body body | EMatch atom arm…
;;;   arm  ::= a constructor over variables | a numeral | a variable
;;;
;;; a match with no arm being the sink (stuck under `ev`, a trap in the binary). Being a
;;; Prog, RS runs under `ev`: the lowering is tested against the program it came from
;;; without the generator (`load.shard --lowered --run`; test/lower_test.sh).
;;;
;;; THE PASSES, per function. (A) the body to a named form — a variable a number, the
;;; parameters 0…n-1 —, with the primitives' rows applied (below) and a string literal spelled
;;; as its cells. (JP) an `if` or a `match` in an operand's position is lifted whole to a
;;; function over its free variables, a call being a legal operand; a nested pattern is
;;; compiled per arm into a chain of flat matches, the fall-through continuation lifted once
;;; per arm so nothing is duplicated. (ANF) every operand an atom, the bindings pushed
;;; outward in evaluation order. Then back to the locally nameless form. A lifted function's
;;; identity is its owner's with a numeric component (`f.7`), which no source name has; its
;;; parameters and result carry the opaque type `JV` — RS is a run artifact.
;;;
;;; THE PRIMITIVES' ROWS. The eighteen bare-named primitives stay as they are.
;;; Of those under Init's names, seven stay too — `Nat.land lor xor shiftLeft
;;; shiftRight beq ble` —, the runtime's operation agreeing with them on the values E reaches
;;; (cgen.shard names it); they are not renamed to the bare ones, because under `ev` the two
;;; differ in what an erased program writes around them (`=` is a test an `if` reads) and RS
;;; must run as the program did. Seven become an expression over both operands bound once,
;;; where the runtime's operation differs: `Nat.sub` truncating at zero; `Nat.div`,
;;; `Int.tdiv`, `Int.ediv` zero at a zero divisor; `Nat.mod`, `Int.emod`, `Int.tmod` the
;;; dividend there — the same value under `ev`, whose own
;;; operations these are. A primitive with no row is refused, never approximated.
;;;
;;; THE WIRE ROLES (`lw_role`). The runtime builds and reads eight cells by tag — true,
;;; false, nil, cons, none, some, pair and the World's (rt.h's decisions and extern shims) —,
;;; so the constructors that are those cells carry a role: the constructors of Init's `Bool`,
;;; `List`, `Option` and `Prod`, by identity, `Decidable`'s two as `Bool`'s, and the
;;; constructor named `World` of the type a program declares for its World. The generator
;;; gives a role its fixed tag and every other constructor a tag of its own.
;;;
;;; REFUSED, each a line naming the function: a `sig fn` or `sig type` left unlinked; a
;;; primitive with no row; a string pattern. Every refusal of a program is reported.

(import "prog.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.descent)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.Prim)
(use kernel.prog.Prog)

;; ---- the wire roles: 0 none; 1 true, 2 false, 3 nil, 4 cons, 5 none, 6 some, 7 pair, 8 the World
(fn lw_role ((n Name)) Int
  (match n
    ((Str _ s) (if (int_list_eq (chars_of_sym s) (utf8 "World")) 8 (lw_role_init (show_name n))))
    (_ 0)))
(fn lw_role_init ((s (List Int))) Int
  (if (bool_or (int_list_eq s (utf8 "Bool.true")) (int_list_eq s (utf8 "Decidable.isTrue"))) 1
  (if (bool_or (int_list_eq s (utf8 "Bool.false")) (int_list_eq s (utf8 "Decidable.isFalse"))) 2
  (if (int_list_eq s (utf8 "List.nil")) 3
  (if (int_list_eq s (utf8 "List.cons")) 4
  (if (int_list_eq s (utf8 "Option.none")) 5
  (if (int_list_eq s (utf8 "Option.some")) 6
  (if (int_list_eq s (utf8 "Prod.mk")) 7
  0))))))))

;; ---- the named form ------------------------------------------------------------------------
(type LwE
  (LwVar Int)
  (LwInt Int)
  (LwCtor Name (List LwE))
  (LwCall Name (List LwE))
  (LwPrim Name (List LwE))
  (LwExt Name (List LwE))
  (LwIf LwE LwE LwE)
  (LwMatch LwE (List LwArm))
  (LwLet Int LwE LwE)
  (LwAbsurd))
(type LwArm (LwArm LwP LwE))
(type LwP (LwPVar Int) (LwPInt Int) (LwPCtor Name (List LwP)))
;; the size of a named term — `LwE.size`, and with it `LwArm.size`, `List_LwE.size` and
;; `List_LwArm.size` —, and of a pattern — `LwP.size`, `List_LwP.size` —, what the functions
;; that walk them are measured by; definitions with no program
(derive LwE size)
(derive LwP size)

;; an application's operands, and the same head over other operands
(fn lw_args ((e LwE)) (Option (List LwE))
  (match e
    ((LwCtor _ as) (some as))
    ((LwCall _ as) (some as))
    ((LwPrim _ as) (some as))
    ((LwExt _ as) (some as))
    (_ none)))
(fn lw_rehead ((e LwE) (as (List LwE))) LwE
  (match e
    ((LwCtor c _) (LwCtor c as))
    ((LwCall f _) (LwCall f as))
    ((LwPrim p _) (LwPrim p as))
    ((LwExt x _) (LwExt x as))
    (_ e)))
(fn lw_vars ((vs (List Int))) (List LwE)
  (measure (struct vs))
  (match vs
    (nil nil)
    ((cons v r) (cons (LwVar v) (lw_vars r)))))

;; ---- pass A: indices to numbers; env is innermost first, k the next unused number ----------
(type LwR (LwOk LwE Int) (LwErr (List Int)))
(type LwRs (LwsOk (List LwE) Int) (LwsErr (List Int)))
(type LwPR (LwPOk LwP (List Int) Int) (LwPErr (List Int)))  ; the pattern, its variables in binding order
(type LwPRs (LwPsOk (List LwP) (List Int) Int) (LwPsErr (List Int)))
(type LwAR (LwAOk (List LwArm) Int) (LwAErr (List Int)))

(fn lw_named ((t ETerm) (env (List Int)) (k Int)) LwR
  (measure (ETerm.size t))
  (match t
    ((EBVar i)
     (match (nth env i)
       ((some v) (LwOk (LwVar v) k))
       (none (LwErr (utf8 "a variable out of range")))))
    ((ELit l) (LwOk (lw_lit l) k))
    ((ECtor c as)
     (match (lw_named_all as env k)
       ((LwsErr m) (LwErr m))
       ((LwsOk rs k1) (LwOk (LwCtor c rs) k1))))
    ((ECall f as)
     (match (lw_named_all as env k)
       ((LwsErr m) (LwErr m))
       ((LwsOk rs k1) (LwOk (LwCall f rs) k1))))
    ((EPrim p as)
     (match (lw_named_all as env k)
       ((LwsErr m) (LwErr m))
       ((LwsOk rs k1) (lw_prim p rs k1))))
    ((EExt x as)
     (match (lw_named_all as env k)
       ((LwsErr m) (LwErr m))
       ((LwsOk rs k1) (LwOk (LwExt x rs) k1))))
    ((EMatch s arms)
     (match (lw_named s env k)
       ((LwErr m) (LwErr m))
       ((LwOk rs k1)
        (match (lw_named_arms arms env k1)
          ((LwAErr m) (LwErr m))
          ((LwAOk ras k2) (LwOk (LwMatch rs ras) k2))))))
    ((ELet rs body) (lw_named_let rs body env k))
    ((EIf c a b)
     (match (lw_named c env k)
       ((LwErr m) (LwErr m))
       ((LwOk rc k1)
        (match (lw_named a env k1)
          ((LwErr m) (LwErr m))
          ((LwOk ra k2)
           (match (lw_named b env k2)
             ((LwErr m) (LwErr m))
             ((LwOk rb k3) (LwOk (LwIf rc ra rb) k3))))))))
    ((ELam _ _ _)
     (LwErr (utf8 "internal: a lambda in a program — the classifier lifts each one")))
    (EAbsurd (LwOk LwAbsurd k))))
(fn lw_named_all ((ts (List ETerm)) (env (List Int)) (k Int)) LwRs
  (measure (List_ETerm.size ts))
  (match ts
    (nil (LwsOk nil k))
    ((cons t r)
     (match (lw_named t env k)
       ((LwErr m) (LwsErr m))
       ((LwOk e k1)
        (match (lw_named_all r env k1)
          ((LwsErr m) (LwsErr m))
          ((LwsOk es k2) (LwsOk (cons e es) k2))))))))
;; the sequential let: each right-hand side sees the bindings before it
(fn lw_named_let ((rs (List ETerm)) (body ETerm) (env (List Int)) (k Int)) LwR
  (measure (+ (List_ETerm.size rs) (ETerm.size body)))
  (match rs
    (nil (lw_named body env k))
    ((cons r rest)
     (match (lw_named r env k)
       ((LwErr m) (LwErr m))
       ((LwOk rr k1)
        (match (lw_named_let rest body (cons k1 env) (+ k1 1))
          ((LwErr m) (LwErr m))
          ((LwOk inner k2) (LwOk (LwLet k1 rr inner) k2))))))))
(fn lw_named_arms ((arms (List EArm)) (env (List Int)) (k Int)) LwAR
  (measure (List_EArm.size arms))
  (match arms
    (nil (LwAOk nil k))
    ((cons (EArm p body) rest)
     (match (lw_pat p k)
       ((LwPErr m) (LwAErr m))
       ((LwPOk rp vs k1)
        (match (lw_named body (rev_onto vs env) k1)  ; the last variable bound is index 0
          ((LwErr m) (LwAErr m))
          ((LwOk rb k2)
           (match (lw_named_arms rest env k2)
             ((LwAErr m) (LwAErr m))
             ((LwAOk rr k3) (LwAOk (cons (LwArm rp rb) rr) k3))))))))))
(fn lw_pat ((p EPat) (k Int)) LwPR
  (measure (EPat.size p))
  (match p
    (PVar (LwPOk (LwPVar k) (list k) (+ k 1)))
    ((PLit (LNat n)) (LwPOk (LwPInt n) nil k))
    ((PLit (LInt n)) (LwPOk (LwPInt n) nil k))
    ((PLit (LStr _))
     (LwPErr (utf8 "a string pattern has no arm in a native binary (match its cons and nil cells)")))
    ((PCtor c subs)
     (match (lw_pats subs k)
       ((LwPsErr m) (LwPErr m))
       ((LwPsOk rps vs k1) (LwPOk (LwPCtor c rps) vs k1))))))
(fn lw_pats ((ps (List EPat)) (k Int)) LwPRs
  (measure (List_EPat.size ps))
  (match ps
    (nil (LwPsOk nil nil k))
    ((cons p r)
     (match (lw_pat p k)
       ((LwPErr m) (LwPsErr m))
       ((LwPOk rp vs1 k1)
        (match (lw_pats r k1)
          ((LwPsErr m) (LwPsErr m))
          ((LwPsOk rps vs2 k2) (LwPsOk (cons rp rps) (append vs1 vs2) k2))))))))
(fulfills lw_pat.dec_1 (by (intro p k c subs h) (rw h) (rw EPat.size.eq_2) (arith)))
(fulfills lw_pats.dec_1 (by (intro ps k p r h) (rw h) (rw List_EPat.size.eq_2) (arith)))
(fulfills lw_pats.dec_2 (by (intro ps k p r h rp vs1 k1) (rw h) (rw List_EPat.size.eq_2) (arith)))
;; a literal; a string as its cells, Init's List's
(fn lw_lit ((l ELit)) LwE
  (match l
    ((LNat n) (LwInt n))
    ((LInt n) (LwInt n))
    ((LStr bs) (lw_str bs))))
(fn lw_str ((bs (List Int))) LwE
  (measure (struct bs))
  (match bs
    (nil (LwCtor (cell_nil) nil))
    ((cons b r) (LwCtor (cell_cons) (list (LwInt b) (lw_str r))))))

;; ---- the primitives' rows ----------------------------------------------------------------
(fn lw_pn ((s Symbol)) Name (n1 s))
;; a primitive under Init's name the runtime's operation agrees with — Nat.land (23), lor (24), xor
;; (25), shiftLeft (26), shiftRight (27), beq (34), ble (35): kept under its own identity
(fn lw_prim_kept ((code Int)) Bool
  (bool_or (bool_and (<= 23 code) (<= code 27)) (bool_or (= code 34) (= code 35))))
;; the ones that differ: Nat.sub (22), Nat.div (30), Nat.mod (31), Int.tdiv (18), Int.tmod (19),
;; Int.ediv (20), Int.emod (21)
(fn lw_prim_expr ((code Int)) Bool
  (bool_or (= code 22)
    (bool_or (= code 30) (bool_or (= code 31) (bool_and (<= 18 code) (<= code 21))))))
(fn lw_prim ((p Name) (rs (List LwE)) (k Int)) LwR
  (match (prim_find p)
    (none
      (LwErr (append (utf8 "the primitive ") (append (show_name p) (utf8 " is not in the table")))))
    ((some (Prim code _))
     (if (bool_or (< code 18) (lw_prim_kept code)) (LwOk (LwPrim p rs) k)
     (if (lw_prim_expr code)
       (match rs
         ((cons a (cons b nil))
          (LwOk (LwLet k a (LwLet (+ k 1) b (lw_row code (LwVar k) (LwVar (+ k 1))))) (+ k 2)))
         (_
           (LwErr
             (append (utf8 "the primitive ")
               (append (show_name p) (utf8 " is not applied to two operands"))))))
       (LwErr
         (append (utf8 "the primitive ")
           (append (show_name p)
             (utf8
               " has no operation in a native binary (those that have one: the eighteen bare-named primitives; Nat.sub div mod land lor xor shiftLeft shiftRight beq ble; Int.tdiv tmod ediv emod)")))))))))
;; both operands bound once, then Init's result where the runtime's operation differs
(fn lw_row ((code Int) (a LwE) (b LwE)) LwE
  (if (= code 22)
    (LwIf (LwPrim (lw_pn (sym "<")) (list a b)) (LwInt 0) (LwPrim (lw_pn (sym "-")) (list a b)))
  (if (bool_or (= code 30) (= code 18)) (lw_at_zero (sym "/") a b (LwInt 0))
  (if (= code 20) (lw_at_zero (sym "ediv") a b (LwInt 0))
  (if (bool_or (= code 31) (= code 21)) (lw_at_zero (sym "mod") a b a)
  (lw_at_zero (sym "tmod") a b a))))))
;; (if (= B 0) AT_ZERO (OP A B))
(fn lw_at_zero ((op Symbol) (a LwE) (b LwE) (z LwE)) LwE
  (LwIf (LwPrim (lw_pn (sym "=")) (list b (LwInt 0))) z (LwPrim (lw_pn op) (list a b))))
;; the descent of lw_named and its members, here where the last function they call is declared
(fulfills lw_named.dec_1 (by (intro t env k c as h) (rw h) (rw ETerm.size.eq_3) (arith)))
(fulfills lw_named.dec_2 (by (intro t env k f as h) (rw h) (rw ETerm.size.eq_4) (arith)))
(fulfills lw_named.dec_3 (by (intro t env k p as h) (rw h) (rw ETerm.size.eq_5) (arith)))
(fulfills lw_named.dec_4 (by (intro t env k x as h) (rw h) (rw ETerm.size.eq_6) (arith)))
(fulfills lw_named.dec_5 (by (intro t env k s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills lw_named.dec_6 (by (intro t env k s arms h rs k1) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills lw_named.dec_7 (by (intro t env k rs body h) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills lw_named.dec_8 (by (intro t env k c a b h) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills lw_named.dec_9 (by (intro t env k c a b h rc k1) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills lw_named.dec_10
  (by (intro t env k c a b h rc k1 ra k2) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills lw_named_all.dec_1 (by (intro ts env k t r h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills lw_named_all.dec_2
  (by (intro ts env k t r h e k1) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills lw_named_let.dec_1 (by (intro rs body env k h) (rw h) (rw List_ETerm.size.eq_1) (arith)))
(fulfills lw_named_let.dec_2
  (by (intro rs body env k r rest h) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills lw_named_let.dec_3
  (by (intro rs body env k r rest h rr k1) (rw h) (rw List_ETerm.size.eq_2) (arith)))
(fulfills lw_named_arms.dec_1
  (by
    (intro arms env k p body rest h rp vs k1 h1)
    (rw h)
    (rw List_EArm.size.eq_2)
    (rw EArm.size.eq_1)
    (arith)))
(fulfills lw_named_arms.dec_2
  (by (intro arms env k p body rest h rp vs k1 h1 rb k2) (rw h) (rw List_EArm.size.eq_2) (arith)))

;; ---- pass JP: join-point lifting and nested-pattern compilation ------------------------------
(type LwLifted (LwLifted Name (List Int) LwE))  ; identity, parameters, a body in tail form
(type LwJ (LwJ LwE (List LwLifted) Int))
(type LwJs (LwJs (List LwE) (List LwLifted) Int))
(type LwJa (LwJa (List LwArm) (List LwLifted) Int))

;; free variables, first occurrence first
(fn lw_fv ((e LwE) (bound (List Int)) (acc (List Int))) (List Int)
  (measure (LwE.size e))
  (match e
    ((LwVar v)
     (if (mem_int v bound) acc
     (if (mem_int v acc) acc
     (append acc (list v)))))
    ((LwInt _) acc)
    (LwAbsurd acc)
    ((LwIf c t f) (lw_fv f bound (lw_fv t bound (lw_fv c bound acc))))
    ((LwMatch s arms) (lw_fv_arms arms bound (lw_fv s bound acc)))
    ((LwLet n r body) (lw_fv body (cons n bound) (lw_fv r bound acc)))
    (_
      (match (lw_args e)
        ((some as) (lw_fv_all as bound acc))
        (none acc)))))
(fn lw_fv_all ((es (List LwE)) (bound (List Int)) (acc (List Int))) (List Int)
  (measure (List_LwE.size es))
  (match es
    (nil acc)
    ((cons e r) (lw_fv_all r bound (lw_fv e bound acc)))))
(fn lw_fv_arms ((arms (List LwArm)) (bound (List Int)) (acc (List Int))) (List Int)
  (measure (List_LwArm.size arms))
  (match arms
    (nil acc)
    ((cons (LwArm p body) r) (lw_fv_arms r bound (lw_fv body (lw_pat_vars p bound) acc)))))
(fn lw_pat_vars ((p LwP) (acc (List Int))) (List Int)
  (measure (LwP.size p))
  (match p
    ((LwPVar v) (cons v acc))
    ((LwPCtor _ ps) (lw_pats_vars ps acc))
    (_ acc)))
(fn lw_pats_vars ((ps (List LwP)) (acc (List Int))) (List Int)
  (measure (List_LwP.size ps))
  (match ps
    (nil acc)
    ((cons p r) (lw_pats_vars r (lw_pat_vars p acc)))))
(fulfills lw_pat_vars.dec_1 (by (intro p acc c ps h) (rw h) (rw LwP.size.eq_3) (arith)))
(fulfills lw_pats_vars.dec_1 (by (intro ps acc p r h) (rw h) (rw List_LwP.size.eq_2) (arith)))
(fulfills lw_pats_vars.dec_2 (by (intro ps acc p r h) (rw h) (rw List_LwP.size.eq_2) (arith)))
;; the descent of lw_fv and its members, here where the last function they call is declared
(fulfills lw_fv.dec_1 (by (intro e b a c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_fv.dec_2 (by (intro e b a c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_fv.dec_3 (by (intro e b a c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_fv.dec_4 (by (intro e b a s arms h) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_fv.dec_5 (by (intro e b a s arms h) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_fv.dec_6 (by (intro e b a n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_fv.dec_7 (by (intro e b a n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_fv.dec_8
  (by
    (intro e b a w hw as h)
    (cases e
      ((LwVar (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwInt (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwCtor (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_3)
         (arith))
       (LwCall (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_4)
         (arith))
       (LwPrim (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_5)
         (arith))
       (LwExt (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2)) (rw LwE.size.eq_6)
         (arith))
       (LwIf (x y z) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwMatch (s arms) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwLet (n r y) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwAbsurd () (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))))))
(fulfills lw_fv_all.dec_1 (by (intro es b a e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_fv_all.dec_2 (by (intro es b a e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_fv_arms.dec_1
  (by (intro arms b a p body r h) (rw h) (rw List_LwArm.size.eq_2) (rw LwArm.size.eq_1) (arith)))
(fulfills lw_fv_arms.dec_2
  (by (intro arms b a p body r h) (rw h) (rw List_LwArm.size.eq_2) (arith)))

;; a tail-form expression lifted to a function over its free variables; what is left is the call
(fn lw_lift ((owner Name) (e LwE) (k Int)) LwJ
  (let ((fvs (lw_fv e nil nil)) (jn (Num owner k)))
    (LwJ (LwCall jn (lw_vars fvs)) (list (LwLifted jn fvs e)) (+ k 1))))

;; an operand's position: no `if`, no `match`
(fn lw_jp_named ((owner Name) (e LwE) (k Int)) LwJ
  (measure (+ (* 4 (LwE.size e)) 3))
  (match e
    ((LwIf _ _ _) (lw_jp_lifted owner e k))
    ((LwMatch _ _) (lw_jp_lifted owner e k))
    ((LwLet n r body)
     (match (lw_jp_named owner r k)
       ((LwJ rr ls1 k1)
        (match (lw_jp_named owner body k1)
          ((LwJ rb ls2 k2) (LwJ (LwLet n rr rb) (append ls1 ls2) k2))))))
    (_ (lw_jp_app owner e k))))
;; a term that is no `if`, `match` or `let`, in either position: an application over its
;; operands, each in an operand's position; a variable, a literal as it is
(fn lw_jp_app ((owner Name) (e LwE) (k Int)) LwJ
  (measure (* 4 (LwE.size e)))
  (match (lw_args e)
    ((some as)
     (match (lw_jp_all owner as k)
       ((LwJs rs ls k1) (LwJ (lw_rehead e rs) ls k1))))
    (none (LwJ e nil k))))
(fn lw_jp_lifted ((owner Name) (e LwE) (k Int)) LwJ
  (measure (+ (* 4 (LwE.size e)) 2))
  (match (lw_jp_tail owner e k)
    ((LwJ pe ls k1)
     (match (lw_lift owner pe k1)
       ((LwJ call ls2 k2) (LwJ call (append ls ls2) k2))))))
(fn lw_jp_all ((owner Name) (es (List LwE)) (k Int)) LwJs
  (measure (* 4 (List_LwE.size es)))
  (match es
    (nil (LwJs nil nil k))
    ((cons e r)
     (match (lw_jp_named owner e k)
       ((LwJ re ls1 k1)
        (match (lw_jp_all owner r k1)
          ((LwJs rs ls2 k2) (LwJs (cons re rs) (append ls1 ls2) k2))))))))
;; a tail position
(fn lw_jp_tail ((owner Name) (e LwE) (k Int)) LwJ
  (measure (+ (* 4 (LwE.size e)) 1))
  (match e
    ((LwIf c t f)
     (match (lw_jp_named owner c k)
       ((LwJ rc ls1 k1)
        (match (lw_jp_tail owner t k1)
          ((LwJ rt ls2 k2)
           (match (lw_jp_tail owner f k2)
             ((LwJ rf ls3 k3) (LwJ (LwIf rc rt rf) (append ls1 (append ls2 ls3)) k3))))))))
    ((LwMatch s arms)
     (match (lw_jp_named owner s k)
       ((LwJ rs ls1 k1)
        (match (lw_jp_arms owner arms k1)
          ((LwJa rarms ls2 k2)
           (if (lw_arms_flat rarms) (LwJ (LwMatch rs rarms) (append ls1 ls2) k2)
           (match (lw_scrut owner rs rarms k2)
             ((LwJ mce ls3 k3) (LwJ mce (append ls1 (append ls2 ls3)) k3)))))))))
    ((LwLet n r body)
     (match (lw_jp_named owner r k)
       ((LwJ rr ls1 k1)
        (match (lw_jp_tail owner body k1)
          ((LwJ rb ls2 k2) (LwJ (LwLet n rr rb) (append ls1 ls2) k2))))))
    (_ (lw_jp_app owner e k))))
(fn lw_jp_arms ((owner Name) (arms (List LwArm)) (k Int)) LwJa
  (measure (* 4 (List_LwArm.size arms)))
  (match arms
    (nil (LwJa nil nil k))
    ((cons (LwArm p body) r)
     (match (lw_jp_tail owner body k)
       ((LwJ rb ls1 k1)
        (match (lw_jp_arms owner r k1)
          ((LwJa rr ls2 k2) (LwJa (cons (LwArm p rb) rr) (append ls1 ls2) k2))))))))
(fn lw_arms_flat ((arms (List LwArm))) Bool
  (measure (List.length arms))
  (match arms
    (nil true)
    ((cons (LwArm p _) r) (if (lw_flat p) (lw_arms_flat r) false))))
(fn lw_flat ((p LwP)) Bool
  (match p
    ((LwPCtor _ ps) (lw_all_vars ps))
    (_ true)))
(fn lw_all_vars ((ps (List LwP))) Bool
  (measure (List.length ps))
  (match ps
    (nil true)
    ((cons (LwPVar _) r) (lw_all_vars r))
    (_ false)))
(fulfills lw_all_vars.dec_1 (by (intro ps w r h) (rw h) (rw List.length_cons) (arith)))
(fulfills lw_arms_flat.dec_1 (by (intro arms p w r h hf) (rw h) (rw List.length_cons) (arith)))
;; the scrutinee a variable, then the arms as a chain
(fn lw_scrut ((owner Name) (s LwE) (arms (List LwArm)) (k Int)) LwJ
  (match s
    ((LwVar sv) (lw_chain owner sv arms k))
    (_
      (match (lw_chain owner k arms (+ k 1))
        ((LwJ e ls k1) (LwJ (LwLet k s e) ls k1))))))
;; arm by arm: try the first; where it does not match, the rest of the chain — a call to it,
;; lifted once. Past the last arm is the sink: a match with no arm
(fn lw_chain ((owner Name) (sv Int) (arms (List LwArm)) (k Int)) LwJ
  (measure (List.length arms))
  (match arms
    (nil (LwJ (LwMatch (LwVar sv) nil) nil k))
    ((cons (LwArm p body) rest)
     (match (lw_chain owner sv rest k)
       ((LwJ fail ls1 k1)
        (match (lw_lift_fail owner fail k1)
          ((LwJ failc ls2 k2)
           (match (lw_test owner sv p body failc k2)
             ((LwJ e ls3 k3) (LwJ e (append ls1 (append ls2 ls3)) k3))))))))))
;; a continuation small enough to repeat is not lifted: the sink, a call of no operand
(fn lw_lift_fail ((owner Name) (e LwE) (k Int)) LwJ
  (match e
    ((LwMatch _ nil) (LwJ e nil k))
    ((LwCall _ nil) (LwJ e nil k))
    (_ (lw_lift owner e k))))
;; one pattern tested on the variable sv: BODY where it matches, FAILC where it does not
(fn lw_test ((owner Name) (sv Int) (p LwP) (body LwE) (failc LwE) (k Int)) LwJ
  (measure (LwP.size p))
  (match p
    ((LwPVar x) (LwJ (LwLet x (LwVar sv) body) nil k))
    ((LwPInt _)
     (LwJ (LwMatch (LwVar sv) (list (LwArm p body) (LwArm (LwPVar k) failc))) nil (+ k 1)))
    ((LwPCtor c ps)
     (match (lw_fields ps k)
       ((Prod.mk fs k1)
        (match (lw_tests owner fs ps body failc k1)
          ((LwJ inner ls k2)
           (LwJ
             (LwMatch (LwVar sv)
               (list (LwArm (LwPCtor c (lw_pvars fs)) inner) (LwArm (LwPVar k2) failc)))
             ls
             (+ k2 1)))))))))
;; a field's variable: the pattern's own where the sub-pattern is a variable, else a new one
(fn lw_fields ((ps (List LwP)) (k Int)) (Prod (List Int) Int)
  (measure (List.length ps))
  (match ps
    (nil (Prod.mk nil k))
    ((cons (LwPVar x) r)
     (match (lw_fields r k)
       ((Prod.mk ns k1) (Prod.mk (cons x ns) k1))))
    ((cons _ r)
     (match (lw_fields r (+ k 1))
       ((Prod.mk ns k1) (Prod.mk (cons k ns) k1))))))
(fulfills lw_fields.dec_1 (by (intro p x r h) (rw h) (rw List.length_cons) (arith)))
(fulfills lw_fields.dec_2 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
(fn lw_pvars ((vs (List Int))) (List LwP)
  (measure (struct vs))
  (match vs
    (nil nil)
    ((cons v r) (cons (LwPVar v) (lw_pvars r)))))
;; the fields' sub-patterns tested in order; the last one's success is the arm's body
(fn lw_tests ((owner Name) (fs (List Int)) (ps (List LwP)) (body LwE) (failc LwE) (k Int)) LwJ
  (measure (List_LwP.size ps))
  (match ps
    (nil (LwJ body nil k))
    ((cons p prest)
     (match fs
       (nil (LwJ body nil k))
       ((cons f frest)
        (match p
          ((LwPVar _) (lw_tests owner frest prest body failc k))  ; bound by the flat arm
          (_
            (match (lw_tests owner frest prest body failc k)
              ((LwJ inner ls1 k1)
               (match (lw_test owner f p inner failc k1)
                 ((LwJ e ls2 k2) (LwJ e (append ls1 ls2) k2))))))))))))
(fulfills lw_test.dec_1
  (by (intro owner sv p body failc k c ps h fs k1 h1) (rw h) (rw LwP.size.eq_3) (arith)))
(fulfills lw_tests.dec_1
  (by
    (intro owner fs ps body failc k p prest h f frest h1 w h2)
    (rw h)
    (rw List_LwP.size.eq_2)
    (arith)))
(fulfills lw_tests.dec_2
  (by
    (intro owner fs ps body failc k p prest h f frest h1 w h2)
    (rw h)
    (rw List_LwP.size.eq_2)
    (arith)))
(fulfills lw_tests.dec_3
  (by
    (intro owner fs ps body failc k p prest h f frest h1 w h2 inner ls1 k1)
    (rw h)
    (rw List_LwP.size.eq_2)
    (arith)))
;; the join-point pass's descents, here below the last function it calls: a part of the term,
;; or the same term handed to a function ranked below — an operand's position (3) above a
;; lifted one (2) above a tail position (1) above an application over its operands (0)
(fulfills lw_jp_named.dec_1 (by (intro owner e k a b c h) (arith)))
(fulfills lw_jp_named.dec_2 (by (intro owner e k a b h) (arith)))
(fulfills lw_jp_named.dec_3 (by (intro owner e k n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_jp_named.dec_4
  (by (intro owner e k n r body h rr ls1 k1) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_jp_named.dec_5 (by (intro owner e k w h) (arith)))
(fulfills lw_jp_app.dec_1
  (by
    (intro owner e k as h)
    (cases e
      ((LwVar (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwInt (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwCtor (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_3)
         (arith))
       (LwCall (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_4)
         (arith))
       (LwPrim (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_5)
         (arith))
       (LwExt (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2)) (rw LwE.size.eq_6)
         (arith))
       (LwIf (x y z) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwMatch (s arms) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwLet (n r y) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwAbsurd () (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))))))
(fulfills lw_jp_lifted.dec_1 (by (intro owner e k) (arith)))
(fulfills lw_jp_all.dec_1 (by (intro owner es k e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_jp_all.dec_2
  (by (intro owner es k e r h re ls1 k1) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_jp_tail.dec_1 (by (intro owner e k c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_jp_tail.dec_2
  (by (intro owner e k c t f h rc ls1 k1) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_jp_tail.dec_3
  (by (intro owner e k c t f h rc ls1 k1 rt ls2 k2) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_jp_tail.dec_4 (by (intro owner e k s arms h) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_jp_tail.dec_5
  (by (intro owner e k s arms h rs ls1 k1) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_jp_tail.dec_6 (by (intro owner e k n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_jp_tail.dec_7
  (by (intro owner e k n r body h rr ls1 k1) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_jp_tail.dec_8 (by (intro owner e k w h) (arith)))
(fulfills lw_jp_arms.dec_1
  (by (intro owner arms k p body r h) (rw h) (rw List_LwArm.size.eq_2) (rw LwArm.size.eq_1) (arith)))
(fulfills lw_jp_arms.dec_2
  (by (intro owner arms k p body r h rb ls1 k1) (rw h) (rw List_LwArm.size.eq_2) (arith)))
;; the descent of lw_chain, here past lw_test, the last function it calls
(fulfills lw_chain.dec_1 (by (intro q p body rest h) (rw h) (rw List.length_cons) (arith)))

;; ---- pass ANF: every operand an atom --------------------------------------------------------
(type LwN (LwNOk (List (Prod Int LwE)) LwE Int) (LwNErr (List Int)))  ; the bindings, the atom
(type LwNs (LwNsOk (List (Prod Int LwE)) (List LwE) Int) (LwNsErr (List Int)))
(type LwT (LwTOk LwE Int) (LwTErr (List Int)))
(type LwTa (LwTaOk (List LwArm) Int) (LwTaErr (List Int)))

;; to an atom, the bindings it needs outward
(fn lw_anf_name ((e LwE) (k Int)) LwN
  (measure (+ (* 4 (LwE.size e)) 1))
  (match e
    ((LwVar _) (LwNOk nil e k))
    ((LwInt _) (LwNOk nil e k))
    (LwAbsurd (LwNOk (list (Prod.mk k LwAbsurd)) (LwVar k) (+ k 1)))
    ((LwLet n rhs body)
     (match (lw_anf_rhs rhs k)
       ((LwNErr m) (LwNErr m))
       ((LwNOk binds1 r k1)
        (match (lw_anf_name body k1)
          ((LwNErr m) (LwNErr m))
          ((LwNOk binds2 atom k2) (LwNOk (append binds1 (cons (Prod.mk n r) binds2)) atom k2))))))
    ((LwIf _ _ _) (LwNErr (utf8 "internal: an if in an operand's position was not lifted")))
    ((LwMatch _ _) (LwNErr (utf8 "internal: a match in an operand's position was not lifted")))
    (_
      (match (lw_args e)
        (none (LwNErr (utf8 "internal: not an application")))
        ((some as)
         (match (lw_anf_names as k)
           ((LwNsErr m) (LwNErr m))
           ((LwNsOk binds atoms k1)
            (LwNOk (append binds (list (Prod.mk k1 (lw_rehead e atoms)))) (LwVar k1) (+ k1 1)))))))))
;; to a right-hand side: an application stays where it is, over atoms
(fn lw_anf_rhs ((e LwE) (k Int)) LwN
  (measure (+ (* 4 (LwE.size e)) 2))
  (match e
    (LwAbsurd (LwNOk nil e k))
    (_
      (match (lw_args e)
        ((some as)
         (match (lw_anf_names as k)
           ((LwNsErr m) (LwNErr m))
           ((LwNsOk binds atoms k1) (LwNOk binds (lw_rehead e atoms) k1))))
        (none (lw_anf_name e k))))))
(fn lw_anf_names ((es (List LwE)) (k Int)) LwNs
  (measure (* 4 (List_LwE.size es)))
  (match es
    (nil (LwNsOk nil nil k))
    ((cons e r)
     (match (lw_anf_name e k)
       ((LwNErr m) (LwNsErr m))
       ((LwNOk binds a k1)
        (match (lw_anf_names r k1)
          ((LwNsErr m) (LwNsErr m))
          ((LwNsOk binds2 atoms k2) (LwNsOk (append binds binds2) (cons a atoms) k2))))))))
(fulfills lw_anf_name.dec_1 (by (intro e k n rhs body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_anf_name.dec_2
  (by (intro e k n rhs body h binds1 r k1) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_anf_name.dec_3
  (by
    (intro e k w hw as h)
    (cases e
      ((LwVar (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwInt (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwCtor (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_3)
         (arith))
       (LwCall (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_4)
         (arith))
       (LwPrim (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_5)
         (arith))
       (LwExt (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2)) (rw LwE.size.eq_6)
         (arith))
       (LwIf (a b c) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwMatch (s arms) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwLet (n r b) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwAbsurd () (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))))))
(fulfills lw_anf_rhs.dec_1
  (by
    (intro e k w hw as h)
    (cases e
      ((LwVar (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwInt (i) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwCtor (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_3)
         (arith))
       (LwCall (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_4)
         (arith))
       (LwPrim (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2))
         (rw LwE.size.eq_5)
         (arith))
       (LwExt (c xs) (have h2 (= xs as) (exact (Option.some.inj h))) (rw (<- h2)) (rw LwE.size.eq_6)
         (arith))
       (LwIf (a b c) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwMatch (s arms) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwLet (n r b) (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))
       (LwAbsurd () (have h3 (= 0 1) (exact (congrArg (@Option.ctorIdx (List LwE)) h))) (arith))))))
(fulfills lw_anf_rhs.dec_2 (by (intro e k w hw h) (arith)))
(fulfills lw_anf_names.dec_1 (by (intro es k e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_anf_names.dec_2
  (by (intro es k e r h binds a k1) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fn lw_wrap ((binds (List (Prod Int LwE))) (tail LwE)) LwE
  (measure (struct binds))
  (match binds
    (nil tail)
    ((cons (Prod.mk n r) rest) (LwLet n r (lw_wrap rest tail)))))
;; a body
(fn lw_anf_tail ((e LwE) (k Int)) LwT
  (measure (LwE.size e))
  (match e
    ((LwIf c t f)
     (match (lw_anf_name c k)
       ((LwNErr m) (LwTErr m))
       ((LwNOk binds ca k1)
        (match (lw_anf_tail t k1)
          ((LwTErr m) (LwTErr m))
          ((LwTOk rt k2)
           (match (lw_anf_tail f k2)
             ((LwTErr m) (LwTErr m))
             ((LwTOk rf k3) (LwTOk (lw_wrap binds (LwIf ca rt rf)) k3))))))))
    ((LwMatch s arms)
     (match (lw_anf_name s k)
       ((LwNErr m) (LwTErr m))
       ((LwNOk binds sa k1)
        (match (lw_anf_arms arms k1)
          ((LwTaErr m) (LwTErr m))
          ((LwTaOk rarms k2) (LwTOk (lw_wrap binds (LwMatch sa rarms)) k2))))))
    ((LwLet n rhs body)
     (match (lw_anf_rhs rhs k)
       ((LwNErr m) (LwTErr m))
       ((LwNOk binds r k1)
        (match (lw_anf_tail body k1)
          ((LwTErr m) (LwTErr m))
          ((LwTOk rb k2) (LwTOk (lw_wrap binds (LwLet n r rb)) k2))))))
    (_
      (match (lw_anf_rhs e k)
        ((LwNErr m) (LwTErr m))
        ((LwNOk binds r k1) (LwTOk (lw_wrap binds r) k1))))))
(fn lw_anf_arms ((arms (List LwArm)) (k Int)) LwTa
  (measure (List_LwArm.size arms))
  (match arms
    (nil (LwTaOk nil k))
    ((cons (LwArm p body) r)
     (if (lw_flat p)
       (match (lw_anf_tail body k)
         ((LwTErr m) (LwTaErr m))
         ((LwTOk rb k1)
          (match (lw_anf_arms r k1)
            ((LwTaErr m) (LwTaErr m))
            ((LwTaOk rr k2) (LwTaOk (cons (LwArm p rb) rr) k2)))))
       (LwTaErr (utf8 "internal: a nested pattern was not compiled"))))))
(fulfills lw_anf_tail.dec_1
  (by (intro e k c t f h binds ca k1 h1) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_anf_tail.dec_2
  (by (intro e k c t f h binds ca k1 h1 rt k2) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_anf_tail.dec_3
  (by (intro e k s arms h binds sa k1 h1) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_anf_tail.dec_4
  (by (intro e k n rhs body h binds r k1 h1) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_anf_arms.dec_1
  (by (intro arms k p body r h hf) (rw h) (rw List_LwArm.size.eq_2) (rw LwArm.size.eq_1) (arith)))
(fulfills lw_anf_arms.dec_2
  (by (intro arms k p body r h hf rb k1) (rw h) (rw List_LwArm.size.eq_2) (arith)))

;; ---- back to indices: env is innermost first -------------------------------------------------
(fn lw_index ((v Int) (env (List Int)) (i Int)) Int
  (measure (struct env))
  (match env
    (nil -1)
    ((cons x r) (if (= x v) i (lw_index v r (+ i 1))))))
(fn lw_term ((e LwE) (env (List Int))) ETerm
  (measure (LwE.size e))
  (match e
    ((LwVar v) (EBVar (lw_index v env 0)))
    ((LwInt n) (ELit (if (< n 0) (LInt n) (LNat n))))
    ((LwCtor c as) (ECtor c (lw_terms as env)))
    ((LwCall f as) (ECall f (lw_terms as env)))
    ((LwPrim p as) (EPrim p (lw_terms as env)))
    ((LwExt x as) (EExt x (lw_terms as env)))
    ((LwIf c t f) (EIf (lw_term c env) (lw_term t env) (lw_term f env)))
    ((LwMatch s arms) (EMatch (lw_term s env) (lw_tarms arms env)))
    ((LwLet n r body) (ELet (list (lw_term r env)) (lw_term body (cons n env))))
    (LwAbsurd EAbsurd)))
(fn lw_terms ((es (List LwE)) (env (List Int))) (List ETerm)
  (measure (List_LwE.size es))
  (match es
    (nil nil)
    ((cons e r) (cons (lw_term e env) (lw_terms r env)))))
(fn lw_tarms ((arms (List LwArm)) (env (List Int))) (List EArm)
  (measure (List_LwArm.size arms))
  (match arms
    (nil nil)
    ((cons (LwArm p body) r)
     (cons (EArm (lw_tpat p) (lw_term body (rev_onto (lw_pat_order p) env))) (lw_tarms r env)))))
(fn lw_tpat ((p LwP)) EPat
  (measure (LwP.size p))
  (match p
    ((LwPVar _) PVar)
    ((LwPInt n) (PLit (if (< n 0) (LInt n) (LNat n))))
    ((LwPCtor c ps) (PCtor c (lw_tpats ps)))))
(fn lw_tpats ((ps (List LwP))) (List EPat)
  (measure (List_LwP.size ps))
  (match ps
    (nil nil)
    ((cons p r) (cons (lw_tpat p) (lw_tpats r)))))
(fulfills lw_tpat.dec_1 (by (intro p c ps h) (rw h) (rw LwP.size.eq_3) (arith)))
(fulfills lw_tpats.dec_1 (by (intro ps p r h) (rw h) (rw List_LwP.size.eq_2) (arith)))
(fulfills lw_tpats.dec_2 (by (intro ps p r h) (rw h) (rw List_LwP.size.eq_2) (arith)))
;; a pattern's variables in binding order
(fn lw_pat_order ((p LwP)) (List Int) (rev (lw_pat_vars p nil)))
;; the descent of lw_term and its members, here where the last function they call is declared
(fulfills lw_term.dec_1 (by (intro e env c as h) (rw h) (rw LwE.size.eq_3) (arith)))
(fulfills lw_term.dec_2 (by (intro e env f as h) (rw h) (rw LwE.size.eq_4) (arith)))
(fulfills lw_term.dec_3 (by (intro e env p as h) (rw h) (rw LwE.size.eq_5) (arith)))
(fulfills lw_term.dec_4 (by (intro e env x as h) (rw h) (rw LwE.size.eq_6) (arith)))
(fulfills lw_term.dec_5 (by (intro e env c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_term.dec_6 (by (intro e env c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_term.dec_7 (by (intro e env c t f h) (rw h) (rw LwE.size.eq_7) (arith)))
(fulfills lw_term.dec_8 (by (intro e env s arms h) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_term.dec_9 (by (intro e env s arms h) (rw h) (rw LwE.size.eq_8) (arith)))
(fulfills lw_term.dec_10 (by (intro e env n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_term.dec_11 (by (intro e env n r body h) (rw h) (rw LwE.size.eq_9) (arith)))
(fulfills lw_terms.dec_1 (by (intro es env e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_terms.dec_2 (by (intro es env e r h) (rw h) (rw List_LwE.size.eq_2) (arith)))
(fulfills lw_tarms.dec_1
  (by (intro arms env p body r h) (rw h) (rw List_LwArm.size.eq_2) (rw LwArm.size.eq_1) (arith)))
(fulfills lw_tarms.dec_2 (by (intro arms env p body r h) (rw h) (rw List_LwArm.size.eq_2) (arith)))

;; ---- a function --------------------------------------------------------------------------
(fn lw_jv () EType (ETCon (n1 (sym "JV")) nil))
(fn lw_jvs ((k Int)) (List EType)
  (measure (Int.natAbs k))
  (if (< k 1) nil (cons (lw_jv) (lw_jvs (- k 1)))))
(fulfills lw_jvs.dec_1 (by (intro k h) (apply natAbs_pred (arith))))
;; the parameters' numbers innermost first: n-1 … 0
(fn lw_params ((n Int)) (List Int)
  (measure (Int.natAbs n))
  (if (< n 1) nil (cons (- n 1) (lw_params (- n 1)))))
(fulfills lw_params.dec_1 (by (intro n h) (apply natAbs_pred (arith))))
(type LwF (LwFOk (List EDecl)) (LwFErr (List Int)))
(fn lw_fn ((n Name) (nt Int) (ps (List EType)) (rt EType) (rec ERec) (body ETerm)) LwF
  (let ((np (len ps)))
    (match (lw_named body (lw_params np) np)
      ((LwErr m) (LwFErr m))
      ((LwOk e0 k0)
       (match (lw_jp_tail n e0 k0)
         ((LwJ e ls k)
          (match (lw_anf_tail e k)
            ((LwTErr m) (LwFErr m))
            ((LwTOk rs k1)
             (match (lw_lifted ls k1 nil)
               ((LwFErr m) (LwFErr m))
               ((LwFOk lifted)
                (LwFOk (cons (EFn n nt ps rt rec (lw_term rs (lw_params np))) lifted))))))))))))
;; the lifted functions in the order they were lifted; acc is newest first
(fn lw_lifted ((ls (List LwLifted)) (k Int) (acc (List EDecl))) LwF
  (measure (List.length ls))
  (match ls
    (nil (LwFOk (rev acc)))
    ((cons (LwLifted jn params body) rest)
     (match (lw_anf_tail body k)
       ((LwTErr m) (LwFErr m))
       ((LwTOk rb k1)
        (lw_lifted rest k1
          (cons (EFn jn 0 (lw_jvs (len params)) (lw_jv) RecNone (lw_term rb (rev params))) acc)))))))
(fulfills lw_lifted.dec_1
  (by (intro p jn params body rest h rb k1 h1) (rw h) (rw List.length_cons) (arith)))

;; ---- a program -----------------------------------------------------------------------------
(type LwRes (LwProg Prog) (LwRefused (List (List Int))))
(fn lw_prog ((p Prog)) LwRes
  (match p
    ((Prog ds) (lw_decls ds nil nil))))
;; acc and errs newest first
(fn lw_decls ((ds (List EDecl)) (acc (List EDecl)) (errs (List (List Int)))) LwRes
  (measure (struct ds))
  (match ds
    (nil
      (match errs
        (nil (LwProg (Prog (rev acc))))
        (_ (LwRefused (rev errs)))))
    ((cons d r)
     (match d
       ((EFn n nt ps rt rec body)
        (match (lw_fn n nt ps rt rec body)
          ((LwFOk fs) (lw_decls r (rev_onto fs acc) errs))
          ((LwFErr m) (lw_decls r acc (cons (append m (append (utf8 " in ") (show_name n))) errs)))))
       ((ESig n _ _ _)
        (lw_decls r acc
          (cons
            (append (utf8 "unlinked sig fn ")
              (append (show_name n)
                (utf8 ": the implementation's directory was not loaded (give it as a root)")))
            errs)))
       ((ESigType n _)
        (lw_decls r acc
          (cons
            (append (utf8 "unlinked sig type ")
              (append (show_name n)
                (utf8 ": the implementation's directory was not loaded (give it as a root)")))
            errs)))
       (_ (lw_decls r (cons d acc) errs))))))
