;;; v3/kernel/prog.shard — E programs as data: what `ev` runs.
;;;
;;; FOUNDATION §2 ("programs are data"), §4.2 (E's types and terms),
;;; §4.4 (`ev` is the definition of "run"; evaluation reflection is
;;; stated over this data), §9.1 (route 2: K interpreted by compiled
;;; `ev`). v3/LANGUAGE.md §6 is the specification; this file is the
;;; definition, phase 2 slice 1 (2026-09-07): declarations with the
;;; rules as comments, the phase-0 precedent — `ev` and the classifier
;;; are the slices after the reader.
;;;
;;; The shape is the Rust bootstrap's AST (rust_bootstrap/src/ast.rs,
;;; the executor of E today) with every name resolved to an identity
;;; (name.shard's Name: the module path plus the declared name for a
;;; native declaration, the exported name for an imported one) and every
;;; call head classified at load, so `ev` never guesses what a head is.
;;; Frontend parity (LANGUAGE.md §10) compares a Prog printed by the V3
;;; reader with the bootstrap's Module printed in the same text.
;;;
;;; This is a toolchain-profile file: the L-level List/Option/Bool/Nat
;;; of the library are Init's and unrelated (prelude.shard).

(import "util.shard")   ; Name (name.shard) + name_eq

;; ---------------------------------------------------------------------
;; TYPES. E-types (§4.2): a type constructor applied to E-types, or a type
;; parameter of the enclosing declaration by position. Every polymorphic
;; type constructor is at universe level 0 here — E-types live in Type —
;; so no levels are carried (LANGUAGE.md §4, "E-type positions").
(type EType
  (ETCon Name (List EType))   ; List Int, Option (List Int), Nat, a native inductive applied
  (ETVar Int))                ; the i-th type parameter of the declaration (0-based)

;; ---------------------------------------------------------------------
;; LITERALS. LNat and LInt share the runtime representation (VInt) — the
;; realization of Nat and Int alike is the unbounded integer
;; (v3/INVENTORY.md); the constructor records the literal's E type for the
;; Stage-1 typing of bodies. LStr is the toolchain profile's string
;; literal, a byte list (LANGUAGE.md §8); S's String literal has no E
;; realization until phase 3. LSym is the profile's symbol literal.
(type ELit
  (LNat Int)          ; a Nat numeral, ≥ 0
  (LInt Int)          ; an Int numeral (the profile's numerals)
  (LStr (List Int))   ; UTF-8 bytes (the profile's "…")
  (LSym Symbol))      ; (quote X) — the profile only

;; ---------------------------------------------------------------------
;; PATTERNS. A variable binds the next de Bruijn index (positional, as in
;; the bootstrap: PVar carries no name); a constructor pattern names the
;; constructor's identity and binds its sub-patterns left to right; a
;; literal pattern compares by value.
(type EPat
  (PVar)                      ; `_` or a name — binds one slot
  (PCtor Name (List EPat))
  (PLit ELit))

;; ---------------------------------------------------------------------
;; TERMS. Locally nameless: EBVar 0 is the innermost binding (a fn's last
;; parameter, the last variable a pattern bound, the last binding of a
;; let). Four head kinds are four constructors: the classifier resolved
;; each head to exactly one of them (LANGUAGE.md §6.3), all saturated.
(type ETerm
  (EBVar Int)                    ; a parameter or pattern/let variable
  (ELit ELit)
  (ECtor Name (List ETerm))      ; a constructor of an E-eligible inductive, applied to its fields
  (ECall Name (List ETerm))      ; an E function (EFn, or an ESig linked at run time)
  (EPrim Name (List ETerm))      ; a primitive of the fixed table, by identity (LANGUAGE.md §6.4)
  (EExt Name (List ETerm))       ; a World extern — `ev` is pure and stops here; `run` performs it
  (EMatch ETerm (List EArm))     ; first arm whose pattern matches; no arm = stuck
  (ELet (List ETerm) ETerm)      ; SEQUENTIAL (RULED 2026-09-12, R44): each rhs sees the bindings before it; pushed in order
  (EIf ETerm ETerm ETerm))       ; then-branch iff the condition's cell is the SECOND constructor of its type
;; RULES of `ev` per node (LANGUAGE.md §6.2): arguments left to right; a
;; call evaluates the callee's body in a fresh frame of exactly its
;; argument values with one unit of fuel less; a primitive's guard
;; failure (the profile's `/` at zero, a shift out of range) is stuck,
;; never a value; `if` is the tag rule — Bool.true, Decidable.isTrue and
;; the prelude's True are all the second constructor — which is what "a
;; decision tag with erased payload" means at run time.

(type EArm (EArm EPat ETerm))

;; ---------------------------------------------------------------------
;; RECURSION STRUCTURE (FOUNDATION §4.4: the correspondence is stated
;; over "its cases, callees, representations and recursion"). `ev` needs
;; none of it — fuel bounds every run — but the realization record does.
(type ERec
  (RecNone)              ; no measure clause
  (RecStruct Int)        ; (measure (struct x)): structural on parameter i (0-based)
  (RecMeasure ETerm))    ; (measure E): a term over the parameters — an obligation until phase 3

;; ---------------------------------------------------------------------
;; DECLARATIONS.
(type ECtorDef (ECtorDef Name (List EType)))   ; constructor identity, field types over ETVar 0..nparams-1

(type EDecl
  (EInd Name Int (List ECtorDef))              ; an E-eligible inductive: identity, nparams, constructors
  (EFn Name Int (List EType) EType ERec ETerm) ; identity, ntparams, parameter types, return type, recursion, body
  (EExtern Name Int (List EType) EType)        ; a World extern: identity, ntparams, parameter types, return type
  (ESig Name Int (List EType) EType)           ; a view's `sig fn`: a signature `run` links to an EFn (LANGUAGE.md §6.5)
  (ESigType Name Int))                         ; a view's `sig type`: identity and arity, no constructors
;; RULES: identities are unique across a Prog (the loader's scope, K's
;; check_name for the L twins); an ECall's target is an EFn or an ESig
;; of the same arity; an ECtor's constructor belongs to an EInd and is
;; applied to exactly its fields; a consumer's body never names an
;; ESigType's constructor (the private-equality leak, refused at
;; classification); a call to an ESig is stuck (`unlinked`) — the
;; implementation check substitutes the implementation's EFn under the
;; same identity (LANGUAGE.md §6.6, §6.7), which is the link.

(type Prog (Prog (List EDecl)))

;; ---------------------------------------------------------------------
;; VALUES and RESULTS. A value is closed data: `ev` values carry no
;; index (the bootstrap's invariant, eval.rs). Nat and Int are both
;; VInt; a Bool is the cell (VCtor Bool.true Nil).
(type Val
  (VCtor Name (List Val))
  (VInt Int)
  (VSym Symbol))

(type EvRes
  (EvOk Val)
  (EvOut)                 ; fuel exhausted — never a value, never a refusal (§9.4)
  (EvStuck Symbol Name))  ; reason (no_arm, guard, unbound, extern, unknown_head), subject (the function)

;; ---------------------------------------------------------------------
;; the identity of a declaration, and lookup by identity (name.shard's
;; structural equality; `ev` may index a Prog however it likes — no
;; representation is mandated).
(fn edecl_name ((d EDecl)) Name
  (match d
    ((EInd n _ _) n)
    ((EFn n _ _ _ _ _) n)
    ((EExtern n _ _ _) n)
    ((ESig n _ _ _) n)
    ((ESigType n _) n)))

(fn prog_find ((p Prog) (n Name)) (Option EDecl)
  (match p ((Prog ds) (prog_find_in ds n))))

(fn prog_find_in ((ds (List EDecl)) (n Name)) (Option EDecl)
  (measure (struct ds))
  (match ds
    (Nil None)
    ((Cons d r) (if (name_eq (edecl_name d) n) (Some d) (prog_find_in r n)))))

;; ---------------------------------------------------------------------
;; THE PRIMITIVE TABLE (LANGUAGE.md §6.4): identity → (operation code,
;; arity). The profile's bare names and the naming law's spellings where
;; the meaning differs (`/` stuck at zero and `Int.tdiv` total are two
;; entries); ev.shard implements the codes, classify.shard resolves heads
;; against the identities. `gen_fresh` is not carried (§6.7).
(type Prim (Prim Int Int))
(fn prim_table () (List (Pair Name Prim))
  (list (Pair (n1 (quote int_eq)) (Prim 0 2)) (Pair (n1 (quote +)) (Prim 1 2)) (Pair (n1 (quote -)) (Prim 2 2))
        (Pair (n1 (quote lt)) (Prim 3 2)) (Pair (n1 (quote le)) (Prim 4 2)) (Pair (n1 (quote sym_eq)) (Prim 5 2))
        (Pair (n1 (quote band)) (Prim 6 2)) (Pair (n1 (quote bshr)) (Prim 7 2))
        (Pair (n1 (quote *)) (Prim 8 2)) (Pair (n1 (quote mod)) (Prim 9 2)) (Pair (n1 (quote /)) (Prim 10 2))
        (Pair (n1 (quote tmod)) (Prim 11 2)) (Pair (n1 (quote ediv)) (Prim 12 2))
        (Pair (n1 (quote bor)) (Prim 13 2)) (Pair (n1 (quote bxor)) (Prim 14 2)) (Pair (n1 (quote bshl)) (Prim 15 2))
        (Pair (n1 (quote sym_of_chars)) (Prim 16 1)) (Pair (n1 (quote chars_of_sym)) (Prim 17 1))
        (Pair (n2 (quote Int) (quote tdiv)) (Prim 18 2)) (Pair (n2 (quote Int) (quote tmod)) (Prim 19 2))
        (Pair (n2 (quote Int) (quote ediv)) (Prim 20 2)) (Pair (n2 (quote Int) (quote emod)) (Prim 21 2))
        (Pair (n2 (quote Nat) (quote sub)) (Prim 22 2))
        (Pair (n2 (quote Nat) (quote land)) (Prim 23 2)) (Pair (n2 (quote Nat) (quote lor)) (Prim 24 2))
        (Pair (n2 (quote Nat) (quote xor)) (Prim 25 2))
        (Pair (n2 (quote Nat) (quote shiftLeft)) (Prim 26 2)) (Pair (n2 (quote Nat) (quote shiftRight)) (Prim 27 2))))
(fn prim_find ((n Name)) (Option Prim) (prim_assoc (prim_table) n))
(fn prim_assoc ((t (List (Pair Name Prim))) (n Name)) (Option Prim)
  (measure (struct t))
  (match t (Nil None) ((Cons (Pair k p) r) (if (name_eq k n) (Some p) (prim_assoc r n)))))
;; the first candidate the table knows (S: the scope's candidates; the profile: the bare citation)
(fn prim_of ((cands (List Name))) (Option (Pair Name Prim))
  (measure (struct cands))
  (match cands
    (Nil None)
    ((Cons c r) (match (prim_find c) ((Some p) (Some (Pair c p))) (None (prim_of r))))))
;; a primitive's result type head: Bool for the decisions, Symbol, List, else Int
(fn prim_result ((code Int)) EType
  (if (bool_or (int_eq code 0) (bool_or (int_eq code 3) (bool_or (int_eq code 4) (int_eq code 5)))) (ETCon (prelude_bool) Nil)
  (if (int_eq code 16) (ETCon (n1 (quote Symbol)) Nil)
  (if (int_eq code 17) (ETCon (prelude_list) (list (ETCon (n1 (quote Int)) Nil)))
    (ETCon (n1 (quote Int)) Nil)))))

;; ---------------------------------------------------------------------
;; THE TOOLCHAIN PRELUDE'S IDENTITIES (LANGUAGE.md §8): the wire's cells
;; and the decisions the comparison primitives return (§6.7).
(fn prelude_mod () Name (n2 (quote kernel) (quote prelude)))
(fn prelude_list () Name (Str (prelude_mod) (quote List)))
(fn prelude_bool () Name (Str (prelude_mod) (quote Bool)))
(fn prelude_option () Name (Str (prelude_mod) (quote Option)))
(fn prelude_pair () Name (Str (prelude_mod) (quote Pair)))
(fn prelude_nil () Name (Str (prelude_list) (quote Nil)))
(fn prelude_cons () Name (Str (prelude_list) (quote Cons)))
(fn prelude_false () Name (Str (prelude_bool) (quote False)))
(fn prelude_true () Name (Str (prelude_bool) (quote True)))
(fn prelude_none () Name (Str (prelude_option) (quote None)))
(fn prelude_some () Name (Str (prelude_option) (quote Some)))
(fn prelude_mk_pair () Name (Str (prelude_pair) (quote Pair)))

