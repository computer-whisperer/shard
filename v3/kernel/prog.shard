;;; v3/kernel/prog.shard — E programs as data: what `ev` runs. `ev`
;;; (ev.shard) is the definition of "run", stated over this data: the
;;; declarations, with the rules as comments.
;;;
;;; The shape is the Rust bootstrap's AST (rust_bootstrap/src/ast.rs)
;;; with every name resolved to an identity
;;; (name.shard's Name: the module path plus the declared name for a
;;; native declaration, the exported name for an imported one) and every
;;; call head classified at load, so `ev` never guesses what a head is.
;;; Frontend parity (test/parity_test.sh) compares a Prog printed by the V3
;;; reader with the bootstrap's Module printed in the same text.
;;;

(import "util.shard")
(import "intmap.shard")
(import "sym.shard")
(import "name.shard")
(import "base.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.base)
(use kernel.descent)
(use kernel.intmap)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.name.Name)

;; ---------------------------------------------------------------------
;; TYPES. E-types: a type constructor applied to E-types, or a type
;; parameter of the enclosing declaration by position. Every polymorphic
;; type constructor is at universe level 0 here — E-types live in Type —
;; so no levels are carried.
(type EType
  (ETCon Name (List EType))  ; List Int, Option (List Int), Nat, a native inductive applied
  (ETVar Int))  ; the i-th type parameter of the declaration (0-based)
;; structural equality of E types
(fn etype_eq ((a EType) (b EType)) Bool
  (measure (struct a))
  (match a
    ((ETVar i)
     (match b
       ((ETVar j) (= i j))
       (_ false)))
    ((ETCon n as)
     (match b
       ((ETCon m bs) (bool_and (name_eq n m) (etypes_eq as bs)))
       (_ false)))))
(fn etypes_eq ((as (List EType)) (bs (List EType))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a ar)
     (match bs
       ((cons b br) (bool_and (etype_eq a b) (etypes_eq ar br)))
       (nil false)))))
;; a type under the type arguments of the inductive it is a field of, and a constructor's field
;; types among its inductive's (the classifier's static types; ev.shard's checked door)
(fn subst_tys ((args (List EType)) (ts (List EType))) (List EType)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (cons (subst_ty args t) (subst_tys args r)))))
(fn subst_ty ((args (List EType)) (t EType)) EType
  (measure (struct t))
  (match t
    ((ETVar i)
     (match (nth args i)
       ((some a) a)
       (none (ETVar i))))
    ((ETCon n ts) (ETCon n (subst_tys args ts)))))

;; ---------------------------------------------------------------------
;; LITERALS. LNat and LInt
;; share the runtime representation (VInt) — the realization of Nat and Int
;; alike is the unbounded integer; the kind is the sign, a
;; non-negative numeral typing as Nat for the static pass. LStr is a string
;; literal, a `String`: its UTF-8 bytes as a chain of Init's `List` cells — a String's
;; representation — built once by the linker.
(type ELit
  (LNat Int)  ; a numeral ≥ 0
  (LInt Int)  ; a negative numeral
  (LStr (List Int)))  ; "…": the UTF-8 bytes

;; ---------------------------------------------------------------------
;; PATTERNS. A variable binds the next de Bruijn index (positional, as in
;; the bootstrap: PVar carries no name); a constructor pattern names the
;; constructor's identity and binds its sub-patterns left to right; a
;; literal pattern compares by value.
(type EPat
  (PVar)  ; `_` or a name — binds one slot
  (PCtor Name (List EPat))
  (PLit ELit))

;; ---------------------------------------------------------------------
;; TERMS. Locally nameless: EBVar 0 is the innermost binding (a fn's last
;; parameter, the last variable a pattern bound, the last binding of a
;; let). Four head kinds are four constructors: the classifier resolved
;; each head to exactly one of them, all saturated.
(type ETerm
  (EBVar Int)  ; a parameter or pattern/let variable
  (ELit ELit)
  (ECtor Name (List ETerm))  ; a constructor of an E-eligible inductive, applied to its fields
  (ECall Name (List ETerm))  ; an E function (EFn, or an ESig linked at run time)
  (EPrim Name (List ETerm))  ; a primitive of the fixed table, by identity
  (EExt Name (List ETerm))  ; a World extern — `ev` is pure and stops here; `run` performs it
  (EMatch ETerm (List EArm))  ; first arm whose pattern matches; no arm = stuck
  (ELet (List ETerm) ETerm)  ; SEQUENTIAL: each rhs sees the bindings before it; pushed in order
  (EIf ETerm ETerm ETerm)  ; then-branch iff the condition's cell is the SECOND constructor of its type
  (ELam (List EType) (Option EType) ETerm)  ; a lambda written as a template's static argument: its binders' types, its result type once the body is typed, its body under the binders — in a body as read only: the classifier lifts it to a fn where it takes the instance, and no program holds one
  (EAbsurd))  ; a refuted row — Init's `absurd` or `False.elim` in a body read on the typed route: unreachable, stuck if reached
;; RULES of `ev` per node: arguments left to right; a
;; call evaluates the callee's body in a fresh frame of exactly its
;; argument values with one unit of fuel less; a primitive's guard
;; failure (the bare-named `/` at zero, a shift out of range) is stuck,
;; never a value; `if` is the tag rule — Bool.true and Decidable.isTrue
;; are both the second constructor — which is what "a
;; decision tag with erased payload" means at run time.

(type EArm (EArm EPat ETerm))

;; ---------------------------------------------------------------------
;; RECURSION STRUCTURE. `ev` needs none of it — fuel bounds every run —
;; but the descent check of a supplied `realize` does (realize.shard).
(type ERec
  (RecNone)  ; no measure clause
  (RecStruct Int)  ; (measure (struct x)): structural on parameter i (0-based)
  (RecMeasure ETerm)  ; (measure E): a term over the parameters
  (RecLogical))  ; (measure E) where E has no program: it cites a function that is a definition and nothing more — a derived size. The descent is K's alone, the definition's obligations

;; ---------------------------------------------------------------------
;; DECLARATIONS.
(type ECtorDef (ECtorDef Name (List EType)))  ; constructor identity, field types over ETVar 0..nparams-1

(fn fields_of ((cs (List ECtorDef)) (c Name)) (Option (List EType))
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons (ECtorDef d fts) r) (if (name_eq c d) (some fts) (fields_of r c)))))

(type EDecl
  (EInd Name Int (List ECtorDef))  ; an E-eligible inductive: identity, nparams, constructors
  (EFn Name Int (List EType) EType ERec ETerm)  ; identity, ntparams, parameter types, return type, recursion, body
  (EExtern Name Int (List EType) EType)  ; a World extern: identity, ntparams, parameter types, return type
  (ESig Name Int (List EType) EType)  ; a view's `sig fn`: a signature `run` links to an EFn
  (ESigType Name Int))  ; a view's `sig type`: identity and arity, no constructors
;; RULES: identities are unique across a Prog (the loader's scope, K's
;; check_name for the L twins); an ECall's target is an EFn or an ESig
;; of the same arity; an ECtor's constructor belongs to an EInd and is
;; applied to exactly its fields; a consumer's body never names an
;; ESigType's constructor (the private-equality leak, refused at
;; classification); a call to an ESig is stuck (`unlinked`) — the
;; implementation check substitutes the implementation's EFn under the
;; same identity, which is the link.

(type Prog (Prog (List EDecl)))

;; ---------------------------------------------------------------------
;; VALUES and RESULTS. A value is closed data: `ev` values carry no
;; index (the bootstrap's invariant, eval.rs). Nat and Int are both
;; VInt; a Bool is the cell (VCtor Bool.true Nil).
(type Val (VCtor Name (List Val)) (VInt Int))

(type EvRes
  (EvOk Val)
  (EvOut)  ; fuel exhausted — never a value, never a refusal
  (EvExhausted Symbol Name)  ; a primitive's resource exhausted (nat_size, nat_count), the function — like EvOut, never a refusal
  (EvStuck Symbol Name))  ; reason (no_arm, guard, unbound, extern, unknown_head), subject (the function)

;; ---------------------------------------------------------------------
;; the call heads of a body, first occurrence first (the loader: a realization's inherited
;; obligations)
(fn calls_of ((t ETerm)) (List Name) (rev (calls_acc t nil)))
(fn calls_acc ((t ETerm) (acc (List Name))) (List Name)
  (measure (struct t))
  (match t
    ((EBVar _) acc)
    ((ELit _) acc)
    ((ECtor _ as) (calls_all as acc))
    ((ECall f as) (calls_all as (cons f acc)))
    ((EPrim _ as) (calls_all as acc))
    ((EExt _ as) (calls_all as acc))
    ((EMatch s arms) (calls_arms arms (calls_acc s acc)))
    ((ELet rs b) (calls_acc b (calls_all rs acc)))
    ((EIf a b c) (calls_acc c (calls_acc b (calls_acc a acc))))
    ((ELam _ _ b) (calls_acc b acc))
    (EAbsurd acc)))
(fn calls_all ((ts (List ETerm)) (acc (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (nil acc)
    ((cons t r) (calls_all r (calls_acc t acc)))))
(fn calls_arms ((arms (List EArm)) (acc (List Name))) (List Name)
  (measure (struct arms))
  (match arms
    (nil acc)
    ((cons (EArm _ b) r) (calls_arms r (calls_acc b acc)))))
;; the identity of a declaration, and lookup by identity (name.shard's
;; structural equality; `ev` may index a Prog however it likes — no
;; representation is mandated).
(fn edecl_name ((d EDecl)) Name
  (match d
    ((EInd n _ _) n)
    ((EFn n _ _ _ _ _) n)
    ((EExtern n _ _ _) n)
    ((ESig n _ _ _) n)
    ((ESigType n _) n)))

(fn prog_find ((p Prog) (n Name)) (Option EDecl)
  (match p
    ((Prog ds) (prog_find_in ds n))))

(fn prog_find_in ((ds (List EDecl)) (n Name)) (Option EDecl)
  (measure (struct ds))
  (match ds
    (nil none)
    ((cons d r) (if (name_eq (edecl_name d) n) (some d) (prog_find_in r n)))))
;; declarations by identity: an index keyed by the name's hash, the newest first under one
;; name — an identity registered again overrides (the E table's, etable.shard; a checked
;; handle's inductives, ev.shard)
(fn decl_index_add ((x (IntMap (List (Prod Name EDecl)))) (d EDecl))
  (IntMap (List (Prod Name EDecl)))
  (let ((n (edecl_name d)))
    (let ((h (name_key n)))
      (im_insert x h
        (cons (Prod.mk n d)
          (match (im_find x h)
            ((some b) b)
            (none nil)))))))
(fn decl_index_find ((x (IntMap (List (Prod Name EDecl)))) (n Name)) (Option EDecl)
  (match (im_find x (name_key n))
    (none none)
    ((some b) (assoc_decl b n))))
(fn assoc_decl ((b (List (Prod Name EDecl))) (n Name)) (Option EDecl)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk k d) r) (if (name_eq k n) (some d) (assoc_decl r n)))))
;; an E type as text: `Int`, `(List Int)`, a type parameter by position as `Ti`
(fn show_etype ((t EType)) (List Int)
  (measure (struct t))
  (match t
    ((ETVar i) (cons 84 (show_nat i)))
    ((ETCon n nil) (show_name n))
    ((ETCon n as) (append (utf8 "(") (append (show_name n) (append (show_etypes as) (utf8 ")")))))))
(fn show_etypes ((ts (List EType))) (List Int)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (cons 32 (append (show_etype t) (show_etypes r))))))

;; ---------------------------------------------------------------------
;; THE PRIMITIVE TABLE: identity → (operation code,
;; arity). The toolchain's bare names and Init's spellings where
;; the meaning differs (`/` stuck at zero and `Int.tdiv` total are two
;; entries); ev.shard implements the codes, classify.shard resolves heads
;; against the identities. The comparisons are `= < <=`; the spellings `int_eq lt le` are
;; refused with the one to write (scope.shard `renamed_prim`).
(type Prim (Prim Int Int))
(fn prim_table () (List (Prod Name Prim))
  (list (Prod.mk (n1 (sym "=")) (Prim 0 2)) (Prod.mk (n1 (sym "+")) (Prim 1 2))
    (Prod.mk (n1 (sym "-")) (Prim 2 2))
    (Prod.mk (n1 (sym "<")) (Prim 3 2))
    (Prod.mk (n1 (sym "<=")) (Prim 4 2))
    (Prod.mk (n1 (sym "band")) (Prim 6 2))
    (Prod.mk (n1 (sym "bshr")) (Prim 7 2))
    (Prod.mk (n1 (sym "*")) (Prim 8 2))
    (Prod.mk (n1 (sym "mod")) (Prim 9 2))
    (Prod.mk (n1 (sym "/")) (Prim 10 2))
    (Prod.mk (n1 (sym "tmod")) (Prim 11 2))
    (Prod.mk (n1 (sym "ediv")) (Prim 12 2))
    (Prod.mk (n1 (sym "bor")) (Prim 13 2))
    (Prod.mk (n1 (sym "bxor")) (Prim 14 2))
    (Prod.mk (n1 (sym "bshl")) (Prim 15 2))
    (Prod.mk (n2 (sym "Int") (sym "tdiv")) (Prim 18 2))
    (Prod.mk (n2 (sym "Int") (sym "tmod")) (Prim 19 2))
    (Prod.mk (n2 (sym "Int") (sym "ediv")) (Prim 20 2))
    (Prod.mk (n2 (sym "Int") (sym "emod")) (Prim 21 2))
    (Prod.mk (n2 (sym "Nat") (sym "sub")) (Prim 22 2))
    (Prod.mk (n2 (sym "Nat") (sym "land")) (Prim 23 2))
    (Prod.mk (n2 (sym "Nat") (sym "lor")) (Prim 24 2))
    (Prod.mk (n2 (sym "Nat") (sym "xor")) (Prim 25 2))
    (Prod.mk (n2 (sym "Nat") (sym "shiftLeft")) (Prim 26 2))
    (Prod.mk (n2 (sym "Nat") (sym "shiftRight")) (Prim 27 2))
    (Prod.mk (n2 (sym "Nat") (sym "add")) (Prim 28 2))
    (Prod.mk (n2 (sym "Nat") (sym "mul")) (Prim 29 2))
    (Prod.mk (n2 (sym "Nat") (sym "div")) (Prim 30 2))
    (Prod.mk (n2 (sym "Nat") (sym "mod")) (Prim 31 2))
    (Prod.mk (n2 (sym "Nat") (sym "gcd")) (Prim 32 2))
    (Prod.mk (n2 (sym "Nat") (sym "pow")) (Prim 33 2))
    (Prod.mk (n2 (sym "Nat") (sym "beq")) (Prim 34 2))
    (Prod.mk (n2 (sym "Nat") (sym "ble")) (Prim 35 2))
    (Prod.mk (n2 (sym "Nat") (sym "decEq")) (Prim 36 2))
    (Prod.mk (n2 (sym "Nat") (sym "decLt")) (Prim 37 2))
    (Prod.mk (n2 (sym "Nat") (sym "decLe")) (Prim 38 2))))
;; the L identity of an entry: Init's spellings (18 and up) are L constants under their own
;; names; the bare names (0–17) have none
(fn prim_l_identity ((n Name)) (Option Name)
  (match (prim_find n)
    ((some (Prim code _)) (if (< code 18) none (some n)))
    (none none)))
;; K's accelerated Nat set: the entries whose operands are Nat and whose result is
;; Nat (28–33 with Nat.sub and the bitwise five), Init's Bool (34, 35) or a Decidable (36–38)
(fn prim_nat_bool ((code Int)) Bool (bool_or (= code 34) (= code 35)))
(fn prim_decidable ((code Int)) Bool (bool_and (<= 36 code) (<= code 38)))
(fn prim_find ((n Name)) (Option Prim) (prim_assoc (prim_table) n))
(fn prim_assoc ((t (List (Prod Name Prim))) (n Name)) (Option Prim)
  (measure (struct t))
  (match t
    (nil none)
    ((cons (Prod.mk k p) r) (if (name_eq k n) (some p) (prim_assoc r n)))))
;; the first candidate the table knows (the scope's candidates, the bare citation last)
(fn prim_of ((cands (List Name))) (Option (Prod Name Prim))
  (measure (struct cands))
  (match cands
    (nil none)
    ((cons c r)
     (match (prim_find c)
       ((some p) (some (Prod.mk c p)))
       (none (prim_of r))))))
;; a primitive's result type head: Bool for the bare-named decisions and Nat.beq/ble, Nat for
;; the Nat set, Decidable for Nat.decEq/decLt/decLe, else Int
(fn prim_result ((code Int)) EType
  (if (bool_or (= code 0) (bool_or (= code 3) (= code 4))) (ETCon (cell_bool) nil)
  (if (prim_nat_bool code) (ETCon (n1 (sym "Bool")) nil)
  (if (prim_decidable code) (ETCon (n1 (sym "Decidable")) nil)
  (if (bool_and (<= 22 code) (<= code 33)) (ETCon (n1 (sym "Nat")) nil)
  (ETCon (n1 (sym "Int")) nil))))))

;; the realization registry's Int rows: a resolved L operation → the table's
;; entry. ev's integer operation and K's constant agree on every input for these; the
;; decisions answer a two-constructor cell, which is all an `if` reads (decide converts)
(fn realization_of ((c Name)) (Option Name)
  (if (name_eq c (n2 (sym "Int") (sym "add"))) (some (n1 (sym "+")))
  (if (name_eq c (n2 (sym "Int") (sym "sub"))) (some (n1 (sym "-")))
  (if (name_eq c (n2 (sym "Int") (sym "mul"))) (some (n1 (sym "*")))
  (if (name_eq c (n2 (sym "Int") (sym "decEq"))) (some (n1 (sym "=")))
  (if (name_eq c (n2 (sym "Int") (sym "decLt"))) (some (n1 (sym "<")))
  (if (name_eq c (n2 (sym "Int") (sym "decLe")))
    (some (n1 (sym "<=")))
    ;; Nat's five that are the integer entry's own operation on naturals: one entry, the
    ;; spelling the classifier gives `+ * = < <=` (frontend parity stays byte for byte);
    ;; Nat.sub, Nat.div, Nat.mod differ from `- / mod` and keep their own entries
    (if (name_eq c (n2 (sym "Nat") (sym "add"))) (some (n1 (sym "+")))
    (if (name_eq c (n2 (sym "Nat") (sym "mul"))) (some (n1 (sym "*")))
    (if (name_eq c (n2 (sym "Nat") (sym "decEq"))) (some (n1 (sym "=")))
    (if (name_eq c (n2 (sym "Nat") (sym "decLt"))) (some (n1 (sym "<")))
    (if (name_eq c (n2 (sym "Nat") (sym "decLe")))
      (some (n1 (sym "<=")))
      ;; the bit-level five at Int: Init's two shifts, and the base's three (base.shard), the
      ;; one native declaration a row speaks for. The engine's operation is two's complement
      ;; on integers of any size and a shift by any count that is a natural number
      (if (name_eq c (n2 (sym "Int") (sym "shiftLeft"))) (some (n1 (sym "bshl")))
      (if (name_eq c (n2 (sym "Int") (sym "shiftRight"))) (some (n1 (sym "bshr")))
      (if (name_eq c (base_op (sym "land"))) (some (n1 (sym "band")))
      (if (name_eq c (base_op (sym "lor"))) (some (n1 (sym "bor")))
      (if (name_eq c (base_op (sym "xor"))) (some (n1 (sym "bxor")))
      none)))))))))))))))))
;; a registry row's signature as a function's: the two operands at the constant's own type,
;; the result that type — a decision's, Decidable's cell. What a static argument that names the
;; constant is typed by (classify.shard take_args)
(fn registry_signature ((c Name)) (Option (Prod (List EType) EType))
  (match (realization_of c)
    (none none)
    ((some p)
     (let
       ((ty
          (ETCon
            (match c
              ((Str (Str Anon t) _) (n1 t))
              (_ (n1 (sym "Int"))))
            nil)))
       (some
         (Prod.mk (list ty ty)
           (if
             (bool_or (name_eq p (n1 (sym "=")))
               (bool_or (name_eq p (n1 (sym "<"))) (name_eq p (n1 (sym "<=")))))
             (ETCon (n1 (sym "Decidable")) nil)
             ty)))))))
;; the registry's expression rows: a one-argument L operation with no
;; table entry of its own, as an E expression over the existing entries with the argument
;; bound once (#0) — it agrees with K's constant on every input, as the rows above do
(fn realization_expr ((c Name)) (Option ETerm)
  (if (name_eq c (n2 (sym "Int") (sym "natAbs")))  ; |n|: (if (< n 0) (- 0 n) n)
    (some
      (EIf (EPrim (n1 (sym "<")) (list (EBVar 0) (ELit (LNat 0))))
        (EPrim (n1 (sym "-")) (list (ELit (LNat 0)) (EBVar 0)))
        (EBVar 0)))
    none))
;; an expression row's result type, and the one row that is the identity: `Int.ofNat` (Nat and
;; Int share the integer). A reader that has no elaborated term keeps a row's head as a
;; primitive of this name while it types the body, and writes the row's expression last
;; (classify.shard settle_ops, expand_rows)
(fn realization_type ((c Name)) (Option EType)
  (if (name_eq c (n2 (sym "Int") (sym "natAbs"))) (some (ETCon (n1 (sym "Nat")) nil))
  (if (name_eq c (n2 (sym "Int") (sym "ofNat"))) (some (ETCon (n1 (sym "Int")) nil))
  (if (name_eq c (n2 (sym "Fin") (sym "val"))) (some (ETCon (n1 (sym "Nat")) nil))
  none))))
;; a row whose field is at another type than the row itself: its projection is the identity
;; on the value and is kept by name while a body is typed — `Fin.val i` is a Nat, `Subtype.val
;; s` is at the subtype's base — and written out as its argument last, as `Int.ofNat` is
(fn row_field_proj ((sn Name)) (Option Name)
  (if (name_eq sn (n1 (sym "Fin"))) (some (n2 (sym "Fin") (sym "val")))
  (if (name_eq sn (n1 (sym "Subtype"))) (some (n2 (sym "Subtype") (sym "val")))
  none)))
(fn row_identity ((p Name)) Bool
  (bool_or (name_eq p (n2 (sym "Int") (sym "ofNat")))
    (bool_or (name_eq p (n2 (sym "Fin") (sym "val"))) (name_eq p (n2 (sym "Subtype") (sym "val"))))))
;; Init's Bool cells: what a decision's value converts to, and what the Bool connectives' rows
;; are built of
(fn bool_true () ETerm (ECtor (n2 (sym "Bool") (sym "true")) nil))
(fn bool_false () ETerm (ECtor (n2 (sym "Bool") (sym "false")) nil))
;; Decidable's two cells: what a decision is where it is a value
(fn dec_true () ETerm (ECtor (n2 (sym "Decidable") (sym "isTrue")) nil))
(fn dec_false () ETerm (ECtor (n2 (sym "Decidable") (sym "isFalse")) nil))
;; `a = b` at Init's Bool as the test an `if` reads: `a` where b is `true` (and symmetrically),
;; else (if a b (if b false true)) — b read once on either path
(fn bool_eq_cond ((a ETerm) (b ETerm)) ETerm
  (if (is_bool_true b) a
  (if (is_bool_true a) b
  (EIf a b (EIf b (bool_false) (bool_true))))))
(fn is_bool_true ((t ETerm)) Bool
  (match t
    ((ECtor c nil) (name_eq c (n2 (sym "Bool") (sym "true"))))
    (_ false)))

;; ---------------------------------------------------------------------
;; THE RUNTIME'S CELLS: Init's constructors, by identity. A comparison answers in Bool's,
;; a symbol's bytes are a List's, a host call's values are built of all four types'.
(fn cell_list () Name (n1 (sym "List")))
(fn cell_bool () Name (n1 (sym "Bool")))
(fn cell_option () Name (n1 (sym "Option")))
(fn cell_prod () Name (n1 (sym "Prod")))
(fn cell_nil () Name (n2 (sym "List") (sym "nil")))
(fn cell_cons () Name (n2 (sym "List") (sym "cons")))
(fn cell_false () Name (n2 (sym "Bool") (sym "false")))
(fn cell_true () Name (n2 (sym "Bool") (sym "true")))
(fn cell_none () Name (n2 (sym "Option") (sym "none")))
(fn cell_some () Name (n2 (sym "Option") (sym "some")))
(fn cell_mk () Name (n2 (sym "Prod") (sym "mk")))
;; k variable patterns: a constructor's runtime fields, all bound (classify.shard, erasure.shard)
(fn pvars ((k Int)) (List EPat)
  (measure (Int.natAbs k))
  (if (< k 1) nil (cons PVar (pvars (- k 1)))))
(fulfills pvars.dec_1 (by (intro k h) (apply natAbs_pred (arith))))
