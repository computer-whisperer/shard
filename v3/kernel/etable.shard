;;; v3/kernel/etable.shard — the E table: every E
;;; identity findable by any suffix of its spelling (`hex_val`,
;;; `json.hex_val`, `kernel.json.hex_val`), pre-registered per file before
;;; any body is read so that a body may cite what its file declares later;
;;; an identity registered again overrides (the implementation check's
;;; substitution, the link). Resolution: the visible hits among
;;; the scope's candidates — one rule for every file. Apart from
;;; classify.shard so that erase.shard (Init's inductives as
;;; E types) can register into it below the classifier.
(import "scope.shard")
(import "prog.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.intmap)
(use kernel.name)
(use kernel.prog)
(use kernel.scope)
(use kernel.util)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.EType)
(use kernel.prog.Prog)
(use kernel.scope.Open)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
;; ---- the E table ----------------------------------------------------------------------
;; a template's written binder as the E-first reader takes it:
;; a static parameter's domains and result as E types over the template's type parameters,
;; a data parameter's E type, a package parameter (no E value: the typed route's)
(type EBind (EBStatic (List EType) EType) (EBData EType) (EBPackage))
(type EInfo
  (EICtor Name Int Int)  ; its inductive, its ordinal, its field count
  (EIInd Int (List Name))  ; parameter count, constructors in order
  (EIFn Int)  ; parameter count
  (EISig Int)  ; a view's sig fn: parameter count
  (EIExt Int)  ; an extern: parameter count
  (EISigType Int)  ; a view's sig type: arity
  (EITemplate Int (List EBind) EType Int))  ; a template: its static parameters' count, its written binders' E signatures, its result, its type parameters' count — an E-first body takes an instance by them; no program of its own — its instances have them
(type EEnt (EEnt Name Name Name EInfo))  ; suffix, identity, module, info
;; declarations (reversed), the suffix table, the declarations by identity.
;; An identity registered again overrides (newest first): the implementation
;; check's fork substitutes the implementation's fn and type under the view's
;; sig fn and sig type, and its merge into the main line does the
;; same — that substitution is the link `run` needs.
(type ESt (ESt (List EDecl) (IntMap (List EEnt)) (IntMap (List (Prod Name EDecl)))))
(fn es0 () ESt (ESt nil IMEmpty IMEmpty))
(fn es_decls ((e ESt)) (List EDecl)
  (match e
    ((ESt ds _ _) (rev ds))))
;; how many declarations the table holds, and the k newest, newest first — a file's own, from
;; the count at its start (for the threading verdicts at the file's end)
(fn es_count ((e ESt)) Int
  (match e
    ((ESt ds _ _) (len ds))))
(fn es_newest ((e ESt) (k Int)) (List EDecl)
  (match e
    ((ESt ds _ _) (take k ds))))
(fn es_tbl ((e ESt)) (IntMap (List EEnt))
  (match e
    ((ESt _ t _) t)))
(fn es_idx ((e ESt)) (IntMap (List (Prod Name EDecl)))
  (match e
    ((ESt _ _ x) x)))
;; the program: the declarations in order, a sig fn or sig type dropped where
;; the implementation was substituted under its identity
(fn es_prog ((e ESt)) Prog (Prog (live_decls e (es_decls e))))
(fn live_decls ((e ESt) (ds (List EDecl))) (List EDecl)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons (ESig n a b c) r)
     (match (es_find_decl e n)
       ((some (ESig _ _ _ _)) (cons (ESig n a b c) (live_decls e r)))
       (_ (live_decls e r))))
    ((cons (ESigType n a) r)
     (match (es_find_decl e n)
       ((some (ESigType _ _)) (cons (ESigType n a) (live_decls e r)))
       (_ (live_decls e r))))
    ((cons d r) (cons d (live_decls e r)))))

;; a name's components as one-step names, outermost first; its suffixes on component boundaries
(fn name_steps ((n Name)) (List Name)
  (measure (struct n))
  (match n
    (Anon nil)
    ((Str p s) (append (name_steps p) (list (Str Anon s))))
    ((Num p k) (append (name_steps p) (list (Num Anon k))))))
(fn join_steps ((ss (List Name)) (acc Name)) Name
  (measure (struct ss))
  (match ss
    (nil acc)
    ((cons s r) (join_steps r (name_append acc s)))))
(fn suffixes_of ((ss (List Name))) (List Name)
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons _ r) (cons (join_steps ss Anon) (suffixes_of r)))))
(fn name_suffixes ((n Name)) (List Name) (suffixes_of (name_steps n)))

;; register an identity under every suffix
(fn es_register ((e ESt) (id Name) (m Name) (info EInfo)) ESt
  (match e
    ((ESt ds t x) (ESt ds (tbl_put_all t (name_suffixes id) id m info) x))))
(fn tbl_put_all ((t (IntMap (List EEnt))) (sufs (List Name)) (id Name) (m Name) (info EInfo))
  (IntMap (List EEnt))
  (measure (struct sufs))
  (match sufs
    (nil t)
    ((cons s r)
     (let ((h (name_key s)))
       (tbl_put_all
         (im_insert t h
           (cons (EEnt s id m info)
             (match (im_find t h)
               ((some b) b)
               (none nil))))
         r
         id
         m
         info)))))
;; every entry whose suffix is the citation — the newest per identity
(fn es_hits ((e ESt) (n Name)) (List EEnt)
  (match (im_find (es_tbl e) (name_key n))
    (none nil)
    ((some b) (hits_with b n nil))))
(fn hits_with ((b (List EEnt)) (n Name) (seen (List Name))) (List EEnt)
  (measure (struct b))
  (match b
    (nil nil)
    ((cons (EEnt s id m i) r)
     (if (bool_and (name_eq s n) (bool_not (mem_name id seen)))
       (cons (EEnt s id m i) (hits_with r n (cons id seen)))
       (hits_with r n seen)))))
;; the entry registered under an identity's full spelling
(fn es_info ((e ESt) (id Name)) (Option EInfo)
  (match (full_entry (es_hits e id) id)
    ((some (EEnt _ _ _ i)) (some i))
    (none none)))
;; the module an identity was registered under (its tag)
(fn es_module ((e ESt) (id Name)) (Option Name)
  (match (full_entry (es_hits e id) id)
    ((some (EEnt _ _ m _)) (some m))
    (none none)))
(fn full_entry ((b (List EEnt)) (id Name)) (Option EEnt)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (EEnt s i m x) r) (if (name_eq i id) (some (EEnt s i m x)) (full_entry r id)))))
(fn es_has ((e ESt) (id Name)) Bool
  (match (es_info e id)
    ((some _) true)
    (none false)))

;; a declaration reached: recorded, findable by identity
(fn es_add_decl ((e ESt) (d EDecl)) ESt
  (match e
    ((ESt ds t x) (ESt (cons d ds) t (decl_index_add x d)))))
(fn es_find_decl ((e ESt) (n Name)) (Option EDecl) (decl_index_find (es_idx e) n))
;; the info a declaration registers (the fork's declarations merged into the main line)
(fn decl_infos ((d EDecl)) (List (Prod Name EInfo))
  (match d
    ((EInd n np cs) (cons (Prod.mk n (EIInd np (ector_names cs))) (ctor_infos n cs 0)))
    ((EFn n _ ps _ _ _) (list (Prod.mk n (EIFn (len ps)))))
    ((EExtern n _ ps _) (list (Prod.mk n (EIExt (len ps)))))
    ((ESig n _ ps _) (list (Prod.mk n (EISig (len ps)))))
    ((ESigType n a) (list (Prod.mk n (EISigType a))))))
(fn ector_names ((cs (List ECtorDef))) (List Name)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (ECtorDef c _) r) (cons c (ector_names r)))))
(fn ctor_infos ((ind Name) (cs (List ECtorDef)) (i Int)) (List (Prod Name EInfo))
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (ECtorDef c fs) r) (cons (Prod.mk c (EICtor ind i (len fs))) (ctor_infos ind r (+ i 1))))))
(fn es_register_all ((e ESt) (m Name) (infos (List (Prod Name EInfo)))) ESt
  (measure (struct infos))
  (match infos
    (nil e)
    ((cons (Prod.mk n i) r) (es_register_all (es_register e n m i) m r))))
;; the fork's state merged into the main line: its declarations the main line
;; lacks, and its fn / type under a sig fn / sig type the main line holds (the substitution)
(fn es_merge ((main ESt) (fork ESt)) ESt (es_merge_decls main (es_decls fork) (es_tbl fork)))
(fn es_merge_decls ((main ESt) (ds (List EDecl)) (ftbl (IntMap (List EEnt)))) ESt
  (measure (struct ds))
  (match ds
    (nil main)
    ((cons d r)
     (let ((n (edecl_name d)))
       (if (substitutes main n d)
         (es_merge_decls (es_add_decl (es_register_all main (entry_module ftbl n) (decl_infos d)) d)
           r
           ftbl)
         (es_merge_decls main r ftbl))))))
;; d takes the identity n in main: n is new, or main holds a sig fn and d is a fn, a sig type and d a type
(fn substitutes ((main ESt) (n Name) (d EDecl)) Bool
  (match (es_find_decl main n)
    (none true)
    ((some (ESig _ _ _ _))
     (match d
       ((EFn _ _ _ _ _ _) true)
       (_ false)))
    ((some (ESigType _ _))
     (match d
       ((EInd _ _ _) true)
       (_ false)))
    (_ false)))
(fn entry_module ((t (IntMap (List EEnt))) (id Name)) Name
  (match (im_find t (name_key id))
    (none Anon)
    ((some b)
     (match (full_entry b id)
       ((some (EEnt _ _ m _)) m)
       (none Anon)))))

;; ---- resolution ----------------------------------------------------------------------------
(type EHit (EHit Name Name EInfo))  ; identity, module, info
(fn eresolve ((es ESt) (sc Scope) (n Name)) (List EHit)
  (let ((cited (if (init_prefixed n) (drop_init n) n)))  ; `Init.NAME` cites the imported NAME
    (hits_in_scope (es_hits es cited) sc n cited)))
;; a hit is in scope when the citation names it under the scope's candidates — the module's own
;; prefix, an opened prefix, the bare name, `Init.NAME` — decided structurally on the hit's
;; identity (its prefix above the cited suffix) rather than by building every candidate name
;; (with fifty opened prefixes per toolchain file that construction is the load's cost)
(fn hits_in_scope ((hs (List EEnt)) (sc Scope) (n Name) (cited Name)) (List EHit)
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (EEnt _ id m i) r)
     (if (bool_and (mod_visible sc m) (cited_in_scope sc n cited id))
       (cons (EHit id m i) (hits_in_scope r sc n cited))
       (hits_in_scope r sc n cited)))))
(fn cited_in_scope ((sc Scope) (n Name) (cited Name) (id Name)) Bool
  (match (name_above id cited)
    (none false)
    ((some pre)
     (if (init_prefixed n)
       (match pre
         (Anon true)
         (_ false))  ; `Init.NAME`: the bare imported name only
       (match pre
         (Anon true)  ; the bare name
         (_ (bool_or (name_eq pre (sc_module sc)) (opened_has (sc_opened sc) pre n))))))))
;; the identity's prefix above the cited suffix: `kernel.json.hex_val` above `json.hex_val` is `kernel`
(fn name_above ((id Name) (suffix Name)) (Option Name)
  (measure (struct suffix))
  (match suffix
    (Anon (some id))
    ((Str sp ss)
     (match id
       ((Str ip is) (if (sym_eq is ss) (name_above ip sp) none))
       (_ none)))
    ((Num sp sk)
     (match id
       ((Num ip ik) (if (= ik sk) (name_above ip sp) none))
       (_ none)))))
(fn opened_has ((ps (List Open)) (pre Name) (n Name)) Bool
  (measure (struct ps))
  (match ps
    (nil false)
    ((cons (OpenAll p) r) (if (name_eq p pre) true (opened_has r pre n)))
    ((cons (OpenSome p ms) r)
     (if (bool_and (name_eq p pre) (first_component_in n ms)) true (opened_has r pre n)))))
(fn mod_visible ((sc Scope) (m Name)) Bool
  (match (sc_vis sc)
    (VisAll true)
    ((VisOnly mods _ _ _ _) (if (name_eq m (init_module)) true (mem_name m mods)))))
;; the module an Init inductive registers under: visible from every file
(fn init_module () Name (n1 (quote Init)))
(fn only_ctors ((hs (List EHit))) (List EHit)
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (EHit id m (EICtor a b c)) r) (cons (EHit id m (EICtor a b c)) (only_ctors r)))
    ((cons _ r) (only_ctors r))))
;; the hits a term position sees: constructors, functions, sig fns, externs — never a type
(fn only_values ((hs (List EHit))) (List EHit)
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (EHit id m (EIInd a b)) r) (only_values r))
    ((cons (EHit id m (EISigType a)) r) (only_values r))
    ((cons h r) (cons h (only_values r)))))
(fn only_types ((hs (List EHit))) (List EHit)
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (EHit id m (EIInd a b)) r) (cons (EHit id m (EIInd a b)) (only_types r)))
    ((cons (EHit id m (EISigType a)) r) (cons (EHit id m (EISigType a)) (only_types r)))
    ((cons _ r) (only_types r))))
(fn ambiguous_msg ((n Name) (a Name) (b Name)) (List Int)
  (append (show_name n) (append ": " (append (show_name a) (append " and " (show_name b))))))


;; ---- an instance's name ----------------------------------------------------------------------
;; the template flattened with its type arguments (derive's precedent,
;; std.derive.List_UInt8.decEq), `of`, then each shape as its identity flattened and its
;; captured count — under the taking module; one formula for both routes (erasure.shard's
;; instance_name over shapes, classify.shard's take_instance over an E-first body's)
(fn instance_name_of ((sc Scope) (c Name) (tye (List EType)) (shapes (List (Prod Name Int)))) Name
  (name_append (qualify sc (n2 (sym_of_chars (append (flat_name c) (flat_etys tye))) (quote of)))
    (shape_name_chain shapes)))
(fn shape_name_chain ((ss (List (Prod Name Int)))) Name
  (measure (struct ss))
  (match ss
    (nil Anon)
    ((cons (Prod.mk g k) r)
     (name_append (n1 (sym_of_chars (append (flat_name g) (cons 95 (show_nat k)))))
       (shape_name_chain r)))))
(fn flat_name ((n Name)) (List Int) (flat_chars (show_name n)))
(fn flat_chars ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r) (cons (if (= c 46) 95 c) (flat_chars r)))))
(fn flat_etys ((ts (List EType))) (List Int)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (append (cons 95 (flat_ety t)) (flat_etys r)))))
(fn flat_ety ((t EType)) (List Int)
  (measure (struct t))
  (match t
    ((ETVar i) (cons 84 (show_nat i)))
    ((ETCon n as) (append (flat_name n) (flat_etys as)))))
