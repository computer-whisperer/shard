;;; v3/kernel/classify.shard — the fragment classifier: the E forms `fn`,
;;; `extern`, `type`, `sig fn` and `sig type` read
;;; into prog.shard's data with every head resolved to one identity and one
;;; kind, saturated, no function name in argument position, every `match`
;;; exhaustive by the pattern matrix, the private-equality leak refused where
;;; the scrutinee's static type is a `sig type`. Reading IS
;;; classifying: nothing reaches `ev` unresolved.
;;;
;;; The E table (ESt) is the loader's: every E identity findable by any
;;; suffix of its spelling (`hex_val`, `json.hex_val`, `kernel.json.hex_val`),
;;; pre-registered from a file's forms before any body is read so that a
;;; body may cite what its file declares later. Resolution (etable.shard's
;;; eresolve): the hits in a visible module that the citation names among the
;;; scope's candidates. The primitive table is prog.shard's, keyed on identity.

(import "etable.shard")
(import "erase.shard")
(use kernel.k)
(use kernel.erase)
(use kernel.kw)
(use kernel.etable)
(use kernel.etable.EBind)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.prelude)
(use kernel.prog)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.etable.EHit)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.Prim)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)

;; ---- pre-registration ----------------------------------------------------------------
;; a file's E heads — name, kind, arity, a type's constructors — before any body
(type PreRes (PreOk ESt) (PreErr Symbol (List Int)))
(fn pre_register ((es ESt) (sc Scope) (env CheckedEnv) (forms (List SExpr))) PreRes
  (measure (struct forms))
  (match forms
    (Nil (PreOk es))
    ((Cons s r)
     (match (pre_one es sc env s)
       ((PreErr e m) (PreErr e m))
       ((PreOk es1) (pre_register es1 sc env r))))))
(fn pre_one ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) PreRes
  (match s
    ((SList (Cons (SSym h) args))
     (if (sym_eq h (quote fn)) (pre_head es sc args (quote fn))
     (if (sym_eq h (quote extern)) (pre_head es sc args (quote extern))
     (if (sym_eq h (quote realize)) (pre_realize es sc env args)
     (if (sym_eq h (quote type)) (pre_type es sc args)
     (if (sym_eq h (quote sig))
       (match args
         ((Cons (SSym k) rest)
          (if (sym_eq k (quote fn)) (pre_head es sc rest (quote sig))
          (if (sym_eq k (quote type))
            (match rest
              ((Cons hd Nil) (pre_sig_type es sc hd))
              (_ (PreOk es)))
            (PreOk es))))
         (_ (PreOk es)))
       (PreOk es)))))))
    (_ (PreOk es))))
;; the realize forms alone, after the file's directives made their targets visible
(fn pre_register_realize ((es ESt) (sc Scope) (env CheckedEnv) (forms (List SExpr))) PreRes
  (measure (struct forms))
  (match forms
    (Nil (PreOk es))
    ((Cons s r)
     (match s
       ((SList (Cons (SSym h) args))
        (if (sym_eq h (quote realize))
          (match (pre_realize es sc env args)
            ((PreErr e m) (PreErr e m))
            ((PreOk es1) (pre_register_realize es1 sc env r)))
          (pre_register_realize es sc env r)))
       (_ (pre_register_realize es sc env r))))))
;; (realize NAME BINDERS RET …) / (realize NAME (view)): the realized constant's identity as a
;; function head — its arity the E binders', or the erasure's for the derived view
(fn pre_realize ((es ESt) (sc Scope) (env CheckedEnv) (args (List SExpr))) PreRes
  (match args
    ((Cons (SSym x) rest)
     (match (name_of_sym x)
       (None (PreErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (resolve (cx0 sc env Nil Nil) n)
          ((RName k _)
           (if (bool_not (may_declare es k True)) (PreErr (quote duplicate_name) (show_name k))
           (match rest
             ((Cons (SList bs) (Cons _ _))
              (PreOk (es_register es k (sc_tag sc) (EIFn (value_binders bs)))))
             (_
               (match (env_find env k)
                 ((Some info)
                  (match (tele_of (w0 env) es sc info)
                    ((TeleOk _ es1 (Tele _ binds _ _))
                     (PreOk (es_register es1 k (sc_tag sc) (EIFn (count_data_binds binds)))))
                    ((TeleErr _ _) (PreOk es))))
                 (None (PreOk es)))))))
          (_ (PreOk es))))))
    (_ (PreOk es))))
(fn count_data_binds ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds
    (Nil 0)
    ((Cons (TBind _ (BData _) _) r) (+ 1 (count_data_binds r)))
    ((Cons _ r) (count_data_binds r))))
;; HEAD BINDERS …: the declared name and its
;; arity — `(T Type)` binders are type parameters, not arguments (read_params)
(fn pre_head ((es ESt) (sc Scope) (args (List SExpr)) (kind Symbol)) PreRes
  (match args
    ((Cons hd (Cons (SList bs) _))
     (match (head_name hd)
       (None (PreErr (quote bad_name) "a declared name is NAME or (NAME T…)"))
       ((Some short)
        (let ((id (qualify sc short)) (k (value_binders bs)))
          (if (bool_not (may_declare es id (sym_eq kind (quote fn))))
            (PreErr (quote duplicate_name) (show_name id))
            (PreOk
              (es_register es id (sc_tag sc)
                (if (sym_eq kind (quote fn)) (EIFn k)
                (if (sym_eq kind (quote extern)) (EIExt k)
                (EISig k))))))))))
    (_ (PreOk es))))
;; an identity may be declared when it is new; a fn may take a sig fn's, a type a sig type's
(fn may_declare ((es ESt) (id Name) (is_fn Bool)) Bool
  (match (es_info es id)
    (None True)
    ((Some (EISig _)) is_fn)
    (_ False)))
(fn may_declare_type ((es ESt) (id Name)) Bool
  (match (es_info es id)
    (None True)
    ((Some (EISigType _)) True)
    (_ False)))
;; the binders that are arguments: all but `(x Type)`
(fn value_binders ((bs (List SExpr))) Int
  (measure (struct bs))
  (match bs
    (Nil 0)
    ((Cons (SList (Cons _ (Cons ty Nil))) r) (+ (if (is_type_sym ty) 0 1) (value_binders r)))
    ((Cons _ r) (+ 1 (value_binders r)))))
(fn head_name ((hd SExpr)) (Option Name)
  (match hd
    ((SSym x) (name_of_sym x))
    ((SList (Cons (SSym x) _)) (name_of_sym x))
    (_ None)))
;; (type HEAD (CTOR F…)…): the inductive with its constructors' ordinals and field counts
(fn pre_type ((es ESt) (sc Scope) (args (List SExpr))) PreRes
  (match args
    ((Cons hd ctors)
     (match (type_head sc hd)
       ((Pair None m) (PreErr (quote bad_name) m))
       ((Pair (Some (Pair n params)) _)
        (if (bool_not (may_declare_type es n)) (PreErr (quote duplicate_name) (show_name n))
        (match (ctor_shapes n ctors 0 Nil)
          (None (PreErr (quote bad_constructor) "a constructor is (CTOR FIELD-TYPE…)"))
          ((Some shapes)
           (PreOk
             (es_register_all
               (es_register es n (sc_tag sc) (EIInd (len params) (shape_names shapes)))
               (sc_tag sc)
               shapes))))))))
    (_ (PreOk es))))
(fn ctor_shapes ((ind Name) (cs (List SExpr)) (i Int) (acc (List (Pair Name EInfo))))
  (Option (List (Pair Name EInfo)))
  (measure (struct cs))
  (match cs
    (Nil (Some (rev acc)))
    ((Cons (SList (Cons (SSym cn) fields)) r)
     (match (name_of_sym cn)
       (None None)
       ((Some short)
        (ctor_shapes ind r (+ i 1)
          (Cons (Pair (name_append ind short) (EICtor ind i (len fields))) acc)))))
    (_ None)))
(fn shape_names ((ss (List (Pair Name EInfo)))) (List Name)
  (measure (struct ss))
  (match ss
    (Nil Nil)
    ((Cons (Pair n _) r) (Cons n (shape_names r)))))
(fn pre_sig_type ((es ESt) (sc Scope) (hd SExpr)) PreRes
  (match (type_head sc hd)
    ((Pair None m) (PreErr (quote bad_name) m))
    ((Pair (Some (Pair n params)) _)
     (if (es_has es n) (PreErr (quote duplicate_name) (show_name n))
     (PreOk (es_register es n (sc_tag sc) (EISigType (len params))))))))

;; ---- E-types ---------------------------------------------------------
;; the type parameters are threaded (`(T Type)` binders, read_params; an unknown name binds none)
(type TyRes (TyOk EType (List Name)) (TyErr Symbol (List Int)))
(fn read_ety ((es ESt) (sc Scope) (env CheckedEnv) (tps (List Name)) (s SExpr)) TyRes
  (match s
    ((SSym x)
     (match (name_of_sym x)
       (None (TyErr (quote bad_type) (chars_of_sym x)))
       ((Some n)
        (match (index_of n tps 0)
          ((Some i) (TyOk (ETVar i) tps))
          (None
            (match (type_ident es sc env n)
              ((TyOk (ETCon id Nil) _) (TyOk (alias_etype es sc env id) tps))
              ((TyOk t _) (TyOk t tps))
              ((TyErr e m) (TyErr e m))))))))
    ((SList (Cons (SSym x) args))
     (if (sym_eq x (quote ->))  ; a function-typed binder makes a template, on the typed route
       (TyErr (quote function_value)
         "(-> …): a function is no value of E — a function-typed binder is a static parameter and its fn a template, whose instances are taken on the typed route; this signature or body has no L reading")
       (match (name_of_sym (at_strip sc x))
         (None (TyErr (quote bad_type) (chars_of_sym x)))
         ((Some n)
          (match (type_ident es sc env n)
            ((TyErr e m) (TyErr e m))
            ((TyOk (ETCon id _) _)
             ;; `(Decidable P)`: the parameter is a proposition, nothing of it is in E — the type
             ;; is its two cells, as the erasure has it (a view's sig fn that exports
             ;; a decision states its result this way)
             (if (name_eq id (n1 (quote Decidable))) (TyOk (ETCon id Nil) tps)
             (match (type_args sc env id (at_explicit sc x) args)
               ((WrErr e m)
                (if (sym_eq e (quote unwritten_argument))
                  (TyErr e
                    (append (show_name id)
                      ": a type argument that is implicit — the type it is at is not written here, and this reading fills nothing in; write the type with @ and every argument"))
                  (TyErr e (append (show_name id) m))))
               ((WrOk targs)
                (match (read_etys es sc env tps targs Nil)
                  ((Pair (TyErr e m) _) (TyErr e m))
                  ((Pair (TyOk _ tps1) ts) (TyOk (ETCon id ts) tps1)))))))
            ((TyOk _ _) (TyErr (quote bad_type) "a type parameter takes no arguments")))))))
    (_ (TyErr (quote bad_type) "a type is NAME or (NAME TYPE…)"))))
;; a type's written arguments that are types. An inductive of K takes values and propositions
;; too — `(Fin n)`, `(Subtype P)`, `(Decidable P)` — which no E type keeps (erase.shard
;; l_to_etype): its parameters' roles select the type arguments among those written, by the
;; binder infos of its own type (written_data). An E-only type's arguments are all types
(fn type_args ((sc Scope) (env CheckedEnv) (id Name) (ex Bool) (args (List SExpr))) Wr
  (match (if (init_seen sc) (type_flags env id) None)
    ((Some flags) (written_data flags ex True args Nil))
    (None (WrOk args))))
(fn type_flags ((env CheckedEnv) (id Name)) (Option (List (Pair Bool Symbol)))
  (match (env_find env id)
    ((Some info)
     (match info
       ((InductInfo _ _ _ _ _ _ _ _ _)
        (match (if (rep_row id) (row_param_roles (w0 env) id) (ind_param_roles (w0 env) id))
          ((Pair _ (Some roles)) (zip_type_flags (ci_type info) roles Nil))
          ((Pair _ None) None)))
       (_ None)))
    (None None)))
(fn zip_type_flags ((ty Expr) (roles (List Bool)) (acc (List (Pair Bool Symbol))))
  (Option (List (Pair Bool Symbol)))
  (measure (struct roles))
  (match roles
    (Nil (Some (rev acc)))
    ((Cons is_type rr)
     (match ty
       ((Pi _ _ bi _ body)
        (zip_type_flags body rr
          (Cons (Pair (bi_explicit bi) (if is_type (quote keep) (quote drop))) acc)))
       (_ None)))))
;; a name that is a definition of K standing for a type (`(def Sorted () Type …)`): the E type
;; its value is, as the typed route reads the binder (erase.shard l_to_etype unfolds it)
(fn alias_etype ((es ESt) (sc Scope) (env CheckedEnv) (id Name)) EType
  (match (if (init_seen sc) (env_find env id) None)
    ((Some info)
     (match info
       ((DefnInfo _ _ _ _ _)
        (match (ci_lparams info)
          (Nil
            (match (l_to_etype (w0 env) es sc (mk_const id Nil) Nil Nil)
              ((Pair _ (Some t)) t)
              ((Pair _ None) (ETCon id Nil))))
          (_ (ETCon id Nil))))
       (_ (ETCon id Nil))))
    (None (ETCon id Nil))))
;; is a binder's written type a proposition? Decided on its head, with no elaboration: a
;; comparison's or a connective's spelling, a bound proposition or predicate, a constant of K
;; whose type ends in Prop, a function type or a quantification into one. False is no claim
;; that the type is data: it is then read as an E type, and what is neither is refused
(fn prop_type ((r Rd) (s SExpr)) Bool
  (measure (struct s))
  (match s
    ((SSym x) (prop_head r (sym_strip x)))
    ((SList (Cons (SSym h) args))
     (if (prop_spelling h) True
     (if (bool_or (sym_eq h (quote ->)) (sym_eq h (quote forall)))
       (match (last_of args)
         ((Some l) (prop_type r l))
         (None False))
       (prop_head r (sym_strip h)))))
    (_ False)))
(fn prop_spelling ((h Symbol)) Bool
  (bool_or (sym_eq h (quote =))
    (bool_or (sym_eq h (quote !=))
      (bool_or (sym_eq h (quote <))
        (bool_or (sym_eq h (quote <=))
          (bool_or (sym_eq h (quote >))
            (bool_or (sym_eq h (quote >=))
              (bool_or (sym_eq h (quote iff))
                (bool_or (sym_eq h (quote and))
                  (bool_or (sym_eq h (quote or))
                    (bool_or (sym_eq h (quote not)) (sym_eq h (quote exists)))))))))))))
(fn prop_head ((r Rd) (h Symbol)) Bool
  (match (name_of_sym h)
    (None False)
    ((Some n)
     (match (rd_find r n)
       ((RdGhost p) p)
       ((RdVar _) False)
       (RdNone
         (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
           ((RName k _)
            (match (env_find (rd_env r) k)
              ((Some info) (ends_in_prop (ci_type info)))
              (None False)))
           (_ False)))))))
(fn ends_in_prop ((t Expr)) Bool
  (measure (struct t))
  (match t
    ((Pi _ _ _ _ b) (ends_in_prop b))
    ((Sort _ l) (is_zero (normalize l)))
    (_ False)))
;; `Prop`, or a function type into it: a binder of this type is a proposition or a predicate
(fn is_pred_sort ((s SExpr)) Bool
  (measure (struct s))
  (match s
    ((SSym x) (sym_eq x (quote Prop)))
    ((SList (Cons (SSym a) args))
     (if (sym_eq a (quote ->))
       (match (last_of args)
         ((Some l) (is_pred_sort l))
         (None False))
       False))
    (_ False)))
;; the argument types in order; the TyRes carries the threaded parameters (its type is a placeholder)
(fn read_etys
  ((es ESt) (sc Scope) (env CheckedEnv) (tps (List Name)) (ss (List SExpr)) (acc (List EType)))
  (Pair TyRes (List EType))
  (measure (struct ss))
  (match ss
    (Nil (Pair (TyOk (ETVar 0) tps) (rev acc)))
    ((Cons s r)
     (match (read_ety es sc env tps s)
       ((TyErr e m) (Pair (TyErr e m) Nil))
       ((TyOk t tps1) (read_etys es sc env tps1 r (Cons t acc)))))))
;; a type name's identity: the built-in E types `Int`, `Nat`, `Symbol` in every
;; file (where Init is in scope, `Int` and `Nat` are its constants under the same bare name);
;; then, where Init is in scope, K's constants through the scope (a `type` K holds, a `sig
;; type`, Init's inductives) and after them the E-only types; elsewhere the E table first —
;; the same answer, since an ambiguity between a native and an imported type needs Init
(fn type_ident ((es ESt) (sc Scope) (env CheckedEnv) (n Name)) TyRes
  (if (builtin_type n) (TyOk (ETCon n Nil) Nil)
  (if (init_seen sc) (type_ident_k es sc env n)  ; K's constants first where Init is in scope: a native type beside an imported one is an ambiguity K reports
  (type_ident_e es sc env n))))  ; faster than resolving in L; every K type has its E twin there
(fn type_ident_k ((es ESt) (sc Scope) (env CheckedEnv) (n Name)) TyRes
  (match (resolve (cx_with_etype (cx0 sc env Nil Nil) True) n)
    ((RName k _) (TyOk (ETCon k Nil) Nil))
    ((RAmbiguous a b) (TyErr (quote ambiguous_type) (ambiguous_msg n a b)))
    ((RPend k) (TyErr (quote pending_obligation) (show_name k)))
    (RNone (type_ident_e es sc env n))))
(fn type_ident_e ((es ESt) (sc Scope) (env CheckedEnv) (n Name)) TyRes
  (match (only_types (eresolve es sc n))
    ((Cons (EHit id _ _) Nil) (TyOk (ETCon id Nil) Nil))
    ((Cons (EHit a _ _) (Cons (EHit b _ _) _)) (TyErr (quote ambiguous_type) (ambiguous_msg n a b)))
    (Nil
      (match (resolve (cx_with_etype (cx0 sc env Nil Nil) True) n)
        ((RName k _) (TyOk (ETCon k Nil) Nil))
        ((RAmbiguous a b) (TyErr (quote ambiguous_type) (ambiguous_msg n a b)))
        ((RPend k) (TyErr (quote pending_obligation) (show_name k)))
        (RNone (TyErr (quote unknown_type) (show_name n)))))))

;; ---- terms ----------------------------------------------------------------------------
;; a bound name: a runtime variable with its static type as far as the declarations fix it,
;; or an erased one — a proof, a type parameter; True where it is a proposition or a
;; predicate, whose applications are propositions (prop_type)
(type Bd (BdVar Name (Option EType)) (BdGhost Name Bool))
;; the reading context: the table, the scope, the environment, the bound names innermost
;; first, the fn being read with its written binders' flags (its own call is read by them,
;; before K holds its constant), and whether the typed route has read this same form — only
;; then may a written proof be passed over (written_data)
(type Rd (Rd ESt Scope CheckedEnv (List Bd) (Option (Pair Name (List (Pair Bool Symbol)))) Bool))
(fn rd_es ((r Rd)) ESt
  (match r
    ((Rd e _ _ _ _ _) e)))
(fn rd_sc ((r Rd)) Scope
  (match r
    ((Rd _ s _ _ _ _) s)))
(fn rd_env ((r Rd)) CheckedEnv
  (match r
    ((Rd _ _ e _ _ _) e)))
(fn rd_bound ((r Rd)) (List Bd)
  (match r
    ((Rd _ _ _ b _ _) b)))
(fn rd_own ((r Rd)) (Option (Pair Name (List (Pair Bool Symbol))))
  (match r
    ((Rd _ _ _ _ o _) o)))
(fn rd_checked ((r Rd)) Bool
  (match r
    ((Rd _ _ _ _ _ c) c)))
(fn rd_push ((r Rd) (b Bd)) Rd
  (match r
    ((Rd e s v bs o c) (Rd e s v (Cons b bs) o c))))
(fn rd_bind ((r Rd) (n Name) (t (Option EType))) Rd (rd_push r (BdVar n t)))
(fn rd_ghost ((r Rd) (n Name)) Rd (rd_push r (BdGhost n False)))
;; a pattern's variables in capture order, the last innermost, each with its type
(fn rd_bind_all ((r Rd) (ns (List Name)) (ts (List (Option EType)))) Rd
  (measure (struct ns))
  (match ns
    (Nil r)
    ((Cons n nr)
     (match ts
       ((Cons t tr) (rd_bind_all (rd_bind r n t) nr tr))
       (Nil (rd_bind_all (rd_bind r n None) nr Nil))))))
(fn rd_ghost_all ((r Rd) (ns (List Name))) Rd
  (measure (struct ns))
  (match ns
    (Nil r)
    ((Cons n nr) (rd_ghost_all (rd_ghost r n) nr))))
;; a name among the bound: its index among the runtime variables, or erased (a proposition?)
(type RdHit (RdVar Int) (RdGhost Bool) (RdNone))
(fn rd_find ((r Rd) (n Name)) RdHit (bd_find (rd_bound r) n 0))
(fn bd_find ((bs (List Bd)) (n Name) (i Int)) RdHit
  (measure (struct bs))
  (match bs
    (Nil RdNone)
    ((Cons (BdVar m _) rest) (if (name_eq n m) (RdVar i) (bd_find rest n (+ i 1))))
    ((Cons (BdGhost m p) rest) (if (name_eq n m) (RdGhost p) (bd_find rest n i)))))
;; the runtime variables' types, innermost first (what c_type reads a body's variables by)
(fn rd_tys ((r Rd)) (List (Option EType)) (bd_tys (rd_bound r)))
(fn bd_tys ((bs (List Bd))) (List (Option EType))
  (measure (struct bs))
  (match bs
    (Nil Nil)
    ((Cons (BdVar _ t) rest) (Cons t (bd_tys rest)))
    ((Cons (BdGhost _ _) rest) (bd_tys rest))))
;; a read term's static type, where the reading uses one: in a file that sees Init, where a
;; pattern's constructor is read at its scrutinee's type and a head by K's signature. A file
;; that sees no Init has neither, and its bindings carry no type
(fn rd_type ((r Rd) (t ETerm)) (Option EType)
  (if (init_seen (rd_sc r)) (c_type (rd_es r) (rd_tys r) t) None))
(fn erased_msg ((n Name)) (List Int)
  (append (show_name n)
    ": a proof or a type in a runtime position — both are erased from a program"))

(type TRes (TOk ETerm) (TErr Symbol (List Int)))
(fn read_et ((r Rd) (s SExpr)) TRes
  (measure (struct s))
  (match s
    ((SNum k) (TOk (ELit (if (< k 0) (LInt k) (LNat k)))))  ; the kind is the sign
    ((SStr bs) (read_estr r bs))
    ((SSymU _ _) (TErr (quote bad_universe_suffix) "an E term takes no universe arguments"))
    ((SSym x) (read_esym r x))
    ((SList Nil) (TErr (quote empty_application) "()"))
    ((SList (Cons (SSym h) args))
     (if (sym_eq h (quote match)) (read_ematch r args)
     (if (sym_eq h (quote let)) (read_elet r args)
     (if (sym_eq h (quote if)) (read_eif r args)
     (if (sym_eq h (quote dif)) (read_edif r args)
     (if (sym_eq h (quote absurd))
       ;; a refuted row: Init's absurd applied to a proof and its negation, neither read here
       (if (if (rd_checked r) (init_const r (n1 (quote absurd)) (n1 (quote absurd))) False)
         (TOk EAbsurd)
         (TErr (quote absurd_needs_init)
           "a refuted row is Init's absurd applied to a proof and its negation: it reads on the typed route, and this body is read E-first"))
       (if (sym_eq h (quote proj)) (read_eproj r args)
       (if (sym_eq h (quote quote))
         (match args
           ((Cons (SSym q) Nil) (TOk (ELit (LSym q))))
           (_ (TErr (quote bad_shape) "(quote SYMBOL)")))
       (if (sym_eq h (quote list)) (read_elist r args)
       (if (sym_eq h (quote fun))
         (TErr (quote function_value)
           "a lambda in a runtime position: a lambda is a static argument of a template, lifted to a fn — never a value, a field, a let or a result")
         (read_eapp r h args)))))))))))
    ((SList (Cons _ _)) (TErr (quote bad_head) "a head is a name"))))

;; a bare name: bound, else a constructor without fields, else a fn of no parameters as its
;; call — the typed route reads the constant as the value it is, and the two routes agree —,
;; else the refusal it earns, naming the arity
;; a template cited bare in an E-first body: never a value — it is called at its full arity, and
;; its instance is taken where it is called (read_template_app)
(fn template_e_first_msg ((id Name)) (List Int)
  (append (show_name id)
    " is a template (a fn with a function-typed binder): it is called at its full arity, and its instance is taken where it is called — never a value"))
(fn fn_value_msg ((id Name) (k Int)) (List Int)
  (append (show_name id)
    (append " in argument position: a function is no value — call it with its "
      (append (show_nat k) " arguments"))))
(fn read_esym ((r Rd) (x Symbol)) TRes
  (match (name_of_sym x)
    (None (TErr (quote bad_name) (chars_of_sym x)))
    ((Some n)
     (match (rd_find r n)
       ((RdVar i) (TOk (EBVar i)))
       ((RdGhost _) (TErr (quote erased_in_runtime) (erased_msg n)))
       (RdNone
         (match (only_values (eresolve (rd_es r) (rd_sc r) n))
           ((Cons (EHit id _ (EICtor _ _ k)) Nil)
            (if (= k 0) (TOk (ECtor id Nil))
            (TErr (quote unsaturated)
              (append (show_name id) (append " takes " (append (show_nat k) " arguments"))))))
           ((Cons (EHit id _ (EIFn k)) Nil)
            (if (= k 0) (TOk (ECall id Nil)) (TErr (quote function_value) (fn_value_msg id k))))
           ((Cons (EHit id _ (EISig k)) Nil)
            (if (= k 0) (TOk (ECall id Nil)) (TErr (quote function_value) (fn_value_msg id k))))
           ((Cons (EHit id _ (EIExt k)) Nil) (TErr (quote function_value) (fn_value_msg id k)))
           ((Cons (EHit id _ (EITemplate _ _ _ _)) Nil)
            (TErr (quote function_value) (template_e_first_msg id)))
           ((Cons (EHit a _ _) (Cons (EHit b _ _) _))
            (TErr (quote ambiguous_head) (ambiguous_msg n a b)))
           (Nil
             (match (prim_of (scope_candidates (rd_sc r) n))
               ((Some (Pair id _))
                (TErr (quote function_value)
                  (append (show_name id) " in argument position: a function is no value")))
               (None
                 (if (init_const r n (nm_nat_zero)) (TOk (ELit (LNat 0)))
                 (if (nat_ctor r n)
                   (TErr (quote nat_constructor)
                     (append (show_name n)
                       ": Nat and Int are realized as the integer — write a numeral"))
                   (TErr (quote unbound_name) (show_name n)))))))
           ((Cons (EHit id _ _) Nil)
            (TErr (quote unbound_name) (append (show_name id) " is a type")))))))))

;; in S, a name that resolves to a constructor of Nat or Int (never E constructors)
(fn nat_ctor ((r Rd) (n Name)) Bool
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName k _)
     (match (env_find (rd_env r) k)
       ((Some (CtorInfo _ ind _ _ _ _)) (is_nat_or_int ind))
       (_ False)))
    (_ False)))
;; (HEAD E…): a constructor, a function or sig fn, an extern, a primitive — saturated.
;; `@HEAD` names every binder of a constant of K; `%` is `mod`'s other spelling
(fn read_eapp ((r Rd) (h0 Symbol) (args (List SExpr))) TRes
  (let ((h (at_strip (rd_sc r) h0)))
    (read_eapp_at r (at_explicit (rd_sc r) h0) (if (sym_eq h (quote %)) (quote mod) h) args)))
;; `@` is a spelling of files that see Init: elsewhere a head is its symbol as written (and
;; its bytes are not read to find out)
(fn at_explicit ((sc Scope) (x Symbol)) Bool (if (init_seen sc) (sym_explicit x) False))
(fn at_strip ((sc Scope) (x Symbol)) Symbol (if (init_seen sc) (sym_strip x) x))
(fn read_eapp_at ((r Rd) (ex Bool) (h Symbol) (args (List SExpr))) TRes
  (match (name_of_sym h)
    (None (TErr (quote bad_name) (chars_of_sym h)))
    ((Some n)
     (match (rd_find r n)
       ((RdVar _)
        (TErr (quote bad_head) (append (show_name n) " is a variable: there are no function values")))
       ((RdGhost _) (TErr (quote erased_in_runtime) (erased_msg n)))
       (RdNone
         (match (only_values (eresolve (rd_es r) (rd_sc r) n))
           ((Cons (EHit id _ (EICtor _ _ k)) Nil) (read_known r id k ex args (quote ctor)))
           ((Cons (EHit id _ (EIFn k)) Nil) (read_known r id k ex args (quote call)))
           ((Cons (EHit id _ (EISig k)) Nil) (read_known r id k ex args (quote call)))
           ((Cons (EHit id _ (EIExt k)) Nil) (read_known r id k ex args (quote ext)))
           ((Cons (EHit id _ (EITemplate _ ebs _ _)) Nil) (read_template_app r id ebs args))
           ((Cons (EHit a _ _) (Cons (EHit b _ _) _))
            (TErr (quote ambiguous_head) (ambiguous_msg n a b)))
           (Nil
             (match (prim_head (rd_sc r) n)
               ((Some (Pair id (Prim _ k))) (read_prim_head r id k args))
               (None
                 (match (init_row r h n args)
                   ((Some res) res)
                   (None
                     (match (k_head r ex n args)
                       ((Some res) res)
                       (None
                         (if (nat_ctor r n)
                           (TErr (quote nat_constructor)
                             (append (show_name n)
                               ": Nat and Int are realized as the integer — write a numeral, Nat.add, Nat.sub"))
                           (match (renamed_prim h)
                             ((Some new) (TErr (quote renamed_primitive) (renamed_msg h new)))
                             (None (TErr (quote unknown_head) (show_name n))))))))))))
           ((Cons (EHit id _ _) Nil) (TErr (quote bad_head) (append (show_name id) " is a type")))))))))

;; ---- the arguments written and the arguments that run ----------------------------------------
;; What a call writes is not what it passes: a type and a proof are written and erased, and
;; a binder marked implicit is not written at all. Which is which is the head's declared
;; signature — its binders in order, each explicit or not, each `keep` (runtime data), `drop`
;; (a type) or `proof` — read off K's constant by the roles the erasure reads (erase.shard
;; tele_of), or off the written binders of the fn being read. Two refusals keep the reading
;; honest. The elaborator fills in types and proofs only (LAW rule 24): a binder that is
;; implicit and runtime data is an argument that runs and is not written. And a proof is
;; passed over unread, so it must have a reader: where the typed route has not read this same
;; form (`checked`), a written proof is refused — nothing checks it
(type Wr (WrOk (List SExpr)) (WrErr Symbol (List Int)))
(fn written_data
  ((flags (List (Pair Bool Symbol)))
   (ex Bool)
   (checked Bool)
   (args (List SExpr))
   (acc (List SExpr)))
  Wr
  (measure (struct flags))
  (match flags
    (Nil
      (match args
        (Nil (WrOk (rev acc)))
        (_
          (WrErr (quote unsaturated)
            (append " is given "
              (append (show_nat (len args)) " more arguments than its signature has binders"))))))
    ((Cons (Pair explicit role) fr)
     (if (bool_or ex explicit)
       (match args
         (Nil
           (WrErr (quote unsaturated)
             " is given fewer arguments than its signature has binders: a function is no value"))
         ((Cons a ar)
          (if (sym_eq role (quote keep)) (written_data fr ex checked ar (Cons a acc))
          (if (bool_and (sym_eq role (quote proof)) (bool_not checked))
            (WrErr (quote unchecked_proof)
              ": a proof is written here, and this body has no L reading — the plain reading passes a proof over unread, and nothing else checks it")
            (written_data fr ex checked ar acc)))))
     (if (sym_eq role (quote keep))
       (WrErr (quote unwritten_argument)
         ": a binder that is implicit and runtime data — its argument exists at run time and is not written; write the call with @ and every argument")
       (written_data fr ex checked args acc))))))
;; a head's binders' flags, where the file sees Init: the fn being read by its own written
;; binders, else K's constant
(fn head_flags ((r Rd) (id Name)) (Option (List (Pair Bool Symbol)))
  (if (bool_not (init_seen (rd_sc r))) None
  (match (rd_own r)
    ((Some (Pair own flags)) (if (name_eq own id) (Some flags) (k_flags r id)))
    (None (k_flags r id)))))
(fn k_flags ((r Rd) (id Name)) (Option (List (Pair Bool Symbol)))
  (match (env_find (rd_env r) id)
    (None None)
    ((Some info)
     (match
       (match info
         ((CtorInfo _ _ _ nparams _ _)
          (tele_of_fields (w0 (rd_env r)) (rd_es r) (rd_sc r) info nparams))
         (_ (tele_of (w0 (rd_env r)) (rd_es r) (rd_sc r) info)))
       ((TeleOk _ _ (Tele _ binds _ _)) (zip_flags (ci_type info) binds Nil))
       ((TeleErr _ _) None)))))
;; the binders' roles beside the binder infos of the type's own Pi chain; a function-typed
;; binder is a template's (never read here), and a type that is no Pi chain gives nothing
(fn zip_flags ((ty Expr) (binds (List TBind)) (acc (List (Pair Bool Symbol))))
  (Option (List (Pair Bool Symbol)))
  (measure (struct binds))
  (match binds
    (Nil (Some (rev acc)))
    ((Cons (TBind _ role _) br)
     (match ty
       ((Pi _ _ bi _ body)
        (match role
          ((BStatic _) None)
          ((BData _) (zip_flags body br (Cons (Pair (bi_explicit bi) (quote keep)) acc)))
          (BType (zip_flags body br (Cons (Pair (bi_explicit bi) (quote drop)) acc)))
          (BErased (zip_flags body br (Cons (Pair (bi_explicit bi) (quote proof)) acc)))))
       (_ None)))))
(fn bi_explicit ((bi BinderInfo)) Bool
  (match bi
    (BDefault True)
    (_ False)))
;; a head the E table knows: its runtime arguments among those written
(fn read_known ((r Rd) (id Name) (k Int) (ex Bool) (args (List SExpr)) (kind Symbol)) TRes
  (match (head_flags r id)
    ((Some flags)
     (match (written_data flags ex (rd_checked r) args Nil)
       ((WrErr e m) (TErr e (append (show_name id) m)))
       ((WrOk ss) (read_head_args r id (len ss) ss kind))))
    (None
      (if ex
        (TErr (quote bad_head)
          (append (show_name id)
            ": @ names every binder of a constant of K, and this head's signature is not one K holds"))
        (read_head_args r id k args kind)))))
;; a primitive written by name: the table's entry; a decision of the registry is a value here —
;; Decidable's cell by its test, as the erasure writes it (erasure.shard erase_dec_value)
(fn read_prim_head ((r Rd) (id Name) (k Int) (args (List SExpr))) TRes
  (match (decision_test id)
    ((Some p) (read_decision r p args))
    (None (read_head_args r (table_entry id) k args (quote prim)))))
(fn read_decision ((r Rd) (p Name) (args (List SExpr))) TRes
  (match (read_head_args r p 2 args (quote prim))
    ((TErr e m) (TErr e m))
    ((TOk test) (TOk (EIf test (dec_true) (dec_false))))))
;; the comparison a decision of the registry answers (`Nat.decEq` is `=`)
(fn decision_test ((id Name)) (Option Name)
  (match (realization_of id)
    ((Some p) (if (cmp_prim p) (Some p) None))
    (None None)))

;; ---- a head that is a constant of K and no entry of the E table ------------------------------
;; where the file sees Init: `dite` and `ite` written with their decision, a refuted row, Bool's
;; decidable equality, a row's constructor — its one runtime argument — and a projection
;; function: of a row the subject itself, of a structure the field's variable under a match on
;; its constructor (erasure.shard erase_const_at gives the same constants the same shapes)
(fn k_head ((r Rd) (ex Bool) (n Name) (args (List SExpr))) (Option TRes)
  (if (bool_not (init_seen (rd_sc r))) None
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName k _)
     (if (name_eq k (n1 (quote dite))) (Some (read_ite r ex True args))
     (if (name_eq k (n1 (quote ite))) (Some (read_ite r ex False args))
     (if (bool_or (name_eq k (n1 (quote absurd))) (name_eq k (n2 (quote False) (quote elim))))
       (Some
         (if (rd_checked r) (TOk EAbsurd)
         (TErr (quote absurd_needs_init)
           "a refuted row is a proof of False: it reads on the typed route, and this body is read E-first")))
     (if (name_eq k (n1 (quote instDecidableEqBool)))
       (Some
         (match (read_bool_eq r args)
           ((TErr e m) (TErr e m))
           ((TOk test) (TOk (EIf test (dec_true) (dec_false))))))
       (match (env_find (rd_env r) k)
         ((Some info)
          (match info
            ((CtorInfo _ ind _ _ _ _) (if (rep_row ind) (Some (read_row_ctor r ex k args)) None))
            ((DefnInfo _ v _ _ _)
             (match (proj_fn_of v 0)
               ((Some (Pair (Pair sn i) depth))
                (Some (read_proj_fn r ex k sn i (pi_explicit (ci_type info) depth) args)))
               (None (Some (no_program k)))))
            ((ThmInfo _ _ _) (Some (no_program k)))
            ((AxiomInfo _ _) (Some (no_program k)))
            ((OpaqueInfo _ _ _ _) (Some (no_program k)))
            (_ None)))
         (None None)))))))
    (_ None))))
;; a constant K holds that no table gives a program: a definition and nothing more, a theorem
(fn no_program ((k Name)) TRes
  (TErr (quote no_realization)
    (append (show_name k)
      ": no realization attached — realize it first, or import the file that does")))
(fn read_row_ctor ((r Rd) (ex Bool) (k Name) (args (List SExpr))) TRes
  (match (k_flags r k)
    (None
      (TErr (quote no_realization)
        (append (show_name k) ": the registry's row does not describe this structure")))
    ((Some flags)
     (match (written_data flags ex (rd_checked r) args Nil)
       ((WrErr e m) (TErr e (append (show_name k) m)))
       ((WrOk (Cons a Nil)) (read_et r a))
       ((WrOk _)
        (TErr (quote no_realization)
          (append (show_name k) ": a row's constructor has exactly one runtime field")))))))
;; a projection function — a constant whose value is λ params self. self.i: the structure, the
;; field and the number of its lambdas; which of them a call writes is its type's binder infos
(fn proj_fn_of ((v Expr) (depth Int)) (Option (Pair (Pair Name Int) Int))
  (measure (struct v))
  (match v
    ((Lam _ _ _ _ b) (proj_fn_of b (+ depth 1)))
    ((Proj _ sn i (BVar _ 0)) (if (< depth 1) None (Some (Pair (Pair sn i) depth))))
    (_ None)))
(fn pi_explicit ((ty Expr) (k Int)) (List Bool)
  (measure k)
  (if (< k 1) Nil
  (match ty
    ((Pi _ _ bi _ body) (Cons (bi_explicit bi) (pi_explicit body (- k 1))))
    (_ Nil))))
;; applied to its structure exactly (the subject is its last lambda's argument)
(fn read_proj_fn
  ((r Rd) (ex Bool) (k Name) (sn Name) (i Int) (lams (List Bool)) (args (List SExpr)))
  TRes
  (if (< (if ex (len lams) (count_true lams)) (len args))
    (TErr (quote function_value)
      (append (show_name k)
        ": a projection applied past its structure — a field that is a function is a package's, read off the package constant's value, which this reading does not unfold: call the function the field holds by its name, or pass the package to a template"))
  (if (bool_not (= (len args) (if ex (len lams) (count_true lams))))
    (TErr (quote unsaturated) (append (show_name k) ": a projection is applied to its structure"))
    (match (last_of args)
      (None
        (TErr (quote unsaturated)
          (append (show_name k) ": a projection is applied to its structure")))
      ((Some x) (read_proj r sn i x))))))
(fn last_of ((T Type) (xs (List T))) (Option T)
  (measure (struct xs))
  (match xs
    (Nil None)
    ((Cons x Nil) (Some x))
    ((Cons _ rest) (last_of rest))))
;; field i of the structure sn, of the subject x
(fn read_proj ((r Rd) (sn Name) (i Int) (x SExpr)) TRes
  (match (struct_ctor r sn)
    (None (TErr (quote no_realization) (append (show_name sn) " is not a structure")))
    ((Some c)
     (match (ctor_data_flags (w0 (rd_env r)) (rd_es r) (rd_sc r) c)
       (None (TErr (quote no_realization) (show_name c)))
       ((Some flags)
        (match (runtime_index flags i 0 0)
          (None
            (TErr (quote erased_in_runtime)
              (append (show_name sn) ": a projection of an erased field")))
          ((Some (Pair j nrt))
           (match (read_et r x)
             ((TErr e m) (TErr e m))
             ((TOk x1)
              (if (rep_row sn)
                (if (= nrt 1)
                  (TOk
                    (match (row_field_proj sn)
                      ((Some p) (EPrim p (list x1)))  ; kept by name while the body is typed
                      (None x1)))
                  (TErr (quote no_realization)
                    (append (show_name sn)
                      ": the registry's row does not describe this structure (one constructor, one runtime field)")))
                (match (es_info (rd_es r) c)
                  ((Some (EICtor _ _ _))
                   (TOk (EMatch x1 (list (EArm (PCtor c (pvars nrt)) (EBVar (- (- nrt 1) j)))))))
                  (_ (TErr (quote no_realization) (append (show_name sn) " is not an E type"))))))))))))))
(fn struct_ctor ((r Rd) (sn Name)) (Option Name)
  (match (env_find (rd_env r) sn)
    ((Some (InductInfo _ _ _ _ (Cons c Nil) _ _ _ _)) (Some c))
    (_ None)))
;; (proj S i E): field i of the structure S
(fn read_eproj ((r Rd) (args (List SExpr))) TRes
  (match args
    ((Cons (SSym sx) (Cons (SNum i) (Cons x Nil)))
     (match (name_of_sym sx)
       (None (TErr (quote bad_name) (chars_of_sym sx)))
       ((Some n)
        (match
          (if (init_seen (rd_sc r))
            (resolve (cx_with_etype (cx0 (rd_sc r) (rd_env r) Nil Nil) True) n)
            RNone)
          ((RName sn _) (read_proj r sn i x))
          (_ (TErr (quote unknown_head) (append (show_name n) " is not a structure of K")))))))
    (_ (TErr (quote bad_shape) "(proj STRUCTURE INDEX E)"))))

;; ---- decisions: a value and a condition ------------------------------------------------------
;; (@dite T C DEC (fun ((h C)) A) (fun ((h (Not C))) B)) and (@ite T C DEC A B): an `if` on the
;; decision. The type and the proposition are erased; a dite's branch is a lambda over its
;; hypothesis, a proof. Without @ the decision is an instance argument — it runs and is not
;; written — so the plain forms are `if` and `dif`
(fn read_ite ((r Rd) (ex Bool) (dep Bool) (args (List SExpr))) TRes
  (if (bool_not ex)
    (TErr (quote unwritten_argument)
      "ite and dite take their decision as an instance argument, which exists at run time and is not written: write (if C A B), (dif h C A B), or the @ form with its decision")
    (match args
      ((Cons _ (Cons _ (Cons d (Cons a (Cons b Nil)))))
       (match (read_cond r d)
         ((TErr e m) (TErr e m))
         ((TOk c)
          (match (read_branch r dep a)
            ((TErr e m) (TErr e m))
            ((TOk ta)
             (match (read_branch r dep b)
               ((TErr e m) (TErr e m))
               ((TOk tb) (TOk (EIf c ta tb)))))))))
      (_ (TErr (quote unsaturated) "@ite and @dite take five arguments")))))
(fn read_branch ((r Rd) (dep Bool) (s SExpr)) TRes
  (if (bool_not dep) (read_et r s)
  (match s
    ((SList (Cons (SSym f) (Cons (SList (Cons (SList (Cons (SSym x) _)) Nil)) (Cons body Nil))))
     (if (sym_eq f (quote fun))
       (match (name_of_sym x)
         (None (TErr (quote bad_name) (chars_of_sym x)))
         ((Some n) (read_et (rd_ghost r n) body)))
       (TErr (quote function_value) "a dite's branch is (fun ((h P)) E)")))
    (_ (TErr (quote function_value) "a dite's branch is (fun ((h P)) E)")))))
;; a decision where an `if` reads it: a decision of the registry written by name is its bare
;; test, Bool's decidable equality the test over its operands; anything else — the call of a
;; derived decision, a variable — is its value, whose cell the `if` reads
(type CondHead (CondPrim Name) (CondBoolEq) (CondNone))
(fn read_cond ((r Rd) (s SExpr)) TRes
  (if (bool_not (init_seen (rd_sc r))) (read_et r s) (read_cond_at r s)))
(fn read_cond_at ((r Rd) (s SExpr)) TRes
  (match s
    ((SList (Cons (SSym h0) args))
     (match (name_of_sym (sym_strip h0))
       (None (read_et r s))
       ((Some n)
        (match (cond_head r n)
          ((CondPrim p) (read_head_args r p 2 args (quote prim)))
          (CondBoolEq (read_bool_eq r args))
          (CondNone (read_et r s))))))
    (_ (read_et r s))))
(fn cond_head ((r Rd) (n Name)) CondHead
  (if (bool_not (init_seen (rd_sc r))) CondNone
  (match (rd_find r n)
    (RdNone
      (match (only_values (eresolve (rd_es r) (rd_sc r) n))
        (Nil
          (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
            ((RName k _)
             (if (name_eq k (n1 (quote instDecidableEqBool))) CondBoolEq
             (match (decision_test k)
               ((Some p) (CondPrim p))
               (None CondNone))))
            (_ CondNone)))
        (_ CondNone)))
    (_ CondNone))))
(fn read_bool_eq ((r Rd) (args (List SExpr))) TRes
  (match (read_ets_list r args Nil)
    ((Pair (Some (Pair e m)) _) (TErr e m))
    ((Pair None (Cons a (Cons b Nil))) (TOk (bool_eq_cond a b)))
    ((Pair None _) (TErr (quote unsaturated) "instDecidableEqBool takes 2 arguments"))))
;; (dif h C A B): the `if` on C, its hypothesis a proof in both branches
(fn read_edif ((r Rd) (args (List SExpr))) TRes
  (if (bool_not (init_seen (rd_sc r)))
    (TErr (quote dif_needs_init)
      "a dif names the hypothesis of a decided proposition: Decidable and dite are Init's, and this file does not see Init")
    (match args
      ((Cons (SSym hn) (Cons c (Cons a (Cons b Nil))))
       (match (name_of_sym hn)
         (None (TErr (quote bad_name) (chars_of_sym hn)))
         ((Some n)
          (match (read_et r c)
            ((TErr e m) (TErr e m))
            ((TOk tc)
             (match (read_et (rd_ghost r n) a)
               ((TErr e m) (TErr e m))
               ((TOk ta)
                (match (read_et (rd_ghost r n) b)
                  ((TErr e m) (TErr e m))
                  ((TOk tb) (TOk (EIf tc ta tb)))))))))))
      (_ (TErr (quote bad_shape) "(dif h C A B)")))))
;; the entry an operation of Init written by name is run as: the registry's (prog.shard
;; realization_of — `Nat.add` is `+`), as the typed route's erasure writes it (a decision is
;; read before it comes here: read_decision)
(fn table_entry ((id Name)) Name
  (match (realization_of id)
    ((Some p) p)
    (None id)))
;; does the name resolve, through the scope, to the constant k of Init?
(fn init_const ((r Rd) (n Name) (k Name)) Bool
  (if (bool_not (init_seen (rd_sc r))) False
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName c _) (name_eq c k))
    (_ False))))
;; a head no table knows, in a file that sees Init: a constant of Init with a fixed program —
;; the rows the typed route's erasure gives the same constants (erasure.shard erase_const_at,
;; prog.shard's registry). An Int operation is the table's entry; `Nat.succ x` is x + 1; Init's
;; Bool connectives, `and` `or` `not` among them, are the `if` their definitions are; a row
;; with an expression (`Int.natAbs`) and the identity (`Int.ofNat`) keep their name as the
;; head until the body is typed (settle_ops) and are written out last (expand_rows)
(fn init_row ((r Rd) (h Symbol) (n Name) (args (List SExpr))) (Option TRes)
  (if (bool_not (init_seen (rd_sc r))) None
  (if (sym_eq h (quote and)) (Some (read_bool_row r (quote and) args))
  (if (sym_eq h (quote or)) (Some (read_bool_row r (quote or) args))
  (if (sym_eq h (quote not)) (Some (read_bool_row r (quote not) args))
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName k _)
     (if (name_eq k (n2 (quote Bool) (quote and))) (Some (read_bool_row r (quote and) args))
     (if (name_eq k (n2 (quote Bool) (quote or))) (Some (read_bool_row r (quote or) args))
     (if (name_eq k (n2 (quote Bool) (quote not))) (Some (read_bool_row r (quote not) args))
     (if (name_eq k (nm_nat_succ)) (Some (read_succ r args))
     (match (realization_of k)
       ((Some p)
        (Some (if (cmp_prim p) (read_decision r p args) (read_head_args r p 2 args (quote prim)))))
       (None
         (match (realization_type k)
           ((Some _) (Some (read_head_args r k 1 args (quote prim))))
           (None None)))))))))
    (_ None)))))))
(fn read_succ ((r Rd) (args (List SExpr))) TRes
  (match (read_ets_list r args Nil)
    ((Pair (Some (Pair e m)) _) (TErr e m))
    ((Pair None (Cons x Nil)) (TOk (EPrim (n2 (quote Nat) (quote add)) (list x (ELit (LNat 1))))))
    ((Pair None _) (TErr (quote unsaturated) "Nat.succ takes 1 argument"))))
(fn read_bool_row ((r Rd) (op Symbol) (args (List SExpr))) TRes
  (match (read_ets_list r args Nil)
    ((Pair (Some (Pair e m)) _) (TErr e m))
    ((Pair None (Cons a Nil))
     (if (sym_eq op (quote not)) (TOk (EIf a (bool_false) (bool_true)))
     (TErr (quote unsaturated) (append (chars_of_sym op) " takes 2 arguments, given 1"))))
    ((Pair None (Cons a (Cons b Nil)))
     (if (sym_eq op (quote and)) (TOk (EIf a b (bool_false)))
     (if (sym_eq op (quote or)) (TOk (EIf a (bool_true) b))
     (TErr (quote unsaturated) "not takes 1 argument, given 2"))))
    ((Pair None _) (TErr (quote unsaturated) (append (chars_of_sym op) " takes 2 arguments")))))
;; a primitive head: the table's entry among the scope's candidates (a renamed spelling
;; is refused by the caller, `renamed_primitive`)
(fn prim_head ((sc Scope) (n Name)) (Option (Pair Name Prim)) (prim_of (scope_candidates sc n)))
(fn read_head_args ((r Rd) (id Name) (k Int) (args (List SExpr)) (kind Symbol)) TRes
  (if (bool_not (= k (len args)))
    (TErr (quote unsaturated)
      (append (show_name id)
        (append " takes " (append (show_nat k) (append " arguments, given " (show_nat (len args)))))))
    (match (read_ets_list r args Nil)
      ((Pair (Some (Pair e m)) _) (TErr e m))
      ((Pair None ts)
       (TOk
         (if (sym_eq kind (quote ctor)) (ECtor id ts)
         (if (sym_eq kind (quote call)) (ECall id ts)
         (if (sym_eq kind (quote ext)) (EExt id ts)
         (EPrim id ts)))))))))
;; the arguments in order, or the first error
(fn read_ets_list ((r Rd) (ss (List SExpr)) (acc (List ETerm)))
  (Pair (Option (Pair Symbol (List Int))) (List ETerm))
  (measure (struct ss))
  (match ss
    (Nil (Pair None (rev acc)))
    ((Cons s rest)
     (match (read_et r s)
       ((TErr e m) (Pair (Some (Pair e m)) Nil))
       ((TOk t) (read_ets_list r rest (Cons t acc)))))))

;; (TEMPLATE ARG…) in an E-first body: the arguments read by the template's written binders —
;; a data position as any term, a static position as a shape (read_static_arg), transiently the
;; name applied to its captured terms; the instance is taken by take_instances once the body
;; is read and its types are known
(fn read_template_app ((r Rd) (id Name) (ebs (List EBind)) (args (List SExpr))) TRes
  (if (bool_not (= (len ebs) (len args)))
    (TErr (quote unsaturated)
      (append (show_name id)
        (append " takes "
          (append (show_nat (len ebs)) (append " arguments, given " (show_nat (len args)))))))
    (match (read_tm_args r id ebs args Nil)
      ((Pair (Some (Pair e m)) _) (TErr e m))
      ((Pair None ts) (TOk (ECall id ts))))))
(fn read_tm_args ((r Rd) (id Name) (ebs (List EBind)) (args (List SExpr)) (acc (List ETerm)))
  (Pair (Option (Pair Symbol (List Int))) (List ETerm))
  (measure (struct ebs))
  (match ebs
    (Nil (Pair None (rev acc)))
    ((Cons b br)
     (match args
       (Nil (Pair None (rev acc)))
       ((Cons a ar)
        (match
          (match b
            ((EBData _) (read_et r a))
            ((EBStatic _ _) (read_static_arg r id a))
            (EBPackage (read_package_arg r id a)))
          ((TErr e m) (Pair (Some (Pair e m)) Nil))
          ((TOk t) (read_tm_args r id br ar (Cons t acc)))))))))
;; a static argument: a lambda (read_elam); a name with a program and no type parameters — a fn
;; or a sig fn of the E table, a constant of the realization registry —, bare or applied to
;; runtime terms (its captured values) short of its arity. Anything else written is refused
;; with its pointer — a bound variable, a polymorphic fn, a template, a constructor, an extern
(fn read_static_arg ((r Rd) (tm Name) (s SExpr)) TRes
  (match s
    ((SSym x) (read_static_head r tm x Nil))
    ((SList (Cons (SSym h) gargs))
     (if (sym_eq h (quote fun)) (read_elam r gargs) (read_static_head r tm h gargs)))
    (_
      (TErr (quote function_value)
        (append (show_name tm)
          ": a static argument is a name, or a name applied to its captured values")))))
(fn read_static_head ((r Rd) (tm Name) (h Symbol) (gargs (List SExpr))) TRes
  (match (name_of_sym h)
    (None (TErr (quote bad_name) (chars_of_sym h)))
    ((Some n)
     (match (rd_find r n)
       ((RdVar _)
        (TErr (quote function_value)
          (append (show_name n)
            ": a variable as a static argument — there are no function values; a static argument names a fn")))
       ((RdGhost _) (TErr (quote erased_in_runtime) (erased_msg n)))
       (RdNone
         (match (only_values (eresolve (rd_es r) (rd_sc r) n))
           ((Cons (EHit id _ (EIFn k)) Nil) (read_static_fn r id k gargs))
           ((Cons (EHit id _ (EISig k)) Nil) (read_static_fn r id k gargs))
           ((Cons (EHit id _ (EIExt _)) Nil)
            (TErr (quote function_value)
              (append (show_name id)
                ": an extern as a static argument is not supported — it takes a World")))
           ((Cons (EHit id _ (EITemplate _ _ _ _)) Nil)
            (TErr (quote function_value)
              (append (show_name id)
                ": a template as a static argument — an instance is taken where the template is called")))
           ((Cons (EHit id _ (EICtor _ _ _)) Nil)
            (TErr (quote function_value)
              (append (show_name id)
                ": a constructor as a static argument — a static argument names a fn")))
           ((Cons (EHit a _ _) (Cons (EHit b _ _) _))
            (TErr (quote ambiguous_head) (ambiguous_msg n a b)))
           (Nil
             (match (registry_const r n)
               ((Some k) (read_static_registry r k gargs))
               (None
                 (match (prim_of (scope_candidates (rd_sc r) n))
                   ((Some (Pair id _))
                    (TErr (quote function_value)
                      (append (show_name id)
                        ": an operator as a static argument — a static argument names a function: the constant the operator is at its type (Int.add, Nat.mul), or a fn")))
                   (None (TErr (quote unbound_name) (show_name n)))))))
           ((Cons (EHit id _ _) Nil)
            (TErr (quote unbound_name) (append (show_name id) " is a type")))))))))
(fn read_static_fn ((r Rd) (id Name) (k Int) (gargs (List SExpr))) TRes
  (if (bool_not (= (e_tparams (rd_es r) id) 0))
    (TErr (quote function_value)
      (append (show_name id)
        ": a polymorphic fn as a static argument in a body with no L reading — its type arguments are not written here; give the body an L reading"))
  (if (<= k (len gargs))
    (TErr (quote function_value)
      (append (show_name id)
        (append " applied to "
          (append (show_nat (len gargs))
            (append " arguments leaves none of its "
              (append (show_nat k) " for the static parameter — a static argument is a function"))))))
    (match (read_ets_list r gargs Nil)
      ((Pair (Some (Pair e m)) _) (TErr e m))
      ((Pair None ts) (TOk (ECall id ts)))))))
(fn e_tparams ((es ESt) (id Name)) Int
  (match (es_find_decl es id)
    ((Some (EFn _ nt _ _ _ _)) nt)
    ((Some (ESig _ nt _ _)) nt)
    (_ 0)))
;; a name that resolves to a constant of the realization registry (prog.shard realization_of),
;; in a file that sees Init: as a static argument it is its own shape — its instance calls the
;; table's entry —, bare or applied to its first operand
(fn registry_const ((r Rd) (n Name)) (Option Name)
  (if (bool_not (init_seen (rd_sc r))) None
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName k _)
     (match (realization_of k)
       ((Some _) (Some k))
       (None None)))
    (_ None))))
(fn read_static_registry ((r Rd) (k Name) (gargs (List SExpr))) TRes
  (if (<= 2 (len gargs))
    (TErr (quote function_value)
      (append (show_name k)
        (append " applied to "
          (append (show_nat (len gargs))
            " arguments leaves none of its 2 for the static parameter — a static argument is a function"))))
    (match (read_ets_list r gargs Nil)
      ((Pair (Some (Pair e m)) _) (TErr e m))
      ((Pair None ts) (TOk (ECall k ts))))))
;; a package argument: the name of a package constant — a def of K, closed, nothing of it
;; captured; its shape is its identity. That its value is the structure's constructor applied
;; is read where the instance is built (erasure.shard package_fields_of)
(fn read_package_arg ((r Rd) (tm Name) (s SExpr)) TRes
  (match
    (match s
      ((SSym x)
       (match (name_of_sym x)
         ((Some n)
          (match (rd_find r n)
            (RdNone
              (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
                ((RName k _)
                 (match (env_find (rd_env r) k)
                   ((Some (DefnInfo _ _ _ _ _)) (Some k))
                   (_ None)))
                (_ None)))
            (_ None)))
         (None None)))
      (_ None))
    ((Some k) (TOk (ECall k Nil)))
    (None
      (TErr (quote function_value)
        (append (show_name tm)
          ": a package argument names a package constant — a def whose value is the structure's constructor applied")))))
;; a lambda as a static argument: (fun ((x TYPE)…) E) — each binder states its type, a closed
;; E type, and the body is read under them. It stays a lambda in the body as read (ELam) and
;; is lifted to a fn where the instance is taken (take_lambda)
(fn read_elam ((r Rd) (args (List SExpr))) TRes
  (match args
    ((Cons (SList bs) (Cons body Nil))
     (match (read_lam_binders r bs Nil Nil)
       ((Pair (Some (Pair e m)) _) (TErr e m))
       ((Pair None (Pair Nil _))
        (TErr (quote bad_shape) "a lambda binds a variable: (fun ((x TYPE)…) E)"))
       ((Pair None (Pair names types))
        (match (read_et (rd_bind_all r names (some_all types)) body)
          ((TErr e m) (TErr e m))
          ((TOk b) (TOk (ELam types None b)))))))
    (_ (TErr (quote bad_shape) "(fun ((x TYPE)…) E)"))))
(fn read_lam_binders ((r Rd) (bs (List SExpr)) (names (List Name)) (types (List EType)))
  (Pair (Option (Pair Symbol (List Int))) (Pair (List Name) (List EType)))
  (measure (struct bs))
  (match bs
    (Nil (Pair None (Pair (rev names) (rev types))))
    ((Cons (SList (Cons (SSym x) (Cons ty Nil))) rest)
     (match (name_of_sym x)
       (None (Pair (Some (Pair (quote bad_name) (chars_of_sym x))) (Pair Nil Nil)))
       ((Some n)
        (match (read_ety (rd_es r) (rd_sc r) (rd_env r) Nil ty)
          ((TyErr e m)
           (Pair
             (Some
               (Pair e
                 (append m
                   " — a lambda's binder states a closed type; a lambda over a type parameter is not supported")))
             (Pair Nil Nil)))
          ((TyOk t _) (read_lam_binders r rest (Cons n names) (Cons t types)))))))
    (_
      (Pair (Some (Pair (quote bad_shape) "a lambda's binder is (NAME TYPE): its type is written"))
        (Pair Nil Nil)))))

;; (match E (PAT E)…): the first arm whose pattern matches; each arm's variables bound for its
;; body, typed from the scrutinee's static type (a constructor's name is read at that type)
(fn read_ematch ((r Rd) (args (List SExpr))) TRes
  (match args
    ((Cons s arms)
     (match (read_et r s)
       ((TErr e m) (TErr e m))
       ((TOk t)
        (if (if (init_seen (rd_sc r)) (has_numeral_row arms) False) (read_ematch_lit r t arms)
        (match (read_earms r (rd_type r t) arms Nil)
          ((Pair (Some (Pair e m)) _) (TErr e m))
          ((Pair None as)
           (match (dead_row_in as arms)
             ((Some m) (TErr (quote unreachable_arm) m))
             (None (TOk (EMatch t as))))))))))
    (_ (TErr (quote bad_shape) "(match E (PAT E)…)"))))
;; numeral rows, where the file sees Init: Lean's value patterns as the elaborator reads them
;; (elab.shard elab_match_lit) — the scrutinee once, a test per row in row order, the last row
;; `_` or a name for the scrutinee. A local scrutinee is itself in the tests; anything else
;; is bound once. At Nat and Int, where the scrutinee's type is fixed
(fn read_ematch_lit ((r Rd) (t ETerm) (arms (List SExpr))) TRes
  (if (bool_not (numeral_typed (rd_type r t)))
    (TErr (quote pattern_type) "a numeral row matches a value read at Nat or Int")
    (match t
      ((EBVar _) (read_lit_rows r t arms))
      (_
        (match (read_lit_rows (rd_bind r (n1 (lit_scrut)) (rd_type r t)) (EBVar 0) arms)
          ((TErr e m) (TErr e m))
          ((TOk chain) (TOk (ELet (list t) chain))))))))
(fn numeral_typed ((t (Option EType))) Bool
  (match t
    (None True)
    (_ (bool_or (is_nat_type t) (is_int_type t)))))
(fn read_lit_rows ((r Rd) (x ETerm) (arms (List SExpr))) TRes
  (measure (struct arms))
  (match arms
    (Nil
      (TErr (quote match_not_exhaustive)
        "numeral rows cover no type: close the match with a `_` row or a name"))
    ((Cons (SList (Cons (SNum k) (Cons body Nil))) rest)
     (match (read_et r body)
       ((TErr e m) (TErr e m))
       ((TOk b)
        (match (read_lit_rows r x rest)
          ((TErr e m) (TErr e m))
          ((TOk e)
           (TOk (EIf (EPrim (n1 (quote =)) (list x (ELit (if (< k 0) (LInt k) (LNat k))))) b e)))))))
    ((Cons (SList (Cons (SSym v) (Cons body Nil))) Nil)
     (if (sym_eq v (quote _)) (read_et r body)
     (match (name_of_sym v)
       (None (TErr (quote bad_name) (chars_of_sym v)))
       ((Some n)
        (match (read_et (rd_bind r n (rd_type r x)) body)
          ((TErr e m) (TErr e m))
          ((TOk b) (TOk (ELet (list x) b))))))))
    (_
      (TErr (quote literal_rows)
        "a literal match is numeral rows closed by one last row, `_` or a name: no constructor row beside them, no row after the catch-all"))))
(fn read_earms ((r Rd) (st (Option EType)) (arms (List SExpr)) (acc (List EArm)))
  (Pair (Option (Pair Symbol (List Int))) (List EArm))
  (measure (struct arms))
  (match arms
    (Nil (Pair None (rev acc)))
    ((Cons (SList (Cons p (Cons b Nil))) rest)
     (match (read_epat r st p)
       ((PErr e m) (Pair (Some (Pair e m)) Nil))
       ((POk pat names ghosts)
        (match (read_et (rd_bind_all (rd_ghost_all r ghosts) names (pat_types (rd_es r) st pat)) b)
          ((TErr e m) (Pair (Some (Pair e m)) Nil))
          ((TOk body) (read_earms r st rest (Cons (EArm pat body) acc)))))))
    (_ (Pair (Some (Pair (quote bad_shape) "an arm is (PAT E)")) Nil))))

;; a match whose rows all read is refused where a row that matches every value has rows
;; after it: those can never be taken, and a constructor's name that resolved to nothing is
;; read as such a row. The rows as read, beside their source
(fn dead_row_in ((as (List EArm)) (arms (List SExpr))) (Option (List Int))
  (measure (struct as))
  (match as
    ((Cons (EArm pat _) ar)
     (match arms
       ((Cons (SList (Cons p _)) sr)
        (match (dead_rows pat p (len ar))
          ((Some m) (Some m))
          (None (dead_row_in ar sr))))
       (_ None)))
    (Nil None)))
;; the refusal's text for a row that matches every value, `after` rows following it
(fn dead_rows ((pat EPat) (p SExpr) (after Int)) (Option (List Int))
  (if (< after 1) None
  (match pat
    (PVar
      (match p
        ((SSym x)
         (if (sym_eq x (quote _))
           (Some
             (append "the row _ matches every value, so the "
               (append (show_nat after)
                 " row(s) after it can never be taken: a catch-all is the last row")))
           (Some
             (append "the row "
               (append (chars_of_sym x)
                 (append " binds a variable and matches every value, so the "
                   (append (show_nat after)
                     (append " row(s) after it can never be taken: no constructor named "
                       (append (chars_of_sym x)
                         " is in scope — write the constructor as its type spells it, or make a catch-all the last row")))))))))
        (_ None)))
    (_ None))))
;; ---- patterns: the variables in capture order (leftmost first) ------------------------------
;; a pattern at the scrutinee's static type, as far as the declarations fix it: its runtime
;; variables, and the names it gives erased fields (proofs). A constructor's name is the E
;; table's in scope; a name the scope does not resolve is the constructor it names under the
;; scrutinee's own inductive (`CAtom` at a `CNode` is `CNode.CAtom`), as the typed route reads
;; a pattern's head (scope.shard resolve_ctor)
(type PRes (POk EPat (List Name) (List Name)) (PErr Symbol (List Int)))
(fn read_epat ((r Rd) (st (Option EType)) (s SExpr)) PRes
  (measure (struct s))
  (match s
    ((SNum k) (POk (PLit (if (< k 0) (LInt k) (LNat k))) Nil Nil))
    ((SStr _) (PErr (quote pattern_literal) "a string is not a pattern: match its Cons and Nil"))
    ((SSymU _ _) (PErr (quote bad_universe_suffix) "a pattern takes no universe arguments"))
    ((SSym x)
     (match (name_of_sym x)
       (None (PErr (quote bad_name) (chars_of_sym x)))
       ((Some n)
        (match (only_ctors (eresolve (rd_es r) (rd_sc r) n))
          (Nil
            (match (ctor_at r st n)
              ((Some (Pair id k))
               ;; under the scrutinee's inductive: its constructor where that has no fields,
               ;; else a variable (elab.shard el_pat)
               (if (= k 0) (POk (PCtor id Nil) Nil Nil) (POk PVar (list n) Nil)))
              (None
                (match (only_values (eresolve (rd_es r) (rd_sc r) n))
                  (Nil (POk PVar (list n) Nil))
                  ((Cons (EHit id _ _) _)
                   (PErr (quote pattern_name)
                     (append (show_name id)
                       " is a function: a pattern variable may not shadow one (it would match anything)")))))))
          ((Cons (EHit id _ (EICtor _ _ k)) Nil)
           (if (= k 0) (POk (PCtor id Nil) Nil Nil)
           (PErr (quote pattern_arity)
             (append (show_name id) (append " has " (append (show_nat k) " fields"))))))
          ((Cons (EHit a _ _) (Cons (EHit b _ _) _))
           (PErr (quote ambiguous_head) (ambiguous_msg n a b)))
          (_ (PErr (quote bad_pattern) (show_name n)))))))
    ((SList (Cons (SSym h) subs))
     (if (sym_eq h (quote quote))
       (match subs
         ((Cons (SSym q) Nil) (POk (PLit (LSym q)) Nil Nil))
         (_ (PErr (quote bad_shape) "(quote SYMBOL)")))
       (match (name_of_sym h)
         (None (PErr (quote bad_name) (chars_of_sym h)))
         ((Some n)
          (match (only_ctors (eresolve (rd_es r) (rd_sc r) n))
            (Nil
              (match (ctor_at r st n)
                ((Some (Pair id _)) (read_ctor_pat r st id subs))
                (None
                  (match (row_ctor r n)
                    ((Some k) (read_row_pat r k subs))
                    (None (PErr (quote unknown_head) (append (show_name n) " is not a constructor")))))))
            ((Cons (EHit id _ (EICtor _ _ _)) Nil) (read_ctor_pat r st id subs))
            ((Cons (EHit a _ _) (Cons (EHit b _ _) _))
             (PErr (quote ambiguous_head) (ambiguous_msg n a b)))
            (_ (PErr (quote bad_pattern) (show_name n))))))))
    (_ (PErr (quote bad_pattern) "a pattern is _, NAME, NUMERAL or (CTOR PAT…)"))))
;; a row's constructor: its pattern is its one runtime field's pattern, on the scrutinee itself
;; (erasure.shard mt_epat); the erased fields' names are proofs
(fn row_ctor ((r Rd) (n Name)) (Option Name)
  (if (bool_not (init_seen (rd_sc r))) None
  (match (resolve (cx0 (rd_sc r) (rd_env r) Nil Nil) n)
    ((RName k _)
     (match (env_find (rd_env r) k)
       ((Some (CtorInfo _ ind _ _ _ _)) (if (rep_row ind) (Some k) None))
       (_ None)))
    (_ None))))
(fn read_row_pat ((r Rd) (k Name) (subs (List SExpr))) PRes
  (match (ctor_data_flags (w0 (rd_env r)) (rd_es r) (rd_sc r) k)
    (None (PErr (quote bad_pattern) (show_name k)))
    ((Some flags)
     (if (bool_not (= (len flags) (len subs)))
       (PErr (quote pattern_arity)
         (append (show_name k)
           (append " has "
             (append (show_nat (len flags)) (append " fields, the pattern " (show_nat (len subs)))))))
       (match (read_epats r Nil flags subs Nil Nil Nil)
         ((Pair (Some (Pair e m)) _) (PErr e m))
         ((Pair None (Pair (Cons p Nil) (Pair names ghosts))) (POk p names ghosts))
         ((Pair None _)
          (PErr (quote bad_pattern)
            (append (show_name k) ": a row's constructor has exactly one runtime field"))))))))
;; the constructor a name is under the scrutinee's inductive, with its written fields' number
(fn ctor_at ((r Rd) (st (Option EType)) (n Name)) (Option (Pair Name Int))
  (match st
    ((Some (ETCon ind _))
     (match (es_info (rd_es r) ind)
       ((Some (EIInd _ ctors))
        (let ((id (name_append ind n)))
          (if (mem_name id ctors) (Some (Pair id (len (pat_fields r id)))) None)))
       (_ None)))
    (_ None)))
;; a constructor's fields as a pattern writes them: True for a runtime field, False for an
;; erased one — all of K's where K holds the constructor, else the E table's runtime fields
(fn pat_fields ((r Rd) (id Name)) (List Bool)
  (match (if (init_seen (rd_sc r)) (ctor_data_flags (w0 (rd_env r)) (rd_es r) (rd_sc r) id) None)
    ((Some flags) flags)
    (None
      (match (es_info (rd_es r) id)
        ((Some (EICtor _ _ k)) (trues k))
        (_ Nil)))))
(fn read_ctor_pat ((r Rd) (st (Option EType)) (id Name) (subs (List SExpr))) PRes
  (let ((flags (pat_fields r id)))
    (if (bool_not (= (len flags) (len subs)))
      (PErr (quote pattern_arity)
        (append (show_name id)
          (append " has "
            (append (show_nat (len flags)) (append " fields, the pattern " (show_nat (len subs)))))))
      (match
        (read_epats r
          (match (ctor_field_types (rd_es r) st id)
            ((Some fts) (some_all fts))
            (None Nil))
          flags
          subs
          Nil
          Nil
          Nil)
        ((Pair (Some (Pair e m)) _) (PErr e m))
        ((Pair None (Pair ps (Pair names ghosts))) (POk (PCtor id ps) names ghosts))))))
;; the fields' patterns in order: a runtime field's at its type (`sts`: the runtime fields'
;; types, none known where empty), an erased field's a name bound as a proof
(fn read_epats
  ((r Rd)
   (sts (List (Option EType)))
   (flags (List Bool))
   (ss (List SExpr))
   (pacc (List EPat))
   (nacc (List Name))
   (gacc (List Name)))
  (Pair (Option (Pair Symbol (List Int))) (Pair (List EPat) (Pair (List Name) (List Name))))
  (measure (struct ss))
  (match ss
    (Nil (Pair None (Pair (rev pacc) (Pair nacc gacc))))
    ((Cons s rest)
     (match flags
       ((Cons False fr)
        (match s
          ((SSym x)
           (match (name_of_sym x)
             (None (Pair (Some (Pair (quote bad_name) (chars_of_sym x))) (Pair Nil (Pair Nil Nil))))
             ((Some n) (read_epats r sts fr rest pacc nacc (append gacc (list n))))))
          (_
            (Pair
              (Some
                (Pair (quote bad_pattern)
                  "an erased field's pattern is a name: a proof has no constructor to match"))
              (Pair Nil (Pair Nil Nil))))))
       (_
         (match
           (read_epat r
             (match sts
               ((Cons t _) t)
               (Nil None))
             s)
           ((PErr e m) (Pair (Some (Pair e m)) (Pair Nil (Pair Nil Nil))))
           ((POk p names ghosts)
            (read_epats r
              (match sts
                ((Cons _ tr) tr)
                (Nil Nil))
              (match flags
                ((Cons _ fr) fr)
                (Nil Nil))
              rest
              (Cons p pacc)
              (append nacc names)
              (append gacc ghosts)))))))))

;; (let ((x E)…) E): sequential — each right-hand side sees the bindings before it. Where the
;; file sees Init a binding may state its type, (x TYPE E): at a proposition it is a proof and
;; vanishes with its variable, as the erasure drops it; a let of proofs alone is its body
(fn read_elet ((r Rd) (args (List SExpr))) TRes
  (match args
    ((Cons (SList binds) (Cons body Nil))
     (match (read_ebinds r binds Nil)
       ((Pair (Some (Pair e m)) _) (TErr e m))
       ((Pair None (Pair rhss r1))
        (match (read_et r1 body)
          ((TErr e m) (TErr e m))
          ((TOk b)
           (match rhss
             (Nil (TOk b))
             (_ (TOk (if (init_seen (rd_sc r)) (let_chain rhss b) (ELet rhss b))))))))))
    (_ (TErr (quote bad_shape) "(let ((x E)…) E)"))))
;; where the file sees Init a let of several bindings is a let in a let, one binding each: the
;; elaborator reads the form so, and the erasure writes K's lets one by one
(fn let_chain ((rs (List ETerm)) (b ETerm)) ETerm
  (measure (struct rs))
  (match rs
    (Nil b)
    ((Cons v r) (ELet (list v) (let_chain r b)))))
(fn read_ebinds ((r Rd) (binds (List SExpr)) (acc (List ETerm)))
  (Pair (Option (Pair Symbol (List Int))) (Pair (List ETerm) Rd))
  (measure (struct binds))
  (match binds
    (Nil (Pair None (Pair (rev acc) r)))
    ((Cons (SList (Cons (SSym x) (Cons e Nil))) rest) (read_ebind r x e rest acc))
    ((Cons (SList (Cons (SSym x) (Cons ty (Cons e Nil)))) rest)
     (if (bool_not (init_seen (rd_sc r)))
       (Pair (Some (Pair (quote bad_shape) "a binding is (NAME E)")) (Pair Nil r))
     (if (prop_type r ty)
       (if (bool_not (rd_checked r))
         (Pair
           (Some
             (Pair (quote unchecked_proof)
               "a let binds a proof, and this body has no L reading — nothing checks it"))
           (Pair Nil r))
         (match (name_of_sym x)
           (None (Pair (Some (Pair (quote bad_name) (chars_of_sym x))) (Pair Nil r)))
           ((Some n) (read_ebinds (rd_ghost r n) rest acc))))
       (read_ebind r x e rest acc))))
    (_ (Pair (Some (Pair (quote bad_shape) "a binding is (NAME E)")) (Pair Nil r)))))
(fn read_ebind ((r Rd) (x Symbol) (e SExpr) (rest (List SExpr)) (acc (List ETerm)))
  (Pair (Option (Pair Symbol (List Int))) (Pair (List ETerm) Rd))
  (match (name_of_sym x)
    (None (Pair (Some (Pair (quote bad_name) (chars_of_sym x))) (Pair Nil r)))
    ((Some n)
     (match (read_et r e)
       ((TErr e2 m) (Pair (Some (Pair e2 m)) (Pair Nil r)))
       ((TOk t) (read_ebinds (rd_bind r n (rd_type r t)) rest (Cons t acc)))))))

(fn read_eif ((r Rd) (args (List SExpr))) TRes
  (match args
    ((Cons c (Cons a (Cons b Nil)))
     (match (read_cond r c)
       ((TErr e m) (TErr e m))
       ((TOk tc)
        (match (read_et r a)
          ((TErr e m) (TErr e m))
          ((TOk ta)
           (match (read_et r b)
             ((TErr e m) (TErr e m))
             ((TOk tb) (TOk (EIf tc ta tb)))))))))
    (_ (TErr (quote bad_shape) "(if E E E)"))))

;; (list a b…): the constructor chain of the `List` in scope — the
;; two-constructor type `List` resolves to (the toolchain prelude's, Init's), its first
;; constructor nil and its second cons. "…": a String — its UTF-8
;; bytes as Init's List cells, String's representation — carried as one literal the linker
;; builds once (prog.shard LStr); in the toolchain's own sources the chain of the List
;; in scope over its bytes
(fn read_elist ((r Rd) (args (List SExpr))) TRes
  (match (list_in_scope r)
    (None (TErr (quote no_list) "(list …) needs a two-constructor List in scope"))
    ((Some (Pair nil_id cons_id))
     (match (read_ets_list r args Nil)
       ((Pair (Some (Pair e m)) _) (TErr e m))
       ((Pair None ts) (TOk (cons_chain cons_id nil_id ts)))))))
(fn read_estr ((r Rd) (bs (List Int))) TRes
  (if (toolchain_scope (rd_sc r))
    (match (list_in_scope r)
      (None (TErr (quote no_list) "\"…\" needs a two-constructor List in scope"))
      ((Some (Pair nil_id cons_id)) (TOk (ELit (LStr nil_id cons_id bs)))))
    (match (if (visible (rd_sc r) (nm_string)) (env_find (rd_env r) (nm_string)) None)
      ;; String is Init's: seen only where the file sees Init
      (None
        (TErr (quote no_string)
          "\"…\" is a String, which is Init's, and this file does not import Init: write (import Init) before the file's first declaration"))
      ((Some _)
       (if (utf8_ok bs) (TOk (ELit (LStr (nm_list_nil) (nm_list_cons) bs)))
       (TErr (quote bad_string) "a string literal's bytes are not UTF-8"))))))
(fn list_in_scope ((r Rd)) (Option (Pair Name Name))
  (match (type_ident (rd_es r) (rd_sc r) (rd_env r) (n1 (quote List)))
    ((TyOk (ETCon id _) _)
     (match (es_info (rd_es r) id)
       ((Some (EIInd _ (Cons nl (Cons cs Nil)))) (Some (Pair nl cs)))
       (_ None)))
    (_ None)))
(fn cons_chain ((c Name) (nl Name) (ts (List ETerm))) ETerm
  (measure (struct ts))
  (match ts
    (Nil (ECtor nl Nil))
    ((Cons t r) (ECtor c (list t (cons_chain c nl r))))))

;; ---- the declarations -------------------------------------------------------------------------
;; COkT: a fn whose body takes instances — the lambdas it lifted, each a fn with its
;; program, and the instances it demands
(type CRes (COk EDecl) (COkT EDecl (List EDecl) (List EDemand)) (CErr Symbol (List Int)))
;; fn / extern / type / sig fn / sig type: the form read alone — the program's only reading
(fn classify_form ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) CRes
  (classify_as es sc env False s))
;; a fn the typed route has read and given a program: the second reading of the same form
;; (loader.shard both_recs). Its proofs were checked there, and are passed over here
(fn classify_checked ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) CRes
  (classify_as es sc env True s))
(fn classify_as ((es ESt) (sc Scope) (env CheckedEnv) (checked Bool) (s SExpr)) CRes
  (match s
    ((SList (Cons (SSym h) args))
     (if (sym_eq h (quote fn)) (read_efn es sc env checked args)
     (if (sym_eq h (quote extern)) (read_eextern es sc env args)
     (if (sym_eq h (quote type)) (read_etype_decl es sc env args)
     (if (sym_eq h (quote sig))
       (match args
         ((Cons (SSym k) rest)
          (if (sym_eq k (quote fn)) (read_esig_fn es sc env rest)
          (if (sym_eq k (quote type))
            (match rest
              ((Cons hd Nil) (read_esig_type es sc hd))
              (_ (CErr (quote bad_shape) "(sig type NAME)")))
            (CErr (quote bad_shape) "(sig fn …) or (sig type …)"))))
         (_ (CErr (quote bad_shape) "(sig fn …) or (sig type …)")))
       (CErr (quote unknown_form) (chars_of_sym h)))))))
    (_ (CErr (quote unknown_form) "a top-level form is (KEYWORD …)"))))

;; a supplied realize — (realize NAME ((x TYPE)…) RET (measure M)? BODY (equations …)?) — read
;; as the fn it is: the realized constant's program under that constant's identity — a head
;; of the table, as pre_realize made it or, for a constant this file defined after its
;; forms were pre-registered, as made here; the equations it cites are K's. None for a form
;; that supplies no body. The typed route has read the same form (loader.shard both_realized)
(fn classify_realize ((es ESt) (sc Scope) (env CheckedEnv) (id Name) (s SExpr)) (Option CRes)
  (match s
    ((SList (Cons _ (Cons (SSym _) (Cons (SList bs) (Cons ret (Cons b rest))))))
     (Some
       (read_fn_rest (if (es_has es id) es (es_register es id (sc_tag sc) (EIFn (len bs)))) sc env
         True
         id
         Nil
         bs
         ret
         (without_equations (Cons b rest)))))
    (_ None)))
(fn without_equations ((rest (List SExpr))) (List SExpr)
  (measure (struct rest))
  (match rest
    (Nil Nil)
    ((Cons (SList (Cons (SSym h) more)) Nil)
     (if (sym_eq h (quote equations)) Nil (list (SList (Cons (SSym h) more)))))
    ((Cons x r) (Cons x (without_equations r)))))

;; HEAD: NAME (the type parameters are `(T Type)` binders; a parameterized head is refused)
(fn head_params ((hd SExpr)) (Pair (Option Name) (List Name))
  (match hd
    ((SSym x) (Pair (name_of_sym x) Nil))
    (_ (Pair None Nil))))
;; ((x TYPE)…): the runtime binders' names and E-types in order; `(T Type)` declares a type
;; parameter. Where the file sees Init a binder whose type is a proposition is a proof — written,
;; and no parameter of the program — and one of type `Prop` or a function into it is a
;; predicate. With them: every binder as the body's context has it (innermost first), and each
;; written binder's flags in order — explicit, runtime data — which a call of the fn is read by
(type PmRes
  (PmOk (List Name) (List EType) (List Name) (List Bd) (List (Pair Bool Symbol)))
  (PmErr Symbol (List Int)))
(fn read_params
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (checked Bool)
   (tps (List Name))
   (bs (List SExpr))
   (names (List Name))
   (types (List EType))
   (bds (List Bd))
   (flags (List (Pair Bool Symbol))))
  PmRes
  (measure (struct bs))
  (match bs
    (Nil (PmOk (rev names) (rev types) tps bds (rev flags)))
    ((Cons (SList (Cons (SSym x) (Cons ty Nil))) rest)
     (match (name_of_sym x)
       (None (PmErr (quote bad_binder) (chars_of_sym x)))
       ((Some n)
        (if (is_type_sym ty)  ; `(T Type)` is a type parameter in every file
          (read_params es sc env checked (append tps (list n)) rest names types
            (if (init_seen sc) (Cons (BdGhost n False) bds) bds)
            (Cons (Pair False (quote drop)) flags))
        (if (if (ghosts_read sc checked) (is_pred_sort ty) False)
          (read_params es sc env checked tps rest names types (Cons (BdGhost n True) bds)
            (Cons (Pair True (quote proof)) flags))
          ;; an `if`, not bool_and: the test resolves the type's head, and is run only where asked
          (if (if (ghosts_read sc checked) (prop_type (Rd es sc env bds None checked) ty) False)
            (read_params es sc env checked tps rest names types (Cons (BdGhost n False) bds)
              (Cons (Pair True (quote proof)) flags))
            (match (read_ety es sc env tps ty)
              ((TyErr e m) (PmErr e m))
              ((TyOk t tps1)
               (read_params es sc env checked tps1 rest (Cons n names) (Cons t types)
                 (Cons (BdVar n (Some t)) bds)
                 (Cons (Pair True (quote keep)) flags))))))))))
    (_ (PmErr (quote bad_binder) "a binder is (x TYPE)"))))
;; a binder that is a proof or a predicate is read as one where the file sees Init and the
;; typed route has read the form: a hypothesis nothing checked is no hypothesis
(fn ghosts_read ((sc Scope) (checked Bool)) Bool (bool_and checked (init_seen sc)))
(fn is_type_sym ((s SExpr)) Bool
  (match s
    ((SSym x) (sym_eq x (quote Type)))
    (_ False)))
;; the forms after RET: BODY, or (measure M) BODY
(fn measure_body ((rest (List SExpr))) (Pair (Option SExpr) (Option SExpr))
  (match rest
    ((Cons b Nil) (Pair (Some b) None))
    ((Cons (SList (Cons (SSym m) (Cons e Nil))) (Cons b Nil))
     (if (sym_eq m (quote measure)) (Pair (Some b) (Some e)) (Pair None None)))
    (_ (Pair None None))))
(type RcRes (RcOk ERec) (RcErr Symbol (List Int)))
(fn read_rec ((r Rd) (pnames (List Name)) (meas (Option SExpr))) RcRes
  (match meas
    (None (RcOk RecNone))
    ((Some (SList (Cons (SSym s) (Cons (SSym x) Nil))))
     (if (sym_eq s (quote struct))
       (match (name_of_sym x)
         (None (RcErr (quote bad_measure) (chars_of_sym x)))
         ((Some n)
          (match (index_of n pnames 0)
            ((Some i) (RcOk (RecStruct i)))
            (None (RcErr (quote bad_measure) (append (show_name n) " is not a parameter"))))))
       (read_measure r (SList (Cons (SSym s) (Cons (SSym x) Nil))))))
    ((Some m) (read_measure r m))))
;; a measure term over the parameters. One that cites a function with no program — a
;; definition and nothing more, a derived size — is K's alone: the program's clause says so
;; and holds no term (erasure.shard predef_rec)
(fn read_measure ((r Rd) (m SExpr)) RcRes
  (match (read_et r m)
    ((TErr e m2) (if (sym_eq e (quote no_realization)) (RcOk RecLogical) (RcErr e m2)))
    ((TOk t) (RcOk (RecMeasure t)))))

;; (fn HEAD BINDERS RET (measure M)? BODY)
(fn read_efn ((es ESt) (sc Scope) (env CheckedEnv) (checked Bool) (args (List SExpr))) CRes
  (match args
    ((Cons hd (Cons (SList bs) (Cons ret rest)))
     (match (head_params hd)
       ((Pair None _) (CErr (quote bad_name) "a declared name is NAME"))
       ((Pair (Some short) tps0)
        (read_fn_rest es sc env checked (qualify sc short) tps0 bs ret rest))))
    (_ (CErr (quote bad_shape) "(fn NAME ((x TYPE)…) RET (measure M)? BODY)"))))
;; BINDERS RET (measure M)? BODY under the identity id
(fn read_fn_rest
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (checked Bool)
   (id Name)
   (tps0 (List Name))
   (bs (List SExpr))
   (ret SExpr)
   (rest (List SExpr)))
  CRes
  (match (read_params es sc env checked tps0 bs Nil Nil Nil Nil)
    ((PmErr e m) (CErr e m))
    ((PmOk pnames ptypes tps1 bds flags)
     (match (read_ety es sc env tps1 ret)
       ((TyErr e m) (CErr e m))
       ((TyOk rt tps2)
        (let ((r (Rd es sc env bds (Some (Pair id flags)) checked)))
          (match (measure_body rest)
            ((Pair None _) (CErr (quote bad_shape) "NAME ((x TYPE)…) RET (measure M)? BODY"))
            ((Pair (Some body) meas)
             (match (read_et r body)
               ((TErr e m) (CErr e m))
               ((TOk t00)
                (match
                  (take_instances es sc (some_all (rev ptypes))
                    ;; typed with the fn's own signature in the table: a call of itself has a type
                    (settle_body (es_add_decl es (EFn id (len tps2) ptypes rt RecNone t00)) sc env
                      (some_all (rev ptypes))
                      (Some rt)
                      t00)
                    (tk_new id))
                  ;; the instances the body takes, the lambdas it lifts
                  ((TkErr e m) (CErr e m))
                  ((TkOk t tk)
                   (match (read_rec r pnames meas)
                     ((RcErr e m) (CErr e m))
                     ((RcOk rec0)
                      (let ((rec (settle_rec es sc env (some_all (rev ptypes)) rec0)))
                        (match
                          (match (classify_both es id (some_all (rev ptypes)) t rec)
                            ((Some x) (Some x))
                            (None (classify_lifted es (tk_lifted tk))))
                          ((Some (Pair e m)) (CErr e m))
                          (None
                            (let
                              ((d (EFn id (len tps2) ptypes rt (expand_rec rec) (expand_rows t))))
                              (match (tk_demands tk)
                                (Nil (COk d))
                                (eds (COkT d (tk_lifted tk) eds)))))))))))))))))))))
;; the body, then a measure term, each over the parameters
(fn classify_both ((es ESt) (id Name) (tys (List (Option EType))) (t ETerm) (rec ERec))
  (Option (Pair Symbol (List Int)))
  (match (classify_body es id tys t)
    ((Some e) (Some e))
    (None
      (match rec
        ((RecMeasure m) (classify_body es id tys m))
        (_ None)))))
(fn some_all ((ts (List EType))) (List (Option EType))
  (measure (struct ts))
  (match ts
    (Nil Nil)
    ((Cons t r) (Cons (Some t) (some_all r)))))

;; (extern HEAD BINDERS RET)
(fn read_eextern ((es ESt) (sc Scope) (env CheckedEnv) (args (List SExpr))) CRes
  (match (read_esignature es sc env args)
    ((SgErr e m) (CErr e m))
    ((SgOk id nt ps rt) (COk (EExtern id nt ps rt)))))
(fn read_esig_fn ((es ESt) (sc Scope) (env CheckedEnv) (args (List SExpr))) CRes
  (match (read_esignature es sc env args)
    ((SgErr e m) (CErr e m))
    ((SgOk id nt ps rt) (COk (ESig id nt ps rt)))))
(type SgRes (SgOk Name Int (List EType) EType) (SgErr Symbol (List Int)))
(fn read_esignature ((es ESt) (sc Scope) (env CheckedEnv) (args (List SExpr))) SgRes
  (match args
    ((Cons hd (Cons (SList bs) (Cons ret Nil)))
     (match (head_params hd)
       ((Pair None _) (SgErr (quote bad_name) "a declared name is NAME"))
       ((Pair (Some short) tps0)
        (match (read_params es sc env False tps0 bs Nil Nil Nil Nil)
          ((PmErr e m) (SgErr e m))
          ((PmOk _ ptypes tps1 _ _)
           (match (read_ety es sc env tps1 ret)
             ((TyErr e m) (SgErr e m))
             ((TyOk rt tps2) (SgOk (qualify sc short) (len tps2) ptypes rt))))))))
    (_ (SgErr (quote bad_shape) "NAME ((x TYPE)…) RET"))))
(fn read_esig_type ((es ESt) (sc Scope) (hd SExpr)) CRes
  (match (type_head sc hd)
    ((Pair None m) (CErr (quote bad_name) m))
    ((Pair (Some (Pair n params)) _) (COk (ESigType n (len params))))))

;; (type HEAD (CTOR FIELD-TYPE…)…): the E inductive; field types over the declared parameters only
(fn read_etype_decl ((es ESt) (sc Scope) (env CheckedEnv) (args (List SExpr))) CRes
  (match args
    ((Cons hd ctors)
     (match (type_head sc hd)
       ((Pair None m) (CErr (quote bad_name) m))
       ((Pair (Some (Pair n params)) _)
        (match (read_ectors es sc env params n ctors Nil)
          ((Pair (Some (Pair e m)) _) (CErr e m))
          ((Pair None cs) (COk (EInd n (len params) cs)))))))
    (_ (CErr (quote bad_shape) "(type (NAME T…) (CTOR FIELD-TYPE…)…)"))))
(fn read_ectors
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (params (List Name))
   (ind Name)
   (cs (List SExpr))
   (acc (List ECtorDef)))
  (Pair (Option (Pair Symbol (List Int))) (List ECtorDef))
  (measure (struct cs))
  (match cs
    (Nil (Pair None (rev acc)))
    ((Cons (SList (Cons (SSym cn) fields)) r)
     (match (name_of_sym cn)
       (None (Pair (Some (Pair (quote bad_name) (chars_of_sym cn))) Nil))
       ((Some short)
        (match (read_etys es sc env params fields Nil)
          ((Pair (TyErr e m) _) (Pair (Some (Pair e m)) Nil))
          ((Pair (TyOk _ tps1) fts)
           (if (bool_not (= (len tps1) (len params)))
             (Pair
               (Some
                 (Pair (quote unknown_type)
                   (append "in "
                     (append (show_name (name_append ind short))
                       ": a field names a type this file cannot see"))))
               Nil)
             (read_ectors es sc env params ind r (Cons (ECtorDef (name_append ind short) fts) acc))))))))
    (_ (Pair (Some (Pair (quote bad_constructor) "a constructor is (CTOR FIELD-TYPE…)")) Nil))))

;; ---- the operators of a body, by their operands' types ------------------------------------
;; An operator's meaning is its operands' type (LANGUAGE.md, Terms): `-` at Nat is Nat.sub;
;; `/` and `mod` are Nat.div and Nat.mod there, Int.ediv and Int.emod at Int; a comparison
;; where Init's Bool is expected is the decision's value, (if TEST true false). On the typed
;; route the elaborator resolves these and the erasure writes the table's entry; this pass
;; writes the same entries into a body read here, from the types its binders state. A numeral
;; takes the type of the operand beside it, else the type expected of the operation, else Nat.
;; A file that sees no Init has no Nat, and its `/` and `mod` are the bare entries: its bodies
;; are left as read.
(fn settle_body
  ((es ESt) (sc Scope) (env CheckedEnv) (tys (List (Option EType))) (exp (Option EType)) (t ETerm))
  ETerm
  (if (init_seen sc) (settle_ops es (derived_eqs es sc env) tys exp t) t))
(fn settle_rec ((es ESt) (sc Scope) (env CheckedEnv) (tys (List (Option EType))) (rec ERec)) ERec
  (match rec
    ((RecMeasure m) (RecMeasure (settle_body es sc env tys (Some (ETCon (nm_nat) Nil)) m)))
    (_ rec)))
;; the decisions of equality derived and visible here, each at the E type of the type it was
;; derived at (scope.shard's table keys them by the L type)
(fn derived_eqs ((es ESt) (sc Scope) (env CheckedEnv)) (List (Pair EType Name))
  (derived_etypes es sc env (derived_visible sc (quote eq))))
(fn derived_etypes ((es ESt) (sc Scope) (env CheckedEnv) (ds (List (Pair Expr Name))))
  (List (Pair EType Name))
  (measure (struct ds))
  (match ds
    (Nil Nil)
    ((Cons (Pair t p) r)
     (match (l_to_etype (w0 env) es sc t Nil Nil)
       ((Pair _ (Some ty)) (Cons (Pair ty p) (derived_etypes es sc env r)))
       ((Pair _ None) (derived_etypes es sc env r))))))
;; the decisions at one type, each once
(fn derived_at ((dv (List (Pair EType Name))) (t EType) (acc (List Name))) (List Name)
  (measure (struct dv))
  (match dv
    (Nil acc)
    ((Cons (Pair ty p) r)
     (derived_at r t (if (bool_and (etype_eq ty t) (bool_not (mem_name p acc))) (Cons p acc) acc)))))
(fn settle_ops
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (t ETerm))
  ETerm
  (measure (struct t))
  (match t
    ((EBVar _) t)
    ((ELit _) t)
    ((ECtor c as) (ECtor c (settle_args es dv tys (ctor_ptypes es c exp) as)))
    ((ECall f as)
     (match (es_info es f)
       ((Some (EITemplate _ ebs rt nt)) (ECall f (settle_tm es dv tys exp ebs rt nt as)))
       (_ (ECall f (settle_args es dv tys (head_ptypes es f exp) as)))))
    ((EExt f as) (EExt f (settle_args es dv tys (head_ptypes es f exp) as)))
    ((EPrim p as) (settle_prim es dv tys exp p as))
    ((EMatch s arms)
     (let ((s1 (settle_ops es dv tys None s)))
       (EMatch s1 (settle_arms es dv tys (c_type es tys s1) exp arms))))
    ((ELet rs b) (settle_let es dv tys exp rs b Nil))
    ((EIf c a b)
     (EIf (settle_ops es dv tys None c) (settle_ops es dv tys exp a) (settle_ops es dv tys exp b)))
    ((ELam ts rt b) (ELam ts rt (settle_ops es dv (rev_onto (some_all ts) tys) rt b)))
    (EAbsurd t)))
;; a template's call, its arguments read in the elaborator's order (elab.shard elab_args): the
;; bare variables first, each fixing type parameters by its type; then the type expected of
;; the call against the template's result; then the other arguments left to right, each at
;; its binder's type as fixed so far; the numerals last. A lambda's binders fix its static
;; parameter's domains; its body is read at the parameter's result type where that is fixed,
;; and its result type — the parameter's, else its body's own — is kept with it for the lift
(fn settle_tm
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (ebs (List EBind))
   (rt EType)
   (nt Int)
   (as (List ETerm)))
  (List ETerm)
  (let ((sub0 (tm_pass es Nil tys ebs as 0 Nil)))
    (settle_tm_args es dv tys ebs nt as
      (match exp
        ((Some e) (unify_ty rt e sub0))
        (None sub0)))))
(fn settle_tm_args
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (ebs (List EBind))
   (nt Int)
   (as (List ETerm))
   (sub (List (Pair Int EType))))
  (List ETerm)
  (measure (struct as))
  (match as
    (Nil Nil)
    ((Cons a ar)
     (match ebs
       (Nil (Cons (settle_ops es dv tys None a) (settle_tm_args es dv tys Nil nt ar sub)))
       ((Cons b br)
        (if (bool_not (= (tm_arg_pass a) 1)) (Cons a (settle_tm_args es dv tys br nt ar sub))
        (let ((a1 (settle_tm_arg es dv tys b nt a sub)))
          (Cons a1 (settle_tm_args es dv tys br nt ar (tm_bind es Nil tys b a1 sub))))))))))
(fn settle_tm_arg
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (b EBind)
   (nt Int)
   (a ETerm)
   (sub (List (Pair Int EType))))
  ETerm
  (match b
    ((EBData ty) (settle_ops es dv tys (fixed_type ty sub nt) a))
    ((EBStatic doms res)
     (match a
       ((ELam ts _ body)
        (let
          ((expb (fixed_type res (unify_tys doms ts sub) nt)) (tys1 (rev_onto (some_all ts) tys)))
          (let ((body1 (settle_ops es dv tys1 expb body)))
            (ELam ts
              (match expb
                ((Some t) (Some t))
                (None (c_type es tys1 body1)))
              body1))))
       ((ECall g cs)
        (match (shape_signature es Nil g)
          ((Some (Pair ps _)) (ECall g (settle_args es dv tys (take (len cs) ps) cs)))
          (None (settle_ops es dv tys None a))))
       (_ (settle_ops es dv tys None a))))
    (EBPackage a)))
;; a binder's type under the type arguments fixed so far, where they fix all of it
(fn fixed_type ((ty EType) (sub (List (Pair Int EType))) (nt Int)) (Option EType)
  (let ((t (subst_ty (params_from sub nt 0) ty))) (if (< 0 (tvar_count t)) None (Some t))))
;; the arguments, each under its parameter's declared type where the head states one
(fn settle_args
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (pts (List EType))
   (as (List ETerm)))
  (List ETerm)
  (measure (struct as))
  (match as
    (Nil Nil)
    ((Cons a r)
     (match pts
       ((Cons pt pr) (Cons (settle_ops es dv tys (Some pt) a) (settle_args es dv tys pr r)))
       (Nil (Cons (settle_ops es dv tys None a) (settle_args es dv tys Nil r)))))))
(fn settle_arms
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (st (Option EType))
   (exp (Option EType))
   (arms (List EArm)))
  (List EArm)
  (measure (struct arms))
  (match arms
    (Nil Nil)
    ((Cons (EArm p b) r)
     (Cons (EArm p (settle_ops es dv (rev_onto (pat_types es st p) tys) exp b))
       (settle_arms es dv tys st exp r)))))
(fn settle_let
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (rs (List ETerm))
   (b ETerm)
   (out (List ETerm)))
  ETerm
  (measure (struct rs))
  (match rs
    (Nil (ELet (rev out) (settle_ops es dv tys exp b)))
    ((Cons v r)
     (let ((v1 (settle_ops es dv tys None v)))
       (settle_let es dv (Cons (c_type es tys v1) tys) exp r b (Cons v1 out))))))
(fn head_ptypes ((es ESt) (f Name) (exp (Option EType))) (List EType)
  (match (es_find_decl es f)
    ((Some (EFn _ _ ps rt _ _)) (ptypes_under ps rt exp))
    ((Some (ESig _ _ ps rt)) (ptypes_under ps rt exp))
    ((Some (EExtern _ _ ps rt)) (ptypes_under ps rt exp))
    (_ Nil)))
;; a head's parameter types under the type arguments its result type takes from the type
;; expected of the call: `(List.cons (- a 1) xs)` where a `(List Int)` is expected reads its
;; first argument at Int
(fn ptypes_under ((ps (List EType)) (rt EType) (exp (Option EType))) (List EType)
  (match exp
    ((Some e) (subst_tys (params_from (unify_ty rt e Nil) (tvar_count_all (Cons rt ps)) 0) ps))
    (None ps)))
(fn ctor_ptypes ((es ESt) (c Name) (exp (Option EType))) (List EType)
  (match (es_info es c)
    ((Some (EICtor ind _ _))
     (match (es_find_decl es ind)
       ((Some (EInd _ _ cs))
        (match (fields_of cs c)
          ((Some fts)
           (match exp
             ((Some (ETCon ind2 targs)) (if (name_eq ind ind2) (subst_tys targs fts) fts))
             (_ fts)))
          (None Nil)))
       (_ Nil)))
    (_ Nil)))
;; the five operators written bare whose entry is their operands' type's
(fn arith_op ((p Name)) Bool
  (bool_or (name_eq p (n1 (quote +)))
    (bool_or (name_eq p (n1 (quote -)))
      (bool_or (name_eq p (n1 (quote *)))
        (bool_or (name_eq p (n1 (quote /))) (name_eq p (n1 (quote mod))))))))
;; a numeral, or an operator over numerals: it has no type of its own
(fn lit_only ((t ETerm)) Bool
  (measure (struct t))
  (match t
    ((ELit (LNat _)) True)
    ((EPrim p (Cons a (Cons b Nil))) (if (arith_op p) (bool_and (lit_only a) (lit_only b)) False))
    (_ False)))
(fn is_int_type ((t (Option EType))) Bool
  (match t
    ((Some (ETCon n Nil)) (name_eq n (n1 (quote Int))))
    (_ False)))
(fn is_init_bool ((t (Option EType))) Bool
  (match t
    ((Some (ETCon n Nil)) (name_eq n (n1 (quote Bool))))
    (_ False)))
(fn settle_prim
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (p Name)
   (as (List ETerm)))
  ETerm
  (match as
    ((Cons a (Cons b Nil))
     (if (arith_op p)
       ;; under an expected Nat or Int the operation is that type's and both operands are read
       ;; at it — `(- 1 2)` at Int is Int.sub, a Nat local under Int is the integer it is
       (if (bool_or (is_nat_type exp) (is_int_type exp))
         (EPrim (arith_entry p exp) (list (settle_ops es dv tys exp a) (settle_ops es dv tys exp b)))
         (settle_by_operand es dv tys exp p a b))
       (if (cmp_prim p) (settle_by_operand es dv tys exp p a b)
       (EPrim p (settle_args es dv tys (prim_ptypes p) as)))))
    (_ (EPrim p (settle_args es dv tys (prim_ptypes p) as)))))
;; no numeric type expected: the operation is the first operand's type's — of the second where
;; the first is numerals alone — and the other operand is read at that type (elab.shard
;; elab_op_at). An operand whose type the declarations do not fix leaves the operation as written
(fn settle_by_operand
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (p Name)
   (a ETerm)
   (b ETerm))
  ETerm
  (if (bool_and (lit_only a) (bool_not (lit_only b)))
    (settle_second es dv tys exp p a (settle_ops es dv tys None b))
    (settle_first es dv tys exp p (settle_ops es dv tys None a) b)))
(fn settle_first
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (p Name)
   (a1 ETerm)
   (b ETerm))
  ETerm
  (settle_at dv exp p (c_type es tys a1) a1 (settle_ops es dv tys (c_type es tys a1) b)))
(fn settle_second
  ((es ESt)
   (dv (List (Pair EType Name)))
   (tys (List (Option EType)))
   (exp (Option EType))
   (p Name)
   (a ETerm)
   (b1 ETerm))
  ETerm
  (settle_at dv exp p (c_type es tys b1) (settle_ops es dv tys (c_type es tys b1) a) b1))
(fn settle_at
  ((dv (List (Pair EType Name)))
   (exp (Option EType))
   (p Name)
   (ty (Option EType))
   (a2 ETerm)
   (b2 ETerm))
  ETerm
  (if (cmp_prim p)
    (if (is_init_bool exp) (EIf (cmp_cond dv p ty a2 b2) (bool_true) (bool_false))
    (cmp_cond dv p ty a2 b2))
    (EPrim (arith_entry p ty) (list a2 b2))))
;; a comparison as the test an `if` reads: the primitive at Nat and Int; `=` at Init's Bool the
;; test over its operands, at a type with one visible derived equality the call of that
;; decision, whose cell the `if` reads (elab.shard decision_of; erasure.shard erase_cond)
(fn cmp_cond ((dv (List (Pair EType Name))) (p Name) (ty (Option EType)) (a ETerm) (b ETerm)) ETerm
  (if (bool_not (name_eq p (n1 (quote =)))) (EPrim p (list a b))
  (if (bool_or (is_nat_type ty) (is_int_type ty)) (EPrim p (list a b))
  (if (is_init_bool ty) (bool_eq_cond a b)
  (match ty
    ((Some t)
     (match (derived_at dv t Nil)
       ((Cons proc Nil) (ECall proc (list a b)))
       (_ (EPrim p (list a b)))))
    (None (EPrim p (list a b))))))))
(fn arith_entry ((p Name) (ty (Option EType))) Name
  (if (is_nat_type ty)
    (if (name_eq p (n1 (quote -))) (n2 (quote Nat) (quote sub))
    (if (name_eq p (n1 (quote /))) (n2 (quote Nat) (quote div))
    (if (name_eq p (n1 (quote mod))) (n2 (quote Nat) (quote mod))
    p)))
  (if (is_int_type ty)
    (if (name_eq p (n1 (quote /))) (n2 (quote Int) (quote ediv))
    (if (name_eq p (n1 (quote mod))) (n2 (quote Int) (quote emod))
    p))
    p)))
;; the operand type an entry written by name states: Nat for Init's Nat set, Int for its Int
;; divisions and for a row's argument
(fn prim_ptypes ((p Name)) (List EType)
  (match (prim_find p)
    ((Some (Prim code _))
     (if (bool_and (<= 22 code) (<= code 38)) (list (ETCon (nm_nat) Nil) (ETCon (nm_nat) Nil))
     (if (bool_and (<= 18 code) (<= code 21))
       (list (ETCon (n1 (quote Int)) Nil) (ETCon (n1 (quote Int)) Nil))
       Nil)))
    (None Nil)))
;; the rows kept by name while the body was typed, written out: `Int.ofNat x` and a row's
;; projection (`Fin.val i`) are their argument, a row with
;; an expression is the expression over its argument bound once (prog.shard's registry; the
;; typed route's erasure writes the same)
(fn expand_rows ((t ETerm)) ETerm
  (measure (struct t))
  (match t
    ((EBVar _) t)
    ((ELit _) t)
    ((ECtor c as) (ECtor c (expand_all as)))
    ((ECall f as) (ECall f (expand_all as)))
    ((EExt f as) (EExt f (expand_all as)))
    ((EPrim p (Cons a Nil))
     (if (row_identity p) (expand_rows a)
     (match (realization_expr p)
       ((Some body) (ELet (list (expand_rows a)) body))
       (None (EPrim p (list (expand_rows a)))))))
    ((EPrim p as) (EPrim p (expand_all as)))
    ((EMatch s arms) (EMatch (expand_rows s) (expand_arms arms)))
    ((ELet rs b) (ELet (expand_all rs) (expand_rows b)))
    ((EIf c a b) (EIf (expand_rows c) (expand_rows a) (expand_rows b)))
    ((ELam ts rt b) (ELam ts rt (expand_rows b)))
    (EAbsurd t)))
(fn expand_all ((ts (List ETerm))) (List ETerm)
  (measure (struct ts))
  (match ts
    (Nil Nil)
    ((Cons t r) (Cons (expand_rows t) (expand_all r)))))
(fn expand_arms ((arms (List EArm))) (List EArm)
  (measure (struct arms))
  (match arms
    (Nil Nil)
    ((Cons (EArm p b) r) (Cons (EArm p (expand_rows b)) (expand_arms r)))))
(fn expand_rec ((rec ERec)) ERec
  (match rec
    ((RecMeasure m) (RecMeasure (expand_rows m)))
    (_ rec)))

;; ---- the classifier's passes over a read body ------------------------------
(fn classify_body ((es ESt) (id Name) (tys (List (Option EType))) (t ETerm))
  (Option (Pair Symbol (List Int)))
  (if (bool_not (c_exh es t))
    (Some
      (Pair (quote nonexhaustive)
        (append (show_name id) ": a match does not cover its scrutinee's constructors")))
    (match (c_leak es tys t)
      ((Some (Leak st))
       (Some
         (Pair (quote private_match)
           (append (show_name id)
             (append " matches a value of the sig type "
               (append (show_name st)
                 " against a constructor: a sig type has no constructor outside its implementation"))))))
      ((Some (Mismatch st c))
       (Some
         (Pair (quote pattern_type)
           (append (show_name id)
             (append " matches a value of type "
               (append (show_name st) (append " against the constructor " (show_name c))))))))
      ((Some (IfPrivate st))
       (Some
         (Pair (quote private_if)
           (append (show_name id)
             (append " branches on a value of the sig type "
               (append (show_name st)
                 ": an if would read the implementation's constructor order through the view"))))))
      ((Some (PrimType st op))
       (Some
         (Pair (quote prim_type)
           (append (show_name id)
             (append " compares a value of type "
               (append (show_name st)
                 (append " with "
                   (append (show_name op)
                     ": the comparison primitives are the integers', and `=` reads at a type only where exactly one derived equality at it is visible — a (derive TYPE eq) before this form, or the decision called by name, (T.decEq a b)"))))))))
      ((Some (IfType st k))
       (Some
         (Pair (quote if_type)
           (append (show_name id)
             (append " branches on a value of type "
               (append (show_name st)
                 (if (= k 0)
                   ", which is not an inductive type: an if takes a type of two constructors"
                   (append ", which has "
                     (append (show_nat k) " constructors: an if takes a type of two")))))))))
      (None None))))
;; ---- the instances a body takes, the lambdas it lifts ---------------------------------------
;; a static argument's shape as this reader takes it — its identity (a fn or a sig fn of the E
;; table with no type parameters, a lambda the body lifted, a constant of the realization
;; registry, a package constant), the static parameter's arity (0: a package), the captured
;; values' declared types (their count the captured count, the name's second key) — and the
;; instance a body demands: its name, the template, the type arguments solved, the shapes in order
(type EShape (EShape Name Int (List EType)))
(type EDemand (EDemand Name Name (List EType) (List EShape)))
(fn edemand_name ((d EDemand)) Name
  (match d
    ((EDemand n _ _ _) n)))
(fn edemand_template ((d EDemand)) Name
  (match d
    ((EDemand _ c _ _) c)))
;; what taking accumulates: the fn being read, the lambdas lifted so far — their count numbers
;; the next, lam_N under the fn's name — with their programs, and the instances demanded
(type Tk (Tk Name Int (List EDecl) (List EDemand)))
(fn tk_new ((id Name)) Tk (Tk id 0 Nil Nil))
(fn tk_lifted ((k Tk)) (List EDecl)
  (match k
    ((Tk _ _ ls _) ls)))
(fn tk_demands ((k Tk)) (List EDemand)
  (match k
    ((Tk _ _ _ ds) ds)))
(fn tk_numbered ((k Tk) (n Int)) Tk
  (match k
    ((Tk id _ ls ds) (Tk id n ls ds))))
(fn tk_lift ((k Tk) (d EDecl)) Tk
  (match k
    ((Tk id n ls ds) (Tk id n (append ls (list d)) ds))))
(fn tk_demand ((k Tk) (d EDemand)) Tk
  (match k
    ((Tk id n ls ds) (Tk id n ls (add_edemand ds d)))))
;; over the read body with its parameters' types (a match's variables typed from the scrutinee,
;; a let's from its value, as c_type reads them): every call of a template — (ECall T args) with
;; T of the E table as EITemplate — becomes the call of its instance at the captured values then
;; the data, and the instance is demanded of the loader (EDemand); a lambda is lifted
;; (take_lambda); the first refusal stops
(type TkRes (TkOk ETerm Tk) (TkErr Symbol (List Int)))
(fn take_instances ((es ESt) (sc Scope) (tys (List (Option EType))) (t ETerm) (acc Tk)) TkRes
  (measure (struct t))
  (match t
    ((EBVar _) (TkOk t acc))
    ((ELit _) (TkOk t acc))
    ((ECtor c as)
     (match (take_all es sc tys as acc Nil)
       ((TkAllOk as1 acc1) (TkOk (ECtor c as1) acc1))
       ((TkAllErr e m) (TkErr e m))))
    ((ECall f as)
     (match (take_all es sc tys as acc Nil)
       ((TkAllErr e m) (TkErr e m))
       ((TkAllOk as1 acc1)
        (match (es_info es f)
          ((Some (EITemplate _ ebs _ nt))
           (match (captured_bad es tys ebs as)
             ((Some m) (TkErr (quote type_mismatch) m))
             (None (take_instance es sc f ebs nt (tm_solve es Nil tys ebs as) as1 acc1))))
          (_ (TkOk (ECall f as1) acc1))))))
    ((EPrim p as)
     (match (take_all es sc tys as acc Nil)
       ((TkAllOk as1 acc1) (TkOk (EPrim p as1) acc1))
       ((TkAllErr e m) (TkErr e m))))
    ((EExt x as)
     (match (take_all es sc tys as acc Nil)
       ((TkAllOk as1 acc1) (TkOk (EExt x as1) acc1))
       ((TkAllErr e m) (TkErr e m))))
    ((EMatch s arms)
     (match (take_instances es sc tys s acc)
       ((TkErr e m) (TkErr e m))
       ((TkOk s1 acc1)
        (match (take_arms es sc tys (c_type es tys s) arms acc1 Nil)
          ((TkArmsErr e m) (TkErr e m))
          ((TkArmsOk arms1 acc2) (TkOk (EMatch s1 arms1) acc2))))))
    ((ELet rs b) (take_let es sc tys rs b acc Nil))
    ((EIf c a b)
     (match (take_instances es sc tys c acc)
       ((TkErr e m) (TkErr e m))
       ((TkOk c1 acc1)
        (match (take_instances es sc tys a acc1)
          ((TkErr e m) (TkErr e m))
          ((TkOk a1 acc2)
           (match (take_instances es sc tys b acc2)
             ((TkErr e m) (TkErr e m))
             ((TkOk b1 acc3) (TkOk (EIf c1 a1 b1) acc3))))))))
    ((ELam ts rt b) (take_lambda es sc tys ts rt b acc))
    (EAbsurd (TkOk t acc))))
(type TkAll (TkAllOk (List ETerm) Tk) (TkAllErr Symbol (List Int)))
(fn take_all
  ((es ESt) (sc Scope) (tys (List (Option EType))) (ts (List ETerm)) (acc Tk) (out (List ETerm)))
  TkAll
  (measure (struct ts))
  (match ts
    (Nil (TkAllOk (rev out) acc))
    ((Cons t r)
     (match (take_instances es sc tys t acc)
       ((TkErr e m) (TkAllErr e m))
       ((TkOk t1 acc1) (take_all es sc tys r acc1 (Cons t1 out)))))))
(type TkArms (TkArmsOk (List EArm) Tk) (TkArmsErr Symbol (List Int)))
(fn take_arms
  ((es ESt)
   (sc Scope)
   (tys (List (Option EType)))
   (st (Option EType))
   (arms (List EArm))
   (acc Tk)
   (out (List EArm)))
  TkArms
  (measure (struct arms))
  (match arms
    (Nil (TkArmsOk (rev out) acc))
    ((Cons (EArm p b) r)
     (match (take_instances es sc (rev_onto (pat_types es st p) tys) b acc)
       ((TkErr e m) (TkArmsErr e m))
       ((TkOk b1 acc1) (take_arms es sc tys st r acc1 (Cons (EArm p b1) out)))))))
;; a let's bindings in order, each seeing the ones before it, then its body
(fn take_let
  ((es ESt)
   (sc Scope)
   (tys (List (Option EType)))
   (rs (List ETerm))
   (b ETerm)
   (acc Tk)
   (out (List ETerm)))
  TkRes
  (measure (struct rs))
  (match rs
    (Nil
      (match (take_instances es sc tys b acc)
        ((TkErr e m) (TkErr e m))
        ((TkOk b1 acc1) (TkOk (ELet (rev out) b1) acc1))))
    ((Cons v r)
     (match (take_instances es sc tys v acc)
       ((TkErr e m) (TkErr e m))
       ;; typed as read: an instance's call has no type of its own
       ((TkOk v1 acc1) (take_let es sc (Cons (c_type es tys v) tys) r b acc1 (Cons v1 out)))))))
;; a lambda, lifted: OWNER.lam_N, numbered as the lambdas are met — an outer one before those
;; in its body, as the erasure numbers them (erasure.shard lift_lambda). The body's variables
;; that are not the lambda's own are captured, first occurrence first, as the fn's leading
;; parameters at their declared types; its binders follow; its result is the type kept with
;; it (settle_tm), else its body's static type. What it leaves in the body is the fn applied
;; to the captured variables — a named partial application, which take_args reads as one written
(fn take_lambda
  ((es ESt)
   (sc Scope)
   (tys (List (Option EType)))
   (ts (List EType))
   (rt (Option EType))
   (b ETerm)
   (acc Tk))
  TkRes
  (match acc
    ((Tk owner n0 _ _)
     (let ((n (+ n0 1)) (tys1 (rev_onto (some_all ts) tys)))
       (match (take_instances es sc tys1 b (tk_numbered acc n))
         ((TkErr e m) (TkErr e m))
         ((TkOk b1 acc1)
          (let ((free (rev (free_vars b (len ts) Nil))))
            (match (closed_types tys free Nil)
              (None
                (TkErr (quote function_value)
                  "a lambda over a local with no closed E type — one whose type the declarations do not fix, or one over a type parameter"))
              ((Some ctys)
               (match (lam_result es tys ts rt b)
                 (None
                   (TkErr (quote function_value)
                     "a lambda whose result type the declarations do not fix: name it as a fn, whose result is written"))
                 ((Some rty)
                  (if (< 0 (tvar_count rty))
                    (TkErr (quote function_value)
                      "a lambda whose result is over a type parameter is not supported")
                    (let
                      ((name (name_append owner (n1 (sym_of_chars (append "lam_" (show_nat n)))))))
                      (TkOk (ECall name (bvars_of free))
                        (tk_lift acc1
                          (EFn name 0 (append ctys ts) rty RecNone
                            (expand_rows (lam_body b1 (len ts) free))))))))))))))))))
;; the variables of a term past its d innermost binders, as indices of the body around it,
;; newest first: each once, in order of first occurrence (an operator's operands and a call's
;; arguments left to right, a match's scrutinee before its rows, a let's values before its body)
(fn free_vars ((t ETerm) (d Int) (acc (List Int))) (List Int)
  (measure (struct t))
  (match t
    ((EBVar i)
     (if (< i d) acc
     (if (mem_int (- i d) acc) acc
     (Cons (- i d) acc))))
    ((ELit _) acc)
    ((ECtor _ as) (free_all as d acc))
    ((ECall _ as) (free_all as d acc))
    ((EPrim _ as) (free_all as d acc))
    ((EExt _ as) (free_all as d acc))
    ((EMatch s arms) (free_arms arms d (free_vars s d acc)))
    ((ELet rs b) (free_let rs b d acc))
    ((EIf a b c) (free_vars c d (free_vars b d (free_vars a d acc))))
    ((ELam ts _ b) (free_vars b (+ d (len ts)) acc))
    (EAbsurd acc)))
(fn free_all ((ts (List ETerm)) (d Int) (acc (List Int))) (List Int)
  (measure (struct ts))
  (match ts
    (Nil acc)
    ((Cons t r) (free_all r d (free_vars t d acc)))))
(fn free_arms ((arms (List EArm)) (d Int) (acc (List Int))) (List Int)
  (measure (struct arms))
  (match arms
    (Nil acc)
    ((Cons (EArm p b) r) (free_arms r d (free_vars b (+ d (pat_slots p)) acc)))))
(fn free_let ((rs (List ETerm)) (b ETerm) (d Int) (acc (List Int))) (List Int)
  (measure (struct rs))
  (match rs
    (Nil (free_vars b d acc))
    ((Cons v r) (free_let r b (+ d 1) (free_vars v d acc)))))
;; the slots a pattern binds
(fn pat_slots ((p EPat)) Int
  (measure (struct p))
  (match p
    (PVar 1)
    ((PLit _) 0)
    ((PCtor _ subs) (pat_slots_all subs))))
(fn pat_slots_all ((ps (List EPat))) Int
  (measure (struct ps))
  (match ps
    (Nil 0)
    ((Cons p r) (+ (pat_slots p) (pat_slots_all r)))))
;; the captured variables' types, each fixed and closed
(fn closed_types ((tys (List (Option EType))) (free (List Int)) (acc (List EType)))
  (Option (List EType))
  (measure (struct free))
  (match free
    (Nil (Some (rev acc)))
    ((Cons j r)
     (match (nth tys j)
       ((Some (Some t)) (if (< 0 (tvar_count t)) None (closed_types tys r (Cons t acc))))
       (_ None)))))
(fn bvars_of ((js (List Int))) (List ETerm)
  (measure (struct js))
  (match js
    (Nil Nil)
    ((Cons j r) (Cons (EBVar j) (bvars_of r)))))
;; the lifted fn's body: a variable under the d binders in scope — the lambda's own and those
;; of its body — is as it was; a captured one is its parameter, the captured leading
(fn lam_body ((t ETerm) (d Int) (free (List Int))) ETerm
  (measure (struct t))
  (match t
    ((EBVar i)
     (if (< i d) t
     (match (index_of_int (- i d) free 0)
       ((Some p) (EBVar (+ d (- (- (len free) 1) p))))
       (None t))))
    ((ELit _) t)
    ((ECtor c as) (ECtor c (lam_all as d free)))
    ((ECall f as) (ECall f (lam_all as d free)))
    ((EPrim q as) (EPrim q (lam_all as d free)))
    ((EExt x as) (EExt x (lam_all as d free)))
    ((EMatch s arms) (EMatch (lam_body s d free) (lam_arms arms d free)))
    ((ELet rs b) (lam_let rs b d free Nil))
    ((EIf a b c) (EIf (lam_body a d free) (lam_body b d free) (lam_body c d free)))
    ((ELam ts rt b) (ELam ts rt (lam_body b (+ d (len ts)) free)))
    (EAbsurd t)))
(fn lam_all ((ts (List ETerm)) (d Int) (free (List Int))) (List ETerm)
  (measure (struct ts))
  (match ts
    (Nil Nil)
    ((Cons t r) (Cons (lam_body t d free) (lam_all r d free)))))
(fn lam_arms ((arms (List EArm)) (d Int) (free (List Int))) (List EArm)
  (measure (struct arms))
  (match arms
    (Nil Nil)
    ((Cons (EArm p b) r) (Cons (EArm p (lam_body b (+ d (pat_slots p)) free)) (lam_arms r d free)))))
(fn lam_let ((rs (List ETerm)) (b ETerm) (d Int) (free (List Int)) (out (List ETerm))) ETerm
  (measure (struct rs))
  (match rs
    (Nil (ELet (rev out) (lam_body b d free)))
    ((Cons v r) (lam_let r b (+ d 1) free (Cons (lam_body v d free) out)))))
;; one template call: the type arguments its arguments fix (tm_solve — over the arguments
;; as read, before a lambda is lifted or an inner instance taken, where each still has its
;; type), the shapes read off the static arguments, the instance named as on the typed route;
;; a type argument left open — undetermined, or a type parameter of the body — is refused, as on it
(fn take_instance
  ((es ESt)
   (sc Scope)
   (c Name)
   (ebs (List EBind))
   (nt Int)
   (sub (List (Pair Int EType)))
   (args (List ETerm))
   (acc Tk))
  TkRes
  (match (take_args es (tk_lifted acc) c ebs args Nil Nil Nil)
    ((TaE e m) (TkErr e m))
    ((TaS shapes caps data)
     (let ((tye (params_from sub nt 0)))
       (if (< 0 (tvar_count_all tye))
         (TkErr (quote function_value)
           (append (show_name c)
             ": an instance at an open type — a type argument the arguments do not determine, or a type parameter of this body; an instance is at closed types"))
         (let ((name (instance_name_of sc c tye (eshape_keys shapes))))
           (TkOk (ECall name (append caps data)) (tk_demand acc (EDemand name c tye shapes)))))))))
;; the type arguments a template's call fixes, in the elaborator's order: its bare variables,
;; then its other arguments left to right, then its numerals — a type parameter is bound once,
;; by the first that reaches it. What the type expected of the call fixes is in the lambdas'
;; kept result types (settle_tm)
(fn tm_solve
  ((es ESt) (ls (List EDecl)) (tys (List (Option EType))) (ebs (List EBind)) (args (List ETerm)))
  (List (Pair Int EType))
  (tm_pass es ls tys ebs args 2 (tm_pass es ls tys ebs args 1 (tm_pass es ls tys ebs args 0 Nil))))
(fn tm_pass
  ((es ESt)
   (ls (List EDecl))
   (tys (List (Option EType)))
   (ebs (List EBind))
   (args (List ETerm))
   (pass Int)
   (sub (List (Pair Int EType))))
  (List (Pair Int EType))
  (measure (struct ebs))
  (match ebs
    (Nil sub)
    ((Cons b br)
     (match args
       (Nil sub)
       ((Cons a ar)
        (tm_pass es ls tys br ar pass (if (= (tm_arg_pass a) pass) (tm_bind es ls tys b a sub) sub)))))))
(fn tm_arg_pass ((a ETerm)) Int
  (match a
    ((EBVar _) 0)
    ((ELit (LNat _)) 2)
    ((ELit (LInt _)) 2)
    (_ 1)))
;; one argument against its binder: a data argument's static type; a static argument's
;; parameter types past its captured values and its result — a lambda's binders and its kept
;; result type, else its body's own
(fn tm_bind
  ((es ESt)
   (ls (List EDecl))
   (tys (List (Option EType)))
   (b EBind)
   (a ETerm)
   (sub (List (Pair Int EType))))
  (List (Pair Int EType))
  (match b
    ((EBData ty)
     (match (c_type es tys a)
       ((Some at) (unify_ty ty at sub))
       (None sub)))
    ((EBStatic doms res)
     (match a
       ((ELam ts rt body)
        (match (lam_result es tys ts rt body)
          ((Some t) (unify_ty res t (unify_tys doms ts sub)))
          (None (unify_tys doms ts sub))))
       ((ECall g cs)
        (match (shape_signature es ls g)
          ((Some (Pair ps grt)) (unify_ty res grt (unify_tys doms (drop (len cs) ps) sub)))
          (None sub)))
       (_ sub)))
    (EBPackage sub)))
(fn lam_result
  ((es ESt) (tys (List (Option EType))) (ts (List EType)) (rt (Option EType)) (body ETerm))
  (Option EType)
  (match rt
    ((Some t) (Some t))
    (None (c_type es (rev_onto (some_all ts) tys) body))))
;; a template's call's static type: its result under the type arguments its arguments fix
(fn tm_call_type
  ((es ESt) (tys (List (Option EType))) (ebs (List EBind)) (rt EType) (nt Int) (args (List ETerm)))
  (Option EType)
  (fixed_type rt (tm_solve es Nil tys ebs args) nt))
;; the shapes of a call's static arguments, the captured values group by group, the data: over
;; the arguments once taken — a lambda is by now its lifted fn applied to what it captured
(type TaS (TaS (List EShape) (List ETerm) (List ETerm)) (TaE Symbol (List Int)))
(fn take_args
  ((es ESt)
   (ls (List EDecl))
   (c Name)
   (ebs (List EBind))
   (args (List ETerm))
   (shapes (List EShape))
   (caps (List ETerm))
   (data (List ETerm)))
  TaS
  (measure (struct ebs))
  (match ebs
    (Nil (TaS (rev shapes) (rev caps) (rev data)))
    ((Cons b br)
     (match args
       (Nil (TaS (rev shapes) (rev caps) (rev data)))
       ((Cons a ar)
        (match b
          ((EBData _) (take_args es ls c br ar shapes caps (Cons a data)))
          ((EBStatic doms _)
           (match a
             ((ECall g cs)
              (match (shape_signature es ls g)
                (None
                  (TaE (quote function_value)
                    (append (show_name g) ": a static argument with no program of the E table")))
                ((Some (Pair ps _))
                 (let ((n (len cs)))
                   (if (bool_not (= (len (drop n ps)) (len doms)))
                     (TaE (quote function_value)
                       (append (show_name g)
                         (append " leaves "
                           (append (show_nat (len (drop n ps)))
                             (append " parameters where the static parameter's arity is "
                               (show_nat (len doms)))))))
                     (take_args es ls c br ar (Cons (EShape g (len doms) (take n ps)) shapes)
                       (rev_onto cs caps)
                       data))))))
             (_
               (TaE (quote function_value)
                 (append (show_name c)
                   ": a static argument is a lambda, a name or a named partial application")))))
          (EBPackage
            (match a
              ((ECall g Nil) (take_args es ls c br ar (Cons (EShape g 0 Nil) shapes) caps data))
              (_
                (TaE (quote function_value)
                  (append (show_name c) ": a package argument names a package constant")))))))))))
;; a static argument's parameter types and result: a fn's or a sig fn's of the table, a lambda
;; this body lifted, a constant of the realization registry (the erasure's shape_kind reads a
;; program of the table before the registry)
(fn shape_signature ((es ESt) (ls (List EDecl)) (g Name)) (Option (Pair (List EType) EType))
  (match (fn_signature es g)
    ((Some sg) (Some sg))
    (None
      (match (lifted_signature ls g)
        ((Some sg) (Some sg))
        (None (registry_signature g))))))
(fn lifted_signature ((ls (List EDecl)) (g Name)) (Option (Pair (List EType) EType))
  (measure (struct ls))
  (match ls
    (Nil None)
    ((Cons (EFn n _ ps rt _ _) r) (if (name_eq n g) (Some (Pair ps rt)) (lifted_signature r g)))
    ((Cons _ r) (lifted_signature r g))))
;; a fn's parameter types and result (an EFn's or an ESig's)
(fn fn_signature ((es ESt) (g Name)) (Option (Pair (List EType) EType))
  (match (es_find_decl es g)
    ((Some (EFn _ _ ps rt _ _)) (Some (Pair ps rt)))
    ((Some (ESig _ _ ps rt)) (Some (Pair ps rt)))
    (_ None)))
;; a named partial application's captured values against its name's declared parameter types,
;; over the call as read: None when every determined one agrees (an undetermined one is the
;; run's, as any call's), else what differs
(fn captured_bad ((es ESt) (tys (List (Option EType))) (ebs (List EBind)) (args (List ETerm)))
  (Option (List Int))
  (measure (struct ebs))
  (match ebs
    (Nil None)
    ((Cons b br)
     (match args
       (Nil None)
       ((Cons a ar)
        (match
          (match b
            ((EBStatic _ _)
             (match a
               ((ECall g cs)
                (match (shape_signature es Nil g)
                  ((Some (Pair ps _))
                   (match (captured_ok es tys cs (take (len cs) ps))
                     ((Some m) (Some (append (show_name g) m)))
                     (None None)))
                  (None None)))
               (_ None)))
            (_ None))
          ((Some m) (Some m))
          (None (captured_bad es tys br ar))))))))
(fn captured_ok ((es ESt) (tys (List (Option EType))) (cs (List ETerm)) (ps (List EType)))
  (Option (List Int))
  (measure (struct cs))
  (match cs
    (Nil None)
    ((Cons a ar)
     (match ps
       (Nil None)
       ((Cons p pr)
        (match (c_type es tys a)
          (None (captured_ok es tys ar pr))
          ((Some at)
           ;; numerals alone under an Int parameter are the integer they are
           (if (bool_or (etype_eq at p) (bool_and (lit_only a) (is_int_type (Some p))))
             (captured_ok es tys ar pr)
             (Some ": a captured value's type is not the parameter's")))))))))
(fn eshape_keys ((ss (List EShape))) (List (Pair Name Int))
  (measure (struct ss))
  (match ss
    (Nil Nil)
    ((Cons (EShape g _ ctys) r) (Cons (Pair g (len ctys)) (eshape_keys r)))))
(fn add_edemand ((acc (List EDemand)) (d EDemand)) (List EDemand)
  (if (has_edemand acc (edemand_name d)) acc (append acc (list d))))
(fn has_edemand ((ds (List EDemand)) (n Name)) Bool
  (measure (struct ds))
  (match ds
    (Nil False)
    ((Cons d r) (if (name_eq (edemand_name d) n) True (has_edemand r n)))))
;; the lifted lambdas' bodies pass what the fn's own does (classify_body)
(fn classify_lifted ((es ESt) (ls (List EDecl))) (Option (Pair Symbol (List Int)))
  (measure (struct ls))
  (match ls
    (Nil None)
    ((Cons (EFn n _ ps _ _ body) r)
     (match (classify_body es n (some_all (rev ps)) body)
       ((Some x) (Some x))
       (None (classify_lifted es r))))
    ((Cons _ r) (classify_lifted es r))))

;; what the typed pass refuses: a sig type matched against a constructor; a constructor of another
;; type; an `if` whose condition is a sig type, or a type that is not a two-constructor inductive;
;; a comparison primitive at an inductive or a row's type (it would be stuck at run)
(type Bad (Leak Name) (Mismatch Name Name) (IfPrivate Name) (IfType Name Int) (PrimType Name Name))

;; exhaustiveness: every match, by the pattern matrix
(fn c_exh ((es ESt) (t ETerm)) Bool
  (measure (struct t))
  (match t
    ((EBVar _) True)
    ((ELit _) True)
    ((ECtor _ as) (c_exh_all es as))
    ((ECall _ as) (c_exh_all es as))
    ((EPrim _ as) (c_exh_all es as))
    ((EExt _ as) (c_exh_all es as))
    ((EMatch s arms)
     (bool_and (c_exh es s)
       (bool_and (matrix_exh es (arm_rows arms) 1 (matrix_fuel)) (c_exh_arms es arms))))
    ((ELet rs b) (bool_and (c_exh_all es rs) (c_exh es b)))
    ((EIf a b c) (bool_and (c_exh es a) (bool_and (c_exh es b) (c_exh es c))))
    ((ELam _ _ b) (c_exh es b))
    (EAbsurd True)))
(fn c_exh_all ((es ESt) (ts (List ETerm))) Bool
  (measure (struct ts))
  (match ts
    (Nil True)
    ((Cons t r) (bool_and (c_exh es t) (c_exh_all es r)))))
(fn c_exh_arms ((es ESt) (arms (List EArm))) Bool
  (measure (struct arms))
  (match arms
    (Nil True)
    ((Cons (EArm _ b) r) (bool_and (c_exh es b) (c_exh_arms es r)))))
(fn arm_rows ((arms (List EArm))) (List (List EPat))
  (measure (struct arms))
  (match arms
    (Nil Nil)
    ((Cons (EArm p _) r) (Cons (list p) (arm_rows r)))))
(fn matrix_fuel () Int 1000000)
;; rows of n patterns: exhaustive iff some row matches every vector of values
(fn matrix_exh ((es ESt) (rows (List (List EPat))) (n Int) (fuel Int)) Bool
  (measure fuel)
  (if (< fuel 0) False
  (match rows
    (Nil False)
    (_
      (if (= n 0) True
      (match (column_ctor rows)
        (None (matrix_exh es (default_rows rows) (- n 1) (- fuel 1)))
        ((Some c)
         (match (es_info es c)
           ((Some (EICtor ind _ _))
            (match (es_info es ind)
              ((Some (EIInd _ ctors)) (all_ctors_exh es rows ctors n (- fuel 1)))
              (_ False)))
           (_ False)))))))))
(fn column_ctor ((rows (List (List EPat)))) (Option Name)
  (measure (struct rows))
  (match rows
    (Nil None)
    ((Cons (Cons (PCtor c _) _) _) (Some c))
    ((Cons _ r) (column_ctor r))))
;; the rows whose first pattern is a variable, without it
(fn default_rows ((rows (List (List EPat)))) (List (List EPat))
  (measure (struct rows))
  (match rows
    (Nil Nil)
    ((Cons (Cons PVar tl) r) (Cons tl (default_rows r)))
    ((Cons _ r) (default_rows r))))
(fn all_ctors_exh ((es ESt) (rows (List (List EPat))) (ctors (List Name)) (n Int) (fuel Int)) Bool
  (measure (struct ctors))
  (match ctors
    (Nil True)
    ((Cons c r)
     (match (es_info es c)
       ((Some (EICtor _ _ k))
        (bool_and (matrix_exh es (specialize rows c k) (+ (- n 1) k) fuel)
          (all_ctors_exh es rows r n fuel)))
       (_ False)))))
;; the rows specialized to constructor c with k fields: its sub-patterns, or k variables, prepended
(fn specialize ((rows (List (List EPat))) (c Name) (k Int)) (List (List EPat))
  (measure (struct rows))
  (match rows
    (Nil Nil)
    ((Cons (Cons (PCtor d subs) tl) r)
     (if (name_eq c d) (Cons (append subs tl) (specialize r c k)) (specialize r c k)))
    ((Cons (Cons PVar tl) r) (Cons (append (pvars k) tl) (specialize r c k)))
    ((Cons _ r) (specialize r c k))))

;; the private-equality leak: a scrutinee of a sig type matched against a constructor —
;; and, with the same types, a constructor of another type than the scrutinee's. Types
;; are read off the binders, the fields, the callees and the primitives as far as they reach.
(fn c_leak ((es ESt) (tys (List (Option EType))) (t ETerm)) (Option Bad)
  (measure (struct t))
  (match t
    ((EBVar _) None)
    ((ELit _) None)
    ((ECtor _ as) (c_leak_all es tys as))
    ((ECall _ as) (c_leak_all es tys as))
    ((EPrim n as)
     (match (c_leak_all es tys as)
       ((Some x) (Some x))
       (None
         (if (cmp_prim n)
           (match (cmp_bad es tys as)
             ((Some st) (Some (PrimType st n)))
             (None None))
           None))))
    ((EExt _ as) (c_leak_all es tys as))
    ((EMatch s arms)
     (match (c_leak es tys s)
       ((Some x) (Some x))
       (None
         (let ((st (c_type es tys s)))
           (match (sig_typed es st)
             ((Some sn) (if (any_ctor_arm arms) (Some (Leak sn)) (c_leak_arms es tys st arms)))
             (None
               (match (foreign_ctor es st arms)
                 ((Some c) (Some (Mismatch (type_head_name st) c)))
                 (None (c_leak_arms es tys st arms)))))))))
    ((ELet rs b) (c_leak_let es tys rs b))
    ((EIf a b c)
     (match (c_leak es tys a)
       ((Some x) (Some x))
       (None
         (match (if_bad es (c_type es tys a))
           ((Some x) (Some x))
           (None
             (match (c_leak es tys b)
               ((Some x) (Some x))
               (None (c_leak es tys c))))))))
    ((ELam ts _ b) (c_leak es (rev_onto (some_all ts) tys) b))
    (EAbsurd None)))
;; an `if`'s condition: where the declarations determine its static type, that type must be a
;; transparent two-constructor inductive — Bool, Init's Bool, Decidable, a type — whose second
;; constructor is the observation `if` makes. A sig type is the leak (`private_if`: the tag bit
;; would read the implementation's constructor order through the view); an inductive of another
;; arity, or Int, Nat, Symbol, is `if_type`. A type the pass cannot fix (a type parameter) is
;; unchecked, as a match on one is.
(fn if_bad ((es ESt) (st (Option EType))) (Option Bad)
  (match st
    ((Some (ETCon n _))
     (match (es_info es n)
       ((Some (EISigType _)) (Some (IfPrivate n)))
       ((Some (EIInd _ ctors)) (if (= (len ctors) 2) None (Some (IfType n (len ctors)))))
       ;; a row of the registry's types has no tag an E-first body may read
       (_ (if (bool_or (builtin_type n) (rep_row n)) (Some (IfType n 0)) None))))
    (_ None)))
;; `= < <=` compare integers: an operand whose static type is an inductive or one of the
;; registry's rows — a derived equality's type, a String — has no primitive comparison. On the
;; typed route the elaborator never produces one (it resolves `=` by the operand's type); an
;; E-first body that wrote one would be stuck at run
(fn cmp_prim ((n Name)) Bool
  (bool_or (name_eq n (n1 (quote =)))
    (bool_or (name_eq n (n1 (quote <))) (name_eq n (n1 (quote <=))))))
(fn cmp_bad ((es ESt) (tys (List (Option EType))) (as (List ETerm))) (Option Name)
  (measure (struct as))
  (match as
    (Nil None)
    ((Cons a r)
     (match (c_type es tys a)
       ((Some (ETCon t _))
        (if (rep_row t) (Some t)
        (match (es_info es t)
          ((Some (EIInd _ _)) (Some t))
          (_ (cmp_bad es tys r)))))
       (_ (cmp_bad es tys r))))))
(fn c_leak_all ((es ESt) (tys (List (Option EType))) (ts (List ETerm))) (Option Bad)
  (measure (struct ts))
  (match ts
    (Nil None)
    ((Cons t r)
     (match (c_leak es tys t)
       ((Some x) (Some x))
       (None (c_leak_all es tys r))))))
(fn c_leak_arms ((es ESt) (tys (List (Option EType))) (st (Option EType)) (arms (List EArm)))
  (Option Bad)
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm p b) r)
     (match (c_leak es (rev_onto (pat_types es st p) tys) b)
       ((Some x) (Some x))
       (None (c_leak_arms es tys st r))))))
(fn c_leak_let ((es ESt) (tys (List (Option EType))) (rs (List ETerm)) (b ETerm)) (Option Bad)
  (measure (struct rs))
  (match rs
    (Nil (c_leak es tys b))
    ((Cons t r)
     (match (c_leak es tys t)
       ((Some x) (Some x))
       (None (c_leak_let es (Cons (c_type es tys t) tys) r b))))))
(fn any_ctor_arm ((arms (List EArm))) Bool
  (measure (struct arms))
  (match arms
    (Nil False)
    ((Cons (EArm (PCtor _ _) _) _) True)
    ((Cons _ r) (any_ctor_arm r))))
;; a constructor pattern whose inductive is not the scrutinee's known type (an E inductive, Int or
;; Symbol, or a row of the registry's types — whose representation no E-first body takes apart:
;; every constructor pattern on it is foreign)
(fn foreign_ctor ((es ESt) (st (Option EType)) (arms (List EArm))) (Option Name)
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm (PCtor c _) _) r)
     (match (es_info es c)
       ((Some (EICtor ind _ _))
        (match st
          ((Some (ETCon n _))
           (if (bool_or (builtin_type n) (bool_or (is_ind es n) (rep_row n)))
             (if (name_eq ind n) (foreign_ctor es st r) (Some c))
             (foreign_ctor es st r)))
          (_ (foreign_ctor es st r))))
       (_ (foreign_ctor es st r))))
    ((Cons _ r) (foreign_ctor es st r))))
(fn builtin_type ((n Name)) Bool
  (bool_or (name_eq n (nm_nat))
    (bool_or (name_eq n (n1 (quote Int))) (name_eq n (n1 (quote Symbol))))))
(fn is_ind ((es ESt) (n Name)) Bool
  (match (es_info es n)
    ((Some (EIInd _ _)) True)
    (_ False)))
(fn type_head_name ((st (Option EType))) Name
  (match st
    ((Some (ETCon n _)) n)
    (_ Anon)))
(fn sig_typed ((es ESt) (st (Option EType))) (Option Name)
  (match st
    ((Some (ETCon n _))
     (match (es_info es n)
       ((Some (EISigType _)) (Some n))
       (_ None)))
    (_ None)))
;; a pattern's variables' types in capture order, from the scrutinee's type
(fn pat_types ((es ESt) (st (Option EType)) (p EPat)) (List (Option EType))
  (measure (struct p))
  (match p
    (PVar (list st))
    ((PLit _) Nil)
    ((PCtor c subs)
     (match (ctor_field_types es st c)
       ((Some fts) (pat_types_all es (some_all fts) subs))
       (None (pat_types_all es (nones (len subs)) subs))))))
(fn pat_types_all ((es ESt) (fts (List (Option EType))) (subs (List EPat))) (List (Option EType))
  (measure (struct subs))
  (match subs
    (Nil Nil)
    ((Cons p r)
     (match fts
       ((Cons ft fr) (append (pat_types es ft p) (pat_types_all es fr r)))
       (Nil (append (pat_types es None p) (pat_types_all es Nil r)))))))
(fn nones ((k Int)) (List (Option EType)) (measure k) (if (< k 1) Nil (Cons None (nones (- k 1)))))
;; constructor c's field types under the scrutinee's type arguments, when its inductive is known
(fn ctor_field_types ((es ESt) (st (Option EType)) (c Name)) (Option (List EType))
  (match st
    ((Some (ETCon ind args))
     (match (es_find_decl es ind)
       ((Some (EInd _ _ cs))
        (match (fields_of cs c)
          ((Some fts) (Some (subst_tys args fts)))
          (None None)))
       (_ None)))
    (_ None)))
;; the static E type of a term, as far as the declarations determine it
(fn c_type ((es ESt) (tys (List (Option EType))) (t ETerm)) (Option EType)
  (measure (struct t))
  (match t
    ((EBVar i)
     (match (nth tys i)
       ((Some o) o)
       (None None)))
    ((ELit (LNat _)) (Some (ETCon (nm_nat) Nil)))
    ((ELit (LInt _)) (Some (ETCon (n1 (quote Int)) Nil)))
    ((ELit (LStr nl _ _))  ; a String (Init's cells); in the toolchain, the prelude's List over Int
     (if (name_eq nl (nm_list_nil)) (Some (ETCon (nm_string) Nil))
     (match (es_info es nl)
       ((Some (EICtor ind _ _)) (Some (ETCon ind (list (ETCon (n1 (quote Int)) Nil)))))
       (_ None))))
    ((ELit (LSym _)) (Some (ETCon (n1 (quote Symbol)) Nil)))
    ((ECtor c args)
     (match (es_info es c)
       ((Some (EICtor ind _ _))
        (match (es_find_decl es ind)
          ((Some (EInd _ np cs))
           (match (fields_of cs c)
             ((Some fts) (Some (ETCon ind (params_from (unify_all es tys fts args Nil) np 0))))
             (None (Some (ETCon ind Nil)))))
          (_ (Some (ETCon ind Nil)))))
       (_ None)))
    ((ECall f args)
     (match (es_find_decl es f)
       ((Some (EFn _ _ ps rt _ _))
        (Some (subst_ty (params_from (unify_all es tys ps args Nil) (tvar_count rt) 0) rt)))
       ((Some (ESig _ _ ps rt))
        (Some (subst_ty (params_from (unify_all es tys ps args Nil) (tvar_count rt) 0) rt)))
       (_
         (match (es_info es f)
           ((Some (EITemplate _ ebs rt nt)) (tm_call_type es tys ebs rt nt args))
           (_ None)))))
    ((EExt f args)
     (match (es_find_decl es f)
       ((Some (EExtern _ _ ps rt))
        (Some (subst_ty (params_from (unify_all es tys ps args Nil) (tvar_count rt) 0) rt)))
       (_ None)))
    ((EPrim n args)
     (match (prim_find n)
       ((Some (Prim code _)) (Some (prim_static es tys code args)))
       ;; a row kept by name while the body is typed (settle_ops): a subtype's value is at its base
       (None
         (if (name_eq n (n2 (quote Subtype) (quote val)))
           (match args
             ((Cons x Nil)
              (match (c_type es tys x)
                ((Some (ETCon _ (Cons a Nil))) (Some a))
                (_ None)))
             (_ None))
           (realization_type n)))))
    ((EMatch s arms)
     (match (live_arm arms)
       ((Some (EArm p b)) (c_type es (rev_onto (pat_types es (c_type es tys s) p) tys) b))
       (None None)))
    ((ELet rs b) (c_type_let es tys rs b))
    ((EIf _ b _) (c_type es tys b))
    ((ELam _ _ _) None)
    (EAbsurd None)))
;; the first arm that is not a refuted row: a match's static type is read off it
(fn live_arm ((arms (List EArm))) (Option EArm)
  (measure (struct arms))
  (match arms
    (Nil None)
    ((Cons (EArm _ EAbsurd) r) (live_arm r))
    ((Cons a _) (Some a))))
;; a primitive's static result: + - * at two Nat operands is Nat (a numeral's E type is the
;; binder's, and the identity is resolved by this type), else the table's result type
(fn prim_static ((es ESt) (tys (List (Option EType))) (code Int) (args (List ETerm))) EType
  (if (bool_or (= code 1) (bool_or (= code 2) (= code 8)))
    (match args
      ((Cons a (Cons b Nil))
       (if (bool_and (is_nat_type (c_type es tys a)) (is_nat_type (c_type es tys b)))
         (ETCon (nm_nat) Nil)
         (prim_result code)))
      (_ (prim_result code)))
    (prim_result code)))
(fn is_nat_type ((t (Option EType))) Bool
  (match t
    ((Some (ETCon n Nil)) (name_eq n (nm_nat)))
    (_ False)))
;; the type parameters a head's declared types take from its arguments' static types:
;; ETVar i bound where a declared type meets a known argument type, else left as ETVar i
(fn unify_all
  ((es ESt)
   (tys (List (Option EType)))
   (decl (List EType))
   (args (List ETerm))
   (acc (List (Pair Int EType))))
  (List (Pair Int EType))
  (measure (struct decl))
  (match decl
    (Nil acc)
    ((Cons d dr)
     (match args
       (Nil acc)
       ((Cons a ar)
        (unify_all es tys dr ar
          (match (c_type es tys a)
            ((Some at) (unify_ty d at acc))
            (None acc))))))))
(fn unify_ty ((d EType) (a EType) (acc (List (Pair Int EType)))) (List (Pair Int EType))
  (measure (struct d))
  (match d
    ((ETVar i)
     (match (assoc_tvar i acc)
       ((Some _) acc)
       (None (Cons (Pair i a) acc))))
    ((ETCon _ ds)
     (match a
       ((ETCon _ as) (unify_tys ds as acc))
       (_ acc)))))
(fn unify_tys ((ds (List EType)) (as (List EType)) (acc (List (Pair Int EType))))
  (List (Pair Int EType))
  (measure (struct ds))
  (match ds
    (Nil acc)
    ((Cons d dr)
     (match as
       (Nil acc)
       ((Cons a ar) (unify_tys dr ar (unify_ty d a acc)))))))
(fn assoc_tvar ((i Int) (acc (List (Pair Int EType)))) (Option EType)
  (measure (struct acc))
  (match acc
    (Nil None)
    ((Cons (Pair j t) r) (if (= i j) (Some t) (assoc_tvar i r)))))
;; the parameter list 0..n-1 from the bindings, an unbound one left as itself
(fn params_from ((acc (List (Pair Int EType))) (n Int) (i Int)) (List EType)
  (measure (- n i))
  (if (<= n i) Nil
  (Cons
    (match (assoc_tvar i acc)
      ((Some t) t)
      (None (ETVar i)))
    (params_from acc n (+ i 1)))))
;; one more than the greatest type parameter a type names (the count a substitution needs)
(fn tvar_count ((t EType)) Int
  (measure (struct t))
  (match t
    ((ETVar i) (+ i 1))
    ((ETCon _ ts) (tvar_count_all ts))))
(fn tvar_count_all ((ts (List EType))) Int
  (measure (struct ts))
  (match ts
    (Nil 0)
    ((Cons t r) (max_int (tvar_count t) (tvar_count_all r)))))
(fn c_type_let ((es ESt) (tys (List (Option EType))) (rs (List ETerm)) (b ETerm)) (Option EType)
  (measure (struct rs))
  (match rs
    (Nil (c_type es tys b))
    ((Cons t r) (c_type_let es (Cons (c_type es tys t) tys) r b))))
