    (rw h)
    (rw ETerm.size.eq_7)
    (have h1 (< (EArm.size (EArm p b)) (List_EArm.size arms))
      (exact (live_arm_lt arms (EArm p b) hl)))
    (arith (EArm.size.eq_1 p b))))
