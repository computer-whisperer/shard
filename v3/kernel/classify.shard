;; the arm `live_arm` returns is one of the list's, so smaller than the list (c_type's descent)
(theorem live_arm_lt ((arms (List EArm)))
  (forall ((a EArm)) (-> (= (live_arm arms) (some a)) (< (EArm.size a) (List_EArm.size arms))))
  (by
    (induction arms
      ((nil () (intro a h)
         (exact (absurd (congrArg Option.isSome h) (ne_true_of_eq_false (Eq.refl false)))))
       (cons (arm r ih)
         (cases arm
           ((EArm (q x)
              (cases x
                ((EBVar (i) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (ELit (l) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (ECtor (c as) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (ECall (f as) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (EPrim (n as) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (EExt (f as) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (EMatch (s ms) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (ELet (rs b) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (EIf (c d e) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (ELam (ts rt b) (intro a h) (rw (<- (Option.some.inj h))) (rw List_EArm.size.eq_2)
                   (arith))
                 (EAbsurd () (intro a h) (rw List_EArm.size.eq_2)
                   (have hl (< (EArm.size a) (List_EArm.size r)) (exact (ih a h)))
                   (arith))))))))))))
(fulfills c_type.dec_9
  (by
