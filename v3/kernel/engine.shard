;;; v3/kernel/engine.shard — the engine: a producer of I as an ordinary E library over the
;;; fixed API. It composes `tac_open`,
;;; `applicable` and `tac_step` into a ladder, cheapest first, and answers a block of nodes
;;; — every node confirmed by `tac_step` as it is chosen, so what it emits replays — or
;;; nothing. The ladder on a goal: `intro` over every leading binder; `rfl`; `(reduce)` then
;;; `rfl`; `decide`; `(arith only FACT…)` over the context's comparisons and the lemmas
;;; given, the certificate written as `arith` found it; `(simp_only EQN…)` over the
;;; equations of the functions in the target, the context's equations (an induction
;;; hypothesis among them), the equations Init states of its own functions (`init_equations`)
;;; and the lemmas, then `rfl` or `arith`; the steps of a DESCENT — where the target is a
;;; `Prod.Lex`, a measure in several parts, `(apply Prod.Lex.right …)`, `.left`, `.right'` in
;;; turn; where it compares two `Int.natAbs`, the one lemma of Init that does; where it weighs
;;; or adds them, the facts about them as `have`s and then the comparison —, each premise
;;; by the same ladder; `induction` on the hinted local, then on each local of an inductive
;;; type in turn, each arm by the same ladder one level down. Hints accelerate and add no language: `(induct X)`,
;;; `(lemmas NAME…)`, `(budget N)`. A failed attempt leaves nothing: the elaborator's state
;;; is a value and the attempt's is dropped. The budget counts steps tried.
;;;
;;; Untrusted, as the elaborator is: the block it emits is replayed and K checks P.

(import "tactic.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.arith)
(use kernel.descent)
(use kernel.elab)
(use kernel.expr)
(use kernel.kw)
(use kernel.name)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.spelling)
(use kernel.sym)
(use kernel.tactic)
(use kernel.unify)
(use kernel.util)
(use kernel.arith.ARel)
(use kernel.arith.ARes)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.expr.Expr)
(use kernel.name.Name)
(use kernel.sexpr.SExpr)
(use kernel.tactic.Goal)
(use kernel.tactic.Node)
(use kernel.tactic.TStep)
(use kernel.tactic.Opened)
(use kernel.tactic.IndOf)
(use kernel.tactic.FactsRes)

;; the engine's version: printed in prove.shard's first line and in a sidecar's header comment
(fn engine_version () Int 2)

;; ---- hints ---------------------------------------------------------------------------------
;; (induct X), (lemmas NAME…), (budget N); anything else is refused by the reader of the hints
(type Hints (Hints (Option SExpr) (List SExpr) Int))
(fn hints_induct ((h Hints)) (Option SExpr)
  (match h
    ((Hints x _ _) x)))
(fn hints_lemmas ((h Hints)) (List SExpr)
  (match h
    ((Hints _ ls _) ls)))
(fn hints_budget ((h Hints)) Int
  (match h
    ((Hints _ _ b) b)))
(fn default_budget () Int 400)
(type HintsRes (HintsOk Hints) (HintsErr (List Int)))
(fn read_hints ((ss (List SExpr)) (h Hints)) HintsRes
  (measure (struct ss))
  (match ss
    (nil (HintsOk h))
    ((cons (SList (cons (SSym k) args)) r)
     (if (sym_eq k (sym "induct"))
       (match args
         ((cons x nil) (read_hints r (Hints (some x) (hints_lemmas h) (hints_budget h))))
         (_ (HintsErr (utf8 "(induct X)"))))
     (if (sym_eq k (sym "lemmas"))
       (read_hints r (Hints (hints_induct h) (append (hints_lemmas h) args) (hints_budget h)))
     (if (sym_eq k (sym "budget"))
       (match args
         ((cons (SNum n) nil) (read_hints r (Hints (hints_induct h) (hints_lemmas h) n)))
         (_ (HintsErr (utf8 "(budget N)"))))
       (HintsErr
         (append (chars_of_sym k) (utf8 ": a hint is (induct X), (lemmas NAME…) or (budget N)")))))))
    ((cons _ _) (HintsErr (utf8 "a hint is (induct X), (lemmas NAME…) or (budget N)")))))

;; ---- the result --------------------------------------------------------------------------------
;; solved: the state and the block; or not, with the budget left and the last goal tried
(type EngRes (EngOk El (List Node) Int) (EngNo Int (List Int)))

;; the entry: the goal (the theorem's statement closed over its binders, made by tac_prove's
;; opener), the hints; the block, or the refusal's text
(type Produced (Produced (List Node)) (NotProduced (List Int)))
(fn engine_prove ((e El) (stmt Expr) (nctx Int) (hints (List SExpr))) Produced
  (match (read_hints hints (Hints none nil (default_budget)))
    ((HintsErr m) (NotProduced m))
    ((HintsOk h)
     (match (el_fresh e (n1 (sym "goal")) stmt (sym "goal"))
       ((Prod.mk e1 (MVar _ i))
        (match (eng_solve e1 (Goal i stmt nctx) h (hints_budget h) 5)
          ((EngOk _ nodes _) (Produced nodes))
          ((EngNo _ m) (NotProduced m))))
       ((Prod.mk _ _) (NotProduced (utf8 "no metavariable")))))))

;; ---- the ladder ------------------------------------------------------------------------------
(fn eng_solve ((e El) (g Goal) (h Hints) (budget Int) (depth Int)) EngRes
  (measure (Int.natAbs depth) 0 (Int.natAbs budget))
  (if (< depth 1)
    (EngNo budget (append (utf8 "the search is deeper than its limit at ") (goal_of g)))
  (if (< budget 1) (EngNo budget (append (utf8 "the budget is spent at ") (goal_of g)))
  (match (eng_intro e g)
    ((some (Prod.mk (Prod.mk e1 g1) nd))
     (match (eng_solve e1 g1 h (- budget 1) depth)
       ((EngOk e2 nodes b) (EngOk e2 (cons nd nodes) b))
       ((EngNo b _) (eng_induct e g h b (- depth 1)))))  ; the binders kept in the target: an induction's hypothesis quantifies them (`generalizing`)
    (none
      (match (eng_close e g h budget)
        ((EngOk e1 nodes b) (EngOk e1 nodes b))
        ((EngNo b1 _)
         (match (eng_simp_close e g h b1)
           ((EngOk e1 nodes b) (EngOk e1 nodes b))
           ((EngNo b2 _) (eng_descent e g h b2 (- depth 1)))))))))))

;; intro: every leading binder of the target, named after the binder or h1, h2, … where it
;; has no name a source can write: none, a number, or a wildcard's (`_ wildcard`, elab.shard
;; el_pat) — a name with a space would be two names when the block is read back
(fn eng_intro ((e El) (g Goal)) (Option (Prod (Prod El Goal) Node))
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (match (el_whnf e1 target)
       ((Prod.mk e2 tw)
        (if (bool_not (is_pi tw)) none
        (let ((names (pi_names e2 tw (len ctx) nil)))
          (match (tac_step e g (NIntro names))
            ((StepOk e3 _ _ _ (some g1)) (some (Prod.mk (Prod.mk e3 g1) (NIntro names))))
            (_ none)))))))))
(fn pi_names ((e El) (t Expr) (k Int) (acc (List Name))) (List Name)
  (measure (struct t))
  (match t
    ((Pi _ n _ _ body) (pi_names e body (+ k 1) (cons (unlike (binder_name n k) acc k) acc)))
    (_ (rev acc))))
;; a name no earlier binder of the same intro took — the name with its binder's number where
;; one did: two hypotheses a statement both calls `h` are two facts, and a later step cites
;; each by its own name
(fn unlike ((n Name) (taken (List Name)) (k Int)) Name
  (if (mem_name n taken)
    (n1 (sym_of_chars (append (show_name n) (append (utf8 "_") (show_nat (+ k 1))))))
    n))
(fn binder_name ((n Name) (k Int)) Name
  (match n
    ((Str Anon s)
     (if (bool_or (all_digits (chars_of_sym s)) (mem_int 32 (chars_of_sym s)))
       (n1 (sym_of_chars (append (utf8 "h") (show_nat (+ k 1)))))
       n))
    (_ (n1 (sym_of_chars (append (utf8 "h") (show_nat (+ k 1))))))))

;; the closing steps, cheapest first: rfl; (reduce) rfl; decide; arith only over the context's
;; comparisons and the lemmas
(fn eng_close ((e El) (g Goal) (h Hints) (budget Int)) EngRes
  (match (eng_try_close e g (NRfl) budget)
    ((EngOk e1 ns b) (EngOk e1 ns b))
    ((EngNo b1 _)
     (match (eng_try_then e g (NReduce (sym "both") nil nil) (NRfl) b1)
       ((EngOk e1 ns b) (EngOk e1 ns b))
       ((EngNo b2 _)
        (match (eng_try_close e g (NDecide) b2)
          ((EngOk e1 ns b) (EngOk e1 ns b))
          ((EngNo b3 _) (eng_arith e g h b3))))))))
;; one closing node tried
(fn eng_try_close ((e El) (g Goal) (nd Node) (budget Int)) EngRes
  (if (< budget 1) (EngNo budget (utf8 "budget"))
  (match (tac_step e g nd)
    ((StepOk e1 filling nil nil none)
     (EngOk (el_set_mc e1 (mc_set (el_mc e1) (goal_id g) filling)) (list nd) (- budget 1)))
    ((StepOk _ _ _ _ _) (EngNo (- budget 1) (utf8 "the step left goals")))
    ((StepErr _ m) (EngNo (- budget 1) m)))))
;; a sequential node, then a closing one on its continuation
(fn eng_try_then ((e El) (g Goal) (nd Node) (closer Node) (budget Int)) EngRes
  (if (< budget 1) (EngNo budget (utf8 "budget"))
  (match (tac_step e g nd)
    ((StepOk e1 filling nil nil (some g1))
     (match
       (eng_try_close (el_set_mc e1 (mc_set (el_mc e1) (goal_id g) filling)) g1 closer (- budget 1))
       ((EngOk e2 ns b) (EngOk e2 (cons nd ns) b))
       ((EngNo b m) (EngNo b m))))
    ((StepOk _ _ _ _ _) (EngNo (- budget 1) (utf8 "the step left goals")))
    ((StepErr _ m) (EngNo (- budget 1) m)))))

;; arith only: the facts are the context's comparisons by name and the lemmas; the certificate
;; `arith` finds is written into the node, and the node is confirmed by the step
(fn eng_arith ((e El) (g Goal) (h Hints) (budget Int)) EngRes
  (if (< budget 1) (EngNo budget (utf8 "budget"))
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (let
       ((other Bool
          (match (ar_rel (sp_canon (el_zonk e1 target)))
            ((ARNone) true)
            (_ false))))
       (if other (EngNo budget (utf8 "not a comparison"))
       (let ((facts (append (ctx_facts e1 ctx (sym "cmp") nil) (hints_lemmas h))))
         (match (arith_facts e1 facts nil)
           ((FactsErr _ m) (EngNo (- budget 1) m))
           ((FactsOk e2 fs)
            (match (ar_prove e2 (el_zonk e2 target) nil fs nil)
              ((ARErr _ m _ _) (EngNo (- budget 1) m))
              ((AROk _ _ certs) (eng_try_close e g (NArith true facts certs) (- budget 1)))))))))))))
;; a local's type under a test: a comparison, an equation, an inductive type. A comparison is
;; one arithmetic can weigh: an equation denied (`x ≠ k`) is none, and given as a fact it
;; fails the step
(fn ctx_test ((e El) (kind Symbol) (ty Expr)) Bool
  (if (sym_eq kind (sym "cmp"))
    (match (ar_rel (sp_canon ty))
      ((ARNone) false)
      ((ARel op _ denied _ _) (bool_not (bool_and denied (sym_eq op (sym "eq")))))
      (_ true))
  (if (sym_eq kind (sym "eq"))
    (match (eq_sides (pi_result ty))
      ((some _) true)
      (none false))  ; a quantified equation (an induction hypothesis over a generalized binder) is a rule too
    (match (ind_of_type e ty)
      ((IndOf _ _ _ _ _ _ _) true)
      (_ false)))))
;; the context's locals whose type passes the test, each as the symbol of its name
(fn ctx_facts ((e El) (ctx (List Expr)) (kind Symbol) (acc (List SExpr))) (List SExpr)
  (measure (struct ctx))
  (match ctx
    (nil (rev acc))
    ((cons (FVar d id) r)
     (match (w_local_type (el_w e) id)
       ((some ty)
        (if (ctx_test e kind (el_zonk e ty))
          (ctx_facts e r kind (cons (SSym (sym_of_chars (show_name (local_name e id)))) acc))
          (ctx_facts e r kind acc)))
       (none (ctx_facts e r kind acc))))
    ((cons _ r) (ctx_facts e r kind acc))))

;; simp_only over the equations of the functions in the target, the context's equations and
;; the lemmas, then rfl or arith on what is left; nothing to rewrite with is nothing tried
(fn eng_simp_close ((e El) (g Goal) (h Hints) (budget Int)) EngRes
  (match (eng_simp_once e g h budget)
    ((SimpDone e1 ns b) (EngOk e1 ns b))
    ((SimpNo b m) (EngNo b m))
    ;; what is left does not close: one more round, its rules read from what is left — a
    ;; rewrite by a size's equation brings in the sizes of the parts, whose equations the first
    ;; target did not name
    ((SimpLeft e1 g1 nd b)
     (match (eng_simp_once e1 g1 h b)
       ((SimpDone e2 ns b2) (EngOk e2 (cons nd ns) b2))
       ((SimpLeft _ _ _ b2) (EngNo b2 (utf8 "the rewrite leaves a goal nothing closes")))
       ((SimpNo b2 m) (EngNo b2 m))))))
;; one round: closed, with its steps; or rewritten and not closed — the state, the goal left,
;; the rewrite's step; or nothing
(type SimpRes (SimpDone El (List Node) Int) (SimpLeft El Goal Node Int) (SimpNo Int (List Int)))
(fn eng_simp_once ((e El) (g Goal) (h Hints) (budget Int)) SimpRes
  (if (< budget 1) (SimpNo budget (utf8 "budget"))
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (let
       ((rules
          (append (fn_equations e1 (names_dedup (expr_consts (el_zonk e1 target)) nil) nil)
            (append (init_equations e1 (names_dedup (expr_consts (el_zonk e1 target)) nil) nil)
              (append (ctx_facts e1 ctx (sym "eq") nil) (hints_lemmas h))))))
       (match rules
         (nil (SimpNo budget (utf8 "no rule")))
         (_
           (let ((nd (NSimp (as_rules rules nil))))
             (match (tac_step e g nd)
               ((StepOk e2 filling nil nil (some g1))
                (let ((e3 (el_set_mc e2 (mc_set (el_mc e2) (goal_id g) filling))))
                  (match (eng_try_close e3 g1 (NRfl) (- budget 1))
                    ((EngOk e4 ns b) (SimpDone e4 (cons nd ns) b))
                    ((EngNo b1 _)
                     (match (eng_arith e3 g1 h b1)
                       ((EngOk e4 ns b) (SimpDone e4 (cons nd ns) b))
                       ((EngNo b2 _) (SimpLeft e3 g1 nd b2)))))))
               ((StepOk _ _ _ _ _) (SimpNo (- budget 1) (utf8 "the step left goals")))
               ((StepErr _ m) (SimpNo (- budget 1) m)))))))))))
(fn as_rules ((ss (List SExpr)) (acc (List (Prod Bool SExpr)))) (List (Prod Bool SExpr))
  (measure (struct ss))
  (match ss
    (nil (rev acc))
    ((cons s r) (as_rules r (cons (Prod.mk false s) acc)))))
;; the equations of each constant that has any, cited relative to the module
(fn fn_equations ((e El) (cs (List Name)) (acc (List SExpr))) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil (rev acc))
    ((cons c r) (fn_equations e r (cite_all e (safe_equations e c (equations_of e c) nil) acc)))))
;; the equations a rewriter may run to a fixpoint: one whose left side has a pattern (a
;; constructor, a literal — anything but the bound variables), or whose right side does not
;; mention the function; an unfolding equation of a measured function (`show n = … show (n / 10)
;; …`, every argument a variable) matches its own result without end
(fn safe_equations ((e El) (f Name) (ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil (rev acc))
    ((cons n r)
     (match (env_find (el_env e) n)
       ((some info)
        (match (eq_sides (pi_result (ci_type info)))
          ((some (Prod.mk _ (Prod.mk _ (Prod.mk lhs rhs))))
           (if
             (bool_or (bool_not (all_bvars (get_app_args lhs)))
               (bool_not (mem_name f (expr_consts rhs))))
             (safe_equations e f r (cons n acc))
             (safe_equations e f r acc)))
          (none (safe_equations e f r acc))))
       (none (safe_equations e f r acc))))))
(fn all_bvars ((xs (List Expr))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons (BVar _ _) r) (all_bvars r))
    ((cons _ _) false)))
(fn names_dedup ((ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil (rev acc))
    ((cons n r) (names_dedup r (if (mem_name n acc) acc (cons n acc))))))
(fn cite_all ((e El) (ns (List Name)) (acc (List SExpr))) (List SExpr)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r) (cite_all e r (cons (SSym (sym_of_chars (cite e n))) acc)))))
;; a constant's citation: its name without the module's prefix where the module's is one
(fn cite ((e El) (n Name)) (List Int)
  (let ((full (show_name n)) (pre (append (show_name (sc_module (cx_scope (el_cx e)))) (utf8 "."))))
    (if (bool_and (< (len pre) (+ (len full) 1)) (int_list_eq (take (len pre) full) pre))
      (drop (len pre) full)
      full)))

;; ---- the engine's lemmas of Init --------------------------------------------------------------
;; The constants of Init the engine may cite though no source names them. Under prove's modes
;; the loader asks Init for them with every file's own demand (loader.shard init_demand); a
;; block cites one only where it is used, and a build fetches it then as it fetches whatever a
;; sidecar's block cites.
(fn eng_kit () (List Name)
  (list (eng_natabs_lt) (eng_sub_lt) (n2 (sym "List") (sym "length_cons"))
    (n2 (sym "List") (sym "length_nil"))
    (eng_lex (sym "left"))
    (eng_lex (sym "right"))
    (eng_lex (sym "right'"))))
(fn eng_natabs_lt () Name (n2 (sym "Int") (sym "natAbs_lt_natAbs_of_nonneg_of_lt")))
(fn eng_sub_lt () Name (n2 (sym "Nat") (sym "sub_lt")))
(fn eng_lex ((s Symbol)) Name (Str (n2 (sym "Prod") (sym "Lex")) s))
;; the equations Init states of its own functions, for those among `cs` — what `fn_equations`
;; is for a function of the program; each cited where the environment holds it
(fn init_equations ((e El) (cs (List Name)) (acc (List SExpr))) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil (rev acc))
    ((cons c r)
     (init_equations e r
       (if (name_eq c (n2 (sym "List") (sym "length")))
         (cited_present e
           (list (n2 (sym "List") (sym "length_cons")) (n2 (sym "List") (sym "length_nil")))
           acc)
         acc)))))
(fn cited_present ((e El) (ns (List Name)) (acc (List SExpr))) (List SExpr)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r)
     (cited_present e r
       (match (env_find (el_env e) n)
         ((some _) (cons (SSym (sym_of_chars (show_name n))) acc))
         (none acc))))))

;; ---- a descent ---------------------------------------------------------------------------------
;; The obligation of a measure has few shapes. A measure in several parts states a `Prod.Lex`:
;; the first parts the same term (`Prod.Lex.right`, the rest compared), the first part falling
;; (`.left`), or the first part no greater by arithmetic (`.right'`). A measure through
;; `Int.natAbs` compares two of them, and Init's lemma takes `0 <= a` and `a < b` for it; a
;; natural number less a positive one is less by `Nat.sub_lt`. Each
;; lemma is applied and its premises are goals of the same ladder; where none closes the goal
;; the induction follows, as before.
(fn eng_descent ((e El) (g Goal) (h Hints) (budget Int) (depth Int)) EngRes
  (measure (Int.natAbs depth) 8 0)
  (match (eng_apply_each e g h budget depth (descent_lemmas e g))
    ((EngOk e1 ns b) (EngOk e1 ns b))
    ((EngNo b _)
     (match (eng_abs_each e g h b depth (abs_facts e g) (Prod.mk nil 1))
       ((EngOk e1 ns b1) (EngOk e1 ns b1))
       ((EngNo b1 _) (eng_induct e g h b1 depth))))))

;; ---- facts about Int.natAbs --------------------------------------------------------------------
;; Arithmetic takes `(Int.natAbs X)` for a number it knows nothing of, so a comparison that
;; weighs or adds such numbers — a measure `(* 2 (Int.natAbs (+ fuel 1)))`, or one beside a
;; size — is closed in two moves: the facts first, each a `have` — for two of the target's
;; `Int.natAbs` terms, that the one is less than the other (Init's lemma, its two premises by
;; the ladder); for one over a numeral, its value —, then the comparison with the facts in the
;; context. A fact that does not hold is passed over; with none there is nothing to add.
;; A fact's statement is written from the target as it is displayed, read back: a projection
;; `(proj I T)` is given the structure an obligation's tuple has, `PProd`. A statement that
;; does not read, as any step that fails, is one candidate less.
(fn abs_facts ((e El) (g Goal)) (List SExpr)
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (if (bool_not (mem_name (n2 (sym "Int") (sym "natAbs")) (expr_consts (el_zonk e1 target)))) nil
     (match (read_expr (tc_show_closed e1 ctx (el_zonk e1 target)) 100000)
       ((SOk sx _)
        (let ((xs (sx_dedup (abs_args (with_struct sx) nil) nil)))
          (append (abs_values xs) (abs_pairs xs xs))))
       (_ nil))))))
;; `(proj I T)` as `(proj PProd I T)`, everywhere
(fn with_struct ((s SExpr)) SExpr
  (measure (SExpr.size s))
  (match s
    ((SList xs) (SList (struct_named (with_struct_all xs))))
    (_ s)))
(fn struct_named ((xs (List SExpr))) (List SExpr)
  (match xs
    ((cons (SSym p) (cons (SNum i) (cons t nil)))
     (if (sym_eq p (sym "proj")) (list (SSym p) (SSym (sym "PProd")) (SNum i) t) xs))
    (_ xs)))
(fn with_struct_all ((xs (List SExpr))) (List SExpr)
  (measure (List_SExpr.size xs))
  (match xs
    (nil nil)
    ((cons x r) (cons (with_struct x) (with_struct_all r)))))
(fulfills with_struct.dec_1 (by (intro s xs h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills with_struct_all.dec_1 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills with_struct_all.dec_2 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
;; the arguments of the `Int.natAbs` terms in a form
(fn abs_args ((s SExpr) (acc (List SExpr))) (List SExpr)
  (measure (SExpr.size s))
  (match s
    ((SList xs) (abs_args_all xs (abs_here xs acc)))
    (_ acc)))
(fn abs_here ((xs (List SExpr)) (acc (List SExpr))) (List SExpr)
  (match xs
    ((cons (SSym f) (cons x nil)) (if (sym_eq f (sym "Int.natAbs")) (cons x acc) acc))
    (_ acc)))
(fn abs_args_all ((xs (List SExpr)) (acc (List SExpr))) (List SExpr)
  (measure (List_SExpr.size xs))
  (match xs
    (nil acc)
    ((cons x r) (abs_args_all r (abs_args x acc)))))
(fulfills abs_args.dec_1 (by (intro s acc xs h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills abs_args_all.dec_1 (by (intro xs acc x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills abs_args_all.dec_2 (by (intro xs acc x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fn sx_dedup ((xs (List SExpr)) (acc (List SExpr))) (List SExpr)
  (measure (struct xs))
  (match xs
    (nil (rev acc))
    ((cons x r) (sx_dedup r (if (sx_mem x acc) acc (cons x acc))))))
(fn sx_mem ((x SExpr) (xs (List SExpr))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (int_list_eq (show_sexpr x) (show_sexpr y)) true (sx_mem x r)))))
(fn abs_of ((x SExpr)) SExpr (SList (list (SSym (sym "Int.natAbs")) x)))
;; the value of one over a numeral that is not negative
(fn abs_values ((xs (List SExpr))) (List SExpr)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (SNum k) r)
     (if (< k 0) (abs_values r)
     (cons (SList (list (SSym (sym "=")) (abs_of (SNum k)) (SNum k))) (abs_values r))))
    ((cons _ r) (abs_values r))))
;; each less than each other
(fn abs_pairs ((xs (List SExpr)) (all (List SExpr))) (List SExpr)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (append (abs_less x all) (abs_pairs r all)))))
(fn abs_less ((x SExpr) (ys (List SExpr))) (List SExpr)
  (measure (struct ys))
  (match ys
    (nil nil)
    ((cons y r)
     (if (int_list_eq (show_sexpr x) (show_sexpr y)) (abs_less x r)
     (cons (SList (list (SSym (sym "<")) (abs_of x) (abs_of y))) (abs_less x r))))))
;; the facts in turn, each stated by a `have` and proven where it holds — the goal is then the
;; `have`'s continuation, the fact in its context —; after the last, the comparison. `acc` is
;; the steps so far (last first) and the next fact's number
(fn eng_abs_each
  ((e El)
   (g Goal)
   (h Hints)
   (budget Int)
   (depth Int)
   (facts (List SExpr))
   (acc (Prod (List Node) Int)))
  EngRes
  (measure (Int.natAbs depth) 7 (List.length facts))
  (match acc
    ((Prod.mk done k)
     (match facts
       (nil
         (match done
           (nil (EngNo budget (append (utf8 "nothing closes ") (goal_of g))))
           (_
             (match (eng_close e g h budget)
               ((EngOk e1 ns b) (EngOk e1 (append (rev done) ns) b))
               ((EngNo b1 _)
                (match (eng_simp_close e g h b1)
                  ((EngOk e1 ns b) (EngOk e1 (append (rev done) ns) b))
                  ((EngNo b2 m) (EngNo b2 m))))))))
       ((cons prop r)
        (if (< budget 1) (EngNo budget (utf8 "budget"))
        (let ((nm (n1 (sym_of_chars (append (utf8 "abs_") (show_nat k))))))
          (match (tac_step e g (NHave nm prop nil))
            ((StepOk e1 filling (cons child nil) _ (some cont))
             (match
               (eng_fact (el_set_mc e1 (mc_set (el_mc e1) (goal_id g) filling)) child h (- budget 1)
                 depth)
               ((EngOk e2 block b)
                (eng_abs_each e2 cont h b depth r
                  (Prod.mk (cons (NHave nm prop block) done) (+ k 1))))
               ((EngNo b _) (eng_abs_each e g h b depth r acc))))
            (_ (eng_abs_each e g h (- budget 1) depth r acc))))))))))
;; one fact's proof: a value by the closing steps, a comparison by Init's lemma and the ladder
(fn eng_fact ((e El) (g Goal) (h Hints) (budget Int) (depth Int)) EngRes
  (measure (Int.natAbs depth) 6 0)
  (match (eng_close e g h budget)
    ((EngOk e1 ns b) (EngOk e1 ns b))
    ((EngNo b _)
     (eng_apply_each e g h b depth (present_lemmas e (list (Prod.mk (eng_natabs_lt) 2)))))))
;; the lemmas to try on a goal, each with the number of premises it leaves
(fn descent_lemmas ((e El) (g Goal)) (List (Prod SExpr Int))
  (match (tac_open e g)
    ((Opened e1 _ target)
     (let ((cs (expr_consts (el_zonk e1 target))))
       (append
         (if (mem_name (n2 (sym "Prod") (sym "Lex")) cs)
           (present_lemmas e1
             (list (Prod.mk (eng_lex (sym "right")) 1) (Prod.mk (eng_lex (sym "left")) 1)
               (Prod.mk (eng_lex (sym "right'")) 2)))
           nil)
         (append
           (if (mem_name (n2 (sym "Int") (sym "natAbs")) cs)
             (present_lemmas e1 (list (Prod.mk (eng_natabs_lt) 2)))
             nil)
           (if (mem_name (n2 (sym "Nat") (sym "sub")) cs)
             (present_lemmas e1 (list (Prod.mk (eng_sub_lt) 2)))
             nil)))))))
(fn present_lemmas ((e El) (ns (List (Prod Name Int)))) (List (Prod SExpr Int))
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons (Prod.mk n k) r)
     (match (env_find (el_env e) n)
       ((some _) (cons (Prod.mk (SSym (sym_of_chars (show_name n))) k) (present_lemmas e r)))
       (none (present_lemmas e r))))))
;; each lemma in turn: applied with an empty block for each premise, the premises then solved
;; in order and written into the step
(fn eng_apply_each
  ((e El) (g Goal) (h Hints) (budget Int) (depth Int) (cands (List (Prod SExpr Int))))
  EngRes
  (measure (Int.natAbs depth) 5 (List.length cands))
  (match cands
    (nil (EngNo budget (append (utf8 "nothing closes ") (goal_of g))))
    ((cons (Prod.mk t k) r)
     (if (< budget 1) (EngNo budget (utf8 "budget"))
     (match (tac_step e g (NApply t (empty_blocks k)))
       ((StepOk e1 filling children _ none)
        (match
          (eng_children (el_set_mc e1 (mc_set (el_mc e1) (goal_id g) filling)) children h
            (- budget 1)
            depth
            nil)
          ((Prod.mk (some (Prod.mk e2 blocks)) b) (EngOk e2 (list (NApply t (as_blocks blocks))) b))
          ((Prod.mk none b) (eng_apply_each e g h b depth r))))
       (_ (eng_apply_each e g h (- budget 1) depth r)))))))
(fn empty_blocks ((k Int)) (List Node)
  (measure (Int.natAbs k))
  (if (< k 1) nil (cons (NBlock nil) (empty_blocks (- k 1)))))
(fulfills empty_blocks.dec_1 (by (intro k h) (apply natAbs_pred (arith))))
(fn as_blocks ((bs (List (List Node)))) (List Node)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (cons (NBlock b) (as_blocks r)))))

;; the least depth an induction is tried at: the search starts at 5, so inductions nest two
;; deep, as they did before a descent's steps took levels of their own — a third level of
;; induction spends the budget on goals no induction closes
(fn induct_floor () Int 3)
;; induction: on the hinted local first, then on each local of an inductive type in context
;; order; the arms named after the constructors' fields with `ih_FIELD` for a recursive one,
;; each arm's goal by the ladder one level down
(fn eng_induct ((e El) (g Goal) (h Hints) (budget Int) (depth Int)) EngRes
  (measure (Int.natAbs depth) 4 0)
  (if (< budget 1) (EngNo budget (utf8 "budget"))
  (if (< depth (induct_floor)) (EngNo budget (append (utf8 "nothing closes ") (goal_of g)))
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (let
       ((hinted (List SExpr)
          (match (hints_induct h)
            ((some x) (list x))
            (none nil))))
       (let
         ((cands
            (append hinted
              (ctx_facts e1 (in_target e1 ctx (expr_fvars (el_zonk e1 target) nil) nil)
                (sym "inductive")
                nil))))
         (eng_induct_each e g h budget depth cands))))))))
;; the locals the target mentions: an induction on another changes nothing
(fn in_target ((e El) (ctx (List Expr)) (ids (List Int)) (acc (List Expr))) (List Expr)
  (measure (struct ctx))
  (match ctx
    (nil (rev acc))
    ((cons (FVar d id) r) (in_target e r ids (if (mem_int id ids) (cons (FVar d id) acc) acc)))
    ((cons _ r) (in_target e r ids acc))))
(fn eng_induct_each ((e El) (g Goal) (h Hints) (budget Int) (depth Int) (cands (List SExpr))) EngRes
  (measure (Int.natAbs depth) 3 (List.length cands))
  (match cands
    (nil (EngNo budget (append (utf8 "nothing closes ") (goal_of g))))
    ((cons x r)
     (match (eng_induct_on e g h budget depth x)
       ((EngOk e1 ns b) (EngOk e1 ns b))
       ((EngNo b _) (eng_induct_each e g h b depth r))))))
(fn eng_induct_on ((e El) (g Goal) (h Hints) (budget Int) (depth Int) (x SExpr)) EngRes
  (measure (Int.natAbs depth) 2 0)
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (match (elab e1 x none (budget_depth))
       ((EErr _ m) (EngNo budget m))
       ((EOk e2 _ xty)
        (match (ind_of_type e2 xty)
          ((IndNone _ m) (EngNo budget m))
          ((IndOf e3 iname _ _ nparams _ ctors)
           (let ((arms (arm_shells e3 iname nparams ctors nil)))
             (match (tac_step e g (NInduction x none arms))
               ((StepErr _ m) (EngNo (- budget 1) m))
               ((StepOk e4 filling children _ none)
                (match
                  (eng_children (el_set_mc e4 (mc_set (el_mc e4) (goal_id g) filling)) children h
                    (- budget 1)
                    depth
                    nil)
                  ((Prod.mk (some (Prod.mk e5 blocks)) b)
                   (EngOk e5 (list (NInduction x none (arms_with arms blocks nil))) b))
                  ((Prod.mk none b)
                   (EngNo b
                     (append (utf8 "an arm of the induction on ")
                       (append (show_sexpr x) (utf8 " does not close")))))))
               ((StepOk _ _ _ _ _) (EngNo (- budget 1) (utf8 "the induction left a continuation"))))))))))))
;; the arms with empty blocks: the names a constructor's minor premise binds
(fn arm_shells ((e El) (iname Name) (nparams Int) (ctors (List Name)) (acc (List Node))) (List Node)
  (measure (struct ctors))
  (match ctors
    (nil (rev acc))
    ((cons c r)
     (match (env_find (el_env e) c)
       ((some info)
        (arm_shells e iname nparams r
          (cons
            (NArm (n1 (sym_of_chars (chars_of_name_last c)))
              (minor_names (drop_pis (ci_type info) nparams) iname nil nil)
              nil)
            acc)))
       (none (arm_shells e iname nparams r acc))))))
(fn drop_pis ((t Expr) (k Int)) Expr
  (measure (Int.natAbs k))
  (if (< k 1) t
  (match t
    ((Pi _ _ _ _ body) (drop_pis body (- k 1)))
    (_ t))))
(fulfills drop_pis.dec_1 (by (intro p h a n bi d body hm) (apply natAbs_pred (arith))))
;; the fields' names, then ih_FIELD for each field whose type is the inductive itself
(fn minor_names ((t Expr) (iname Name) (fields (List Name)) (ihs (List Name))) (List Name)
  (measure (struct t))
  (match t
    ((Pi _ n _ dom body)
     (let ((fname (field_name n (len fields))))
       (minor_names body iname (cons fname fields)
         (if (is_const_named (get_app_fn (pi_result dom)) iname)
           (cons (n1 (sym_of_chars (append (utf8 "ih_") (show_name fname)))) ihs)
           ihs))))
    (_ (append (rev fields) (rev ihs)))))
(fn pi_result ((t Expr)) Expr
  (measure (struct t))
  (match t
    ((Pi _ _ _ _ body) (pi_result body))
    (_ t)))
(fn field_name ((n Name) (k Int)) Name
  (match n
    ((Str Anon s)
     (if (all_digits (chars_of_sym s)) (n1 (sym_of_chars (append (utf8 "f") (show_nat (+ k 1))))) n))
    (_ (n1 (sym_of_chars (append (utf8 "f") (show_nat (+ k 1))))))))
;; the children solved in order; the blocks, or none
(fn eng_children
  ((e El) (gs (List Goal)) (h Hints) (budget Int) (depth Int) (acc (List (List Node))))
  (Prod (Option (Prod El (List (List Node)))) Int)
  (measure (Int.natAbs depth) 1 (List.length gs))
  (match gs
    (nil (Prod.mk (some (Prod.mk e (rev acc))) budget))
    ((cons g r)
     (match (eng_solve e g h budget depth)
       ((EngOk e1 ns b) (eng_children e1 r h b depth (cons ns acc)))
       ((EngNo b _) (Prod.mk none b))))))
(fn arms_with ((arms (List Node)) (blocks (List (List Node))) (acc (List Node))) (List Node)
  (measure (struct arms))
  (match arms
    (nil (rev acc))
    ((cons (NArm c ns _) r)
     (match blocks
       ((cons b br) (arms_with r br (cons (NArm c ns b) acc)))
       (nil (arms_with r nil (cons (NArm c ns nil) acc)))))
    ((cons o r) (arms_with r blocks (cons o acc)))))
(fulfills eng_descent.dec_1
  (by (intro e g h budget depth) (apply Prod.Lex.right ((apply Prod.Lex.left (decide))))))
(fulfills eng_descent.dec_2
  (by (intro e g h budget depth b h7) (apply Prod.Lex.right ((apply Prod.Lex.left (decide))))))
(fulfills eng_descent.dec_3
  (by (intro e g h budget depth b h7 b1 h9) (apply Prod.Lex.right ((apply Prod.Lex.left (decide))))))
(fulfills eng_abs_each.dec_1
  (by
    (intro e g h budget depth facts acc done k h_10 prop r h_13 h_14)
    (intro e1 filling child h18 cont h)
    (apply Prod.Lex.right ((apply Prod.Lex.left (decide))))))
(fulfills eng_abs_each.dec_2
  (by
    (intro e g h budget depth facts acc done k h_10 prop r h_13 h_14)
    (intro e1 filling child h18 cont h e2 block b)
    (apply Prod.Lex.right
      ((apply Prod.Lex.right
         ((simp_only List.length_cons List.length_nil h_10 h_13 h) (arith only h_14 (farkas 1))))))))
(fulfills eng_abs_each.dec_3
  (by
    (intro e g h budget depth facts acc done k h_10 prop r h_13 h_14)
    (intro e1 filling child h18 cont h b h22)
    (apply Prod.Lex.right
      ((apply Prod.Lex.right
         ((simp_only List.length_cons List.length_nil h_10 h_13 h) (arith only h_14 (farkas 1))))))))
(fulfills eng_abs_each.dec_4
  (by
    (intro e g h budget depth facts acc done k h_10 prop r h_13 h_14)
    (intro h15 h)
    (apply Prod.Lex.right
      ((apply Prod.Lex.right
         ((simp_only List.length_cons List.length_nil h_10 h_13 h) (arith only h_14 (farkas 1))))))))
(fulfills eng_fact.dec_1
  (by (intro e g h budget depth b h7 h_8) (apply Prod.Lex.right ((apply Prod.Lex.left (decide))))))
(fulfills eng_apply_each.dec_1
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills eng_apply_each.dec_2
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 hs a11 a12 a13 a14 a15 a16 a17)
    (rw hs)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills eng_apply_each.dec_3
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 hs a11 a12 a13)
    (rw hs)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills eng_solve.dec_1
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11)
    (apply Prod.Lex.right (apply Prod.Lex.right (apply natAbs_pred (arith))))))
(fulfills eng_solve.dec_2
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills eng_solve.dec_3
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills eng_induct.dec_1
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills eng_induct_each.dec_1
  (by (intro a1 a2 a3 a4 a5 a6 a7 a8 a9) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills eng_induct_each.dec_2
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 hs a10 a11)
    (rw hs)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills eng_induct_on.dec_1
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24
      a25 a26 a27)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills eng_children.dec_1
  (by (intro a1 a2 a3 a4 a5 a6 a7 a8 a9) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills eng_children.dec_2
  (by
    (intro a1 a2 a3 a4 a5 a6 a7 a8 hs a10 a11 a12)
    (rw hs)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))

;; ---- rendering: a block as I's concrete syntax, what the sidecar holds ------------------------
(fn nodes_sx ((ns (List Node))) (List SExpr)
  (measure (List_Node.size ns))
  (match ns
    (nil nil)
    ((cons n r) (cons (node_sx n) (nodes_sx r)))))
(fn node_sx ((n Node)) SExpr
  (measure (Node.size n))
  (match n
    ((NIntro ns) (SList (cons (SSym (sym "intro")) (names_sx ns))))
    ((NExact t) (SList (list (SSym (sym "exact")) t)))
    ((NRfl) (SSym (sym "rfl")))
    ((NHave nm p b) (SList (cons (SSym (sym "have")) (cons (name_sx nm) (cons p (nodes_sx b))))))
    ((NShow p) (SList (list (SSym (sym "show")) p)))
    ((NApply t bs) (SList (cons (SSym (sym "apply")) (cons t (nodes_sx bs)))))
    ((NCases t hn arms)
     (SList
       (cons (SSym (sym "cases")) (cons t (append (opt_name_sx hn) (list (SList (nodes_sx arms))))))))
    ((NInduction t hn arms)
     (SList
       (cons (SSym (sym "induction"))
         (cons t (append (opt_name_sx hn) (list (SList (nodes_sx arms))))))))
    ((NWf x m ih b)
     (SList (cons (SSym (sym "wf")) (cons x (cons m (cons (name_sx ih) (nodes_sx b)))))))
    ((NDecide) (SSym (sym "decide")))
    ((NUnfold ns) (SList (cons (SSym (sym "unfold")) (names_sx ns))))
    ((NReduce side keep rules)
     (SList
       (cons (SSym (sym "reduce"))
         (append (if (sym_eq side (sym "both")) nil (list (SSym side)))
           (append
             (match keep
               (nil nil)
               (_ (list (SList (cons (SSym (sym "keep")) (names_sx keep))))))
             (match rules
               (nil nil)
               (_ (list (SList (cons (SSym (sym "using")) (rules_sx rules)))))))))))
    ((NRw rv t k ex bs)
     (SList
       (cons (SSym (sym "rw"))
         (cons (if rv (SList (list (SSym (sym "<-")) t)) t)
           (append
             (if (= k 0) nil
             (list
               (SList
                 (cons (SSym (sym "occ"))
                   (cons (SNum k)
                     (match ex
                       ((some s) (list s))
                       (none nil)))))))
             (nodes_sx bs))))))
    ((NSorry) (SSym (sym "sorry")))
    ((NArith only facts certs)
     (SList
       (cons (SSym (sym "arith"))
         (append (if only (list (SSym (sym "only"))) nil) (append facts (certs_sx certs))))))
    ((NSimp rules) (SList (cons (SSym (sym "simp_only")) (rules_sx rules))))
    ((NBlock b) (SList (nodes_sx b)))
    ((NArm c ns b) (SList (cons (name_sx c) (cons (SList (names_sx ns)) (nodes_sx b)))))))
(fn names_sx ((ns (List Name))) (List SExpr)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r) (cons (name_sx n) (names_sx r)))))
(fn name_sx ((n Name)) SExpr (SSym (sym_of_chars (show_name n))))
(fn opt_name_sx ((hn (Option Name))) (List SExpr)
  (match hn
    ((some n) (list (name_sx n)))
    (none nil)))
(fn certs_sx ((cs (List (List Int)))) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons ks r) (cons (SList (cons (SSym (sym "farkas")) (ints_sx ks))) (certs_sx r)))))
(fn ints_sx ((ks (List Int))) (List SExpr)
  (measure (struct ks))
  (match ks
    (nil nil)
    ((cons k r) (cons (SNum k) (ints_sx r)))))
(fn rules_sx ((rs (List (Prod Bool SExpr)))) (List SExpr)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (Prod.mk rv s) r) (cons (if rv (SList (list (SSym (sym "<-")) s)) s) (rules_sx r)))))
(fulfills nodes_sx.dec_1 (by (intro ns n r h) (rw h) (rw List_Node.size.eq_2) (arith)))
(fulfills nodes_sx.dec_2 (by (intro ns n r h) (rw h) (rw List_Node.size.eq_2) (arith)))
(fulfills node_sx.dec_1 (by (intro n nm p b h) (rw h) (rw Node.size.eq_4) (arith)))
(fulfills node_sx.dec_2 (by (intro n t bs h) (rw h) (rw Node.size.eq_6) (arith)))
(fulfills node_sx.dec_3 (by (intro n t hn arms h) (rw h) (rw Node.size.eq_7) (arith)))
(fulfills node_sx.dec_4 (by (intro n t hn arms h) (rw h) (rw Node.size.eq_8) (arith)))
(fulfills node_sx.dec_5 (by (intro n x m ih b h) (rw h) (rw Node.size.eq_9) (arith)))
(fulfills node_sx.dec_6 (by (intro n rv t k ex bs h) (rw h) (rw Node.size.eq_13) (arith)))
(fulfills node_sx.dec_7 (by (intro n b h) (rw h) (rw Node.size.eq_17) (arith)))
(fulfills node_sx.dec_8 (by (intro n c ns b h) (rw h) (rw Node.size.eq_18) (arith)))
