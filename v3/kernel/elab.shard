;;; v3/kernel/elab.shard — the L elaborator. S terms → K's `Expr`, bidirectional:
;;; every rule takes an expected type when the position has one and returns
;;; the term with its type. Terms are built over K's locals (kw.shard) and
;;; closed by K's mk_binding; a citation of a constant inserts a metavariable
;;; at each implicit binder and a level metavariable for each universe
;;; parameter not written, solved by first-order unification (unify.shard)
;;; of the argument types with the binders and of the result type with the
;;; expected type — the expected type first, the explicit arguments left to
;;; right with numerals last, so `(List.cons 0 nil)` at `(List Int)` reads
;;; `0` at `Int`. What the declared inputs do not determine is a refusal that
;;; names the binder (`unsolved_implicit`, `unsolved_universe`), never a
;;; default — except the numeral's `Nat`. The coercions (check_expected): a
;;; `Nat` where an `Int` is expected becomes `Int.ofNat`, a proposition where
;;; a `Bool` is expected `Decidable.decide`, a `Bool` where a proposition is
;;; expected `b = true`. The operator spellings take the naming-law identity
;;; at the type of their first operand (`-`, `/`, `mod` at `Nat` are
;;; `Nat.sub`, `Nat.div`, `Nat.mod` here — nothing runs); `if` is `ite` with
;;; the decision of its proposition's head, a `Bool` condition read as
;;; `c = true`. `@f` is Lean's explicit application: no binder is implicit.
;;; `(match t (PAT BODY)…)` is the application of a generated matcher
;;; (matcher.shard): the matcher is checked into the walk's environment as it
;;; is made and handed to the reader with the declaration (`el_aux`), so K
;;; admits it before its owner. A bare name that is ambiguous is the
;;; constructor of the expected type's inductive when exactly that settles it.
;;; Unification's outcomes are kept apart: a blocked or exhausted attempt is
;;; `unify_stuck` / `unify_exhausted`, never `type_mismatch`.
;;;
;;; Untrusted: K rechecks every closed declaration this produces; a wrong
;;; assignment is K's refusal, a missing one is this file's, with its pointer.

(import "scope.shard")
(import "unify.shard")
(import "matcher.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.expr)
(use kernel.kw)
(use kernel.level)
(use kernel.matcher)
(use kernel.name)
(use kernel.scope)
(use kernel.spelling)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.unify)
(use kernel.decl)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.kw.W)
(use kernel.level.Level)
(use kernel.matcher.MtGen)
(use kernel.matcher.MtInd)
(use kernel.matcher.MtPat)
(use kernel.name.Name)
(use kernel.scope.Cx)
(use kernel.scope.Defd)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)
(use kernel.unify.MCtx)
(use kernel.unify.URes)

;; what elaboration generates beside the term: the owner the names hang under, the next
;; matcher's number, the declarations made so far in admission order (already checked into
;; the walk's environment; the reader hands them to the loader before the owner)
(type Gen (Gen Name Int (List Declaration)))
;; the elaboration state: K's world (environment, locals, checker state), the
;; metavariable context, the scope context, the generated declarations
(type El (El W MCtx Cx Gen))
(fn el_w ((e El)) W
  (match e
    ((El w _ _ _) w)))
(fn el_mc ((e El)) MCtx
  (match e
    ((El _ m _ _) m)))
(fn el_cx ((e El)) Cx
  (match e
    ((El _ _ c _) c)))
(fn el_gen ((e El)) Gen
  (match e
    ((El _ _ _ g) g)))
(fn el_set_w ((e El) (w W)) El
  (match e
    ((El _ m c g) (El w m c g))))
(fn el_set_mc ((e El) (m MCtx)) El
  (match e
    ((El w _ c g) (El w m c g))))
(fn el_set_cx ((e El) (c Cx)) El
  (match e
    ((El w m _ g) (El w m c g))))
(fn el_aux ((e El)) (List Declaration)
  (match (el_gen e)
    ((Gen _ _ ds) ds)))
(fn el_owner ((e El)) Name
  (match (el_gen e)
    ((Gen o _ _) o)))
(fn el_next_matcher ((e El)) Int
  (match (el_gen e)
    ((Gen _ k _) k)))
(fn el_add_aux ((e El) (d Declaration)) El
  (match e
    ((El w m c (Gen o k ds)) (El w m c (Gen o (+ k 1) (append ds (list d)))))))
(fn el0 ((sc Scope) (env CheckedEnv) (lps (List Name)) (defining (List Defd)) (owner Name)) El
  (El (w0 env) (mc0) (cx0 sc env lps defining) (Gen owner 1 nil)))
(fn el_env ((e El)) CheckedEnv (w_env (el_w e)))
(fn el_with_etype ((e El) (t Bool)) El (el_set_cx e (cx_with_etype (el_cx e) t)))
(fn el_with_defining ((e El) (d (List Defd))) El (el_set_cx e (cx_with_defining (el_cx e) d)))
(fn el_with_aliases ((e El) (a (List (Prod Name (Prod Int Expr))))) El
  (el_set_cx e (cx_with_aliases (el_cx e) a)))

;; a term result: the state, the term, its type
(type ERes (EOk El Expr Expr) (EErr Symbol (List Int)))

;; ---- the state's operations ---------------------------------------------------------------
(fn el_zonk ((e El) (x Expr)) Expr (inst_mvars (el_mc e) x))
(fn el_whnf ((e El) (x Expr)) (Prod El Expr)
  (let ((z (el_zonk e x)))
    (match (w_whnf (el_w e) z)
      ((Prod.mk w1 (some r)) (Prod.mk (el_set_w e w1) r))
      ((Prod.mk w1 none) (Prod.mk (el_set_w e w1) z)))))
;; unification with its outcome; `el_unify` where any failure is one "no"
(type EU (EUOk El) (EUNo) (EUStuck Int) (EUExhausted Symbol))
(fn el_unify_r ((e El) (a Expr) (b Expr)) EU
  (match (unify (el_w e) (el_mc e) a b)
    ((UYes w1 mc1) (EUOk (El w1 mc1 (el_cx e) (el_gen e))))
    (UNo EUNo)
    ((UStuck i) (EUStuck i))
    ((UExhausted site) (EUExhausted site))))
(fn el_unify ((e El) (a Expr) (b Expr)) (Option El)
  (match (el_unify_r e a b)
    ((EUOk e1) (some e1))
    (_ none)))
;; the refusal of a blocked or an exhausted unification, naming what it waits for
(fn eu_refusal ((e El) (u EU) (otherwise ERes)) ERes
  (match u
    ((EUStuck i)
     (EErr (sym "unify_stuck")
       (append (utf8 "blocked on ")
         (append
           (match (mc_decl (el_mc e) i)
             ((some d) (show_name (md_name d)))
             (none (utf8 "a metavariable")))
           (utf8
             ": an argument the elaborator cannot solve first-order — write the application with @")))))
    ((EUExhausted site)
     (EErr (sym "unify_exhausted") (append (utf8 "unification ran out at ") (chars_of_sym site))))
    (_ otherwise)))
(fn el_infer ((e El) (x Expr)) (Prod El (Option Expr))
  (match (w_infer (el_w e) (el_zonk e x))
    ((Prod.mk w1 r) (Prod.mk (el_set_w e w1) r))))
;; the type of a term K checks as it infers (kw.shard w_infer_checked), None of an ill-typed one
(fn el_infer_checked ((e El) (x Expr)) (Prod El (Option Expr))
  (match (w_infer_checked (el_w e) (el_zonk e x))
    ((Prod.mk w1 r) (Prod.mk (el_set_w e w1) r))))
;; a fresh metavariable in the current scope
(fn el_fresh ((e El) (n Name) (ty Expr) (kind Symbol)) (Prod El Expr)
  (match (mc_fresh (el_mc e) n ty (cx_fvar_ids (el_cx e)) kind)
    ((Prod.mk mc1 m) (Prod.mk (el_set_mc e mc1) m))))
(fn el_fresh_level ((e El)) (Prod El Level)
  (match (mc_fresh_level (el_mc e))
    ((Prod.mk mc1 l) (Prod.mk (el_set_mc e mc1) l))))
(fn el_fresh_levels ((e El) (k Int)) (Prod El (List Level))
  (measure k)
  (if (< k 1) (Prod.mk e nil)
  (match (el_fresh_level e)
    ((Prod.mk e1 l)
     (match (el_fresh_levels e1 (- k 1))
       ((Prod.mk e2 ls) (Prod.mk e2 (cons l ls))))))))
;; a local: its type instantiated first (K's local carries it as written —
;; the binding is closed by K's mk_binding over the local's declaration)
(fn el_local ((e El) (n Name) (ty Expr) (bi BinderInfo)) (Prod El Expr)
  (match (w_local_bi (el_w e) n (el_zonk e ty) bi)
    ((Prod.mk w1 fv) (Prod.mk (El w1 (el_mc e) (cx_bind (el_cx e) n fv) (el_gen e)) fv))))
(fn el_local_val ((e El) (n Name) (ty Expr) (v Expr)) (Prod El Expr)
  (match (w_local_val (el_w e) n (el_zonk e ty) (el_zonk e v))
    ((Prod.mk w1 fv) (Prod.mk (El w1 (el_mc e) (cx_bind (el_cx e) n fv) (el_gen e)) fv))))
;; close binders over fvars: the body instantiated, K's mk_binding, the
;; metavariables that survive lose the closed locals from their telescopes
(fn el_close ((e El) (fvars (List Expr)) (b Expr) (is_lam Bool)) (Prod El Expr)
  (let ((z (el_zonk e b)))
    (match (if is_lam (w_lams (el_w e) fvars z) (w_pis (el_w e) fvars z))
      ((Prod.mk w1 r)
       (Prod.mk (El w1 (mc_drop_fvars (el_mc e) (fvar_ids fvars)) (el_cx e) (el_gen e)) r)))))
(fn el_pis ((e El) (fvars (List Expr)) (b Expr)) (Prod El Expr) (el_close e fvars b false))
(fn el_lams ((e El) (fvars (List Expr)) (b Expr)) (Prod El Expr) (el_close e fvars b true))
;; leave the scope of the locals opened after `saved` (the world keeps them: a
;; closed term never mentions them)
(fn el_restore ((e El) (saved El)) El (el_set_cx e (el_cx saved)))

;; ---- finishing a declaration ----------------------------------------------------------------
(type FinRes (FinOk Expr) (FinErr Symbol (List Int)))
;; the term instantiated; an unsolved metavariable names its binder
(fn el_finish ((e0 El) (x Expr)) FinRes
  (let ((e (el_solve_instances e0)))
    (let ((z (el_zonk e x)))
      (match (tentative_bad (el_w e) (el_mc e))
        ((some i)
         (FinErr (sym "tentative_assignment")
           (append (utf8 "the value unification chose for ")
             (append
               (match (mc_decl (el_mc e) i)
                 ((some d) (show_name (md_name d)))
                 (none (utf8 "a metavariable")))
               (utf8 " does not have its type: write the application with @")))))
        (none (el_finish_term e z))))))
;; ---- instances by table -------------------------------------------------------------------
;; an instance-implicit metavariable whose type is closed takes the table's term
;; (spelling.shard's sp_instance) when the table has a row; the rest stay for unsolved_msg's
;; instance_needed. Asked for an application's own binders when its arguments are read
;; (el_solve_slots), for every metavariable when a declaration finishes, and for a tactic
;; opening's premises (tactic.shard's witness_close)
(fn el_solve_instances ((e El)) El (el_solve_ids e (mc_ids (el_mc e))))
(fn el_solve_ids ((e El) (is (List Int))) El
  (measure (struct is))
  (match is
    (nil e)
    ((cons i r) (el_solve_ids (el_solve_one e i) r))))
(fn el_solve_slots ((e El) (slots (List Slot))) El
  (measure (struct slots))
  (match slots
    (nil e)
    ((cons (SImp (MVar _ i)) r) (el_solve_slots (el_solve_one e i) r))
    ((cons _ r) (el_solve_slots e r))))
(fn el_solve_one ((e El) (i Int)) El
  (match (mc_assigned (el_mc e) i)
    ((some _) e)
    (none
      (match (mc_decl (el_mc e) i)
        (none e)
        ((some d)
         (if (bool_not (sym_eq (md_kind d) (sym "inst"))) e
         (let ((ty (el_zonk e (md_type d))))
           (if (has_mvar ty) e
           (match (sp_instance ty)
             (none e)
             ((some v)
              (match (first_missing e (expr_consts v))
                ((some _) e)  ; an instance the module does not see is not taken: unsolved_msg names it
                (none
                  (match (assign (el_w e) (el_mc e) i v 32)
                    ((UYes w1 mc1) (el_set_mc (el_set_w e w1) mc1))
                    (_ e))))))))))))))
(fn el_finish_term ((e El) (z Expr)) FinRes
  (match (first_mvar z)
    ((some i) (unsolved_msg e i))
    (none
      (match (first_lmvar z)
        ((some _)
         (FinErr (sym "unsolved_universe")
           (utf8 "a universe the declared inputs do not determine: write NAME.{…}")))
        (none (FinOk z))))))
(fn unsolved_msg ((e El) (i Int)) FinRes
  (match (mc_decl (el_mc e) i)
    (none
      (FinErr (sym "unsolved_implicit") (utf8 "an argument the declared inputs do not determine")))
    ((some d)
     (if (sym_eq (md_kind d) (sym "inst"))
       (match (inst_unseen e (el_zonk e (md_type d)))
         ((some k) (FinErr (sym "unknown_constant") (show_name k)))
         (none
           (FinErr (sym "instance_needed")
             (append (utf8 "the instance argument ")
               (append (show_name (md_name d))
                 (utf8
                   " is not filled by the instance table (there is no instance search): write the application with @ and the instance"))))))
     (if (sym_eq (md_kind d) (sym "explicit"))
       (FinErr (sym "unsolved_implicit")
         (append (utf8 "the argument ")
           (append (show_name (md_name d)) (utf8 " was not determined"))))
       (FinErr (sym "unsolved_implicit")
         (append (utf8 "the implicit argument ")
           (append (show_name (md_name d))
             (utf8
               " is not determined by the explicit arguments or the expected type: write the application with @")))))))))
;; the instance the table has for a closed type cites a constant the module does not see — one
;; the environment lacks, or one of Init in a module that sees none: that constant
(fn inst_unseen ((e El) (ty Expr)) (Option Name)
  (if (has_mvar ty) none
  (match (sp_instance ty)
    (none none)
    ((some v) (first_missing e (expr_consts v))))))

;; ---- levels ----------------------------------------------------------------------------
(fn elab_level ((e El) (s SExpr)) (Option Level)
  (measure (struct s))
  (match s
    ((SNum k) (some (level_of_nat k)))
    ((SSym x)
     (match (name_of_sym x)
       ((some n) (if (mem_name n (cx_lps (el_cx e))) (some (LParam n)) none))
       (none none)))
    ((SList (cons (SSym h) args))
     (if (sym_eq h (sym "succ"))
       (match args
         ((cons a nil)
          (match (elab_level e a)
            ((some l) (some (LSucc l)))
            (none none)))
         (_ none))
     (if (sym_eq h (sym "max"))
       (match args
         ((cons a (cons b nil)) (level2 e a b true))
         (_ none))
     (if (sym_eq h (sym "imax"))
       (match args
         ((cons a (cons b nil)) (level2 e a b false))
         (_ none))
       none))))
    (_ none)))
(fn level2 ((e El) (a SExpr) (b SExpr) (is_max Bool)) (Option Level)
  (match (elab_level e a)
    (none none)
    ((some la)
     (match (elab_level e b)
       (none none)
       ((some lb) (some (if is_max (LMax la lb) (LIMax la lb))))))))
(fn level_of_nat ((k Int)) Level (measure k) (if (< k 1) LZero (LSucc (level_of_nat (- k 1)))))
(fn elab_levels ((e El) (ss (List SExpr))) (Option (List Level))
  (measure (struct ss))
  (match ss
    (nil (some nil))
    ((cons s r)
     (match (elab_level e s)
       (none none)
       ((some l)
        (match (elab_levels e r)
          (none none)
          ((some ls) (some (cons l ls)))))))))
(fn zeros ((k Int)) (List Level) (measure k) (if (< k 1) nil (cons LZero (zeros (- k 1)))))

;; ---- the expected type -------------------------------------------------------------------
;; the term's type against the expected one: unify, else a coercion
(fn check_expected ((e El) (v Expr) (ty Expr) (expected (Option Expr))) ERes
  (match expected
    (none (EOk e v ty))
    ((some x)
     (match (el_unify_r e ty x)
       ((EUOk e1) (EOk e1 v (el_zonk e1 x)))
       ((EUStuck i) (eu_refusal e (EUStuck i) (EErr (sym "type_mismatch") (utf8 "blocked"))))
       ((EUExhausted site)
        (eu_refusal e (EUExhausted site) (EErr (sym "type_mismatch") (utf8 "exhausted"))))
       (EUNo
         (match (el_whnf e ty)
           ((Prod.mk e1 tyw)
            (match (el_whnf e1 x)
              ((Prod.mk e2 xw)
               (if
                 (bool_and (is_const_named tyw (nm_nat))
                   (bool_and (is_const_named xw (nm_int_ty)) (int_of_nat_visible e2)))
                 (EOk e2 (mk_app (mk_const (nm_int_of_nat) nil) v) xw)
                 (if (bool_and (is_prop_sort tyw) (is_const_named xw (nm_bool)))
                   (prop_as_bool e2 v xw)
                 (if (bool_and (is_const_named tyw (nm_bool)) (is_prop_sort xw))
                   (match (first_missing e2 (list (nm_eq)))
                     ((some k) (EErr (sym "unknown_constant") (show_name k)))
                     (none (EOk e2 (bool_is_true v) xw)))
                   (EErr (sym "type_mismatch")
                     (append (utf8 "expected ")
                       (append (show_expr xw) (append (utf8 ", found ") (show_expr tyw)))))))))))))))))
;; a proposition where a Bool is expected: `Decidable.decide p inst` with the decision its
;; head has, else no_decision
(fn is_prop_sort ((t Expr)) Bool
  (match t
    ((Sort _ LZero) true)
    (_ false)))
(fn prop_as_bool ((e El) (p Expr) (xw Expr)) ERes
  (let ((pz (el_zonk e p)))
    (match (first_missing e (list (n2 (sym "Decidable") (sym "decide"))))
      ((some k) (EErr (sym "unknown_constant") (show_name k)))
      (none
        (match (decision_of e pz)
          ((Prod.mk e1 (some dec))
           (EOk e1 (mk_app (mk_app (mk_const (n2 (sym "Decidable") (sym "decide")) nil) pz) dec) xw))
          ((Prod.mk _ none)
           (no_decision e pz
             (append (utf8 "a Bool is expected and the proposition ")
               (append (show_expr pz)
                 (utf8 " has no decision the elaborator knows: write (@Decidable.decide P DEC)"))))))))))
;; a constant the module can cite: in the environment and visible from the scope (the
;; environment holds what the process declared for any file; what a module sees is its own)
(fn el_sees ((e El) (k Name)) Bool
  (match (env_find (el_env e) k)
    ((some _) (visible (cx_scope (el_cx e)) k))
    (none false)))
;; the first of these constants the module does not see: the elaborator builds a term from
;; them by name, and K would refuse the term later
(fn first_missing ((e El) (ks (List Name))) (Option Name)
  (measure (struct ks))
  (match ks
    (nil none)
    ((cons k r) (if (el_sees e k) (first_missing e r) (some k)))))
(fn int_of_nat_visible ((e El)) Bool (el_sees e (nm_int_of_nat)))

;; ---- terms -------------------------------------------------------------------------------
(fn elab ((e El) (s SExpr) (expected (Option Expr))) ERes
  (measure (struct s))
  (match s
    ((SNum k) (elab_num e k expected))
    ;; a String literal is UTF-8 text: K reads it by decoding, and only on valid bytes is the
    ;; encoding of the decoded text the bytes written
    ((SStr bs)
     (if (utf8_ok bs) (check_expected e (mk_lit (LitStr bs)) (mk_const (nm_string) nil) expected)
     (EErr (sym "bad_string") (utf8 "a string literal's bytes are not UTF-8"))))
    ((SSym x) (elab_sym e x nil false expected))
    ((SSymU x ls) (elab_sym e x ls true expected))
    ((SList nil) (EErr (sym "empty_application") (utf8 "()")))
    ((SList (cons (SSym h) args))
     (if (sym_eq h (sym "quote"))
       (EErr (sym "no_quote") (utf8 "a symbol is written (sym \"x\"): there is no quote form"))
     (if (sym_eq h (sym "fun")) (elab_binding e args true expected)
     (if (sym_eq h (sym "forall")) (elab_binding e args false expected)
     (if (sym_eq h (sym "->")) (elab_arrow e args expected)
     (if (sym_eq h (sym "let")) (elab_let e args expected)
     (if (sym_eq h (sym "Sort"))
       (match args
         ((cons l nil)
          (match (elab_level e l)
            ((some u) (check_expected e (mk_sort u) (mk_sort (LSucc u)) expected))
            (none (EErr (sym "bad_level") (utf8 "(Sort LEVEL)")))))
         (_ (EErr (sym "bad_shape") (utf8 "(Sort LEVEL)"))))
     (if (sym_eq h (sym "Type"))
       (match args
         ((cons l nil)
          (match (elab_level e l)
            ((some u) (check_expected e (mk_sort (LSucc u)) (mk_sort (LSucc (LSucc u))) expected))
            (none (EErr (sym "bad_level") (utf8 "(Type LEVEL)")))))
         (_ (EErr (sym "bad_shape") (utf8 "(Type LEVEL)"))))
     (if (sym_eq h (sym "proj")) (elab_proj e args expected)
     (if (sym_eq h (sym "if")) (elab_if e args expected)
     (if (sym_eq h (sym "dif")) (elab_dif e args expected)
     (if (sym_eq h (sym "match")) (elab_match e args expected)
     (if (sym_eq h (sym "list")) (elab_list e args expected)
     (if (sym_eq h (sym "exists")) (elab_exists e args expected)
     (elab_app e (SSym h) args expected)))))))))))))))
    ((SList (cons h args)) (elab_app e h args expected))))

;; a numeral: at an expected `Int`, `Int.ofNat n` / `Int.negSucc (-n-1)` (where Init's
;; Int.ofNat is in scope); else K's Nat literal
(fn elab_num ((e El) (k Int) (expected (Option Expr))) ERes
  (match expected
    ((some x)
     (match (el_whnf e x)
       ((Prod.mk e1 xw)
        (if (bool_and (is_const_named xw (nm_int_ty)) (int_of_nat_visible e1))
          (if (< k 0) (EOk e1 (mk_app (mk_const (nm_int_neg_succ) nil) (nat_lit (- (- 0 k) 1))) xw)
          (EOk e1 (mk_app (mk_const (nm_int_of_nat) nil) (nat_lit k)) xw))
          (elab_nat_lit e1 k expected)))))
    (none (elab_nat_lit e k expected))))
(fn elab_nat_lit ((e El) (k Int) (expected (Option Expr))) ERes
  (if (< k 0)
    (EErr (sym "negative_numeral")
      (utf8 "a negative numeral has an L literal at Int only: K's literals are naturals"))
    (check_expected e (nat_lit k) (mk_const (nm_nat) nil) expected)))

;; a symbol: Prop / Type, a bound name, a projection alias, else a constant with
;; its implicit arguments inserted (a bare `List.nil` is `@List.nil ?α`)
(fn elab_sym ((e El) (x Symbol) (ls (List SExpr)) (has_univ Bool) (expected (Option Expr))) ERes
  (let ((explicit (sym_explicit x)) (x1 (sym_strip x)))
    (match (name_of_sym x1)
      (none (EErr (sym "bad_name") (chars_of_sym x1)))
      ((some n)
       (match (cx_lookup (el_cx e) n)
         ((some fv)
          (if has_univ
            (EErr (sym "bad_universe_suffix") (utf8 "a bound variable takes no universe arguments"))
            (match (w_local_type (el_w e) (fvar_id_of fv))
              ((some ty) (check_expected e fv ty expected))
              (none (EErr (sym "bad_shape") (utf8 "a bound variable without a local"))))))
         (none
           (match (assoc_alias n (cx_aliases (el_cx e)))
             ((some (Prod.mk j ty))
              (match (cx_lookup (el_cx e) (self_name))
                ((some fv) (check_expected e (mk_proj (alias_struct e) j fv) ty expected))
                (none (EErr (sym "bad_shape") (utf8 "a projection alias outside its structure")))))
             (none
               (if (bool_and (bool_not has_univ) (sym_eq x1 (sym "Prop")))
                 (check_expected e (mk_sort LZero) (mk_sort (LSucc LZero)) expected)
               (if (bool_and (bool_not has_univ) (sym_eq x1 (sym "Type")))
                 (check_expected e (mk_sort (LSucc LZero)) (mk_sort (LSucc (LSucc LZero))) expected)
                 (match (elab_const e n ls has_univ expected)
                   ((EErr r m) (EErr r m))
                   ((EOk e1 c cty) (elab_args e1 c cty nil explicit expected)))))))))))))
(fn assoc_alias ((n Name) (xs (List (Prod Name (Prod Int Expr))))) (Option (Prod Int Expr))
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons (Prod.mk m v) r) (if (name_eq n m) (some v) (assoc_alias n r)))))
;; the bound name projections go through; `self.` is not a name an author can spell
;; (nor a symbol the V3 lexer reads — a trailing dot is a universe suffix's start — so it is built from its bytes)
(fn self_name () Name (Str Anon (sym_of_chars (utf8 "self."))))
;; the structure a projection alias projects from: the first name being declared
(fn alias_struct ((e El)) Name
  (match (cx_defining (el_cx e))
    ((cons (Defd n _ _) _) n)
    (nil Anon)))
;; (proj S i x): its type is K's (the field's type past the earlier fields)
(fn proj_term ((e El) (sn Name) (i Int) (x Expr) (expected (Option Expr))) ERes
  (let ((p (mk_proj sn i x)))
    (match (el_infer e p)
      ((Prod.mk e1 (some ty)) (check_expected e1 p ty expected))
      ((Prod.mk _ none)
       (EErr (sym "bad_projection") (append (show_name sn) (append (utf8 ".") (show_nat i))))))))

;; a constant with its universe arguments: written, or none, or level 0 by rule
;; in an E-type position, else a level metavariable each (universe inference)
(fn elab_const ((e El) (n Name) (ls (List SExpr)) (has_univ Bool) (expected (Option Expr))) ERes
  (match (resolve (el_cx e) n)
    (RNone (EErr (sym "unknown_constant") (show_name n)))
    ((RAmbiguous a b)
     (match (expected_ctor e n expected)
       ((some k)
        (elab_const_at e n k
          (match (const_arity (el_cx e) k)
            ((some ar) ar)
            (none 0))
          ls
          has_univ))
       (none
         (match (if (expects_sort e expected) (type_of_pair e a b) none)
           ((some k)
            (elab_const_at e n k
              (match (const_arity (el_cx e) k)
                ((some ar) ar)
                (none 0))
              ls
              has_univ))
           (none
             (EErr (sym "ambiguous_name")
               (append (show_name n)
                 (append (utf8 ": ") (append (show_name a) (append (utf8 " and ") (show_name b)))))))))))
    ((RPend k)
     (EErr (sym "pending_obligation")
       (append (show_name k)
         (utf8 " is pending: it admits nothing, and citing it is the obligation"))))
    ((RName k arity) (elab_const_at e n k arity ls has_univ))))
;; an ambiguous bare name at an expected inductive type: its constructor of that name
(fn expected_ctor ((e El) (n Name) (expected (Option Expr))) (Option Name)
  (match expected
    (none none)
    ((some x)
     (match (el_whnf e x)
       ((Prod.mk e1 xw)
        (match (get_app_fn xw)
          ((Const _ ind _)
           (match (env_find (el_env e1) ind)
             ((some (InductInfo _ _ _ _ _ _ _ _ _)) (resolve_ctor (el_cx e1) n ind))
             (_ none)))
          (_ none)))))))
;; a type and its own constructor under one name (`(type CalcState (CalcState …))`): where a
;; type is expected the name is the type's — a binder's type, an argument at a sort
(fn type_of_pair ((e El) (a Name) (b Name)) (Option Name)
  (if (ctor_of_type e b a) (some a)
  (if (ctor_of_type e a b) (some b)
  none)))
(fn ctor_of_type ((e El) (c Name) (t Name)) Bool
  (match (env_find (el_env e) c)
    ((some (CtorInfo _ ind _ _ _ _)) (name_eq ind t))
    (_ false)))
(fn expects_sort ((e El) (expected (Option Expr))) Bool
  (match expected
    (none false)
    ((some x)
     (match (el_whnf e x)
       ((Prod.mk _ (Sort _ _)) true)
       (_ false)))))
;; the head of a type expression read as a type: `CalcState`, `(Step CalcState Action)`
(fn type_position ((e El) (s SExpr)) SExpr
  (match s
    ((SSym x) (SSym (type_sym e x)))
    ((SList (cons (SSym x) args)) (SList (cons (SSym (type_sym e x)) args)))
    (_ s)))
(fn type_sym ((e El) (x Symbol)) Symbol
  (match (name_of_sym x)
    (none x)
    ((some n)
     (match (resolve (el_cx e) n)
       ((RAmbiguous a b)
        (match (type_of_pair e a b)
          ((some k) (sym_of_chars (show_name k)))
          (none x)))
       (_ x)))))
(fn elab_const_at ((e El) (n Name) (k Name) (arity Int) (ls (List SExpr)) (has_univ Bool)) ERes
  (if has_univ
    (match (elab_levels e ls)
      (none (EErr (sym "bad_level") (show_name n)))
      ((some lvls)
       (if (= (len lvls) arity) (const_at e k lvls)
       (EErr (sym "universe_arity")
         (append (show_name k)
           (append (utf8 " takes ") (append (show_nat arity) (utf8 " universe arguments"))))))))
  (if (= arity 0) (const_at e k nil)
  (if (cx_etype (el_cx e)) (const_at e k (zeros arity))
  (match (el_fresh_levels e arity)
    ((Prod.mk e1 lvls) (const_at e1 k lvls)))))))
;; the constant and its type at these levels: a name this form declares, else the environment's
(fn const_at ((e El) (k Name) (lvls (List Level))) ERes
  (match (find_defd k (cx_defining (el_cx e)))
    ((some (Defd _ _ ty))
     (match (w_inst_lparams (el_w e) ty (cx_lps (el_cx e)) lvls)
       ((Prod.mk w1 ty1) (EOk (el_set_w e w1) (mk_const k lvls) ty1))))
    (none
      (match (env_find (el_env e) k)
        (none (EErr (sym "unknown_constant") (show_name k)))
        ((some info)
         (match (w_inst_lparams (el_w e) (ci_type info) (ci_lparams info) lvls)
           ((Prod.mk w1 ty1) (EOk (el_set_w e w1) (mk_const k lvls) ty1))))))))

;; ---- application -----------------------------------------------------------------------
;; an argument: source, or already elaborated (the operator and `if` paths)
(type EArg (ASrc SExpr) (AVal Expr Expr))
(fn elab_app ((e El) (h SExpr) (args (List SExpr)) (expected (Option Expr))) ERes
  (match h
    ((SSym x) (elab_app_sym e x nil false args expected))
    ((SSymU x ls) (elab_app_sym e x ls true args expected))
    (_
      (match (elab e h none)
        ((EErr r m) (EErr r m))
        ((EOk e1 f fty) (elab_args e1 f fty (srcs args) false expected))))))
(fn srcs ((args (List SExpr))) (List EArg)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons a r) (cons (ASrc a) (srcs r)))))
;; the head a symbol: a bound name, an operator spelling, else a constant
(fn elab_app_sym
  ((e El) (x Symbol) (ls (List SExpr)) (has_univ Bool) (args (List SExpr)) (expected (Option Expr)))
  ERes
  (let ((explicit (sym_explicit x)) (x1 (sym_strip x)))
    (match (name_of_sym x1)
      (none (EErr (sym "bad_name") (chars_of_sym x1)))
      ((some n)
       (match (cx_lookup (el_cx e) n)
         ((some fv)
          (match (w_local_type (el_w e) (fvar_id_of fv))
            ((some ty) (elab_args e fv ty (srcs args) false expected))
            (none (EErr (sym "bad_shape") (utf8 "a bound variable without a local")))))
         (none
           ;; an earlier field applied in a later field's type (a package's law over its operation)
           (match (assoc_alias n (cx_aliases (el_cx e)))
             ((some (Prod.mk j ty))
              (match (cx_lookup (el_cx e) (self_name))
                ((some fv)
                 (elab_args e (mk_proj (alias_struct e) j fv) ty (srcs args) false expected))
                (none (EErr (sym "bad_shape") (utf8 "a projection alias outside its structure")))))
             (none
               (if (bool_and (bool_not has_univ) (bool_or (is_operator x1) (renamed_spelling x1)))
                 (match (renamed_prim x1)
                   ((some new) (EErr (sym "renamed_primitive") (renamed_msg x1 new)))
                   (none (elab_op e x1 args expected)))
                 (match (elab_const e n ls has_univ expected)
                   ((EErr r m) (EErr r m))
                   ((EOk e1 c cty) (elab_args e1 c cty (srcs args) explicit expected))))))))))))

;; a slot of the telescope: an inserted metavariable, or an explicit argument
;; with the metavariable standing for it until it is elaborated
(type Slot (SImp Expr) (SExp EArg Expr))
(type TlRes (TlOk El Expr Expr (List Slot)) (TlErr Symbol (List Int)))
;; the head applied through its telescope: a metavariable per implicit binder
;; (a strict one only before an explicit argument, an instance one is the
;; table's to fill: el_solve_instances), a placeholder per explicit argument, the result type
(fn tele ((e El) (f Expr) (fty Expr) (args (List EArg)) (explicit Bool) (acc (List Slot)) (d Int))
  TlRes
  (measure d)
  (if (< d 1) (TlErr (sym "bad_shape") (utf8 "an application too long"))
  (let ((ty (el_zonk e fty)))
    (match ty
      ((Pi _ n bi dom body)
       (if (bool_or explicit (bool_or (bi_default bi) (bool_and (bi_strict bi) (nil_args args))))
         (match args
           (nil (TlOk e f ty (rev acc)))
           ((cons a r)
            (match (el_fresh e n dom (sym "explicit"))
              ((Prod.mk e1 m)
               (match (w_inst1 (el_w e1) body m)
                 ((Prod.mk w2 body1)
                  (tele (el_set_w e1 w2) (mk_app f m) body1 r explicit (cons (SExp a m) acc) (- d 1))))))))
         (match (el_fresh e n dom (if (bi_inst bi) (sym "inst") (sym "implicit")))
           ((Prod.mk e1 m)
            (match (w_inst1 (el_w e1) body m)
              ((Prod.mk w2 body1)
               (tele (el_set_w e1 w2) (mk_app f m) body1 args explicit (cons (SImp m) acc) (- d 1))))))))
      (_
        (match args
          (nil (TlOk e f ty (rev acc)))
          (_
            (match (el_whnf e ty)
              ((Prod.mk e1 tyw)
               (if (is_pi tyw) (tele e1 f tyw args explicit acc (- d 1))
               (match args
                 ((cons (ASrc (SSym op)) _)
                  (if (is_operator op)
                    (TlErr (sym "infix_form")
                      (append (utf8 "S is prefix notation: write (")
                        (append (chars_of_sym op)
                          (append (utf8 " A B) — applied to ")
                            (append (show_nat (len args))
                              (append (utf8 " more arguments than its type has: ") (show_expr tyw)))))))
                    (TlErr (sym "function_expected") (over_applied e1 f (len args) tyw))))
                 (_ (TlErr (sym "function_expected") (over_applied e1 f (len args) tyw))))))))))))))
;; a head applied past its type: the head as it was resolved — where a name of Init's stands
;; for a declaration of the load's that was meant, the full name is what to write
(fn over_applied ((e El) (f Expr) (extra Int) (tyw Expr)) (List Int)
  (append
    (match (get_app_fn f)
      ((Const _ c _)
       (append (utf8 "the head resolved to ")
         (append (show_name c)
           (if (native_decl (cx_scope (el_cx e)) c) (utf8 ", which is ")
           (utf8
             " — Init's declaration; a constructor or function of the load that bears the name is cited by its full name, or bare where its prefix is opened with (use …) — and is ")))))
      (_ (utf8 "the head is ")))
    (append (utf8 "applied to ")
      (append (show_nat extra) (append (utf8 " more arguments than its type has: ") (show_expr tyw))))))
(fn bi_default ((bi BinderInfo)) Bool
  (match bi
    (BDefault true)
    (_ false)))
(fn bi_strict ((bi BinderInfo)) Bool
  (match bi
    (BStrictImplicit true)
    (_ false)))
(fn bi_inst ((bi BinderInfo)) Bool
  (match bi
    (BInstImplicit true)
    (_ false)))
(fn nil_args ((args (List EArg))) Bool
  (match args
    (nil true)
    (_ false)))

;; the application: the telescope; the written arguments that are bare names
;; first (a variable or a constant: an eliminator's major premise, so the
;; expected type then meets `?motive t` as a pattern, Lean's elabAsElim order);
;; the expected type propagated (best effort); the other explicit arguments at
;; their binders, numerals last — each unified with its placeholder; then the
;; term and its type instantiated
(fn elab_args
  ((e El) (f Expr) (fty Expr) (args (List EArg)) (explicit Bool) (expected (Option Expr)))
  ERes
  (match (tele e f fty args explicit nil 256)
    ((TlErr r m) (EErr r m))
    ((TlOk e1 fa rty slots)
     (match (elab_slots e1 slots 0)
       ((EErr r m) (EErr r m))
       ((EOk e1b _ _)
        (let
          ((e2 El
             (match expected
               ((some x)
                (match (el_unify e1b rty x)
                  ((some e3) e3)
                  (none e1b)))
               (none e1b))))
          (match (elab_slots e2 slots 1)
            ((EErr r m) (EErr r m))
            ((EOk e3 _ _)
             (match (elab_slots e3 slots 2)
               ((EErr r m) (EErr r m))
               ((EOk e4 _ _)
                (match (check_expected e4 (el_zonk e4 fa) (el_zonk e4 rty) expected)
                  ((EOk e5 v ty) (EOk (el_solve_slots e5 slots) v ty))  ; the binders' instances by table, once the expected type has had its say
                  (other other))))))))))))
;; the explicit slots of one pass: 0 the bound variables and the elaborated
;; values, 1 the rest, 2 the numerals
(fn elab_slots ((e El) (slots (List Slot)) (pass Int)) ERes
  (measure (struct slots))
  (match slots
    (nil (EOk e (mk_sort LZero) (mk_sort LZero)))
    ((cons (SImp _) r) (elab_slots e r pass))
    ((cons (SExp a m) r)
     (if (bool_not (= (arg_pass e a) pass)) (elab_slots e r pass)
     (match (elab_slot e a m)
       ((EErr r2 m2) (EErr r2 m2))
       ((EOk e1 _ _) (elab_slots e1 r pass)))))))
(fn arg_pass ((e El) (a EArg)) Int
  (match a
    ((ASrc (SNum _)) 2)
    ((ASrc (SSym x))
     (match (name_of_sym x)
       ((some n)
        (match (cx_lookup (el_cx e) n)
          ((some _) 0)
          (none 1)))
       (none 1)))
    ((AVal _ _) 0)
    (_ 1)))
;; one explicit argument at its binder's type (the placeholder's), then the
;; placeholder is the argument — already assigned by the expected type, a
;; definitional check
(fn elab_slot ((e El) (a EArg) (m Expr)) ERes
  (let
    ((dom Expr
       (match (mvar_type e m)
         ((some t) (el_zonk e t))
         (none (mk_sort LZero)))))
    (let
      ((r ERes
         (match a
           ((ASrc s) (elab e s (some dom)))
           ((AVal v vty) (check_expected e v vty (some dom))))))
      (match r
        ((EErr r1 msg) (EErr r1 msg))
        ((EOk e1 v vty)
         (match (el_unify_r e1 m v)
           ((EUOk e2) (EOk e2 v vty))
           (u
             (eu_refusal e1 u
               (EErr (sym "argument_mismatch")
                 (append (utf8 "the expected type fixes this argument to ")
                   (append (show_expr (el_zonk e1 m)) (append (utf8 ", found ") (show_expr v)))))))))))))
(fn mvar_type ((e El) (m Expr)) (Option Expr)
  (match m
    ((MVar _ i)
     (match (mc_decl (el_mc e) i)
       ((some d) (some (md_type d)))
       (none none)))
    (_ none)))

;; ---- binders -----------------------------------------------------------------------------
;; (x TYPE) or (x TYPE implicit|strict|inst): the type elaborated and checked to be one
(type BRes (BOk El Expr Level) (BErr Symbol (List Int)))
(fn read_binder ((e El) (s SExpr)) BRes
  (match s
    ((SList (cons (SSym x) (cons ty rest)))
     (match (name_of_sym x)
       (none (BErr (sym "bad_name") (chars_of_sym x)))
       ((some n)
        (match (binder_info rest)
          (none
            (BErr (sym "bad_binder") (utf8 "a binder is (x TYPE) or (x TYPE implicit|strict|inst)")))
          ((some bi)
           (match (elab_type e ty)
             ((EErr r m) (BErr r m))
             ((EOk e1 t s)
              (match (el_local e1 n t bi)
                ((Prod.mk e2 fv) (BOk e2 fv (level_of_sort s)))))))))))
    (_ (BErr (sym "bad_binder") (utf8 "a binder is (x TYPE)")))))
(fn binder_info ((rest (List SExpr))) (Option BinderInfo)
  (match rest
    (nil (some BDefault))
    ((cons (SSym m) nil)
     (if (sym_eq m (sym "implicit")) (some BImplicit)
     (if (sym_eq m (sym "strict")) (some BStrictImplicit)
     (if (sym_eq m (sym "inst")) (some BInstImplicit)
     none))))
    (_ none)))
;; a term in a type position: its type must be a Sort; a metavariable left in
;; it is a refusal here (K's locals carry their types as written)
(fn elab_type ((e El) (s SExpr)) ERes
  (match (elab e (type_position e s) none)
    ((EErr r m) (EErr r m))
    ((EOk e1 t tty)
     (match (el_finish e1 t)
       ((FinErr r m) (EErr r m))
       ((FinOk t1)
        (match (el_whnf e1 tty)
          ((Prod.mk e2 s1)
           (if (is_sort s1) (EOk e2 t1 s1)
           (match s1
             ((MVar _ _)
              (match (el_unify e2 s1 (mk_sort (LSucc LZero)))
                ((some e3) (EOk e3 t1 (mk_sort (LSucc LZero))))
                (none (EErr (sym "not_a_type") (show_expr t1)))))
             (_
               (EErr (sym "not_a_type") (append (show_expr t1) (append (utf8 " : ") (show_expr s1))))))))))))))
;; a declaration's binders in order, each in scope for the next; the fvars in
;; order, and the sort levels of their types (a Pi's sort is imax over them)
(fn read_binders ((e El) (bs (List SExpr)) (acc (List Expr)))
  (Prod (Option (Prod El (List Expr))) (List Int))
  (match (read_binders_lv e bs acc nil)
    ((Prod.mk none m) (Prod.mk none m))
    ((Prod.mk (some (Prod.mk e1 (Prod.mk fvars _))) _) (Prod.mk (some (Prod.mk e1 fvars)) nil))))
(fn read_binders_lv ((e El) (bs (List SExpr)) (acc (List Expr)) (lvs (List Level)))
  (Prod (Option (Prod El (Prod (List Expr) (List Level)))) (List Int))
  (measure (struct bs))
  (match bs
    (nil (Prod.mk (some (Prod.mk e (Prod.mk (rev acc) (rev lvs)))) nil))
    ((cons b r)
     (match (read_binder e b)
       ((BErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
       ((BOk e1 fv lv) (read_binders_lv e1 r (cons fv acc) (cons lv lvs)))))))
(fn level_of_sort ((s Expr)) Level
  (match s
    ((Sort _ u) u)
    (_ LZero)))
;; Sort (imax u_1 (… (imax u_n v))): a Pi's sort from its binders' and its body's
(fn pi_sort ((lvs (List Level)) (v Level)) Expr (mk_sort (imax_fold lvs v)))
(fn imax_fold ((lvs (List Level)) (v Level)) Level
  (measure (struct lvs))
  (match lvs
    (nil v)
    ((cons u r) (LIMax u (imax_fold r v)))))

;; (fun (BINDER…) BODY) / (forall (BINDER…) BODY)
(fn elab_binding ((e El) (args (List SExpr)) (is_lam Bool) (expected (Option Expr))) ERes
  (match args
    ((cons (SList bs) (cons body nil))
     (match (read_binders_lv e bs nil nil)
       ((Prod.mk none m) (EErr (sym "bad_binder") m))
       ((Prod.mk (some (Prod.mk e1 (Prod.mk fvars lvs))) _)
        (if is_lam
          (match (elab e1 body (lam_body_expected e1 fvars expected))
            ((EErr r m) (EErr r m))
            ((EOk e2 v vty)
             (match (el_lams e2 fvars v)
               ((Prod.mk e3 lam)
                (match (el_pis e3 fvars vty)
                  ((Prod.mk e4 pi) (check_expected (el_restore e4 e) lam pi expected)))))))
          (match (elab_type e1 body)
            ((EErr r m) (EErr r m))
            ((EOk e2 b s)
             (match (el_pis e2 fvars b)
               ((Prod.mk e3 pi)
                (check_expected (el_restore e3 e) pi (pi_sort lvs (level_of_sort s)) expected)))))))))
    (_
      (EErr (sym "bad_shape")
        (if is_lam (utf8 "(fun ((x TYPE)…) TERM)") (utf8 "(forall ((x TYPE)…) TERM)"))))))
;; the body's expected type under a lambda: the expected Pi's codomain at the locals
(fn lam_body_expected ((e El) (fvars (List Expr)) (expected (Option Expr))) (Option Expr)
  (match expected
    (none none)
    ((some x) (pi_codomain_at e (el_zonk e x) fvars))))
(fn pi_codomain_at ((e El) (x Expr) (fvars (List Expr))) (Option Expr)
  (measure (struct fvars))
  (match fvars
    (nil (some x))
    ((cons fv r)
     (match x
       ((Pi _ _ _ _ body)
        (match (w_inst1 (el_w e) body fv)
          ((Prod.mk _ b1) (pi_codomain_at e b1 r))))
       (_ none)))))

;; (-> A … R): non-dependent Pi, right-nested; the binder is anonymous
(fn elab_arrow ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    (nil (EErr (sym "bad_shape") (utf8 "(-> TERM… TERM)")))
    ((cons r nil) (elab e r expected))
    (_
      (match (arrow_locals e args nil nil)
        ((Prod.mk none m) (EErr (sym "bad_binder") m))
        ((Prod.mk (some (Prod.mk (Prod.mk e1 fvars) (Prod.mk b s))) _)
         (match (el_pis e1 fvars b)
           ((Prod.mk e2 pi) (check_expected (el_restore e2 e) pi s expected))))))))
;; the locals of the domains, the body with its sort
(fn arrow_locals ((e El) (args (List SExpr)) (acc (List Expr)) (lvs (List Level)))
  (Prod (Option (Prod (Prod El (List Expr)) (Prod Expr Expr))) (List Int))
  (measure (struct args))
  (match args
    (nil (Prod.mk none (utf8 "(-> TERM… TERM)")))
    ((cons r nil)
     (match (elab_type e r)
       ((EErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
       ((EOk e1 b s)
        (Prod.mk
          (some (Prod.mk (Prod.mk e1 (rev acc)) (Prod.mk b (pi_sort (rev lvs) (level_of_sort s)))))
          nil))))
    ((cons a rest)
     (match (elab_type e a)
       ((EErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
       ((EOk e1 d s)
        (match (el_local e1 Anon d BDefault)
          ((Prod.mk e2 fv) (arrow_locals e2 rest (cons fv acc) (cons (level_of_sort s) lvs)))))))))

;; a let's body, elaborated under the local `fv := val`, closed over it as a Let; the
;; context restored to e0's
(fn let_close ((e0 El) (fv Expr) (val Expr) (res ERes)) ERes
  (match res
    ((EErr r m) (EErr r m))
    ((EOk e4 b bty)
     (match (el_lams e4 (list fv) b)
       ((Prod.mk e5 lb)
        (match (w_subst (el_w e5) (el_zonk e5 bty) (fvar_id_of fv) val)
          ((Prod.mk w6 bty1) (EOk (el_restore (el_set_w e5 w6) e0) lb bty1))))))))
;; (let ((x TYPE TERM)…) BODY): sequential, one Let per binding
(fn elab_let ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    ((cons (SList bs) (cons body nil)) (elab_lets e bs body expected))
    (_ (EErr (sym "bad_shape") (utf8 "(let ((x TYPE TERM)…) TERM)")))))
(fn elab_lets ((e El) (bs (List SExpr)) (body SExpr) (expected (Option Expr))) ERes
  (measure (struct bs))
  (match bs
    (nil (elab e body expected))
    ((cons (SList (cons (SSym x) (cons ty (cons v nil)))) r)
     (match (name_of_sym x)
       (none (EErr (sym "bad_name") (chars_of_sym x)))
       ((some n)
        (match (elab_type e ty)
          ((EErr r2 m) (EErr r2 m))
          ((EOk e1 t _)
           (match (elab e1 v (some t))
             ((EErr r2 m) (EErr r2 m))
             ((EOk e2 val _)
              (match (el_finish e2 val)
                ((FinErr r2 m) (EErr r2 m))
                ((FinOk val1)
                 (match (el_local_val e2 n t val1)
                   ((Prod.mk e3 fv) (let_close e fv val1 (elab_lets e3 r body expected)))))))))))))
    ((cons (SList (cons (SSym x) (cons v nil))) r)  ; (x TERM): the type is the term's (a body's let)
     (match (name_of_sym x)
       (none (EErr (sym "bad_name") (chars_of_sym x)))
       ((some n)
        (match (elab e v none)
          ((EErr r2 m) (EErr r2 m))
          ((EOk e1 val vty)
           (match (el_finish e1 vty)
             ((FinErr r2 m) (EErr r2 m))
             ((FinOk t)
              (match (el_finish e1 val)
                ((FinErr r2 m) (EErr r2 m))
                ((FinOk val1)
                 (match (el_local_val e1 n t val1)
                   ((Prod.mk e3 fv) (let_close e fv val1 (elab_lets e3 r body expected)))))))))))))
    (_ (EErr (sym "bad_shape") (utf8 "a let binding is (x TYPE TERM) or (x TERM)")))))

;; (proj S i TERM)
(fn elab_proj ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    ((cons (SSym sn) (cons (SNum i) (cons t nil)))
     (match (name_of_sym sn)
       (none (EErr (sym "bad_name") (chars_of_sym sn)))
       ((some n)
        (match (resolve (el_cx e) n)
          ((RName k _)
           (match (elab e t none)
             ((EErr r m) (EErr r m))
             ((EOk e1 x _) (proj_term e1 k i x expected))))
          ((RAmbiguous a b)
           (EErr (sym "ambiguous_name") (append (show_name a) (append (utf8 " and ") (show_name b)))))
          ((RPend k)
           (EErr (sym "pending_obligation")
             (append (show_name k)
               (utf8 " is pending: it admits nothing, and citing it is the obligation"))))
          (RNone (EErr (sym "unknown_constant") (show_name n)))))))
    (_ (EErr (sym "bad_shape") (utf8 "(proj STRUCTURE INDEX TERM)")))))

;; ---- the operator spellings -------------------------------------------------------------
;; the identity at the type of the first operand: Nat, Int, or a proposition /
;; Bool for the connectives; `=` is Eq with its implicit type; `if` below
(fn is_operator ((x Symbol)) Bool
  (bool_or (sym_eq x (sym "+"))
    (bool_or (sym_eq x (sym "-"))
      (bool_or (sym_eq x (sym "*"))
        (bool_or (sym_eq x (sym "/"))
          (bool_or (sym_eq x (sym "mod"))
            (bool_or (sym_eq x (sym "%"))
              (bool_or (sym_eq x (sym "<"))
                (bool_or (sym_eq x (sym "<="))
                  (bool_or (sym_eq x (sym ">"))
                    (bool_or (sym_eq x (sym ">="))
                      (bool_or (sym_eq x (sym "="))
                        (bool_or (sym_eq x (sym "!="))
                          (bool_or (sym_eq x (sym "and"))
                            (bool_or (sym_eq x (sym "or"))
                              (bool_or (sym_eq x (sym "not"))
                                (bool_or (sym_eq x (sym "iff"))
                                  (bool_or (sym_eq x (sym "min")) (sym_eq x (sym "max"))))))))))))))))))))
;; an operator is a term: inside an E-type position — a fn's `(Decidable (= a b))` — its
;; constants take their levels by unification, not the position's level 0
(fn elab_op ((e El) (x Symbol) (args (List SExpr)) (expected (Option Expr))) ERes
  (if (cx_etype (el_cx e))
    (match (elab_op_at (el_with_etype e false) x args expected)
      ((EErr r m) (EErr r m))
      ((EOk e1 v t) (EOk (el_with_etype e1 true) v t)))
    (elab_op_at e x args expected)))
(fn elab_op_at ((e El) (x Symbol) (args (List SExpr)) (expected (Option Expr))) ERes
  (if (sym_eq x (sym "=")) (op_const e (nm_eq) args expected)
  (if (sym_eq x (sym "!=")) (op_const e (n1 (sym "Ne")) args expected)
  (if (sym_eq x (sym "iff")) (op_const e (n1 (sym "Iff")) args expected)
  (if (bool_or (sym_eq x (sym ">")) (sym_eq x (sym ">=")))
    (match args
      ((cons a (cons b nil))
       (elab_op_at e (if (sym_eq x (sym ">")) (sym "<") (sym "<=")) (list b a) expected))
      (_ (EErr (sym "bad_shape") (utf8 "(OP a b)"))))
    (match args
      ((cons a nil)
       (if (sym_eq x (sym "not"))
         (match (elab e a none)
           ((EErr r m) (EErr r m))
           ((EOk e1 av aty)
            (match (el_whnf e1 aty)
              ((Prod.mk e2 atyw)
               (if (is_sort atyw) (op_apply e2 (n1 (sym "Not")) (list (AVal av aty)) expected)
               (if (is_const_named atyw (nm_bool))
                 (op_apply e2 (n2 (sym "Bool") (sym "not")) (list (AVal av aty)) expected)
                 (EErr (sym "no_operator_identity") (append (utf8 "not at ") (show_expr atyw)))))))))
         (EErr (sym "bad_shape") (utf8 "(OP a b)"))))
      ((cons a (cons b nil))
       (match (op_expected e x expected)
         ((Prod.mk e0 (some id)) (op_apply e0 id (list (ASrc a) (ASrc b)) expected))
         ((Prod.mk e0 none)
          (if (bool_and (is_num_closed a) (bool_not (is_num_closed b)))
            ;; the identity is the first operand's type's — of the first that is not numeric-closed
            ;; (`(<= 48 c)` at c's Int; `(<= -5 x)` at x's): the closed operand is then read at
            ;; the binder
            (match (elab e0 b none)
              ((EErr r m) (EErr r m))
              ((EOk e1 bv bty)
               (match (el_whnf e1 bty)
                 ((Prod.mk e2 btyw)
                  (match (op_identity x btyw)
                    ((some id) (op_apply e2 id (list (ASrc a) (AVal bv bty)) expected))
                    (none
                      (EErr (sym "no_operator_identity")
                        (append (chars_of_sym x)
                          (append (utf8 " at ")
                            (append (show_expr btyw)
                              (utf8
                                ": no naming-law identity at this type — the operator spellings are read at Nat and Int, `and` and `or` at a proposition and at Bool: write the type's own function")))))))))))
            (match (elab e0 a none)
              ((EErr r m) (EErr r m))
              ((EOk e1 av aty)
               (match (el_whnf e1 aty)
                 ((Prod.mk e2 atyw)
                  (match (op_identity x atyw)
                    ((some id) (op_apply e2 id (list (AVal av aty) (ASrc b)) expected))
                    (none
                      (EErr (sym "no_operator_identity")
                        (append (chars_of_sym x)
                          (append (utf8 " at ")
                            (append (show_expr atyw)
                              (utf8
                                ": no naming-law identity at this type — the operator spellings are read at Nat and Int, `and` and `or` at a proposition and at Bool: write the type's own function")))))))))))))))
      (_ (EErr (sym "bad_shape") (utf8 "(OP a b)")))))))))
;; an arithmetic operator under an expected type that is Nat or Int takes that type's identity
;; and reads both operands at it — `(- 1 2)` at Int is Int.sub, a Nat local under Int is cast
;; at the leaf — as Lean's binop% reads `(n + 1 : Int)`; chosen from an operand with the result
;; coerced, `(- 1 2)` at Int would be 0
(fn op_expected ((e El) (x Symbol) (expected (Option Expr))) (Prod El (Option Name))
  (if (bool_not (is_arith_op x)) (Prod.mk e none)
  (match expected
    (none (Prod.mk e none))
    ((some ty)
     (match (el_whnf e ty)
       ((Prod.mk e1 tyw)
        (if (is_const_named tyw (nm_nat)) (Prod.mk e1 (op_at (sym "Nat") x))
        (if (is_const_named tyw (nm_int_ty)) (Prod.mk e1 (op_at (sym "Int") x))
        (Prod.mk e1 none)))))))))
(fn is_arith_op ((x Symbol)) Bool
  (bool_or (sym_eq x (sym "+"))
    (bool_or (sym_eq x (sym "-"))
      (bool_or (sym_eq x (sym "*"))
        (bool_or (sym_eq x (sym "/")) (bool_or (sym_eq x (sym "mod")) (sym_eq x (sym "%"))))))))
;; numeric-closed: a numeral, or an arithmetic operator over numeric-closed operands — an
;; operand that decides no identity by itself
(fn is_num_closed ((s SExpr)) Bool
  (measure (struct s))
  (match s
    ((SNum _) true)
    ((SList (cons (SSym h) args)) (bool_and (is_arith_op h) (all_num_closed args)))
    (_ false)))
(fn all_num_closed ((xs (List SExpr))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r) (bool_and (is_num_closed x) (all_num_closed r)))))
;; a constant applied to source arguments (Eq, Ne, Iff: the implicit type is theirs)
(fn op_const ((e El) (k Name) (args (List SExpr)) (expected (Option Expr))) ERes
  (match (elab_const e k nil false none)
    ((EErr r m) (EErr r m))
    ((EOk e1 c cty) (elab_args e1 c cty (srcs args) false expected))))
(fn op_apply ((e El) (k Name) (args (List EArg)) (expected (Option Expr))) ERes
  (match (elab_const e k nil false none)
    ((EErr r m) (EErr r m))
    ((EOk e1 c cty) (elab_args e1 c cty args false expected))))
;; the identity of a binary spelling at the first operand's type
(fn op_identity ((x Symbol) (ty Expr)) (Option Name)
  (if (is_const_named ty (nm_nat)) (op_at (sym "Nat") x)
  (if (is_const_named ty (nm_int_ty)) (op_at (sym "Int") x)
  (if (is_sort ty) (op_prop x)
  (if (is_const_named ty (n1 (sym "Bool"))) (op_bool x)
  none)))))
;; `/` and `%` at Int are the Euclidean pair Int.ediv and Int.emod (the pin has no Int.div);
;; `min` and `max` are Init's Min.min and Max.max under the table's instance, the one spelling
;; of `List.length_take`'s right side
(fn op_at ((t Symbol) (x Symbol)) (Option Name)
  (if (sym_eq x (sym "+")) (some (n2 t (sym "add")))
  (if (sym_eq x (sym "-")) (some (n2 t (sym "sub")))
  (if (sym_eq x (sym "*")) (some (n2 t (sym "mul")))
  (if (sym_eq x (sym "/")) (some (n2 t (if (sym_eq t (sym "Int")) (sym "ediv") (sym "div"))))
  (if (bool_or (sym_eq x (sym "mod")) (sym_eq x (sym "%")))
    (some (n2 t (if (sym_eq t (sym "Int")) (sym "emod") (sym "mod"))))
  (if (sym_eq x (sym "<")) (some (n2 t (sym "lt")))
  (if (sym_eq x (sym "<=")) (some (n2 t (sym "le")))
  (if (sym_eq x (sym "min")) (some (n2 (sym "Min") (sym "min")))
  (if (sym_eq x (sym "max")) (some (n2 (sym "Max") (sym "max")))
  none))))))))))
(fn op_prop ((x Symbol)) (Option Name)
  (if (sym_eq x (sym "and")) (some (n1 (sym "And")))
  (if (sym_eq x (sym "or")) (some (n1 (sym "Or")))
  none)))
;; Init's Bool connectives under their Lean 4.33 names (`and`, `or`, `not` are not constants
;; of the export)
(fn op_bool ((x Symbol)) (Option Name)
  (if (sym_eq x (sym "and")) (some (n2 (sym "Bool") (sym "and")))
  (if (sym_eq x (sym "or")) (some (n2 (sym "Bool") (sym "or")))
  none)))

;; (if C T F): `ite C dec T F` for a proposition C whose head has a decision
;; (Nat.lt/le → Nat.decLt/decLe, Eq at Nat/Int/Bool → decEq, Int likewise); a Bool C is the
;; proposition `C = true` with Bool's decidable equality (Lean's own elaboration); the
;; branches at the expected type
(fn elab_if ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    ((cons c (cons t (cons f nil)))
     (match (elab e c none)
       ((EErr r m) (EErr r m))
       ((EOk e1 cv cty)
        (match (el_whnf e1 cty)
          ((Prod.mk e2 ctyw)
           (if (is_const_named ctyw (nm_bool))
             (match
               (first_missing e2
                 (list (nm_eq) (n1 (sym "Decidable")) (n1 (sym "instDecidableEqBool"))))
               ((some k) (EErr (sym "unknown_constant") (show_name k)))
               (none
                 (let ((p (bool_is_true cv)))
                   (op_apply_explicit e2 (n1 (sym "ite"))
                     (list (AVal p (mk_sort LZero))
                       (AVal (bool_decision cv) (mk_app (mk_const (n1 (sym "Decidable")) nil) p))
                       (ASrc t)
                       (ASrc f))
                     expected))))
             (match (two_ctors e2 ctyw)
               ((some (Prod.mk c1 c2))
                ;; a value of a two-constructor inductive: the second constructor takes the
                ;; then-branch — the match it abbreviates
                (elab_if_cases e2 (el_zonk e2 cv) ctyw c1 c2 t f expected))
               (none
                 (match (if_refusal e2 ctyw)
                   ((some (Prod.mk r m)) (EErr r m))
                   (none
                     (match (decision_of e2 (el_zonk e2 cv))
                       ((Prod.mk e3 (some dec))
                        (op_apply_explicit e3 (n1 (sym "ite"))
                          (list (AVal cv cty)
                            (AVal dec (mk_app (mk_const (n1 (sym "Decidable")) nil) cv))
                            (ASrc t)
                            (ASrc f))
                          expected))
                       ((Prod.mk _ none)
                        (no_decision e2 (el_zonk e2 cv)
                          (append (utf8 "the condition ")
                            (append (show_expr (el_zonk e2 cv))
                              (utf8
                                " has no decision the elaborator knows: write (@ite C DEC T F) with the Decidable instance"))))))))))))))))
    (_ (EErr (sym "bad_shape") (utf8 "(if C T F)")))))
;; (dif h C T F): the dependent if, its hypothesis named —
;; `dite C dec (λ h:C. T) (λ h:¬C. F)`, Lean's elaboration of `if h : c then t else e`; C as an
;; if's condition (a proposition with a decision, or a Bool as `C = true`); each branch at the
;; form's expected type, else the then-branch's own; a two-constructor value is no condition here
(fn elab_dif ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    ((cons (SSym hn) (cons c (cons t (cons f nil))))
     (match (elab e c none)
       ((EErr r m) (EErr r m))
       ((EOk e1 cv cty)
        (match (el_whnf e1 cty)
          ((Prod.mk e2 ctyw)
           (if (is_const_named ctyw (nm_bool))
             (match
               (first_missing e2
                 (list (nm_eq) (n1 (sym "Decidable")) (n1 (sym "instDecidableEqBool"))
                   (n1 (sym "dite"))
                   (n1 (sym "Not"))))
               ((some k) (EErr (sym "unknown_constant") (show_name k)))
               (none (elab_dif_branches e2 hn (bool_is_true cv) (bool_decision cv) t f expected)))
             (match (two_ctors e2 ctyw)
               ((some _)
                (EErr (sym "dif_type")
                  (utf8
                    "a dif names the hypothesis of a proposition: a value of a two-constructor inductive has none (write if)")))
               (none
                 (match (if_refusal e2 ctyw)
                   ((some (Prod.mk r m)) (EErr r m))
                   (none
                     (match
                       (first_missing e2
                         (list (n1 (sym "Decidable")) (n1 (sym "dite")) (n1 (sym "Not"))))
                       ((some k) (EErr (sym "unknown_constant") (show_name k)))
                       (none
                         (match (decision_of e2 (el_zonk e2 cv))
                           ((Prod.mk e3 (some dec))
                            (elab_dif_branches e3 hn (el_zonk e3 cv) dec t f expected))
                           ((Prod.mk _ none)
                            (no_decision e2 (el_zonk e2 cv)
                              (append (utf8 "the condition ")
                                (append (show_expr (el_zonk e2 cv))
                                  (utf8 " has no decision the elaborator knows"))))))))))))))))))
    (_ (EErr (sym "bad_shape") (utf8 "(dif h C T F)")))))
;; the branches under their hypotheses, then `dite p dec lamT lamF` at the result type
(fn elab_dif_branches
  ((e El) (hn Symbol) (p Expr) (dec Expr) (t SExpr) (f SExpr) (expected (Option Expr)))
  ERes
  (match (dif_branch e hn p t expected)
    ((EErr r m) (EErr r m))
    ((EOk e1 lam_t ret)
     (match (dif_branch e1 hn (mk_app (mk_const (n1 (sym "Not")) nil) p) f (some ret))
       ((EErr r m) (EErr r m))
       ((EOk e2 lam_f _)
        (op_apply_explicit e2 (n1 (sym "dite"))
          (list (AVal p (mk_sort LZero)) (AVal dec (mk_app (mk_const (n1 (sym "Decidable")) nil) p))
            (AVal lam_t (mk_pi_anon p ret))
            (AVal lam_f (mk_pi_anon (mk_app (mk_const (n1 (sym "Not")) nil) p) ret)))
          expected))))))
;; `λ h:hyp. BRANCH`; the result is the branch's type, closed over nothing (the hypothesis is a
;; proof, and the branch's type does not mention it: a dif's type is its position's)
(fn dif_branch ((e El) (hn Symbol) (hyp Expr) (br SExpr) (expected (Option Expr))) ERes
  (match (el_local e (n1 hn) hyp BDefault)
    ((Prod.mk e1 h)
     (match (elab e1 br expected)
       ((EErr r m) (EErr r m))
       ((EOk e2 v vty)
        (match (el_lams e2 (list h) v)
          ((Prod.mk e3 lam)
           (let ((ret (el_zonk e3 vty)))
             (let
               ((mentions Bool
                  (match h
                    ((FVar _ hid) (mem_int hid (expr_fvars ret nil)))
                    (_ false))))
               (if mentions
                 (EErr (sym "dif_type")
                   (append (utf8 "the branch's type mentions the hypothesis ") (chars_of_sym hn)))
                 (EOk (el_restore e3 e) lam ret)))))))))))
(fn mk_pi_anon ((dom Expr) (cod Expr)) Expr (mk_pi Anon BDefault dom cod))

;; a condition that is a value, not a proposition, and not of a Bool or a two-constructor
;; inductive: a sig type's observation is the type's to export (private_if), any other type
;; has no binary rule to inherit (if_type)
(fn if_refusal ((e El) (ctyw Expr)) (Option (Prod Symbol (List Int)))
  (match (get_app_fn ctyw)
    ((Const _ st _)
     (match (env_find (el_env e) st)
       ((some (AxiomInfo _ _))
        (some
          (Prod.mk (sym "private_if")
            (append (utf8 "an if branches on a value of the sig type ")
              (append (show_name st)
                (utf8
                  ": an if would read the implementation's constructor order through the view — branch on the result of a function the view declares"))))))
       ((some (InductInfo _ _ _ _ ctors _ _ _ _))
        (some
          (Prod.mk (sym "if_type")
            (append (utf8 "an if branches on a value of type ")
              (append (show_name st)
                (append (utf8 ", which has ")
                  (append (show_nat (len ctors))
                    (utf8 " constructors: an if takes a type of two — write a match"))))))))
       (_ none)))
    (_ none)))
;; an `if` on a value of a two-constructor inductive: `T.casesOn`
;; with a constant motive, the first constructor's alternative the else-branch and the second's
;; the then-branch, each ignoring its fields — not a matcher, so the erasure reads the `if`
;; back (erasure.shard's erase_cases) and the equations do not split on it
(fn elab_if_cases
  ((e El)
   (cv Expr)
   (ctyw Expr)
   (c1 (Prod Name Int))
   (c2 (Prod Name Int))
   (t SExpr)
   (f SExpr)
   (expected (Option Expr)))
  ERes
  (match (if_ret e t expected)
    ((Prod.mk _ none)
     (EErr (sym "match_motive")
       (utf8 "an if takes its type from its position or its then-branch, and neither is determined")))
    ((Prod.mk e1 (some ret))
     (match (el_infer e1 ret)
       ((Prod.mk _ none) (EErr (sym "not_a_type") (show_expr ret)))
       ((Prod.mk e2 (some rs))
        (match (el_whnf e2 rs)
          ((Prod.mk e3 (Sort _ l))
           (match (get_app_fn ctyw)
             ((Const _ ind ls)
              (match (env_find (el_env e3) (name_append ind (n1 (sym "casesOn"))))
                (none
                  (EErr (sym "match_eliminator")
                    (append (show_name ind) (utf8 ".casesOn is not in the environment"))))
                ((some info)
                 (if (bool_not (= (len (ci_lparams info)) (+ 1 (len ls))))
                   (EErr (sym "match_eliminator")
                     (append (show_name ind) (utf8 ".casesOn eliminates into Prop only")))
                   (match
                     (if_minor e3
                       (match c1
                         ((Prod.mk k _) k))
                       ls
                       (get_app_args ctyw)
                       f
                       ret)
                     ((EErr r m) (EErr r m))
                     ((EOk e4 m1 _)
                      (match
                        (if_minor e4
                          (match c2
                            ((Prod.mk k _) k))
                          ls
                          (get_app_args ctyw)
                          t
                          ret)
                        ((EErr r m) (EErr r m))
                        ((EOk e5 m2 _)
                         (match (w_local (el_w e5) (n1 (sym "d")) ctyw)
                           ((Prod.mk w1 d)
                            (match (w_lams w1 (list d) ret)
                              ((Prod.mk w2 motive)
                               (check_expected (el_set_w e5 w2)
                                 (mk_app_n
                                   (mk_const (name_append ind (n1 (sym "casesOn"))) (cons l ls))
                                   (append (get_app_args ctyw) (list motive cv m1 m2)))
                                 ret
                                 expected)))))))))))))
             (_ (EErr (sym "if_type") (utf8 "an if on a value whose type is not an inductive")))))
          ((Prod.mk _ other) (EErr (sym "not_a_type") (show_expr other)))))))))
;; the if's type: the position's when determined, else the then-branch's own
(fn if_ret ((e El) (t SExpr) (expected (Option Expr))) (Prod El (Option Expr))
  (match (match_ret e expected)
    ((some r) (Prod.mk e (some r)))
    (none
      (match (elab e t none)
        ((EErr _ _) (Prod.mk e none))
        ((EOk e1 _ ty)
         (match (el_finish e1 ty)
           ((FinOk r) (Prod.mk e (some r)))
           ((FinErr _ _) (Prod.mk e none))))))))
;; `λ fields . BRANCH` at the result type
(fn if_minor ((e El) (c Name) (ls (List Level)) (params (List Expr)) (br SExpr) (ret Expr)) ERes
  (match (elab e br (some ret))
    ((EErr r m) (EErr r m))
    ((EOk e1 v _)
     (match (mt_ctor_type (el_w e1) c ls params)
       ((Prod.mk _ none) (EErr (sym "match_constructor") (show_name c)))
       ((Prod.mk w1 (some (Prod.mk cty nfields)))
        (match (mt_open_fields w1 cty nfields nil)
          ((Prod.mk _ none) (EErr (sym "match_constructor") (show_name c)))
          ((Prod.mk w2 (some fields))
           (match (w_lams w2 (mt_firsts fields) (el_zonk e1 v))
             ((Prod.mk w3 m) (EOk (el_set_w e1 w3) m ret))))))))))
;; the two constructors of a type that is an inductive with exactly two, each with its fields' number
(fn two_ctors ((e El) (tyw Expr)) (Option (Prod (Prod Name Int) (Prod Name Int)))
  (match (get_app_fn tyw)
    ((Const _ ind _)
     (match (env_find (el_env e) ind)
       ((some (InductInfo _ _ _ _ (cons c1 (cons c2 nil)) _ _ _ _))
        (match (Prod.mk (ctor_nfields e c1) (ctor_nfields e c2))
          ((Prod.mk (some n1f) (some n2f)) (some (Prod.mk (Prod.mk c1 n1f) (Prod.mk c2 n2f))))
          (_ none)))
       (_ none)))
    (_ none)))
(fn ctor_nfields ((e El) (c Name)) (Option Int)
  (match (env_find (el_env e) c)
    ((some (CtorInfo _ _ _ _ nf _)) (some nf))
    (_ none)))

;; (list a b …): the constructor chain of the expected type's list — an inductive with a
;; field-less constructor and a two-field one. No expected type, no
;; literal: the element type is never defaulted
(fn elab_list ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match expected
    (none
      (EErr (sym "unsolved_implicit")
        (utf8 "a list literal takes its type from its position: write it where the type is known")))
    ((some x)
     (match (el_whnf e x)
       ((Prod.mk e1 xw)
        (match (two_ctors e1 xw)
          ((some (Prod.mk (Prod.mk nl 0) (Prod.mk cs 2)))
           (elab e1 (list_chain args (sym_of_chars (show_name nl)) (sym_of_chars (show_name cs)))
             expected))
          (_
            (EErr (sym "type_mismatch")
              (append (utf8 "a list literal where ") (append (show_expr xw) (utf8 " is expected")))))))))))
(fn list_chain ((args (List SExpr)) (nl Symbol) (cs Symbol)) SExpr
  (measure (struct args))
  (match args
    (nil (SSym nl))
    ((cons a r) (SList (list (SSym cs) a (list_chain r nl cs))))))
;; the constant applied with every binder explicit but the leading implicit ones
(fn op_apply_explicit ((e El) (k Name) (args (List EArg)) (expected (Option Expr))) ERes
  (match (elab_const e k nil false none)
    ((EErr r m) (EErr r m))
    ((EOk e1 c cty)
     (match (tele e1 c cty nil false nil 16)  ; the leading implicits (α, u)
       ((TlErr r m) (EErr r m))
       ((TlOk e2 ca cty1 _) (elab_args e2 ca cty1 args true expected))))))
(fn decision_of ((e El) (c Expr)) (Prod El (Option Expr))
  (let ((h (get_app_fn c)) (as (get_app_args c)))
    (match h
      ((Const _ n _)
       (if (bool_or (name_eq n (n2 (sym "Nat") (sym "lt"))) (name_eq n (n2 (sym "Nat") (sym "le"))))
         (Prod.mk e
           (decide_with
             (n2 (sym "Nat")
               (if (name_eq n (n2 (sym "Nat") (sym "lt"))) (sym "decLt") (sym "decLe")))
             as))
       (if (bool_or (name_eq n (n2 (sym "Int") (sym "lt"))) (name_eq n (n2 (sym "Int") (sym "le"))))
         (Prod.mk e
           (decide_with
             (n2 (sym "Int")
               (if (name_eq n (n2 (sym "Int") (sym "lt"))) (sym "decLt") (sym "decLe")))
             as))
       (if (name_eq n (nm_eq))
         (match as
           ((cons ty (cons a (cons b nil)))
            (match (el_whnf e ty)
              ((Prod.mk e1 tyw)
               (if (is_const_named tyw (nm_nat))
                 (Prod.mk e1
                   (some (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "decEq")) nil) a) b)))
               (if (is_const_named tyw (nm_int_ty))
                 (Prod.mk e1
                   (some (mk_app (mk_app (mk_const (n2 (sym "Int") (sym "decEq")) nil) a) b)))
               (if (is_const_named tyw (n1 (sym "Bool")))
                 (Prod.mk e1
                   (some (mk_app (mk_app (mk_const (n1 (sym "instDecidableEqBool")) nil) a) b)))
                 ;; a type of the program's: the derivation table's one visible entry
                 (match (el_norm_ty e1 tyw)
                   ((Prod.mk e2 key)
                    (match (derived_for (cx_scope (el_cx e2)) key (sym "eq"))
                      ((cons p nil) (Prod.mk e2 (some (mk_app (mk_app (mk_const p nil) a) b))))
                      (_ (Prod.mk e2 none)))))))))))
           (_ (Prod.mk e none)))
         (Prod.mk e none)))))
      (_ (Prod.mk e none)))))
;; a type as the derivation table keys it (kw.shard w_norm_ty)
(fn el_norm_ty ((e El) (t Expr)) (Prod El Expr)
  (match (w_norm_ty (el_w e) (el_zonk e t) 16)
    ((Prod.mk w1 r) (Prod.mk (el_set_w e w1) r))))
;; no decision: at an equation whose type has two visible derivations it is the ambiguity; at
;; one with none, the pointer to the derivation
(fn no_decision ((e El) (c Expr) (m (List Int))) ERes
  (match (get_app_fn c)
    ((Const _ n _)
     (if (name_eq n (nm_eq))
       (match (get_app_args c)
         ((cons ty _)
          (match (el_norm_ty e ty)
            ((Prod.mk e1 tyw)
             (match (derived_for (cx_scope (el_cx e1)) tyw (sym "eq"))
               ((cons p (cons q _))
                (EErr (sym "ambiguous_decision")
                  (append (utf8 "two derivations of equality at ")
                    (append (show_expr tyw)
                      (append (utf8 " are visible: ")
                        (append (show_name q) (append (utf8 " and ") (show_name p))))))))
               (_
                 (EErr (sym "no_decision")
                   (append m
                     (utf8 ", or its derived equality — a (derive TYPE eq) before this form"))))))))
         (_ (EErr (sym "no_decision") m)))
       (EErr (sym "no_decision") m)))
    (_ (EErr (sym "no_decision") m))))
(fn nm_bool () Name (n1 (sym "Bool")))
;; `c = true` and its decision
(fn bool_is_true ((c Expr)) Expr
  (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (LSucc LZero))) (mk_const (nm_bool) nil)) c)
    (mk_const (n2 (sym "Bool") (sym "true")) nil)))
(fn bool_decision ((c Expr)) Expr
  (mk_app (mk_app (mk_const (n1 (sym "instDecidableEqBool")) nil) c)
    (mk_const (n2 (sym "Bool") (sym "true")) nil)))
(fn decide_with ((k Name) (as (List Expr))) (Option Expr)
  (match as
    ((cons a (cons b nil)) (some (mk_app (mk_app (mk_const k nil) a) b)))
    (_ none)))

;; ---- match ---------------------------------------------------------------------------------
;; (match T (PAT BODY)…): the matcher generated for the rows at T's type, checked into the
;; walk's environment, applied to the motive, T and an alternative per row (its body under
;; its pattern's variables). RET is the position's expected type and the motive `λ _. RET` —
;; unless T is a local RET mentions: then the motive is `λ d. RET[d/T]` and a row's body is
;; read at RET with its pattern for T (Lean's generalization of the discriminant), so a
;; result whose type depends on the scrutinee is written row by row. The readings are tried
;; in order (match_try): with the locals whose types mention T generalized too, with RET
;; alone generalized, with the constant motive; what is refused is the first reading's error
(fn elab_match ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match args
    ((cons scrut arms)
     (if (has_numeral_row arms) (elab_match_lit e scrut arms expected)
     (match (match_ret e expected)
       (none
         (EErr (sym "match_motive")
           (utf8
             "a match takes its type from its position: write it where the type is known — a definition's value, an argument, (let ((r TYPE (match …))) r)")))
       ((some ret)
        (match (elab e scrut none)
          ((EErr r m) (EErr r m))
          ((EOk e1 sv sty)
           (match (el_finish e1 sty)
             ((FinErr r m)
              (EErr (sym "match_scrutinee")
                (append (utf8 "the scrutinee's type is not determined: ") m)))
             ((FinOk dty)
              (match (el_infer e1 ret)
                ((Prod.mk _ none) (EErr (sym "not_a_type") (show_expr ret)))
                ((Prod.mk e2 (some rs))
                 (match (el_whnf e2 rs)
                   ((Prod.mk e3 (Sort _ l))
                    (let ((sv1 (el_zonk e3 sv)))
                      (let
                        ((gen (match_gen sv1 ret))
                         (svid (Option Int)
                           (match sv1
                             ((FVar _ id) (some id))
                             (_ none))))
                        (let
                          ((deps (List (Prod Name Expr))
                             (match svid
                               ((some id) (match_deps e3 id))
                               (none nil))))  ; (name, local) pairs, outermost first
                          ;; the dependent reading first, then the expected type's, then the
                          ;; constant motive; the first reading's error
                          (let
                            ((first ERes
                               (match deps
                                 (nil (EErr (sym "none") nil))
                                 (_ (match_try e3 dty ret l sv1 deps svid arms expected)))))
                            (match_live e3 dty arms
                              (match first
                                ((EOk e4 v vt) (EOk e4 v vt))
                                ((EErr r0 m0)
                                 (match (match_try e3 dty ret l sv1 nil gen arms expected)
                                   ((EOk e4 v vt) (EOk e4 v vt))
                                   ((EErr r m)
                                    (match gen
                                      (none
                                        (match deps
                                          (nil (EErr r m))
                                          (_ (EErr r0 m0))))
                                      ((some _)
                                       (match (match_try e3 dty ret l sv1 nil none arms expected)
                                         ((EOk e4 v vt) (EOk e4 v vt))
                                         ((EErr _ _)
                                          (match deps
                                            (nil (EErr r m))
                                            (_ (EErr r0 m0)))))))))))))))))
                   ((Prod.mk _ other)
                    (EErr (sym "not_a_type")
                      (append (show_expr ret) (append (utf8 " : ") (show_expr other))))))))))))))))
    (nil (EErr (sym "bad_shape") (utf8 "(match TERM (PATTERN BODY)…)")))))
;; ---- a literal match ------------------------------------------------------------------------
;; (match T (K BODY)… (CATCH BODY)) with numeral rows, at Nat or Int: Lean's value patterns —
;; the scrutinee once, then `if (= x K) BODY …` in row order, the last row `_` or a name for
;; the scrutinee. No matcher: the rows are the `ite`s on the type's decision, read as any
;; `if` is. A numeral under a constructor stays el_pat's refusal. The classifier reads the same
;; rows the same way (classify.shard read_ematch_lit; scope.shard has_numeral_row, lit_scrut)
(fn lit_chain ((arms (List SExpr))) (Option SExpr)
  (measure (struct arms))
  (match arms
    ((cons (SList (cons (SSym v) (cons body nil))) nil)
     (if (sym_eq v (sym "_")) (some body)
     (some
       (SList
         (list (SSym (sym "let")) (SList (list (SList (list (SSym v) (SSym (lit_scrut)))))) body)))))
    ((cons (SList (cons (SNum k) (cons body nil))) r)
     (match (lit_chain r)
       (none none)
       ((some rest)
        (some
          (SList
            (list (SSym (sym "if")) (SList (list (SSym (sym "=")) (SSym (lit_scrut)) (SNum k))) body
              rest))))))
    (_ none)))
(fn all_numeral_rows ((arms (List SExpr))) Bool
  (measure (struct arms))
  (match arms
    (nil true)
    ((cons (SList (cons (SNum _) (cons _ nil))) r) (all_numeral_rows r))
    (_ false)))
(fn elab_match_lit ((e El) (scrut SExpr) (arms (List SExpr)) (expected (Option Expr))) ERes
  (match (lit_chain arms)
    (none
      (if (all_numeral_rows arms)
        (EErr (sym "match_not_exhaustive")
          (utf8 "numeral rows cover no type: close the match with a `_` row or a name"))
        (EErr (sym "literal_rows")
          (utf8
            "a literal match is numeral rows closed by one last row, `_` or a name: no constructor row beside them, no row after the catch-all"))))
    ((some chain)
     (match (elab e scrut none)
       ((EErr r m) (EErr r m))
       ((EOk e1 sv sty)
        (match (el_finish e1 sty)
          ((FinErr r m)
           (EErr (sym "match_scrutinee")
             (append (utf8 "the scrutinee's type is not determined: ") m)))
          ((FinOk dty)
           (match (el_whnf e1 dty)
             ((Prod.mk e2 dtyw)
              (if
                (bool_not (bool_or (is_const_named dtyw (nm_nat)) (is_const_named dtyw (nm_int_ty))))
                (EErr (sym "pattern_type")
                  (append (utf8 "a numeral row matches a value of type ")
                    (append (show_expr dtyw) (utf8 ": literal rows are read at Nat and Int"))))
                (match (el_finish e2 sv)
                  ((FinErr r m) (EErr r m))
                  ((FinOk sv1)
                   (match (name_of_sym (lit_scrut))
                     (none (EErr (sym "bad_name") (chars_of_sym (lit_scrut))))
                     ((some x)
                      (match sv1
                        ;; a local scrutinee is its own name in the conditions; anything else is bound once
                        ((FVar _ _)
                         (match (elab (el_set_cx e2 (cx_bind (el_cx e2) x sv1)) chain expected)
                           ((EErr r m) (EErr r m))
                           ((EOk e3 b bty) (EOk (el_restore e3 e) b bty))))
                        (_
                          (match (el_local_val e2 x dty sv1)
                            ((Prod.mk e3 fv) (let_close e fv sv1 (elab e3 chain expected))))))))))))))))))))
;; the expected type, when nothing in it is still to be solved
(fn match_ret ((e El) (expected (Option Expr))) (Option Expr)
  (match expected
    (none none)
    ((some x)
     (match (el_finish e x)
       ((FinOk r) (some r))
       ((FinErr _ _) none)))))
;; one reading of the match. With `deps` — the locals in scope whose types mention the scrutinee,
;; outermost first (Lean's revert) — the motive is the expected type under a Pi
;; over them, each arm reads its body with them re-bound at the pattern's type, and the matcher's
;; result is applied back to them; so under `match xs` with `i : Fin (List.length xs)` the nil row
;; sees `i : Fin (List.length List.nil)` and refutes it. Without deps the motive is over the
;; scrutinee alone (`gen`), or constant
(fn match_try
  ((e El)
   (dty Expr)
   (ret Expr)
   (l Level)
   (sv Expr)
   (deps (List (Prod Name Expr)))
   (gen (Option Int))
   (arms (List SExpr))
   (expected (Option Expr)))
  ERes
  (match deps
    (nil (match_arms e dty ret l sv gen nil arms nil nil expected))
    (_
      (match (el_pis e (bound_fvars deps) ret)
        ((Prod.mk e1 ret2)
         (match (el_infer e1 ret2)
           ((Prod.mk _ none) (EErr (sym "not_a_type") (show_expr ret2)))
           ((Prod.mk e2 (some rs2))
            (match (el_whnf e2 rs2)
              ((Prod.mk e3 (Sort _ l2))
               (match (match_arms e3 dty ret2 l2 sv gen (bound_names deps) arms nil nil none)
                 ((EErr r m) (EErr r m))
                 ((EOk e4 v _) (check_expected e4 (mk_app_n v (bound_fvars deps)) ret expected))))
              ((Prod.mk _ other)
               (EErr (sym "not_a_type")
                 (append (show_expr ret2) (append (utf8 " : ") (show_expr other)))))))))))))
;; the locals in scope whose types mention the scrutinee, or one of these (transitively), outermost
;; first, each under the name the context binds it by (a realize's telescope local carries Lean's
;; binder name; the body knows it by the signature's)
(fn match_deps ((e El) (id Int)) (List (Prod Name Expr))
  (deps_among e (rev (cx_bound (el_cx e))) (list id)))
(fn deps_among ((e El) (bs (List (Prod Name Expr))) (ids (List Int))) (List (Prod Name Expr))
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (Prod.mk n fv) r)
     (if (mem_int (fvar_id_of fv) ids) (deps_among e r ids)
     (let
       ((dep Bool
          (match (w_local_type (el_w e) (fvar_id_of fv))
            ((some t) (ids_meet ids (expr_fvars (el_zonk e t) nil)))
            (none false))))
       (if dep (cons (Prod.mk n fv) (deps_among e r (cons (fvar_id_of fv) ids)))
       (deps_among e r ids)))))))
(fn bound_names ((bs (List (Prod Name Expr)))) (List Name)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (Prod.mk n _) r) (cons n (bound_names r)))))
(fn ids_meet ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (mem_int x ys) true (ids_meet r ys)))))
;; an arm's result type under the generalized locals: one Pi binder per name opened as a local under it
(fn match_peel ((e El) (ty Expr) (names (List Name)) (acc (List Expr)))
  (Prod El (Prod (List Expr) Expr))
  (measure (struct names))
  (match names
    (nil (Prod.mk e (Prod.mk (rev acc) ty)))
    ((cons n r)
     (match ty
       ((Pi _ _ bi dom body)
        (match (el_local e n dom bi)
          ((Prod.mk e1 fv)
           (match (w_inst1 (el_w e1) body fv)
             ((Prod.mk w2 b2) (match_peel (el_set_w e1 w2) b2 r (cons fv acc)))))))
       (_ (Prod.mk e (Prod.mk (rev acc) ty)))))))
;; the local the motive generalizes: the scrutinee, when it is a local the expected type mentions
(fn match_gen ((sv Expr) (ret Expr)) (Option Int)
  (match sv
    ((FVar _ id) (if (mem_int id (expr_fvars ret nil)) (some id) none))
    (_ none)))
;; the expected type with a term for the generalized local
(fn match_ret_at ((e El) (ret Expr) (gen (Option Int)) (v Expr)) (Prod El Expr)
  (match gen
    (none (Prod.mk e ret))
    ((some id)
     (match (w_subst (el_w e) ret id v)
       ((Prod.mk w1 r) (Prod.mk (el_set_w e w1) r))))))
(fn match_arms
  ((e El)
   (dty Expr)
   (ret Expr)
   (l Level)
   (sv Expr)
   (gen (Option Int))
   (dnames (List Name))
   (arms (List SExpr))
   (rows (List (List MtPat)))
   (alts (List Expr))
   (expected (Option Expr)))
  ERes
  (measure (struct arms))
  (match arms
    (nil (match_close e dty ret l sv gen (rev rows) (rev alts) expected))
    ((cons (SList (cons pat (cons body nil))) r)
     (match (el_pat e pat dty 0 nil 256)
       ((PtErr x m) (EErr x m))
       ((PtOk e1 mp pt _ vars)
        (match (match_ret_at e1 ret gen pt)
          ((Prod.mk e1a ret1)
           (match (match_peel e1a ret1 dnames nil)
             ((Prod.mk e1b (Prod.mk dvars ret1b))
              (match (elab e1b body (some ret1b))
                ((EErr x m) (EErr x m))
                ((EOk e2 v _)
                 (match (el_lams e2 (append vars dvars) v)
                   ((Prod.mk e3 alt)
                    (match_arms (el_restore e3 e) dty ret l sv gen dnames r (cons (list mp) rows)
                      (cons alt alts)
                      expected))))))))))))
    (_ (EErr (sym "bad_shape") (utf8 "a match arm is (PATTERN BODY)")))))
(fn match_close
  ((e El)
   (dty Expr)
   (ret Expr)
   (l Level)
   (sv Expr)
   (gen (Option Int))
   (rows (List (List MtPat)))
   (alts (List Expr))
   (expected (Option Expr)))
  ERes
  (match (match_params e dty)
    (none
      (EErr (sym "match_scope")
        (utf8 "the scrutinee's type mentions a local that is not a binder in scope")))
    ((some params)
     (let ((name (mt_name (el_owner e) (el_next_matcher e))) (lps (cx_lps (el_cx e))))
       (let ((v (mt_level_name lps)))
         (match (mt_generate (el_w e) name lps v params (list dty) rows)
           ((MtGenErr x m) (EErr x m))
           ((MtGenOk _ decl)
            (match (w_admit (el_w e) decl)
              ((Prod.mk _ (some why))
               (EErr (sym "matcher_refused")
                 (append (show_name name)
                   (append (utf8 ": K refused the generated matcher (")
                     (append (chars_of_sym why) (utf8 ")"))))))
              ((Prod.mk w1 none)
               (match (w_local w1 (n1 (sym "d")) dty)
                 ((Prod.mk w2 d)
                  (match (match_ret_at (el_set_w e w2) ret gen d)
                    ((Prod.mk e2 retd)
                     (match (w_lams (el_w e2) (list d) retd)
                       ((Prod.mk w3 motive)
                        (check_expected (el_add_aux (el_set_w e w3) decl)
                          (mk_app_n (mk_const name (cons l (lparam_levels lps)))
                            (append params (append (list motive (el_zonk e sv)) alts)))
                          ret
                          expected))))))))))))))))
(fn lparam_levels ((lps (List Name))) (List Level)
  (measure (struct lps))
  (match lps
    (nil nil)
    ((cons u r) (cons (LParam u) (lparam_levels r)))))
;; the binders in scope the type mentions, with those their types mention, outermost first
(fn match_params ((e El) (dty Expr)) (Option (List Expr))
  (let ((ids (fvar_closure e (expr_fvars dty nil) nil 256)) (bound (cx_fvar_ids (el_cx e))))
    (if (all_in ids bound) (some (fvars_among (rev (bound_fvars (cx_bound (el_cx e)))) ids)) none)))
(fn fvar_closure ((e El) (todo (List Int)) (seen (List Int)) (fuel Int)) (List Int)
  (measure fuel)
  (if (< fuel 1) seen
  (match todo
    (nil seen)
    ((cons id r)
     (if (mem_int id seen) (fvar_closure e r seen (- fuel 1))
     (fvar_closure e
       (append
         (match (w_local_type (el_w e) id)
           ((some t) (expr_fvars (el_zonk e t) nil))
           (none nil))
         r)
       (cons id seen)
       (- fuel 1)))))))
(fn bound_fvars ((bs (List (Prod Name Expr)))) (List Expr)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (Prod.mk _ fv) r) (cons fv (bound_fvars r)))))
(fn fvars_among ((fvs (List Expr)) (ids (List Int))) (List Expr)
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r)
     (if (mem_int (fvar_id_of fv) ids)
       (cons fv (fvars_among r (remove_ints ids (list (fvar_id_of fv)))))
       (fvars_among r ids)))))

;; a match whose rows all read is refused where a row that matches every value has rows
;; after it: those can never be taken, and a constructor's name that resolved to nothing is
;; read as such a row
(fn match_live ((e El) (ty Expr) (arms (List SExpr)) (r ERes)) ERes
  (match r
    ((EOk _ _ _)
     (match (dead_row e ty arms)
       ((some m) (EErr (sym "unreachable_arm") m))
       (none r)))
    (_ r)))
(fn dead_row ((e El) (ty Expr) (arms (List SExpr))) (Option (List Int))
  (measure (struct arms))
  (match arms
    ((cons (SList (cons pat _)) (cons a r))
     (match (catch_all_before e pat ty (+ 1 (len r)))
       ((some m) (some m))
       (none (dead_row e ty (cons a r)))))
    (_ none)))
;; the refusal's text for a row that matches every value, `after` rows following it
(fn catch_all_before ((e El) (pat SExpr) (ty Expr) (after Int)) (Option (List Int))
  (match pat
    ((SSym x)
     (if (sym_eq x (sym "_"))
       (some
         (append (utf8 "the row _ matches every value, so the ")
           (append (show_nat after)
             (utf8 " row(s) after it can never be taken: a catch-all is the last row"))))
       (match (name_of_sym x)
         (none none)
         ((some n)
          (match (pat_ctor e n ty)
            ((some (Prod.mk _ (Prod.mk 0 _))) none)
            ((some (Prod.mk c (Prod.mk k _)))
             (some
               (append (utf8 "the row ")
                 (append (chars_of_sym x)
                   (append (utf8 " binds a variable and matches every value, so the ")
                     (append (show_nat after)
                       (append (utf8 " row(s) after it can never be taken: ")
                         (append (show_name c)
                           (append (utf8 " has ")
                             (append (show_nat k)
                               (append (utf8 " field(s) — write (")
                                 (append (chars_of_sym x) (utf8 " NAME…)")))))))))))))
            (none
              (some
                (append (utf8 "the row ")
                  (append (chars_of_sym x)
                    (append (utf8 " binds a variable and matches every value, so the ")
                      (append (show_nat after)
                        (append (utf8 " row(s) after it can never be taken: no constructor of ")
                          (append (show_expr (el_zonk e ty))
                            (append (utf8 " named ")
                              (append (chars_of_sym x)
                                (utf8
                                  " is in scope — write the constructor as its type spells it, or make a catch-all the last row"))))))))))))))))
    (_ none)))
;; a pattern at its type: `_`, a name — the constructor of the type's inductive it names when
;; that constructor has no fields, else a variable bound for the body —, or a constructor on
;; its fields' patterns. The state with the variables bound, the pattern, its term, the next
;; slot, the variables' locals in slot order
(type PtRes (PtOk El MtPat Expr Int (List Expr)) (PtErr Symbol (List Int)))
(fn el_pat ((e El) (s SExpr) (ty Expr) (slot Int) (vars (List Expr)) (fuel Int)) PtRes
  (measure fuel)
  (if (< fuel 1) (PtErr (sym "match_depth") (utf8 "a pattern too deep"))
  (match s
    ((SSym x)
     (if (sym_eq x (sym "_"))
       ;; bound under a name no source spells: a term a later metavariable takes may mention it
       ;; (a refined row's type does: `(TNum _)` at a type that mentions the scrutinee)
       (match (el_local e (n1 (sym_of_chars (utf8 "_ wildcard"))) ty BDefault)
         ((Prod.mk e1 fv) (PtOk e1 (MtVar slot) fv (+ slot 1) (append vars (list fv)))))
       (match (name_of_sym x)
         (none (PtErr (sym "bad_name") (chars_of_sym x)))
         ((some n)
          (match (pat_ctor e n ty)
            ((some (Prod.mk c (Prod.mk 0 head))) (PtOk e (MtCtor c nil) head slot vars))
            (_
              (match (el_local e n ty BDefault)
                ((Prod.mk e1 fv) (PtOk e1 (MtVar slot) fv (+ slot 1) (append vars (list fv)))))))))))
    ((SList (cons (SSym h) subs))
     (if (sym_eq h (sym "quote"))
       (PtErr (sym "no_quote") (utf8 "a symbol is written (sym \"x\"): there is no quote form"))
       (match (name_of_sym h)
         (none (PtErr (sym "bad_name") (chars_of_sym h)))
         ((some n)
          (match (pat_ctor_type e n ty)
            (none
              (PtErr (sym "pattern_constructor")
                (append (show_name n)
                  (append (utf8 " is not a constructor of ") (show_expr (el_zonk e ty))))))
            ((some (Prod.mk c (Prod.mk (Prod.mk cty nfields) head)))
             (if (bool_not (= (len subs) nfields))
               (PtErr (sym "pattern_arity")
                 (append (show_name c)
                   (append (utf8 " has ") (append (show_nat nfields) (utf8 " fields")))))
               (el_pat_fields e subs cty c head nil slot vars (- fuel 1)))))))))
    ((SNum _)
     (PtErr (sym "literal_pattern")
       (utf8
         "a numeral under a constructor or beside constructor rows has no L form: bind the field and compare with an if (a row that is a numeral is read)")))
    (_ (PtErr (sym "literal_pattern") (utf8 "a string pattern has no L form: compare with an if"))))))
(fn el_pat_fields
  ((e El)
   (subs (List SExpr))
   (cty Expr)
   (c Name)
   (acc Expr)
   (ps (List MtPat))
   (slot Int)
   (vars (List Expr))
   (fuel Int))
  PtRes
  (measure (struct subs))
  (match subs
    (nil (PtOk e (MtCtor c (rev ps)) acc slot vars))
    ((cons p r)
     (match cty
       ((Pi _ _ _ dom body)
        (match (el_pat e p dom slot vars fuel)
          ((PtErr x m) (PtErr x m))
          ((PtOk e1 mp t slot1 vars1)
           (match (w_inst1 (el_w e1) body t)
             ((Prod.mk w2 b)
              (el_pat_fields (el_set_w e1 w2) r b c (mk_app acc t) (cons mp ps) slot1 vars1 fuel))))))
       (_ (PtErr (sym "pattern_arity") (show_name c)))))))
;; the constructor a pattern head names at this type: its identity, its fields' telescope at
;; the type's levels and parameters with their number, and the constructor applied to the parameters
(fn pat_ctor_type ((e El) (n Name) (ty Expr)) (Option (Prod Name (Prod (Prod Expr Int) Expr)))
  (match (mt_ind_of (el_w e) (el_zonk e ty))
    ((Prod.mk _ (MtNoInd _ _)) none)
    ((Prod.mk w1 (MtInd ind ls params _))
     (match (resolve_ctor (el_cx e) n ind)
       (none none)
       ((some c)
        (match (mt_ctor_type w1 c ls params)
          ((Prod.mk _ none) none)
          ((Prod.mk _ (some tn)) (some (Prod.mk c (Prod.mk tn (mk_app_n (mk_const c ls) params)))))))))))
(fn pat_ctor ((e El) (n Name) (ty Expr)) (Option (Prod Name (Prod Int Expr)))
  (match (pat_ctor_type e n ty)
    ((some (Prod.mk c (Prod.mk (Prod.mk _ nfields) head)))
     (some (Prod.mk c (Prod.mk nfields head))))
    (none none)))

;; (exists ((x TYPE)) P): Exists (fun (x : TYPE) => P)
(fn elab_exists ((e El) (args (List SExpr)) (expected (Option Expr))) ERes
  (match (elab_binding e args true none)
    ((EErr r m) (EErr r m))
    ((EOk e1 lam lty) (op_apply e1 (n1 (sym "Exists")) (list (AVal lam lty)) expected))))

;; the constants the elaborator constructs by name: the loader fetches them for every module
(fn el_kit () (List Name)
  (list (nm_eq) (n1 (sym "Decidable")) (n2 (sym "Decidable") (sym "decide"))
    (n1 (sym "instDecidableEqBool"))
    (n1 (sym "dite"))
    (n1 (sym "ite"))
    (n1 (sym "Not"))
    (n1 (sym "And"))
    (n1 (sym "Or"))
    (n1 (sym "Iff"))
    (n1 (sym "Ne"))
    (n1 (sym "Exists"))
    (nm_bool)
    (n2 (sym "Bool") (sym "true"))
    (n2 (sym "Bool") (sym "and"))
    (n2 (sym "Bool") (sym "or"))
    (n2 (sym "Bool") (sym "not"))
    (n2 (sym "Int") (sym "decEq"))
    (n2 (sym "Int") (sym "le"))
    (n2 (sym "Int") (sym "lt"))
    (n2 (sym "Nat") (sym "decEq"))
    (n2 (sym "Nat") (sym "le"))
    (n2 (sym "Nat") (sym "lt"))
    (nm_int_of_nat)
    (nm_nat)
    (nm_string)
    (n1 (sym "Int"))))
