;;; v3/kernel/ev.shard — `ev`, the definition of "run" (v3/LANGUAGE.md §6.2,
;;; §6.7; FOUNDATION §4.4), `run_prog`, the effectful driver with the
;;; checked entry of §9 (slice 7), and the prepared handle both stand on
;;; (slice 4.6). Phase 2, slice 5.
;;;
;;; `ev : Prog → Name → List Val → Int → EvRes` is pure: a Prog is linked
;;; into this file's own representation — constructors as integer tags
;;; whose low bit says "second constructor of its type" (§6.2's `if` rule
;;; is one bit test), functions and externs as indices, primitives as
;;; operation codes (prog.shard's table), literals built once — and run as
;;; a machine with an explicit continuation: two tail-recursive steps,
;;; `ev_term` (a term in a frame under a continuation) and `ev_ret` (a
;;; value to a continuation), so the host's stack does not grow with the
;;; program's recursion and the machine can stop at an extern with its
;;; arguments and continuation in hand. Fuel is spent on function entry.
;;; No function of the machine takes more than six parameters: compiled
;;; through C, a call in tail position is a jump only where the callee's
;;; arguments fit where the caller's came in — in registers, six of them.
;;; With functions of seven and nine among them the compiled machine took
;;; host stack at every application, from one extern to the next: 2.5 GB
;;; on K's nested_test, 12 MB with six (measured 2026-11-10,
;;; docs/records/REDUCE-2026-11-10.md).
;;; `run_prog` performs each extern through the host's own extern of the
;;; same short name (kernel/host.shard's six) and resumes: §6.2's frontier
;;; loop without a search. No other file sees the linked representation.
;;; Linking happens in one place, `prepare` (§8.6 slice 4.6 rule 1; law
;;; §9.3): a program linked once and one entry bound as a handle, which
;;; `invoke` runs on arguments built as data as often as the client likes —
;;; validated against the entry's E types at the checked door, taken on the
;;; caller's word at the assumed one. `ev` and `run_prog` are one
;;; preparation and one invocation each. What a program does not state of
;;; an entry — an evidence binder, a constructor's proposition field — is
;;; read where the environment is held: session.shard's door (rule 2).
;;; A primitive's outcome is three-valued (GPT-6 R51, 2026-09-13): a value, a
;;; GUARD failure (the input outside the operation's domain: a negative Nat, a
;;; zero divisor) or an EXHAUSTED resource (K's literal limits, `nat_size` and
;;; `nat_count`, checked BEFORE the work as tc.shard's `nat_apply` checks them)
;;; — distinct through `EvRes` (`EvStuck` against `EvExhausted`) and the
;;; driver, since a result past a limit says nothing about the input's validity.

(import "host.shard")
(import "prog.shard")
(import "intmap.shard")
(use kernel.host)
(use kernel.intmap)
(use kernel.name)
(use kernel.prelude)
(use kernel.prog)
(use kernel.util)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.EvRes)
(use kernel.prog.Prim)
(use kernel.prog.Prog)
(use kernel.prog.Val)

;; ---- the linked representation ---------------------------------------------------------
(type IVal (IVCtor Int (List IVal)) (IVInt Int) (IVSym Symbol))
(type LPat (LPVar) (LPCtor Int (List LPat)) (LPInt Int) (LPSym Symbol))
(type LTerm
  (LBVar Int)
  (LLit IVal)
  (LCtor Int (List LTerm))
  (LCall Int (List LTerm))
  (LPrim Int (List LTerm))
  (LExt Int (List LTerm))
  (LMatch LTerm (List LArm))
  (LLet (List LTerm) LTerm)
  (LIf LTerm LTerm LTerm)
  (LAbsurd))                    ; a refuted row: reached only by a program K did not warrant
(type LArm (LArm LPat LTerm))
(type LFn
  (LBody Name Int LTerm)       ; a function: identity, parameter count, body
  (LExtern Name Symbol Int (List EType) EType)    ; an extern: identity, its short name (the host's), parameter count, the declared types (the wire's codec reads them)
  (LUnlinked Name))            ; a sig fn no implementation was linked to
;; the wire's tags: nil cons none some pair false true — and, for the table's Nat set
;; (§7.5), Init's Bool.false Bool.true and Decidable.isFalse Decidable.isTrue
(type Wire (Wire Int Int Int Int Int Int Int Int Int Int Int))
(fn wire_nil ((w Wire)) Int (match w ((Wire a _ _ _ _ _ _ _ _ _ _) a)))
(fn wire_cons ((w Wire)) Int (match w ((Wire _ a _ _ _ _ _ _ _ _ _) a)))
(fn wire_none ((w Wire)) Int (match w ((Wire _ _ a _ _ _ _ _ _ _ _) a)))
(fn wire_some ((w Wire)) Int (match w ((Wire _ _ _ a _ _ _ _ _ _ _) a)))
(fn wire_pair ((w Wire)) Int (match w ((Wire _ _ _ _ a _ _ _ _ _ _) a)))
(fn wire_false ((w Wire)) Int (match w ((Wire _ _ _ _ _ a _ _ _ _ _) a)))
(fn wire_true ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ a _ _ _ _) a)))
(fn wire_bfalse ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ a _ _ _) a)))
(fn wire_btrue ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ a _ _) a)))
(fn wire_dfalse ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ _ a _) a)))
(fn wire_dtrue ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ _ _ a) a)))
;; functions by index, constructor tags by identity, identities by tag, function indices by identity, the wire
(type Linked (Linked (IntMap LFn) (IntMap (List (Pair Name Int))) (IntMap Name) (IntMap (List (Pair Name Int))) Wire))
(fn lk_fns ((l Linked)) (IntMap LFn) (match l ((Linked f _ _ _ _) f)))
(fn lk_tags ((l Linked)) (IntMap (List (Pair Name Int))) (match l ((Linked _ t _ _ _) t)))
(fn lk_names ((l Linked)) (IntMap Name) (match l ((Linked _ _ n _ _) n)))
(fn lk_ids ((l Linked)) (IntMap (List (Pair Name Int))) (match l ((Linked _ _ _ i _) i)))
(fn lk_wire ((l Linked)) Wire (match l ((Linked _ _ _ _ w) w)))

;; a name-keyed map of ints (the environment's key, collisions by list)
(fn nmap_find ((m (IntMap (List (Pair Name Int)))) (n Name)) (Option Int)
  (match (im_find m (name_key n)) (None None) ((Some b) (assoc_int b n))))
(fn assoc_int ((b (List (Pair Name Int))) (n Name)) (Option Int)
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair k v) r) (if (name_eq k n) (Some v) (assoc_int r n)))))
(fn nmap_add ((m (IntMap (List (Pair Name Int)))) (n Name) (v Int)) (IntMap (List (Pair Name Int)))
  (let ((h (name_key n)))
    (im_insert m h (Cons (Pair n v) (match (im_find m h) ((Some b) b) (None Nil))))))
(fn fn_name ((lk Linked) (id Int)) Name
  (match (im_find (lk_fns lk) id)
    ((Some (LBody n _ _)) n)
    ((Some (LExtern n _ _ _ _)) n)
    ((Some (LUnlinked n)) n)
    (None Anon)))
(fn last_sym ((n Name)) Symbol (match n ((Str _ s) s) (_ (quote anon))))

;; ---- linking ----------------------------------------------------------------------------
(type LinkRes (LkOk Linked) (LkErr Symbol (List Int)))
;; constructor tags: 2k for the k-th constructor interned, plus one when it is the second of its type
(type Tags (Tags Int (IntMap (List (Pair Name Int))) (IntMap Name)))
(fn tag_of ((k Int) (ordinal Int)) Int (+ (* 2 k) (if (= ordinal 1) 1 0)))
(fn intern_ctor ((t Tags) (c Name) (ordinal Int)) Tags
  (match t
    ((Tags k n2t t2n)
     (let ((tag (tag_of k ordinal)))
       (Tags (+ k 1) (nmap_add n2t c tag) (im_insert t2n tag c))))))
(fn intern_ctors ((t Tags) (cs (List ECtorDef)) (i Int)) Tags
  (measure (struct cs))
  (match cs (Nil t) ((Cons (ECtorDef c _) r) (intern_ctors (intern_ctor t c i) r (+ i 1)))))
(fn intern_decls ((t Tags) (ds (List EDecl))) Tags
  (measure (struct ds))
  (match ds
    (Nil t)
    ((Cons (EInd _ _ cs) r) (intern_decls (intern_ctors t cs 0) r))
    ((Cons _ r) (intern_decls t r))))
;; a wire name the program lacks is interned with its ordinal
(fn intern_wire ((t Tags) (c Name) (ordinal Int)) (Pair Tags Int)
  (match t
    ((Tags _ n2t _)
     (match (nmap_find n2t c)
       ((Some tag) (Pair t tag))
       (None (match (intern_ctor t c ordinal) ((Tags k2 nt2 t2) (Pair (Tags k2 nt2 t2) (tag_of (- k2 1) ordinal)))))))))
;; Init's cells, which the wire builds for a program under the naming law (§6.7; §8.4 slice
;; 3.18 rule 4) and a string literal is made of: interned like the prelude's, found by name
(fn init_nil () Name (n2 (quote List) (quote nil)))
(fn init_cons () Name (n2 (quote List) (quote cons)))
(fn init_none () Name (n2 (quote Option) (quote none)))
(fn init_some () Name (n2 (quote Option) (quote some)))
(fn init_prod_mk () Name (n2 (quote Prod) (quote mk)))
(fn intern_init ((t Tags)) Tags
  (intern_each t (list (Pair (init_nil) 0) (Pair (init_cons) 1) (Pair (init_none) 0) (Pair (init_some) 1) (Pair (init_prod_mk) 0))))
(fn intern_each ((t Tags) (cs (List (Pair Name Int)))) Tags
  (measure (struct cs))
  (match cs (Nil t) ((Cons (Pair c o) r) (match (intern_wire t c o) ((Pair t1 _) (intern_each t1 r))))))
(fn wire_of ((t0 Tags)) (Pair Tags Wire)
  (match (intern_wire (intern_init t0) (prelude_nil) 0)
    ((Pair t1 nl)
     (match (intern_wire t1 (prelude_cons) 1)
       ((Pair t2 cs)
        (match (intern_wire t2 (prelude_none) 0)
          ((Pair t3 nn)
           (match (intern_wire t3 (prelude_some) 1)
             ((Pair t4 sm)
              (match (intern_wire t4 (prelude_mk_pair) 0)
                ((Pair t5 pr)
                 (match (intern_wire t5 (prelude_false) 0)
                   ((Pair t6 fl)
                    (match (intern_wire t6 (prelude_true) 1)
                      ((Pair t7 tr)
                       (match (intern_wire t7 (n2 (quote Bool) (quote false)) 0)
                         ((Pair t8 bf)
                          (match (intern_wire t8 (n2 (quote Bool) (quote true)) 1)
                            ((Pair t9 bt)
                             (match (intern_wire t9 (n2 (quote Decidable) (quote isFalse)) 0)
                               ((Pair t10 df)
                                (match (intern_wire t10 (n2 (quote Decidable) (quote isTrue)) 1)
                                  ((Pair t11 dt) (Pair t11 (Wire nl cs nn sm pr fl tr bf bt df dt)))))))))))))))))))))))))
;; function indices
(fn index_fns ((ds (List EDecl)) (j Int) (ids (IntMap (List (Pair Name Int))))) (IntMap (List (Pair Name Int)))
  (measure (struct ds))
  (match ds
    (Nil ids)
    ((Cons (EFn n _ _ _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons (ESig n _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons (EExtern n _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons _ r) (index_fns r j ids))))

(fn link ((p Prog)) LinkRes
  (match p
    ((Prog ds)
     (match (wire_of (intern_decls (Tags 0 IMEmpty IMEmpty) ds))
       ((Pair (Tags _ n2t t2n) wire)
        (let ((ids (index_fns ds 0 IMEmpty)))
          (let ((lk (Linked IMEmpty n2t t2n ids wire)))
            (match (lower_decls lk ds IMEmpty)
              ((Pair (Some (Pair e m)) _) (LkErr e m))
              ((Pair None fns) (LkOk (Linked fns n2t t2n ids wire)))))))))))
(fn lower_decls ((lk Linked) (ds (List EDecl)) (fns (IntMap LFn))) (Pair (Option (Pair Symbol (List Int))) (IntMap LFn))
  (measure (struct ds))
  (match ds
    (Nil (Pair None fns))
    ((Cons (EFn n _ ps _ _ body) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id)
        (match (lower lk body)
          ((Pair (Some (Pair e m)) _) (Pair (Some (Pair e m)) fns))
          ((Pair None t) (lower_decls lk r (im_insert fns id (LBody n (len ps) t))))))))
    ((Cons (ESig n _ _ _) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id) (lower_decls lk r (im_insert fns id (LUnlinked n))))))
    ((Cons (EExtern n _ ps rt) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id) (lower_decls lk r (im_insert fns id (LExtern n (last_sym n) (len ps) ps rt))))))
    ((Cons _ r) (lower_decls lk r fns))))
;; a term into the linked representation
(fn lower ((lk Linked) (t ETerm)) (Pair (Option (Pair Symbol (List Int))) LTerm)
  (measure (struct t))
  (match t
    ((EBVar i) (Pair None (LBVar i)))
    ((ELit l) (Pair None (LLit (lit_val lk l))))
    ((ECtor c args)
     (match (nmap_find (lk_tags lk) c)
       (None (Pair (Some (Pair (quote unresolved) (show_name c))) (LBVar 0)))
       ((Some tag) (lower_args lk args (LCtor tag Nil) 0 tag))))
    ((ECall f args)
     (match (nmap_find (lk_ids lk) f)
       (None (Pair (Some (Pair (quote unresolved) (show_name f))) (LBVar 0)))
       ((Some id) (lower_args lk args (LCall id Nil) 1 id))))
    ((EPrim n args)
     (match (prim_find n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) (LBVar 0)))
       ((Some (Prim code _)) (lower_args lk args (LPrim code Nil) 2 code))))
    ((EExt f args)
     (match (nmap_find (lk_ids lk) f)
       (None (Pair (Some (Pair (quote unresolved) (show_name f))) (LBVar 0)))
       ((Some id) (lower_args lk args (LExt id Nil) 3 id))))
    ((EMatch s arms)
     (match (lower lk s)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None ls)
        (match (lower_arms lk arms Nil)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None las) (Pair None (LMatch ls las)))))))
    ((ELet rs b)
     (match (lower_list lk rs Nil)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None lrs)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None lb) (Pair None (LLet lrs lb)))))))
    ((EIf a b c)
     (match (lower lk a)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None la)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None lb)
           (match (lower lk c)
             ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
             ((Pair None lc) (Pair None (LIf la lb lc)))))))))
    (EAbsurd (Pair None LAbsurd))))
;; the head's node over its lowered arguments (kind 0 ctor, 1 call, 2 prim, 3 ext)
(fn lower_args ((lk Linked) (args (List ETerm)) (empty LTerm) (kind Int) (head Int)) (Pair (Option (Pair Symbol (List Int))) LTerm)
  (match (lower_list lk args Nil)
    ((Pair (Some e) _) (Pair (Some e) empty))
    ((Pair None las)
     (Pair None (if (= kind 0) (LCtor head las) (if (= kind 1) (LCall head las) (if (= kind 2) (LPrim head las) (LExt head las))))))))
(fn lower_list ((lk Linked) (ts (List ETerm)) (acc (List LTerm))) (Pair (Option (Pair Symbol (List Int))) (List LTerm))
  (measure (struct ts))
  (match ts
    (Nil (Pair None (rev acc)))
    ((Cons t r)
     (match (lower lk t)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lt) (lower_list lk r (Cons lt acc)))))))
(fn lower_arms ((lk Linked) (arms (List EArm)) (acc (List LArm))) (Pair (Option (Pair Symbol (List Int))) (List LArm))
  (measure (struct arms))
  (match arms
    (Nil (Pair None (rev acc)))
    ((Cons (EArm p b) r)
     (match (lower_pat lk p)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lp)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) Nil))
          ((Pair None lb) (lower_arms lk r (Cons (LArm lp lb) acc)))))))))
(fn lower_pat ((lk Linked) (p EPat)) (Pair (Option (Pair Symbol (List Int))) LPat)
  (measure (struct p))
  (match p
    (PVar (Pair None LPVar))
    ((PLit (LNat k)) (Pair None (LPInt k)))
    ((PLit (LInt k)) (Pair None (LPInt k)))
    ((PLit (LSym s)) (Pair None (LPSym s)))
    ((PLit (LStr _ _ _)) (Pair (Some (Pair (quote pattern_literal) "a string pattern")) LPVar))
    ((PCtor c subs)
     (match (nmap_find (lk_tags lk) c)
       (None (Pair (Some (Pair (quote unresolved) (show_name c))) LPVar))
       ((Some tag)
        (match (lower_pats lk subs Nil)
          ((Pair (Some e) _) (Pair (Some e) LPVar))
          ((Pair None lps) (Pair None (LPCtor tag lps)))))))))
(fn lower_pats ((lk Linked) (ps (List EPat)) (acc (List LPat))) (Pair (Option (Pair Symbol (List Int))) (List LPat))
  (measure (struct ps))
  (match ps
    (Nil (Pair None (rev acc)))
    ((Cons p r)
     (match (lower_pat lk p)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lp) (lower_pats lk r (Cons lp acc)))))))
(fn lit_val ((lk Linked) (l ELit)) IVal
  (match l
    ((LNat k) (IVInt k))
    ((LInt k) (IVInt k))
    ((LStr nl cs bs)   ; the cells the literal names: Init's List for a String (§8.4 slice 3.18 rule 3), the List in scope's in the toolchain's sources (§8.1 rule 2)
     (match (nmap_find (lk_tags lk) nl)
       (None (bytes_in lk bs))
       ((Some tnl) (match (nmap_find (lk_tags lk) cs) (None (bytes_in lk bs)) ((Some tcs) (cells_in tnl tcs bs))))))
    ((LSym s) (IVSym s))))

;; ---- the primitives' cells: the prelude's (§6.7); the externs' are read by declared type, below ----
(fn bytes_in ((lk Linked) (bs (List Int))) IVal
  (measure (struct bs))
  (match bs
    (Nil (IVCtor (wire_nil (lk_wire lk)) Nil))
    ((Cons b r) (IVCtor (wire_cons (lk_wire lk)) (list (IVInt b) (bytes_in lk r))))))
;; a Cons chain of Int cells back to bytes; None when the value is not one
(fn bytes_out ((lk Linked) (v IVal) (acc (List Int)) (fuel Int)) (Option (List Int))
  (cells_out (wire_nil (lk_wire lk)) (wire_cons (lk_wire lk)) v acc fuel))
;; a chain of integer cells under the tags nl and cs
(fn cells_out ((nl Int) (cs Int) (v IVal) (acc (List Int)) (fuel Int)) (Option (List Int))
  (measure fuel)
  (if (< fuel 0) None
  (match v
    ((IVCtor tag fields)
     (if (= tag nl) (Some (rev acc))
     (if (= tag cs)
       (match fields
         ((Cons (IVInt b) (Cons rest Nil)) (cells_out nl cs rest (Cons b acc) (- fuel 1)))
         (_ None))
       None)))
    (_ None))))
(fn bool_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_true (lk_wire lk)) (wire_false (lk_wire lk))) Nil))
;; Init's Bool and Decidable cells: what the table's Nat set returns (§7.5)
(fn init_bool_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_btrue (lk_wire lk)) (wire_bfalse (lk_wire lk))) Nil))
(fn dec_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_dtrue (lk_wire lk)) (wire_dfalse (lk_wire lk))) Nil))
(fn wire_budget () Int 1000000000)

;; ---- the machine (§6.7) --------------------------------------------------------------------
(type Kont
  (KHalt)
  (KArg Int Int (List IVal) (List LTerm) (List IVal) Int Kont)  ; kind, head, the values so far (last first), the terms to go, env, cur, next
  (KMatch (List LArm) (List IVal) Int Kont)
  (KLet (List LTerm) LTerm (List IVal) Int Kont)                ; the right-hand sides to go, the body, env, cur, next
  (KIf LTerm LTerm (List IVal) Int Kont))
(type Halt
  (HVal IVal)
  (HOut Int)                            ; the function whose entry exhausted the fuel
  (HStuck Symbol Int)                   ; the reason, the function
  (HExhausted Symbol Int)               ; a primitive's resource (nat_size, nat_count), the function
  (HExt Int (List IVal) Kont Int Int))  ; an extern to perform: its index, arguments, the continuation, cur, fuel

(fn ev_term ((lk Linked) (env (List IVal)) (t LTerm) (k Kont) (cur Int) (fuel Int)) Halt
  (match t
    ((LBVar i) (match (nth env i) ((Some v) (ev_ret lk v k cur fuel)) (None (HStuck (quote unbound) cur))))
    ((LLit v) (ev_ret lk v k cur fuel))
    ;; an application: its first argument under the frame that holds the rest (kind 0 a cell,
    ;; 1 a call, 2 a primitive, 3 an extern), or the head applied where it has none; the
    ;; arguments after the first are ev_ret's (KArg)
    ((LCtor tag args)
     (match args
       (Nil (ev_ret lk (IVCtor tag Nil) k cur fuel))
       ((Cons a more) (ev_term lk env a (KArg 0 tag Nil more env cur k) cur fuel))))
    ((LCall id args)
     (match args
       (Nil (ev_call lk id Nil k cur fuel))
       ((Cons a more) (ev_term lk env a (KArg 1 id Nil more env cur k) cur fuel))))
    ((LPrim op args)
     (match args
       (Nil (ev_prim lk op Nil k cur fuel))
       ((Cons a more) (ev_term lk env a (KArg 2 op Nil more env cur k) cur fuel))))
    ((LExt id args)
     (match args
       (Nil (HExt id Nil k cur fuel))
       ((Cons a more) (ev_term lk env a (KArg 3 id Nil more env cur k) cur fuel))))
    ((LMatch s arms) (ev_term lk env s (KMatch arms env cur k) cur fuel))
    ((LLet rhss body)
     (match rhss
       (Nil (ev_term lk env body k cur fuel))
       ((Cons r1 rest) (ev_term lk env r1 (KLet rest body env cur k) cur fuel))))
    ((LIf c a b) (ev_term lk env c (KIf a b env cur k) cur fuel))
    (LAbsurd (HStuck (quote unreachable) cur))))
(fn ev_ret ((lk Linked) (v IVal) (k Kont) (cur Int) (fuel Int)) Halt
  (match k
    (KHalt (HVal v))
    ;; an argument's value: the next argument, left to right, or the saturated head over its
    ;; values (last first) — a cell, a call, a primitive, an extern
    ((KArg kind head done rest env cur1 next)
     (match rest
       ((Cons a more) (ev_term lk env a (KArg kind head (Cons v done) more env cur1 next) cur1 fuel))
       (Nil
        (if (= kind 0) (ev_ret lk (IVCtor head (rev (Cons v done))) next cur1 fuel)
        (if (= kind 1) (ev_call lk head (Cons v done) next cur1 fuel)
        (if (= kind 2) (ev_prim lk head (Cons v done) next cur1 fuel)
          (HExt head (rev (Cons v done)) next cur1 fuel)))))))
    ((KMatch arms env cur1 next)
     (match (pick_arm v arms env)
       ((ArmAt env1 body) (ev_term lk env1 body next cur1 fuel))
       (ArmNone (HStuck (quote no_arm) cur1))))
    ((KLet rest body env cur1 next)
     (let ((env1 (Cons v env)))
       (match rest
         (Nil (ev_term lk env1 body next cur1 fuel))
         ((Cons r1 more) (ev_term lk env1 r1 (KLet more body env1 cur1 next) cur1 fuel)))))
    ((KIf a b env cur1 next)
     (match v
       ((IVCtor tag _) (ev_term lk env (if (= (band tag 1) 1) a b) next cur1 fuel))
       (_ (HStuck (quote if_tag) cur1))))))
;; a function over its arguments' values (last first: the body's frame): one unit of fuel
(fn ev_call ((lk Linked) (head Int) (done (List IVal)) (k Kont) (cur Int) (fuel Int)) Halt
  (match (im_find (lk_fns lk) head)
    ((Some (LBody _ _ body)) (if (< fuel 1) (HOut head) (ev_term lk done body k head (- fuel 1))))
    ((Some (LUnlinked _)) (HStuck (quote unlinked) head))
    (_ (HStuck (quote unknown_head) cur))))
;; a primitive over its arguments' values (last first)
(fn ev_prim ((lk Linked) (op Int) (done (List IVal)) (k Kont) (cur Int) (fuel Int)) Halt
  (match (prim_apply lk op (rev done))
    ((PrimVal v) (ev_ret lk v k cur fuel))
    (PrimGuard (HStuck (quote guard) cur))
    ((PrimOut r) (HExhausted r cur))))
;; the first arm whose pattern takes the value: the frame with the pattern's variables, the body
(type Arm (ArmNone) (ArmAt (List IVal) LTerm))
(fn pick_arm ((v IVal) (arms (List LArm)) (env (List IVal))) Arm
  (measure (struct arms))
  (match arms
    (Nil ArmNone)
    ((Cons (LArm p body) rest)
     (match (match_pat p v env)
       ((Some env1) (ArmAt env1 body))
       (None (pick_arm v rest env))))))
;; the pattern's variables pushed in capture order: the last one bound is index 0
(fn match_pat ((p LPat) (v IVal) (env (List IVal))) (Option (List IVal))
  (measure (struct p))
  (match p
    (LPVar (Some (Cons v env)))
    ((LPInt n) (match v ((IVInt m) (if (= n m) (Some env) None)) (_ None)))
    ((LPSym s) (match v ((IVSym t) (if (sym_eq s t) (Some env) None)) (_ None)))
    ((LPCtor tag subs)
     (match v
       ((IVCtor t2 fields) (if (= tag t2) (match_fields subs fields env) None))
       (_ None)))))
(fn match_fields ((ps (List LPat)) (vs (List IVal)) (env (List IVal))) (Option (List IVal))
  (measure (struct ps))
  (match ps
    (Nil (match vs (Nil (Some env)) (_ None)))
    ((Cons p pr)
     (match vs
       (Nil None)
       ((Cons v vr) (match (match_pat p v env) ((Some env1) (match_fields pr vr env1)) (None None)))))))

;; ---- the primitives (prog.shard's codes; §6.4) ----------------------------------------------
;; a primitive's outcome: a value; the guard failed (the input outside the operation's
;; domain); a resource exhausted (nat_size: a result past K's literal size, nat_count: a
;; count past 32 bits) — checked before the work, never a domain failure
(type PrimRes (PrimVal IVal) (PrimGuard) (PrimOut Symbol))
(fn prim_apply ((lk Linked) (code Int) (args (List IVal))) PrimRes
  (match args
    ((Cons a (Cons b Nil))
     (match a
       ((IVInt x) (match b ((IVInt y) (prim_ii lk code x y)) (_ PrimGuard)))
       ((IVSym s) (match b ((IVSym t) (if (= code 5) (PrimVal (bool_cell lk (sym_eq s t))) PrimGuard)) (_ PrimGuard)))
       (_ PrimGuard)))
    ((Cons a Nil)
     (if (= code 16)
       (match (bytes_out lk a Nil (wire_budget)) ((Some bs) (if (utf8_ok bs) (PrimVal (IVSym (sym_of_chars bs))) PrimGuard)) (None PrimGuard))
     (if (= code 17)
       (match a ((IVSym s) (PrimVal (bytes_in lk (chars_of_sym s)))) (_ PrimGuard))
       PrimGuard)))
    (_ PrimGuard)))
;; sym_of_chars takes UTF-8 (the host decodes the bytes into the symbol's text): the guard is
;; validity (util.shard's utf8_ok) — an invalid sequence is stuck, never handed to the host,
;; whose refusal is fatal
(fn shift_ok ((k Int)) Bool (bool_and (<= 0 k) (< k 64)))
(fn nonneg2 ((x Int) (y Int)) Bool (bool_and (<= 0 x) (<= 0 y)))
(fn prim_ii ((lk Linked) (code Int) (x Int) (y Int)) PrimRes
  (if (< code 8)
    (if (= code 0) (PrimVal (bool_cell lk (= x y)))
    (if (= code 1) (PrimVal (IVInt (+ x y)))
    (if (= code 2) (PrimVal (IVInt (- x y)))
    (if (= code 3) (PrimVal (bool_cell lk (< x y)))
    (if (= code 4) (PrimVal (bool_cell lk (<= x y)))
    (if (= code 6) (PrimVal (IVInt (band x y)))
    (if (= code 7) (if (shift_ok y) (PrimVal (IVInt (bshr x y))) PrimGuard)
      PrimGuard)))))))
  (if (< code 16)
    (if (= code 8) (PrimVal (IVInt (* x y)))
    (if (= code 9) (if (= y 0) PrimGuard (PrimVal (IVInt (mod x y))))
    (if (= code 10) (if (= y 0) PrimGuard (PrimVal (IVInt (/ x y))))
    (if (= code 11) (if (= y 0) PrimGuard (PrimVal (IVInt (tmod x y))))
    (if (= code 12) (if (= y 0) PrimGuard (PrimVal (IVInt (ediv x y))))
    (if (= code 13) (PrimVal (IVInt (bor x y)))
    (if (= code 14) (PrimVal (IVInt (bxor x y)))
      (if (shift_ok y) (PrimVal (IVInt (bshl x y))) PrimGuard))))))))
  (if (< code 22)
    (if (= code 18) (PrimVal (IVInt (if (= y 0) 0 (/ x y))))
    (if (= code 19) (PrimVal (IVInt (if (= y 0) x (tmod x y))))
    (if (= code 20) (PrimVal (IVInt (if (= y 0) 0 (ediv x y))))
    (if (= code 21) (PrimVal (IVInt (if (= y 0) x (mod x y))))
      PrimGuard))))
  (if (bool_not (nonneg2 x y)) PrimGuard
  (if (= code 22) (PrimVal (IVInt (if (< x y) 0 (- x y))))
  (if (= code 23) (PrimVal (IVInt (band x y)))
  (if (= code 24) (PrimVal (IVInt (bor x y)))
  (if (= code 25) (PrimVal (IVInt (bxor x y)))
  (if (= code 26)
    (if (= x 0) (PrimVal (IVInt 0))   ; the zero shortcut first: no count, no size, no work
    (if (< (count_max_ev) y) (PrimOut (quote nat_count))
    (if (< (ev_nat_max_size) (+ (ev_nat_bytes x) (+ (ediv y 8) 1))) (PrimOut (quote nat_size))
      (PrimVal (IVInt (* x (nat_pow_ev 2 y)))))))
  (if (= code 27) (PrimVal (IVInt (nat_shr x y)))
    (nat_prim lk code x y))))))))))))
;; K's accelerated Nat set under its identities (§7.5; tc.shard's nat_apply): total where
;; Lean's are — Nat.div x 0 = 0, Nat.mod x 0 = x — and exhausted where K exhausts: a result
;; past K's literal size (nat_max_size, 2^27 bytes), a power's or a shift's count past 32 bits
;; (count_max), a power's size estimate — each before the work, as K's. A sum or a product is
;; measured after: its size is bounded by its operands', which are literals under the cap.
(fn nat_prim ((lk Linked) (code Int) (x Int) (y Int)) PrimRes
  (if (= code 28) (nat_sized (+ x y))
  (if (= code 29) (nat_sized (* x y))
  (if (= code 30) (PrimVal (IVInt (if (= y 0) 0 (/ x y))))
  (if (= code 31) (PrimVal (IVInt (if (= y 0) x (mod x y))))
  (if (= code 32) (PrimVal (IVInt (nat_gcd_ev x y)))
  (if (= code 33)
    (if (< (count_max_ev) y) (PrimOut (quote nat_count))
    (if (< y 1) (nat_sized (nat_pow_ev x y))   ; x^0 = 1; the size estimate below divides by y
    (if (bool_and (< 1 x) (< (ediv (ev_nat_max_size) y) (ev_nat_bytes x))) (PrimOut (quote nat_size))
      (nat_sized (nat_pow_ev x y)))))
  (if (= code 34) (PrimVal (init_bool_cell lk (= x y)))
  (if (= code 35) (PrimVal (init_bool_cell lk (<= x y)))
  (if (= code 36) (PrimVal (dec_cell lk (= x y)))
  (if (= code 37) (PrimVal (dec_cell lk (< x y)))
  (if (= code 38) (PrimVal (dec_cell lk (<= x y)))
    PrimGuard))))))))))))
(fn ev_nat_max_size () Int 134217728)
(fn ev_nat_bytes_go ((n Int) (acc Int)) Int
  (measure n)
  (if (<= n 0) acc (ev_nat_bytes_go (ediv n 256) (+ acc 1))))
(fn ev_nat_bytes ((n Int)) Int (ev_nat_bytes_go n 0))
(fn count_max_ev () Int 4294967295)
(fn nat_sized ((r Int)) PrimRes (if (< (ev_nat_max_size) (ev_nat_bytes r)) (PrimOut (quote nat_size)) (PrimVal (IVInt r))))
(fn nat_gcd_ev ((a Int) (b Int)) Int
  (measure b)
  (if (<= b 0) a (nat_gcd_ev b (mod a b))))
(fn nat_pow_ev ((b Int) (e Int)) Int
  (measure e)
  (if (<= e 0) 1
    (let ((h (nat_pow_ev b (ediv e 2))))
      (if (= (mod e 2) 0) (* h h) (* (* h h) b)))))
;; Nat.shiftLeft n k = n · 2^k (K's form, after the guards above) and Nat.shiftRight n k =
;; n / 2^k, total (Lean's), the right shift in steps of 62 bits over the host's guarded
;; shift, stopping at zero — so its work is bounded by n's size, never by k
(fn nat_shr ((n Int) (k Int)) Int
  (measure k)
  (if (= n 0) 0 (if (< k 62) (bshr n k) (nat_shr (bshr n 62) (- k 62)))))

;; ---- `ev` (§6.2) ----------------------------------------------------------------------------
(fn val_in ((lk Linked) (v Val)) (Option IVal)
  (measure (struct v))
  (match v
    ((VInt k) (Some (IVInt k)))
    ((VSym s) (Some (IVSym s)))
    ((VCtor c vs)
     (match (nmap_find (lk_tags lk) c)
       (None None)
       ((Some tag) (match (vals_in lk vs Nil) (None None) ((Some ivs) (Some (IVCtor tag ivs)))))))))
(fn vals_in ((lk Linked) (vs (List Val)) (acc (List IVal))) (Option (List IVal))
  (measure (struct vs))
  (match vs
    (Nil (Some (rev acc)))
    ((Cons v r) (match (val_in lk v) (None None) ((Some iv) (vals_in lk r (Cons iv acc)))))))
(fn val_out ((lk Linked) (v IVal)) Val
  (measure (struct v))
  (match v
    ((IVInt k) (VInt k))
    ((IVSym s) (VSym s))
    ((IVCtor tag vs) (VCtor (match (im_find (lk_names lk) tag) ((Some n) n) (None Anon)) (vals_out lk vs)))))
(fn vals_out ((lk Linked) (vs (List IVal))) (List Val)
  (measure (struct vs))
  (match vs (Nil Nil) ((Cons v r) (Cons (val_out lk v) (vals_out lk r)))))
(fn halt_res ((lk Linked) (h Halt)) EvRes
  (match h
    ((HVal v) (EvOk (val_out lk v)))
    ((HOut _) EvOut)
    ((HStuck r id) (EvStuck r (fn_name lk id)))
    ((HExhausted r id) (EvExhausted r (fn_name lk id)))
    ((HExt _ _ _ cur _) (EvStuck (quote extern) (fn_name lk cur)))))
;; the function f of the program p on args, under fuel: a value, out of fuel, or stuck — one
;; preparation and one invocation through the assumed door (below): the caller answers for the
;; arguments' types, and only their constructors are resolved (`bad_value`)
(fn ev ((p Prog) (f Name) (args (List Val)) (fuel Int)) EvRes
  (match (prepare p f (policy_of Assumed False Nil fuel) 0)
    ((PrepNo e _) (EvStuck e f))
    ((PrepOk h)
     (match (invoke h args)
       ((InvRan r) r)
       ((InvArg _ r _) (EvStuck r f))
       ((InvNo r _) (EvStuck r f))))))

;; ---- the prepared handle (§8.6 slice 4.6 rule 1; law §9.3) ------------------------------------
;; `prepare` links a program once and binds one entry of it; `invoke` runs the bound entry on
;; arguments built as data, as often as the client likes. `ev` above and `run_prog` below are
;; one preparation and one invocation each, so nothing in this file links but `prepare`. A
;; handle is a value: an invocation does not change it, and no later program retargets it.
;; A client reads `Handle.entry`, `Handle.params` (the parameters it supplies: under effects,
;; those before the World), `Handle.result`, `Handle.policy` and `Handle.revision`; the linked
;; program, the entry's index, the World's token and the inductives' index are this file's,
;; and so is making or restating a handle. That is a convention, as `Linked`'s is: a record's
;; constructor and updaters are ordinary declarations (record.shard), and no view seals this
;; file — kernel/test/handle_cost_test.sh holds the toolchain's sources to it by name.
;; The policy is fixed at `prepare`:
;;   door     law §9.3's two kinds of entry. Checked: every argument is validated against the
;;            E type the program states for its parameter before the machine starts, and
;;            `prepare` refuses (`preconditioned`) an entry one of whose parameters states a
;;            type a value cannot be validated against in full — a type parameter with no
;;            type stated for it; `Fin`, `BitVec` or `Subtype`, whose bound or predicate is a
;;            value argument E dropped (§8.4 slice 3.18 rule 1); a type the program does not
;;            define, or applies to the wrong number of types. A sig fn no implementation is
;;            linked to and an extern are no entries (`unlinked`, `unknown_head`). Assumed:
;;            the caller answers for the arguments' types — `ev`'s contract (§6.2) — and
;;            only their constructors are resolved; whatever the linker indexed is bound, and
;;            the machine answers for it.
;;   effects  the entry takes the World last and its externs are performed by the host's
;;            (`invoke_run`); without it an extern reached is stuck (`invoke`). The World
;;            is not an argument and not the door's: its token is built here, a value of the
;;            last parameter's type (world_last) — which type that is, is §9's stated limit
;;   trace    the path the effect trace is written to at a run's end (empty: none)
;;   fuel     of one invocation
;; THE CHECKED DOOR ON A PROGRAM ALONE: it validates against what the Prog states, and a Prog
;; does not state what the erasure dropped beside a type's value arguments — an evidence binder
;; of the entry's own signature, a proposition field of a constructor (§7.5). An entry with
;; either passes this `prepare` as checked on its runtime parameters alone. Where the program
;; comes with the environment it was erased from — a session's revision, the driver's load —
;; the door reads the two there and refuses the entry (session.shard prepare_on; rule 2).
(type Door (Checked) (Assumed))
(record Policy (door Door) (effects Bool) (trace (List Int)) (fuel Int))
;; `make` reaches the records of its own file alone (record.shard), so a client states a policy
;; through this
(fn policy_of ((door Door) (effects Bool) (trace (List Int)) (fuel Int)) Policy
  (make Policy (door door) (effects effects) (trace trace) (fuel fuel)))
(record Handle (lk Linked) (id Int) (entry Name) (params (List EType)) (result EType) (policy Policy) (token (Option IVal)) (inds (IntMap (List (Pair Name EDecl)))) (revision Int))
(type Prep (PrepOk Handle) (PrepNo Symbol (List Int)))   ; a refusal: the reason — a link error's, unknown_head, unlinked, bad_entry, preconditioned — and its text
(fn prepare ((p Prog) (f Name) (pol Policy) (revision Int)) Prep
  (match (link p)
    ((LkErr e m) (PrepNo e m))
    ((LkOk lk)
     (match (nmap_find (lk_ids lk) f)
       (None (PrepNo (quote unknown_head) (show_name f)))
       ((Some id)
        (match p
          ((Prog ds)
           (match (entry_types (fn_decl_at ds id) (Policy.door pol) f)
             ((EntNo e m) (PrepNo e m))
             ((EntOk ps rt)
              (match (if (Policy.effects pol) (world_last lk ds ps) (Some (Pair ps None)))
                (None (PrepNo (quote bad_entry) (append (show_name f) " does not take a World last")))
                ((Some (Pair params token))
                 (let ((h (make Handle (lk lk) (id id) (entry f) (params params) (result rt) (policy pol) (token token) (inds IMEmpty) (revision revision))))
                   (match (Policy.door pol)
                     (Assumed (PrepOk h))
                     (Checked (checked_door h ds)))))))))))))))
;; the entry's parameter and result types as its declaration states them. At the checked door
;; an entry is a fn; at the assumed one a sig fn and an extern are bound as `ev` always took
;; them, and the machine answers — after the arguments are resolved, as before
(type Ent (EntOk (List EType) EType) (EntNo Symbol (List Int)))
(fn entry_types ((d (Option EDecl)) (door Door) (f Name)) Ent
  (match d
    ((Some (EFn _ _ ps rt _ _)) (EntOk ps rt))
    ((Some (ESig _ _ ps rt))
     (match door
       (Assumed (EntOk ps rt))
       (Checked (EntNo (quote unlinked) (append (show_name f) " is a sig fn no implementation is linked to")))))
    ((Some (EExtern _ _ ps rt))
     (match door
       (Assumed (EntOk ps rt))
       (Checked (EntNo (quote unknown_head) (append (show_name f) " is an extern, not a fn of the program")))))
    (_ (EntNo (quote unknown_head) (show_name f)))))
;; the declaration the linker numbered j: the j-th fn, sig fn or extern in order (index_fns) —
;; of two under one name the later, as the linker's index has it
(fn fn_decl_at ((ds (List EDecl)) (j Int)) (Option EDecl)
  (measure (struct ds))
  (match ds
    (Nil None)
    ((Cons (EInd _ _ _) r) (fn_decl_at r j))
    ((Cons (ESigType _ _) r) (fn_decl_at r j))
    ((Cons d r) (if (< j 1) (Some d) (fn_decl_at r (- j 1))))))
;; under effects the entry takes the World last (§9): the parameters before it are the client's,
;; the World's token its type's first constructor with its fields zero. The last parameter's
;; type is taken as the World, whatever its name (§9's stated Stage-0 limit) — but the token
;; is a value of it: the constructor's fields are integers (`Int`, `Nat`), or it has none.
;; Of two inductives under the name, the later, as the linker's tags have it
(fn world_last ((lk Linked) (ds (List EDecl)) (ps (List EType))) (Option (Pair (List EType) (Option IVal)))
  (match (split_last ps Nil)
    (None None)
    ((Some (Pair params wn))
     (match (ind_last ds wn None)
       ((Some (EInd _ _ (Cons (ECtorDef c fs) _)))
        (if (bool_not (all_integers fs)) None
          (match (nmap_find (lk_tags lk) c) ((Some tag) (Some (Pair params (Some (IVCtor tag (zeros_iv (len fs))))))) (None None))))
       (_ None)))))
(fn ind_last ((ds (List EDecl)) (n Name) (acc (Option EDecl))) (Option EDecl)
  (measure (struct ds))
  (match ds
    (Nil acc)
    ((Cons (EInd m np cs) r) (ind_last r n (if (name_eq m n) (Some (EInd m np cs)) acc)))
    ((Cons _ r) (ind_last r n acc))))
(fn all_integers ((ts (List EType))) Bool
  (measure (struct ts))
  (match ts
    (Nil True)
    ((Cons (ETCon n Nil) r) (if (bool_or (name_eq n (n1 (quote Int))) (name_eq n (n1 (quote Nat)))) (all_integers r) False))
    ((Cons _ _) False)))
(fn split_last ((ps (List EType)) (acc (List EType))) (Option (Pair (List EType) Name))
  (measure (struct ps))
  (match ps
    (Nil None)
    ((Cons (ETCon n _) Nil) (Some (Pair (rev acc) n)))
    ((Cons _ Nil) None)
    ((Cons t r) (split_last r (Cons t acc)))))
(fn zeros_iv ((k Int)) (List IVal) (measure k) (if (< k 1) Nil (Cons (IVInt 0) (zeros_iv (- k 1)))))

;; the checked door's condition, decided once at `prepare`: every parameter states a closed
;; type, and every type a value of it reaches is one the validation below reads in full — an
;; inductive of the program applied to as many types as it takes, its fields' types over its
;; own parameters; a type read by identity, applied to none (an Array to one). An inductive's
;; constructors are examined once (seen), the arguments at every application — so an argument
;; a type never uses is examined too. A type parameter of the entry that no parameter states
;; is no obstacle: no value is read at it
(type Tc (TcOk (List Name)) (TcNo (List Int)))
(fn checked_door ((h Handle) (ds (List EDecl))) Prep
  (let ((inds (index_inds ds IMEmpty)))
    (match (params_checked inds (Handle.params h) 1 Nil)
      ((TcNo m) (PrepNo (quote preconditioned) (append (show_name (Handle.entry h)) (append ": parameter " m))))
      ((TcOk _) (PrepOk (with Handle h (inds inds)))))))
(fn index_inds ((ds (List EDecl)) (x (IntMap (List (Pair Name EDecl))))) (IntMap (List (Pair Name EDecl)))
  (measure (struct ds))
  (match ds
    (Nil x)
    ((Cons (EInd n np cs) r) (index_inds r (decl_index_add x (EInd n np cs))))
    ((Cons _ r) (index_inds r x))))
(fn params_checked ((inds (IntMap (List (Pair Name EDecl)))) (ps (List EType)) (i Int) (seen (List Name))) Tc
  (measure (struct ps))
  (match ps
    (Nil (TcOk seen))
    ((Cons t r)
     (match (ty_checked inds 0 t seen)
       ((TcNo m) (TcNo (append (show_nat i) (append " states " (append (show_etype t) (append ": " m))))))
       ((TcOk seen1) (params_checked inds r (+ i 1) seen1))))))
;; np: the type parameters in scope — none at a parameter of the entry, its inductive's at a field
(fn tys_checked ((inds (IntMap (List (Pair Name EDecl)))) (np Int) (ts (List EType)) (seen (List Name))) Tc
  (measure (struct ts))
  (match ts
    (Nil (TcOk seen))
    ((Cons t r) (match (ty_checked inds np t seen) ((TcNo m) (TcNo m)) ((TcOk seen1) (tys_checked inds np r seen1))))))
(fn ty_checked ((inds (IntMap (List (Pair Name EDecl)))) (np Int) (t EType) (seen (List Name))) Tc
  (match t
    ((ETVar i) (if (bool_and (<= 0 i) (< i np)) (TcOk seen) (TcNo (append (show_etype t) " is a type parameter with no type stated for it"))))
    ((ETCon n args)
     (match (head_checked inds n (len args) seen)
       ((TcNo m) (TcNo m))
       ((TcOk seen1) (tys_checked inds np args seen1))))))
;; a type's head applied to k types
(fn head_checked ((inds (IntMap (List (Pair Name EDecl)))) (n Name) (k Int) (seen (List Name))) Tc
  (if (door_reads n) (if (= k (if (name_eq n (n1 (quote Array))) 1 0)) (TcOk seen) (TcNo (arity_text n (if (name_eq n (n1 (quote Array))) 1 0) k)))
  (if (door_dropped n) (TcNo (append (show_name n) "'s bound or predicate is a value argument E dropped, which no reading of a value restores"))
    (match (decl_index_find inds n)
      ((Some (EInd _ np cs))
       (if (bool_not (= k np)) (TcNo (arity_text n np k))
       (if (mem_name n seen) (TcOk seen)
         (ctors_checked inds np cs (Cons n seen)))))
      (_ (TcNo (append (show_name n) " is not a type the program defines")))))))
(fn arity_text ((n Name) (takes Int) (k Int)) (List Int)
  (append (show_name n) (append " takes " (append (show_nat takes) (append " type argument(s) and is applied to " (show_nat k))))))
(fn ctors_checked ((inds (IntMap (List (Pair Name EDecl)))) (np Int) (cs (List ECtorDef)) (seen (List Name))) Tc
  (measure (struct cs))
  (match cs
    (Nil (TcOk seen))
    ((Cons (ECtorDef _ fts) r) (match (tys_checked inds np fts seen) ((TcNo m) (TcNo m)) ((TcOk seen1) (ctors_checked inds np r seen1))))))
;; the types the validation reads by identity: the integers, a symbol, and the registry's rows
;; whose invariant a value shows (§8.4 slice 3.18 rule 1) — a UInt8 below 256, an Array's and a
;; ByteArray's cells, a String's bytes and their validity; and the rows it cannot
(fn door_reads ((n Name)) Bool
  (bool_or (name_eq n (n1 (quote Int))) (bool_or (name_eq n (n1 (quote Nat))) (bool_or (name_eq n (n1 (quote Symbol)))
  (bool_or (name_eq n (n1 (quote UInt8))) (bool_or (name_eq n (n1 (quote Array))) (bool_or (name_eq n (n1 (quote ByteArray))) (name_eq n (n1 (quote String))))))))))
(fn door_dropped ((n Name)) Bool
  (bool_or (name_eq n (n1 (quote Fin))) (bool_or (name_eq n (n1 (quote BitVec))) (name_eq n (n1 (quote Subtype))))))

;; ---- invocation ------------------------------------------------------------------------------
;; the machine ran, and its answer; an argument refused before it started — its 1-based
;; position, the reason, its text (the assumed door's `bad_value` has no position: 0); the
;; handle does not take the call (`policy`: an entry prepared for effects, whose run is
;; invoke_run's)
(type InvRes (InvRan EvRes) (InvArg Int Symbol (List Int)) (InvNo Symbol (List Int)))
(fn invoke ((h Handle) (args (List Val))) InvRes
  (if (Policy.effects (Handle.policy h)) (InvNo (quote policy) (append (show_name (Handle.entry h)) " was prepared for a run with effects (invoke_run)"))
    (match (args_at h args)
      ((ArgsBad i r m) (InvArg i r m))
      ((ArgsOk ivs) (InvRan (halt_res (Handle.lk h) (enter h ivs)))))))
;; the same for an entry prepared with effects: the World's token after the client's arguments,
;; every extern performed by the host's, argv what `get_args` answers, the trace written to
;; the policy's path
(fn invoke_run ((h Handle) (args (List Val)) (argv (List (List Int))) (w World)) (Pair RunRes World)
  (if (bool_not (Policy.effects (Handle.policy h))) (Pair (RunLink (quote policy) (append (show_name (Handle.entry h)) " was prepared without effects (invoke)")) w)
    (match (args_at h args)
      ((ArgsBad i r m) (Pair (RunArg i r m) w))
      ((ArgsOk ivs) (run_loop (Handle.lk h) (enter h ivs) argv (Policy.trace (Handle.policy h)) Nil w)))))
;; the machine entered at the handle's function: its arguments last first (the body's frame)
(fn enter ((h Handle) (ivs (List IVal))) Halt
  (ev_call (Handle.lk h) (Handle.id h) (rev (match (Handle.token h) ((Some tok) (append ivs (list tok))) (None ivs))) KHalt (Handle.id h) (Policy.fuel (Handle.policy h))))
;; the arguments at the handle's door
(type ArgsRes (ArgsOk (List IVal)) (ArgsBad Int Symbol (List Int)))
(fn args_at ((h Handle) (args (List Val))) ArgsRes
  (match (Policy.door (Handle.policy h))
    (Assumed (match (vals_in (Handle.lk h) args Nil) (None (ArgsBad 0 (quote bad_value) Nil)) ((Some ivs) (ArgsOk ivs))))
    (Checked (args_checked h (Handle.params h) args 1 Nil))))
(fn args_checked ((h Handle) (ps (List EType)) (args (List Val)) (i Int) (acc (List IVal))) ArgsRes
  (measure (struct ps))
  (match ps
    (Nil (match args
           (Nil (ArgsOk (rev acc)))
           (_ (ArgsBad i (quote argument_count) (count_msg (Handle.entry h) (- i 1) (+ (- i 1) (len args)))))))
    ((Cons t r)
     (match args
       (Nil (ArgsBad i (quote argument_count) (count_msg (Handle.entry h) (+ (- i 1) (len ps)) (- i 1))))
       ((Cons a ar)
        (match (val_at h t a)
          ((ChkNo e m) (ArgsBad i e m))
          ((ChkOk iv) (args_checked h r ar (+ i 1) (Cons iv acc)))))))))
(fn count_msg ((f Name) (takes Int) (got Int)) (List Int)
  (append (show_name f) (append " takes " (append (show_nat takes) (append " argument(s), got " (show_nat got))))))

;; ---- the checked door's validation (rule 1; law §9.3: raw inputs → validation or error) -------
;; a value built as data at an E type: an integer where the type is Int, not negative at Nat,
;; below 256 at UInt8; a symbol at Symbol; a constructor of the type's inductive over exactly
;; its fields, each at its field's type under the type's arguments; a row's cells. The reasons:
;; not_a_nat and not_a_byte with the integer's text (the text codec's not_a_nat is the same
;; refusal of the same argument), not_of_type, field_count and not_utf8 with the value's head
;; and the type
(type Chk (ChkOk IVal) (ChkNo Symbol (List Int)))
(type Chks (ChksOk (List IVal)) (ChksNo Symbol (List Int)))
(fn val_at ((h Handle) (t EType) (v Val)) Chk
  (measure (struct v))
  (match t
    ((ETVar _) (ChkNo (quote not_of_type) (at_type v t)))
    ((ETCon n targs)
     (match v
       ((VInt k) (int_at n k t))
       ((VSym s) (if (name_eq n (n1 (quote Symbol))) (ChkOk (IVSym s)) (ChkNo (quote not_of_type) (at_type v t))))
       ((VCtor c vs)
        (if (name_eq n (n1 (quote ByteArray))) (row_at h (ETCon (n1 (quote UInt8)) Nil) t v)
        (if (name_eq n (n1 (quote Array))) (match targs ((Cons a Nil) (row_at h a t v)) (_ (ChkNo (quote not_of_type) (at_type v t))))
        (if (name_eq n (n1 (quote String))) (string_at h t v)
        (if (door_reads n) (ChkNo (quote not_of_type) (at_type v t))   ; an integer's or a symbol's type has no constructor, whatever the program declares under its name
          (match (decl_index_find (Handle.inds h) n)
            ((Some (EInd _ _ cs))
             (match (fields_of cs c)
               (None (ChkNo (quote not_of_type) (at_type v t)))
               ((Some fts)
                (if (bool_not (= (len fts) (len vs))) (ChkNo (quote field_count) (at_type v t))
                  (match (nmap_find (lk_tags (Handle.lk h)) c)
                    (None (ChkNo (quote bad_value) (at_type v t)))
                    ((Some tag)
                     (match (vals_at h (subst_tys targs fts) vs Nil)
                       ((ChksNo e m) (ChkNo e m))
                       ((ChksOk ivs) (ChkOk (IVCtor tag ivs))))))))))
            (_ (ChkNo (quote not_of_type) (at_type v t)))))))))))))
(fn vals_at ((h Handle) (ts (List EType)) (vs (List Val)) (acc (List IVal))) Chks
  (measure (struct vs))
  (match vs
    (Nil (ChksOk (rev acc)))
    ((Cons v r)
     (match ts
       (Nil (ChksNo (quote field_count) Nil))
       ((Cons t tr)
        (match (val_at h t v)
          ((ChkNo e m) (ChksNo e m))
          ((ChkOk iv) (vals_at h tr r (Cons iv acc)))))))))
(fn int_at ((n Name) (k Int) (t EType)) Chk
  (if (name_eq n (n1 (quote Int))) (ChkOk (IVInt k))
  (if (name_eq n (n1 (quote Nat))) (if (< k 0) (ChkNo (quote not_a_nat) (show_int k)) (ChkOk (IVInt k)))
  (if (name_eq n (n1 (quote UInt8))) (if (bool_and (<= 0 k) (< k 256)) (ChkOk (IVInt k)) (ChkNo (quote not_a_byte) (show_int k)))
    (ChkNo (quote not_of_type) (at_type (VInt k) t))))))
;; a row's cells (§8.4 slice 3.18 rule 1): an Array's and a ByteArray's are Init's List cells
;; of their elements — the spine walked as a loop, so a long buffer takes no host stack
(fn row_at ((h Handle) (et EType) (t EType) (v Val)) Chk
  (match (tags2 (Handle.lk h) (init_nil) (init_cons))
    (None (ChkNo (quote bad_value) (at_type v t)))
    ((Some tg) (row_cells h et t v Nil tg))))
(fn row_cells ((h Handle) (et EType) (t EType) (v Val) (acc (List IVal)) (tg (Pair Int Int))) Chk
  (measure (struct v))
  (match v
    ((VCtor c vs)
     (if (name_eq c (init_nil))
       (match vs
         (Nil (match tg ((Pair tnl tcs) (ChkOk (cells_onto tcs acc (IVCtor tnl Nil))))))
         (_ (ChkNo (quote field_count) (at_type v t))))
     (if (name_eq c (init_cons))
       (match vs
         ((Cons x (Cons rest Nil))
          (match (val_at h et x)
            ((ChkNo e m) (ChkNo e m))
            ((ChkOk iv) (row_cells h et t rest (Cons iv acc) tg))))
         (_ (ChkNo (quote field_count) (at_type v t))))
       (ChkNo (quote not_of_type) (at_type v t)))))
    (_ (ChkNo (quote not_of_type) (at_type v t)))))
;; the cells of the elements (last first) onto a tail
(fn cells_onto ((tcs Int) (acc (List IVal)) (tail IVal)) IVal
  (measure (struct acc))
  (match acc (Nil tail) ((Cons x r) (cells_onto tcs r (IVCtor tcs (list x tail))))))
;; a String is its ByteArray with the validity proof erased (slice 3.18): the bytes, and that
;; they are UTF-8 — the invariant the erasure dropped, read back from the value
(fn string_at ((h Handle) (t EType) (v Val)) Chk
  (match (row_at h (ETCon (n1 (quote UInt8)) Nil) t v)
    ((ChkNo e m) (ChkNo e m))
    ((ChkOk iv)
     (match (tags2 (Handle.lk h) (init_nil) (init_cons))
       (None (ChkNo (quote bad_value) (at_type v t)))
       ((Some (Pair tnl tcs))
        (match (cells_out tnl tcs iv Nil (wire_budget))
          ((Some bs) (if (utf8_ok bs) (ChkOk iv) (ChkNo (quote not_utf8) (at_type v t))))
          (None (ChkNo (quote not_of_type) (at_type v t)))))))))
;; a refusal's text: the value's head and the type it was read at
(fn at_type ((v Val) (t EType)) (List Int)
  (append (match v
            ((VInt k) (append "the integer " (show_int k)))
            ((VSym s) (append "the symbol " (chars_of_sym s)))
            ((VCtor c _) (append "the constructor " (show_name c))))
          (append " at " (show_etype t))))

;; ---- `run_prog`: the effectful driver (§6.2, §6.7; the checked entry, §9) --------------------
(type RunRes (RunOk) (RunOut Name) (RunExhausted Symbol Name) (RunStuck Symbol Name) (RunLink Symbol (List Int)) (RunArg Int Symbol (List Int)))   ; RunExhausted: a primitive's resource; RunLink: `prepare`'s refusal; RunArg: the argument's position, the reason, its text
;; f on the World with the program's arguments: the parameters before the World are the checked
;; entry (§9) — each command-line argument read by the text codec below at its parameter's E
;; type and validated at the checked door before the machine starts — the World the last
;; parameter's first constructor; every extern performed by the host's. One preparation, the
;; text codec, one invocation — of a program alone. The driver's run holds a load, and its door
;; is the session's (session.shard run_load), where the policy carries the effect trace's path
;; (§8.6 slice 4.3 landing 2; law §4.7 (iii)): every host call the run performs, in order, as
;; one line — the extern's name, its arguments and the host's answer by the wire (perform_at)
;; — written when the path is not empty: at the run's end, and before an `exit` is performed,
;; since the host's exit never returns
(fn run_prog ((p Prog) (f Name) (argv (List (List Int))) (fuel Int) (w World)) (Pair RunRes World)
  (match (prepare p f (policy_of Checked True Nil fuel) 0)
    ((PrepNo e m) (Pair (RunLink e m) w))
    ((PrepOk h)
     (match (text_args h argv)
       ((TextNo r) (Pair r w))
       ((TextOk vs) (invoke_run h vs argv w))))))
;; the text codec (§9): one producer of a checked handle's arguments — the command line's
;; against the parameters in order, i the 1-based position; an argument that does not parse is
;; refused with its position and text, never a file span; an entry with the World alone takes
;; the raw list through get_args
(type TextArgs (TextOk (List Val)) (TextNo RunRes))
(type TextArg (TArgOk Val) (TArgBad Symbol) (TArgType (List Int)))
(fn text_args ((h Handle) (argv (List (List Int)))) TextArgs
  (if (= (len (Handle.params h)) 0) (TextOk Nil) (text_args_go (Handle.entry h) (Handle.params h) argv 1 Nil)))
(fn text_args_go ((f Name) (params (List EType)) (argv (List (List Int))) (i Int) (acc (List Val))) TextArgs
  (measure (struct params))
  (match params
    (Nil (match argv
           (Nil (TextOk (rev acc)))
           (_ (TextNo (RunArg i (quote argument_count) (count_msg f (- i 1) (+ (- i 1) (len argv))))))))
    ((Cons t r)
     (match argv
       (Nil (TextNo (RunArg i (quote argument_count) (count_msg f (+ (- i 1) (len params)) (- i 1)))))
       ((Cons a ar)
        (match (text_arg t a)
          ((TArgOk v) (text_args_go f r ar (+ i 1) (Cons v acc)))
          ((TArgBad reason) (TextNo (RunArg i reason a)))
          ((TArgType msg) (TextNo (RunLink (quote bad_entry) (append (show_name f) (append ": parameter " (append (show_nat i) (append " " msg)))))))))))))
;; one argument's text at one parameter type: Int, Nat, or a byte-list codec taking the bytes
(fn text_arg ((t EType) (a (List Int))) TextArg
  (match t
    ((ETCon n _)
     (if (name_eq n (n1 (quote Int))) (match (arg_int a) ((Some k) (TArgOk (VInt k))) (None (TArgBad (quote not_an_int))))
     (if (name_eq n (n1 (quote Nat))) (match (arg_nat a) ((Some k) (TArgOk (VInt k))) (None (TArgBad (quote not_a_nat))))
       (match (val_of_text t a) ((Some v) (TArgOk v)) (None (TArgType (unsupplied n)))))))
    (_ (TArgType "has a type variable's type, which no command-line argument supplies (§9)"))))
;; text as a value of a byte type, and back (slice 3.29 rule 1: a tactic library's goal in and
;; block out, through the same codec as the checked entry's arguments): the cells of the
;; type's list constructors; None when the type is no byte type, or the value no text
(fn text_type ((t EType)) Bool (match (list_ctors t) ((Some _) True) (None False)))
(fn val_of_text ((t EType) (bs (List Int))) (Option Val)
  (match (list_ctors t)
    (None None)
    ((Some (Pair nl cs)) (Some (text_cells nl cs bs)))))
(fn text_cells ((nl Name) (cs Name) (bs (List Int))) Val
  (measure (struct bs))
  (match bs (Nil (VCtor nl Nil)) ((Cons b r) (VCtor cs (list (VInt b) (text_cells nl cs r))))))
(fn text_of_val ((v Val)) (Option (List Int))
  (measure (struct v))
  (match v
    ((VCtor _ Nil) (Some Nil))
    ((VCtor _ (Cons (VInt b) (Cons r Nil))) (match (text_of_val r) ((Some bs) (Some (Cons b bs))) (None None)))
    (_ None)))
(fn unsupplied ((n Name)) (List Int)
  (append "has type " (append (show_name n) ", which no command-line argument supplies (§9: Int, Nat, the prelude's (List Int), Init's (List Nat) or (List Int), ByteArray)")))
;; the byte-list codecs, by identity and element type (§9; GPT-6 R59, slice 10): the prelude's
;; (List Int), Init's (List Nat) and (List Int), and ByteArray, whose representation is Init's
;; List cells (§8.4 slice 3.18 rule 1) — never a shape. Before: any two-constructor
;; type with a nullary first and a binary second constructor took the bytes, so a
;; `(type Tree (Empty) (Branch Tree Tree))` entry received Branch cells with integers in its
;; Tree fields — a value of no type, stuck at the first match on it.
(fn list_ctors ((t EType)) (Option (Pair Name Name))
  (match t
    ((ETCon n (Cons (ETCon e Nil) Nil))
     (if (bool_and (name_eq n (prelude_list)) (name_eq e (n1 (quote Int)))) (Some (Pair (prelude_nil) (prelude_cons)))
     (if (bool_and (name_eq n (n1 (quote List))) (bool_or (name_eq e (n1 (quote Nat))) (name_eq e (n1 (quote Int)))))
       (Some (Pair (init_nil) (init_cons)))
       None)))
    ((ETCon n Nil) (if (name_eq n (n1 (quote ByteArray))) (Some (Pair (init_nil) (init_cons))) None))
    (_ None)))
(fn cells_in ((nl Int) (cs Int) (bs (List Int))) IVal
  (measure (struct bs))
  (match bs (Nil (IVCtor nl Nil)) ((Cons b r) (IVCtor cs (list (IVInt b) (cells_in nl cs r))))))
(fn arg_nat ((a (List Int))) (Option Int)
  (match a (Nil None) (_ (if (arg_all_digits a) (Some (arg_digits a 0)) None))))
(fn arg_int ((a (List Int))) (Option Int)
  (match a
    ((Cons b r) (if (= b 45) (match (arg_nat r) ((Some k) (Some (- 0 k))) (None None)) (arg_nat a)))
    (Nil None)))
(fn arg_all_digits ((bs (List Int))) Bool
  (measure (struct bs))
  (match bs (Nil True) ((Cons b r) (if (bool_and (<= 48 b) (<= b 57)) (arg_all_digits r) False))))
(fn arg_digits ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs (Nil acc) ((Cons b r) (arg_digits r (+ (* acc 10) (- b 48))))))
(fn run_loop ((lk Linked) (h Halt) (argv (List (List Int))) (path (List Int)) (tr (List (List Int))) (w World)) (Pair RunRes World)
  (match h
    ((HVal _) (Pair RunOk (tr_flush path tr w)))
    ((HOut id) (Pair (RunOut (fn_name lk id)) (tr_flush path tr w)))
    ((HStuck r id) (Pair (RunStuck r (fn_name lk id)) (tr_flush path tr w)))
    ((HExhausted r id) (Pair (RunExhausted r (fn_name lk id)) (tr_flush path tr w)))
    ((HExt id args k cur fuel)
     (match (im_find (lk_fns lk) id)
       ((Some (LExtern _ short _ ps rt))
        (match (perform lk short ps rt args argv (if (sym_eq short (quote exit)) (tr_flush path (Cons (tr_exit_line args) tr) w) w))
          ((Pair (Pair (Some v) line) w1) (run_loop lk (ev_ret lk v k cur fuel) argv path (Cons line tr) w1))
          ((Pair (Pair None _) w1) (Pair (RunStuck (quote extern) (fn_name lk id)) (tr_flush path tr w1)))))
       (_ (Pair (RunStuck (quote extern) (fn_name lk cur)) (tr_flush path tr w)))))))
;; ---- the effect trace (§8.6 slice 4.3 landing 2) ----------------------------------------------
;; one line per host call: the extern's short name, its arguments as the host saw them and the
;; host's answer where it carries data — `get_args "a" "b"`, `read_file "p" -> none` or
;; `-> (some "…")`, `write "…"`, `write_line "…"`, `write_file "p" "…" -> true`, `exit 3`; bytes
;; quoted with `\"`, `\\`, `\n`, `\t`, `\r` and `\xHH` for any other byte outside 32–126. The
;; model's trace (examples/calc/calc_app_world.shard) is rendered by the same functions
;; (kernel/test/calc_harness.shard), so the tie is the call lists', not a renderer's
(fn tr_flush ((path (List Int)) (tr (List (List Int))) (w World)) World
  (match path
    (Nil w)
    (_ (match (write_file path (tr_join (rev tr)) w) ((Pair _ w1) w1)))))
(fn tr_join ((ls (List (List Int)))) (List Int)
  (measure (struct ls))
  (match ls (Nil Nil) ((Cons x r) (append x (Cons 10 (tr_join r))))))
(fn tr_exit_line ((args (List IVal))) (List Int)
  (match args ((Cons (IVInt code) _) (append "exit " (show_int code))) (_ "exit ?")))
(fn tr_quote ((bs (List Int))) (List Int) (Cons 34 (tr_quote_go bs)))
(fn tr_quote_go ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (Nil (list 34))
    ((Cons b r)
     (append (if (= b 34) "\\\""
             (if (= b 92) "\\\\"
             (if (= b 10) "\\n"
             (if (= b 9) "\\t"
             (if (= b 13) "\\r"
             (if (bool_and (<= 32 b) (<= b 126)) (list b)
               (append "\\x" (tr_hex2 b))))))))
             (tr_quote_go r)))))
(fn tr_hex2 ((b Int)) (List Int) (list (tr_hex_digit (/ (mod b 256) 16)) (tr_hex_digit (mod b 16))))
(fn tr_hex_digit ((d Int)) Int (if (< d 10) (+ 48 d) (+ 87 d)))
(fn tr_args ((as (List (List Int)))) (List Int)
  (measure (struct as))
  (match as (Nil Nil) ((Cons a r) (append " " (append (tr_quote a) (tr_args r))))))
(fn tr_opt ((o (Option (List Int)))) (List Int)
  (match o (None "none") ((Some bs) (append "(some " (append (tr_quote bs) ")")))))
;; ---- the wire by declared type (§6.7; §8.4 slice 3.18 rule 4) --------------------------------
;; each value of an extern is built and read by the E type the program declared — a codec by
;; identity, as the entry's is: the prelude's cells under the toolchain's signatures
;; (host.shard), Init's under the naming law. A declared type the host's value does not fit
;; yields no value (the extern is stuck), decided before the host is asked — the result's type
;; too: the World's token is returned at the type it was passed at (the extern's last parameter's)
(fn tags2 ((lk Linked) (a Name) (b Name)) (Option (Pair Int Int))
  (match (nmap_find (lk_tags lk) a)
    (None None)
    ((Some ta) (match (nmap_find (lk_tags lk) b) (None None) ((Some tb) (Some (Pair ta tb)))))))
;; a byte type's nil and cons: the prelude's (List Int), or ByteArray
(fn wb_tags ((lk Linked) (t EType)) (Option (Pair Int Int))
  (match t
    ((ETCon n (Cons (ETCon e Nil) Nil))
     (if (bool_and (name_eq n (prelude_list)) (name_eq e (n1 (quote Int)))) (tags2 lk (prelude_nil) (prelude_cons)) None))
    ((ETCon n Nil) (if (name_eq n (n1 (quote ByteArray))) (tags2 lk (init_nil) (init_cons)) None))
    (_ None)))
;; a list type's nil and cons, and its element type
(fn wl_tags ((lk Linked) (t EType)) (Option (Pair (Pair Int Int) EType))
  (match t
    ((ETCon n (Cons e Nil))
     (match (if (name_eq n (prelude_list)) (tags2 lk (prelude_nil) (prelude_cons))
            (if (name_eq n (n1 (quote List))) (tags2 lk (init_nil) (init_cons)) None))
       (None None)
       ((Some tg) (Some (Pair tg e)))))
    (_ None)))
;; an option type's none and some, and its element type
(fn wo_tags ((lk Linked) (t EType)) (Option (Pair (Pair Int Int) EType))
  (match t
    ((ETCon n (Cons e Nil))
     (match (if (name_eq n (prelude_option)) (tags2 lk (prelude_none) (prelude_some))
            (if (name_eq n (n1 (quote Option))) (tags2 lk (init_none) (init_some)) None))
       (None None)
       ((Some tg) (Some (Pair tg e)))))
    (_ None)))
;; a pair type's constructor and its first component's type; the second is the World's (wt)
(fn wp_first ((lk Linked) (t EType) (wt EType)) (Option (Pair Int EType))
  (match t
    ((ETCon n (Cons a (Cons b Nil)))
     (if (bool_not (etype_eq b wt)) None
       (match (nmap_find (lk_tags lk) (if (name_eq n (prelude_pair)) (prelude_mk_pair) (if (name_eq n (n1 (quote Prod))) (init_prod_mk) Anon)))
         (None None)
         ((Some tg) (Some (Pair tg a))))))
    (_ None)))
;; a flag type's false and true
(fn wf_tags ((lk Linked) (t EType)) (Option (Pair Int Int))
  (match t
    ((ETCon n Nil)
     (if (name_eq n (prelude_bool)) (tags2 lk (prelude_false) (prelude_true))
     (if (name_eq n (n1 (quote Bool))) (tags2 lk (n2 (quote Bool) (quote false)) (n2 (quote Bool) (quote true))) None)))
    (_ None)))
;; the host's data as values of the declared types
(fn w_bytes ((lk Linked) (t EType) (bs (List Int))) (Option IVal)
  (match (wb_tags lk t) (None None) ((Some (Pair nl cs)) (Some (cells_in nl cs bs)))))
(fn w_argv ((lk Linked) (t EType) (args (List (List Int)))) (Option IVal)
  (match (wl_tags lk t)
    (None None)
    ((Some (Pair (Pair nl cs) et))
     (match (wb_tags lk et) (None None) ((Some (Pair bn bc)) (Some (argv_cells nl cs bn bc args)))))))
(fn argv_cells ((nl Int) (cs Int) (bn Int) (bc Int) (args (List (List Int)))) IVal
  (measure (struct args))
  (match args (Nil (IVCtor nl Nil)) ((Cons a r) (IVCtor cs (list (cells_in bn bc a) (argv_cells nl cs bn bc r))))))
(fn w_opt_bytes ((lk Linked) (t EType) (o (Option (List Int)))) (Option IVal)
  (match (wo_tags lk t)
    (None None)
    ((Some (Pair (Pair nn sm) et))
     (match (w_bytes lk et (match o ((Some bs) bs) (None Nil)))
       (None None)
       ((Some v) (Some (match o ((Some _) (IVCtor sm (list v))) (None (IVCtor nn Nil)))))))))
(fn w_flag ((lk Linked) (t EType) (b Bool)) (Option IVal)
  (match (wf_tags lk t) (None None) ((Some (Pair fl tr)) (Some (IVCtor (if b tr fl) Nil)))))
;; the first component's type of a pair-typed result, and the pair of a value with the World's token
(fn w_first_type ((lk Linked) (t EType) (wt EType)) (Option EType)
  (match (wp_first lk t wt) (None None) ((Some (Pair _ a)) (Some a))))
(fn w_paired ((lk Linked) (t EType) (wt EType) (a (Option IVal)) (tok IVal)) (Option IVal)
  (match (wp_first lk t wt)
    (None None)
    ((Some (Pair pt _)) (match a (None None) ((Some v) (Some (IVCtor pt (list v tok))))))))
;; a program's byte value read back, by the type of the parameter it was passed at
(fn r_bytes_at ((lk Linked) (ps (List EType)) (i Int) (v IVal)) (Option (List Int))
  (match (nth ps i)
    (None None)
    ((Some t) (match (wb_tags lk t) (None None) ((Some (Pair nl cs)) (cells_out nl cs v Nil (wire_budget)))))))
;; the World's type as the extern declares it: its last parameter's
(fn ext_world ((ps (List EType))) (Option EType)
  (measure (struct ps))
  (match ps (Nil None) ((Cons t Nil) (Some t)) ((Cons _ r) (ext_world r))))
;; the six host externs by short name, each value by its declared type; the program's World
;; value passes through, at its own type
(fn perform ((lk Linked) (short Symbol) (ps (List EType)) (rt EType) (args (List IVal)) (argv (List (List Int))) (w World)) (Pair (Pair (Option IVal) (List Int)) World)
  (match (ext_world ps)
    (None (Pair (Pair None Nil) w))
    ((Some wt) (perform_at lk short ps wt rt args argv w))))
;; the value, with the trace line of the call (empty where the extern is stuck)
(fn perform_at ((lk Linked) (short Symbol) (ps (List EType)) (wt EType) (rt EType) (args (List IVal)) (argv (List (List Int))) (w World)) (Pair (Pair (Option IVal) (List Int)) World)
  (if (sym_eq short (quote get_args))
    (match args
      ((Cons tok Nil) (Pair (Pair (w_paired lk rt wt (match (w_first_type lk rt wt) ((Some at) (w_argv lk at argv)) (None None)) tok) (append "get_args" (tr_args argv))) w))
      (_ (Pair (Pair None Nil) w)))
  (if (sym_eq short (quote read_file))
    (match args
      ((Cons path (Cons tok Nil))
       (match (Pair (r_bytes_at lk ps 0 path) (w_first_type lk rt wt))
         ((Pair (Some bs) (Some ot))
          (match (w_opt_bytes lk ot None)
            (None (Pair (Pair None Nil) w))
            ((Some _) (match (read_file bs w) ((Pair content w1) (Pair (Pair (w_paired lk rt wt (w_opt_bytes lk ot content) tok) (append "read_file " (append (tr_quote bs) (append " -> " (tr_opt content))))) w1))))))
         (_ (Pair (Pair None Nil) w))))
      (_ (Pair (Pair None Nil) w)))
  (if (sym_eq short (quote write))
    (match args
      ((Cons bytes (Cons tok Nil))
       (match (if (etype_eq rt wt) (r_bytes_at lk ps 0 bytes) None) (None (Pair (Pair None Nil) w)) ((Some bs) (Pair (Pair (Some tok) (append "write " (tr_quote bs))) (write bs w)))))
      (_ (Pair (Pair None Nil) w)))
  (if (sym_eq short (quote write_line))
    (match args
      ((Cons bytes (Cons tok Nil))
       (match (if (etype_eq rt wt) (r_bytes_at lk ps 0 bytes) None) (None (Pair (Pair None Nil) w)) ((Some bs) (Pair (Pair (Some tok) (append "write_line " (tr_quote bs))) (write_line bs w)))))
      (_ (Pair (Pair None Nil) w)))
  (if (sym_eq short (quote write_file))
    (match args
      ((Cons path (Cons bytes (Cons tok Nil)))
       (match (Pair (r_bytes_at lk ps 0 path) (Pair (r_bytes_at lk ps 1 bytes) (w_first_type lk rt wt)))
         ((Pair (Some pbs) (Pair (Some bs) (Some ft)))
          (match (w_flag lk ft False)
            (None (Pair (Pair None Nil) w))
            ((Some _) (match (write_file pbs bs w) ((Pair ok w1) (Pair (Pair (w_paired lk rt wt (w_flag lk ft ok) tok) (append "write_file " (append (tr_quote pbs) (append " " (append (tr_quote bs) (if ok " -> true" " -> false")))))) w1))))))
         (_ (Pair (Pair None Nil) w))))
      (_ (Pair (Pair None Nil) w)))
  (if (sym_eq short (quote exit))
    (match args
      ((Cons (IVInt code) (Cons tok Nil)) (if (etype_eq rt wt) (Pair (Pair (Some tok) (tr_exit_line args)) (exit code w)) (Pair (Pair None Nil) w)))
      (_ (Pair (Pair None Nil) w)))
    (Pair (Pair None Nil) w))))))))
