;;; v3/kernel/ev.shard — `ev`, the definition of "run" (v3/LANGUAGE.md §6.2,
;;; §6.7; FOUNDATION §4.4), and `run_prog`, the effectful driver with the
;;; checked entry of §9 (slice 7). Phase 2, slice 5.
;;;
;;; `ev : Prog → Name → List Val → Int → EvRes` is pure: a Prog is linked
;;; into this file's own representation — constructors as integer tags
;;; whose low bit says "second constructor of its type" (§6.2's `if` rule
;;; is one bit test), functions and externs as indices, primitives as
;;; operation codes (prog.shard's table), literals built once — and run as
;;; a machine with an explicit continuation: two tail-recursive steps,
;;; `ev_term` (a term in a frame under a continuation) and `ev_ret` (a
;;; value to a continuation), so the host's stack does not grow with the
;;; program's recursion and the machine can stop at an extern with its
;;; arguments and continuation in hand. Fuel is spent on function entry.
;;; `run_prog` performs each extern through the host's own extern of the
;;; same short name (kernel/host.shard's six) and resumes: §6.2's frontier
;;; loop without a search. No other file sees the linked representation.
;;; A primitive's outcome is three-valued (GPT-6 R51, 2026-09-13): a value, a
;;; GUARD failure (the input outside the operation's domain: a negative Nat, a
;;; zero divisor) or an EXHAUSTED resource (K's literal limits, `nat_size` and
;;; `nat_count`, checked BEFORE the work as tc.shard's `nat_apply` checks them)
;;; — distinct through `EvRes` (`EvStuck` against `EvExhausted`) and the
;;; driver, since a result past a limit says nothing about the input's validity.

(import "host.shard")
(import "prog.shard")
(import "intmap.shard")

;; ---- the linked representation ---------------------------------------------------------
(type IVal (IVCtor Int (List IVal)) (IVInt Int) (IVSym Symbol))
(type LPat (LPVar) (LPCtor Int (List LPat)) (LPInt Int) (LPSym Symbol))
(type LTerm
  (LBVar Int)
  (LLit IVal)
  (LCtor Int (List LTerm))
  (LCall Int (List LTerm))
  (LPrim Int (List LTerm))
  (LExt Int (List LTerm))
  (LMatch LTerm (List LArm))
  (LLet (List LTerm) LTerm)
  (LIf LTerm LTerm LTerm))
(type LArm (LArm LPat LTerm))
(type LFn
  (LBody Name Int LTerm)       ; a function: identity, parameter count, body
  (LExtern Name Symbol Int)    ; an extern: identity, its short name (the host's), parameter count
  (LUnlinked Name))            ; a sig fn no implementation was linked to
;; the wire's tags: nil cons none some pair false true — and, for the table's Nat set
;; (§7.5), Init's Bool.false Bool.true and Decidable.isFalse Decidable.isTrue
(type Wire (Wire Int Int Int Int Int Int Int Int Int Int Int))
(fn wire_nil ((w Wire)) Int (match w ((Wire a _ _ _ _ _ _ _ _ _ _) a)))
(fn wire_cons ((w Wire)) Int (match w ((Wire _ a _ _ _ _ _ _ _ _ _) a)))
(fn wire_none ((w Wire)) Int (match w ((Wire _ _ a _ _ _ _ _ _ _ _) a)))
(fn wire_some ((w Wire)) Int (match w ((Wire _ _ _ a _ _ _ _ _ _ _) a)))
(fn wire_pair ((w Wire)) Int (match w ((Wire _ _ _ _ a _ _ _ _ _ _) a)))
(fn wire_false ((w Wire)) Int (match w ((Wire _ _ _ _ _ a _ _ _ _ _) a)))
(fn wire_true ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ a _ _ _ _) a)))
(fn wire_bfalse ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ a _ _ _) a)))
(fn wire_btrue ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ a _ _) a)))
(fn wire_dfalse ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ _ a _) a)))
(fn wire_dtrue ((w Wire)) Int (match w ((Wire _ _ _ _ _ _ _ _ _ _ a) a)))
;; functions by index, constructor tags by identity, identities by tag, function indices by identity, the wire
(type Linked (Linked (IntMap LFn) (IntMap (List (Pair Name Int))) (IntMap Name) (IntMap (List (Pair Name Int))) Wire))
(fn lk_fns ((l Linked)) (IntMap LFn) (match l ((Linked f _ _ _ _) f)))
(fn lk_tags ((l Linked)) (IntMap (List (Pair Name Int))) (match l ((Linked _ t _ _ _) t)))
(fn lk_names ((l Linked)) (IntMap Name) (match l ((Linked _ _ n _ _) n)))
(fn lk_ids ((l Linked)) (IntMap (List (Pair Name Int))) (match l ((Linked _ _ _ i _) i)))
(fn lk_wire ((l Linked)) Wire (match l ((Linked _ _ _ _ w) w)))

;; a name-keyed map of ints (the environment's key, collisions by list)
(fn nmap_find ((m (IntMap (List (Pair Name Int)))) (n Name)) (Option Int)
  (match (im_find m (name_key n)) (None None) ((Some b) (assoc_int b n))))
(fn assoc_int ((b (List (Pair Name Int))) (n Name)) (Option Int)
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair k v) r) (if (name_eq k n) (Some v) (assoc_int r n)))))
(fn nmap_add ((m (IntMap (List (Pair Name Int)))) (n Name) (v Int)) (IntMap (List (Pair Name Int)))
  (let ((h (name_key n)))
    (im_insert m h (Cons (Pair n v) (match (im_find m h) ((Some b) b) (None Nil))))))
(fn fn_name ((lk Linked) (id Int)) Name
  (match (im_find (lk_fns lk) id)
    ((Some (LBody n _ _)) n)
    ((Some (LExtern n _ _)) n)
    ((Some (LUnlinked n)) n)
    (None Anon)))
(fn last_sym ((n Name)) Symbol (match n ((Str _ s) s) (_ (quote anon))))

;; ---- linking ----------------------------------------------------------------------------
(type LinkRes (LkOk Linked) (LkErr Symbol (List Int)))
;; constructor tags: 2k for the k-th constructor interned, plus one when it is the second of its type
(type Tags (Tags Int (IntMap (List (Pair Name Int))) (IntMap Name)))
(fn tag_of ((k Int) (ordinal Int)) Int (+ (* 2 k) (if (int_eq ordinal 1) 1 0)))
(fn intern_ctor ((t Tags) (c Name) (ordinal Int)) Tags
  (match t
    ((Tags k n2t t2n)
     (let ((tag (tag_of k ordinal)))
       (Tags (+ k 1) (nmap_add n2t c tag) (im_insert t2n tag c))))))
(fn intern_ctors ((t Tags) (cs (List ECtorDef)) (i Int)) Tags
  (measure (struct cs))
  (match cs (Nil t) ((Cons (ECtorDef c _) r) (intern_ctors (intern_ctor t c i) r (+ i 1)))))
(fn intern_decls ((t Tags) (ds (List EDecl))) Tags
  (measure (struct ds))
  (match ds
    (Nil t)
    ((Cons (EInd _ _ cs) r) (intern_decls (intern_ctors t cs 0) r))
    ((Cons _ r) (intern_decls t r))))
;; a wire name the program lacks is interned with its ordinal
(fn intern_wire ((t Tags) (c Name) (ordinal Int)) (Pair Tags Int)
  (match t
    ((Tags _ n2t _)
     (match (nmap_find n2t c)
       ((Some tag) (Pair t tag))
       (None (match (intern_ctor t c ordinal) ((Tags k2 nt2 t2) (Pair (Tags k2 nt2 t2) (tag_of (- k2 1) ordinal)))))))))
(fn wire_of ((t Tags)) (Pair Tags Wire)
  (match (intern_wire t (prelude_nil) 0)
    ((Pair t1 nl)
     (match (intern_wire t1 (prelude_cons) 1)
       ((Pair t2 cs)
        (match (intern_wire t2 (prelude_none) 0)
          ((Pair t3 nn)
           (match (intern_wire t3 (prelude_some) 1)
             ((Pair t4 sm)
              (match (intern_wire t4 (prelude_mk_pair) 0)
                ((Pair t5 pr)
                 (match (intern_wire t5 (prelude_false) 0)
                   ((Pair t6 fl)
                    (match (intern_wire t6 (prelude_true) 1)
                      ((Pair t7 tr)
                       (match (intern_wire t7 (n2 (quote Bool) (quote false)) 0)
                         ((Pair t8 bf)
                          (match (intern_wire t8 (n2 (quote Bool) (quote true)) 1)
                            ((Pair t9 bt)
                             (match (intern_wire t9 (n2 (quote Decidable) (quote isFalse)) 0)
                               ((Pair t10 df)
                                (match (intern_wire t10 (n2 (quote Decidable) (quote isTrue)) 1)
                                  ((Pair t11 dt) (Pair t11 (Wire nl cs nn sm pr fl tr bf bt df dt)))))))))))))))))))))))))
;; function indices
(fn index_fns ((ds (List EDecl)) (j Int) (ids (IntMap (List (Pair Name Int))))) (IntMap (List (Pair Name Int)))
  (measure (struct ds))
  (match ds
    (Nil ids)
    ((Cons (EFn n _ _ _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons (ESig n _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons (EExtern n _ _ _) r) (index_fns r (+ j 1) (nmap_add ids n j)))
    ((Cons _ r) (index_fns r j ids))))

(fn link ((p Prog)) LinkRes
  (match p
    ((Prog ds)
     (match (wire_of (intern_decls (Tags 0 IMEmpty IMEmpty) ds))
       ((Pair (Tags _ n2t t2n) wire)
        (let ((ids (index_fns ds 0 IMEmpty)))
          (let ((lk (Linked IMEmpty n2t t2n ids wire)))
            (match (lower_decls lk ds IMEmpty)
              ((Pair (Some (Pair e m)) _) (LkErr e m))
              ((Pair None fns) (LkOk (Linked fns n2t t2n ids wire)))))))))))
(fn lower_decls ((lk Linked) (ds (List EDecl)) (fns (IntMap LFn))) (Pair (Option (Pair Symbol (List Int))) (IntMap LFn))
  (measure (struct ds))
  (match ds
    (Nil (Pair None fns))
    ((Cons (EFn n _ ps _ _ body) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id)
        (match (lower lk body)
          ((Pair (Some (Pair e m)) _) (Pair (Some (Pair e m)) fns))
          ((Pair None t) (lower_decls lk r (im_insert fns id (LBody n (len ps) t))))))))
    ((Cons (ESig n _ _ _) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id) (lower_decls lk r (im_insert fns id (LUnlinked n))))))
    ((Cons (EExtern n _ ps _) r)
     (match (nmap_find (lk_ids lk) n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) fns))
       ((Some id) (lower_decls lk r (im_insert fns id (LExtern n (last_sym n) (len ps)))))))
    ((Cons _ r) (lower_decls lk r fns))))
;; a term into the linked representation
(fn lower ((lk Linked) (t ETerm)) (Pair (Option (Pair Symbol (List Int))) LTerm)
  (measure (struct t))
  (match t
    ((EBVar i) (Pair None (LBVar i)))
    ((ELit l) (Pair None (LLit (lit_val lk l))))
    ((ECtor c args)
     (match (nmap_find (lk_tags lk) c)
       (None (Pair (Some (Pair (quote unresolved) (show_name c))) (LBVar 0)))
       ((Some tag) (lower_args lk args (LCtor tag Nil) 0 tag))))
    ((ECall f args)
     (match (nmap_find (lk_ids lk) f)
       (None (Pair (Some (Pair (quote unresolved) (show_name f))) (LBVar 0)))
       ((Some id) (lower_args lk args (LCall id Nil) 1 id))))
    ((EPrim n args)
     (match (prim_find n)
       (None (Pair (Some (Pair (quote unresolved) (show_name n))) (LBVar 0)))
       ((Some (Prim code _)) (lower_args lk args (LPrim code Nil) 2 code))))
    ((EExt f args)
     (match (nmap_find (lk_ids lk) f)
       (None (Pair (Some (Pair (quote unresolved) (show_name f))) (LBVar 0)))
       ((Some id) (lower_args lk args (LExt id Nil) 3 id))))
    ((EMatch s arms)
     (match (lower lk s)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None ls)
        (match (lower_arms lk arms Nil)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None las) (Pair None (LMatch ls las)))))))
    ((ELet rs b)
     (match (lower_list lk rs Nil)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None lrs)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None lb) (Pair None (LLet lrs lb)))))))
    ((EIf a b c)
     (match (lower lk a)
       ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
       ((Pair None la)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
          ((Pair None lb)
           (match (lower lk c)
             ((Pair (Some e) _) (Pair (Some e) (LBVar 0)))
             ((Pair None lc) (Pair None (LIf la lb lc)))))))))))
;; the head's node over its lowered arguments (kind 0 ctor, 1 call, 2 prim, 3 ext)
(fn lower_args ((lk Linked) (args (List ETerm)) (empty LTerm) (kind Int) (head Int)) (Pair (Option (Pair Symbol (List Int))) LTerm)
  (match (lower_list lk args Nil)
    ((Pair (Some e) _) (Pair (Some e) empty))
    ((Pair None las)
     (Pair None (if (int_eq kind 0) (LCtor head las) (if (int_eq kind 1) (LCall head las) (if (int_eq kind 2) (LPrim head las) (LExt head las))))))))
(fn lower_list ((lk Linked) (ts (List ETerm)) (acc (List LTerm))) (Pair (Option (Pair Symbol (List Int))) (List LTerm))
  (measure (struct ts))
  (match ts
    (Nil (Pair None (rev acc)))
    ((Cons t r)
     (match (lower lk t)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lt) (lower_list lk r (Cons lt acc)))))))
(fn lower_arms ((lk Linked) (arms (List EArm)) (acc (List LArm))) (Pair (Option (Pair Symbol (List Int))) (List LArm))
  (measure (struct arms))
  (match arms
    (Nil (Pair None (rev acc)))
    ((Cons (EArm p b) r)
     (match (lower_pat lk p)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lp)
        (match (lower lk b)
          ((Pair (Some e) _) (Pair (Some e) Nil))
          ((Pair None lb) (lower_arms lk r (Cons (LArm lp lb) acc)))))))))
(fn lower_pat ((lk Linked) (p EPat)) (Pair (Option (Pair Symbol (List Int))) LPat)
  (measure (struct p))
  (match p
    (PVar (Pair None LPVar))
    ((PLit (LNat k)) (Pair None (LPInt k)))
    ((PLit (LInt k)) (Pair None (LPInt k)))
    ((PLit (LSym s)) (Pair None (LPSym s)))
    ((PLit (LStr _)) (Pair (Some (Pair (quote pattern_literal) "a string pattern")) LPVar))
    ((PCtor c subs)
     (match (nmap_find (lk_tags lk) c)
       (None (Pair (Some (Pair (quote unresolved) (show_name c))) LPVar))
       ((Some tag)
        (match (lower_pats lk subs Nil)
          ((Pair (Some e) _) (Pair (Some e) LPVar))
          ((Pair None lps) (Pair None (LPCtor tag lps)))))))))
(fn lower_pats ((lk Linked) (ps (List EPat)) (acc (List LPat))) (Pair (Option (Pair Symbol (List Int))) (List LPat))
  (measure (struct ps))
  (match ps
    (Nil (Pair None (rev acc)))
    ((Cons p r)
     (match (lower_pat lk p)
       ((Pair (Some e) _) (Pair (Some e) Nil))
       ((Pair None lp) (lower_pats lk r (Cons lp acc)))))))
(fn lit_val ((lk Linked) (l ELit)) IVal
  (match l
    ((LNat k) (IVInt k))
    ((LInt k) (IVInt k))
    ((LStr bs) (bytes_in lk bs))
    ((LSym s) (IVSym s))))

;; ---- the wire: the prelude's cells (§6.7) -------------------------------------------------
(fn bytes_in ((lk Linked) (bs (List Int))) IVal
  (measure (struct bs))
  (match bs
    (Nil (IVCtor (wire_nil (lk_wire lk)) Nil))
    ((Cons b r) (IVCtor (wire_cons (lk_wire lk)) (list (IVInt b) (bytes_in lk r))))))
(fn list_in ((lk Linked) (xs (List IVal))) IVal
  (measure (struct xs))
  (match xs
    (Nil (IVCtor (wire_nil (lk_wire lk)) Nil))
    ((Cons x r) (IVCtor (wire_cons (lk_wire lk)) (list x (list_in lk r))))))
(fn argv_in ((lk Linked) (args (List (List Int)))) IVal
  (measure (struct args))
  (match args
    (Nil (IVCtor (wire_nil (lk_wire lk)) Nil))
    ((Cons a r) (IVCtor (wire_cons (lk_wire lk)) (list (bytes_in lk a) (argv_in lk r))))))
;; a Cons chain of Int cells back to bytes; None when the value is not one
(fn bytes_out ((lk Linked) (v IVal) (acc (List Int)) (fuel Int)) (Option (List Int))
  (measure fuel)
  (if (lt fuel 0) None
  (match v
    ((IVCtor tag fields)
     (if (int_eq tag (wire_nil (lk_wire lk))) (Some (rev acc))
     (if (int_eq tag (wire_cons (lk_wire lk)))
       (match fields
         ((Cons (IVInt b) (Cons rest Nil)) (bytes_out lk rest (Cons b acc) (- fuel 1)))
         (_ None))
       None)))
    (_ None))))
(fn bool_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_true (lk_wire lk)) (wire_false (lk_wire lk))) Nil))
;; Init's Bool and Decidable cells: what the table's Nat set returns (§7.5)
(fn init_bool_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_btrue (lk_wire lk)) (wire_bfalse (lk_wire lk))) Nil))
(fn dec_cell ((lk Linked) (b Bool)) IVal (IVCtor (if b (wire_dtrue (lk_wire lk)) (wire_dfalse (lk_wire lk))) Nil))
(fn pair_cell ((lk Linked) (a IVal) (b IVal)) IVal (IVCtor (wire_pair (lk_wire lk)) (list a b)))
(fn some_cell ((lk Linked) (a IVal)) IVal (IVCtor (wire_some (lk_wire lk)) (list a)))
(fn none_cell ((lk Linked)) IVal (IVCtor (wire_none (lk_wire lk)) Nil))
(fn wire_budget () Int 1000000000)

;; ---- the machine (§6.7) --------------------------------------------------------------------
(type Kont
  (KHalt)
  (KArg Int Int (List IVal) (List LTerm) (List IVal) Int Kont)  ; kind, head, the values so far (last first), the terms to go, env, cur, next
  (KMatch (List LArm) (List IVal) Int Kont)
  (KLet (List LTerm) LTerm (List IVal) Int Kont)                ; the right-hand sides to go, the body, env, cur, next
  (KIf LTerm LTerm (List IVal) Int Kont))
(type Halt
  (HVal IVal)
  (HOut Int)                            ; the function whose entry exhausted the fuel
  (HStuck Symbol Int)                   ; the reason, the function
  (HExhausted Symbol Int)               ; a primitive's resource (nat_size, nat_count), the function
  (HExt Int (List IVal) Kont Int Int))  ; an extern to perform: its index, arguments, the continuation, cur, fuel

(fn ev_term ((lk Linked) (env (List IVal)) (t LTerm) (k Kont) (cur Int) (fuel Int)) Halt
  (match t
    ((LBVar i) (match (nth env i) ((Some v) (ev_ret lk v k cur fuel)) (None (HStuck (quote unbound) cur))))
    ((LLit v) (ev_ret lk v k cur fuel))
    ((LCtor tag args) (ev_args lk 0 tag Nil args env k cur fuel))
    ((LCall id args) (ev_args lk 1 id Nil args env k cur fuel))
    ((LPrim op args) (ev_args lk 2 op Nil args env k cur fuel))
    ((LExt id args) (ev_args lk 3 id Nil args env k cur fuel))
    ((LMatch s arms) (ev_term lk env s (KMatch arms env cur k) cur fuel))
    ((LLet rhss body)
     (match rhss
       (Nil (ev_term lk env body k cur fuel))
       ((Cons r1 rest) (ev_term lk env r1 (KLet rest body env cur k) cur fuel))))
    ((LIf c a b) (ev_term lk env c (KIf a b env cur k) cur fuel))))
;; the arguments left to right, then the head applied
(fn ev_args ((lk Linked) (kind Int) (head Int) (done (List IVal)) (rest (List LTerm)) (env (List IVal)) (k Kont) (cur Int) (fuel Int)) Halt
  (match rest
    (Nil (ev_apply lk kind head done k cur fuel))
    ((Cons a more) (ev_term lk env a (KArg kind head done more env cur k) cur fuel))))
(fn ev_ret ((lk Linked) (v IVal) (k Kont) (cur Int) (fuel Int)) Halt
  (match k
    (KHalt (HVal v))
    ((KArg kind head done rest env cur1 next) (ev_args lk kind head (Cons v done) rest env next cur1 fuel))
    ((KMatch arms env cur1 next) (ev_match lk v arms env next cur1 fuel))
    ((KLet rest body env cur1 next)
     (let ((env1 (Cons v env)))
       (match rest
         (Nil (ev_term lk env1 body next cur1 fuel))
         ((Cons r1 more) (ev_term lk env1 r1 (KLet more body env1 cur1 next) cur1 fuel)))))
    ((KIf a b env cur1 next)
     (match v
       ((IVCtor tag _) (ev_term lk env (if (int_eq (band tag 1) 1) a b) next cur1 fuel))
       (_ (HStuck (quote if_tag) cur1))))))
;; a saturated head over its values (last first): a cell, a call (one unit of fuel), a primitive, an extern
(fn ev_apply ((lk Linked) (kind Int) (head Int) (done (List IVal)) (k Kont) (cur Int) (fuel Int)) Halt
  (if (int_eq kind 0) (ev_ret lk (IVCtor head (rev done)) k cur fuel)
  (if (int_eq kind 1)
    (match (im_find (lk_fns lk) head)
      ((Some (LBody _ _ body)) (if (lt fuel 1) (HOut head) (ev_term lk done body k head (- fuel 1))))
      ((Some (LUnlinked _)) (HStuck (quote unlinked) head))
      (_ (HStuck (quote unknown_head) cur)))
  (if (int_eq kind 2)
    (match (prim_apply lk head (rev done))
      ((PrimVal v) (ev_ret lk v k cur fuel))
      (PrimGuard (HStuck (quote guard) cur))
      ((PrimOut r) (HExhausted r cur)))
    (HExt head (rev done) k cur fuel)))))
(fn ev_match ((lk Linked) (v IVal) (arms (List LArm)) (env (List IVal)) (k Kont) (cur Int) (fuel Int)) Halt
  (measure (struct arms))
  (match arms
    (Nil (HStuck (quote no_arm) cur))
    ((Cons (LArm p body) rest)
     (match (match_pat p v env)
       ((Some env1) (ev_term lk env1 body k cur fuel))
       (None (ev_match lk v rest env k cur fuel))))))
;; the pattern's variables pushed in capture order: the last one bound is index 0
(fn match_pat ((p LPat) (v IVal) (env (List IVal))) (Option (List IVal))
  (measure (struct p))
  (match p
    (LPVar (Some (Cons v env)))
    ((LPInt n) (match v ((IVInt m) (if (int_eq n m) (Some env) None)) (_ None)))
    ((LPSym s) (match v ((IVSym t) (if (sym_eq s t) (Some env) None)) (_ None)))
    ((LPCtor tag subs)
     (match v
       ((IVCtor t2 fields) (if (int_eq tag t2) (match_fields subs fields env) None))
       (_ None)))))
(fn match_fields ((ps (List LPat)) (vs (List IVal)) (env (List IVal))) (Option (List IVal))
  (measure (struct ps))
  (match ps
    (Nil (match vs (Nil (Some env)) (_ None)))
    ((Cons p pr)
     (match vs
       (Nil None)
       ((Cons v vr) (match (match_pat p v env) ((Some env1) (match_fields pr vr env1)) (None None)))))))

;; ---- the primitives (prog.shard's codes; §6.4) ----------------------------------------------
;; a primitive's outcome: a value; the guard failed (the input outside the operation's
;; domain); a resource exhausted (nat_size: a result past K's literal size, nat_count: a
;; count past 32 bits) — checked before the work, never a domain failure
(type PrimRes (PrimVal IVal) (PrimGuard) (PrimOut Symbol))
(fn prim_apply ((lk Linked) (code Int) (args (List IVal))) PrimRes
  (match args
    ((Cons a (Cons b Nil))
     (match a
       ((IVInt x) (match b ((IVInt y) (prim_ii lk code x y)) (_ PrimGuard)))
       ((IVSym s) (match b ((IVSym t) (if (int_eq code 5) (PrimVal (bool_cell lk (sym_eq s t))) PrimGuard)) (_ PrimGuard)))
       (_ PrimGuard)))
    ((Cons a Nil)
     (if (int_eq code 16)
       (match (bytes_out lk a Nil (wire_budget)) ((Some bs) (if (utf8_ok bs) (PrimVal (IVSym (sym_of_chars bs))) PrimGuard)) (None PrimGuard))
     (if (int_eq code 17)
       (match a ((IVSym s) (PrimVal (bytes_in lk (chars_of_sym s)))) (_ PrimGuard))
       PrimGuard)))
    (_ PrimGuard)))
;; sym_of_chars takes UTF-8 (the host decodes the bytes into the symbol's text): the guard is
;; validity — an invalid sequence is stuck, never handed to the host, whose refusal is fatal
(fn utf8_ok ((bs (List Int))) Bool
  (measure (struct bs))
  (match bs
    (Nil True)
    ((Cons b r)
     (if (bool_and (le 0 b) (le b 127)) (utf8_ok r)
     (if (bool_and (le 194 b) (le b 223)) (utf8_tail r 1 128 191)
     (if (int_eq b 224) (utf8_tail r 2 160 191)
     (if (bool_and (le 225 b) (le b 239)) (utf8_tail r 2 128 (if (int_eq b 237) 159 191))
     (if (int_eq b 240) (utf8_tail r 3 144 191)
     (if (bool_and (le 241 b) (le b 243)) (utf8_tail r 3 128 191)
     (if (int_eq b 244) (utf8_tail r 3 128 143)
       False))))))))))
;; k continuation bytes, the first within [lo, hi], the rest 128..191; then the rest of the text
(fn utf8_tail ((bs (List Int)) (k Int) (lo Int) (hi Int)) Bool
  (measure k)
  (if (le k 0) (utf8_ok bs)
    (match bs
      (Nil False)
      ((Cons b r) (if (bool_and (le lo b) (le b hi)) (utf8_tail r (- k 1) 128 191) False)))))
(fn shift_ok ((k Int)) Bool (bool_and (le 0 k) (lt k 64)))
(fn nonneg2 ((x Int) (y Int)) Bool (bool_and (le 0 x) (le 0 y)))
(fn prim_ii ((lk Linked) (code Int) (x Int) (y Int)) PrimRes
  (if (lt code 8)
    (if (int_eq code 0) (PrimVal (bool_cell lk (int_eq x y)))
    (if (int_eq code 1) (PrimVal (IVInt (+ x y)))
    (if (int_eq code 2) (PrimVal (IVInt (- x y)))
    (if (int_eq code 3) (PrimVal (bool_cell lk (lt x y)))
    (if (int_eq code 4) (PrimVal (bool_cell lk (le x y)))
    (if (int_eq code 6) (PrimVal (IVInt (band x y)))
    (if (int_eq code 7) (if (shift_ok y) (PrimVal (IVInt (bshr x y))) PrimGuard)
      PrimGuard)))))))
  (if (lt code 16)
    (if (int_eq code 8) (PrimVal (IVInt (* x y)))
    (if (int_eq code 9) (if (int_eq y 0) PrimGuard (PrimVal (IVInt (mod x y))))
    (if (int_eq code 10) (if (int_eq y 0) PrimGuard (PrimVal (IVInt (/ x y))))
    (if (int_eq code 11) (if (int_eq y 0) PrimGuard (PrimVal (IVInt (tmod x y))))
    (if (int_eq code 12) (if (int_eq y 0) PrimGuard (PrimVal (IVInt (ediv x y))))
    (if (int_eq code 13) (PrimVal (IVInt (bor x y)))
    (if (int_eq code 14) (PrimVal (IVInt (bxor x y)))
      (if (shift_ok y) (PrimVal (IVInt (bshl x y))) PrimGuard))))))))
  (if (lt code 22)
    (if (int_eq code 18) (PrimVal (IVInt (if (int_eq y 0) 0 (/ x y))))
    (if (int_eq code 19) (PrimVal (IVInt (if (int_eq y 0) x (tmod x y))))
    (if (int_eq code 20) (PrimVal (IVInt (if (int_eq y 0) 0 (ediv x y))))
    (if (int_eq code 21) (PrimVal (IVInt (if (int_eq y 0) x (mod x y))))
      PrimGuard))))
  (if (bool_not (nonneg2 x y)) PrimGuard
  (if (int_eq code 22) (PrimVal (IVInt (if (lt x y) 0 (- x y))))
  (if (int_eq code 23) (PrimVal (IVInt (band x y)))
  (if (int_eq code 24) (PrimVal (IVInt (bor x y)))
  (if (int_eq code 25) (PrimVal (IVInt (bxor x y)))
  (if (int_eq code 26)
    (if (int_eq x 0) (PrimVal (IVInt 0))   ; the zero shortcut first: no count, no size, no work
    (if (lt (count_max_ev) y) (PrimOut (quote nat_count))
    (if (lt (ev_nat_max_size) (+ (ev_nat_bytes x) (+ (ediv y 8) 1))) (PrimOut (quote nat_size))
      (PrimVal (IVInt (* x (nat_pow_ev 2 y)))))))
  (if (int_eq code 27) (PrimVal (IVInt (nat_shr x y)))
    (nat_prim lk code x y))))))))))))
;; K's accelerated Nat set under its identities (§7.5; tc.shard's nat_apply): total where
;; Lean's are — Nat.div x 0 = 0, Nat.mod x 0 = x — and exhausted where K exhausts: a result
;; past K's literal size (nat_max_size, 2^27 bytes), a power's or a shift's count past 32 bits
;; (count_max), a power's size estimate — each before the work, as K's. A sum or a product is
;; measured after: its size is bounded by its operands', which are literals under the cap.
(fn nat_prim ((lk Linked) (code Int) (x Int) (y Int)) PrimRes
  (if (int_eq code 28) (nat_sized (+ x y))
  (if (int_eq code 29) (nat_sized (* x y))
  (if (int_eq code 30) (PrimVal (IVInt (if (int_eq y 0) 0 (/ x y))))
  (if (int_eq code 31) (PrimVal (IVInt (if (int_eq y 0) x (mod x y))))
  (if (int_eq code 32) (PrimVal (IVInt (nat_gcd_ev x y)))
  (if (int_eq code 33)
    (if (lt (count_max_ev) y) (PrimOut (quote nat_count))
    (if (lt y 1) (nat_sized (nat_pow_ev x y))   ; x^0 = 1; the size estimate below divides by y
    (if (bool_and (lt 1 x) (lt (ediv (ev_nat_max_size) y) (ev_nat_bytes x))) (PrimOut (quote nat_size))
      (nat_sized (nat_pow_ev x y)))))
  (if (int_eq code 34) (PrimVal (init_bool_cell lk (int_eq x y)))
  (if (int_eq code 35) (PrimVal (init_bool_cell lk (le x y)))
  (if (int_eq code 36) (PrimVal (dec_cell lk (int_eq x y)))
  (if (int_eq code 37) (PrimVal (dec_cell lk (lt x y)))
  (if (int_eq code 38) (PrimVal (dec_cell lk (le x y)))
    PrimGuard))))))))))))
(fn ev_nat_max_size () Int 134217728)
(fn ev_nat_bytes_go ((n Int) (acc Int)) Int
  (measure n)
  (if (le n 0) acc (ev_nat_bytes_go (ediv n 256) (+ acc 1))))
(fn ev_nat_bytes ((n Int)) Int (ev_nat_bytes_go n 0))
(fn count_max_ev () Int 4294967295)
(fn nat_sized ((r Int)) PrimRes (if (lt (ev_nat_max_size) (ev_nat_bytes r)) (PrimOut (quote nat_size)) (PrimVal (IVInt r))))
(fn nat_gcd_ev ((a Int) (b Int)) Int
  (measure b)
  (if (le b 0) a (nat_gcd_ev b (mod a b))))
(fn nat_pow_ev ((b Int) (e Int)) Int
  (measure e)
  (if (le e 0) 1
    (let ((h (nat_pow_ev b (ediv e 2))))
      (if (int_eq (mod e 2) 0) (* h h) (* (* h h) b)))))
;; Nat.shiftLeft n k = n · 2^k (K's form, after the guards above) and Nat.shiftRight n k =
;; n / 2^k, total (Lean's), the right shift in steps of 62 bits over the host's guarded
;; shift, stopping at zero — so its work is bounded by n's size, never by k
(fn nat_shr ((n Int) (k Int)) Int
  (measure k)
  (if (int_eq n 0) 0 (if (lt k 62) (bshr n k) (nat_shr (bshr n 62) (- k 62)))))

;; ---- `ev` (§6.2) ----------------------------------------------------------------------------
(fn val_in ((lk Linked) (v Val)) (Option IVal)
  (measure (struct v))
  (match v
    ((VInt k) (Some (IVInt k)))
    ((VSym s) (Some (IVSym s)))
    ((VCtor c vs)
     (match (nmap_find (lk_tags lk) c)
       (None None)
       ((Some tag) (match (vals_in lk vs Nil) (None None) ((Some ivs) (Some (IVCtor tag ivs)))))))))
(fn vals_in ((lk Linked) (vs (List Val)) (acc (List IVal))) (Option (List IVal))
  (measure (struct vs))
  (match vs
    (Nil (Some (rev acc)))
    ((Cons v r) (match (val_in lk v) (None None) ((Some iv) (vals_in lk r (Cons iv acc)))))))
(fn val_out ((lk Linked) (v IVal)) Val
  (measure (struct v))
  (match v
    ((IVInt k) (VInt k))
    ((IVSym s) (VSym s))
    ((IVCtor tag vs) (VCtor (match (im_find (lk_names lk) tag) ((Some n) n) (None Anon)) (vals_out lk vs)))))
(fn vals_out ((lk Linked) (vs (List IVal))) (List Val)
  (measure (struct vs))
  (match vs (Nil Nil) ((Cons v r) (Cons (val_out lk v) (vals_out lk r)))))
(fn halt_res ((lk Linked) (h Halt)) EvRes
  (match h
    ((HVal v) (EvOk (val_out lk v)))
    ((HOut _) EvOut)
    ((HStuck r id) (EvStuck r (fn_name lk id)))
    ((HExhausted r id) (EvExhausted r (fn_name lk id)))
    ((HExt _ _ _ cur _) (EvStuck (quote extern) (fn_name lk cur)))))
;; the function f of the program p on args, under fuel: a value, out of fuel, or stuck
(fn ev ((p Prog) (f Name) (args (List Val)) (fuel Int)) EvRes
  (match (link p)
    ((LkErr e _) (EvStuck e f))
    ((LkOk lk)
     (match (nmap_find (lk_ids lk) f)
       (None (EvStuck (quote unknown_head) f))
       ((Some id)
        (match (vals_in lk args Nil)
          (None (EvStuck (quote bad_value) f))
          ((Some ivs) (halt_res lk (ev_apply lk 1 id (rev ivs) KHalt id fuel)))))))))

;; ---- `run_prog`: the effectful driver (§6.2, §6.7; the checked entry, §9) --------------------
(type RunRes (RunOk) (RunOut Name) (RunExhausted Symbol Name) (RunStuck Symbol Name) (RunLink Symbol (List Int)) (RunArg Int Symbol (List Int)))   ; RunExhausted: a primitive's resource; RunArg: the argument's position, the reason, its text
;; f on the World with the program's arguments: the parameters before the World are the checked
;; entry (§9) — each command-line argument validated against its parameter's E type before ev
;; runs — the World the last parameter's first constructor; every extern performed by the host's
(fn run_prog ((p Prog) (f Name) (argv (List (List Int))) (fuel Int) (w World)) (Pair RunRes World)
  (match (link p)
    ((LkErr e m) (Pair (RunLink e m) w))
    ((LkOk lk)
     (match (nmap_find (lk_ids lk) f)
       (None (Pair (RunLink (quote unknown_head) (show_name f)) w))
       ((Some id)
        (match (entry_shape lk p f)
          (None (Pair (RunLink (quote bad_entry) (append (show_name f) " does not take a World last")) w))
          ((Some (Pair params token))   ; the machine takes its arguments last first
           (match (if (int_eq (len params) 0) (ArgsOk Nil) (args_in lk p f params argv 1 Nil))   ; a World-only entry takes the raw list through get_args (§9)
             ((ArgsBad r) (Pair r w))
             ((ArgsOk ivs) (run_loop lk (ev_apply lk 1 id (rev (append ivs (list token))) KHalt id fuel) argv w))))))))))
;; the entry's parameters before its last, and the World: the last parameter's type, its first
;; constructor with its fields zero
(fn entry_shape ((lk Linked) (p Prog) (f Name)) (Option (Pair (List EType) IVal))
  (match (prog_find p f)
    ((Some (EFn _ _ ps _ _ _))
     (match (split_last ps Nil)
       (None None)
       ((Some (Pair params wn))
        (match (prog_find p wn)
          ((Some (EInd _ _ (Cons (ECtorDef c fs) _)))
           (match (nmap_find (lk_tags lk) c) ((Some tag) (Some (Pair params (IVCtor tag (zeros_iv (len fs)))))) (None None)))
          (_ None)))))
    (_ None)))
(fn split_last ((ps (List EType)) (acc (List EType))) (Option (Pair (List EType) Name))
  (measure (struct ps))
  (match ps
    (Nil None)
    ((Cons (ETCon n _) Nil) (Some (Pair (rev acc) n)))
    ((Cons _ Nil) None)
    ((Cons t r) (split_last r (Cons t acc)))))
(fn zeros_iv ((k Int)) (List IVal) (measure k) (if (lt k 1) Nil (Cons (IVInt 0) (zeros_iv (- k 1)))))
;; the checked entry (§9): the arguments against the parameters in order, i the 1-based position;
;; an argument that does not parse is refused with its position and text, never a file span
(type ArgsRes (ArgsOk (List IVal)) (ArgsBad RunRes))
(type ArgRes (ArgOk IVal) (ArgBad Symbol) (ArgType (List Int)))
(fn args_in ((lk Linked) (p Prog) (f Name) (params (List EType)) (argv (List (List Int))) (i Int) (acc (List IVal))) ArgsRes
  (measure (struct params))
  (match params
    (Nil (match argv
           (Nil (ArgsOk (rev acc)))
           (_ (ArgsBad (RunArg i (quote argument_count) (count_msg f (- i 1) (+ (- i 1) (len argv))))))))
    ((Cons t r)
     (match argv
       (Nil (ArgsBad (RunArg i (quote argument_count) (count_msg f (+ (- i 1) (len params)) (- i 1)))))
       ((Cons a ar)
        (match (arg_in lk p t a)
          ((ArgOk v) (args_in lk p f r ar (+ i 1) (Cons v acc)))
          ((ArgBad reason) (ArgsBad (RunArg i reason a)))
          ((ArgType msg) (ArgsBad (RunLink (quote bad_entry) (append (show_name f) (append ": parameter " (append (show_nat i) (append " " msg)))))))))))))
(fn count_msg ((f Name) (takes Int) (got Int)) (List Int)
  (append (show_name f) (append " takes " (append (show_nat takes) (append " argument(s), got " (show_nat got))))))
;; one argument against one parameter type: Int, Nat, or a two-constructor list type taking the bytes
(fn arg_in ((lk Linked) (p Prog) (t EType) (a (List Int))) ArgRes
  (match t
    ((ETCon n _)
     (if (name_eq n (n1 (quote Int))) (match (arg_int a) ((Some k) (ArgOk (IVInt k))) (None (ArgBad (quote not_an_int))))
     (if (name_eq n (n1 (quote Nat))) (match (arg_nat a) ((Some k) (ArgOk (IVInt k))) (None (ArgBad (quote not_a_nat))))
       (match (list_ctors t)
         ((Some (Pair nl cs))
          (match (nmap_find (lk_tags lk) nl)
            (None (ArgType (unsupplied n)))
            ((Some tnl) (match (nmap_find (lk_tags lk) cs) (None (ArgType (unsupplied n))) ((Some tcs) (ArgOk (cells_in tnl tcs a)))))))
         (None (ArgType (unsupplied n)))))))
    (_ (ArgType "has a type variable's type, which no command-line argument supplies (§9)"))))
(fn unsupplied ((n Name)) (List Int)
  (append "has type " (append (show_name n) ", which no command-line argument supplies (§9: Int, Nat, the prelude's (List Int), Init's (List Nat) or (List Int))")))
;; the byte-list codecs, by identity and element type (§9; GPT-6 R59, slice 10): the prelude's
;; (List Int), Init's (List Nat) and (List Int) — never a shape. Before: any two-constructor
;; type with a nullary first and a binary second constructor took the bytes, so a
;; `(type Tree (Empty) (Branch Tree Tree))` entry received Branch cells with integers in its
;; Tree fields — a value of no type, stuck at the first match on it.
(fn list_ctors ((t EType)) (Option (Pair Name Name))
  (match t
    ((ETCon n (Cons (ETCon e Nil) Nil))
     (if (bool_and (name_eq n (prelude_list)) (name_eq e (n1 (quote Int)))) (Some (Pair (prelude_nil) (prelude_cons)))
     (if (bool_and (name_eq n (n1 (quote List))) (bool_or (name_eq e (n1 (quote Nat))) (name_eq e (n1 (quote Int)))))
       (Some (Pair (n2 (quote List) (quote nil)) (n2 (quote List) (quote cons))))
       None)))
    (_ None)))
(fn cells_in ((nl Int) (cs Int) (bs (List Int))) IVal
  (measure (struct bs))
  (match bs (Nil (IVCtor nl Nil)) ((Cons b r) (IVCtor cs (list (IVInt b) (cells_in nl cs r))))))
(fn arg_nat ((a (List Int))) (Option Int)
  (match a (Nil None) (_ (if (arg_all_digits a) (Some (arg_digits a 0)) None))))
(fn arg_int ((a (List Int))) (Option Int)
  (match a
    ((Cons b r) (if (int_eq b 45) (match (arg_nat r) ((Some k) (Some (- 0 k))) (None None)) (arg_nat a)))
    (Nil None)))
(fn arg_all_digits ((bs (List Int))) Bool
  (measure (struct bs))
  (match bs (Nil True) ((Cons b r) (if (bool_and (le 48 b) (le b 57)) (arg_all_digits r) False))))
(fn arg_digits ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs (Nil acc) ((Cons b r) (arg_digits r (+ (* acc 10) (- b 48))))))
(fn run_loop ((lk Linked) (h Halt) (argv (List (List Int))) (w World)) (Pair RunRes World)
  (match h
    ((HVal _) (Pair RunOk w))
    ((HOut id) (Pair (RunOut (fn_name lk id)) w))
    ((HStuck r id) (Pair (RunStuck r (fn_name lk id)) w))
    ((HExhausted r id) (Pair (RunExhausted r (fn_name lk id)) w))
    ((HExt id args k cur fuel)
     (match (im_find (lk_fns lk) id)
       ((Some (LExtern _ short _))
        (match (perform lk short args argv w)
          ((Pair (Some v) w1) (run_loop lk (ev_ret lk v k cur fuel) argv w1))
          ((Pair None w1) (Pair (RunStuck (quote extern) (fn_name lk id)) w1))))
       (_ (Pair (RunStuck (quote extern) (fn_name lk cur)) w))))))
;; the six host externs by short name; the program's World value passes through
(fn perform ((lk Linked) (short Symbol) (args (List IVal)) (argv (List (List Int))) (w World)) (Pair (Option IVal) World)
  (if (sym_eq short (quote get_args))
    (match args ((Cons tok Nil) (Pair (Some (pair_cell lk (argv_in lk argv) tok)) w)) (_ (Pair None w)))
  (if (sym_eq short (quote read_file))
    (match args
      ((Cons path (Cons tok Nil))
       (match (bytes_out lk path Nil (wire_budget))
         (None (Pair None w))
         ((Some bs)
          (match (read_file bs w)
            ((Pair None w1) (Pair (Some (pair_cell lk (none_cell lk) tok)) w1))
            ((Pair (Some content) w1) (Pair (Some (pair_cell lk (some_cell lk (bytes_in lk content)) tok)) w1))))))
      (_ (Pair None w)))
  (if (sym_eq short (quote write))
    (match args
      ((Cons bytes (Cons tok Nil))
       (match (bytes_out lk bytes Nil (wire_budget)) (None (Pair None w)) ((Some bs) (Pair (Some tok) (write bs w)))))
      (_ (Pair None w)))
  (if (sym_eq short (quote write_line))
    (match args
      ((Cons bytes (Cons tok Nil))
       (match (bytes_out lk bytes Nil (wire_budget)) (None (Pair None w)) ((Some bs) (Pair (Some tok) (write_line bs w)))))
      (_ (Pair None w)))
  (if (sym_eq short (quote write_file))
    (match args
      ((Cons path (Cons bytes (Cons tok Nil)))
       (match (bytes_out lk path Nil (wire_budget))
         (None (Pair None w))
         ((Some ps)
          (match (bytes_out lk bytes Nil (wire_budget))
            (None (Pair None w))
            ((Some bs) (match (write_file ps bs w) ((Pair ok w1) (Pair (Some (pair_cell lk (bool_cell lk ok) tok)) w1))))))))
      (_ (Pair None w)))
  (if (sym_eq short (quote exit))
    (match args
      ((Cons (IVInt code) (Cons tok Nil)) (Pair (Some tok) (exit code w)))
      (_ (Pair None w)))
    (Pair None w))))))))
