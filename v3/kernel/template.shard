;;; v3/kernel/template.shard — instances of templates.
;;; A template is a `fn` with a static parameter — a function-typed binder
;;; (erase.shard's BStatic) — defined in K as any fn is (define.shard) and holding no program of
;;; its own. A body that calls it demands an **instance**: the template at a tuple of shapes
;;; (erasure.shard's Shape — an identity and a captured count, never the captured values) and
;;; closed type arguments. This file builds one: its E program — the template's body erased
;;; with each static parameter bound to its shape (EKShape), the captured values its leading
;;; parameters group by group, then the template's runtime parameters —, its L definition —
;;; the template applied to the type arguments, the shapes' L terms over the captured binders
;;; and the runtime binders, so the instance is definitionally the specialized body —, and
;;; its equations — the template's `eq_N`, each instantiated and restated over the instance,
;;; proven by the template's own theorem applied, which K accepts through the unfolding.
;;; The loader admits what this file returns (loader.shard's build_demands) and records
;;; INSTANCE; a lambda the body lifts and an instance it demands in turn come back with it.
(import "erasure.shard")
(import "realize.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.classify)
(use kernel.decl)
(use kernel.descent)
(use kernel.erase)
(use kernel.erasure)
(use kernel.kw)
(use kernel.elab El el_w el_cx)
(use kernel.etable)
(use kernel.etable.EBind)
(use kernel.classify.EDemand)
(use kernel.classify.EShape)
(use kernel.expr)
(use kernel.matcher)
(use kernel.name)
(use kernel.predef)
(use kernel.prog)
(use kernel.realize)
(use kernel.scope)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erasure.Demand)
(use kernel.erasure.EKind)
(use kernel.erasure.ErEnt)
(use kernel.erasure.ErRes)
(use kernel.erasure.Either5r)
(use kernel.erasure.Lifted)
(use kernel.erasure.Shape)
(use kernel.erasure.Tr)
(use kernel.etable.ESt)
(use kernel.expr.Expr)
(use kernel.level)
(use kernel.predef.PdRec)
(use kernel.predef.PreDef)
(use kernel.prog.EDecl)
(use kernel.prog.ERec)
(use kernel.prog.EType)
(use kernel.realize.Either3)
(use kernel.scope.Scope)

;; a template as the loader keeps it: its pre-definition (the body and the walk that
;; elaborated it), its binders' roles, its result's E type
;; a template's carrier: a fn's pre-definition (its self-local, its callee-locals, its declared
;; type and binders), or a realize's — the result's L type over the telescope's locals, the
;; constant's levels and its equations' identities as the realizing module declared them (a
;; supplied realize with a static binder is a template as a fn is)
(type TmKind (TmFn PreDef) (TmRealize Expr (List Level) (List Name)))
;; the template: its identity, the elaboration state its body was read in (the binders' names),
;; the body, the recursion clause, the binders with their roles, the result's E type, its kind
(type Template (Template Name El Expr PdRec (List TBind) EType TmKind))
(fn tm_name ((tm Template)) Name
  (match tm
    ((Template n _ _ _ _ _ _) n)))
(fn tm_state ((tm Template)) El
  (match tm
    ((Template _ e _ _ _ _ _) e)))
(fn tm_body ((tm Template)) Expr
  (match tm
    ((Template _ _ b _ _ _ _) b)))
(fn tm_rec ((tm Template)) PdRec
  (match tm
    ((Template _ _ _ r _ _ _) r)))
(fn tm_binds ((tm Template)) (List TBind)
  (match tm
    ((Template _ _ _ _ bs _ _) bs)))
(fn tm_rt ((tm Template)) EType
  (match tm
    ((Template _ _ _ _ _ rt _) rt)))
(fn tm_kind ((tm Template)) TmKind
  (match tm
    ((Template _ _ _ _ _ _ k) k)))
(fn tm_of_fn ((pd PreDef) (binds (List TBind)) (rt EType)) Template
  (Template (pd_name pd) (pd_state pd) (pd_body pd) (pd_rec pd) binds rt (TmFn pd)))
;; the entries beside the binders': a fn's self-local as the template, its callee-locals; a
;; realize's self-call names its constant (erase_const_at's owner)
(fn tm_self_ents ((tm Template)) (List ErEnt)
  (match (tm_kind tm)
    ((TmFn pd)
     (cons (ErEnt (fvar_id_of (pd_self pd)) (EKTemplate (tm_name tm))) (callee_ents (pd_callees pd))))
    ((TmRealize _ _ _) nil)))
(fn tm_levels ((tm Template)) (List Level)
  (match (tm_kind tm)
    ((TmFn _) nil)
    ((TmRealize _ ls _) ls)))
;; the result's L type over the binders' locals
(fn tm_result ((t Tr) (tm Template)) (Prod Tr (Option Expr))
  (match (tm_kind tm)
    ((TmFn pd)
     (match (mt_inst_args (Tr.w t) (pd_type pd) (pd_binders pd))
       ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
    ((TmRealize rl _ _) (Prod.mk t (some rl)))))
;; the template's equation i: a fn's NAME.eq_i (None past the environment's); a realize's i-th as declared
(fn tm_eq_name ((env CheckedEnv) (tm Template) (i Int)) (Option Name)
  (match (tm_kind tm)
    ((TmFn _)
     (let ((eqn (name_append (tm_name tm) (nm_eq_n i))))
       (match (env_find env eqn)
         ((some _) (some eqn))
         (none none))))
    ((TmRealize _ _ eqs) (nth eqs (- i 1)))))
;; the template's written binders as the E-first reader takes them: a static binder's
;; domains and result as E types over the type parameters' locals (static_etypes over the local's
;; type in the elaborator's context), a data binder's E type, a package binder; a type or an
;; erased binder is not written. None when a static binder's type reads as no function type —
;; binder_role read the same type, so this is never reached by a template that checked
(fn tm_ebinds ((es ESt) (sc Scope) (tm Template)) (Prod ESt (Option (List EBind)))
  (match (tm_ebinds_go (el_w (tm_state tm)) es sc (tm_binds tm) (tbind_types (tm_binds tm)) nil)
    ((Prod.mk (Prod.mk _ es1) r) (Prod.mk es1 r))))
(fn tm_ebinds_go
  ((w W) (es ESt) (sc Scope) (binds (List TBind)) (tps (List Expr)) (acc (List EBind)))
  (Prod (Prod W ESt) (Option (List EBind)))
  (measure (struct binds))
  (match binds
    (nil (Prod.mk (Prod.mk w es) (some (rev acc))))
    ((cons (TBind _ role fv) r)
     (match role
       (BType (tm_ebinds_go w es sc r tps acc))
       (BErased (tm_ebinds_go w es sc r tps acc))
       ((BData t) (tm_ebinds_go w es sc r tps (cons (EBData t) acc)))
       ((BStatic k)
        (if (= k 0) (tm_ebinds_go w es sc r tps (cons EBPackage acc))
        (match (w_local_type w (fvar_id_of fv))
          (none (Prod.mk (Prod.mk w es) none))
          ((some ty)
           (match (static_etypes w es sc ty tps nil (budget_depth))
             ((Prod.mk (Prod.mk w1 es1) none) (Prod.mk (Prod.mk w1 es1) none))
             ((Prod.mk (Prod.mk w1 es1) (some ts))
              (tm_ebinds_go w1 es1 sc r tps
                (cons (EBStatic (take (- (len ts) 1) ts) (last_etype ts)) acc))))))))))))
(fn last_etype ((ts (List EType))) EType
  (measure (struct ts))
  (match ts
    (nil (ETVar 0))
    ((cons t nil) t)
    ((cons _ r) (last_etype r))))
;; the static binders' names, as the form wrote them (the TEMPLATE record)
(fn template_statics ((tm Template)) (List Name)
  (static_names (cx_bound (el_cx (tm_state tm))) (tm_binds tm)))
(fn static_names ((bs (List (Prod Name Expr))) (binds (List TBind))) (List Name)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ (BStatic _) fv) r)
     (cons (tm_bound_name bs (fvar_id_of fv)) (static_names bs r)))
    ((cons _ r) (static_names bs r))))
(fn tm_bound_name ((bs (List (Prod Name Expr))) (id Int)) Name
  (measure (struct bs))
  (match bs
    (nil (n1 (sym "x")))
    ((cons (Prod.mk n (FVar _ j)) r) (if (= id j) n (tm_bound_name r id)))
    ((cons _ r) (tm_bound_name r id))))
;; two demands of one name agree on their arguments: the type arguments and each shape's
;; identity, arity, leading arguments and captured types — a second taking at other arguments
;; under the same name is refused by the loader (instance_clash), never silently reused
(fn demand_same ((a Demand) (b Demand)) Bool
  (match a
    ((Demand _ ca tla _ sa)
     (match b
       ((Demand _ cb tlb _ sb)
        (bool_and (name_eq ca cb) (bool_and (exprs_same tla tlb) (shapes_same sa sb))))))))
(fn exprs_same ((as (List Expr)) (bs (List Expr))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a ar)
     (match bs
       ((cons b br) (bool_and (expr_eq a b) (exprs_same ar br)))
       (nil false)))))
(fn opt_exprs_same ((as (List (Option Expr))) (bs (List (Option Expr)))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a ar)
     (match bs
       (nil false)
       ((cons b br)
        (bool_and
          (match a
            ((some x)
             (match b
               ((some y) (expr_eq x y))
               (none false)))
            (none
              (match b
                (none true)
                (_ false))))
          (opt_exprs_same ar br)))))))
(fn shapes_same ((as (List Shape)) (bs (List Shape))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a ar)
     (match bs
       (nil false)
       ((cons b br)
        (bool_and (expr_eq (shape_head a) (shape_head b))
          (bool_and (= (shape_arity a) (shape_arity b))
            (bool_and (opt_exprs_same (shape_leading a) (shape_leading b))
              (bool_and (exprs_same (shape_captured a) (shape_captured b)) (shapes_same ar br))))))))))

;; ---- the template's declaration checked ---------------------------------------------------
;; the body erased once with each static parameter at a placeholder shape — the parameter's own
;; name, nothing captured —: a static parameter in a runtime position, applied as a static
;; argument, or under a lambda is refused here, at the declaration, as the
;; classifier enforces the escape rule; and a self-call at other shapes is the type-growing
;; recursion. The program, the lambdas and the demands of this erasure are discarded
(fn check_template ((es ESt) (sc Scope) (tm Template)) (Option (Prod Symbol (List Int)))
  (let ((c (tm_name tm)) (binds (tm_binds tm)))
    (let ((shapes (placeholder_shapes (cx_bound (el_cx (tm_state tm))) binds)))
      (let ((name (instance_name sc c (placeholder_types (count_types binds) 0) shapes)))
        (match (inst_env binds shapes -1 nil nil 0)
          ((Prod.mk ents (Prod.mk ncap _))
           (let
             ((env0 (append (rev ents) (tm_self_ents tm)))
              (t0 (tr_own (tr_new (el_w (tm_state tm)) es sc c (tbind_types binds)) c name binds)))
             (match (inst_rec t0 env0 (tm_rec tm) binds (tbind_types binds) ncap)
               ((Prod.mk _ (Left5r e m)) (some (Prod.mk e m)))
               ((Prod.mk t1 (Right5r _))
                (match (erase t1 env0 (tm_body tm) (budget_depth))
                  ((ErErr e m) (some (Prod.mk e m)))
                  ((ErOk _ _) none)))))))))))
(fn placeholder_shapes ((bs (List (Prod Name Expr))) (binds (List TBind))) (List Shape)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ (BStatic k) fv) r)
     (cons
       (Shape (mk_const (n1 (sym_of_chars (show_name (tm_bound_name bs (fvar_id_of fv))))) nil) none
         k
         nil
         nil)
       (placeholder_shapes bs r)))
    ((cons _ r) (placeholder_shapes bs r))))
(fn placeholder_types ((n Int) (i Int)) (List EType)
  (measure (Int.natAbs (- n i)))
  (if (<= n i) nil (cons (ETVar i) (placeholder_types n (+ i 1)))))
(fulfills placeholder_types.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))

;; ---- the instance -----------------------------------------------------------------------------
(type InstRes
  (InstOk ESt EDecl Declaration (List Declaration) (List Lifted) (List Demand))
  (InstErr Symbol (List Int)))
;; the instance's program — the half both routes share (an E-first taker has no L
;; half): the body at the type arguments, the entries, the recursion, the erasure, the captured
;; values' types as the program's leading parameter types
(type PgRes (PgOk Tr EDecl) (PgErr Symbol (List Int)))
(fn build_program ((es ESt) (sc Scope) (tm Template) (d Demand)) PgRes
  (let ((binds (tm_binds tm)))
    (match d
      ((Demand name c tyl tye shapes)
       (if (bool_not (= (len tye) (count_types binds)))
         (PgErr (sym "function_value")
           (append (show_name c)
             (utf8 ": the instance's type arguments do not match the template's type parameters")))
       (if (bool_not (= (len shapes) (count_static binds)))
         (PgErr (sym "function_value")
           (append (show_name c)
             (utf8 ": the instance's shapes do not match the template's static parameters")))
         (let ((t0 (tr_own (tr_new (el_w (tm_state tm)) es sc name nil) c name binds)))
           (match (subst_types t0 (tm_body tm) binds tyl)
             ((Prod.mk t1 body1)
              (match (inst_env binds shapes -1 nil nil 0)
                ((Prod.mk ents (Prod.mk ncap _))
                 (let ((env0 (append (rev ents) (tm_self_ents tm))))
                   (match (inst_rec t1 env0 (tm_rec tm) binds tyl ncap)
                     ((Prod.mk _ (Left5r e m)) (PgErr e m))
                     ((Prod.mk t2 (Right5r rec))
                      (match (erase t2 env0 body1 (budget_depth))
                        ((ErErr e m) (PgErr e m))
                        ((ErOk t3 ebody)
                         (match (captured_etypes t3 shapes nil)
                           ((Prod.mk t4 none)
                            (PgErr (sym "function_value")
                              (append (show_name c) (utf8 ": a captured value's type is no E type"))))
                           ((Prod.mk t4 (some cetys))
                            (PgOk t4
                              (EFn name 0 (append cetys (subst_tys tye (bind_ptypes binds)))
                                (subst_ty tye (tm_rt tm))
                                rec
                                ebody))))))))))))))))))))
(fn build_instance ((es ESt) (sc Scope) (env CheckedEnv) (tm Template) (d Demand)) InstRes
  (match (build_program es sc tm d)
    ((PgErr e m) (InstErr e m))
    ((PgOk t4 prog)
     (match d
       ((Demand name _ tyl _ shapes)
        (match (inst_definition t4 env tm tyl shapes name)
          ((Prod.mk t5 (Left3 e m)) (InstErr e m))
          ((Prod.mk t5 (Right3 (cons dd nil)))
           (match (inst_equations t5 env tm tyl shapes name 1 nil)
             ((Prod.mk t6 (Left3 e m)) (InstErr e m))
             ((Prod.mk t6 (Right3 eqs))
              (InstOk (Tr.es t6) prog dd eqs (Tr.lifted t6) (Tr.demands t6)))))
          ((Prod.mk t5 (Right3 _))
           (InstErr (sym "function_value") (utf8 "the instance's definition")))))))))
;; an E-first taker's instance: the program alone — no
;; definition and no equations, the body that takes it having no L reading. The demand's E types
;; become the L types the template's body is erased at (etype_to_l) and its shapes the named fns
;; at their captured values' declared types; what the body lifts or demands is typed as any
(type InstERes (IEOk ESt EDecl Demand (List Lifted) (List Demand)) (IEErr Symbol (List Int)))
(fn build_instance_e ((es ESt) (sc Scope) (env CheckedEnv) (tm Template) (ed EDemand)) InstERes
  (match (edemand_to_demand es env ed)
    (none
      (IEErr (sym "function_value")
        (append (show_name (edemand_template ed))
          (utf8
            ": a type argument of an E-first instance has no L reading — an E-only type; instantiate the template at a type the logic reads"))))
    ((some d)
     (match (build_program es sc tm d)
       ((PgErr e m) (IEErr e m))
       ((PgOk t prog) (IEOk (Tr.es t) prog d (Tr.lifted t) (Tr.demands t)))))))
(fn edemand_to_demand ((es ESt) (env CheckedEnv) (ed EDemand)) (Option Demand)
  (match ed
    ((EDemand name c tye shapes)
     (match (etypes_to_l env tye nil)
       (none none)
       ((some tyl)
        (match (eshapes_to_shapes es env shapes nil)
          (none none)
          ((some ss) (some (Demand name c tyl tye ss)))))))))
;; an E shape as the erasure's: its identity a constant of no level parameter, called as a
;; program of the table where it has one, else by the registry's entry (erasure.shard
;; shape_kind); every captured value a runtime one
(fn eshapes_to_shapes ((es ESt) (env CheckedEnv) (ss (List EShape)) (acc (List Shape)))
  (Option (List Shape))
  (measure (struct ss))
  (match ss
    (nil (some (rev acc)))
    ((cons (EShape g k ctys) r)
     (match (etypes_to_l env ctys nil)
       (none none)
       ((some ltys)
        (eshapes_to_shapes es env r
          (cons
            (Shape (mk_const g nil)
              (match (es_find_decl es g)
                ((some (EFn _ _ _ _ _ _)) none)
                (_ (realization_of g)))
              k
              (nones_of (len ctys))
              ltys)
            acc)))))))
;; an E type as the L type it names: every E type lives in Type, so a constant's level parameters
;; are the ones that put its Sort binders at Type (erase.shard's solve_levels); a type parameter
;; has no L reading here
(fn etype_to_l ((env CheckedEnv) (t EType)) (Option Expr)
  (measure (EType.size t))
  (match t
    ((ETVar _) none)
    ((ETCon n args)
     (match (env_find env n)
       (none none)
       ((some info)
        (match (solve_levels info)
          (none none)
          ((some ls)
           (match (etypes_to_l env args nil)
             (none none)
             ((some largs) (some (mk_app_n (mk_const n ls) largs)))))))))))
(fn etypes_to_l ((env CheckedEnv) (ts (List EType)) (acc (List Expr))) (Option (List Expr))
  (measure (List_EType.size ts))
  (match ts
    (nil (some (rev acc)))
    ((cons t r)
     (match (etype_to_l env t)
       (none none)
       ((some e) (etypes_to_l env r (cons e acc)))))))
(fulfills etype_to_l.dec_1
  (by (intro env t n args h info hi ls hl) (rw h) (rw EType.size.eq_1) (arith)))
(fulfills etypes_to_l.dec_1 (by (intro env ts acc t r h) (rw h) (rw List_EType.size.eq_2) (arith)))
(fulfills etypes_to_l.dec_2
  (by (intro env ts acc t r h e) (rw h) (rw List_EType.size.eq_2) (arith)))
;; the body at the type arguments: each type binder's local replaced
(fn subst_types ((t Tr) (e Expr) (binds (List TBind)) (tyl (List Expr))) (Prod Tr Expr)
  (measure (struct binds))
  (match binds
    (nil (Prod.mk t e))
    ((cons (TBind _ BType fv) br)
     (match tyl
       (nil (Prod.mk t e))
       ((cons ty tr)
        (match (tr_subst t e (fvar_id_of fv) ty)
          ((Prod.mk t1 e1) (subst_types t1 e1 br tr))))))
    ((cons _ br) (subst_types t e br tyl))))
;; the body's entries, outermost first: the captured slots of every static argument in order
;; (EKVar each, under ids below zero — no local's), then the template's binders — a type
;; binder static, an erased one erased, a data binder a variable, a static one its shape at
;; its slots. Returns the entries forward, the captured count and the next free slot id
(fn inst_env
  ((binds (List TBind))
   (shapes (List Shape))
   (next Int)
   (caps (List ErEnt))
   (bents (List ErEnt))
   (ncap Int))
  (Prod (List ErEnt) (Prod Int Int))
  (measure (struct binds))
  (match binds
    (nil (Prod.mk (append (rev caps) (rev bents)) (Prod.mk ncap next)))
    ((cons (TBind _ role fv) br)
     (match role
       (BType (inst_env br shapes next caps (cons (ErEnt (fvar_id_of fv) EKStatic) bents) ncap))
       (BErased (inst_env br shapes next caps (cons (ErEnt (fvar_id_of fv) EKErased) bents) ncap))
       ((BData _) (inst_env br shapes next caps (cons (ErEnt (fvar_id_of fv) EKVar) bents) ncap))
       ((BStatic _)
        (match shapes
          (nil (inst_env br nil next caps bents ncap))
          ((cons sh sr)
           (let ((k (len (shape_captured sh))))
             (let ((ids (slot_ids next k)))
               (inst_env br sr (- next k) (append (rev (slot_ents ids)) caps)
                 (cons (ErEnt (fvar_id_of fv) (EKShape sh ids)) bents)
                 (+ ncap k)))))))))))
(fn slot_ids ((next Int) (k Int)) (List Int)
  (measure (Int.natAbs k))
  (if (< k 1) nil (cons next (slot_ids (- next 1) (- k 1)))))
(fulfills slot_ids.dec_1 (by (intro p h) (apply natAbs_pred (arith))))
(fn slot_ents ((ids (List Int))) (List ErEnt)
  (measure (struct ids))
  (match ids
    (nil nil)
    ((cons sid r) (cons (ErEnt sid EKVar) (slot_ents r)))))
;; the recursion clause at the instance: the structural position shifted past the captured
;; parameters; a measure at the type arguments, erased over the body's entries
(fn inst_rec
  ((t Tr) (env (List ErEnt)) (prec PdRec) (binds (List TBind)) (tyl (List Expr)) (ncap Int))
  (Prod Tr Either5r)
  (match prec
    (PdNone (Prod.mk t (Right5r RecNone)))
    ((PdStruct x)
     (match (fvar_index (fvar_id_of x) (data_fvars binds) 0)
       ((some i) (Prod.mk t (Right5r (RecStruct (+ i ncap)))))
       (none
         (Prod.mk t
           (Left5r (sym "bad_measure") (utf8 "the structural parameter is not a data parameter"))))))
    ((PdMeasure m)
     (match (subst_types t m binds tyl)
       ((Prod.mk t1 m1)
        (match (erase t1 env m1 (budget_depth))
          ((ErErr e msg)
           (if (sym_eq e (sym "no_realization")) (Prod.mk t1 (Right5r RecLogical))  ; erasure.shard predef_rec's
           (Prod.mk t1 (Left5r e msg))))
          ((ErOk t2 em) (Prod.mk t2 (Right5r (RecMeasure em))))))))))
;; the captured values' E types, shape by shape, from their closed L types
(fn captured_etypes ((t Tr) (shapes (List Shape)) (acc (List EType)))
  (Prod Tr (Option (List EType)))
  (measure (struct shapes))
  (match shapes
    (nil (Prod.mk t (some (rev acc))))
    ((cons sh r)
     (match (etypes_of t (shape_captured sh) acc)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some acc1)) (captured_etypes t1 r acc1))))))
(fn etypes_of ((t Tr) (tys (List Expr)) (acc (List EType))) (Prod Tr (Option (List EType)))
  (measure (struct tys))
  (match tys
    (nil (Prod.mk t (some acc)))
    ((cons ty r)
     (match (l_to_etype (Tr.w t) (Tr.es t) (Tr.sc t) ty nil nil)
       ((Prod.mk (Prod.mk w1 es1) none) (Prod.mk (tr_set_es (tr_set_w t w1) es1) none))
       ((Prod.mk (Prod.mk w1 es1) (some ety))
        (etypes_of (tr_set_es (tr_set_w t w1) es1) r (cons ety acc)))))))

;; ---- the L definition: λ captured… binders…, TEMPLATE types… shapes… binders… ------------------
;; the captured binders fresh locals of the shapes' captured types, group by group; a shape's L
;; term its identity applied to its leading arguments with the group at the captured
;; positions; the template's data and erased binders re-opened at the substitution (a type
;; local its type argument, a static local its shape's term, an earlier binder its new local)
(fn inst_definition
  ((t Tr) (env CheckedEnv) (tm Template) (tyl (List Expr)) (shapes (List Shape)) (name Name))
  (Prod Tr Either3)
  (match (open_captured t shapes nil)
    ((Prod.mk t1 groups)
     (let
       ((terms (shape_terms shapes groups))
        (bs (cx_bound (el_cx (tm_state tm))))
        (binds (tm_binds tm)))
       (match (rebuild_binders t1 bs binds tyl terms nil nil nil)
         ((Prod.mk t2 (Prod.mk subs (Prod.mk args locals)))
          (match (tm_result t2 tm)
            ((Prod.mk t3 none)
             (Prod.mk t3
               (Left3 (sym "define_matrix") (utf8 "the declared type does not take the binders"))))
            ((Prod.mk t3 (some rl))
             (match (subst_pairs t3 rl subs)
               ((Prod.mk t4 rl1)
                (let ((all (append (flatten_exprs groups) locals)))
                  (match (tr_apps t4 (mk_const (tm_name tm) (tm_levels tm)) args)
                    ((Prod.mk t5 app)
                     (match (tr_lams t5 all app)
                       ((Prod.mk t6 val)
                        (match (tr_pis t6 all rl1)
                          ((Prod.mk t7 ty)
                           (Prod.mk t7
                             (Right3
                               (list
                                 (DefnDecl (ConstantVal name nil ty) val
                                   (HRegular (def_height env val))
                                   Safe
                                   (list name))))))))))))))))))))))
(fn open_captured ((t Tr) (shapes (List Shape)) (acc (List (List Expr))))
  (Prod Tr (List (List Expr)))
  (measure (struct shapes))
  (match shapes
    (nil (Prod.mk t (rev acc)))
    ((cons sh r)
     (match (open_group t (shape_captured sh) nil)
       ((Prod.mk t1 g) (open_captured t1 r (cons g acc)))))))
(fn open_group ((t Tr) (tys (List Expr)) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct tys))
  (match tys
    (nil (Prod.mk t (rev acc)))
    ((cons ty r)
     (match (tr_local t (n1 (sym "c")) ty)
       ((Prod.mk t1 fv) (open_group t1 r (cons fv acc)))))))
(fn shape_terms ((shapes (List Shape)) (groups (List (List Expr)))) (List Expr)
  (measure (struct shapes))
  (match shapes
    (nil nil)
    ((cons sh r)
     (match groups
       (nil nil)
       ((cons g gr)
        (cons (mk_app_n (shape_head sh) (fill_leading (shape_leading sh) g)) (shape_terms r gr)))))))
(fn fill_leading ((ls (List (Option Expr))) (g (List Expr))) (List Expr)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons (some a) r) (cons a (fill_leading r g)))
    ((cons none r)
     (match g
       ((cons x gr) (cons x (fill_leading r gr)))
       (nil (fill_leading r nil))))))
(fn flatten_exprs ((gs (List (List Expr)))) (List Expr)
  (measure (struct gs))
  (match gs
    (nil nil)
    ((cons g r) (append g (flatten_exprs r)))))
;; the substitution (old id → replacement), the template's arguments in binder order and the
;; new runtime and erased locals in order
(fn rebuild_binders
  ((t Tr)
   (bs (List (Prod Name Expr)))
   (binds (List TBind))
   (tyl (List Expr))
   (terms (List Expr))
   (subs (List (Prod Int Expr)))
   (args (List Expr))
   (locals (List Expr)))
  (Prod Tr (Prod (List (Prod Int Expr)) (Prod (List Expr) (List Expr))))
  (measure (struct binds))
  (match binds
    (nil (Prod.mk t (Prod.mk subs (Prod.mk (rev args) (rev locals)))))
    ((cons (TBind _ role fv) br)
     (match role
       (BType
         (match tyl
           ((cons ty tr)
            (rebuild_binders t bs br tr terms (cons (Prod.mk (fvar_id_of fv) ty) subs)
              (cons ty args)
              locals))
           (nil (rebuild_binders t bs br nil terms subs args locals))))
       ((BStatic _)
        (match terms
          ((cons tm tr)
           (rebuild_binders t bs br tyl tr (cons (Prod.mk (fvar_id_of fv) tm) subs) (cons tm args)
             locals))
          (nil (rebuild_binders t bs br tyl nil subs args locals))))
       (_
         (match (tr_type_of_local t fv)
           (none (rebuild_binders t bs br tyl terms subs args locals))
           ((some ty)
            (match (subst_pairs t ty subs)
              ((Prod.mk t1 ty1)
               (match (tr_local t1 (tm_bound_name bs (fvar_id_of fv)) ty1)
                 ((Prod.mk t2 fv1)
                  (rebuild_binders t2 bs br tyl terms (cons (Prod.mk (fvar_id_of fv) fv1) subs)
                    (cons fv1 args)
                    (cons fv1 locals)))))))))))))

;; ---- the equations: TEMPLATE.eq_N instantiated, proven by itself through the unfolding ---------
;; `∀ kept, TEMPLATE a… f… lhs… = rhs` becomes `∀ captured… kept', NAME captured… lhs…' = rhs'`
;; — the type and static locals of `kept` replaced by the type arguments and the shapes' terms
;; (they stand unsplit at the template's positions in the left-hand side), the rest re-opened
;; at the substitution —, proven by `TEMPLATE.eq_N` at the same arguments: K converts the
;; template applied to the instance applied by delta and beta (its definition)
(fn inst_equations
  ((t Tr)
   (env CheckedEnv)
   (tm Template)
   (tyl (List Expr))
   (shapes (List Shape))
   (name Name)
   (i Int)
   (acc (List Declaration)))
  (Prod Tr Either3)
  (measure (Int.natAbs (- 65 i)))
  (if (< 64 i) (Prod.mk t (Right3 (rev acc)))
  (match (tm_eq_name env tm i)
    (none (Prod.mk t (Right3 (rev acc))))
    ((some eqn)
     (let ((binds (tm_binds tm)))
       (match (env_find env eqn)
         (none (Prod.mk t (Right3 (rev acc))))
         ((some info)
          (match (tm_open_pis t (ci_type info) nil (budget_depth))
            ((Prod.mk t1 (Prod.mk elocals ebody))
             (match (get_app_args ebody)
               ((cons ety (cons lhs (cons rhs nil)))
                (let ((largs (get_app_args lhs)))
                  (if (bool_not (= (len largs) (len binds)))
                    (Prod.mk t1
                      (Left3 (sym "equation_form")
                        (append (show_name eqn)
                          (utf8 ": its left-hand side does not apply the template to its binders"))))
                    (match (open_captured t1 shapes nil)
                      ((Prod.mk t2 groups)
                       (match (eq_subs binds largs tyl (shape_terms shapes groups) nil)
                         (none
                           (Prod.mk t2
                             (Left3 (sym "equation_form")
                               (append (show_name eqn)
                                 (utf8
                                   ": a type or static binder is not a variable of its left-hand side")))))
                         ((some subs0)
                          (match (reopen_locals t2 elocals subs0 subs0 nil)
                            ((Prod.mk t3 (Prod.mk subs newlocals))
                             (match (subst_pairs t3 ety subs)
                               ((Prod.mk t4 ety1)
                                (match (subst_pairs t4 rhs subs)
                                  ((Prod.mk t5 rhs1)
                                   (match (subst_exprs t5 (runtime_args binds largs) subs nil)
                                     ((Prod.mk t6 dargs)
                                      (let ((all (append (flatten_exprs groups) newlocals)))
                                        (match
                                          (tr_apps t6 (mk_const name nil)
                                            (append (flatten_exprs groups) dargs))
                                          ((Prod.mk t7 lhs1)
                                           (match
                                             (tr_apps t7 (get_app_fn ebody) (list ety1 lhs1 rhs1))
                                             ((Prod.mk t8 stmt)
                                              (match (subst_exprs t8 elocals subs nil)
                                                ((Prod.mk t9 eargs)
                                                 (match (tr_apps t9 (mk_const eqn nil) eargs)
                                                   ((Prod.mk t10 proof)
                                                    (match (tr_pis t10 all stmt)
                                                      ((Prod.mk t11 ty)
                                                       (match (tr_lams t11 all proof)
                                                         ((Prod.mk t12 val)
                                                          (let ((en (name_append name (nm_eq_n i))))
                                                            (inst_equations t12 env tm tyl shapes
                                                              name
                                                              (+ i 1)
                                                              (cons
                                                                (ThmDecl (ConstantVal en nil ty) val
                                                                  (list en))
                                                                acc)))))))))))))))))))))))))))))))
               (_
                 (Prod.mk t1
                   (Left3 (sym "equation_form") (append (show_name eqn) (utf8 ": not an equation")))))))))))))))
;; a Pi chain opened at fresh locals
(fn tm_open_pis ((t Tr) (ty Expr) (acc (List Expr)) (fuel Int)) (Prod Tr (Prod (List Expr) Expr))
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (Prod.mk t (Prod.mk (rev acc) ty))
  (match ty
    ((Pi _ n _ dom body)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 b1) (tm_open_pis t2 b1 (cons fv acc) (- fuel 1)))))))
    (_ (Prod.mk t (Prod.mk (rev acc) ty))))))
(fulfills tm_open_pis.dec_1
  (by (intro p h w1 n w2 dom body hm t1 fv h1 t2 b1 h2) (apply natAbs_pred (arith))))
;; the type and static positions' locals of the left-hand side, each to its replacement
(fn eq_subs
  ((binds (List TBind))
   (largs (List Expr))
   (tyl (List Expr))
   (terms (List Expr))
   (acc (List (Prod Int Expr))))
  (Option (List (Prod Int Expr)))
  (measure (struct binds))
  (match binds
    (nil (some acc))
    ((cons (TBind _ role _) br)
     (match largs
       (nil (some acc))
       ((cons a ar)
        (match role
          (BType
            (match tyl
              ((cons ty tr)
               (match a
                 ((FVar _ fid) (eq_subs br ar tr terms (cons (Prod.mk fid ty) acc)))
                 (_ none)))
              (nil none)))
          ((BStatic _)
           (match terms
             ((cons tm tr)
              (match a
                ((FVar _ fid) (eq_subs br ar tyl tr (cons (Prod.mk fid tm) acc)))
                (_ none)))
             (nil none)))
          (_ (eq_subs br ar tyl terms acc))))))))
;; the left-hand side's arguments at the runtime and erased positions
(fn runtime_args ((binds (List TBind)) (largs (List Expr))) (List Expr)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ role _) br)
     (match largs
       (nil nil)
       ((cons a ar)
        (match role
          (BType (runtime_args br ar))
          ((BStatic _) (runtime_args br ar))
          (_ (cons a (runtime_args br ar)))))))))
;; the equation's locals re-opened past the substituted ones, each at its substituted type
(fn reopen_locals
  ((t Tr)
   (ls (List Expr))
   (subs0 (List (Prod Int Expr)))
   (subs (List (Prod Int Expr)))
   (acc (List Expr)))
  (Prod Tr (Prod (List (Prod Int Expr)) (List Expr)))
  (measure (struct ls))
  (match ls
    (nil (Prod.mk t (Prod.mk subs (rev acc))))
    ((cons fv r)
     (match (assoc_int_expr (fvar_id_of fv) subs0)
       ((some _) (reopen_locals t r subs0 subs acc))
       (none
         (match (tr_type_of_local t fv)
           (none (reopen_locals t r subs0 subs acc))
           ((some ty)
            (match (subst_pairs t ty subs)
              ((Prod.mk t1 ty1)
               (match (tr_local t1 (n1 (sym "x")) ty1)
                 ((Prod.mk t2 fv1)
                  (reopen_locals t2 r subs0 (cons (Prod.mk (fvar_id_of fv) fv1) subs) (cons fv1 acc)))))))))))))
(fn subst_exprs ((t Tr) (es (List Expr)) (subs (List (Prod Int Expr))) (acc (List Expr)))
  (Prod Tr (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk t (rev acc)))
    ((cons e r)
     (match (subst_pairs t e subs)
       ((Prod.mk t1 e1) (subst_exprs t1 r subs (cons e1 acc)))))))
(fulfills inst_equations.dec_1
  (by
    (intro p h0 eqn h1 info h2 t1 el eb h3 ety lhs rhs h4 h5 t2 gs h6 s0 h7 t3 subs nl h8 t4 e1 h9
      t5 r1 h10 t6 da h11 t7 l1 h12 t8 st h13 t9 ea h14 t10 pf h15 t11 ty h16 t12 v h17)
    (apply natAbs_lt (arith) (arith))))
