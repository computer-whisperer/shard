;;; v3/kernel/test/entry_test.shard — the checked entry (raw against
;;; checked arguments): run_prog validates the
;;; driver's arguments against the entry's parameters before ev runs — Int,
;;; Nat, a byte list, the World last — and refuses a malformed one by its
;;; position and text, never a file span; an entry the driver cannot serve is
;;; bad_entry. The profile pin prints; the S pin (it calls no extern)
;;; is checked by its result alone. Then the run of a load (run.shard's
;;; run_load, the command line's `--run`): what the program does not state
;;; of an entry — an evidence binder, a proposition field of a parameter's
;;; constructor — is read from the load's environment and refused
;;; `preconditioned` before any argument is read (pin handle_door).

(import "loader_kit.shard")
(import "case_kit.shard")
(import "../run.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.ev)
(use kernel.host)
(use kernel.name)
(use kernel.test.loader_kit)
(use kernel.util)
(use kernel.ev.RunRes)
(use kernel.host.World)
(use kernel.loader)
(use kernel.name.Name)
(use kernel.prog.EvRes)
(use kernel.prog.Val)
(use kernel.run)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


(fn e_fn ((s Symbol)) Name (Str (Str (Str Anon (quote kernel)) (quote main)) s))
(fn s_fn ((s Symbol)) Name (Str (Str Anon (quote main)) s))
(fn res ((r (Prod RunRes World))) RunRes
  (match r
    ((Prod.mk x _) x)))
(fn is_ok ((r RunRes)) Bool
  (match r
    (RunOk true)
    (_ false)))
(fn is_arg ((r RunRes) (i Int) (reason Symbol) (txt (List Int))) Bool
  (match r
    ((RunArg j s t) (bool_and (= i j) (bool_and (sym_eq reason s) (int_list_eq t txt))))
    (_ false)))
(fn is_link ((r RunRes) (e Symbol)) Bool
  (match r
    ((RunLink s _) (sym_eq e s))
    (_ false)))
(fn is_link_text ((r RunRes) (e Symbol) (m (List Int))) Bool
  (match r
    ((RunLink s t) (bool_and (sym_eq e s) (int_list_eq t m)))
    (_ false)))
(fn fuel () Int 1000000)
;; the load of the pin handle_door: its environment beside its program
(fn door_load ((w World)) (Prod Load World)
  (load_all (kit_load0 (list "v3" "pins" "loader" "handle_door"))
    (list "v3/pins/loader/handle_door/main.shard")
    w))
;; the run's door on that load: an entry of the pin on ARGS
(fn door_run ((l Load) (f Symbol) (args (List (List Int))) (w World)) RunRes
  (res (run_load l (s_fn f) args (fuel) nil w)))

(fn cases ((w World)) (Prod (List Case) World)
  (match (load_prog "v3/pins/loader/entry" (list "v3/pins/loader/entry/kernel/main.shard") w)
    ((Prod.mk (Prod.mk pe _) w1)
     (match (load_prog "v3/pins/loader/entry_s" (list "v3/pins/loader/entry_s/main.shard") w1)
       ((Prod.mk (Prod.mk ps _) w2)
        (match
          (load_prog "v3/pins/loader/entry_shape" (list "v3/pins/loader/entry_shape/main.shard") w2)
          ((Prod.mk (Prod.mk pt _) w3)
           (Prod.mk
             (list
               (Case
                 "a Tree with the list arities is not a byte-list codec — bad_entry, never Branch cells over bytes"
                 (is_link (res (run_prog pt (s_fn (quote main)) (list "abc") (fuel) w3))
                   (quote bad_entry)))
               (Case "a list of Bool is not a byte-list codec — bad_entry"
                 (is_link (res (run_prog pt (s_fn (quote bools)) (list "abc") (fuel) w3))
                   (quote bad_entry)))
               (Case "Init's (List Nat) is, by identity — nats abc = 97"
                 (is_ok (res (run_prog pt (s_fn (quote nats)) (list "abc") (fuel) w3))))
               (Case "profile: main 21 hello runs (prints \"hello 42\") and is RunOk"
                 (is_ok (res (run_prog pe (e_fn (quote main)) (list "21" "hello") (fuel) w2))))
               (Case "a negative Int parses"
                 (is_ok (res (run_prog pe (e_fn (quote main)) (list "-21" "neg") (fuel) w2))))
               (Case "a malformed Int is refused by position and text, never a file span"
                 (is_arg (res (run_prog pe (e_fn (quote main)) (list "abc" "hello") (fuel) w2)) 1
                   (quote not_an_int)
                   "abc"))
               (Case "a bare minus is not an Int"
                 (is_arg (res (run_prog pe (e_fn (quote main)) (list "-" "hello") (fuel) w2)) 1
                   (quote not_an_int)
                   "-"))
               (Case "too few arguments: argument_count at the missing position"
                 (is_arg (res (run_prog pe (e_fn (quote main)) (list "21") (fuel) w2)) 2
                   (quote argument_count)
                   "kernel.main.main takes 2 argument(s), got 1"))
               (Case "too many arguments: argument_count at the first surplus"
                 (is_arg (res (run_prog pe (e_fn (quote main)) (list "21" "a" "b") (fuel) w2)) 3
                   (quote argument_count)
                   "kernel.main.main takes 2 argument(s), got 3"))
               (Case
                 "the World alone: no checked parameter, the raw list through get_args (prints 0)"
                 (is_ok (res (run_prog pe (e_fn (quote raw)) nil (fuel) w2))))
               (Case
                 "the World alone takes any argument list raw through get_args (prints 1+1+1+0) — the count rule is the checked entry's"
                 (is_ok (res (run_prog pe (e_fn (quote raw)) (list "a" "b" "c") (fuel) w2))))
               (Case "an entry with a type parameter that no parameter states runs (prints poly 5)"
                 (is_ok (res (run_prog pe (e_fn (quote poly)) (list "5") (fuel) w2))))
               (Case
                 "an entry with a parameter stating a type parameter is preconditioned: no value is read at it"
                 (is_link (res (run_prog pe (e_fn (quote polyx)) (list "5") (fuel) w2))
                   (quote preconditioned)))
               (Case "a parameter no argument supplies is bad_entry"
                 (is_link (res (run_prog pe (e_fn (quote opt)) (list "1") (fuel) w2))
                   (quote bad_entry)))
               (Case "an entry without a World last is bad_entry"
                 (is_link (res (run_prog pe (e_fn (quote noworld)) (list "1") (fuel) w2))
                   (quote bad_entry)))
               (Case "S: Nat and Init's (List Nat) before the World"
                 (is_ok (res (run_prog ps (s_fn (quote main)) (list "12" "abc") (fuel) w2))))
               (Case "S: a signed numeral is not a Nat"
                 (is_arg (res (run_prog ps (s_fn (quote main)) (list "-1" "abc") (fuel) w2)) 1
                   (quote not_a_nat)
                   "-1"))
               (Case "S: the byte list arrives as Init's List — total 1 [2 3] = 6"
                 (match (ev ps (s_fn (quote total)) (list (VInt 1) (nat_list (list 2 3))) (fuel))
                   ((EvOk (VInt 6)) true)
                   (_ false))))
             w3))))))))

;; the run of a load: the checked door closed from the environment
(fn door_cases ((w World)) (Prod (List Case) World)
  (match (door_load w)
    ((Prod.mk l w1)
     (Prod.mk
       (list
         (Case "the run of a load: an entry with nothing dropped runs"
           (is_ok (door_run l (quote shown) (list "4") w1)))
         (Case
           "the run of a load: an evidence binder of the entry — guarded's h — is preconditioned, the binder named, before any argument is read"
           (is_link_text (door_run l (quote guarded) (list "x") w1) (quote preconditioned)
             "main.guarded: the binder h is evidence the erasure dropped: no value supplies it"))
         (Case
           "the run of a load: a proposition field of a parameter's constructor — Span's ok — is preconditioned, the field named"
           (is_link_text (door_run l (quote spanned) (list "x") w1) (quote preconditioned)
             "main.spanned: the field ok of main.Span.mk is a proposition the erasure dropped: no value shows it")))
       w1))))

(fn main ((w World)) World
  (match (cases w)
    ((Prod.mk cs w1)
     (match (door_cases w1)
       ((Prod.mk cs2 w2) (run_cases (utf8 "entry_test") (append cs cs2) 0 w2))))))
