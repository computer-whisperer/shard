;;; v3/kernel/test/reader_pins_test.shard — replays v3/pins/reader/*.shard
;;; (the list below: the host has no directory read) from the
;;; empty environment through the reader into K and compares each file's
;;; outcome with its `;; expect:` header (v3/pins/reader/README.md; the
;;; header's parsing is reader_kit's, shared with loader_pins_test).

(import "reader_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.host)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.test.reader_kit)
(use kernel.util)
(use kernel.host.World)
(use kernel.name.Name)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.sexpr.RAll)
(use kernel.test.reader_kit.Step)

(fn pin_files () (List (List Int))
  (utf8_all
    (list "v3/pins/reader/world.shard" "v3/pins/reader/refuse_universe_collapse.shard"
      "v3/pins/reader/refuse_false_theorem.shard"
      "v3/pins/reader/refuse_nonpositive.shard"
      "v3/pins/reader/pending_sorry.shard"
      "v3/pins/reader/accept_by.shard"
      "v3/pins/reader/refuse_unsolved_universe.shard"
      "v3/pins/reader/refuse_negative_numeral.shard"
      "v3/pins/reader/refuse_unknown_constant.shard"
      "v3/pins/reader/refuse_unterminated.shard"
      "v3/pins/reader/refuse_universe_arity.shard"
      "v3/pins/reader/refuse_unknown_form.shard")))

;; ---- the replay --------------------------------------------------------------------
;; every form in order from the empty environment; the first non-acceptance ends it
(fn replay ((forms (List SExpr)) (env CheckedEnv) (n Int)) (Prod Step Int)
  (measure (struct forms))
  (match forms
    (nil (Prod.mk (SAcc env) n))
    ((cons f r)
     (match (step_form (Scope Anon Anon nil VisAll) env f)
       ((SAcc e2) (replay r e2 (+ n 1)))
       (s (Prod.mk s n))))))

(fn outcome ((src (List Int))) (Prod Step Int)
  (match (read_all src)
    ((RAErr e off) (Prod.mk (SRead e (append "at byte " (show_nat off))) 0))
    ((RAOk forms) (replay forms (e0) 0))))

;; the outcome against the header's words
(fn matches ((ws (List (List Int))) (s Step) (n Int)) Bool
  (match ws
    ((cons w nil) (if (int_list_eq w "ok") (bool_and (acc s) (< 0 n)) false))
    ((cons w1 (cons w2 nil))
     (if (int_list_eq w1 "read-error")
       (match s
         ((SRead e _) (int_list_eq (chars_of_sym e) w2))
         (_ false))
       false))
    ((cons name (cons kind (cons reason nil)))
     (if (int_list_eq kind "refused")
       (match s
         ((SRej subj r)
          (bool_and (int_list_eq (show_name subj) name) (int_list_eq (chars_of_sym r) reason)))
         (_ false))
     (if (int_list_eq kind "pending")
       (match s
         ((SPend subj r)
          (bool_and (int_list_eq (show_name subj) name) (int_list_eq (chars_of_sym r) reason)))
         (_ false))
       false)))
    (_ false)))

(fn run ((files (List (List Int))) (fails Int) (w World)) World
  (measure (struct files))
  (match files
    (nil
      (exit fails (write_line (append (utf8 "reader_pins_test: failures = ") (show_int fails)) w)))
    ((cons f r)
     (match (read_file f w)
       ((Prod.mk none w1) (run r (+ fails 1) (write_line (append (utf8 "FAIL cannot read ") f) w1)))
       ((Prod.mk (some src) w1)
        (let ((ws (expect_words src)))
          (match (outcome src)
            ((Prod.mk s n)
             (if (matches ws s n)
               (run r fails
                 (write_line
                   (append (utf8 "PASS ") (append f (append (utf8 " — ") (show_words ws))))
                   w1))
               (run r (+ fails 1)
                 (write_line
                   (append (utf8 "FAIL ")
                     (append f
                       (append (utf8 " expected ")
                         (append (show_words ws) (append (utf8 " got ") (show_step s))))))
                   w1)))))))))))
(fn main ((w World)) World (run (pin_files) 0 w))
