;;; v3/kernel/test/prog_test.shard — prog.shard loads under the bootstrap
;;; (the toolchain-profile gate, kernel/README.md) and a Prog value is
;;; built and looked up: the E form of
;;;   (fn length ((xs (List Int))) Int (measure (struct xs))
;;;     (match xs (Nil 0) ((Cons _ t) (+ 1 (length t)))))
;;; over the toolchain's own List (kernel.prelude.List), as v3/LANGUAGE.md
;;; §6.1 shapes it. Phase 2 slice 1; `ev` runs it in slice 5.

(import "../host.shard")
(import "../prog.shard")

(type Case (Case (List Int) Bool))

(fn nm_list () Name (Str (n2 (quote kernel) (quote prelude)) (quote List)))
(fn nm_nil () Name (Str (nm_list) (quote Nil)))
(fn nm_cons () Name (Str (nm_list) (quote Cons)))
(fn nm_int () Name (n1 (quote Int)))
(fn nm_add () Name (n1 (quote +)))
(fn nm_length () Name (n2 (quote prog_test) (quote length)))

(fn ty_int () EType (ETCon (nm_int) Nil))
(fn ty_list_int () EType (ETCon (nm_list) (list (ty_int))))

;; the inductive: (type (List T) (Nil) (Cons T (List T)))
(fn list_decl () EDecl
  (EInd (nm_list) 1
    (list (ECtorDef (nm_nil) Nil)
          (ECtorDef (nm_cons) (list (ETVar 0) (ETCon (nm_list) (list (ETVar 0))))))))

;; the body: xs is EBVar 0; in the Cons arm the fields bind two more slots, t = EBVar 0
(fn length_body () ETerm
  (EMatch (EBVar 0)
    (list (EArm (PCtor (nm_nil) Nil) (ELit (LInt 0)))
          (EArm (PCtor (nm_cons) (list PVar PVar))
                (EPrim (nm_add) (list (ELit (LInt 1)) (ECall (nm_length) (list (EBVar 0)))))))))

(fn length_decl () EDecl
  (EFn (nm_length) 0 (list (ty_list_int)) (ty_int) (RecStruct 0) (length_body)))

(fn prog () Prog (Prog (list (list_decl) (length_decl))))

(fn cases () (List Case)
  (list
    (Case "prog_find finds the function with its shape"
      (match (prog_find (prog) (nm_length))
        ((Some (EFn _ 0 (Cons _ Nil) _ (RecStruct 0) (EMatch (EBVar 0) (Cons _ (Cons _ Nil))))) True)
        (_ False)))
    (Case "prog_find finds the inductive with two constructors"
      (match (prog_find (prog) (nm_list))
        ((Some (EInd _ 1 (Cons (ECtorDef _ Nil) (Cons (ECtorDef _ (Cons _ (Cons _ Nil))) Nil)))) True)
        (_ False)))
    (Case "prog_find misses a primitive's name"
      (match (prog_find (prog) (nm_add)) (None True) (_ False)))
    (Case "edecl_name is the identity"
      (bool_and (name_eq (edecl_name (length_decl)) (nm_length))
                (name_eq (edecl_name (list_decl)) (nm_list))))))

(fn run ((cs (List Case)) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (Nil (exit fails (write_line (append "prog_test: failures = " (show_int fails)) w)))
    ((Cons (Case name ok) r) (run r (if ok fails (+ fails 1)) (write_line (append (if ok "PASS " "FAIL ") name) w)))))

(fn main ((w World)) World (run (cases) 0 w))
