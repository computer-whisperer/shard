;;; v3/kernel/test/reader_test.shard — the reader through K:
;;; a world declared from S text (no import,
;;; no Rust loader: the direct S → L → K path), every declaration form, the term
;;; grammar, scope resolution, the refusals with their reasons, and
;;; origin-only invariance (whitespace, comments, binder names change
;;; no declaration).

(import "reader_kit.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.host)
(use kernel.name)
(use kernel.scope)
(use kernel.test.reader_kit)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.Declaration)
(use kernel.expr.Expr)
(use kernel.host.World)
(use kernel.name.Name)
(use kernel.scope.Open)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


(fn sc () Scope (scope_of Anon Anon nil VisAll))
(fn s_nat () (List Int) (utf8 "(inductive Nat () Type (zero Nat) (succ (-> Nat Nat)))"))
(fn s_eq () (List Int)
  (utf8 "(inductive Eq.{u} ((α (Sort u) implicit) (a α)) (-> α Prop) (refl (Eq a a)))"))
(fn s_two () (List Int) (utf8 "(def two () Nat (Nat.succ (Nat.succ Nat.zero)))"))
(fn e_nat () CheckedEnv (env_of (step (sc) (e0) (s_nat)) (e0)))
(fn e_eq () CheckedEnv (env_of (step (sc) (e_nat) (s_eq)) (e0)))
(fn e_two () CheckedEnv (env_of (step (sc) (e_eq) (s_two)) (e0)))
(fn e_pt () CheckedEnv (env_of (step (sc) (e_two) (utf8 "(structure Pt () (x Nat) (y Nat))")) (e0)))
(fn e_id () CheckedEnv
  (env_of
    (step (sc) (e_two) (utf8 "(inductive Id.{u} ((α (Type u))) (Type u) (mk (-> α (Id α))))"))
    (e0)))
(fn at ((env CheckedEnv) (src (List Int))) Step (step (sc) env src))

;; scopes for the resolution cases: module A declares x, module B declares x
(fn sc_a () Scope (scope_of (n1 (sym "A")) (n1 (sym "A")) nil VisAll))
(fn sc_b () Scope (scope_of (n1 (sym "B")) (n1 (sym "B")) nil VisAll))
(fn e_ab () CheckedEnv
  (env_of
    (step (sc_b) (env_of (step (sc_a) (e_two) (utf8 "(def x () Nat two)")) (e0))
      (utf8 "(def x () Nat Nat.zero)"))
    (e0)))

(fn same_decl ((a (List Int)) (b (List Int))) Bool
  (match (read_one (sc) (e_eq) a)
    (none false)
    ((some d1)
     (match (read_one (sc) (e_eq) b)
       (none false)
       ((some d2) (decl_eq d1 d2))))))
(fn same_identity ((a (List Int)) (b (List Int)) (n Name)) Bool
  (match (identity_hash (env_of (at (e_eq) a) (e0)) n)
    (none false)
    ((some h1)
     (match (identity_hash (env_of (at (e_eq) b) (e0)) n)
       (none false)
       ((some h2) (= h1 h2))))))

(fn cases () (List Case)
  (list (Case (utf8 "the world: Nat from S") (acc (step (sc) (e0) (s_nat))))
    (Case (utf8 "the world: Eq.{u} from S, with implicit and universe binders")
      (acc (step (sc) (e_nat) (s_eq))))
    (Case (utf8 "def two") (acc (step (sc) (e_eq) (s_two))))
    (Case (utf8 "the S-read Nat is pinned (its closure matches the reference)")
      (env_pinned (e_nat) (nm_nat)))
    (Case (utf8 "a Nat literal types under the S-read Nat")
      (acc (at (e_two) (utf8 "(def five () Nat 5)"))))
    (Case (utf8 "a theorem by rfl: direct P verification")
      (acc (at (e_two) (utf8 "(theorem t1 () (Eq two two) (exact (Eq.refl two)))"))))
    (Case
      (utf8
        "a false theorem: the elaborator refuses the proof's type before K (K's own refusal is hostile battery 1)")
      (rerr (at (e_two) (utf8 "(theorem t2 () (Eq two Nat.zero) (exact (Eq.refl two)))"))
        (sym "type_mismatch")))
    (Case (utf8 "sorry: pending, admits nothing")
      (pend (at (e_two) (utf8 "(theorem t3 () (Eq two Nat.zero) sorry)"))))
    (Case (utf8 "by: I's block is read (rfl by Eq.refl)")
      (acc (at (e_two) (utf8 "(theorem t4 () (Eq two two) (by rfl))"))))
    (Case (utf8 "an unknown constant")
      (rerr (at (e_two) (utf8 "(def bad () Nat foo)")) (sym "unknown_constant")))
    (Case (utf8 "a polymorphic constant cited bare: its universe inferred, its implicit inserted")
      (acc (at (e_two) (utf8 "(def ok () Prop (Eq two two))"))))
    (Case (utf8 "a universe the inputs do not determine is refused")
      (rerr
        (at (env_of (at (e_two) (utf8 "(axiom lonely.{v} () Nat)")) (e0))
          (utf8 "(def bad () Nat lonely)"))
        (sym "unsolved_universe")))
    (Case (utf8 "an implicit the inputs do not determine is refused")
      (rerr
        (at (env_of (at (e_two) (utf8 "(axiom idk.{u} ((α (Type u) implicit)) Nat)")) (e0))
          (utf8 "(def bad () Nat idk)"))
        (sym "unsolved_implicit")))
    (Case (utf8 "a proof where a type is expected")
      (rerr (at (e_two) (utf8 "(def bad () Prop (forall ((p Prop)) (Eq.refl p)))"))
        (sym "not_a_type")))
    (Case (utf8 "the wrong universe arity")
      (rerr (at (e_two) (utf8 "(def bad () Prop (Eq.{1 2} Nat two two))")) (sym "universe_arity")))
    (Case (utf8 "an undeclared universe name")
      (rerr (at (e_two) (utf8 "(def bad () (Sort v) Nat)")) (sym "bad_level")))
    (Case (utf8 "a declared universe name")
      (acc (at (e_two) (utf8 "(def ty.{v} () (Sort (succ v)) (Sort v))"))))
    (Case (utf8 "fun / forall / ->: the polymorphic identity")
      (acc (at (e_two) (utf8 "(def id () (forall ((A Type)) (-> A A)) (fun ((A Type) (x A)) x))"))))
    (Case (utf8 "application of it")
      (acc
        (at
          (env_of
            (at (e_two) (utf8 "(def id () (forall ((A Type)) (-> A A)) (fun ((A Type) (x A)) x))"))
            (e0))
          (utf8 "(def two' () Nat (id Nat two))"))))
    (Case (utf8 "let, sequential: the second binding sees the first")
      (acc
        (at (e_two) (utf8 "(def four () Nat (let ((t Nat two) (u Nat (Nat.succ t))) (Nat.succ u)))"))))
    (Case (utf8 "let reduces by zeta under rfl")
      (acc
        (at
          (env_of
            (at (e_two)
              (utf8 "(def four () Nat (let ((t Nat two) (u Nat (Nat.succ t))) (Nat.succ u)))"))
            (e0))
          (utf8 "(theorem t5 () (Eq four (Nat.succ (Nat.succ two))) (exact (Eq.refl four)))"))))
    (Case (utf8 "structure: Pt, Pt.mk, Pt.x, Pt.y admitted")
      (acc (at (e_two) (utf8 "(structure Pt () (x Nat) (y Nat))"))))
    (Case (utf8 "a projection reduces under rfl")
      (acc
        (at (e_pt)
          (utf8 "(theorem t6 () (Eq (Pt.x (Pt.mk two Nat.zero)) two) (exact (Eq.refl two)))"))))
    (Case (utf8 "the raw proj form")
      (acc (at (e_pt) (utf8 "(def px () Nat (proj Pt 1 (Pt.mk two Nat.zero)))"))))
    (Case
      (utf8 "a dependent structure: the second field's type cites the first through its projection")
      (acc (at (e_two) (utf8 "(structure Dep () (n Nat) (p (Eq n n)))"))))
    (Case (utf8 "type: an enumeration") (acc (at (e_two) (utf8 "(type Color (red) (green))"))))
    (Case (utf8 "type: a parameterized pair, its constructor applied")
      (acc
        (at (env_of (at (e_two) (utf8 "(type (Pair2 A B) (mk A B))")) (e0))
          (utf8 "(def p () (Pair2 Nat Nat) (Pair2.mk two two))"))))
    (Case (utf8 "type: a polymorphic field type takes level 0 by rule (E-type position)")
      (acc (at (e_id) (utf8 "(type (W T) (mk (Id T)))"))))
    (Case (utf8 "the same citation outside an E-type position infers the level")
      (acc (at (e_id) (utf8 "(def w () Type (Id Nat))"))))
    (Case (utf8 "the explicit application @: the implicit written")
      (acc
        (at (e_two) (utf8 "(theorem t7 () (@Eq.{1} Nat two two) (exact (@Eq.refl.{1} Nat two)))"))))
    (Case (utf8 "a Nat where an Int is expected: no Int here, so a type mismatch names both")
      (rerr (at (e_two) (utf8 "(def bad () Prop two)")) (sym "type_mismatch")))
    (Case (utf8 "axiom: read (the trusts gate is the loader's)")
      (acc (at (e_two) (utf8 "(axiom ax () (Eq two two))"))))
    (Case (utf8 "opaque") (acc (at (e_two) (utf8 "(opaque o () Nat two)"))))
    (Case (utf8 "abbrev") (acc (at (e_two) (utf8 "(abbrev a () Nat two)"))))
    (Case (utf8 "a negative numeral is not S")
      (rerr (at (e_two) (utf8 "(def m () Nat -7)")) (sym "negative_numeral")))
    (Case (utf8 "an unknown form") (rerr (at (e_two) (utf8 "(frob x)")) (sym "unknown_form")))
    (Case (utf8 "instance: no instance declarations")
      (rerr (at (e_two) (utf8 "(instance x)")) (sym "reserved_form")))
    (Case (utf8 "requires: reserved — a clause of the bin form, which is the loader's")
      (rerr (at (e_two) (utf8 "(requires x)")) (sym "reserved_form")))
    (Case (utf8 "fn: routed onward to the loader")
      (later (at (e_two) (utf8 "(fn f ((x Nat)) Nat x)"))))
    (Case (utf8 "import: the loader's") (directive (at (e_two) (utf8 "(import \"x.shard\")"))))
    (Case (utf8 "a malformed binder")
      (rerr (at (e_two) (utf8 "(def bad ((x)) Nat two)")) (sym "bad_binder")))
    (Case (utf8 "a malformed def") (rerr (at (e_two) (utf8 "(def bad Nat two)")) (sym "bad_shape")))
    (Case (utf8 "resolution: a module's own declaration first")
      (acc (step (sc_a) (e_ab) (utf8 "(def y () Nat x)"))))
    (Case (utf8 "resolution: the module's own x is A.x")
      (match (read_one (sc_a) (e_ab) (utf8 "(def y () Nat x)"))
        ((some (DefnDecl _ (Const _ n _) _ _ _)) (name_eq n (n2 (sym "A") (sym "x"))))
        (_ false)))
    (Case (utf8 "resolution: one opened prefix")
      (acc
        (step (scope_of Anon Anon (list (open_all (n1 (sym "B")))) VisAll) (e_ab)
          (utf8 "(def y () Nat x)"))))
    (Case (utf8 "resolution: two opened prefixes both declaring x is ambiguous")
      (rerr
        (step (scope_of Anon Anon (list (open_all (n1 (sym "A"))) (open_all (n1 (sym "B")))) VisAll)
          (e_ab)
          (utf8 "(def y () Nat x)"))
        (sym "ambiguous_name")))
    (Case (utf8 "resolution: the qualified name always resolves")
      (acc
        (step (scope_of Anon Anon (list (open_all (n1 (sym "A"))) (open_all (n1 (sym "B")))) VisAll)
          (e_ab)
          (utf8 "(def y () Nat A.x)"))))
    (Case (utf8 "origin-only: whitespace and comments change no declaration")
      (same_decl (s_two)
        (utf8 "( def   two ( ) ; the comment\n  Nat\n  (Nat.succ (Nat.succ  Nat.zero)) )")))
    (Case (utf8 "origin-only: binder names change no declaration")
      (same_decl (utf8 "(def k () (forall ((A Type)) (-> A A)) (fun ((A Type) (x A)) x))")
        (utf8 "(def k () (forall ((B Type)) (-> B B)) (fun ((T Type) (y T)) y))")))
    (Case (utf8 "origin-only: the admitted identity is the same")
      (same_identity (s_two) (utf8 "(def two () Nat (Nat.succ\n (Nat.succ Nat.zero)))")
        (n1 (sym "two"))))
    (Case (utf8 "origin-only: a different body is a different declaration")
      (bool_not (same_decl (s_two) (utf8 "(def two () Nat (Nat.succ Nat.zero))"))))))

(fn main ((w World)) World (run_cases (utf8 "reader_test") (cases) 0 w))
