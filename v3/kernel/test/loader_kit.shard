;;; v3/kernel/test/loader_kit.shard — shared by the loader-level tests
;;; (loader_test, loader_pins_test, entry_test): a load of root files under a
;;; package root with a chunk list, its records and the E program it yields,
;;; predicates over the records, Init's List cells. Not an entrypoint.

(import "reader_kit.shard")
(import "../loader.shard")
(import "../ev.shard")

(fn fixture () (List Int) "v3/kernel/test/fixtures/init_prefix_3000.ndjson")
(fn wrong_pin () (List Int) "v3/kernel/test/fixtures/init_wrong_pin.ndjson")

;; a load of FILES under ROOT with the chunk list, its records
(fn load_case ((root (List Int)) (chunks (List (List Int))) (files (List (List Int))) (w World)) (Pair (List Rec) World)
  (match (parts_of root)
    (None (Pair Nil w))
    ((Some rootp)
     (match (load_all (load0 rootp chunks) files w)
       ((Pair l w1) (Pair (ld_recs l) w1))))))
;; the E program a load yields (classify.shard's es_prog)
(fn load_prog ((root (List Int)) (chunks (List (List Int))) (files (List (List Int))) (w World)) (Pair (Pair Prog (List Rec)) World)
  (match (parts_of root)
    (None (Pair (Pair (Prog Nil) Nil) w))
    ((Some rootp)
     (match (load_all (load0 rootp chunks) files w)
       ((Pair l w1) (Pair (Pair (es_prog (ld_e l)) (ld_recs l)) w1))))))
(fn main_fn ((s Symbol)) Name (Str (Str Anon (quote main)) s))
(fn load_all ((l Load) (files (List (List Int))) (w World)) (Pair Load World)
  (measure (struct files))
  (match files
    (Nil (Pair l w))
    ((Cons f r) (match (load_root_file l f w) ((Pair l1 w1) (load_all l1 r w1))))))

(fn show_recs ((rs (List Rec))) (List Int)
  (measure (struct rs))
  (match rs (Nil Nil) ((Cons x r) (append (show_rec x) (Cons 10 (show_recs r))))))
;; the records without their MODULE lines' file paths (the root's spelling)
(fn accept_lines ((rs (List Rec))) (List Int)
  (measure (struct rs))
  (match rs
    (Nil Nil)
    ((Cons (RAccept n m h a p q) r) (append (show_rec (RAccept n m h a p q)) (Cons 10 (accept_lines r))))
    ((Cons (RModule m _ h cl pf) r) (append (show_rec (RModule m Nil h cl pf)) (Cons 10 (accept_lines r))))
    ((Cons _ r) (accept_lines r))))
(fn inits ((rs (List Rec))) (List Int)
  (measure (struct rs))
  (match rs (Nil Nil) ((Cons (RInit _ k) r) (Cons k (inits r))) ((Cons _ r) (inits r))))
(fn has_rec ((rs (List Rec)) (want (List Int))) Bool
  (measure (struct rs))
  (match rs (Nil False) ((Cons x r) (if (int_list_eq (show_rec x) want) True (has_rec r want)))))
(fn has_read_err ((rs (List Rec)) (e Symbol)) Bool
  (measure (struct rs))
  (match rs (Nil False) ((Cons (RReadErr _ f _) r) (if (sym_eq e f) True (has_read_err r e))) ((Cons _ r) (has_read_err r e))))
(fn has_load_err ((rs (List Rec)) (e Symbol)) Bool
  (measure (struct rs))
  (match rs (Nil False) ((Cons (RLoadErr _ f _) r) (if (sym_eq e f) True (has_load_err r e))) ((Cons _ r) (has_load_err r e))))
(fn count_accepts ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs (Nil 0) ((Cons (RAccept _ _ _ _ _ _) r) (+ 1 (count_accepts r))) ((Cons _ r) (count_accepts r))))
(fn count_kind ((rs (List Rec)) (k Symbol)) Int
  (measure (struct rs))
  (match rs
    (Nil 0)
    ((Cons (RDischarge _ _) r) (+ (if (sym_eq k (quote discharge)) 1 0) (count_kind r k)))
    ((Cons (RImplRec _) r) (+ (if (sym_eq k (quote impl)) 1 0) (count_kind r k)))
    ((Cons _ r) (count_kind r k))))
(fn first ((xs (List Int))) Int (match xs ((Cons x _) x) (Nil 0)))
;; ACCEPT records of the named declaration
(fn count_named ((rs (List Rec)) (n (List Int))) Int
  (measure (struct rs))
  (match rs
    (Nil 0)
    ((Cons (RAccept m _ _ _ _ _) r) (+ (if (int_list_eq (show_name m) n) 1 0) (count_named r n)))
    ((Cons _ r) (count_named r n))))
;; Init's List of Nat cells, and back to text
(fn nat_list ((xs (List Int))) Val
  (measure (struct xs))
  (match xs
    (Nil (VCtor (n2 (quote List) (quote nil)) Nil))
    ((Cons x r) (VCtor (n2 (quote List) (quote cons)) (list (VInt x) (nat_list r))))))
(fn show_nat_list ((v Val)) (List Int)
  (measure (struct v))
  (match v
    ((VCtor _ (Cons (VInt x) (Cons r Nil))) (match r ((VCtor _ Nil) (show_nat x)) (_ (append (show_nat x) (Cons 32 (show_nat_list r))))))
    (_ "?")))
(fn second ((xs (List Int))) Int (match xs ((Cons _ (Cons x _)) x) (_ 0)))
