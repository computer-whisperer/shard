;;; v3/kernel/test/loader_kit.shard — shared by the loader-level tests
;;; (loader_test, loader_pins_test, entry_test): a load of root files under a
;;; package root, with or without the pinned export and its index
;;; (v3/export.sh's init.ndjson, kernel/test/init_index.sh's init.index — the
;;; suite driver keeps the index current), its records and the E program it
;;; yields, predicates over the records, Init's List cells. Not an entrypoint.

(import Init)
(import "reader_kit.shard")
(import "../loader.shard")
(import "../ev.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.etable)
(use kernel.host)
(use kernel.loader)
(use kernel.name)
(use kernel.prog)
(use kernel.util)
(use kernel.host.World)
(use kernel.loader.Rec)
(use kernel.loader.InitSt)
(use kernel.name.Name)
(use kernel.prog.Prog)
(use kernel.prog.Val)

(fn export_path () (List Int) ".shard-cache/v3-export/init.ndjson")
(fn index_path () (List Int) "v3/.cache/init.index")
(fn wrong_pin () (List Int) "v3/kernel/test/fixtures/init_wrong_pin.ndjson")  ; a meta line off the pin: refused before any record

;; the load a test starts from: with Init, the export and its index named (opened at the
;; first import, as a driver's); without, none
(fn kit_load0 ((rootp (List (List Int))) (init Bool)) Load
  (if init (ld_with_init (load0 rootp) (InitPaths (export_path) (index_path))) (load0 rootp)))
;; a load of FILES under ROOT, with or without Init, its records
(fn load_case ((root (List Int)) (init Bool) (files (List (List Int))) (w World))
  (Prod (List Rec) World)
  (match (parts_of root)
    (none (Prod.mk nil w))
    ((some rootp)
     (match (load_all (kit_load0 rootp init) files w)
       ((Prod.mk l w1) (Prod.mk (ld_recs l) w1))))))
;; a load with another export (the wrong-pin case) and the standard index
(fn load_case_on ((root (List Int)) (export (List Int)) (files (List (List Int))) (w World))
  (Prod (List Rec) World)
  (match (parts_of root)
    (none (Prod.mk nil w))
    ((some rootp)
     (match (load_all (ld_with_init (load0 rootp) (InitPaths export (index_path))) files w)
       ((Prod.mk l w1) (Prod.mk (ld_recs l) w1))))))
;; the E program a load yields (classify.shard's es_prog)
(fn load_prog ((root (List Int)) (init Bool) (files (List (List Int))) (w World))
  (Prod (Prod Prog (List Rec)) World)
  (match (parts_of root)
    (none (Prod.mk (Prod.mk (Prog nil) nil) w))
    ((some rootp)
     (match (load_all (kit_load0 rootp init) files w)
       ((Prod.mk l w1) (Prod.mk (Prod.mk (es_prog (Load.etab l)) (ld_recs l)) w1))))))
(fn main_fn ((s Symbol)) Name (Str (Str Anon (quote main)) s))
(fn load_all ((l Load) (files (List (List Int))) (w World)) (Prod Load World)
  (measure (struct files))
  (match files
    (nil (Prod.mk l w))
    ((cons f r)
     (match (load_root_file l f w)
       ((Prod.mk l1 w1) (load_all l1 r w1))))))

;; the records without their MODULE lines' file paths (the root's spelling)
(fn accept_lines ((rs (List Rec))) (List Int)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons (RAccept n m h a q k) r)
     (append (show_rec (RAccept n m h a q k)) (cons 10 (accept_lines r))))
    ((cons (RModule m _ h cl) r)
     (append (show_rec (RModule m nil h cl)) (cons 10 (accept_lines r))))
    ((cons _ r) (accept_lines r))))
(fn has_rec ((rs (List Rec)) (want (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons x r) (if (int_list_eq (show_rec x) want) true (has_rec r want)))))
(fn has_read_err ((rs (List Rec)) (e Symbol)) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RReadErr _ f _) r) (if (sym_eq e f) true (has_read_err r e)))
    ((cons _ r) (has_read_err r e))))
(fn has_load_err ((rs (List Rec)) (e Symbol)) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RLoadErr _ f _) r) (if (sym_eq e f) true (has_load_err r e)))
    ((cons _ r) (has_load_err r e))))
(fn count_accepts ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons (RAccept _ _ _ _ _ _) r) (+ 1 (count_accepts r)))
    ((cons _ r) (count_accepts r))))
(fn count_kind ((rs (List Rec)) (k Symbol)) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons (RDischarge _ _) r) (+ (if (sym_eq k (quote discharge)) 1 0) (count_kind r k)))
    ((cons (RImplRec _) r) (+ (if (sym_eq k (quote impl)) 1 0) (count_kind r k)))
    ((cons _ r) (count_kind r k))))
;; ACCEPT records of the named declaration
(fn count_named ((rs (List Rec)) (n (List Int))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons (RAccept m _ _ _ _ _) r) (+ (if (int_list_eq (show_name m) n) 1 0) (count_named r n)))
    ((cons _ r) (count_named r n))))
;; Init's List of Nat cells, and back to text
(fn nat_list ((xs (List Int))) Val
  (measure (struct xs))
  (match xs
    (nil (VCtor (n2 (quote List) (quote nil)) nil))
    ((cons x r) (VCtor (n2 (quote List) (quote cons)) (list (VInt x) (nat_list r))))))
(fn show_nat_list ((v Val)) (List Int)
  (measure (struct v))
  (match v
    ((VCtor _ (cons (VInt x) (cons r nil)))
     (match r
       ((VCtor _ nil) (show_nat x))
       (_ (append (show_nat x) (cons 32 (show_nat_list r))))))
    (_ "?")))
