;;; v3/kernel/test/sexpr_test.shard — the s-expression reader:
;;; atoms, lists, strings and their escapes, the quote mark refused,
;;; the universe suffix, negative numerals, comments,
;;; and every reader error with its declared reason.

(import "../host.shard")
(import "../sexpr.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.host)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.sexpr.RAll)
(use kernel.sexpr.SExpr)
(use kernel.sexpr.SRes)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


;; read one tree from S text and print it back
(fn rt ((src (List Int))) (List Int)
  (match (read_expr src (read_budget))
    ((SOk x _) (show_sexpr x))
    (SEnd (utf8 "<end>"))
    ((SErr e _) (append (utf8 "ERR ") (chars_of_sym e)))))
(fn same ((a (List Int)) (b (List Int))) Bool (int_list_eq a b))
(fn err_at ((src (List Int)) (e Symbol) (off Int)) Bool
  (match (read_all src)
    ((RAErr e2 k) (bool_and (sym_eq e e2) (= k off)))
    (_ false)))
(fn bytes_of ((src (List Int))) (List Int)
  (match (read_expr src (read_budget))
    ((SOk (SStr bs) _) bs)
    (_ (list 999))))

(fn cases () (List Case)
  (list (Case (utf8 "a numeral") (same (rt (utf8 "42")) (utf8 "42")))
    (Case (utf8 "a symbol with dots and primes")
      (same (rt (utf8 "List.length'")) (utf8 "List.length'")))
    (Case (utf8 "operator symbols") (same (rt (utf8 "(-> A B)")) (utf8 "(-> A B)")))
    (Case (utf8 "a nested list, whitespace normalized")
      (same (rt (utf8 "( def  x\n  (f 1)   )")) (utf8 "(def x (f 1))")))
    (Case (utf8 "a comment to the end of the line")
      (same (rt (utf8 "(a ; the b\n b)")) (utf8 "(a b)")))
    (Case (utf8 "there is no quote macro: a quote mark at a token's start is refused")
      (same (rt (utf8 "'x")) (utf8 "ERR no_quote")))
    (Case (utf8 "a prime inside an atom is the atom's") (same (rt (utf8 "f'")) (utf8 "f'")))
    (Case (utf8 "a string") (same (rt (utf8 "\"hi\"")) (utf8 "\"hi\"")))
    (Case (utf8 "string escapes: \\n \\t \\\\ \\\"")
      (same (bytes_of (utf8 "\"a\\n\\t\\\\\\\"\"")) (list 97 10 9 92 34)))
    (Case (utf8 "string escape \\xHH") (same (bytes_of (utf8 "\"\\x41\\x7a\"")) (list 65 122)))
    (Case (utf8 "string escape \\u{HHHH} to UTF-8")
      (same (bytes_of (utf8 "\"\\u{3b1}\\u{1F600}\"")) (list 206 177 240 159 152 128)))
    (Case (utf8 "raw UTF-8 in a string") (same (bytes_of (utf8 "\"α\"")) (list 206 177)))
    (Case (utf8 "a universe suffix with one level") (same (rt (utf8 "List.{0}")) (utf8 "List.{0}")))
    (Case (utf8 "a universe suffix with names and terms")
      (same (rt (utf8 "Sum.{(max u v) 0}")) (utf8 "Sum.{(max u v) 0}")))
    (Case (utf8 "a universe suffix with spaces inside")
      (same (rt (utf8 "Prod.{ u  v }")) (utf8 "Prod.{u v}")))
    (Case (utf8 "a universe suffix inside a list")
      (same (rt (utf8 "(List.{u} a)")) (utf8 "(List.{u} a)")))
    (Case (utf8 "a negative numeral reads in every file (the L reader refuses it in an L position)")
      (same (rt (utf8 "-7")) (utf8 "-7")))
    (Case (utf8 "a bare minus is a symbol, a minus before a non-digit an atom")
      (same (rt (utf8 "-x")) (utf8 "-x")))
    (Case (utf8 "S: a bare minus is a symbol") (same (rt (utf8 "(- a b)")) (utf8 "(- a b)")))
    (Case (utf8 "a numeral-led atom that is not a numeral")
      (same (rt (utf8 "7x")) (utf8 "ERR bad_numeral")))
    (Case (utf8 "unexpected close") (same (rt (utf8 ")")) (utf8 "ERR unexpected_close")))
    (Case (utf8 "unterminated list") (same (rt (utf8 "(a (b c)")) (utf8 "ERR unterminated_list")))
    (Case (utf8 "unterminated string") (same (rt (utf8 "\"abc")) (utf8 "ERR unterminated_string")))
    (Case (utf8 "bad escape") (same (rt (utf8 "\"\\q\"")) (utf8 "ERR bad_escape")))
    (Case (utf8 "bad \\u escape") (same (rt (utf8 "\"\\u{zz}\"")) (utf8 "ERR bad_escape")))
    (Case (utf8 "stray brace") (same (rt (utf8 "}")) (utf8 "ERR stray_brace")))
    (Case (utf8 "brace after a non-dot symbol")
      (same (rt (utf8 "List{0}")) (utf8 "ERR bad_universe_suffix")))
    (Case (utf8 "unterminated universe list")
      (same (rt (utf8 "List.{0")) (utf8 "ERR unterminated_universe_list")))
    (Case (utf8 "only whitespace and comments") (same (rt (utf8 "  ; nothing\n")) (utf8 "<end>")))
    (Case (utf8 "read_all: three forms")
      (match (read_all (utf8 "(a) b ; c\n \"s\""))
        ((RAOk (cons _ (cons _ (cons _ nil)))) true)
        (_ false)))
    (Case (utf8 "read_all: the error offset (byte 6)")
      (err_at (utf8 "(a b) )") (sym "unexpected_close") 6))
    (Case (utf8 "size_sexpr")
      (match (read_expr (utf8 "(a (b c) d)") (read_budget))
        ((SOk x _) (= (size_sexpr x) 6))
        (_ false)))))

(fn main ((w World)) World (run_cases (utf8 "sexpr_test") (cases) 0 w))
