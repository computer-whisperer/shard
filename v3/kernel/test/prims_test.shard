;;; v3/kernel/test/prims_test.shard — the primitive suite:
;;; every entry of prog.shard's table under `ev` with a
;;; positive, a negative and a boundary case, the expected values fixed by
;;; hand — the guards (stuck, never a value), the totalizations of the
;;; naming-law entries, the cells the decisions return, arithmetic past 64 bits,
;;; and the resource outcomes (a
;;; count or a size past K's limits is EXHAUSTED, never stuck — the guard
;;; says the input is outside the domain, exhaustion says nothing about it).
;;; One fn per entry applies it to
;;; Int parameters; the table is walked so that an entry without its three
;;; cases fails the count. Values past
;;; 64 bits are written as products: the
;;; bootstrap reads literals up to u64 and computes past it.

(import "../host.shard")
(import "../ev.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.ev)
(use kernel.host)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.name.Name)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.EvRes)
(use kernel.prog.Prim)
(use kernel.prog.Prog)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)

(type Exp (XInt Int) (XCtor Name) (XStuck) (XOut Symbol))
(type PCase (PCase (List Int) Name (List Val) Exp))

(fn nm_list () Name (n1 (sym "List")))
(fn nm_nil () Name (Str (nm_list) (sym "nil")))
(fn nm_cons () Name (Str (nm_list) (sym "cons")))
(fn nm_bool () Name (n1 (sym "Bool")))
(fn ty_int () EType (ETCon (n1 (sym "Int")) nil))
(fn list_decl () EDecl
  (EInd (nm_list) 1
    (list (ECtorDef (nm_nil) nil)
      (ECtorDef (nm_cons) (list (ETVar 0) (ETCon (nm_list) (list (ETVar 0))))))))
(fn bool_decl () EDecl
  (EInd (nm_bool) 0
    (list (ECtorDef (Str (nm_bool) (sym "false")) nil) (ECtorDef (Str (nm_bool) (sym "true")) nil))))
;; the entry's fn: t.NAME applying the primitive to its parameters
(fn tname ((n Name)) Name
  (measure (struct n))
  (match n
    (Anon (n1 (sym "t")))
    ((Str p s) (Str (tname p) s))
    ((Num p k) (Num (tname p) k))))
(fn op_decl ((n Name) (arity Int)) EDecl
  (if (= arity 1) (EFn (tname n) 0 (list (ty_int)) (ty_int) RecNone (EPrim n (list (EBVar 0))))
  (EFn (tname n) 0 (list (ty_int) (ty_int)) (ty_int) RecNone (EPrim n (list (EBVar 1) (EBVar 0))))))
(fn op_decls ((t (List (Prod Name Prim)))) (List EDecl)
  (measure (struct t))
  (match t
    (nil nil)
    ((cons (Prod.mk n (Prim _ arity)) r) (cons (op_decl n arity) (op_decls r)))))
(fn prog () Prog (Prog (cons (list_decl) (cons (bool_decl) (op_decls (prim_table))))))

(fn check ((r EvRes) (e Exp)) Bool
  (match e
    ((XInt k)
     (match r
       ((EvOk (VInt m)) (= m k))
       (_ false)))
    ((XCtor c)
     (match r
       ((EvOk (VCtor d nil)) (name_eq c d))
       (_ false)))
    (XStuck
      (match r
        ((EvStuck s _) (sym_eq s (sym "guard")))
        (_ false)))
    ((XOut res)
     (match r
       ((EvExhausted s _) (sym_eq s res))
       (_ false)))))
(fn run_pc ((c PCase)) Case
  (match c
    ((PCase name n args e) (Case name (check (ev (prog) (tname n) args 1000) e)))))
(fn run_pcs ((cs (List PCase))) (List Case)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r) (cons (run_pc c) (run_pcs r)))))
;; every entry of the table has exactly three cases
(fn count_for ((cs (List PCase)) (n Name)) Int
  (measure (struct cs))
  (match cs
    (nil 0)
    ((cons (PCase _ m _ _) r) (+ (if (name_eq m n) 1 0) (count_for r n)))))
(fn all_three ((t (List (Prod Name Prim))) (cs (List PCase))) Bool
  (measure (struct t))
  (match t
    (nil true)
    ((cons (Prod.mk n _) r) (if (<= 3 (count_for cs n)) (all_three r cs) false))))

(fn p1 ((s Symbol)) Name (n1 s))
(fn pn ((s Symbol)) Name (n2 (sym "Nat") s))
(fn pi ((s Symbol)) Name (n2 (sym "Int") s))
(fn ii ((a Int) (b Int)) (List Val) (list (VInt a) (VInt b)))
(fn ptrue () Exp (XCtor (Str (nm_bool) (sym "true"))))
(fn pfalse () Exp (XCtor (Str (nm_bool) (sym "false"))))
(fn btrue () Exp (XCtor (n2 (sym "Bool") (sym "true"))))
(fn bfalse () Exp (XCtor (n2 (sym "Bool") (sym "false"))))
(fn dtrue () Exp (XCtor (n2 (sym "Decidable") (sym "isTrue"))))
(fn dfalse () Exp (XCtor (n2 (sym "Decidable") (sym "isFalse"))))

(fn cases () (List PCase)
  (list
    ;; 0 =
    (PCase (utf8 "= 3 3 is True") (p1 (sym "=")) (ii 3 3) (ptrue))
    (PCase (utf8 "= 3 4 is False") (p1 (sym "=")) (ii 3 4) (pfalse))
    (PCase (utf8 "= past 64 bits: 2^70 = 2^70") (p1 (sym "="))
      (ii (* 1099511627776 1073741824) (* 1099511627776 1073741824))
      (ptrue))
    ;; 1 +
    (PCase (utf8 "+ 2 3 = 5") (p1 (sym "+")) (ii 2 3) (XInt 5))
    (PCase (utf8 "+ -2 -3 = -5") (p1 (sym "+")) (ii -2 -3) (XInt -5))
    (PCase (utf8 "+ past 64 bits: 2^63 + 2^63 = 2^64") (p1 (sym "+"))
      (ii 9223372036854775808 9223372036854775808)
      (XInt (* 4294967296 4294967296)))
    ;; 2 -
    (PCase (utf8 "- 5 3 = 2") (p1 (sym "-")) (ii 5 3) (XInt 2))
    (PCase (utf8 "- 3 5 = -2 (Int, not saturating)") (p1 (sym "-")) (ii 3 5) (XInt -2))
    (PCase (utf8 "- 0 2^63 = -2^63") (p1 (sym "-")) (ii 0 9223372036854775808)
      (XInt -9223372036854775808))
    ;; 3 <
    (PCase (utf8 "< 1 2 = True") (p1 (sym "<")) (ii 1 2) (ptrue))
    (PCase (utf8 "< 2 1 = False") (p1 (sym "<")) (ii 2 1) (pfalse))
    (PCase (utf8 "< 2 2 = False") (p1 (sym "<")) (ii 2 2) (pfalse))
    ;; 4 <=
    (PCase (utf8 "<= 1 2 = True") (p1 (sym "<=")) (ii 1 2) (ptrue))
    (PCase (utf8 "<= 2 1 = False") (p1 (sym "<=")) (ii 2 1) (pfalse))
    (PCase (utf8 "<= 2 2 = True") (p1 (sym "<=")) (ii 2 2) (ptrue))
    ;; 6 band
    (PCase (utf8 "band 12 10 = 8") (p1 (sym "band")) (ii 12 10) (XInt 8))
    (PCase (utf8 "band -1 5 = 5 (two's complement)") (p1 (sym "band")) (ii -1 5) (XInt 5))
    (PCase (utf8 "band 0 -1 = 0") (p1 (sym "band")) (ii 0 -1) (XInt 0))
    ;; 7 bshr
    (PCase (utf8 "bshr 16 2 = 4") (p1 (sym "bshr")) (ii 16 2) (XInt 4))
    (PCase (utf8 "bshr by 64 leaves nothing") (p1 (sym "bshr")) (ii 1 64) (XInt 0))
    (PCase (utf8 "bshr of a negative by 64 leaves the sign") (p1 (sym "bshr")) (ii -5 64) (XInt -1))
    (PCase (utf8 "bshr by a negative count is stuck (guard)") (p1 (sym "bshr")) (ii 1 -1) XStuck)
    (PCase (utf8 "bshr 2^63 63 = 1; -16 2 = -4 is arithmetic") (p1 (sym "bshr"))
      (ii 9223372036854775808 63)
      (XInt 1))
    ;; 8 *
    (PCase (utf8 "* 6 7 = 42") (p1 (sym "*")) (ii 6 7) (XInt 42))
    (PCase (utf8 "* -6 7 = -42") (p1 (sym "*")) (ii -6 7) (XInt -42))
    (PCase (utf8 "* past 64 bits: 2^40 * 2^40 = 2^80") (p1 (sym "*"))
      (ii 1099511627776 1099511627776)
      (XInt (* 1099511627776 1099511627776)))
    ;; 9 mod
    (PCase (utf8 "mod 7 3 = 1") (p1 (sym "mod")) (ii 7 3) (XInt 1))
    (PCase (utf8 "mod by zero is stuck (guard)") (p1 (sym "mod")) (ii 7 0) XStuck)
    (PCase (utf8 "mod -7 3 = 2 (Euclidean)") (p1 (sym "mod")) (ii -7 3) (XInt 2))
    ;; 10 /
    (PCase (utf8 "/ 7 2 = 3") (p1 (sym "/")) (ii 7 2) (XInt 3))
    (PCase (utf8 "/ by zero is stuck (guard)") (p1 (sym "/")) (ii 7 0) XStuck)
    (PCase (utf8 "/ -7 2 = -3 (truncating)") (p1 (sym "/")) (ii -7 2) (XInt -3))
    ;; 11 tmod
    (PCase (utf8 "tmod 7 3 = 1") (p1 (sym "tmod")) (ii 7 3) (XInt 1))
    (PCase (utf8 "tmod by zero is stuck (guard)") (p1 (sym "tmod")) (ii 7 0) XStuck)
    (PCase (utf8 "tmod -7 3 = -1 (the dividend's sign)") (p1 (sym "tmod")) (ii -7 3) (XInt -1))
    ;; 12 ediv
    (PCase (utf8 "ediv 7 2 = 3") (p1 (sym "ediv")) (ii 7 2) (XInt 3))
    (PCase (utf8 "ediv by zero is stuck (guard)") (p1 (sym "ediv")) (ii 7 0) XStuck)
    (PCase (utf8 "ediv -7 3 = -3 (pairs with mod: -7 = 3*-3 + 2)") (p1 (sym "ediv")) (ii -7 3)
      (XInt -3))
    ;; 13 bor
    (PCase (utf8 "bor 12 10 = 14") (p1 (sym "bor")) (ii 12 10) (XInt 14))
    (PCase (utf8 "bor -8 5 = -3") (p1 (sym "bor")) (ii -8 5) (XInt -3))
    (PCase (utf8 "bor 0 0 = 0") (p1 (sym "bor")) (ii 0 0) (XInt 0))
    ;; 14 bxor
    (PCase (utf8 "bxor 12 10 = 6") (p1 (sym "bxor")) (ii 12 10) (XInt 6))
    (PCase (utf8 "bxor -1 5 = -6") (p1 (sym "bxor")) (ii -1 5) (XInt -6))
    (PCase (utf8 "bxor 5 5 = 0") (p1 (sym "bxor")) (ii 5 5) (XInt 0))
    ;; 15 bshl
    (PCase (utf8 "bshl 1 4 = 16") (p1 (sym "bshl")) (ii 1 4) (XInt 16))
    (PCase (utf8 "bshl 1 64 = 2^64") (p1 (sym "bshl")) (ii 1 64) (XInt 18446744073709551616))
    (PCase (utf8 "bshl -5 100 = -5 · 2^100") (p1 (sym "bshl")) (ii -5 100)
      (XInt -6338253001141147007483516026880))
    (PCase (utf8 "bshl by a negative count is stuck (guard)") (p1 (sym "bshl")) (ii 1 -1) XStuck)
    (PCase (utf8 "bshl 1 63 = 2^63") (p1 (sym "bshl")) (ii 1 63) (XInt 9223372036854775808))
    ;; 18 Int.tdiv
    (PCase (utf8 "Int.tdiv 7 2 = 3") (pi (sym "tdiv")) (ii 7 2) (XInt 3))
    (PCase (utf8 "Int.tdiv -7 2 = -3 (truncating)") (pi (sym "tdiv")) (ii -7 2) (XInt -3))
    (PCase (utf8 "Int.tdiv x 0 = 0 (total)") (pi (sym "tdiv")) (ii 7 0) (XInt 0))
    ;; 19 Int.tmod
    (PCase (utf8 "Int.tmod 7 3 = 1") (pi (sym "tmod")) (ii 7 3) (XInt 1))
    (PCase (utf8 "Int.tmod -7 3 = -1") (pi (sym "tmod")) (ii -7 3) (XInt -1))
    (PCase (utf8 "Int.tmod x 0 = x (total)") (pi (sym "tmod")) (ii 7 0) (XInt 7))
    ;; 20 Int.ediv
    (PCase (utf8 "Int.ediv 7 2 = 3") (pi (sym "ediv")) (ii 7 2) (XInt 3))
    (PCase (utf8 "Int.ediv -7 2 = -4 (Euclidean)") (pi (sym "ediv")) (ii -7 2) (XInt -4))
    (PCase (utf8 "Int.ediv x 0 = 0 (total)") (pi (sym "ediv")) (ii 7 0) (XInt 0))
    ;; 21 Int.emod
    (PCase (utf8 "Int.emod 7 3 = 1") (pi (sym "emod")) (ii 7 3) (XInt 1))
    (PCase (utf8 "Int.emod -7 3 = 2 (never negative)") (pi (sym "emod")) (ii -7 3) (XInt 2))
    (PCase (utf8 "Int.emod x 0 = x (total)") (pi (sym "emod")) (ii 7 0) (XInt 7))
    ;; 22 Nat.sub
    (PCase (utf8 "Nat.sub 5 3 = 2") (pn (sym "sub")) (ii 5 3) (XInt 2))
    (PCase (utf8 "Nat.sub on a negative operand is stuck (guard)") (pn (sym "sub")) (ii -1 3) XStuck)
    (PCase (utf8 "Nat.sub 3 5 = 0 (saturating)") (pn (sym "sub")) (ii 3 5) (XInt 0))
    ;; 23 Nat.land
    (PCase (utf8 "Nat.land 12 10 = 8") (pn (sym "land")) (ii 12 10) (XInt 8))
    (PCase (utf8 "Nat.land on a negative is stuck (guard)") (pn (sym "land")) (ii -1 3) XStuck)
    (PCase (utf8 "Nat.land 0 2^70 = 0") (pn (sym "land")) (ii 0 (* 1099511627776 1073741824))
      (XInt 0))
    ;; 24 Nat.lor
    (PCase (utf8 "Nat.lor 12 10 = 14") (pn (sym "lor")) (ii 12 10) (XInt 14))
    (PCase (utf8 "Nat.lor on a negative is stuck (guard)") (pn (sym "lor")) (ii 3 -1) XStuck)
    (PCase (utf8 "Nat.lor 0 0 = 0") (pn (sym "lor")) (ii 0 0) (XInt 0))
    ;; 25 Nat.xor
    (PCase (utf8 "Nat.xor 12 10 = 6") (pn (sym "xor")) (ii 12 10) (XInt 6))
    (PCase (utf8 "Nat.xor on a negative is stuck (guard)") (pn (sym "xor")) (ii -1 -1) XStuck)
    (PCase (utf8 "Nat.xor 5 5 = 0") (pn (sym "xor")) (ii 5 5) (XInt 0))
    ;; 26 Nat.shiftLeft
    (PCase (utf8 "Nat.shiftLeft 1 4 = 16") (pn (sym "shiftLeft")) (ii 1 4) (XInt 16))
    (PCase (utf8 "Nat.shiftLeft on a negative is stuck (guard)") (pn (sym "shiftLeft")) (ii -1 1)
      XStuck)
    (PCase (utf8 "Nat.shiftLeft 1 64 = 2^64 (total past the host's 64 bits)") (pn (sym "shiftLeft"))
      (ii 1 64)
      (XInt (* 4294967296 4294967296)))
    (PCase (utf8 "Nat.shiftLeft 0 by 10^12 = 0 through the zero shortcut, no work")
      (pn (sym "shiftLeft"))
      (ii 0 1000000000000)
      (XInt 0))
    (PCase (utf8 "Nat.shiftLeft 1 by 2^32 is exhausted nat_count, not stuck") (pn (sym "shiftLeft"))
      (ii 1 4294967296)
      (XOut (sym "nat_count")))
    (PCase (utf8 "Nat.shiftLeft 1 by 2^31 is exhausted nat_size before any work")
      (pn (sym "shiftLeft"))
      (ii 1 2147483648)
      (XOut (sym "nat_size")))
    (PCase
      (utf8
        "Nat.shiftLeft 1 by 2^30 - 8 is exhausted nat_size (one byte over K's 2^27-byte cap), cheaply")
      (pn (sym "shiftLeft"))
      (ii 1 1073741816)
      (XOut (sym "nat_size")))
    ;; 27 Nat.shiftRight
    (PCase (utf8 "Nat.shiftRight 16 2 = 4") (pn (sym "shiftRight")) (ii 16 2) (XInt 4))
    (PCase (utf8 "Nat.shiftRight on a negative is stuck (guard)") (pn (sym "shiftRight")) (ii 16 -2)
      XStuck)
    (PCase (utf8 "Nat.shiftRight 2^70 70 = 1 (in 62-bit steps)") (pn (sym "shiftRight"))
      (ii (* 1099511627776 1073741824) 70)
      (XInt 1))
    ;; 28 Nat.add
    (PCase (utf8 "Nat.add 2 3 = 5") (pn (sym "add")) (ii 2 3) (XInt 5))
    (PCase (utf8 "Nat.add on a negative is stuck (guard)") (pn (sym "add")) (ii -1 3) XStuck)
    (PCase (utf8 "Nat.add 2^63 2^63 = 2^64") (pn (sym "add"))
      (ii 9223372036854775808 9223372036854775808)
      (XInt (* 4294967296 4294967296)))
    ;; 29 Nat.mul
    (PCase (utf8 "Nat.mul 6 7 = 42") (pn (sym "mul")) (ii 6 7) (XInt 42))
    (PCase (utf8 "Nat.mul on a negative is stuck (guard)") (pn (sym "mul")) (ii 6 -7) XStuck)
    (PCase (utf8 "Nat.mul 2^40 2^40 = 2^80") (pn (sym "mul")) (ii 1099511627776 1099511627776)
      (XInt (* 1099511627776 1099511627776)))
    ;; 30 Nat.div
    (PCase (utf8 "Nat.div 7 2 = 3") (pn (sym "div")) (ii 7 2) (XInt 3))
    (PCase (utf8 "Nat.div on a negative is stuck (guard)") (pn (sym "div")) (ii -6 2) XStuck)
    (PCase (utf8 "Nat.div x 0 = 0 (total)") (pn (sym "div")) (ii 7 0) (XInt 0))
    ;; 31 Nat.mod
    (PCase (utf8 "Nat.mod 7 3 = 1") (pn (sym "mod")) (ii 7 3) (XInt 1))
    (PCase (utf8 "Nat.mod on a negative is stuck (guard)") (pn (sym "mod")) (ii -7 3) XStuck)
    (PCase (utf8 "Nat.mod x 0 = x (total)") (pn (sym "mod")) (ii 7 0) (XInt 7))
    ;; 32 Nat.gcd
    (PCase (utf8 "Nat.gcd 12 18 = 6") (pn (sym "gcd")) (ii 12 18) (XInt 6))
    (PCase (utf8 "Nat.gcd on a negative is stuck (guard)") (pn (sym "gcd")) (ii -12 18) XStuck)
    (PCase (utf8 "Nat.gcd 0 5 = 5") (pn (sym "gcd")) (ii 0 5) (XInt 5))
    ;; 33 Nat.pow
    (PCase (utf8 "Nat.pow 2 10 = 1024") (pn (sym "pow")) (ii 2 10) (XInt 1024))
    (PCase (utf8 "Nat.pow on a negative is stuck (guard)") (pn (sym "pow")) (ii -2 2) XStuck)
    (PCase (utf8 "Nat.pow 0 0 = 1") (pn (sym "pow")) (ii 0 0) (XInt 1))
    (PCase (utf8 "Nat.pow 2 by 2^32 is exhausted nat_count, not stuck") (pn (sym "pow"))
      (ii 2 4294967296)
      (XOut (sym "nat_count")))
    (PCase (utf8 "Nat.pow 2 by 2^31 is exhausted nat_size before any work") (pn (sym "pow"))
      (ii 2 2147483648)
      (XOut (sym "nat_size")))
    (PCase
      (utf8 "Nat.pow 1 by 2^32 - 1 = 1 (the count at its cap; no size estimate for a base of 1)")
      (pn (sym "pow"))
      (ii 1 4294967295)
      (XInt 1))
    ;; 34 Nat.beq
    (PCase (utf8 "Nat.beq 3 3 = Bool.true") (pn (sym "beq")) (ii 3 3) (btrue))
    (PCase (utf8 "Nat.beq on a negative is stuck (guard)") (pn (sym "beq")) (ii -3 3) XStuck)
    (PCase (utf8 "Nat.beq 3 4 = Bool.false") (pn (sym "beq")) (ii 3 4) (bfalse))
    ;; 35 Nat.ble
    (PCase (utf8 "Nat.ble 2 3 = Bool.true") (pn (sym "ble")) (ii 2 3) (btrue))
    (PCase (utf8 "Nat.ble on a negative is stuck (guard)") (pn (sym "ble")) (ii -2 3) XStuck)
    (PCase (utf8 "Nat.ble 4 3 = Bool.false") (pn (sym "ble")) (ii 4 3) (bfalse))
    ;; 36 Nat.decEq
    (PCase (utf8 "Nat.decEq 3 3 = Decidable.isTrue") (pn (sym "decEq")) (ii 3 3) (dtrue))
    (PCase (utf8 "Nat.decEq on a negative is stuck (guard)") (pn (sym "decEq")) (ii -3 3) XStuck)
    (PCase (utf8 "Nat.decEq 3 4 = Decidable.isFalse") (pn (sym "decEq")) (ii 3 4) (dfalse))
    ;; 37 Nat.decLt
    (PCase (utf8 "Nat.decLt 2 3 = Decidable.isTrue") (pn (sym "decLt")) (ii 2 3) (dtrue))
    (PCase (utf8 "Nat.decLt on a negative is stuck (guard)") (pn (sym "decLt")) (ii -2 3) XStuck)
    (PCase (utf8 "Nat.decLt 3 3 = Decidable.isFalse") (pn (sym "decLt")) (ii 3 3) (dfalse))
    ;; 38 Nat.decLe
    (PCase (utf8 "Nat.decLe 2 3 = Decidable.isTrue") (pn (sym "decLe")) (ii 2 3) (dtrue))
    (PCase (utf8 "Nat.decLe on a negative is stuck (guard)") (pn (sym "decLe")) (ii -2 3) XStuck)
    (PCase (utf8 "Nat.decLe 4 3 = Decidable.isFalse") (pn (sym "decLe")) (ii 4 3) (dfalse))))

(fn main ((w World)) World
  (run_cases (utf8 "prims_test")
    (cons (Case (utf8 "the table has 36 entries") (= (len (prim_table)) 36))
      (cons
        (Case (utf8 "every entry has at least its three cases") (all_three (prim_table) (cases)))
        (run_pcs (cases))))
    0
    w))
