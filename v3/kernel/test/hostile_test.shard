;;; v3/kernel/test/hostile_test.shard — T0's hostile battery (FOUNDATION
;;; §12.5): declarations that must be REFUSED, each for its declared
;;; reason, and the accelerator-identity cases that speak through the public
;;; entry. A CLIENT of K: it imports the view only (the K seal, §13 item 26 —
;;; GPT-6 R52's forged-node fixtures exercising the public entry); the
;;; matcher's own cases (7c, 7d, the 7e rows) live inside the directory,
;;; k/test/accel_test.shard. Nothing here may be
;;; Accepted except where a case says so (the budget cases 12: exhaustion is
;;; not a verdict, and §9.4's fuel monotonicity — a result reached under a
;;; budget is the same under any larger one, since exhaustion is never cached).
;;; The old tree's six 2026 holes lived in special rules,
;;; dispatch tables and text-derived gates; K has none, so their
;;; analogues are the pin gates and the raw-input checks below.

(import "../host.shard")
(import "../json.shard")
(import "../k")
(import "case_kit.shard")
(import "decls_kit.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.json)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.QuotKind)
(use kernel.decl.ReducibilityHints)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.expr.BinderInfo)
(use kernel.expr.D)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.expr.Memo)
(use kernel.expr.St)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.verdict.KRes)
(use kernel.host.World)
(use kernel.json.JRes)
(use kernel.level.Level)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)
(fn e0 () CheckedEnv (env_empty))
(fn e_nat () CheckedEnv (env_after (check (e0) (st0) (nat_decl)) (e0)))
(fn e_eq () CheckedEnv (env_after (check (e_nat) (st0) (eq_decl)) (e0)))
;; §9.4 fuel monotonicity: two acceptances admitted the same identity
(fn same_identity ((a (Outcome CheckedEnv)) (b (Outcome CheckedEnv)) (n Name)) Bool
  (match a
    ((Accepted ea)
     (match b
       ((Accepted eb)
        (match (identity_hash ea n)
          ((Some x) (match (identity_hash eb n) ((Some y) (= x y)) (None False)))
          (None False)))
       (_ False)))
    (_ False)))
(fn not_accepted ((o (Outcome CheckedEnv))) Bool (bool_not (accepted o)))
;; --- the cases ------------------------------------------------------------------

;; 1. universe collapse: def bad : Prop := Nat  (Nat : Type, never Prop)
(fn c_collapse () Declaration (DefnDecl (cv (n1 (quote bad)) Nil (mk_sort LZero)) (nat) (HRegular 1) Safe (list (n1 (quote bad)))))
;; 2. scope capture: a loose bound variable in a value
(fn c_loose () Declaration (DefnDecl (cv (n1 (quote loose)) Nil (nat)) (mk_bvar 0) (HRegular 1) Safe (list (n1 (quote loose)))))
;; 2b. a free variable smuggled into a type
(fn c_fvar () Declaration (AxiomDecl (cv (n1 (quote smug)) Nil (mk_fvar 7)) False))
;; 3. a forged recursor cannot be declared: Declaration has no recursor form; a
;;    constructor returning the wrong type is the closest raw forgery
(fn c_forged () Declaration
  (InductDecl Nil 0 (list (InductiveType (n1 (quote F)) (type1) (list (Constructor (n2 (quote F) (quote mk)) (nat))))) False))
;; 4. non-positive occurrence
(fn c_nonpos () Declaration
  (InductDecl Nil 0 (list (InductiveType (n1 (quote Bad)) (type1)
    (list (Constructor (n2 (quote Bad) (quote mk)) (arrow (arrow (mk_const (n1 (quote Bad)) Nil) (nat)) (mk_const (n1 (quote Bad)) Nil)))))) False))
;; 5. illicit Prop elimination: Or-like predicate (two constructors) eliminates
;;    only into Prop, so its recursor has no universe parameter — Or2.rec.{1} is refused
(fn or_decl () Declaration
  (InductDecl Nil 0 (list (InductiveType (n1 (quote Or2)) (mk_sort LZero)
    (list (Constructor (n2 (quote Or2) (quote l)) (mk_const (n1 (quote Or2)) Nil)) (Constructor (n2 (quote Or2) (quote r)) (mk_const (n1 (quote Or2)) Nil))))) False))
(fn e_or () CheckedEnv (env_after (check (e_nat) (st0) (or_decl)) (e0)))
(fn c_large_elim () Declaration
  (DefnDecl (cv (n1 (quote elim)) Nil (arrow (mk_const (n1 (quote Or2)) Nil) (nat)))
    (mk_lam (n1 (quote h)) BDefault (mk_const (n1 (quote Or2)) Nil)
      (mk_app (mk_app (mk_app (mk_app (mk_const (n2 (quote Or2) (quote rec)) (list (LSucc LZero))) (mk_lam (x_) BDefault (mk_const (n1 (quote Or2)) Nil) (nat))) (lit 0)) (lit 1)) (mk_bvar 0)))
    (HRegular 1) Safe (list (n1 (quote elim)))))
;; 5b. data out of a proof: a Prop structure with a Nat field cannot be projected
(fn ex_decl () Declaration
  (InductDecl Nil 0 (list (InductiveType (n1 (quote Ex)) (mk_sort LZero)
    (list (Constructor (n2 (quote Ex) (quote mk)) (arrow (nat) (mk_const (n1 (quote Ex)) Nil)))))) False))
(fn e_ex () CheckedEnv (env_after (check (e_nat) (st0) (ex_decl)) (e0)))
(fn c_proj_prop () Declaration
  (DefnDecl (cv (n1 (quote leak)) Nil (arrow (mk_const (n1 (quote Ex)) Nil) (nat)))
    (mk_lam (n1 (quote h)) BDefault (mk_const (n1 (quote Ex)) Nil) (mk_proj (n1 (quote Ex)) 0 (mk_bvar 0)))
    (HRegular 1) Safe (list (n1 (quote leak)))))
;; 6. cyclic / self-referential definition
(fn c_cyclic () Declaration (DefnDecl (cv (n1 (quote cyc)) Nil (nat)) (mk_const (n1 (quote cyc)) Nil) (HRegular 1) Safe (list (n1 (quote cyc)))))
;; 7. the same-spelled non-core Nat.add: a user definition `Nat.add a b := a`
(fn user_add () Declaration
  (DefnDecl (cv (n2 (quote Nat) (quote add)) Nil (arrow (nat) (arrow (nat) (nat))))
    (mk_lam (n1 (quote a)) BDefault (nat) (mk_lam (n1 (quote b)) BDefault (nat) (mk_bvar 1))) (HRegular 1) Safe (list (n2 (quote Nat) (quote add)))))
(fn e_user_add () CheckedEnv (env_after (check (e_eq) (st0) (user_add)) (e0)))
;; 7b. GPT-6 R42 (2026-09-12): the same-spelled Nat.add whose 61-bit identity
;;     hash EQUALLED the committed pin — `Nat.add a b := 1781693077243641776`,
;;     the literal one subtraction from the pin (the hash is affine in it).
;;     Before the fix K pinned it and accepted `Nat.add 2 3 = 5` by the
;;     accelerator (records §4.7). Now: admitted as an ordinary definition; the
;;     reference closure refuses it; `Nat.add 2 3 = 5` is not established and
;;     `Nat.add 2 3 = 1781693077243641776` holds by the definition.
(fn big () Int 1781693077243641776)
(fn collide_add () Declaration
  (DefnDecl (cv (nm_add) Nil (arrow (nat) (arrow (nat) (nat))))
    (mk_lam (n1 (quote a)) BDefault (nat) (mk_lam (n1 (quote b)) BDefault (nat) (lit (big)))) (HRegular 1) Safe (list (nm_add))))
(fn e_collide () CheckedEnv (env_after (check (e_eq) (st0) (collide_add)) (e0)))
(fn t_add_five () Declaration
  (ThmDecl (cv (n1 (quote t5)) Nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 5))) (refl_nat (lit 5)) (list (n1 (quote t5)))))
(fn t_add_big () Declaration
  (ThmDecl (cv (n1 (quote tb)) Nil (eq_nat (nat_add (lit 2) (lit 3)) (lit (big)))) (refl_nat (lit (big))) (list (n1 (quote tb)))))
;; 7e. GPT-6 R49 (2026-09-13): a THEOREM named Nat.add in an environment without
;;     one — an exempt kind under a candidate's name. Before the fix `ref_matches`
;;     said True on ThmInfo without consulting the row and the name was PINNED;
;;     K never applied it (a theorem's type is not a Pi: function_expected), so
;;     an authorization hole, not a false theorem. Now: admitted, not pinned; the
;;     matcher refuses every exempt kind under a rowed name and accepts them
;;     under a name the table holds no row for (a closure's own theorem).
(fn thm_add () Declaration (ThmDecl (cv (nm_add) Nil (eq_nat (zero) (zero))) (refl_nat (zero)) (list (nm_add))))
(fn o_thm_add () (Outcome CheckedEnv) (check (e_eq) (st0) (thm_add)))
(fn e_thm_add () CheckedEnv (env_after (o_thm_add) (e0)))
(fn t_add_true () Declaration   ; Nat.add 2 3 = 2 holds for the USER's Nat.add
  (ThmDecl (cv (n1 (quote t1)) Nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 2))) (refl_nat (lit 2)) (list (n1 (quote t1)))))
(fn t_add_false () Declaration  ; Nat.add 2 3 = 5 does NOT — a name-keyed accelerator would accept it
  (ThmDecl (cv (n1 (quote t2)) Nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 5))) (refl_nat (lit 5)) (list (n1 (quote t2)))))
;; 8. a Nat literal under an environment whose Nat is not the pinned one
(fn odd_nat_decl () Declaration
  (InductDecl Nil 0 (list (InductiveType (nm_nat) (type1)
    (list (Constructor (nm_nat_zero) (nat)) (Constructor (nm_nat_succ) (arrow (nat) (nat))) (Constructor (n2 (quote Nat) (quote extra)) (nat))))) False))
(fn e_odd () CheckedEnv (env_after (check (e0) (st0) (odd_nat_decl)) (e0)))
(fn c_lit_unpinned () Declaration (DefnDecl (cv (n1 (quote seven)) Nil (nat)) (lit 7) (HRegular 1) Safe (list (n1 (quote seven)))))
;; 8b. a string literal under an environment whose String is not the pinned one
(fn odd_string_decl () Declaration
  (InductDecl Nil 0 (list (InductiveType (nm_string) (type1)
    (list (Constructor (n2 (quote String) (quote mk)) (mk_const (nm_string) Nil))))) False))
(fn e_odd_string () CheckedEnv (env_after (check (e0) (st0) (odd_string_decl)) (e0)))
(fn c_str_unpinned () Declaration
  (DefnDecl (cv (n1 (quote hello)) Nil (mk_const (nm_string) Nil)) (mk_lit (LitStr "hi")) (HRegular 1) Safe (list (n1 (quote hello)))))
;; 9. duplicates
(fn c_dup_ctor () Declaration
  (InductDecl Nil 0 (list (InductiveType (n1 (quote D)) (type1)
    (list (Constructor (n2 (quote D) (quote a)) (mk_const (n1 (quote D)) Nil)) (Constructor (n2 (quote D) (quote a)) (mk_const (n1 (quote D)) Nil))))) False))
(fn c_dup_univ () Declaration (AxiomDecl (cv (n1 (quote du)) (list (n1 (quote u)) (n1 (quote u))) (mk_sort (u))) False))
;; 10. a theorem whose type is not a proposition
(fn c_thm_data () Declaration (ThmDecl (cv (n1 (quote td)) Nil (nat)) (zero) (list (n1 (quote td)))))
;; 11. Quot under a wrong Eq (an extra constructor)
(fn bad_eq_decl () Declaration
  (InductDecl (list (n1 (quote u))) 2
    (list (InductiveType (nm_eq)
            (mk_pi (n1 (quote a)) BImplicit (mk_sort (u)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0) (mk_pi (n1 (quote b)) BDefault (mk_bvar 1) (mk_sort LZero))))
            (list (Constructor (nm_eq_refl)
                    (mk_pi (n1 (quote a)) BImplicit (mk_sort (u)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0)
                      (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (u))) (mk_bvar 1)) (mk_bvar 0)) (mk_bvar 0)))))
                  (Constructor (n2 (quote Eq) (quote bogus))
                    (mk_pi (n1 (quote a)) BImplicit (mk_sort (u)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0) (mk_pi (n1 (quote b)) BDefault (mk_bvar 1)
                      (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (u))) (mk_bvar 2)) (mk_bvar 1)) (mk_bvar 0)))))))))
    False))
(fn e_bad_eq () CheckedEnv (env_after (check (e_nat) (st0) (bad_eq_decl)) (e0)))
;; 12. exhaustion is never a verdict: a definition under a tiny budget
(fn c_deep () Declaration
  (DefnDecl (cv (n1 (quote deep)) Nil (nat)) (mk_app (mk_lam (x_) BDefault (nat) (mk_app (mk_lam (x_) BDefault (nat) (mk_bvar 0)) (mk_bvar 0))) (zero)) (HRegular 1) Safe (list (n1 (quote deep)))))
;; 13. unsafe / partial / mutual are out of the profile
(fn c_unsafe () Declaration (DefnDecl (cv (n1 (quote un)) Nil (nat)) (zero) (HRegular 1) Unsafe (list (n1 (quote un)))))
(fn c_partial () Declaration (DefnDecl (cv (n1 (quote pa)) Nil (nat)) (zero) (HRegular 1) Partial (list (n1 (quote pa)))))
;; 14. an auxiliary-nested name reserved
(fn c_reserved () Declaration
  (InductDecl Nil 0 (list (InductiveType (n2 (quote _nested) (quote X)) (type1) (list (Constructor (n2 (quote _nested) (quote mk)) (mk_const (n2 (quote _nested) (quote X)) Nil))))) False))
;; 16. GPT-6 R43 (2026-09-12): node data on a raw term is a claim. Before the raw
;;     entry ingested its input, two different literals wearing one positive id
;;     made `0 = 1` a theorem (quick_is_def_eq's expr_eq shortcut); a BVar
;;     claiming a closed range, an FVar claiming no fvar, slipped their checks.
;;     `check` now rebuilds every node from its structure (expr.shard ingest_expr) — since
;;     2026-11-11 each distinct structure once, the nodes minted by the check (case 19).
(fn forged_lit ((k Int)) Expr (Lit (D 5 12345 0 False False False) (LitNat k)))
(fn c_forged_ids () Declaration
  (ThmDecl (cv (n1 (quote zero_eq_one)) Nil (eq_nat (forged_lit 0) (forged_lit 1))) (refl_nat (forged_lit 0)) (list (n1 (quote zero_eq_one)))))
;; a loose BVar 0 whose node data claims a closed term
(fn c_forged_range () Declaration
  (DefnDecl (cv (n1 (quote closed)) Nil (nat)) (BVar (D 0 (mix 29 0) 0 False False False) 0) (HRegular 1) Safe (list (n1 (quote closed)))))
;; an FVar whose node data claims has_fvar = false
(fn c_forged_fvar () Declaration (AxiomDecl (cv (n1 (quote nofv)) Nil (FVar (D 0 (mix 31 7) 0 False False False) 7)) False))
;; slice 3.15: a metavariable is the elaborator's; K refuses it in a type, in a value, and
;; when its node data claims has_mvar = false (ingestion rebuilds the claim; infer refuses the node)
(fn c_mvar_type () Declaration (AxiomDecl (cv (n1 (quote nomv)) Nil (mk_mvar 3)) False))
(fn c_mvar_value () Declaration (DefnDecl (cv (n1 (quote nomvv)) Nil (nat)) (mk_mvar 4) (HRegular 1) Safe (list (n1 (quote nomvv)))))
(fn c_forged_mvar () Declaration (AxiomDecl (cv (n1 (quote nomvf)) Nil (MVar (D 0 (mix 73 5) 0 False False False) 5)) False))
(fn c_lmvar () Declaration (AxiomDecl (cv (n1 (quote nolmv)) Nil (mk_sort (LMVar 2))) False))
;; a stale cached hash on a correct term: two = two by rfl, the right-hand `two` mis-hashed
(fn two_lit () Expr (mk_app (mk_const (nm_nat_succ) Nil) (mk_app (mk_const (nm_nat_succ) Nil) (mk_const (nm_nat_zero) Nil))))
(fn stale_two () Expr (match (two_lit) ((App _ f a) (App (D 0 999 0 False False False) f a)) (e e)))
(fn c_stale_hash () Declaration
  (ThmDecl (cv (n1 (quote two_two)) Nil (eq_nat (two_lit) (stale_two))) (refl_nat (two_lit)) (list (n1 (quote two_two)))))
;; snapshot forks: from one env, two checks mint the same ids for different
;; nodes; a node taken from one fork, submitted into the other, must not be
;; equated by its id — `a`'s value (fun x => x) from fork A against `b`'s
;; (fun x => Nat.zero) from fork B
(fn nat_fn () Expr (arrow (nat) (nat)))
(fn d_a () Declaration (DefnDecl (cv (n1 (quote a)) Nil (nat_fn)) (mk_lam (x_) BDefault (nat) (mk_bvar 0)) (HRegular 1) Safe (list (n1 (quote a)))))
(fn d_b () Declaration (DefnDecl (cv (n1 (quote b)) Nil (nat_fn)) (mk_lam (x_) BDefault (nat) (mk_const (nm_nat_zero) Nil)) (HRegular 1) Safe (list (n1 (quote b)))))
(fn e_fork_a () CheckedEnv (env_after (check (e_eq) (st0) (d_a)) (e0)))
(fn e_fork_b () CheckedEnv (env_after (check (e_eq) (st0) (d_b)) (e0)))
(fn value_of ((env CheckedEnv) (n Name)) Expr
  (match (env_find env n) ((Some (DefnInfo _ v _ _ _)) v) (_ (nat))))
(fn c_fork_mix () Declaration
  (ThmDecl (cv (n1 (quote a_is_b)) Nil
             (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (LSucc LZero))) (nat_fn)) (value_of (e_fork_a) (n1 (quote a)))) (value_of (e_fork_b) (n1 (quote b)))))
           (mk_app (mk_app (mk_const (nm_eq_refl) (list (LSucc LZero))) (nat_fn)) (value_of (e_fork_a) (n1 (quote a))))
           (list (n1 (quote a_is_b)))))
(fn ids_collide () Bool
  (= (expr_id (value_of (e_fork_a) (n1 (quote a)))) (expr_id (value_of (e_fork_b) (n1 (quote b))))))
;; independently built anonymous terms compare by structure
(fn built_twice () Bool (expr_eq (two_lit) (two_lit)))
;; a failed check leaves the env it was given untouched: the next check sees no trace
(fn after_failure () Bool
  (bool_and (refused (check (e_eq) (st0) (c_forged_ids)) (quote conversion))
            (accepted (check (e_eq) (st0) (t_add_true_std)))))
(fn t_add_true_std () Declaration
  (ThmDecl (cv (n1 (quote two_rfl)) Nil (eq_nat (two_lit) (two_lit))) (refl_nat (two_lit)) (list (n1 (quote two_rfl)))))
;; 18. Two environments joined (2026-11-11; LANGUAGE.md §8.6 "One environment, one counter").
;;     A node's id is unique within the counter that minted it and expr_eq answers true on two
;;     equal positive ids. Before the view lost `env_transfer` and `run_with_env`, two record
;;     runs from the empty run — each minting id 1 for its first compound node — met in one
;;     environment and `boom : (p : Prop) → p := h c1` was ACCEPTED with no axiom: `Prop → Prop`
;;     and `(p : Prop) → p` were one id. A second route needed no id: a constant proven where a
;;     citation of its citation meant one thing, transferred to where it meant another. What the
;;     view still spells: a second source's records on a fresh run over the first's environment.
(fn feed ((r Run) (lines (List (List Int)))) Run
  (measure (struct lines))
  (match lines
    (Nil r)
    ((Cons l rest) (match (json_parse l) ((JRes j _) (match (process_record r j) ((Pair r1 _) (feed r1 rest)))) (JErr r)))))
(fn c1_ () Name (n1 (quote c1)))
(fn h_ () Name (n1 (quote h)))
(fn cp_ () Name (n1 (quote cp)))
(fn c_ () Name (n1 (quote c)))
(fn d_ () Name (n1 (quote d)))
;; source A: c1 : Prop → Prop := fun p => p
(fn ids_a () (List (List Int))
  (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"c1\"}}"
        "{\"ie\":1,\"sort\":0}"
        "{\"ie\":2,\"forallE\":{\"binderInfo\":\"default\",\"body\":1,\"name\":0,\"type\":1}}"
        "{\"ie\":3,\"bvar\":0}"
        "{\"ie\":4,\"lam\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":1}}"
        "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":2,\"value\":4}}"))
;; source B: h : F → F := fun x => x, F = (p : Prop) → p
(fn ids_b () (List (List Int))
  (list "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"h\"}}"
        "{\"ie\":11,\"sort\":0}"
        "{\"ie\":12,\"bvar\":0}"
        "{\"ie\":13,\"forallE\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":11}}"
        "{\"ie\":14,\"forallE\":{\"binderInfo\":\"default\",\"body\":13,\"name\":0,\"type\":13}}"
        "{\"ie\":15,\"lam\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":13}}"
        "{\"def\":{\"all\":[2],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":14,\"value\":15}}"))
;; source A': cp : Prop := (p : Prop) → p → p (true); c : Prop := cp
(fn cite_a () (List (List Int))
  (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"cp\"}}"
        "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"c\"}}"
        "{\"ie\":1,\"sort\":0}"
        "{\"ie\":2,\"bvar\":0}"
        "{\"ie\":3,\"bvar\":1}"
        "{\"ie\":4,\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":2}}"
        "{\"ie\":5,\"forallE\":{\"binderInfo\":\"default\",\"body\":4,\"name\":0,\"type\":1}}"
        "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":1,\"value\":5}}"
        "{\"ie\":6,\"const\":{\"name\":1,\"us\":[]}}"
        "{\"def\":{\"all\":[2],\"hints\":{\"regular\":2},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":1,\"value\":6}}"))
;; source B': cp : Prop := (p : Prop) → p (false); c : Prop := cp; d : c → F := fun x => x
(fn cite_b () (List (List Int))
  (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"cp\"}}"
        "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"c\"}}"
        "{\"in\":3,\"str\":{\"pre\":0,\"str\":\"d\"}}"
        "{\"ie\":1,\"sort\":0}"
        "{\"ie\":2,\"bvar\":0}"
        "{\"ie\":3,\"forallE\":{\"binderInfo\":\"default\",\"body\":2,\"name\":0,\"type\":1}}"
        "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":1,\"value\":3}}"
        "{\"ie\":4,\"const\":{\"name\":1,\"us\":[]}}"
        "{\"def\":{\"all\":[2],\"hints\":{\"regular\":2},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":1,\"value\":4}}"
        "{\"ie\":5,\"const\":{\"name\":2,\"us\":[]}}"
        "{\"ie\":6,\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":5}}"
        "{\"ie\":7,\"lam\":{\"binderInfo\":\"default\",\"body\":2,\"name\":0,\"type\":5}}"
        "{\"def\":{\"all\":[3],\"hints\":{\"regular\":3},\"levelParams\":[],\"name\":3,\"safety\":\"safe\",\"type\":6,\"value\":7}}"))
(fn env_of ((lines (List (List Int)))) CheckedEnv (run_env (feed (empty_run False) lines)))
;; B's records on a fresh run over A's environment
(fn env_onto ((a (List (List Int))) (b (List (List Int)))) CheckedEnv (run_env (feed (run_on (env_of a)) b)))
(fn holds ((e CheckedEnv) (n Name)) Bool (match (env_find e n) ((Some _) True) (None False)))
(fn type_id ((e CheckedEnv) (n Name)) Int (match (env_find e n) ((Some i) (expr_id (ci_type i))) (None (- 0 1))))
(fn dom_id ((e CheckedEnv) (n Name)) Int
  (match (env_find e n) ((Some i) (match (ci_type i) ((Pi _ _ _ dm _) (expr_id dm)) (_ (- 0 2)))) (None (- 0 1))))
;; F = (p : Prop) → p, raw; boom : F by a function applied to an argument
(fn false_type () Expr (mk_pi (n1 (quote p)) BDefault (mk_sort LZero) (mk_bvar 0)))
(fn boom_by ((f Name) (arg Expr)) Declaration
  (ThmDecl (cv (n1 (quote boom)) Nil (false_type)) (mk_app (mk_const f Nil) arg) (list (n1 (quote boom)))))
;; (fun (p : Prop) (x : p) => x) : (p : Prop) → p → p
(fn id_true () Expr (mk_lam (n1 (quote p)) BDefault (mk_sort LZero) (mk_lam (x_) BDefault (mk_bvar 0) (mk_bvar 0))))
(fn boom_ids () Declaration (boom_by (h_) (mk_const (c1_) Nil)))
(fn boom_cite () Declaration (boom_by (d_) (id_true)))
;; 19. The raw entry builds each structure once (2026-11-11; LANGUAGE.md §8.6): what a caller
;;     builds twice is one node of what is admitted — whatever ids it wore, and none read —,
;;     minted by the check above the environment's watermark; a binder's name is display data
;;     and is kept: two binders that differ in it stay two nodes.
(fn arrow_as ((n Symbol)) Expr (mk_pi (n1 n) BDefault (nat) (nat)))
;; twice : A → B → Nat := fun f g => Nat.zero, A and B each a `Nat → Nat` built on its own
(fn d_twice ((nm Symbol) (a Symbol) (b Symbol)) Declaration
  (DefnDecl (cv (n1 nm) Nil (mk_pi (n1 (quote f)) BDefault (arrow_as a) (mk_pi (n1 (quote g)) BDefault (arrow_as b) (nat))))
            (mk_lam (n1 (quote f)) BDefault (arrow_as a) (mk_lam (n1 (quote g)) BDefault (arrow_as b) (zero)))
            (HRegular 1) Safe (list (n1 nm))))
(fn e_twice ((a Symbol) (b Symbol)) CheckedEnv (env_after (check (e_nat) (st0) (d_twice (quote twice) a b)) (e0)))
;; the first and the second domain of a constant's type; the first domain of its value
(fn dom1 ((x Expr)) Expr (match x ((Pi _ _ _ dm _) dm) ((Lam _ _ _ dm _) dm) (_ x)))
(fn dom2 ((x Expr)) Expr (match x ((Pi _ _ _ _ (Pi _ _ _ dm _)) dm) (_ x)))
(fn type_in ((e CheckedEnv)) Expr (match (env_find e (n1 (quote twice))) ((Some i) (ci_type i)) (None (nat))))
(fn value_in ((e CheckedEnv)) Expr (value_of e (n1 (quote twice))))
(fn binder_is ((x Expr) (n Symbol)) Bool (match x ((Pi _ m _ _ _) (name_eq m (n1 n))) (_ False)))
(fn above ((e CheckedEnv) (x Expr)) Bool (< 0 (expr_id x)))
;; 19b. The rebuild itself (expr.shard ingest_expr, public) under a state that mints no id: two
;;      binders that differ in name under equal structure keep their names there too — two
;;      compound nodes without an id are never taken for one (found by review, 2026-11-11:
;;      they were compared by expr_eq, which is blind to the name).
(fn k_of ((n Symbol)) Expr (mk_app (mk_const (n1 (quote k)) Nil) (arrow_as n)))
(fn two_ks () Expr (mk_app (mk_app (mk_const (n1 (quote pair)) Nil) (k_of (quote x))) (k_of (quote y))))
(fn rebuilt ((st St)) Expr (match (ingest_expr (ingest_new st) (two_ks)) ((Pair _ e) e)))
(fn first_binder ((e Expr)) Name (match e ((App _ (App _ _ (App _ _ (Pi _ n _ _ _))) _) n) (_ Anon)))
(fn second_binder ((e Expr)) Name (match e ((App _ _ (App _ _ (Pi _ n _ _ _))) n) (_ Anon)))
;; 20. A caller's state carries memo tables (found by review, 2026-11-11): St and Memo are
;;     public data, and the view's advisory `infer` answers from a table its caller wrote —
;;     here, that `fun (p : Prop) (x : p) => x` has the type `(p : Prop) → p`. `check` starts
;;     from its own tables whatever it is handed (st_seed), at any counter.
(fn forged_key ((e Expr)) Int (band (hash_expr e) 16777215))
(fn forged_one ((k Expr) (v Expr)) (IntMap (List (Pair Expr Expr))) (im_insert IMEmpty (forged_key k) (list (Pair k v))))
(fn forged_st ((k Int)) St
  (St 0 0 k (Memo (forged_one (id_true) (false_type)) (forged_one (id_true) (false_type)) IMEmpty IMEmpty IMEmpty IMEmpty IMEmpty)))
(fn infers_false ((st St)) Bool
  (match (infer (ctx_new (e_nat) Nil (Some Nil) Safe False 1000000) st 1000 (id_true) False)
    ((KOk _ t) (expr_eq t (false_type)))
    (_ False)))
(fn boom_memo () Declaration (ThmDecl (cv (n1 (quote boom)) Nil (false_type)) (id_true) (list (n1 (quote boom)))))
;; 15. a wrong universe arity on a constant
(fn c_arity () Declaration (DefnDecl (cv (n1 (quote ar)) Nil (mk_sort (LSucc LZero))) (mk_const (nm_nat) (list LZero)) (HRegular 1) Safe (list (n1 (quote ar)))))
(fn cases () (List Case)
  (list
    (Case "the base environment is sound to start from" (accepted (check (e_nat) (st0) (eq_decl))))
    (Case "1 universe collapse: def bad : Prop := Nat" (refused (check (e_nat) (st0) (c_collapse)) (quote conversion)))
    (Case "2 loose bound variable" (refused (check (e_nat) (st0) (c_loose)) (quote loose_bvar)))
    (Case "2b free variable in a type" (refused (check (e_nat) (st0) (c_fvar)) (quote fvar_in_type)))
    (Case "3 constructor returning the wrong type" (refused (check (e_nat) (st0) (c_forged)) (quote invalid_ctor_result)))
    (Case "4 non-positive occurrence" (refused (check (e_nat) (st0) (c_nonpos)) (quote non_positive_occurrence)))
    (Case "5 Or2 admitted" (accepted (check (e_nat) (st0) (or_decl))))
    (Case "5 large elimination from a two-constructor predicate refused" (refused (check (e_or) (st0) (c_large_elim)) (quote universe_arity)))
    (Case "5b data projected out of a proof refused" (refused (check (e_ex) (st0) (c_proj_prop)) (quote invalid_projection)))
    (Case "6 self-reference" (refused (check (e_nat) (st0) (c_cyclic)) (quote unknown_constant)))
    (Case "7 user Nat.add admitted" (accepted (check (e_eq) (st0) (user_add))))
    (Case "7 accelerator OFF: Nat.add 2 3 = 2 holds by the user's definition" (accepted (check (e_user_add) (st0) (t_add_true))))
    (Case "7 accelerator OFF: Nat.add 2 3 = 5 refused" (refused (check (e_user_add) (st0) (t_add_false)) (quote conversion)))
    (Case "7 the user's Nat.add is not pinned" (bool_not (env_pinned (e_user_add) (n2 (quote Nat) (quote add)))))
    (Case "7b R42: the Nat.add whose hash equalled the old pin is admitted" (accepted (check (e_eq) (st0) (collide_add))))
    (Case "7b R42: not pinned — the reference closure refuses it" (bool_not (env_pinned (e_collide) (nm_add))))
    (Case "7b R42: accelerator OFF: Nat.add 2 3 = 5 refused" (refused (check (e_collide) (st0) (t_add_five)) (quote conversion)))
    (Case "7b R42: Nat.add 2 3 = 1781693077243641776 holds by the definition" (accepted (check (e_collide) (st0) (t_add_big))))
    (Case "7e R49: a THEOREM named Nat.add (Nat.zero = Nat.zero) is admitted" (accepted (o_thm_add)))
    (Case "7e R49: not pinned — the row holds a definition, the entry is a theorem" (bool_not (env_pinned (e_thm_add) (nm_add))))
    (Case "7e R49: a theorem head is never applicable — Nat.add 2 3 = 5 refused function_expected" (refused (check (e_thm_add) (st0) (t_add_five)) (quote function_expected)))
    (Case "8 a Nat literal under a non-pinned Nat is Unsupported" (refused (check (e_odd) (st0) (c_lit_unpinned)) (quote nat_literal_unpinned_Nat)))
    (Case "8 the pinned Nat is pinned" (env_pinned (e_nat) (nm_nat)))
    (Case "8b a string literal under a non-pinned String is Unsupported" (refused (check (e_odd_string) (st0) (c_str_unpinned)) (quote string_literal_unpinned_String)))
    (Case "9 duplicate constructor" (refused (check (e_nat) (st0) (c_dup_ctor)) (quote duplicate_constructor)))
    (Case "9 duplicate universe parameter" (refused (check (e_nat) (st0) (c_dup_univ)) (quote duplicate_univ_param)))
    (Case "10 theorem with a data type" (refused (check (e_nat) (st0) (c_thm_data)) (quote theorem_type_not_prop)))
    (Case "11 Quot under a wrong Eq" (refused (check (e_bad_eq) (st0) QuotDecl) (quote quot_eq_shape)))
    (Case "12 exhaustion is not a verdict" (refused (check_with (e_nat) (st0) (limits 2 1000000) (c_deep)) (quote exhausted)))
    (Case "12 the same declaration under the default limits is fine" (accepted (check (e_nat) (st0) (c_deep))))
    (Case "12b fuel monotonicity, depth: exhausted at 2; at 64 and at the default the same admitted identity"
      (bool_and (refused (check_with (e_nat) (st0) (limits 2 1000000) (c_deep)) (quote exhausted))
                (same_identity (check_with (e_nat) (st0) (limits 64 1000000) (c_deep)) (check (e_nat) (st0) (c_deep)) (n1 (quote deep)))))
    (Case "12c fuel monotonicity, steps: exhausted at 1; at 1000 and at the default the same admitted identity"
      (bool_and (refused (check_with (e_nat) (st0) (limits 8192 1) (c_deep)) (quote exhausted))
                (same_identity (check_with (e_nat) (st0) (limits 8192 1000) (c_deep)) (check (e_nat) (st0) (c_deep)) (n1 (quote deep)))))
    (Case "13 unsafe out of the profile" (refused (check (e_nat) (st0) (c_unsafe)) (quote unsafe_declaration)))
    (Case "13 partial out of the profile" (refused (check (e_nat) (st0) (c_partial)) (quote unsafe_declaration)))
    (Case "13 mutual block out of the profile" (refused (check (e_nat) (st0) (MutualDefnDecl Nil)) (quote mutual_unsafe_block)))
    (Case "14 reserved auxiliary prefix" (refused (check (e_nat) (st0) (c_reserved)) (quote reserved_nested_prefix)))
    (Case "15 wrong universe arity" (refused (check (e_nat) (st0) (c_arity)) (quote universe_arity)))
    (Case "16 R43: two literals wearing one positive id — 0 = 1 refused" (refused (check (e_eq) (st0) (c_forged_ids)) (quote conversion)))
    (Case "16b R43: a loose BVar claiming a closed range" (refused (check (e_nat) (st0) (c_forged_range)) (quote loose_bvar)))
    (Case "16c R43: an FVar claiming has_fvar = false" (refused (check (e_nat) (st0) (c_forged_fvar)) (quote fvar_in_type)))
    (Case "17a slice 3.15: a metavariable in a type is Malformed" (refused (check (e_nat) (st0) (c_mvar_type)) (quote mvar_in_type)))
    (Case "17b slice 3.15: a metavariable in a value is Malformed" (refused (check (e_nat) (st0) (c_mvar_value)) (quote mvar_in_value)))
    (Case "17c slice 3.15: an MVar claiming has_mvar = false" (refused (check (e_nat) (st0) (c_forged_mvar)) (quote mvar_in_type)))
    (Case "17d slice 3.15: a universe metavariable in a type is Malformed too" (refused (check (e_nat) (st0) (c_lmvar)) (quote mvar_in_type)))
    (Case "16d R43: a stale cached hash on a correct term is rebuilt, the theorem admitted" (accepted (check (e_eq) (st0) (c_stale_hash))))
    (Case "16e R43: snapshot forks mint the same ids for different nodes" (ids_collide))
    (Case "16e R43: a node from fork A against fork B's is not equated by id" (refused (check (e_fork_b) (st0) (c_fork_mix)) (quote conversion)))
    (Case "16f R43: independently built anonymous terms compare by structure" (built_twice))
    (Case "16g R43: a failed check leaves no trace for the next" (after_failure))
    (Case "18 each source alone admits its records" (bool_and (holds (env_of (ids_a)) (c1_)) (holds (env_of (ids_b)) (h_))))
    (Case "18 two runs from the empty run mint one id for different nodes" (= (type_id (env_of (ids_a)) (c1_)) (dom_id (env_of (ids_b)) (h_))))
    (Case "18 a second source's records on a fresh run over the first's environment are admitted" (bool_and (holds (env_onto (ids_a) (ids_b)) (c1_)) (holds (env_onto (ids_a) (ids_b)) (h_))))
    (Case "18 and minted above it: the two nodes wear two ids" (< (type_id (env_onto (ids_a) (ids_b)) (c1_)) (dom_id (env_onto (ids_a) (ids_b)) (h_))))
    (Case "18 boom : (p : Prop) → p := h c1 is refused there" (refused (check (env_onto (ids_a) (ids_b)) (st0) (boom_ids)) (quote app_type_mismatch)))
    (Case "18b the citation route's source B' proves d : c → F where c is F" (holds (env_of (cite_b)) (d_)))
    (Case "18b over A', where c is true: B's cp and c are already declared and d is refused on its statement" (bool_and (holds (env_onto (cite_a) (cite_b)) (c_)) (bool_not (holds (env_onto (cite_a) (cite_b)) (d_)))))
    (Case "18b boom : (p : Prop) → p := d (fun p x => x) is refused there" (refused (check (env_onto (cite_a) (cite_b)) (st0) (boom_cite)) (quote unknown_constant)))
    (Case "19 a definition whose type holds `Nat → Nat` twice, built apart, is accepted" (accepted (check (e_nat) (st0) (d_twice (quote twice) (quote x) (quote x)))))
    (Case "19 the two are one node of the admitted type, minted by the check" (bool_and (above (e_twice (quote x) (quote x)) (dom1 (type_in (e_twice (quote x) (quote x))))) (= (expr_id (dom1 (type_in (e_twice (quote x) (quote x))))) (expr_id (dom2 (type_in (e_twice (quote x) (quote x))))))))
    (Case "19 and the value's is the type's: one table to a declaration" (= (expr_id (dom1 (value_in (e_twice (quote x) (quote x))))) (expr_id (dom1 (type_in (e_twice (quote x) (quote x)))))))
    (Case "19 two binders that differ in name stay two nodes" (bool_not (= (expr_id (dom1 (type_in (e_twice (quote x) (quote y))))) (expr_id (dom2 (type_in (e_twice (quote x) (quote y))))))))
    (Case "19 each with the name it was written with" (bool_and (binder_is (dom1 (type_in (e_twice (quote x) (quote y)))) (quote x)) (binder_is (dom2 (type_in (e_twice (quote x) (quote y)))) (quote y))))
    (Case "19 and are equal terms all the same" (expr_eq (dom1 (type_in (e_twice (quote x) (quote y)))) (dom2 (type_in (e_twice (quote x) (quote y))))))
    (Case "19b the rebuild under a minting state keeps both binders' names" (bool_and (name_eq (first_binder (rebuilt (st_init))) (n1 (quote x))) (name_eq (second_binder (rebuilt (st_init))) (n1 (quote y)))))
    (Case "19b and under a state that mints no id" (bool_and (name_eq (first_binder (rebuilt (st_anon))) (n1 (quote x))) (name_eq (second_binder (rebuilt (st_anon))) (n1 (quote y)))))
    (Case "19b where what it leaves is the submitted term" (expr_eq (rebuilt (st_anon)) (two_ks)))
    (Case "20 the control: an honest state does not type `fun p x => x` at (p : Prop) → p; a forged table makes the view's infer do so" (bool_and (bool_not (infers_false (st0))) (infers_false (forged_st 0))))
    (Case "20 check under the forged tables refuses boom : (p : Prop) → p := fun p x => x" (refused (check (e_nat) (forged_st 0) (boom_memo)) (quote conversion)))
    (Case "20 at a counter far above the watermark" (refused (check (e_nat) (forged_st 1000000) (boom_memo)) (quote conversion)))
    (Case "20 and at a counter that mints no id" (refused (check (e_nat) (forged_st (- 0 3)) (boom_memo)) (quote conversion)))))
(fn main ((w World)) World (run_cases "hostile_test" (cases) 0 w))
