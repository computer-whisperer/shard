;;; v3/kernel/test/hostile_test.shard — K's hostile battery:
;;; declarations that must be REFUSED, each for its declared
;;; reason, and the accelerator-identity cases that speak through the public
;;; entry. A CLIENT of K: it imports the view only (the forged-node
;;; fixtures exercise the public entry); the
;;; matcher's own cases (7c, 7d, the 7e rows) live inside the directory,
;;; k/test/accel_test.shard. Nothing here may be
;;; Accepted except where a case says so (the budget cases 12: exhaustion is
;;; not a verdict, and fuel monotonicity — a result reached under a
;;; budget is the same under any larger one, since exhaustion is never cached).
;;; K has no special rules, dispatch tables or text-derived gates; the
;;; holes such things open have their analogues in the pin gates and the
;;; raw-input checks below.

(import "../host.shard")
(import "../json.shard")
(import "../k")
(import "case_kit.shard")
(import "decls_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.json)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.QuotKind)
(use kernel.decl.ReducibilityHints)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.expr.BinderInfo)
(use kernel.expr.D)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.expr.Memo)
(use kernel.expr.St)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.verdict.KRes)
(use kernel.host.World)
(use kernel.json.JRes)
(use kernel.level.Level)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)
(fn e0 () CheckedEnv (env_empty))
(fn e_nat () CheckedEnv (env_after (check (e0) (st0) (nat_decl)) (e0)))
(fn e_eq () CheckedEnv (env_after (check (e_nat) (st0) (eq_decl)) (e0)))
;; fuel monotonicity: two acceptances admitted the same identity
(fn same_identity ((a (Outcome CheckedEnv)) (b (Outcome CheckedEnv)) (n Name)) Bool
  (match a
    ((Accepted ea)
     (match b
       ((Accepted eb)
        (match (identity_hash ea n)
          ((some x)
           (match (identity_hash eb n)
             ((some y) (= x y))
             (none false)))
          (none false)))
       (_ false)))
    (_ false)))
;; --- the cases ------------------------------------------------------------------

;; 1. universe collapse: def bad : Prop := Nat  (Nat : Type, never Prop)
(fn c_collapse () Declaration
  (DefnDecl (cv (n1 (sym "bad")) nil (mk_sort LZero)) (nat) (HRegular 1) Safe
    (list (n1 (sym "bad")))))
;; 2. scope capture: a loose bound variable in a value
(fn c_loose () Declaration
  (DefnDecl (cv (n1 (sym "loose")) nil (nat)) (mk_bvar 0) (HRegular 1) Safe
    (list (n1 (sym "loose")))))
;; 2b. a free variable smuggled into a type
(fn c_fvar () Declaration (AxiomDecl (cv (n1 (sym "smug")) nil (mk_fvar 7)) false))
;; 3. a forged recursor cannot be declared: Declaration has no recursor form; a
;;    constructor returning the wrong type is the closest raw forgery
(fn c_forged () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n1 (sym "F")) (type1) (list (Constructor (n2 (sym "F") (sym "mk")) (nat)))))
    false))
;; 4. non-positive occurrence
(fn c_nonpos () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n1 (sym "Bad")) (type1)
        (list
          (Constructor (n2 (sym "Bad") (sym "mk"))
            (arrow (arrow (mk_const (n1 (sym "Bad")) nil) (nat)) (mk_const (n1 (sym "Bad")) nil))))))
    false))
;; 5. illicit Prop elimination: Or-like predicate (two constructors) eliminates
;;    only into Prop, so its recursor has no universe parameter — Or2.rec.{1} is refused
(fn or_decl () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n1 (sym "Or2")) (mk_sort LZero)
        (list (Constructor (n2 (sym "Or2") (sym "l")) (mk_const (n1 (sym "Or2")) nil))
          (Constructor (n2 (sym "Or2") (sym "r")) (mk_const (n1 (sym "Or2")) nil)))))
    false))
(fn e_or () CheckedEnv (env_after (check (e_nat) (st0) (or_decl)) (e0)))
(fn c_large_elim () Declaration
  (DefnDecl (cv (n1 (sym "elim")) nil (arrow (mk_const (n1 (sym "Or2")) nil) (nat)))
    (mk_lam (n1 (sym "h")) BDefault (mk_const (n1 (sym "Or2")) nil)
      (mk_app
        (mk_app
          (mk_app
            (mk_app (mk_const (n2 (sym "Or2") (sym "rec")) (list (LSucc LZero)))
              (mk_lam (x_) BDefault (mk_const (n1 (sym "Or2")) nil) (nat)))
            (lit 0))
          (lit 1))
        (mk_bvar 0)))
    (HRegular 1)
    Safe
    (list (n1 (sym "elim")))))
;; 5b. data out of a proof: a Prop structure with a Nat field cannot be projected
(fn ex_decl () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n1 (sym "Ex")) (mk_sort LZero)
        (list (Constructor (n2 (sym "Ex") (sym "mk")) (arrow (nat) (mk_const (n1 (sym "Ex")) nil))))))
    false))
(fn e_ex () CheckedEnv (env_after (check (e_nat) (st0) (ex_decl)) (e0)))
(fn c_proj_prop () Declaration
  (DefnDecl (cv (n1 (sym "leak")) nil (arrow (mk_const (n1 (sym "Ex")) nil) (nat)))
    (mk_lam (n1 (sym "h")) BDefault (mk_const (n1 (sym "Ex")) nil)
      (mk_proj (n1 (sym "Ex")) 0 (mk_bvar 0)))
    (HRegular 1)
    Safe
    (list (n1 (sym "leak")))))
;; 6. cyclic / self-referential definition
(fn c_cyclic () Declaration
  (DefnDecl (cv (n1 (sym "cyc")) nil (nat)) (mk_const (n1 (sym "cyc")) nil) (HRegular 1) Safe
    (list (n1 (sym "cyc")))))
;; 7. the same-spelled non-core Nat.add: a user definition `Nat.add a b := a`
(fn user_add () Declaration
  (DefnDecl (cv (n2 (sym "Nat") (sym "add")) nil (arrow (nat) (arrow (nat) (nat))))
    (mk_lam (n1 (sym "a")) BDefault (nat) (mk_lam (n1 (sym "b")) BDefault (nat) (mk_bvar 1)))
    (HRegular 1)
    Safe
    (list (n2 (sym "Nat") (sym "add")))))
(fn e_user_add () CheckedEnv (env_after (check (e_eq) (st0) (user_add)) (e0)))
;; 7b. a shortcut is never authorised by a hash: a same-spelled Nat.add built to
;;     carry a chosen 61-bit identity hash — `Nat.add a b := 1781693077243641776`,
;;     the literal one subtraction from the target (the hash is affine in it).
;;     A pin that compared hashes would take it for the genuine one and accept
;;     `Nat.add 2 3 = 5` by the accelerator. It is admitted as an ordinary definition;
;;     the reference closure refuses it; `Nat.add 2 3 = 5` is not established and
;;     `Nat.add 2 3 = 1781693077243641776` holds by the definition.
(fn big () Int 1781693077243641776)
(fn collide_add () Declaration
  (DefnDecl (cv (nm_add) nil (arrow (nat) (arrow (nat) (nat))))
    (mk_lam (n1 (sym "a")) BDefault (nat) (mk_lam (n1 (sym "b")) BDefault (nat) (lit (big))))
    (HRegular 1)
    Safe
    (list (nm_add))))
(fn e_collide () CheckedEnv (env_after (check (e_eq) (st0) (collide_add)) (e0)))
(fn t_add_five () Declaration
  (ThmDecl (cv (n1 (sym "t5")) nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 5))) (refl_nat (lit 5))
    (list (n1 (sym "t5")))))
(fn t_add_big () Declaration
  (ThmDecl (cv (n1 (sym "tb")) nil (eq_nat (nat_add (lit 2) (lit 3)) (lit (big))))
    (refl_nat (lit (big)))
    (list (n1 (sym "tb")))))
;; 7e. a THEOREM named Nat.add in an environment without one — an exempt kind
;;     under a candidate's name. `ref_matches` consults the row for every kind: a
;;     theorem pinned under a rowed name would be an authorization hole (not a false
;;     theorem: K never applies it, a theorem's type is not a Pi — function_expected).
;;     It is admitted, not pinned; the
;;     matcher refuses every exempt kind under a rowed name and accepts them
;;     under a name the table holds no row for (a closure's own theorem).
(fn thm_add () Declaration
  (ThmDecl (cv (nm_add) nil (eq_nat (zero) (zero))) (refl_nat (zero)) (list (nm_add))))
(fn o_thm_add () (Outcome CheckedEnv) (check (e_eq) (st0) (thm_add)))
(fn e_thm_add () CheckedEnv (env_after (o_thm_add) (e0)))
(fn t_add_true () Declaration  ; Nat.add 2 3 = 2 holds for the USER's Nat.add
  (ThmDecl (cv (n1 (sym "t1")) nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 2))) (refl_nat (lit 2))
    (list (n1 (sym "t1")))))
(fn t_add_false () Declaration  ; Nat.add 2 3 = 5 does NOT — a name-keyed accelerator would accept it
  (ThmDecl (cv (n1 (sym "t2")) nil (eq_nat (nat_add (lit 2) (lit 3)) (lit 5))) (refl_nat (lit 5))
    (list (n1 (sym "t2")))))
;; 8. a Nat literal under an environment whose Nat is not the pinned one
(fn odd_nat_decl () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (nm_nat) (type1)
        (list (Constructor (nm_nat_zero) (nat)) (Constructor (nm_nat_succ) (arrow (nat) (nat)))
          (Constructor (n2 (sym "Nat") (sym "extra")) (nat)))))
    false))
(fn e_odd () CheckedEnv (env_after (check (e0) (st0) (odd_nat_decl)) (e0)))
(fn c_lit_unpinned () Declaration
  (DefnDecl (cv (n1 (sym "seven")) nil (nat)) (lit 7) (HRegular 1) Safe (list (n1 (sym "seven")))))
;; 8b. a string literal under an environment whose String is not the pinned one
(fn odd_string_decl () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (nm_string) (type1)
        (list (Constructor (n2 (sym "String") (sym "mk")) (mk_const (nm_string) nil)))))
    false))
(fn e_odd_string () CheckedEnv (env_after (check (e0) (st0) (odd_string_decl)) (e0)))
(fn c_str_unpinned () Declaration
  (DefnDecl (cv (n1 (sym "hello")) nil (mk_const (nm_string) nil)) (mk_lit (LitStr (utf8 "hi")))
    (HRegular 1)
    Safe
    (list (n1 (sym "hello")))))
;; 9. duplicates
(fn c_dup_ctor () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n1 (sym "D")) (type1)
        (list (Constructor (n2 (sym "D") (sym "a")) (mk_const (n1 (sym "D")) nil))
          (Constructor (n2 (sym "D") (sym "a")) (mk_const (n1 (sym "D")) nil)))))
    false))
(fn c_dup_univ () Declaration
  (AxiomDecl (cv (n1 (sym "du")) (list (n1 (sym "u")) (n1 (sym "u"))) (mk_sort (u))) false))
;; 10. a theorem whose type is not a proposition
(fn c_thm_data () Declaration
  (ThmDecl (cv (n1 (sym "td")) nil (nat)) (zero) (list (n1 (sym "td")))))
;; 11. Quot under a wrong Eq (an extra constructor)
(fn bad_eq_decl () Declaration
  (InductDecl (list (n1 (sym "u"))) 2
    (list
      (InductiveType (nm_eq)
        (mk_pi (n1 (sym "a")) BImplicit (mk_sort (u))
          (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
            (mk_pi (n1 (sym "b")) BDefault (mk_bvar 1) (mk_sort LZero))))
        (list
          (Constructor (nm_eq_refl)
            (mk_pi (n1 (sym "a")) BImplicit (mk_sort (u))
              (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
                (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (u))) (mk_bvar 1)) (mk_bvar 0))
                  (mk_bvar 0)))))
          (Constructor (n2 (sym "Eq") (sym "bogus"))
            (mk_pi (n1 (sym "a")) BImplicit (mk_sort (u))
              (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
                (mk_pi (n1 (sym "b")) BDefault (mk_bvar 1)
                  (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (u))) (mk_bvar 2)) (mk_bvar 1))
                    (mk_bvar 0)))))))))
    false))
(fn e_bad_eq () CheckedEnv (env_after (check (e_nat) (st0) (bad_eq_decl)) (e0)))
;; 12. exhaustion is never a verdict: a definition under a tiny budget
(fn c_deep () Declaration
  (DefnDecl (cv (n1 (sym "deep")) nil (nat))
    (mk_app
      (mk_lam (x_) BDefault (nat) (mk_app (mk_lam (x_) BDefault (nat) (mk_bvar 0)) (mk_bvar 0)))
      (zero))
    (HRegular 1)
    Safe
    (list (n1 (sym "deep")))))
;; 13. unsafe / partial / mutual are out of the profile
(fn c_unsafe () Declaration
  (DefnDecl (cv (n1 (sym "un")) nil (nat)) (zero) (HRegular 1) Unsafe (list (n1 (sym "un")))))
(fn c_partial () Declaration
  (DefnDecl (cv (n1 (sym "pa")) nil (nat)) (zero) (HRegular 1) Partial (list (n1 (sym "pa")))))
;; 14. an auxiliary-nested name reserved
(fn c_reserved () Declaration
  (InductDecl nil 0
    (list
      (InductiveType (n2 (sym "_nested") (sym "X")) (type1)
        (list
          (Constructor (n2 (sym "_nested") (sym "mk")) (mk_const (n2 (sym "_nested") (sym "X")) nil)))))
    false))
;; 16. node data on a raw term is a claim. Read as given, two different literals
;;     wearing one positive id make `0 = 1` a theorem (quick_is_def_eq's expr_eq
;;     shortcut), and a BVar claiming a closed range or an FVar claiming no fvar
;;     slips its check.
;;     `check` rebuilds every node from its structure (expr.shard ingest_expr) —
;;     each distinct structure once, the nodes minted by the check (case 19).
(fn forged_lit ((k Int)) Expr (Lit (D 5 12345 0 false false false) (LitNat k)))
(fn c_forged_ids () Declaration
  (ThmDecl (cv (n1 (sym "zero_eq_one")) nil (eq_nat (forged_lit 0) (forged_lit 1)))
    (refl_nat (forged_lit 0))
    (list (n1 (sym "zero_eq_one")))))
;; a loose BVar 0 whose node data claims a closed term
(fn c_forged_range () Declaration
  (DefnDecl (cv (n1 (sym "closed")) nil (nat)) (BVar (D 0 (mix 29 0) 0 false false false) 0)
    (HRegular 1)
    Safe
    (list (n1 (sym "closed")))))
;; an FVar whose node data claims has_fvar = false
(fn c_forged_fvar () Declaration
  (AxiomDecl (cv (n1 (sym "nofv")) nil (FVar (D 0 (mix 31 7) 0 false false false) 7)) false))
;; a metavariable is the elaborator's; K refuses it in a type, in a value, and
;; when its node data claims has_mvar = false (ingestion rebuilds the claim; infer refuses the node)
(fn c_mvar_type () Declaration (AxiomDecl (cv (n1 (sym "nomv")) nil (mk_mvar 3)) false))
(fn c_mvar_value () Declaration
  (DefnDecl (cv (n1 (sym "nomvv")) nil (nat)) (mk_mvar 4) (HRegular 1) Safe
    (list (n1 (sym "nomvv")))))
(fn c_forged_mvar () Declaration
  (AxiomDecl (cv (n1 (sym "nomvf")) nil (MVar (D 0 (mix 73 5) 0 false false false) 5)) false))
(fn c_lmvar () Declaration (AxiomDecl (cv (n1 (sym "nolmv")) nil (mk_sort (LMVar 2))) false))
;; a stale cached hash on a correct term: two = two by rfl, the right-hand `two` mis-hashed
(fn two_lit () Expr
  (mk_app (mk_const (nm_nat_succ) nil)
    (mk_app (mk_const (nm_nat_succ) nil) (mk_const (nm_nat_zero) nil))))
(fn stale_two () Expr
  (match (two_lit)
    ((App _ f a) (App (D 0 999 0 false false false) f a))
    (e e)))
(fn c_stale_hash () Declaration
  (ThmDecl (cv (n1 (sym "two_two")) nil (eq_nat (two_lit) (stale_two))) (refl_nat (two_lit))
    (list (n1 (sym "two_two")))))
;; snapshot forks: from one env, two checks mint the same ids for different
;; nodes; a node taken from one fork, submitted into the other, must not be
;; equated by its id — `a`'s value (fun x => x) from fork A against `b`'s
;; (fun x => Nat.zero) from fork B
(fn nat_fn () Expr (arrow (nat) (nat)))
(fn d_a () Declaration
  (DefnDecl (cv (n1 (sym "a")) nil (nat_fn)) (mk_lam (x_) BDefault (nat) (mk_bvar 0)) (HRegular 1)
    Safe
    (list (n1 (sym "a")))))
(fn d_b () Declaration
  (DefnDecl (cv (n1 (sym "b")) nil (nat_fn))
    (mk_lam (x_) BDefault (nat) (mk_const (nm_nat_zero) nil))
    (HRegular 1)
    Safe
    (list (n1 (sym "b")))))
(fn e_fork_a () CheckedEnv (env_after (check (e_eq) (st0) (d_a)) (e0)))
(fn e_fork_b () CheckedEnv (env_after (check (e_eq) (st0) (d_b)) (e0)))
(fn value_of ((env CheckedEnv) (n Name)) Expr
  (match (env_find env n)
    ((some (DefnInfo _ v _ _ _)) v)
    (_ (nat))))
(fn c_fork_mix () Declaration
  (ThmDecl
    (cv (n1 (sym "a_is_b")) nil
      (mk_app
        (mk_app (mk_app (mk_const (nm_eq) (list (LSucc LZero))) (nat_fn))
          (value_of (e_fork_a) (n1 (sym "a"))))
        (value_of (e_fork_b) (n1 (sym "b")))))
    (mk_app (mk_app (mk_const (nm_eq_refl) (list (LSucc LZero))) (nat_fn))
      (value_of (e_fork_a) (n1 (sym "a"))))
    (list (n1 (sym "a_is_b")))))
(fn ids_collide () Bool
  (= (expr_id (value_of (e_fork_a) (n1 (sym "a")))) (expr_id (value_of (e_fork_b) (n1 (sym "b"))))))
;; independently built anonymous terms compare by structure
(fn built_twice () Bool (expr_eq (two_lit) (two_lit)))
;; a failed check leaves the env it was given untouched: the next check sees no trace
(fn after_failure () Bool
  (bool_and (refused (check (e_eq) (st0) (c_forged_ids)) (sym "conversion"))
    (accepted (check (e_eq) (st0) (t_add_true_std)))))
(fn t_add_true_std () Declaration
  (ThmDecl (cv (n1 (sym "two_rfl")) nil (eq_nat (two_lit) (two_lit))) (refl_nat (two_lit))
    (list (n1 (sym "two_rfl")))))
;; 18. Two environments joined.
;;     A node's id is unique within the counter that minted it and expr_eq answers true on two
;;     equal positive ids. Were the view to take two environments, two record
;;     runs from the empty run — each minting id 1 for its first compound node — would meet in
;;     one, and `boom : (p : Prop) → p := h c1` be ACCEPTED with no axiom: `Prop → Prop`
;;     and `(p : Prop) → p` wear one id. A second route needs no id: a constant proven where a
;;     citation of its citation means one thing, transferred to where it means another. What the
;;     view spells: a second source's records on a fresh run over the first's environment.
(fn feed ((r Run) (lines (List (List Int)))) Run
  (measure (struct lines))
  (match lines
    (nil r)
    ((cons l rest)
     (match (json_parse l)
       ((JRes j _)
        (match (process_record r j)
          ((Prod.mk r1 _) (feed r1 rest))))
       (JErr r)))))
(fn c1_ () Name (n1 (sym "c1")))
(fn h_ () Name (n1 (sym "h")))
(fn c_ () Name (n1 (sym "c")))
(fn d_ () Name (n1 (sym "d")))
;; source A: c1 : Prop → Prop := fun p => p
(fn ids_a () (List (List Int))
  (utf8_all
    (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"c1\"}}" "{\"ie\":1,\"sort\":0}"
      "{\"ie\":2,\"forallE\":{\"binderInfo\":\"default\",\"body\":1,\"name\":0,\"type\":1}}"
      "{\"ie\":3,\"bvar\":0}"
      "{\"ie\":4,\"lam\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":1}}"
      "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":2,\"value\":4}}")))
;; source B: h : F → F := fun x => x, F = (p : Prop) → p
(fn ids_b () (List (List Int))
  (utf8_all
    (list "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"h\"}}" "{\"ie\":11,\"sort\":0}"
      "{\"ie\":12,\"bvar\":0}"
      "{\"ie\":13,\"forallE\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":11}}"
      "{\"ie\":14,\"forallE\":{\"binderInfo\":\"default\",\"body\":13,\"name\":0,\"type\":13}}"
      "{\"ie\":15,\"lam\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":13}}"
      "{\"def\":{\"all\":[2],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":14,\"value\":15}}")))
;; source A': cp : Prop := (p : Prop) → p → p (true); c : Prop := cp
(fn cite_a () (List (List Int))
  (utf8_all
    (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"cp\"}}"
      "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"c\"}}"
      "{\"ie\":1,\"sort\":0}"
      "{\"ie\":2,\"bvar\":0}"
      "{\"ie\":3,\"bvar\":1}"
      "{\"ie\":4,\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":2}}"
      "{\"ie\":5,\"forallE\":{\"binderInfo\":\"default\",\"body\":4,\"name\":0,\"type\":1}}"
      "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":1,\"value\":5}}"
      "{\"ie\":6,\"const\":{\"name\":1,\"us\":[]}}"
      "{\"def\":{\"all\":[2],\"hints\":{\"regular\":2},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":1,\"value\":6}}")))
;; source B': cp : Prop := (p : Prop) → p (false); c : Prop := cp; d : c → F := fun x => x
(fn cite_b () (List (List Int))
  (utf8_all
    (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"cp\"}}"
      "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"c\"}}"
      "{\"in\":3,\"str\":{\"pre\":0,\"str\":\"d\"}}"
      "{\"ie\":1,\"sort\":0}"
      "{\"ie\":2,\"bvar\":0}"
      "{\"ie\":3,\"forallE\":{\"binderInfo\":\"default\",\"body\":2,\"name\":0,\"type\":1}}"
      "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":1,\"value\":3}}"
      "{\"ie\":4,\"const\":{\"name\":1,\"us\":[]}}"
      "{\"def\":{\"all\":[2],\"hints\":{\"regular\":2},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":1,\"value\":4}}"
      "{\"ie\":5,\"const\":{\"name\":2,\"us\":[]}}"
      "{\"ie\":6,\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":5}}"
      "{\"ie\":7,\"lam\":{\"binderInfo\":\"default\",\"body\":2,\"name\":0,\"type\":5}}"
      "{\"def\":{\"all\":[3],\"hints\":{\"regular\":3},\"levelParams\":[],\"name\":3,\"safety\":\"safe\",\"type\":6,\"value\":7}}")))
(fn env_of ((lines (List (List Int)))) CheckedEnv (run_env (feed (empty_run false) lines)))
;; B's records on a fresh run over A's environment
(fn env_onto ((a (List (List Int))) (b (List (List Int)))) CheckedEnv
  (run_env (feed (run_on (env_of a)) b)))
(fn holds ((e CheckedEnv) (n Name)) Bool
  (match (env_find e n)
    ((some _) true)
    (none false)))
(fn type_id ((e CheckedEnv) (n Name)) Int
  (match (env_find e n)
    ((some i) (expr_id (ci_type i)))
    (none -1)))
(fn dom_id ((e CheckedEnv) (n Name)) Int
  (match (env_find e n)
    ((some i)
     (match (ci_type i)
       ((Pi _ _ _ dm _) (expr_id dm))
       (_ -2)))
    (none -1)))
;; F = (p : Prop) → p, raw; boom : F by a function applied to an argument
(fn false_type () Expr (mk_pi (n1 (sym "p")) BDefault (mk_sort LZero) (mk_bvar 0)))
(fn boom_by ((f Name) (arg Expr)) Declaration
  (ThmDecl (cv (n1 (sym "boom")) nil (false_type)) (mk_app (mk_const f nil) arg)
    (list (n1 (sym "boom")))))
;; (fun (p : Prop) (x : p) => x) : (p : Prop) → p → p
(fn id_true () Expr
  (mk_lam (n1 (sym "p")) BDefault (mk_sort LZero) (mk_lam (x_) BDefault (mk_bvar 0) (mk_bvar 0))))
(fn boom_ids () Declaration (boom_by (h_) (mk_const (c1_) nil)))
(fn boom_cite () Declaration (boom_by (d_) (id_true)))
;; 19. The raw entry builds each structure once: what a caller
;;     builds twice is one node of what is admitted — whatever ids it wore, and none read —,
;;     minted by the check above the environment's watermark; a binder's name is display data
;;     and is kept: two binders that differ in it stay two nodes.
(fn arrow_as ((n Symbol)) Expr (mk_pi (n1 n) BDefault (nat) (nat)))
;; twice : A → B → Nat := fun f g => Nat.zero, A and B each a `Nat → Nat` built on its own
(fn d_twice ((nm Symbol) (a Symbol) (b Symbol)) Declaration
  (DefnDecl
    (cv (n1 nm) nil
      (mk_pi (n1 (sym "f")) BDefault (arrow_as a) (mk_pi (n1 (sym "g")) BDefault (arrow_as b) (nat))))
    (mk_lam (n1 (sym "f")) BDefault (arrow_as a)
      (mk_lam (n1 (sym "g")) BDefault (arrow_as b) (zero)))
    (HRegular 1)
    Safe
    (list (n1 nm))))
(fn e_twice ((a Symbol) (b Symbol)) CheckedEnv
  (env_after (check (e_nat) (st0) (d_twice (sym "twice") a b)) (e0)))
;; the first and the second domain of a constant's type; the first domain of its value
(fn dom1 ((x Expr)) Expr
  (match x
    ((Pi _ _ _ dm _) dm)
    ((Lam _ _ _ dm _) dm)
    (_ x)))
(fn dom2 ((x Expr)) Expr
  (match x
    ((Pi _ _ _ _ (Pi _ _ _ dm _)) dm)
    (_ x)))
(fn type_in ((e CheckedEnv)) Expr
  (match (env_find e (n1 (sym "twice")))
    ((some i) (ci_type i))
    (none (nat))))
(fn value_in ((e CheckedEnv)) Expr (value_of e (n1 (sym "twice"))))
(fn binder_is ((x Expr) (n Symbol)) Bool
  (match x
    ((Pi _ m _ _ _) (name_eq m (n1 n)))
    (_ false)))
(fn above ((e CheckedEnv) (x Expr)) Bool (< 0 (expr_id x)))
;; 19b. The rebuild itself (expr.shard ingest_expr, public) under a state that mints no id: two
;;      binders that differ in name under equal structure keep their names there too — two
;;      compound nodes without an id are never taken for one (expr_eq, which is blind to
;;      the name, would take them for one).
(fn k_of ((n Symbol)) Expr (mk_app (mk_const (n1 (sym "k")) nil) (arrow_as n)))
(fn two_ks () Expr
  (mk_app (mk_app (mk_const (n1 (sym "pair")) nil) (k_of (sym "x"))) (k_of (sym "y"))))
(fn rebuilt ((st St)) Expr
  (match (ingest_expr (ingest_new st) (two_ks))
    ((Prod.mk _ e) e)))
(fn first_binder ((e Expr)) Name
  (match e
    ((App _ (App _ _ (App _ _ (Pi _ n _ _ _))) _) n)
    (_ Anon)))
(fn second_binder ((e Expr)) Name
  (match e
    ((App _ _ (App _ _ (Pi _ n _ _ _))) n)
    (_ Anon)))
;; 20. A caller's state carries memo tables: St and Memo are
;;     public data, and the view's advisory `infer` answers from a table its caller wrote —
;;     here, that `fun (p : Prop) (x : p) => x` has the type `(p : Prop) → p`. `check` starts
;;     from its own tables whatever it is handed (st_seed), at any counter.
(fn forged_key ((e Expr)) Int (band (hash_expr e) 16777215))
(fn forged_one ((k Expr) (v Expr)) (IntMap (List (Prod Expr Expr)))
  (im_insert IMEmpty (forged_key k) (list (Prod.mk k v))))
(fn forged_st ((k Int)) St
  (St 0 0 k
    (Memo (forged_one (id_true) (false_type)) (forged_one (id_true) (false_type)) IMEmpty IMEmpty
      IMEmpty
      IMEmpty
      IMEmpty)))
(fn infers_false ((st St)) Bool
  (match (infer (ctx_new (e_nat) nil (some nil) Safe false 1000000) st 1000 (id_true) false)
    ((KOk _ t) (expr_eq t (false_type)))
    (_ false)))
(fn boom_memo () Declaration
  (ThmDecl (cv (n1 (sym "boom")) nil (false_type)) (id_true) (list (n1 (sym "boom")))))
;; 21. One id on two nodes. The
;;     layers above K reuse states, so a term of theirs can wear one positive id on two
;;     different nodes, each under its own honest hash — here two applications minted from one
;;     state. K's readers of an id read the hash with it: the two are not equal, not the same
;;     node, K's services do not take one for the other, and a walk that has seen one still
;;     reads the other (the loader collects a definition's constants so, for its height).
(fn on_seven ((n Symbol)) Expr
  (match (new_app (St 0 0 6 (memo_empty)) (mk_const (n1 (sym "f")) nil) (mk_const (n1 n) nil))
    ((Prod.mk _ x) x)))
(fn both_on_seven () Expr (mk_app (on_seven (sym "a")) (on_seven (sym "b"))))
(fn defeq_by_k ((x Expr) (y Expr)) Bool
  (match (is_def_eq (ctx_new (e_nat) nil (some nil) Safe false 1000000) (st0) 1000 x y)
    ((KOk _ b) b)
    (_ false)))
;; 15. a wrong universe arity on a constant
(fn c_arity () Declaration
  (DefnDecl (cv (n1 (sym "ar")) nil (mk_sort (LSucc LZero))) (mk_const (nm_nat) (list LZero))
    (HRegular 1)
    Safe
    (list (n1 (sym "ar")))))
(fn cases () (List Case)
  (list
    (Case (utf8 "the base environment is sound to start from")
      (accepted (check (e_nat) (st0) (eq_decl))))
    (Case (utf8 "1 universe collapse: def bad : Prop := Nat")
      (refused (check (e_nat) (st0) (c_collapse)) (sym "conversion")))
    (Case (utf8 "2 loose bound variable")
      (refused (check (e_nat) (st0) (c_loose)) (sym "loose_bvar")))
    (Case (utf8 "2b free variable in a type")
      (refused (check (e_nat) (st0) (c_fvar)) (sym "fvar_in_type")))
    (Case (utf8 "3 constructor returning the wrong type")
      (refused (check (e_nat) (st0) (c_forged)) (sym "invalid_ctor_result")))
    (Case (utf8 "4 non-positive occurrence")
      (refused (check (e_nat) (st0) (c_nonpos)) (sym "non_positive_occurrence")))
    (Case (utf8 "5 Or2 admitted") (accepted (check (e_nat) (st0) (or_decl))))
    (Case (utf8 "5 large elimination from a two-constructor predicate refused")
      (refused (check (e_or) (st0) (c_large_elim)) (sym "universe_arity")))
    (Case (utf8 "5b data projected out of a proof refused")
      (refused (check (e_ex) (st0) (c_proj_prop)) (sym "invalid_projection")))
    (Case (utf8 "6 self-reference")
      (refused (check (e_nat) (st0) (c_cyclic)) (sym "unknown_constant")))
    (Case (utf8 "7 user Nat.add admitted") (accepted (check (e_eq) (st0) (user_add))))
    (Case (utf8 "7 accelerator OFF: Nat.add 2 3 = 2 holds by the user's definition")
      (accepted (check (e_user_add) (st0) (t_add_true))))
    (Case (utf8 "7 accelerator OFF: Nat.add 2 3 = 5 refused")
      (refused (check (e_user_add) (st0) (t_add_false)) (sym "conversion")))
    (Case (utf8 "7 the user's Nat.add is not pinned")
      (bool_not (env_pinned (e_user_add) (n2 (sym "Nat") (sym "add")))))
    (Case (utf8 "7b the Nat.add built to carry a chosen identity hash is admitted")
      (accepted (check (e_eq) (st0) (collide_add))))
    (Case (utf8 "7b not pinned — the reference closure refuses it")
      (bool_not (env_pinned (e_collide) (nm_add))))
    (Case (utf8 "7b accelerator OFF: Nat.add 2 3 = 5 refused")
      (refused (check (e_collide) (st0) (t_add_five)) (sym "conversion")))
    (Case (utf8 "7b Nat.add 2 3 = 1781693077243641776 holds by the definition")
      (accepted (check (e_collide) (st0) (t_add_big))))
    (Case (utf8 "7e a THEOREM named Nat.add (Nat.zero = Nat.zero) is admitted")
      (accepted (o_thm_add)))
    (Case (utf8 "7e not pinned — the row holds a definition, the entry is a theorem")
      (bool_not (env_pinned (e_thm_add) (nm_add))))
    (Case
      (utf8 "7e a theorem head is never applicable — Nat.add 2 3 = 5 refused function_expected")
      (refused (check (e_thm_add) (st0) (t_add_five)) (sym "function_expected")))
    (Case (utf8 "8 a Nat literal under a non-pinned Nat is Unsupported")
      (refused (check (e_odd) (st0) (c_lit_unpinned)) (sym "nat_literal_unpinned_Nat")))
    (Case (utf8 "8 the pinned Nat is pinned") (env_pinned (e_nat) (nm_nat)))
    (Case (utf8 "8b a string literal under a non-pinned String is Unsupported")
      (refused (check (e_odd_string) (st0) (c_str_unpinned)) (sym "string_literal_unpinned_String")))
    (Case (utf8 "9 duplicate constructor")
      (refused (check (e_nat) (st0) (c_dup_ctor)) (sym "duplicate_constructor")))
    (Case (utf8 "9 duplicate universe parameter")
      (refused (check (e_nat) (st0) (c_dup_univ)) (sym "duplicate_univ_param")))
    (Case (utf8 "10 theorem with a data type")
      (refused (check (e_nat) (st0) (c_thm_data)) (sym "theorem_type_not_prop")))
    (Case (utf8 "11 Quot under a wrong Eq")
      (refused (check (e_bad_eq) (st0) QuotDecl) (sym "quot_eq_shape")))
    (Case (utf8 "12 exhaustion is not a verdict")
      (refused (check_with (e_nat) (st0) (limits 2 1000000) (c_deep)) (sym "exhausted")))
    (Case (utf8 "12 the same declaration under the default limits is fine")
      (accepted (check (e_nat) (st0) (c_deep))))
    (Case
      (utf8
        "12b fuel monotonicity, depth: exhausted at 2; at 64 and at the default the same admitted identity")
      (bool_and (refused (check_with (e_nat) (st0) (limits 2 1000000) (c_deep)) (sym "exhausted"))
        (same_identity (check_with (e_nat) (st0) (limits 64 1000000) (c_deep))
          (check (e_nat) (st0) (c_deep))
          (n1 (sym "deep")))))
    (Case
      (utf8
        "12c fuel monotonicity, steps: exhausted at 1; at 1000 and at the default the same admitted identity")
      (bool_and (refused (check_with (e_nat) (st0) (limits 8192 1) (c_deep)) (sym "exhausted"))
        (same_identity (check_with (e_nat) (st0) (limits 8192 1000) (c_deep))
          (check (e_nat) (st0) (c_deep))
          (n1 (sym "deep")))))
    (Case (utf8 "13 unsafe out of the profile")
      (refused (check (e_nat) (st0) (c_unsafe)) (sym "unsafe_declaration")))
    (Case (utf8 "13 partial out of the profile")
      (refused (check (e_nat) (st0) (c_partial)) (sym "unsafe_declaration")))
    (Case (utf8 "13 mutual block out of the profile")
      (refused (check (e_nat) (st0) (MutualDefnDecl nil)) (sym "mutual_unsafe_block")))
    (Case (utf8 "14 reserved auxiliary prefix")
      (refused (check (e_nat) (st0) (c_reserved)) (sym "reserved_nested_prefix")))
    (Case (utf8 "15 wrong universe arity")
      (refused (check (e_nat) (st0) (c_arity)) (sym "universe_arity")))
    (Case (utf8 "16 two literals wearing one positive id — 0 = 1 refused")
      (refused (check (e_eq) (st0) (c_forged_ids)) (sym "conversion")))
    (Case (utf8 "16b a loose BVar claiming a closed range")
      (refused (check (e_nat) (st0) (c_forged_range)) (sym "loose_bvar")))
    (Case (utf8 "16c an FVar claiming has_fvar = false")
      (refused (check (e_nat) (st0) (c_forged_fvar)) (sym "fvar_in_type")))
    (Case (utf8 "17a a metavariable in a type is Malformed")
      (refused (check (e_nat) (st0) (c_mvar_type)) (sym "mvar_in_type")))
    (Case (utf8 "17b a metavariable in a value is Malformed")
      (refused (check (e_nat) (st0) (c_mvar_value)) (sym "mvar_in_value")))
    (Case (utf8 "17c an MVar claiming has_mvar = false")
      (refused (check (e_nat) (st0) (c_forged_mvar)) (sym "mvar_in_type")))
    (Case (utf8 "17d a universe metavariable in a type is Malformed too")
      (refused (check (e_nat) (st0) (c_lmvar)) (sym "mvar_in_type")))
    (Case (utf8 "16d a stale cached hash on a correct term is rebuilt, the theorem admitted")
      (accepted (check (e_eq) (st0) (c_stale_hash))))
    (Case (utf8 "16e snapshot forks mint the same ids for different nodes") (ids_collide))
    (Case (utf8 "16e a node from fork A against fork B's is not equated by id")
      (refused (check (e_fork_b) (st0) (c_fork_mix)) (sym "conversion")))
    (Case (utf8 "16f independently built anonymous terms compare by structure") (built_twice))
    (Case (utf8 "16g a failed check leaves no trace for the next") (after_failure))
    (Case (utf8 "18 each source alone admits its records")
      (bool_and (holds (env_of (ids_a)) (c1_)) (holds (env_of (ids_b)) (h_))))
    (Case (utf8 "18 two runs from the empty run mint one id for different nodes")
      (= (type_id (env_of (ids_a)) (c1_)) (dom_id (env_of (ids_b)) (h_))))
    (Case
      (utf8 "18 a second source's records on a fresh run over the first's environment are admitted")
      (bool_and (holds (env_onto (ids_a) (ids_b)) (c1_)) (holds (env_onto (ids_a) (ids_b)) (h_))))
    (Case (utf8 "18 and minted above it: the two nodes wear two ids")
      (< (type_id (env_onto (ids_a) (ids_b)) (c1_)) (dom_id (env_onto (ids_a) (ids_b)) (h_))))
    (Case (utf8 "18 boom : (p : Prop) → p := h c1 is refused there")
      (refused (check (env_onto (ids_a) (ids_b)) (st0) (boom_ids)) (sym "app_type_mismatch")))
    (Case (utf8 "18b the citation route's source B' proves d : c → F where c is F")
      (holds (env_of (cite_b)) (d_)))
    (Case
      (utf8
        "18b over A', where c is true: B's cp and c are already declared and d is refused on its statement")
      (bool_and (holds (env_onto (cite_a) (cite_b)) (c_))
        (bool_not (holds (env_onto (cite_a) (cite_b)) (d_)))))
    (Case (utf8 "18b boom : (p : Prop) → p := d (fun p x => x) is refused there")
      (refused (check (env_onto (cite_a) (cite_b)) (st0) (boom_cite)) (sym "unknown_constant")))
    (Case (utf8 "19 a definition whose type holds `Nat → Nat` twice, built apart, is accepted")
      (accepted (check (e_nat) (st0) (d_twice (sym "twice") (sym "x") (sym "x")))))
    (Case (utf8 "19 the two are one node of the admitted type, minted by the check")
      (bool_and (above (e_twice (sym "x") (sym "x")) (dom1 (type_in (e_twice (sym "x") (sym "x")))))
        (= (expr_id (dom1 (type_in (e_twice (sym "x") (sym "x")))))
          (expr_id (dom2 (type_in (e_twice (sym "x") (sym "x"))))))))
    (Case (utf8 "19 and the value's is the type's: one table to a declaration")
      (= (expr_id (dom1 (value_in (e_twice (sym "x") (sym "x")))))
        (expr_id (dom1 (type_in (e_twice (sym "x") (sym "x")))))))
    (Case (utf8 "19 two binders that differ in name stay two nodes")
      (bool_not
        (= (expr_id (dom1 (type_in (e_twice (sym "x") (sym "y")))))
          (expr_id (dom2 (type_in (e_twice (sym "x") (sym "y"))))))))
    (Case (utf8 "19 each with the name it was written with")
      (bool_and (binder_is (dom1 (type_in (e_twice (sym "x") (sym "y")))) (sym "x"))
        (binder_is (dom2 (type_in (e_twice (sym "x") (sym "y")))) (sym "y"))))
    (Case (utf8 "19 and are equal terms all the same")
      (expr_eq (dom1 (type_in (e_twice (sym "x") (sym "y"))))
        (dom2 (type_in (e_twice (sym "x") (sym "y"))))))
    (Case (utf8 "19b the rebuild under a minting state keeps both binders' names")
      (bool_and (name_eq (first_binder (rebuilt (st_init))) (n1 (sym "x")))
        (name_eq (second_binder (rebuilt (st_init))) (n1 (sym "y")))))
    (Case (utf8 "19b and under a state that mints no id")
      (bool_and (name_eq (first_binder (rebuilt (st_anon))) (n1 (sym "x")))
        (name_eq (second_binder (rebuilt (st_anon))) (n1 (sym "y")))))
    (Case (utf8 "19b where what it leaves is the submitted term")
      (expr_eq (rebuilt (st_anon)) (two_ks)))
    (Case
      (utf8
        "20 the control: an honest state does not type `fun p x => x` at (p : Prop) → p; a forged table makes the view's infer do so")
      (bool_and (bool_not (infers_false (st0))) (infers_false (forged_st 0))))
    (Case (utf8 "20 check under the forged tables refuses boom : (p : Prop) → p := fun p x => x")
      (refused (check (e_nat) (forged_st 0) (boom_memo)) (sym "conversion")))
    (Case (utf8 "20 at a counter far above the watermark")
      (refused (check (e_nat) (forged_st 1000000) (boom_memo)) (sym "conversion")))
    (Case (utf8 "20 and at a counter that mints no id")
      (refused (check (e_nat) (forged_st -3) (boom_memo)) (sym "conversion")))
    (Case (utf8 "21 the control: two different nodes, both wearing id 7")
      (bool_and (= (expr_id (on_seven (sym "a"))) 7)
        (bool_and (= (expr_id (on_seven (sym "b"))) 7)
          (bool_not (= (hash_expr (on_seven (sym "a"))) (hash_expr (on_seven (sym "b"))))))))
    (Case (utf8 "21 expr_eq does not take one for the other")
      (bool_not (expr_eq (on_seven (sym "a")) (on_seven (sym "b")))))
    (Case (utf8 "21 and a node is still itself by its id")
      (expr_eq (on_seven (sym "a")) (on_seven (sym "a"))))
    (Case (utf8 "21 same_node does not")
      (bool_not (same_node (on_seven (sym "a")) (on_seven (sym "b")))))
    (Case (utf8 "21 K's is_def_eq does not")
      (bool_not (defeq_by_k (on_seven (sym "a")) (on_seven (sym "b")))))
    (Case (utf8 "21 the constants of a term holding both are both collected")
      (bool_and (mem_name (n1 (sym "a")) (expr_consts (both_on_seven)))
        (mem_name (n1 (sym "b")) (expr_consts (both_on_seven)))))))
(fn main ((w World)) World (run_cases (utf8 "hostile_test") (cases) 0 w))
