;;; v3/kernel/test/decls_kit.shard — raw declarations for K's tests, on both sides of the seal
;;; (phase 3, the second of the four follow-ups after the K seal). Public data only — Name,
;;; Level, Expr, Declaration, the verdict vocabulary — so a client of the view
;;; (hostile_test, k_client_test) and a test of the internals (k/test/) import the same
;;; file; nothing here names CheckedEnv, and the outcome helpers take the environment type
;;; as a parameter. The names are K's spellings under the kit's own constants (nat_n, …),
;;; since the view's nm_nat and tc's are two identities a test may not see both of.

(import "../decl.shard")
(import "../expr.shard")
(import "../level.shard")
(import "../name.shard")
(import "../util.shard")
(import "../verdict.shard")
(use kernel.decl)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.InductiveType)
(use kernel.expr)
(use kernel.expr.BinderInfo)
(use kernel.expr.Literal)
(use kernel.expr.St)
(use kernel.level)
(use kernel.level.Level)
(use kernel.name)
(use kernel.prelude)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Pair)
(use kernel.util)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)

;; the names, as K spells them
(fn nat_n () Name (n1 (quote Nat)))
(fn zero_n () Name (n2 (quote Nat) (quote zero)))
(fn succ_n () Name (n2 (quote Nat) (quote succ)))
(fn eq_n () Name (n1 (quote Eq)))
(fn eq_refl_n () Name (n2 (quote Eq) (quote refl)))
(fn nm_add () Name (n2 (quote Nat) (quote add)))

;; terms
(fn u () Level (LParam (n1 (quote u))))
(fn nat () Expr (mk_const (nat_n) Nil))
(fn zero () Expr (mk_const (zero_n) Nil))
(fn lit ((k Int)) Expr (mk_lit (LitNat k)))
(fn x_ () Name (n1 (quote x)))
(fn val ((p (Pair St Expr))) Expr (match p ((Pair _ e) e)))
(fn arrow ((a Expr) (b Expr)) Expr (mk_pi (x_) BDefault a (val (lift_loose_bvars (st_anon) b 0 1))))
(fn type1 () Expr (mk_sort (LSucc LZero)))
(fn st0 () St (st_init))
(fn cv ((n Name) (ps (List Name)) (t Expr)) ConstantVal (ConstantVal n ps t))
(fn eq_nat ((a Expr) (b Expr)) Expr (mk_app (mk_app (mk_app (mk_const (eq_n) (list (LSucc LZero))) (nat)) a) b))
(fn refl_nat ((a Expr)) Expr (mk_app (mk_app (mk_const (eq_refl_n) (list (LSucc LZero))) (nat)) a))
(fn nat_add ((a Expr) (b Expr)) Expr (mk_app (mk_app (mk_const (n2 (quote Nat) (quote add)) Nil) a) b))

;; declarations: Nat and Eq as the export declares them
(fn nat_decl () Declaration
  (InductDecl Nil 0
    (list (InductiveType (nat_n) (type1)
            (list (Constructor (zero_n) (nat)) (Constructor (succ_n) (mk_pi (n1 (quote n)) BDefault (nat) (nat))))))
    False))
(fn eq_decl () Declaration
  (InductDecl (list (n1 (quote u))) 2
    (list (InductiveType (eq_n)
            (mk_pi (n1 (quote a)) BImplicit (mk_sort (u)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0) (mk_pi (n1 (quote b)) BDefault (mk_bvar 1) (mk_sort LZero))))
            (list (Constructor (eq_refl_n)
                    (mk_pi (n1 (quote a)) BImplicit (mk_sort (u)) (mk_pi (n1 (quote a)) BDefault (mk_bvar 0)
                      (mk_app (mk_app (mk_app (mk_const (eq_n) (list (u))) (mk_bvar 1)) (mk_bvar 0)) (mk_bvar 0))))))))
    False))

;; outcomes, over any environment type
(fn env_after ((E Type) (o (Outcome E)) (dflt E)) E (match o ((Accepted e) e) (_ dflt)))
(fn accepted ((E Type) (o (Outcome E))) Bool (match o ((Accepted _) True) (_ False)))
(fn refused ((E Type) (o (Outcome E)) (s Symbol)) Bool
  (match o
    ((Rejected (RuleViolation t) _) (sym_eq s t)) ((Rejected (Malformed t) _) (sym_eq s t))
    ((Rejected (Unsupported t) _) (sym_eq s t)) ((Rejected (ConversionNotEstablished) _) (sym_eq s (quote conversion)))
    ((Exhausted _ _) (sym_eq s (quote exhausted)))
    (_ False)))
