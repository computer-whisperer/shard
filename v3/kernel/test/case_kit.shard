;;; v3/kernel/test/case_kit.shard — the case list and its report, shared by every test
;;; entrypoint. A test defines `cases` and `(fn main ((w World)) World (run_cases
;;; "NAME_test" (cases) 0 w))`; the exit status is the failure count.

(import "../host.shard")
(import "../util.shard")
(use Init.List cons nil)
(use kernel.host)
(use kernel.host.World)
(use kernel.util)

(type Case (Case (List Int) Bool))

(fn run_cases ((label (List Int)) (cs (List Case)) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (nil (exit fails (write_line (append label (append (utf8 ": failures = ") (show_int fails))) w)))
    ((cons (Case name ok) r)
     (run_cases label r (if ok fails (+ fails 1))
       (write_line (append (if ok (utf8 "PASS ") (utf8 "FAIL ")) name) w)))))
