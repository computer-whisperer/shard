;;; v3/kernel/test/case_kit.shard — the case list and its report, shared by every test
;;; entrypoint (phase 3, the second of the four follow-ups after the K seal: one kit instead
;;; of seventeen copies). A test defines `cases` and `(fn main ((w World)) World (run_cases
;;; "NAME_test" (cases) 0 w))`; the exit status is the failure count.

(import "../host.shard")
(import "../util.shard")
(use kernel.host)
(use kernel.host.World)
(use kernel.prelude)
(use kernel.prelude.List)
(use kernel.util)

(type Case (Case (List Int) Bool))

(fn run_cases ((label (List Int)) (cs (List Case)) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (Nil (exit fails (write_line (append label (append ": failures = " (show_int fails))) w)))
    ((Cons (Case name ok) r) (run_cases label r (if ok fails (+ fails 1)) (write_line (append (if ok "PASS " "FAIL ") name) w)))))
