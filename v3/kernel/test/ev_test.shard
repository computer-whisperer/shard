;;; v3/kernel/test/ev_test.shard — `ev` on hand-built programs:
;;; the per-node rules, the tag rule for `if`, sequential `let`,
;;; the primitive table's guards and totalizations, fuel (a
;;; self-recursive function exhausts and is never a value), an extern under
;;; the pure `ev`, a sig fn linked and unlinked, deep recursion without the
;;; host's stack.

(import "../host.shard")
(import "../ev.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.ev)
(use kernel.host)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.EvRes)
(use kernel.prog.Prog)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


(fn nm_list () Name (n1 (sym "List")))
(fn nm_nil () Name (Str (nm_list) (sym "nil")))
(fn nm_cons () Name (Str (nm_list) (sym "cons")))
(fn nm_int () Name (n1 (sym "Int")))
(fn nm_bool () Name (n1 (sym "Bool")))
(fn nm_true () Name (Str (nm_bool) (sym "true")))
(fn nm_false () Name (Str (nm_bool) (sym "false")))
(fn ty_int () EType (ETCon (nm_int) nil))
(fn ty_list_int () EType (ETCon (nm_list) (list (ty_int))))
(fn t () Name (n1 (sym "t")))
(fn nm ((s Symbol)) Name (n2 (sym "t") s))

(fn list_decl () EDecl
  (EInd (nm_list) 1
    (list (ECtorDef (nm_nil) nil)
      (ECtorDef (nm_cons) (list (ETVar 0) (ETCon (nm_list) (list (ETVar 0))))))))
(fn bool_decl () EDecl (EInd (nm_bool) 0 (list (ECtorDef (nm_false) nil) (ECtorDef (nm_true) nil))))

;; (fn length ((xs (List Int))) Int (match xs (Nil 0) ((Cons _ t) (+ 1 (length t)))))
(fn length_decl () EDecl
  (EFn (nm (sym "length")) 0 (list (ty_list_int)) (ty_int) (RecStruct 0)
    (EMatch (EBVar 0)
      (list (EArm (PCtor (nm_nil) nil) (ELit (LInt 0)))
        (EArm (PCtor (nm_cons) (list PVar PVar))
          (EPrim (n1 (sym "+")) (list (ELit (LInt 1)) (ECall (nm (sym "length")) (list (EBVar 0))))))))))
;; (fn loop ((n Int)) Int (loop n)) — exhausts, never a value
(fn loop_decl () EDecl
  (EFn (nm (sym "loop")) 0 (list (ty_int)) (ty_int) RecNone
    (ECall (nm (sym "loop")) (list (EBVar 0)))))
;; (fn seq ((a Int)) Int (let ((b (+ a 1)) (c (* b 2))) (- c a)))  — sequential: b sees a, c sees b
(fn seq_decl () EDecl
  (EFn (nm (sym "seq")) 0 (list (ty_int)) (ty_int) RecNone
    (ELet
      (list (EPrim (n1 (sym "+")) (list (EBVar 0) (ELit (LInt 1))))
        (EPrim (n1 (sym "*")) (list (EBVar 0) (ELit (LInt 2)))))
      (EPrim (n1 (sym "-")) (list (EBVar 0) (EBVar 2))))))
;; (fn pick ((a Int) (b Int)) Int (if (lt a b) 10 20))
(fn pick_decl () EDecl
  (EFn (nm (sym "pick")) 0 (list (ty_int) (ty_int)) (ty_int) RecNone
    (EIf (EPrim (n1 (sym "<")) (list (EBVar 1) (EBVar 0))) (ELit (LInt 10)) (ELit (LInt 20)))))
;; (fn bad_if ((a Int)) Int (if a 1 2)) — a non-cell condition
(fn bad_if_decl () EDecl
  (EFn (nm (sym "bad_if")) 0 (list (ty_int)) (ty_int) RecNone
    (EIf (EBVar 0) (ELit (LInt 1)) (ELit (LInt 2)))))
;; (fn six ((a Int)) Int (match a (6 1))) — no arm for anything else
(fn six_decl () EDecl
  (EFn (nm (sym "six")) 0 (list (ty_int)) (ty_int) RecNone
    (EMatch (EBVar 0) (list (EArm (PLit (LInt 6)) (ELit (LInt 1)))))))
;; (fn op2 ((a Int) (b Int)) Int (PRIM a b)) for each primitive under test
(fn op2_decl ((name Symbol) (prim Name)) EDecl
  (EFn (nm name) 0 (list (ty_int) (ty_int)) (ty_int) RecNone (EPrim prim (list (EBVar 1) (EBVar 0)))))
;; (fn hello () String "hi")
(fn hello_decl () EDecl
  (EFn (nm (sym "hello")) 0 nil (ETCon (n1 (sym "String")) nil) RecNone (ELit (LStr (utf8 "hi")))))
;; (extern shout ((n Int)) Int); (fn use_ext ((n Int)) Int (shout n))
(fn shout_decl () EDecl (EExtern (nm (sym "shout")) 0 (list (ty_int)) (ty_int)))
(fn use_ext_decl () EDecl
  (EFn (nm (sym "use_ext")) 0 (list (ty_int)) (ty_int) RecNone
    (EExt (nm (sym "shout")) (list (EBVar 0)))))
;; (sig fn twice ((n Int)) Int), or the implementation substituted under its identity:
;; (fn twice ((n Int)) Int (* n 2))
(fn twice_sig () EDecl (ESig (nm (sym "twice")) 0 (list (ty_int)) (ty_int)))
(fn twice_impl () EDecl
  (EFn (nm (sym "twice")) 0 (list (ty_int)) (ty_int) RecNone
    (EPrim (n1 (sym "*")) (list (EBVar 0) (ELit (LInt 2))))))
(fn use_sig_decl () EDecl
  (EFn (nm (sym "use_sig")) 0 (list (ty_int)) (ty_int) RecNone
    (ECall (nm (sym "twice")) (list (EBVar 0)))))
;; (fn count ((xs (List Int)) (acc Int)) Int (match xs (Nil acc) ((Cons _ t) (count t (+ acc 1))))) — tail recursive, deep
(fn count_decl () EDecl
  (EFn (nm (sym "count")) 0 (list (ty_list_int) (ty_int)) (ty_int) (RecStruct 0)
    (EMatch (EBVar 1)
      (list (EArm (PCtor (nm_nil) nil) (EBVar 0))
        (EArm (PCtor (nm_cons) (list PVar PVar))
          (ECall (nm (sym "count"))
            (list (EBVar 0) (EPrim (n1 (sym "+")) (list (EBVar 2) (ELit (LInt 1)))))))))))

(fn prog ((linked Bool)) Prog
  (Prog
    (append
      (list (list_decl) (bool_decl) (length_decl) (loop_decl) (seq_decl) (pick_decl) (bad_if_decl)
        (six_decl)
        (op2_decl (sym "div") (n1 (sym "/")))
        (op2_decl (sym "tdiv") (n2 (sym "Int") (sym "tdiv")))
        (op2_decl (sym "tmod_t") (n2 (sym "Int") (sym "tmod")))
        (op2_decl (sym "emod") (n1 (sym "mod")))
        (op2_decl (sym "tmod") (n1 (sym "tmod")))
        (op2_decl (sym "ediv") (n1 (sym "ediv")))
        (op2_decl (sym "nsub") (n2 (sym "Nat") (sym "sub")))
        (op2_decl (sym "shl") (n1 (sym "bshl")))
        (op2_decl (sym "nland") (n2 (sym "Nat") (sym "land")))
        (op2_decl (sym "nadd") (n2 (sym "Nat") (sym "add")))
        (op2_decl (sym "nmul") (n2 (sym "Nat") (sym "mul")))
        (op2_decl (sym "ndiv") (n2 (sym "Nat") (sym "div")))
        (op2_decl (sym "nmod") (n2 (sym "Nat") (sym "mod")))
        (op2_decl (sym "ngcd") (n2 (sym "Nat") (sym "gcd")))
        (op2_decl (sym "npow") (n2 (sym "Nat") (sym "pow")))
        (op2_decl (sym "nbeq") (n2 (sym "Nat") (sym "beq")))
        (op2_decl (sym "nble") (n2 (sym "Nat") (sym "ble")))
        (op2_decl (sym "ndeceq") (n2 (sym "Nat") (sym "decEq")))
        (op2_decl (sym "ndeclt") (n2 (sym "Nat") (sym "decLt")))
        (op2_decl (sym "ndecle") (n2 (sym "Nat") (sym "decLe")))
        (op2_decl (sym "nshr") (n2 (sym "Nat") (sym "shiftRight")))
        (op2_decl (sym "nshl") (n2 (sym "Nat") (sym "shiftLeft")))
        (hello_decl)
        (shout_decl)
        (use_ext_decl)
        (if linked (twice_impl) (twice_sig))
        (use_sig_decl)
        (count_decl))
      nil)))

(fn vlist ((xs (List Int))) Val
  (measure (struct xs))
  (match xs
    (nil (VCtor (nm_nil) nil))
    ((cons x r) (VCtor (nm_cons) (list (VInt x) (vlist r))))))
(fn ints ((n Int) (acc (List Int))) (List Int)
  (measure n)
  (if (< n 1) acc (ints (- n 1) (cons n acc))))
(fn vint ((r EvRes) (k Int)) Bool
  (match r
    ((EvOk (VInt m)) (= m k))
    (_ false)))
(fn vctor ((r EvRes) (c Name)) Bool
  (match r
    ((EvOk (VCtor d nil)) (name_eq c d))
    (_ false)))
(fn stuck ((r EvRes) (reason Symbol) (subject Name)) Bool
  (match r
    ((EvStuck s n) (bool_and (sym_eq s reason) (name_eq n subject)))
    (_ false)))
(fn out ((r EvRes)) Bool
  (match r
    (EvOut true)
    (_ false)))
(fn exhausted ((r EvRes) (res Symbol) (subject Name)) Bool
  (match r
    ((EvExhausted s n) (bool_and (sym_eq s res) (name_eq n subject)))
    (_ false)))
(fn run1 ((f Symbol) (args (List Val))) EvRes (ev (prog false) (nm f) args 1000000))
(fn run_fuel ((f Symbol) (args (List Val)) (fuel Int)) EvRes (ev (prog false) (nm f) args fuel))

(fn cases () (List Case)
  (list
    (Case (utf8 "length of a 3-list is 3")
      (vint (run1 (sym "length") (list (vlist (list 7 8 9)))) 3))
    (Case (utf8 "length of Nil is 0") (vint (run1 (sym "length") (list (vlist nil))) 0))
    (Case (utf8 "let is sequential: b sees a, c sees b") (vint (run1 (sym "seq") (list (VInt 5))) 7))
    (Case (utf8 "if takes the then-branch on the second constructor")
      (vint (run1 (sym "pick") (list (VInt 1) (VInt 2))) 10))
    (Case (utf8 "if takes the else-branch on the first")
      (vint (run1 (sym "pick") (list (VInt 2) (VInt 1))) 20))
    (Case (utf8 "if on a non-cell is stuck if_tag")
      (stuck (run1 (sym "bad_if") (list (VInt 1))) (sym "if_tag") (nm (sym "bad_if"))))
    (Case (utf8 "no arm is stuck no_arm in the function")
      (stuck (run1 (sym "six") (list (VInt 5))) (sym "no_arm") (nm (sym "six"))))
    (Case (utf8 "a literal arm matches") (vint (run1 (sym "six") (list (VInt 6))) 1))
    (Case (utf8 "the bare-named / is stuck at zero (guard)")
      (stuck (run1 (sym "div") (list (VInt 7) (VInt 0))) (sym "guard") (nm (sym "div"))))
    (Case (utf8 "the bare-named / truncates") (vint (run1 (sym "div") (list (VInt -7) (VInt 2))) -3))
    (Case (utf8 "Int.tdiv is total: x / 0 = 0")
      (vint (run1 (sym "tdiv") (list (VInt 7) (VInt 0))) 0))
    (Case (utf8 "Int.tmod is total: tmod x 0 = x")
      (vint (run1 (sym "tmod_t") (list (VInt 7) (VInt 0))) 7))
    (Case (utf8 "mod is Euclidean") (vint (run1 (sym "emod") (list (VInt -7) (VInt 3))) 2))
    (Case (utf8 "tmod follows the dividend") (vint (run1 (sym "tmod") (list (VInt -7) (VInt 3))) -1))
    (Case (utf8 "ediv pairs with mod") (vint (run1 (sym "ediv") (list (VInt -7) (VInt 3))) -3))
    (Case (utf8 "Nat.sub saturates") (vint (run1 (sym "nsub") (list (VInt 3) (VInt 5))) 0))
    (Case (utf8 "Nat.sub otherwise subtracts") (vint (run1 (sym "nsub") (list (VInt 5) (VInt 3))) 2))
    (Case (utf8 "a shift by 64 is a value")
      (vint (run1 (sym "shl") (list (VInt 1) (VInt 64))) 18446744073709551616))
    (Case (utf8 "a shift by a negative count is stuck (guard)")
      (stuck (run1 (sym "shl") (list (VInt 1) (VInt -1))) (sym "guard") (nm (sym "shl"))))
    (Case (utf8 "a shift by 63 is a value")
      (vint (run1 (sym "shl") (list (VInt 1) (VInt 63))) 9223372036854775808))
    (Case (utf8 "Nat.land on a negative is stuck (guard)")
      (stuck (run1 (sym "nland") (list (VInt -1) (VInt 3))) (sym "guard") (nm (sym "nland"))))
    (Case (utf8 "Nat.land on naturals") (vint (run1 (sym "nland") (list (VInt 6) (VInt 3))) 2))
    (Case (utf8 "K's Nat set: Nat.add") (vint (run1 (sym "nadd") (list (VInt 2) (VInt 3))) 5))
    (Case (utf8 "Nat.add on a negative is stuck (guard)")
      (stuck (run1 (sym "nadd") (list (VInt -1) (VInt 3))) (sym "guard") (nm (sym "nadd"))))
    (Case (utf8 "Nat.mul") (vint (run1 (sym "nmul") (list (VInt 6) (VInt 7))) 42))
    (Case (utf8 "Nat.mul on a negative is stuck (guard)")
      (stuck (run1 (sym "nmul") (list (VInt 6) (VInt -7))) (sym "guard") (nm (sym "nmul"))))
    (Case (utf8 "Nat.div on a negative is stuck (guard)")
      (stuck (run1 (sym "ndiv") (list (VInt -6) (VInt 2))) (sym "guard") (nm (sym "ndiv"))))
    (Case
      (utf8
        "Nat.pow whose size estimate passes K's literal bound is exhausted nat_size — never stuck")
      (exhausted (run1 (sym "npow") (list (VInt 2) (VInt 2000000000))) (sym "nat_size")
        (nm (sym "npow"))))
    (Case (utf8 "Nat.div is total: x / 0 = 0") (vint (run1 (sym "ndiv") (list (VInt 7) (VInt 0))) 0))
    (Case (utf8 "Nat.div floors") (vint (run1 (sym "ndiv") (list (VInt 7) (VInt 2))) 3))
    (Case (utf8 "Nat.mod is total: x % 0 = x") (vint (run1 (sym "nmod") (list (VInt 7) (VInt 0))) 7))
    (Case (utf8 "Nat.mod") (vint (run1 (sym "nmod") (list (VInt 7) (VInt 3))) 1))
    (Case (utf8 "Nat.gcd") (vint (run1 (sym "ngcd") (list (VInt 12) (VInt 18))) 6))
    (Case (utf8 "Nat.gcd with zero") (vint (run1 (sym "ngcd") (list (VInt 12) (VInt 0))) 12))
    (Case (utf8 "Nat.pow") (vint (run1 (sym "npow") (list (VInt 2) (VInt 63))) 9223372036854775808))
    (Case (utf8 "Nat.pow with an exponent past K's count is exhausted nat_count — never stuck")
      (exhausted (run1 (sym "npow") (list (VInt 2) (VInt 4294967296))) (sym "nat_count")
        (nm (sym "npow"))))
    (Case (utf8 "Nat.beq returns Init's Bool: true")
      (vctor (run1 (sym "nbeq") (list (VInt 4) (VInt 4))) (n2 (sym "Bool") (sym "true"))))
    (Case (utf8 "Nat.beq: false")
      (vctor (run1 (sym "nbeq") (list (VInt 4) (VInt 5))) (n2 (sym "Bool") (sym "false"))))
    (Case (utf8 "Nat.ble: true at equality")
      (vctor (run1 (sym "nble") (list (VInt 4) (VInt 4))) (n2 (sym "Bool") (sym "true"))))
    (Case (utf8 "Nat.ble: false")
      (vctor (run1 (sym "nble") (list (VInt 5) (VInt 4))) (n2 (sym "Bool") (sym "false"))))
    (Case (utf8 "Nat.decEq returns a Decidable: isTrue")
      (vctor (run1 (sym "ndeceq") (list (VInt 4) (VInt 4))) (n2 (sym "Decidable") (sym "isTrue"))))
    (Case (utf8 "Nat.decLt: isFalse")
      (vctor (run1 (sym "ndeclt") (list (VInt 4) (VInt 4))) (n2 (sym "Decidable") (sym "isFalse"))))
    (Case (utf8 "Nat.decLe: isTrue")
      (vctor (run1 (sym "ndecle") (list (VInt 4) (VInt 4))) (n2 (sym "Decidable") (sym "isTrue"))))
    (Case (utf8 "Nat.shiftRight is total: 1 >> 64 = 0")
      (vint (run1 (sym "nshr") (list (VInt 1) (VInt 64))) 0))
    (Case (utf8 "Nat.shiftLeft past the host's guard: 1 << 63")
      (vint (run1 (sym "nshl") (list (VInt 1) (VInt 63))) 9223372036854775808))
    (Case (utf8 "Nat.shiftRight past the host's guard: 2^63 >> 63 = 1")
      (vint (run1 (sym "nshr") (list (VInt 9223372036854775808) (VInt 63))) 1))
    (Case (utf8 "a string literal is the list of its bytes")
      (match (run1 (sym "hello") nil)
        ((EvOk
           (VCtor _
             (cons (VInt 104) (cons (VCtor _ (cons (VInt 105) (cons (VCtor _ nil) nil))) nil))))
         true)
        (_ false)))
    (Case (utf8 "the self-recursive function exhausts its fuel")
      (out (run_fuel (sym "loop") (list (VInt 1)) 1000)))
    (Case (utf8 "it exhausts any fuel") (out (run_fuel (sym "loop") (list (VInt 1)) 1)))
    (Case (utf8 "fuel is spent per function entry: length needs four")
      (out (run_fuel (sym "length") (list (vlist (list 1 2 3))) 3)))
    (Case (utf8 "and four suffice") (vint (run_fuel (sym "length") (list (vlist (list 1 2 3))) 4) 3))
    (Case (utf8 "an extern is stuck under the pure ev, in the calling function")
      (stuck (run1 (sym "use_ext") (list (VInt 1))) (sym "extern") (nm (sym "use_ext"))))
    (Case (utf8 "a sig fn without a link is stuck unlinked")
      (stuck (run1 (sym "use_sig") (list (VInt 4))) (sym "unlinked") (nm (sym "twice"))))
    (Case (utf8 "the implementation substituted under the sig fn's identity runs")
      (vint (ev (prog true) (nm (sym "use_sig")) (list (VInt 4)) 1000) 8))
    (Case (utf8 "an unknown function is stuck unknown_head")
      (stuck (run1 (sym "nowhere") nil) (sym "unknown_head") (nm (sym "nowhere"))))
    (Case (utf8 "a 200,000-deep recursion does not need the host's stack")
      (vint (run1 (sym "length") (list (vlist (ints 200000 nil)))) 200000))
    (Case (utf8 "and neither does a 200,000-long tail loop")
      (vint (run1 (sym "count") (list (vlist (ints 200000 nil)) (VInt 0))) 200000))))


(fn main ((w World)) World (run_cases (utf8 "ev_test") (cases) 0 w))
