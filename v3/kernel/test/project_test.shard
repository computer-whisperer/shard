;;; v3/kernel/test/project_test.shard — the E projection run: v3/pins/loader/project_bool's
;;; definitions erased by the derived view and run under `ev`. Both values of a `decide`
;;; survive being returned, matched against Bool's constructors, stored in a field, used as a
;;; condition and as the operand of another if; a matcher application runs its chosen arm only.
;;; Run: ./rust_bootstrap/target/release/eval direct v3/kernel/test/project_test.shard
;;; Exit code = number of failures.

(import "loader_kit.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.ev)
(use kernel.host)
(use kernel.prog)
(use kernel.test.loader_kit)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.prog.EvRes)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)

(fn nat_of ((p Prog) (f Symbol)) Int
  (match (ev p (main_fn f) nil 100000)
    ((EvOk (VInt n)) n)
    (_ -1)))
(fn ok_run ((p Prog) (f Symbol)) Bool
  (match (ev p (main_fn f) nil 100000)
    ((EvOk _) true)
    (_ false)))

(fn cases ((w World)) (Prod (List Case) World)
  (match
    (load_prog (utf8 "v3/pins/loader/project_bool")
      (list (utf8 "v3/pins/loader/project_bool/main.shard"))
      w)
    ((Prod.mk (Prod.mk p _) w1)
     (Prod.mk
       (list
         (Case (utf8 "decide true, returned and matched against Bool.true: 1")
           (= (nat_of p (sym "t_true")) 1))
         (Case (utf8 "decide false, returned and matched against Bool.false: 0")
           (= (nat_of p (sym "t_false")) 0))
         (Case (utf8 "decide true stored in an Option's field and matched after: 1")
           (= (nat_of p (sym "t_stored")) 1))
         (Case (utf8 "decide false stored and matched after: 0")
           (= (nat_of p (sym "t_stored_false")) 0))
         (Case (utf8 "decide as a condition, both ways: 10 + 20") (= (nat_of p (sym "t_cond")) 30))
         (Case (utf8 "decide as the branch of another if, then matched: 1 + 0 + 0")
           (= (nat_of p (sym "t_both")) 1))
         (Case (utf8 "the chosen arm only: pick false is 1 though the other arm exhausts")
           (= (nat_of p (sym "t_pick")) 1))
         (Case (utf8 "and the other arm does exhaust when it is the chosen one")
           (bool_not (ok_run p (sym "t_pick_spent")))))
       w1))))

(fn main ((w World)) World
  (match (cases w)
    ((Prod.mk cs w1) (run_cases (utf8 "project_test") cs 0 w1))))
