;;; v3/kernel/test/project_test.shard — the E projection run (LANGUAGE.md §8.4 slice 3.16 rules
;;; 1 and 3; GPT-6 R64's forcing and R66, fixtures G2 and G3): v3/pins/loader/project_bool's
;;; definitions erased by the derived view and run under `ev`. Both values of a `decide`
;;; survive being returned, matched against Bool's constructors, stored in a field, used as a
;;; condition and as the operand of another if; a matcher application runs its chosen arm only.
;;; Run: ./rust_bootstrap/target/release/eval direct v3/kernel/test/project_test.shard
;;; Exit code = number of failures.

(import "loader_kit.shard")
(import "case_kit.shard")
(use kernel.ev)
(use kernel.host)
(use kernel.prelude)
(use kernel.prog)
(use kernel.test.loader_kit)
(use kernel.util)
(use kernel.host.World)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Pair)
(use kernel.prog.EvRes)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)

(fn nat_of ((p Prog) (f Symbol)) Int
  (match (ev p (main_fn f) Nil 100000) ((EvOk (VInt n)) n) (_ (- 0 1))))
(fn ok_run ((p Prog) (f Symbol)) Bool
  (match (ev p (main_fn f) Nil 100000) ((EvOk _) True) (_ False)))

(fn cases ((w World)) (Pair (List Case) World)
  (match (load_prog "v3/pins/loader/project_bool" (list (fixture_int)) (list "v3/pins/loader/project_bool/main.shard") w)
    ((Pair (Pair p _) w1)
     (Pair
       (list
         (Case "decide true, returned and matched against Bool.true: 1" (int_eq (nat_of p (quote t_true)) 1))
         (Case "decide false, returned and matched against Bool.false: 0" (int_eq (nat_of p (quote t_false)) 0))
         (Case "decide true stored in an Option's field and matched after: 1" (int_eq (nat_of p (quote t_stored)) 1))
         (Case "decide false stored and matched after: 0" (int_eq (nat_of p (quote t_stored_false)) 0))
         (Case "decide as a condition, both ways: 10 + 20" (int_eq (nat_of p (quote t_cond)) 30))
         (Case "decide as the branch of another if, then matched: 1 + 0 + 0" (int_eq (nat_of p (quote t_both)) 1))
         (Case "the chosen arm only: pick false is 1 though the other arm exhausts" (int_eq (nat_of p (quote t_pick)) 1))
         (Case "and the other arm does exhaust when it is the chosen one" (bool_not (ok_run p (quote t_pick_spent)))))
       w1))))

(fn main ((w World)) World
  (match (cases w) ((Pair cs w1) (run_cases "project_test" cs 0 w1))))
