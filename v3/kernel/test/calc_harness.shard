;;; v3/kernel/test/calc_harness.shard — the V3 side of calc's differential
;;; (kernel/test/calc_test.sh):
;;;   eval direct v3/kernel/test/calc_harness.shard EXPORT INDEX INPUTS [trace]
;;; loads v3/examples/calc/ (root v3) with Init on demand from the pinned
;;; EXPORT and its INDEX, then for each line of INPUTS calls
;;; `ev` on every entry of the program half with the line as an Init
;;; `List Int` cell — the values built as data — and prints one line per input and
;;; entry, `[i] NAME: VALUE`, then the folds over all the lines as
;;; `* NAME: VALUE`. VALUE is written in the value syntax of the recorded
;;; reference (fixtures/calc_old_tree.txt, which calc_test.sh compares this
;;; output with): `(Some 3)`, `None`, `(Cons 1 Nil)`, `True`,
;;; a nullary constructor bare, integers in decimal. The cases are in the
;;; reference's order; a disagreement is a finding.

(import "loader_kit.shard")
(import "../loader.shard")
(import "../ev.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.etable)
(use kernel.ev)
(use kernel.host)
(use kernel.json)
(use kernel.loader)
(use kernel.loader.InitSt)
(use kernel.name)
(use kernel.prog)
(use kernel.scope)
(use kernel.test.loader_kit)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.loader.Rec)
(use kernel.name.Name)
(use kernel.prog.EvRes)
(use kernel.prog.Prog)
(use kernel.prog.Val)

(fn fuel () Int 100000000)
(fn nm ((s Symbol)) Name
  (match (name_of_sym s)
    ((some n) n)
    (none Anon)))

;; ---- values as data: Init's cells and the port's --------------------------------
(fn v_nil () Val (VCtor (nm (sym "List.nil")) nil))
(fn v_cons ((x Val) (r Val)) Val (VCtor (nm (sym "List.cons")) (list x r)))
(fn v_bytes ((bs (List Int))) Val
  (measure (struct bs))
  (match bs
    (nil (v_nil))
    ((cons b r) (v_cons (VInt b) (v_bytes r)))))
(fn v_lines ((ls (List (List Int)))) Val
  (measure (struct ls))
  (match ls
    (nil (v_nil))
    ((cons l r) (v_cons (v_bytes l) (v_lines r)))))
(fn v_none () Val (VCtor (nm (sym "Option.none")) nil))
(fn v_state0 () Val (VCtor (nm (sym "examples.calc.calc_app.CalcState.CalcState")) (list (v_none))))
(fn v_world0 () Val
  (VCtor (nm (sym "examples.calc.calc_app_world.CalcWorld.CalcWorld")) (list (v_nil))))
(fn v_num ((n Int)) Val (VCtor (nm (sym "examples.calc.calc.Exp.Num")) (list (VInt n))))
(fn v_add ((a Val) (b Val)) Val (VCtor (nm (sym "examples.calc.calc.Exp.Add")) (list a b)))
(fn v_sub ((a Val) (b Val)) Val (VCtor (nm (sym "examples.calc.calc.Exp.Sub")) (list a b)))
(fn v_print ((bs (List Int))) Val
  (VCtor (nm (sym "examples.calc.calc_app.Action.Print")) (list (v_bytes bs))))
(fn v_exit ((n Int)) Val (VCtor (nm (sym "examples.calc.calc_app.Action.Exit")) (list (VInt n))))
(fn v_nop () Val (VCtor (nm (sym "examples.calc.calc_app.Action.Nop")) nil))
(fn v_true () Val (VCtor (nm (sym "Bool.true")) nil))
(fn v_false () Val (VCtor (nm (sym "Bool.false")) nil))
(fn v_digit ((b Int)) Val
  (VCtor (nm (sym_of_chars (append (utf8 "examples.calc.calc_ndigit.Digit.D") (show_int (- b 48)))))
    nil))
(fn v_digits ((bs (List Int))) Val
  (measure (struct bs))
  (match bs
    (nil (v_nil))
    ((cons b r) (if (bool_and (<= 48 b) (<= b 57)) (v_cons (v_digit b) (v_digits r)) (v_digits r)))))
(fn first_digit ((bs (List Int))) (Option Int)
  (measure (struct bs))
  (match bs
    (nil none)
    ((cons b r) (if (bool_and (<= 48 b) (<= b 57)) (some b) (first_digit r)))))

;; ---- the reference's value syntax -------------------------------------------------
(fn r_val ((v Val)) (List Int)
  (measure (struct v))
  (match v
    ((VInt n) (show_int n))
    ((VCtor c args)
     (match args
       (nil (r_ctor c))
       (_ (append (utf8 "(") (append (r_ctor c) (append (r_args args) (utf8 ")")))))))))
(fn r_args ((vs (List Val))) (List Int)
  (measure (struct vs))
  (match vs
    (nil nil)
    ((cons v r) (append (utf8 " ") (append (r_val v) (r_args r))))))
;; Init's constructors under the reference's names; the port's by their last component
(fn r_ctor ((c Name)) (List Int)
  (let
    ((s
       (chars_of_sym
         (match c
           ((Str _ x) x)
           (_ (sym "anon"))))))
    (if (int_list_eq s (utf8 "some")) (utf8 "Some")
    (if (int_list_eq s (utf8 "none")) (utf8 "None")
    (if (int_list_eq s (utf8 "cons")) (utf8 "Cons")
    (if (int_list_eq s (utf8 "nil")) (utf8 "Nil")
    (if (int_list_eq s (utf8 "true")) (utf8 "True")
    (if (int_list_eq s (utf8 "false")) (utf8 "False")
    s))))))))
(fn r_opt ((o (Option (List Int)))) (List Int)
  (match o
    (none (utf8 "None"))
    ((some s) (append (utf8 "(Some ") (append s (utf8 ")"))))))

;; ---- calling the program ----------------------------------------------------------------
(fn call ((p Prog) (f Symbol) (args (List Val))) (List Int)
  (match (ev p (nm f) args (fuel))
    ((EvOk v) (r_val v))
    (EvOut (utf8 "out-of-fuel"))
    ((EvExhausted r n)
     (append (utf8 "exhausted ") (append (chars_of_sym r) (append (utf8 " in ") (show_name n)))))
    ((EvStuck r n)
     (append (utf8 "stuck ") (append (chars_of_sym r) (append (utf8 " in ") (show_name n)))))))
(fn call_v ((p Prog) (f Symbol) (args (List Val))) (Option Val)
  (match (ev p (nm f) args (fuel))
    ((EvOk v) (some v))
    (_ none)))
;; the result of `run`, when some
(fn run_int ((p Prog) (line Val)) (Option Int)
  (match (call_v p (sym "examples.calc.calc.run") (list line))
    ((some (VCtor _ (cons (VInt m) nil))) (some m))
    (_ none)))
(fn abs_int ((n Int)) Int (if (< n 0) (- 0 n) n))

(fn out ((i Int) (name (List Int)) (v (List Int)) (w World)) World
  (write_line
    (append (utf8 "[")
      (append (show_int i) (append (utf8 "] ") (append name (append (utf8 ": ") v)))))
    w))
(fn out_g ((name (List Int)) (v (List Int)) (w World)) World
  (write_line (append (utf8 "* ") (append name (append (utf8 ": ") v))) w))

(fn fc ((s Symbol)) Symbol (sym_of_chars (append (utf8 "examples.calc.calc.") (chars_of_sym s))))
(fn fcs ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_spec.") (chars_of_sym s))))
(fn fce ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_equiv.") (chars_of_sym s))))
(fn fca ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_app.") (chars_of_sym s))))
(fn fcas ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_app_spec.") (chars_of_sym s))))
(fn fct ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_app_trace.") (chars_of_sym s))))
(fn fcw ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_app_world.") (chars_of_sym s))))
(fn fcsh ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_show.") (chars_of_sym s))))
(fn fcsr ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_show_run.") (chars_of_sym s))))
(fn fcn ((s Symbol)) Symbol
  (sym_of_chars (append (utf8 "examples.calc.calc_ndigit.") (chars_of_sym s))))

;; the cases over one line, in the reference's order (the innermost call prints first:
;; the World is threaded by nesting); prev = the lines before it
(fn pl_a ((p Prog) (i Int) (L Val) (tv Val) (pnv Val) (tdv Val) (ptv Val) (w World)) World
  (out i (utf8 "numr_rest") (call p (fcs (sym "numr_rest")) (list tdv))
    (out i (utf8 "numr_val") (call p (fcs (sym "numr_val")) (list tdv))
      (out i (utf8 "pn_rest") (call p (fcs (sym "pn_rest")) (list pnv))
        (out i (utf8 "pn_some") (call p (fcs (sym "pn_some")) (list pnv))
          (out i (utf8 "head_is_ws") (call p (fce (sym "head_is_ws")) (list L))
            (out i (utf8 "strip") (call p (fce (sym "strip")) (list ptv))
              (out i (utf8 "parse_tail") (r_val ptv)
                (out i (utf8 "parse_num") (r_val pnv)
                  (out i (utf8 "take_digits") (r_val tdv)
                    (out i (utf8 "skip_ws") (call p (fcs (sym "skip_ws")) (list L))
                      (out i (utf8 "parse_expr") (call p (fcs (sym "parse_expr")) (list L))
                        (out i (utf8 "spec_run") (call p (fcs (sym "spec_run")) (list L))
                          (out i (utf8 "run") (call p (fc (sym "run")) (list L))
                            (out i (utf8 "parse") (call p (fc (sym "parse")) (list tv))
                              (out i (utf8 "lex") (r_val tv) w))))))))))))))))
(fn pl_b ((p Prog) (i Int) (L Val) (sv Val) (s2v Val) (w World)) World
  (out i (utf8 "emitted_spec") (call p (fct (sym "emitted_spec")) (list s2v L))
    (out i (utf8 "next_state_spec") (call p (fct (sym "next_state_spec")) (list s2v L))
      (out i (utf8 "emitted") (call p (fct (sym "emitted")) (list sv L))
        (out i (utf8 "next_state") (call p (fct (sym "next_state")) (list sv L))
          (out i (utf8 "step_spec") (call p (fcas (sym "step_spec")) (list s2v L))
            (out i (utf8 "step") (call p (fca (sym "step")) (list sv L)) w)))))))
;; over the run result, when some: show_ascii of it, show/show_nat/valI/codes of its magnitude
(fn pl_c ((p Prog) (i Int) (m (Option Int)) (w World)) World
  (match m
    (none
      (out i (utf8 "codes") (utf8 "None")
        (out i (utf8 "valI") (utf8 "None")
          (out i (utf8 "show_nat") (utf8 "None")
            (out i (utf8 "show") (utf8 "None") (out i (utf8 "show_ascii") (utf8 "None") w))))))
    ((some mv)
     (let ((a (VInt (abs_int mv))))
       (match (call_v p (fcsh (sym "show")) (list a))
         (none (out i (utf8 "show_ascii") (utf8 "stuck") w))
         ((some shown)
          (out i (utf8 "codes") (r_opt (some (call p (fcsr (sym "codes")) (list shown))))
            (out i (utf8 "valI") (r_opt (some (call p (fcsh (sym "valI")) (list shown))))
              (out i (utf8 "show_nat") (r_opt (some (call p (fca (sym "show_nat")) (list a))))
                (out i (utf8 "show") (r_opt (some (r_val shown)))
                  (out i (utf8 "show_ascii")
                    (r_opt (some (call p (fca (sym "show_ascii")) (list (VInt mv)))))
                    w)))))))))))
;; the line's digits as Digit values; dval and code over the first, when any
(fn pl_d ((p Prog) (i Int) (line (List Int)) (ds Val) (w World)) World
  (match (first_digit line)
    (none (out i (utf8 "code") (utf8 "None") (out i (utf8 "dval") (utf8 "None") (pl_d0 p i ds w))))
    ((some b)
     (out i (utf8 "code") (r_opt (some (call p (fcn (sym "code")) (list (v_digit b)))))
       (out i (utf8 "dval") (r_opt (some (call p (fcn (sym "dval")) (list (v_digit b)))))
         (pl_d0 p i ds w))))))
(fn pl_d0 ((p Prog) (i Int) (ds Val) (w World)) World
  (out i (utf8 "value_go") (call p (fcn (sym "value_go")) (list ds (VInt 7)))
    (out i (utf8 "value") (call p (fcn (sym "value")) (list ds))
      (out i (utf8 "digits") (r_val ds) w))))
;; over the first byte, when any
(fn pl_e ((p Prog) (i Int) (line (List Int)) (w World)) World
  (match line
    (nil
      (out i (utf8 "digit_val") (utf8 "None")
        (out i (utf8 "is_ws") (utf8 "None") (out i (utf8 "is_digit") (utf8 "None") w))))
    ((cons b _)
     (out i (utf8 "digit_val") (r_opt (some (call p (fc (sym "digit_val")) (list (VInt b)))))
       (out i (utf8 "is_ws") (r_opt (some (call p (fc (sym "is_ws")) (list (VInt b)))))
         (out i (utf8 "is_digit") (r_opt (some (call p (fc (sym "is_digit")) (list (VInt b))))) w))))))
(fn per_line ((p Prog) (i Int) (line (List Int)) (prev (List (List Int))) (w World)) World
  (let
    ((s (call_v p (fct (sym "run_state")) (list (v_state0) (v_lines prev))))
     (s2 (call_v p (fct (sym "run_state_spec")) (list (v_state0) (v_lines prev))))
     (toks (call_v p (fc (sym "tokenize")) (list (v_bytes line))))
     (pn (call_v p (fcs (sym "parse_num")) (list (v_bytes line))))
     (td (call_v p (fcs (sym "take_digits")) (list (v_bytes line) (VInt 0))))
     (pt (call_v p (fcs (sym "parse_tail")) (list (v_num 0) (v_bytes line)))))
    (match (Prod.mk (Prod.mk s s2) (Prod.mk (Prod.mk toks pn) (Prod.mk td pt)))
      ((Prod.mk (Prod.mk (some sv) (some s2v))
         (Prod.mk (Prod.mk (some tv) (some pnv)) (Prod.mk (some tdv) (some ptv))))
       (pl_e p i line
         (pl_d p i line (v_digits line)
           (pl_c p i (run_int p (v_bytes line))
             (pl_b p i (v_bytes line) sv s2v (pl_a p i (v_bytes line) tv pnv tdv ptv w))))))
      (_ (out i (utf8 "harness") (utf8 "a derived input got stuck") w)))))

(fn lines_loop ((p Prog) (i Int) (lines (List (List Int))) (prev (List (List Int))) (w World)) World
  (measure (struct lines))
  (match lines
    (nil w)
    ((cons line rest)
     (lines_loop p (+ i 1) rest (append prev (list line)) (per_line p i line prev w)))))

;; the folds over all the lines, in calc_test.sh's order (the innermost prints first
(fn folds ((p Prog) (lines (List (List Int))) (tr Bool) (w World)) World
  (let ((E (v_lines lines)) (s0 (v_state0)) (w0 (v_world0)))
    (trace_out p E tr
      (out_g (utf8 "eval")
        (call p (fc (sym "eval")) (list (v_add (v_num 1) (v_sub (v_num 2) (v_num 3)))))
        (out_g (utf8 "combine")
          (match (call_v p (fcs (sym "combine")) (list (v_true) (v_num 1) (v_num 2)))
            ((some inner) (call p (fcs (sym "combine")) (list (v_false) inner (v_num 3))))
            (none (utf8 "stuck")))
          (out_g (utf8 "apply_action_nop") (call p (fcw (sym "apply_action")) (list w0 (v_nop)))
            (out_g (utf8 "apply_action_exit")
              (call p (fcw (sym "apply_action")) (list w0 (v_exit 3)))
              (out_g (utf8 "apply_action_print")
                (call p (fcw (sym "apply_action")) (list w0 (v_print (list 49))))
                (out_g (utf8 "run_world_spec") (call p (fcw (sym "run_world_spec")) (list w0 s0 E))
                  (out_g (utf8 "run_world") (call p (fcw (sym "run_world")) (list w0 s0 E))
                    (out_g (utf8 "drive_spec") (call p (fct (sym "drive_spec")) (list s0 E))
                      (out_g (utf8 "run_trace_spec")
                        (call p (fct (sym "run_trace_spec")) (list s0 E))
                        (out_g (utf8 "run_state_spec")
                          (call p (fct (sym "run_state_spec")) (list s0 E))
                          (out_g (utf8 "drive") (call p (fct (sym "drive")) (list s0 E))
                            (out_g (utf8 "run_trace") (call p (fct (sym "run_trace")) (list s0 E))
                              (out_g (utf8 "run_state") (call p (fct (sym "run_state")) (list s0 E))
                                w))))))))))))))))
;; the model's trace, on request (the fourth argument `trace`; calc_test's
;; tie to the reference reads the output without it): `trace_of` over the lines, each call rendered
;; as the driver renders the host's (ev.shard tr_quote, tr_args) — `* trace: get_args "1+2" …`,
;; then `* trace: write_line "3"` per line; bin_test.sh compares these with `--trace FILE`'s lines
(fn trace_out ((p Prog) (E Val) (tr Bool) (w World)) World
  (if (bool_not tr) w
  (match (call_v p (fcw (sym "trace_of")) (list E))
    (none (out 0 (utf8 "harness") (utf8 "trace_of got stuck") w))
    ((some v) (trace_lines (val_list v) w)))))
(fn trace_lines ((cs (List Val)) (w World)) World
  (measure (struct cs))
  (match cs
    (nil w)
    ((cons c r) (trace_lines r (write_line (append (utf8 "* trace: ") (trace_line c)) w)))))
(fn trace_line ((c Val)) (List Int)
  (match c
    ((VCtor n (cons a nil))
     (if (name_eq n (nm (sym "examples.calc.calc_app_world.Call.CArgs")))
       (append (utf8 "get_args") (tr_args (val_lists a)))
     (if (name_eq n (nm (sym "examples.calc.calc_app_world.Call.CWrite")))
       (append (utf8 "write_line ") (tr_quote (val_bytes a)))
     (if (name_eq n (nm (sym "examples.calc.calc_app_world.Call.CExit")))
       (append (utf8 "exit ")
         (match a
           ((VInt k) (show_int k))
           (_ (utf8 "?"))))
       (utf8 "?")))))
    (_ (utf8 "?"))))
;; Init's List cells as a list of values, a byte list, a list of byte lists
(fn val_list ((v Val)) (List Val)
  (measure (struct v))
  (match v
    ((VCtor n (cons x (cons r nil)))
     (if (name_eq n (nm (sym "List.cons"))) (cons x (val_list r)) nil))
    (_ nil)))
(fn val_bytes ((v Val)) (List Int) (val_ints (val_list v)))
(fn val_ints ((vs (List Val))) (List Int)
  (measure (struct vs))
  (match vs
    (nil nil)
    ((cons (VInt k) r) (cons k (val_ints r)))
    ((cons _ r) (val_ints r))))
(fn val_lists ((v Val)) (List (List Int)) (val_lists_go (val_list v)))
(fn val_lists_go ((vs (List Val))) (List (List Int))
  (measure (struct vs))
  (match vs
    (nil nil)
    ((cons x r) (cons (val_bytes x) (val_lists_go r)))))

(fn split_lines ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil
      (rev
        (match cur
          (nil acc)
          ((cons _ _) (cons (rev cur) acc)))))
    ((cons b r)
     (if (= b 10) (split_lines r nil (cons (rev cur) acc)) (split_lines r (cons b cur) acc)))))

(fn roots () (List (List Int))
  (utf8_all
    (list "v3/examples/calc/calc_app_world.shard" "v3/examples/calc/calc_show_run.shard"
      "v3/examples/calc/calc_ndigit.shard"
      "v3/examples/calc/calc_reconcile_tests.shard"
      "v3/examples/calc/calc_spec_tests.shard")))
(fn print_failures ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs
    (nil w)
    ((cons (RRefuse n r) t)
     (print_failures t
       (write_line
         (append (utf8 "REFUSE ") (append (show_name n) (append (utf8 " ") (chars_of_sym r))))
         w)))
    ((cons (RClassify n r m) t)
     (print_failures t
       (write_line
         (append (utf8 "REFUSE ")
           (append (show_name n)
             (append (utf8 " ") (append (chars_of_sym r) (append (utf8 ": ") m)))))
         w)))
    ((cons (RReadErr f r m) t)
     (print_failures t
       (write_line
         (append (utf8 "READ-ERROR ")
           (append f (append (utf8 " ") (append (chars_of_sym r) (append (utf8 ": ") m)))))
         w)))
    ((cons (RLoadErr f r m) t)
     (print_failures t
       (write_line
         (append (utf8 "LOAD-ERROR ")
           (append f (append (utf8 " ") (append (chars_of_sym r) (append (utf8 ": ") m)))))
         w)))
    ((cons _ t) (print_failures t w))))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk (cons export (cons index (cons inputs rest))) w1)  ; EXPORT INDEX INPUTS [trace]
     (match (parts_of (utf8 "v3"))
       (none (exit 2 w1))
       ((some rootp)
        (match (load_all (ld_with_init (load0 rootp) (InitPaths export index)) (roots) w1)
          ((Prod.mk l w2)
           (let ((fails (load_failures (rec_counts (ld_recs l) (zero_counts)))))
             (if (< 0 fails)
               (exit 2
                 (write_line
                   (append (utf8 "calc_harness: the port did not load: ")
                     (show_counts_load (rec_counts (ld_recs l) (zero_counts))))
                   (print_failures (ld_recs l) w2)))
               (match (read_file inputs w2)
                 ((Prod.mk none w3)
                  (exit 2 (write_line (utf8 "calc_harness: cannot read the inputs") w3)))
                 ((Prod.mk (some bs) w3)
                  (let ((p (es_prog (Load.etab l))) (lines (split_lines bs nil nil)))
                    (folds p lines
                      (match rest
                        ((cons t nil) (int_list_eq t (utf8 "trace")))
                        (_ false))
                      (lines_loop p 0 lines nil w3))))))))))))
    ((Prod.mk _ w1)
     (exit 2
       (write_line
         (utf8 "usage: eval direct v3/kernel/test/calc_harness.shard EXPORT INDEX INPUTS [trace]")
         w1)))))
