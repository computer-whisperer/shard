(import "../host.shard")
(import "../json.shard")
(import "../intmap.shard")
(import "case_kit.shard")
(import "../sym.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.json.JRes)
(use kernel.json.Json)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(fn parsed ((s (List Int))) Json
  (match (json_parse s)
    ((JRes v _) v)
    (JErr JNull)))
(fn cases () (List Case)
  (list
    (Case (utf8 "number")
      (match (jint (parsed (utf8 "42")))
        ((some 42) true)
        (_ false)))
    (Case (utf8 "negative")
      (match (jint (parsed (utf8 "-7")))
        ((some n) (= n -7))
        (_ false)))
    (Case (utf8 "string")
      (match (jstr (parsed (utf8 "\"ab\"")))
        ((some s) (int_list_eq s (utf8 "ab")))
        (_ false)))
    (Case (utf8 "escape")
      (match (jstr (parsed (utf8 "\"a\\nb\"")))
        ((some s) (int_list_eq s (list 97 10 98)))
        (_ false)))
    (Case (utf8 "unicode escape")
      (match (jstr (parsed (utf8 "\"\\u00e9\"")))
        ((some s) (int_list_eq s (list 195 169)))
        (_ false)))
    (Case (utf8 "surrogate pair")
      (match (jstr (parsed (utf8 "\"\\ud83d\\ude00\"")))
        ((some s) (int_list_eq s (list 240 159 152 128)))
        (_ false)))
    (Case (utf8 "array")
      (match (jarr (parsed (utf8 "[1, 2 ,3]")))
        ((some (cons _ (cons _ (cons _ nil)))) true)
        (_ false)))
    (Case (utf8 "object field")
      (match (jget (parsed (utf8 "{\"in\":3,\"str\":{\"pre\":0,\"str\":\"x\"}}")) (utf8 "str"))
        ((some o)
         (match (jget o (utf8 "pre"))
           ((some p)
            (match (jint p)
              ((some 0) true)
              (_ false)))
           (none false)))
        (none false)))
    (Case (utf8 "record kind skips in/il/ie")
      (match (jkind_of_record (parsed (utf8 "{\"ie\":1,\"bvar\":0}")))
        ((some k) (int_list_eq k (utf8 "bvar")))
        (none false)))
    (Case (utf8 "bool true")
      (match (jbool (parsed (utf8 "true")))
        ((some b) b)
        (none false)))
    (Case (utf8 "null")
      (match (parsed (utf8 "null"))
        (JNull true)
        (_ false)))
    (Case (utf8 "malformed")
      (match (json_parse (utf8 "{\"a\":"))
        (JErr true)
        (_ false)))
    ;; the fuel the parser hands down does not run out before the input does: a byte for each `[`
    (Case (utf8 "nesting")
      (match (json_parse (utf8 "[[[[[[[[[[[[[[[[{\"a\":[[[[7]]]]}]]]]]]]]]]]]]]]] "))
        ((JRes (JArr (cons _ nil)) (cons 32 nil)) true)
        (_ false)))
    (Case (utf8 "unclosed")
      (match (json_parse (utf8 "[[[[[[[["))
        (JErr true)
        (_ false)))
    (Case (utf8 "take_line")
      (match (take_line (utf8 "ab\ncd") nil)
        ((Prod.mk l r) (bool_and (int_list_eq l (utf8 "ab")) (int_list_eq r (utf8 "cd"))))))
    (Case (utf8 "intmap")
      (let
        ((m
           (im_insert
             (im_insert (im_insert (im_insert IMEmpty 5 (sym "a")) 0 (sym "z")) 1024 (sym "b"))
             1027
             (sym "c"))))
        (bool_and
          (match (im_find m 5)
            ((some s) (sym_eq s (sym "a")))
            (none false))
          (bool_and
            (match (im_find m 0)
              ((some s) (sym_eq s (sym "z")))
              (none false))
            (bool_and
              (match (im_find m 1024)
                ((some s) (sym_eq s (sym "b")))
                (none false))
              (bool_and
                (match (im_find m 1027)
                  ((some s) (sym_eq s (sym "c")))
                  (none false))
                (match (im_find m 6)
                  (none true)
                  (_ false))))))))
    ;; leaves split: 5, 21 and 69 share their low two bits (01), 5 and 21 the next two as well (01); 0 lands at a node's own slot; a re-insert replaces
    (Case (utf8 "intmap_split")
      (let
        ((m
           (im_insert
             (im_insert
               (im_insert (im_insert (im_insert IMEmpty 5 (sym "a")) 21 (sym "b")) 69 (sym "c"))
               0
               (sym "z"))
             5
             (sym "a2"))))
        (bool_and
          (match (im_find m 5)
            ((some s) (sym_eq s (sym "a2")))
            (none false))
          (bool_and
            (match (im_find m 21)
              ((some s) (sym_eq s (sym "b")))
              (none false))
            (bool_and
              (match (im_find m 69)
                ((some s) (sym_eq s (sym "c")))
                (none false))
              (bool_and
                (match (im_find m 0)
                  ((some s) (sym_eq s (sym "z")))
                  (none false))
                (bool_and
                  (match (im_find m 37)
                    (none true)
                    (_ false))
                  (bool_and
                    (match (im_find m 1)
                      (none true)
                      (_ false))
                    (match (im_find (im_insert IMEmpty 0 (sym "q")) 0)
                      ((some s) (sym_eq s (sym "q")))
                      (none false))))))))))
    ;; keys below zero part as any others do: -1 and -5 share their low two bits (11) and part at
    ;; the next two, 3 lands at the slot of the node they part under, and -1 — which every shift
    ;; leaves -1 — inserted again is replaced
    (Case (utf8 "intmap_negative")
      (let
        ((m
           (im_insert
             (im_insert (im_insert (im_insert IMEmpty -1 (sym "a")) -5 (sym "b")) 3 (sym "c"))
             -1
             (sym "a2"))))
        (bool_and
          (match (im_find m -1)
            ((some s) (sym_eq s (sym "a2")))
            (none false))
          (bool_and
            (match (im_find m -5)
              ((some s) (sym_eq s (sym "b")))
              (none false))
            (bool_and
              (match (im_find m 3)
                ((some s) (sym_eq s (sym "c")))
                (none false))
              (match (im_find m -2)
                (none true)
                (_ false)))))))))
(fn main ((w World)) World (run_cases (utf8 "json_test") (cases) 0 w))
