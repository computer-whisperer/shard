(import Init)
(import "../host.shard")
(import "../json.shard")
(import "../intmap.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.util)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.json.JRes)
(use kernel.json.Json)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(fn parsed ((s (List Int))) Json
  (match (json_parse s)
    ((JRes v _) v)
    (JErr JNull)))
(fn cases () (List Case)
  (list
    (Case "number"
      (match (jint (parsed "42"))
        ((some 42) true)
        (_ false)))
    (Case "negative"
      (match (jint (parsed "-7"))
        ((some n) (= n -7))
        (_ false)))
    (Case "string"
      (match (jstr (parsed "\"ab\""))
        ((some s) (int_list_eq s "ab"))
        (_ false)))
    (Case "escape"
      (match (jstr (parsed "\"a\\nb\""))
        ((some s) (int_list_eq s (list 97 10 98)))
        (_ false)))
    (Case "unicode escape"
      (match (jstr (parsed "\"\\u00e9\""))
        ((some s) (int_list_eq s (list 195 169)))
        (_ false)))
    (Case "surrogate pair"
      (match (jstr (parsed "\"\\ud83d\\ude00\""))
        ((some s) (int_list_eq s (list 240 159 152 128)))
        (_ false)))
    (Case "array"
      (match (jarr (parsed "[1, 2 ,3]"))
        ((some (cons _ (cons _ (cons _ nil)))) true)
        (_ false)))
    (Case "object field"
      (match (jget (parsed "{\"in\":3,\"str\":{\"pre\":0,\"str\":\"x\"}}") "str")
        ((some o)
         (match (jget o "pre")
           ((some p)
            (match (jint p)
              ((some 0) true)
              (_ false)))
           (none false)))
        (none false)))
    (Case "record kind skips in/il/ie"
      (match (jkind_of_record (parsed "{\"ie\":1,\"bvar\":0}"))
        ((some k) (int_list_eq k "bvar"))
        (none false)))
    (Case "bool true"
      (match (jbool (parsed "true"))
        ((some b) b)
        (none false)))
    (Case "null"
      (match (parsed "null")
        (JNull true)
        (_ false)))
    (Case "malformed"
      (match (json_parse "{\"a\":")
        (JErr true)
        (_ false)))
    (Case "take_line"
      (match (take_line "ab\ncd" nil)
        ((Prod.mk l r) (bool_and (int_list_eq l "ab") (int_list_eq r "cd")))))
    (Case "intmap"
      (let
        ((m
           (im_insert
             (im_insert (im_insert (im_insert IMEmpty 5 (quote a)) 0 (quote z)) 1024 (quote b))
             1027
             (quote c))))
        (bool_and
          (match (im_find m 5)
            ((some s) (sym_eq s (quote a)))
            (none false))
          (bool_and
            (match (im_find m 0)
              ((some s) (sym_eq s (quote z)))
              (none false))
            (bool_and
              (match (im_find m 1024)
                ((some s) (sym_eq s (quote b)))
                (none false))
              (bool_and
                (match (im_find m 1027)
                  ((some s) (sym_eq s (quote c)))
                  (none false))
                (match (im_find m 6)
                  (none true)
                  (_ false))))))))
    ;; leaves split: 5, 21 and 69 share their low two bits (01), 5 and 21 the next two as well (01); 0 lands at a node's own slot; a re-insert replaces
    (Case "intmap_split"
      (let
        ((m
           (im_insert
             (im_insert
               (im_insert (im_insert (im_insert IMEmpty 5 (quote a)) 21 (quote b)) 69 (quote c))
               0
               (quote z))
             5
             (quote a2))))
        (bool_and
          (match (im_find m 5)
            ((some s) (sym_eq s (quote a2)))
            (none false))
          (bool_and
            (match (im_find m 21)
              ((some s) (sym_eq s (quote b)))
              (none false))
            (bool_and
              (match (im_find m 69)
                ((some s) (sym_eq s (quote c)))
                (none false))
              (bool_and
                (match (im_find m 0)
                  ((some s) (sym_eq s (quote z)))
                  (none false))
                (bool_and
                  (match (im_find m 37)
                    (none true)
                    (_ false))
                  (bool_and
                    (match (im_find m 1)
                      (none true)
                      (_ false))
                    (match (im_find (im_insert IMEmpty 0 (quote q)) 0)
                      ((some s) (sym_eq s (quote q)))
                      (none false))))))))))))
(fn main ((w World)) World (run_cases "json_test" (cases) 0 w))
