(import "../host.shard")
(import "../json.shard")
(import "../intmap.shard")
(type Case (Case (List Int) Bool))
(fn parsed ((s (List Int))) Json (match (json_parse s) ((JRes v _) v) (JErr JNull)))
(fn cases () (List Case)
  (list
    (Case "number" (match (jint (parsed "42")) ((Some 42) True) (_ False)))
    (Case "negative" (match (jint (parsed "-7")) ((Some n) (int_eq n (- 0 7))) (_ False)))
    (Case "string" (match (jstr (parsed "\"ab\"")) ((Some s) (int_list_eq s "ab")) (_ False)))
    (Case "escape" (match (jstr (parsed "\"a\\nb\"")) ((Some s) (int_list_eq s (list 97 10 98))) (_ False)))
    (Case "unicode escape" (match (jstr (parsed "\"\\u00e9\"")) ((Some s) (int_list_eq s (list 195 169))) (_ False)))
    (Case "surrogate pair" (match (jstr (parsed "\"\\ud83d\\ude00\"")) ((Some s) (int_list_eq s (list 240 159 152 128))) (_ False)))
    (Case "array" (match (jarr (parsed "[1, 2 ,3]")) ((Some (Cons _ (Cons _ (Cons _ Nil)))) True) (_ False)))
    (Case "object field" (match (jget (parsed "{\"in\":3,\"str\":{\"pre\":0,\"str\":\"x\"}}") "str") ((Some o) (match (jget o "pre") ((Some p) (match (jint p) ((Some 0) True) (_ False))) (None False))) (None False)))
    (Case "record kind skips in/il/ie" (match (jkind_of_record (parsed "{\"ie\":1,\"bvar\":0}")) ((Some k) (int_list_eq k "bvar")) (None False)))
    (Case "bool true" (match (jbool (parsed "true")) ((Some b) b) (None False)))
    (Case "null" (match (parsed "null") (JNull True) (_ False)))
    (Case "malformed" (match (json_parse "{\"a\":") (JErr True) (_ False)))
    (Case "take_line" (match (take_line "ab\ncd" Nil) ((Pair l r) (bool_and (int_list_eq l "ab") (int_list_eq r "cd")))))
    (Case "intmap" (let ((m (im_insert (im_insert (im_insert (im_insert IMEmpty 5 (quote a)) 0 (quote z)) 1024 (quote b)) 1027 (quote c))))
                     (bool_and (match (im_find m 5) ((Some s) (sym_eq s (quote a))) (None False))
                       (bool_and (match (im_find m 0) ((Some s) (sym_eq s (quote z))) (None False))
                         (bool_and (match (im_find m 1024) ((Some s) (sym_eq s (quote b))) (None False))
                                   (bool_and (match (im_find m 1027) ((Some s) (sym_eq s (quote c))) (None False)) (match (im_find m 6) (None True) (_ False))))))))))
(fn run ((cs (List Case)) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (Nil (exit fails (write_line (append "json_test: failures = " (show_int fails)) w)))
    ((Cons (Case name ok) r) (run r (if ok fails (+ fails 1)) (write_line (append (if ok "PASS " "FAIL ") name) w)))))
(fn main ((w World)) World (run (cases) 0 w))
