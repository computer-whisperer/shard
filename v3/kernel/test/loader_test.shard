;;; v3/kernel/test/loader_test.shard — the loader's cases beyond the pins
;;; (loader_pins_test): what the records say, a module named twice, the
;;; export pin, a load given no export, visibility across root files, the sorry
;;; obligation, the root's location changing nothing (origin-only invariance); the
;;; program a load yields, run under `ev`: a consumer's fn over the
;;; view alone is stuck at the sig fn, with the implementation it runs it.
;;; The helpers are loader_kit.shard's.

(import "loader_kit.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.ev)
(use kernel.host)
(use kernel.loader)
(use kernel.test.loader_kit)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.prog.EvRes)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


(fn cases ((w World)) (Prod (List Case) World)
  (match (load_case (utf8 "v3/pins/loader/basic") (list (utf8 "v3/pins/loader/basic/main.shard")) w)
    ((Prod.mk basic w1)
     (match
       (load_case (utf8 "./v3/pins/loader/basic") (list (utf8 "./v3/pins/loader/basic/main.shard"))
         w1)
       ((Prod.mk basic2 w2)
        (match
          (load_case (utf8 "v3/pins/loader/init_nested")
            (list (utf8 "v3/pins/loader/init_nested/main.shard")
              (utf8 "v3/pins/loader/init_nested/a.shard"))
            w2)
          ((Prod.mk nested w3)
           (match
             (load_case_on (utf8 "v3/pins/loader/init") (wrong_pin)
               (list (utf8 "v3/pins/loader/init/main.shard"))
               w3)
             ((Prod.mk pin w4)
              (match
                (load_case (utf8 "v3/pins/loader/visible")
                  (list (utf8 "v3/pins/loader/visible/one.shard")
                    (utf8 "v3/pins/loader/visible/two.shard"))
                  w4)
                ((Prod.mk vis w5)
                 (match
                   (load_case (utf8 "v3/pins/loader/sorry")
                     (list (utf8 "v3/pins/loader/sorry/main.shard"))
                     w5)
                   ((Prod.mk sorry w6)
                    (match
                      (load_case_bare (utf8 "v3/pins/loader/init")
                        (list (utf8 "v3/pins/loader/init/main.shard"))
                        w6)
                      ((Prod.mk noinit w7)
                       (match
                         (load_case (utf8 "v3/pins/loader/basic")
                           (list (utf8 "v3/pins/loader/outside/main.shard"))
                           w7)
                         ((Prod.mk outside w8)
                          (match
                            (load_case (utf8 "v3/pins/loader/view_basic")
                              (list (utf8 "v3/pins/loader/view_basic/main.shard"))
                              w8)
                            ((Prod.mk view w9)
                             (match
                               (load_case (utf8 "v3/pins/loader/view_basic")
                                 (list (utf8 "v3/pins/loader/view_basic/lib"))
                                 w9)
                               ((Prod.mk impl w10)
                                (match
                                  (load_prog (utf8 "v3/pins/loader/view_basic")
                                    (list (utf8 "v3/pins/loader/view_basic/main.shard"))
                                    w10)
                                  ((Prod.mk (Prod.mk prog_view _) w11)
                                   (match
                                     (load_prog (utf8 "v3/pins/loader/view_basic")
                                       (list (utf8 "v3/pins/loader/view_basic/main.shard")
                                         (utf8 "v3/pins/loader/view_basic/lib"))
                                       w11)
                                     ((Prod.mk (Prod.mk prog_impl _) w12)
                                      (match
                                        (load_prog (utf8 "v3/pins/loader/ev_basic")
                                          (list (utf8 "v3/pins/loader/ev_basic/main.shard"))
                                          w12)
                                        ((Prod.mk (Prod.mk prog_basic recs_basic) w13)
                                         (match
                                           (load_prog (utf8 "v3/pins/loader/realize_supplied")
                                             (list
                                               (utf8 "v3/pins/loader/realize_supplied/main.shard"))
                                             w13)
                                           ((Prod.mk (Prod.mk prog_rz recs_rz) w14)
                                            (match
                                              (load_prog (utf8 "v3/pins/loader/realize_native")
                                                (list
                                                  (utf8 "v3/pins/loader/realize_native/main.shard"))
                                                w14)
                                              ((Prod.mk (Prod.mk prog_nat recs_nat) w15)
                                               (match
                                                 (load_case (utf8 "v3/pins/loader/retry")
                                                   (list (utf8 "v3/pins/loader/retry/main.shard")
                                                     (utf8 "v3/pins/loader/retry/b.shard"))
                                                   w15)
                                                 ((Prod.mk retry w16)
                                                  (match
                                                    (load_prog
                                                      (utf8 "v3/pins/loader/realize_pending_via")
                                                      (list
                                                        (utf8
                                                          "v3/pins/loader/realize_pending_via/main.shard"))
                                                      w16)
                                                    ((Prod.mk (Prod.mk _ recs_via) w17)
                                                     (match
                                                       (load_case
                                                         (utf8 "v3/pins/loader/view_pending")
                                                         (list
                                                           (utf8 "v3/pins/loader/view_pending/lib"))
                                                         w17)
                                                       ((Prod.mk impl_pending w18)
                                                        (Prod.mk
                                                          (list
                                                            (Case
                                                              (utf8
                                                                "a pending measure is recorded once and every realization reaching it names it — f's own, g through f, h through g")
                                                              (bool_and
                                                                (has_rec recs_via
                                                                  (utf8
                                                                    "REALIZE main.f supplied equations=main.f.realize_1 pending=main.f"))
                                                                (bool_and
                                                                  (has_rec recs_via
                                                                    (utf8 "PENDING main.f measure"))
                                                                  (bool_and
                                                                    (has_rec recs_via
                                                                      (utf8
                                                                        "REALIZE main.g supplied equations=main.g.realize_1 pending=main.f"))
                                                                    (bool_and
                                                                      (has_rec recs_via
                                                                        (utf8
                                                                          "REALIZE main.h supplied equations=main.h.realize_1 pending=main.f"))
                                                                      (bool_not
                                                                        (has_rec recs_via
                                                                          (utf8
                                                                            "PENDING main.g measure"))))))))
                                                            (Case
                                                              (utf8
                                                                "the implementation check's statuses are distinct kinds — a sig type by a type, a sig fn by the implementation's definition (DEFINE in the fork, no parameter admitted over it), a requirement pending")
                                                              (bool_and
                                                                (has_rec impl_pending
                                                                  (utf8 "DISCHARGE lib.Stack type"))
                                                                (bool_and
                                                                  (has_rec impl_pending
                                                                    (utf8
                                                                      "DISCHARGE lib.push defined"))
                                                                  (bool_and
                                                                    (has_rec impl_pending
                                                                      (utf8
                                                                        "IMPL DEFINE lib.push equations=lib.push.eq_1"))
                                                                    (bool_and
                                                                      (bool_not
                                                                        (has_rec impl_pending
                                                                          (utf8
                                                                            "IMPL PARAM lib.push fn")))
                                                                      (has_rec impl_pending
                                                                        (utf8
                                                                          "DISCHARGE lib.top_push pending")))))))
                                                            (Case
                                                              (utf8
                                                                "a file whose reading failed is loaded once: the second root's import reports import_failed, never duplicate_name")
                                                              (bool_and
                                                                (has_load_err retry
                                                                  (sym "import_failed"))
                                                                (bool_not
                                                                  (has_load_err retry
                                                                    (sym "duplicate_name")))))
                                                            (Case
                                                              (utf8
                                                                "basic: 10 declarations accepted in two modules (a.Tally with its casesOn, noConfusionType, noConfusion and succ.inj generated)")
                                                              (= (count_accepts basic) 10))
                                                            (Case
                                                              (utf8
                                                                "basic: a.two_rfl's record names its module and an empty axiom closure")
                                                              (has_rec basic
                                                                (utf8
                                                                  "ACCEPT a.two_rfl module=a hash=2080020097402181575 axioms= params= req=2080020097402181575.857639430829099676.0.58324888111")))
                                                            (Case
                                                              (utf8 "basic: main sees a and itself")
                                                              (has_rec basic
                                                                (utf8
                                                                  "MODULE main file=main.shard hash=273435378591199318 sees=a,main")))
                                                            (Case
                                                              (utf8
                                                                "origin-only: the root spelled from ./ gives the same declaration and module records")
                                                              (int_list_eq (accept_lines basic)
                                                                (accept_lines basic2)))
                                                            (Case
                                                              (utf8
                                                                "two modules: a.shard named again as a root is loaded once (no new module), three declarations accepted")
                                                              (= (count_accepts nested) 3))
                                                            (Case
                                                              (utf8
                                                                "the export's meta line off the pin: refused before any record")
                                                              (has_load_err pin
                                                                (sym "export_pin_mismatch")))
                                                            (Case
                                                              (utf8
                                                                "no export given: no file loads (init_unavailable)")
                                                              (has_load_err noinit
                                                                (sym "init_unavailable")))
                                                            (Case
                                                              (utf8
                                                                "visibility: b.Tally is in K's environment (one.shard imported b) but not in two.shard's closure")
                                                              (bool_and (= (count_accepts vis) 6)
                                                                (has_read_err vis
                                                                  (sym "unknown_constant"))))  ; b.Tally, its four generated declarations, one.z
                                                            (Case
                                                              (utf8
                                                                "sorry: citing the pending theorem is the obligation, never an assumption")
                                                              (has_read_err sorry
                                                                (sym "pending_obligation")))
                                                            (Case
                                                              (utf8
                                                                "a file outside the root is refused as such")
                                                              (has_load_err outside
                                                                (sym "outside_root")))
                                                            (Case
                                                              (utf8
                                                                "views: a consumer's import loads the view only — no discharge, no IMPL record")
                                                              (bool_and
                                                                (=
                                                                  (count_kind view (sym "discharge"))
                                                                  0)
                                                                (= (count_kind view (sym "impl")) 0)))
                                                            (Case
                                                              (utf8
                                                                "views: the consumer's theorem rests on the view's parameters, named on its record")
                                                              (has_rec view
                                                                (utf8
                                                                  "ACCEPT main.t module=main hash=990260074396937510 axioms=lib.stack_refl,lib.push,lib.Stack params=lib.stack_refl,lib.push,lib.Stack req=990260074396937510.1803183345620853871.552445165841731320.58324888111")))  ; req's last part: the export's identity, the view's module seeing Init
                                                            (Case
                                                              (utf8
                                                                "views: the directory as a root discharges every parameter — type, fn, fn, proved")
                                                              (= (count_kind impl (sym "discharge"))
                                                                4))
                                                            (Case
                                                              (utf8
                                                                "views: the implementation's own declarations are recorded under IMPL")
                                                              (< 0 (count_kind impl (sym "impl"))))
                                                            (Case
                                                              (utf8
                                                                "views: the fork's environment is not the consumer's — the view's parameters stay parameters after the check")
                                                              (has_rec impl
                                                                (utf8
                                                                  "PARAM lib.stack_refl requirement")))
                                                            (Case
                                                              (utf8
                                                                "ev: a consumer's fn over the view alone is stuck unlinked at the sig fn")
                                                              (match
                                                                (ev prog_view
                                                                  (main_fn (sym "fresh"))
                                                                  nil
                                                                  1000)
                                                                ((EvStuck r n)
                                                                 (bool_and
                                                                   (sym_eq r (sym "unlinked"))
                                                                   (int_list_eq (show_name n)
                                                                     (utf8 "lib.empty"))))
                                                                (_ false)))
                                                            (Case
                                                              (utf8
                                                                "ev: with the implementation checked, the same fn runs it — the substitution is the link")
                                                              (match
                                                                (ev prog_impl
                                                                  (main_fn (sym "fresh"))
                                                                  nil
                                                                  1000)
                                                                ((EvOk (VCtor c (cons (VInt 2) nil)))
                                                                 (int_list_eq (show_name c)
                                                                   (utf8 "lib.Stack.mk")))
                                                                (_ false)))
                                                            (Case
                                                              (utf8
                                                                "ev: an S program — match, let, if, the bare and naming-law primitives — runs (main RUNNABLE with the obstacle named: a numeral under a constructor has no form in the logic)")
                                                              (bool_and
                                                                (has_rec recs_basic
                                                                  (utf8
                                                                    "RUNNABLE fn main.main why=no_l_identity route=e_first"))
                                                                (match
                                                                  (ev prog_basic
                                                                    (main_fn (sym "main"))
                                                                    (list (VInt 1))
                                                                    1000)
                                                                  ((EvOk (VInt 3)) true)
                                                                  (_ false))))
                                                            (Case
                                                              (utf8
                                                                "realize: List.append's equations are ACCEPT records, the realization a REALIZE record")
                                                              (bool_and
                                                                (has_rec recs_rz
                                                                  (utf8
                                                                    "REALIZE List.append supplied equations=main.List.append.realize_1,main.List.append.realize_2"))
                                                                (< 0
                                                                  (count_named recs_rz
                                                                    (utf8
                                                                      "main.List.append.realize_2")))))
                                                            (Case
                                                              (utf8
                                                                "realize: the realized List.append runs under its L identity — twice [1] = [1, 1]")
                                                              (match
                                                                (ev prog_rz (main_fn (sym "twice"))
                                                                  (list (nat_list (list 1)))
                                                                  1000)
                                                                ((EvOk v)
                                                                 (int_list_eq (show_nat_list v)
                                                                   (utf8 "1 1")))
                                                                (_ false)))
                                                            (Case
                                                              (utf8
                                                                "the same body as a fn is DEFINE with its equation, as a realize it is REALIZE with an equation a theorem cites")
                                                              (bool_and
                                                                (has_rec recs_nat
                                                                  (utf8
                                                                    "DEFINE main.four equations=main.four.eq_1"))
                                                                (bool_and
                                                                  (has_rec recs_nat
                                                                    (utf8
                                                                      "REALIZE main.twice supplied equations=main.twice.realize_1"))
                                                                  (bool_and
                                                                    (< 0
                                                                      (count_named recs_nat
                                                                        (utf8 "main.twice.realize_1")))
                                                                    (match
                                                                      (ev prog_nat
                                                                        (main_fn (sym "four"))
                                                                        nil
                                                                        1000)
                                                                      ((EvOk (VInt 4)) true)
                                                                      (_ false)))))))
                                                          w18))))))))))))))))))))))))))))))))))))))

(fn main ((w World)) World
  (match (cases w)
    ((Prod.mk cs w1) (run_cases (utf8 "loader_test") cs 0 w1))))
