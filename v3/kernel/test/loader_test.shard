;;; v3/kernel/test/loader_test.shard — the loader's cases beyond the pins
;;; (loader_pins_test): what the records say, nested Init prefixes, the
;;; export pin, visibility across root files, the sorry obligation, the
;;; root's location changing nothing (T8's origin-only invariance); the
;;; program a load yields, run under `ev` (slice 5): a consumer's fn over the
;;; view alone is stuck at the sig fn, with the implementation it runs it.
;;; The helpers are loader_kit.shard's.

(import "loader_kit.shard")
(import "case_kit.shard")
(use kernel.ev)
(use kernel.host)
(use kernel.loader)
(use kernel.prelude)
(use kernel.test.loader_kit)
(use kernel.util)
(use kernel.host.World)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Pair)
(use kernel.prog.EvRes)
(use kernel.prog.Val)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)



(fn cases ((w World)) (Pair (List Case) World)
  (match (load_case "v3/pins/loader/basic" Nil (list "v3/pins/loader/basic/main.shard") w)
    ((Pair basic w1)
     (match (load_case "./v3/pins/loader/basic" Nil (list "./v3/pins/loader/basic/main.shard") w1)
       ((Pair basic2 w2)
        (match (load_case "v3/pins/loader/init_nested" (list (fixture)) (list "v3/pins/loader/init_nested/main.shard" "v3/pins/loader/init_nested/a.shard") w2)
          ((Pair nested w3)
           (match (load_case "v3/pins/loader/init" (list (wrong_pin)) (list "v3/pins/loader/init/main.shard") w3)
             ((Pair pin w4)
              (match (load_case "v3/pins/loader/visible" Nil (list "v3/pins/loader/visible/one.shard" "v3/pins/loader/visible/two.shard") w4)
                ((Pair vis w5)
                 (match (load_case "v3/pins/loader/sorry" Nil (list "v3/pins/loader/sorry/main.shard") w5)
                   ((Pair sorry w6)
                    (match (load_case "v3/pins/loader/init" Nil (list "v3/pins/loader/init/main.shard") w6)
                      ((Pair noinit w7)
                       (match (load_case "v3/pins/loader/basic" Nil (list "v3/pins/loader/outside/main.shard") w7)
                         ((Pair outside w8)
                          (match (load_case "v3/pins/loader/view_basic" (list (fixture)) (list "v3/pins/loader/view_basic/main.shard") w8)
                            ((Pair view w9)
                             (match (load_case "v3/pins/loader/view_basic" (list (fixture)) (list "v3/pins/loader/view_basic/lib") w9)
                               ((Pair impl w10)
                             (match (load_prog "v3/pins/loader/view_basic" (list (fixture)) (list "v3/pins/loader/view_basic/main.shard") w10)
                               ((Pair (Pair prog_view _) w11)
                             (match (load_prog "v3/pins/loader/view_basic" (list (fixture)) (list "v3/pins/loader/view_basic/main.shard" "v3/pins/loader/view_basic/lib") w11)
                               ((Pair (Pair prog_impl _) w12)
                             (match (load_prog "v3/pins/loader/ev_basic" (list (fixture)) (list "v3/pins/loader/ev_basic/main.shard") w12)
                               ((Pair (Pair prog_basic recs_basic) w13)
                             (match (load_prog "v3/pins/loader/realize_supplied" (list (fixture)) (list "v3/pins/loader/realize_supplied/main.shard") w13)
                               ((Pair (Pair prog_rz recs_rz) w14)
                             (match (load_prog "v3/pins/loader/realize_native" (list (fixture)) (list "v3/pins/loader/realize_native/main.shard") w14)
                               ((Pair (Pair prog_nat recs_nat) w15)
                             (match (load_case "v3/pins/loader/retry" (list (fixture)) (list "v3/pins/loader/retry/main.shard" "v3/pins/loader/retry/b.shard") w15)
                               ((Pair retry w16)
                             (match (load_prog "v3/pins/loader/realize_pending_via" (list (fixture)) (list "v3/pins/loader/realize_pending_via/main.shard") w16)
                               ((Pair (Pair _ recs_via) w17)
                             (match (load_case "v3/pins/loader/view_pending" (list (fixture)) (list "v3/pins/loader/view_pending/lib") w17)
                               ((Pair impl_pending w18)
                          (Pair
                            (list
                              (Case "R58 (slice 10): a pending measure is recorded once and every realization reaching it names it — f's own, g through f, h through g"
                                (bool_and (has_rec recs_via "REALIZE main.f supplied equations=main.f.realize_1 pending=main.f")
                                  (bool_and (has_rec recs_via "PENDING main.f measure")
                                    (bool_and (has_rec recs_via "REALIZE main.g supplied equations=main.g.realize_1 pending=main.f")
                                      (bool_and (has_rec recs_via "REALIZE main.h supplied equations=main.h.realize_1 pending=main.f")
                                        (bool_not (has_rec recs_via "PENDING main.g measure")))))))
                              (Case "R57 (slice 10): the implementation check's statuses are distinct kinds — a sig type by a type, a sig fn by an E fn (still a parameter in the fork), a requirement pending"
                                (bool_and (has_rec impl_pending "DISCHARGE lib.Stack type")
                                  (bool_and (has_rec impl_pending "DISCHARGE lib.push fn")
                                    (bool_and (has_rec impl_pending "IMPL PARAM lib.push fn")
                                      (has_rec impl_pending "DISCHARGE lib.top_push pending")))))
                              (Case "a file whose reading failed is loaded once: the second root's import reports import_failed, never duplicate_name (slice 6)"
                                (bool_and (has_load_err retry (quote import_failed)) (bool_not (has_load_err retry (quote duplicate_name)))))
                              (Case "basic: 7 declarations accepted in two modules" (int_eq (count_accepts basic) 7))
                              (Case "basic: a.two_rfl's record names its module and an empty axiom closure"
                                (has_rec basic "ACCEPT a.two_rfl module=a hash=1718361179517844046 axioms= init=- params="))
                              (Case "basic: main sees a and itself" (has_rec basic "MODULE main file=main.shard hash=119538086569699698 sees=a,main"))
                              (Case "T8 origin-only: the root spelled from ./ gives the same declaration and module records"
                                (int_list_eq (accept_lines basic) (accept_lines basic2)))
                              (Case "nested Init prefixes: a's load through Nat, then main's through Bool, on from where a stopped"
                                (bool_and (int_eq (len (inits nested)) 2) (lt (first (inits nested)) (second (inits nested)))))
                              (Case "nested Init prefixes: a.shard named again is loaded once (no new module, no new Init load)"
                                (int_eq (count_accepts nested) 3))
                              (Case "the export's meta line off the pin: refused before any record" (has_load_err pin (quote export_pin_mismatch)))
                              (Case "no chunks given: (import Init …) is init_unavailable" (has_load_err noinit (quote init_unavailable)))
                              (Case "visibility: b.Nat is in K's environment (one.shard imported b) but not in two.shard's closure"
                                (bool_and (int_eq (count_accepts vis) 2) (has_read_err vis (quote unknown_constant))))
                              (Case "sorry: citing the pending theorem is the obligation, never an assumption" (has_read_err sorry (quote pending_obligation)))
                              (Case "a file outside the root is refused as such" (has_load_err outside (quote outside_root)))
                              (Case "views: a consumer's import loads the view only — no discharge, no IMPL record" (bool_and (int_eq (count_kind view (quote discharge)) 0) (int_eq (count_kind view (quote impl)) 0)))
                              (Case "views: the consumer's theorem rests on the view's parameters, named on its record"
                                (has_rec view "ACCEPT main.t module=main hash=990260074396937510 axioms=lib.stack_refl,lib.push,lib.Stack init=Eq params=lib.stack_refl,lib.push,lib.Stack"))
                              (Case "views: the directory as a root discharges every parameter — type, fn, fn, proved" (int_eq (count_kind impl (quote discharge)) 4))
                              (Case "views: the implementation's own declarations are recorded under IMPL" (lt 0 (count_kind impl (quote impl))))
                              (Case "views: the fork's environment is not the consumer's — the view's parameters stay parameters after the check"
                                (has_rec impl "PARAM lib.stack_refl requirement"))
                              (Case "ev: a consumer's fn over the view alone is stuck unlinked at the sig fn"
                                (match (ev prog_view (main_fn (quote fresh)) Nil 1000)
                                  ((EvStuck r n) (bool_and (sym_eq r (quote unlinked)) (int_list_eq (show_name n) "lib.empty")))
                                  (_ False)))
                              (Case "ev: with the implementation checked, the same fn runs it — the substitution is the link (T5)"
                                (match (ev prog_impl (main_fn (quote fresh)) Nil 1000)
                                  ((EvOk (VCtor c (Cons (VInt 2) Nil))) (int_list_eq (show_name c) "lib.Stack.mk"))
                                  (_ False)))
                              (Case "ev: an S program — match, let, if, the bare and naming-law primitives — runs (R45: RUNNABLE, no L meaning)"
                                (bool_and (has_rec recs_basic "RUNNABLE fn main.main")
                                  (match (ev prog_basic (main_fn (quote main)) (list (VInt 1)) 1000) ((EvOk (VInt 3)) True) (_ False))))
                              (Case "realize (§7.5): List.append's equations are ACCEPT records, the realization a REALIZE record"
                                (bool_and (has_rec recs_rz "REALIZE List.append supplied equations=main.List.append.realize_1,main.List.append.realize_2")
                                  (lt 0 (count_named recs_rz "main.List.append.realize_2"))))
                              (Case "realize: the realized List.append runs under its L identity — twice [1] = [1, 1]"
                                (match (ev prog_rz (main_fn (quote twice)) (list (nat_list (list 1))) 1000)
                                  ((EvOk v) (int_list_eq (show_nat_list v) "1 1"))
                                  (_ False)))
                              (Case "R45's third test: the same body as a fn is RUNNABLE with no L meaning, as a realize it is REALIZE with an equation a theorem cites"
                                (bool_and (has_rec recs_nat "RUNNABLE fn main.four")
                                  (bool_and (has_rec recs_nat "REALIZE main.twice supplied equations=main.twice.realize_1")
                                    (bool_and (lt 0 (count_named recs_nat "main.twice.realize_1"))
                                      (match (ev prog_nat (main_fn (quote four)) Nil 1000) ((EvOk (VInt 4)) True) (_ False)))))))
                            w18))))))))))))))))))))))))))))))))))))))

(fn main ((w World)) World (match (cases w) ((Pair cs w1) (run_cases "loader_test" cs 0 w1))))
