;;; v3/kernel/test/level_test.shard — universe levels (level.shard).
;;; Run: ./rust_bootstrap/target/release/eval direct v3/kernel/test/level_test.shard
;;; (v3/test.sh runs every test entrypoint). Exit code = number of failures.

(import "../host.shard")
(import "../level.shard")
(import "case_kit.shard")
(import "decls_kit.shard")
(use Init.Bool false true)
(use Init.Option none some)
(use kernel.host)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.level.Level)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn v () Level (LParam (n1 (sym "v"))))
(fn one () Level (LSucc LZero))
(fn two () Level (LSucc (LSucc LZero)))

(fn cases () (List Case)
  (list (Case (utf8 "normalize (max u 0) = u") (level_eq (normalize (LMax (u) LZero)) (u)))
    (Case (utf8 "equiv (max u v) (max v u)") (is_equivalent (LMax (u) (v)) (LMax (v) (u))))
    (Case (utf8 "equiv (succ (max u v)) (max (succ u) (succ v))")
      (is_equivalent (LSucc (LMax (u) (v))) (LMax (LSucc (u)) (LSucc (v)))))
    (Case (utf8 "normalize (imax u 0) = 0") (is_zero (normalize (LIMax (u) LZero))))
    ;; a universe metavariable is an atom to every rule, as level.cpp's mvar is
    (Case (utf8 "?u is an atom: normalize (max ?u ?u) = ?u")
      (level_eq (normalize (LMax (LMVar 1) (LMVar 1))) (LMVar 1)))
    (Case (utf8 "?u1 and ?u2 are not equivalent") (bool_not (is_equivalent (LMVar 1) (LMVar 2))))
    (Case (utf8 "equiv (max ?u v) (max v ?u)")
      (is_equivalent (LMax (LMVar 1) (v)) (LMax (v) (LMVar 1))))
    (Case (utf8 "?u has no parameter and is not a proposition")
      (bool_and (bool_not (level_has_param (LMVar 1))) (bool_not (normalizes_to_zero (LMVar 1)))))
    ;; EXACTNESS: the pin's normalize does not re-sort after mk_imax
    ;; (level.cpp l. 462 returns mk_succ(mk_imax(l1,l2),k) as is), so
    ;; (imax u 1) normalizes to (max u 1) while (max u 1) normalizes to
    ;; (max 1 u); Lean's is_equivalent is incomplete here and K agrees.
    (Case (utf8 "pin: not equiv (imax u 1) (max u 1)")
      (bool_not (is_equivalent (LIMax (u) (one)) (LMax (u) (one)))))
    (Case (utf8 "pin: normalize (imax u 1) = (max u 1) structurally")
      (level_eq (normalize (LIMax (u) (one))) (LMax (u) (one))))
    (Case (utf8 "pin: normalize (max u 1) = (max 1 u) structurally")
      (level_eq (normalize (LMax (u) (one))) (LMax (one) (u))))
    (Case (utf8 "normalize (imax 1 u) = u") (level_eq (normalize (LIMax (one) (u))) (u)))
    (Case (utf8 "not equiv u (succ u)") (bool_not (is_equivalent (u) (LSucc (u)))))
    (Case (utf8 "not equiv (max u v) u") (bool_not (is_equivalent (LMax (u) (v)) (u))))
    (Case (utf8 "normalize (max u u) = u") (level_eq (normalize (LMax (u) (u))) (u)))
    (Case (utf8 "normalize (max u (succ u)) = succ u")
      (level_eq (normalize (LMax (u) (LSucc (u)))) (LSucc (u))))
    (Case (utf8 "normalize (max 1 u) keeps 1")
      (is_equivalent (normalize (LMax (one) (u))) (LMax (one) (u))))
    (Case (utf8 "normalize (max 1 (succ u)) drops 1")
      (level_eq (normalize (LMax (one) (LSucc (u)))) (LSucc (u))))
    (Case (utf8 "normalize (max 2 1) = 2") (level_eq (normalize (LMax (two) (one))) (two)))
    (Case (utf8 "geq (max u v) u") (is_geq (LMax (u) (v)) (u)))
    (Case (utf8 "geq (succ u) u") (is_geq (LSucc (u)) (u)))
    (Case (utf8 "not geq u (succ u)") (bool_not (is_geq (u) (LSucc (u)))))
    (Case (utf8 "geq u 0") (is_geq (u) LZero))
    (Case (utf8 "not geq 0 u") (bool_not (is_geq LZero (u))))
    (Case (utf8 "geq (imax u v) v") (is_geq (LIMax (u) (v)) (v)))
    (Case (utf8 "geq (max (succ u) v) (max u v)") (is_geq (LMax (LSucc (u)) (v)) (LMax (u) (v))))
    (Case (utf8 "not geq (max u v) (succ u)") (bool_not (is_geq (LMax (u) (v)) (LSucc (u)))))
    (Case (utf8 "is_not_zero (succ u)") (is_not_zero (LSucc (u))))
    (Case (utf8 "not is_not_zero (max u 0)") (bool_not (is_not_zero (LMax (u) LZero))))
    (Case (utf8 "normalizes_to_zero (imax 1 0)") (normalizes_to_zero (LIMax (one) LZero)))
    (Case (utf8 "not normalizes_to_zero (imax 0 u)")
      (bool_not (normalizes_to_zero (LIMax LZero (u)))))
    (Case (utf8 "inst u:=1 in (max u v)")
      (level_eq (level_inst (LMax (u) (v)) (list (n1 (sym "u"))) (list (one))) (LMax (one) (v))))
    (Case (utf8 "inst collapses (imax u v) with v:=1")
      (level_eq (level_inst (LIMax (u) (v)) (list (n1 (sym "v"))) (list (one))) (LMax (u) (one))))
    (Case (utf8 "undef_param finds w")
      (match (undef_param (LMax (u) (LParam (n1 (sym "w")))) (list (n1 (sym "u")) (n1 (sym "v"))))
        ((some n) (name_eq n (n1 (sym "w"))))
        (none false)))
    (Case (utf8 "undef_param none")
      (match (undef_param (LMax (u) (v)) (list (n1 (sym "u")) (n1 (sym "v"))))
        (none true)
        (_ false)))
    (Case (utf8 "show (max u 1)") (int_list_eq (show_level (LMax (u) (one))) (utf8 "(max u 1)")))
    (Case (utf8 "depth explicit 2") (= (level_depth (two)) 2))
    (Case (utf8 "mk_max 1 2 = 2") (level_eq (mk_max (one) (two)) (two)))
    (Case (utf8 "mk_max u (max u v) = max u v")
      (level_eq (mk_max (u) (LMax (u) (v))) (LMax (u) (v))))))


(fn main ((w World)) World (run_cases (utf8 "level_test") (cases) 0 w))
