;;; v3/kernel/test/matcher_test.shard — a matcher's type is its description:
;;; mt_is_matcher reads the rows back off an admitted
;;; constant's type, regenerates the definition and compares — the generated matchers of the
;;; pins are recognized with their rows, an ordinary definition and an imposter of the right
;;; type are not.
;;; Run: ./rust_bootstrap/target/release/eval direct v3/kernel/test/matcher_test.shard
;;; Exit code = number of failures.

(import Init)
(import "loader_kit.shard")
(import "case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.host)
(use kernel.loader)
(use kernel.matcher)
(use kernel.name)
(use kernel.test.loader_kit)
(use kernel.util)
(use kernel.host.World)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtPat)
(use kernel.name.Name)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)

(fn env_after ((root (List Int)) (w World)) (Prod CheckedEnv World)
  (match (parts_of root)
    (none (Prod.mk (env_empty) w))
    ((some rootp)
     (match (load_all (kit_load0 rootp true) (list (append root "/main.shard")) w)
       ((Prod.mk l w1) (Prod.mk (Load.env l) w1))))))
(fn nm3 ((a Symbol) (b Symbol) (c Symbol)) Name (Str (Str (Str Anon a) b) c))
;; nparams, nscrutinees, rows of a recognized matcher; (-1 -1 -1) otherwise
(fn shape ((d (Option MtDesc))) (List Int)
  (match d
    ((some (MtDesc np nd rows)) (list np nd (len rows)))
    (none (list -1 -1 -1))))
(fn is_none ((d (Option MtDesc))) Bool
  (match d
    (none true)
    ((some _) false)))
;; the first row's one pattern is a constructor pattern with this many sub-patterns
(fn row_ctor_arity ((d (Option MtDesc)) (i Int)) Int
  (match d
    ((some (MtDesc _ _ rows))
     (match (nth rows i)
       ((some (cons (MtCtor _ subs) nil)) (len subs))
       ((some (cons (MtVar _) nil)) -1)
       (_ -2)))
    (none -3)))

(fn cases ((w World)) (Prod (List Case) World)
  (match (env_after "v3/pins/loader/match_def" w)
    ((Prod.mk env w1)
     (match (env_after "v3/pins/loader/match_poly" w1)
       ((Prod.mk penv w2)
        (match (env_after "v3/pins/loader/match_imposter" w2)
          ((Prod.mk ienv w3)
           (Prod.mk
             (list
               (Case "flush's matcher: no parameters, one scrutinee, two rows"
                 (int_list_eq
                   (shape (mt_is_matcher env (nm3 (quote main) (quote flush) (quote match_1))))
                   (list 0 1 2)))
               (Case "parse1's matcher: four rows, as written"
                 (int_list_eq
                   (shape (mt_is_matcher env (nm3 (quote main) (quote parse1) (quote match_1))))
                   (list 0 1 4)))
               (Case "parse1's second row is cons on two sub-patterns"
                 (=
                   (row_ctor_arity
                     (mt_is_matcher env (nm3 (quote main) (quote parse1) (quote match_1)))
                     1)
                   2))
               (Case "parse1's last row is the variable row"
                 (=
                   (row_ctor_arity
                     (mt_is_matcher env (nm3 (quote main) (quote parse1) (quote match_1)))
                     3)
                   -1))
               (Case "an ordinary definition is no matcher"
                 (is_none (mt_is_matcher env (Str (Str Anon (quote main)) (quote flush)))))
               (Case "a recursor's casesOn is no matcher"
                 (is_none (mt_is_matcher env (Str (Str Anon (quote List)) (quote casesOn)))))
               (Case "head_or's matcher has the type parameter as its one parameter"
                 (int_list_eq
                   (shape (mt_is_matcher penv (nm3 (quote main) (quote head_or) (quote match_1))))
                   (list 1 1 2)))
               (Case "a hand-written matcher that is the generated one is a matcher"
                 (int_list_eq
                   (shape (mt_is_matcher ienv (nm3 (quote main) (quote pick) (quote match_1))))
                   (list 0 1 2)))
               (Case "an imposter of a matcher's type and name is none"
                 (is_none (mt_is_matcher ienv (nm3 (quote main) (quote fake) (quote match_1))))))
             w3))))))))

(fn main ((w World)) World
  (match (cases w)
    ((Prod.mk cs w1) (run_cases "matcher_test" cs 0 w1))))
