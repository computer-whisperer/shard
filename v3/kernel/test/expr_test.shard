;;; v3/kernel/test/expr_test.shard — term utilities: instantiate, abstract,
;;; lift, spines, level instantiation, cheap beta; and the node data
;;; (hash, range, flags, identity) of the annotated representation.

(import "../host.shard")
(import "../expr.shard")
(import "case_kit.shard")
(import "decls_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.expr)
(use kernel.host)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.St)
(use kernel.host.World)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn nat_c () Expr (mk_const (n1 (sym "Nat")) nil))
(fn x_n () Name (n1 (sym "x")))
;; fun (x : Nat) => fun (y : Nat) => x   ==  Lam x Nat (Lam y Nat #1)
(fn k_fn () Expr
  (mk_lam (x_n) BDefault (nat_c) (mk_lam (n1 (sym "y")) BDefault (nat_c) (mk_bvar 1))))
;; the utilities threaded in anonymous mode
(fn sa () St (st_anon))
;; identified nodes are minted from a fresh counter
(fn st1 () St (st_init))

;; mix (name.shard) against its formula written whole, the modulus spelled here: over the range
;; its pieces cover and at that range's ends, on the two sides of each split (2^31 in a; 2^30
;; in a's upper part times the multiplier, crossed between 1073·2^31 and 1074·2^31), outside
;; the range (a negative, a from 2^61 up: the whole formula's own branch), with b small, at the
;; modulus, past 64 and 128 bits and negative; and along a walk of hashes
(fn mix_ref ((a Int) (b Int)) Int (mod (+ (* a 1000003) (+ b 1)) 2305843009213693951))
(fn two64 () Int (* 4294967296 4294967296))  ; past the bootstrap reader's literals
(fn mix_agrees ((xs (List Int)) (bs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons a r) (if (mix_agrees_at a bs) (mix_agrees r bs) false))))
(fn mix_agrees_at ((a Int) (bs (List Int))) Bool
  (measure (struct bs))
  (match bs
    (nil true)
    ((cons b r) (if (= (mix a b) (mix_ref a b)) (mix_agrees_at a r) false))))
(fn mix_walk ((x Int) (n Int)) Bool
  (measure n)
  (if (< n 1) true
  (if (= (mix x n) (mix_ref x n)) (mix_walk (mix x n) (- n 1))
  false)))

;; a name's hash from a prefix's hash and the name's components (name.shard `hash_under`):
;; `kernel.loader` above `a.12.b`, written out as one name beside
(fn pre_n () Name (Str (Str Anon (sym "kernel")) (sym "loader")))
(fn tail_n () Name (Str (Num (Str Anon (sym "a")) 12) (sym "b")))
(fn whole_n () Name (Str (Num (Str (pre_n) (sym "a")) 12) (sym "b")))

;; ---- two graphs of one structure ---------------------------------------------------------
;; two values, then each next the application of the two before it: n + 2 nodes whose tree has
;; about 1.6^n — what a chain of lets whose values are each used twice unfolds to. The nodes are
;; identified, so a chain built again from a later state is the same structure under other ids
(fn chain_from ((st St) (a Expr) (b Expr) (n Int)) (Prod St Expr)
  (measure n)
  (if (< n 1) (Prod.mk st b)
  (match (new_app st b a)
    ((Prod.mk s2 c) (chain_from s2 b c (- n 1))))))
;; two chains of n steps, built one after the other, over the first values (lit x) and (lit y)
(fn chains_eq ((x Int) (y Int) (n Int)) Bool
  (match (chain_from (st1) (lit x) (lit 1) n)
    ((Prod.mk st a)
     (match (chain_from st (lit y) (lit 1) n)
       ((Prod.mk _ b) (expr_eq a b))))))
;; two equal chains, each applied to one more value: (lit x) on the one, (lit y) on the other —
;; the difference stands after every pair of the chains has been found equal
(fn chains_then ((n Int) (x Int) (y Int)) Bool
  (match (chain_from (st1) (lit 0) (lit 1) n)
    ((Prod.mk st a)
     (match (chain_from st (lit 0) (lit 1) n)
       ((Prod.mk _ b) (expr_eq (mk_app a (lit x)) (mk_app b (lit y))))))))

(fn cases () (List Case)
  (list (Case (utf8 "range closed") (= (loose_bvar_range (k_fn)) 0))
    (Case (utf8 "range #2 under one binder")
      (= (loose_bvar_range (mk_lam (x_n) BDefault (nat_c) (mk_bvar 2))) 2))
    (Case (utf8 "instantiate1 #0")
      (expr_eq (val (instantiate1 (sa) (mk_app (mk_bvar 0) (mk_bvar 1)) (lit 7)))
        (mk_app (lit 7) (mk_bvar 0))))
    (Case (utf8 "instantiate1 under binder lifts")
      (expr_eq
        (val
          (instantiate1 (sa) (mk_lam (x_n) BDefault (nat_c) (mk_app (mk_bvar 1) (mk_bvar 0)))
            (mk_bvar 0)))
        (mk_lam (x_n) BDefault (nat_c) (mk_app (mk_bvar 1) (mk_bvar 0)))))
    (Case (utf8 "instantiate1 under binder substitutes a closed term")
      (expr_eq
        (val
          (instantiate1 (sa) (mk_lam (x_n) BDefault (nat_c) (mk_app (mk_bvar 1) (mk_bvar 0)))
            (lit 3)))
        (mk_lam (x_n) BDefault (nat_c) (mk_app (lit 3) (mk_bvar 0)))))
    (Case (utf8 "instantiate_rev order: last replaces #0")
      (expr_eq (val (instantiate_rev (sa) (mk_app (mk_bvar 0) (mk_bvar 1)) (list (lit 1) (lit 2))))
        (mk_app (lit 2) (lit 1))))
    (Case (utf8 "abstract fvars in binder order")
      (expr_eq (val (abstract_fvars (sa) (mk_app (mk_fvar 10) (mk_fvar 11)) (list 10 11)))
        (mk_app (mk_bvar 1) (mk_bvar 0))))
    (Case (utf8 "abstract under a binder offsets")
      (expr_eq (val (abstract_fvars (sa) (mk_lam (x_n) BDefault (nat_c) (mk_fvar 10)) (list 10)))
        (mk_lam (x_n) BDefault (nat_c) (mk_bvar 1))))
    (Case (utf8 "abstract then instantiate_rev is identity")
      (let
        ((e (mk_app (mk_app (mk_fvar 3) (mk_fvar 4)) (mk_lam (x_n) BDefault (nat_c) (mk_fvar 3)))))
        (expr_eq
          (val
            (instantiate_rev (sa) (val (abstract_fvars (sa) e (list 3 4)))
              (list (mk_fvar 3) (mk_fvar 4))))
          e)))
    (Case (utf8 "lift ≥ 1 by 2")
      (expr_eq (val (lift_loose_bvars (sa) (mk_app (mk_bvar 0) (mk_bvar 1)) 1 2))
        (mk_app (mk_bvar 0) (mk_bvar 3))))
    (Case (utf8 "lower")
      (expr_eq (val (lower_loose_bvars (sa) (mk_app (mk_bvar 0) (mk_bvar 3)) 1 2))
        (mk_app (mk_bvar 0) (mk_bvar 1))))
    (Case (utf8 "has_loose_bvar 1 under binder")
      (has_loose_bvar (mk_lam (x_n) BDefault (nat_c) (mk_bvar 2)) 1))
    (Case (utf8 "has_loose_bvar prunes by range")
      (bool_not (has_loose_bvar (mk_app (mk_bvar 0) (mk_bvar 1)) 2)))
    (Case (utf8 "get_app_fn / args")
      (let ((e (mk_app (mk_app (nat_c) (lit 1)) (lit 2))))
        (bool_and (expr_eq (get_app_fn e) (nat_c))
          (exprs_eq (get_app_args e) (list (lit 1) (lit 2))))))
    (Case (utf8 "mk_app_list roundtrip")
      (let ((e (mk_app (mk_app (nat_c) (lit 1)) (lit 2))))
        (expr_eq (val (mk_app_list (sa) (get_app_fn e) (get_app_args e))) e)))
    (Case (utf8 "num args") (= (get_app_num_args (mk_app (mk_app (nat_c) (lit 1)) (lit 2))) 2))
    (Case (utf8 "inst lparams in Sort and Const")
      (expr_eq
        (val
          (expr_inst_lparams (sa) (mk_app (mk_sort (u)) (mk_const (n1 (sym "c")) (list (u))))
            (list (n1 (sym "u")))
            (list LZero)))
        (mk_app (mk_sort LZero) (mk_const (n1 (sym "c")) (list LZero)))))
    (Case (utf8 "cheap beta: closed body drops args")
      (expr_eq
        (val (cheap_beta_reduce (sa) (mk_app (mk_lam (x_n) BDefault (nat_c) (lit 5)) (lit 9))))
        (lit 5)))
    (Case (utf8 "cheap beta: bvar body selects arg")
      (expr_eq (val (cheap_beta_reduce (sa) (mk_app (mk_app (k_fn) (lit 1)) (lit 2)))) (lit 1)))
    (Case (utf8 "cheap beta: partial application untouched")
      (let ((e (mk_app (k_fn) (lit 1)))) (expr_eq (val (cheap_beta_reduce (sa) e)) e)))
    (Case (utf8 "cheap beta: extra args kept")
      (expr_eq
        (val
          (cheap_beta_reduce (sa)
            (mk_app (mk_app (mk_lam (x_n) BDefault (nat_c) (mk_bvar 0)) (nat_c)) (lit 4))))
        (mk_app (nat_c) (lit 4))))
    (Case (utf8 "beta_head: two lambdas, two args")
      (expr_eq (val (beta_head (sa) (k_fn) (list (lit 1) (lit 2)))) (lit 1)))
    (Case (utf8 "beta_head: one lambda, two args keeps the second")
      (expr_eq
        (val (beta_head (sa) (mk_lam (x_n) BDefault (nat_c) (mk_bvar 0)) (list (nat_c) (lit 4))))
        (mk_app (nat_c) (lit 4))))
    (Case (utf8 "beta_head: dependent body substitution")
      (expr_eq
        (val
          (beta_head (sa)
            (mk_lam (x_n) BDefault (nat_c) (mk_lam (n1 (sym "y")) BDefault (mk_bvar 0) (mk_bvar 1)))
            (list (lit 8))))
        (mk_lam (n1 (sym "y")) BDefault (lit 8) (lit 8))))
    (Case (utf8 "expr_eq ignores binder names")
      (expr_eq (mk_lam (x_n) BDefault (nat_c) (mk_bvar 0))
        (mk_lam (n1 (sym "z")) BImplicit (nat_c) (mk_bvar 0))))
    (Case (utf8 "show") (int_list_eq (show_expr (mk_app (nat_c) (lit 3))) (utf8 "(Nat 3)")))
    ;; the node data
    (Case (utf8 "flags: fvar and lparam")
      (let ((e (mk_app (mk_fvar 1) (mk_sort (u)))))
        (bool_and (has_fvar e)
          (bool_and (has_lparam e)
            (bool_and (bool_not (has_fvar (nat_c))) (bool_not (has_lparam (nat_c))))))))
    (Case (utf8 "anonymous mode mints no ids")
      (= (expr_id (val (instantiate1 (sa) (mk_app (mk_bvar 0) (nat_c)) (lit 1)))) 0))
    (Case (utf8 "identified nodes carry ids from 1")
      (match (new_app (st1) (nat_c) (lit 2))
        ((Prod.mk _ e) (= (expr_id e) 1))))
    (Case (utf8 "identified vs anonymous twin: equal, same hash")
      (match (new_app (st1) (nat_c) (lit 2))
        ((Prod.mk _ e)
         (bool_and (expr_eq e (mk_app (nat_c) (lit 2)))
           (= (hash_expr e) (hash_expr (mk_app (nat_c) (lit 2))))))))
    (Case (utf8 "hash unchanged by identity and by binder names")
      (match (new_lam (st1) (n1 (sym "q")) BImplicit (nat_c) (mk_bvar 0))
        ((Prod.mk _ e) (= (hash_expr e) (hash_expr (mk_lam (x_n) BDefault (nat_c) (mk_bvar 0)))))))
    (Case (utf8 "mix: a small value is the formula unreduced") (= (mix 41 7) 41000131))
    (Case (utf8 "mix: at M - 1 the product wraps to M + 1 - 1000003")
      (= (mix 2305843009213693950 0) 2305843009212693949))
    (Case
      (utf8
        "mix is its formula: the pieces' range and its ends, each split's two sides, outside the range")
      (mix_agrees
        (list 0 1 61 2147483647 2147483648 2147483649 2304249954304 2306397437952
          1152921504606846975
          1234567890123456789
          2305843009213693950
          2305843009213693951
          2305843009213693952
          2305843009213693953
          4611686018427387904
          (two64)
          -1
          -1000003)
        (list 0 1 255 2305843009213693950 2305843009213693951 2305843009213693952 (two64)
          (* (two64) (two64))
          -1
          -2305843009213693952)))
    (Case (utf8 "mix is its formula along a walk of 2000 hashes") (mix_walk 41 2000))
    (Case (utf8 "a name's hash is its prefix's hash folded over its components")
      (bool_and
        (= (hash_name (whole_n)) (hash_under (hash_name (pre_n)) (comp_hashes (tail_n) nil)))
        (bool_and
          (= (name_key (whole_n)) (key_under (hash_name (pre_n)) (comp_hashes (tail_n) nil)))
          (bool_and
            (= (hash_name (tail_n)) (hash_under (hash_name Anon) (comp_hashes (tail_n) nil)))
            (= (hash_name (pre_n)) (hash_under (hash_name (pre_n)) (comp_hashes Anon nil)))))))
    (Case (utf8 "instantiate keeps a closed subterm's identity")
      (match (new_app (st1) (nat_c) (lit 1))
        ((Prod.mk st c)
         (match (instantiate1 st (mk_app (mk_bvar 0) c) (lit 1))
           ((Prod.mk _ r)
            (match r
              ((App _ _ c1) (same_node c c1))
              (_ false)))))))
    (Case (utf8 "abstract keeps an untouched node's identity")
      (match (new_app (st1) (mk_fvar 7) (nat_c))
        ((Prod.mk st e)
         (match (abstract_fvars st e (list 8))
           ((Prod.mk _ e1) (same_node e e1))))))
    (Case (utf8 "abstract rebuilds a touched node")
      (match (new_app (st1) (mk_fvar 7) (nat_c))
        ((Prod.mk st e)
         (match (abstract_fvars st e (list 7))
           ((Prod.mk _ e1)
            (bool_and (bool_not (same_node e e1)) (expr_eq e1 (mk_app (mk_bvar 0) (nat_c)))))))))
    ;; expr_eq on graphs (expr.shard: the tree walk under its budget, then the walk that notes
    ;; the pairs found equal). The unequal cases differ in one literal, the hash's modulus
    ;; apart, so every node of the two bears one hash and no answer is the hash's
    (Case (utf8 "two literals the modulus apart bear one hash, and are not equal")
      (bool_and (= (hash_expr (lit 0)) (hash_expr (lit (hash_m))))
        (bool_not (expr_eq (lit 0) (lit (hash_m))))))
    (Case (utf8 "graphs of one structure under other ids: equal, within the tree walk")
      (chains_eq 0 0 10))
    (Case (utf8 "graphs of one structure: equal past the tree walk's budget") (chains_eq 0 0 24))
    (Case (utf8 "graphs of one structure: equal where the tree is 10^18 nodes") (chains_eq 0 0 90))
    (Case (utf8 "graphs that differ in one value of the same hash: unequal, short")
      (bool_not (chains_eq 0 (hash_m) 10)))
    (Case (utf8 "graphs that differ in one value of the same hash: unequal, long")
      (bool_not (chains_eq 0 (hash_m) 90)))
    (Case (utf8 "equal graphs under one more equal value: equal") (chains_then 90 5 5))
    (Case (utf8 "a difference after every pair was noted equal: unequal")
      (bool_not (chains_then 90 0 (hash_m))))
    (Case (utf8 "the same below the budget: unequal") (bool_not (chains_then 6 0 (hash_m))))
    (Case (utf8 "watermark: st_fresh_node advances the node counter only")
      (match (st_fresh_node (St 5 6 7 (memo_empty)))
        ((Prod.mk (St g t k _) id)
         (bool_and (= id 8) (bool_and (= k 8) (bool_and (= g 5) (= t 6)))))))))


(fn main ((w World)) World (run_cases (utf8 "expr_test") (cases) 0 w))
