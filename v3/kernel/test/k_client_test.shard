;;; v3/kernel/test/k_client_test.shard — the raw-construction client fixture (the
;;; K seal): a client that imports K's view only builds a raw
;;; declaration from the public data, checks it from the empty environment, inspects the
;;; result, and checks again over it — never reaching around the API (a client naming
;;; CheckedEnv's constructor is the pin k_client_reach). The view joins no two environments
;;; (docs/KERNEL.md "The state discipline"):
;;; a client naming a transfer is the pin k_client_transfer, and what a second
;;; source can do is hostile_test's case 18.

(import "../host.shard")
(import "../k")
(import "case_kit.shard")
(import "decls_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.host.World)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn zero_def () Declaration
  (DefnDecl (ConstantVal (n1 (sym "z")) nil (nat)) (mk_const (nm_nat_zero) nil) (HRegular 1) Safe
    (list (n1 (sym "z")))))
(fn loose_def () Declaration
  (DefnDecl (ConstantVal (n1 (sym "loose")) nil (nat)) (mk_bvar 0) (HRegular 1) Safe
    (list (n1 (sym "loose")))))
(fn has ((env CheckedEnv) (n Name)) Bool
  (match (env_find env n)
    ((some _) true)
    (none false)))
;; the flow: the empty environment, Nat checked into it, z checked over that
(fn e_nat () CheckedEnv (env_after (check (env_empty) (st_init) (nat_decl)) (env_empty)))
(fn e_z () CheckedEnv (env_after (check (e_nat) (st_init) (zero_def)) (e_nat)))

(fn cases () (List Case)
  (list (Case (utf8 "the empty environment holds nothing") (bool_not (has (env_empty) (nm_nat))))
    (Case (utf8 "a raw inductive checked from the empty environment is accepted")
      (accepted (check (env_empty) (st_init) (nat_decl))))
    (Case (utf8 "the result holds it") (has (e_nat) (nm_nat)))
    (Case (utf8 "the result pins the export's Nat") (env_pinned (e_nat) (nm_nat)))
    (Case (utf8 "a second check over the result is accepted")
      (accepted (check (e_nat) (st_init) (zero_def))))
    (Case (utf8 "and holds both") (bool_and (has (e_z) (nm_nat)) (has (e_z) (n1 (sym "z")))))
    (Case (utf8 "a raw declaration with a loose variable is refused")
      (bool_not (accepted (check (e_nat) (st_init) (loose_def)))))
    (Case (utf8 "a refusal leaves the environment it was given")
      (bool_not (has (e_nat) (n1 (sym "loose")))))))

(fn main ((w World)) World (run_cases (utf8 "k_client_test") (cases) 0 w))
