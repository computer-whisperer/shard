;;; v3/kernel/test/k_client_test.shard — the raw-construction client fixture (GPT-6 R52; the
;;; K seal, v3/LANGUAGE.md §13 item 26): a client that imports K's view only builds a raw
;;; declaration from the public data, checks it from the empty environment, inspects the
;;; result, and checks again over it — never reaching around the API (a client naming
;;; CheckedEnv's constructor is the pin k_client_reach).

(import "../host.shard")
(import "../k")
(import "case_kit.shard")
(import "decls_kit.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.host.World)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn zero_def () Declaration
  (DefnDecl (ConstantVal (n1 (quote z)) Nil (nat)) (mk_const (nm_nat_zero) Nil) (HRegular 1) Safe (list (n1 (quote z)))))
(fn loose_def () Declaration
  (DefnDecl (ConstantVal (n1 (quote loose)) Nil (nat)) (mk_bvar 0) (HRegular 1) Safe (list (n1 (quote loose)))))
(fn has ((env CheckedEnv) (n Name)) Bool (match (env_find env n) ((Some _) True) (None False)))
;; the flow: the empty environment, Nat checked into it, z checked over that
(fn e_nat () CheckedEnv (env_after (check (env_empty) (st_init) (nat_decl)) (env_empty)))
(fn e_z () CheckedEnv (env_after (check (e_nat) (st_init) (zero_def)) (e_nat)))
;; the checked transfer (slice 4.0 rule 4, R78): z under another definition — Nat.succ Nat.zero
(fn other_z () Declaration
  (DefnDecl (ConstantVal (n1 (quote z)) Nil (nat)) (mk_app (mk_const (nm_nat_succ) Nil) (mk_const (nm_nat_zero) Nil)) (HRegular 1) Safe (list (n1 (quote z)))))
(fn e_z2 () CheckedEnv (env_after (check (e_nat) (st_init) (other_z)) (e_nat)))
;; a transfer names the whole block — the type, its constructors, its recursor — as the loader's
;; does (initload.shard od_admit: every constant the records admitted)
(fn nat_block_and_z () (List Name) (list (nm_nat) (nm_nat_zero) (nm_nat_succ) (n2 (quote Nat) (quote rec)) (n1 (quote z))))
(fn transferred ((o (Option CheckedEnv))) Bool (match o ((Some _) True) (None False)))
(fn holds_both ((o (Option CheckedEnv))) Bool (match o ((Some e) (bool_and (has e (nm_nat)) (has e (n1 (quote z))))) (None False)))
(fn pins_nat ((o (Option CheckedEnv))) Bool (match o ((Some e) (env_pinned e (nm_nat))) (None False)))

(fn cases () (List Case)
  (list
    (Case "the empty environment holds nothing" (bool_not (has (env_empty) (nm_nat))))
    (Case "a raw inductive checked from the empty environment is accepted" (accepted (check (env_empty) (st_init) (nat_decl))))
    (Case "the result holds it" (has (e_nat) (nm_nat)))
    (Case "the result pins the export's Nat" (env_pinned (e_nat) (nm_nat)))
    (Case "a second check over the result is accepted" (accepted (check (e_nat) (st_init) (zero_def))))
    (Case "and holds both" (bool_and (has (e_z) (nm_nat)) (has (e_z) (n1 (quote z)))))
    (Case "a raw declaration with a loose variable is refused" (bool_not (accepted (check (e_nat) (st_init) (loose_def)))))
    (Case "a refusal leaves the environment it was given" (bool_not (has (e_nat) (n1 (quote loose)))))
    (Case "a transfer of Nat's block and z into the empty environment holds both" (holds_both (env_transfer (e_z) (env_empty) (nat_block_and_z))))
    (Case "and pins the export's Nat by identity, not by the source's flag" (pins_nat (env_transfer (e_z) (env_empty) (nat_block_and_z))))
    (Case "a transfer of Nat without its constructors is refused: the recursor's citations are absent" (bool_not (transferred (env_transfer (e_z) (env_empty) (list (nm_nat) (n1 (quote z)))))))
    (Case "a transfer of z alone into the empty environment is refused: its citation is absent" (bool_not (transferred (env_transfer (e_z) (env_empty) (list (n1 (quote z)))))))
    (Case "a transfer of z onto an environment holding another z is refused" (bool_not (transferred (env_transfer (e_z) (e_z2) (list (n1 (quote z)))))))
    (Case "a transfer of z onto an environment holding the same z is accepted" (transferred (env_transfer (e_z) (e_z) (list (n1 (quote z))))))
    (Case "a transfer of a name the source lacks is refused" (bool_not (transferred (env_transfer (e_z) (e_nat) (list (n1 (quote loose)))))))))

(fn main ((w World)) World (run_cases "k_client_test" (cases) 0 w))
