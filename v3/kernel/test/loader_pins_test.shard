;; the outcome of a load: its first record that is not a module, an Init
;; load, an acceptance, a parameter or a discharge (the implementation's
;; own records under IMPL likewise); None = every record accepted
(fn first_bad ((rs (List Rec))) (Option Rec)
  (measure (struct rs))
  (match rs
    (nil none)
    ((cons x r) (if (rec_ok x) (first_bad r) (some (unwrap_impl x))))))
(fn rec_ok ((x Rec)) Bool
  (measure (struct x))
  (match x
    ((RModule _ _ _ _) true)
    ((RAccept _ _ _ _ _ _) true)
    ((RUnused _ _) true)
    ((RDerive _ _ _ _ _) true)
    ((RParam _ _ _) true)
    ((RDischarge _ _) true)
    ((RRun _ _ _ _ _) true)
    ((RRealize _ _ _ _) true)
    ((RDefine _ _ _) true)
    ((RTemplate _ _ _) true)
    ((RInstance _ _ _ _) true)
    ((RThread _ _ _) true)
    ((RSidecar _ _ _) true)
    ((RRecon _ _ _) true)
    ((RTactic _ _ _) true)
    ((RBin _ _ _ _ _ _) true)
    ((RImplRec y) (rec_ok y))
    (_ false)))
(fn unwrap_impl ((x Rec)) Rec
  (match x
    ((RImplRec y) (unwrap_impl y))
    (_ x)))
(fn accepts ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons x r) (+ (accepted_one x) (accepts r)))))
(fn accepted_one ((x Rec)) Int
  (measure (struct x))
  (match x
    ((RAccept _ _ _ _ _ _) 1)
    ((RParam _ _ _) 1)
    ((RRun _ _ _ _ _) 1)
    ((RRealize _ _ _ _) 1)
    ((RDefine _ _ _) 1)
    ((RTemplate _ _ _) 1)
    ((RInstance _ _ _ _) 1)
    ((RImplRec y) (accepted_one y))
    (_ 0)))

(fn matches ((ws (List (List Int))) (rs (List Rec))) Bool
  (match ws
    ((cons w nil)
     (if (int_list_eq w (utf8 "ok"))
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (< 0 (accepts rs)))
       false))
    ((cons w1 (cons w2 nil))
     (if (int_list_eq w2 (utf8 "threaded"))  ; NAME threaded: every record accepted, and the fn NAME's threading verdict is ok
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (has_thread rs w1 (utf8 "ok")))
     (if (int_list_eq w1 (utf8 "read-error"))
       (match (first_bad rs)
         ((some (RReadErr _ e _)) (int_list_eq (chars_of_sym e) w2))
         (_ false))
     (if (int_list_eq w1 (utf8 "load-error"))
       (match (first_bad rs)
         ((some (RLoadErr _ e _)) (int_list_eq (chars_of_sym e) w2))
         (_ false))
     (if (int_list_eq w1 (utf8 "load-error-after")) (has_load_error rs w2)  ; some record is the load error CODE — not the first bad one (a refusal stands before it)
     false)))))
    ((cons name (cons kind rest))
     (if (int_list_eq kind (utf8 "refused"))
       (match (first_bad rs)
         ((some (RRefuse n r))
          (bool_and (int_list_eq (show_name n) name)
            (int_list_eq (chars_of_sym r) (join_words rest))))
         ((some (RClassify n r _))
          (bool_and (int_list_eq (show_name n) name)
            (int_list_eq (chars_of_sym r) (join_words rest))))
         (_ false))
     (if (int_list_eq kind (utf8 "pending"))
       (match (first_bad rs)
         ((some (RPending n r))
          (bool_and (int_list_eq (show_name n) name)
            (int_list_eq (chars_of_sym r) (join_words rest))))
         (_ false))
     (if (int_list_eq kind (utf8 "policy"))
       (match (first_bad rs)
         ((some (RPolicy n out))
          (bool_and (int_list_eq (show_name n) name)
            (int_list_eq (show_names_c out) (join_words rest))))
         (_ false))
     (if (int_list_eq kind (utf8 "impl-error"))
       (match (first_bad rs)
         ((some (RImplErr n e _))
          (bool_and (int_list_eq (show_name n) name)
            (int_list_eq (chars_of_sym e) (join_words rest))))
         (_ false))
     (if (int_list_eq kind (utf8 "runnable"))  ; every record accepted, and NAME is RUNNABLE with the obstacle named
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (has_runnable rs name (join_words rest)))
     (if (int_list_eq kind (utf8 "refuses"))  ; some record refuses NAME for REASON — not the first bad one (a PENDING measure stands before a refused discharge)
       (has_refusal rs name (join_words rest))
     (if (int_list_eq kind (utf8 "unthreaded"))  ; every record accepted, and NAME's verdict is REASON (world_twice, world_unsupported, world_forged)
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (has_thread rs name (join_words rest)))
     (if (int_list_eq kind (utf8 "param"))  ; every record accepted, and NAME is a declared parameter of KIND (a trusted axiom is PARAM NAME axiom)
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (has_param rs name (join_words rest)))
     (if (int_list_eq kind (utf8 "bin"))  ; every record accepted, and the bin NAME's record has every requirement met (NAME bin ok)
       (bool_and
         (match (first_bad rs)
           (none true)
           (_ false))
         (bool_and (int_list_eq (join_words rest) (utf8 "ok")) (has_bin rs name)))
     (if (int_list_eq kind (utf8 "bad-bin"))  ; some record is the bin NAME's failure REASON — not necessarily the first bad one (a PENDING requirement stands before its UNMET): unmet, unthreaded, bad_entry, extern_undeclared, extern_outside, unknown_requirement, unknown_trust, untrusted
       (has_bin_err rs name (join_words rest))
       false)))))))))))
    (_ false)))
(fn has_load_error ((rs (List Rec)) (code (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RLoadErr _ e _) r)
     (if (int_list_eq (chars_of_sym e) code) true (has_load_error r code)))
    ((cons _ r) (has_load_error r code))))
(fn has_refusal ((rs (List Rec)) (name (List Int)) (why (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RClassify n r _) rest)
     (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) why)) true
     (has_refusal rest name why)))
    ((cons _ rest) (has_refusal rest name why))))
(fn has_param ((rs (List Rec)) (name (List Int)) (kind (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RParam n k _) r)
     (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym k) kind)) true
     (has_param r name kind)))
    ((cons (RImplRec y) r) (bool_or (has_param (list y) name kind) (has_param r name kind)))
    ((cons _ r) (has_param r name kind))))
(fn has_thread ((rs (List Rec)) (name (List Int)) (kind (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RThread n k _) r)
     (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym k) kind)) true
     (has_thread r name kind)))
    ((cons (RImplRec y) r) (bool_or (has_thread (list y) name kind) (has_thread r name kind)))
    ((cons _ r) (has_thread r name kind))))
(fn has_bin ((rs (List Rec)) (name (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RBin n _ _ _ reqs met) r)
     (if (bool_and (int_list_eq (show_name n) name) (= met (len reqs))) true (has_bin r name)))
    ((cons _ r) (has_bin r name))))
(fn has_bin_err ((rs (List Rec)) (name (List Int)) (kind (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RBinErr n k _) r)
     (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym k) kind)) true
     (has_bin_err r name kind)))
    ((cons _ r) (has_bin_err r name kind))))
(fn has_runnable ((rs (List Rec)) (name (List Int)) (why (List Int))) Bool
  (measure (struct rs))
  (match rs
    (nil false)
    ((cons (RRun _ n w _ _) r)
     (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym w) why)) true
     (has_runnable r name why)))
    ((cons (RImplRec y) r) (bool_or (has_runnable (list y) name why) (has_runnable r name why)))
    ((cons _ r) (has_runnable r name why))))

(fn case_root ((c (List Int))) (List Int) (append (utf8 "v3/pins/loader/") c))
;; the instance budget a case loads under: the loader's, except the
;; budget case, which exercises the refusal at 2
(fn case_budget ((c (List Int))) Int
  (if (int_list_eq c (utf8 "template_budget")) 2 (instance_budget)))
;; the files the loader is given, in order: the `;; roots:` header, else main.shard
;; the root the loader is given: the case's directory, or the `;; root:` header's path — a
;; case whose files must sit under the package root, as a client of kernel/k must
(fn root_of ((c (List Int)) (src (List Int))) (List Int)
  (match (header_words (utf8 ";; root:") src)
    ((cons r _) r)
    (nil (case_root c))))
(fn root_files ((c (List Int)) (src (List Int))) (List (List Int))
  (match (header_words (utf8 ";; roots:") src)
    (nil (list (append (case_root c) (utf8 "/main.shard"))))
    (ws (prefix_all (append (root_of c src) (utf8 "/")) ws))))
(fn prefix_all ((p (List Int)) (ws (List (List Int)))) (List (List Int))
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons w r) (cons (append p w) (prefix_all p r)))))
;; every case starts from one Init load of this process (the
;; export and its index opened once, the records a case demands loaded once), the case's root
;; fresh on it (ld_reroot) — a case's records are those of its own load, whatever the cases
;; before it fetched of Init. A case as it was loaded: the load after it (the next case
;; re-roots from it: Init's load carried, the case's own declarations not), whether the
;; outcome is the header's with the line that says so, the records as text
(type Ran (Ran Load Bool (List Int) (List Int)) (RanNot (List Int)))
(fn run_case ((c (List Int)) (l0 Load) (w World)) (Prod Ran World)
  (let ((main (append (case_root c) (utf8 "/main.shard"))))
    (match (read_file main w)
      ((Prod.mk none w1) (Prod.mk (RanNot (append (utf8 "FAIL cannot read ") main)) w1))
      ((Prod.mk (some src) w1)
       (let ((ws (expect_words src)))
         (match (parts_of (root_of c src))
           (none (Prod.mk (RanNot (append (utf8 "FAIL bad root ") c)) w1))
           ((some rootp)
            (match
              (load_all (ld_with_budget (ld_reroot l0 rootp) (case_budget c)) (root_files c src) w1)
              ((Prod.mk l w2)
               (Prod.mk
                 (if (matches ws (ld_recs l))
                   (Ran l true
                     (append (utf8 "PASS ") (append c (append (utf8 " — ") (show_words ws))))
                     (recs_text (ld_recs l)))
                   (Ran l false
                     (append (utf8 "FAIL ")
                       (append c
                         (append (utf8 " expected ")
                           (append (show_words ws)
                             (append (utf8 " got ")
                               (match (first_bad (ld_recs l))
                                 ((some x) (show_rec x))
                                 (none (utf8 "all accepted"))))))))
                     (recs_text (ld_recs l))))
                 w2))))))))))
(fn recs_text ((rs (List Rec))) (List Int)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons x r) (append (show_rec x) (cons 10 (recs_text r))))))
;; the cases in the list's order: each one's outcome against its header, its records kept —
;; newest first — and the records of Init it fetched after its first declaration, which the
;; base it leaves does not hold (Load.beyond)
(type First (First Load Int (List (List Int)) (List Int)))
(fn run_first
  ((cs (List (List Int)))
   (l0 Load)
   (fails Int)
   (texts (List (List Int)))
   (beyond (List Int))
   (w World))
  (Prod First World)
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (First l0 fails texts beyond) w))
    ((cons c r)
     (match (run_case c l0 w)
       ((Prod.mk (RanNot line) w1)
        (run_first r l0 (+ fails 1) (cons nil texts) beyond (write_line line w1)))
       ((Prod.mk (Ran l ok line text) w1)
        (run_first r l (if ok fails (+ fails 1)) (cons text texts) (append (Load.beyond l) beyond)
          (write_line line w1)))))))
;; ---- the order of the cases is no part of a case's records ------------------------------------
;; The standing test that what a file is given of Init is its own: after the cases have run in
;; the list's order, the base holds what each fetched before its first declaration; what they
;; fetched after it is loaded into the base as well, so that the base holds every record of
;; Init any case asked for; then every case is loaded again, last first, and its records must
;; be the first run's, byte for byte. A record that depended on what another case fetched —
;; an equation stated because Eq happened to be there, a lemma found because another file
;; cited it — differs here
(fn run_again
  ((cs (List (List Int))) (texts (List (List Int))) (l0 Load) (n Int) (differ Int) (w World))
  (Prod (Prod Int Int) World)
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (Prod.mk n differ) w))
    ((cons c r)
     (match texts
       (nil (Prod.mk (Prod.mk n differ) w))
       ((cons text tr)
        (match (run_case c l0 w)
          ((Prod.mk (RanNot _) w1) (run_again r tr l0 (+ n 1) differ w1))
          ((Prod.mk (Ran l _ _ text2) w1)
           (if (int_list_eq text text2) (run_again r tr l (+ n 1) differ w1)
           (run_again r tr l (+ n 1) (+ differ 1)
             (write_line
               (append (utf8 "FAIL ")
                 (append c
                   (append
                     (utf8
                       " — its records on the base every case left are not its records in the list's order: ")
                     (first_difference (text_lines text nil nil) (text_lines text2 nil nil)))))
               w1))))))))))
(fn text_lines ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil (rev acc))
    ((cons b r)
     (if (= b 10) (text_lines r nil (cons (rev cur) acc)) (text_lines r (cons b cur) acc)))))
(fn first_difference ((a (List (List Int))) (b (List (List Int)))) (List Int)
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil (utf8 "no line differs"))
        ((cons y _) (append (utf8 "in the list's order no record, here ") y))))
    ((cons x ar)
     (match b
       (nil (append (utf8 "in the list's order ") (append x (utf8 ", here no record"))))
       ((cons y br)
        (if (int_list_eq x y) (first_difference ar br)
        (append (utf8 "in the list's order ") (append x (append (utf8 ", here ") y)))))))))
;; the one Init load every case starts from: the export and its index named, opened by the
;; first case
(fn run_all ((w World)) World
  (match (run_first (cases) (kit_load0 (list (utf8 "v3") (utf8 "pins"))) 0 nil nil w)
    ((Prod.mk (First l fails texts beyond) w1)
     (match (init_load (ld_reroot l (list (utf8 "v3") (utf8 "pins"))) beyond w1)
       ((Prod.mk (Prod.mk lb _) w2)
        (match (run_again (rev (cases)) texts lb 0 0 w2)
          ((Prod.mk (Prod.mk n differ) w3)
           (exit (+ fails differ)
             (write_line (append (utf8 "loader_pins_test: failures = ") (show_int (+ fails differ)))
               (write_line
                 (append (utf8 "loader_pins_test: order: ")
                   (append (show_int n)
                     (append
                       (utf8 " cases loaded again, last first, on the base every case left — ")
                       (append (show_int differ) (utf8 " with other records")))))
                 w3))))))))))
(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk nil w1) (run_all w1))
    ((Prod.mk (cons x _) w1)
     (exit 2 (write_line (append (utf8 "loader_pins_test: unknown argument ") x) w1)))))
