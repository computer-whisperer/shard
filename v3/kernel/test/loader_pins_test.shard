        ;; slice 3.21b: GPT-6's trajectory review, findings 1–3
        "op_expected" "init_horizon" "init_horizon_beyond"
        ;; slice 3.22 landing 1: arith only, the witness goal, auto with sidecar replay
        "arith_only" "by_witness_open" "auto_core" "auto_stale" "auto_missing" "auto_malformed"))

;; the outcome of a load: its first record that is not a module, an Init
;; load, an acceptance, a parameter or a discharge (the implementation's
;; own records under IMPL likewise); None = every record accepted
(fn first_bad ((rs (List Rec))) (Option Rec)
  (measure (struct rs))
  (match rs
    (Nil None)
    ((Cons x r) (if (rec_ok x) (first_bad r) (Some (unwrap_impl x))))))
(fn rec_ok ((x Rec)) Bool
  (measure (struct x))
  (match x
    ((RModule _ _ _ _) True) ((RInit _ _) True) ((RAccept _ _ _ _ _ _) True) ((RUnused _ _) True) ((RDerive _ _ _ _ _) True)
    ((RParam _ _ _) True) ((RDischarge _ _) True) ((RRun _ _ _ _) True) ((RRealize _ _ _ _) True) ((RDefine _ _ _) True)
    ((RImplRec y) (rec_ok y))
    (_ False)))
(fn unwrap_impl ((x Rec)) Rec (match x ((RImplRec y) (unwrap_impl y)) (_ x)))
(fn accepts ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs (Nil 0) ((Cons x r) (+ (accepted_one x) (accepts r)))))
(fn accepted_one ((x Rec)) Int
  (measure (struct x))
  (match x ((RAccept _ _ _ _ _ _) 1) ((RParam _ _ _) 1) ((RRun _ _ _ _) 1) ((RRealize _ _ _ _) 1) ((RDefine _ _ _) 1) ((RImplRec y) (accepted_one y)) (_ 0)))

(fn matches ((ws (List (List Int))) (rs (List Rec))) Bool
  (match ws
    ((Cons w Nil) (if (int_list_eq w "ok") (bool_and (match (first_bad rs) (None True) (_ False)) (lt 0 (accepts rs))) False))
    ((Cons w1 (Cons w2 Nil))
     (if (int_list_eq w1 "read-error") (match (first_bad rs) ((Some (RReadErr _ e _)) (int_list_eq (chars_of_sym e) w2)) (_ False))
     (if (int_list_eq w1 "load-error") (match (first_bad rs) ((Some (RLoadErr _ e _)) (int_list_eq (chars_of_sym e) w2)) (_ False))
       False)))
    ((Cons name (Cons kind rest))
     (if (int_list_eq kind "refused")
       (match (first_bad rs)
         ((Some (RRefuse n r)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest))))
         ((Some (RClassify n r _)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest))))
         (_ False))
     (if (int_list_eq kind "pending")
       (match (first_bad rs) ((Some (RPending n r)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest)))) (_ False))
     (if (int_list_eq kind "policy")
       (match (first_bad rs) ((Some (RPolicy n out)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (show_names_c out) (join_words rest)))) (_ False))
     (if (int_list_eq kind "impl-error")
       (match (first_bad rs) ((Some (RImplErr n e _)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym e) (join_words rest)))) (_ False))
     (if (int_list_eq kind "runnable")   ; every record accepted, and NAME is RUNNABLE with the obstacle named (§8.4 rule 1)
       (bool_and (match (first_bad rs) (None True) (_ False)) (has_runnable rs name (join_words rest)))
     (if (int_list_eq kind "refuses")    ; some record refuses NAME for REASON — not the first bad one (a PENDING measure stands before a refused discharge)
       (has_refusal rs name (join_words rest))
       False)))))))
    (_ False)))
(fn has_refusal ((rs (List Rec)) (name (List Int)) (why (List Int))) Bool
  (measure (struct rs))
  (match rs
    (Nil False)
    ((Cons (RClassify n r _) rest) (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) why)) True (has_refusal rest name why)))
    ((Cons _ rest) (has_refusal rest name why))))
(fn has_runnable ((rs (List Rec)) (name (List Int)) (why (List Int))) Bool
  (measure (struct rs))
  (match rs
    (Nil False)
    ((Cons (RRun _ n w _) r) (if (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym w) why)) True (has_runnable r name why)))
    ((Cons (RImplRec y) r) (bool_or (has_runnable (list y) name why) (has_runnable r name why)))
    ((Cons _ r) (has_runnable r name why))))

(fn case_root ((c (List Int))) (List Int) (append "v3/pins/loader/" c))
;; the files the loader is given, in order: the `;; roots:` header, else main.shard
;; the root the loader is given: the case's directory, or the `;; root:` header's path — a
;; case whose files must sit under the package root, as a client of kernel/k must
(fn root_of ((c (List Int)) (src (List Int))) (List Int)
  (match (header_words ";; root:" src) ((Cons r _) r) (Nil (case_root c))))
(fn root_files ((c (List Int)) (src (List Int))) (List (List Int))
  (match (header_words ";; roots:" src)
    (Nil (list (append (case_root c) "/main.shard")))
    (ws (prefix_all (append (root_of c src) "/") ws))))
(fn prefix_all ((p (List Int)) (ws (List (List Int)))) (List (List Int))
  (measure (struct ws))
  (match ws (Nil Nil) ((Cons w r) (Cons (append p w) (prefix_all p r)))))
(fn load_roots ((l Load) (files (List (List Int))) (w World)) (Pair Load World)
  (measure (struct files))
  (match files
    (Nil (Pair l w))
    ((Cons f r) (match (load_root_file l f w) ((Pair l1 w1) (load_roots l1 r w1))))))
(fn run ((cs (List (List Int))) (rcpt (List (Pair (List Int) Int))) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (Nil (exit fails (write_line (append "loader_pins_test: failures = " (show_int fails)) w)))
    ((Cons c r)
     (let ((main (append (case_root c) "/main.shard")))
       (match (read_file main w)
         ((Pair None w1) (run r rcpt (+ fails 1) (write_line (append "FAIL cannot read " main) w1)))
         ((Pair (Some src) w1)
          (let ((ws (expect_words src)))
            (match (parts_of (root_of c src))
              (None (run r rcpt (+ fails 1) (write_line (append "FAIL bad root " c) w1)))
              ((Some rootp)
               (match (load_roots (ld_with_receipt (load0 rootp (list (fixture_int) (fixture_tail))) rcpt) (root_files c src) w1)
                 ((Pair l w2)
                  (if (matches ws (ld_recs l))
                    (run r rcpt fails (write_line (append "PASS " (append c (append " — " (show_words ws)))) w2))
                    (run r rcpt (+ fails 1) (write_line (append "FAIL " (append c (append " expected " (append (show_words ws) (append " got " (match (first_bad (ld_recs l)) ((Some x) (show_rec x)) (None "all accepted"))))))) w2))))))))))))))
;; `--init-receipt FILE` (slice 3.23): every case's load under the receipt — the records must not change
(fn main ((w World)) World
  (match (get_args w)
    ((Pair (Cons flag (Cons f _)) w1)
     (if (int_list_eq flag "--init-receipt")
       (match (read_file f w1)
         ((Pair None w2) (exit 2 (write_line (append "loader_pins_test: cannot read the receipt " f) w2)))
         ((Pair (Some bs) w2) (run (cases) (receipt_parse bs) 0 w2)))
       (exit 2 (write_line (append "loader_pins_test: unknown argument " flag) w1))))
    ((Pair Nil w1) (run (cases) Nil 0 w1))
    ((Pair (Cons x _) w1) (exit 2 (write_line (append "loader_pins_test: unknown argument " x) w1)))))
