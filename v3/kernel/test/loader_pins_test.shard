;;; v3/kernel/test/loader_pins_test.shard — replays v3/pins/loader/CASE/main.shard
;;; (the list below) as a package rooted at CASE through the loader and
;;; compares the load's outcome with the file's `;; expect:` header
;;; (v3/pins/loader/README.md). `(import Init NAME)` streams the 3000-line
;;; export fixture. The `realize_*` cases are slice 5b's (§7.5); `entry`,
;;; `entry_s`, `same_spelled` and `realize_theorem` are slice 7's (§9, T5).

(import "loader_kit.shard")
(use kernel.host)
(use kernel.loader)
(use kernel.prelude)
(use kernel.test.loader_kit)
(use kernel.test.reader_kit)
(use kernel.util)
(use kernel.host.World)
(use kernel.loader.Rec)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

