        "type_e_only" "type_flip" "private_module" "private_inside" "sealed_module" "impl_e_only" "k_client_reach" "record_basic" "record_make"
        "view_basic" "view_pending" "view_missing_fn" "view_missing_type" "view_missing_fulfills"
        "view_signature" "view_arity" "view_fulfills_unknown" "view_req_scope" "view_no_interface"
        "view_dir_form" "view_form" "view_sig_outside" "view_helper"
        "ev_basic" "ev_unsaturated" "ev_fn_value" "ev_nonexhaustive" "ev_nested_exhaustive" "ev_unknown_head"
        "ev_string" "ev_list_sugar" "ev_symbol" "ev_ambiguous" "ev_no_l_meaning" "ev_duplicate"
        "ev_profile" "ev_profile_form" "ev_type_param" "ev_pattern_type" "collision"
        "realize_supplied" "realize_wrong" "realize_loop" "realize_recursion" "realize_signature" "realize_prop"
        "realize_primitive" "realize_no_l_identity" "realize_native" "realize_view" "realize_brecon" "realize_unknown"
        "realize_pending" "realize_order" "realize_fn" "realize_dup" "fulfills_outside"
        "realize_equations" "realize_measure_loop" "realize_name_taken" "realize_param_use"
        "if_private" "if_type" "if_one" "if_ok" "entry_shape" "qualified_collision" "qualified_collision_l"
        "realize_pending_via"
        "define_basic" "define_depth" "define_nat_operator" "define_runnable" "define_refused" "def_match" "view_eq_hidden" "view_rfl"
        "elab_implicit" "elab_numeral" "elab_unsolved" "elab_instance" "elab_no_decision" "elab_mismatch" "define_forward" "elab_confusion"
        "define_below" "define_measure" "define_measure_int" "define_mutual"
        "match_def" "match_statement" "match_not_exhaustive" "match_literal" "match_motive" "match_poly" "match_imposter" "ctor_expected"
        "project_bool" "elab_bridge"
        ;; slice 3.16 landing 3: the flip
        "route_callee" "one_meaning" "discharge_measure" "discharge_self_cycle" "discharge_two_cycle" "match_in_impl" "define_arg_match"
        "literal_pattern" "literal_open" "literal_type" "literal_rows" "literal_nested" "rename_refused" "rename_refused_e" "rename_ok"
        "record_laws" "struct_make" "dependent_update" "struct_params" "measure_natabs" "route_sig_callee"
        ;; slice 3.18: the type rows, the literal, the wire
        "str_e_first" "str_no_string" "str_bad_utf8" "row_types" "row_e_first" "row_e_match" "struct_proj" "wire_s" "wire_bad" "wire_bad_result"
