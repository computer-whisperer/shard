;;; v3/kernel/test/loader_pins_test.shard — replays v3/pins/loader/CASE/main.shard
;;; (the list below) as a package rooted at CASE through the loader and
;;; compares the load's outcome with the file's `;; expect:` header
;;; (v3/pins/loader/README.md). The export and its index are opened once
;;; for the whole run and Init's load carried from case to case:
;;; each case's root loads fresh on K's environment of Init alone,
;;; what it needs of Init loaded on demand — once in the process. Then the
;;; cases are loaded a second time, last first, and each one's records
;;; compared with its first run's: what a file is given of Init does not
;;; depend on what was fetched before it.

(import "loader_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.host)
(use kernel.loader)
(use kernel.test.loader_kit)
(use kernel.test.reader_kit)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.loader.Rec)

