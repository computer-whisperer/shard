        ;; found by the second reader over the slice's diff
        "registry_native" "decidable_cells" "derive_name_taken" "derive_refusals" "derive_visible"
        ;; slice 3.20: I's opener — by blocks
        "by_core" "by_wf" "by_sorry" "by_goal_open" "by_goal_closed" "by_unknown_step" "by_intro_no_pi" "by_rfl_failed"
