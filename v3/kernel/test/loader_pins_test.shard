;;; v3/kernel/test/loader_pins_test.shard — replays v3/pins/loader/CASE/main.shard
;;; (the list below) as a package rooted at CASE through the loader and
;;; compares the load's outcome with the file's `;; expect:` header
;;; (v3/pins/loader/README.md). `(import Init NAME)` streams the 3000-line
;;; export fixture.

(import "reader_kit.shard")
(import "../loader.shard")

(fn fixture () (List Int) "v3/kernel/test/fixtures/init_prefix_3000.ndjson")
(fn cases () (List (List Int))
  (list "basic" "no_open" "ambiguous" "selective" "cycle" "missing" "directory" "outside"
        "init" "init_nested" "init_not_found" "sorry" "type_opens"
        "policy_axiom" "policy_trusts" "policy_cross" "read_error" "runnable_fn" "refused" "visible"
        "view_basic" "view_pending" "view_missing_fn" "view_missing_type" "view_missing_fulfills"
        "view_signature" "view_arity" "view_fulfills_unknown" "view_req_scope" "view_no_interface"
        "view_dir_form" "view_form" "view_sig_outside" "view_helper"
        "ev_basic" "ev_unsaturated" "ev_fn_value" "ev_nonexhaustive" "ev_nested_exhaustive" "ev_unknown_head"
        "ev_private_match" "ev_string" "ev_list_sugar" "ev_symbol" "ev_ambiguous" "ev_no_l_meaning" "ev_duplicate"
        "ev_profile" "ev_profile_form" "ev_type_param" "ev_pattern_type" "ev_launder" "collision"))

;; the outcome of a load: its first record that is not a module, an Init
;; load, an acceptance, a parameter or a discharge (the implementation's
;; own records under IMPL likewise); None = every record accepted
(fn first_bad ((rs (List Rec))) (Option Rec)
  (measure (struct rs))
  (match rs
    (Nil None)
    ((Cons x r) (if (rec_ok x) (first_bad r) (Some (unwrap_impl x))))))
(fn rec_ok ((x Rec)) Bool
  (measure (struct x))
  (match x
    ((RModule _ _ _ _) True) ((RInit _ _) True) ((RAccept _ _ _ _ _ _) True)
    ((RParam _ _ _) True) ((RDischarge _ _) True) ((RRun _ _) True)
    ((RImplRec y) (rec_ok y))
    (_ False)))
(fn unwrap_impl ((x Rec)) Rec (match x ((RImplRec y) (unwrap_impl y)) (_ x)))
(fn accepts ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs (Nil 0) ((Cons x r) (+ (accepted_one x) (accepts r)))))
(fn accepted_one ((x Rec)) Int
  (measure (struct x))
  (match x ((RAccept _ _ _ _ _ _) 1) ((RParam _ _ _) 1) ((RRun _ _) 1) ((RImplRec y) (accepted_one y)) (_ 0)))

(fn matches ((ws (List (List Int))) (rs (List Rec))) Bool
  (match ws
    ((Cons w Nil) (if (int_list_eq w "ok") (bool_and (match (first_bad rs) (None True) (_ False)) (lt 0 (accepts rs))) False))
    ((Cons w1 (Cons w2 Nil))
     (if (int_list_eq w1 "read-error") (match (first_bad rs) ((Some (RReadErr _ e _)) (int_list_eq (chars_of_sym e) w2)) (_ False))
     (if (int_list_eq w1 "load-error") (match (first_bad rs) ((Some (RLoadErr _ e _)) (int_list_eq (chars_of_sym e) w2)) (_ False))
       False)))
    ((Cons name (Cons kind rest))
     (if (int_list_eq kind "refused")
       (match (first_bad rs)
         ((Some (RRefuse n r)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest))))
         ((Some (RClassify n r _)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest))))
         (_ False))
     (if (int_list_eq kind "pending")
       (match (first_bad rs) ((Some (RPending n r)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym r) (join_words rest)))) (_ False))
     (if (int_list_eq kind "later")
       (match (first_bad rs) ((Some (RLater k n)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym k) (join_words rest)))) (_ False))
     (if (int_list_eq kind "policy")
       (match (first_bad rs) ((Some (RPolicy n out)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (show_names_c out) (join_words rest)))) (_ False))
     (if (int_list_eq kind "impl-error")
       (match (first_bad rs) ((Some (RImplErr n e _)) (bool_and (int_list_eq (show_name n) name) (int_list_eq (chars_of_sym e) (join_words rest)))) (_ False))
       False))))))
    (_ False)))

(fn case_root ((c (List Int))) (List Int) (append "v3/pins/loader/" c))
;; the files the loader is given, in order: the `;; roots:` header, else main.shard
(fn root_files ((c (List Int)) (src (List Int))) (List (List Int))
  (match (header_words ";; roots:" src)
    (Nil (list (append (case_root c) "/main.shard")))
    (ws (prefix_all (append (case_root c) "/") ws))))
(fn prefix_all ((p (List Int)) (ws (List (List Int)))) (List (List Int))
  (measure (struct ws))
  (match ws (Nil Nil) ((Cons w r) (Cons (append p w) (prefix_all p r)))))
(fn load_roots ((l Load) (files (List (List Int))) (w World)) (Pair Load World)
  (measure (struct files))
  (match files
    (Nil (Pair l w))
    ((Cons f r) (match (load_root_file l f w) ((Pair l1 w1) (load_roots l1 r w1))))))
(fn run ((cs (List (List Int))) (fails Int) (w World)) World
  (measure (struct cs))
  (match cs
    (Nil (exit fails (write_line (append "loader_pins_test: failures = " (show_int fails)) w)))
    ((Cons c r)
     (let ((main (append (case_root c) "/main.shard")))
       (match (read_file main w)
         ((Pair None w1) (run r (+ fails 1) (write_line (append "FAIL cannot read " main) w1)))
         ((Pair (Some src) w1)
          (let ((ws (expect_words src)))
            (match (parts_of (case_root c))
              (None (run r (+ fails 1) (write_line (append "FAIL bad root " c) w1)))
              ((Some rootp)
               (match (load_roots (load0 rootp (list (fixture))) (root_files c src) w1)
                 ((Pair l w2)
                  (if (matches ws (ld_recs l))
                    (run r fails (write_line (append "PASS " (append c (append " — " (show_words ws)))) w2))
                    (run r (+ fails 1) (write_line (append "FAIL " (append c (append " expected " (append (show_words ws) (append " got " (match (first_bad (ld_recs l)) ((Some x) (show_rec x)) (None "all accepted"))))))) w2))))))))))))))
(fn main ((w World)) World (run (cases) 0 w))
