;;; v3/kernel/test/reader_kit.shard — shared by the reader tests: one S form
;;; from text through the reader into K, and the verdict as a Step. Not an
;;; entrypoint. The loader owns the file-level version of this.

(import "../host.shard")
(import "../reader.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.name)
(use kernel.reader)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.InductiveType)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.expr.St)
(use kernel.reader.RDecl)
(use kernel.scope.Scope)
(use kernel.sexpr.SRes)

(type Step
  (SAcc CheckedEnv)  ; every declaration the form made was admitted
  (SRej Name Symbol)  ; K refused (subject, reason)
  (SPend Name Symbol)  ; read, admits nothing (sorry)
  (SRead Symbol (List Int))  ; the reader or the s-expression reader refused (reason, message)
  (SDirective)  ; import / use / trusts
  (SLater Symbol))  ; an E form the reader routes onward (fn, extern, fulfills, realize)

(fn st0 () St (st_init))
(fn e0 () CheckedEnv (env_empty))

(fn reason_sym ((r Reason)) Symbol
  (match r
    ((Malformed t) t)
    ((RuleViolation t) t)
    ((Unsupported t) t)
    (ConversionNotEstablished (quote conversion))))

(fn admit_all ((env CheckedEnv) (ds (List Declaration))) Step
  (measure (struct ds))
  (match ds
    (nil (SAcc env))
    ((cons d r)
     (match (check env (st0) d)
       ((Accepted e2) (admit_all e2 r))
       ((Rejected reason subject) (SRej subject (reason_sym reason)))
       ((Exhausted _ _) (SRej (decl_name d) (quote exhausted)))))))

;; one already-read form
(fn step_form ((sc Scope) (env CheckedEnv) (s SExpr)) Step
  (match (read_decl sc env s)
    ((RDOk ds) (admit_all env ds))
    ((RDPending n r) (SPend n r))
    ((RDErr e m) (SRead e m))
    ((RDDirective _) SDirective)
    ((RDParam d _ _) (admit_all env (list d)))
    ((RDSolved _ _ _ ds) (admit_all env ds))  ; never under the kit's mode (off); the loader's modes are prove.shard's
    ((RDMeasured _ _ _ ds) (admit_all env ds))
    ((RDLater k) (SLater k))))

;; one form from S text
(fn step ((sc Scope) (env CheckedEnv) (src (List Int))) Step
  (match (read_expr src (read_budget))
    ((SOk s _) (step_form sc env s))
    ((SErr e _) (SRead e nil))
    (SEnd (SRead (quote empty) nil))))

(fn env_of ((s Step) (dflt CheckedEnv)) CheckedEnv
  (match s
    ((SAcc e) e)
    (_ dflt)))
(fn acc ((s Step)) Bool
  (match s
    ((SAcc _) true)
    (_ false)))
(fn rerr ((s Step) (r Symbol)) Bool
  (match s
    ((SRead t _) (sym_eq r t))
    (_ false)))
(fn pend ((s Step)) Bool
  (match s
    ((SPend _ _) true)
    (_ false)))
(fn later ((s Step)) Bool
  (match s
    ((SLater _) true)
    (_ false)))
(fn directive ((s Step)) Bool
  (match s
    (SDirective true)
    (_ false)))
(fn show_step ((s Step)) (List Int)
  (match s
    ((SAcc _) "accepted")
    ((SRej n r) (append "refused " (append (show_name n) (append " " (chars_of_sym r)))))
    ((SPend n r) (append "pending " (append (show_name n) (append " " (chars_of_sym r)))))
    ((SRead e m) (append "read-error " (append (chars_of_sym e) (append ": " m))))
    (SDirective "directive")
    ((SLater k) (append "later " (chars_of_sym k)))))

;; ---- the `;; expect:` header of a pins file -------------------------------------------------------------------
;; the words after the first `;; expect:` line's marker
(fn expect_words ((src (List Int))) (List (List Int)) (header_words (utf8 ";; expect:") src))
;; the words after the first line starting with `marker`; Nil when none
(fn header_words ((marker (List Int)) (src (List Int))) (List (List Int))
  (measure (len src))
  (match (first_line src nil)
    ((Prod.mk line rest)
     (match (starts_with_lit marker line)
       ((some tail) (words tail nil nil))
       (none
         (match rest
           (nil nil)
           (_ (header_words marker rest))))))))
;; the first line and the rest (json.shard's take_line has the same shape; this kit is in
;; closures without json.shard, and parity's dump keys on last components: one name,
;; one declaration per closure)
(fn first_line ((bs (List Int)) (acc (List Int))) (Prod (List Int) (List Int))
  (measure (struct bs))
  (match bs
    (nil (Prod.mk (rev acc) nil))
    ((cons c r) (if (= c 10) (Prod.mk (rev acc) r) (first_line r (cons c acc))))))
(fn words ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil
      (rev
        (match cur
          (nil acc)
          (_ (cons (rev cur) acc)))))
    ((cons c r)
     (if (is_ws c)
       (words r nil
         (match cur
           (nil acc)
           (_ (cons (rev cur) acc))))
       (words r (cons c cur) acc)))))
(fn show_words ((ws (List (List Int)))) (List Int)
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons w r) (append w (cons 32 (show_words r))))))
;; the words separated by single spaces, no trailing space
(fn join_words ((ws (List (List Int)))) (List Int)
  (measure (struct ws))
  (match ws
    (nil nil)
    ((cons w nil) w)
    ((cons w r) (append w (cons 32 (join_words r))))))

;; two declarations the same? kind, name, level parameters, type, value (expr_eq: binder names ignored)
(fn decl_eq ((a Declaration) (b Declaration)) Bool
  (match a
    ((DefnDecl v1 x1 _ _ _)
     (match b
       ((DefnDecl v2 x2 _ _ _) (bool_and (cval_eq v1 v2) (expr_eq x1 x2)))
       (_ false)))
    ((ThmDecl v1 x1 _)
     (match b
       ((ThmDecl v2 x2 _) (bool_and (cval_eq v1 v2) (expr_eq x1 x2)))
       (_ false)))
    ((InductDecl l1 na (cons (InductiveType a1 t1 c1) nil) _)
     (match b
       ((InductDecl l2 nb (cons (InductiveType a2 t2 c2) nil) _)
        (bool_and (names_eq l1 l2)
          (bool_and (= na nb) (bool_and (name_eq a1 a2) (bool_and (expr_eq t1 t2) (ctors_eq c1 c2))))))
       (_ false)))
    (_ false)))
(fn ctors_eq ((a (List Constructor)) (b (List Constructor))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons (Constructor na t1) r1)
     (match b
       ((cons (Constructor nb t2) r2)
        (bool_and (name_eq na nb) (bool_and (expr_eq t1 t2) (ctors_eq r1 r2))))
       (_ false)))))
(fn read_one ((sc Scope) (env CheckedEnv) (src (List Int))) (Option Declaration)
  (match (read_expr src (read_budget))
    ((SOk s _)
     (match (read_decl sc env s)
       ((RDOk (cons d _)) (some d))
       (_ none)))
    (_ none)))
