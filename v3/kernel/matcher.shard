;;; v3/kernel/matcher.shard — matchers. A `match` elaborates to the
;;; application of a generated constant in Lean's shape,
;;;
;;;   OWNER.match_N.{v, us} : ∀ params (motive : D… → Sort v) (d : D)…
;;;                             (h_i : ∀ pattern variables, motive pattern_i)…, motive d…
;;;
;;; defined by a `casesOn` tree: first-match column splitting, the first
;;; column the first row constrains, a row with a variable there kept under
;;; every constructor — so a fall-through alternative is *applied* at every
;;; leaf it reaches, never copied. K checks the definition like any other.
;;;
;;; The matcher's type **is** its description: each alternative's type spells
;;; its row's patterns as a term over its variables, in row order. `mt_describe`
;;; reads the rows back off an admitted type and `mt_is_matcher` regenerates
;;; the definition from them and compares it with the admitted value — a
;;; check: no side table to go stale, to lose in a view's fork or to trust
;;; by a name's spelling.
;;;
;;; Untrusted (above K).

(import "kw.shard")
(import "scope.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.kw)
(use kernel.level)
(use kernel.name)
(use kernel.scope)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.kw.W)
(use kernel.level.Level)
(use kernel.name.Name)

;; a pattern: a variable with its slot among the alternative's variables (left to right in
;; the pattern; -1 for the wildcards a split introduces), or a constructor on its fields
(type MtPat (MtVar Int) (MtCtor Name (List MtPat)))
;; a row in compilation: the patterns by column, the alternative's index, the variables
;; bound so far (slot → value)
(type MtRow (MtRow (List MtPat) Int (List (Prod Int Expr))))
(type MtRes (MtOk W Expr) (MtErr Symbol (List Int)))
(type MtGen (MtGenOk W Declaration) (MtGenErr Symbol (List Int)))

(fn nm_motive () Name (n1 (sym "motive")))
(fn mt_alt_name ((i Int)) Name (n1 (sym_of_chars (append (utf8 "h_") (show_nat (+ i 1))))))
(fn mt_name ((owner Name) (k Int)) Name
  (Str owner (sym_of_chars (append (utf8 "match_") (show_nat k)))))
;; a universe name no parameter of the owner bears
(fn mt_level_name ((lps (List Name))) Name (mt_level_go lps 0 64))
(fn mt_level_go ((lps (List Name)) (k Int) (fuel Int)) Name
  (measure fuel)
  (let ((n (n1 (sym_of_chars (if (= k 0) (utf8 "v") (append (utf8 "v_") (show_nat k)))))))
    (if (bool_or (< fuel 1) (bool_not (mem_name n lps))) n (mt_level_go lps (+ k 1) (- fuel 1)))))

;; ---- an inductive type at its arguments --------------------------------------------------
;; the head inductive of a type, its levels and its parameters (an indexed family is refused)
(type MtInd (MtInd Name (List Level) (List Expr) (List Name)) (MtNoInd Symbol (List Int)))
(fn mt_ind_of ((w W) (ty Expr)) (Prod W MtInd)
  (match (w_whnf w ty)
    ((Prod.mk w1 none)
     (Prod.mk w1
       (MtNoInd (sym "match_scrutinee")
         (append (utf8 "K could not normalize the type ") (show_expr ty)))))
    ((Prod.mk w1 (some tyw))
     (match (get_app_fn tyw)
       ((Const _ ind ls)
        (match (env_find (w_env w1) ind)
          ((some (InductInfo _ nparams nindices _ ctors _ _ _ _))
           (if (< 0 nindices)
             (Prod.mk w1
               (MtNoInd (sym "match_indexed")
                 (append (show_name ind)
                   (utf8
                     ": a match on an indexed family needs a dependent motive, which match does not build"))))
             (Prod.mk w1 (MtInd ind ls (take nparams (get_app_args tyw)) ctors))))
          (_
            (Prod.mk w1
              (MtNoInd (sym "match_scrutinee")
                (append (show_expr tyw) (utf8 " is not an inductive type")))))))
       (_
         (Prod.mk w1
           (MtNoInd (sym "match_scrutinee")
             (append (show_expr tyw) (utf8 " is not an inductive type")))))))))
;; a constructor's type at the inductive's levels and parameters: the fields' telescope
(fn mt_ctor_type ((w W) (c Name) (ls (List Level)) (params (List Expr)))
  (Prod W (Option (Prod Expr Int)))
  (match (env_find (w_env w) c)
    ((some (CtorInfo cv _ _ _ nfields _))
     (match (w_inst_lparams w (cv_type cv) (cv_lparams cv) ls)
       ((Prod.mk w1 t)
        (match (mt_inst_args w1 t params)
          ((Prod.mk w2 (some t1)) (Prod.mk w2 (some (Prod.mk t1 nfields))))
          ((Prod.mk w2 none) (Prod.mk w2 none))))))
    (_ (Prod.mk w none))))
(fn mt_inst_args ((w W) (t Expr) (args (List Expr))) (Prod W (Option Expr))
  (measure (struct args))
  (match args
    (nil (Prod.mk w (some t)))
    ((cons a r)
     (match t
       ((Pi _ _ _ _ body)
        (match (w_inst1 w body a)
          ((Prod.mk w1 b) (mt_inst_args w1 b r))))
       (_ (Prod.mk w none))))))
;; the fields of a constructor as fresh locals, each typed past the earlier ones
(fn mt_open_fields ((w W) (t Expr) (k Int) (acc (List (Prod Expr Expr))))
  (Prod W (Option (List (Prod Expr Expr))))
  (measure k)
  (if (< k 1) (Prod.mk w (some (rev acc)))
  (match t
    ((Pi _ n _ dom body)
     (match (w_local w n dom)
       ((Prod.mk w1 fv)
        (match (w_inst1 w1 body fv)
          ((Prod.mk w2 b) (mt_open_fields w2 b (- k 1) (cons (Prod.mk fv dom) acc)))))))
    (_ (Prod.mk w none)))))
(fn mt_firsts ((xs (List (Prod Expr Expr)))) (List Expr)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (Prod.mk a _) r) (cons a (mt_firsts r)))))

;; ---- a pattern as a term over fresh variables --------------------------------------------
;; the pattern at its type: the term, and the variables' locals in slot order
(type MtPt (MtPtOk W Expr (List Expr)) (MtPtErr Symbol (List Int)))
(fn mt_pat_term ((w W) (p MtPat) (ty Expr) (vars (List Expr)) (fuel Int)) MtPt
  (measure fuel)
  (if (< fuel 1) (MtPtErr (sym "match_depth") (utf8 "a pattern too deep"))
  (match p
    ((MtVar _)
     (match (w_local w (n1 (sym "x")) ty)
       ((Prod.mk w1 fv) (MtPtOk w1 fv (append vars (list fv))))))
    ((MtCtor c subs)
     (match (mt_ind_of w ty)
       ((Prod.mk _ (MtNoInd e m)) (MtPtErr e m))
       ((Prod.mk w1 (MtInd _ ls params _))
        (match (mt_ctor_type w1 c ls params)
          ((Prod.mk _ none) (MtPtErr (sym "match_constructor") (show_name c)))
          ((Prod.mk w2 (some (Prod.mk cty nfields)))
           (if (bool_not (= (len subs) nfields))
             (MtPtErr (sym "pattern_arity")
               (append (show_name c)
                 (append (utf8 " has ") (append (show_nat nfields) (utf8 " fields")))))
             (mt_pat_fields w2 subs cty (mk_app_n (mk_const c ls) params) vars (- fuel 1)))))))))))
(fn mt_pat_fields ((w W) (subs (List MtPat)) (cty Expr) (acc Expr) (vars (List Expr)) (fuel Int))
  MtPt
  (measure (struct subs))
  (match subs
    (nil (MtPtOk w acc vars))
    ((cons p r)
     (match cty
       ((Pi _ _ _ dom body)
        (match (mt_pat_term w p dom vars fuel)
          ((MtPtErr e m) (MtPtErr e m))
          ((MtPtOk w1 t vars1)
           (match (w_inst1 w1 body t)
             ((Prod.mk w2 b) (mt_pat_fields w2 r b (mk_app acc t) vars1 fuel))))))
       (_ (MtPtErr (sym "match_constructor") (utf8 "a constructor's type ran out of fields")))))))
(fn mt_pat_terms ((w W) (ps (List MtPat)) (tys (List Expr)) (acc (List Expr)) (vars (List Expr)))
  (Prod W (Option (Prod (List Expr) (List Expr))))
  (measure (struct ps))
  (match ps
    (nil (Prod.mk w (some (Prod.mk (rev acc) vars))))
    ((cons p r)
     (match tys
       (nil (Prod.mk w none))
       ((cons ty tr)
        (match (mt_pat_term w p ty vars 256)
          ((MtPtErr _ _) (Prod.mk w none))
          ((MtPtOk w1 t vars1) (mt_pat_terms w1 r tr (cons t acc) vars1))))))))

;; ---- the definition ----------------------------------------------------------------------
;; params: the outer locals the scrutinee types mention, in dependency order (the caller's);
;; dtys: the scrutinee types; rows: the patterns per row, by column
(fn mt_generate
  ((w W)
   (name Name)
   (lps (List Name))
   (v Name)
   (params (List Expr))
   (dtys (List Expr))
   (rows (List (List MtPat))))
  MtGen
  (match (mt_locals w dtys (n1 (sym "d")) nil)
    ((Prod.mk w1 ds)
     (match (w_pis w1 ds (mk_sort (LParam v)))
       ((Prod.mk w2 mty)
        (match (w_local w2 (nm_motive) mty)
          ((Prod.mk w3 M)
           (match (mt_locals w3 dtys (n1 (sym "t")) nil)
             ((Prod.mk w4 xs)
              (match (mt_alts w4 M dtys rows 0 nil)
                ((Prod.mk _ (MtAltsErr e m)) (MtGenErr e m))
                ((Prod.mk w5 (MtAltsOk alts))
                 (match
                   (mt_compile w5 (* 64 (+ 1 (len rows))) v M (mt_zip xs dtys) xs (mt_rows0 rows 0)
                     alts
                     nil)
                   ((MtErr e m) (MtGenErr e m))
                   ((MtOk w6 body)
                    (let ((binders (append params (append (list M) (append xs alts)))))
                      (match (w_lams w6 binders body)
                        ((Prod.mk w7 value)
                         (match (w_pis w7 binders (mk_app_n M xs))
                           ((Prod.mk w8 ty)
                            (MtGenOk w8
                              (DefnDecl (ConstantVal name (cons v lps) ty) value HAbbrev Safe
                                (list name)))))))))))))))))))))
(type MtAlts (MtAltsErr Symbol (List Int)) (MtAltsOk (List Expr)))
(fn mt_locals ((w W) (tys (List Expr)) (n Name) (acc (List Expr))) (Prod W (List Expr))
  (measure (struct tys))
  (match tys
    (nil (Prod.mk w (rev acc)))
    ((cons ty r)
     (match (w_local w n ty)
       ((Prod.mk w1 fv) (mt_locals w1 r n (cons fv acc)))))))
(fn mt_zip ((xs (List Expr)) (tys (List Expr))) (List (Prod Expr Expr))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r)
     (match tys
       ((cons t tr) (cons (Prod.mk x t) (mt_zip r tr)))
       (nil nil)))))
(fn mt_rows0 ((rows (List (List MtPat))) (i Int)) (List MtRow)
  (measure (struct rows))
  (match rows
    (nil nil)
    ((cons ps r) (cons (MtRow ps i nil) (mt_rows0 r (+ i 1))))))
;; the alternatives' locals: h_i : ∀ variables, motive pattern_i
(fn mt_alts ((w W) (M Expr) (dtys (List Expr)) (rows (List (List MtPat))) (i Int) (acc (List Expr)))
  (Prod W MtAlts)
  (measure (struct rows))
  (match rows
    (nil (Prod.mk w (MtAltsOk (rev acc))))
    ((cons ps r)
     (match (mt_pat_terms w ps dtys nil nil)
       ((Prod.mk w1 none)
        (Prod.mk w1
          (MtAltsErr (sym "match_pattern")
            (append (utf8 "row ")
              (append (show_nat (+ i 1)) (utf8 ": a pattern does not fit its scrutinee's type"))))))
       ((Prod.mk w1 (some (Prod.mk terms vars)))
        (match (w_pis w1 vars (mk_app_n M terms))
          ((Prod.mk w2 aty)
           (match (w_local w2 (mt_alt_name i) aty)
             ((Prod.mk w3 h) (mt_alts w3 M dtys r (+ i 1) (cons h acc)))))))))))

;; the case tree: cols are (local, type); targs the motive's arguments as refined so far;
;; substs the splits made on the way down (local := constructor term, in order) — a variable
;; bound before a later split is refined by it at the leaf, so the alternative's argument is
;; the term the motive's argument has there
(fn mt_compile
  ((w W)
   (fuel Int)
   (v Name)
   (M Expr)
   (cols (List (Prod Expr Expr)))
   (targs (List Expr))
   (rows (List MtRow))
   (alts (List Expr))
   (substs (List (Prod Int Expr))))
  MtRes
  (measure fuel)
  (if (< fuel 1) (MtErr (sym "match_depth") (utf8 "the case tree is too deep"))
  (match rows
    (nil
      (MtErr (sym "match_not_exhaustive")
        (utf8 "a constructor no row covers: add the case or a `_` row")))
    ((cons (MtRow pats i binds) _)
     (match (mt_ctor_col pats 0)
       (none
         (match (nth alts i)
           (none (MtErr (sym "match_pattern") (utf8 "alternative")))
           ((some h)
            (match (mt_refine_all w (mt_slot_args (mt_bind_cols pats cols binds) 0 256) substs nil)
              ((Prod.mk w1 args) (MtOk w1 (mk_app_n h args)))))))
       ((some j)
        (match (nth cols j)
          (none (MtErr (sym "match_pattern") (utf8 "column")))
          ((some (Prod.mk x xty))
           (match (mt_ind_of w xty)
             ((Prod.mk _ (MtNoInd e m)) (MtErr e m))
             ((Prod.mk w1 (MtInd ind ls params ctors))
              (match (mt_cases_levels w1 ind ls v)
                (none
                  (MtErr (sym "match_eliminator")
                    (append (show_name ind)
                      (utf8 ".casesOn is missing or eliminates into Prop only"))))
                ((some cls)
                 (match (w_local w1 (n1 (sym "y")) xty)
                   ((Prod.mk w2 y)
                    (match (mt_subst_all w2 targs (fvar_id_of x) y nil)
                      ((Prod.mk w3 targs_y)
                       (match (w_lams w3 (list y) (mk_app_n M targs_y))
                         ((Prod.mk w4 motive)
                          (match
                            (mt_minors w4 (- fuel 1) v M cols targs rows alts substs j x ls params
                              ctors
                              nil)
                            ((Prod.mk _ (MtAltsErr e m)) (MtErr e m))
                            ((Prod.mk w5 (MtAltsOk minors))
                             (MtOk w5
                               (mk_app_n (mk_const (name_append ind (n1 (sym "casesOn"))) cls)
                                 (append params (append (list motive x) minors))))))))))))))))))))))))
;; casesOn's levels: the motive's universe first, then the inductive's (a large eliminator)
(fn mt_cases_levels ((w W) (ind Name) (ls (List Level)) (v Name)) (Option (List Level))
  (match (env_find (w_env w) (name_append ind (n1 (sym "casesOn"))))
    ((some info) (if (= (len (ci_lparams info)) (+ 1 (len ls))) (some (cons (LParam v) ls)) none))
    (none none)))
(fn mt_ctor_col ((pats (List MtPat)) (i Int)) (Option Int)
  (measure (struct pats))
  (match pats
    (nil none)
    ((cons (MtCtor _ _) _) (some i))
    ((cons _ r) (mt_ctor_col r (+ i 1)))))
;; a leaf: every remaining pattern is a variable, bound to its column's local
(fn mt_bind_cols ((pats (List MtPat)) (cols (List (Prod Expr Expr))) (binds (List (Prod Int Expr))))
  (List (Prod Int Expr))
  (measure (struct pats))
  (match pats
    (nil binds)
    ((cons p r)
     (match cols
       (nil binds)
       ((cons (Prod.mk x _) cr)
        (mt_bind_cols r cr
          (match p
            ((MtVar s) (if (< s 0) binds (cons (Prod.mk s x) binds)))
            (_ binds))))))))
(fn mt_slot_args ((binds (List (Prod Int Expr))) (s Int) (fuel Int)) (List Expr)
  (measure fuel)
  (if (< fuel 1) nil
  (match (mt_slot binds s)
    (none nil)
    ((some e) (cons e (mt_slot_args binds (+ s 1) (- fuel 1)))))))
(fn mt_refine_all ((w W) (es (List Expr)) (substs (List (Prod Int Expr))) (acc (List Expr)))
  (Prod W (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk w (rev acc)))
    ((cons e r)
     (match (mt_refine w e substs)
       ((Prod.mk w1 e1) (mt_refine_all w1 r substs (cons e1 acc)))))))
(fn mt_refine ((w W) (e Expr) (substs (List (Prod Int Expr)))) (Prod W Expr)
  (measure (struct substs))
  (match substs
    (nil (Prod.mk w e))
    ((cons (Prod.mk id ct) r)
     (match (w_subst w e id ct)
       ((Prod.mk w1 e1) (mt_refine w1 e1 r))))))
(fn mt_slot ((binds (List (Prod Int Expr))) (s Int)) (Option Expr)
  (measure (struct binds))
  (match binds
    (nil none)
    ((cons (Prod.mk k e) r) (if (= k s) (some e) (mt_slot r s)))))
(fn mt_subst_all ((w W) (es (List Expr)) (id Int) (val Expr) (acc (List Expr))) (Prod W (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk w (rev acc)))
    ((cons e r)
     (match (w_subst w e id val)
       ((Prod.mk w1 e1) (mt_subst_all w1 r id val (cons e1 acc)))))))
;; one minor premise per constructor: λ fields. the tree over the specialized rows
(fn mt_minors
  ((w W)
   (fuel Int)
   (v Name)
   (M Expr)
   (cols (List (Prod Expr Expr)))
   (targs (List Expr))
   (rows (List MtRow))
   (alts (List Expr))
   (substs (List (Prod Int Expr)))
   (j Int)
   (x Expr)
   (ls (List Level))
   (params (List Expr))
   (ctors (List Name))
   (acc (List Expr)))
  (Prod W MtAlts)
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk w (MtAltsOk (rev acc))))
    ((cons c r)
     (match (mt_ctor_type w c ls params)
       ((Prod.mk w1 none) (Prod.mk w1 (MtAltsErr (sym "match_constructor") (show_name c))))
       ((Prod.mk w1 (some (Prod.mk cty nfields)))
        (match (mt_open_fields w1 cty nfields nil)
          ((Prod.mk w2 none) (Prod.mk w2 (MtAltsErr (sym "match_constructor") (show_name c))))
          ((Prod.mk w2 (some fields))
           (let ((ct (mk_app_n (mk_app_n (mk_const c ls) params) (mt_firsts fields))))
             (match (mt_subst_all w2 targs (fvar_id_of x) ct nil)
               ((Prod.mk w3 targs_c)
                (match
                  (mt_compile w3 fuel v M (append (take j cols) (append fields (drop (+ j 1) cols)))
                    targs_c
                    (mt_specialize rows j c nfields ct)
                    alts
                    (append substs (list (Prod.mk (fvar_id_of x) ct))))
                  ((MtErr e m) (Prod.mk w3 (MtAltsErr e m)))
                  ((MtOk w4 body)
                   (match (w_lams w4 (mt_firsts fields) body)
                     ((Prod.mk w5 minor)
                      (mt_minors w5 fuel v M cols targs rows alts substs j x ls params r
                        (cons minor acc))))))))))))))))
;; the rows under constructor c at column j: a row with c there gives its sub-patterns, one
;; with a variable there stays (the variable bound to the constructor term), another goes
(fn mt_specialize ((rows (List MtRow)) (j Int) (c Name) (nfields Int) (ct Expr)) (List MtRow)
  (measure (struct rows))
  (match rows
    (nil nil)
    ((cons (MtRow pats i binds) r)
     (match (nth pats j)
       ((some (MtCtor c2 subs))
        (if (name_eq c c2)
          (cons (MtRow (append (take j pats) (append subs (drop (+ j 1) pats))) i binds)
            (mt_specialize r j c nfields ct))
          (mt_specialize r j c nfields ct)))
       ((some (MtVar s))
        (cons
          (MtRow (append (take j pats) (append (mt_wilds nfields) (drop (+ j 1) pats))) i
            (if (< s 0) binds (cons (Prod.mk s ct) binds)))
          (mt_specialize r j c nfields ct)))
       (none (mt_specialize r j c nfields ct))))))
(fn mt_wilds ((k Int)) (List MtPat)
  (measure k)
  (if (< k 1) nil (cons (MtVar -1) (mt_wilds (- k 1)))))

;; ---- the description read back -----------------------------------------------------------
;; the rows of a matcher's type: past `nparams` binders the motive, its arity the number of
;; scrutinees, then an alternative per row whose type ends in `motive pattern…`
(type MtDesc (MtDesc Int Int (List (List MtPat))))  ; nparams, nscrutinees, rows
(fn mt_describe ((env CheckedEnv) (ty Expr)) (Option MtDesc) (mt_find_motive env ty 0 256))
(fn mt_find_motive ((env CheckedEnv) (ty Expr) (k Int) (fuel Int)) (Option MtDesc)
  (measure fuel)
  (if (< fuel 1) none
  (match ty
    ((Pi _ n _ dom body)
     (if (bool_and (name_eq n (nm_motive)) (mt_ends_in_sort dom 64))
       (let ((nd (mt_pi_arity dom 0 64)))
         (match (mt_skip_pis body nd)
           (none none)
           ((some rest)
            (match (mt_desc_rows env rest nd 0 nil 256)
              ((some rows) (some (MtDesc k nd rows)))
              (none none)))))
       (mt_find_motive env body (+ k 1) (- fuel 1))))
    (_ none))))
(fn mt_ends_in_sort ((t Expr) (fuel Int)) Bool
  (measure fuel)
  (if (< fuel 1) false
  (match t
    ((Pi _ _ _ _ b) (mt_ends_in_sort b (- fuel 1)))
    ((Sort _ _) true)
    (_ false))))
(fn mt_pi_arity ((t Expr) (k Int) (fuel Int)) Int
  (measure fuel)
  (if (< fuel 1) k
  (match t
    ((Pi _ _ _ _ b) (mt_pi_arity b (+ k 1) (- fuel 1)))
    (_ k))))
(fn mt_skip_pis ((t Expr) (k Int)) (Option Expr)
  (measure k)
  (if (< k 1) (some t)
  (match t
    ((Pi _ _ _ _ b) (mt_skip_pis b (- k 1)))
    (_ none))))
;; the alternatives: each a Pi until the result `motive d…`; depth = binders passed since the motive
(fn mt_desc_rows
  ((env CheckedEnv) (t Expr) (nd Int) (nalts Int) (acc (List (List MtPat))) (fuel Int))
  (Option (List (List MtPat)))
  (measure fuel)
  (if (< fuel 1) none
  (match t
    ((Pi _ _ _ dom body)
     (match (mt_alt_pats env dom 0 64)
       (none none)
       ((some pats)
        (if (= (len pats) nd) (mt_desc_rows env body nd (+ nalts 1) (cons pats acc) (- fuel 1))
        none))))
    (_ (some (rev acc))))))
;; an alternative's type: ∀ variables, motive p…; a bound variable k under nv binders is slot nv-1-k
(fn mt_alt_pats ((env CheckedEnv) (t Expr) (nv Int) (fuel Int)) (Option (List MtPat))
  (measure fuel)
  (if (< fuel 1) none
  (match t
    ((Pi _ _ _ _ body) (mt_alt_pats env body (+ nv 1) (- fuel 1)))
    (_ (mt_pats_of env (get_app_args t) nv nil 64)))))
(fn mt_pats_of ((env CheckedEnv) (es (List Expr)) (nv Int) (acc (List MtPat)) (fuel Int))
  (Option (List MtPat))
  (measure (struct es))
  (match es
    (nil (some (rev acc)))
    ((cons e r)
     (match (mt_pat_of env e nv fuel)
       ((some p) (mt_pats_of env r nv (cons p acc) fuel))
       (none none)))))
;; a variable of the alternative, or a constructor on its fields (its parameters dropped)
(fn mt_pat_of ((env CheckedEnv) (e Expr) (nv Int) (fuel Int)) (Option MtPat)
  (measure fuel)
  (if (< fuel 1) none
  (match e
    ((BVar _ k) (if (< k nv) (some (MtVar (- (- nv 1) k))) none))
    (_
      (match (get_app_fn e)
        ((Const _ c _)
         (match (env_find env c)
           ((some (CtorInfo _ _ _ nparams nfields _))
            (let ((fields (drop nparams (get_app_args e))))
              (if (= (len fields) nfields)
                (match (mt_pats_of env fields nv nil (- fuel 1))
                  ((some ps) (some (MtCtor c ps)))
                  (none none))
                none)))
           (_ none)))
        (_ none))))))

;; is this admitted constant a matcher, and which? Its type read back, the definition
;; regenerated from the rows at the same name and universe parameters, the two values
;; compared: a constant that merely looks like one is not one
(fn mt_is_matcher ((env CheckedEnv) (name Name)) (Option MtDesc)
  (match (env_find env name)
    ((some (DefnInfo cv value _ _ _))
     (match (mt_describe env (cv_type cv))
       (none none)
       ((some (MtDesc np nd rows))
        (match (cv_lparams cv)
          (nil none)
          ((cons v lps)
           (match (mt_open_params (w0 env) (cv_type cv) np nil)
             ((Prod.mk _ none) none)
             ((Prod.mk w1 (some (Prod.mk params rest)))
              (match (mt_motive_doms rest)
                (none none)
                ((some dtys)
                 (match (mt_generate w1 name lps v params dtys rows)
                   ((MtGenErr _ _) none)
                   ((MtGenOk _ (DefnDecl _ value2 _ _ _))
                    (if (expr_eq value value2) (some (MtDesc np nd rows)) none))
                   ((MtGenOk _ _) none)))))))))))
    (_ none)))
;; the parameters as fresh locals; what is left starts at the motive
(fn mt_open_params ((w W) (t Expr) (k Int) (acc (List Expr)))
  (Prod W (Option (Prod (List Expr) Expr)))
  (measure k)
  (if (< k 1) (Prod.mk w (some (Prod.mk (rev acc) t)))
  (match t
    ((Pi _ n _ dom body)
     (match (w_local w n dom)
       ((Prod.mk w1 fv)
        (match (w_inst1 w1 body fv)
          ((Prod.mk w2 b) (mt_open_params w2 b (- k 1) (cons fv acc)))))))
    (_ (Prod.mk w none)))))
;; the scrutinee types: the motive's domains (non-dependent)
(fn mt_motive_doms ((t Expr)) (Option (List Expr))
  (match t
    ((Pi _ _ _ mty _) (some (mt_doms mty 64)))
    (_ none)))
(fn mt_doms ((t Expr) (fuel Int)) (List Expr)
  (measure fuel)
  (if (< fuel 1) nil
  (match t
    ((Pi _ _ _ dom b) (cons dom (mt_doms b (- fuel 1))))
    (_ nil))))
