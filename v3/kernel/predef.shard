;;; v3/kernel/predef.shard — the pre-definition (v3/LANGUAGE.md §8.4 slice 3.16 "the
;;; shape"; GPT-6 R63). A `fn` form elaborated **once**, by elab.shard, into a named
;;; record: the declared identity and type, the binders' locals, the **self-local** — the
;;; function's own name bound to a local of the declared type, so a body that calls itself
;;; is an ordinary L term —, the body over them, and the elaboration state that made it
;;; (the walk with the locals and the matchers already checked into its environment, which
;;; the projections continue in). Its two projections consume the record and re-read
;;; nothing: the erasure toward E (realize.shard's `erase_predef`), the compilation toward
;;; K (define.shard; landing 3).
;;;
;;; A PreDef is never an admitted declaration: a body well typed *assuming* a local for its
;;; own name is provisional until the K projection admits it, and nothing here produces a
;;; `Declaration` for the owner — only the matchers it generated (`pd_aux`), which K has
;;; checked. `PdSkip` is a signature with no L reading (the function never enters the
;;; route; rule 6); `PdErr` is a refusal on the route.

(import "reader.shard")
(use kernel.k)
(use kernel.kw)
(use kernel.decl)
(use kernel.elab)
(use kernel.expr)
(use kernel.name)
(use kernel.prelude)
(use kernel.reader)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.elab.El)
(use kernel.kw.W)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)

;; the recursion clause as read: none; `(measure (struct x))` — the structural binder's local;
;; `(measure M)` — M elaborated over the binders (K's projection wants a Nat: define.shard)
(type PdRec (PdNone) (PdStruct Expr) (PdMeasure Expr))
;; identity, the declared type (closed), the binders' locals in order, the self-local, the
;; body over them (finished: no metavariable), the state, the recursion clause, the callee-locals
;; a RUNNABLE callee — a function with a program and no K constant — stands in a body as a
;; local of its signature's type (rule 6): the name as the body writes it, its identity, the
;; scope its form was read in, the form
(type Callee (Callee Name Name Scope SExpr))
;; a callee-local: the local, the callee's identity, its binders' runtime flags (a type binder False)
(type CalleeLocal (CalleeLocal Expr Name (List Bool)))
(type PreDef (PreDef Name Expr (List Expr) Expr Expr El PdRec (List CalleeLocal)))
(type PdRes (PdOk PreDef) (PdSkip Symbol (List Int)) (PdErr Symbol (List Int)))
(fn pd_name ((p PreDef)) Name (match p ((PreDef n _ _ _ _ _ _ _) n)))
(fn pd_type ((p PreDef)) Expr (match p ((PreDef _ t _ _ _ _ _ _) t)))
(fn pd_binders ((p PreDef)) (List Expr) (match p ((PreDef _ _ bs _ _ _ _ _) bs)))
(fn pd_self ((p PreDef)) Expr (match p ((PreDef _ _ _ s _ _ _ _) s)))
(fn pd_body ((p PreDef)) Expr (match p ((PreDef _ _ _ _ b _ _ _) b)))
(fn pd_state ((p PreDef)) El (match p ((PreDef _ _ _ _ _ e _ _) e)))
(fn pd_rec ((p PreDef)) PdRec (match p ((PreDef _ _ _ _ _ _ r _) r)))
(fn pd_callees ((p PreDef)) (List CalleeLocal) (match p ((PreDef _ _ _ _ _ _ _ c) c)))
(fn pd_aux ((p PreDef)) (List Declaration) (el_aux (pd_state p)))

;; (fn NAME BINDERS RET (measure M)? BODY)
(fn read_predef ((sc Scope) (env CheckedEnv) (s SExpr) (callees (List Callee))) PdRes
  (match s
    ((SList (Cons _ (Cons (SSym x) (Cons (SList bs) (Cons ret rest)))))
     (match (name_of_sym x)
       (None (PdErr (quote bad_name) (chars_of_sym x)))
       ((Some short)
        (match (fn_body rest)
          (None (PdErr (quote bad_shape) "(fn NAME ((x TYPE)…) RET (measure M)? BODY)"))
          ((Some body)
           (let ((n (qualify sc short)))
             (match (fn_binders (el_with_etype (el0 sc env Nil Nil n) True) bs Nil)
               ((Pair None (Pair r m)) (PdSkip r m))
               ((Pair (Some (Pair e1 fvars)) _)
                (match (elab_type e1 ret)
                  ((EErr r m) (PdSkip r m))
                  ((EOk e2 rt _)
                   (match (close_pis e2 fvars rt)
                     ((Pair _ (FinErr r m)) (PdSkip r m))
                     ((Pair e3 (FinOk T))
                      (if (has_e_literal body) (PdErr (quote no_l_identity) "a symbol or a string literal in the body has no L form before slice 3.17 (rule 6)")
                      (match (fn_rec (el_with_etype e3 False) (fn_measure rest) fvars)
                        ((Pair _ (Left5 r m)) (PdErr r m))
                        ((Pair e3a (Right5 rec))
                         (match (bind_callees e3a env callees Nil)
                           ((Pair _ None) (PdErr (quote no_l_identity) "a callee's signature has no L reading"))
                           ((Pair e3b (Some cls))
                         (match (el_local e3b short T BDefault)
                           ((Pair e4 self)
                            (match (elab e4 body (Some rt))
                              ((EErr r m) (PdErr r m))
                              ((EOk e5 v _)
                               (match (el_finish e5 v)
                                 ((FinErr r m) (PdErr r m))
                                 ((FinOk b) (PdOk (PreDef n T fvars self b e5 rec cls)))))))))))))))))))))))))
    (_ (PdErr (quote bad_shape) "(fn NAME ((x TYPE)…) RET (measure M)? BODY)"))))
;; the body is the last form; a (measure …) may stand before it
(fn fn_body ((rest (List SExpr))) (Option SExpr)
  (match rest
    ((Cons b Nil) (Some b))
    ((Cons (SList (Cons (SSym m) _)) (Cons b Nil)) (if (sym_eq m (quote measure)) (Some b) None))
    (_ None)))
;; each callee's signature elaborated in its own scope — inside this walk, so its terms are
;; this state's — and the name as written bound to a local of that type
(fn bind_callees ((e El) (env CheckedEnv) (cs (List Callee)) (acc (List CalleeLocal))) (Pair El (Option (List CalleeLocal)))
  (measure (struct cs))
  (match cs
    (Nil (Pair e (Some (rev acc))))
    ((Cons (Callee written id csc form) r)
     (match form
       ((SList (Cons _ (Cons _ (Cons (SList bs) (Cons ret _)))))
        (match (fn_binders (el_with_etype (el_set_cx e (cx0 csc env Nil Nil)) True) bs Nil)
          ((Pair None _) (Pair e None))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 ret)
             ((EErr _ _) (Pair e None))
             ((EOk e2 rt _)
              (match (close_pis e2 fvars rt)
                ((Pair _ (FinErr _ _)) (Pair e None))
                ((Pair e3 (FinOk T))
                 (match (el_local (el_set_cx e3 (el_cx e)) written T BDefault)
                   ((Pair e4 fv) (bind_callees e4 env r (Cons (CalleeLocal fv id (sort_flags (el_w e3) fvars)) acc)))))))))))
       (_ (Pair e None))))))
(fn sort_flags ((w W) (fvs (List Expr))) (List Bool)
  (measure (struct fvs))
  (match fvs
    (Nil Nil)
    ((Cons fv r) (Cons (match (w_local_type w (fvar_id_of fv)) ((Some (Sort _ _)) False) (_ True)) (sort_flags w r)))))
;; a `(quote S)` or a "…" anywhere in the body: E's Symbol and byte-list literals (slice 3.17)
(fn has_e_literal ((s SExpr)) Bool
  (measure (struct s))
  (match s
    ((SStr _) True)
    ((SList (Cons (SSym h) r)) (if (sym_eq h (quote quote)) True (any_e_literal r)))
    ((SList xs) (any_e_literal xs))
    (_ False)))
(fn any_e_literal ((xs (List SExpr))) Bool
  (measure (struct xs))
  (match xs (Nil False) ((Cons x r) (bool_or (has_e_literal x) (any_e_literal r)))))
;; the clause before the body, if any
(fn fn_measure ((rest (List SExpr))) (Option SExpr)
  (match rest ((Cons (SList (Cons _ (Cons m Nil))) (Cons _ Nil)) (Some m)) (_ None)))
;; `(struct x)` names a binder; anything else is a term over the binders
(type Either5 (Left5 Symbol (List Int)) (Right5 PdRec))
(fn fn_rec ((e El) (m (Option SExpr)) (fvars (List Expr))) (Pair El Either5)
  (match m
    (None (Pair e (Right5 PdNone)))
    ((Some (SList (Cons (SSym s) (Cons (SSym x) Nil))))
     (if (sym_eq s (quote struct))
       (match (elab e (SSym x) None)
         ((EOk e1 (FVar d id) _) (if (mem_int id (pd_fvar_ids fvars)) (Pair e1 (Right5 (PdStruct (FVar d id)))) (Pair e (Left5 (quote bad_measure) (append (chars_of_sym x) " is not a parameter")))))
         (_ (Pair e (Left5 (quote bad_measure) (append (chars_of_sym x) " is not a parameter")))))
       (fn_rec_term e (SList (Cons (SSym s) (Cons (SSym x) Nil))))))
    ((Some t) (fn_rec_term e t))))
(fn fn_rec_term ((e El) (m SExpr)) (Pair El Either5)
  (match (elab e m None)
    ((EErr r msg) (Pair e (Left5 r msg)))
    ((EOk e1 v _)
     (match (el_finish e1 v)
       ((FinErr r msg) (Pair e (Left5 r msg)))
       ((FinOk mv) (Pair e1 (Right5 (PdMeasure mv))))))))
(fn pd_fvar_ids ((fvs (List Expr))) (List Int)
  (measure (struct fvs))
  (match fvs (Nil Nil) ((Cons fv r) (Cons (fvar_id_of fv) (pd_fvar_ids r)))))
;; a fn's binders: a `(T Type)` binder is implicit in the L signature, as a `type`'s
;; parameters are in its constructors (slice 3.15), the data binders explicit
(fn fn_binders ((e El) (bs (List SExpr)) (acc (List Expr))) (Pair (Option (Pair El (List Expr))) (Pair Symbol (List Int)))
  (measure (struct bs))
  (match bs
    (Nil (Pair (Some (Pair e (rev acc))) (Pair (quote none) Nil)))
    ((Cons (SList (Cons (SSym x) (Cons ty Nil))) r)
     (match (name_of_sym x)
       (None (Pair None (Pair (quote bad_name) (chars_of_sym x))))
       ((Some n)
        (match (elab_type e ty)
          ((EErr r2 m) (Pair None (Pair r2 m)))
          ((EOk e1 t _)
           (match (el_local e1 n t (if (is_sort t) BImplicit BDefault))
             ((Pair e2 fv) (fn_binders e2 r (Cons fv acc)))))))))
    (_ (Pair None (Pair (quote bad_binder) "a fn's binder is (x TYPE)")))))
