;;; v3/kernel/predef.shard — the pre-definition.
;;; A `fn` form elaborated **once**, by elab.shard, into a named
;;; record: the declared identity and type, the binders' locals, the **self-local** — the
;;; function's own name bound to a local of the declared type, so a body that calls itself
;;; is an ordinary L term —, the body over them, and the elaboration state that made it
;;; (the walk with the locals and the matchers already checked into its environment, which
;;; the projections continue in). Its two projections consume the record and re-read
;;; nothing: the erasure toward E (erasure.shard's `erase_predef`), the compilation toward
;;; K (define.shard).
;;;
;;; A PreDef is never an admitted declaration: a body well typed *assuming* a local for its
;;; own name is provisional until the K projection admits it, and nothing here produces a
;;; `Declaration` for the owner — only the matchers it generated (`pd_aux`), which K has
;;; checked. `PdSkip` is a signature with no L reading (the function never enters the
;;; route); `PdErr` is a refusal on the route.

(import "reader.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.kw)
(use kernel.decl)
(use kernel.elab)
(use kernel.expr)
(use kernel.name)
(use kernel.reader)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.elab.El)
(use kernel.kw.W)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.elab.Gen)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)

;; the recursion clause as read: none; `(measure (struct x))` — the structural binder's local;
;; `(measure M)` — M elaborated over the binders (K's projection wants a Nat: define.shard)
(type PdRec (PdNone) (PdStruct Expr) (PdMeasure Expr))
;; identity, the declared type (closed), the binders' locals in order, the self-local, the
;; body over them (finished: no metavariable), the state, the recursion clause, the callee-locals
;; a RUNNABLE callee — a function with a program and no K constant — stands in a body as a
;; local of its signature's type: the name as the body writes it, its identity, the
;; scope its form was read in, the form
(type Callee (Callee Name Name Scope SExpr))
;; a callee-local: the local, the callee's identity, its binders' runtime flags (a type binder False)
(type CalleeLocal (CalleeLocal Expr Name (List Bool)))
(type PreDef (PreDef Name Expr (List Expr) Expr Expr El PdRec (List CalleeLocal)))
(type PdRes (PdOk PreDef) (PdSkip Symbol (List Int)) (PdErr Symbol (List Int)))
(fn pd_name ((p PreDef)) Name
  (match p
    ((PreDef n _ _ _ _ _ _ _) n)))
(fn pd_type ((p PreDef)) Expr
  (match p
    ((PreDef _ t _ _ _ _ _ _) t)))
(fn pd_binders ((p PreDef)) (List Expr)
  (match p
    ((PreDef _ _ bs _ _ _ _ _) bs)))
(fn pd_self ((p PreDef)) Expr
  (match p
    ((PreDef _ _ _ s _ _ _ _) s)))
(fn pd_body ((p PreDef)) Expr
  (match p
    ((PreDef _ _ _ _ b _ _ _) b)))
(fn pd_state ((p PreDef)) El
  (match p
    ((PreDef _ _ _ _ _ e _ _) e)))
(fn pd_rec ((p PreDef)) PdRec
  (match p
    ((PreDef _ _ _ _ _ _ r _) r)))
(fn pd_callees ((p PreDef)) (List CalleeLocal)
  (match p
    ((PreDef _ _ _ _ _ _ _ c) c)))
(fn pd_aux ((p PreDef)) (List Declaration) (el_aux (pd_state p)))

;; (fn NAME BINDERS RET (measure M)? BODY)
(fn read_predef ((sc Scope) (env CheckedEnv) (s SExpr) (callees (List Callee))) PdRes
  (read_predef_from none sc env s callees))
;; the state a pre-definition is read in: a fresh one over the environment, or the one another
;; pre-definition left — its walk (the locals, the matchers checked into its environment), its
;; metavariables and the declarations it generated, under a new owner. The members of a group
;; are read one after the other this way, so their terms are one walk's and K's
;; projection builds one term over all of them (define.shard define_group)
(fn el_from ((base (Option El)) (sc Scope) (env CheckedEnv) (n Name)) El
  (match base
    (none (el0 sc env nil nil n))
    ((some e) (El (el_w e) (el_mc e) (cx0 sc (el_env e) nil nil) (Gen n 1 (el_aux e))))))
(fn read_predef_from
  ((base (Option El)) (sc Scope) (env CheckedEnv) (s SExpr) (callees (List Callee)))
  PdRes
  (match s
    ((SList (cons _ (cons (SSym x) (cons (SList bs) (cons ret rest)))))
     (match (name_of_sym x)
       (none (PdErr (quote bad_name) (chars_of_sym x)))
       ((some short)
        (match (fn_body rest)
          (none (PdErr (quote bad_shape) "(fn NAME ((x TYPE)…) RET (measure M)? BODY)"))
          ((some body)
           (let ((n (qualify sc short)))
             (match (fn_binders (el_with_etype (el_from base sc env n) true) bs nil)
               ((Prod.mk none (Prod.mk r m)) (PdSkip r m))
               ((Prod.mk (some (Prod.mk e1 fvars)) _)
                (match (elab_type e1 ret)
                  ((EErr r m) (PdSkip r m))
                  ((EOk e2 rt _)
                   (match (close_pis e2 fvars rt)
                     ((Prod.mk _ (FinErr r m)) (PdSkip r m))
                     ((Prod.mk e3 (FinOk T))
                      (if (has_quote body)
                        (PdErr (quote no_l_identity) "a symbol in the body has no L form")
                        (match (fn_rec (el_with_etype e3 false) (fn_measure rest) fvars)
                          ((Prod.mk _ (Left5 r m)) (PdErr r m))
                          ((Prod.mk e3a (Right5 rec))
                           (match (bind_callees e3a env callees nil)
                             ((Prod.mk _ none)
                              (PdErr (quote no_l_identity) "a callee's signature has no L reading"))
                             ((Prod.mk e3b (some cls))
                              (match (el_local e3b short T BDefault)
                                ((Prod.mk e4 self)
                                 (match (elab e4 body (some rt))
                                   ((EErr r m) (PdErr r m))
                                   ((EOk e5 v _)
                                    (match (el_finish e5 v)
                                      ((FinErr r m) (PdErr r m))
                                      ((FinOk b) (PdOk (PreDef n T fvars self b e5 rec cls)))))))))))))))))))))))))
    (_ (PdErr (quote bad_shape) "(fn NAME ((x TYPE)…) RET (measure M)? BODY)"))))
;; the body is the last form; a (measure …) may stand before it
(fn fn_body ((rest (List SExpr))) (Option SExpr)
  (match rest
    ((cons b nil) (some b))
    ((cons (SList (cons (SSym m) _)) (cons b nil)) (if (sym_eq m (quote measure)) (some b) none))
    (_ none)))
;; each callee's signature elaborated in its own scope — inside this walk, so its terms are
;; this state's — and the name as written bound to a local of that type
(fn bind_callees ((e El) (env CheckedEnv) (cs (List Callee)) (acc (List CalleeLocal)))
  (Prod El (Option (List CalleeLocal)))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk e (some (rev acc))))
    ((cons (Callee written id csc form) r)
     (match form
       ((SList (cons _ (cons _ (cons (SList bs) (cons ret _)))))
        (match (fn_binders (el_with_etype (el_set_cx e (cx0 csc env nil nil)) true) bs nil)
          ((Prod.mk none _) (Prod.mk e none))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ret)
             ((EErr _ _) (Prod.mk e none))
             ((EOk e2 rt _)
              (match (close_pis e2 fvars rt)
                ((Prod.mk _ (FinErr _ _)) (Prod.mk e none))
                ((Prod.mk e3 (FinOk T))
                 (match (el_local (el_set_cx e3 (el_cx e)) written T BDefault)
                   ((Prod.mk e4 fv)
                    (bind_callees e4 env r
                      (cons (CalleeLocal fv id (sort_flags (el_w e3) fvars)) acc)))))))))))
       (_ (Prod.mk e none))))))
(fn sort_flags ((w W) (fvs (List Expr))) (List Bool)
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r)
     (cons
       (match (w_local_type w (fvar_id_of fv))
         ((some (Sort _ _)) false)
         (_ true))
       (sort_flags w r)))))
;; a `(quote S)` anywhere in the body: E's Symbol literal, which has no L reading
(fn has_quote ((s SExpr)) Bool
  (measure (struct s))
  (match s
    ((SList (cons (SSym h) r)) (if (sym_eq h (quote quote)) true (any_quote r)))
    ((SList xs) (any_quote xs))
    (_ false)))
(fn any_quote ((xs (List SExpr))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (bool_or (has_quote x) (any_quote r)))))
;; the clause before the body, if any
(fn fn_measure ((rest (List SExpr))) (Option SExpr)
  (match rest
    ((cons (SList (cons _ (cons m nil))) (cons _ nil)) (some m))
    (_ none)))
;; `(struct x)` names a binder; anything else is a term over the binders
(type Either5 (Left5 Symbol (List Int)) (Right5 PdRec))
(fn fn_rec ((e El) (m (Option SExpr)) (fvars (List Expr))) (Prod El Either5)
  (match m
    (none (Prod.mk e (Right5 PdNone)))
    ((some (SList (cons (SSym s) (cons (SSym x) nil))))
     (if (sym_eq s (quote struct))
       (match (elab e (SSym x) none)
         ((EOk e1 (FVar d id) _)
          (if (mem_int id (pd_fvar_ids fvars)) (Prod.mk e1 (Right5 (PdStruct (FVar d id))))
          (Prod.mk e (Left5 (quote bad_measure) (append (chars_of_sym x) " is not a parameter")))))
         (_ (Prod.mk e (Left5 (quote bad_measure) (append (chars_of_sym x) " is not a parameter")))))
       (fn_rec_term e (SList (cons (SSym s) (cons (SSym x) nil))))))
    ((some t) (fn_rec_term e t))))
(fn fn_rec_term ((e El) (m SExpr)) (Prod El Either5)
  (match (elab e m none)
    ((EErr r msg) (Prod.mk e (Left5 r msg)))
    ((EOk e1 v _)
     (match (el_finish e1 v)
       ((FinErr r msg) (Prod.mk e (Left5 r msg)))
       ((FinOk mv) (Prod.mk e1 (Right5 (PdMeasure mv))))))))
(fn pd_fvar_ids ((fvs (List Expr))) (List Int)
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r) (cons (fvar_id_of fv) (pd_fvar_ids r)))))
;; a fn's binders: a `(T Type)` binder is implicit in the L signature, as a `type`'s
;; parameters are in its constructors, the data binders explicit
(fn fn_binders ((e El) (bs (List SExpr)) (acc (List Expr)))
  (Prod (Option (Prod El (List Expr))) (Prod Symbol (List Int)))
  (measure (struct bs))
  (match bs
    (nil (Prod.mk (some (Prod.mk e (rev acc))) (Prod.mk (quote none) nil)))
    ((cons (SList (cons (SSym x) (cons ty nil))) r)
     (match (name_of_sym x)
       (none (Prod.mk none (Prod.mk (quote bad_name) (chars_of_sym x))))
       ((some n)
        (match (elab_type e ty)
          ((EErr r2 m) (Prod.mk none (Prod.mk r2 m)))
          ((EOk e1 t _)
           (match (el_local e1 n t (if (is_sort t) BImplicit BDefault))
             ((Prod.mk e2 fv) (fn_binders e2 r (cons fv acc)))))))))
    (_ (Prod.mk none (Prod.mk (quote bad_binder) "a fn's binder is (x TYPE)")))))
