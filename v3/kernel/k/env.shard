;;; v3/kernel/k/env.shard — environments, raw versus checked, and outcomes.
;;;
;;; FOUNDATION §3.3, §3.5. Reconciled against src/kernel/environment.cpp
;;; (v4.33.1). Phase 1 replaces the association list by a map keyed on
;;; Name; the interface stays.

(import "../decl.shard")
(import "../intmap.shard")
(import "../verdict.shard")
(use kernel.decl)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.name)
(use kernel.prelude)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Pair)

;; The raw side is whatever a client or the import built — a Declaration and its
;; terms, public data (decl.shard, expr.shard). `check` validates it in order (§3.5)
;; and produces a CheckedEnv, which is a different type — never forgeable from a
;; similarly shaped record or a deserialized receipt; its constructor is sealed
;; behind kernel/k's view (§6.6, §13 item 26).

(type CheckedEnv (CheckedEnv (IntMap (List (Pair Name ConstantInfo))) Bool (List Name) Int))   ; entries by name hash, quotInitialized, pinned identities (§3.2), node-id watermark
;; the empty checked environment — the one way in from outside the seal (§13 item 26)
(fn env_empty () CheckedEnv (CheckedEnv IMEmpty False Nil 0))
;; Invariant (K-internal, established only by admission): every entry
;; passed `check` against the entries before it; names are unique;
;; quotInitialized is set only by QuotDecl admission; every node reachable
;; from an entry has an id below the watermark (expr.shard: identity), and
;; a check mints its ids from max(watermark, the caller's St) and writes
;; the final counter back.

;; FIXED-IDENTITY ACCELERATORS (§3.2): the Nat operations of
;; expr.shard's reduce_nat are bound at admission of `Nat.add` etc. to
;; the admitted declaration's identity (name AND checked signature AND
;; defining equations validated against the export); a same-spelled
;; non-core `Nat.add` (T0's battery) never reaches the shortcut.
