;;; v3/kernel/k/env.shard — environments, raw versus checked.
;;;
;;; Reconciled against src/kernel/environment.cpp (v4.33.1).

(import "../decl.shard")
(import "../intmap.shard")
(import "../verdict.shard")
(use kernel.decl)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.name)
(use kernel.prelude)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Pair)

;; The raw side is whatever a client or the import built — a Declaration and its
;; terms, public data (decl.shard, expr.shard). `check` validates it in order
;; and produces a CheckedEnv, which is a different type — never forgeable from a
;; similarly shaped record or a deserialized receipt; its constructor is sealed
;; behind kernel/k's view.

(type CheckedEnv (CheckedEnv (IntMap (List (Pair Name ConstantInfo))) Bool (List Name) Int))  ; entries by name hash, quotInitialized, pinned identities, node-id watermark
;; the empty checked environment — the one way in from outside the seal
(fn env_empty () CheckedEnv (CheckedEnv IMEmpty False Nil 0))
;; Invariant (K-internal, established only by admission): every entry
;; passed `check` against the entries before it; names are unique;
;; quotInitialized is set only by QuotDecl admission; every node reachable
;; from an entry has an id at most the watermark (expr.shard: identity), and
;; a check mints its ids from max(watermark, the caller's St) and writes
;; the final counter back. No operation joins two environments or moves a
;; run's tables onto another's (docs/KERNEL.md "The state discipline"):
;; two environments that fork from one reuse ids for different
;; nodes, and a term crosses between them only as a raw declaration,
;; rebuilt (add.shard `check`), or as record text.

;; FIXED-IDENTITY ACCELERATORS: the Nat operations of
;; expr.shard's reduce_nat are bound at admission of `Nat.add` etc. to
;; the admitted declaration's identity (its closure equal to the reference
;; rows generated from the export: add.shard `pin_if_matches`); a same-spelled
;; non-core `Nat.add` (the hostile battery, case 7) never reaches the shortcut.
