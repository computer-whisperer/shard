;;; v3/kernel/k/axioms.shard — axiom closures (an axiom is
;;; TRACKED, any axiom beyond the standard profile is an assumption-policy
;;; matter above K, reported in the receipt; the replay gate compares K's
;;; closures with the oracle's).
;;;
;;; The relation is src/Lean/Util/CollectAxioms.lean at v4.33.1: an axiom
;;; contributes itself and its type's constants; a definition, theorem or
;;; opaque its type's and value's; a quotient nothing; a constructor and a
;;; recursor their type's; an inductive its type's and its constructors. The
;;; closure is the transitive reachability of that relation — the least
;;; fixpoint, NOT Lean's memoized walk: that walk plants a sentinel for the
;;; constant in progress, so an inductive's cached closure depends on whether
;;; it or one of its constructors was visited first (an order-dependent cache
;;; the oracle script v3/axioms.lean also avoids).
;;;
;;; A checked environment is append-only and every constant references only
;;; earlier ones, except inside one inductive block: a constructor's type
;;; names its type, the type's edges are its constructors. Those blocks are
;;; the only cycles, and `block_closures` resolves a block as a unit — each
;;; member's closure is the union, over the members it reaches inside the
;;; block, of their contributions through edges leaving the block. Everything
;;; else is memoized directly; asked in admission order (t0.shard) the
;;; recursion never goes deeper than one block.

(import "tc.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.descent)
(use kernel.expr)
(use kernel.intmap)
(use kernel.name)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.k.CheckedEnv)
(use kernel.intmap.IntMap)

;; the memo: name key → bucket of (name, closure); a cache of a pure function
;; of the checked environment, kept OUTSIDE it (cache policy is distinct
;; from authoritative state)
(type AxMemo (AxMemo (IntMap (List (Prod Name (List Name))))))

(fn ax_memo_empty () AxMemo (AxMemo IMEmpty))

(fn ax_bucket_find ((b (List (Prod Name (List Name)))) (n Name)) (Option (List Name))
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk k v) r) (if (name_eq k n) (some v) (ax_bucket_find r n)))))

(fn ax_find ((m AxMemo) (n Name)) (Option (List Name))
  (match m
    ((AxMemo t)
     (match (im_find t (env_key n))
       (none none)
       ((some b) (ax_bucket_find b n))))))

(fn ax_put ((m AxMemo) (n Name) (axs (List Name))) AxMemo
  (match m
    ((AxMemo t)
     (let ((k (env_key n)))
       (AxMemo
         (im_insert t k
           (cons (Prod.mk n axs)
             (match (im_find t k)
               ((some b) b)
               (none nil)))))))))

(fn names_union ((a (List Name)) (b (List Name))) (List Name)
  (measure (struct b))
  (match b
    (nil a)
    ((cons x r) (names_union (if (mem_name x a) a (cons x a)) r))))

;; the constants a term cites: expr.shard `expr_consts`

;; the relation's direct edges of a constant
(fn ci_used ((i ConstantInfo)) (List Name)
  (match i
    ((QuotInfo _ _) nil)
    ((InductInfo _ _ _ _ ctors _ _ _ _) (append (expr_consts (ci_type i)) ctors))
    (_
      (append (expr_consts (ci_type i))
        (match i
          ((DefnInfo _ val _ _ _) (expr_consts val))
          ((ThmInfo _ val _) (expr_consts val))
          ((OpaqueInfo _ val _ _) (expr_consts val))
          (_ nil))))))

(fn ci_is_axiom ((i ConstantInfo)) Bool
  (match i
    ((AxiomInfo _ _) true)
    (_ false)))

;; ---- inductive blocks -------------------------------------------------------------------

(fn induct_all ((env CheckedEnv) (t Name)) (List Name)
  (match (env_find env t)
    ((some (InductInfo _ _ _ all _ _ _ _ _)) all)
    (_ (cons t nil))))

(fn induct_ctors ((env CheckedEnv) (t Name)) (List Name)
  (match (env_find env t)
    ((some (InductInfo _ _ _ _ ctors _ _ _ _)) ctors)
    (_ nil)))

;; the members of a block: its types and their constructors
(fn block_members ((env CheckedEnv) (all (List Name))) (List Name)
  (measure (struct all))
  (match all
    (nil nil)
    ((cons t r) (append (cons t (induct_ctors env t)) (block_members env r)))))

;; a block edge list: (member, edges inside the block, closure through the edges leaving it)
(type BlockEdges (BlockEdges Name (List Name) (List Name)))

(fn split_edges
  ((used (List Name)) (members (List Name)) (inside (List Name)) (outside (List Name)))
  (Prod (List Name) (List Name))
  (measure (struct used))
  (match used
    (nil (Prod.mk inside outside))
    ((cons u r)
     (if (mem_name u members)
       (split_edges r members (if (mem_name u inside) inside (cons u inside)) outside)
       (split_edges r members inside (cons u outside))))))

;; the members reachable from `front` inside the block, accumulated in `seen`
(fn block_reach ((edges (List BlockEdges)) (front (List Name)) (seen (List Name)) (fuel Int))
  (List Name)
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) seen
  (match front
    (nil seen)
    ((cons n r)
     (if (mem_name n seen) (block_reach edges r seen (- fuel 1))
     (block_reach edges (append (block_inside edges n) r) (cons n seen) (- fuel 1)))))))

(fn block_inside ((edges (List BlockEdges)) (n Name)) (List Name)
  (measure (struct edges))
  (match edges
    (nil nil)
    ((cons (BlockEdges m ins _) r) (if (name_eq m n) ins (block_inside r n)))))
(fulfills block_reach.dec_1 (by (intro p h n r hm hs) (apply natAbs_lt (arith) (arith))))
(fulfills block_reach.dec_2 (by (intro p h n r hm hs) (apply natAbs_lt (arith) (arith))))

(fn block_outside_of ((edges (List BlockEdges)) (ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r) (block_outside_of edges r (names_union acc (block_outside edges n))))))

(fn block_outside ((edges (List BlockEdges)) (n Name)) (List Name)
  (measure (struct edges))
  (match edges
    (nil nil)
    ((cons (BlockEdges m _ out) r) (if (name_eq m n) out (block_outside r n)))))

;; ---- closures ----------------------------------------------------------------------------
;; `d` bounds the dependency recursion (a chain longer than the environment is
;; impossible in a checked environment; None = the bound was hit, reported by
;; the caller, never a silent answer)

(fn ax_depth () Int 1000000)

(fn closure_of ((env CheckedEnv) (m AxMemo) (d Int) (n Name)) (Prod AxMemo (Option (List Name)))
  (measure (Int.natAbs (+ d 1)) 0 0)
  (if (< d 0) (Prod.mk m none)
  (match (ax_find m n)
    ((some axs) (Prod.mk m (some axs)))
    (none
      (match (env_find env n)
        (none (Prod.mk m (some nil)))  ; the relation's `none` case: not a constant here, nothing contributed
        ((some i)
         (match i
           ((InductInfo _ _ _ all _ _ _ _ _) (block_closure env m d n (block_members env all)))
           ((CtorInfo _ ind _ _ _ _)
            (block_closure env m d n (block_members env (induct_all env ind))))
           (_
             (match (closures_of env m (- d 1) (ci_used i) (if (ci_is_axiom i) (cons n nil) nil))
               ((Prod.mk m1 none) (Prod.mk m1 none))
               ((Prod.mk m1 (some axs)) (Prod.mk (ax_put m1 n axs) (some axs))))))))))))

(fn closures_of ((env CheckedEnv) (m AxMemo) (d Int) (ns (List Name)) (acc (List Name)))
  (Prod AxMemo (Option (List Name)))
  (measure (Int.natAbs (+ d 1)) 1 (List.length ns))
  (match ns
    (nil (Prod.mk m (some acc)))
    ((cons n r)
     (match (closure_of env m d n)
       ((Prod.mk m1 none) (Prod.mk m1 none))
       ((Prod.mk m1 (some axs)) (closures_of env m1 d r (names_union acc axs)))))))

;; every member's closure at once, then the one asked for
(fn block_closure ((env CheckedEnv) (m AxMemo) (d Int) (n Name) (members (List Name)))
  (Prod AxMemo (Option (List Name)))
  (measure (Int.natAbs (+ (- d 1) 1)) 3 0)
  (match (block_edges env m (- d 1) members members nil)
    ((Prod.mk m1 none) (Prod.mk m1 none))
    ((Prod.mk m1 (some edges))
     (let ((m2 (block_store m1 edges members)))
       (match (ax_find m2 n)
         ((some axs) (Prod.mk m2 (some axs)))
         (none (Prod.mk m2 (some nil))))))))

(fn block_edges
  ((env CheckedEnv)
   (m AxMemo)
   (d Int)
   (members (List Name))
   (todo (List Name))
   (acc (List BlockEdges)))
  (Prod AxMemo (Option (List BlockEdges)))
  (measure (Int.natAbs (+ d 1)) 2 (List.length todo))
  (match todo
    (nil (Prod.mk m (some acc)))
    ((cons n r)
     (match (env_find env n)
       (none (block_edges env m d members r acc))
       ((some i)
        (match (split_edges (ci_used i) members nil nil)
          ((Prod.mk inside outside)
           (match (closures_of env m d outside nil)
             ((Prod.mk m1 none) (Prod.mk m1 none))
             ((Prod.mk m1 (some out_axs))
              (block_edges env m1 d members r (cons (BlockEdges n inside out_axs) acc)))))))))))

(fn block_store ((m AxMemo) (edges (List BlockEdges)) (todo (List Name))) AxMemo
  (measure (struct todo))
  (match todo
    (nil m)
    ((cons n r)
     (let ((reach (block_reach edges (cons n nil) nil (* 4 (len edges)))))
       (block_store (ax_put m n (block_outside_of edges reach nil)) edges r)))))
;; the descent of closure_of and its members, here where the last function they call is declared:
;; depth, rank, length; block_closure steps d untested, so its depth is stated at the d it hands on
(fulfills closure_of.dec_1
  (by
    (intro env m d n hd ha i he a1 a2 a3 all a4 a5 a6 a7 a8 hi)
    (apply Prod.Lex.left (apply natAbs_lt (arith) (arith)))))
(fulfills closure_of.dec_2
  (by
    (intro env m d n hd ha i he a1 ind a2 a3 a4 a5 hi)
    (apply Prod.Lex.left (apply natAbs_lt (arith) (arith)))))
(fulfills closure_of.dec_3
  (by (intro env m d n hd ha i he a1 hi) (apply Prod.Lex.left (apply natAbs_lt (arith) (arith)))))
(fulfills closures_of.dec_1
  (by (intro env m d ns acc n r h) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills closures_of.dec_2
  (by
    (intro env m d ns acc n r h m1 axs)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills block_closure.dec_1
  (by (intro env m d n members) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills block_edges.dec_1
  (by
    (intro env m d members todo acc n r h he)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills block_edges.dec_2
  (by
    (intro env m d members todo acc n r h i he inside outside hs)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills block_edges.dec_3
  (by
    (intro env m d members todo acc n r h i he inside outside hs m1 oa)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))

;; the API: the closure of a constant of a checked environment
(fn axioms_of ((env CheckedEnv) (m AxMemo) (n Name)) (Prod AxMemo (Option (List Name)))
  (closure_of env m (ax_depth) n))
