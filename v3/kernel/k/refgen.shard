;;; v3/kernel/k/refgen.shard — pins mode's generator (gen_pins.sh, t0.shard
;;; --pins): after the export replay, print the reference table that
;;; accel_pins.shard carries below its marker — every candidate's identity
;;; closure (add.shard `ref_edges`: the candidate and, transitively, each
;;; definition, opaque, axiom and inductive type its type and value cite) as
;;; the L declarations K admitted, spelled with expr.shard's anonymous
;;; constructors. One `REF ` line per generated form (gen_pins.sh strips the
;;; prefix); a `REF-ERROR` line aborts the generation. Generation-only code:
;;; nothing in K's checking path imports this file.

(import "../host.shard")
(import "add.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.descent)
(use kernel.expr)
(use kernel.host)
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.ReducibilityHints)
(use kernel.k.CheckedEnv)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.name.Name)

;; ---- text ---------------------------------------------------------------------------
(fn wr ((s (List Int)) (w World)) World (write s w))
(fn nat_s ((k Int)) (List Int) (show_nat k))

;; a byte list as `(list b …)` or `nil`
(fn ints_s ((bs (List Int))) (List Int)
  (match bs
    (nil (utf8 "nil"))
    (_ (append (utf8 "(list") (append (ints_go bs) (utf8 ")"))))))
(fn ints_go ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (append (utf8 " ") (append (nat_s b) (ints_go r))))))

;; a symbol: `(sym "…")` when every byte is printable ASCII (`"` and `\` escaped), else
;; `(sym_of_chars (list …))` over its bytes
(fn sym_plain ((bs (List Int))) Bool
  (measure (struct bs))
  (match bs
    (nil true)
    ((cons b r) (if (bool_and (<= 32 b) (<= b 126)) (sym_plain r) false))))
(fn esc ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (if (bool_or (= b 34) (= b 92)) (cons 92 (cons b (esc r))) (cons b (esc r))))))
(fn wr_sym ((s Symbol) (w World)) World
  (let ((bs (chars_of_sym s)))
    (if (sym_plain bs) (wr (append (utf8 "(sym \"") (append (esc bs) (utf8 "\")"))) w)
    (wr (append (utf8 "(sym_of_chars ") (append (ints_s bs) (utf8 ")"))) w))))

;; a name by reference: `(rn_H)` with H = hash_name; Anon literally
(fn wr_nref ((n Name) (w World)) World
  (match n
    (Anon (wr (utf8 "Anon") w))
    (_ (wr (append (utf8 "(rn_") (append (nat_s (hash_name n)) (utf8 ")"))) w))))
(fn wr_names ((ns (List Name)) (w World)) World
  (match ns
    (nil (wr (utf8 "nil") w))
    (_ (wr (utf8 ")") (wr_names_go ns (wr (utf8 "(list") w))))))
(fn wr_names_go ((ns (List Name)) (w World)) World
  (measure (struct ns))
  (match ns
    (nil w)
    ((cons n r) (wr_names_go r (wr_nref n (wr (utf8 " ") w))))))

(fn wr_level ((l Level) (w World)) World
  (measure (struct l))
  (match l
    (LZero (wr (utf8 "LZero") w))
    ((LSucc x) (wr (utf8 ")") (wr_level x (wr (utf8 "(LSucc ") w))))
    ((LMax a b) (wr (utf8 ")") (wr_level b (wr (utf8 " ") (wr_level a (wr (utf8 "(LMax ") w))))))
    ((LIMax a b) (wr (utf8 ")") (wr_level b (wr (utf8 " ") (wr_level a (wr (utf8 "(LIMax ") w))))))
    ((LParam n) (wr (utf8 ")") (wr_nref n (wr (utf8 "(LParam ") w))))
    ((LMVar i) (wr (append (utf8 "(LMVar ") (append (nat_s i) (utf8 ")"))) w))))
(fn wr_levels ((ls (List Level)) (w World)) World
  (match ls
    (nil (wr (utf8 "nil") w))
    (_ (wr (utf8 ")") (wr_levels_go ls (wr (utf8 "(list") w))))))
(fn wr_levels_go ((ls (List Level)) (w World)) World
  (measure (struct ls))
  (match ls
    (nil w)
    ((cons l r) (wr_levels_go r (wr_level l (wr (utf8 " ") w))))))

(fn wr_bi ((b BinderInfo) (w World)) World
  (wr
    (match b
      (BDefault (utf8 "BDefault"))
      (BImplicit (utf8 "BImplicit"))
      (BStrictImplicit (utf8 "BStrictImplicit"))
      (BInstImplicit (utf8 "BInstImplicit")))
    w))

;; ---- terms: one `(fn re_K () Expr …)` per distinct node -----------------------------
;; Nodes are numbered by a counter and found by structural equality in a
;; hash bucket: expr.shard's hash is affine in each child, so structurally
;; different Init terms collide on it naturally (`List.cons`'s type against
;; `List α → α → List α`: the inner domains swapped, `List` adding the same
;; constant to each). No generated line nests deeper than a constructor and
;; its children (the s-expression reader has a depth limit).
(type RefSt (RefSt (IntMap (List (Prod Expr Int))) Int))  ; numbered nodes by hash bucket; the next number

(fn ref_st0 () RefSt (RefSt IMEmpty 1))
(fn ref_lookup ((st RefSt) (e Expr)) (Option Int)
  (match st
    ((RefSt m _)
     (match (im_find m (hash_expr e))
       ((some b) (ref_assoc e b))
       (none none)))))
(fn ref_assoc ((e Expr) (b (List (Prod Expr Int)))) (Option Int)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk x k) r) (if (expr_eq x e) (some k) (ref_assoc e r)))))
(fn ref_number ((st RefSt) (e Expr)) (Prod RefSt Int)
  (match st
    ((RefSt m k)
     (let ((h (hash_expr e)))
       (Prod.mk
         (RefSt
           (im_insert m h
             (cons (Prod.mk e k)
               (match (im_find m h)
                 ((some b) b)
                 (none nil))))
           (+ k 1))
         k)))))

(fn wr_eref ((st RefSt) (e Expr) (w World)) World
  (match (ref_lookup st e)
    ((some k) (wr (append (utf8 "(re_") (append (nat_s k) (utf8 ")"))) w))
    (none (write_line (utf8 "REF-ERROR unnumbered node") w))))

;; one node with the anonymous constructor and its children by reference
(fn wr_node ((st RefSt) (e Expr) (w World)) World
  (match e
    ((BVar _ i) (wr (append (utf8 "(mk_bvar ") (append (nat_s i) (utf8 ")"))) w))
    ((FVar _ i) (wr (append (utf8 "(mk_fvar ") (append (nat_s i) (utf8 ")"))) w))
    ((Sort _ u) (wr (utf8 ")") (wr_level u (wr (utf8 "(mk_sort ") w))))
    ((Const _ n ls)
     (wr (utf8 ")") (wr_levels ls (wr (utf8 " ") (wr_nref n (wr (utf8 "(mk_const ") w))))))
    ((App _ f a)
     (wr (utf8 ")") (wr_eref st a (wr (utf8 " ") (wr_eref st f (wr (utf8 "(mk_app ") w))))))
    ((Lam _ n bi d b)
     (wr (utf8 ")")
       (wr_eref st b
         (wr (utf8 " ")
           (wr_eref st d
             (wr (utf8 " ") (wr_bi bi (wr (utf8 " ") (wr_nref n (wr (utf8 "(mk_lam ") w))))))))))
    ((Pi _ n bi d b)
     (wr (utf8 ")")
       (wr_eref st b
         (wr (utf8 " ")
           (wr_eref st d
             (wr (utf8 " ") (wr_bi bi (wr (utf8 " ") (wr_nref n (wr (utf8 "(mk_pi ") w))))))))))
    ((Let _ n t v b)
     (wr (utf8 ")")
       (wr_eref st b
         (wr (utf8 " ")
           (wr_eref st v
             (wr (utf8 " ") (wr_eref st t (wr (utf8 " ") (wr_nref n (wr (utf8 "(mk_let ") w))))))))))
    ((Lit _ (LitNat k)) (wr (append (utf8 "(mk_lit (LitNat ") (append (nat_s k) (utf8 "))"))) w))
    ((Lit _ (LitStr bs)) (wr (append (utf8 "(mk_lit (LitStr ") (append (ints_s bs) (utf8 "))"))) w))
    ((MVar _ i) (wr (append (utf8 "(mk_mvar ") (append (nat_s i) (utf8 ")"))) w))
    ((Proj _ s i x)
     (wr (utf8 ")")
       (wr_eref st x
         (wr (utf8 " ") (wr (nat_s i) (wr (utf8 " ") (wr_nref s (wr (utf8 "(mk_proj ") w))))))))))

;; the node definitions of a term, children first, each distinct node once
(fn wr_expr_defs ((e Expr) (st RefSt) (w World)) (Prod RefSt World)
  (measure (struct e))
  (match (ref_lookup st e)
    ((some _) (Prod.mk st w))
    (none
      (match (wr_expr_children e st w)
        ((Prod.mk st1 w1)
         (match (ref_number st1 e)
           ((Prod.mk st2 k)
            (Prod.mk st2
              (write_line (utf8 ")")
                (wr_node st2 e
                  (wr (append (utf8 "REF (fn re_") (append (nat_s k) (utf8 " () Expr "))) w1)))))))))))
(fn wr_expr_children ((e Expr) (st RefSt) (w World)) (Prod RefSt World)
  (measure (struct e))
  (match e
    ((App _ f a)
     (match (wr_expr_defs f st w)
       ((Prod.mk s1 w1) (wr_expr_defs a s1 w1))))
    ((Lam _ _ _ d b)
     (match (wr_expr_defs d st w)
       ((Prod.mk s1 w1) (wr_expr_defs b s1 w1))))
    ((Pi _ _ _ d b)
     (match (wr_expr_defs d st w)
       ((Prod.mk s1 w1) (wr_expr_defs b s1 w1))))
    ((Let _ _ t v b)
     (match (wr_expr_defs t st w)
       ((Prod.mk s1 w1)
        (match (wr_expr_defs v s1 w1)
          ((Prod.mk s2 w2) (wr_expr_defs b s2 w2))))))
    ((Proj _ _ _ x) (wr_expr_defs x st w))
    (_ (Prod.mk st w))))
(fn wr_exprs_defs ((es (List Expr)) (st RefSt) (w World)) (Prod RefSt World)
  (measure (struct es))
  (match es
    (nil (Prod.mk st w))
    ((cons e r)
     (match (wr_expr_defs e st w)
       ((Prod.mk s1 w1) (wr_exprs_defs r s1 w1))))))

;; every term a row spells: its type and value; an inductive block's types and constructor types
(fn row_exprs ((env CheckedEnv) (info ConstantInfo)) (List Expr)
  (match info
    ((DefnInfo cv v _ _ _) (list (cv_type cv) v))
    ((OpaqueInfo cv v _ _) (list (cv_type cv) v))
    ((AxiomInfo cv _) (list (cv_type cv)))
    ((InductInfo _ _ _ all _ _ _ _ _) (block_exprs env all))
    (_ nil)))
(fn block_exprs ((env CheckedEnv) (all (List Name))) (List Expr)
  (measure (struct all))
  (match all
    (nil nil)
    ((cons t r)
     (append
       (match (env_find env t)
         ((some (InductInfo cv _ _ _ ctors _ _ _ _)) (cons (cv_type cv) (ctor_exprs env ctors)))
         (_ nil))
       (block_exprs env r)))))
(fn ctor_exprs ((env CheckedEnv) (cs (List Name))) (List Expr)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r)
     (match (env_find env c)
       ((some info) (cons (ci_type info) (ctor_exprs env r)))
       (none (ctor_exprs env r))))))
(fn wr_rows_exprs ((env CheckedEnv) (ns (List Name)) (st RefSt) (w World)) (Prod RefSt World)
  (measure (struct ns))
  (match ns
    (nil (Prod.mk st w))
    ((cons n r)
     (match (env_find env n)
       (none (wr_rows_exprs env r st w))
       ((some info)
        (match (wr_exprs_defs (row_exprs env info) st w)
          ((Prod.mk s1 w1) (wr_rows_exprs env r s1 w1))))))))

(fn wr_cval ((st RefSt) (cv ConstantVal) (w World)) World
  (wr (utf8 ")")
    (wr_eref st (cv_type cv)
      (wr (utf8 " ")
        (wr_names (cv_lparams cv)
          (wr (utf8 " ") (wr_nref (cv_name cv) (wr (utf8 "(ConstantVal ") w))))))))
(fn wr_hints ((h ReducibilityHints) (w World)) World
  (match h
    (HOpaque (wr (utf8 "HOpaque") w))
    (HAbbrev (wr (utf8 "HAbbrev") w))
    ((HRegular k) (wr (append (utf8 "(HRegular ") (append (nat_s k) (utf8 ")"))) w))))

;; the constructors of one inductive type, by name from the checked environment
(fn wr_ctors ((env CheckedEnv) (st RefSt) (cs (List Name)) (w World)) World
  (match cs
    (nil (wr (utf8 "nil") w))
    (_ (wr (utf8 ")") (wr_ctors_go env st cs (wr (utf8 "(list") w))))))
(fn wr_ctors_go ((env CheckedEnv) (st RefSt) (cs (List Name)) (w World)) World
  (measure (struct cs))
  (match cs
    (nil w)
    ((cons c r)
     (wr_ctors_go env st r
       (match (env_find env c)
         ((some info)
          (wr (utf8 ")")
            (wr_eref st (ci_type info) (wr (utf8 " ") (wr_nref c (wr (utf8 " (Constructor ") w))))))
         (none (write_line (utf8 "REF-ERROR constructor missing from the environment") w)))))))
(fn wr_induct_types ((env CheckedEnv) (st RefSt) (all (List Name)) (w World)) World
  (measure (struct all))
  (match all
    (nil w)
    ((cons t r)
     (wr_induct_types env st r
       (match (env_find env t)
         ((some (InductInfo cv _ _ _ ctors _ _ _ _))
          (wr (utf8 ")")
            (wr_ctors env st ctors
              (wr (utf8 " ")
                (wr_eref st (cv_type cv)
                  (wr (utf8 " ") (wr_nref t (wr (utf8 " (InductiveType ") w))))))))
         (_ (write_line (utf8 "REF-ERROR inductive block member missing") w)))))))

;; one reference row: `(fn rd_H () Declaration …)`
(fn wr_decl ((env CheckedEnv) (st RefSt) (c Name) (info ConstantInfo) (w World)) World
  (let
    ((w1
       (wr (append (utf8 "REF (fn rd_") (append (nat_s (hash_name c)) (utf8 " () Declaration "))) w)))
    (match info
      ((DefnInfo cv v h _ all)
       (write_line (utf8 "))")
         (wr_names all
           (wr (utf8 " Safe ")
             (wr_hints h
               (wr (utf8 " ")
                 (wr_eref st v (wr (utf8 " ") (wr_cval st cv (wr (utf8 "(DefnDecl ") w1))))))))))
      ((OpaqueInfo cv v _ all)
       (write_line (utf8 "))")
         (wr_names all
           (wr (utf8 " false ")
             (wr_eref st v (wr (utf8 " ") (wr_cval st cv (wr (utf8 "(OpaqueDecl ") w1))))))))
      ((AxiomInfo cv _) (write_line (utf8 " false))") (wr_cval st cv (wr (utf8 "(AxiomDecl ") w1))))
      ((InductInfo cv np _ all _ _ _ _ _)
       (write_line (utf8 ") false))")
         (wr_induct_types env st all
           (wr (utf8 " (list")
             (wr (nat_s np) (wr (utf8 " ") (wr_names (cv_lparams cv) (wr (utf8 "(InductDecl ") w1))))))))
      (_ (write_line (utf8 "REF-ERROR not a reference kind") w1)))))

;; ---- the names table ----------------------------------------------------------------
;; every name the rows cite, keyed by hash_name (a bucket of two = a collision,
;; reported); a name brings its prefixes
(fn name_prefix ((n Name)) Name
  (match n
    (Anon Anon)
    ((Str p _) p)
    ((Num p _) p)))
(fn seen_add ((s (IntMap (List Name))) (n Name)) (IntMap (List Name))
  (measure (struct n))
  (match n
    (Anon s)
    (_
      (let ((h (hash_name n)))
        (match (im_find s h)
          ((some b) (if (mem_name n b) s (im_insert s h (cons n b))))
          (none (seen_add (im_insert s h (cons n nil)) (name_prefix n))))))))
(fn seen_names ((s (IntMap (List Name))) (ns (List Name))) (IntMap (List Name))
  (measure (struct ns))
  (match ns
    (nil s)
    ((cons n r) (seen_names (seen_add s n) r))))
(fn seen_level ((s (IntMap (List Name))) (l Level)) (IntMap (List Name))
  (measure (struct l))
  (match l
    (LZero s)
    ((LSucc x) (seen_level s x))
    ((LMax a b) (seen_level (seen_level s a) b))
    ((LIMax a b) (seen_level (seen_level s a) b))
    ((LParam n) (seen_add s n))
    ((LMVar _) s)))
(fn seen_levels ((s (IntMap (List Name))) (ls (List Level))) (IntMap (List Name))
  (measure (struct ls))
  (match ls
    (nil s)
    ((cons l r) (seen_levels (seen_level s l) r))))
(fn seen_expr ((s (IntMap (List Name))) (e Expr)) (IntMap (List Name))
  (measure (struct e))
  (match e
    ((Sort _ u) (seen_level s u))
    ((Const _ n ls) (seen_levels (seen_add s n) ls))
    ((App _ f a) (seen_expr (seen_expr s f) a))
    ((Lam _ n _ d b) (seen_expr (seen_expr (seen_add s n) d) b))
    ((Pi _ n _ d b) (seen_expr (seen_expr (seen_add s n) d) b))
    ((Let _ n t v b) (seen_expr (seen_expr (seen_expr (seen_add s n) t) v) b))
    ((Proj _ n _ x) (seen_expr (seen_add s n) x))
    (_ s)))
(fn seen_cval ((s (IntMap (List Name))) (cv ConstantVal)) (IntMap (List Name))
  (seen_expr (seen_names (seen_add s (cv_name cv)) (cv_lparams cv)) (cv_type cv)))
(fn seen_ctors ((env CheckedEnv) (s (IntMap (List Name))) (cs (List Name))) (IntMap (List Name))
  (measure (struct cs))
  (match cs
    (nil s)
    ((cons c r)
     (seen_ctors env
       (match (env_find env c)
         ((some info) (seen_cval s (ci_val info)))
         (none s))
       r))))
(fn seen_block ((env CheckedEnv) (s (IntMap (List Name))) (all (List Name))) (IntMap (List Name))
  (measure (struct all))
  (match all
    (nil s)
    ((cons t r)
     (seen_block env
       (match (env_find env t)
         ((some (InductInfo cv _ _ _ ctors _ _ _ _)) (seen_ctors env (seen_cval s cv) ctors))
         (_ s))
       r))))
(fn seen_decl ((env CheckedEnv) (s (IntMap (List Name))) (info ConstantInfo)) (IntMap (List Name))
  (match info
    ((DefnInfo cv v _ _ all) (seen_names (seen_expr (seen_cval s cv) v) all))
    ((OpaqueInfo cv v _ all) (seen_names (seen_expr (seen_cval s cv) v) all))
    ((AxiomInfo cv _) (seen_cval s cv))
    ((InductInfo cv _ _ all _ _ _ _ _) (seen_block env (seen_cval s cv) all))
    (_ s)))
(fn seen_decls ((env CheckedEnv) (s (IntMap (List Name))) (ns (List Name))) (IntMap (List Name))
  (measure (struct ns))
  (match ns
    (nil s)
    ((cons n r)
     (seen_decls env
       (match (env_find env n)
         ((some info) (seen_decl env s info))
         (none s))
       r))))

(fn wr_name_def ((n Name) (w World)) World
  (match n
    (Anon w)
    ((Str p s)
     (write_line (utf8 "))")
       (wr_sym s
         (wr (utf8 " ")
           (wr_nref p
             (wr
               (append (utf8 "REF (fn rn_") (append (nat_s (hash_name n)) (utf8 " () Name (Str ")))
               w))))))
    ((Num p k)
     (write_line (utf8 "))")
       (wr (nat_s k)
         (wr (utf8 " ")
           (wr_nref p
             (wr
               (append (utf8 "REF (fn rn_") (append (nat_s (hash_name n)) (utf8 " () Name (Num ")))
               w))))))))
(fn name_depth ((n Name)) Int
  (measure (struct n))
  (match n
    (Anon 0)
    ((Str p _) (+ 1 (name_depth p)))
    ((Num p _) (+ 1 (name_depth p)))))
(fn bucket_depth ((b (List Name))) Int
  (match b
    ((cons n _) (name_depth n))
    (nil 0)))
(fn names_depth ((m (IntMap (List Name)))) Int
  (measure (struct m))
  (match m
    (IMEmpty 0)
    ((IMLeaf _ b) (bucket_depth b))
    ((IMNode v c0 c1 c2 c3)
     (max_int
       (match v
         ((some b) (bucket_depth b))
         (none 0))
       (max_int (max_int (names_depth c0) (names_depth c1))
         (max_int (names_depth c2) (names_depth c3)))))))
;; the names of d components and more, the shortest first: a name's row cites its prefix's,
;; and no row of the table cites a later one
(fn wr_name_defs ((m (IntMap (List Name))) (d Int) (top Int) (w World)) World
  (measure (Int.natAbs (- (+ top 1) d)))
  (if (< top d) w (wr_name_defs m (+ d 1) top (wr_names_at m d w))))
(fn wr_names_at ((m (IntMap (List Name))) (d Int) (w World)) World
  (measure (struct m))
  (match m
    (IMEmpty w)
    ((IMLeaf _ b) (wr_name_bucket b d w))
    ((IMNode v c0 c1 c2 c3)
     (wr_names_at c3 d
       (wr_names_at c2 d
         (wr_names_at c1 d
           (wr_names_at c0 d
             (match v
               ((some b) (wr_name_bucket b d w))
               (none w)))))))))
(fn wr_name_bucket ((b (List Name)) (d Int) (w World)) World
  (match b
    ((cons n nil) (if (= (name_depth n) d) (wr_name_def n w) w))
    (_ (if (= d 1) (write_line (utf8 "REF-ERROR name hash collision") w) w))))
(fulfills wr_name_defs.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))

;; ---- the closure in dependency order ------------------------------------------------
;; depth-first over `ref_edges`; `done` is the reverse post-order (a constant
;; after everything it cites), `pending` the path (cycles: a block's `all`,
;; a constructor's own inductive)
(fn ref_visit ((env CheckedEnv) (c Name) (done (List Name)) (pending (List Name)) (fuel Int))
  (List Name)
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) done
  (if (bool_or (mem_name c done) (mem_name c pending)) done
  (match (env_find env c)
    (none done)
    ((some info) (cons c (ref_visit_all env (ref_edges env info) done (cons c pending) (- fuel 1))))))))
(fn ref_visit_all
  ((env CheckedEnv) (cs (List Name)) (done (List Name)) (pending (List Name)) (fuel Int))
  (List Name)
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) done
  (match cs
    (nil done)
    ((cons c r) (ref_visit_all env r (ref_visit env c done pending (- fuel 1)) pending (- fuel 1))))))
(fulfills ref_visit.dec_1
  (by (intro env c dn pd fuel h hb info hm) (apply natAbs_lt (arith) (arith))))
(fulfills ref_visit_all.dec_1
  (by (intro env cs dn pd fuel h c r hm) (apply natAbs_lt (arith) (arith))))

;; the entries with a row: definitions, opaques, axioms, inductive types
(fn ref_kind ((info ConstantInfo)) Bool
  (match info
    ((DefnInfo _ _ _ _ _) true)
    ((OpaqueInfo _ _ _ _) true)
    ((AxiomInfo _ _) true)
    ((InductInfo _ _ _ _ _ _ _ _ _) true)
    (_ false)))
(fn ref_rows ((env CheckedEnv) (ns (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r)
     (match (env_find env n)
       ((some info) (if (ref_kind info) (cons n (ref_rows env r)) (ref_rows env r)))
       (none (ref_rows env r))))))

;; a candidate's closure, dependency order, rows only
(fn candidate_closure ((env CheckedEnv) (c Name)) (List Name)
  (ref_rows env (rev (ref_visit env c nil nil (ref_fuel)))))
(fn candidates_closure ((env CheckedEnv) (cs (List Name)) (done (List Name))) (List Name)
  (measure (struct cs))
  (match cs
    (nil done)
    ((cons c r) (candidates_closure env r (ref_visit env c done nil (ref_fuel))))))

;; ---- the tables ---------------------------------------------------------------------
(fn wr_rows ((env CheckedEnv) (st RefSt) (ns (List Name)) (w World)) World
  (measure (struct ns))
  (match ns
    (nil w)
    ((cons n r)
     (wr_rows env st r
       (match (env_find env n)
         ((some info) (wr_decl env st n info w))
         (none w))))))
(fn close_parens ((k Int) (w World)) World
  (measure (Int.natAbs k))
  (if (< k 1) w (close_parens (- k 1) (wr (utf8 ")") w))))
(fulfills close_parens.dec_1 (by (intro p h) (apply natAbs_pred (arith))))
;; the table, bucketed on the low four bits of hash_name: no generated `if`
;; chain deeper than a bucket (the s-expression reader has a depth limit; a
;; 206-row chain exceeds it), and a lookup costs a bucket, not the table. The
;; buckets stand before the function that reads them
(fn wr_ref_table ((ns (List Name)) (w World)) World
  (write_line (utf8 "")
    (close_parens 18
      (wr (utf8 "REF   none")
        (wr_ref_top 0
          (write_line
            (utf8
              "REF (fn accel_ref ((n Name)) (Option Declaration) (let ((b (band (hash_name n) 15)))")
            (wr_ref_buckets ns 0 w)))))))
(fn wr_ref_top ((k Int) (w World)) World
  (measure (Int.natAbs (- 16 k)))
  (if (< 15 k) w
  (wr_ref_top (+ k 1)
    (write_line (append (nat_s k) (utf8 " n)"))
      (wr (append (utf8 "REF   (if (= b ") (append (nat_s k) (utf8 ") (accel_ref_b"))) w)))))
(fulfills wr_ref_top.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))
(fn wr_ref_buckets ((ns (List Name)) (k Int) (w World)) World
  (measure (Int.natAbs (- 16 k)))
  (if (< 15 k) w
  (let ((b (bucket_of ns k)))
    (wr_ref_buckets ns (+ k 1)
      (write_line (utf8 "")
        (close_parens (+ (len b) 1)
          (wr (utf8 "REF   none")
            (wr_ref_rows b
              (write_line
                (append (utf8 "REF (fn accel_ref_b")
                  (append (nat_s k) (utf8 " ((n Name)) (Option Declaration)")))
                w)))))))))
(fn bucket_of ((ns (List Name)) (k Int)) (List Name)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r) (if (= (band (hash_name n) 15) k) (cons n (bucket_of r k)) (bucket_of r k)))))
(fn wr_ref_rows ((ns (List Name)) (w World)) World
  (measure (struct ns))
  (match ns
    (nil w)
    ((cons n r)
     (let ((h (nat_s (hash_name n))))
       (wr_ref_rows r
         (write_line (utf8 "))")
           (wr h (wr (utf8 ")) (some (rd_") (wr h (wr (utf8 "REF   (if (name_eq n (rn_") w))))))))))
(fulfills wr_ref_buckets.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))
(fn wr_closure_table ((env CheckedEnv) (cs (List Name)) (w World)) World
  (write_line (utf8 "")
    (close_parens (+ (len cs) 1)
      (wr (utf8 "REF   nil")
        (wr_closure_rows env cs
          (write_line (utf8 "REF (fn accel_ref_closure ((n Name)) (List Name)") w))))))
(fn wr_closure_rows ((env CheckedEnv) (cs (List Name)) (w World)) World
  (measure (struct cs))
  (match cs
    (nil w)
    ((cons c r)
     (wr_closure_rows env r
       (match (env_find env c)
         (none w)
         ((some _)
          (write_line (utf8 "")
            (wr_names (candidate_closure env c)
              (wr
                (append (utf8 "REF   (if (name_eq n (rn_")
                  (append (nat_s (hash_name c)) (utf8 ")) ")))
                w)))))))))

;; the entry point: the generated section of accel_pins.shard. What a row cites stands above
;; it: the names, then the term nodes, the reference rows, the table's buckets and the table,
;; the candidates' closures
(fn show_refs ((env CheckedEnv) (cands (List Name)) (w World)) World
  (let ((rows (ref_rows env (rev (candidates_closure env cands nil)))))
    (let ((names (seen_decls env IMEmpty rows)))
      (match
        (wr_rows_exprs env rows (ref_st0)
          (wr_name_defs names 1 (names_depth names)
            (write_line
              (append (utf8 "REF ;; ") (append (nat_s (len rows)) (utf8 " reference rows")))
              w)))
        ((Prod.mk st w1)
         (wr_closure_table env (present env cands) (wr_ref_table rows (wr_rows env st rows w1))))))))
(fn present ((env CheckedEnv) (ns (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r)
     (match (env_find env n)
       ((some _) (cons n (present env r)))
       (none (present env r))))))
