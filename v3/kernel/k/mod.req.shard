;;; v3/kernel/k/mod.req.shard — the view of K: the one way in (v3/LANGUAGE.md §6.6, §13 item
;;; 26; the K seal, slice 3.8, 2026-09-16).
;;;
;;; K is one module across the files of this directory (§3.3's sealed-directory rule): the
;;; opaque types are its parameters here — a CheckedEnv is never built outside, env_empty is
;;; the empty one and check the only way to extend it — and the signatures are what the rest
;;; of the toolchain calls, matched against the private files' declarations when the
;;; directory is checked (`load.shard --root v3 v3/kernel/k`). The data vocabulary is public:
;;; name, level, expr, decl, verdict (K's answers), intmap, json.

(import "../prelude.shard")
(import "../host.shard")
(import "../name.shard")
(import "../level.shard")
(import "../expr.shard")
(import "../decl.shard")
(import "../intmap.shard")
(import "../json.shard")
(import "../verdict.shard")
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.json)
(use kernel.name)
(use kernel.prelude)
(use kernel.verdict)

;; the sealed types
(sig type CheckedEnv)
(sig type AxMemo)
(sig type Tabs)
(sig type Run)
(sig type Ctx)
(sig type LDecl)
(sig type Loc)
(sig type Limits)

;; the operations
(sig fn ctx_new ((e CheckedEnv) (l (List LDecl)) (lps (Option (List Name))) (s DefinitionSafety) (eager Bool) (ticks Int)) Ctx)
(sig fn loc_ctx ((x Loc)) Ctx)
(sig fn loc_st ((x Loc)) St)
(sig fn loc_fvar ((x Loc)) Expr)
(sig fn all_names ((ts (List InductiveType))) (List Name))
(sig fn assoc_name ((n Name) (xs (List (Pair Name ConstantInfo)))) (Option ConstantInfo))
(sig fn ax_memo_empty () AxMemo)
(sig fn axioms_of ((env CheckedEnv) (m AxMemo) (n Name)) (Pair AxMemo (Option (List Name))))
(sig fn budget_depth () Int)
(sig fn budget_ticks () Int)
(sig fn check ((env CheckedEnv) (st St) (d Declaration)) (Outcome CheckedEnv))
(sig fn check_with ((env CheckedEnv) (st St) (lim Limits) (d0 Declaration)) (Outcome CheckedEnv))
(sig fn limits ((depth Int) (ticks Int)) Limits)
(sig fn ci_lparams ((i ConstantInfo)) (List Name))
(sig fn ci_name ((i ConstantInfo)) Name)
(sig fn ci_type ((i ConstantInfo)) Expr)
(sig fn ci_value ((i ConstantInfo)) (Option Expr))
(sig fn ctx_lctx ((c Ctx)) (List LDecl))
(sig fn decl_name ((d Declaration)) Name)
(sig fn empty_run ((pins_mode Bool) (ax_mode Bool)) Run)
(sig fn env_empty () CheckedEnv)
(sig fn env_find ((e CheckedEnv) (n Name)) (Option ConstantInfo))
(sig fn env_key ((n Name)) Int)
(sig fn env_pinned ((e CheckedEnv) (n Name)) Bool)
(sig fn fvar_ids ((fvars (List Expr))) (List Int))
(sig fn guard ((c Ctx) (st St) (d Int) (site Symbol)) (KRes Int))
(sig fn identity_hash ((env CheckedEnv) (n Name)) (Option Int))
(sig fn induct_ctors ((env CheckedEnv) (t Name)) (List Name))
(sig fn infer ((c Ctx) (st St) (d Int) (e Expr) (io Bool)) (KRes Expr))
(sig fn is_def_eq ((c Ctx) (st St) (d Int) (t Expr) (s Expr)) (KRes Bool))
(sig fn is_prop ((c Ctx) (st St) (d Int) (e Expr)) (KRes Bool))
(sig fn lctx_find ((l (List LDecl)) (id Int)) (Option LDecl))
(sig fn ldecl_type ((dcl LDecl)) Expr)
(sig fn mk_binding ((c Ctx) (st St) (is_lam Bool) (fvars (List Expr)) (b Expr) (rdl Bool)) (Pair St Expr))
(sig fn mk_local ((c Ctx) (st St) (n Name) (ty Expr) (v (Option Expr)) (bi BinderInfo)) Loc)
(sig fn names_union ((a (List Name)) (b (List Name))) (List Name))
(sig fn nat_lit ((n Int)) Expr)
(sig fn nm_eq () Name)
(sig fn nm_eq_refl () Name)
(sig fn nm_list () Name)
(sig fn nm_list_cons () Name)
(sig fn nm_list_nil () Name)
(sig fn nm_nat () Name)
(sig fn nm_nat_succ () Name)
(sig fn nm_nat_zero () Name)
(sig fn nm_quot_ind () Name)
(sig fn nm_quot_lift () Name)
(sig fn nm_quot_mk () Name)
(sig fn nm_string () Name)
(sig fn pin_candidates () (List Name))
(sig fn process_lines ((r Run) (bs0 (List Int)) (verbose Bool) (w World)) (Pair Run World))
(sig fn process_record ((r Run) (j Json)) (Pair Run Verdict))
(sig fn record_constants ((t Tabs) (j Json) (v Verdict)) (List Name))
(sig fn run_counts ((r Run)) (List Int))
(sig fn run_env ((r Run)) CheckedEnv)
(sig fn run_tabs ((r Run)) Tabs)
(sig fn run_with_env ((r Run) (e CheckedEnv) (s St)) Run)
(sig fn show_counts ((r Run)) (List Int))
(sig fn show_refs ((env CheckedEnv) (cands (List Name)) (w World)) World)
(sig fn show_verdict ((v Verdict)) (Option (List Int)))
(sig fn st_for ((e CheckedEnv)) St)
(sig fn whnf ((c Ctx) (st St) (d Int) (e Expr)) (KRes Expr))
