;;; v3/kernel/k/import.shard — the lean4export NDJSON import: records →
;;; the Name/Level/Expr tables → Declarations → `check_decl_pinning`
;;; (add.shard), in export order; and the validation of K's generated
;;; inductive constants against the exported ones (`MISMATCH`). Trusted:
;;; docs/KERNEL.md "The trust base, file by file".
;;;
;;; The export's tables share subterms by index; the IntMap tables keep
;;; that sharing in memory, and every table node is IDENTIFIED (minted
;;; from the run's St, which every check seeds from — expr.shard), so the
;;; export's DAG arrives with its sharing recognizable. Index 0 is
;;; `anonymous` for names and `zero` for levels (the exporter starts its
;;; numbering at 1 for both).

(import "../host.shard")
(import "add.shard")
(import "axioms.shard")
(import "../json.shard")
(import "../intmap.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.level)
(use kernel.name)
(use kernel.util)
(use kernel.k.AxMemo)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Verdict)
(use kernel.verdict.Reason)
(use kernel.verdict.Resource)
(use kernel.expr.BinderInfo)
(use kernel.expr.Literal)
(use kernel.expr.St)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.json.JRes)
(use kernel.json.Json)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)

(type Tabs (Tabs (IntMap Name) (IntMap Level) (IntMap Expr)))

;; the run's state: tables, environment, checker state, counters
(type Run (Run Tabs CheckedEnv St Int Int Int Int Int Bool AxMemo))  ; accepted rejected exhausted mismatched unsupported; -a mode + its closure memo

(fn tabs_names ((t Tabs)) (IntMap Name)
  (match t
    ((Tabs n _ _) n)))
(fn tabs_levels ((t Tabs)) (IntMap Level)
  (match t
    ((Tabs _ l _) l)))
(fn tabs_exprs ((t Tabs)) (IntMap Expr)
  (match t
    ((Tabs _ _ e) e)))

(fn name_at ((t Tabs) (i Int)) Name
  (if (= i 0) Anon
  (match (im_find (tabs_names t) i)
    ((some n) n)
    (none Anon))))
(fn level_at ((t Tabs) (i Int)) Level
  (if (= i 0) LZero
  (match (im_find (tabs_levels t) i)
    ((some l) l)
    (none LZero))))
(fn expr_at ((t Tabs) (i Int)) (Option Expr) (im_find (tabs_exprs t) i))

;; ---- field readers -----------------------------------------------------------------

(fn fint ((j Json) (key (List Int))) (Option Int)
  (match (jget j key)
    ((some v) (jint v))
    (none none)))
(fn fstr ((j Json) (key (List Int))) (Option (List Int))
  (match (jget j key)
    ((some v) (jstr v))
    (none none)))
(fn fbool ((j Json) (key (List Int))) (Option Bool)
  (match (jget j key)
    ((some v) (jbool v))
    (none none)))
(fn fints ((j Json) (key (List Int))) (Option (List Int))
  (match (jget j key)
    ((some (JArr xs)) (ints_of xs nil))
    (_ none)))
(fn ints_of ((xs (List Json)) (acc (List Int))) (Option (List Int))
  (measure (struct xs))
  (match xs
    (nil (some (rev acc)))
    ((cons x r)
     (match (jint x)
       ((some n) (ints_of r (cons n acc)))
       (none none)))))

(fn names_at ((t Tabs) (is (List Int))) (List Name)
  (measure (struct is))
  (match is
    (nil nil)
    ((cons i r) (cons (name_at t i) (names_at t r)))))
(fn levels_at ((t Tabs) (is (List Int))) (List Level)
  (measure (struct is))
  (match is
    (nil nil)
    ((cons i r) (cons (level_at t i) (levels_at t r)))))

(fn fexpr ((t Tabs) (j Json) (key (List Int))) (Option Expr)
  (match (fint j key)
    ((some i) (expr_at t i))
    (none none)))

(fn binder_info_of ((s (List Int))) BinderInfo
  (if (int_list_eq s "implicit") BImplicit
  (if (int_list_eq s "strictImplicit") BStrictImplicit
  (if (int_list_eq s "instImplicit") BInstImplicit
  BDefault))))

;; ---- table records ----------------------------------------------------------------

;; returns the updated state and tables, or None for a malformed record
(fn table_record ((t Tabs) (st St) (kind (List Int)) (j Json)) (Option (Prod St Tabs))
  (if (int_list_eq kind "str")
    (match (jget j "str")
      ((some o)
       (match (fint j "in")
         ((some idx)
          (match (fint o "pre")
            ((some pre)
             (match (fstr o "str")
               ((some s)
                (some
                  (Prod.mk st
                    (Tabs (im_insert (tabs_names t) idx (Str (name_at t pre) (sym_of_chars s)))
                      (tabs_levels t)
                      (tabs_exprs t)))))
               (none none)))
            (none none)))
         (none none)))
      (none none))
  (if (int_list_eq kind "num")
    (match (jget j "num")
      ((some o)
       (match (fint j "in")
         ((some idx)
          (match (fint o "pre")
            ((some pre)
             (match (fint o "i")
               ((some i)
                (some
                  (Prod.mk st
                    (Tabs (im_insert (tabs_names t) idx (Num (name_at t pre) i)) (tabs_levels t)
                      (tabs_exprs t)))))
               (none none)))
            (none none)))
         (none none)))
      (none none))
  (if (int_list_eq kind "succ")
    (match (fint j "il")
      ((some idx)
       (match (fint j "succ")
         ((some a) (some (Prod.mk st (put_level t idx (LSucc (level_at t a))))))
         (none none)))
      (none none))
  (if (int_list_eq kind "max")
    (match (fint j "il")
      ((some idx)
       (match (fints j "max")
         ((some (cons a (cons b nil)))
          (some (Prod.mk st (put_level t idx (LMax (level_at t a) (level_at t b))))))
         (_ none)))
      (none none))
  (if (int_list_eq kind "imax")
    (match (fint j "il")
      ((some idx)
       (match (fints j "imax")
         ((some (cons a (cons b nil)))
          (some (Prod.mk st (put_level t idx (LIMax (level_at t a) (level_at t b))))))
         (_ none)))
      (none none))
  (if (int_list_eq kind "param")
    (match (fint j "il")
      ((some idx)
       (match (fint j "param")
         ((some n) (some (Prod.mk st (put_level t idx (LParam (name_at t n))))))
         (none none)))
      (none none))
    (match (fint j "ie")
      (none none)
      ((some idx)
       (match (expr_record t st kind j)
         ((Prod.mk st1 (some e))
          (some (Prod.mk st1 (Tabs (tabs_names t) (tabs_levels t) (im_insert (tabs_exprs t) idx e)))))
         ((Prod.mk _ none) none)))))))))))

(fn put_level ((t Tabs) (idx Int) (l Level)) Tabs
  (Tabs (tabs_names t) (im_insert (tabs_levels t) idx l) (tabs_exprs t)))

;; an identified compound node, or None
(fn some_node ((p (Prod St Expr))) (Prod St (Option Expr))
  (match p
    ((Prod.mk st e) (Prod.mk st (some e)))))

(fn expr_record ((t Tabs) (st St) (kind (List Int)) (j Json)) (Prod St (Option Expr))
  (if (int_list_eq kind "bvar")
    (match (fint j "bvar")
      ((some n) (Prod.mk st (some (mk_bvar n))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "sort")
    (match (fint j "sort")
      ((some l) (Prod.mk st (some (mk_sort (level_at t l)))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "const")
    (match (jget j "const")
      ((some o)
       (match (fint o "name")
         ((some n)
          (match (fints o "us")
            ((some us) (Prod.mk st (some (mk_const (name_at t n) (levels_at t us)))))
            (none (Prod.mk st none))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "app")
    (match (jget j "app")
      ((some o)
       (match (fexpr t o "fn")
         ((some f)
          (match (fexpr t o "arg")
            ((some a) (some_node (new_app st f a)))
            (none (Prod.mk st none))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (bool_or (int_list_eq kind "lam") (int_list_eq kind "forallE"))
    (match (jget j kind)
      ((some o)
       (match (fint o "name")
         ((some n)
          (match (fexpr t o "type")
            ((some ty)
             (match (fexpr t o "body")
               ((some b)
                (let
                  ((bi
                     (match (fstr o "binderInfo")
                       ((some s) (binder_info_of s))
                       (none BDefault))))
                  (some_node
                    (if (int_list_eq kind "lam") (new_lam st (name_at t n) bi ty b)
                    (new_pi st (name_at t n) bi ty b)))))
               (none (Prod.mk st none))))
            (none (Prod.mk st none))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "letE")
    (match (jget j "letE")
      ((some o)
       (match (fint o "name")
         ((some n)
          (match (fexpr t o "type")
            ((some ty)
             (match (fexpr t o "value")
               ((some v)
                (match (fexpr t o "body")
                  ((some b) (some_node (new_let st (name_at t n) ty v b)))
                  (none (Prod.mk st none))))
               (none (Prod.mk st none))))
            (none (Prod.mk st none))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "proj")
    (match (jget j "proj")
      ((some o)
       (match (fint o "typeName")
         ((some n)
          (match (fint o "idx")
            ((some i)
             (match (fexpr t o "struct")
               ((some s) (some_node (new_proj st (name_at t n) i s)))
               (none (Prod.mk st none))))
            (none (Prod.mk st none))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "natVal")
    (match (fstr j "natVal")
      ((some s)
       (match (parse_nat s 0)
         ((some n) (Prod.mk st (some (mk_lit (LitNat n)))))
         (none (Prod.mk st none))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "strVal")
    (match (fstr j "strVal")
      ((some s) (Prod.mk st (some (mk_lit (LitStr s)))))
      (none (Prod.mk st none)))
  (if (int_list_eq kind "mdata")
    ;; transparent to every rule (expr.shard): the inner term
    (match (jget j "mdata")
      ((some o) (Prod.mk st (fexpr t o "expr")))
      (none (Prod.mk st none)))
    (Prod.mk st none))))))))))))

;; ---- declaration records ------------------------------------------------------------

(fn cval_of ((t Tabs) (o Json)) (Option ConstantVal)
  (match (fint o "name")
    ((some n)
     (match (fints o "levelParams")
       ((some ps)
        (match (fexpr t o "type")
          ((some ty) (some (ConstantVal (name_at t n) (names_at t ps) ty)))
          (none none)))
       (none none)))
    (none none)))

(fn hints_of ((j Json)) ReducibilityHints
  (match j
    ((JStr s) (if (int_list_eq s "abbrev") HAbbrev HOpaque))
    (_
      (match (fint j "regular")
        ((some n) (HRegular n))
        (none HOpaque)))))

(fn safety_of ((s (List Int))) DefinitionSafety
  (if (int_list_eq s "unsafe") Unsafe
  (if (int_list_eq s "partial") Partial
  Safe)))

(fn decl_record ((t Tabs) (kind (List Int)) (j Json)) (Option Declaration)
  (match (jget j kind)
    (none none)
    ((some o)
     (if (int_list_eq kind "axiom")
       (match (cval_of t o)
         ((some cv)
          (some
            (AxiomDecl cv
              (match (fbool o "isUnsafe")
                ((some b) b)
                (none false)))))
         (none none))
     (if (int_list_eq kind "def")
       (match (cval_of t o)
         ((some cv)
          (match (fexpr t o "value")
            ((some v)
             (some
               (DefnDecl cv v
                 (match (jget o "hints")
                   ((some h) (hints_of h))
                   (none HOpaque))
                 (match (fstr o "safety")
                   ((some s) (safety_of s))
                   (none Safe))
                 (match (fints o "all")
                   ((some xs) (names_at t xs))
                   (none nil)))))
            (none none)))
         (none none))
     (if (int_list_eq kind "thm")
       (match (cval_of t o)
         ((some cv)
          (match (fexpr t o "value")
            ((some v)
             (some
               (ThmDecl cv v
                 (match (fints o "all")
                   ((some xs) (names_at t xs))
                   (none nil)))))
            (none none)))
         (none none))
     (if (int_list_eq kind "opaque")
       (match (cval_of t o)
         ((some cv)
          (match (fexpr t o "value")
            ((some v)
             (some
               (OpaqueDecl cv v
                 (match (fbool o "isUnsafe")
                   ((some b) b)
                   (none false))
                 (match (fints o "all")
                   ((some xs) (names_at t xs))
                   (none nil)))))
            (none none)))
         (none none))
       none)))))))

;; the exported inductive block: (types, ctors, recs) as Json arrays
(fn inductive_parts ((j Json)) (Option (Prod (List Json) (Prod (List Json) (List Json))))
  (match (jget j "inductive")
    (none none)
    ((some o)
     (match (jget o "types")
       ((some (JArr ts))
        (match (jget o "ctors")
          ((some (JArr cs))
           (match (jget o "recs")
             ((some (JArr rs)) (some (Prod.mk ts (Prod.mk cs rs))))
             (_ none)))
          (_ none)))
       (_ none)))))

;; the raw declaration from the exported block
(fn induct_decl_of ((t Tabs) (ts (List Json)) (cs (List Json))) (Option Declaration)
  (match ts
    (nil none)
    ((cons t0 _)
     (match (fints t0 "levelParams")
       (none none)
       ((some lps)
        (match (fint t0 "numParams")
          (none none)
          ((some np)
           (match (induct_types_of t ts cs nil)
             (none none)
             ((some types)
              (some
                (InductDecl (names_at t lps) np types
                  (match (fbool t0 "isUnsafe")
                    ((some b) b)
                    (none false)))))))))))))

(fn induct_types_of ((t Tabs) (ts (List Json)) (cs (List Json)) (acc (List InductiveType)))
  (Option (List InductiveType))
  (measure (struct ts))
  (match ts
    (nil (some (rev acc)))
    ((cons tj r)
     (match (fint tj "name")
       (none none)
       ((some n)
        (match (fexpr t tj "type")
          (none none)
          ((some ty)
           (match (fints tj "ctors")
             (none none)
             ((some cidx)
              (match (ctors_of t cs (names_at t cidx) nil)
                (none none)
                ((some ctors)
                 (induct_types_of t r cs (cons (InductiveType (name_at t n) ty ctors) acc)))))))))))))

;; the constructors named, in the exported order of the type's ctor list
(fn ctors_of ((t Tabs) (cs (List Json)) (names (List Name)) (acc (List Constructor)))
  (Option (List Constructor))
  (measure (struct names))
  (match names
    (nil (some (rev acc)))
    ((cons n r)
     (match (find_ctor_json t cs n)
       (none none)
       ((some cj)
        (match (fexpr t cj "type")
          (none none)
          ((some ty) (ctors_of t cs r (cons (Constructor n ty) acc)))))))))

(fn find_ctor_json ((t Tabs) (cs (List Json)) (n Name)) (Option Json)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons cj r)
     (match (fint cj "name")
       ((some i) (if (name_eq (name_at t i) n) (some cj) (find_ctor_json t r n)))
       (none (find_ctor_json t r n))))))

;; ---- validation: the exported constants against K's generated ones ----------------------

;; every exported InductiveVal / ConstructorVal / RecursorVal must match K's
(fn validate_inductive
  ((t Tabs) (env CheckedEnv) (ts (List Json)) (cs (List Json)) (rs (List Json)))
  (Option Symbol)
  (match (validate_types t env ts)
    ((some s) (some s))
    (none
      (match (validate_ctors t env cs)
        ((some s) (some s))
        (none (validate_recs t env rs))))))

(fn validate_types ((t Tabs) (env CheckedEnv) (ts (List Json))) (Option Symbol)
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons tj r)
     (match (fint tj "name")
       (none (some (quote type_record)))
       ((some ni)
        (match (env_find env (name_at t ni))
          ((some (InductInfo (ConstantVal _ lps ty) np nidx all ctors nn isrec _ isrefl))
           (if (bool_not (opt_int_eq (fint tj "numParams") np)) (some (quote numParams))
           (if (bool_not (opt_int_eq (fint tj "numIndices") nidx)) (some (quote numIndices))
           (if (bool_not (opt_names_eq t (fints tj "all") all)) (some (quote all))
           (if (bool_not (opt_names_eq t (fints tj "ctors") ctors)) (some (quote ctors))
           (if (bool_not (opt_names_eq t (fints tj "levelParams") lps)) (some (quote levelParams))
           (if (bool_not (opt_bool_eq (fbool tj "isRec") isrec)) (some (quote isRec))
           (if (bool_not (opt_bool_eq (fbool tj "isReflexive") isrefl)) (some (quote isReflexive))
           (if (bool_not (opt_expr_eq (fexpr t tj "type") ty)) (some (quote type))
           (validate_types t env r))))))))))
          (_ (some (quote inductive_missing)))))))))

(fn validate_ctors ((t Tabs) (env CheckedEnv) (cs (List Json))) (Option Symbol)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons cj r)
     (match (fint cj "name")
       (none (some (quote ctor_record)))
       ((some ni)
        (match (env_find env (name_at t ni))
          ((some (CtorInfo (ConstantVal _ lps ty) induct cidx np nf _))
           (if (bool_not (opt_name_eq t (fint cj "induct") induct)) (some (quote induct))
           (if (bool_not (opt_int_eq (fint cj "cidx") cidx)) (some (quote cidx))
           (if (bool_not (opt_int_eq (fint cj "numParams") np)) (some (quote ctor_numParams))
           (if (bool_not (opt_int_eq (fint cj "numFields") nf)) (some (quote numFields))
           (if (bool_not (opt_names_eq t (fints cj "levelParams") lps))
             (some (quote ctor_levelParams))
           (if (bool_not (opt_expr_eq (fexpr t cj "type") ty)) (some (quote ctor_type))
           (validate_ctors t env r))))))))
          (_ (some (quote ctor_missing)))))))))

(fn validate_recs ((t Tabs) (env CheckedEnv) (rs (List Json))) (Option Symbol)
  (measure (struct rs))
  (match rs
    (nil none)
    ((cons rj r)
     (match (fint rj "name")
       (none (some (quote rec_record)))
       ((some ni)
        (match (env_find env (name_at t ni))
          ((some (RecInfo (ConstantVal _ lps ty) all np nidx nmot nmin rules k _))
           (if (bool_not (opt_names_eq t (fints rj "levelParams") lps))
             (some (quote rec_levelParams))
           (if (bool_not (opt_expr_eq (fexpr t rj "type") ty)) (some (quote rec_type))
           (if (bool_not (opt_names_eq t (fints rj "all") all)) (some (quote rec_all))
           (if (bool_not (opt_int_eq (fint rj "numParams") np)) (some (quote rec_numParams))
           (if (bool_not (opt_int_eq (fint rj "numIndices") nidx)) (some (quote rec_numIndices))
           (if (bool_not (opt_int_eq (fint rj "numMotives") nmot)) (some (quote numMotives))
           (if (bool_not (opt_int_eq (fint rj "numMinors") nmin)) (some (quote numMinors))
           (if (bool_not (opt_bool_eq (fbool rj "k") k)) (some (quote k))
           (match (jget rj "rules")
             ((some (JArr rjs))
              (match (validate_rules t rjs rules)
                ((some s) (some s))
                (none (validate_recs t env r))))
             (_ (some (quote rules_record)))))))))))))
          (_ (some (quote rec_missing)))))))))

(fn validate_rules ((t Tabs) (rjs (List Json)) (rules (List RecursorRule))) (Option Symbol)
  (measure (struct rjs))
  (match rjs
    (nil
      (match rules
        (nil none)
        (_ (some (quote rule_count)))))
    ((cons rj rr)
     (match rules
       (nil (some (quote rule_count)))
       ((cons (RecursorRule cn nf rhs) rules_r)
        (if (bool_not (opt_name_eq t (fint rj "ctor") cn)) (some (quote rule_ctor))
        (if (bool_not (opt_int_eq (fint rj "nfields") nf)) (some (quote rule_nfields))
        (if (bool_not (opt_expr_eq (fexpr t rj "rhs") rhs)) (some (quote rule_rhs))
        (validate_rules t rr rules_r)))))))))

(fn opt_int_eq ((o (Option Int)) (n Int)) Bool
  (match o
    ((some m) (= m n))
    (none false)))
(fn opt_bool_eq ((o (Option Bool)) (b Bool)) Bool
  (match o
    ((some c) (if b c (bool_not c)))
    (none false)))
(fn opt_expr_eq ((o (Option Expr)) (e Expr)) Bool
  (match o
    ((some x) (expr_eq x e))
    (none false)))
(fn opt_name_eq ((t Tabs) (o (Option Int)) (n Name)) Bool
  (match o
    ((some i) (name_eq (name_at t i) n))
    (none false)))
(fn opt_names_eq ((t Tabs) (o (Option (List Int))) (ns (List Name))) Bool
  (match o
    ((some is) (names_eq (names_at t is) ns))
    (none false)))

;; a "quot" record: the first one adds the four constants; every one is
;; validated against K's own (types structurally equal)
(fn quot_record ((t Tabs) (env CheckedEnv) (st St) (j Json))
  (Prod (KRes CheckedEnv) (Option Symbol))
  (match (jget j "quot")
    (none (Prod.mk (KFail (FRej (Malformed (quote quot_record)))) none))
    ((some o)
     (match (add_quot env st)
       ((KFail f) (Prod.mk (KFail f) none))
       ((KOk st1 env1)
        (match (fint o "name")
          (none (Prod.mk (KOk st1 env1) (some (quote quot_record))))
          ((some ni)
           (match (env_find env1 (name_at t ni))
             ((some (QuotInfo (ConstantVal _ lps ty) _))
              (if (bool_not (opt_names_eq t (fints o "levelParams") lps))
                (Prod.mk (KOk st1 env1) (some (quote quot_levelParams)))
              (if (bool_not (opt_expr_eq (fexpr t o "type") ty))
                (Prod.mk (KOk st1 env1) (some (quote quot_type)))
                (Prod.mk (KOk st1 env1) none))))
             (_ (Prod.mk (KOk st1 env1) (some (quote quot_missing))))))))))))

;; ---- one record ---------------------------------------------------------------------------

(fn run_tabs ((r Run)) Tabs
  (match r
    ((Run t _ _ _ _ _ _ _ _ _) t)))
(fn run_env ((r Run)) CheckedEnv
  (match r
    ((Run _ e _ _ _ _ _ _ _ _) e)))
(fn run_st ((r Run)) St
  (match r
    ((Run _ _ s _ _ _ _ _ _ _) s)))
(fn run_ax_mode ((r Run)) Bool
  (match r
    ((Run _ _ _ _ _ _ _ _ x _) x)))
(fn run_memo ((r Run)) AxMemo
  (match r
    ((Run _ _ _ _ _ _ _ _ _ mm) mm)))
(fn run_with_memo ((r Run) (mm AxMemo)) Run
  (match r
    ((Run t e s a b c d f x _) (Run t e s a b c d f x mm))))
(fn run_counts ((r Run)) (List Int)
  (match r
    ((Run _ _ _ a b c d e _ _) (list a b c d e))))
(fn run_with_tabs ((r Run) (t Tabs) (s St)) Run
  (match r
    ((Run _ e _ a b c d f x mm) (Run t e s a b c d f x mm))))
;; the run after a check of its own: the environment and the state that check returned. Private:
;; a run's tables were minted by its own state against its own environment, and nothing puts
;; them beside another's (docs/KERNEL.md "The state discipline")
(fn run_after ((r Run) (e CheckedEnv) (s St)) Run
  (match r
    ((Run t _ _ a b c d f x mm) (Run t e s a b c d f x mm))))
;; a run resumed from before a step that refused — a declaration K did not accept, a table
;; line that did not read: the run's own state stands, and what the step built is gone with the
;; state it built it under (a Failure holds no term). The identity; the one place a state is
;; taken back, written where it happens — the state's check (thread.shard) names this
;; function and `state_test.sh` counts its uses (docs/KERNEL.md "The state discipline")
(fn run_resume ((r Run)) Run r)
(fn run_count ((r Run) (which Int)) Run
  (match r
    ((Run t e s a b c d f x mm)
     (if (= which 0) (Run t e s (+ a 1) b c d f x mm)
     (if (= which 1) (Run t e s a (+ b 1) c d f x mm)
     (if (= which 2) (Run t e s a b (+ c 1) d f x mm)
     (if (= which 3) (Run t e s a b c (+ d 1) f x mm)
     (Run t e s a b c d (+ f 1) x mm))))))))

;; the verdict of checking one declaration and the run afterwards
(fn check_into ((r Run) (d Declaration)) (Prod Run Verdict)
  (match (check_decl_pinning (run_env r) (run_st r) d)
    ((KOk st1 env1) (Prod.mk (run_count (run_after r env1 st1) 0) (VAccept (decl_name d))))
    ((KFail (FRej (Unsupported s)))
     (Prod.mk (run_count (run_resume r) 4) (VUnsupported s (decl_name d))))
    ((KFail (FRej reason)) (Prod.mk (run_count (run_resume r) 1) (VReject reason (decl_name d))))
    ((KFail (FOut res site))
     (Prod.mk (run_count (run_resume r) 2) (VExhaust res site (decl_name d))))))

(fn process_record ((r Run) (j Json)) (Prod Run Verdict)
  (match j
    (JNull (Prod.mk r (VMalformed "json")))
    (_
      (match (jkind_of_record j)
        (none (Prod.mk r (VMalformed "kind")))
        ((some kind)
         (if (int_list_eq kind "meta") (Prod.mk r VSkip)
         (if (int_list_eq kind "inductive")
           (match (inductive_parts j)
             (none (Prod.mk r (VMalformed "inductive")))
             ((some (Prod.mk ts (Prod.mk cs rs)))
              (match (induct_decl_of (run_tabs r) ts cs)
                (none (Prod.mk r (VMalformed "inductive-decl")))
                ((some d)
                 (match (check_into r d)
                   ((Prod.mk r1 (VAccept n))
                    (match (validate_inductive (run_tabs r1) (run_env r1) ts cs rs)
                      (none (Prod.mk r1 (VAccept n)))
                      ((some s) (Prod.mk (run_count r1 3) (VMismatch n s)))))
                   ((Prod.mk r1 v) (Prod.mk r1 v)))))))
         (if (int_list_eq kind "quot")
           (match (quot_record (run_tabs r) (run_env r) (run_st r) j)
             ((Prod.mk (KFail (FRej reason)) _)
              (Prod.mk (run_count r 1) (VReject reason (nm_quot))))
             ((Prod.mk (KFail (FOut res site)) _)
              (Prod.mk (run_count r 2) (VExhaust res site (nm_quot))))
             ((Prod.mk (KOk st1 env1) none)
              (Prod.mk (run_count (run_after r env1 st1) 0) (VAccept (nm_quot))))
             ((Prod.mk (KOk st1 env1) (some s))
              (Prod.mk (run_count (run_after r env1 st1) 3) (VMismatch (nm_quot) s))))
           (match (decl_record (run_tabs r) kind j)
             ((some d) (check_into r d))
             (none
               (match (table_record (run_tabs r) (run_st r) kind j)
                 ((some (Prod.mk st1 t1)) (Prod.mk (run_with_tabs r t1 st1) VSkip))
                 (none (Prod.mk (run_resume r) (VMalformed kind))))))))))))))

(fn show_reason ((r Reason)) (List Int)
  (match r
    ((Malformed s) (append "Malformed:" (chars_of_sym s)))
    ((RuleViolation s) (append "RuleViolation:" (chars_of_sym s)))
    ((Unsupported s) (append "Unsupported:" (chars_of_sym s)))
    (ConversionNotEstablished "ConversionNotEstablished")))

(fn show_resource ((r Resource)) (List Int)
  (match r
    (RHeartbeats "heartbeats")
    (RRecDepth "rec_depth")
    (RNatSize "nat_size")
    (RNatCount "nat_count")))

(fn show_verdict ((v Verdict)) (Option (List Int))
  (match v
    ((VAccept n) (some (append "ACCEPT " (show_name n))))
    ((VReject reason n)
     (some (append "REJECT " (append (show_reason reason) (append " " (show_name n))))))
    ((VExhaust res site n)
     (some
       (append "EXHAUSTED "
         (append (show_resource res)
           (append "@" (append (chars_of_sym site) (append " " (show_name n))))))))
    ((VMismatch n s)
     (some (append "MISMATCH " (append (chars_of_sym s) (append " " (show_name n))))))
    ((VUnsupported s n)
     (some (append "UNSUPPORTED " (append (chars_of_sym s) (append " " (show_name n))))))
    (VSkip none)
    ((VMalformed k) (some (append "MALFORMED " k)))))

;; -a: the axiom closure of every constant an accepted record admitted
;; (axioms.shard), one line each — `AX name: axiom axiom …`, the axioms in
;; collection order (the gate sorts both sides); `?depth` = the bound was hit
(fn json_names ((t Tabs) (js (List Json))) (List Name)
  (measure (struct js))
  (match js
    (nil nil)
    ((cons j r)
     (match (fint j "name")
       ((some i) (cons (name_at t i) (json_names t r)))
       (none (json_names t r))))))

(fn record_constants ((t Tabs) (j Json) (v Verdict)) (List Name)
  (match v
    ((VAccept n)
     (match (jkind_of_record j)
       (none (cons n nil))
       ((some kind)
        (if (int_list_eq kind "inductive")
          (match (inductive_parts j)
            ((some (Prod.mk ts (Prod.mk cs rs)))
             (append (json_names t ts) (append (json_names t cs) (json_names t rs))))
            (none (cons n nil)))
        (if (int_list_eq kind "quot")
          ;; one record per quotient constant; the first admits all four, each names its own
          (match (jget j "quot")
            ((some o)
             (match (fint o "name")
               ((some i) (cons (name_at t i) nil))
               (none (cons n nil))))
            (none (cons n nil)))
          (cons n nil))))))
    (_ nil)))

(fn show_names_sp ((ns (List Name))) (List Int)
  (measure (struct ns))
  (match ns
    (nil "")
    ((cons n r) (append " " (append (show_name n) (show_names_sp r))))))

(fn emit_axioms ((r Run) (ns (List Name)) (w World)) (Prod Run World)
  (measure (struct ns))
  (match ns
    (nil (Prod.mk r w))
    ((cons n rest)
     (match (axioms_of (run_env r) (run_memo r) n)
       ((Prod.mk m1 (some axs))
        (emit_axioms (run_with_memo r m1) rest
          (write_line (append "AX " (append (show_name n) (append ":" (show_names_sp axs)))) w)))
       ((Prod.mk m1 none)
        (emit_axioms (run_with_memo r m1) rest
          (write_line (append "AX " (append (show_name n) ": ?depth")) w)))))))

;; process every line of a chunk; verbose = print ACCEPT lines too
(fn process_lines ((r Run) (bs0 (List Int)) (verbose Bool) (w World)) (Prod Run World)
  (measure (struct bs0))
  (let ((bs (skip_ws bs0)))
    (match bs
      (nil (Prod.mk r w))
      (_
        (match (json_parse bs)
          (JErr (Prod.mk r (write_line "MALFORMED json (stream)" w)))
          ((JRes j rest)
           (match (process_record r j)
             ((Prod.mk r1 v)
              (let
                ((w1
                   (match (show_verdict v)
                     (none w)
                     ((some s)
                      (match v
                        ((VAccept _) (if verbose (write_line s w) w))
                        (_ (write_line s w)))))))
                (match
                  (if (run_ax_mode r1) (emit_axioms r1 (record_constants (run_tabs r1) j v) w1)
                  (Prod.mk r1 w1))
                  ((Prod.mk r2 w2) (process_lines r2 rest verbose w2))))))))))))

(fn show_counts ((r Run)) (List Int)
  (match (run_counts r)
    ((cons a (cons b (cons c (cons d (cons e nil)))))
     (append "accepted "
       (append (show_nat a)
         (append "  rejected "
           (append (show_nat b)
             (append "  exhausted "
               (append (show_nat c)
                 (append "  mismatched "
                   (append (show_nat d) (append "  unsupported " (show_nat e)))))))))))
    (_ "")))

(fn empty_run ((ax_mode Bool)) Run
  (Run (Tabs IMEmpty IMEmpty IMEmpty) (CheckedEnv IMEmpty false nil 0) (st_init) 0 0 0 0 0 ax_mode
    (ax_memo_empty)))
;; a fresh run over an environment: no tables, the counter at the environment's watermark, the
;; counts zero. The one way a run meets an environment it did not build — with nothing minted
;; anywhere else in its hands
(fn run_on ((e CheckedEnv)) Run
  (Run (Tabs IMEmpty IMEmpty IMEmpty) e (st_for e) 0 0 0 0 0 false (ax_memo_empty)))
