;;; v3/kernel/k/nested.shard — nested inductive types: elimination into
;;; auxiliary mutual types, admission, and restoration; plus the uniform
;;; occurrence check. After src/kernel/inductive.cpp at v4.33.1:
;;; `check_uniform_ind_occs` (l. 134), `elim_nested_inductive_fn`
;;; (l. 1000–1220), `restore_nested` (l. 927), `mk_aux_rec_name_map`
;;; (l. 1183), `environment::add_inductive` (l. 1235). `add_inductive`
;;; below is the entry `add.shard` dispatches to.

(import "inductive.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.descent)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.RecursorRule)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Reason)
(use kernel.verdict.Resource)
(use kernel.expr.Expr)
(use kernel.expr.St)
(use kernel.name.Name)
(use kernel.k.Ctx)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)
(use kernel.k.LDecl)
(use kernel.k.Loc)

(fn nm_nested () Name (n1 (sym "_nested")))

;; is_prefix_of(_nested, n): n's root component is `_nested`
(fn has_nested_prefix ((n Name)) Bool
  (measure (struct n))
  (match n
    (Anon false)
    ((Str Anon s) (sym_eq s (sym "_nested")))
    ((Str p _) (has_nested_prefix p))
    ((Num p _) (has_nested_prefix p))))

;; check_no_nested_aux (l. 1222): no constant or projection naming an auxiliary type
(fn mentions_nested_aux ((e Expr)) Bool
  (measure (struct e))
  (match e
    ((Const _ n _) (has_nested_prefix n))
    ((Proj _ s _ x) (bool_or (has_nested_prefix s) (mentions_nested_aux x)))
    ((App _ f a) (bool_or (mentions_nested_aux f) (mentions_nested_aux a)))
    ((Lam _ _ _ d b) (bool_or (mentions_nested_aux d) (mentions_nested_aux b)))
    ((Pi _ _ _ d b) (bool_or (mentions_nested_aux d) (mentions_nested_aux b)))
    ((Let _ _ t v b)
     (bool_or (bool_or (mentions_nested_aux t) (mentions_nested_aux v)) (mentions_nested_aux b)))
    (_ false)))

;; name concatenation `_nested ++ J` (name + name)
(fn name_concat ((p Name) (n Name)) Name
  (measure (struct n))
  (match n
    (Anon p)
    ((Str q s) (Str (name_concat p q) s))
    ((Num q k) (Num (name_concat p q) k))))

;; ---- check_uniform_ind_occs (l. 134) ----------------------------------------------------
;; every syntactic occurrence of a declared type in a constructor type is
;; applied to the declaration's levels and, at binder depth `offset`, to
;; the parameter bvars #(offset−1) … #(offset−nparams)

(fn check_uniform ((lps (List Name)) (nparams Int) (types (List InductiveType))) (Option Failure)
  (cu_types (params_to_levels lps) nparams (all_names types) types))

(fn cu_types ((lvls (List Level)) (nparams Int) (names (List Name)) (ts (List InductiveType)))
  (Option Failure)
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons t r)
     (match (cu_ctors lvls nparams names (it_ctors t))
       ((some f) (some f))
       (none (cu_types lvls nparams names r))))))

(fn cu_ctors ((lvls (List Level)) (nparams Int) (names (List Name)) (cs (List Constructor)))
  (Option Failure)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons c r)
     (if (cu_expr lvls nparams names (ctor_type c) 0) (cu_ctors lvls nparams names r)
     (some (FRej (RuleViolation (sym "non_uniform_occurrence"))))))))

;; True if every occurrence in e (at binder depth offset) is uniform
(fn cu_expr ((lvls (List Level)) (nparams Int) (names (List Name)) (e Expr) (offset Int)) Bool
  (measure (+ (* 2 (Expr.size e)) 1))
  (match (get_app_fn e)
    ((Const _ n ls)
     (if (bool_not (mem_name n names)) (cu_children lvls nparams names e offset)
     (let ((args (get_app_args e)))
       (if (< nparams (len args)) (cu_children lvls nparams names e offset)  ; over-applied: descend
       (bool_and (= (len args) nparams)
         (bool_and (<= nparams offset) (bool_and (levels_eq ls lvls) (cu_param_bvars args offset 0))))))))
    (_ (cu_children lvls nparams names e offset))))

(fn cu_param_bvars ((args (List Expr)) (offset Int) (i Int)) Bool
  (measure (struct args))
  (match args
    (nil true)
    ((cons a r)
     (match a
       ((BVar _ k) (if (= k (- (- offset 1) i)) (cu_param_bvars r offset (+ i 1)) false))
       (_ false)))))

(fn cu_children ((lvls (List Level)) (nparams Int) (names (List Name)) (e Expr) (offset Int)) Bool
  (measure (* 2 (Expr.size e)))
  (match e
    ((App _ f a)
     (bool_and (cu_expr lvls nparams names f offset) (cu_expr lvls nparams names a offset)))
    ((Lam _ _ _ d b)
     (bool_and (cu_expr lvls nparams names d offset) (cu_expr lvls nparams names b (+ offset 1))))
    ((Pi _ _ _ d b)
     (bool_and (cu_expr lvls nparams names d offset) (cu_expr lvls nparams names b (+ offset 1))))
    ((Let _ _ t v b)
     (bool_and
       (bool_and (cu_expr lvls nparams names t offset) (cu_expr lvls nparams names v offset))
       (cu_expr lvls nparams names b (+ offset 1))))
    ((Proj _ _ _ x) (cu_expr lvls nparams names x offset))
    (_ true)))
(fulfills cu_expr.dec_1 (by (intro lv np nm e off w n ls h hn hl) (arith)))
(fulfills cu_expr.dec_2 (by (intro lv np nm e off w n ls h hn) (arith)))
(fulfills cu_expr.dec_3 (by (intro lv np nm e off w h) (arith)))
(fulfills cu_children.dec_1 (by (intro lv np nm e off w f a h) (rw h) (rw Expr.size.eq_5) (arith)))
(fulfills cu_children.dec_2 (by (intro lv np nm e off w f a h) (rw h) (rw Expr.size.eq_5) (arith)))
(fulfills cu_children.dec_3
  (by (intro lv np nm e off w1 w2 w3 d b h) (rw h) (rw Expr.size.eq_6) (arith)))
(fulfills cu_children.dec_4
  (by (intro lv np nm e off w1 w2 w3 d b h) (rw h) (rw Expr.size.eq_6) (arith)))
(fulfills cu_children.dec_5
  (by (intro lv np nm e off w1 w2 w3 d b h) (rw h) (rw Expr.size.eq_7) (arith)))
(fulfills cu_children.dec_6
  (by (intro lv np nm e off w1 w2 w3 d b h) (rw h) (rw Expr.size.eq_7) (arith)))
(fulfills cu_children.dec_7
  (by (intro lv np nm e off w1 w2 t v b h) (rw h) (rw Expr.size.eq_8) (arith)))
(fulfills cu_children.dec_8
  (by (intro lv np nm e off w1 w2 t v b h) (rw h) (rw Expr.size.eq_8) (arith)))
(fulfills cu_children.dec_9
  (by (intro lv np nm e off w1 w2 t v b h) (rw h) (rw Expr.size.eq_8) (arith)))
(fulfills cu_children.dec_10
  (by (intro lv np nm e off w1 w2 w3 x h) (rw h) (rw Expr.size.eq_10) (arith)))

;; ---- elim_nested_inductive_fn (l. 1000) ----------------------------------------------------

;; the elimination state
(type N
  (N CheckedEnv  ; 0 env (the original)
    St  ; 1 fresh ids
    (List LDecl)  ; 2 lctx (params and per-constructor As)
    (List Level)  ; 3 the declaration's levels
    (List Expr)  ; 4 params (fvars, from the first type)
    (List (Prod Expr Name))  ; 5 nested_aux: (I Ds over params, aux name)
    (List InductiveType)  ; 6 new_types (worklist; grows)
    Int))  ; 7 next_idx

(fn n_env ((n N)) CheckedEnv
  (match n
    ((N e _ _ _ _ _ _ _) e)))
(fn n_st ((n N)) St
  (match n
    ((N _ s _ _ _ _ _ _) s)))
(fn n_lctx ((n N)) (List LDecl)
  (match n
    ((N _ _ l _ _ _ _ _) l)))
(fn n_lvls ((n N)) (List Level)
  (match n
    ((N _ _ _ v _ _ _ _) v)))
(fn n_params ((n N)) (List Expr)
  (match n
    ((N _ _ _ _ p _ _ _) p)))
(fn n_aux ((n N)) (List (Prod Expr Name))
  (match n
    ((N _ _ _ _ _ a _ _) a)))
(fn n_types ((n N)) (List InductiveType)
  (match n
    ((N _ _ _ _ _ _ t _) t)))
(fn n_next ((n N)) Int
  (match n
    ((N _ _ _ _ _ _ _ i) i)))
(fn n_set_st ((n N) (s St)) N
  (match n
    ((N e _ l v p a t i) (N e s l v p a t i))))
(fn n_set_st_lctx ((n N) (s St) (l (List LDecl))) N
  (match n
    ((N e _ _ v p a t i) (N e s l v p a t i))))
(fn n_set_params ((n N) (p (List Expr))) N
  (match n
    ((N e s l v _ a t i) (N e s l v p a t i))))
(fn n_add_aux ((n N) (x (Prod Expr Name))) N
  (match n
    ((N e s l v p a t i) (N e s l v p (append a (cons x nil)) t i))))
(fn n_add_type ((n N) (x InductiveType)) N
  (match n
    ((N e s l v p a t i) (N e s l v p a (append t (cons x nil)) i))))
(fn n_set_type ((n N) (idx Int) (x InductiveType)) N
  (match n
    ((N e s l v p a t i) (N e s l v p a (set_nth t idx x) i))))
(fn n_set_next ((n N) (i Int)) N
  (match n
    ((N e s l v p a t _) (N e s l v p a t i))))

(fn set_nth ((T Type) (xs (List T)) (i Int) (x T)) (List T)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons y r) (if (= i 0) (cons x r) (cons y (set_nth r (- i 1) x))))))

(fn n_ctx ((n N)) Ctx (Ctx (n_env n) (n_lctx n) none Safe false (budget_ticks)))

;; adopt a term built through the state
(fn n_lift ((n N) (p (Prod St Expr))) (Prod N Expr)
  (match p
    ((Prod.mk st e) (Prod.mk (n_set_st n st) e))))

;; a fresh local (no type annotations consumed here: the pin's mk_local_decl in this class)
(fn n_local ((n N) (nm Name) (ty Expr) (bi BinderInfo)) (Prod N Expr)
  (match (mk_local (n_ctx n) (n_st n) nm ty none bi)
    ((Loc c st fv) (Prod.mk (n_set_st_lctx n st (ctx_lctx c)) fv))))

(fn n_mk_pi ((n N) (fvars (List Expr)) (b Expr)) (Prod N Expr)
  (n_lift n (mk_binding (n_ctx n) (n_st n) false fvars b false)))
(fn n_inst1 ((n N) (b Expr) (v Expr)) (Prod N Expr) (n_lift n (instantiate1 (n_st n) b v)))
(fn n_app_list ((n N) (f Expr) (xs (List Expr))) (Prod N Expr)
  (n_lift n (mk_app_list (n_st n) f xs)))

;; get_params (l. 1138): open nparams binders of a type as locals; (n, (locals, rest))
(fn get_params ((n N) (ty Expr) (k Int) (acc (List Expr))) (KRes (Prod N (Prod (List Expr) Expr)))
  (measure (Int.natAbs k))
  (if (<= k 0) (KOk (n_st n) (Prod.mk n (Prod.mk (rev acc) ty)))
  (match ty
    ((Pi _ nm bi dom body)
     (match (n_local n nm dom bi)
       ((Prod.mk ns1 x)
        (match (n_inst1 ns1 body x)
          ((Prod.mk ns2 b1) (get_params ns2 b1 (- k 1) (cons x acc)))))))
    (_ (KFail (FRej (RuleViolation (sym "param_count_mismatch"))))))))
(fulfills get_params.dec_1
  (by (intro p h a nm bi dom body hm ns1 x hx ns2 b1 hb) (apply natAbs_pred (arith))))

;; the most auxiliary types one declaration may come to, and the most names tried for one of
;; them: the pin's two loops (l. 1005, l. 1153) have no bound
(fn nested_max () Int 100000)

;; mk_unique_name (l. 1005): n_idx, n_(idx+1), … not in the environment, within `tries` of them
(fn mk_unique_name ((n N) (base Name) (tries Int)) (KRes (Prod N Name))
  (measure (Int.natAbs tries))
  (if (< tries 1) (KFail (FOut RHeartbeats (sym "mk_unique_name")))
  (let ((cand (name_append_after base (n_next n))) (ns1 (n_set_next n (+ (n_next n) 1))))
    (match (env_find (n_env n) cand)
      (none (KOk (n_st ns1) (Prod.mk ns1 cand)))
      ((some _) (mk_unique_name ns1 base (- tries 1)))))))
(fulfills mk_unique_name.dec_1 (by (intro p ht w0 he) (apply natAbs_pred (arith))))

;; replace_params (l. 1013): the constructor's own param locals As ↦ the shared params
(fn replace_params ((n N) (e Expr) (as (List Expr))) (Prod N Expr)
  (match (abstract_fvars (n_st n) e (fvar_ids as))
    ((Prod.mk st1 e1) (n_lift n (instantiate_rev st1 e1 (n_params n))))))

;; instantiate_pi_params (l. 1057): strip nparams Pis, instantiate them with Ds
(fn instantiate_pi_params ((st St) (e Expr) (k Int) (ds (List Expr))) (Prod St (Option Expr))
  (measure (Int.natAbs k))
  (if (<= k 0)
    (match (instantiate_rev st e ds)
      ((Prod.mk st1 r) (Prod.mk st1 (some r))))
    (match e
      ((Pi _ _ _ _ body) (instantiate_pi_params st body (- k 1) ds))
      (_ (Prod.mk st none)))))
(fulfills instantiate_pi_params.dec_1 (by (intro p h a b c d body hm) (apply natAbs_pred (arith))))

(fn declared_name ((n N) (nm Name)) Bool (mem_name nm (all_names (n_types n))))

;; does e mention a type being declared (including the aux types)?
(fn mentions_declared ((n N) (e Expr)) Bool
  (measure (struct e))
  (match e
    ((Const _ nm _) (declared_name n nm))
    ((App _ f a) (bool_or (mentions_declared n f) (mentions_declared n a)))
    ((Lam _ _ _ d b) (bool_or (mentions_declared n d) (mentions_declared n b)))
    ((Pi _ _ _ d b) (bool_or (mentions_declared n d) (mentions_declared n b)))
    ((Let _ _ t v b)
     (bool_or (bool_or (mentions_declared n t) (mentions_declared n v)) (mentions_declared n b)))
    ((Proj _ _ _ x) (mentions_declared n x))
    (_ false)))

(fn any_mentions_declared ((n N) (es (List Expr))) Bool
  (measure (struct es))
  (match es
    (nil false)
    ((cons e r) (bool_or (mentions_declared n e) (any_mentions_declared n r)))))
(fn any_loose ((es (List Expr))) Bool
  (measure (struct es))
  (match es
    (nil false)
    ((cons e r) (bool_or (has_loose_bvars e) (any_loose r)))))

;; is_nested_inductive_app (l. 1023): `I Ds is`, I a previously declared
;; inductive, Ds mention a declared type and have no loose bvars →
;; (I's name, levels, nparams, all)
(fn nested_app ((n N) (e Expr))
  (KRes (Option (Prod Name (Prod (List Level) (Prod Int (List Name))))))
  (if (bool_not (is_app e)) (KOk (n_st n) none)
  (match (get_app_fn e)
    ((Const _ iname ls)
     (match (env_find (n_env n) iname)
       ((some (InductInfo _ nparams _ all _ _ _ _ _))
        (let ((args (get_app_args e)))
          (if (< (len args) nparams) (KOk (n_st n) none)
          (let ((ds (take nparams args)))
            (if (bool_not (any_mentions_declared n ds)) (KOk (n_st n) none)
            (if (any_loose ds) (KFail (FRej (RuleViolation (sym "nested_params_with_locals"))))
            (KOk (n_st n) (some (Prod.mk iname (Prod.mk ls (Prod.mk nparams all)))))))))))
       (_ (KOk (n_st n) none))))
    (_ (KOk (n_st n) none)))))

(fn find_aux ((aux (List (Prod Expr Name))) (key Expr)) (Option Name)
  (measure (struct aux))
  (match aux
    (nil none)
    ((cons (Prod.mk k nm) r) (if (expr_eq k key) (some nm) (find_aux r key)))))

;; replace_if_nested (l. 1066): the replacement for e, if it is a nested occurrence
(fn replace_if_nested ((n N) (as (List Expr)) (e Expr)) (KRes (Prod N (Option Expr)))
  (match (nested_app n e)
    ((KFail f) (KFail f))
    ((KOk _ none) (KOk (n_st n) (Prod.mk n none)))
    ((KOk _ (some (Prod.mk iname (Prod.mk ls (Prod.mk inparams all)))))
     (let ((args (get_app_args e)))
       (let ((ds (take inparams args)) (rest (drop inparams args)))
         (match (n_app_list n (mk_const iname ls) ds)
           ((Prod.mk n0 ids)
            (match (replace_params n0 ids as)
              ((Prod.mk ns1 key)
               (match (find_aux (n_aux ns1) key)
                 ((some auxi) (aux_application ns1 auxi as rest))
                 (none
                   (match (create_aux_types ns1 as iname ls inparams ds all none)
                     ((KFail f) (KFail f))
                     ((KOk _ (Prod.mk ns2 (some auxi))) (aux_application ns2 auxi as rest))
                     ((KOk _ (Prod.mk ns2 none)) (KFail (FRej (Malformed (sym "nested_aux")))))))))))))))))

;; `auxI As rest`
(fn aux_application ((n N) (auxi Name) (as (List Expr)) (rest (List Expr)))
  (KRes (Prod N (Option Expr)))
  (match (n_app_list n (mk_const auxi (n_lvls n)) as)
    ((Prod.mk ns1 head)
     (match (n_app_list ns1 head rest)
       ((Prod.mk ns2 e1) (KOk (n_st ns2) (Prod.mk ns2 (some e1))))))))

;; l. 1093–1128: for every J in I's mutual block, an auxiliary type
;; auxJ with J's type and constructors instantiated at Ds, over As
(fn create_aux_types
  ((n N)
   (as (List Expr))
   (iname Name)
   (ls (List Level))
   (inparams Int)
   (ds (List Expr))
   (all (List Name))
   (result (Option Name)))
  (KRes (Prod N (Option Name)))
  (measure (struct all))
  (match all
    (nil (KOk (n_st n) (Prod.mk n result)))
    ((cons jname r)
     (match (env_find (n_env n) jname)
       ((some (InductInfo (ConstantVal _ jlps jty) _ _ _ jctors _ _ _ _))
        (match (mk_unique_name n (name_concat (nm_nested) jname) (nested_max))
          ((KFail f) (KFail f))
          ((KOk _ (Prod.mk ns1 auxj))
           (match (expr_inst_lparams (n_st ns1) jty jlps ls)
             ((Prod.mk st1 jty0)
              (match (instantiate_pi_params st1 jty0 inparams ds)
                ((Prod.mk st2 none) (KFail (FRej (Malformed (sym "nested_type_arity")))))
                ((Prod.mk st2 (some jty1))
                 (match (n_mk_pi (n_set_st ns1 st2) as jty1)
                   ((Prod.mk ns2 auxj_type)
                    (match (n_app_list ns2 (mk_const jname ls) ds)
                      ((Prod.mk n3 jds)
                       (match (replace_params n3 jds as)
                         ((Prod.mk n4 key)
                          (let ((n5 (n_add_aux n4 (Prod.mk key auxj))))
                            (match (aux_ctors n5 as jname auxj ls inparams ds jctors nil)
                              ((KFail f) (KFail f))
                              ((KOk _ (Prod.mk n6 ctors))
                               (create_aux_types
                                 (n_add_type n6 (InductiveType auxj auxj_type ctors))
                                 as
                                 iname
                                 ls
                                 inparams
                                 ds
                                 r
                                 (if (name_eq jname iname) (some auxj) result))))))))))))))))))
       (_ (KFail (FRej (Malformed (sym "nested_missing_type")))))))))

(fn aux_ctors
  ((n N)
   (as (List Expr))
   (jname Name)
   (auxj Name)
   (ls (List Level))
   (inparams Int)
   (ds (List Expr))
   (cnames (List Name))
   (acc (List Constructor)))
  (KRes (Prod N (List Constructor)))
  (measure (struct cnames))
  (match cnames
    (nil (KOk (n_st n) (Prod.mk n (rev acc))))
    ((cons cn r)
     (match (env_find (n_env n) cn)
       ((some (CtorInfo (ConstantVal _ clps cty) _ _ _ _ _))
        (match (expr_inst_lparams (n_st n) cty clps ls)
          ((Prod.mk st1 cty0)
           (match (instantiate_pi_params st1 cty0 inparams ds)
             ((Prod.mk st2 none) (KFail (FRej (Malformed (sym "nested_ctor_arity")))))
             ((Prod.mk st2 (some cty1))
              (match (n_mk_pi (n_set_st n st2) as cty1)
                ((Prod.mk ns1 cty2)
                 (aux_ctors ns1 as jname auxj ls inparams ds r
                   (cons (Constructor (name_replace_prefix cn jname auxj) cty2) acc)))))))))
       (_ (KFail (FRej (Malformed (sym "nested_missing_ctor")))))))))

;; replace_all_nested (l. 1134): top-down; a replaced subterm is not descended into
(fn replace_all_nested ((n N) (as (List Expr)) (e Expr)) (KRes (Prod N Expr))
  (measure (struct e))
  (match (replace_if_nested n as e)
    ((KFail f) (KFail f))
    ((KOk _ (Prod.mk ns1 (some e1))) (KOk (n_st ns1) (Prod.mk ns1 e1)))
    ((KOk _ (Prod.mk ns1 none))
     (match e
       ((App _ f a)
        (match (replace_all_nested ns1 as f)
          ((KFail x) (KFail x))
          ((KOk _ (Prod.mk ns2 f1))
           (match (replace_all_nested ns2 as a)
             ((KFail x) (KFail x))
             ((KOk _ (Prod.mk n3 a1))
              (match (n_lift n3 (new_app (n_st n3) f1 a1))
                ((Prod.mk n4 r) (KOk (n_st n4) (Prod.mk n4 r)))))))))
       ((Lam _ nm bi d b)
        (match (replace_all_nested ns1 as d)
          ((KFail x) (KFail x))
          ((KOk _ (Prod.mk ns2 d1))
           (match (replace_all_nested ns2 as b)
             ((KFail x) (KFail x))
             ((KOk _ (Prod.mk n3 b1))
              (match (n_lift n3 (new_lam (n_st n3) nm bi d1 b1))
                ((Prod.mk n4 r) (KOk (n_st n4) (Prod.mk n4 r)))))))))
       ((Pi _ nm bi d b)
        (match (replace_all_nested ns1 as d)
          ((KFail x) (KFail x))
          ((KOk _ (Prod.mk ns2 d1))
           (match (replace_all_nested ns2 as b)
             ((KFail x) (KFail x))
             ((KOk _ (Prod.mk n3 b1))
              (match (n_lift n3 (new_pi (n_st n3) nm bi d1 b1))
                ((Prod.mk n4 r) (KOk (n_st n4) (Prod.mk n4 r)))))))))
       ((Let _ nm t v b)
        (match (replace_all_nested ns1 as t)
          ((KFail x) (KFail x))
          ((KOk _ (Prod.mk ns2 t1))
           (match (replace_all_nested ns2 as v)
             ((KFail x) (KFail x))
             ((KOk _ (Prod.mk n3 v1))
              (match (replace_all_nested n3 as b)
                ((KFail x) (KFail x))
                ((KOk _ (Prod.mk n4 b1))
                 (match (n_lift n4 (new_let (n_st n4) nm t1 v1 b1))
                   ((Prod.mk n5 r) (KOk (n_st n5) (Prod.mk n5 r)))))))))))
       ((Proj _ s i x)
        (match (replace_all_nested ns1 as x)
          ((KFail y) (KFail y))
          ((KOk _ (Prod.mk ns2 x1))
           (match (n_lift ns2 (new_proj (n_st ns2) s i x1))
             ((Prod.mk n3 r) (KOk (n_st n3) (Prod.mk n3 r)))))))
       (_ (KOk (n_st ns1) (Prod.mk ns1 e)))))))

;; the worklist (l. 1153–1175): process type qhead's constructors, then the next
(fn elim_worklist ((n N) (qhead Int) (nparams Int)) (KRes N)
  (measure (Int.natAbs (- (nested_max) qhead)))
  (if (<= (nested_max) qhead) (KFail (FOut RHeartbeats (sym "elim_worklist")))
  (match (nth (n_types n) qhead)
    (none (KOk (n_st n) n))
    ((some t)
     (match (elim_ctors n (it_ctors t) nparams nil)
       ((KFail f) (KFail f))
       ((KOk _ (Prod.mk ns1 ctors))
        (elim_worklist (n_set_type ns1 qhead (InductiveType (it_name t) (it_type t) ctors))
          (+ qhead 1)
          nparams)))))))

(fn elim_ctors ((n N) (cs (List Constructor)) (nparams Int) (acc (List Constructor)))
  (KRes (Prod N (List Constructor)))
  (measure (struct cs))
  (match cs
    (nil (KOk (n_st n) (Prod.mk n (rev acc))))
    ((cons c r)
     ;; re-create the params for each constructor (binder infos preserved)
     (match (get_params n (ctor_type c) nparams nil)
       ((KFail f) (KFail f))
       ((KOk _ (Prod.mk ns1 (Prod.mk as body)))
        (match (replace_all_nested ns1 as body)
          ((KFail f) (KFail f))
          ((KOk _ (Prod.mk ns2 body1))
           (match (n_mk_pi ns2 as body1)
             ((Prod.mk n3 cty) (elim_ctors n3 r nparams (cons (Constructor (ctor_name c) cty) acc)))))))))))
(fulfills elim_worklist.dec_1
  (by (intro p hq t ht w0 ns1 ctors he) (apply natAbs_lt (arith) (arith))))

;; ---- restore_nested (l. 927) ------------------------------------------------------------------

;; the restoration state: the original env, params, aux2nested, the aux rec name map
(type R (R CheckedEnv St (List LDecl) (List Expr) (List (Prod Expr Name)) (List (Prod Name Name))))
(fn r_env ((r R)) CheckedEnv
  (match r
    ((R e _ _ _ _ _) e)))
(fn r_st ((r R)) St
  (match r
    ((R _ s _ _ _ _) s)))
(fn r_lctx ((r R)) (List LDecl)
  (match r
    ((R _ _ l _ _ _) l)))
(fn r_params ((r R)) (List Expr)
  (match r
    ((R _ _ _ p _ _) p)))
(fn r_aux ((r R)) (List (Prod Expr Name))
  (match r
    ((R _ _ _ _ a _) a)))
(fn r_recmap ((r R)) (List (Prod Name Name))
  (match r
    ((R _ _ _ _ _ m) m)))
(fn r_set_st ((r R) (s St)) R
  (match r
    ((R e _ l p a m) (R e s l p a m))))
(fn r_set_st_lctx ((r R) (s St) (l (List LDecl))) R
  (match r
    ((R e _ _ p a m) (R e s l p a m))))
(fn r_ctx ((r R)) Ctx (Ctx (r_env r) (r_lctx r) none Safe false (budget_ticks)))
(fn r_local ((r R) (nm Name) (ty Expr) (bi BinderInfo)) (Prod R Expr)
  (match (mk_local (r_ctx r) (r_st r) nm ty none bi)
    ((Loc c st fv) (Prod.mk (r_set_st_lctx r st (ctx_lctx c)) fv))))
(fn r_lift ((r R) (p (Prod St Expr))) (Prod R Expr)
  (match p
    ((Prod.mk st e) (Prod.mk (r_set_st r st) e))))

;; aux name → the nested `I Ds` (over the params)
(fn aux_nested ((aux (List (Prod Expr Name))) (nm Name)) (Option Expr)
  (measure (struct aux))
  (match aux
    (nil none)
    ((cons (Prod.mk e a) r) (if (name_eq a nm) (some e) (aux_nested r nm)))))

(fn lookup_name ((m (List (Prod Name Name))) (k Name)) (Option Name)
  (measure (struct m))
  (match m
    (nil none)
    ((cons (Prod.mk a b) r) (if (name_eq a k) (some b) (lookup_name r k)))))

;; get_nested_if_aux_constructor (l. 946): a constructor of an aux type → (nested, aux type)
(fn nested_if_aux_ctor ((r R) (aux_env CheckedEnv) (c Name)) (Option (Prod Expr Name))
  (match (env_find aux_env c)
    ((some (CtorInfo _ induct _ _ _ _))
     (match (aux_nested (r_aux r) induct)
       ((some nested) (some (Prod.mk nested induct)))
       (none none)))
    (_ none)))

;; restore one term: open the params, rewrite, close (Pi if it was a Pi, else Lam)
(fn restore_nested ((r R) (aux_env CheckedEnv) (e Expr)) (KRes (Prod R Expr))
  (match (restore_open r e (len (r_params r)) nil)
    ((KFail f) (KFail f))
    ((KOk _ (Prod.mk r1 (Prod.mk as body)))
     (match (restore_rewrite r1 aux_env as body)
       ((KFail f) (KFail f))
       ((KOk st2 body1)
        (match
          (r_lift (r_set_st r1 st2) (mk_binding (r_ctx r1) st2 (bool_not (is_pi e)) as body1 false))
          ((Prod.mk r2 e1) (KOk (r_st r2) (Prod.mk r2 e1)))))))))

(fn restore_open ((r R) (e Expr) (k Int) (acc (List Expr))) (KRes (Prod R (Prod (List Expr) Expr)))
  (measure (Int.natAbs k))
  (if (<= k 0) (KOk (r_st r) (Prod.mk r (Prod.mk (rev acc) e)))
  (match e
    ((Pi _ nm bi dom body)
     (match (r_local r nm dom bi)
       ((Prod.mk r1 x)
        (match (r_lift r1 (instantiate1 (r_st r1) body x))
          ((Prod.mk r2 b1) (restore_open r2 b1 (- k 1) (cons x acc)))))))
    ((Lam _ nm bi dom body)
     (match (r_local r nm dom bi)
       ((Prod.mk r1 x)
        (match (r_lift r1 (instantiate1 (r_st r1) body x))
          ((Prod.mk r2 b1) (restore_open r2 b1 (- k 1) (cons x acc)))))))
    (_ (KFail (FRej (RuleViolation (sym "nested_restore_binders"))))))))
(fulfills restore_open.dec_1
  (by (intro p h a nm bi dom body hm r1 x hx r2 b1 hb) (apply natAbs_pred (arith))))
(fulfills restore_open.dec_2
  (by (intro p h a nm bi dom body hm r1 x hx r2 b1 hb) (apply natAbs_pred (arith))))

;; `replace` with the restoration callback (l. 936–971), top-down; the KOk's
;; state is the state after the rebuild
(fn restore_rewrite ((r R) (aux_env CheckedEnv) (as (List Expr)) (e Expr)) (KRes Expr)
  (measure (struct e))
  (match (restore_at r aux_env as e)
    ((KFail f) (KFail f))
    ((KOk st1 (some e1)) (KOk st1 e1))
    ((KOk st1 none)
     (let ((r1 (r_set_st r st1)))
       (match e
         ((App _ f a)
          (match (restore_rewrite r1 aux_env as f)
            ((KFail x) (KFail x))
            ((KOk st2 f1)
             (match (restore_rewrite (r_set_st r1 st2) aux_env as a)
               ((KFail x) (KFail x))
               ((KOk st3 a1)
                (match (new_app st3 f1 a1)
                  ((Prod.mk st4 e1) (KOk st4 e1))))))))
         ((Lam _ nm bi d b)
          (match (restore_rewrite r1 aux_env as d)
            ((KFail x) (KFail x))
            ((KOk st2 d1)
             (match (restore_rewrite (r_set_st r1 st2) aux_env as b)
               ((KFail x) (KFail x))
               ((KOk st3 b1)
                (match (new_lam st3 nm bi d1 b1)
                  ((Prod.mk st4 e1) (KOk st4 e1))))))))
         ((Pi _ nm bi d b)
          (match (restore_rewrite r1 aux_env as d)
            ((KFail x) (KFail x))
            ((KOk st2 d1)
             (match (restore_rewrite (r_set_st r1 st2) aux_env as b)
               ((KFail x) (KFail x))
               ((KOk st3 b1)
                (match (new_pi st3 nm bi d1 b1)
                  ((Prod.mk st4 e1) (KOk st4 e1))))))))
         ((Let _ nm t v b)
          (match (restore_rewrite r1 aux_env as t)
            ((KFail x) (KFail x))
            ((KOk st2 t1)
             (match (restore_rewrite (r_set_st r1 st2) aux_env as v)
               ((KFail x) (KFail x))
               ((KOk st3 v1)
                (match (restore_rewrite (r_set_st r1 st3) aux_env as b)
                  ((KFail x) (KFail x))
                  ((KOk st4 b1)
                   (match (new_let st4 nm t1 v1 b1)
                     ((Prod.mk st5 e1) (KOk st5 e1))))))))))
         ((Proj _ s i x)
          (match (restore_rewrite r1 aux_env as x)
            ((KFail y) (KFail y))
            ((KOk st2 x1)
             (match (new_proj st2 s i x1)
               ((Prod.mk st3 e1) (KOk st3 e1))))))
         (_ (KOk st1 e)))))))

;; the nested expr (over the params) re-expressed over this term's own As
(fn over_as ((st St) (r R) (nested Expr) (as (List Expr))) (Prod St Expr)
  (match (abstract_fvars st nested (fvar_ids (r_params r)))
    ((Prod.mk st1 ns1) (instantiate_rev st1 ns1 as))))

(fn restore_at ((r R) (aux_env CheckedEnv) (as (List Expr)) (e Expr)) (KRes (Option Expr))
  (let ((np (len (r_params r))))
    (match e
      ((Const _ c ls)
       (match (lookup_name (r_recmap r) c)
         ((some c1) (KOk (r_st r) (some (mk_const c1 ls))))
         (none (restore_app r aux_env as e np))))
      (_ (restore_app r aux_env as e np)))))

(fn restore_app ((r R) (aux_env CheckedEnv) (as (List Expr)) (e Expr) (np Int)) (KRes (Option Expr))
  (match (get_app_fn e)
    ((Const _ fnn _)
     (match (aux_nested (r_aux r) fnn)
       ((some nested)
        (let ((args (get_app_args e)))
          (if (< (len args) np) (KFail (FRej (RuleViolation (sym "nested_aux_underapplied"))))
          (match (over_as (r_st r) r nested as)
            ((Prod.mk st1 head)
             (match (mk_app_list st1 head (drop np args))
               ((Prod.mk st2 e1) (KOk st2 (some e1)))))))))
       (none
         (match (nested_if_aux_ctor r aux_env fnn)
           (none (KOk (r_st r) none))
           ((some (Prod.mk nested auxi))
            (let ((args (get_app_args e)))
              (if (< (len args) np)
                (KFail (FRej (RuleViolation (sym "nested_aux_ctor_underapplied"))))
                (match (over_as (r_st r) r nested as)
                  ((Prod.mk st1 new_nested)
                   (match (get_app_fn new_nested)
                     ((Const _ iname ils)
                      (match
                        (mk_app_list st1 (mk_const (name_replace_prefix fnn auxi iname) ils)
                          (get_app_args new_nested))
                        ((Prod.mk st2 head)
                         (match (mk_app_list st2 head (drop np args))
                           ((Prod.mk st3 e1) (KOk st3 (some e1)))))))
                     (_ (KFail (FRej (RuleViolation (sym "nested_not_inductive_app")))))))))))))))
    (_ (KOk (r_st r) none))))

;; restore_constructor_name (l. 956)
(fn restore_ctor_name ((r R) (aux_env CheckedEnv) (cn Name)) (Option Name)
  (match (nested_if_aux_ctor r aux_env cn)
    (none none)
    ((some (Prod.mk nested auxi))
     (match (get_app_fn nested)
       ((Const _ iname _) (some (name_replace_prefix cn auxi iname)))
       (_ none)))))

;; mk_aux_rec_name_map (l. 1183): the aux recursors become main.rec_1, main.rec_2, …
(fn aux_rec_map
  ((all (List Name)) (ntypes Int) (main Name) (i Int) (next Int) (acc (List (Prod Name Name))))
  (List (Prod Name Name))
  (measure (struct all))
  (match all
    (nil (rev acc))
    ((cons nm r)
     (if (< i ntypes) (aux_rec_map r ntypes main (+ i 1) next acc)
     (aux_rec_map r ntypes main (+ i 1) (+ next 1)
       (cons (Prod.mk (mk_rec_name nm) (name_append_after (mk_rec_name main) next)) acc))))))

;; ---- environment::add_inductive (l. 1235) --------------------------------------------------------

(fn no_fvar_or_aux_types ((ts (List InductiveType))) (Option Failure)
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons t r)
     (if (has_fvar (it_type t)) (some (FRej (Malformed (sym "fvar_in_type"))))
     (if (mentions_nested_aux (it_type t))
       (some (FRej (RuleViolation (sym "reserved_nested_prefix"))))
       (match (no_fvar_or_aux_ctors (it_ctors t))
         ((some f) (some f))
         (none (no_fvar_or_aux_types r))))))))
(fn no_fvar_or_aux_ctors ((cs (List Constructor))) (Option Failure)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons c r)
     (if (has_fvar (ctor_type c)) (some (FRej (Malformed (sym "fvar_in_type"))))
     (if (mentions_nested_aux (ctor_type c))
       (some (FRej (RuleViolation (sym "reserved_nested_prefix"))))
       (no_fvar_or_aux_ctors r))))))

(fn add_inductive
  ((env CheckedEnv)
   (st St)
   (lps (List Name))
   (nparams Int)
   (types (List InductiveType))
   (is_unsafe Bool))
  (KRes CheckedEnv)
  (match (no_fvar_or_aux_types types)
    ((some f) (KFail f))
    (none
      (match (check_uniform lps nparams types)
        ((some f) (KFail f))
        (none
          (match types
            (nil (KFail (FRej (RuleViolation (sym "empty_inductive_block")))))
            ((cons t0 _)
             (let ((n0 (N.N env st nil (params_to_levels lps) nil nil types 1)))
               (match (get_params n0 (it_type t0) nparams nil)
                 ((KFail f) (KFail f))
                 ((KOk _ (Prod.mk ns1 (Prod.mk params _)))
                  (match (elim_worklist (n_set_params ns1 params) 0 nparams)
                    ((KFail f) (KFail f))
                    ((KOk _ ns2)
                     (let ((nnested (len (n_aux ns2))))
                       (match
                         (add_inductive_core env (n_st ns2) lps nparams (n_types ns2) is_unsafe
                           nnested)
                         ((KFail f) (KFail f))
                         ((KOk st1 aux_env)
                          (if (= nnested 0) (KOk st1 aux_env)
                          (restore_all env st1 (n_lctx ns2) params (n_aux ns2) types lps aux_env
                            is_unsafe)))))))))))))))))

;; l. 1255–1345: rebuild the original types, constructors and recursors in
;; the ORIGINAL environment from the auxiliary one, then re-check
(fn restore_all
  ((env CheckedEnv)
   (st St)
   (lctx (List LDecl))
   (params (List Expr))
   (aux (List (Prod Expr Name)))
   (types (List InductiveType))
   (lps (List Name))
   (aux_env CheckedEnv)
   (is_unsafe Bool))
  (KRes CheckedEnv)
  (match types
    (nil (KFail (FRej (Malformed (sym "nested_restore")))))
    ((cons main _)
     (match (env_find aux_env (it_name main))
       ((some (InductInfo _ _ _ all_aux _ _ _ _ _))
        (let
          ((recmap (aux_rec_map all_aux (len types) (it_name main) 0 1 nil))
           (all (all_names types)))
          (let ((r0 (R.R env (st_clear_memo st) lctx params aux recmap)))  ; a new environment: fresh memo
            (match (restore_types r0 aux_env types all none)
              ((KFail f) (KFail f))
              ((KOk _ (Prod.mk r1 new_env1))
               (match (restore_recs r1 aux_env (map_fst recmap) all new_env1 nil)
                 ((KFail f) (KFail f))
                 ((KOk _ (Prod.mk r2 (Prod.mk new_env2 rec_names)))
                  (match (check_nested_apps r2 new_env2 aux lps is_unsafe)
                    ((KFail f) (KFail f))
                    ((KOk st3 _)
                     (match
                       (recheck_restored (r_set_st_lctx r2 st3 (r_lctx r2)) new_env2 types lps
                         rec_names
                         is_unsafe)
                       ((KFail f) (KFail f))
                       ((KOk st4 _) (KOk st4 new_env2))))))))))))
       (_ (KFail (FRej (Malformed (sym "nested_restore")))))))))

(fn map_fst ((m (List (Prod Name Name)))) (List Name)
  (measure (struct m))
  (match m
    (nil nil)
    ((cons (Prod.mk a _) r) (cons a (map_fst r)))))

;; the original types: InductInfo with `all` = the original names; ctors restored; main recursors
(fn restore_types
  ((r R)
   (aux_env CheckedEnv)
   (types (List InductiveType))
   (all (List Name))
   (acc_env (Option CheckedEnv)))
  (KRes (Prod R CheckedEnv))
  (measure (struct types))
  (let
    ((env CheckedEnv
       (match acc_env
         ((some e) e)
         (none (r_env r)))))
    (match types
      (nil (KOk (r_st r) (Prod.mk r env)))
      ((cons t rest)
       (match (env_find aux_env (it_name t))
         ((some (InductInfo cv np ni _ ctors nn isrec unsafe isrefl))
          (match (env_check_name env (it_name t))
            ((some f) (KFail f))
            (none
              (let
                ((env1
                   (env_add env (it_name t) (InductInfo cv np ni all ctors nn isrec unsafe isrefl))))
                (match (restore_ctors r aux_env ctors env1)
                  ((KFail f) (KFail f))
                  ((KOk _ (Prod.mk r1 env2))
                   (match (restore_rec r1 aux_env (mk_rec_name (it_name t)) all env2)
                     ((KFail f) (KFail f))
                     ((KOk _ (Prod.mk r2 env3)) (restore_types r2 aux_env rest all (some env3))))))))))
         (_ (KFail (FRej (Malformed (sym "nested_restore_type"))))))))))

(fn restore_ctors ((r R) (aux_env CheckedEnv) (ctors (List Name)) (env CheckedEnv))
  (KRes (Prod R CheckedEnv))
  (measure (struct ctors))
  (match ctors
    (nil (KOk (r_st r) (Prod.mk r env)))
    ((cons cn rest)
     (match (env_find aux_env cn)
       ((some (CtorInfo (ConstantVal _ lps ty) induct cidx np nf unsafe))
        (match (restore_nested r aux_env ty)
          ((KFail f) (KFail f))
          ((KOk _ (Prod.mk r1 ty1))
           (match (env_check_name env cn)
             ((some f) (KFail f))
             (none
               (restore_ctors r1 aux_env rest
                 (env_add env cn (CtorInfo (ConstantVal cn lps ty1) induct cidx np nf unsafe))))))))
       (_ (KFail (FRej (Malformed (sym "nested_restore_ctor")))))))))

;; process_rec (l. 1266): one recursor (main or aux) restored into env
(fn restore_rec ((r R) (aux_env CheckedEnv) (rec_name Name) (all (List Name)) (env CheckedEnv))
  (KRes (Prod R CheckedEnv))
  (let
    ((new_name Name
       (match (lookup_name (r_recmap r) rec_name)
         ((some nn) nn)
         (none rec_name))))
    (match (env_find aux_env rec_name)
      ((some (RecInfo (ConstantVal _ lps ty) _ np ni nmot nmin rules k unsafe))
       (match (restore_nested r aux_env ty)
         ((KFail f) (KFail f))
         ((KOk _ (Prod.mk r1 ty1))
          (match (restore_rules r1 aux_env rules (bool_not (name_eq new_name rec_name)) nil)
            ((KFail f) (KFail f))
            ((KOk _ (Prod.mk r2 rules1))
             (match (env_check_name env new_name)
               ((some f) (KFail f))
               (none
                 (KOk (r_st r2)
                   (Prod.mk r2
                     (env_add env new_name
                       (RecInfo (ConstantVal new_name lps ty1) all np ni nmot nmin rules1 k unsafe)))))))))))
      (_ (KFail (FRej (Malformed (sym "nested_restore_rec"))))))))

(fn restore_rules
  ((r R) (aux_env CheckedEnv) (rules (List RecursorRule)) (rename Bool) (acc (List RecursorRule)))
  (KRes (Prod R (List RecursorRule)))
  (measure (struct rules))
  (match rules
    (nil (KOk (r_st r) (Prod.mk r (rev acc))))
    ((cons (RecursorRule cn nf rhs) rest)
     (match (restore_nested r aux_env rhs)
       ((KFail f) (KFail f))
       ((KOk _ (Prod.mk r1 rhs1))
        (let
          ((cn1
             (if rename
               (match (restore_ctor_name r1 aux_env cn)
                 ((some c) c)
                 (none cn))
               cn)))
          (restore_rules r1 aux_env rest rename (cons (RecursorRule cn1 nf rhs1) acc))))))))

;; the aux recursors, after the main ones (l. 1311)
(fn restore_recs
  ((r R)
   (aux_env CheckedEnv)
   (aux_recs (List Name))
   (all (List Name))
   (env CheckedEnv)
   (acc (List Name)))
  (KRes (Prod R (Prod CheckedEnv (List Name))))
  (measure (struct aux_recs))
  (match aux_recs
    (nil (KOk (r_st r) (Prod.mk r (Prod.mk env (rev acc)))))
    ((cons rn rest)
     (match (restore_rec r aux_env rn all env)
       ((KFail f) (KFail f))
       ((KOk _ (Prod.mk r1 env1))
        (restore_recs r1 aux_env rest all env1
          (cons
            (match (lookup_name (r_recmap r1) rn)
              ((some nn) nn)
              (none rn))
            acc)))))))

;; l. 1318–1326: the nested applications `I Ds` are type checked in the final env
(fn check_nested_apps
  ((r R) (env CheckedEnv) (aux (List (Prod Expr Name))) (lps (List Name)) (is_unsafe Bool))
  (KRes Int)
  (measure (struct aux))
  (match aux
    (nil (KOk (r_st r) 0))
    ((cons (Prod.mk nested _) rest)
     (match
       (infer (Ctx env (r_lctx r) (some lps) (if is_unsafe Unsafe Safe) false (budget_ticks))
         (r_st r)
         (budget_depth)
         nested
         false)
       ((KFail f) (KFail f))
       ((KOk st1 _) (check_nested_apps (r_set_st_lctx r st1 (r_lctx r)) env rest lps is_unsafe))))))

;; l. 1334–1345: every restored constructor type, recursor type and rule rhs re-checks
(fn recheck_restored
  ((r R)
   (env CheckedEnv)
   (types (List InductiveType))
   (lps (List Name))
   (aux_rec_names (List Name))
   (is_unsafe Bool))
  (KRes Int)
  (match (recheck_ctor_types r env (all_ctor_names types) lps is_unsafe)
    ((KFail f) (KFail f))
    ((KOk st1 _)
     (recheck_recs (r_set_st_lctx r st1 (r_lctx r)) env
       (append (main_rec_names types) aux_rec_names)
       is_unsafe))))

(fn all_ctor_names ((ts (List InductiveType))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (append (ctor_names (it_ctors t)) (all_ctor_names r)))))
(fn main_rec_names ((ts (List InductiveType))) (List Name)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (cons (mk_rec_name (it_name t)) (main_rec_names r)))))

(fn recheck_ctor_types ((r R) (env CheckedEnv) (cs (List Name)) (lps (List Name)) (is_unsafe Bool))
  (KRes Int)
  (measure (struct cs))
  (match cs
    (nil (KOk (r_st r) 0))
    ((cons cn rest)
     (match (env_find env cn)
       ((some info)
        (match
          (infer (Ctx env nil (some lps) (if is_unsafe Unsafe Safe) false (budget_ticks)) (r_st r)
            (budget_depth)
            (ci_type info)
            false)
          ((KFail f) (KFail f))
          ((KOk st1 _) (recheck_ctor_types (r_set_st_lctx r st1 (r_lctx r)) env rest lps is_unsafe))))
       (none (KFail (FRej (Malformed (sym "nested_recheck")))))))))

(fn recheck_recs ((r R) (env CheckedEnv) (recs (List Name)) (is_unsafe Bool)) (KRes Int)
  (measure (struct recs))
  (match recs
    (nil (KOk (r_st r) 0))
    ((cons rn rest)
     (match (env_find env rn)
       ((some (RecInfo (ConstantVal _ lps ty) _ _ _ _ _ rules _ _))
        (match
          (infer (Ctx env nil (some lps) (if is_unsafe Unsafe Safe) false (budget_ticks)) (r_st r)
            (budget_depth)
            ty
            false)
          ((KFail f) (KFail f))
          ((KOk st1 _)
           (match (recheck_rules (r_set_st_lctx r st1 (r_lctx r)) env rules lps is_unsafe)
             ((KFail f) (KFail f))
             ((KOk st2 _) (recheck_recs (r_set_st_lctx r st2 (r_lctx r)) env rest is_unsafe))))))
       (_ (KFail (FRej (Malformed (sym "nested_recheck_rec")))))))))

(fn recheck_rules
  ((r R) (env CheckedEnv) (rules (List RecursorRule)) (lps (List Name)) (is_unsafe Bool))
  (KRes Int)
  (measure (struct rules))
  (match rules
    (nil (KOk (r_st r) 0))
    ((cons (RecursorRule _ _ rhs) rest)
     (match
       (infer (Ctx env nil (some lps) (if is_unsafe Unsafe Safe) false (budget_ticks)) (r_st r)
         (budget_depth)
         rhs
         false)
       ((KFail f) (KFail f))
       ((KOk st1 _) (recheck_rules (r_set_st_lctx r st1 (r_lctx r)) env rest lps is_unsafe))))))
