;;; v3/kernel/k/test/add_test.shard — environment-level admission and quotients; and the
;;; environment's one counter (LANGUAGE.md §8.6 "One environment, one counter"): after record
;;; runs and raw checks in turn, no id of the environment stands on two different nodes.

(import "../../host.shard")
(import "../../json.shard")
(import "../add.shard")
(import "../import.shard")
(import "../../test/case_kit.shard")
(import "../../test/decls_kit.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.expr.D)
(use kernel.expr.Expr)
(use kernel.json.JRes)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
