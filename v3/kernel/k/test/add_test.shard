;;; v3/kernel/k/test/add_test.shard — environment-level admission and quotients; and the
;;; environment's one counter (docs/KERNEL.md "The state discipline"): after record
;;; runs and raw checks in turn, no id of the environment stands on two different nodes.

(import "../../host.shard")
(import "../../json.shard")
(import "../add.shard")
(import "../import.shard")
(import "../../test/case_kit.shard")
(import "../../test/decls_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.intmap)
(use kernel.json)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.expr.D)
(use kernel.expr.Expr)
(use kernel.json.JRes)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.k.Ctx)
(use kernel.verdict.KRes)
(use kernel.k.LDecl)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn rejected ((o (Outcome CheckedEnv)) (s Symbol)) Bool
  (match o
    ((Rejected (RuleViolation t) _) (sym_eq s t))
    ((Rejected (Malformed t) _) (sym_eq s t))
    ((Rejected (Unsupported t) _) (sym_eq s t))
    ((Rejected (ConversionNotEstablished) _) (sym_eq s (sym "conversion")))
    (_ false)))

(fn e0 () CheckedEnv (CheckedEnv IMEmpty false nil 0))
(fn e_nat () CheckedEnv (env_after (check (e0) (st0) (nat_decl)) (e0)))
(fn e_eq () CheckedEnv (env_after (check (e_nat) (st0) (eq_decl)) (e0)))
(fn e_quot () CheckedEnv (env_after (check (e_eq) (st0) QuotDecl) (e0)))

(fn id_decl () Declaration
  (DefnDecl (cv (n1 (sym "idn")) nil (arrow (nat) (nat))) (mk_lam (x_) BDefault (nat) (mk_bvar 0))
    (HRegular 1)
    Safe
    (list (n1 (sym "idn")))))
(fn bad_defn () Declaration
  (DefnDecl (cv (n1 (sym "bad")) nil (arrow (nat) (nat))) (zero) (HRegular 1) Safe
    (list (n1 (sym "bad")))))
;; theorem rfl0 : Eq Nat 0 0 := Eq.refl Nat 0
(fn thm_decl () Declaration
  (ThmDecl (cv (n1 (sym "rfl0")) nil (eq_nat (zero) (zero)))
    (mk_app (mk_app (mk_const (nm_eq_refl) (list (LSucc LZero))) (nat)) (zero))
    (list (n1 (sym "rfl0")))))
;; theorem by computation: Eq Nat (Nat.succ 1) 2 := Eq.refl Nat 2
(fn thm_comp () Declaration
  (ThmDecl (cv (n1 (sym "s1")) nil (eq_nat (mk_app (mk_const (nm_nat_succ) nil) (lit 1)) (lit 2)))
    (mk_app (mk_app (mk_const (nm_eq_refl) (list (LSucc LZero))) (nat)) (lit 2))
    (list (n1 (sym "s1")))))
(fn thm_wrong () Declaration
  (ThmDecl (cv (n1 (sym "w")) nil (eq_nat (lit 1) (lit 2)))
    (mk_app (mk_app (mk_const (nm_eq_refl) (list (LSucc LZero))) (nat)) (lit 2))
    (list (n1 (sym "w")))))
(fn thm_not_prop () Declaration
  (ThmDecl (cv (n1 (sym "np")) nil (nat)) (zero) (list (n1 (sym "np")))))
(fn ax_decl () Declaration (AxiomDecl (cv (n1 (sym "ax")) nil (eq_nat (lit 1) (lit 2))) false))
(fn ax_unsafe () Declaration (AxiomDecl (cv (n1 (sym "axu")) nil (nat)) true))
(fn opaque_decl () Declaration
  (OpaqueDecl (cv (n1 (sym "op")) nil (nat)) (zero) false (list (n1 (sym "op")))))
(fn univ_decl () Declaration (AxiomDecl (cv (n1 (sym "uu")) nil (mk_sort (u))) false))
(fn dup_univ () Declaration
  (AxiomDecl (cv (n1 (sym "du")) (list (n1 (sym "u")) (n1 (sym "u"))) (mk_sort (u))) false))

;; Quot.lift.{1,1} Nat r Nat f h (Quot.mk Nat r 3) ⇒ f 3, with r, f, h opaque locals
(fn quot_ctx () Ctx
  (Ctx (e_quot)
    (list (LDecl 1002 (n1 (sym "h")) (nat) none BDefault)  ; type irrelevant to the reduction rule
      (LDecl 1001 (n1 (sym "f")) (arrow (nat) (nat)) none BDefault)
      (LDecl 1000 (n1 (sym "r")) (arrow (nat) (arrow (nat) (mk_sort LZero))) none BDefault))
    (some nil)
    Safe
    false
    1000000))
(fn quot_lift_app () Expr
  (mk_app
    (mk_app
      (mk_app
        (mk_app
          (mk_app (mk_app (mk_const (nm_quot_lift) (list (LSucc LZero) (LSucc LZero))) (nat))
            (mk_fvar 1000))
          (nat))
        (mk_fvar 1001))
      (mk_fvar 1002))
    (mk_app (mk_app (mk_app (mk_const (nm_quot_mk) (list (LSucc LZero))) (nat)) (mk_fvar 1000))
      (lit 3))))
(fn ok_is ((r (KRes Expr)) (e Expr)) Bool
  (match r
    ((KOk _ x) (expr_eq x e))
    (_ false)))

;; ---- one environment, one counter ---------------------------------------------------------
;; the census of an environment: every identified node reachable from its constants, its id to
;; its hash — the nodes counted, the ids met again under another hash (two different nodes
;; wearing one id: what expr_eq's shortcut would equate), the greatest id
(type Census (Census (IntMap Int) Int Int Int))
(fn cen_two ((c Census)) Int
  (match c
    ((Census _ _ t _) t)))
(fn cen_nodes ((c Census)) Int
  (match c
    ((Census _ n _ _) n)))
(fn cen_top ((c Census)) Int
  (match c
    ((Census _ _ _ m) m)))
;; the census after a node, and whether its children are still to be read
(fn cen_node ((c Census) (d D)) (Prod Census Bool)
  (match d
    ((D id h _ _ _ _)
     (if (< 0 id)
       (match c
         ((Census m n t top)
          (match (im_find m id)
            ((some h0) (if (= h0 h) (Prod.mk c false) (Prod.mk (Census m n (+ t 1) top) true)))
            (none (Prod.mk (Census (im_insert m id h) (+ n 1) t (max_int top id)) true)))))
       (Prod.mk c true)))))
(fn cen_expr ((c Census) (e Expr)) Census
  (measure (struct e))
  (match (cen_node c (expr_d e))
    ((Prod.mk c1 false) c1)
    ((Prod.mk c1 true)
     (match e
       ((App _ f a) (cen_expr (cen_expr c1 f) a))
       ((Lam _ _ _ t b) (cen_expr (cen_expr c1 t) b))
       ((Pi _ _ _ t b) (cen_expr (cen_expr c1 t) b))
       ((Let _ _ t v b) (cen_expr (cen_expr (cen_expr c1 t) v) b))
       ((Proj _ _ _ x) (cen_expr c1 x))
       (_ c1)))))
(fn cen_rules ((c Census) (rs (List RecursorRule))) Census
  (measure (struct rs))
  (match rs
    (nil c)
    ((cons (RecursorRule _ _ rhs) r) (cen_rules (cen_expr c rhs) r))))
(fn cen_info ((c Census) (i ConstantInfo)) Census
  (let ((c1 (cen_expr c (ci_type i))))
    (match i
      ((DefnInfo _ v _ _ _) (cen_expr c1 v))
      ((ThmInfo _ v _) (cen_expr c1 v))
      ((OpaqueInfo _ v _ _) (cen_expr c1 v))
      ((RecInfo _ _ _ _ _ _ rules _ _) (cen_rules c1 rules))
      (_ c1))))
(fn cen_all ((c Census) (xs (List (Prod Name ConstantInfo)))) Census
  (measure (struct xs))
  (match xs
    (nil c)
    ((cons (Prod.mk _ i) r) (cen_all (cen_info c i) r))))
(fn census ((env CheckedEnv)) Census (cen_all (Census IMEmpty 0 0 0) (env_entries env)))

(fn feed ((r Run) (lines (List (List Int)))) Run
  (measure (struct lines))
  (match lines
    (nil r)
    ((cons l rest)
     (match (json_parse l)
       ((JRes j _)
        (match (process_record r j)
          ((Prod.mk r1 _) (feed r1 rest))))
       (JErr r)))))
;; c1 : Prop → Prop := fun p => p
(fn recs_c1 () (List (List Int))
  (utf8_all
    (list "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"c1\"}}" "{\"ie\":1,\"sort\":0}"
      "{\"ie\":2,\"forallE\":{\"binderInfo\":\"default\",\"body\":1,\"name\":0,\"type\":1}}"
      "{\"ie\":3,\"bvar\":0}"
      "{\"ie\":4,\"lam\":{\"binderInfo\":\"default\",\"body\":3,\"name\":0,\"type\":1}}"
      "{\"def\":{\"all\":[1],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":1,\"safety\":\"safe\",\"type\":2,\"value\":4}}")))
;; h : F → F := fun x => x, F = (p : Prop) → p
(fn recs_h () (List (List Int))
  (utf8_all
    (list "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"h\"}}" "{\"ie\":11,\"sort\":0}"
      "{\"ie\":12,\"bvar\":0}"
      "{\"ie\":13,\"forallE\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":11}}"
      "{\"ie\":14,\"forallE\":{\"binderInfo\":\"default\",\"body\":13,\"name\":0,\"type\":13}}"
      "{\"ie\":15,\"lam\":{\"binderInfo\":\"default\",\"body\":12,\"name\":0,\"type\":13}}"
      "{\"def\":{\"all\":[2],\"hints\":{\"regular\":1},\"levelParams\":[],\"name\":2,\"safety\":\"safe\",\"type\":14,\"value\":15}}")))
(fn e_c1 () CheckedEnv (run_env (feed (empty_run false) (recs_c1))))
(fn e_h () CheckedEnv (run_env (feed (empty_run false) (recs_h))))
;; the turns a load takes: records; a raw inductive (K generates its constructors' and its
;; recursor's terms); a fresh run over what stands, more records; a raw inductive; a raw theorem
(fn e_turns () CheckedEnv
  (env_after
    (check
      (env_after
        (check (run_env (feed (run_on (env_after (check (e_c1) (st0) (nat_decl)) (e0))) (recs_h)))
          (st0)
          (eq_decl))
        (e0))
      (st0)
      (thm_decl))
    (e0)))
(fn has ((e CheckedEnv) (n Name)) Bool
  (match (env_find e n)
    ((some _) true)
    (none false)))
(fn type_of ((e CheckedEnv) (n Name)) Expr
  (match (env_find e n)
    ((some i) (ci_type i))
    (none (nat))))
(fn dom_of ((x Expr)) Expr
  (match x
    ((Pi _ _ _ dm _) dm)
    (_ x)))
;; the census's control, an environment only this directory can spell: c1's type from one run
;; and the domain of h's type from another — one id, two nodes — as two axioms' types
(fn e_forged () CheckedEnv
  (env_add
    (env_add (e0) (n1 (sym "fa"))
      (AxiomInfo (ConstantVal (n1 (sym "fa")) nil (type_of (e_c1) (n1 (sym "c1")))) false))
    (n1 (sym "fb"))
    (AxiomInfo (ConstantVal (n1 (sym "fb")) nil (dom_of (type_of (e_h) (n1 (sym "h"))))) false)))

(fn cases () (List Case)
  (list (Case (utf8 "Nat accepted") (accepted (check (e0) (st0) (nat_decl))))
    (Case (utf8 "Eq accepted") (accepted (check (e_nat) (st0) (eq_decl))))
    (Case (utf8 "Quot accepted after Eq") (accepted (check (e_eq) (st0) QuotDecl)))
    (Case (utf8 "Quot refused without Eq")
      (rejected (check (e_nat) (st0) QuotDecl) (sym "quot_eq_shape")))
    (Case (utf8 "Quot constants present and typed")
      (match (env_find (e_quot) (nm_quot_lift))
        ((some i)
         (match
           (infer (Ctx (e_quot) nil (some (list (n1 (sym "u")) (n1 (sym "v")))) Safe false 1000000)
             (st0)
             300
             (ci_type i)
             false)
           ((KOk _ s) (is_sort s))
           (_ false)))
        (none false)))
    (Case (utf8 "Quot.ind type checks")
      (match (env_find (e_quot) (nm_quot_ind))
        ((some i)
         (match
           (infer (Ctx (e_quot) nil (some (list (n1 (sym "u")))) Safe false 1000000) (st0) 300
             (ci_type i)
             false)
           ((KOk _ s) (is_sort s))
           (_ false)))
        (none false)))
    (Case (utf8 "Quot.lift f h (Quot.mk r 3) ⇒ f 3")
      (ok_is (whnf (quot_ctx) (st_for (e_quot)) 300 (quot_lift_app)) (mk_app (mk_fvar 1001) (lit 3))))
    (Case (utf8 "Quot idempotent") (accepted (check (e_quot) (st0) QuotDecl)))
    (Case (utf8 "definition accepted") (accepted (check (e_nat) (st0) (id_decl))))
    (Case (utf8 "definition value/type mismatch: conversion not established")
      (rejected (check (e_nat) (st0) (bad_defn)) (sym "conversion")))
    (Case (utf8 "theorem rfl0 accepted") (accepted (check (e_eq) (st0) (thm_decl))))
    (Case (utf8 "theorem by computation: succ 1 = 2 by rfl")
      (accepted (check (e_eq) (st0) (thm_comp))))
    (Case (utf8 "theorem 1 = 2 by rfl refused")
      (rejected (check (e_eq) (st0) (thm_wrong)) (sym "conversion")))
    (Case (utf8 "theorem whose type is not a Prop refused")
      (rejected (check (e_eq) (st0) (thm_not_prop)) (sym "theorem_type_not_prop")))
    (Case (utf8 "axiom accepted (tracked, not judged)") (accepted (check (e_eq) (st0) (ax_decl))))
    (Case (utf8 "unsafe axiom unsupported")
      (rejected (check (e_nat) (st0) (ax_unsafe)) (sym "unsafe_declaration")))
    (Case (utf8 "opaque accepted") (accepted (check (e_nat) (st0) (opaque_decl))))
    (Case (utf8 "opaque never unfolds")
      (ok_is
        (whnf
          (Ctx (env_after (check (e_nat) (st0) (opaque_decl)) (e0)) nil (some nil) Safe false
            1000000)
          (st0)
          300
          (mk_const (n1 (sym "op")) nil))
        (mk_const (n1 (sym "op")) nil)))
    (Case (utf8 "undefined universe in a type refused")
      (rejected (check (e_nat) (st0) (univ_decl)) (sym "undefined_universe")))
    (Case (utf8 "duplicate universe parameter refused")
      (rejected (check (e_nat) (st0) (dup_univ)) (sym "duplicate_univ_param")))
    (Case (utf8 "redeclaration refused")
      (rejected (check (e_nat) (st0) (nat_decl)) (sym "already_declared")))
    (Case (utf8 "mutual block unsupported")
      (rejected (check (e_nat) (st0) (MutualDefnDecl nil)) (sym "mutual_unsafe_block")))
    (Case
      (utf8
        "one counter: records, a raw inductive, a fresh run's records, a raw inductive, a raw theorem — all held")
      (bool_and (has (e_turns) (n1 (sym "c1")))
        (bool_and (has (e_turns) (nat_n))
          (bool_and (has (e_turns) (n1 (sym "h")))
            (bool_and (has (e_turns) (eq_n)) (has (e_turns) (n1 (sym "rfl0"))))))))
    (Case (utf8 "one counter: the census reads its identified nodes")
      (< 8 (cen_nodes (census (e_turns)))))
    (Case (utf8 "one counter: no id of it stands on two different nodes")
      (= (cen_two (census (e_turns))) 0))
    (Case (utf8 "one counter: no id of it exceeds the watermark")
      (<= (cen_top (census (e_turns))) (env_watermark (e_turns))))
    (Case
      (utf8
        "one counter: the census's control — two runs' first nodes as one environment's — reads one id on two nodes")
      (= (cen_two (census (e_forged))) 1))))


(fn main ((w World)) World (run_cases (utf8 "add_test") (cases) 0 w))
