;;; v3/kernel/k/test/inductive_test.shard — admission and recursor generation.

(import "../../host.shard")
(import "../inductive.shard")
(import "../../test/case_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.k)
(use kernel.expr)
(use kernel.host)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.expr.St)
(use kernel.host.World)
(use kernel.k.A)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.k.Ctx)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)
(use kernel.k.LDecl)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)


(fn u () Level (LParam (n1 (sym "u"))))
(fn nat () Expr (mk_const (nm_nat) nil))
(fn zero () Expr (mk_const (nm_nat_zero) nil))
(fn succ () Expr (mk_const (nm_nat_succ) nil))
(fn lit ((k Int)) Expr (mk_lit (LitNat k)))
(fn nm_rec () Name (n2 (sym "Nat") (sym "rec")))
(fn x_ () Name (n1 (sym "x")))
(fn val ((p (Prod St Expr))) Expr
  (match p
    ((Prod.mk _ e) e)))
(fn arrow ((a Expr) (b Expr)) Expr (mk_pi (x_) BDefault a (val (lift_loose_bvars (st_anon) b 0 1))))
(fn type1 () Expr (mk_sort (LSucc LZero)))
(fn st0 () St (st_init))
(fn empty_env () CheckedEnv (CheckedEnv IMEmpty false (list (nm_nat)) 0))

;; the hand-written Nat.rec of tc_test, for the cross-check
(fn rec_type () Expr
  (mk_pi (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_pi (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_pi (n1 (sym "succ")) BDefault
        (mk_pi (n1 (sym "n")) BDefault (nat)
          (mk_pi (n1 (sym "ih")) BDefault (mk_app (mk_bvar 2) (mk_bvar 0))
            (mk_app (mk_bvar 3) (mk_app (succ) (mk_bvar 1)))))
        (mk_pi (n1 (sym "t")) BDefault (nat) (mk_app (mk_bvar 3) (mk_bvar 0)))))))
(fn succ_dom () Expr
  (mk_pi (n1 (sym "n")) BDefault (nat)
    (mk_pi (n1 (sym "ih")) BDefault (mk_app (mk_bvar 2) (mk_bvar 0))
      (mk_app (mk_bvar 3) (mk_app (succ) (mk_bvar 1))))))
(fn rule_zero () Expr
  (mk_lam (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_lam (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_lam (n1 (sym "succ")) BDefault (succ_dom) (mk_bvar 1)))))
(fn rule_succ () Expr
  (mk_lam (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_lam (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_lam (n1 (sym "succ")) BDefault (succ_dom)
        (mk_lam (n1 (sym "n")) BDefault (nat)
          (mk_app (mk_app (mk_bvar 1) (mk_bvar 0))
            (mk_app
              (mk_app (mk_app (mk_app (mk_const (nm_rec) (list (u))) (mk_bvar 3)) (mk_bvar 2))
                (mk_bvar 1))
              (mk_bvar 0))))))))

(fn nat_decl () (List InductiveType)
  (list
    (InductiveType (nm_nat) (type1)
      (list (Constructor (nm_nat_zero) (nat))
        (Constructor (nm_nat_succ) (mk_pi (n1 (sym "n")) BDefault (nat) (nat)))))))

;; admission seeded from the env's watermark; the result carries the new one
(fn add ((env CheckedEnv) (lps (List Name)) (np Int) (ts (List InductiveType))) (KRes CheckedEnv)
  (match (add_inductive_core env (st_for env) lps np ts false 0)
    ((KFail f) (KFail f))
    ((KOk st1 e1) (KOk st1 (env_set_watermark e1 (st_node st1))))))

(fn env_of ((r (KRes CheckedEnv))) CheckedEnv
  (match r
    ((KOk _ e) e)
    (_ (empty_env))))
(fn accepted ((r (KRes CheckedEnv))) Bool
  (match r
    ((KOk _ _) true)
    (_ false)))
(fn rejected ((r (KRes CheckedEnv)) (s Symbol)) Bool
  (match r
    ((KFail (FRej (RuleViolation t))) (sym_eq s t))
    ((KFail (FRej (Malformed t))) (sym_eq s t))
    (_ false)))

(fn nat_env () CheckedEnv (env_of (add (empty_env) nil 0 (nat_decl))))
(fn ctx_of ((e CheckedEnv) (lps (List Name))) Ctx (Ctx e nil (some lps) Safe false 1000000))

(fn rec_of ((e CheckedEnv) (n Name)) (Option ConstantInfo) (env_find e n))
(fn rec_rules ((i ConstantInfo)) (List RecursorRule)
  (match i
    ((RecInfo _ _ _ _ _ _ rs _ _) rs)
    (_ nil)))
(fn rec_k ((i ConstantInfo)) Bool
  (match i
    ((RecInfo _ _ _ _ _ _ _ k _) k)
    (_ false)))
(fn rec_nmotives ((i ConstantInfo)) Int
  (match i
    ((RecInfo _ _ _ _ nm _ _ _ _) nm)
    (_ -1)))
(fn rec_nminors ((i ConstantInfo)) Int
  (match i
    ((RecInfo _ _ _ _ _ nmi _ _ _) nmi)
    (_ -1)))
(fn rec_nindices ((i ConstantInfo)) Int
  (match i
    ((RecInfo _ _ _ ni _ _ _ _ _) ni)
    (_ -1)))
(fn rule_rhs ((rs (List RecursorRule)) (c Name)) (Option Expr)
  (measure (struct rs))
  (match rs
    (nil none)
    ((cons (RecursorRule n _ rhs) r) (if (name_eq n c) (some rhs) (rule_rhs r c)))))
(fn opt_expr_eq ((o (Option Expr)) (e Expr)) Bool
  (match o
    ((some x) (expr_eq x e))
    (none false)))
(fn ind_flags ((e CheckedEnv) (n Name)) (Prod Bool Bool)
  (match (env_find e n)
    ((some (InductInfo _ _ _ _ _ _ isrec _ isrefl)) (Prod.mk isrec isrefl))
    (_ (Prod.mk false false))))

(fn motive_nat () Expr (mk_lam (x_) BDefault (nat) (nat)))
(fn rec_app ((major Expr)) Expr
  (mk_app
    (mk_app (mk_app (mk_app (mk_const (nm_rec) (list (LSucc LZero))) (motive_nat)) (lit 7))
      (mk_lam (n1 (sym "n")) BDefault (nat) (mk_lam (n1 (sym "ih")) BDefault (nat) (mk_bvar 0))))
    major))
(fn ok_is ((r (KRes Expr)) (e Expr)) Bool
  (match r
    ((KOk _ x) (expr_eq x e))
    (_ false)))

;; Bool
(fn nm_bool () Name (n1 (sym "Bool")))
(fn bool_decl () (List InductiveType)
  (list
    (InductiveType (nm_bool) (type1)
      (list (Constructor (nm_bool_false) (mk_const (nm_bool) nil))
        (Constructor (nm_bool_true) (mk_const (nm_bool) nil))))))

;; True : Prop, True.intro : True
(fn nm_true () Name (n1 (sym "True")))
(fn true_decl () (List InductiveType)
  (list
    (InductiveType (nm_true) (mk_sort LZero)
      (list (Constructor (n2 (sym "True") (sym "intro")) (mk_const (nm_true) nil))))))

;; Eq.{u} : {α : Sort u} → α → α → Prop ; Eq.refl : ∀ {α} (a : α), Eq α a a   (nparams 2)
(fn nm_eq () Name (n1 (sym "Eq")))
(fn nm_eq_refl () Name (n2 (sym "Eq") (sym "refl")))
(fn eq_decl () (List InductiveType)
  (list
    (InductiveType (nm_eq)
      (mk_pi (n1 (sym "a")) BImplicit (mk_sort (u))
        (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
          (mk_pi (n1 (sym "b")) BDefault (mk_bvar 1) (mk_sort LZero))))
      (list
        (Constructor (nm_eq_refl)
          (mk_pi (n1 (sym "a")) BImplicit (mk_sort (u))
            (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
              (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (u))) (mk_bvar 1)) (mk_bvar 0))
                (mk_bvar 0)))))))))
(fn eq_env () CheckedEnv (env_of (add (nat_env) (list (n1 (sym "u"))) 2 (eq_decl))))
;; a : Nat (fvar 1000), h : Eq Nat a a (fvar 1001)
(fn eq_ctx () Ctx
  (Ctx (eq_env)
    (list
      (LDecl 1001 (n1 (sym "h"))
        (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (LSucc LZero))) (nat)) (mk_fvar 1000))
          (mk_fvar 1000))
        none
        BDefault)
      (LDecl 1000 (n1 (sym "a")) (nat) none BDefault))
    (some nil)
    Safe
    false
    1000000))
;; Eq.rec.{1,1} Nat a (fun b h => Nat) 7 a h
(fn eq_rec_app () Expr
  (mk_app
    (mk_app
      (mk_app
        (mk_app
          (mk_app
            (mk_app (mk_const (n2 (sym "Eq") (sym "rec")) (list (LSucc LZero) (LSucc LZero))) (nat))
            (mk_fvar 1000))
          (mk_lam (n1 (sym "b")) BDefault (nat)
            (mk_lam (n1 (sym "h")) BDefault
              (mk_app (mk_app (mk_app (mk_const (nm_eq) (list (LSucc LZero))) (nat)) (mk_fvar 1000))
                (mk_bvar 0))
              (nat))))
        (lit 7))
      (mk_fvar 1000))
    (mk_fvar 1001)))

;; structure P2 (a b : Nat)
(fn nm_p2 () Name (n1 (sym "P2")))
(fn p2_decl () (List InductiveType)
  (list
    (InductiveType (nm_p2) (type1)
      (list
        (Constructor (n2 (sym "P2") (sym "mk"))
          (mk_pi (n1 (sym "a")) BDefault (nat)
            (mk_pi (n1 (sym "b")) BDefault (nat) (mk_const (nm_p2) nil))))))))

;; mutual: A.mk : B → A ; B.nil : B ; B.cons : A → B
(fn nm_a () Name (n1 (sym "A")))
(fn nm_b () Name (n1 (sym "B")))
(fn mutual_decl () (List InductiveType)
  (list
    (InductiveType (nm_a) (type1)
      (list
        (Constructor (n2 (sym "A") (sym "mk")) (arrow (mk_const (nm_b) nil) (mk_const (nm_a) nil)))))
    (InductiveType (nm_b) (type1)
      (list (Constructor (n2 (sym "B") (sym "nil")) (mk_const (nm_b) nil))
        (Constructor (n2 (sym "B") (sym "cons")) (arrow (mk_const (nm_a) nil) (mk_const (nm_b) nil)))))))

;; reflexive: T.mk : (Nat → T) → T
(fn nm_t () Name (n1 (sym "T")))
(fn refl_decl () (List InductiveType)
  (list
    (InductiveType (nm_t) (type1)
      (list
        (Constructor (n2 (sym "T") (sym "mk"))
          (arrow (arrow (nat) (mk_const (nm_t) nil)) (mk_const (nm_t) nil)))))))

;; negative: Bad.mk : (Bad → Nat) → Bad
(fn nm_bad () Name (n1 (sym "Bad")))
(fn bad_decl () (List InductiveType)
  (list
    (InductiveType (nm_bad) (type1)
      (list
        (Constructor (n2 (sym "Bad") (sym "mk"))
          (arrow (arrow (mk_const (nm_bad) nil) (nat)) (mk_const (nm_bad) nil)))))))

;; universe: U : Type, U.mk : Type → U   (a Type-1 field in a Type)
(fn nm_u () Name (n1 (sym "U")))
(fn big_decl () (List InductiveType)
  (list
    (InductiveType (nm_u) (type1)
      (list (Constructor (n2 (sym "U") (sym "mk")) (arrow (type1) (mk_const (nm_u) nil)))))))

;; result shape: Q (α : Type) : Type, Q.mk : (α : Type) → (n : Nat) → Q Nat  — the result is not `Q α`
;; (a Type-valued field would fail the universe check first, as the pin does: "universe level … too big")
(fn nm_q () Name (n1 (sym "Q")))
(fn q_decl () (List InductiveType)
  (list
    (InductiveType (nm_q) (mk_pi (n1 (sym "a")) BDefault (type1) (type1))
      (list
        (Constructor (n2 (sym "Q") (sym "mk"))
          (mk_pi (n1 (sym "a")) BDefault (type1)
            (mk_pi (n1 (sym "n")) BDefault (nat) (mk_app (mk_const (nm_q) nil) (nat)))))))))
;; the universe refusal, stated as its own case
(fn q_big_decl () (List InductiveType)
  (list
    (InductiveType (nm_q) (mk_pi (n1 (sym "a")) BDefault (type1) (type1))
      (list
        (Constructor (n2 (sym "Q") (sym "mk"))
          (mk_pi (n1 (sym "a")) BDefault (type1)
            (mk_pi (n1 (sym "b")) BDefault (type1) (mk_app (mk_const (nm_q) nil) (mk_bvar 0)))))))))

;; a duplicate name is refused
(fn dup_decl () (List InductiveType) (list (InductiveType (nm_nat) (type1) nil)))

;; class C (r : semiOutParam Type) : Type, C.mk : (r : semiOutParam Type) → C r
;; semiOutParam is the pinned Prelude def (fun a => a); the recursor's parameter binder
;; drops the annotation (consume_type_annotations, as the pin)
(fn nm_sop () Name (n1 (sym "semiOutParam")))
(fn sop_env () CheckedEnv
  (env_add (nat_env) (nm_sop)
    (DefnInfo
      (ConstantVal (nm_sop) (list (n1 (sym "u")))
        (mk_pi (n1 (sym "a")) BDefault (mk_sort (u)) (mk_sort (u))))
      (mk_lam (n1 (sym "a")) BDefault (mk_sort (u)) (mk_bvar 0))
      HAbbrev
      Safe
      (list (nm_sop)))))
(fn nm_c () Name (n1 (sym "C")))
(fn sop_ty () Expr (mk_app (mk_const (nm_sop) (list (LSucc (LSucc LZero)))) (type1)))
(fn c_decl () (List InductiveType)
  (list
    (InductiveType (nm_c) (mk_pi (n1 (sym "r")) BDefault (sop_ty) (type1))
      (list
        (Constructor (n2 (sym "C") (sym "mk"))
          (mk_pi (n1 (sym "r")) BDefault (sop_ty) (mk_app (mk_const (nm_c) nil) (mk_bvar 0))))))))
(fn c_res () (KRes CheckedEnv) (add (sop_env) nil 1 (c_decl)))
(fn c_rec_param_dom () (Option Expr)
  (match (rec_of (env_of (c_res)) (n2 (sym "C") (sym "rec")))
    ((some i)
     (match (ci_type i)
       ((Pi _ _ _ dom _) (some dom))
       (_ none)))
    (none none)))

(fn cases () (List Case)
  (let ((ne (nat_env)))
    (list (Case (utf8 "C (r : semiOutParam Type) admitted") (accepted (c_res)))
      (Case (utf8 "C.rec parameter binder is Type, the semiOutParam annotation consumed")
        (opt_expr_eq (c_rec_param_dom) (type1)))
      (Case (utf8 "Nat admitted") (accepted (add (empty_env) nil 0 (nat_decl))))
      (Case (utf8 "Nat.rec generated with the hand-written type")
        (match (rec_of ne (nm_rec))
          ((some i) (expr_eq (ci_type i) (rec_type)))
          (none false)))
      (Case (utf8 "Nat.rec lparams = [u]")
        (match (rec_of ne (nm_rec))
          ((some i) (names_eq (ci_lparams i) (list (n1 (sym "u")))))
          (none false)))
      (Case (utf8 "Nat.rec rule zero")
        (match (rec_of ne (nm_rec))
          ((some i) (opt_expr_eq (rule_rhs (rec_rules i) (nm_nat_zero)) (rule_zero)))
          (none false)))
      (Case (utf8 "Nat.rec rule succ")
        (match (rec_of ne (nm_rec))
          ((some i) (opt_expr_eq (rule_rhs (rec_rules i) (nm_nat_succ)) (rule_succ)))
          (none false)))
      (Case (utf8 "Nat.rec counts: 1 motive, 2 minors, 0 indices, not K")
        (match (rec_of ne (nm_rec))
          ((some i)
           (bool_and (= (rec_nmotives i) 1)
             (bool_and (= (rec_nminors i) 2) (bool_and (= (rec_nindices i) 0) (bool_not (rec_k i))))))
          (none false)))
      (Case (utf8 "Nat isRec, not reflexive")
        (match (ind_flags ne (nm_nat))
          ((Prod.mk r f) (bool_and r (bool_not f)))))
      (Case (utf8 "Nat.succ ctor info: cidx 1, nfields 1")
        (match (env_find ne (nm_nat_succ))
          ((some (CtorInfo _ _ cidx np nf _)) (bool_and (= cidx 1) (bool_and (= np 0) (= nf 1))))
          (_ false)))
      (Case (utf8 "the admitted env carries a watermark above its nodes") (< 0 (env_watermark ne)))
      (Case (utf8 "iota through the generated recursor: rec … 2 = 7")
        (ok_is (whnf (ctx_of ne nil) (st_for ne) 300 (rec_app (lit 2))) (lit 7)))
      (Case (utf8 "rec app checks: (fun _ => Nat) 2")
        (ok_is (infer (ctx_of ne nil) (st_for ne) 300 (rec_app (lit 2)) false)
          (mk_app (motive_nat) (lit 2))))
      (Case (utf8 "Bool admitted, large elimination (u), not K")
        (match (rec_of (env_of (add (empty_env) nil 0 (bool_decl))) (n2 (sym "Bool") (sym "rec")))
          ((some i) (bool_and (names_eq (ci_lparams i) (list (n1 (sym "u")))) (bool_not (rec_k i))))
          (none false)))
      (Case (utf8 "True admitted: K-target, eliminates into any universe")
        (match (rec_of (env_of (add (empty_env) nil 0 (true_decl))) (n2 (sym "True") (sym "rec")))
          ((some i) (bool_and (rec_k i) (names_eq (ci_lparams i) (list (n1 (sym "u"))))))
          (none false)))
      (Case (utf8 "Eq admitted with 1 index, K-target, fresh level u_1")
        (match (rec_of (eq_env) (n2 (sym "Eq") (sym "rec")))
          ((some i)
           (bool_and (= (rec_nindices i) 1)
             (bool_and (rec_k i) (names_eq (ci_lparams i) (list (n1 (sym "u_1")) (n1 (sym "u")))))))
          (none false)))
      (Case (utf8 "K-like reduction: Eq.rec … h = 7 for an opaque h : Eq Nat a a")
        (ok_is (whnf (eq_ctx) (st_for (eq_env)) 300 (eq_rec_app)) (lit 7)))
      (Case (utf8 "P2 admitted: non-recursive structure")
        (bool_and (accepted (add ne nil 0 (p2_decl)))
          (is_non_rec_structure (env_of (add ne nil 0 (p2_decl))) (nm_p2))))
      (Case (utf8 "P2 struct eta through the generated env")
        (let ((e (env_of (add ne nil 0 (p2_decl)))))
          (match
            (is_def_eq
              (Ctx e (list (LDecl 1000 (n1 (sym "p")) (mk_const (nm_p2) nil) none BDefault))
                (some nil)
                Safe
                false
                1000000)
              (st_for e)
              300
              (mk_fvar 1000)
              (mk_app
                (mk_app (mk_const (n2 (sym "P2") (sym "mk")) nil) (mk_proj (nm_p2) 0 (mk_fvar 1000)))
                (mk_proj (nm_p2) 1 (mk_fvar 1000))))
            ((KOk _ b) b)
            (_ false))))
      (Case (utf8 "mutual A/B: two recursors, 2 motives, 3 minors each")
        (let ((e (env_of (add (empty_env) nil 0 (mutual_decl)))))
          (match (rec_of e (n2 (sym "A") (sym "rec")))
            ((some i)
             (match (rec_of e (n2 (sym "B") (sym "rec")))
               ((some j)
                (bool_and (= (rec_nmotives i) 2)
                  (bool_and (= (rec_nminors i) 3)
                    (bool_and (= (rec_nmotives j) 2) (= (rec_nminors j) 3)))))
               (none false)))
            (none false))))
      (Case (utf8 "mutual motives named motive_1, motive_2")
        (match (rec_of (env_of (add (empty_env) nil 0 (mutual_decl))) (n2 (sym "A") (sym "rec")))
          ((some i)
           (match (ci_type i)
             ((Pi _ n _ _ (Pi _ m _ _ _))
              (bool_and (name_eq n (n1 (sym "motive_1"))) (name_eq m (n1 (sym "motive_2")))))
             (_ false)))
          (none false)))
      (Case (utf8 "reflexive T admitted and flagged")
        (match (ind_flags (env_of (add ne nil 0 (refl_decl))) (nm_t))
          ((Prod.mk r f) (bool_and r f))))
      (Case (utf8 "reflexive ih is function-typed")
        (match (rec_of (env_of (add ne nil 0 (refl_decl))) (n2 (sym "T") (sym "rec")))
          ((some i)
           (match (ci_type i)
             ((Pi _ _ _ _ (Pi _ _ _ minor _))
              (match minor
                ((Pi _ _ _ _ (Pi _ _ _ ih _)) (is_pi ih))
                (_ false)))
             (_ false)))
          (none false)))
      (Case (utf8 "non-positive occurrence rejected")
        (rejected (add ne nil 0 (bad_decl)) (sym "non_positive_occurrence")))
      (Case (utf8 "field universe too big rejected")
        (rejected (add (empty_env) nil 0 (big_decl)) (sym "field_universe_too_big")))
      (Case (utf8 "constructor result with the wrong params rejected")
        (rejected (add ne nil 1 (q_decl)) (sym "invalid_ctor_result")))
      (Case (utf8 "a Type field in a Type inductive: universe check fires first")
        (rejected (add (empty_env) nil 1 (q_big_decl)) (sym "field_universe_too_big")))
      (Case (utf8 "redeclaration rejected")
        (rejected (add ne nil 0 (dup_decl)) (sym "already_declared")))
      (Case (utf8 "ctor universe check: Prop-valued type may hold a Type field")
        (accepted
          (add (empty_env) nil 0
            (list
              (InductiveType (n1 (sym "Ex")) (mk_sort LZero)
                (list
                  (Constructor (n2 (sym "Ex") (sym "mk"))
                    (arrow (type1) (mk_const (n1 (sym "Ex")) nil))))))))))))


(fn main ((w World)) World (run_cases (utf8 "inductive_test") (cases) 0 w))
