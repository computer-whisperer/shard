;;; v3/kernel/k/test/tc_test.shard — the checker core on a hand-built
;;; environment (Nat with its recursor, Bool, a two-field structure).
;;; The recursor is written by hand here; inductive.shard generates it
;;; and inductive_test cross-checks the generation.

(import "../../host.shard")
(import "../tc.shard")
(import "../../test/case_kit.shard")
(import "../../test/decls_kit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.k)
(use kernel.expr)
(use kernel.host)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.expr.Literal)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.k.Ctx)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)
(use kernel.k.LDecl)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)


(fn succ () Expr (mk_const (nm_nat_succ) nil))
(fn nm_rec () Name (n2 (sym "Nat") (sym "rec")))
(fn nm_bool () Name (n1 (sym "Bool")))
(fn nm_p2 () Name (n1 (sym "P2")))
(fn nm_p2_mk () Name (n2 (sym "P2") (sym "mk")))

;; Nat.rec.{u} : (motive : Nat → Sort u) → motive Nat.zero →
;;   ((n : Nat) → motive n → motive (Nat.succ n)) → (t : Nat) → motive t
(fn rec_type () Expr
  (mk_pi (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_pi (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_pi (n1 (sym "succ")) BDefault
        (mk_pi (n1 (sym "n")) BDefault (nat)
          (mk_pi (n1 (sym "ih")) BDefault (mk_app (mk_bvar 2) (mk_bvar 0))
            (mk_app (mk_bvar 3) (mk_app (succ) (mk_bvar 1)))))
        (mk_pi (n1 (sym "t")) BDefault (nat) (mk_app (mk_bvar 3) (mk_bvar 0)))))))
(fn succ_dom () Expr
  (mk_pi (n1 (sym "n")) BDefault (nat)
    (mk_pi (n1 (sym "ih")) BDefault (mk_app (mk_bvar 2) (mk_bvar 0))
      (mk_app (mk_bvar 3) (mk_app (succ) (mk_bvar 1))))))
;; fun motive zero succ => zero
(fn rule_zero () Expr
  (mk_lam (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_lam (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_lam (n1 (sym "succ")) BDefault (succ_dom) (mk_bvar 1)))))
;; fun motive zero succ n => succ n (Nat.rec motive zero succ n)
(fn rule_succ () Expr
  (mk_lam (n1 (sym "motive")) BDefault (mk_pi (x_) BDefault (nat) (mk_sort (u)))
    (mk_lam (n1 (sym "zero")) BDefault (mk_app (mk_bvar 0) (zero))
      (mk_lam (n1 (sym "succ")) BDefault (succ_dom)
        (mk_lam (n1 (sym "n")) BDefault (nat)
          (mk_app (mk_app (mk_bvar 1) (mk_bvar 0))
            (mk_app
              (mk_app (mk_app (mk_app (mk_const (nm_rec) (list (u))) (mk_bvar 3)) (mk_bvar 2))
                (mk_bvar 1))
              (mk_bvar 0))))))))

(fn env () CheckedEnv (env_of_list (env_entries_list) (CheckedEnv IMEmpty false (env_pins_list) 0)))
(fn env_of_list ((xs (List (Prod Name ConstantInfo))) (e CheckedEnv)) CheckedEnv
  (measure (struct xs))
  (match xs
    (nil e)
    ((cons (Prod.mk n i) r) (env_of_list r (env_add e n i)))))
(fn env_entries_list () (List (Prod Name ConstantInfo))
  (list
    (Prod.mk (nm_nat)
      (InductInfo (cv (nm_nat) nil (mk_sort (LSucc LZero))) 0 0 (list (nm_nat))
        (list (nm_nat_zero) (nm_nat_succ))
        0
        true
        false
        false))
    (Prod.mk (nm_nat_zero) (CtorInfo (cv (nm_nat_zero) nil (nat)) (nm_nat) 0 0 0 false))
    (Prod.mk (nm_nat_succ)
      (CtorInfo (cv (nm_nat_succ) nil (arrow (nat) (nat))) (nm_nat) 1 0 1 false))
    (Prod.mk (nm_rec)
      (RecInfo (cv (nm_rec) (list (n1 (sym "u"))) (rec_type)) (list (nm_nat)) 0 0 1 2
        (list (RecursorRule (nm_nat_zero) 0 (rule_zero)) (RecursorRule (nm_nat_succ) 1 (rule_succ)))
        false
        false))
    (Prod.mk (nm_bool)
      (InductInfo (cv (nm_bool) nil (mk_sort (LSucc LZero))) 0 0 (list (nm_bool))
        (list (nm_bool_false) (nm_bool_true))
        0
        false
        false
        false))
    (Prod.mk (nm_bool_false)
      (CtorInfo (cv (nm_bool_false) nil (mk_const (nm_bool) nil)) (nm_bool) 0 0 0 false))
    (Prod.mk (nm_bool_true)
      (CtorInfo (cv (nm_bool_true) nil (mk_const (nm_bool) nil)) (nm_bool) 1 0 0 false))
    ;; structure P2 (a b : Nat)
    (Prod.mk (nm_p2)
      (InductInfo (cv (nm_p2) nil (mk_sort (LSucc LZero))) 0 0 (list (nm_p2)) (list (nm_p2_mk)) 0
        false
        false
        false))
    (Prod.mk (nm_p2_mk)
      (CtorInfo (cv (nm_p2_mk) nil (arrow (nat) (arrow (nat) (mk_const (nm_p2) nil)))) (nm_p2) 0 0 2
        false))
    ;; def id2 (x : Nat) : Nat := x   (regular hint, height 1)
    (Prod.mk (n1 (sym "id2"))
      (DefnInfo (cv (n1 (sym "id2")) nil (arrow (nat) (nat)))
        (mk_lam (x_) BDefault (nat) (mk_bvar 0))
        (HRegular 1)
        Safe
        (list (n1 (sym "id2")))))
    ;; the operators reduce_nat accelerates, as axiom-shaped constants (typing only)
    (Prod.mk (n2 (sym "Nat") (sym "add"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "add")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "sub"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "sub")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "mul"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "mul")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "pow"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "pow")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "gcd"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "gcd")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "mod"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "mod")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "div"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "div")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "land"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "land")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "lor"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "lor")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "xor"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "xor")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "shiftLeft"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "shiftLeft")) nil (arrow (nat) (arrow (nat) (nat)))) false))
    (Prod.mk (n2 (sym "Nat") (sym "shiftRight"))
      (AxiomInfo (cv (n2 (sym "Nat") (sym "shiftRight")) nil (arrow (nat) (arrow (nat) (nat))))
        false))
    (Prod.mk (n2 (sym "Nat") (sym "beq"))
      (AxiomInfo
        (cv (n2 (sym "Nat") (sym "beq")) nil (arrow (nat) (arrow (nat) (mk_const (nm_bool) nil))))
        false))
    (Prod.mk (n2 (sym "Nat") (sym "ble"))
      (AxiomInfo
        (cv (n2 (sym "Nat") (sym "ble")) nil (arrow (nat) (arrow (nat) (mk_const (nm_bool) nil))))
        false))
    ;; the string-literal expansion's constants (typing only)
    (Prod.mk (nm_string) (AxiomInfo (cv (nm_string) nil (mk_sort (LSucc LZero))) false))
    (Prod.mk (nm_char) (AxiomInfo (cv (nm_char) nil (mk_sort (LSucc LZero))) false))
    (Prod.mk (n1 (sym "List"))
      (AxiomInfo
        (cv (n1 (sym "List")) (list (n1 (sym "u")))
          (arrow (mk_sort (LSucc (u))) (mk_sort (LSucc (u)))))
        false))
    (Prod.mk (nm_list_nil)
      (AxiomInfo
        (cv (nm_list_nil) (list (n1 (sym "u")))
          (mk_pi (n1 (sym "a")) BImplicit (mk_sort (LSucc (u)))
            (mk_app (mk_const (n1 (sym "List")) (list (u))) (mk_bvar 0))))
        false))
    (Prod.mk (nm_list_cons)
      (AxiomInfo
        (cv (nm_list_cons) (list (n1 (sym "u")))
          (mk_pi (n1 (sym "a")) BImplicit (mk_sort (LSucc (u)))
            (arrow (mk_bvar 0)
              (arrow (mk_app (mk_const (n1 (sym "List")) (list (u))) (mk_bvar 1))
                (mk_app (mk_const (n1 (sym "List")) (list (u))) (mk_bvar 2))))))
        false))
    (Prod.mk (nm_char_of_nat)
      (AxiomInfo (cv (nm_char_of_nat) nil (arrow (nat) (mk_const (nm_char) nil))) false))
    (Prod.mk (nm_string_of_list)
      (AxiomInfo
        (cv (nm_string_of_list) nil
          (arrow (mk_app (mk_const (n1 (sym "List")) (list LZero)) (mk_const (nm_char) nil))
            (mk_const (nm_string) nil)))
        false))
    ;; theorem-shaped constant: thm : Nat := Nat.zero (has_value ⇒ unfolds)
    (Prod.mk (n1 (sym "thm"))
      (ThmInfo (cv (n1 (sym "thm")) nil (nat)) (zero) (list (n1 (sym "thm")))))))
(fn env_pins_list () (List Name)
  (list (nm_nat) (nm_string) (nm_char) (nm_list) (nm_string_of_list) (nm_char_of_nat)
    (n2 (sym "Nat") (sym "add"))
    (n2 (sym "Nat") (sym "sub"))
    (n2 (sym "Nat") (sym "mul"))
    (n2 (sym "Nat") (sym "pow"))
    (n2 (sym "Nat") (sym "gcd"))
    (n2 (sym "Nat") (sym "mod"))
    (n2 (sym "Nat") (sym "div"))
    (n2 (sym "Nat") (sym "beq"))
    (n2 (sym "Nat") (sym "ble"))
    (n2 (sym "Nat") (sym "land"))
    (n2 (sym "Nat") (sym "lor"))
    (n2 (sym "Nat") (sym "xor"))
    (n2 (sym "Nat") (sym "shiftLeft"))
    (n2 (sym "Nat") (sym "shiftRight"))))

;; the accelerators' cases:
;; an operation at two literals, its result, and a wrong result not established; a power of two
;; by doubling, so an expected value past the machine word is not the accelerator's own
(fn two_pow ((k Int)) Int (measure k) (if (<= k 0) 1 (* 2 (two_pow (- k 1)))))
(fn nat_op ((s Symbol) (a Int) (b Int)) Expr
  (mk_app (mk_app (mk_const (n2 (sym "Nat") s) nil) (lit a)) (lit b)))
(fn ctx () Ctx (Ctx (env) nil (some (list (n1 (sym "u")))) Safe false 100000))
(fn op_is ((s Symbol) (a Int) (b Int) (r Int)) Bool
  (ok_is (whnf (ctx) (st0) (depth) (nat_op s a b)) (lit r)))
(fn op_not ((s Symbol) (a Int) (b Int) (r Int)) Bool
  (ok_bool (is_def_eq (ctx) (st0) (depth) (nat_op s a b) (lit r)) false))
(fn op_true ((s Symbol) (a Int) (b Int) (yes Bool)) Bool
  (ok_bool (is_def_eq (ctx) (st0) (depth) (nat_op s a b) (c_bool_true)) yes))
(fn ctx_np () Ctx (Ctx (env) nil (some nil) Safe false 100000))
(fn depth () Int 300)

(fn ok_is ((r (KRes Expr)) (e Expr)) Bool
  (match r
    ((KOk _ x) (expr_eq x e))
    (_ false)))
(fn ok_bool ((r (KRes Bool)) (b Bool)) Bool
  (match r
    ((KOk _ x) (if b x (bool_not x)))
    (_ false)))
(fn rejected ((r (KRes Expr)) (s Symbol)) Bool
  (match r
    ((KFail (FRej (RuleViolation t))) (sym_eq s t))
    ((KFail (FRej (Malformed t))) (sym_eq s t))
    ((KFail (FRej (Unsupported t))) (sym_eq s t))
    (_ false)))
(fn exhausted ((r (KRes Expr))) Bool
  (match r
    ((KFail (FOut _ _)) true)
    (_ false)))

(fn id_nat () Expr (mk_lam (x_) BDefault (nat) (mk_bvar 0)))
(fn motive_nat () Expr (mk_lam (x_) BDefault (nat) (nat)))
;; Nat.rec.{1} (fun _ => Nat) 7 (fun n ih => ih) 2
(fn rec_app ((major Expr)) Expr
  (mk_app
    (mk_app (mk_app (mk_app (mk_const (nm_rec) (list (LSucc LZero))) (motive_nat)) (lit 7))
      (mk_lam (n1 (sym "n")) BDefault (nat) (mk_lam (n1 (sym "ih")) BDefault (nat) (mk_bvar 0))))
    major))
(fn p2_mk ((a Expr) (b Expr)) Expr (mk_app (mk_app (mk_const (nm_p2_mk) nil) a) b))
(fn ctx_with_p () Ctx
  (ctx_add_local (ctx) (LDecl 1000 (n1 (sym "p")) (mk_const (nm_p2) nil) none BDefault)))
(fn ctx_with_h () Ctx
  ;; h1 h2 : (∀ p : Prop, p)  — two proofs of one proposition
  (ctx_add_local
    (ctx_add_local (ctx)
      (LDecl 1000 (n1 (sym "h1")) (mk_pi (x_) BDefault (mk_sort LZero) (mk_bvar 0)) none BDefault))
    (LDecl 1001 (n1 (sym "h2")) (mk_pi (x_) BDefault (mk_sort LZero) (mk_bvar 0)) none BDefault)))

(fn cases () (List Case)
  (list
    (Case (utf8 "Sort 0 : Sort 1")
      (ok_is (infer (ctx) (st0) (depth) (mk_sort LZero) false) (mk_sort (LSucc LZero))))
    (Case (utf8 "Nat : Sort 1")
      (ok_is (infer (ctx) (st0) (depth) (nat) false) (mk_sort (LSucc LZero))))
    (Case (utf8 "fun x : Nat => x  :  Nat -> Nat")
      (ok_is (infer (ctx) (st0) (depth) (id_nat) false) (arrow (nat) (nat))))
    (Case (utf8 "(fun x => x) zero : Nat")
      (ok_is (infer (ctx) (st0) (depth) (mk_app (id_nat) (zero)) false) (nat)))
    (Case (utf8 "succ zero : Nat")
      (ok_is (infer (ctx) (st0) (depth) (mk_app (succ) (zero)) false) (nat)))
    (Case (utf8 "succ Nat  rejected: app_type_mismatch")
      (rejected (infer (ctx) (st0) (depth) (mk_app (succ) (nat)) false) (sym "app_type_mismatch")))
    (Case (utf8 "zero zero rejected: function_expected")
      (rejected (infer (ctx) (st0) (depth) (mk_app (zero) (zero)) false) (sym "function_expected")))
    (Case (utf8 "forall p : Prop, p  :  Prop")
      (ok_is (infer (ctx) (st0) (depth) (mk_pi (x_) BDefault (mk_sort LZero) (mk_bvar 0)) false)
        (mk_sort LZero)))
    (Case (utf8 "Nat -> Nat : Sort 1")
      (ok_is (infer (ctx) (st0) (depth) (arrow (nat) (nat)) false) (mk_sort (LSucc LZero))))
    (Case (utf8 "Sort u with u declared")
      (ok_is (infer (ctx) (st0) (depth) (mk_sort (u)) false) (mk_sort (LSucc (u)))))
    (Case (utf8 "Sort u undeclared rejected")
      (rejected (infer (ctx_np) (st0) (depth) (mk_sort (u)) false) (sym "undefined_universe")))
    (Case (utf8 "unknown constant rejected")
      (rejected (infer (ctx) (st0) (depth) (mk_const (n1 (sym "nope")) nil) false)
        (sym "unknown_constant")))
    (Case (utf8 "universe arity rejected")
      (rejected (infer (ctx) (st0) (depth) (mk_const (nm_rec) nil) false) (sym "universe_arity")))
    (Case (utf8 "loose bvar malformed")
      (rejected (infer (ctx) (st0) (depth) (mk_bvar 0) false) (sym "loose_bvar")))
    (Case (utf8 "let x := zero; succ x : Nat")
      (ok_is
        (infer (ctx) (st0) (depth) (mk_let (x_) (nat) (zero) (mk_app (succ) (mk_bvar 0))) false)
        (nat)))
    (Case (utf8 "literal 5 : Nat") (ok_is (infer (ctx) (st0) (depth) (lit 5) false) (nat)))
    (Case (utf8 "string literal : String")
      (ok_is (infer (ctx) (st0) (depth) (mk_lit (LitStr (utf8 "ab"))) false)
        (mk_const (nm_string) nil)))
    ;; the pin returns the instantiated codomain unreduced (infer_app l. 187): motive t = (fun _ => Nat) 2
    (Case (utf8 "rec app : (fun _ => Nat) 2")
      (ok_is (infer (ctx) (st0) (depth) (rec_app (lit 2)) false) (mk_app (motive_nat) (lit 2))))
    (Case (utf8 "rec app type ≡ Nat")
      (match (infer (ctx) (st0) (depth) (rec_app (lit 2)) false)
        ((KOk st1 t) (ok_bool (is_def_eq (ctx) st1 (depth) t (nat)) true))
        (_ false)))
    (Case (utf8 "whnf beta") (ok_is (whnf (ctx) (st0) (depth) (mk_app (id_nat) (zero))) (zero)))
    ;; the pin: after zeta, `Nat.succ Nat.zero` meets reduce_nat (Nat.zero is a nat-lit-ext) → literal 1
    (Case (utf8 "whnf zeta then nat: let x := zero; succ x = 1")
      (ok_is (whnf (ctx) (st0) (depth) (mk_let (x_) (nat) (zero) (mk_app (succ) (mk_bvar 0))))
        (lit 1)))
    (Case (utf8 "whnf_core zeta alone")
      (ok_is
        (whnf_core (ctx) (st0) (depth) (mk_let (x_) (nat) (zero) (mk_app (succ) (mk_bvar 0))) false
          false)
        (mk_app (succ) (zero))))
    (Case (utf8 "whnf succ 3 = 4")
      (ok_is (whnf (ctx) (st0) (depth) (mk_app (succ) (lit 3))) (lit 4)))
    (Case (utf8 "whnf Nat.add 2 3 = 5")
      (ok_is (whnf (ctx) (st0) (depth) (nat_add (lit 2) (lit 3))) (lit 5)))
    (Case (utf8 "whnf delta id2 zero = zero")
      (ok_is (whnf (ctx) (st0) (depth) (mk_app (mk_const (n1 (sym "id2")) nil) (zero))) (zero)))
    (Case (utf8 "whnf unfolds a theorem")
      (ok_is (whnf (ctx) (st0) (depth) (mk_const (n1 (sym "thm")) nil)) (zero)))
    (Case (utf8 "iota on literal major: rec … 2 = 7")
      (ok_is (whnf (ctx) (st0) (depth) (rec_app (lit 2))) (lit 7)))
    (Case (utf8 "iota on ctor major: rec … (succ zero) = 7")
      (ok_is (whnf (ctx) (st0) (depth) (rec_app (mk_app (succ) (zero)))) (lit 7)))
    (Case (utf8 "proj reduces: (P2.mk 1 2).1 = 2")
      (ok_is (whnf (ctx) (st0) (depth) (mk_proj (nm_p2) 1 (p2_mk (lit 1) (lit 2)))) (lit 2)))
    (Case (utf8 "infer proj: (P2.mk 1 2).0 : Nat")
      (ok_is (infer (ctx) (st0) (depth) (mk_proj (nm_p2) 0 (p2_mk (lit 1) (lit 2))) false) (nat)))
    (Case (utf8 "proj out of range rejected")
      (rejected (infer (ctx) (st0) (depth) (mk_proj (nm_p2) 2 (p2_mk (lit 1) (lit 2))) false)
        (sym "invalid_projection")))
    (Case (utf8 "defeq refl") (ok_bool (is_def_eq (ctx) (st0) (depth) (nat) (nat)) true))
    (Case (utf8 "defeq offset: succ (succ zero) ≡ 2")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (mk_app (succ) (mk_app (succ) (zero))) (lit 2)) true))
    (Case (utf8 "defeq: 2 ≢ 3") (ok_bool (is_def_eq (ctx) (st0) (depth) (lit 2) (lit 3)) false))
    (Case (utf8 "defeq beta: (fun x => x) zero ≡ zero")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (mk_app (id_nat) (zero)) (zero)) true))
    (Case (utf8 "defeq eta: (fun x => succ x) ≡ succ")
      (ok_bool
        (is_def_eq (ctx) (st0) (depth) (mk_lam (x_) BDefault (nat) (mk_app (succ) (mk_bvar 0)))
          (succ))
        true))
    (Case (utf8 "defeq delta: id2 ≡ fun x => x")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (mk_const (n1 (sym "id2")) nil) (id_nat)) true))
    (Case (utf8 "defeq nat: Nat.add 2 3 ≡ 5")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (nat_add (lit 2) (lit 3)) (lit 5)) true))
    (Case (utf8 "defeq iota: rec … 2 ≡ 7")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (rec_app (lit 2)) (lit 7)) true))
    (Case (utf8 "defeq levels: Sort (max u 0) ≡ Sort u")
      (ok_bool (is_def_eq (ctx) (st0) (depth) (mk_sort (LMax (u) LZero)) (mk_sort (u))) true))
    (Case (utf8 "defeq binding: Nat -> Nat ≡ Nat -> Nat with beta in domain")
      (ok_bool
        (is_def_eq (ctx) (st0) (depth) (arrow (mk_app (motive_nat) (zero)) (nat))
          (arrow (nat) (nat)))
        true))
    (Case (utf8 "defeq struct eta: p ≡ P2.mk p.0 p.1")
      (ok_bool
        (is_def_eq (ctx_with_p) (st0) (depth) (mk_fvar 1000)
          (p2_mk (mk_proj (nm_p2) 0 (mk_fvar 1000)) (mk_proj (nm_p2) 1 (mk_fvar 1000))))
        true))
    (Case (utf8 "defeq proof irrelevance: h1 ≡ h2")
      (ok_bool (is_def_eq (ctx_with_h) (st0) (depth) (mk_fvar 1000) (mk_fvar 1001)) true))
    (Case (utf8 "defeq Bool.true shortcut: Nat.beq 2 2 ≡ true")
      (ok_bool
        (is_def_eq (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "beq")) nil) (lit 2)) (lit 2))
          (c_bool_true))
        true))
    (Case (utf8 "defeq: Nat.ble 3 2 ≢ true")
      (ok_bool
        (is_def_eq (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "ble")) nil) (lit 3)) (lit 2))
          (c_bool_true))
        false))
    (Case (utf8 "string lit ≡ its expansion head")
      (ok_bool
        (is_def_eq (ctx) (st0) (depth) (mk_lit (LitStr (utf8 "a")))
          (string_lit_to_constructor (utf8 "a")))
        true))
    (Case (utf8 "native reduction unsupported")
      (rejected
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_const (nm_reduce_bool) nil) (mk_const (n1 (sym "c")) nil)))
        (sym "native_reduction")))
    (Case (utf8 "depth exhaustion")
      (exhausted (infer (ctx) (st0) 2 (mk_app (id_nat) (mk_app (id_nat) (zero))) false)))
    (Case (utf8 "heartbeat exhaustion")
      (exhausted
        (infer (Ctx (env) nil (some nil) Safe false 3) (st0) (depth) (rec_app (lit 2)) false)))
    (Case (utf8 "nat size exhaustion: pow")
      (exhausted
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "pow")) nil) (lit 2)) (lit 5000000000)))))
    (Case (utf8 "Nat.sub saturates: 2 - 3 = 0")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "sub")) nil) (lit 2)) (lit 3)))
        (lit 0)))
    (Case (utf8 "Nat.div 7 0 = 0")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "div")) nil) (lit 7)) (lit 0)))
        (lit 0)))
    (Case (utf8 "Nat.mod 7 0 = 7")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "mod")) nil) (lit 7)) (lit 0)))
        (lit 7)))
    (Case (utf8 "Nat.gcd 12 18 = 6")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "gcd")) nil) (lit 12)) (lit 18)))
        (lit 6)))
    (Case (utf8 "Nat.shiftLeft 3 4 = 48")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "shiftLeft")) nil) (lit 3)) (lit 4)))
        (lit 48)))
    (Case (utf8 "Nat.pow 3 0 = 1 (the size guard must not evaluate ediv by 0)")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "pow")) nil) (lit 3)) (lit 0)))
        (lit 1)))
    (Case (utf8 "Nat.pow 0 0 = 1")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "pow")) nil) (lit 0)) (lit 0)))
        (lit 1)))
    (Case (utf8 "Nat.pow 2 10 = 1024")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "pow")) nil) (lit 2)) (lit 10)))
        (lit 1024)))
    (Case (utf8 "Nat.xor 5 3 = 6")
      (ok_is
        (whnf (ctx) (st0) (depth)
          (mk_app (mk_app (mk_const (n2 (sym "Nat") (sym "xor")) nil) (lit 5)) (lit 3)))
        (lit 6)))
    (Case (utf8 "utf8 decode") (int_list_eq (utf8_decode (utf8 "aé€")) (list 97 233 8364)))
    ;; the four operations that had no result case
    (Case (utf8 "Nat.mul 6 7 = 42") (op_is (sym "mul") 6 7 42))
    (Case (utf8 "Nat.land 12 10 = 8") (op_is (sym "land") 12 10 8))
    (Case (utf8 "Nat.lor 12 10 = 14") (op_is (sym "lor") 12 10 14))
    (Case (utf8 "Nat.shiftRight 48 4 = 3") (op_is (sym "shiftRight") 48 4 3))
    (Case (utf8 "Nat.shiftRight 5 100 = 0: the shift past the operand's width")
      (op_is (sym "shiftRight") 5 100 0))
    (Case (utf8 "Nat.shiftRight 5 5000000000 = 0: a count past 32 bits, no power taken")
      (op_is (sym "shiftRight") 5 5000000000 0))
    ;; operands and results past the machine word, each operation
    (Case (utf8 "Nat.add 2^63 2^63 = 2^64")
      (op_is (sym "add") (two_pow 63) (two_pow 63) (two_pow 64)))
    (Case (utf8 "Nat.sub 2^70 1 = 2^70 - 1") (op_is (sym "sub") (two_pow 70) 1 (- (two_pow 70) 1)))
    (Case (utf8 "Nat.sub 1 2^70 = 0") (op_is (sym "sub") 1 (two_pow 70) 0))
    (Case (utf8 "Nat.mul 2^40 2^40 = 2^80")
      (op_is (sym "mul") (two_pow 40) (two_pow 40) (two_pow 80)))
    (Case (utf8 "Nat.pow 2 100 = 2^100") (op_is (sym "pow") 2 100 (two_pow 100)))
    (Case (utf8 "Nat.gcd 2^70 2^40 = 2^40")
      (op_is (sym "gcd") (two_pow 70) (two_pow 40) (two_pow 40)))
    (Case (utf8 "Nat.gcd 0 5 = 5, 5 0 = 5, 0 0 = 0")
      (bool_and (op_is (sym "gcd") 0 5 5)
        (bool_and (op_is (sym "gcd") 5 0 5) (op_is (sym "gcd") 0 0 0))))
    (Case (utf8 "Nat.mod (2^80 + 5) 2^40 = 5") (op_is (sym "mod") (+ (two_pow 80) 5) (two_pow 40) 5))
    (Case (utf8 "Nat.mod 2^80 0 = 2^80") (op_is (sym "mod") (two_pow 80) 0 (two_pow 80)))
    (Case (utf8 "Nat.div 2^80 2^40 = 2^40")
      (op_is (sym "div") (two_pow 80) (two_pow 40) (two_pow 40)))
    (Case (utf8 "Nat.div 2^80 0 = 0") (op_is (sym "div") (two_pow 80) 0 0))
    (Case (utf8 "Nat.beq 2^70 2^70 ≡ true") (op_true (sym "beq") (two_pow 70) (two_pow 70) true))
    (Case (utf8 "Nat.ble 2^70 (2^70 - 1) ≢ true")
      (op_true (sym "ble") (two_pow 70) (- (two_pow 70) 1) false))
    (Case (utf8 "Nat.land (2^70 + 5) (2^70 + 3) = 2^70 + 1")
      (op_is (sym "land") (+ (two_pow 70) 5) (+ (two_pow 70) 3) (+ (two_pow 70) 1)))
    (Case (utf8 "Nat.lor 2^70 5 = 2^70 + 5") (op_is (sym "lor") (two_pow 70) 5 (+ (two_pow 70) 5)))
    (Case (utf8 "Nat.xor (2^70 + 5) (2^70 + 3) = 6")
      (op_is (sym "xor") (+ (two_pow 70) 5) (+ (two_pow 70) 3) 6))
    (Case (utf8 "Nat.shiftLeft 1 80 = 2^80") (op_is (sym "shiftLeft") 1 80 (two_pow 80)))
    (Case (utf8 "Nat.shiftRight 2^80 40 = 2^40")
      (op_is (sym "shiftRight") (two_pow 80) 40 (two_pow 40)))
    ;; the limits at shiftLeft: the count, then the size, neither computed
    (Case (utf8 "nat count exhaustion: shiftLeft by a count past 32 bits")
      (exhausted (whnf (ctx) (st0) (depth) (nat_op (sym "shiftLeft") 1 5000000000))))
    (Case (utf8 "nat size exhaustion: shiftLeft to 2^31 bits")
      (exhausted (whnf (ctx) (st0) (depth) (nat_op (sym "shiftLeft") 1 2147483648))))
    ;; a wrong result is not established, each operation
    (Case (utf8 "Nat.add 2 3 ≢ 6") (op_not (sym "add") 2 3 6))
    (Case (utf8 "Nat.sub 5 3 ≢ 3") (op_not (sym "sub") 5 3 3))
    (Case (utf8 "Nat.mul 6 7 ≢ 43") (op_not (sym "mul") 6 7 43))
    (Case (utf8 "Nat.pow 2 10 ≢ 1023") (op_not (sym "pow") 2 10 1023))
    (Case (utf8 "Nat.gcd 12 18 ≢ 3") (op_not (sym "gcd") 12 18 3))
    (Case (utf8 "Nat.mod 7 3 ≢ 2") (op_not (sym "mod") 7 3 2))
    (Case (utf8 "Nat.div 7 2 ≢ 4") (op_not (sym "div") 7 2 4))
    (Case (utf8 "Nat.beq 2 3 ≢ true") (op_true (sym "beq") 2 3 false))
    (Case (utf8 "Nat.land 12 10 ≢ 14") (op_not (sym "land") 12 10 14))
    (Case (utf8 "Nat.lor 12 10 ≢ 8") (op_not (sym "lor") 12 10 8))
    (Case (utf8 "Nat.xor 5 3 ≢ 7") (op_not (sym "xor") 5 3 7))
    (Case (utf8 "Nat.shiftLeft 3 4 ≢ 47") (op_not (sym "shiftLeft") 3 4 47))
    (Case (utf8 "Nat.shiftRight 48 4 ≢ 4") (op_not (sym "shiftRight") 48 4 4))
    (Case (utf8 "Nat.mul 2^40 2^40 ≢ 2^80 + 1")
      (op_not (sym "mul") (two_pow 40) (two_pow 40) (+ (two_pow 80) 1)))
    ;; identity: the checker's output carries ids above the env's watermark
    (Case (utf8 "infer mints ids from the seeded state")
      (match (infer (ctx) (st_for (env)) (depth) (mk_app (id_nat) (zero)) false)
        ((KOk st1 _) (< (env_watermark (env)) (st_node st1)))
        (_ false)))))


(fn main ((w World)) World (run_cases (utf8 "tc_test") (cases) 0 w))
