;;; v3/kernel/k/test/nested_test.shard — nested inductives through add.shard:
;;; List.{u} first, then Tree with a `List Tree` field.

(import "../../host.shard")
(import "../add.shard")
(import "../../test/case_kit.shard")
(import "../../test/decls_kit.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.expr)
(use kernel.host)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.InductiveType)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.test.case_kit)
(use kernel.test.case_kit.Case)
(use kernel.test.decls_kit)

(fn typeu () Expr (mk_sort (LSucc (u))))
(fn nm_nil () Name (n2 (quote List) (quote nil)))
(fn nm_cons () Name (n2 (quote List) (quote cons)))
(fn nm_tree () Name (n1 (quote Tree)))
(fn nm_node () Name (n2 (quote Tree) (quote node)))
(fn nm_leaf () Name (n2 (quote Tree) (quote leaf)))

;; List.{u} (α : Type u) : Type u ; nil : List α ; cons : α → List α → List α
(fn list_decl () Declaration
  (InductDecl (list (n1 (quote u))) 1
    (list (InductiveType (nm_list) (mk_pi (n1 (quote a)) BDefault (typeu) (typeu))
            (list (Constructor (nm_nil) (mk_pi (n1 (quote a)) BDefault (typeu) (mk_app (mk_const (nm_list) (list (u))) (mk_bvar 0))))
                  (Constructor (nm_cons)
                    (mk_pi (n1 (quote a)) BDefault (typeu)
                      (mk_pi (n1 (quote h)) BDefault (mk_bvar 0)
                        (mk_pi (n1 (quote t)) BDefault (mk_app (mk_const (nm_list) (list (u))) (mk_bvar 1))
                          (mk_app (mk_const (nm_list) (list (u))) (mk_bvar 2)))))))))
    False))
;; Tree : Type ; leaf : Nat → Tree ; node : List.{0} Tree → Tree
(fn tree_decl () Declaration
  (InductDecl Nil 0
    (list (InductiveType (nm_tree) (type1)
            (list (Constructor (nm_leaf) (arrow (nat) (mk_const (nm_tree) Nil)))
                  (Constructor (nm_node) (arrow (mk_app (mk_const (nm_list) (list LZero)) (mk_const (nm_tree) Nil)) (mk_const (nm_tree) Nil))))))
    False))
;; two-level nesting, Lean.Syntax's shape: Array.{u} (α) := mk (toList : List α);
;; Syn := missing | node (args : Array.{0} Syn) | atom (n : Nat)
(fn nm_array () Name (n1 (quote Array)))
(fn array_decl () Declaration
  (InductDecl (list (n1 (quote u))) 1
    (list (InductiveType (nm_array) (mk_pi (n1 (quote a)) BDefault (typeu) (typeu))
            (list (Constructor (n2 (quote Array) (quote mk))
                    (mk_pi (n1 (quote a)) BDefault (typeu)
                      (mk_pi (n1 (quote toList)) BDefault (mk_app (mk_const (nm_list) (list (u))) (mk_bvar 0))
                        (mk_app (mk_const (nm_array) (list (u))) (mk_bvar 1))))))))
    False))
(fn nm_syn () Name (n1 (quote Syn)))
(fn syn_decl () Declaration
  (InductDecl Nil 0
    (list (InductiveType (nm_syn) (type1)
            (list (Constructor (n2 (quote Syn) (quote missing)) (mk_const (nm_syn) Nil))
                  (Constructor (n2 (quote Syn) (quote node)) (arrow (mk_app (mk_const (nm_array) (list LZero)) (mk_const (nm_syn) Nil)) (mk_const (nm_syn) Nil)))
                  (Constructor (n2 (quote Syn) (quote atom)) (arrow (nat) (mk_const (nm_syn) Nil))))))
    False))
(fn e_arr () CheckedEnv (env_after (check (e1) (st0) (array_decl)) (e0)))
(fn e_syn () CheckedEnv (env_after (check (e_arr) (st0) (syn_decl)) (e0)))

;; a non-uniform occurrence: Bad (α : Type) : Type ; mk : Bad Nat → Bad α
(fn nonuniform_decl () Declaration
  (InductDecl Nil 1
    (list (InductiveType (n1 (quote Bad)) (mk_pi (n1 (quote a)) BDefault (type1) (type1))
            (list (Constructor (n2 (quote Bad) (quote mk))
                    (mk_pi (n1 (quote a)) BDefault (type1) (arrow (mk_app (mk_const (n1 (quote Bad)) Nil) (nat)) (mk_app (mk_const (n1 (quote Bad)) Nil) (mk_bvar 0))))))))
    False))

(fn rejected ((o (Outcome CheckedEnv)) (s Symbol)) Bool
  (match o ((Rejected (RuleViolation t) _) (sym_eq s t)) ((Rejected (Malformed t) _) (sym_eq s t)) (_ False)))
(fn e0 () CheckedEnv (CheckedEnv IMEmpty False Nil 0))
(fn e1 () CheckedEnv (env_after (check (env_after (check (e0) (st0) (nat_decl)) (e0)) (st0) (list_decl)) (e0)))
(fn e2 () CheckedEnv (env_after (check (e1) (st0) (tree_decl)) (e0)))
(fn has ((e CheckedEnv) (n Name)) Bool (match (env_find e n) ((Some _) True) (None False)))
(fn any_nested_name ((xs (List (Pair Name ConstantInfo)))) Bool
  (measure (struct xs))
  (match xs (Nil False) ((Cons (Pair n _) r) (bool_or (has_nested_prefix n) (any_nested_name r)))))
(fn rec_all ((e CheckedEnv) (n Name)) (List Name) (match (env_find e n) ((Some (RecInfo _ all _ _ _ _ _ _ _)) all) (_ Nil)))
(fn rec_nmotives ((e CheckedEnv) (n Name)) Int (match (env_find e n) ((Some (RecInfo _ _ _ _ nm _ _ _ _)) nm) (_ (- 0 1))))
(fn ctor_type_of ((e CheckedEnv) (n Name)) (Option Expr) (match (env_find e n) ((Some i) (Some (ci_type i))) (None None)))

(fn cases () (List Case)
  (list
    (Case "List accepted" (accepted (check (env_after (check (e0) (st0) (nat_decl)) (e0)) (st0) (list_decl))))
    (Case "Tree (nested via List) accepted" (accepted (check (e1) (st0) (tree_decl))))
    (Case "Tree.rec and Tree.rec_1 present" (bool_and (has (e2) (n2 (quote Tree) (quote rec))) (has (e2) (n2 (quote Tree) (quote rec_1)))))
    (Case "no auxiliary name survives" (bool_not (any_nested_name (env_entries (e2)))))
    (Case "Tree.rec: all = [Tree], 2 motives" (bool_and (names_eq (rec_all (e2) (n2 (quote Tree) (quote rec))) (list (nm_tree))) (int_eq (rec_nmotives (e2) (n2 (quote Tree) (quote rec))) 2)))
    (Case "Tree.node's type restored to List Tree"
      (match (ctor_type_of (e2) (nm_node))
        ((Some t) (expr_eq t (arrow (mk_app (mk_const (nm_list) (list LZero)) (mk_const (nm_tree) Nil)) (mk_const (nm_tree) Nil))))
        (None False)))
    (Case "Array accepted" (accepted (check (e1) (st0) (array_decl))))
    (Case "Syn (two-level nesting, Lean.Syntax's shape) accepted" (accepted (check (e_arr) (st0) (syn_decl))))
    (Case "Syn.rec, Syn.rec_1, Syn.rec_2 present" (bool_and (has (e_syn) (n2 (quote Syn) (quote rec))) (bool_and (has (e_syn) (n2 (quote Syn) (quote rec_1))) (has (e_syn) (n2 (quote Syn) (quote rec_2))))))
    (Case "Syn.rec: 3 motives" (int_eq (rec_nmotives (e_syn) (n2 (quote Syn) (quote rec))) 3))
    (Case "non-uniform occurrence refused" (rejected (check (env_after (check (e0) (st0) (nat_decl)) (e0)) (st0) (nonuniform_decl)) (quote non_uniform_occurrence)))))

(fn main ((w World)) World (run_cases "nested_test" (cases) 0 w))
