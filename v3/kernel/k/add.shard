;;; v3/kernel/k/add.shard — `check(env, decl, limits)`:
;;; environment-level admission after src/kernel/environment.cpp
;;; (`environment::add_*`, l. 127–262) and quot.cpp (`add_quot`, l. 40).
;;; The standard profile admits `Safe` declarations only: unsafe /
;;; partial declarations and mutual definition blocks are Unsupported.

(import "nested.shard")
(import "accel_pins.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.descent)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.QuotKind)
(use kernel.k.CheckedEnv)
(use kernel.verdict)
(use kernel.verdict.Outcome)
(use kernel.verdict.Reason)
(use kernel.expr.BinderInfo)
(use kernel.expr.St)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.k.Ctx)
(use kernel.verdict.Failure)
(use kernel.verdict.KRes)

(fn nm_quot () Name (n1 (sym "Quot")))
(fn nm_eq () Name (n1 (sym "Eq")))
(fn nm_eq_refl () Name (n2 (sym "Eq") (sym "refl")))


;; the limits: recursion depth and heartbeats
(type Limits (Limits Int Int))
(fn lim_depth ((l Limits)) Int
  (match l
    ((Limits d _) d)))
(fn lim_ticks ((l Limits)) Int
  (match l
    ((Limits _ t) t)))
(fn default_limits () Limits (Limits (budget_depth) (budget_ticks)))
(fn limits ((depth Int) (ticks Int)) Limits (Limits depth ticks))  ; the budget, for the clients behind the view

(fn ctx_for ((env CheckedEnv) (ps (List Name)) (safety DefinitionSafety) (lim Limits)) Ctx
  (Ctx env nil (some ps) safety false (lim_ticks lim)))

;; check_constant_val (environment.cpp l. 127): name free, level params
;; distinct, no fvar in the type, the type checks and is a sort
(fn check_constant_val
  ((env CheckedEnv) (st St) (v ConstantVal) (safety DefinitionSafety) (lim Limits))
  (KRes Int)
  (match (env_check_name env (cv_name v))
    ((some f) (KFail f))
    (none
      (if (bool_not (check_duplicated_univ_params (cv_lparams v)))
        (KFail (FRej (RuleViolation (sym "duplicate_univ_param"))))
      (if (has_fvar (cv_type v)) (KFail (FRej (Malformed (sym "fvar_in_type"))))
      (if (has_mvar (cv_type v)) (KFail (FRej (Malformed (sym "mvar_in_type"))))
      (match (infer (ctx_for env (cv_lparams v) safety lim) st (lim_depth lim) (cv_type v) false)
        ((KFail f) (KFail f))
        ((KOk st1 s)
         (match (ensure_sort (ctx_for env (cv_lparams v) safety lim) st1 (lim_depth lim) s)
           ((KFail f) (KFail f))
           ((KOk st2 _) (KOk st2 0)))))))))))

;; a value checks and its type is definitionally the declared type
(fn check_value
  ((env CheckedEnv) (st St) (v ConstantVal) (value Expr) (safety DefinitionSafety) (lim Limits))
  (KRes Int)
  (if (has_fvar value) (KFail (FRej (Malformed (sym "fvar_in_value"))))
  (if (has_mvar value) (KFail (FRej (Malformed (sym "mvar_in_value"))))
  (match (infer (ctx_for env (cv_lparams v) safety lim) st (lim_depth lim) value false)
    ((KFail f) (KFail f))
    ((KOk st1 vty)
     (match (is_def_eq (ctx_for env (cv_lparams v) safety lim) st1 (lim_depth lim) vty (cv_type v))
       ((KFail f) (KFail f))
       ((KOk st2 ok) (if ok (KOk st2 0) (KFail (FRej (ConversionNotEstablished)))))))))))

;; the four quotient constants (quot.cpp l. 40–95), levels u and v; built
;; once, anonymous, with explicit de Bruijn indices
(fn quot_u () Level (LParam (n1 (sym "u"))))
(fn quot_v () Level (LParam (n1 (sym "v"))))
;; α → α → Prop for the α bound just outside: (x : #0) → (y : #1) → Prop
(fn rel_type () Expr
  (mk_pi (n1 (sym "x")) BDefault (mk_bvar 0)
    (mk_pi (n1 (sym "y")) BDefault (mk_bvar 1) (mk_sort LZero))))

(fn quot_type () Expr
  (mk_pi (n1 (sym "a")) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (sym "r")) BDefault (rel_type) (mk_sort (quot_u)))))

(fn quot_mk_type () Expr
  (mk_pi (n1 (sym "a")) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (sym "r")) BDefault (rel_type)
      (mk_pi (n1 (sym "a")) BDefault (mk_bvar 1)
        (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 2)) (mk_bvar 1))))))

(fn quot_lift_type () Expr
  (mk_pi (n1 (sym "a")) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (sym "r")) BImplicit (rel_type)
      (mk_pi (n1 (sym "b")) BImplicit (mk_sort (quot_v))
        (mk_pi (n1 (sym "f")) BDefault (mk_pi (n1 (sym "x")) BDefault (mk_bvar 2) (mk_bvar 1))
          (mk_pi (n1 (sym "h")) BDefault
            (mk_pi (n1 (sym "a")) BDefault (mk_bvar 3)
              (mk_pi (n1 (sym "b")) BDefault (mk_bvar 4)
                (mk_pi (n1 (sym "h")) BDefault (mk_app (mk_app (mk_bvar 4) (mk_bvar 1)) (mk_bvar 0))
                  (mk_app
                    (mk_app (mk_app (mk_const (nm_eq) (list (quot_v))) (mk_bvar 4))
                      (mk_app (mk_bvar 3) (mk_bvar 2)))
                    (mk_app (mk_bvar 3) (mk_bvar 1))))))
            (mk_pi (n1 (sym "q")) BDefault
              (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 4)) (mk_bvar 3))
              (mk_bvar 3))))))))

(fn quot_ind_type () Expr
  (mk_pi (n1 (sym "a")) BImplicit (mk_sort (quot_u))
    (mk_pi (n1 (sym "r")) BImplicit (rel_type)
      (mk_pi (n1 (sym "b")) BImplicit
        (mk_pi (n1 (sym "q")) BDefault
          (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 1)) (mk_bvar 0))
          (mk_sort LZero))
        (mk_pi (n1 (sym "mk")) BDefault
          (mk_pi (n1 (sym "a")) BDefault (mk_bvar 2)
            (mk_app (mk_bvar 1)
              (mk_app
                (mk_app (mk_app (mk_const (nm_quot_mk) (list (quot_u))) (mk_bvar 3)) (mk_bvar 2))
                (mk_bvar 0))))
          (mk_pi (n1 (sym "q")) BDefault
            (mk_app (mk_app (mk_const (nm_quot) (list (quot_u))) (mk_bvar 3)) (mk_bvar 2))
            (mk_app (mk_bvar 2) (mk_bvar 0))))))))

;; check_eq_type (quot.cpp l. 13): Eq is an inductive with one level
;; parameter u, one constructor, type {α : Sort u} → α → α → Prop, and
;; Eq.refl : ∀ {α : Sort u} (a : α), Eq α a a — structurally
(fn check_eq_type ((env CheckedEnv)) Bool
  (match (env_find env (nm_eq))
    ((some (InductInfo (ConstantVal _ (cons up nil) ty) _ _ _ (cons ctor nil) _ _ _ _))
     (let ((u (LParam up)))
       (if
         (bool_not
           (expr_eq ty
             (mk_pi (n1 (sym "a")) BImplicit (mk_sort u)
               (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
                 (mk_pi (n1 (sym "b")) BDefault (mk_bvar 1) (mk_sort LZero))))))
         false
         (match (env_find env ctor)
           ((some (CtorInfo (ConstantVal _ (cons cp nil) cty) _ _ _ _ _))
            (expr_eq cty
              (mk_pi (n1 (sym "a")) BImplicit (mk_sort (LParam cp))
                (mk_pi (n1 (sym "a")) BDefault (mk_bvar 0)
                  (mk_app
                    (mk_app (mk_app (mk_const (nm_eq) (list (LParam cp))) (mk_bvar 1)) (mk_bvar 0))
                    (mk_bvar 0))))))
           (_ false)))))
    (_ false)))

(fn add_quot ((env CheckedEnv) (st St)) (KRes CheckedEnv)
  (if (env_quot_init env) (KOk st env)
  (if (bool_not (check_eq_type env)) (KFail (FRej (RuleViolation (sym "quot_eq_shape"))))
  (match (env_check_name env (nm_quot))
    ((some f) (KFail f))
    (none
      (match (env_check_name env (nm_quot_mk))
        ((some f) (KFail f))
        (none
          (match (env_check_name env (nm_quot_lift))
            ((some f) (KFail f))
            (none
              (match (env_check_name env (nm_quot_ind))
                ((some f) (KFail f))
                (none
                  (let
                    ((u (List Name) (list (n1 (sym "u"))))
                     (uv (List Name) (list (n1 (sym "u")) (n1 (sym "v")))))
                    (match
                      (env_add
                        (env_add
                          (env_add
                            (env_add env (nm_quot)
                              (QuotInfo (ConstantVal (nm_quot) u (quot_type)) QType))
                            (nm_quot_mk)
                            (QuotInfo (ConstantVal (nm_quot_mk) u (quot_mk_type)) QCtor))
                          (nm_quot_lift)
                          (QuotInfo (ConstantVal (nm_quot_lift) uv (quot_lift_type)) QLift))
                        (nm_quot_ind)
                        (QuotInfo (ConstantVal (nm_quot_ind) u (quot_ind_type)) QInd))
                      ((CheckedEnv xs _ p w) (KOk st (CheckedEnv xs true p w))))))))))))))))

;; environment::add (l. 262)
;; the node ids of a check are minted above the env's watermark and the
;; caller's counter; the accepted env carries the final counter
(fn check_decl_lim ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match (check_decl_core env (st_seed env st) lim d)
    ((KFail f) (KFail f))
    ((KOk st1 env1) (KOk (st_clear_memo st1) (env_set_watermark env1 (st_node st1))))))

(fn check_decl_core ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match d
    ((AxiomDecl v unsafe)
     (if unsafe (KFail (FRej (Unsupported (sym "unsafe_declaration"))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _) (KOk st1 (env_add env (cv_name v) (AxiomInfo v false)))))))
    ((DefnDecl v value hints safety all)
     (if (bool_not (safety_is_safe safety)) (KFail (FRej (Unsupported (sym "unsafe_declaration"))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (check_value env st1 v value Safe lim)
          ((KFail f) (KFail f))
          ((KOk st2 _) (KOk st2 (env_add env (cv_name v) (DefnInfo v value hints safety all)))))))))
    ((ThmDecl v value all)
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (is_prop (ctx_for env (cv_lparams v) Safe lim) st1 (lim_depth lim) (cv_type v))
          ((KFail f) (KFail f))
          ((KOk st2 p)
           (if (bool_not p) (KFail (FRej (RuleViolation (sym "theorem_type_not_prop"))))
           (match (check_value env st2 v value Safe lim)
             ((KFail f) (KFail f))
             ((KOk st3 _) (KOk st3 (env_add env (cv_name v) (ThmInfo v value all)))))))))))
    ((OpaqueDecl v value unsafe all)
     (if unsafe (KFail (FRej (Unsupported (sym "unsafe_declaration"))))
     (match (check_constant_val env st v Safe lim)
       ((KFail f) (KFail f))
       ((KOk st1 _)
        (match (check_value env st1 v value Safe lim)
          ((KFail f) (KFail f))
          ((KOk st2 _) (KOk st2 (env_add env (cv_name v) (OpaqueInfo v value false all)))))))))
    (QuotDecl (add_quot env st))
    ((MutualDefnDecl _) (KFail (FRej (Unsupported (sym "mutual_unsafe_block")))))
    ((InductDecl lps nparams types unsafe)
     (if unsafe (KFail (FRej (Unsupported (sym "unsafe_declaration"))))
     (add_inductive env st lps nparams types false)))))

;; the outcome, from a KRes
(fn outcome_of ((r (KRes CheckedEnv)) (subject Name)) (Outcome CheckedEnv)
  (match r
    ((KOk _ e) (Accepted e))
    ((KFail (FRej reason)) (Rejected reason subject))
    ((KFail (FOut res site)) (Exhausted res site))))

(fn decl_name ((d Declaration)) Name
  (match d
    ((AxiomDecl v _) (cv_name v))
    ((DefnDecl v _ _ _ _) (cv_name v))
    ((ThmDecl v _ _) (cv_name v))
    ((OpaqueDecl v _ _ _) (cv_name v))
    (QuotDecl (nm_quot))
    ((MutualDefnDecl _) Anon)
    ((InductDecl _ _ (cons t _) _) (it_name t))
    ((InductDecl _ _ nil _) Anon)))

;; the identity FINGERPRINT of an admitted constant (reports, the fuel-monotonicity
;; test): its type and, for definitions, its value; for an inductive type, its
;; type and every constructor's type (in order). A 61-bit structural hash —
;; NEVER an authority: it is affine in a trailing literal, so a preimage is one
;; subtraction, and it collides on ordinary Init terms (`List.cons`'s type
;; against `List α → α → List α`).
;; Nothing enables a shortcut on it; see `pin_if_matches`.
(fn identity_hash ((env CheckedEnv) (n Name)) (Option Int)
  (match (env_find env n)
    ((some (DefnInfo (ConstantVal _ _ ty) v _ _ _)) (some (mix (hash_expr ty) (hash_expr v))))
    ((some (InductInfo (ConstantVal _ _ ty) _ _ _ ctors _ _ _ _))
     (some (hash_ctor_types env ctors (hash_expr ty))))
    ((some info) (some (hash_expr (ci_type info))))
    (none none)))

(fn hash_ctor_types ((env CheckedEnv) (ctors (List Name)) (acc Int)) Int
  (measure (struct ctors))
  (match ctors
    (nil acc)
    ((cons c r)
     (match (env_find env c)
       ((some info) (hash_ctor_types env r (mix acc (hash_expr (ci_type info)))))
       (none acc)))))

;; ---- the accelerator pins ---------------------------------------------------------------
;; A shortcut (a Nat operation on literals, a literal's typing rule, the string
;; literal expansion) is enabled for a candidate name only when its IDENTITY
;; CLOSURE matches the reference table generated from the pinned export
;; (accel_pins.shard `accel_ref`): the declaration itself and, transitively,
;; every definition, opaque, axiom and inductive type that its type and value
;; cite. Compared exactly, by `expr_eq` (binder names and infos ignored): the
;; kind, the level parameters, the type, the value; for an inductive its
;; parameter count, its block and each constructor's name and type in order.
;; Not compared: theorems (proof irrelevance — a different proof can only make
;; a reduction stick, never change a value); constructors and recursors (K
;; generated them from their inductive, which IS compared); quotients (K fixes
;; them itself); reducibility hints and `all` lists (no effect on a value).
;; Exempt from BODY comparison is not exempt from KIND: a name the table holds
;; as a definition, opaque, axiom or inductive must be admitted as that kind,
;; and a root candidate must have a row (else a theorem named `Nat.add` in
;; an environment without one would be pinned — never applicable, since K
;; types a head before it reduces it, but authorized).
;; Never a hash and never a name: a same-spelled `Nat.add` with a different
;; body, or the pinned body over a different `Nat.pred`, is admitted as an
;; ordinary definition and reaches no shortcut. The walk is fuel-bounded; out
;; of fuel = no pin, never a wrong pin.
(fn ref_fuel () Int 100000)

(fn pin_if_matches ((env CheckedEnv) (n Name)) CheckedEnv
  (if (bool_and (is_pin_candidate n) (ref_rooted n))
    (if (ref_closure_ok env (cons n nil) nil (ref_fuel)) (env_pin env n) env)
    env))
;; every candidate has a reference row; one without pins nothing
(fn ref_rooted ((n Name)) Bool
  (match (accel_ref n)
    ((some _) true)
    (none false)))

(fn ref_closure_ok ((env CheckedEnv) (todo (List Name)) (seen (List Name)) (fuel Int)) Bool
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) false
  (match todo
    (nil true)
    ((cons c r)
     (if (mem_name c seen) (ref_closure_ok env r seen (- fuel 1))
     (match (env_find env c)
       (none false)
       ((some info)
        (if (ref_matches env c info)
          (ref_closure_ok env (append (ref_edges env info) r) (cons c seen) (- fuel 1))
          false))))))))

;; the identity closure's edges out of an entry (the generator walks the same edges)
(fn ref_edges ((env CheckedEnv) (info ConstantInfo)) (List Name)
  (match info
    ((DefnInfo cv v _ _ _) (append (expr_consts (cv_type cv)) (expr_consts v)))
    ((OpaqueInfo cv v _ _) (append (expr_consts (cv_type cv)) (expr_consts v)))
    ((AxiomInfo cv _) (expr_consts (cv_type cv)))
    ((InductInfo cv _ _ all ctors _ _ _ _)
     (append (expr_consts (cv_type cv)) (append (ctor_types_consts env ctors) all)))
    ((CtorInfo _ induct _ _ _ _) (cons induct nil))
    ((RecInfo _ all _ _ _ _ _ _ _) all)
    (_ nil)))

(fn ctor_types_consts ((env CheckedEnv) (ctors (List Name))) (List Name)
  (measure (struct ctors))
  (match ctors
    (nil nil)
    ((cons c r)
     (append
       (match (env_find env c)
         ((some info) (expr_consts (ci_type info)))
         (none nil))
       (ctor_types_consts env r)))))

;; an entry against its reference row: the kind first, then (for a compared kind) the row
(fn ref_matches ((env CheckedEnv) (c Name) (info ConstantInfo)) Bool
  (match info
    ((ThmInfo _ _ _) (ref_exempt c))
    ((QuotInfo _ _) (ref_exempt c))
    ((CtorInfo _ _ _ _ _ _) (ref_exempt c))
    ((RecInfo _ _ _ _ _ _ _ _ _) (ref_exempt c))
    ((DefnInfo cv v _ _ _)
     (match (accel_ref c)
       ((some (DefnDecl rcv rv _ _ _)) (bool_and (cval_eq cv rcv) (expr_eq v rv)))
       (_ false)))
    ((OpaqueInfo cv v _ _)
     (match (accel_ref c)
       ((some (OpaqueDecl rcv rv _ _)) (bool_and (cval_eq cv rcv) (expr_eq v rv)))
       (_ false)))
    ((AxiomInfo cv _)
     (match (accel_ref c)
       ((some (AxiomDecl rcv _)) (cval_eq cv rcv))
       (_ false)))
    ((InductInfo cv np _ all ctors _ _ _ _)
     (match (accel_ref c)
       ((some (InductDecl lps rnp types _))
        (bool_and (names_eq (cv_lparams cv) lps)
          (bool_and (= np rnp)
            (bool_and (names_eq all (all_names types))
              (match (find_it types c)
                ((some it)
                 (bool_and (expr_eq (cv_type cv) (it_type it)) (ctors_match env ctors (it_ctors it))))
                (none false))))))
       (_ false)))))

;; an exempt kind (theorem, quotient, constructor, recursor) passes only under a name the
;; table holds no row for — a row is a definition, opaque, axiom or inductive, and the entry
;; must be that kind
(fn ref_exempt ((c Name)) Bool
  (match (accel_ref c)
    (none true)
    ((some _) false)))


(fn find_it ((ts (List InductiveType)) (n Name)) (Option InductiveType)
  (measure (struct ts))
  (match ts
    (nil none)
    ((cons t r) (if (name_eq (it_name t) n) (some t) (find_it r n)))))

;; the admitted constructors (names, in order) against the reference's, type by type
(fn ctors_match ((env CheckedEnv) (ns (List Name)) (cs (List Constructor))) Bool
  (measure (struct ns))
  (match ns
    (nil
      (match cs
        (nil true)
        (_ false)))
    ((cons n r)
     (match cs
       (nil false)
       ((cons c cr)
        (if (name_eq n (ctor_name c))
          (match (env_find env n)
            ((some info) (if (expr_eq (ci_type info) (ctor_type c)) (ctors_match env r cr) false))
            (none false))
          false))))))
;; the closure's descent, here because `ref_closure_ok` is defined once the last function it
;; calls is
(fulfills ref_closure_ok.dec_1
  (by (intro p h c r ht hm info hi hr) (apply natAbs_lt (arith) (arith))))
(fulfills ref_closure_ok.dec_2 (by (intro p h c r ht hm) (apply natAbs_lt (arith) (arith))))

(fn env_pin ((env CheckedEnv) (n Name)) CheckedEnv
  (match env
    ((CheckedEnv xs q p w) (CheckedEnv xs q (cons n p) w))))

;; check + pin (the environment K clients use)
(fn check_decl_pinning ((env CheckedEnv) (st St) (d Declaration)) (KRes CheckedEnv)
  (check_decl_pinning_lim env st (default_limits) d))

(fn check_decl_pinning_lim ((env CheckedEnv) (st St) (lim Limits) (d Declaration)) (KRes CheckedEnv)
  (match (check_decl_lim env st lim d)
    ((KFail f) (KFail f))
    ((KOk st1 env1) (KOk st1 (pin_names env1 (decl_pin_candidates d))))))

(fn pin_names ((env CheckedEnv) (ns (List Name))) CheckedEnv
  (measure (struct ns))
  (match ns
    (nil env)
    ((cons n r) (pin_names (pin_if_matches env n) r))))

;; the names a declaration may pin: its own, or an inductive block's types
(fn decl_pin_candidates ((d Declaration)) (List Name)
  (match d
    ((InductDecl _ _ types _) (all_names types))
    (_ (cons (decl_name d) nil))))

;; ---- the raw entry -------------------------------------------------------------------
;; `check` is where a declaration built OUTSIDE K enters: the reader's, a test's, an
;; embedding's. Its node data is a claim (expr.shard: ingestion), so every term is rebuilt
;; from its structure before the procedure reads it — each distinct structure once, across
;; the declaration's type and value (an inductive block's types and constructors), the nodes
;; minted from the check's own state above the environment's watermark. The import's records
;; enter through `check_decl_pinning` directly — their tables minted by the run's state — and
;; never pay the walk.
(fn ingest_cval ((g Ingest) (v ConstantVal)) (Prod Ingest ConstantVal)
  (match v
    ((ConstantVal n ps t)
     (match (ingest_expr g t)
       ((Prod.mk g1 t1) (Prod.mk g1 (ConstantVal n ps t1)))))))
;; a constant's type and its value
(fn ingest_valued ((g Ingest) (v ConstantVal) (x Expr)) (Prod Ingest (Prod ConstantVal Expr))
  (match (ingest_cval g v)
    ((Prod.mk g1 v1)
     (match (ingest_expr g1 x)
       ((Prod.mk g2 x1) (Prod.mk g2 (Prod.mk v1 x1)))))))
(fn ingest_ctors ((g Ingest) (cs (List Constructor)) (acc (List Constructor)))
  (Prod Ingest (List Constructor))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk g (rev acc)))
    ((cons (Constructor n t) r)
     (match (ingest_expr g t)
       ((Prod.mk g1 t1) (ingest_ctors g1 r (cons (Constructor n t1) acc)))))))
(fn ingest_types ((g Ingest) (ts (List InductiveType)) (acc (List InductiveType)))
  (Prod Ingest (List InductiveType))
  (measure (struct ts))
  (match ts
    (nil (Prod.mk g (rev acc)))
    ((cons (InductiveType n t cs) r)
     (match (ingest_expr g t)
       ((Prod.mk g1 t1)
        (match (ingest_ctors g1 cs nil)
          ((Prod.mk g2 cs1) (ingest_types g2 r (cons (InductiveType n t1 cs1) acc)))))))))
(fn ingest_decl ((g Ingest) (d Declaration)) (Prod Ingest Declaration)
  (match d
    ((AxiomDecl v u)
     (match (ingest_cval g v)
       ((Prod.mk g1 v1) (Prod.mk g1 (AxiomDecl v1 u)))))
    ((DefnDecl v x h s a)
     (match (ingest_valued g v x)
       ((Prod.mk g1 (Prod.mk v1 x1)) (Prod.mk g1 (DefnDecl v1 x1 h s a)))))
    ((ThmDecl v x a)
     (match (ingest_valued g v x)
       ((Prod.mk g1 (Prod.mk v1 x1)) (Prod.mk g1 (ThmDecl v1 x1 a)))))
    ((OpaqueDecl v x u a)
     (match (ingest_valued g v x)
       ((Prod.mk g1 (Prod.mk v1 x1)) (Prod.mk g1 (OpaqueDecl v1 x1 u a)))))
    (QuotDecl (Prod.mk g QuotDecl))
    ((MutualDefnDecl ds) (Prod.mk g (MutualDefnDecl ds)))  ; refused unread (mutual_unsafe_block)
    ((InductDecl lps np ts u)
     (match (ingest_types g ts nil)
       ((Prod.mk g1 ts1) (Prod.mk g1 (InductDecl lps np ts1 u)))))))

(fn check ((env CheckedEnv) (st St) (d Declaration)) (Outcome CheckedEnv)
  (check_with env st (default_limits) d))

;; `check` under given limits. The ingestion mints from the state the check
;; would start from (st_seed: above the environment's watermark and the caller's counter); the
;; check goes on from the state it leaves
(fn check_with ((env CheckedEnv) (st St) (lim Limits) (d0 Declaration)) (Outcome CheckedEnv)
  (match (ingest_decl (ingest_new (st_seed env st)) d0)
    ((Prod.mk g d) (outcome_of (check_decl_pinning_lim env (ingest_st g) lim d) (decl_name d)))))
