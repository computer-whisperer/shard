;;; v3/kernel/store.shard — the store writer (LANGUAGE.md §8.4 slice 3.22 rule 7;
;;; law §7.5): an admitted constant of K's environment rendered as the records K
;;; ingests — lean4export's NDJSON, format 3.1.0, field for field what
;;; kernel/k/import.shard reads —, one file's worth per declaration: the name,
;;; level and expression tables the declaration cites, numbered from 1 in
;;; first-use order (0 is `anonymous` and `zero`, as the exporter's), then the
;;; declaration record. A file stands alone before an environment that holds
;;; what it cites: the tables restart in every file, so a stream of files
;;; replays in order, each file's tables overwriting the last's (the import's
;;; tables are maps by index). Table nodes are shared by STRICT structural
;;; identity — binder names and infos included, which expr_eq ignores —, so a
;;; record carries the term as elaborated, and two runs over one elaboration
;;; write one text. An inductive type is written as its block: every type,
;;; constructor and recursor K generated for it, the fields the import validates
;;; against K's own regeneration (T0's validation, a second time). Nothing here
;;; is trusted: K re-checks every record the store holds (verify_release.shard),
;;; and a record this writer gets wrong is that run's verdict, never an
;;; acceptance.

(import "host.shard")
(import "json.shard")
(import "k")
(use kernel.k)
(use kernel.host)
(use kernel.json)
(use kernel.decl)
(use kernel.expr)
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.RecursorRule)
(use kernel.decl.ReducibilityHints)
(use kernel.expr.BinderInfo)
(use kernel.expr.D)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.host.World)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

;; ---- JSON text ---------------------------------------------------------------------------
;; the escapes the import reads back (json.shard): the quote, the backslash, the
;; named controls, \u00XX for the rest below 32; every other byte raw (UTF-8 as is)
(fn sw_escape ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (Nil Nil)
    ((Cons c r)
     (if (int_eq c 34) (Cons 92 (Cons 34 (sw_escape r)))
     (if (int_eq c 92) (Cons 92 (Cons 92 (sw_escape r)))
     (if (int_eq c 10) (Cons 92 (Cons 110 (sw_escape r)))
     (if (int_eq c 9) (Cons 92 (Cons 116 (sw_escape r)))
     (if (int_eq c 13) (Cons 92 (Cons 114 (sw_escape r)))
     (if (int_eq c 8) (Cons 92 (Cons 98 (sw_escape r)))
     (if (int_eq c 12) (Cons 92 (Cons 102 (sw_escape r)))
     (if (lt c 32) (append "\\u00" (append (list (sw_hex (ediv c 16)) (sw_hex (mod c 16))) (sw_escape r)))
     (Cons c (sw_escape r)))))))))))))
(fn sw_hex ((d Int)) Int (if (lt d 10) (+ 48 d) (+ 87 d)))
(fn sw_str ((bs (List Int))) (List Int) (Cons 34 (append (sw_escape bs) (list 34))))
(fn sw_bool ((b Bool)) (List Int) (if b "true" "false"))
;; "KEY":VALUE
(fn sw_f ((k (List Int)) (v (List Int))) (List Int) (append (sw_str k) (Cons 58 v)))
;; {F,F,…} and [X,X,…]
(fn sw_obj ((fs (List (List Int)))) (List Int) (Cons 123 (append (sw_join fs) (list 125))))
(fn sw_arr ((xs (List (List Int)))) (List Int) (Cons 91 (append (sw_join xs) (list 93))))
(fn sw_ints ((xs (List Int))) (List Int) (sw_arr (sw_show_all xs)))
(fn sw_show_all ((xs (List Int))) (List (List Int))
  (measure (struct xs))
  (match xs (Nil Nil) ((Cons x r) (Cons (show_nat x) (sw_show_all r)))))
(fn sw_join ((xs (List (List Int)))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil Nil)
    ((Cons x Nil) x)
    ((Cons x r) (append x (Cons 44 (sw_join r))))))

;; ---- the tables of one file ----------------------------------------------------------------
;; names, levels and expressions by structural hash to a bucket of (node, index),
;; the next index of each, and the lines so far (newest first)
(type SW (SW (IntMap (List (Pair Name Int))) Int (IntMap (List (Pair Level Int))) Int (IntMap (List (Pair Expr Int))) Int (List (List Int))))
(fn sw_empty () SW (SW IMEmpty 1 IMEmpty 1 IMEmpty 1 Nil))
(fn sw_lines ((s SW)) (List (List Int)) (match s ((SW _ _ _ _ _ _ ls) (rev ls))))
(fn sw_line ((s SW) (ln (List Int))) SW (match s ((SW a b c d e f ls) (SW a b c d e f (Cons ln ls)))))

;; -- names: {"in":I,"str":{"pre":P,"str":"S"}} / {"in":I,"num":{"i":N,"pre":P}}
(fn sw_name ((s SW) (n Name)) (Pair SW Int)
  (measure (struct n))
  (match n
    (Anon (Pair s 0))
    ((Str p c)
     (match (sw_name_find s n)
       ((Some i) (Pair s i))
       (None
        (match (sw_name s p)
          ((Pair s1 pi) (sw_name_add s1 n (sw_f "str" (sw_obj (list (sw_f "pre" (show_nat pi)) (sw_f "str" (sw_str (chars_of_sym c))))))))))))
    ((Num p k)
     (match (sw_name_find s n)
       ((Some i) (Pair s i))
       (None
        (match (sw_name s p)
          ((Pair s1 pi) (sw_name_add s1 n (sw_f "num" (sw_obj (list (sw_f "i" (show_nat k)) (sw_f "pre" (show_nat pi)))))))))))))
(fn sw_name_find ((s SW) (n Name)) (Option Int)
  (match s ((SW nm _ _ _ _ _ _) (sw_name_in (sw_bucket_n nm (hash_name n)) n))))
(fn sw_bucket_n ((m (IntMap (List (Pair Name Int)))) (h Int)) (List (Pair Name Int))
  (match (im_find m h) ((Some b) b) (None Nil)))
(fn sw_name_in ((b (List (Pair Name Int))) (n Name)) (Option Int)
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair m i) r) (if (name_eq m n) (Some i) (sw_name_in r n)))))
(fn sw_name_add ((s SW) (n Name) (body (List Int))) (Pair SW Int)
  (match s
    ((SW nm ni lv li ex ei ls)
     (let ((h (hash_name n)))
       (Pair (SW (im_insert nm h (Cons (Pair n ni) (sw_bucket_n nm h))) (+ ni 1) lv li ex ei
                 (Cons (sw_obj (list (sw_f "in" (show_nat ni)) body)) ls))
             ni)))))
(fn sw_names ((s SW) (ns (List Name)) (acc (List Int))) (Pair SW (List Int))
  (measure (struct ns))
  (match ns
    (Nil (Pair s (rev acc)))
    ((Cons n r) (match (sw_name s n) ((Pair s1 i) (sw_names s1 r (Cons i acc)))))))

;; -- levels: {"il":I,"succ":A} / {"il":I,"max":[A,B]} / {"il":I,"imax":[A,B]} / {"il":I,"param":N}
(fn sw_level ((s SW) (l Level)) (Pair SW Int)
  (measure (struct l))
  (match l
    (LZero (Pair s 0))
    (_
     (match (sw_level_find s l)
       ((Some i) (Pair s i))
       (None
        (match l
          ((LSucc x) (match (sw_level s x) ((Pair s1 a) (sw_level_add s1 l (sw_f "succ" (show_nat a))))))
          ((LMax a b)
           (match (sw_level s a)
             ((Pair s1 ia) (match (sw_level s1 b) ((Pair s2 ib) (sw_level_add s2 l (sw_f "max" (sw_ints (list ia ib)))))))))
          ((LIMax a b)
           (match (sw_level s a)
             ((Pair s1 ia) (match (sw_level s1 b) ((Pair s2 ib) (sw_level_add s2 l (sw_f "imax" (sw_ints (list ia ib)))))))))
          ((LParam n) (match (sw_name s n) ((Pair s1 ni) (sw_level_add s1 l (sw_f "param" (show_nat ni))))))
          ;; never in a checked constant; written as the import refuses it
          ((LMVar i) (sw_level_add s l (sw_f "mvar" (show_nat i))))
          (LZero (Pair s 0))))))))
(fn sw_level_find ((s SW) (l Level)) (Option Int)
  (match s ((SW _ _ lv _ _ _ _) (sw_level_in (sw_bucket_l lv (hash_level l)) l))))
(fn sw_bucket_l ((m (IntMap (List (Pair Level Int)))) (h Int)) (List (Pair Level Int))
  (match (im_find m h) ((Some b) b) (None Nil)))
(fn sw_level_in ((b (List (Pair Level Int))) (l Level)) (Option Int)
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair m i) r) (if (level_eq m l) (Some i) (sw_level_in r l)))))
(fn sw_level_add ((s SW) (l Level) (body (List Int))) (Pair SW Int)
  (match s
    ((SW nm ni lv li ex ei ls)
     (let ((h (hash_level l)))
       (Pair (SW nm ni (im_insert lv h (Cons (Pair l li) (sw_bucket_l lv h))) (+ li 1) ex ei
                 (Cons (sw_obj (list (sw_f "il" (show_nat li)) body)) ls))
             li)))))
(fn sw_levels ((s SW) (ls (List Level)) (acc (List Int))) (Pair SW (List Int))
  (measure (struct ls))
  (match ls
    (Nil (Pair s (rev acc)))
    ((Cons l r) (match (sw_level s l) ((Pair s1 i) (sw_levels s1 r (Cons i acc)))))))

;; -- expressions, by the import's kinds
(fn sw_expr ((s SW) (e Expr)) (Pair SW Int)
  (measure (struct e))
  (match (sw_expr_find s e)
    ((Some i) (Pair s i))
    (None
     (match e
       ((BVar _ i) (sw_expr_add s e (sw_f "bvar" (show_nat i))))
       ((Sort _ u) (match (sw_level s u) ((Pair s1 li) (sw_expr_add s1 e (sw_f "sort" (show_nat li))))))
       ((Const _ n ls)
        (match (sw_name s n)
          ((Pair s1 ni)
           (match (sw_levels s1 ls Nil)
             ((Pair s2 lis) (sw_expr_add s2 e (sw_f "const" (sw_obj (list (sw_f "name" (show_nat ni)) (sw_f "us" (sw_ints lis)))))))))))
       ((App _ f a)
        (match (sw_expr s f)
          ((Pair s1 fi)
           (match (sw_expr s1 a)
             ((Pair s2 ai) (sw_expr_add s2 e (sw_f "app" (sw_obj (list (sw_f "arg" (show_nat ai)) (sw_f "fn" (show_nat fi)))))))))))
       ((Lam _ n bi d b)
        (match (sw_name s n)
          ((Pair s1 ni)
           (match (sw_expr s1 d)
             ((Pair s2 di)
              (match (sw_expr s2 b)
                ((Pair s3 bo) (sw_expr_add s3 e (sw_binder "lam" ni bi di bo)))))))))
       ((Pi _ n bi d b)
        (match (sw_name s n)
          ((Pair s1 ni)
           (match (sw_expr s1 d)
             ((Pair s2 di)
              (match (sw_expr s2 b)
                ((Pair s3 bo) (sw_expr_add s3 e (sw_binder "forallE" ni bi di bo)))))))))
       ((Let _ n t v b)
        (match (sw_name s n)
          ((Pair s1 ni)
           (match (sw_expr s1 t)
             ((Pair s2 ti)
              (match (sw_expr s2 v)
                ((Pair s3 vi)
                 (match (sw_expr s3 b)
                   ((Pair s4 bo)
                    (sw_expr_add s4 e (sw_f "letE" (sw_obj (list (sw_f "body" (show_nat bo)) (sw_f "name" (show_nat ni)) (sw_f "nondep" "false")
                                                                (sw_f "type" (show_nat ti)) (sw_f "value" (show_nat vi)))))))))))))))
       ((Lit _ (LitNat k)) (sw_expr_add s e (sw_f "natVal" (sw_str (show_nat k)))))
       ((Lit _ (LitStr bs)) (sw_expr_add s e (sw_f "strVal" (sw_str bs))))
       ((Proj _ tn i x)
        (match (sw_name s tn)
          ((Pair s1 ni)
           (match (sw_expr s1 x)
             ((Pair s2 xi)
              (sw_expr_add s2 e (sw_f "proj" (sw_obj (list (sw_f "idx" (show_nat i)) (sw_f "struct" (show_nat xi)) (sw_f "typeName" (show_nat ni)))))))))))
       ;; never in a checked constant; written as the import refuses them
       ((FVar _ i) (sw_expr_add s e (sw_f "fvar" (show_nat i))))
       ((MVar _ i) (sw_expr_add s e (sw_f "mvar" (show_nat i))))))))
(fn sw_binder ((kind (List Int)) (ni Int) (bi BinderInfo) (di Int) (bo Int)) (List Int)
  (sw_f kind (sw_obj (list (sw_f "binderInfo" (sw_str (sw_binfo bi))) (sw_f "body" (show_nat bo)) (sw_f "name" (show_nat ni)) (sw_f "type" (show_nat di))))))
(fn sw_binfo ((bi BinderInfo)) (List Int)
  (match bi (BDefault "default") (BImplicit "implicit") (BStrictImplicit "strictImplicit") (BInstImplicit "instImplicit")))
(fn sw_expr_find ((s SW) (e Expr)) (Option Int)
  (match s ((SW _ _ _ _ ex _ _) (sw_expr_in (sw_bucket_e ex (hash_expr e)) e))))
(fn sw_bucket_e ((m (IntMap (List (Pair Expr Int)))) (h Int)) (List (Pair Expr Int))
  (match (im_find m h) ((Some b) b) (None Nil)))
(fn sw_expr_in ((b (List (Pair Expr Int))) (e Expr)) (Option Int)
  (measure (struct b))
  (match b (Nil None) ((Cons (Pair x i) r) (if (sw_same x e) (Some i) (sw_expr_in r e)))))
(fn sw_expr_add ((s SW) (e Expr) (body (List Int))) (Pair SW Int)
  (match s
    ((SW nm ni lv li ex ei ls)
     (let ((h (hash_expr e)))
       (Pair (SW nm ni lv li (im_insert ex h (Cons (Pair e ei) (sw_bucket_e ex h))) (+ ei 1)
                 (Cons (sw_obj (list (sw_f "ie" (show_nat ei)) body)) ls))
             ei)))))

;; strict structural identity: expr_eq with the binder names and infos compared
;; (the pin's order kept: one identified node is itself; a hash mismatch is no)
(fn sw_same ((a Expr) (b Expr)) Bool
  (match (expr_d a)
    ((D ia ha _ _ _ _)
     (match (expr_d b)
       ((D ib hb _ _ _ _)
        (if (bool_and (int_eq ia ib) (lt 0 ia)) True
          (if (int_eq ha hb) (sw_same_core a b) False)))))))
(fn sw_same_core ((a Expr) (b Expr)) Bool
  (measure (struct a))
  (match a
    ((BVar _ i) (match b ((BVar _ j) (int_eq i j)) (_ False)))
    ((FVar _ i) (match b ((FVar _ j) (int_eq i j)) (_ False)))
    ((Sort _ u) (match b ((Sort _ v) (level_eq u v)) (_ False)))
    ((Const _ n ls) (match b ((Const _ m ms) (if (name_eq n m) (levels_eq ls ms) False)) (_ False)))
    ((App _ f x) (match b ((App _ g y) (if (sw_same f g) (sw_same x y) False)) (_ False)))
    ((Lam _ na i1 d1 b1)
     (match b ((Lam _ nb i2 d2 b2) (if (name_eq na nb) (if (sw_binfo_eq i1 i2) (if (sw_same d1 d2) (sw_same b1 b2) False) False) False)) (_ False)))
    ((Pi _ na i1 d1 b1)
     (match b ((Pi _ nb i2 d2 b2) (if (name_eq na nb) (if (sw_binfo_eq i1 i2) (if (sw_same d1 d2) (sw_same b1 b2) False) False) False)) (_ False)))
    ((Let _ na t1 v1 b1)
     (match b ((Let _ nb t2 v2 b2) (if (name_eq na nb) (if (sw_same t1 t2) (if (sw_same v1 v2) (sw_same b1 b2) False) False) False)) (_ False)))
    ((Lit _ l1) (match b ((Lit _ l2) (lit_eq l1 l2)) (_ False)))
    ((Proj _ s1 i1 x1) (match b ((Proj _ s2 i2 x2) (if (name_eq s1 s2) (if (int_eq i1 i2) (sw_same x1 x2) False) False)) (_ False)))
    ((MVar _ i) (match b ((MVar _ j) (int_eq i j)) (_ False)))))
(fn sw_binfo_eq ((a BinderInfo) (b BinderInfo)) Bool (int_list_eq (sw_binfo a) (sw_binfo b)))

;; ---- declaration records --------------------------------------------------------------------
;; the records of the constant N of ENV as one declaration — its tables, then the
;; declaration record —, or None: N is not a constant of ENV, or is one K generated
;; with its block (a constructor, a recursor) or admitted as a quotient primitive
(fn store_records ((env CheckedEnv) (n Name)) (Option (List (List Int)))
  (match (env_find env n)
    (None None)
    ((Some info)
     (match info
       ((AxiomInfo (ConstantVal _ lps ty) unsafe)
        (match (sw_name (sw_empty) n)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_expr s2 ty)
                ((Pair s3 ti)
                 (Some (sw_done s3 (sw_f "axiom" (sw_obj (list (sw_f "isUnsafe" (sw_bool unsafe)) (sw_f "levelParams" (sw_ints lis))
                                                               (sw_f "name" (show_nat ni)) (sw_f "type" (show_nat ti))))))))))))))
       ((DefnInfo (ConstantVal _ lps ty) v hints safety all)
        (match (sw_name (sw_empty) n)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_names s2 all Nil)
                ((Pair s3 ais)
                 (match (sw_expr s3 ty)
                   ((Pair s4 ti)
                    (match (sw_expr s4 v)
                      ((Pair s5 vi)
                       (Some (sw_done s5 (sw_f "def" (sw_obj (list (sw_f "all" (sw_ints ais)) (sw_f "hints" (sw_hints hints)) (sw_f "levelParams" (sw_ints lis))
                                                                   (sw_f "name" (show_nat ni)) (sw_f "safety" (sw_str (sw_safety safety)))
                                                                   (sw_f "type" (show_nat ti)) (sw_f "value" (show_nat vi))))))))))))))))))
       ((ThmInfo (ConstantVal _ lps ty) v all)
        (match (sw_name (sw_empty) n)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_names s2 all Nil)
                ((Pair s3 ais)
                 (match (sw_expr s3 ty)
                   ((Pair s4 ti)
                    (match (sw_expr s4 v)
                      ((Pair s5 vi)
                       (Some (sw_done s5 (sw_f "thm" (sw_obj (list (sw_f "all" (sw_ints ais)) (sw_f "levelParams" (sw_ints lis))
                                                                   (sw_f "name" (show_nat ni)) (sw_f "type" (show_nat ti)) (sw_f "value" (show_nat vi))))))))))))))))))
       ((OpaqueInfo (ConstantVal _ lps ty) v unsafe all)
        (match (sw_name (sw_empty) n)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_names s2 all Nil)
                ((Pair s3 ais)
                 (match (sw_expr s3 ty)
                   ((Pair s4 ti)
                    (match (sw_expr s4 v)
                      ((Pair s5 vi)
                       (Some (sw_done s5 (sw_f "opaque" (sw_obj (list (sw_f "all" (sw_ints ais)) (sw_f "isUnsafe" (sw_bool unsafe)) (sw_f "levelParams" (sw_ints lis))
                                                                      (sw_f "name" (show_nat ni)) (sw_f "type" (show_nat ti)) (sw_f "value" (show_nat vi))))))))))))))))))
       ((InductInfo _ _ _ all _ nnested _ _ _)
        (match (sw_types env (sw_empty) all Nil)
          ((Pair s1 tjs)
           (match (sw_ctors env s1 (block_members_ctors env all) Nil)
             ((Pair s2 cjs)
              (match (sw_recs env s2 (block_recs n all nnested) Nil)
                ((Pair s3 rjs)
                 (Some (sw_done s3 (sw_f "inductive" (sw_obj (list (sw_f "ctors" (sw_arr cjs)) (sw_f "recs" (sw_arr rjs)) (sw_f "types" (sw_arr tjs))))))))))))))
       (_ None)))))
(fn sw_done ((s SW) (decl (List Int))) (List (List Int)) (append (sw_lines s) (list (sw_obj (list decl)))))
(fn sw_hints ((h ReducibilityHints)) (List Int)
  (match h (HOpaque (sw_str "opaque")) (HAbbrev (sw_str "abbrev")) ((HRegular k) (sw_obj (list (sw_f "regular" (show_nat k)))))))
(fn sw_safety ((s DefinitionSafety)) (List Int) (match s (Safe "safe") (Unsafe "unsafe") (Partial "partial")))

;; the constructors of a block's types, in the types' order
(fn block_members_ctors ((env CheckedEnv) (all (List Name))) (List Name)
  (measure (struct all))
  (match all (Nil Nil) ((Cons t r) (append (induct_ctors env t) (block_members_ctors env r)))))
;; the block's recursors: T.rec for each type, then MAIN.rec_1 … for the nested auxiliaries
(fn block_recs ((main Name) (all (List Name)) (nnested Int)) (List Name)
  (append (block_type_recs all) (block_aux_recs main 1 nnested)))
(fn block_type_recs ((all (List Name))) (List Name)
  (measure (struct all))
  (match all (Nil Nil) ((Cons t r) (Cons (Str t (quote rec)) (block_type_recs r)))))
(fn block_aux_recs ((main Name) (i Int) (nnested Int)) (List Name)
  (measure (- (+ nnested 1) i))
  (if (lt nnested i) Nil
    (Cons (Str main (sym_of_chars (append "rec_" (show_nat i)))) (block_aux_recs main (+ i 1) nnested))))

;; one type entry per type of the block
(fn sw_types ((env CheckedEnv) (s SW) (ts (List Name)) (acc (List (List Int)))) (Pair SW (List (List Int)))
  (measure (struct ts))
  (match ts
    (Nil (Pair s (rev acc)))
    ((Cons t r)
     (match (env_find env t)
       ((Some (InductInfo (ConstantVal _ lps ty) np nidx all ctors nnested isrec unsafe refl))
        (match (sw_name s t)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_names s2 all Nil)
                ((Pair s3 ais)
                 (match (sw_names s3 ctors Nil)
                   ((Pair s4 cis)
                    (match (sw_expr s4 ty)
                      ((Pair s5 ti)
                       (sw_types env s5 r
                         (Cons (sw_obj (list (sw_f "all" (sw_ints ais)) (sw_f "ctors" (sw_ints cis)) (sw_f "isRec" (sw_bool isrec)) (sw_f "isReflexive" (sw_bool refl))
                                             (sw_f "isUnsafe" (sw_bool unsafe)) (sw_f "levelParams" (sw_ints lis)) (sw_f "name" (show_nat ni))
                                             (sw_f "numIndices" (show_nat nidx)) (sw_f "numNested" (show_nat nnested)) (sw_f "numParams" (show_nat np))
                                             (sw_f "type" (show_nat ti))))
                               acc)))))))))))))
       (_ (sw_types env s r acc))))))
(fn sw_ctors ((env CheckedEnv) (s SW) (cs (List Name)) (acc (List (List Int)))) (Pair SW (List (List Int)))
  (measure (struct cs))
  (match cs
    (Nil (Pair s (rev acc)))
    ((Cons c r)
     (match (env_find env c)
       ((Some (CtorInfo (ConstantVal _ lps ty) induct cidx np nf unsafe))
        (match (sw_name s c)
          ((Pair s1 ni)
           (match (sw_name s1 induct)
             ((Pair s2 ii)
              (match (sw_names s2 lps Nil)
                ((Pair s3 lis)
                 (match (sw_expr s3 ty)
                   ((Pair s4 ti)
                    (sw_ctors env s4 r
                      (Cons (sw_obj (list (sw_f "cidx" (show_nat cidx)) (sw_f "induct" (show_nat ii)) (sw_f "isUnsafe" (sw_bool unsafe))
                                          (sw_f "levelParams" (sw_ints lis)) (sw_f "name" (show_nat ni)) (sw_f "numFields" (show_nat nf))
                                          (sw_f "numParams" (show_nat np)) (sw_f "type" (show_nat ti))))
                            acc)))))))))))
       (_ (sw_ctors env s r acc))))))
(fn sw_recs ((env CheckedEnv) (s SW) (rs (List Name)) (acc (List (List Int)))) (Pair SW (List (List Int)))
  (measure (struct rs))
  (match rs
    (Nil (Pair s (rev acc)))
    ((Cons rn r)
     (match (env_find env rn)
       ((Some (RecInfo (ConstantVal _ lps ty) all np nidx nmot nmin rules k unsafe))
        (match (sw_name s rn)
          ((Pair s1 ni)
           (match (sw_names s1 lps Nil)
             ((Pair s2 lis)
              (match (sw_names s2 all Nil)
                ((Pair s3 ais)
                 (match (sw_expr s3 ty)
                   ((Pair s4 ti)
                    (match (sw_rules s4 rules Nil)
                      ((Pair s5 rjs)
                       (sw_recs env s5 r
                         (Cons (sw_obj (list (sw_f "all" (sw_ints ais)) (sw_f "isUnsafe" (sw_bool unsafe)) (sw_f "k" (sw_bool k)) (sw_f "levelParams" (sw_ints lis))
                                             (sw_f "name" (show_nat ni)) (sw_f "numIndices" (show_nat nidx)) (sw_f "numMinors" (show_nat nmin))
                                             (sw_f "numMotives" (show_nat nmot)) (sw_f "numParams" (show_nat np)) (sw_f "rules" (sw_arr rjs))
                                             (sw_f "type" (show_nat ti))))
                               acc)))))))))))))
       (_ (sw_recs env s r acc))))))
(fn sw_rules ((s SW) (rules (List RecursorRule)) (acc (List (List Int)))) (Pair SW (List (List Int)))
  (measure (struct rules))
  (match rules
    (Nil (Pair s (rev acc)))
    ((Cons (RecursorRule cn nf rhs) r)
     (match (sw_name s cn)
       ((Pair s1 ci)
        (match (sw_expr s1 rhs)
          ((Pair s2 ri)
           (sw_rules s2 r (Cons (sw_obj (list (sw_f "ctor" (show_nat ci)) (sw_f "nfields" (show_nat nf)) (sw_f "rhs" (show_nat ri)))) acc)))))))))

;; the file's bytes: one record per line
(fn store_bytes ((lines (List (List Int)))) (List Int)
  (measure (struct lines))
  (match lines (Nil Nil) ((Cons x r) (append x (Cons 10 (store_bytes r))))))

;; ---- the store on disk ------------------------------------------------------------------------
;; DIR/order: one line per declaration, `ID NAME`, in admission order; DIR/ID.ndjson the
;; declaration's records. ID is the content fingerprint (identity_hash — a report's
;; fingerprint, never an authority: add.shard) or, when a file of that name holds another
;; text, FP-K for the first free K. A file already holding the text is shared and listed
;; once; order is appended, never rewritten, so several loads fill one store in sequence
;; (a shared module's declarations come from the first load that admitted them).
(type StoreSt (StoreSt (List (List Int)) (List (List Int)) Int Int))   ; ids listed, new order lines (newest first), new, shared
(type StoreRes (StoreOk Int Int) (StoreFail (List Int)))                 ; new shared; the path that could not be written

(fn store_write ((env CheckedEnv) (dir (List Int)) (ns (List Name)) (w World)) (Pair StoreRes World)
  (match (read_file (store_path dir "order") w)
    ((Pair old w1)
     (let ((olds (match old ((Some bs) bs) (None Nil))))
       (match (store_decls env dir ns (StoreSt (order_ids olds Nil) Nil 0 0) w1)
         ((Pair (Some (StoreSt _ lines new shared)) w2)
          (if (int_eq new 0) (Pair (StoreOk new shared) w2)
            (match (write_file (store_path dir "order") (append olds (store_bytes (rev lines))) w2)
              ((Pair True w3) (Pair (StoreOk new shared) w3))
              ((Pair False w3) (Pair (StoreFail (store_path dir "order")) w3)))))
         ((Pair None w2) (Pair (StoreFail dir) w2)))))))
(fn store_path ((dir (List Int)) (file (List Int))) (List Int) (append dir (Cons 47 file)))
;; the ids of an order file: each line's first token
(fn order_ids ((bs (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (Nil (rev acc))
    (_ (match (take_line bs Nil)
         ((Pair ln rest) (order_ids rest (match (first_token ln) (Nil acc) (t (Cons t acc)))))))))
(fn first_token ((ln (List Int))) (List Int)
  (measure (struct ln))
  (match ln (Nil Nil) ((Cons 32 _) Nil) ((Cons c r) (Cons c (first_token r)))))

(fn store_decls ((env CheckedEnv) (dir (List Int)) (ns (List Name)) (st StoreSt) (w World)) (Pair (Option StoreSt) World)
  (measure (struct ns))
  (match ns
    (Nil (Pair (Some st) w))
    ((Cons n r)
     (match (store_records env n)
       (None (store_decls env dir r st w))
       ((Some lines)
        (match (store_place dir (show_nat (match (identity_hash env n) ((Some h) h) (None 0))) 0 n (store_bytes lines) st 100 w)
          ((Pair (Some st1) w1) (store_decls env dir r st1 w1))
          ((Pair None w1) (Pair None w1))))))))
;; the file for one declaration: FP, else FP-K
(fn store_place ((dir (List Int)) (fp (List Int)) (k Int) (n Name) (bytes (List Int)) (st StoreSt) (fuel Int) (w World)) (Pair (Option StoreSt) World)
  (measure fuel)
  (if (lt fuel 1) (Pair None w)
    (let ((id (if (int_eq k 0) fp (append fp (Cons 45 (show_nat k))))))
      (let ((path (store_path dir (append id ".ndjson"))))
        (match (read_file path w)
          ((Pair None w1)
           (match (write_file path bytes w1)
             ((Pair True w2) (Pair (Some (store_listed st id n True)) w2))
             ((Pair False w2) (Pair None w2))))
          ((Pair (Some have) w1)
           (if (int_list_eq have bytes)
             (Pair (Some (store_listed st id n False)) w1)
             (store_place dir fp (+ k 1) n bytes st (- fuel 1) w1))))))))
(fn store_listed ((st StoreSt) (id (List Int)) (n Name) (new Bool)) StoreSt
  (match st
    ((StoreSt ids lines nw sh)
     (if (mem_bytes id ids)
       (StoreSt ids lines nw (+ sh 1))
       (StoreSt (Cons id ids) (Cons (append id (Cons 32 (show_name n))) lines) (if new (+ nw 1) nw) (if new sh (+ sh 1)))))))
(fn mem_bytes ((x (List Int)) (xs (List (List Int)))) Bool
  (measure (struct xs))
  (match xs (Nil False) ((Cons y r) (if (int_list_eq x y) True (mem_bytes x r)))))
