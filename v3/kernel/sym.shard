;;; v3/kernel/sym.shard — symbols. A `Symbol` is the bytes of its text: an ordinary type with
;;; ordinary operations, which no reader knows by name and no engine stores in a form of its
;;; own. `(sym "x")` is the symbol of a literal; two symbols are the same when their bytes are
;;; (`sym_eq`). A `Name` (name.shard) is built of them.

(import "util.shard")
(use kernel.util)

(type Symbol (MkSym (List Int)))  ; the bytes of its text
;; the symbol of a literal
(fn sym ((s String)) Symbol (MkSym (utf8 s)))
(fn chars_of_sym ((s Symbol)) (List Int)
  (match s
    ((MkSym bs) bs)))
(fn sym_of_chars ((bs (List Int))) Symbol (MkSym bs))
(fn sym_eq ((a Symbol) (b Symbol)) Bool (int_list_eq (chars_of_sym a) (chars_of_sym b)))
