    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match_eq.dec_1
  (by
    (intro t cx c ls params s1 dty mbody rows alts extra fuel t0 srt h1 t1 o1 u h2 t2 s0 h3 t3 ret0
      h4 t4 h0 h5 t5 pi h6 t6 psrt h7 t7 o2 l h8 t8 motive1 h9)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match_eq.dec_2
  (by
    (intro t cx c ls params s1 dty mbody rows alts extra fuel t0 srt h1 t1 o1 u h2 t2 s0 h3 t3 ret0
      h4 t4 h0 h5 t5 pi h6 t6 psrt h7 t7 o2 l h8 t8 motive1 h9 t9 alts1 x t10 r h10)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_alts_eq.dec_1
  (by
    (intro t cx s1 dty u rows alts fuel acc row rr h alt ar ha pat hr w1 pterm0 vars0 hm t1 vars
      body pterm ho t2 hv hl)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_alts_eq.dec_2
  (by
    (intro t cx s1 dty u rows alts fuel acc row rr h alt ar ha pat hr w1 pterm0 vars0 hm t1 vars
      body pterm ho t2 hv hl t3 b t4 alt1 hla)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills pj_alts.dec_1
  (by
    (intro t cx gen sid dty rows alts fuel acc row rr h alt ar ha pat hr w1 pterm vars hm t1 body hi
      t2 tlocals ht)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_alts.dec_2
  (by
    (intro t cx gen sid dty rows alts fuel acc row rr h alt ar ha pat hr w1 pterm vars hm t1 body hi
      t2 tlocals ht t3 b t4 alt1 hla)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills pj_member.dec_1
  (by (intro t cx id args fuel) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))

;; a member as the projection holds it: the pre-definition, its data binders, the result
;; type, the measure, its constructor of the group's argument type
(record GrpM (pd PreDef) (data (List Expr)) (rl Expr) (m Expr) (con Name) (ord MOrder))
;; a member defined: its name, its definition, its equations
(type GrpDef (GrpDef Name Declaration (List Declaration)))
;; GrpSkip: no definition for the group — every member its program with the reason; GrpOk: the
;; E table, the obligations, the argument type with the fixpoint and its unfolding theorem, the
;; members in order
(type GrpRes
  (GrpSkip Symbol (List Int))
  (GrpOk ESt (List Declaration) (List Declaration) (List GrpDef)))
(type GrpPrep (GpOk Tr (List GrpM)) (GpSkip Symbol (List Int)))
(fn pd_names ((pds (List PreDef))) (List Name)
  (measure (struct pds))
  (match pds
    (nil nil)
    ((cons pd r) (cons (pd_name pd) (pd_names r)))))
(fn pd_last ((pds (List PreDef))) (Option PreDef)
  (measure (struct pds))
  (match pds
    (nil none)
    ((cons pd nil) (some pd))
    ((cons _ r) (pd_last r))))
(fn grp_callees_in ((cs (List CalleeLocal)) (names (List Name))) Bool
  (measure (struct cs))
  (match cs
    (nil true)
    ((cons (CalleeLocal _ id _) r) (if (mem_name id names) (grp_callees_in r names) false))))
(fn grp_args_name ((k1 Name)) Name (name_append k1 (n1 (sym "args"))))
(fn grp_ctor_name ((k1 Name) (i Int)) Name
  (name_append (grp_args_name k1) (n1 (sym_of_chars (append (utf8 "of_") (show_nat (+ i 1)))))))
;; the K projection of a group
(fn define_group ((es ESt) (sc Scope) (pds (List PreDef))) GrpRes
  (match pds
    (nil (GrpSkip (sym "define_matrix") (utf8 "an empty group")))
    ((cons first _)
     (match (pd_last pds)
       (none (GrpSkip (sym "define_matrix") (utf8 "an empty group")))
       ((some lastpd)
        (let ((t (tr_new (el_w (pd_state lastpd)) es sc (pd_name first) nil)))
          (match (grp_prepare t (pd_name first) pds (pd_names pds) 0 nil)
            ((GpSkip e m) (GrpSkip e m))
            ((GpOk t1 ms) (grp_build t1 (pd_name first) ms)))))))))
;; each member with its data binders, its result type and its measure — or the reason the
;; group is not compiled
(fn grp_prepare ((t Tr) (k1 Name) (pds (List PreDef)) (names (List Name)) (i Int) (acc (List GrpM)))
  GrpPrep
  (measure (struct pds))
  (match pds
    (nil (GpOk t (rev acc)))
    ((cons pd r)
     (if (bool_not (grp_callees_in (pd_callees pd) names))
       (GpSkip (sym "callee_runnable")
         (append (show_name (pd_name pd))
           (utf8
             ": a callee with a program and no K constant outside its group — the group has its programs and no definition")))
       (match (pd_rec pd)
         ((PdMeasure m)
          (match (pj_split_binders (Tr.w t) (pd_binders pd) nil nil)
            ((Prod.mk tps data)
             (if (< 0 (len tps))
               (GpSkip (sym "group_shape")
                 (append (show_name (pd_name pd))
                   (utf8
                     ": a member of a group of functions that call each other has type parameters — not compiled: make the member monomorphic")))
               (match (mt_inst_args (Tr.w t) (pd_type pd) (pd_binders pd))
                 ((Prod.mk _ none)
                  (GpSkip (sym "define_matrix") (utf8 "the declared type does not take the binders")))
                 ((Prod.mk w1 (some rl))
                  (if (mentions_any rl (pd_fvar_ids data))
                    (GpSkip (sym "group_shape")
                      (append (show_name (pd_name pd))
                        (utf8
                          ": a member of a group of functions that call each other has a result type over its parameters — not compiled: give the member a result type that does not mention them")))
                    (match (measure_order (tr_set_w t w1) m)
                      ((Prod.mk _ none) (GpSkip (sym "measure_type") (measure_type_msg)))
                      ((Prod.mk t1 (some ord))
                       (if (bool_not (grp_same_order acc ord))
                         (GpSkip (sym "measure_type")
                           (append (show_name (pd_name pd))
                             (utf8
                               ": the members of a group of functions that call each other state measures of as many parts each")))
                         (grp_prepare t1 k1 r names (+ i 1)
                           (cons
                             (make GrpM (pd pd) (data data) (rl rl) (m m) (con (grp_ctor_name k1 i))
                               (ord ord))
                             acc))))))))))))
         (_
           (GpSkip (sym "group_measure")
             (append (show_name (pd_name pd))
               (utf8
                 ": a member of a group of functions that call each other needs (measure N) with N a Nat over its parameters — a structural clause is not read as a size")))))))))
;; the members' measures are compared with each other: one order for the group
(fn grp_same_order ((acc (List GrpM)) (ord MOrder)) Bool
  (match acc
    (nil true)
    ((cons g _) (expr_eq (mo_type (GrpM.ord g)) (mo_type ord)))))
(fn grp_order ((ms (List GrpM))) MOrder
  (match ms
    (nil (nat_order))
    ((cons g _) (GrpM.ord g))))
;; the group's argument type: `f_1.args : Type`, a constructor per member over its data binders
(fn grp_ctors ((t Tr) (ms (List GrpM)) (argc Expr) (acc (List Constructor)))
  (Prod Tr (List Constructor))
  (measure (struct ms))
  (match ms
    (nil (Prod.mk t (rev acc)))
    ((cons g r)
     (match (tr_pis t (GrpM.data g) argc)
       ((Prod.mk t1 cty) (grp_ctors t1 r argc (cons (Constructor (GrpM.con g) cty) acc)))))))
;; a function on the argument type by its constructors: `f_1.args.rec motive minor_1 … minor_n`
(fn grp_rec ((t Tr) (k1 Name) (lv Level) (motive Expr) (minors (List Expr))) (Prod Tr Expr)
  (tr_apps t (mk_const (name_append (grp_args_name k1) (n1 (sym "rec"))) (list lv))
    (cons motive minors)))
;; the minors of the result type, `λ data_i. R_i`, and of the measure, `λ data_i. m_i`
(fn grp_result_minors ((t Tr) (ms (List GrpM)) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct ms))
  (match ms
    (nil (Prod.mk t (rev acc)))
    ((cons g r)
     (match (tr_lams t (GrpM.data g) (GrpM.rl g))
       ((Prod.mk t1 b) (grp_result_minors t1 r (cons b acc)))))))
(fn grp_measure_minors ((t Tr) (ms (List GrpM)) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct ms))
  (match ms
    (nil (Prod.mk t (rev acc)))
    ((cons g r)
     (match (tr_lams t (GrpM.data g) (GrpM.m g))
       ((Prod.mk t1 b) (grp_measure_minors t1 r (cons b acc)))))))
;; the members as one member's body calls them: itself by its self-local, the others by the
;; callee-locals its pre-definition bound
(fn grp_member ((ms (List GrpM)) (k Name)) (Option GrpM)
  (measure (struct ms))
  (match ms
    (nil none)
    ((cons g r) (if (name_eq (pd_name (GrpM.pd g)) k) (some g) (grp_member r k)))))
(fn grp_callees ((ms (List GrpM)) (cls (List CalleeLocal))) (List PjCallee)
  (measure (struct cls))
  (match cls
    (nil nil)
    ((cons (CalleeLocal fv id _) r)
     (match (grp_member ms id)
       ((some g)
        (cons (PjCallee (fvar_id_of fv) (GrpM.con g) (GrpM.m g) (GrpM.data g)) (grp_callees ms r)))
       (none (grp_callees ms r))))))
(fn grp_callee_ids ((cls (List CalleeLocal))) (List Int)
  (measure (struct cls))
  (match cls
    (nil nil)
    ((cons (CalleeLocal fv _ _) r) (cons (fvar_id_of fv) (grp_callee_ids r)))))
(fn grp_scope ((fvs (List Expr))) (List (Prod Bool Expr))
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r) (cons (Prod.mk false fv) (grp_scope r)))))
;; ∀ (q : A), rel q x → C q — the recursion hypothesis at a value x of the argument type
(fn grp_rec_type ((t Tr) (argc Expr) (rel Expr) (x Expr) (cfn Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "q")) argc)
    ((Prod.mk t1 q)
     (match (tr_apps t1 rel (list q x))
       ((Prod.mk t2 hty)
        (match (tr_local t2 (n1 (sym "h")) hty)
          ((Prod.mk t3 h)
           (match (tr_apps t3 cfn (list q))
             ((Prod.mk t4 cq) (tr_pis t4 (list q h) cq))))))))))
;; the minors of the functional, in order: `λ data_i (rec : ∀ y, rel y (c_i data_i) → C y).
;; body_i'`, the obligations of member i named under it
(fn grp_minors
  ((t Tr) (all (List GrpM)) (ms (List GrpM)) (argc Expr) (rel Expr) (cfn Expr) (acc (List Expr)))
  (Prod Tr Either2)
  (measure (struct ms))
  (match ms
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) argc))))
    ((cons g r)
     (let ((pd (GrpM.pd g)) (data (GrpM.data g)) (selfid (fvar_id_of (pd_self (GrpM.pd g)))))
       (match (tr_apps t (mk_const (GrpM.con g) nil) data)
         ((Prod.mk t1 here)
          (match (grp_rec_type t1 argc rel here cfn)
            ((Prod.mk t2 recty)
             (match (tr_local t2 (n1 (sym "rec")) recty)
               ((Prod.mk t3 recl)
                (let
                  ((cx
                     (make PjCx (self selfid) (tps nil)
                       (kind
                         (PkGrp recl (GrpM.m g) data
                           (cons (PjCallee selfid (GrpM.con g) (GrpM.m g) data)
                             (grp_callees all (pd_callees pd)))))
                       (tables nil)
                       (scope (grp_scope data))
                       (members (grp_callee_ids (pd_callees pd)))
                       (beyond nil))))
                  (match (pj_term (tr_set_id t3 (pd_name pd)) cx (pd_body pd) (budget_depth))
                    ((TrErr e m) (Prod.mk t3 (Left2 e m)))
                    ((TrOk t4 b)
                     (match (tr_lams t4 (append data (list recl)) b)
                       ((Prod.mk t5 minor) (grp_minors t5 all r argc rel cfn (cons minor acc)))))))))))))))))
;; the argument type checked into the walk's environment; the result type and the measure by
;; constructor, the relation, the functional; then the fixpoint, its unfolding theorem and the
;; members, each checked into the walk's environment so the equations are stated where K
;; decides them (define_pd_go's order)
(fn grp_build ((t Tr) (k1 Name) (ms (List GrpM))) GrpRes
  (let ((aname (grp_args_name k1)) (argc (mk_const (grp_args_name k1) nil)))
    (match (grp_ctors t ms argc nil)
      ((Prod.mk t1 ctors)
       (let
         ((adecl (InductDecl nil 0 (list (InductiveType aname (mk_sort (level_one)) ctors)) false)))
         (match (w_admit (Tr.w t1) adecl)
           ((Prod.mk _ (some why))
            (GrpSkip (sym "definition_refused")
              (append (show_name aname)
                (append (utf8 ": K refused the group's argument type (")
                  (append (chars_of_sym why) (utf8 ")"))))))
           ((Prod.mk w2 none)
            (let ((t2 (tr_set_w t1 w2)))
              (match (tr_local t2 (n1 (sym "x")) argc)
                ((Prod.mk t3 x0)
                 (match (tr_lams t3 (list x0) (mk_sort (level_one)))
                   ((Prod.mk t4 cmotive)
                    (match (grp_result_minors t4 ms nil)
                      ((Prod.mk t5 cmins)
                       (match (grp_rec t5 k1 (LSucc (level_one)) cmotive cmins)
                         ((Prod.mk t6 cfn)
                          (match (tr_lams t6 (list x0) (mo_type (grp_order ms)))
                            ((Prod.mk t7 mmotive)
                             (match (grp_measure_minors t7 ms nil)
                               ((Prod.mk t8 mmins)
                                (match (grp_rec t8 k1 (level_one) mmotive mmins)
                                  ((Prod.mk t9 mfn)
                                   (match (wf_relation t9 argc mfn (grp_order ms))
                                     ((Prod.mk t10 (Prod.mk rel hwf))
                                      (match (grp_minors t10 ms ms argc rel cfn nil)
                                        ((Prod.mk _ (Left2 e m)) (GrpSkip e m))
                                        ((Prod.mk t11 (Right2 (Prod.mk fmins _)))
                                         (match (grp_rec_type t11 argc rel x0 cfn)
                                           ((Prod.mk t12 recty)
                                            (match (tr_local t12 (n1 (sym "rec")) recty)
                                              ((Prod.mk t13 rv)
                                               (match (tr_apps t13 cfn (list x0))
                                                 ((Prod.mk t14 ret)
                                                  (match (tr_pis t14 (list rv) ret)
                                                    ((Prod.mk t15 pi)
                                                     (match (tr_lams t15 (list x0) pi)
                                                       ((Prod.mk t16 fmotive)
                                                        (match
                                                          (grp_rec t16 k1 (level_one) fmotive fmins)
                                                          ((Prod.mk t17 fnl)
                                                           (grp_fix t17 k1 ms argc cfn rel hwf fnl
                                                             adecl)))))))))))))))))))))))))))))))))))))))
;; `f_1.mutual : (x : A) → C x := λ x. WellFounded.fix A C rel hwf F x` and
;; `f_1.mutual.eq : ∀ x, f_1.mutual x = F x (λ y _. f_1.mutual y) := λ x. WellFounded.fix_eq …`
(fn grp_fix
  ((t Tr)
   (k1 Name)
   (ms (List GrpM))
   (argc Expr)
   (cfn Expr)
   (rel Expr)
   (hwf Expr)
   (fnl Expr)
   (adecl Declaration))
  GrpRes
  (let
    ((mname (name_append k1 (n1 (sym "mutual"))))
     (ename (name_append (name_append k1 (n1 (sym "mutual"))) (n1 (sym "eq")))))
    (match (tr_local t (n1 (sym "x")) argc)
      ((Prod.mk t1 x)
       (match
         (tr_apps t1 (mk_const (n2 (sym "WellFounded") (sym "fix")) (list (level_one) (level_one)))
           (list argc cfn rel hwf fnl x))
         ((Prod.mk t2 fixed)
          (match (tr_lams t2 (list x) fixed)
            ((Prod.mk t3 mval)
             (match (tr_apps t3 cfn (list x))
               ((Prod.mk t4 cx)
                (match (tr_pis t4 (list x) cx)
                  ((Prod.mk t5 mty)
                   (let
                     ((mdecl
                        (DefnDecl (ConstantVal mname nil mty) mval
                          (HRegular (def_height (tr_env t5) mval))
                          Safe
                          (list mname))))
                     (match (w_admit_after (Tr.w t5) (tr_obls t5) mdecl)
                       ((Prod.mk _ (some why))
                        (GrpSkip (sym "definition_refused")
                          (append (show_name mname)
                            (append (utf8 ": K refused the group's fixpoint (")
                              (append (chars_of_sym why) (utf8 ")"))))))
                       ((Prod.mk w6 none)
                        (let ((t6 (tr_set_w t5 w6)) (mc (mk_const mname nil)))
                          (match (tr_local t6 (n1 (sym "y")) argc)
                            ((Prod.mk t7 y)
                             (match (tr_apps t7 rel (list y x))
                               ((Prod.mk t8 hty)
                                (match (tr_local t8 (n1 (sym "h")) hty)
                                  ((Prod.mk t9 h)
                                   (match (tr_lams t9 (list y h) (mk_app mc y))
                                     ((Prod.mk t10 again)
                                      (match (tr_apps t10 fnl (list x again))
                                        ((Prod.mk t11 rhs)
                                         (match
                                           (tr_apps t11 (mk_const (nm_eq) (list (level_one)))
                                             (list cx (mk_app mc x) rhs))
                                           ((Prod.mk t12 stmt)
                                            (match (tr_pis t12 (list x) stmt)
                                              ((Prod.mk t13 ety)
                                               (match
                                                 (tr_apps t13
                                                   (mk_const (n2 (sym "WellFounded") (sym "fix_eq"))
                                                     (list (level_one) (level_one)))
                                                   (list argc cfn rel hwf fnl x))
                                                 ((Prod.mk t14 prf)
                                                  (match (tr_lams t14 (list x) prf)
                                                    ((Prod.mk t15 evalue)
                                                     (let
                                                       ((edecl
                                                          (ThmDecl (ConstantVal ename nil ety)
                                                            evalue
                                                            (list ename))))
                                                       (match (w_admit (Tr.w t15) edecl)
                                                         ((Prod.mk _ (some why))
                                                          (GrpSkip (sym "definition_refused")
                                                            (append (show_name ename)
                                                              (append
                                                                (utf8
                                                                  ": K refused the fixpoint's unfolding (")
                                                                (append (chars_of_sym why)
                                                                  (utf8 ")"))))))
                                                         ((Prod.mk w16 none)
                                                          (grp_members (tr_set_w t15 w16) mc ms ms
                                                            (list adecl mdecl edecl)
                                                            nil
                                                            nil))))))))))))))))))))))))))))))))))))))
;; each member `λ binders. f_1.mutual (c_i data)`, admitted in order; then the equations
(fn grp_members
  ((t Tr)
   (mc Expr)
   (all (List GrpM))
   (ms (List GrpM))
   (core (List Declaration))
   (dds (List Declaration))
   (vals (List Expr)))
  GrpRes
  (measure (struct ms))
  (match ms
    (nil (grp_equations t all (rev dds) (rev vals) core nil))
    ((cons g r)
     (let ((pd (GrpM.pd g)))
       (match (tr_apps t (mk_const (GrpM.con g) nil) (GrpM.data g))
         ((Prod.mk t1 tagged)
          (match (tr_lams t1 (pd_binders pd) (mk_app mc tagged))
            ((Prod.mk t2 v)
             (let
               ((dd
                  (DefnDecl (ConstantVal (pd_name pd) nil (pd_type pd)) v
                    (HRegular (def_height (tr_env t2) v))
                    Safe
                    (list (pd_name pd)))))
               (match (w_admit (Tr.w t2) dd)
                 ((Prod.mk _ (some why))
                  (GrpSkip (sym "definition_refused")
                    (append (show_name (pd_name pd))
                      (append (utf8 ": K refused the definition (")
                        (append (chars_of_sym why) (utf8 ")"))))))
                 ((Prod.mk w3 none)
                  (grp_members (tr_set_w t2 w3) mc all r core (cons dd dds) (cons v vals)))))))))))))
;; a member's equations: the body under PkEqn, a matcher carrying its equation
;; as the value has it, the members' locals their constants; each leaf's proof the fixpoint's
;; unfolding at the member's constructor (realize.shard fix_eq_proof)
(fn grp_equations
  ((t Tr)
   (ms (List GrpM))
   (dds (List Declaration))
   (vals (List Expr))
   (core (List Declaration))
   (acc (List GrpDef)))
  GrpRes
  (measure (struct ms))
  (match ms
    (nil (GrpOk (Tr.es t) (tr_obls t) core (rev acc)))
    ((cons g r)
     (match dds
       ((cons dd dr)
        (match vals
          ((cons v vr)
           (let ((pd (GrpM.pd g)) (selfid (fvar_id_of (pd_self (GrpM.pd g)))))
             (match
               (pj_term (tr_set_id t (pd_name pd))
                 (make PjCx (self selfid) (tps nil) (kind (PkEqn)) (tables nil) (scope nil)
                   (members (grp_callee_ids (pd_callees pd)))
                   (beyond nil))
                 (pd_body pd)
                 (budget_depth))
               ((TrErr e m) (GrpSkip e m))
               ((TrOk t1 eqbody)
                (match (grp_subst_members t1 eqbody (pd_callees pd))
                  ((Prod.mk t2 eqbody1)
                   (match
                     (pj_equations t2 (mk_const (pd_name pd) nil) selfid (pd_binders pd) (GrpM.rl g)
                       eqbody1
                       nil
                       true
                       (some v))
                     ((Prod.mk _ (Left3 e m)) (GrpSkip e m))
                     ((Prod.mk t3 (Right3 eqs))
                      (grp_equations t3 r dr vr core (cons (GrpDef (pd_name pd) dd eqs) acc))))))))))
          (nil (GrpSkip (sym "define_matrix") (utf8 "a member without its value")))))
       (nil (GrpSkip (sym "define_matrix") (utf8 "a member without its definition")))))))
;; a body's callee-locals replaced by the members' constants
(fn grp_subst_members ((t Tr) (e Expr) (cls (List CalleeLocal))) (Prod Tr Expr)
  (measure (struct cls))
  (match cls
    (nil (Prod.mk t e))
    ((cons (CalleeLocal fv id _) r)
     (match (tr_subst t e (fvar_id_of fv) (mk_const id nil))
       ((Prod.mk t1 e1) (grp_subst_members t1 e1 r))))))

;; ---- below and brecOn ---------------------------------------------------------------------------
;; Init's under Lean's names at solved levels; a native inductive's generated once, monomorphic,
;; and admitted before the definition (DfAux) — its table is built of Init's PProd and PUnit.
;; An inductive of Init whose below the environment lacks is refused by a message that names
;; the constant: where the export declares it the loader fetches it and reads the function
;; again; where it does not — Lean generates below and brecOn for a recursive type only —
;; the refusal stands
(fn ensure_below ((t Tr) (ind Name) (ls (List Level))) TrAux
  (match (env_find (tr_env t) (name_append ind (n1 (sym "below"))))
    ((some _) (AuxOk t nil))
    (none
      (if (bool_not (native_decl (Tr.sc t) ind)) (AuxErr t (sym "equation_form") (no_below ind))
      (gen_below t ind ls)))))
(fn no_below ((ind Name)) (List Int)
  (append (show_name (name_append ind (n1 (sym "below"))))
    (append (utf8 " and ")
      (append (show_name (name_append ind (n1 (sym "brecOn"))))
        (append (utf8 " are not both in the environment: structural recursion over ")
          (append (show_name ind)
            (utf8
              " is built on them, and Lean generates them for a recursive type only — write a Nat measure, (measure M), where the type has none")))))))
;; the below and brecOn constants with their levels: Init's solved (the motive's universe 1, the
;; type's 0), a generated one at none
(fn below_names ((t Tr) (ind Name)) (Prod Tr (Option (Prod (Prod Name Name) (List Level))))
  (let ((belowc (name_append ind (n1 (sym "below")))) (brecc (name_append ind (n1 (sym "brecOn")))))
    (match (env_find (tr_env t) belowc)
      (none (Prod.mk t none))
      ((some binfo)
       (match (env_find (tr_env t) brecc)
         (none (Prod.mk t none))
         ((some _)
          (match (solve_aux_levels binfo)
            (none (Prod.mk t none))
            ((some lsb) (Prod.mk t (some (Prod.mk (Prod.mk belowc brecc) lsb)))))))))))
;; a constant's level parameters solved so that a `Sort (succ u)` binder is Type (u := 0) and a
;; binder whose codomain is `Sort p` — the motive — lands in Type (p := 1); None if one stays open
(fn solve_aux_levels ((info ConstantInfo)) (Option (List Level))
  (match (aux_sol (ci_type info) nil)
    (none none)
    ((some sol) (levels_all (ci_lparams info) sol))))
(fn aux_sol ((ty Expr) (sol (List (Prod Name Level)))) (Option (List (Prod Name Level)))
  (measure (struct ty))
  (match ty
    ((Pi _ _ _ dom body)
     (match (aux_dom dom sol)
       (none none)
       ((some sol1) (aux_sol body sol1))))
    (_ (some sol))))
(fn aux_dom ((dom Expr) (sol (List (Prod Name Level)))) (Option (List (Prod Name Level)))
  (match dom
    ((Sort _ (LSucc (LParam u))) (bind_level u LZero sol))
    ((Pi _ _ _ _ body)
     (match (pi_codomain body)
       ((Sort _ (LParam p)) (bind_level p (LSucc LZero) sol))
       (_ (some sol))))
    (_ (some sol))))
(fn pi_codomain ((e Expr)) Expr
  (measure (struct e))
  (match e
    ((Pi _ _ _ _ b) (pi_codomain b))
    (_ e)))
(fn levels_all ((ps (List Name)) (sol (List (Prod Name Level)))) (Option (List Level))
  (measure (struct ps))
  (match ps
    (nil (some nil))
    ((cons p r)
     (match (assoc_level p sol)
       (none none)
       ((some l)
        (match (levels_all r sol)
          (none none)
          ((some ls) (some (cons l ls)))))))))

;; T.below (ps) (motive : T ps → Type) (t : T ps) : Type := T.rec (λ _ . Type) minors t, each
;; minor `λ fields ihs . PProd (PProd (motive r_1) ih_1) (… PUnit)` over the recursive fields;
;; T.brecOn (ps) motive (t) (F : ∀ t', T.below ps motive t' → motive t') : motive t :=
;; (T.rec (λ t' . PProd (motive t') (T.below ps motive t')) minors t).1, each minor
;; `λ fields ihs . ⟨F (c fields) TAB, TAB⟩` with TAB the pair nest of the ihs — Lean's own shapes
(fn gen_below ((t Tr) (ind Name) (ls (List Level))) TrAux
  (match (env_find (tr_env t) ind)
    (none (AuxErr t (sym "unknown_constant") (show_name ind)))
    ((some info)
     (match info
       ((InductInfo _ nparams _ _ ctors _ _ _ _)
        (match (w_inst_lparams (Tr.w t) (ci_type info) (ci_lparams info) ls)
          ((Prod.mk w1 ity)
           (match (open_params (tr_set_w t w1) ity nparams nil)
             ((Prod.mk t1 none)
              (AuxErr t1 (sym "equation_form")
                (append (show_name ind) (utf8 ": its parameters could not be opened"))))
             ((Prod.mk t1 (some ps))
              (match (tr_apps t1 (mk_const ind ls) ps)
                ((Prod.mk t2 tyapp)
                 (match (gen_below_decl t2 ind ls ps tyapp ctors)
                   ((AuxErr t3 e m) (AuxErr t3 e m))
                   ((AuxOk t3 bds)
                    (match (gen_brecon_decl t3 ind ls ps tyapp ctors)
                      ((AuxErr t4 e m) (AuxErr t4 e m))
                      ((AuxOk t4 rds) (AuxOk t4 (append bds rds)))))))))))))
       (_ (AuxErr t (sym "unknown_constant") (append (show_name ind) (utf8 " is not an inductive"))))))))
;; the inductive's parameters as locals, its type's leading binders
(fn open_params ((t Tr) (ty Expr) (n Int) (acc (List Expr))) (Prod Tr (Option (List Expr)))
  (measure (Int.natAbs n))
  (if (< n 1) (Prod.mk t (some (rev acc)))
  (match ty
    ((Pi _ nm _ dom body)
     (match (tr_local t nm dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1) (open_params t2 body1 (- n 1) (cons fv acc)))))))
    (_ (Prod.mk t none)))))
(fulfills open_params.dec_1
  (by (intro p h w1 nm w2 dom body hm t1 fv h1 t2 body1 h2) (apply natAbs_pred (arith))))
(fn gen_below_decl
  ((t Tr) (ind Name) (ls (List Level)) (ps (List Expr)) (tyapp Expr) (ctors (List Name)))
  TrAux
  (match (tr_local t (n1 (sym "x")) tyapp)
    ((Prod.mk t1 xm)
     (match (tr_pis t1 (list xm) (mk_sort (level_one)))
       ((Prod.mk t2 mty)
        (match (tr_local t2 (n1 (sym "motive")) mty)
          ((Prod.mk t3 motive)
           (match (tr_local t3 (n1 (sym "t")) tyapp)
             ((Prod.mk t4 tv)
              (match (below_minors t4 motive ls ps ctors nil)
                ((Prod.mk t5 (Left2 e m)) (AuxErr t5 e m))
                ((Prod.mk t5 (Right2 (Prod.mk minors _)))
                 (match (tr_local t5 (n1 (sym "x")) tyapp)
                   ((Prod.mk t6 xm2)
                    (match (tr_lams t6 (list xm2) (mk_sort (level_one)))
                      ((Prod.mk t7 rmotive)
                       (match (rec_app_dep t7 (LSucc (LSucc LZero)) ind ls ps rmotive minors tv)
                         ((TrErr e m) (AuxErr t7 e m))
                         ((TrOk t8 value0)
                          (match (tr_lams t8 (append ps (list motive tv)) value0)
                            ((Prod.mk t9 value)
                             (match (tr_pis t9 (append ps (list motive tv)) (mk_sort (level_one)))
                               ((Prod.mk t10 ty)
                                (let ((n (name_append ind (n1 (sym "below")))))
                                  (AuxOk t10
                                    (list
                                      (DefnDecl (ConstantVal n nil ty) value (HRegular 1) Safe
                                        (list n))))))))))))))))))))))))))
;; below's minors: for each constructor, the pair nest over its recursive fields (the ihs Type)
(fn below_minors
  ((t Tr) (motive Expr) (ls (List Level)) (ps (List Expr)) (ctors (List Name)) (acc (List Expr)))
  (Prod Tr Either2)
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) motive))))
    ((cons c r)
     (match (rz_open_ctor t c ls ps)
       ((Prod.mk t1 none)
        (Prod.mk t1
          (Left2 (sym "equation_form")
            (append (show_name c) (utf8 ": K could not open the constructor")))))
       ((Prod.mk t1 (some (Prod.mk fields _)))
        (match (open_ihs t1 fields (mk_sort (level_one)) nil)
          ((Prod.mk t2 ihs)
           (match (below_nest t2 motive (recursive_fields fields) ihs)
             ((Prod.mk t3 body)
              (match (tr_lams t3 (append (field_fvars fields) ihs) body)
                ((Prod.mk t4 minor) (below_minors t4 motive ls ps r (cons minor acc)))))))))))))
(fn recursive_fields ((fields (List Field))) (List Expr)
  (measure (struct fields))
  (match fields
    (nil nil)
    ((cons (Field fv _ true) r) (cons fv (recursive_fields r)))
    ((cons _ r) (recursive_fields r))))
;; PProd (motive r_1) ih_1 alone, PProd (PProd (motive r_1) ih_1) (…) for more, PUnit for none
(fn below_nest ((t Tr) (motive Expr) (rs (List Expr)) (ihs (List Expr))) (Prod Tr Expr)
  (measure (struct rs))
  (match rs
    (nil (Prod.mk t (punit_ty)))
    ((cons r rr)
     (match ihs
       (nil (Prod.mk t (punit_ty)))
       ((cons ih ir)
        (match (tr_apps t motive (list r))
          ((Prod.mk t1 mr)
           (match (tr_apps t1 (pprod_ty) (list mr ih))
             ((Prod.mk t2 pair)
              (match rr
                (nil (Prod.mk t2 pair))
                (_
                  (match (below_nest t2 motive rr ir)
                    ((Prod.mk t3 rest)
                     (match (tr_apps t3 (pprod_ty) (list pair rest))
                       ((Prod.mk t4 e) (Prod.mk t4 e))))))))))))))))
(fn pprod_ty () Expr (mk_const (n1 (sym "PProd")) (list (level_one) (level_one))))
(fn pprod_mk () Expr (mk_const (n2 (sym "PProd") (sym "mk")) (list (level_one) (level_one))))
(fn punit_ty () Expr (mk_const (n1 (sym "PUnit")) (list (level_one))))
(fn punit_unit () Expr (mk_const (n2 (sym "PUnit") (sym "unit")) (list (level_one))))
(fn gen_brecon_decl
  ((t Tr) (ind Name) (ls (List Level)) (ps (List Expr)) (tyapp Expr) (ctors (List Name)))
  TrAux
  (let ((belowc (name_append ind (n1 (sym "below")))))
    (match (tr_local t (n1 (sym "x")) tyapp)
      ((Prod.mk t1 xm)
       (match (tr_pis t1 (list xm) (mk_sort (level_one)))
         ((Prod.mk t2 mty)
          (match (tr_local t2 (n1 (sym "motive")) mty)
            ((Prod.mk t3 motive)
             (match (tr_local t3 (n1 (sym "t")) tyapp)
               ((Prod.mk t4 tv)
                (match (functional_type t4 belowc ps motive tyapp)
                  ((Prod.mk t5 fty)
                   (match (tr_local t5 (n1 (sym "F")) fty)
                     ((Prod.mk t6 fl)
                      (match (brec_motive t6 belowc ps motive tyapp)
                        ((Prod.mk t7 rmotive)
                         (match (brecon_minors t7 belowc ps motive fl ls ctors nil)
                           ((Prod.mk t8 (Left2 e m)) (AuxErr t8 e m))
                           ((Prod.mk t8 (Right2 (Prod.mk minors _)))
                            (match (rec_app_dep t8 (level_one) ind ls ps rmotive minors tv)
                              ((TrErr e m) (AuxErr t8 e m))
                              ((TrOk t9 recv)
                               (match
                                 (tr_lams t9 (append ps (list motive tv fl))
                                   (mk_proj (n1 (sym "PProd")) 0 recv))
                                 ((Prod.mk t10 value)
                                  (match (tr_apps t10 motive (list tv))
                                    ((Prod.mk t11 mt)
                                     (match (tr_pis t11 (append ps (list motive tv fl)) mt)
                                       ((Prod.mk t12 ty)
                                        (let ((n (name_append ind (n1 (sym "brecOn")))))
                                          (AuxOk t12
                                            (list
                                              (DefnDecl (ConstantVal n nil ty) value (HRegular 2)
                                                Safe
                                                (list n)))))))))))))))))))))))))))))))
;; ∀ (t' : T ps), T.below ps motive t' → motive t'
(fn functional_type ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (tyapp Expr))
  (Prod Tr Expr)
  (match (tr_local t (n1 (sym "t")) tyapp)
    ((Prod.mk t1 tp)
     (match (tr_apps t1 (mk_const belowc nil) (append ps (list motive tp)))
       ((Prod.mk t2 bty)
        (match (tr_local t2 (n1 (sym "b")) bty)
          ((Prod.mk t3 bl)
           (match (tr_apps t3 motive (list tp))
             ((Prod.mk t4 mt)
              (match (tr_pis t4 (list tp bl) mt)
                ((Prod.mk t5 e) (Prod.mk t5 e))))))))))))
;; λ t' . PProd (motive t') (T.below ps motive t')
(fn brec_motive ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (tyapp Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "t")) tyapp)
    ((Prod.mk t1 tp)
     (match (tr_apps t1 motive (list tp))
       ((Prod.mk t2 mt)
        (match (tr_apps t2 (mk_const belowc nil) (append ps (list motive tp)))
          ((Prod.mk t3 bt)
           (match (tr_apps t3 (pprod_ty) (list mt bt))
             ((Prod.mk t4 pr)
              (match (tr_lams t4 (list tp) pr)
                ((Prod.mk t5 e) (Prod.mk t5 e))))))))))))
(fn brecon_minors
  ((t Tr)
   (belowc Name)
   (ps (List Expr))
   (motive Expr)
   (fl Expr)
   (ls (List Level))
   (ctors (List Name))
   (acc (List Expr)))
  (Prod Tr Either2)
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) motive))))
    ((cons c r)
     (match (rz_open_ctor t c ls ps)
       ((Prod.mk t1 none)
        (Prod.mk t1
          (Left2 (sym "equation_form")
            (append (show_name c) (utf8 ": K could not open the constructor")))))
       ((Prod.mk t1 (some (Prod.mk fields cterm)))
        (match (dep_ihs t1 belowc ps motive (recursive_fields fields) nil)
          ((Prod.mk t2 ihs)
           (match (table_nest t2 belowc ps motive (recursive_fields fields) ihs)
             ((Prod.mk t3 (Prod.mk tab tabty))
              (match (tr_apps t3 motive (list cterm))
                ((Prod.mk t4 mc)
                 (match (tr_apps t4 (mk_const belowc nil) (append ps (list motive cterm)))
                   ((Prod.mk t5 bc)
                    (match (tr_apps t5 fl (list cterm tab))
                      ((Prod.mk t6 fc)
                       (match (tr_apps t6 (pprod_mk) (list mc bc fc tab))
                         ((Prod.mk t7 body)
                          (match (tr_lams t7 (append (field_fvars fields) ihs) body)
                            ((Prod.mk t8 minor)
                             (brecon_minors t8 belowc ps motive fl ls r (cons minor acc)))))))))))))))))))))
;; one hypothesis per recursive field at PProd (motive r) (T.below ps motive r)
(fn dep_ihs ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (rs (List Expr)) (acc (List Expr)))
  (Prod Tr (List Expr))
  (measure (struct rs))
  (match rs
    (nil (Prod.mk t (rev acc)))
    ((cons r rr)
     (match (tr_apps t motive (list r))
       ((Prod.mk t1 mr)
        (match (tr_apps t1 (mk_const belowc nil) (append ps (list motive r)))
          ((Prod.mk t2 br)
           (match (tr_apps t2 (pprod_ty) (list mr br))
             ((Prod.mk t3 ty)
              (match (tr_local t3 (n1 (sym "ih")) ty)
                ((Prod.mk t4 ih) (dep_ihs t4 belowc ps motive rr (cons ih acc)))))))))))))
;; TAB = ih_1 alone, PProd.mk ih_1 (…) for more, PUnit.unit for none — with its type
(fn table_nest
  ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (rs (List Expr)) (ihs (List Expr)))
  (Prod Tr (Prod Expr Expr))
  (measure (struct rs))
  (match rs
    (nil (Prod.mk t (Prod.mk (punit_unit) (punit_ty))))
    ((cons r rr)
     (match ihs
       (nil (Prod.mk t (Prod.mk (punit_unit) (punit_ty))))
       ((cons ih ir)
        (match (tr_apps t motive (list r))
          ((Prod.mk t1 mr)
           (match (tr_apps t1 (mk_const belowc nil) (append ps (list motive r)))
             ((Prod.mk t2 br)
              (match (tr_apps t2 (pprod_ty) (list mr br))
                ((Prod.mk t3 ak)
                 (match rr
                   (nil (Prod.mk t3 (Prod.mk ih ak)))
                   (_
                     (match (table_nest t3 belowc ps motive rr ir)
                       ((Prod.mk t4 (Prod.mk rest restty))
                        (match (tr_apps t4 (pprod_mk) (list ak restty ih rest))
                          ((Prod.mk t5 e)
                           (match (tr_apps t5 (pprod_ty) (list ak restty))
                             ((Prod.mk t6 ety) (Prod.mk t6 (Prod.mk e ety)))))))))))))))))))))
;; ---- the constructor-structure bundle -----------------------------------------------------------
;; After a native inductive is admitted: T.casesOn (its recursor with the hypotheses unused,
;; universe polymorphic as Lean's; the recursor of a type of a block — a constructor carrying
;; the type under List or another inductive, types that name each other — with the other
;; types' motives constant PUnit and their minors PUnit.unit, Lean's own shape), and for a type without parameters and indices whose recursor
;; eliminates into every universe, T.noConfusionType, T.noConfusion and T.c.inj per constructor
;; with fields — Lean 4.33's shapes read off the export (Nat's; a parametric type's shape
;; generalizes the parameters twice with HEq on the fields and eq_of_heq, and is not
;; generated). They are built of Init's Eq, Eq.ndrec, Eq.refl, And and And.intro. K
;; checks each declaration; the generator's failure is nothing generated, never a refusal of
;; the type.
(fn confusion_bundle ((es ESt) (sc Scope) (env CheckedEnv) (ind Name)) (List Declaration)
  (match (env_find env ind)
    ((some (InductInfo _ nparams nindices _ ctors _ _ _ _))
     (if (< 0 nindices) nil
     (match (rec_level env ind)
       (none nil)
       ((some u)
        (let ((t (tr_new (w0 env) es sc ind nil)))
          (match (gen_cases_on t ind u nparams ctors)
            ((AuxErr _ _ _) nil)
            ((AuxOk t1 cds)
             (if (< 0 nparams) cds
             (match (gen_nct t1 ind u ctors)
               ((AuxErr _ _ _) cds)
               ((AuxOk t2 nds)
                (match (gen_nc t2 ind u ctors)
                  ((AuxErr _ _ _) (append cds nds))
                  ((AuxOk t3 ncs)
                   (match (gen_injs t3 ind ctors nil)
                     ((AuxErr _ _ _) (append cds (append nds ncs)))
                     ((AuxOk _ ijs) (append cds (append nds (append ncs ijs)))))))))))))))))
    (_ nil)))
;; the recursor's one level parameter (the motive's universe); None for an eliminator into Prop
(fn rec_level ((env CheckedEnv) (ind Name)) (Option Name)
  (match (env_find env (name_append ind (n1 (sym "rec"))))
    ((some info)
     (match (ci_lparams info)
       ((cons u nil) (some u))
       (_ none)))
    (none none)))
(fn nm_cases_on ((ind Name)) Name (name_append ind (n1 (sym "casesOn"))))
(fn nm_nct ((ind Name)) Name (name_append ind (n1 (sym "noConfusionType"))))
(fn nm_nc ((ind Name)) Name (name_append ind (n1 (sym "noConfusion"))))
(fn ctor_short ((c Name)) Name (n1 (sym_of_chars (chars_of_name_last c))))

;; T.casesOn.{u} : ∀ {params} {motive : T params → Sort u} (t : T params) (minors : ∀ fields, motive (c fields))…, motive t
;;   := λ params motive t minors. T.rec.{u} params motive (λ fields ihs. minor_c fields)… t
(fn gen_cases_on ((t Tr) (ind Name) (u Name) (nparams Int) (ctors (List Name))) TrAux
  (match (env_find (tr_env t) ind)
    (none (AuxErr t (sym "unknown_constant") (show_name ind)))
    ((some info)
     (match (open_params_bi t (ci_type info) nparams nil)
       ((Prod.mk t1 none)
        (AuxErr t1 (sym "equation_form") (utf8 "the parameters could not be opened")))
       ((Prod.mk t1 (some ps))
        (match (tr_apps t1 (mk_const ind nil) ps)
          ((Prod.mk t2 tyapp)
           (match (tr_local t2 (n1 (sym "x")) tyapp)
             ((Prod.mk t3 xm)
              (match (tr_pis t3 (list xm) (mk_sort (LParam u)))
                ((Prod.mk t4 mty)
                 (match (tr_local_bi t4 (n1 (sym "motive")) mty BImplicit)
                   ((Prod.mk t5 motive)
                    (match (tr_local t5 (n1 (sym "t")) tyapp)
                      ((Prod.mk t6 tv)
                       (match (cases_minor_locals t6 motive ps ctors nil)
                         ((Prod.mk t7 none)
                          (AuxErr t7 (sym "equation_form")
                            (utf8 "a constructor could not be opened")))
                         ((Prod.mk t7 (some minors))
                          (match
                            (cases_rec_minors t7 motive (LParam u) (block_types (tr_env t7) ind) ps
                              ctors
                              minors
                              nil)
                            ((Prod.mk t8 none)
                             (AuxErr t8 (sym "equation_form")
                               (utf8 "a constructor could not be opened")))
                            ((Prod.mk t8 (some rminors))
                             (match (rec_app_dep t8 (LParam u) ind nil ps motive rminors tv)
                               ((TrErr e m) (AuxErr t8 e m))
                               ((TrOk t9 value0)
                                (let ((binders (append ps (cons motive (cons tv minors)))))
                                  (match (tr_lams t9 binders value0)
                                    ((Prod.mk t10 value)
                                     (match (tr_pis t10 binders (mk_app motive tv))
                                       ((Prod.mk t11 ty)
                                        (let ((n (nm_cases_on ind)))
                                          (AuxOk t11
                                            (list
                                              (DefnDecl (ConstantVal n (list u) ty) value HAbbrev
                                                Safe
                                                (list n)))))))))))))))))))))))))))))))
;; the inductive's parameters as implicit locals
(fn open_params_bi ((t Tr) (ty Expr) (n Int) (acc (List Expr))) (Prod Tr (Option (List Expr)))
  (measure (Int.natAbs n))
  (if (< n 1) (Prod.mk t (some (rev acc)))
  (match ty
    ((Pi _ nm _ dom body)
     (match (tr_local_bi t nm dom BImplicit)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1) (open_params_bi t2 body1 (- n 1) (cons fv acc)))))))
    (_ (Prod.mk t none)))))
(fulfills open_params_bi.dec_1
  (by (intro p h w1 nm w2 dom body hm t1 fv h1 t2 body1 h2) (apply natAbs_pred (arith))))
;; a minor local per constructor: minor_c : ∀ fields, motive (c fields)
(fn cases_minor_locals ((t Tr) (motive Expr) (ps (List Expr)) (ctors (List Name)) (acc (List Expr)))
  (Prod Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some (rev acc))))
    ((cons c r)
     (match (rz_open_ctor t c nil ps)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fields cterm)))
        (match (tr_pis t1 (field_fvars fields) (mk_app motive cterm))
          ((Prod.mk t2 mty)
           (match (tr_local t2 (ctor_short c) mty)
             ((Prod.mk t3 m) (cases_minor_locals t3 motive ps r (cons m acc)))))))))))
;; the recursor's minors: λ fields ihs. minor_c fields, each hypothesis at the motive of its field —
;; that of a field over another type of the block (the type under another inductive, a type
;; that names it back) at PUnit.{u}, the other motives' value
(fn cases_rec_minors
  ((t Tr)
   (motive Expr)
   (u Level)
   (inds (List Name))
   (ps (List Expr))
   (ctors (List Name))
   (minors (List Expr))
   (acc (List Expr)))
  (Prod Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some (rev acc))))
    ((cons c r)
     (match minors
       (nil (Prod.mk t none))
       ((cons m mr)
        (match (rz_open_ctor t c nil ps)
          ((Prod.mk t1 none) (Prod.mk t1 none))
          ((Prod.mk t1 (some (Prod.mk fields _)))
           (match (open_ihs_dep t1 fields motive u inds nil)
             ((Prod.mk t2 ihs)
              (match (tr_apps t2 m (field_fvars fields))
                ((Prod.mk t3 body)
                 (match (tr_lams t3 (append (field_fvars fields) ihs) body)
                   ((Prod.mk t4 minor) (cases_rec_minors t4 motive u inds ps r mr (cons minor acc)))))))))))))))
(fn open_ihs_dep
  ((t Tr) (fields (List Field)) (motive Expr) (u Level) (inds (List Name)) (acc (List Expr)))
  (Prod Tr (List Expr))
  (measure (struct fields))
  (match fields
    (nil (Prod.mk t (rev acc)))
    ((cons (Field fv _ true) r)
     (match (tr_local t (n1 (sym "ih")) (mk_app motive fv))
       ((Prod.mk t1 ih) (open_ihs_dep t1 r motive u inds (cons ih acc)))))
    ((cons (Field fv _ false) r)
     (if (field_over t fv inds)
       (match (tr_local t (n1 (sym "ih")) (mk_const (n1 (sym "PUnit")) (list u)))
         ((Prod.mk t1 ih) (open_ihs_dep t1 r motive u inds (cons ih acc))))
       (open_ihs_dep t r motive u inds acc)))))

;; a constructor's fields as locals of a binder info, and the constructor applied to them
;; (a type without parameters: the fields' types are closed)
(fn open_ctor_bi ((t Tr) (c Name) (bi BinderInfo)) (Prod Tr (Option (Prod (List Expr) Expr)))
  (match (env_find (tr_env t) c)
    ((some info)
     (match (ctor_locals t (ci_type info) bi nil (budget_depth))
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some fvs))
        (match (tr_apps t1 (mk_const c nil) fvs)
          ((Prod.mk t2 cterm) (Prod.mk t2 (some (Prod.mk fvs cterm))))))))
    (none (Prod.mk t none))))
(fn ctor_locals ((t Tr) (ty Expr) (bi BinderInfo) (acc (List Expr)) (fuel Int))
  (Prod Tr (Option (List Expr)))
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) (Prod.mk t none)
  (match ty
    ((Pi _ n _ dom body)
     (if (has_fvar dom) (Prod.mk t none)  ; a dependent field: the HEq shape, not generated
     (match (tr_local_bi t n dom bi)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1) (ctor_locals t2 body1 bi (cons fv acc) (- fuel 1))))))))
    (_ (Prod.mk t (some (rev acc)))))))
(fulfills ctor_locals.dec_1
  (by (intro p h w1 n w2 dom body hm hd t1 fv h1 t2 body1 h2) (apply natAbs_lt (arith) (arith))))
;; the type of a local and the universe of that type
(fn local_type_level ((t Tr) (fv Expr)) (Prod Tr (Option (Prod Expr Level)))
  (match (w_local_type (Tr.w t) (fvar_id_of fv))
    (none (Prod.mk t none))
    ((some ty)
     (match (tr_infer t ty)
       ((Prod.mk t1 (some (Sort _ v))) (Prod.mk t1 (some (Prod.mk ty v))))
       ((Prod.mk t1 _) (Prod.mk t1 none))))))
;; the equations between two openings' fields: f_eq : Eq.{v} F f f' as locals
(fn field_eq_locals ((t Tr) (fs (List Expr)) (fs2 (List Expr)) (acc (List Expr)))
  (Prod Tr (Option (List Expr)))
  (measure (struct fs))
  (match fs
    (nil (Prod.mk t (some (rev acc))))
    ((cons f r)
     (match fs2
       (nil (Prod.mk t none))
       ((cons f2 r2)
        (match (local_type_level t f)
          ((Prod.mk t1 none) (Prod.mk t1 none))
          ((Prod.mk t1 (some (Prod.mk fty v)))
           (match (tr_apps t1 (mk_const (nm_eq) (list v)) (list fty f f2))
             ((Prod.mk t2 eqty)
              (match (tr_local t2 (n1 (sym "f_eq")) eqty)
                ((Prod.mk t3 fe) (field_eq_locals t3 r r2 (cons fe acc)))))))))))))

;; T.noConfusionType.{u} : (P : Sort u) → (t t' : T) → Sort u
;;   := λ P t t'. T.casesOn.{succ u} (λ _. Sort u) t (λ fs. T.casesOn.{succ u} (λ _. Sort u) t' (λ fs'. (c = c' ? (∀ (x : ∀ f_eqs, P), P) : P))…)…
(fn gen_nct ((t Tr) (ind Name) (u Name) (ctors (List Name))) TrAux
  (let ((tyc (mk_const ind nil)) (sortu (mk_sort (LParam u))))
    (match (tr_local t (n1 (sym "P")) sortu)
      ((Prod.mk t1 p)
       (match (tr_local t1 (n1 (sym "t")) tyc)
         ((Prod.mk t2 t1v)
          (match (tr_local t2 (n1 (sym "t'")) tyc)
            ((Prod.mk t3 t2v)
             (match (const_motive t3 tyc sortu)
               ((Prod.mk t4 kmotive)
                (match (nct_outer t4 ind u kmotive p t2v ctors ctors nil)
                  ((Prod.mk t5 none)
                   (AuxErr t5 (sym "equation_form")
                     (utf8 "noConfusionType: a constructor could not be opened")))
                  ((Prod.mk t5 (some outer))
                   (match
                     (tr_apps t5 (mk_const (nm_cases_on ind) (list (LSucc (LParam u))))
                       (cons kmotive (cons t1v outer)))
                     ((Prod.mk t6 value0)
                      (match (tr_lams t6 (list p t1v t2v) value0)
                        ((Prod.mk t7 value)
                         (match (tr_pis t7 (list p t1v t2v) sortu)
                           ((Prod.mk t8 ty)
                            (let ((n (nm_nct ind)))
                              (AuxOk t8
                                (list
                                  (DefnDecl (ConstantVal n (list u) ty) value (HRegular 1) Safe
                                    (list n)))))))))))))))))))))))
;; λ (_ : T). Sort u
(fn const_motive ((t Tr) (tyc Expr) (sortu Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "x")) tyc)
    ((Prod.mk t1 x) (tr_lams t1 (list x) sortu))))
(fn nct_outer
  ((t Tr)
   (ind Name)
   (u Name)
   (kmotive Expr)
   (p Expr)
   (t2v Expr)
   (all (List Name))
   (ctors (List Name))
   (acc (List Expr)))
  (Prod Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some (rev acc))))
    ((cons c r)
     (match (open_ctor_bi t c BDefault)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fs _)))
        (match (nct_inner t1 c fs p all nil)
          ((Prod.mk t2 none) (Prod.mk t2 none))
          ((Prod.mk t2 (some inner))
           (match
             (tr_apps t2 (mk_const (nm_cases_on ind) (list (LSucc (LParam u))))
               (cons kmotive (cons t2v inner)))
             ((Prod.mk t3 inner_app)
              (match (tr_lams t3 fs inner_app)
                ((Prod.mk t4 minor) (nct_outer t4 ind u kmotive p t2v all r (cons minor acc)))))))))))))
(fn nct_inner ((t Tr) (c Name) (fs (List Expr)) (p Expr) (ctors (List Name)) (acc (List Expr)))
  (Prod Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some (rev acc))))
    ((cons c2 r)
     (match (open_ctor_bi t c2 BDefault)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fs2 _)))
        (match (if (name_eq c c2) (nct_same t1 fs fs2 p) (Prod.mk t1 (some p)))
          ((Prod.mk t2 none) (Prod.mk t2 none))
          ((Prod.mk t2 (some body))
           (match (tr_lams t2 fs2 body)
             ((Prod.mk t3 minor) (nct_inner t3 c fs p r (cons minor acc)))))))))))
;; (∀ (x : ∀ f_eqs, P), P)
(fn nct_same ((t Tr) (fs (List Expr)) (fs2 (List Expr)) (p Expr)) (Prod Tr (Option Expr))
  (match (field_eq_locals t fs fs2 nil)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some eqs))
     (match (tr_pis t1 eqs p)
       ((Prod.mk t2 kty)
        (match (tr_local t2 (n1 (sym "x")) kty)
          ((Prod.mk t3 x)
           (match (tr_pis t3 (list x) p)
             ((Prod.mk t4 r) (Prod.mk t4 (some r)))))))))))

;; T.noConfusion.{u} : ∀ {P : Sort u} {t t' : T} (eq : Eq t t'), T.noConfusionType P t t'
;;   := λ P t t' eq. Eq.ndrec.{u, w} T t (λ t'. NCT P t t') (T.casesOn.{u} (λ t. NCT P t t) t (λ fs k. k (Eq.refl f)…)…) t' eq
(fn gen_nc ((t Tr) (ind Name) (u Name) (ctors (List Name))) TrAux
  (let ((tyc (mk_const ind nil)) (sortu (mk_sort (LParam u))))
    (match (tr_infer t tyc)
      ((Prod.mk t0 (some (Sort _ w)))
       (match (tr_local_bi t0 (n1 (sym "P")) sortu BImplicit)
         ((Prod.mk t1 p)
          (match (tr_local_bi t1 (n1 (sym "t")) tyc BImplicit)
            ((Prod.mk t2 t1v)
             (match (tr_local_bi t2 (n1 (sym "t'")) tyc BImplicit)
               ((Prod.mk t3 t2v)
                (match (tr_apps t3 (mk_const (nm_eq) (list w)) (list tyc t1v t2v))
                  ((Prod.mk t4 eqty)
                   (match (tr_local t4 (n1 (sym "eq")) eqty)
                     ((Prod.mk t5 eq)
                      (match (nc_motive1 t5 ind u p t1v tyc)
                        ((Prod.mk t6 motive1)
                         (match (nc_cases_motive t6 ind u p tyc)
                           ((Prod.mk t7 cmotive)
                            (match (nc_minors t7 p ctors nil)
                              ((Prod.mk t8 none)
                               (AuxErr t8 (sym "equation_form")
                                 (utf8 "noConfusion: a constructor could not be opened")))
                              ((Prod.mk t8 (some minors))
                               (match
                                 (tr_apps t8 (mk_const (nm_cases_on ind) (list (LParam u)))
                                   (cons cmotive (cons t1v minors)))
                                 ((Prod.mk t9 inner)
                                  (match
                                    (tr_apps t9
                                      (mk_const (n2 (sym "Eq") (sym "ndrec")) (list (LParam u) w))
                                      (list tyc t1v motive1 inner t2v eq))
                                    ((Prod.mk t10 value0)
                                     (match (tr_lams t10 (list p t1v t2v eq) value0)
                                       ((Prod.mk t11 value)
                                        (match
                                          (tr_apps t11 (mk_const (nm_nct ind) (list (LParam u)))
                                            (list p t1v t2v))
                                          ((Prod.mk t12 rty)
                                           (match (tr_pis t12 (list p t1v t2v eq) rty)
                                             ((Prod.mk t13 ty)
                                              (let ((n (nm_nc ind)))
                                                (AuxOk t13
                                                  (list
                                                    (DefnDecl (ConstantVal n (list u) ty) value
                                                      (HRegular 1)
                                                      Safe
                                                      (list n))))))))))))))))))))))))))))))))
      ((Prod.mk t0 _) (AuxErr t0 (sym "equation_form") (utf8 "noConfusion: the type's sort"))))))
;; λ (t' : T). NCT P t t'
(fn nc_motive1 ((t Tr) (ind Name) (u Name) (p Expr) (t1v Expr) (tyc Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "t'")) tyc)
    ((Prod.mk t1 x)
     (match (tr_apps t1 (mk_const (nm_nct ind) (list (LParam u))) (list p t1v x))
       ((Prod.mk t2 body) (tr_lams t2 (list x) body))))))
;; λ (t : T). NCT P t t
(fn nc_cases_motive ((t Tr) (ind Name) (u Name) (p Expr) (tyc Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "t")) tyc)
    ((Prod.mk t1 x)
     (match (tr_apps t1 (mk_const (nm_nct ind) (list (LParam u))) (list p x x))
       ((Prod.mk t2 body) (tr_lams t2 (list x) body))))))
;; λ fs (k : ∀ f_eqs, P). k (Eq.refl f)…  — P is what the continuation's type ends in: the
;; casesOn motive fixes it, so k's type is read off NCT's shape here: ∀ (f_eq : Eq F f f)…, P
(fn nc_minors ((t Tr) (p Expr) (ctors (List Name)) (acc (List Expr))) (Prod Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk t (some (rev acc))))
    ((cons c r)
     (match (open_ctor_bi t c BDefault)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fs _)))
        (match (nc_k_type t1 p fs)
          ((Prod.mk t2 none) (Prod.mk t2 none))
          ((Prod.mk t2 (some (Prod.mk kty refls)))
           (match (tr_local t2 (n1 (sym "k")) kty)
             ((Prod.mk t3 k)
              (match (tr_apps t3 k refls)
                ((Prod.mk t4 body)
                 (match (tr_lams t4 (append fs (list k)) body)
                   ((Prod.mk t5 minor) (nc_minors t5 p r (cons minor acc)))))))))))))))
;; the continuation's type over one opening (f = f), and the Eq.refl for each field
(fn nc_k_type ((t Tr) (p Expr) (fs (List Expr))) (Prod Tr (Option (Prod Expr (List Expr))))
  (match (field_eq_locals t fs fs nil)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some eqs))
     (match (tr_pis t1 eqs p)
       ((Prod.mk t3 kty)
        (match (refls_of t3 fs nil)
          ((Prod.mk t4 none) (Prod.mk t4 none))
          ((Prod.mk t4 (some refls)) (Prod.mk t4 (some (Prod.mk kty refls))))))))))
(fn refls_of ((t Tr) (fs (List Expr)) (acc (List Expr))) (Prod Tr (Option (List Expr)))
  (measure (struct fs))
  (match fs
    (nil (Prod.mk t (some (rev acc))))
    ((cons f r)
     (match (local_type_level t f)
       ((Prod.mk t1 none) (Prod.mk t1 none))
       ((Prod.mk t1 (some (Prod.mk fty v)))
        (match (tr_apps t1 (mk_const (nm_eq_refl) (list v)) (list fty f))
          ((Prod.mk t2 rf) (refls_of t2 r (cons rf acc)))))))))

;; T.c.inj : ∀ {fs} {fs'}, Eq (c fs) (c fs') → And (Eq f1 f1') (And … ) — a constructor with fields
;;   := λ fs fs' h. T.noConfusion.{0} CONJ (c fs) (c fs') h (λ f_eqs. And.intro _ _ e1 (And.intro …))
(fn gen_injs ((t Tr) (ind Name) (ctors (List Name)) (acc (List Declaration))) TrAux
  (measure (struct ctors))
  (match ctors
    (nil (AuxOk t (rev acc)))
    ((cons c r)
     (match (open_ctor_bi t c BImplicit)
       ((Prod.mk t1 none)
        (AuxErr t1 (sym "equation_form") (utf8 "inj: a constructor could not be opened")))
       ((Prod.mk t1 (some (Prod.mk fs cterm)))
        (match fs
          (nil (gen_injs t1 ind r acc))
          (_
            (match (open_ctor_bi t1 c BImplicit)
              ((Prod.mk t2 none)
               (AuxErr t2 (sym "equation_form") (utf8 "inj: a constructor could not be opened")))
              ((Prod.mk t2 (some (Prod.mk fs2 cterm2)))
               (match (gen_inj t2 ind c fs cterm fs2 cterm2)
                 ((AuxErr t3 e m) (AuxErr t3 e m))
                 ((AuxOk t3 ds) (gen_injs t3 ind r (append (rev ds) acc)))))))))))))
(fn gen_inj
  ((t Tr) (ind Name) (c Name) (fs (List Expr)) (cterm Expr) (fs2 (List Expr)) (cterm2 Expr))
  TrAux
  (match (tr_infer t (mk_const ind nil))
    ((Prod.mk t0 (some (Sort _ w)))
     (match (tr_apps t0 (mk_const (nm_eq) (list w)) (list (mk_const ind nil) cterm cterm2))
       ((Prod.mk t1 hty)
        (match (tr_local t1 (n1 (sym "h")) hty)
          ((Prod.mk t2 h)
           (match (field_eq_locals t2 fs fs2 nil)
             ((Prod.mk t3 none) (AuxErr t3 (sym "equation_form") (utf8 "inj: a field's type")))
             ((Prod.mk t3 (some eqs))
              (match (eq_types t3 eqs nil)
                ((Prod.mk t4 none)
                 (AuxErr t4 (sym "equation_form") (utf8 "inj: an equation's type")))
                ((Prod.mk t4 (some etys))
                 (let ((conj (and_nest etys)))
                   (match (and_intro_nest t4 etys eqs)
                     ((Prod.mk t5 none)
                      (AuxErr t5 (sym "equation_form") (utf8 "inj: the conjunction")))
                     ((Prod.mk t5 (some intro))
                      (match (tr_lams t5 eqs intro)
                        ((Prod.mk t6 kont)
                         (match
                           (tr_apps t6 (mk_const (nm_nc ind) (list LZero))
                             (list conj cterm cterm2 h kont))
                           ((Prod.mk t7 value0)
                            (match (tr_lams t7 (append fs (append fs2 (list h))) value0)
                              ((Prod.mk t8 value)
                               (match (tr_pis t8 (append fs (append fs2 (list h))) conj)
                                 ((Prod.mk t9 ty)
                                  (let ((n (name_append c (n1 (sym "inj")))))
                                    (AuxOk t9 (list (ThmDecl (ConstantVal n nil ty) value (list n)))))))))))))))))))))))))
    ((Prod.mk t0 _) (AuxErr t0 (sym "equation_form") (utf8 "inj: the type's sort")))))
;; the types of the equation locals
(fn eq_types ((t Tr) (eqs (List Expr)) (acc (List Expr))) (Prod Tr (Option (List Expr)))
  (measure (struct eqs))
  (match eqs
    (nil (Prod.mk t (some (rev acc))))
    ((cons e r)
     (match (w_local_type (Tr.w t) (fvar_id_of e))
       (none (Prod.mk t none))
       ((some ty) (eq_types t r (cons ty acc)))))))
;; And e1 (And e2 …) — a single equation is itself
(fn and_nest ((etys (List Expr))) Expr
  (measure (struct etys))
  (match etys
    (nil (mk_const (n1 (sym "True")) nil))
    ((cons e nil) e)
    ((cons e r) (mk_app (mk_app (mk_const (n1 (sym "And")) nil) e) (and_nest r)))))
(fn and_intro_nest ((t Tr) (etys (List Expr)) (eqs (List Expr))) (Prod Tr (Option Expr))
  (measure (struct etys))
  (match etys
    (nil (Prod.mk t none))
    ((cons e nil)
     (match eqs
       ((cons q nil) (Prod.mk t (some q)))
       (_ (Prod.mk t none))))
    ((cons e r)
     (match eqs
       ((cons q qr)
        (match (and_intro_nest t r qr)
          ((Prod.mk t1 none) (Prod.mk t1 none))
          ((Prod.mk t1 (some rest))
           (match
             (tr_apps t1 (mk_const (n2 (sym "And") (sym "intro")) nil) (list e (and_nest r) q rest))
             ((Prod.mk t2 x) (Prod.mk t2 (some x)))))))
       (_ (Prod.mk t none))))))

;; the constants the definer constructs by name: the structural and
;; well-founded recursion kits, the decision cells, the conjunction of obligations
(fn df_kit () (List Name)
  (list (n1 (sym "PProd")) (nm_pprod_mk) (n1 (sym "PUnit")) (nm_punit_unit) (n1 (sym "True"))
    (n1 (sym "And"))
    (n2 (sym "And") (sym "intro"))
    (n1 (sym "Decidable"))
    (n2 (sym "Decidable") (sym "isTrue"))
    (n2 (sym "Decidable") (sym "isFalse"))
    (n2 (sym "Eq") (sym "ndrec"))
    (n1 (sym "ite"))
    (n2 (sym "WellFounded") (sym "fix"))
    (n2 (sym "WellFounded") (sym "fix_eq"))
    (n1 (sym "InvImage"))
    (n2 (sym "InvImage") (sym "wf"))
    (n2 (sym "Nat") (sym "lt"))
    (n2 (sym "Nat") (sym "lt_wfRel"))
    (n1 (sym "Prod"))
    (n2 (sym "Prod") (sym "lex"))
    (n2 (sym "Prod") (sym "Lex"))
    (n2 (sym "WellFoundedRelation") (sym "rel"))
    (n2 (sym "WellFoundedRelation") (sym "wf"))))
