;;; v3/kernel/define.shard — Stage 1's `fn` = `def` + `realize`: the K projection
;;; of a pre-definition (v3/LANGUAGE.md §8.4, slices 3.13–3.14 and 3.16; §13 items
;;; 43–45, 47, 49; law §4.4, §5.1). predef.shard read the `fn` once into an L body
;;; over the binders' locals and the self-local; here it becomes a definition K
;;; checks. A body that never cites the self-local is the value under its binders.
;;; A structurally recursive one is `T.brecOn` applied to a functional: a matcher
;;; on a local the course-of-values table's type mentions takes the table through
;;; its motive (Lean's addArg — the matcher stays the constant K checked), and a
;;; self-call is the table's entry, found by type over an abstract motive (a
;;; native inductive's `below` and `brecOn` generated on first need). A measured
;;; one is `WellFounded.fix` over the data binders' tuple, each self-call's
;;; decreasing fact an obligation `f.dec_N` over every local in scope, an `ite`
;;; compiled as `Decidable.rec` so the branch's proof is one of them. The
;;; equations `NAME.eq_N` (one per leaf of the leading matchers, by `Eq.refl`;
;;; none for a measured function) come with it. What K's projection cannot reach
;;; here leaves the function RUNNABLE with the obstacle named (DfSkip); a
;;; definition that should exist and fails is refused (DfErr) — never a silent
;;; fall-back. Also here: a native inductive's `below`/`brecOn` and its
;;; constructor-structure bundle (slice 3.15).
(import "realize.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.erase)
(use kernel.kw)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.prelude)
(use kernel.scope)
(use kernel.realize)
(use kernel.util)
(use kernel.elab el_w)
(use kernel.matcher)
(use kernel.predef)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.scope.Scope)
(use kernel.kw.WOut)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtInd)
(use kernel.matcher.MtPat)
(use kernel.matcher.MtPt)
(use kernel.predef.PdRec)
(use kernel.realize.Either2)
(use kernel.realize.Either3)
(use kernel.realize.Field)
(use kernel.realize.TrRes)

;; ---- the verdicts ----------------------------------------------------------------------------
;; DfSkip: the function has no L meaning here (RUNNABLE, the obstacle named); DfErr: it should,
;; and the definition failed (refused); DfAux: declarations to admit first (a native inductive's
;; below and brecOn), then read and try again; DfOk: the E table, the obligations to admit as
;; parameters, the definition, its equations, whether a measure is pending
(type DfRes (DfSkip Symbol (List Int)) (DfErr Symbol (List Int)) (DfAux ESt (List Declaration)) (DfOk ESt (List Declaration) Declaration (List Declaration) Bool))
;; a value's result with the state: declarations to admit first, or the error
(type TrAux (AuxOk Tr (List Declaration)) (AuxErr Tr Symbol (List Int)))

;; what K's projection cannot reach here and the program does not need: RUNNABLE, named
(fn df_obstacle ((e Symbol)) Bool
  (bool_or (sym_eq e (quote measure_type))
  (bool_or (sym_eq e (quote below_unreached))
           (sym_eq e (quote wf_unreached)))))
(fn df_verdict ((e Symbol) (m (List Int))) DfRes
  (if (df_obstacle e) (DfSkip e m) (DfErr e m)))

;; ---- the entry: the K projection of a pre-definition ---------------------------------------------
;; the body is an L term over the binders' locals and the self-local (predef.shard). A body
;; that never cites the self-local is the value under its binders, matchers and `ite` as
;; elaborated. One that does is compiled by its recursion clause: structural — `T.brecOn`, each
;; self-call the table's entry found by type (pj_find); measured — `WellFounded.fix`, each
;; self-call `rec (tuple args) f.dec_N`. The equations come with it (pj_equations).
(type PjKind (PkStruct Int Int) (PkWf Expr Expr Expr (List Expr)))   ; C's id, the structural position among the data arguments; rec, the tuple, the relation, the components' types
;; the lexical context of the walk: the self-local's id, the type binders (fixed in a
;; self-call), the recursion, the tables in scope innermost first — a local with its type over
;; the abstract motive —, every local in scope outermost first (True = a let)
(record PjCx (self Int) (tps (List Expr)) (kind PjKind) (tables (List (Pair Expr Expr))) (scope (List (Pair Bool Expr))))
(fn pj_push ((cx PjCx) (is_let Bool) (fvs (List Expr))) PjCx
  (measure (struct fvs))
  (match fvs (Nil cx) ((Cons fv r) (pj_push (with PjCx cx (scope (append (PjCx.scope cx) (list (Pair is_let fv))))) is_let r))))

(fn define_pd ((es ESt) (sc Scope) (pd PreDef)) DfRes
  (let ((w (el_w (pd_state pd))) (k (pd_name pd)) (selfid (fvar_id_of (pd_self pd))))
    (match (pj_split_binders w (pd_binders pd) Nil Nil)
      ((Pair tps data)
       (let ((t (tr_new w es sc k tps (Some (def_rec (- 0 1) Nil False)))))
         (match (mt_inst_args (Tr.w t) (pd_type pd) (pd_binders pd))
           ((Pair _ None) (DfErr (quote define_matrix) "the declared type does not take the binders"))
           ((Pair w1 (Some rl))
            (let ((t0 (tr_set_w t w1)) (recursive (mentions_any (pd_body pd) (list selfid))))
              (match (pj_value t0 pd tps data rl selfid recursive)
                ((AuxErr _ e m) (df_verdict e m))
                ((AuxOk t1 auxs)
                 (if (lt 0 (len auxs)) (DfAux (Tr.es t1) auxs)
                 (match (df_value_term t1)
                   (None (DfErr (quote define_matrix) "no value"))
                   ((Some value)
                    (let ((measured (bool_and recursive (pj_is_measure (pd_rec pd))))
                          (dd (DefnDecl (ConstantVal k Nil (pd_type pd)) value (HRegular (def_height (tr_env t1) value)) Safe (list k))))
                      (if (bool_or measured (bool_not (has_eq (tr_env t1)))) (DfOk (Tr.es t1) (tr_obls t1) dd Nil measured)   ; WellFounded.fix does not compute through Acc.rec (I's); no Eq in scope: the definition alone
                        (match (pj_equations t1 pd rl selfid)
                          ((Pair _ (Left3 e m)) (DfErr e m))
                          ((Pair t2 (Right3 eqs)) (DfOk (Tr.es t2) (tr_obls t2) dd eqs measured))))))))))))))))))
(fn pj_is_measure ((r PdRec)) Bool (match r ((PdMeasure _) True) (_ False)))
;; the type binders (a local whose type is a sort) and the data binders, in order
(fn pj_split_binders ((w W) (bs (List Expr)) (tps (List Expr)) (data (List Expr))) (Pair (List Expr) (List Expr))
  (measure (struct bs))
  (match bs
    (Nil (Pair (rev tps) (rev data)))
    ((Cons fv r)
     (match (w_local_type w (fvar_id_of fv))
       ((Some (Sort _ _)) (pj_split_binders w r (Cons fv tps) data))
       (_ (pj_split_binders w r tps (Cons fv data)))))))
;; the value threads through the state's context: kept in the tables under id -1 so AuxOk
;; carries the declarations alone
(fn df_value_term ((t Tr)) (Option Expr) (tr_table_of t (- 0 1)))
(fn df_set_value ((t Tr) (v Expr)) Tr (tr_add_tables t Nil (list (Pair (- 0 1) v))))
(fn has_eq ((env CheckedEnv)) Bool
  (match (env_find env (nm_eq)) (None False) ((Some _) (match (env_find env (nm_eq_refl)) (None False) ((Some _) True)))))

(fn pj_value ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (recursive Bool)) TrAux
  (if (bool_not recursive)
    (match (tr_lams t (pd_binders pd) (pd_body pd)) ((Pair t1 v) (AuxOk (df_set_value t1 v) Nil)))
    (match (pd_rec pd)
      (PdNone (AuxErr t (quote realize_recursion) (append (show_name (pd_name pd)) " calls itself without a measure")))
      ((PdStruct x) (pj_struct t pd tps data rl selfid x))
      ((PdMeasure m) (pj_wf t pd tps data rl selfid m)))))

;; ---- structural recursion: brecOn (§8.4, slice 3.14 rule 1; slice 3.16 landing 3) -------------------
;; `λ binders . T.brecOn largs (λ x . Π others, RET) x (λ x below others . body') others` — the
;; functional over the binders' own locals (closed before the outer lambdas bind them again)
(fn pj_struct ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (x Expr)) TrAux
  (match (fvar_index (fvar_id_of x) data 0)
    (None (AuxErr t (quote realize_descent) "the structural parameter is not a data parameter"))
    ((Some pos)
     (match (tr_type_of_local t x)
       (None (AuxErr t (quote untyped_subterm) "the structural parameter has no type"))
       ((Some xty)
        (match (mt_ind_of (Tr.w t) xty)
          ((Pair _ (MtNoInd _ _)) (AuxErr t (quote untyped_subterm) "the structural parameter's type is not an inductive type"))
          ((Pair w1 (MtInd ind ls largs _))
           (let ((t1 (tr_set_w t w1)))
             (match (rec_usable t1 ind ls)
               ((Some (Pair e m)) (AuxErr t1 e m))
               (None
                (match (ensure_below t1 ind ls)
                  ((AuxErr t2 e m) (AuxErr t2 e m))
                  ((AuxOk t2 auxs)
                   (if (lt 0 (len auxs)) (AuxOk t2 auxs)
                   (match (below_names t2 ind)
                     ((Pair t3 None) (AuxErr t3 (quote below_unreached) (append (show_name ind) ": its below and brecOn are not in scope")))
                     ((Pair t3 (Some (Pair (Pair belowc brecc) lsb)))
                      (pj_brec t3 pd tps data rl selfid x pos xty largs belowc brecc lsb))))))))))))))))
(fn pj_brec ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (x Expr) (pos Int) (xty Expr) (largs (List Expr)) (belowc Name) (brecc Name) (lsb (List Level))) TrAux
  (let ((others (without_index data pos 0)))
    (match (tr_pis t others rl)
      ((Pair t1 mres)
       (match (tr_lams t1 (list x) mres)
         ((Pair t2 motive)
          (match (tr_local t2 (n1 (quote x)) xty)
            ((Pair t3 x0)
             (match (tr_pis t3 (list x0) (mk_sort (level_one)))
               ((Pair t4 cty)
                (match (tr_local t4 (n1 (quote C)) cty)
                  ((Pair t5 cfv)
                   (match (tr_apps t5 (mk_const belowc lsb) (append largs (list motive x)))
                     ((Pair t6 belowty)
                      (match (tr_apps t6 (mk_const belowc lsb) (append largs (list cfv x)))
                        ((Pair t7 belowabs)
                         (match (tr_local t7 (n1 (quote below)) belowty)
                           ((Pair t8 below)
                            (let ((cx (make PjCx (self selfid) (tps tps) (kind (PkStruct (fvar_id_of cfv) pos)) (tables (list (Pair below belowabs))) (scope Nil))))
                              (match (pj_term t8 cx (pd_body pd) (budget_depth))
                                ((TrErr e m) (AuxErr t8 e m))
                                ((TrOk t9 b)
                                 (match (tr_lams t9 (Cons x (Cons below others)) b)
                                   ((Pair t10 fnl)
                                    (match (tr_apps t10 (mk_const brecc lsb) (append largs (list motive x fnl)))
                                      ((Pair t11 brec)
                                       (match (tr_apps t11 brec others)
                                         ((Pair t12 b2)
                                          (match (tr_lams t12 (pd_binders pd) b2)
                                            ((Pair t13 v) (AuxOk (df_set_value t13 v) Nil))))))))))))))))))))))))))))))
(fn without_index ((xs (List Expr)) (i Int) (k Int)) (List Expr)
  (measure (struct xs))
  (match xs
    (Nil Nil)
    ((Cons x r) (if (int_eq k i) (without_index r i (+ k 1)) (Cons x (without_index r i (+ k 1)))))))

;; the entry for a self-call's structural argument: the tables innermost first, each searched by
;; its type over the abstract motive C — `C y'` with y' the argument is the entry; a PProd is
;; searched through both projections; anything else is normalized by K once (a `T.below C t`
;; unfolds exactly when t is a constructor application) and searched again
(fn pj_find ((t Tr) (tables (List (Pair Expr Expr))) (cid Int) (y Expr)) (Pair Tr (Option Expr))
  (measure (struct tables))
  (match tables
    (Nil (Pair t None))
    ((Cons (Pair term ty) r)
     (match (pj_search t term ty cid y 64)
       ((Pair t1 (Some e)) (Pair t1 (Some e)))
       ((Pair t1 None) (pj_find t1 r cid y))))))
(fn pj_search ((t Tr) (term Expr) (ty Expr) (cid Int) (y Expr) (fuel Int)) (Pair Tr (Option Expr))
  (measure fuel)
  (if (lt fuel 1) (Pair t None)
  (match (tr_whnf t ty)
    ((Pair t1 None) (Pair t1 None))
    ((Pair t1 (Some ty1))
     (match (get_app_fn ty1)
       ((FVar _ id)
        (if (bool_not (int_eq id cid)) (Pair t1 None)
          (match (get_app_args ty1)
            ((Cons y1 Nil) (pj_same t1 term y1 y))
            (_ (Pair t1 None)))))
       ((Const _ c _)
        (if (bool_not (name_eq c (n1 (quote PProd)))) (Pair t1 None)
          (match (get_app_args ty1)
            ((Cons a (Cons b Nil))
             (match (pj_search t1 (mk_proj (n1 (quote PProd)) 0 term) a cid y (- fuel 1))
               ((Pair t2 (Some e)) (Pair t2 (Some e)))
               ((Pair t2 None) (pj_search t2 (mk_proj (n1 (quote PProd)) 1 term) b cid y (- fuel 1)))))
            (_ (Pair t1 None)))))
       (_ (Pair t1 None)))))))
(fn pj_same ((t Tr) (term Expr) (y1 Expr) (y Expr)) (Pair Tr (Option Expr))
  (if (expr_eq y1 y) (Pair t (Some term))
    (match (w_is_def_eq_r (Tr.w t) y1 y)
      ((Pair w1 (WVal True)) (Pair (tr_set_w t w1) (Some term)))
      ((Pair w1 _) (Pair (tr_set_w t w1) None)))))

;; ---- a measure: WellFounded.fix (§8.4, slice 3.14 rule 2) -------------------------------------------
;; `λ binders . WellFounded.fix α (λ _ . RET) (InvImage rel m) (InvImage.wf m Nat.lt_wfRel.wf)
;; (λ p rec . body') (tuple data)` — the body with each data binder the tuple's component, a
;; self-call `rec (tuple args) (f.dec_N locals…)`, the decreasing fact an obligation
(fn pj_wf ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (m Expr)) TrAux
  (if (bool_not (wf_reachable t)) (AuxErr t (quote wf_unreached) "WellFounded.fix, InvImage.wf or Nat.lt_wfRel is past the Init prefix in scope")
  (match (local_types t data Nil)
    ((Pair t1 ltys)
     (match (wf_tuple_type t1 ltys)
       ((Pair t2 alpha)
        (match (tr_local t2 (n1 (quote p)) alpha)
          ((Pair t3 pm)
           (match (pj_subst_projs t3 m data pm (len data) 0)
             ((Pair t4 ml)
              (match (measure_is_nat t4 ml)
                ((Pair t5 False) (AuxErr t5 (quote measure_type) "the measure must be a Nat (an Int measure: write a Nat one; the law inserts no Int.toNat)"))
                ((Pair t5 True)
                 (match (tr_lams t5 (list pm) ml)
                   ((Pair t6 mfn)
                    (match (wf_relation t6 alpha mfn)
                      ((Pair t7 (Pair rel hwf))
                       (match (tr_local t7 (n1 (quote p)) alpha)
                         ((Pair t8 p)
                          (match (wf_rec_type t8 alpha rel p rl)
                            ((Pair t9 rty)
                             (match (tr_local t9 (n1 (quote rec)) rty)
                               ((Pair t10 recl)
                                (match (pj_subst_projs t10 (pd_body pd) data p (len data) 0)
                                  ((Pair t11 body1)
                                   (let ((cx (make PjCx (self selfid) (tps tps) (kind (PkWf recl p rel ltys)) (tables Nil) (scope (list (Pair False p))))))
                                     (match (pj_term t11 cx body1 (budget_depth))
                                       ((TrErr e m2) (AuxErr t11 e m2))
                                       ((TrOk t12 b)
                                        (match (tr_lams t12 (list p recl) b)
                                          ((Pair t13 fnl)
                                           (match (tr_local t13 (n1 (quote x)) alpha)
                                             ((Pair t14 xc)
                                              (match (tr_lams t14 (list xc) rl)
                                                ((Pair t15 cmot)
                                                 (match (wf_tuple t15 ltys data)
                                                   ((Pair t16 tup)
                                                    (match (tr_apps t16 (mk_const (n2 (quote WellFounded) (quote fix)) (list (level_one) (level_one))) (list alpha cmot rel hwf fnl tup))
                                                      ((Pair t17 fixed)
                                                       (match (tr_lams t17 (pd_binders pd) fixed)
                                                         ((Pair t18 v) (AuxOk (df_set_value t18 v) Nil))))))))))))))))))))))))))))))))))))))))
;; e with the k-th data binder the k-th component of the tuple p
(fn pj_subst_projs ((t Tr) (e Expr) (data (List Expr)) (p Expr) (n Int) (k Int)) (Pair Tr Expr)
  (measure (struct data))
  (match data
    (Nil (Pair t e))
    ((Cons fv r) (match (tr_subst t e (fvar_id_of fv) (wf_proj p n k)) ((Pair t1 e1) (pj_subst_projs t1 e1 r p n (+ k 1)))))))
(fn wf_reachable ((t Tr)) Bool
  (bool_and (has_const t (n2 (quote WellFounded) (quote fix)))
  (bool_and (has_const t (n2 (quote InvImage) (quote wf)))
  (bool_and (has_const t (n2 (quote Nat) (quote lt_wfRel)))
  (bool_and (has_const t (n2 (quote WellFoundedRelation) (quote wf)))
            (has_const t (n2 (quote PProd) (quote mk))))))))
(fn has_const ((t Tr) (n Name)) Bool (match (env_find (tr_env t) n) ((Some _) True) (None False)))
(fn local_types ((t Tr) (fvs (List Expr)) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct fvs))
  (match fvs
    (Nil (Pair t (rev acc)))
    ((Cons fv r) (match (tr_type_of_local t fv) ((Some ty) (local_types t r (Cons ty acc))) (None (local_types t r acc))))))
;; the measure's L type is Nat
(fn measure_is_nat ((t Tr) (ml Expr)) (Pair Tr Bool)
  (match (tr_infer t ml)
    ((Pair t1 None) (Pair t1 False))
    ((Pair t1 (Some ty))
     (match (tr_whnf t1 ty)
       ((Pair t2 (Some (Const _ n _))) (Pair t2 (name_eq n (nm_nat))))
       ((Pair t2 _) (Pair t2 False))))))
;; the relation `InvImage Nat.lt_wfRel.rel m` and its well-foundedness `InvImage.wf m Nat.lt_wfRel.wf`
(fn wf_relation ((t Tr) (alpha Expr) (mfn Expr)) (Pair Tr (Pair Expr Expr))
  (let ((nat (mk_const (nm_nat) Nil)) (wfrel (mk_const (n2 (quote Nat) (quote lt_wfRel)) Nil)))
    (match (tr_apps t (mk_const (n2 (quote WellFoundedRelation) (quote rel)) (list (level_one))) (list nat wfrel))
      ((Pair t1 rnat)
       (match (tr_apps t1 (mk_const (n1 (quote InvImage)) (list (level_one) (level_one))) (list alpha nat rnat mfn))
         ((Pair t2 rel)
          (match (tr_apps t2 (mk_const (n2 (quote WellFoundedRelation) (quote wf)) (list (level_one))) (list nat wfrel))
            ((Pair t3 hnat)
             (match (tr_apps t3 (mk_const (n2 (quote InvImage) (quote wf)) (list (level_one) (level_one))) (list alpha nat rnat mfn hnat))
               ((Pair t4 hwf) (Pair t4 (Pair rel hwf))))))))))))
;; ∀ (q : α), rel q p → RET
(fn wf_rec_type ((t Tr) (alpha Expr) (rel Expr) (p Expr) (rl Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote q)) alpha)
    ((Pair t1 q)
     (match (tr_apps t1 rel (list q p))
       ((Pair t2 hty)
        (match (tr_local t2 (n1 (quote h)) hty)
          ((Pair t3 h) (match (tr_pis t3 (list q h) rl) ((Pair t4 e) (Pair t4 e))))))))))

;; ---- the walk over the body -------------------------------------------------------------------------
;; only a subterm that cites the self-local is rebuilt: a self-call by the recursion's rule; a
;; matcher application with its alternatives' variables in scope, its motive carrying the
;; tables its scrutinee refines (pj_match); `ite` as `Decidable.rec` with the branch's proof a
;; local (rule 2: wherever it stands); a let and a lambda with their local in scope
(fn pj_term ((t Tr) (cx PjCx) (e Expr) (fuel Int)) TrRes
  (measure fuel)
  (if (lt fuel 1) (TrErr (quote define_depth) "a body too deep")
  (if (bool_not (mentions_any e (list (PjCx.self cx)))) (TrOk t e)
  (match e
    ((Lam _ n _ dom b)
     (match (tr_local t n dom)
       ((Pair t1 fv)
        (match (tr_inst1 t1 b fv)
          ((Pair t2 b1)
           (match (pj_term t2 (pj_push cx False (list fv)) b1 (- fuel 1))
             ((TrErr x m) (TrErr x m))
             ((TrOk t3 b2) (match (tr_lams t3 (list fv) b2) ((Pair t4 r) (TrOk t4 r))))))))))
    ((Let _ n ty v b)
     (match (pj_term t cx v (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t1 v1)
        (match (tr_local_val t1 n ty v1)
          ((Pair t2 fv)
           (match (tr_inst1 t2 b fv)
             ((Pair t3 b1)
              (match (pj_term t3 (pj_push cx True (list fv)) b1 (- fuel 1))
                ((TrErr x m) (TrErr x m))
                ((TrOk t4 b2) (match (tr_lams t4 (list fv) b2) ((Pair t5 r) (TrOk t5 r))))))))))))
    ((Proj _ s i x)
     (match (pj_term t cx x (- fuel 1)) ((TrErr y m) (TrErr y m)) ((TrOk t1 x1) (TrOk t1 (mk_proj s i x1)))))
    ((Pi _ _ _ _ _) (TrErr (quote function_value) "the function's own name in a type"))
    (_ (pj_app t cx (get_app_fn e) (get_app_args e) (- fuel 1)))))))
(fn pj_app ((t Tr) (cx PjCx) (head Expr) (args (List Expr)) (fuel Int)) TrRes
  (measure fuel)
  (if (lt fuel 1) (TrErr (quote define_depth) "a body too deep")
  (match head
    ((FVar _ id) (if (int_eq id (PjCx.self cx)) (pj_self t cx args fuel) (pj_plain t cx head args fuel)))
    ((Const _ c ls)
     (if (bool_and (name_eq c (n1 (quote ite))) (le 5 (len args))) (pj_ite t cx args fuel)
       (match (mt_is_matcher (tr_env t) c)
         ((Some (MtDesc np 1 rows)) (if (le (+ np (+ 2 (len rows))) (len args)) (pj_match t cx c ls np rows args fuel) (pj_plain t cx head args fuel)))
         (_ (pj_plain t cx head args fuel)))))
    (_
     (match (pj_term t cx head (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t1 h1) (pj_plain t1 cx h1 args fuel)))))))
(fn pj_plain ((t Tr) (cx PjCx) (head Expr) (args (List Expr)) (fuel Int)) TrRes
  (match (pj_terms t cx args fuel Nil)
    ((Pair _ (Left2 x m)) (TrErr x m))
    ((Pair t1 (Right2 (Pair args1 _))) (match (tr_apps t1 head args1) ((Pair t2 r) (TrOk t2 r))))))
(fn pj_terms ((t Tr) (cx PjCx) (es (List Expr)) (fuel Int) (acc (List Expr))) (Pair Tr Either2)
  (measure (struct es))
  (match es
    (Nil (Pair t (Right2 (Pair (rev acc) (mk_sort (level_one))))))
    ((Cons e r)
     (match (pj_term t cx e (- fuel 1))
       ((TrErr x m) (Pair t (Left2 x m)))
       ((TrOk t1 e1) (pj_terms t1 cx r fuel (Cons e1 acc)))))))

;; a self-call: the type arguments the function's own (no polymorphic recursion), then by the
;; recursion — the table's entry for the structural argument applied to the others, or `rec`
;; at the arguments' tuple with the obligation f.dec_N over every local in scope
(fn pj_self ((t Tr) (cx PjCx) (args (List Expr)) (fuel Int)) TrRes
  (let ((nt (len (PjCx.tps cx))))
    (if (bool_not (pj_exprs_eq (take nt args) (PjCx.tps cx))) (TrErr (quote realize_descent) (append (show_name (Tr.id t)) ": a recursive call at other type arguments (polymorphic recursion)"))
    (match (pj_terms t cx (drop nt args) fuel Nil)
      ((Pair _ (Left2 x m)) (TrErr x m))
      ((Pair t1 (Right2 (Pair dargs _)))
       (match (PjCx.kind cx)
         ((PkStruct cid pos)
          (match (nth dargs pos)
            (None (TrErr (quote function_value) (append (show_name (Tr.id t1)) ": its own name is not applied to its structural argument (no function values, §4)")))
            ((Some y)
             (match (pj_find t1 (PjCx.tables cx) cid y)
               ((Pair _ None) (TrErr (quote realize_descent) (append (show_name (Tr.id t1)) (append ": a recursive call does not pass a proper subterm of the structural parameter — " (show_expr y)))))
               ((Pair t2 (Some entry)) (match (tr_apps t2 entry (without_index dargs pos 0)) ((Pair t3 r) (TrOk t3 r))))))))
         ((PkWf recl p rel ltys)
          (let ((n (len ltys)))
            (if (lt (len dargs) n) (TrErr (quote function_value) (append (show_name (Tr.id t1)) ": its own name is not applied to all its arguments (no function values, §4)"))
            (if (pj_own_params (take n dargs) p n 0) (TrErr (quote realize_descent) (append (show_name (Tr.id t1)) " calls itself on its own parameters — no measure decreases (§7.5)"))
            (match (wf_tuple t1 ltys (take n dargs))
              ((Pair t2 tup)
               (match (tr_apps t2 rel (list tup p))
                 ((Pair t3 goal)
                  (match (tr_pis t3 (scope_fvars (PjCx.scope cx)) goal)
                    ((Pair t4 stmt)
                     (let ((dr (dr_of t4)))
                       (let ((name (name_append (Tr.id t4) (n1 (sym_of_chars (append "dec_" (show_nat (+ 1 (len (DefRec.obls dr))))))))))
                         (match (tr_apps t4 (mk_const name Nil) (scope_lambda_fvars (PjCx.scope cx)))
                           ((Pair t5 proof)
                            (match (tr_apps t5 recl (Cons tup (Cons proof (drop n dargs))))
                              ((Pair t6 r) (TrOk (tr_set_rec t6 (Some (dr_add_obl dr (AxiomDecl (ConstantVal name Nil stmt) False)))) r)))))))))))))))))))))))
(fn dr_of ((t Tr)) DefRec (match (Tr.rec t) ((Some dr) dr) (None (def_rec (- 0 1) Nil False))))
(fn pj_exprs_eq ((as (List Expr)) (bs (List Expr))) Bool
  (measure (struct as))
  (match as
    (Nil (match bs (Nil True) (_ False)))
    ((Cons a r) (match bs ((Cons b br) (if (expr_eq a b) (pj_exprs_eq r br) False)) (Nil False)))))
(fn pj_own_params ((args (List Expr)) (p Expr) (n Int) (k Int)) Bool
  (measure (struct args))
  (match args
    (Nil True)
    ((Cons a r) (if (expr_eq a (wf_proj p n k)) (pj_own_params r p n (+ k 1)) False))))

;; `ite c inst a b` inside a recursive function: `Decidable.rec` with a constant motive, the
;; proof of ¬c a local of the else-branch and of c the then-branch's (rule 2; slice 3.14's shape)
(fn pj_ite ((t Tr) (cx PjCx) (args (List Expr)) (fuel Int)) TrRes
  (match args
    ((Cons alpha (Cons c (Cons inst (Cons a (Cons b extra)))))
     (match (pj_term t cx inst (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t1 inst1)
        (match (pj_branch t1 cx (n2 (quote Decidable) (quote isFalse)) c b fuel)
          ((TrErr x m) (TrErr x m))
          ((TrOk t2 mf)
           (match (pj_branch t2 cx (n2 (quote Decidable) (quote isTrue)) c a fuel)
             ((TrErr x m) (TrErr x m))
             ((TrOk t3 mt)
              (match (rec_app t3 (n1 (quote Decidable)) Nil (list c) alpha (list mf mt) inst1)
                ((TrErr x m) (TrErr x m))
                ((TrOk t4 r) (pj_plain t4 cx r extra fuel))))))))))
    (_ (TrErr (quote define_matrix) "ite"))))
(fn pj_branch ((t Tr) (cx PjCx) (ctor Name) (c Expr) (body Expr) (fuel Int)) TrRes
  (match (rz_open_ctor t ctor Nil (list c))
    ((Pair _ None) (TrErr (quote equation_form) (append (show_name ctor) ": K could not open the constructor")))
    ((Pair t1 (Some (Pair fields _)))
     (match (pj_term t1 (pj_push cx False (field_fvars fields)) body (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t2 b) (match (tr_lams t2 (field_fvars fields) b) ((Pair t3 r) (TrOk t3 r))))))))

;; a matcher application `match_N params motive s alt…`: each alternative rebuilt under its
;; row's variables. Where s is a local that tables' types mention (a structural recursion),
;; the motive becomes `λ s' . B[s'] → motive s'` at the universe K infers, each alternative
;; takes the refined tables `B[pattern]` as its last binders, and the application is applied to
;; the tables (Lean's MatcherApp.addArg): the matcher K checked is the case tree, never unfolded
(fn pj_match ((t Tr) (cx PjCx) (c Name) (ls (List Level)) (np Int) (rows (List (List MtPat))) (args (List Expr)) (fuel Int)) TrRes
  (let ((params (take np args)) (nalts (len rows)))
    (match (drop np args)
      ((Cons motive (Cons s rest))
       (match motive
         ((Lam _ _ _ dty mbody)
          (match (pj_term t cx s (- fuel 1))
            ((TrErr x m) (TrErr x m))
            ((TrOk t1 s1)
             (let ((gen (pj_tables_on (PjCx.tables cx) s1)))
               (match (pj_motive t1 gen s1 dty mbody ls)
                 ((Pair _ None) (TrErr (quote define_matrix) "K could not type a matcher's generalized motive"))
                 ((Pair t2 (Some (Pair motive1 ls1)))
                  (match (pj_alts t2 cx gen (fvar_id_of s1) dty rows (take nalts rest) fuel Nil)
                    ((Pair _ (Left2 x m)) (TrErr x m))
                    ((Pair t3 (Right2 (Pair alts1 _)))
                     (match (tr_apps t3 (mk_const c ls1) (append params (Cons motive1 (Cons s1 (append alts1 (firsts_of gen))))))
                       ((Pair t4 r) (pj_plain t4 cx r (drop nalts rest) fuel)))))))))))
         (_ (TrErr (quote define_matrix) "a matcher's motive is not a lambda"))))
      (_ (TrErr (quote define_matrix) "a matcher without its scrutinee")))))
;; the tables whose type (over the abstract motive) mentions the scrutinee, when it is a local
(fn pj_tables_on ((tables (List (Pair Expr Expr))) (s Expr)) (List (Pair Expr Expr))
  (measure (struct tables))
  (match s
    ((FVar _ id)
     (match tables
       (Nil Nil)
       ((Cons (Pair b ty) r) (if (mentions_any ty (list id)) (Cons (Pair b ty) (pj_tables_on r s)) (pj_tables_on r s)))))
    (_ Nil)))
(fn firsts_of ((ps (List (Pair Expr Expr)))) (List Expr)
  (measure (struct ps))
  (match ps (Nil Nil) ((Cons (Pair a _) r) (Cons a (firsts_of r)))))
;; the motive and the matcher's levels: unchanged without tables; else generalized, its universe
;; K's sort of the generalized result
(fn pj_motive ((t Tr) (gen (List (Pair Expr Expr))) (s Expr) (dty Expr) (mbody Expr) (ls (List Level))) (Pair Tr (Option (Pair Expr (List Level))))
  (match (tr_local t (n1 (quote x)) dty)
    ((Pair t1 s0)
     (match (tr_inst1 t1 mbody s0)
       ((Pair t2 ret0)
        (match gen
          (Nil (match (tr_lams t2 (list s0) ret0) ((Pair t3 m1) (Pair t3 (Some (Pair m1 ls))))))
          (_
           (match (pj_table_locals t2 gen (fvar_id_of s) s0 Nil)
             ((Pair t3 glocals)
              (match (tr_pis t3 (firsts_of glocals) ret0)
                ((Pair t4 pi)
                 (match (tr_infer t4 pi)
                   ((Pair t5 None) (Pair t5 None))
                   ((Pair t5 (Some srt))
                    (match (tr_whnf t5 srt)
                      ((Pair t6 (Some (Sort _ l)))
                       (match (tr_lams t6 (list s0) pi)
                         ((Pair t7 m1) (Pair t7 (Some (Pair m1 (Cons l (drop 1 ls))))))))
                      ((Pair t6 _) (Pair t6 None))))))))))))))))
;; for each table a fresh local at its real type with the scrutinee replaced, paired with its
;; abstract type replaced the same way
(fn pj_table_locals ((t Tr) (gen (List (Pair Expr Expr))) (sid Int) (v Expr) (acc (List (Pair Expr Expr)))) (Pair Tr (List (Pair Expr Expr)))
  (measure (struct gen))
  (match gen
    (Nil (Pair t (rev acc)))
    ((Cons (Pair b babs) r)
     (match (tr_type_of_local t b)
       (None (pj_table_locals t r sid v acc))
       ((Some breal)
        (match (tr_subst t breal sid v)
          ((Pair t1 breal1)
           (match (tr_subst t1 babs sid v)
             ((Pair t2 babs1)
              (match (tr_local t2 (n1 (quote below)) breal1)
                ((Pair t3 fv) (pj_table_locals t3 r sid v (Cons (Pair fv babs1) acc)))))))))))))
(fn pj_alts ((t Tr) (cx PjCx) (gen (List (Pair Expr Expr))) (sid Int) (dty Expr) (rows (List (List MtPat))) (alts (List Expr)) (fuel Int) (acc (List Expr))) (Pair Tr Either2)
  (measure (struct rows))
  (match rows
    (Nil (Pair t (Right2 (Pair (rev acc) dty))))
    ((Cons row rr)
     (match alts
       (Nil (Pair t (Left2 (quote define_matrix) "a matcher with fewer alternatives than rows")))
       ((Cons alt ar)
        (match row
          ((Cons pat Nil)
           (match (mt_pat_term (Tr.w t) pat dty Nil 256)
             ((MtPtErr x m) (Pair t (Left2 x m)))
             ((MtPtOk w1 pterm vars)
              (match (pj_inst_lams (tr_set_w t w1) alt vars)
                ((Pair t1 body)
                 (match (pj_table_locals t1 gen sid pterm Nil)
                   ((Pair t2 tlocals)
                    (let ((cx1 (pj_push (with PjCx cx (tables (append tlocals (PjCx.tables cx)))) False (append vars (firsts_of tlocals)))))
                      (match (pj_term t2 cx1 body (- fuel 1))
                        ((TrErr x m) (Pair t2 (Left2 x m)))
                        ((TrOk t3 b)
                         (match (tr_lams t3 (append vars (firsts_of tlocals)) b)
                           ((Pair t4 alt1) (pj_alts t4 cx gen sid dty rr ar fuel (Cons alt1 acc))))))))))))))
          (_ (Pair t (Left2 (quote define_matrix) "a matcher row over several scrutinees")))))))))
;; an alternative at its variables: each lambda's body instantiated, else applied
(fn pj_inst_lams ((t Tr) (e Expr) (vars (List Expr))) (Pair Tr Expr)
  (measure (struct vars))
  (match vars
    (Nil (Pair t e))
    ((Cons v r)
     (match e
       ((Lam _ _ _ _ b) (match (tr_inst1 t b v) ((Pair t1 b1) (pj_inst_lams t1 b1 r))))
       (_ (match (tr_apps t e (list v)) ((Pair t1 e1) (pj_inst_lams t1 e1 r))))))))

;; ---- the equations (§7.5; slice 3.16 landing 3) ----------------------------------------------------
;; the leaves of the body's leading matchers, read off the rows without reduction: a row
;; against the scrutinee term binds, clashes, or is stuck on a local — a universally quantified
;; one is split over its constructors, in order, the first row that does not clash deciding —
;; so the leaves and their numbering are the case tree's, a fall-through row one equation per
;; leaf it reaches. `∀ kept, f lhs = rhs`, the self-local the constant, by Eq.refl
(type PjLeaf (PjLeaf (List Expr) (List Expr) Expr Expr))   ; the left-hand side's arguments, the binders, the result type, the body
(type PjFo (FoBind (List (Pair Int Expr))) (FoClash) (FoStuck Int))
(fn pj_equations ((t Tr) (pd PreDef) (rl Expr) (selfid Int)) (Pair Tr Either3)
  (match (pj_leaves t (pd_binders pd) (pd_binders pd) rl (pd_body pd) 256 Nil)
    ((Pair t1 None) (Pair t1 (Left3 (quote equation_form) "a constructor no row covers")))
    ((Pair t1 (Some lvs)) (pj_equation_decls t1 selfid (rev lvs) 1 Nil))))
(fn pj_leaves ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure fuel)
  (if (lt fuel 1) (Pair t None)
  (match (get_app_fn body)
    ((Const _ c _)
     (match (mt_is_matcher (tr_env t) c)
       ((Some (MtDesc np 1 rows))
        (let ((args (get_app_args body)))
          (if (bool_not (int_eq (len args) (+ np (+ 2 (len rows))))) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))
            (match (nth args (+ np 1))
              (None (Pair t None))
              ((Some s) (pj_rows t lhs kept rl body s rows (drop (+ np 2) args) fuel acc))))))
       (_ (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc))))))
    (_ (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))))))
(fn pj_rows ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (s Expr) (rows (List (List MtPat))) (alts (List Expr)) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure (struct rows))
  (match rows
    (Nil (Pair t None))
    ((Cons row rr)
     (match alts
       (Nil (Pair t None))
       ((Cons alt ar)
        (match (pj_fo_all (tr_env t) row (list s) (FoBind Nil))
          (FoClash (pj_rows t lhs kept rl body s rr ar fuel acc))
          ((FoBind binds)
           (match (pj_inst_lams t alt (pj_slot_args binds (len binds) 0))
             ((Pair t1 b1) (pj_leaves t1 lhs kept rl b1 (- fuel 1) acc))))
          ((FoStuck vid)
           (if (bool_not (mem_int vid (fvar_ids kept))) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc)))
             (pj_split t lhs kept rl body vid fuel acc)))))))))
(fn pj_slot_args ((binds (List (Pair Int Expr))) (n Int) (i Int)) (List Expr)
  (measure (- n i))
  (if (le n i) Nil
    (Cons (match (assoc_int_expr i binds) ((Some v) v) (None (mk_const Anon Nil))) (pj_slot_args binds n (+ i 1)))))
;; a row's patterns against terms: a clash anywhere decides (the row is gone from the
;; specialized matrix), else the first stuck local, else the bindings
(fn pj_fo_all ((env CheckedEnv) (ps (List MtPat)) (ts (List Expr)) (st PjFo)) PjFo
  (measure (struct ps))
  (match ps
    (Nil st)
    ((Cons p pr)
     (match ts
       (Nil st)
       ((Cons x xr)
        (match (pj_fo env p x st)
          (FoClash FoClash)
          (st1 (pj_fo_all env pr xr st1))))))))
(fn pj_fo ((env CheckedEnv) (p MtPat) (x Expr) (st PjFo)) PjFo
  (measure (struct p))
  (match p
    ((MtVar slot) (match st ((FoBind binds) (FoBind (Cons (Pair slot x) binds))) (other other)))
    ((MtCtor c subs)
     (match (get_app_fn x)
       ((FVar _ id) (match st ((FoBind _) (FoStuck id)) (other other)))
       ((Const _ c2 _)
        (if (name_eq c c2) (pj_fo_all env subs (drop (- (len (get_app_args x)) (len subs)) (get_app_args x)) st)
          (if (pj_is_ctor env c2) FoClash (match st ((FoBind _) (FoStuck (- 0 1))) (other other)))))
       (_ (match st ((FoBind _) (FoStuck (- 0 1))) (other other)))))))
(fn pj_is_ctor ((env CheckedEnv) (c Name)) Bool
  (match (env_find env c) ((Some (CtorInfo _ _ _ _ _ _)) True) (_ False)))
;; the local split over its inductive's constructors: the constructor term for it in the
;; left-hand side, the result type and the body, its fields new binders
(fn pj_split ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (vid Int) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (match (w_local_type (Tr.w t) vid)
    (None (Pair t None))
    ((Some vty)
     (match (mt_ind_of (Tr.w t) vty)
       ((Pair _ (MtNoInd _ _)) (Pair t (Some (Cons (PjLeaf lhs kept rl body) acc))))
       ((Pair w1 (MtInd _ ls largs ctors)) (pj_split_ctors (tr_set_w t w1) lhs kept rl body vid ctors ls largs fuel acc))))))
(fn pj_split_ctors ((t Tr) (lhs (List Expr)) (kept (List Expr)) (rl Expr) (body Expr) (vid Int) (ctors (List Name)) (ls (List Level)) (largs (List Expr)) (fuel Int) (acc (List PjLeaf))) (Pair Tr (Option (List PjLeaf)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some acc)))
    ((Cons c r)
     (match (rz_open_ctor t c ls largs)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fields cterm)))
        (match (subst_all t1 lhs vid cterm Nil)
          ((Pair t2 lhs1)
           (match (tr_subst t2 rl vid cterm)
             ((Pair t3 rl1)
              (match (tr_subst t3 body vid cterm)
                ((Pair t4 body1)
                 (match (refresh_kept t4 (without_id kept vid) vid cterm Nil Nil)
                   ((Pair t5 (Pair kept0 pairs))
                    (match (pj_subst_pairs_all t5 lhs1 pairs Nil)
                      ((Pair t6 lhs2)
                       (match (subst_pairs t6 rl1 pairs)
                         ((Pair t7 rl2)
                          (match (subst_pairs t7 body1 pairs)
                            ((Pair t8 body2)
                             (match (pj_leaves t8 lhs2 (append kept0 (field_fvars fields)) rl2 body2 (- fuel 1) acc)
                               ((Pair t9 None) (Pair t9 None))
                               ((Pair t9 (Some acc1)) (pj_split_ctors t9 lhs kept rl body vid r ls largs fuel acc1))))))))))))))))))))))
(fn pj_subst_pairs_all ((t Tr) (es (List Expr)) (pairs (List (Pair Int Expr))) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct es))
  (match es
    (Nil (Pair t (rev acc)))
    ((Cons e r) (match (subst_pairs t e pairs) ((Pair t1 e1) (pj_subst_pairs_all t1 r pairs (Cons e1 acc)))))))
(fn pj_equation_decls ((t Tr) (selfid Int) (lvs (List PjLeaf)) (i Int) (acc (List Declaration))) (Pair Tr Either3)
  (measure (struct lvs))
  (match lvs
    (Nil (Pair t (Right3 (rev acc))))
    ((Cons (PjLeaf lhs kept rl body) r)
     (let ((self (mk_const (Tr.id t) Nil)))
       (match (tr_subst t body selfid self)
         ((Pair t1 rhs)
          (match (tr_apps t1 self lhs)
            ((Pair t2 lhs1)
             (match (tr_apps t2 (mk_const (nm_eq) (list (level_one))) (list rl lhs1 rhs))
               ((Pair t3 stmt)
                (match (tr_pis t3 kept stmt)
                  ((Pair t4 ty)
                   (match (tr_apps t4 (mk_const (nm_eq_refl) (list (level_one))) (list rl lhs1))
                     ((Pair t5 proof)
                      (match (tr_lams t5 kept proof)
                        ((Pair t6 value)
                         (let ((name (name_append (Tr.id t6) (nm_eq_n i))))   ; a fn's identity is its module's already
                           (pj_equation_decls t6 selfid r (+ i 1) (Cons (ThmDecl (ConstantVal name Nil ty) value (list name)) acc)))))))))))))))))))

;; ---- below and brecOn (slice 3.14 rule 1) ----------------------------------------------------------
;; Init's under Lean's names at solved levels; a native inductive's generated once, monomorphic,
;; and admitted before the definition (DfAux); an Init inductive whose below the prefix does not
;; reach is the obstacle below_unreached
(fn ensure_below ((t Tr) (ind Name) (ls (List Level))) TrAux
  (match (env_find (tr_env t) (name_append ind (n1 (quote below))))
    ((Some _) (AuxOk t Nil))
    (None
     (if (match (es_module (Tr.es t) ind) ((Some m) (name_eq m (init_module))) (None False))
       (AuxErr t (quote below_unreached) (append (show_name ind) ": Init's below is past the prefix in scope"))
     (if (bool_not (pprod_reachable t))
       (AuxErr t (quote below_unreached) (append (show_name ind) ": a table needs Init's PProd and PUnit in scope"))
       (gen_below t ind ls))))))
(fn pprod_reachable ((t Tr)) Bool
  (bool_and (has_const t (n1 (quote PProd)))
  (bool_and (has_const t (n2 (quote PProd) (quote mk)))
  (bool_and (has_const t (n1 (quote PUnit)))
            (has_const t (n2 (quote PUnit) (quote unit)))))))
;; the below and brecOn constants with their levels: Init's solved (the motive's universe 1, the
;; type's 0), a generated one at none
(fn below_names ((t Tr) (ind Name)) (Pair Tr (Option (Pair (Pair Name Name) (List Level))))
  (let ((belowc (name_append ind (n1 (quote below)))) (brecc (name_append ind (n1 (quote brecOn)))))
    (match (env_find (tr_env t) belowc)
      (None (Pair t None))
      ((Some binfo)
       (match (env_find (tr_env t) brecc)
         (None (Pair t None))
         ((Some _)
          (match (solve_aux_levels binfo)
            (None (Pair t None))
            ((Some lsb) (Pair t (Some (Pair (Pair belowc brecc) lsb)))))))))))
;; a constant's level parameters solved so that a `Sort (succ u)` binder is Type (u := 0) and a
;; binder whose codomain is `Sort p` — the motive — lands in Type (p := 1); None if one stays open
(fn solve_aux_levels ((info ConstantInfo)) (Option (List Level))
  (match (aux_sol (ci_type info) Nil)
    (None None)
    ((Some sol) (levels_all (ci_lparams info) sol))))
(fn aux_sol ((ty Expr) (sol (List (Pair Name Level)))) (Option (List (Pair Name Level)))
  (measure (struct ty))
  (match ty
    ((Pi _ _ _ dom body)
     (match (aux_dom dom sol)
       (None None)
       ((Some sol1) (aux_sol body sol1))))
    (_ (Some sol))))
(fn aux_dom ((dom Expr) (sol (List (Pair Name Level)))) (Option (List (Pair Name Level)))
  (match dom
    ((Sort _ (LSucc (LParam u))) (bind_level u LZero sol))
    ((Pi _ _ _ _ body) (match (pi_codomain body) ((Sort _ (LParam p)) (bind_level p (LSucc LZero) sol)) (_ (Some sol))))
    (_ (Some sol))))
(fn pi_codomain ((e Expr)) Expr
  (measure (struct e))
  (match e ((Pi _ _ _ _ b) (pi_codomain b)) (_ e)))
(fn levels_all ((ps (List Name)) (sol (List (Pair Name Level)))) (Option (List Level))
  (measure (struct ps))
  (match ps
    (Nil (Some Nil))
    ((Cons p r)
     (match (assoc_level p sol)
       (None None)
       ((Some l) (match (levels_all r sol) (None None) ((Some ls) (Some (Cons l ls)))))))))

;; T.below (ps) (motive : T ps → Type) (t : T ps) : Type := T.rec (λ _ . Type) minors t, each
;; minor `λ fields ihs . PProd (PProd (motive r_1) ih_1) (… PUnit)` over the recursive fields;
;; T.brecOn (ps) motive (t) (F : ∀ t', T.below ps motive t' → motive t') : motive t :=
;; (T.rec (λ t' . PProd (motive t') (T.below ps motive t')) minors t).1, each minor
;; `λ fields ihs . ⟨F (c fields) TAB, TAB⟩` with TAB the pair nest of the ihs — Lean's own shapes
(fn gen_below ((t Tr) (ind Name) (ls (List Level))) TrAux
  (match (env_find (tr_env t) ind)
    (None (AuxErr t (quote unknown_constant) (show_name ind)))
    ((Some info)
     (match info
       ((InductInfo _ nparams _ _ ctors _ _ _ _)
        (match (w_inst_lparams (Tr.w t) (ci_type info) (ci_lparams info) ls)
          ((Pair w1 ity)
           (match (open_params (tr_set_w t w1) ity nparams Nil)
             ((Pair t1 None) (AuxErr t1 (quote below_unreached) (append (show_name ind) ": its parameters could not be opened")))
             ((Pair t1 (Some ps))
              (match (tr_apps t1 (mk_const ind ls) ps)
                ((Pair t2 tyapp)
                 (match (gen_below_decl t2 ind ls ps tyapp ctors)
                   ((AuxErr t3 e m) (AuxErr t3 e m))
                   ((AuxOk t3 bds)
                    (match (gen_brecon_decl t3 ind ls ps tyapp ctors)
                      ((AuxErr t4 e m) (AuxErr t4 e m))
                      ((AuxOk t4 rds) (AuxOk t4 (append bds rds)))))))))))))
       (_ (AuxErr t (quote unknown_constant) (append (show_name ind) " is not an inductive")))))))
;; the inductive's parameters as locals, its type's leading binders
(fn open_params ((t Tr) (ty Expr) (n Int) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure n)
  (if (lt n 1) (Pair t (Some (rev acc)))
    (match ty
      ((Pi _ nm _ dom body)
       (match (tr_local t nm dom)
         ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (open_params t2 body1 (- n 1) (Cons fv acc)))))))
      (_ (Pair t None)))))
(fn gen_below_decl ((t Tr) (ind Name) (ls (List Level)) (ps (List Expr)) (tyapp Expr) (ctors (List Name))) TrAux
  (match (tr_local t (n1 (quote x)) tyapp)
    ((Pair t1 xm)
     (match (tr_pis t1 (list xm) (mk_sort (level_one)))
       ((Pair t2 mty)
        (match (tr_local t2 (n1 (quote motive)) mty)
          ((Pair t3 motive)
           (match (tr_local t3 (n1 (quote t)) tyapp)
             ((Pair t4 tv)
              (match (below_minors t4 motive ls ps ctors Nil)
                ((Pair t5 (Left2 e m)) (AuxErr t5 e m))
                ((Pair t5 (Right2 (Pair minors _)))
                 (match (tr_local t5 (n1 (quote x)) tyapp)
                   ((Pair t6 xm2)
                    (match (tr_lams t6 (list xm2) (mk_sort (level_one)))
                      ((Pair t7 rmotive)
                       (match (rec_app_dep t7 (LSucc (LSucc LZero)) ind ls ps rmotive minors tv)
                         ((TrErr e m) (AuxErr t7 e m))
                         ((TrOk t8 value0)
                          (match (tr_lams t8 (append ps (list motive tv)) value0)
                            ((Pair t9 value)
                             (match (tr_pis t9 (append ps (list motive tv)) (mk_sort (level_one)))
                               ((Pair t10 ty)
                                (let ((n (name_append ind (n1 (quote below)))))
                                  (AuxOk t10 (list (DefnDecl (ConstantVal n Nil ty) value (HRegular 1) Safe (list n))))))))))))))))))))))))))
;; below's minors: for each constructor, the pair nest over its recursive fields (the ihs Type)
(fn below_minors ((t Tr) (motive Expr) (ls (List Level)) (ps (List Expr)) (ctors (List Name)) (acc (List Expr))) (Pair Tr Either2)
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Right2 (Pair (rev acc) motive))))
    ((Cons c r)
     (match (rz_open_ctor t c ls ps)
       ((Pair t1 None) (Pair t1 (Left2 (quote equation_form) (append (show_name c) ": K could not open the constructor"))))
       ((Pair t1 (Some (Pair fields _)))
        (match (open_ihs t1 fields (mk_sort (level_one)) Nil)
          ((Pair t2 ihs)
           (match (below_nest t2 motive (recursive_fields fields) ihs)
             ((Pair t3 body)
              (match (tr_lams t3 (append (field_fvars fields) ihs) body)
                ((Pair t4 minor) (below_minors t4 motive ls ps r (Cons minor acc)))))))))))))
(fn recursive_fields ((fields (List Field))) (List Expr)
  (measure (struct fields))
  (match fields
    (Nil Nil)
    ((Cons (Field fv _ True) r) (Cons fv (recursive_fields r)))
    ((Cons _ r) (recursive_fields r))))
;; PProd (motive r_1) ih_1 alone, PProd (PProd (motive r_1) ih_1) (…) for more, PUnit for none
(fn below_nest ((t Tr) (motive Expr) (rs (List Expr)) (ihs (List Expr))) (Pair Tr Expr)
  (measure (struct rs))
  (match rs
    (Nil (Pair t (punit_ty)))
    ((Cons r rr)
     (match ihs
       (Nil (Pair t (punit_ty)))
       ((Cons ih ir)
        (match (tr_apps t motive (list r))
          ((Pair t1 mr)
           (match (tr_apps t1 (pprod_ty) (list mr ih))
             ((Pair t2 pair)
              (match rr
                (Nil (Pair t2 pair))
                (_ (match (below_nest t2 motive rr ir)
                     ((Pair t3 rest) (match (tr_apps t3 (pprod_ty) (list pair rest)) ((Pair t4 e) (Pair t4 e))))))))))))))))
(fn pprod_ty () Expr (mk_const (n1 (quote PProd)) (list (level_one) (level_one))))
(fn pprod_mk () Expr (mk_const (n2 (quote PProd) (quote mk)) (list (level_one) (level_one))))
(fn punit_ty () Expr (mk_const (n1 (quote PUnit)) (list (level_one))))
(fn punit_unit () Expr (mk_const (n2 (quote PUnit) (quote unit)) (list (level_one))))
(fn gen_brecon_decl ((t Tr) (ind Name) (ls (List Level)) (ps (List Expr)) (tyapp Expr) (ctors (List Name))) TrAux
  (let ((belowc (name_append ind (n1 (quote below)))))
    (match (tr_local t (n1 (quote x)) tyapp)
      ((Pair t1 xm)
       (match (tr_pis t1 (list xm) (mk_sort (level_one)))
         ((Pair t2 mty)
          (match (tr_local t2 (n1 (quote motive)) mty)
            ((Pair t3 motive)
             (match (tr_local t3 (n1 (quote t)) tyapp)
               ((Pair t4 tv)
                (match (functional_type t4 belowc ps motive tyapp)
                  ((Pair t5 fty)
                   (match (tr_local t5 (n1 (quote F)) fty)
                     ((Pair t6 fl)
                      (match (brec_motive t6 belowc ps motive tyapp)
                        ((Pair t7 rmotive)
                         (match (brecon_minors t7 belowc ps motive fl ls ctors Nil)
                           ((Pair t8 (Left2 e m)) (AuxErr t8 e m))
                           ((Pair t8 (Right2 (Pair minors _)))
                            (match (rec_app_dep t8 (level_one) ind ls ps rmotive minors tv)
                              ((TrErr e m) (AuxErr t8 e m))
                              ((TrOk t9 recv)
                               (match (tr_lams t9 (append ps (list motive tv fl)) (mk_proj (n1 (quote PProd)) 0 recv))
                                 ((Pair t10 value)
                                  (match (tr_apps t10 motive (list tv))
                                    ((Pair t11 mt)
                                     (match (tr_pis t11 (append ps (list motive tv fl)) mt)
                                       ((Pair t12 ty)
                                        (let ((n (name_append ind (n1 (quote brecOn)))))
                                          (AuxOk t12 (list (DefnDecl (ConstantVal n Nil ty) value (HRegular 2) Safe (list n)))))))))))))))))))))))))))))))
;; ∀ (t' : T ps), T.below ps motive t' → motive t'
(fn functional_type ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (tyapp Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote t)) tyapp)
    ((Pair t1 tp)
     (match (tr_apps t1 (mk_const belowc Nil) (append ps (list motive tp)))
       ((Pair t2 bty)
        (match (tr_local t2 (n1 (quote b)) bty)
          ((Pair t3 bl)
           (match (tr_apps t3 motive (list tp))
             ((Pair t4 mt)
              (match (tr_pis t4 (list tp bl) mt) ((Pair t5 e) (Pair t5 e))))))))))))
;; λ t' . PProd (motive t') (T.below ps motive t')
(fn brec_motive ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (tyapp Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote t)) tyapp)
    ((Pair t1 tp)
     (match (tr_apps t1 motive (list tp))
       ((Pair t2 mt)
        (match (tr_apps t2 (mk_const belowc Nil) (append ps (list motive tp)))
          ((Pair t3 bt)
           (match (tr_apps t3 (pprod_ty) (list mt bt))
             ((Pair t4 pr) (match (tr_lams t4 (list tp) pr) ((Pair t5 e) (Pair t5 e))))))))))))
(fn brecon_minors ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (fl Expr) (ls (List Level)) (ctors (List Name)) (acc (List Expr))) (Pair Tr Either2)
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Right2 (Pair (rev acc) motive))))
    ((Cons c r)
     (match (rz_open_ctor t c ls ps)
       ((Pair t1 None) (Pair t1 (Left2 (quote equation_form) (append (show_name c) ": K could not open the constructor"))))
       ((Pair t1 (Some (Pair fields cterm)))
        (match (dep_ihs t1 belowc ps motive (recursive_fields fields) Nil)
          ((Pair t2 ihs)
           (match (table_nest t2 belowc ps motive (recursive_fields fields) ihs)
             ((Pair t3 (Pair tab tabty))
              (match (tr_apps t3 motive (list cterm))
                ((Pair t4 mc)
                 (match (tr_apps t4 (mk_const belowc Nil) (append ps (list motive cterm)))
                   ((Pair t5 bc)
                    (match (tr_apps t5 fl (list cterm tab))
                      ((Pair t6 fc)
                       (match (tr_apps t6 (pprod_mk) (list mc bc fc tab))
                         ((Pair t7 body)
                          (match (tr_lams t7 (append (field_fvars fields) ihs) body)
                            ((Pair t8 minor) (brecon_minors t8 belowc ps motive fl ls r (Cons minor acc)))))))))))))))))))))
;; one hypothesis per recursive field at PProd (motive r) (T.below ps motive r)
(fn dep_ihs ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (rs (List Expr)) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct rs))
  (match rs
    (Nil (Pair t (rev acc)))
    ((Cons r rr)
     (match (tr_apps t motive (list r))
       ((Pair t1 mr)
        (match (tr_apps t1 (mk_const belowc Nil) (append ps (list motive r)))
          ((Pair t2 br)
           (match (tr_apps t2 (pprod_ty) (list mr br))
             ((Pair t3 ty)
              (match (tr_local t3 (n1 (quote ih)) ty)
                ((Pair t4 ih) (dep_ihs t4 belowc ps motive rr (Cons ih acc)))))))))))))
;; TAB = ih_1 alone, PProd.mk ih_1 (…) for more, PUnit.unit for none — with its type
(fn table_nest ((t Tr) (belowc Name) (ps (List Expr)) (motive Expr) (rs (List Expr)) (ihs (List Expr))) (Pair Tr (Pair Expr Expr))
  (measure (struct rs))
  (match rs
    (Nil (Pair t (Pair (punit_unit) (punit_ty))))
    ((Cons r rr)
     (match ihs
       (Nil (Pair t (Pair (punit_unit) (punit_ty))))
       ((Cons ih ir)
        (match (tr_apps t motive (list r))
          ((Pair t1 mr)
           (match (tr_apps t1 (mk_const belowc Nil) (append ps (list motive r)))
             ((Pair t2 br)
              (match (tr_apps t2 (pprod_ty) (list mr br))
                ((Pair t3 ak)
                 (match rr
                   (Nil (Pair t3 (Pair ih ak)))
                   (_
                    (match (table_nest t3 belowc ps motive rr ir)
                      ((Pair t4 (Pair rest restty))
                       (match (tr_apps t4 (pprod_mk) (list ak restty ih rest))
                         ((Pair t5 e)
                          (match (tr_apps t5 (pprod_ty) (list ak restty))
                            ((Pair t6 ety) (Pair t6 (Pair e ety)))))))))))))))))))))
;; ---- the constructor-structure bundle (slice 3.15; LANGUAGE.md §8.4's slice-3.15 rules) ----------
;; After a native inductive is admitted: T.casesOn (its recursor with the hypotheses unused, universe
;; polymorphic as Lean's), and for a type without parameters and indices whose recursor eliminates
;; into every universe, T.noConfusionType, T.noConfusion and T.c.inj per constructor with fields —
;; Lean 4.33's shapes read off the export (Nat's; a parametric type's shape generalizes the
;; parameters twice with HEq on the fields and eq_of_heq, and is later). Only where Init's Eq,
;; Eq.ndrec, Eq.refl, And and And.intro are in scope — nothing in K's own sources, as Lean's
;; Prelude before Eq has none. K checks each declaration; the generator's failure is nothing
;; generated, never a refusal of the type.
(fn confusion_bundle ((es ESt) (sc Scope) (env CheckedEnv) (ind Name)) (List Declaration)
  (match (env_find env ind)
    ((Some (InductInfo _ nparams nindices all ctors nnested _ _ _))
     (if (bool_or (lt 0 nindices) (bool_or (lt 0 nnested) (bool_not (int_eq (len all) 1)))) Nil
     (match (rec_level env ind)
       (None Nil)
       ((Some u)
        (let ((t (tr_new (w0 env) es sc ind Nil None)))
          (match (gen_cases_on t ind u nparams ctors)
            ((AuxErr _ _ _) Nil)
            ((AuxOk t1 cds)
             (if (bool_or (lt 0 nparams) (bool_not (confusion_reachable env))) cds
               (match (gen_nct t1 ind u ctors)
                 ((AuxErr _ _ _) cds)
                 ((AuxOk t2 nds)
                  (match (gen_nc t2 ind u ctors)
                    ((AuxErr _ _ _) (append cds nds))
                    ((AuxOk t3 ncs)
                     (match (gen_injs t3 ind ctors Nil)
                       ((AuxErr _ _ _) (append cds (append nds ncs)))
                       ((AuxOk _ ijs) (append cds (append nds (append ncs ijs)))))))))))))))))
    (_ Nil)))
;; the recursor's one level parameter (the motive's universe); None for an eliminator into Prop
(fn rec_level ((env CheckedEnv) (ind Name)) (Option Name)
  (match (env_find env (name_append ind (n1 (quote rec))))
    ((Some info) (match (ci_lparams info) ((Cons u Nil) (Some u)) (_ None)))
    (None None)))
(fn confusion_reachable ((env CheckedEnv)) Bool
  (bool_and (has_env env (nm_eq))
  (bool_and (has_env env (nm_eq_refl))
  (bool_and (has_env env (n2 (quote Eq) (quote ndrec)))
  (bool_and (has_env env (n1 (quote And)))
            (has_env env (n2 (quote And) (quote intro))))))))
(fn has_env ((env CheckedEnv) (n Name)) Bool (match (env_find env n) ((Some _) True) (None False)))
(fn nm_cases_on ((ind Name)) Name (name_append ind (n1 (quote casesOn))))
(fn nm_nct ((ind Name)) Name (name_append ind (n1 (quote noConfusionType))))
(fn nm_nc ((ind Name)) Name (name_append ind (n1 (quote noConfusion))))
(fn ctor_short ((c Name)) Name (n1 (sym_of_chars (chars_of_name_last c))))

;; T.casesOn.{u} : ∀ {params} {motive : T params → Sort u} (t : T params) (minors : ∀ fields, motive (c fields))…, motive t
;;   := λ params motive t minors. T.rec.{u} params motive (λ fields ihs. minor_c fields)… t
(fn gen_cases_on ((t Tr) (ind Name) (u Name) (nparams Int) (ctors (List Name))) TrAux
  (match (env_find (tr_env t) ind)
    (None (AuxErr t (quote unknown_constant) (show_name ind)))
    ((Some info)
     (match (open_params_bi t (ci_type info) nparams Nil)
       ((Pair t1 None) (AuxErr t1 (quote equation_form) "the parameters could not be opened"))
       ((Pair t1 (Some ps))
        (match (tr_apps t1 (mk_const ind Nil) ps)
          ((Pair t2 tyapp)
           (match (tr_local t2 (n1 (quote x)) tyapp)
             ((Pair t3 xm)
              (match (tr_pis t3 (list xm) (mk_sort (LParam u)))
                ((Pair t4 mty)
                 (match (tr_local_bi t4 (n1 (quote motive)) mty BImplicit)
                   ((Pair t5 motive)
                    (match (tr_local t5 (n1 (quote t)) tyapp)
                      ((Pair t6 tv)
                       (match (cases_minor_locals t6 motive ps ctors Nil)
                         ((Pair t7 None) (AuxErr t7 (quote equation_form) "a constructor could not be opened"))
                         ((Pair t7 (Some minors))
                          (match (cases_rec_minors t7 motive ps ctors minors Nil)
                            ((Pair t8 None) (AuxErr t8 (quote equation_form) "a constructor could not be opened"))
                            ((Pair t8 (Some rminors))
                             (match (rec_app_dep t8 (LParam u) ind Nil ps motive rminors tv)
                               ((TrErr e m) (AuxErr t8 e m))
                               ((TrOk t9 value0)
                                (let ((binders (append ps (Cons motive (Cons tv minors)))))
                                  (match (tr_lams t9 binders value0)
                                    ((Pair t10 value)
                                     (match (tr_pis t10 binders (mk_app motive tv))
                                       ((Pair t11 ty)
                                        (let ((n (nm_cases_on ind)))
                                          (AuxOk t11 (list (DefnDecl (ConstantVal n (list u) ty) value HAbbrev Safe (list n)))))))))))))))))))))))))))))))
;; the inductive's parameters as implicit locals
(fn open_params_bi ((t Tr) (ty Expr) (n Int) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure n)
  (if (lt n 1) (Pair t (Some (rev acc)))
    (match ty
      ((Pi _ nm _ dom body)
       (match (tr_local_bi t nm dom BImplicit)
         ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (open_params_bi t2 body1 (- n 1) (Cons fv acc)))))))
      (_ (Pair t None)))))
;; a minor local per constructor: minor_c : ∀ fields, motive (c fields)
(fn cases_minor_locals ((t Tr) (motive Expr) (ps (List Expr)) (ctors (List Name)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some (rev acc))))
    ((Cons c r)
     (match (rz_open_ctor t c Nil ps)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fields cterm)))
        (match (tr_pis t1 (field_fvars fields) (mk_app motive cterm))
          ((Pair t2 mty)
           (match (tr_local t2 (ctor_short c) mty)
             ((Pair t3 m) (cases_minor_locals t3 motive ps r (Cons m acc)))))))))))
;; the recursor's minors: λ fields ihs. minor_c fields, each hypothesis at the motive of its field
(fn cases_rec_minors ((t Tr) (motive Expr) (ps (List Expr)) (ctors (List Name)) (minors (List Expr)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some (rev acc))))
    ((Cons c r)
     (match minors
       (Nil (Pair t None))
       ((Cons m mr)
        (match (rz_open_ctor t c Nil ps)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some (Pair fields _)))
           (match (open_ihs_dep t1 fields motive Nil)
             ((Pair t2 ihs)
              (match (tr_apps t2 m (field_fvars fields))
                ((Pair t3 body)
                 (match (tr_lams t3 (append (field_fvars fields) ihs) body)
                   ((Pair t4 minor) (cases_rec_minors t4 motive ps r mr (Cons minor acc)))))))))))))))
(fn open_ihs_dep ((t Tr) (fields (List Field)) (motive Expr) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct fields))
  (match fields
    (Nil (Pair t (rev acc)))
    ((Cons (Field fv _ True) r)
     (match (tr_local t (n1 (quote ih)) (mk_app motive fv)) ((Pair t1 ih) (open_ihs_dep t1 r motive (Cons ih acc)))))
    ((Cons _ r) (open_ihs_dep t r motive acc))))

;; a constructor's fields as locals of a binder info, and the constructor applied to them
;; (a type without parameters: the fields' types are closed)
(fn open_ctor_bi ((t Tr) (c Name) (bi BinderInfo)) (Pair Tr (Option (Pair (List Expr) Expr)))
  (match (env_find (tr_env t) c)
    ((Some info)
     (match (ctor_locals t (ci_type info) bi Nil (budget_depth))
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some fvs))
        (match (tr_apps t1 (mk_const c Nil) fvs)
          ((Pair t2 cterm) (Pair t2 (Some (Pair fvs cterm))))))))
    (None (Pair t None))))
(fn ctor_locals ((t Tr) (ty Expr) (bi BinderInfo) (acc (List Expr)) (fuel Int)) (Pair Tr (Option (List Expr)))
  (measure fuel)
  (if (lt fuel 0) (Pair t None)
  (match ty
    ((Pi _ n _ dom body)
     (if (has_fvar dom) (Pair t None)   ; a dependent field: the HEq shape, later
       (match (tr_local_bi t n dom bi)
         ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (ctor_locals t2 body1 bi (Cons fv acc) (- fuel 1))))))))
    (_ (Pair t (Some (rev acc)))))))
;; the type of a local and the universe of that type
(fn local_type_level ((t Tr) (fv Expr)) (Pair Tr (Option (Pair Expr Level)))
  (match (w_local_type (Tr.w t) (fvar_id_of fv))
    (None (Pair t None))
    ((Some ty)
     (match (tr_infer t ty)
       ((Pair t1 (Some (Sort _ v))) (Pair t1 (Some (Pair ty v))))
       ((Pair t1 _) (Pair t1 None))))))
;; the equations between two openings' fields: f_eq : Eq.{v} F f f' as locals
(fn field_eq_locals ((t Tr) (fs (List Expr)) (fs2 (List Expr)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct fs))
  (match fs
    (Nil (Pair t (Some (rev acc))))
    ((Cons f r)
     (match fs2
       (Nil (Pair t None))
       ((Cons f2 r2)
        (match (local_type_level t f)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some (Pair fty v)))
           (match (tr_apps t1 (mk_const (nm_eq) (list v)) (list fty f f2))
             ((Pair t2 eqty)
              (match (tr_local t2 (n1 (quote f_eq)) eqty)
                ((Pair t3 fe) (field_eq_locals t3 r r2 (Cons fe acc)))))))))))))
(fn ctor_head ((e Expr)) (Option Name) (match (get_app_fn e) ((Const _ c _) (Some c)) (_ None)))

;; T.noConfusionType.{u} : (P : Sort u) → (t t' : T) → Sort u
;;   := λ P t t'. T.casesOn.{succ u} (λ _. Sort u) t (λ fs. T.casesOn.{succ u} (λ _. Sort u) t' (λ fs'. (c = c' ? (∀ (x : ∀ f_eqs, P), P) : P))…)…
(fn gen_nct ((t Tr) (ind Name) (u Name) (ctors (List Name))) TrAux
  (let ((tyc (mk_const ind Nil)) (sortu (mk_sort (LParam u))))
    (match (tr_local t (n1 (quote P)) sortu)
      ((Pair t1 p)
       (match (tr_local t1 (n1 (quote t)) tyc)
         ((Pair t2 t1v)
          (match (tr_local t2 (n1 (quote t')) tyc)
            ((Pair t3 t2v)
             (match (const_motive t3 tyc sortu)
               ((Pair t4 kmotive)
                (match (nct_outer t4 ind u kmotive p t2v ctors ctors Nil)
                  ((Pair t5 None) (AuxErr t5 (quote equation_form) "noConfusionType: a constructor could not be opened"))
                  ((Pair t5 (Some outer))
                   (match (tr_apps t5 (mk_const (nm_cases_on ind) (list (LSucc (LParam u)))) (Cons kmotive (Cons t1v outer)))
                     ((Pair t6 value0)
                      (match (tr_lams t6 (list p t1v t2v) value0)
                        ((Pair t7 value)
                         (match (tr_pis t7 (list p t1v t2v) sortu)
                           ((Pair t8 ty)
                            (let ((n (nm_nct ind)))
                              (AuxOk t8 (list (DefnDecl (ConstantVal n (list u) ty) value (HRegular 1) Safe (list n)))))))))))))))))))))))
;; λ (_ : T). Sort u
(fn const_motive ((t Tr) (tyc Expr) (sortu Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote x)) tyc) ((Pair t1 x) (tr_lams t1 (list x) sortu))))
(fn nct_outer ((t Tr) (ind Name) (u Name) (kmotive Expr) (p Expr) (t2v Expr) (all (List Name)) (ctors (List Name)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some (rev acc))))
    ((Cons c r)
     (match (open_ctor_bi t c BDefault)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fs _)))
        (match (nct_inner t1 c fs p all Nil)
          ((Pair t2 None) (Pair t2 None))
          ((Pair t2 (Some inner))
           (match (tr_apps t2 (mk_const (nm_cases_on ind) (list (LSucc (LParam u)))) (Cons kmotive (Cons t2v inner)))
             ((Pair t3 inner_app)
              (match (tr_lams t3 fs inner_app)
                ((Pair t4 minor) (nct_outer t4 ind u kmotive p t2v all r (Cons minor acc)))))))))))))
(fn nct_inner ((t Tr) (c Name) (fs (List Expr)) (p Expr) (ctors (List Name)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some (rev acc))))
    ((Cons c2 r)
     (match (open_ctor_bi t c2 BDefault)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fs2 _)))
        (match (if (name_eq c c2) (nct_same t1 fs fs2 p) (Pair t1 (Some p)))
          ((Pair t2 None) (Pair t2 None))
          ((Pair t2 (Some body))
           (match (tr_lams t2 fs2 body)
             ((Pair t3 minor) (nct_inner t3 c fs p r (Cons minor acc)))))))))))
;; (∀ (x : ∀ f_eqs, P), P)
(fn nct_same ((t Tr) (fs (List Expr)) (fs2 (List Expr)) (p Expr)) (Pair Tr (Option Expr))
  (match (field_eq_locals t fs fs2 Nil)
    ((Pair t1 None) (Pair t1 None))
    ((Pair t1 (Some eqs))
     (match (tr_pis t1 eqs p)
       ((Pair t2 kty)
        (match (tr_local t2 (n1 (quote x)) kty)
          ((Pair t3 x)
           (match (tr_pis t3 (list x) p) ((Pair t4 r) (Pair t4 (Some r)))))))))))

;; T.noConfusion.{u} : ∀ {P : Sort u} {t t' : T} (eq : Eq t t'), T.noConfusionType P t t'
;;   := λ P t t' eq. Eq.ndrec.{u, w} T t (λ t'. NCT P t t') (T.casesOn.{u} (λ t. NCT P t t) t (λ fs k. k (Eq.refl f)…)…) t' eq
(fn gen_nc ((t Tr) (ind Name) (u Name) (ctors (List Name))) TrAux
  (let ((tyc (mk_const ind Nil)) (sortu (mk_sort (LParam u))))
    (match (tr_infer t tyc)
      ((Pair t0 (Some (Sort _ w)))
       (match (tr_local_bi t0 (n1 (quote P)) sortu BImplicit)
         ((Pair t1 p)
          (match (tr_local_bi t1 (n1 (quote t)) tyc BImplicit)
            ((Pair t2 t1v)
             (match (tr_local_bi t2 (n1 (quote t')) tyc BImplicit)
               ((Pair t3 t2v)
                (match (tr_apps t3 (mk_const (nm_eq) (list w)) (list tyc t1v t2v))
                  ((Pair t4 eqty)
                   (match (tr_local t4 (n1 (quote eq)) eqty)
                     ((Pair t5 eq)
                      (match (nc_motive1 t5 ind u p t1v tyc)
                        ((Pair t6 motive1)
                         (match (nc_cases_motive t6 ind u p tyc)
                           ((Pair t7 cmotive)
                            (match (nc_minors t7 p ctors Nil)
                              ((Pair t8 None) (AuxErr t8 (quote equation_form) "noConfusion: a constructor could not be opened"))
                              ((Pair t8 (Some minors))
                               (match (tr_apps t8 (mk_const (nm_cases_on ind) (list (LParam u))) (Cons cmotive (Cons t1v minors)))
                                 ((Pair t9 inner)
                                  (match (tr_apps t9 (mk_const (n2 (quote Eq) (quote ndrec)) (list (LParam u) w)) (list tyc t1v motive1 inner t2v eq))
                                    ((Pair t10 value0)
                                     (match (tr_lams t10 (list p t1v t2v eq) value0)
                                       ((Pair t11 value)
                                        (match (tr_apps t11 (mk_const (nm_nct ind) (list (LParam u))) (list p t1v t2v))
                                          ((Pair t12 rty)
                                           (match (tr_pis t12 (list p t1v t2v eq) rty)
                                             ((Pair t13 ty)
                                              (let ((n (nm_nc ind)))
                                                (AuxOk t13 (list (DefnDecl (ConstantVal n (list u) ty) value (HRegular 1) Safe (list n))))))))))))))))))))))))))))))))
      ((Pair t0 _) (AuxErr t0 (quote equation_form) "noConfusion: the type's sort")))))
;; λ (t' : T). NCT P t t'
(fn nc_motive1 ((t Tr) (ind Name) (u Name) (p Expr) (t1v Expr) (tyc Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote t')) tyc)
    ((Pair t1 x)
     (match (tr_apps t1 (mk_const (nm_nct ind) (list (LParam u))) (list p t1v x))
       ((Pair t2 body) (tr_lams t2 (list x) body))))))
;; λ (t : T). NCT P t t
(fn nc_cases_motive ((t Tr) (ind Name) (u Name) (p Expr) (tyc Expr)) (Pair Tr Expr)
  (match (tr_local t (n1 (quote t)) tyc)
    ((Pair t1 x)
     (match (tr_apps t1 (mk_const (nm_nct ind) (list (LParam u))) (list p x x))
       ((Pair t2 body) (tr_lams t2 (list x) body))))))
;; λ fs (k : ∀ f_eqs, P). k (Eq.refl f)…  — P is what the continuation's type ends in: the
;; casesOn motive fixes it, so k's type is read off NCT's shape here: ∀ (f_eq : Eq F f f)…, P
(fn nc_minors ((t Tr) (p Expr) (ctors (List Name)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair t (Some (rev acc))))
    ((Cons c r)
     (match (open_ctor_bi t c BDefault)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fs _)))
        (match (nc_k_type t1 p fs)
          ((Pair t2 None) (Pair t2 None))
          ((Pair t2 (Some (Pair kty refls)))
           (match (tr_local t2 (n1 (quote k)) kty)
             ((Pair t3 k)
              (match (tr_apps t3 k refls)
                ((Pair t4 body)
                 (match (tr_lams t4 (append fs (list k)) body)
                   ((Pair t5 minor) (nc_minors t5 p r (Cons minor acc)))))))))))))))
;; the continuation's type over one opening (f = f), and the Eq.refl for each field
(fn nc_k_type ((t Tr) (p Expr) (fs (List Expr))) (Pair Tr (Option (Pair Expr (List Expr))))
  (match (field_eq_locals t fs fs Nil)
    ((Pair t1 None) (Pair t1 None))
    ((Pair t1 (Some eqs))
     (match (tr_pis t1 eqs p)
       ((Pair t3 kty)
        (match (refls_of t3 fs Nil)
          ((Pair t4 None) (Pair t4 None))
          ((Pair t4 (Some refls)) (Pair t4 (Some (Pair kty refls))))))))))
(fn refls_of ((t Tr) (fs (List Expr)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct fs))
  (match fs
    (Nil (Pair t (Some (rev acc))))
    ((Cons f r)
     (match (local_type_level t f)
       ((Pair t1 None) (Pair t1 None))
       ((Pair t1 (Some (Pair fty v)))
        (match (tr_apps t1 (mk_const (nm_eq_refl) (list v)) (list fty f))
          ((Pair t2 rf) (refls_of t2 r (Cons rf acc)))))))))

;; T.c.inj : ∀ {fs} {fs'}, Eq (c fs) (c fs') → And (Eq f1 f1') (And … ) — a constructor with fields
;;   := λ fs fs' h. T.noConfusion.{0} CONJ (c fs) (c fs') h (λ f_eqs. And.intro _ _ e1 (And.intro …))
(fn gen_injs ((t Tr) (ind Name) (ctors (List Name)) (acc (List Declaration))) TrAux
  (measure (struct ctors))
  (match ctors
    (Nil (AuxOk t (rev acc)))
    ((Cons c r)
     (match (open_ctor_bi t c BImplicit)
       ((Pair t1 None) (AuxErr t1 (quote equation_form) "inj: a constructor could not be opened"))
       ((Pair t1 (Some (Pair fs cterm)))
        (match fs
          (Nil (gen_injs t1 ind r acc))
          (_
           (match (open_ctor_bi t1 c BImplicit)
             ((Pair t2 None) (AuxErr t2 (quote equation_form) "inj: a constructor could not be opened"))
             ((Pair t2 (Some (Pair fs2 cterm2)))
              (match (gen_inj t2 ind c fs cterm fs2 cterm2)
                ((AuxErr t3 e m) (AuxErr t3 e m))
                ((AuxOk t3 ds) (gen_injs t3 ind r (append (rev ds) acc)))))))))))))
(fn gen_inj ((t Tr) (ind Name) (c Name) (fs (List Expr)) (cterm Expr) (fs2 (List Expr)) (cterm2 Expr)) TrAux
  (match (tr_infer t (mk_const ind Nil))
    ((Pair t0 (Some (Sort _ w)))
     (match (tr_apps t0 (mk_const (nm_eq) (list w)) (list (mk_const ind Nil) cterm cterm2))
       ((Pair t1 hty)
        (match (tr_local t1 (n1 (quote h)) hty)
          ((Pair t2 h)
           (match (field_eq_locals t2 fs fs2 Nil)
             ((Pair t3 None) (AuxErr t3 (quote equation_form) "inj: a field's type"))
             ((Pair t3 (Some eqs))
              (match (eq_types t3 eqs Nil)
                ((Pair t4 None) (AuxErr t4 (quote equation_form) "inj: an equation's type"))
                ((Pair t4 (Some etys))
                 (let ((conj (and_nest etys)))
                   (match (and_intro_nest t4 etys eqs)
                     ((Pair t5 None) (AuxErr t5 (quote equation_form) "inj: the conjunction"))
                     ((Pair t5 (Some intro))
                      (match (tr_lams t5 eqs intro)
                        ((Pair t6 kont)
                         (match (tr_apps t6 (mk_const (nm_nc ind) (list LZero)) (list conj cterm cterm2 h kont))
                           ((Pair t7 value0)
                            (match (tr_lams t7 (append fs (append fs2 (list h))) value0)
                              ((Pair t8 value)
                               (match (tr_pis t8 (append fs (append fs2 (list h))) conj)
                                 ((Pair t9 ty)
                                  (let ((n (name_append c (n1 (quote inj)))))
                                    (AuxOk t9 (list (ThmDecl (ConstantVal n Nil ty) value (list n)))))))))))))))))))))))))
    ((Pair t0 _) (AuxErr t0 (quote equation_form) "inj: the type's sort"))))
;; the types of the equation locals
(fn eq_types ((t Tr) (eqs (List Expr)) (acc (List Expr))) (Pair Tr (Option (List Expr)))
  (measure (struct eqs))
  (match eqs
    (Nil (Pair t (Some (rev acc))))
    ((Cons e r)
     (match (w_local_type (Tr.w t) (fvar_id_of e))
       (None (Pair t None))
       ((Some ty) (eq_types t r (Cons ty acc)))))))
;; And e1 (And e2 …) — a single equation is itself
(fn and_nest ((etys (List Expr))) Expr
  (measure (struct etys))
  (match etys
    (Nil (mk_const (n1 (quote True)) Nil))
    ((Cons e Nil) e)
    ((Cons e r) (mk_app (mk_app (mk_const (n1 (quote And)) Nil) e) (and_nest r)))))
(fn and_intro_nest ((t Tr) (etys (List Expr)) (eqs (List Expr))) (Pair Tr (Option Expr))
  (measure (struct etys))
  (match etys
    (Nil (Pair t None))
    ((Cons e Nil) (match eqs ((Cons q Nil) (Pair t (Some q))) (_ (Pair t None))))
    ((Cons e r)
     (match eqs
       ((Cons q qr)
        (match (and_intro_nest t r qr)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some rest))
           (match (tr_apps t1 (mk_const (n2 (quote And) (quote intro)) Nil) (list e (and_nest r) q rest))
             ((Pair t2 x) (Pair t2 (Some x)))))))
       (_ (Pair t None))))))
