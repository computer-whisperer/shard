;;; v3/kernel/define.shard — a `fn` as a definition: the K projection of a
;;; pre-definition. predef.shard reads the `fn` once into an L body
;;; over the binders' locals and the self-local; here it becomes a definition K
;;; checks. A body that never cites the self-local is the value under its binders.
;;; A structurally recursive one is `T.brecOn` applied to a functional: a matcher
;;; on a local the course-of-values table's type mentions takes the table through
;;; its motive (Lean's addArg — the matcher stays the constant K checked), and a
;;; self-call is the table's entry, found by type over an abstract motive (a
;;; native inductive's `below` and `brecOn` generated on first need). A measured
;;; one is `WellFounded.fix` over the data binders' tuple, each self-call's
;;; decreasing fact an obligation `f.dec_N` over the type binders and every local in scope, an `ite`
;;; compiled as `Decidable.rec` so the branch's proof is one of them and a
;;; matcher carrying its equation so a row's is one too. The
;;; equations `NAME.eq_N` (one per leaf of the leading matchers: by `Eq.refl`,
;;; a measured function's by `WellFounded.fix_eq`) come with it. Where no
;;; definition comes of it the reason is named with its sentence (DfSkip): the
;;; loader leaves a `fn` its program with that reason and refuses a `def` or a
;;; template, which have no program to be left with. Also here: a native inductive's
;;; `below`/`brecOn` and its constructor-structure bundle.
(import "realize.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.descent)
(use kernel.erase)
(use kernel.kw)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.scope)
(use kernel.realize)
(use kernel.erasure)
(use kernel.erasure.Field)
(use kernel.erasure.TrRes)
(use kernel.sym)
(use kernel.util)
(use kernel.elab el_w el_cx)
(use kernel.matcher)
(use kernel.predef)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.InductiveType)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.scope.Scope)
(use kernel.kw.WOut)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtInd)
(use kernel.matcher.MtPt)
(use kernel.predef.CalleeLocal)
(use kernel.predef.PdRec)
(use kernel.realize.Either3)

;; ---- the verdicts ----------------------------------------------------------------------------
;; DfSkip: no definition, the reason and its sentence; DfAux: declarations to admit first (a
;; native inductive's below and brecOn), then read and try again; DfOk: the E table, the
;; obligations to admit as parameters, the definition, its equations, whether a measure is pending
(type DfRes
  (DfSkip Symbol (List Int))
  (DfAux ESt (List Declaration))
  (DfOk ESt (List Declaration) Declaration (List Declaration) Bool))
;; a value's result with the state: declarations to admit first, or the error
(type TrAux (AuxOk Tr (List Declaration)) (AuxErr Tr Symbol (List Int)))


;; ---- the entry: the K projection of a pre-definition ---------------------------------------------
;; the body is an L term over the binders' locals and the self-local (predef.shard). A body
;; that never cites the self-local is the value under its binders, matchers and `ite` as
;; elaborated. One that does is compiled by its recursion clause: structural — `T.brecOn`, each
;; self-call the table's entry found by type (pj_find); measured — `WellFounded.fix`, each
;; self-call `rec (tuple args) f.dec_N`. The equations come with it (pj_equations).
;; a member of a group as a body calls it: the local's id in this body, the member's
;; constructor of the group's argument type, its measure over its data binders, those binders
(type PjCallee (PjCallee Int Name Expr (List Expr)))
;; PkStruct: C's id, the structural position among the data arguments. PkWf: rec, the tuple,
;; the components' types and their levels, the measure over the data binders, the data binders. PkEqn: the
;; statement of a measured function's equations (a self-call stays a call, a matcher carries
;; its equation as under PkWf). PkGrp: a member of a group — rec, the member's measure, its
;; data binders, the members as this body calls them
(type PjKind
  (PkStruct Int Int)
  (PkWf Expr Expr (List Expr) (List Level) Expr (List Expr))
  (PkEqn)
  (PkGrp Expr Expr (List Expr) (List PjCallee)))
(fn pj_carries_eq ((k PjKind)) Bool
  (match k
    ((PkStruct _ _) false)
    (_ true)))
(fn pj_is_eqn ((k PjKind)) Bool
  (match k
    ((PkEqn) true)
    (_ false)))
;; the lexical context of the walk: the self-local's id, the type binders (fixed in a
;; self-call), the recursion, the tables in scope innermost first — a local with its type over
;; the abstract motive —, every local in scope outermost first (True = a let)
;; `members`: the callee-locals that stand for the other members of the function's group,
;; none for a function that calls only itself
;; `beyond`: the lets in scope whose value is the recursion's own — bound to a recursive call,
;; or computed from such a let —, each with its name: no obligation is stated over them
(record PjCx (self Int) (tps (List Expr)) (kind PjKind) (tables (List (Prod Expr Expr)))
  (scope (List (Prod Bool Expr)))
  (members (List Int))
  (beyond (List (Prod Int Name))))
(fn pj_push ((cx PjCx) (is_let Bool) (fvs (List Expr))) PjCx
  (measure (struct fvs))
  (match fvs
    (nil cx)
    ((cons fv r)
     (pj_push (with PjCx cx (scope (append (PjCx.scope cx) (list (Prod.mk is_let fv))))) is_let r))))
;; a let's local in scope; one whose value cites the recursion's local, or a let that does, is
;; beyond an obligation's reach
(fn pj_push_let ((cx PjCx) (n Name) (fv Expr) (v Expr)) PjCx
  (let ((cx1 (pj_push cx true (list fv))))
    (if (mentions_any v (pj_out cx))
      (with PjCx cx1 (beyond (cons (Prod.mk (fvar_id_of fv) n) (PjCx.beyond cx))))
      cx1)))
;; the locals no obligation may cite: the recursion's own local, and the lets beyond reach
(fn pj_out ((cx PjCx)) (List Int)
  (append
    (match (PjCx.kind cx)
      ((PkWf recl _ _ _ _ _) (list (fvar_id_of recl)))
      ((PkGrp recl _ _ _) (list (fvar_id_of recl)))
      (_ nil))
    (pj_beyond_ids (PjCx.beyond cx))))
(fn pj_beyond_ids ((bs (List (Prod Int Name)))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (Prod.mk i _) r) (cons i (pj_beyond_ids r)))))

(fn define_pd ((es ESt) (sc Scope) (pd PreDef)) DfRes
  (match (pd_callees pd)
    ((cons (CalleeLocal _ id _) _)
     (DfSkip (sym "callee_runnable")
       (append (show_name id)
         (utf8
           ": a callee with a program and no K constant — this function has its program and no definition"))))
    (nil (define_pd_go es sc pd))))
(fn define_pd_go ((es ESt) (sc Scope) (pd PreDef)) DfRes
  (let ((w (el_w (pd_state pd))) (k (pd_name pd)) (selfid (fvar_id_of (pd_self pd))))
    (match (pj_split_binders w (pd_binders pd) nil nil)
      ((Prod.mk tps data)
       (let ((t (tr_new w es sc k tps)))
         (match (mt_inst_args (Tr.w t) (pd_type pd) (pd_binders pd))
           ((Prod.mk _ none)
            (DfSkip (sym "define_matrix") (utf8 "the declared type does not take the binders")))
           ((Prod.mk w1 (some rl))
            (let ((t0 (tr_set_w t w1)) (recursive (mentions_any (pd_body pd) (list selfid))))
              (match (pj_value t0 pd tps data rl selfid recursive)
                ((AuxErr _ e m) (DfSkip e m))
                ((AuxOk t1 auxs)
                 (if (< 0 (len auxs)) (DfAux (Tr.es t1) auxs)
                 (match (Tr.value t1)
                   (none (DfSkip (sym "define_matrix") (utf8 "no value")))
                   ((some value)
                    (let
                      ((measured (bool_and recursive (pj_is_measure (pd_rec pd))))
                       (dd
                         (DefnDecl (ConstantVal k nil (pd_type pd)) value
                           (HRegular (def_height (tr_env t1) value))
                           Safe
                           (list k))))
                      ;; the definition checked into the walk's environment, so each leaf's
                      ;; equation is stated only where K decides it by conversion
                      ;; (pj_equation_decls); a measured definition's equations are by
                      ;; WellFounded.fix_eq
                      (match (w_admit_after (Tr.w t1) (if measured (tr_obls t1) nil) dd)
                        ((Prod.mk _ (some why))
                         (DfSkip (sym "definition_refused")
                           (append (show_name k)
                             (append (utf8 ": K refused the definition (")
                               (append (chars_of_sym why) (utf8 ")"))))))
                        ((Prod.mk w2 none)
                         ;; a measured function's equations are stated over the body as the value has it:
                         ;; each matcher with its equation (pj_match_eq), so K converts F's body to the leaf's
                         (match
                           (if measured
                             (pj_term (tr_set_w t1 w2)
                               (make PjCx (self selfid) (tps tps) (kind (PkEqn)) (tables nil)
                                 (scope nil)
                                 (members nil)
                                 (beyond nil))
                               (pd_body pd)
                               (budget_depth))
                             (TrOk (tr_set_w t1 w2) (pd_body pd)))
                           ((TrErr e m) (DfSkip e m))
                           ((TrOk t1b eqbody)
                            (match
                              (pj_equations t1b (mk_const k nil) selfid (pd_binders pd) rl eqbody
                                nil
                                true
                                (if measured (some value) none))
                              ((Prod.mk _ (Left3 e m)) (DfSkip e m))
                              ((Prod.mk t2 (Right3 eqs))
                               (DfOk (Tr.es t2) (tr_obls t2) dd eqs measured)))))))))))))))))))))
(fn pj_is_measure ((r PdRec)) Bool
  (match r
    ((PdMeasure _) true)
    (_ false)))
;; the type binders (a local whose type is a sort) and the data binders, in order
(fn pj_split_binders ((w W) (bs (List Expr)) (tps (List Expr)) (data (List Expr)))
  (Prod (List Expr) (List Expr))
  (measure (struct bs))
  (match bs
    (nil (Prod.mk (rev tps) (rev data)))
    ((cons fv r)
     (match (w_local_type w (fvar_id_of fv))
       ((some (Sort _ _)) (pj_split_binders w r (cons fv tps) data))
       (_ (pj_split_binders w r tps (cons fv data)))))))
;; the declaration admitted into the walk's environment after the obligations it cites (a
;; measured definition's descent facts: the loader admits them as parameters before it)
(fn w_admit_after ((w W) (before (List Declaration)) (d Declaration)) (Prod W (Option Symbol))
  (measure (struct before))
  (match before
    (nil (w_admit w d))
    ((cons b r)
     (match (w_admit w b)
       ((Prod.mk w1 (some why)) (Prod.mk w1 (some why)))
       ((Prod.mk w1 none) (w_admit_after w1 r d))))))

(fn pj_value
  ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (recursive Bool))
  TrAux
  (if (bool_not recursive)
    (match (tr_lams t (pd_binders pd) (pd_body pd))
      ((Prod.mk t1 v) (AuxOk (tr_set_value t1 v) nil)))
    (match (pd_rec pd)
      (PdNone
        (AuxErr t (sym "realize_recursion")
          (append (show_name (pd_name pd)) (utf8 " calls itself without a measure"))))
      ((PdStruct x) (pj_struct t pd tps data rl selfid x))
      ((PdMeasure m) (pj_wf t pd tps data rl selfid m)))))

;; ---- structural recursion: brecOn ---------------------------------------------------------------
;; `λ binders . T.brecOn largs (λ x . Π others, RET) x (λ x below others . body') others` — the
;; functional over the binders' own locals (closed before the outer lambdas bind them again)
(fn pj_struct
  ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (x Expr))
  TrAux
  (match (fvar_index (fvar_id_of x) data 0)
    (none
      (AuxErr t (sym "realize_descent") (utf8 "the structural parameter is not a data parameter")))
    ((some pos)
     (match (tr_type_of_local t x)
       (none (AuxErr t (sym "untyped_subterm") (utf8 "the structural parameter has no type")))
       ((some xty)
        (match (mt_ind_of (Tr.w t) xty)
          ((Prod.mk _ (MtNoInd _ _))
           (AuxErr t (sym "untyped_subterm")
             (utf8 "the structural parameter's type is not an inductive type")))
          ((Prod.mk w1 (MtInd ind ls largs _))
           (let ((t1 (tr_set_w t w1)))
             (match (rec_usable t1 ind ls)
               ((some (Prod.mk e m)) (AuxErr t1 e m))
               (none
                 (match (ensure_below t1 ind ls)
                   ((AuxErr t2 e m) (AuxErr t2 e m))
                   ((AuxOk t2 auxs)
                    (if (< 0 (len auxs)) (AuxOk t2 auxs)
                    (match (below_names t2 ind)
                      ((Prod.mk t3 none) (AuxErr t3 (sym "equation_form") (no_below ind)))
                      ((Prod.mk t3 (some (Prod.mk (Prod.mk belowc brecc) lsb)))
                       (pj_brec t3 pd tps data rl selfid x pos xty largs belowc brecc lsb))))))))))))))))
(fn pj_brec
  ((t Tr)
   (pd PreDef)
   (tps (List Expr))
   (data (List Expr))
   (rl Expr)
   (selfid Int)
   (x Expr)
   (pos Int)
   (xty Expr)
   (largs (List Expr))
   (belowc Name)
   (brecc Name)
   (lsb (List Level)))
  TrAux
  (let ((others (without_index data pos 0)))
    (match (tr_pis t others rl)
      ((Prod.mk t1 mres)
       (match (tr_lams t1 (list x) mres)
         ((Prod.mk t2 motive)
          (match (tr_local t2 (n1 (sym "x")) xty)
            ((Prod.mk t3 x0)
             (match (tr_pis t3 (list x0) (mk_sort (level_one)))
               ((Prod.mk t4 cty)
                (match (tr_local t4 (n1 (sym "C")) cty)
                  ((Prod.mk t5 cfv)
                   (match (tr_apps t5 (mk_const belowc lsb) (append largs (list motive x)))
                     ((Prod.mk t6 belowty)
                      (match (tr_apps t6 (mk_const belowc lsb) (append largs (list cfv x)))
                        ((Prod.mk t7 belowabs)
                         (match (tr_local t7 (n1 (sym "below")) belowty)
                           ((Prod.mk t8 below)
                            (let
                              ((cx
                                 (make PjCx (self selfid) (tps tps)
                                   (kind (PkStruct (fvar_id_of cfv) pos))
                                   (tables (list (Prod.mk below belowabs)))
                                   (scope nil)
                                   (members nil)
                                   (beyond nil))))
                              (match (pj_term t8 cx (pd_body pd) (budget_depth))
                                ((TrErr e m) (AuxErr t8 e m))
                                ((TrOk t9 b)
                                 (match (tr_lams t9 (cons x (cons below others)) b)
                                   ((Prod.mk t10 fnl)
                                    (match
                                      (tr_apps t10 (mk_const brecc lsb)
                                        (append largs (list motive x fnl)))
                                      ((Prod.mk t11 brec)
                                       (match (tr_apps t11 brec others)
                                         ((Prod.mk t12 b2)
                                          (match (tr_lams t12 (pd_binders pd) b2)
                                            ((Prod.mk t13 v) (AuxOk (tr_set_value t13 v) nil))))))))))))))))))))))))))))))
(fn without_index ((xs (List Expr)) (i Int) (k Int)) (List Expr)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (if (= k i) (without_index r i (+ k 1)) (cons x (without_index r i (+ k 1)))))))

;; the entry for a self-call's structural argument: the tables innermost first, each searched by
;; its type over the abstract motive C — `C y'` with y' the argument is the entry; a PProd is
;; searched through both projections; anything else is normalized by K once (a `T.below C t`
;; unfolds exactly when t is a constructor application) and searched again
(fn pj_find ((t Tr) (tables (List (Prod Expr Expr))) (cid Int) (y Expr)) (Prod Tr (Option Expr))
  (measure (struct tables))
  (match tables
    (nil (Prod.mk t none))
    ((cons (Prod.mk term ty) r)
     (match (pj_search t term ty cid y 64)
       ((Prod.mk t1 (some e)) (Prod.mk t1 (some e)))
       ((Prod.mk t1 none) (pj_find t1 r cid y))))))
(fn pj_search ((t Tr) (term Expr) (ty Expr) (cid Int) (y Expr) (fuel Int)) (Prod Tr (Option Expr))
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (Prod.mk t none)
  (match (tr_whnf t ty)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some ty1))
     (match (get_app_fn ty1)
       ((FVar _ id)
        (if (bool_not (= id cid)) (Prod.mk t1 none)
        (match (get_app_args ty1)
          ((cons y1 nil) (pj_same t1 term y1 y))
          (_ (Prod.mk t1 none)))))
       ((Const _ c _)
        (if (bool_not (name_eq c (n1 (sym "PProd")))) (Prod.mk t1 none)
        (match (get_app_args ty1)
          ((cons a (cons b nil))
           (match (pj_search t1 (mk_proj (n1 (sym "PProd")) 0 term) a cid y (- fuel 1))
             ((Prod.mk t2 (some e)) (Prod.mk t2 (some e)))
             ((Prod.mk t2 none)
              (pj_search t2 (mk_proj (n1 (sym "PProd")) 1 term) b cid y (- fuel 1)))))
          (_ (Prod.mk t1 none)))))
       (_ (Prod.mk t1 none)))))))
(fn pj_same ((t Tr) (term Expr) (y1 Expr) (y Expr)) (Prod Tr (Option Expr))
  (if (expr_eq y1 y) (Prod.mk t (some term))
  (match (w_is_def_eq_r (Tr.w t) y1 y)
    ((Prod.mk w1 (WVal true)) (Prod.mk (tr_set_w t w1) (some term)))
    ((Prod.mk w1 _) (Prod.mk (tr_set_w t w1) none)))))
(fulfills pj_search.dec_1
  (by (intro p h t1 ty1 hw w1 c w2 hf hn a b ha) (apply natAbs_pred (arith))))
(fulfills pj_search.dec_2
  (by (intro p h t1 ty1 hw w1 c w2 hf hn a b ha t2) (apply natAbs_pred (arith))))

;; ---- the order of a measure ----------------------------------------------------------------------
;; The order a measure descends in. A measure is a Nat, or several: a pair of a Nat and a
;; measure — `(Prod.mk a (Prod.mk b c))`, which `(measure a b c)` writes —, compared part by
;; part, the first part that differs deciding: Init's `Prod.Lex` over `Nat.lt`, well-founded by
;; `Prod.lex`. An order is the measure's type T, the `WellFoundedRelation T` and the relation
;; on T as the term an obligation states: `Nat.lt`, or `Prod.Lex Nat T' Nat.lt R'`.
(type MOrder (MOrder Expr Expr Expr))
(fn mo_type ((o MOrder)) Expr
  (match o
    ((MOrder ty _ _) ty)))
(fn mo_rel ((o MOrder)) Expr
  (match o
    ((MOrder _ _ r) r)))
(fn nat_order () MOrder
  (MOrder (mk_const (nm_nat) nil) (mk_const (n2 (sym "Nat") (sym "lt_wfRel")) nil)
    (mk_const (n2 (sym "Nat") (sym "lt")) nil)))
(fn measure_parts_max () Int 8)
(fn measure_type_msg () (List Int)
  (utf8
    "the measure must be a Nat, or several Nats — (measure A B …), compared part by part — (an Int measure: write a Nat one, such as (Int.natAbs n); no conversion is inserted)"))
;; `Prod Nat T'`, `Prod.lex Nat T' Nat.lt_wfRel inst'`, `Prod.Lex Nat T' Nat.lt R'`
(fn pair_order ((t Tr) (tb Expr) (ib Expr) (rb Expr)) (Prod Tr (Option MOrder))
  (let
    ((nat (mk_const (nm_nat) nil))
     (zz (List Level) (list LZero LZero))
     (nlt (mk_const (n2 (sym "Nat") (sym "lt")) nil)))
    (match (tr_apps t (mk_const (n1 (sym "Prod")) zz) (list nat tb))
      ((Prod.mk t1 ty)
       (match
         (tr_apps t1 (mk_const (n2 (sym "Prod") (sym "lex")) zz)
           (list nat tb (mk_const (n2 (sym "Nat") (sym "lt_wfRel")) nil) ib))
         ((Prod.mk t2 inst)
          (match (tr_apps t2 (mk_const (n2 (sym "Prod") (sym "Lex")) zz) (list nat tb nlt rb))
            ((Prod.mk t3 rel) (Prod.mk t3 (some (MOrder ty inst rel)))))))))))
(fn measure_order ((t Tr) (ml Expr)) (Prod Tr (Option MOrder))
  (match (tr_infer t ml)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some ty)) (order_of_type t1 ty (measure_parts_max)))))
;; the order of a measure's type, read to at most `left` parts
(fn order_of_type ((t Tr) (ty Expr) (left Int)) (Prod Tr (Option MOrder))
  (measure (Int.natAbs left))
  (if (<= left 0) (Prod.mk t none)
  (match (tr_whnf t ty)
    ((Prod.mk t1 (some (Const _ n _)))
     (Prod.mk t1 (if (name_eq n (nm_nat)) (some (nat_order)) none)))
    ((Prod.mk t1 (some (App _ (App _ (Const _ p _) a) b)))
     (if (bool_not (name_eq p (n1 (sym "Prod")))) (Prod.mk t1 none)
     (match (tr_whnf t1 a)
       ((Prod.mk t2 (some (Const _ n _)))
        (if (bool_not (name_eq n (nm_nat))) (Prod.mk t2 none)
        (match (order_of_type t2 b (- left 1))
          ((Prod.mk t3 (some (MOrder tb ib rb))) (pair_order t3 tb ib rb))
          ((Prod.mk t3 none) (Prod.mk t3 none)))))
       ((Prod.mk t2 _) (Prod.mk t2 none)))))
    ((Prod.mk t1 _) (Prod.mk t1 none)))))
(fulfills order_of_type.dec_1
  (by (intro p h t1 w1 w2 w3 pn w4 a b hw hp t2 w5 n w6 ha hn) (apply natAbs_pred (arith))))
;; the descent fact as the comparison it is: the order's relation at the callee's measure and
;; the caller's — `Nat.lt ma m`, or `Prod.Lex … ma m`
(fn wf_goal ((t Tr) (m Expr) (ma Expr) (mp Expr)) (Prod Tr Expr)
  (match (measure_order t m)
    ((Prod.mk t1 (some o)) (tr_apps t1 (mo_rel o) (list ma mp)))
    ((Prod.mk t1 none) (tr_apps t1 (mo_rel (nat_order)) (list ma mp)))))
;; the relation `InvImage inst.rel m` and its well-foundedness `InvImage.wf m inst.wf`, inst the
;; order's `WellFoundedRelation` — `Nat.lt_wfRel` for a measure of one part
(fn wf_relation ((t Tr) (alpha Expr) (mfn Expr) (ord MOrder)) (Prod Tr (Prod Expr Expr))
  (match ord
    ((MOrder mty wfrel _)
     (match
       (tr_apps t (mk_const (n2 (sym "WellFoundedRelation") (sym "rel")) (list (level_one)))
         (list mty wfrel))
       ((Prod.mk t1 rnat)
        (match
          (tr_apps t1 (mk_const (n1 (sym "InvImage")) (list (level_one) (level_one)))
            (list alpha mty rnat mfn))
          ((Prod.mk t2 rel)
           (match
             (tr_apps t2 (mk_const (n2 (sym "WellFoundedRelation") (sym "wf")) (list (level_one)))
               (list mty wfrel))
             ((Prod.mk t3 hnat)
              (match
                (tr_apps t3
                  (mk_const (n2 (sym "InvImage") (sym "wf")) (list (level_one) (level_one)))
                  (list alpha mty rnat mfn hnat))
                ((Prod.mk t4 hwf) (Prod.mk t4 (Prod.mk rel hwf)))))))))))))
;; ---- a measure: WellFounded.fix -----------------------------------------------------------------
;; `λ binders . WellFounded.fix α (λ _ . RET) (InvImage rel m) (InvImage.wf m Nat.lt_wfRel.wf)
;; (λ p rec . body') (tuple data)` — the body with each data binder the tuple's component, a
;; self-call `rec (tuple args) (f.dec_N locals…)`, the decreasing fact an obligation
(fn pj_wf ((t Tr) (pd PreDef) (tps (List Expr)) (data (List Expr)) (rl Expr) (selfid Int) (m Expr))
  TrAux
  (match (measure_order t m)
    ((Prod.mk t0 none) (AuxErr t0 (sym "measure_type") (measure_type_msg)))
    ((Prod.mk t0 (some ord)) (pj_wf_go t0 pd tps data rl selfid m ord))))
(fn pj_wf_go
  ((t Tr)
   (pd PreDef)
   (tps (List Expr))
   (data (List Expr))
   (rl Expr)
   (selfid Int)
   (m Expr)
   (ord MOrder))
  TrAux
  (match (local_types t data nil)
    ((Prod.mk t1 ltys)
     (match (wf_levels t1 ltys nil)
       ((Prod.mk t1b lvs)
        (match (wf_tuple_type t1b data ltys lvs)
          ((Prod.mk t2 alpha)
           (match (tr_local t2 (n1 (sym "p")) alpha)
             ((Prod.mk t3 pm)
              (match (pj_subst_list t3 m data (wf_projs alpha pm (len data)))
                ((Prod.mk t5 ml)
                 (match (tr_lams t5 (list pm) ml)
                   ((Prod.mk t6 mfn)
                    (match (wf_relation t6 alpha mfn ord)
                      ((Prod.mk t7 (Prod.mk rel hwf))
                       (match (tr_local t7 (pj_tuple_name pd data) alpha)
                         ((Prod.mk t8 p)
                          (match (wf_rec_type t8 alpha rel p rl)
                            ((Prod.mk t9 rty)
                             (match (tr_local t9 (n1 (sym "rec")) rty)
                               ((Prod.mk t10 recl)
                                (match
                                  (pj_subst_list t10 (pd_body pd) data (wf_projs alpha p (len data)))
                                  ((Prod.mk t11 body1)
                                   (let
                                     ((cx
                                        (make PjCx (self selfid) (tps tps)
                                          (kind (PkWf recl p ltys lvs m data))
                                          (tables nil)
                                          (scope (list (Prod.mk false p)))
                                          (members nil)
                                          (beyond nil))))
                                     (match (pj_term t11 cx body1 (budget_depth))
                                       ((TrErr e m2) (AuxErr t11 e m2))
                                       ((TrOk t12 b)
                                        (match (tr_lams t12 (list p recl) b)
                                          ((Prod.mk t13 fnl)
                                           (match (tr_local t13 (n1 (sym "x")) alpha)
                                             ((Prod.mk t14 xc)
                                              (match (tr_lams t14 (list xc) rl)
                                                ((Prod.mk t15 cmot)
                                                 (match (wf_tuple t15 data ltys lvs data)
                                                   ((Prod.mk t16 tup)
                                                    (match
                                                      (tr_apps t16
                                                        (mk_const
                                                          (n2 (sym "WellFounded") (sym "fix"))
                                                          (list (level_one) (level_one)))
                                                        (list alpha cmot rel hwf fnl tup))
                                                      ((Prod.mk t17 fixed)
                                                       (match (tr_lams t17 (pd_binders pd) fixed)
                                                         ((Prod.mk t18 v)
                                                          (AuxOk (tr_set_value t18 v) nil)))))))))))))))))))))))))))))))))))))))
(fn local_types ((t Tr) (fvs (List Expr)) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct fvs))
  (match fvs
    (nil (Prod.mk t (rev acc)))
    ((cons fv r)
     (match (tr_type_of_local t fv)
       ((some ty) (local_types t r (cons ty acc)))
       (none (local_types t r acc))))))
;; the measure's L type is Nat
;; ∀ (q : α), rel q p → RET
(fn wf_rec_type ((t Tr) (alpha Expr) (rel Expr) (p Expr) (rl Expr)) (Prod Tr Expr)
  (match (tr_local t (n1 (sym "q")) alpha)
    ((Prod.mk t1 q)
     (match (tr_apps t1 rel (list q p))
       ((Prod.mk t2 hty)
        (match (tr_local t2 (n1 (sym "h")) hty)
          ((Prod.mk t3 h)
           (match (tr_pis t3 (list q h) rl)
             ((Prod.mk t4 e) (Prod.mk t4 e))))))))))

;; ---- the tuple of a measure's arguments, the recursor applied -----------------------------------
(fn scope_fvars ((scope (List (Prod Bool Expr)))) (List Expr)
  (measure (struct scope))
  (match scope
    (nil nil)
    ((cons (Prod.mk _ fv) r) (cons fv (scope_fvars r)))))
(fn scope_lambda_fvars ((scope (List (Prod Bool Expr)))) (List Expr)
  (measure (struct scope))
  (match scope
    (nil nil)
    ((cons (Prod.mk true _) r) (scope_lambda_fvars r))
    ((cons (Prod.mk false fv) r) (cons fv (scope_lambda_fvars r)))))
;; The parameter tuple. One parameter is itself; more are pairs nested to the right, and a
;; pair is `PProd` where no later parameter's type names its first component and `PSigma`
;; over that component where one does — evidence about a parameter, `(hk (<= k n))` beside
;; `k` and `n` —, which is how Lean packs a recursion's domain. A component that is a
;; proposition stands at level 0, any other at level 1.
;; the level of each component's type
(fn wf_levels ((t Tr) (ltys (List Expr)) (acc (List Level))) (Prod Tr (List Level))
  (measure (struct ltys))
  (match ltys
    (nil (Prod.mk t (rev acc)))
    ((cons ty r)
     (match (tr_infer t ty)
       ((Prod.mk t1 (some s))
        (match (tr_whnf t1 s)
          ((Prod.mk t2 (some (Sort _ LZero))) (wf_levels t2 r (cons LZero acc)))
          ((Prod.mk t2 _) (wf_levels t2 r (cons (level_one) acc)))))
       ((Prod.mk t1 none) (wf_levels t1 r (cons (level_one) acc)))))))
;; the level of what stands after a pair's first component: the last component's own, a
;; pair's 1
(fn wf_rest_level ((lvs (List Level))) Level
  (match lvs
    ((cons l nil) l)
    (_ (level_one))))
;; the tuple of these values, each component's type at the values before it
(fn wf_tuple ((t Tr) (data (List Expr)) (ltys (List Expr)) (lvs (List Level)) (vals (List Expr)))
  (Prod Tr Expr)
  (measure (struct vals))
  (match vals
    (nil (Prod.mk t (mk_const (nm_punit_unit) (list (level_one)))))
    ((cons v nil) (Prod.mk t v))
    ((cons v r)
     (match (Prod.mk data (Prod.mk ltys lvs))
       ((Prod.mk (cons x xr) (Prod.mk (cons ty tr0) (cons u ur)))
        (match (wf_tuple_type t xr tr0 ur)
          ((Prod.mk t1 restty)
           (if (mentions_any restty (list (fvar_id_of x)))
             (match (wf_subst_all t1 tr0 (fvar_id_of x) v nil)
               ((Prod.mk t2 tr1)
                (match (wf_tuple t2 xr tr1 ur r)
                  ((Prod.mk t3 rest)
                   (match (tr_lams t3 (list x) restty)
                     ((Prod.mk t4 fam)
                      (tr_apps t4 (mk_const (nm_psigma_mk) (list u (wf_rest_level ur)))
                        (list ty fam v rest))))))))
             (match (wf_tuple t1 xr tr0 ur r)
               ((Prod.mk t2 rest)
                (tr_apps t2 (mk_const (nm_pprod_mk) (list u (wf_rest_level ur)))
                  (list ty restty v rest))))))))
       (_ (Prod.mk t v))))))
(fn wf_subst_all ((t Tr) (es (List Expr)) (id Int) (v Expr) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct es))
  (match es
    (nil (Prod.mk t (rev acc)))
    ((cons e r)
     (match (tr_subst t e id v)
       ((Prod.mk t1 e1) (wf_subst_all t1 r id v (cons e1 acc)))))))
(fn wf_tuple_type ((t Tr) (data (List Expr)) (ltys (List Expr)) (lvs (List Level))) (Prod Tr Expr)
  (measure (struct ltys))
  (match ltys
    (nil (Prod.mk t (mk_const (n1 (sym "PUnit")) (list (level_one)))))
    ((cons ty nil) (Prod.mk t ty))
    ((cons ty r)
     (match (Prod.mk data lvs)
       ((Prod.mk (cons x xr) (cons u ur))
        (match (wf_tuple_type t xr r ur)
          ((Prod.mk t1 restty)
           (if (mentions_any restty (list (fvar_id_of x)))
             (match (tr_lams t1 (list x) restty)
               ((Prod.mk t2 fam)
                (tr_apps t2 (mk_const (n1 (sym "PSigma")) (list u (wf_rest_level ur))) (list ty fam))))
             (tr_apps t1 (mk_const (n1 (sym "PProd")) (list u (wf_rest_level ur))) (list ty restty))))))
       (_ (Prod.mk t ty))))))
;; the components of a tuple of n at the type alpha: (p.2)^k .1, the last (p.2)^(n-1), each
;; projection of the pair its level is
(fn wf_projs ((alpha Expr) (p Expr) (n Int)) (List Expr)
  (measure (Int.natAbs n))
  (if (< n 1) nil
  (if (< n 2) (list p)
  (let ((s (wf_pair_name alpha)))
    (cons (mk_proj s 0 p) (wf_projs (wf_pair_rest alpha) (mk_proj s 1 p) (- n 1)))))))
(fn wf_pair_name ((alpha Expr)) Name
  (match (get_app_fn alpha)
    ((Const _ c _) c)
    (_ (n1 (sym "PProd")))))
;; the type of a pair's second component — under its binder where the pair is over the
;; first, which is read for the next pair's name alone
(fn wf_pair_rest ((alpha Expr)) Expr
  (match (get_app_args alpha)
    ((cons _ (cons (Lam _ _ _ _ b) nil)) b)
    ((cons _ (cons b nil)) b)
    (_ alpha)))
;; the components of the tuple local p
(fn wf_comps ((t Tr) (p Expr) (n Int)) (List Expr)
  (match (tr_type_of_local t p)
    ((some alpha) (wf_projs alpha p n))
    (none nil)))
(fulfills wf_projs.dec_1 (by (intro p h1 h2) (apply natAbs_pred (arith))))
(fn nm_pprod_mk () Name (n2 (sym "PProd") (sym "mk")))
(fn nm_psigma_mk () Name (n2 (sym "PSigma") (sym "mk")))
(fn nm_punit_unit () Name (n2 (sym "PUnit") (sym "unit")))
;; the recursor applied: the parameters, a constant motive over the result type, the minors, the major
(fn rec_app
  ((t Tr)
   (ind Name)
   (ls (List Level))
   (largs (List Expr))
   (rty Expr)
   (minors (List Expr))
   (major Expr))
  TrRes
  (match (tr_apps t (mk_const ind ls) largs)
    ((Prod.mk t2 tyapp)
     (match (tr_local t2 (n1 (sym "x")) tyapp)
       ((Prod.mk t3 mv)
        (match (tr_lams t3 (list mv) rty)
          ((Prod.mk t4 motive) (rec_app_dep t4 (level_one) ind ls largs motive minors major))))))))
;; what the recursor of a type of a block takes besides the type's own: the other types'
;; motives before and after its motive, their constructors' minors before and after its minors
(type RecFill (RecFill (List Expr) (List Expr) (List Expr) (List Expr)))
;; the recursor applied with a given motive at the motive's universe (a table generalized in
;; the motive; below's motive into Sort 1 at universe 2). The recursor of a type of a block —
;; types that name each other, a nested inductive's auxiliary types — takes a motive per type
;; of the block, in the block's order with the auxiliary ones last, and the minors of every
;; type's constructors in that order: the other types' motives are `λ x. PUnit.{u}` and their
;; minors `λ binders. PUnit.unit.{u}`, read off the recursor's own telescope — K's `casesOn`
;; shape; the type's own minors carry a `PUnit` hypothesis per field over another type of
;; the block.
(fn rec_app_dep
  ((t Tr)
   (u Level)
   (ind Name)
   (ls (List Level))
   (largs (List Expr))
   (motive Expr)
   (minors (List Expr))
   (major Expr))
  TrRes
  (match (env_find (tr_env t) (Str ind (sym "rec")))
    ((some (RecInfo _ _ _ _ nmotives nminors _ _ _))
     (if (= nmotives 1)
       (match
         (tr_apps t (mk_const (Str ind (sym "rec")) (cons u ls))
           (append largs (cons motive (append minors (list major)))))
         ((Prod.mk t5 e) (TrOk t5 e)))
       (match (env_find (tr_env t) (Str ind (sym "rec")))
         ((some rinfo)
          (match (w_inst_lparams (Tr.w t) (ci_type rinfo) (ci_lparams rinfo) (cons u ls))
            ((Prod.mk w1 rty)
             (match (inst_params w1 rty largs)
               ((Prod.mk w2 none)
                (TrErr (sym "equation_form")
                  (append (show_name ind) (utf8 ": the recursor's parameters could not be opened"))))
               ((Prod.mk w2 (some ty1))
                (match (block_place (tr_env t) ind)
                  ((Prod.mk k c)
                   (match
                     (block_tail (tr_set_w t w2) ty1 u motive k (- (- nmotives 1) k) minors c
                       (- (- nminors c) (len minors)))
                     ((Prod.mk t2 none)
                      (TrErr (sym "equation_form")
                        (append (show_name ind)
                          (utf8 ": the recursor's telescope is not a block's shape"))))
                     ((Prod.mk t2 (some (RecFill mb ma nb na)))
                      (match
                        (tr_apps t2 (mk_const (Str ind (sym "rec")) (cons u ls))
                          (append largs
                            (append mb
                              (cons motive
                                (append ma (append nb (append minors (append na (list major)))))))))
                        ((Prod.mk t5 e) (TrOk t5 e))))))))))))
         (none (TrErr (sym "equation_form") (append (show_name ind) (utf8 " has no recursor")))))))
    (_ (TrErr (sym "equation_form") (append (show_name ind) (utf8 " has no recursor"))))))
;; where a type stands in its block: the count of the block's types before it, and of their
;; constructors
(fn block_place ((env CheckedEnv) (ind Name)) (Prod Int Int)
  (match (env_find env ind)
    ((some (InductInfo _ _ _ all _ _ _ _ _)) (place_in env all ind 0 0))
    (_ (Prod.mk 0 0))))
(fn place_in ((env CheckedEnv) (all (List Name)) (ind Name) (k Int) (c Int)) (Prod Int Int)
  (measure (struct all))
  (match all
    (nil (Prod.mk 0 0))
    ((cons n r)
     (if (name_eq n ind) (Prod.mk k c) (place_in env r ind (+ k 1) (+ c (ctor_count env n)))))))
(fn ctor_count ((env CheckedEnv) (n Name)) Int
  (match (env_find env n)
    ((some (InductInfo _ _ _ _ ctors _ _ _ _)) (len ctors))
    (_ 0)))
;; the types of a type's block, itself among them
(fn block_types ((env CheckedEnv) (ind Name)) (List Name)
  (match (env_find env ind)
    ((some (InductInfo _ _ _ all _ _ _ _ _)) all)
    (_ (list ind))))
;; the recursor's telescope after the parameters: the motives of the block's types before the
;; type's own, its own, those after it; then the minors before the type's own, its own, those
;; after — the others built and the type's own instantiated
(fn block_tail
  ((t Tr)
   (ty Expr)
   (u Level)
   (motive Expr)
   (nbefore Int)
   (nafter Int)
   (minors (List Expr))
   (minbefore Int)
   (minafter Int))
  (Prod Tr (Option RecFill))
  (match (aux_motives t ty u nbefore nil)
    ((Prod.mk t0 none) (Prod.mk t0 none))
    ((Prod.mk t0 (some (Prod.mk ty0 mb)))
     (match ty0
       ((Pi _ _ _ _ body)
        (match (tr_inst1 t0 body motive)
          ((Prod.mk t1 ty1)
           (match (aux_motives t1 ty1 u nafter nil)
             ((Prod.mk t2 none) (Prod.mk t2 none))
             ((Prod.mk t2 (some (Prod.mk ty2 ma)))
              (match (aux_minors t2 ty2 u minbefore nil)
                ((Prod.mk t3 none) (Prod.mk t3 none))
                ((Prod.mk t3 (some (Prod.mk ty3 nb)))
                 (match (inst_minors t3 ty3 minors)
                   ((Prod.mk t4 none) (Prod.mk t4 none))
                   ((Prod.mk t4 (some ty4))
                    (match (aux_minors t4 ty4 u minafter nil)
                      ((Prod.mk t5 none) (Prod.mk t5 none))
                      ((Prod.mk t5 (some (Prod.mk _ na))) (Prod.mk t5 (some (RecFill mb ma nb na))))))))))))))
       (_ (Prod.mk t0 none))))))
;; another type's motive: the binder's type is `(x : Aux) → Sort u`; the motive is `λ (x : Aux). PUnit.{u}`
(fn aux_motives ((t Tr) (ty Expr) (u Level) (n Int) (acc (List Expr)))
  (Prod Tr (Option (Prod Expr (List Expr))))
  (measure (Int.natAbs n))
  (if (< n 1) (Prod.mk t (some (Prod.mk ty (rev acc))))
  (match ty
    ((Pi _ _ _ dom body)
     (match dom
       ((Pi _ xn _ xdom _)
        (match (tr_local t xn xdom)
          ((Prod.mk t1 xv)
           (match (tr_lams t1 (list xv) (mk_const (n1 (sym "PUnit")) (list u)))
             ((Prod.mk t2 am)
              (match (tr_inst1 t2 body am)
                ((Prod.mk t3 body1) (aux_motives t3 body1 u (- n 1) (cons am acc)))))))))
       (_ (Prod.mk t none))))
    (_ (Prod.mk t none)))))
(fulfills aux_motives.dec_1
  (by
    (intro p h w1 w2 w3 dom body hm w4 xn w5 xdom w6 hd t1 xv h1 t2 am h2 t3 body1 h3)
    (apply natAbs_pred (arith))))
;; the type's own minors instantiated in order
(fn inst_minors ((t Tr) (ty Expr) (minors (List Expr))) (Prod Tr (Option Expr))
  (measure (struct minors))
  (match minors
    (nil (Prod.mk t (some ty)))
    ((cons m r)
     (match ty
       ((Pi _ _ _ _ body)
        (match (tr_inst1 t body m)
          ((Prod.mk t1 body1) (inst_minors t1 body1 r))))
       (_ (Prod.mk t none))))))
;; another type's constructor's minor: `λ binders. PUnit.unit.{u}`, and the telescope after it
(fn aux_minors ((t Tr) (ty Expr) (u Level) (n Int) (acc (List Expr)))
  (Prod Tr (Option (Prod Expr (List Expr))))
  (measure (Int.natAbs n))
  (if (< n 1) (Prod.mk t (some (Prod.mk ty (rev acc))))
  (match ty
    ((Pi _ _ _ dom body)
     (match (open_pi_locals t dom nil (budget_depth))
       ((Prod.mk t1 fvs)
        (match (tr_lams t1 fvs (mk_const (n2 (sym "PUnit") (sym "unit")) (list u)))
          ((Prod.mk t2 am)
           (match (tr_inst1 t2 body am)
             ((Prod.mk t3 body1) (aux_minors t3 body1 u (- n 1) (cons am acc)))))))))
    (_ (Prod.mk t none)))))
;; a telescope's binders as locals, in order
(fn open_pi_locals ((t Tr) (ty Expr) (acc (List Expr)) (fuel Int)) (Prod Tr (List Expr))
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (Prod.mk t (rev acc))
  (match ty
    ((Pi _ n _ dom body)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1) (open_pi_locals t2 body1 (cons fv acc) (- fuel 1)))))))
    (_ (Prod.mk t (rev acc))))))
(fulfills open_pi_locals.dec_1
  (by (intro p h w1 n w2 dom body hm t1 fv h1 t2 body1 h2) (apply natAbs_pred (arith))))
(fulfills aux_minors.dec_1
  (by (intro p h w1 w2 w3 dom body hm t1 fvs h1 t2 am h2 t3 body1 h3) (apply natAbs_pred (arith))))
;; a field's type cites one of the types
(fn field_over ((t Tr) (fv Expr) (inds (List Name))) Bool
  (match (tr_type_of_local t fv)
    ((some fty) (mentions_one_of fty inds))
    (none false)))
;; one of the constants occurs in a term
(fn mentions_one_of ((e Expr) (ns (List Name))) Bool
  (measure (struct ns))
  (match ns
    (nil false)
    ((cons n r) (if (mentions_const e n) true (mentions_one_of e r)))))
;; a constant occurs in a term
(fn mentions_const ((e Expr) (n Name)) Bool
  (measure (struct e))
  (match e
    ((Const _ c _) (name_eq c n))
    ((App _ f a) (bool_or (mentions_const f n) (mentions_const a n)))
    ((Lam _ _ _ d b) (bool_or (mentions_const d n) (mentions_const b n)))
    ((Pi _ _ _ d b) (bool_or (mentions_const d n) (mentions_const b n)))
    ((Let _ _ ty v b)
     (bool_or (mentions_const ty n) (bool_or (mentions_const v n) (mentions_const b n))))
    ((Proj _ _ _ x) (mentions_const x n))
    (_ false)))
;; whether a type's recursor serves structural recursion (pj_struct): it exists, has one
;; motive and eliminates beyond Prop — else the refusal
(fn rec_usable ((t Tr) (ind Name) (ls (List Level))) (Option (Prod Symbol (List Int)))
  (match (env_find (tr_env t) (Str ind (sym "rec")))
    (none (some (Prod.mk (sym "equation_form") (append (show_name ind) (utf8 " has no recursor")))))
    ((some rinfo)
     (match rinfo
       ((RecInfo _ _ _ _ nmotives _ _ _ _)
        (if (bool_not (= nmotives 1))
          (some
            (Prod.mk (sym "equation_form")
              (append (show_name ind)
                (utf8
                  ": a nested inductive's recursor has a motive per auxiliary type, and structural recursion takes one — write a Nat measure: (derive TYPE size) gives a size to measure by"))))
        (if (bool_not (= (len (ci_lparams rinfo)) (+ 1 (len ls))))
          (some
            (Prod.mk (sym "equation_form")
              (append (show_name ind) (utf8 " eliminates into Prop only"))))
          none)))
       (_ (some (Prod.mk (sym "equation_form") (append (show_name ind) (utf8 ": no recursor")))))))))
(type Either2 (Left2 Symbol (List Int)) (Right2 (Prod (List Expr) Expr)))
;; one induction hypothesis per recursive field: a local of the motive's (constant) result type
(fn open_ihs ((t Tr) (fields (List Field)) (rty Expr) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct fields))
  (match fields
    (nil (Prod.mk t (rev acc)))
    ((cons (Field _ _ true) r)
     (match (tr_local t (n1 (sym "ih")) rty)
       ((Prod.mk t1 fv) (open_ihs t1 r rty (cons fv acc)))))
    ((cons _ r) (open_ihs t r rty acc))))

;; ---- the walk over the body -------------------------------------------------------------------------
;; only a subterm that cites the self-local is rebuilt: a self-call by the recursion's rule; a
;; matcher application with its alternatives' variables in scope, its motive carrying the
;; tables its scrutinee refines (pj_match); `ite` as `Decidable.rec` with the branch's proof a
;; local (wherever it stands); a let and a lambda with their local in scope
(fn pj_term ((t Tr) (cx PjCx) (e Expr) (fuel Int)) TrRes
  (measure (Int.natAbs fuel) 0 0)
  (if (< fuel 1) (TrErr (sym "define_depth") (utf8 "a body too deep"))
  (if (bool_not (mentions_any e (cons (PjCx.self cx) (PjCx.members cx)))) (TrOk t e)
  (match e
    ((Lam _ n _ dom b)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 b fv)
          ((Prod.mk t2 b1)
           (match (pj_term t2 (pj_push cx false (list fv)) b1 (- fuel 1))
             ((TrErr x m) (TrErr x m))
             ((TrOk t3 b2)
              (match (tr_lams t3 (list fv) b2)
                ((Prod.mk t4 r) (TrOk t4 r))))))))))
    ((Let _ n ty v b)
     (match (pj_term t cx v (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t1 v1)
        (match (tr_local_val t1 n ty v1)
          ((Prod.mk t2 fv)
           (match (tr_inst1 t2 b fv)
             ((Prod.mk t3 b1)
              (match (pj_term t3 (pj_push_let cx n fv v1) b1 (- fuel 1))
                ((TrErr x m) (TrErr x m))
                ((TrOk t4 b2)
                 (match (tr_lams t4 (list fv) b2)
                   ((Prod.mk t5 r) (TrOk t5 r))))))))))))
    ((Proj _ s i x)
     (match (pj_term t cx x (- fuel 1))
       ((TrErr y m) (TrErr y m))
       ((TrOk t1 x1) (TrOk t1 (mk_proj s i x1)))))
    ((Pi _ _ _ _ _) (TrErr (sym "function_value") (utf8 "the function's own name in a type")))
    (_ (pj_app t cx (get_app_fn e) (get_app_args e) (- fuel 1)))))))
(fn pj_app ((t Tr) (cx PjCx) (head Expr) (args (List Expr)) (fuel Int)) TrRes
  (measure (Int.natAbs fuel) 0 0)
  (if (< fuel 1) (TrErr (sym "define_depth") (utf8 "a body too deep"))
  (match head
    ((FVar _ id)
     (if (= id (PjCx.self cx)) (pj_self t cx args fuel)
     (if (mem_int id (PjCx.members cx)) (pj_member t cx id args fuel)
     (pj_plain t cx head args fuel))))
    ((Const _ c ls)
     (if
       (bool_and (bool_and (name_eq c (n1 (sym "ite"))) (<= 5 (len args)))
         (bool_not (pj_is_eqn (PjCx.kind cx))))
       (pj_ite t cx args fuel)
       (match (mt_is_matcher (tr_env t) c)
         ((some (MtDesc np ns rows))
          (if (bool_and (= ns 1) (<= (+ np (+ 2 (len rows))) (len args)))
            (pj_match t cx c ls np rows args fuel)
            (pj_plain t cx head args fuel)))
         (none (pj_plain t cx head args fuel)))))
    (_
      (match (pj_term t cx head (- fuel 1))
        ((TrErr x m) (TrErr x m))
        ((TrOk t1 h1) (pj_plain t1 cx h1 args fuel)))))))
(fn pj_plain ((t Tr) (cx PjCx) (head Expr) (args (List Expr)) (fuel Int)) TrRes
  (measure (Int.natAbs (- fuel 1)) 2 0)
  (match (pj_terms t cx args fuel nil)
    ((Prod.mk _ (Left2 x m)) (TrErr x m))
    ((Prod.mk t1 (Right2 (Prod.mk args1 _)))
     (match (tr_apps t1 head args1)
       ((Prod.mk t2 r) (TrOk t2 r))))))
(fn pj_terms ((t Tr) (cx PjCx) (es (List Expr)) (fuel Int) (acc (List Expr))) (Prod Tr Either2)
  (measure (Int.natAbs (- fuel 1)) 1 (List.length es))
  (match es
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) (mk_sort (level_one))))))
    ((cons e r)
     (match (pj_term t cx e (- fuel 1))
       ((TrErr x m) (Prod.mk t (Left2 x m)))
       ((TrOk t1 e1) (pj_terms t1 cx r fuel (cons e1 acc)))))))

;; a self-call: the type arguments the function's own (no polymorphic recursion), then by the
;; recursion — the table's entry for the structural argument applied to the others, or `rec`
;; at the arguments' tuple with the obligation f.dec_N over the function's type parameters and
;; every local in scope (a statement with a type parameter free is none K takes)
(fn pj_self ((t Tr) (cx PjCx) (args (List Expr)) (fuel Int)) TrRes
  (measure (Int.natAbs (- fuel 1)) 2 0)
  (let ((nt (len (PjCx.tps cx))))
    (if (bool_not (pj_exprs_eq (take nt args) (PjCx.tps cx)))
      (TrErr (sym "realize_descent")
        (append (show_name (Tr.id t))
          (utf8 ": a recursive call at other type arguments (polymorphic recursion)")))
      (match (pj_terms t cx (drop nt args) fuel nil)
        ((Prod.mk _ (Left2 x m)) (TrErr x m))
        ((Prod.mk t1 (Right2 (Prod.mk dargs _)))
         (match (PjCx.kind cx)
           ((PkEqn)
            (match (tr_apps t1 (mk_fvar (PjCx.self cx)) (append (take nt args) dargs))
              ((Prod.mk t2 r) (TrOk t2 r))))
           ((PkGrp _ _ data _)
            (if (pj_exprs_eq (take (len data) dargs) data)
              (TrErr (sym "realize_descent")
                (append (show_name (Tr.id t1))
                  (utf8 " calls itself on its own parameters — no measure decreases")))
              (pj_grp_call t1 cx (PjCx.self cx) dargs)))
           ((PkStruct cid pos)
            (match (nth dargs pos)
              (none
                (TrErr (sym "function_value")
                  (append (show_name (Tr.id t1))
                    (utf8
                      ": its own name is not applied to its structural argument (no function values)"))))
              ((some y)
               (match (pj_find t1 (PjCx.tables cx) cid y)
                 ((Prod.mk _ none)
                  (TrErr (sym "realize_descent")
                    (append (show_name (Tr.id t1))
                      (append
                        (utf8
                          ": a recursive call does not pass a proper subterm of the structural parameter — ")
                        (show_expr y)))))
                 ((Prod.mk t2 (some entry))
                  (match (tr_apps t2 entry (without_index dargs pos 0))
                    ((Prod.mk t3 r) (TrOk t3 r))))))))
           ((PkWf recl p ltys lvs m data)
            (let ((n (len ltys)))
              (if (< (len dargs) n)
                (TrErr (sym "function_value")
                  (append (show_name (Tr.id t1))
                    (utf8 ": its own name is not applied to all its arguments (no function values)")))
              (if (pj_exprs_eq (take n dargs) (wf_comps t1 p n))
                (TrErr (sym "realize_descent")
                  (append (show_name (Tr.id t1))
                    (utf8 " calls itself on its own parameters — no measure decreases")))
                (match (wf_tuple t1 data ltys lvs (take n dargs))
                  ((Prod.mk t2 tup)
                   (match (pj_descent t2 m data (take n dargs) p n)
                     ((Prod.mk t3 goal)
                      (match (pj_obl_scope t3 cx)
                        ((Prod.mk over out)
                         (if (mentions_any goal out)
                           (TrErr (sym "nested_recursion") (pj_nested t3 cx goal))
                           (match (tr_pis t3 (append (PjCx.tps cx) (scope_fvars over)) goal)
                             ((Prod.mk t4 stmt)
                              (let ((had (obl_stating (Tr.obls t4) stmt)))
                                (let
                                  ((name Name
                                     (match had
                                       ((some k) k)
                                       (none
                                         (name_append (Tr.id t4)
                                           (n1
                                             (sym_of_chars
                                               (append (utf8 "dec_")
                                                 (show_nat (+ 1 (len (Tr.obls t4))))))))))))
                                  (match
                                    (tr_apps t4 (mk_const name nil)
                                      (append (PjCx.tps cx) (scope_lambda_fvars over)))
                                    ((Prod.mk t5 proof)
                                     (match (tr_apps t5 recl (cons tup (cons proof (drop n dargs))))
                                       ((Prod.mk t6 r)
                                        (TrOk
                                          (match had
                                            ((some _) t6)
                                            (none
                                              (tr_add_obl t6
                                                (AxiomDecl (ConstantVal name nil stmt) false))))
                                          r))))))))))))))))))))))))))
;; the descent fact as the comparison it is, `measure[arguments] < measure[parameters]` in
;; the measure's order (wf_goal): K converts the relation's instance `InvImage … (tuple
;; arguments) p` to it, and an author — and arith — reads a comparison. The body's arguments are over the tuple's
;; components already, so the data binders are substituted one after the other
(fn pj_descent ((t Tr) (m Expr) (data (List Expr)) (args (List Expr)) (p Expr) (n Int))
  (Prod Tr Expr)
  (match (pj_subst_list t m data args)
    ((Prod.mk t1 ma)
     (match (pj_subst_list t1 m data (wf_comps t1 p n))
       ((Prod.mk t2 mp) (wf_goal t2 m ma mp))))))
(fn pj_subst_list ((t Tr) (e Expr) (olds (List Expr)) (news (List Expr))) (Prod Tr Expr)
  (measure (struct olds))
  (match olds
    (nil (Prod.mk t e))
    ((cons o r)
     (match news
       (nil (Prod.mk t e))
       ((cons v vr)
        (match (tr_subst t e (fvar_id_of o) v)
          ((Prod.mk t1 e1) (pj_subst_list t1 e1 r vr))))))))
;; the tuple's local: under the binder's own name where the function has one data binder (the
;; tuple is that binder, and its obligations read `∀ n, …`), else `p`
(fn pj_tuple_name ((pd PreDef) (data (List Expr))) Name
  (match data
    ((cons (FVar _ id) nil) (pj_bound_name (cx_bound (el_cx (pd_state pd))) id))
    (_ (n1 (sym "p")))))
(fn pj_bound_name ((bs (List (Prod Name Expr))) (id Int)) Name
  (measure (struct bs))
  (match bs
    (nil (n1 (sym "p")))
    ((cons (Prod.mk n (FVar _ j)) r) (if (= id j) n (pj_bound_name r id)))
    ((cons _ r) (pj_bound_name r id))))
;; an alternative's first k binders opened under their own names — the row's variables as the
;; source wrote them, so an obligation reads `skip_ws cs = cons c rest`
(fn pj_open_named ((t Tr) (e Expr) (k Int) (acc (List Expr))) (Prod Tr (Prod (List Expr) Expr))
  (measure (Int.natAbs k))
  (if (< k 1) (Prod.mk t (Prod.mk (rev acc) e))
  (match e
    ((Lam _ n _ dom b)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 b fv)
          ((Prod.mk t2 b1) (pj_open_named t2 b1 (- k 1) (cons fv acc)))))))
    (_ (Prod.mk t (Prod.mk (rev acc) e))))))
(fulfills pj_open_named.dec_1
  (by (intro p h w1 n w2 dom b hm t1 fv h1 t2 b1 h2) (apply natAbs_pred (arith))))
;; the locals an obligation is stated over: every local in scope at the call but those that
;; state the function's own value, which a closed statement cannot cite — the hypothesis
;; `f x = true` of a branch under a recursive call's condition, whose type cites the
;; recursion's local; a let bound to a recursive call, whose value does; and every local whose
;; type cites one left out. The obligation is asked without them: a stronger statement, never
;; a weaker one. The second component is every local left out, the recursion's own first
(fn pj_obl_scope ((t Tr) (cx PjCx)) (Prod (List (Prod Bool Expr)) (List Int))
  (pj_obl_keep t (PjCx.scope cx) (pj_out cx) nil))
(fn pj_obl_keep
  ((t Tr) (scope (List (Prod Bool Expr))) (out (List Int)) (acc (List (Prod Bool Expr))))
  (Prod (List (Prod Bool Expr)) (List Int))
  (measure (struct scope))
  (match scope
    (nil (Prod.mk (rev acc) out))
    ((cons (Prod.mk letb fv) r)
     (if (bool_or (mem_int (fvar_id_of fv) out) (pj_local_cites t fv out))
       (pj_obl_keep t r (cons (fvar_id_of fv) out) acc)
       (pj_obl_keep t r out (cons (Prod.mk letb fv) acc))))))
(fn pj_local_cites ((t Tr) (fv Expr) (out (List Int))) Bool
  (match (lctx_find (w_lctx (Tr.w t)) (fvar_id_of fv))
    ((some d) (mentions_any (ldecl_type d) out))
    (none false)))
;; a descent fact that cites a local left out of its obligation: the argument of a recursive
;; call is computed by the recursion itself — nested recursion, which gets no definition
(fn pj_nested ((t Tr) (cx PjCx) (goal Expr)) (List Int)
  (append (show_name (Tr.id t))
    (append (utf8 ": the argument of a recursive call is computed by the recursion itself")
      (append
        (match (pj_beyond_cited (PjCx.beyond cx) goal)
          ((some n)
           (append (utf8 " — it cites ")
             (append (show_name n) (utf8 ", a let bound to the result of a recursive call"))))
          (none (utf8 " — a recursive call stands inside it")))
        (utf8
          ": that it decreases would be a statement over the function's own values, which cannot be made before the function is defined. Nested recursion gets no definition: pass an argument computed without a recursive call")))))
(fn pj_beyond_cited ((bs (List (Prod Int Name))) (goal Expr)) (Option Name)
  (measure (struct bs))
  (match bs
    (nil none)
    ((cons (Prod.mk i n) r)
     (match (pj_beyond_cited r goal)
       ((some m) (some m))
       (none (if (mentions_any goal (list i)) (some n) none))))))
;; the obligation already stating this fact: one call written once and read twice (an `if`'s
;; condition is in its proposition and in its decision), or the same call twice in one scope,
;; is one obligation
(fn obl_stating ((obls (List Declaration)) (stmt Expr)) (Option Name)
  (measure (struct obls))
  (match obls
    (nil none)
    ((cons (AxiomDecl (ConstantVal k _ ty) _) r)
     (if (expr_eq ty stmt) (some k) (obl_stating r stmt)))
    ((cons _ r) (obl_stating r stmt))))
(fn pj_exprs_eq ((as (List Expr)) (bs (List Expr))) Bool
  (measure (struct as))
  (match as
    (nil
      (match bs
        (nil true)
        (_ false)))
    ((cons a r)
     (match bs
       ((cons b br) (if (expr_eq a b) (pj_exprs_eq r br) false))
       (nil false)))))

;; `ite c inst a b` inside a recursive function: `Decidable.rec` with a constant motive, the
;; proof of ¬c a local of the else-branch and of c the then-branch's.
;; The condition goes through the walk as its decision does: a self-call in it — `(if (f x) …)`
;; is `f x = true` — is in the proposition and in the instance both
(fn pj_ite ((t Tr) (cx PjCx) (args (List Expr)) (fuel Int)) TrRes
  (measure (Int.natAbs (- fuel 1)) 3 0)
  (match args
    ((cons alpha (cons c0 (cons inst (cons a (cons b extra)))))
     (match (pj_term t cx c0 (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t0 c)
        (match (pj_term t0 cx inst (- fuel 1))
          ((TrErr x m) (TrErr x m))
          ((TrOk t1 inst1)
           (match (pj_branch t1 cx (n2 (sym "Decidable") (sym "isFalse")) c b fuel)
             ((TrErr x m) (TrErr x m))
             ((TrOk t2 mf)
              (match (pj_branch t2 cx (n2 (sym "Decidable") (sym "isTrue")) c a fuel)
                ((TrErr x m) (TrErr x m))
                ((TrOk t3 mt)
                 (match (rec_app t3 (n1 (sym "Decidable")) nil (list c) alpha (list mf mt) inst1)
                   ((TrErr x m) (TrErr x m))
                   ((TrOk t4 r) (pj_plain t4 cx r extra fuel))))))))))))
    (_ (TrErr (sym "define_matrix") (utf8 "ite")))))
(fn pj_branch ((t Tr) (cx PjCx) (ctor Name) (c Expr) (body Expr) (fuel Int)) TrRes
  (measure (Int.natAbs (- fuel 1)) 1 0)
  (match (rz_open_ctor t ctor nil (list c))
    ((Prod.mk _ none)
     (TrErr (sym "equation_form")
       (append (show_name ctor) (utf8 ": K could not open the constructor"))))
    ((Prod.mk t1 (some (Prod.mk fields _)))
     (match (pj_term t1 (pj_push cx false (field_fvars fields)) body (- fuel 1))
       ((TrErr x m) (TrErr x m))
       ((TrOk t2 b)
        (match (tr_lams t2 (field_fvars fields) b)
          ((Prod.mk t3 r) (TrOk t3 r))))))))

;; a matcher application `match_N params motive s alt…`: each alternative rebuilt under its
;; row's variables. Where s is a local that tables' types mention (a structural recursion),
;; the motive becomes `λ s' . B[s'] → motive s'` at the universe K infers, each alternative
;; takes the refined tables `B[pattern]` as its last binders, and the application is applied to
;; the tables (Lean's MatcherApp.addArg): the matcher K checked is the case tree, never unfolded
(fn pj_match
  ((t Tr)
   (cx PjCx)
   (c Name)
   (ls (List Level))
   (np Int)
   (rows (List (List MtPat)))
   (args (List Expr))
   (fuel Int))
  TrRes
  (measure (Int.natAbs (- fuel 1)) 4 0)
  (let ((params (take np args)) (nalts (len rows)))
    (match (drop np args)
      ((cons motive (cons s rest))
       (match motive
         ((Lam _ _ _ dty mbody)
          (match (pj_term t cx s (- fuel 1))
            ((TrErr x m) (TrErr x m))
            ((TrOk t1 s1)
             (if (pj_carries_eq (PjCx.kind cx))
               (pj_match_eq t1 cx c ls params s1 dty mbody rows (take nalts rest) (drop nalts rest)
                 fuel)
               (let ((gen (pj_tables_on (PjCx.tables cx) s1)))
                 (match (pj_motive t1 gen s1 dty mbody ls)
                   ((Prod.mk _ none)
                    (TrErr (sym "define_matrix")
                      (utf8 "K could not type a matcher's generalized motive")))
                   ((Prod.mk t2 (some (Prod.mk motive1 ls1)))
                    (match (pj_alts t2 cx gen (fvar_id_of s1) dty rows (take nalts rest) fuel nil)
                      ((Prod.mk _ (Left2 x m)) (TrErr x m))
                      ((Prod.mk t3 (Right2 (Prod.mk alts1 _)))
                       (match
                         (tr_apps t3 (mk_const c ls1)
                           (append params (cons motive1 (cons s1 (append alts1 (firsts_of gen))))))
                         ((Prod.mk t4 r) (pj_plain t4 cx r (drop nalts rest) fuel))))))))))))
         (_ (TrErr (sym "define_matrix") (utf8 "a matcher's motive is not a lambda")))))
      (_ (TrErr (sym "define_matrix") (utf8 "a matcher without its scrutinee"))))))
;; under a measure a matcher carries its equation: the motive `λ s' . s = s' →
;; motive s'`, each alternative's last binder `h : s = pattern`, the application applied to
;; `Eq.refl s` — Lean's `match h : s with`, by addArg on the matcher K checked. A descent
;; obligation in an arm is then stated under the fact that the scrutinee is the pattern
;; (`skip_ws cs = cons c rest`): without it the obligation of a call on a pattern variable is
;; about an arbitrary value and no proof exists. The equations of the function are stated over
;; the same shape (PkEqn), so a matcher at a constructor still computes: `alt fields (Eq.refl _)`
(fn pj_match_eq
  ((t Tr)
   (cx PjCx)
   (c Name)
   (ls (List Level))
   (params (List Expr))
   (s1 Expr)
   (dty Expr)
   (mbody Expr)
   (rows (List (List MtPat)))
   (alts (List Expr))
   (extra (List Expr))
   (fuel Int))
  TrRes
  (measure (Int.natAbs (- fuel 1)) 3 0)
  (match (tr_infer t dty)
    ((Prod.mk _ none)
     (TrErr (sym "define_matrix") (utf8 "K could not type a matcher's scrutinee type")))
    ((Prod.mk t0 (some srt))
     (match (tr_whnf t0 srt)
       ((Prod.mk t1 (some (Sort _ u)))
        (match (tr_local t1 (n1 (sym "x")) dty)
          ((Prod.mk t2 s0)
           (match (tr_inst1 t2 mbody s0)
             ((Prod.mk t3 ret0)
              (match
                (tr_local t3 (n1 (sym "h")) (mk_app_n (mk_const (nm_eq) (list u)) (list dty s1 s0)))
                ((Prod.mk t4 h0)
                 (match (tr_pis t4 (list h0) ret0)
                   ((Prod.mk t5 pi)
                    (match (tr_infer t5 pi)
                      ((Prod.mk _ none)
                       (TrErr (sym "define_matrix")
                         (utf8 "K could not type a matcher's motive under its equation")))
                      ((Prod.mk t6 (some psrt))
                       (match (tr_whnf t6 psrt)
                         ((Prod.mk t7 (some (Sort _ l)))
                          (match (tr_lams t7 (list s0) pi)
                            ((Prod.mk t8 motive1)
                             (match (pj_alts_eq t8 cx s1 dty u rows alts fuel nil)
                               ((Prod.mk _ (Left2 x m)) (TrErr x m))
                               ((Prod.mk t9 (Right2 (Prod.mk alts1 _)))
                                (match
                                  (tr_apps t9 (mk_const c (cons l (drop 1 ls)))
                                    (append params
                                      (cons motive1
                                        (cons s1
                                          (append alts1
                                            (list
                                              (mk_app_n (mk_const (nm_eq_refl) (list u))
                                                (list dty s1))))))))
                                  ((Prod.mk t10 r) (pj_plain t10 cx r extra fuel))))))))
                         ((Prod.mk _ _)
                          (TrErr (sym "define_matrix")
                            (utf8 "a matcher's motive under its equation is not a type")))))))))))))))
       ((Prod.mk _ _)
        (TrErr (sym "define_matrix") (utf8 "a matcher's scrutinee type is not a type")))))))
(fn pj_alts_eq
  ((t Tr)
   (cx PjCx)
   (s1 Expr)
   (dty Expr)
   (u Level)
   (rows (List (List MtPat)))
   (alts (List Expr))
   (fuel Int)
   (acc (List Expr)))
  (Prod Tr Either2)
  (measure (Int.natAbs (- fuel 1)) 1 (List.length rows))
  (match rows
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) dty))))
    ((cons row rr)
     (match alts
       (nil
         (Prod.mk t
           (Left2 (sym "define_matrix") (utf8 "a matcher with fewer alternatives than rows"))))
       ((cons alt ar)
        (match row
          ((cons pat nil)
           (match (mt_pat_term (Tr.w t) pat dty nil 256)
             ((MtPtErr x m) (Prod.mk t (Left2 x m)))
             ((MtPtOk w1 pterm0 vars0)
              (match (pj_row_open (tr_set_w t w1) alt vars0 pterm0)
                ((Prod.mk t1 (Prod.mk vars (Prod.mk body pterm)))
                 (match
                   (tr_local t1 (n1 (sym "h"))
                     (mk_app_n (mk_const (nm_eq) (list u)) (list dty s1 pterm)))
                   ((Prod.mk t2 h)
                    (match (pj_term t2 (pj_push cx false (append vars (list h))) body (- fuel 1))
                      ((TrErr x m) (Prod.mk t2 (Left2 x m)))
                      ((TrOk t3 b)
                       (match (tr_lams t3 (append vars (list h)) b)
                         ((Prod.mk t4 alt1) (pj_alts_eq t4 cx s1 dty u rr ar fuel (cons alt1 acc)))))))))))))
          (_
            (Prod.mk t (Left2 (sym "define_matrix") (utf8 "a matcher row over several scrutinees"))))))))))
;; a row opened: its variables under the alternative's own binder names with the pattern over
;; them (an alternative with fewer binders than the row has variables keeps the pattern's own)
(fn pj_row_open ((t Tr) (alt Expr) (vars (List Expr)) (pterm Expr))
  (Prod Tr (Prod (List Expr) (Prod Expr Expr)))
  (match (pj_open_named t alt (len vars) nil)
    ((Prod.mk t1 (Prod.mk nvars body))
     (if (= (len nvars) (len vars))
       (match (pj_subst_list t1 pterm vars nvars)
         ((Prod.mk t2 pterm1) (Prod.mk t2 (Prod.mk nvars (Prod.mk body pterm1)))))
       (match (pj_inst_lams t alt vars)
         ((Prod.mk t3 body3) (Prod.mk t3 (Prod.mk vars (Prod.mk body3 pterm)))))))))
;; the tables whose type (over the abstract motive) mentions the scrutinee, when it is a local
(fn pj_tables_on ((tables (List (Prod Expr Expr))) (s Expr)) (List (Prod Expr Expr))
  (measure (struct tables))
  (match s
    ((FVar _ id)
     (match tables
       (nil nil)
       ((cons (Prod.mk b ty) r)
        (if (mentions_any ty (list id)) (cons (Prod.mk b ty) (pj_tables_on r s)) (pj_tables_on r s)))))
    (_ nil)))
(fn firsts_of ((ps (List (Prod Expr Expr)))) (List Expr)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (Prod.mk a _) r) (cons a (firsts_of r)))))
;; the motive and the matcher's levels: unchanged without tables; else generalized, its universe
;; K's sort of the generalized result
(fn pj_motive
  ((t Tr) (gen (List (Prod Expr Expr))) (s Expr) (dty Expr) (mbody Expr) (ls (List Level)))
  (Prod Tr (Option (Prod Expr (List Level))))
  (match (tr_local t (n1 (sym "x")) dty)
    ((Prod.mk t1 s0)
     (match (tr_inst1 t1 mbody s0)
       ((Prod.mk t2 ret0)
        (match gen
          (nil
            (match (tr_lams t2 (list s0) ret0)
              ((Prod.mk t3 m1) (Prod.mk t3 (some (Prod.mk m1 ls))))))
          (_
            (match (pj_table_locals t2 gen (fvar_id_of s) s0 nil)
              ((Prod.mk t3 glocals)
               (match (tr_pis t3 (firsts_of glocals) ret0)
                 ((Prod.mk t4 pi)
                  (match (tr_infer t4 pi)
                    ((Prod.mk t5 none) (Prod.mk t5 none))
                    ((Prod.mk t5 (some srt))
                     (match (tr_whnf t5 srt)
                       ((Prod.mk t6 (some (Sort _ l)))
                        (match (tr_lams t6 (list s0) pi)
                          ((Prod.mk t7 m1) (Prod.mk t7 (some (Prod.mk m1 (cons l (drop 1 ls))))))))
                       ((Prod.mk t6 _) (Prod.mk t6 none))))))))))))))))
;; for each table a fresh local at its real type with the scrutinee replaced, paired with its
;; abstract type replaced the same way
(fn pj_table_locals
  ((t Tr) (gen (List (Prod Expr Expr))) (sid Int) (v Expr) (acc (List (Prod Expr Expr))))
  (Prod Tr (List (Prod Expr Expr)))
  (measure (struct gen))
  (match gen
    (nil (Prod.mk t (rev acc)))
    ((cons (Prod.mk b babs) r)
     (match (tr_type_of_local t b)
       (none (pj_table_locals t r sid v acc))
       ((some breal)
        (match (tr_subst t breal sid v)
          ((Prod.mk t1 breal1)
           (match (tr_subst t1 babs sid v)
             ((Prod.mk t2 babs1)
              (match (tr_local t2 (n1 (sym "below")) breal1)
                ((Prod.mk t3 fv) (pj_table_locals t3 r sid v (cons (Prod.mk fv babs1) acc)))))))))))))
(fn pj_alts
  ((t Tr)
   (cx PjCx)
   (gen (List (Prod Expr Expr)))
   (sid Int)
   (dty Expr)
   (rows (List (List MtPat)))
   (alts (List Expr))
   (fuel Int)
   (acc (List Expr)))
  (Prod Tr Either2)
  (measure (Int.natAbs (- fuel 1)) 1 (List.length rows))
  (match rows
    (nil (Prod.mk t (Right2 (Prod.mk (rev acc) dty))))
    ((cons row rr)
     (match alts
       (nil
         (Prod.mk t
           (Left2 (sym "define_matrix") (utf8 "a matcher with fewer alternatives than rows"))))
       ((cons alt ar)
        (match row
          ((cons pat nil)
           (match (mt_pat_term (Tr.w t) pat dty nil 256)
             ((MtPtErr x m) (Prod.mk t (Left2 x m)))
             ((MtPtOk w1 pterm vars)
              (match (pj_inst_lams (tr_set_w t w1) alt vars)
                ((Prod.mk t1 body)
                 (match (pj_table_locals t1 gen sid pterm nil)
                   ((Prod.mk t2 tlocals)
                    (let
                      ((cx1
                         (pj_push (with PjCx cx (tables (append tlocals (PjCx.tables cx)))) false
                           (append vars (firsts_of tlocals)))))
                      (match (pj_term t2 cx1 body (- fuel 1))
                        ((TrErr x m) (Prod.mk t2 (Left2 x m)))
                        ((TrOk t3 b)
                         (match (tr_lams t3 (append vars (firsts_of tlocals)) b)
                           ((Prod.mk t4 alt1)
                            (pj_alts t4 cx gen sid dty rr ar fuel (cons alt1 acc))))))))))))))
          (_
            (Prod.mk t (Left2 (sym "define_matrix") (utf8 "a matcher row over several scrutinees"))))))))))

;; ---- a group of functions that call each other: one well-founded fixpoint ----------------------
;; Lean's WF.Fix over a domain made for the group: an inductive type `f_1.args` with one
;; constructor per member, its fields the member's data binders — the tagged union of the
;; members' arguments, with no tuple and nothing of Init beyond what one measured function
;; needs. The result type C and the measure M are each `f_1.args.rec` over the constructors;
;; the functional F is one `f_1.args.rec` whose motive carries the recursion hypothesis —
;; `λ x. (∀ y, rel y x → C y) → C x` — each minor a member's body under its own binders, a call
;; to member j `rec (c_j args) (f_i.dec_N locals…)`. One constant holds the fixpoint,
;; `f_1.mutual := λ x. WellFounded.fix … F x`; one theorem unfolds it, `f_1.mutual.eq`, by
;; WellFounded.fix_eq; each member is the fixpoint at its constructor. The members'
;; pre-definitions are read in one state (predef.shard read_predef_from), so every term here
;; is one walk's.

;; a call to a member under the equations' statement: the call stays a call; in the group's
;; functional: the recursion hypothesis at the callee's constructor
(fn pj_member ((t Tr) (cx PjCx) (id Int) (args (List Expr)) (fuel Int)) TrRes
  (measure (Int.natAbs (- fuel 1)) 2 0)
  (match (pj_terms t cx args fuel nil)
    ((Prod.mk _ (Left2 x m)) (TrErr x m))
    ((Prod.mk t1 (Right2 (Prod.mk dargs _)))
     (match (PjCx.kind cx)
       ((PkGrp _ _ _ _) (pj_grp_call t1 cx id dargs))
       (_
         (match (tr_apps t1 (mk_fvar id) dargs)
           ((Prod.mk t2 r) (TrOk t2 r))))))))
(fn pj_callee_of ((cs (List PjCallee)) (id Int)) (Option PjCallee)
  (measure (struct cs))
  (match cs
    (nil none)
    ((cons (PjCallee i c m data) r) (if (= i id) (some (PjCallee i c m data)) (pj_callee_of r id)))))
;; `rec (c_j args) (f_i.dec_N locals…)`: the obligation is the comparison of the callee's
;; measure at the arguments with the caller's at its parameters, named under the caller in the
;; caller's own count, stated over every local in scope at the call — the caller's binders
;; first, each by its name (pj_self's obligation, with no tuple)
(fn pj_grp_call ((t Tr) (cx PjCx) (id Int) (dargs (List Expr))) TrRes
  (match (PjCx.kind cx)
    ((PkGrp recl m _ callees)
     (match (pj_callee_of callees id)
       (none (TrErr (sym "define_matrix") (utf8 "a call to a function outside the group")))
       ((some (PjCallee _ ctor cm cdata))
        (let ((n (len cdata)))
          (if (< (len dargs) n)
            (TrErr (sym "function_value")
              (append (show_name (Tr.id t))
                (utf8
                  ": a member of its group is not applied to all its arguments (no function values)")))
            (match (tr_apps t (mk_const ctor nil) (take n dargs))
              ((Prod.mk t2 tagged)
               (match (pj_subst_list t2 cm cdata (take n dargs))
                 ((Prod.mk t30 ma)
                  (match (wf_goal t30 m ma m)
                    ((Prod.mk t3 goal)
                     (match (pj_obl_scope t3 cx)
                       ((Prod.mk over out)
                        (if (mentions_any goal out)
                          (TrErr (sym "nested_recursion") (pj_nested t3 cx goal))
                          (match (tr_pis t3 (scope_fvars over) goal)
                            ((Prod.mk t4 stmt)
                             (let ((had (obl_stating_under (Tr.obls t4) (Tr.id t4) stmt)))
                               (let
                                 ((name Name
                                    (match had
                                      ((some k) k)
                                      (none
                                        (name_append (Tr.id t4)
                                          (n1
                                            (sym_of_chars
                                              (append (utf8 "dec_")
                                                (show_nat (+ 1 (obls_under (Tr.obls t4) (Tr.id t4))))))))))))
                                 (match (tr_apps t4 (mk_const name nil) (scope_lambda_fvars over))
                                   ((Prod.mk t5 proof)
                                    (match
                                      (tr_apps t5 recl (cons tagged (cons proof (drop n dargs))))
                                      ((Prod.mk t6 r)
                                       (TrOk
                                         (match had
                                           ((some _) t6)
                                           (none
                                             (tr_add_obl t6
                                               (AxiomDecl (ConstantVal name nil stmt) false))))
                                         r)))))))))))))))))))))))
    (_ (TrErr (sym "define_matrix") (utf8 "a group call outside a group")))))
;; the obligations named under one owner: their count, and the one stating a fact already
(fn obl_owner_is ((k Name) (owner Name)) Bool
  (match k
    ((Str p _) (name_eq p owner))
    (_ false)))
(fn obls_under ((obls (List Declaration)) (owner Name)) Int
  (measure (struct obls))
  (match obls
    (nil 0)
    ((cons (AxiomDecl (ConstantVal k _ _) _) r)
     (+ (if (obl_owner_is k owner) 1 0) (obls_under r owner)))
    ((cons _ r) (obls_under r owner))))
(fn obl_stating_under ((obls (List Declaration)) (owner Name) (stmt Expr)) (Option Name)
  (measure (struct obls))
  (match obls
    (nil none)
    ((cons (AxiomDecl (ConstantVal k _ ty) _) r)
     (if (bool_and (obl_owner_is k owner) (expr_eq ty stmt)) (some k)
     (obl_stating_under r owner stmt)))
    ((cons _ r) (obl_stating_under r owner stmt))))
(fulfills pj_term.dec_1
  (by
    (intro t cx e fuel h1 h2 dd n bi dom b he t1 fv hl t2 b1 hi)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_term.dec_2
  (by (intro t cx e fuel h1 h2 dd n ty v b he) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_term.dec_3
  (by
    (intro t cx e fuel h1 h2 dd n ty v b he t1 v1 t2 fv hl t3 b1 hi)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_term.dec_4
  (by (intro t cx e fuel h1 h2 dd s i x he) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_term.dec_5
  (by (intro t cx e fuel h1 h2 o he) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_1
  (by
    (intro t cx head args fuel h dd id he h1 h2)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_2
  (by
    (intro t cx head args fuel h dd id he h1 h2)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_3
  (by (intro t cx head args fuel h dd id he h1) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_4
  (by
    (intro t cx head args fuel h dd c ls he h1 np ns rows hm h2)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_5
  (by
    (intro t cx head args fuel h dd c ls he h1 np ns rows hm h2)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_6
  (by
    (intro t cx head args fuel h dd c ls he h1 hm)
    (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_7
  (by (intro t cx head args fuel h dd c ls he h1) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_8
  (by (intro t cx head args fuel h o he) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_app.dec_9
  (by (intro t cx head args fuel h o he t1 hd) (apply Prod.Lex.left (apply natAbs_pred (arith)))))
(fulfills pj_plain.dec_1
  (by (intro t cx head args fuel) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_terms.dec_1
  (by (intro t cx es fuel acc e r h) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_terms.dec_2
  (by
    (intro t cx es fuel acc e r h t1 e1)
    (rw h)
    (rw List.length_cons)
    (apply Prod.Lex.right (apply Prod.Lex.right (arith)))))
(fulfills pj_self.dec_1
  (by (intro t cx args fuel h) (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_ite.dec_1
  (by
    (intro t cx args fuel alpha c0 inst a b extra h)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_ite.dec_2
  (by
    (intro t cx args fuel alpha c0 inst a b extra h t0 c)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_ite.dec_3
  (by
    (intro t cx args fuel alpha c0 inst a b extra h t0 c t1 inst1)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_ite.dec_4
  (by
    (intro t cx args fuel alpha c0 inst a b extra h t0 c t1 inst1 t2 mf)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_ite.dec_5
  (by
    (intro t cx args fuel alpha c0 inst a b extra h t0 c t1 inst1 t2 mf t3 mt t4 r hr)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_branch.dec_1
  (by
    (intro t cx ctor c body fuel t1 fields o h)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match.dec_1
  (by
    (intro t cx c ls np rows args fuel motive s rest hd d1 d2 d3 dty mbody hm)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match.dec_2
  (by
    (intro t cx c ls np rows args fuel motive s rest hd d1 d2 d3 dty mbody hm t1 s1 hc t2 motive1
      ls1 hp)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match.dec_3
  (by
    (intro t cx c ls np rows args fuel motive s rest hd d1 d2 d3 dty mbody hm t1 s1 hc t2 motive1
      ls1 hp t3 alts1 x t4 r ha)
    (apply Prod.Lex.right (apply Prod.Lex.left (arith)))))
(fulfills pj_match.dec_4
  (by
