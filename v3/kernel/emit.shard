;;; v3/kernel/emit.shard — a loaded closure as the C text of its binary: the back end's
;;; driver (v3/LANGUAGE.md §8.7 slice 5.0 rules 2 and 4; law §9.1 route 1). `load.shard --emit
;;; DIR FILE…` loads the closure and hands the program the load yielded to the two stages —
;;; lower.shard (the program in the restricted form RS) and cgen.shard (RS as C over rt.h) —,
;;; in this process: nothing is printed and read back. DIR then holds
;;;
;;;   main.c, pNNNN.c   the C text; `cc -o BIN DIR/main.c -I v3/kernel` builds the binary
;;;   map               one line per declaration of the program: its C name (a function's) or
;;;                     its last component, its kind, its identity, its module's source file
;;;                     (R85: the generated text is a derivation, never an origin)
;;;   sources           each module's source file and hash (load.shard writes it)
;;;
;;; The entry is the root module's `main`. What the back end cannot take is refused before
;;; any file is written, the first refusal on the `EMIT:` line (lower.shard and cgen.shard
;;; list theirs).
;;;
;;; Until slice 5.0 this file printed the closure in the old tree's dialect for the old tree's
;;; chain to read (slices 4.1 and 4.4); the bridge it carried is lower.shard's rows and roles.

(import "prog.shard")
(import "etable.shard")
(import "lower.shard")
(import "cgen.shard")
(use kernel.cgen)
(use kernel.etable)
(use kernel.lower)
(use kernel.name)
(use kernel.prelude)
(use kernel.prog)
(use kernel.util)
(use kernel.cgen.CgRes)
(use kernel.etable.ESt)
(use kernel.lower.LwRes)
(use kernel.name.Name)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EDecl)
(use kernel.prog.Prog)

;; the files (name, text) with main.c first, the map's lines, the entry file's name, the
;; closure's modules; or the first refusal
(type EmitRes
  (EmitOk (List (Pair (List Int) (List Int))) (List (List Int)) (List Int) Int)
  (EmitFail (List Int)))

;; mf: module → its source file (the load's MODULE records)
(fn emit_prog ((es ESt) (p Prog) (root Name) (mf (List (Pair Name (List Int))))) EmitRes
  (match (lw_prog p)
    ((LwRefused errs) (EmitFail (em_first errs)))
    ((LwProg rs)
     (match (cg_prog rs (Str root (quote main)))
       ((CgRefused errs) (EmitFail (em_first errs)))
       ((CgFiles fs _)
        (match p
          ((Prog ds) (EmitOk fs (em_map es ds mf) "main.c" (len (em_modules es ds Nil))))))))))
(fn em_first ((errs (List (List Int)))) (List Int)
  (match errs
    (Nil "refused")
    ((Cons m _) m)))

;; ---- the map: one line per declaration of the loaded program ---------------------------------
(fn em_map ((es ESt) (ds (List EDecl)) (mf (List (Pair Name (List Int))))) (List (List Int))
  (measure (struct ds))
  (match ds
    (Nil Nil)
    ((Cons d r)
     (Cons
       (append (em_decl_name d)
         (append " "
           (append (em_kind d)
             (append " "
               (append (show_name (edecl_name d))
                 (append " " (em_source (em_module es (edecl_name d)) mf)))))))
       (em_map es r mf)))))
(fn em_kind ((d EDecl)) (List Int)
  (match d
    ((EInd _ _ _) "type")
    ((EFn _ _ _ _ _ _) "fn")
    ((EExtern _ _ _ _) "extern")
    ((ESig _ _ _ _) "sig")
    ((ESigType _ _) "sigtype")))
(fn em_decl_name ((d EDecl)) (List Int)
  (match d
    ((EFn n _ _ _ _ _) (cg_fname n))
    (_ (em_short (edecl_name d)))))
(fn em_short ((n Name)) (List Int)
  (match n
    ((Str _ s) (chars_of_sym s))
    ((Num _ k) (show_nat k))
    (Anon "anon")))
(fn em_module ((es ESt) (n Name)) Name
  (match (es_module es n)
    ((Some m) m)
    (None Anon)))
(fn em_source ((m Name) (mf (List (Pair Name (List Int))))) (List Int)
  (measure (struct mf))
  (match mf
    (Nil "(no source file)")
    ((Cons (Pair k f) r) (if (name_eq k m) f (em_source m r)))))
;; the closure's modules, each once
(fn em_modules ((es ESt) (ds (List EDecl)) (acc (List Name))) (List Name)
  (measure (struct ds))
  (match ds
    (Nil acc)
    ((Cons d r)
     (let ((m (em_module es (edecl_name d))))
       (em_modules es r (if (mem_name m acc) acc (Cons m acc)))))))
