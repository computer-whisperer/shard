;;; v3/kernel/erase.shard — roles, levels and E-eligibility over the checked
;;; environment. Which inductives of K's
;;; environment are E types — Init's `List`, `Option`, `Bool`, `Decidable`,
;;; a native `inductive` — registered into the E table on first citation;
;;; the roles of a constant's binders (a type parameter, erased evidence,
;;; runtime data with its E type), which the supplied `realize` checks a
;;; signature against and the derived view erases a body by. `Nat` and
;;; `Int` are never E inductives: their realization is the integer. Nor are
;;; the registry's type rows (`rep_row`): `Fin`, `Subtype`, `BitVec`,
;;; `UInt8`, `Array`, `ByteArray`, `String`, each represented by its one
;;; runtime field.
(import "etable.shard")
(import "kw.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.decl)
(use kernel.descent)
(use kernel.k)
(use kernel.kw)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.prog)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.Expr)
(use kernel.kw.W)
(use kernel.level.Level)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.EType)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.sexpr.SExpr)

;; the module a constant registers under: its declaring module, else Init
(fn decl_module ((sc Scope) (n Name)) Name
  (match (sc_vis sc)
    (VisAll (init_module))
    ((VisOnly _ tbl _ _ _)
     (match (tbl_find tbl n)
       ((some m) m)
       (none (init_module))))))
(fn is_nat_or_int ((n Name)) Bool (bool_or (name_eq n (nm_nat)) (name_eq n (nm_int_ty))))
;; the realization registry's type rows: a structure
;; represented by its one runtime field — in E its constructor is that argument and the
;; field's projection its subject (erasure.shard), its E type its own name over its type
;; arguments. A UInt8 is an integer below 256, a ByteArray and an Array Init's List cells, a
;; String its UTF-8 bytes. Never an E inductive: no E-first body cites a row's constructor,
;; so the two routes cannot disagree on the cells
(fn rep_row ((n Name)) Bool
  (bool_or (name_eq n (n1 (sym "Fin")))
    (bool_or (name_eq n (n1 (sym "Subtype")))  ; the ghost refinement
      (bool_or (name_eq n (n1 (sym "BitVec")))
        (bool_or (name_eq n (n1 (sym "UInt8")))
          (bool_or (name_eq n (n1 (sym "Array")))
            (bool_or (name_eq n (n1 (sym "ByteArray"))) (name_eq n (nm_string)))))))))

;; ---- levels: a constant's level parameters solved so that its Sort binders are Type -----------
(fn solve_levels ((info ConstantInfo)) (Option (List Level))
  (match (solve_tele (ci_type info) nil)
    (none none)
    ((some sol) (some (levels_from (ci_lparams info) sol)))))
;; the bindings from the binder sorts, then the result sort — which needs no shape of its own
;; when the binders solved every parameter it names (`Prod.{u v} : Type (max u v)`); None on a
;; conflict or an unsolvable Sort
(fn solve_tele ((t Expr) (sol (List (Prod Name Level)))) (Option (List (Prod Name Level)))
  (measure (struct t))
  (match t
    ((Pi _ _ _ dom body)
     (match (solve_sort dom sol)
       (none none)
       ((some sol1) (solve_tele body sol1))))
    ((Sort _ l) (if (all_solved (level_params l nil) sol) (some sol) (solve_sort t sol)))
    (_ (solve_sort t sol))))
(fn level_params ((l Level) (acc (List Name))) (List Name)
  (measure (struct l))
  (match l
    ((LParam p) (cons p acc))
    ((LSucc a) (level_params a acc))
    ((LMax a b) (level_params a (level_params b acc)))
    ((LIMax a b) (level_params a (level_params b acc)))
    ((LMVar _) acc)
    (LZero acc)))
(fn all_solved ((ps (List Name)) (sol (List (Prod Name Level)))) Bool
  (measure (struct ps))
  (match ps
    (nil true)
    ((cons p r)
     (match (assoc_level p sol)
       ((some _) (all_solved r sol))
       (none false)))))
;; `Sort (succ p)` binds p := 0, `Sort p` binds p := 1; a Sort of another shape over a parameter is unsolvable
(fn solve_sort ((e Expr) (sol (List (Prod Name Level)))) (Option (List (Prod Name Level)))
  (match e
    ((Sort _ (LSucc (LParam p))) (bind_level p LZero sol))
    ((Sort _ (LParam p)) (bind_level p (LSucc LZero) sol))
    ((Sort _ l) (if (level_has_param l) none (some sol)))
    (_ (some sol))))
(fn bind_level ((p Name) (l Level) (sol (List (Prod Name Level)))) (Option (List (Prod Name Level)))
  (match (assoc_level p sol)
    (none (some (cons (Prod.mk p l) sol)))
    ((some l2) (if (level_eq l l2) (some sol) none))))
(fn assoc_level ((p Name) (sol (List (Prod Name Level)))) (Option Level)
  (measure (struct sol))
  (match sol
    (nil none)
    ((cons (Prod.mk q l) r) (if (name_eq p q) (some l) (assoc_level p r)))))
;; every parameter in order; an unsolved one is 0
(fn levels_from ((ps (List Name)) (sol (List (Prod Name Level)))) (List Level)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r)
     (cons
       (match (assoc_level p sol)
         ((some l) l)
         (none LZero))
       (levels_from r sol)))))
;; a constant's type at its solved levels
(fn type_at_levels ((w W) (info ConstantInfo)) (Prod W (Option (Prod (List Level) Expr)))
  (match (solve_levels info)
    (none (Prod.mk w none))
    ((some ls)
     (match (w_inst_lparams w (ci_type info) (ci_lparams info) ls)
       ((Prod.mk w1 ty) (Prod.mk w1 (some (Prod.mk ls ty))))))))

;; ---- E-eligibility -----------------------------------------------------------------------
;; an inductive of the environment is an E type: no indices, not in Prop, its parameters
;; types or propositions, its fields E types or propositions; registered with its
;; constructors (runtime field types over the type parameters) on the first yes.
;; `pending` holds the inductives under examination (a field of the type itself, or a
;; nested occurrence, counts as eligible while its own check runs).
(fn ind_eligible ((w W) (es ESt) (sc Scope) (n Name) (pending (List Name))) (Prod (Prod W ESt) Bool)
  (if (bool_or (is_nat_or_int n) (rep_row n)) (Prod.mk (Prod.mk w es) false)
  (if (mem_name n pending) (Prod.mk (Prod.mk w es) true)
  (match (es_info es n)
    ((some (EIInd _ _)) (Prod.mk (Prod.mk w es) true))
    ((some _) (Prod.mk (Prod.mk w es) false))
    (none
      (match (env_find (w_env w) n)
        ((some info)
         (match info
           ((InductInfo _ nparams nindices _ ctors _ _ unsafe refl)
            (if (bool_or (bool_not (= nindices 0)) (bool_or unsafe refl))
              (Prod.mk (Prod.mk w es) false)
              (match (type_at_levels w info)
                ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) false))
                ((Prod.mk w1 (some (Prod.mk ls ty)))
                 (match (ind_params w1 ty nparams nil nil)
                   ((Prod.mk w2 none) (Prod.mk (Prod.mk w2 es) false))
                   ((Prod.mk w2 (some (Prod.mk fvs tps)))
                    (match (ind_ctors w2 es sc n ctors ls fvs tps (cons n pending) nil)
                      ((Prod.mk (Prod.mk w3 es3) none) (Prod.mk (Prod.mk w3 es3) false))
                      ((Prod.mk (Prod.mk w3 es3) (some cdefs))
                       (Prod.mk (Prod.mk w3 (register_ind es3 (decl_module sc n) n (len tps) cdefs))
                         true)))))))))
           (_ (Prod.mk (Prod.mk w es) false))))
        (none (Prod.mk (Prod.mk w es) false))))))))
;; the parameters opened as locals: all of them (in order) and the type parameters among them;
;; then the result must be a Sort above Prop
(fn ind_params ((w W) (ty Expr) (k Int) (fvs (List Expr)) (tps (List Expr)))
  (Prod W (Option (Prod (List Expr) (List Expr))))
  (measure k)
  (match (w_whnf w ty)
    ((Prod.mk w1 none) (Prod.mk w1 none))
    ((Prod.mk w1 (some t))
     (if (<= k 0)
       (match t
         ((Sort _ l)
          (if (is_zero (normalize l)) (Prod.mk w1 none)
          (Prod.mk w1 (some (Prod.mk (rev fvs) (rev tps))))))
         (_ (Prod.mk w1 none)))
       (match t
         ((Pi _ n _ dom body)
          (match (sort_role w1 dom)
            ((Prod.mk w2 none) (Prod.mk w2 none))
            ((Prod.mk w2 (some is_type))
             (match (w_local w2 n dom)
               ((Prod.mk w3 fv)
                (match (w_inst1 w3 body fv)
                  ((Prod.mk w4 body1)
                   (ind_params w4 body1 (- k 1) (cons fv fvs) (if is_type (cons fv tps) tps)))))))))
         (_ (Prod.mk w1 none)))))))
;; a parameter's binder type: Some True for Type, Some False for Prop, None otherwise
(fn sort_role ((w W) (dom Expr)) (Prod W (Option Bool))
  (match (w_whnf w dom)
    ((Prod.mk w1 (some (Sort _ l)))
     (let ((nl (normalize l)))
       (if (is_zero nl) (Prod.mk w1 (some false))
       (if (is_one nl) (Prod.mk w1 (some true))
       (Prod.mk w1 none)))))
    ((Prod.mk w1 _) (Prod.mk w1 none))))
;; the type parameters' roles of a registered (or eligible) inductive: True = a type parameter, False = erased
(fn ind_param_roles ((w W) (n Name)) (Prod W (Option (List Bool)))
  (match (env_find (w_env w) n)
    ((some info)
     (match info
       ((InductInfo _ nparams _ _ _ _ _ _ _)
        (match (type_at_levels w info)
          ((Prod.mk w1 none) (Prod.mk w1 none))
          ((Prod.mk w1 (some (Prod.mk _ ty))) (param_roles w1 ty nparams nil))))
       (_ (Prod.mk w none))))
    (none (Prod.mk w none))))
(fn param_roles ((w W) (ty Expr) (k Int) (acc (List Bool))) (Prod W (Option (List Bool)))
  (measure k)
  (if (<= k 0) (Prod.mk w (some (rev acc)))
  (match (w_whnf w ty)
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (sort_role w1 dom)
       ((Prod.mk w2 none) (Prod.mk w2 none))
       ((Prod.mk w2 (some is_type))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1) (param_roles w4 body1 (- k 1) (cons is_type acc)))))))))
    ((Prod.mk w1 _) (Prod.mk w1 none)))))
;; a row's parameters: True for a type parameter, False for anything else — a
;; proposition, or a value (`Fin n`, `BitVec w`), which the E type drops
(fn row_param_roles ((w W) (n Name)) (Prod W (Option (List Bool)))
  (match (env_find (w_env w) n)
    ((some info)
     (match info
       ((InductInfo _ nparams nindices _ (cons _ nil) _ _ _ _)
        (if (bool_not (= nindices 0)) (Prod.mk w none)
        (match (type_at_levels w info)
          ((Prod.mk w1 none) (Prod.mk w1 none))
          ((Prod.mk w1 (some (Prod.mk _ ty))) (row_roles w1 ty nparams nil)))))
       (_ (Prod.mk w none))))
    (none (Prod.mk w none))))
(fn row_roles ((w W) (ty Expr) (k Int) (acc (List Bool))) (Prod W (Option (List Bool)))
  (measure k)
  (if (<= k 0) (Prod.mk w (some (rev acc)))
  (match (w_whnf w ty)
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (sort_role w1 dom)
       ((Prod.mk w2 r)
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1)
              (row_roles w4 body1 (- k 1)
                (cons
                  (match r
                    ((some true) true)
                    (_ false))
                  acc)))))))))
    ((Prod.mk w1 _) (Prod.mk w1 none)))))
;; each constructor's runtime field types over the type parameters
(fn ind_ctors
  ((w W)
   (es ESt)
   (sc Scope)
   (ind Name)
   (cs (List Name))
   (ls (List Level))
   (fvs (List Expr))
   (tps (List Expr))
   (pending (List Name))
   (acc (List ECtorDef)))
  (Prod (Prod W ESt) (Option (List ECtorDef)))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (Prod.mk w es) (some (rev acc))))
    ((cons c r)
     (match (env_find (w_env w) c)
       ((some info)
        (match (w_inst_lparams w (ci_type info) (ci_lparams info) ls)
          ((Prod.mk w1 cty)
           (match (inst_params w1 cty fvs)
             ((Prod.mk w2 none) (Prod.mk (Prod.mk w2 es) none))
             ((Prod.mk w2 (some fty))
              (match (ctor_fields w2 es sc fty tps pending nil (budget_depth))
                ((Prod.mk (Prod.mk w3 es3) none) (Prod.mk (Prod.mk w3 es3) none))
                ((Prod.mk (Prod.mk w3 es3) (some fts))
                 (ind_ctors w3 es3 sc ind r ls fvs tps pending (cons (ECtorDef c fts) acc)))))))))
       (none (Prod.mk (Prod.mk w es) none))))))
;; the leading binders instantiated with the parameters' locals
(fn inst_params ((w W) (ty Expr) (fvs (List Expr))) (Prod W (Option Expr))
  (measure (struct fvs))
  (match fvs
    (nil (Prod.mk w (some ty)))
    ((cons fv r)
     (match (w_whnf w ty)
       ((Prod.mk w1 (some (Pi _ _ _ _ body)))
        (match (w_inst1 w1 body fv)
          ((Prod.mk w2 body1) (inst_params w2 body1 r))))
       ((Prod.mk w1 _) (Prod.mk w1 none))))))
;; the fields after the parameters: a proposition is erased, a data field is its E type, anything else refuses
(fn ctor_fields
  ((w W)
   (es ESt)
   (sc Scope)
   (ty Expr)
   (tps (List Expr))
   (pending (List Name))
   (acc (List EType))
   (fuel Int))
  (Prod (Prod W ESt) (Option (List EType)))
  (measure fuel)
  (if (< fuel 0) (Prod.mk (Prod.mk w es) none)
  (match (w_whnf w ty)
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (w_is_prop w1 dom)
       ((Prod.mk w2 (some true))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1) (ctor_fields w4 es sc body1 tps pending acc (- fuel 1)))))))
       ((Prod.mk w2 _)
        (match (l_to_etype w2 es sc dom tps pending)
          ((Prod.mk (Prod.mk w3 es3) none) (Prod.mk (Prod.mk w3 es3) none))
          ((Prod.mk (Prod.mk w3 es3) (some t))
           (match (w_local w3 n dom)
             ((Prod.mk w4 fv)
              (match (w_inst1 w4 body fv)
                ((Prod.mk w5 body1)
                 (ctor_fields w5 es3 sc body1 tps pending (cons t acc) (- fuel 1)))))))))))
    ((Prod.mk w1 (some _)) (Prod.mk (Prod.mk w1 es) (some (rev acc))))
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none)))))
(fn register_ind ((es ESt) (m Name) (n Name) (ntparams Int) (cdefs (List ECtorDef))) ESt
  (es_add_decl
    (es_register_all es m
      (cons (Prod.mk n (EIInd ntparams (ector_names cdefs))) (ctor_infos n cdefs 0)))
    (EInd n ntparams cdefs)))

;; ---- an L type as an E type ---------------------------------------------------------------
;; over the type parameters' locals: a local is its ETVar, `Nat` and `Int` are themselves, an
;; E-eligible inductive applied to its parameters keeps the type arguments and drops the erased
;; ones, and so does a row of the registry (rep_row), which is no inductive of E
(fn l_to_etype ((w W) (es ESt) (sc Scope) (e Expr) (tps (List Expr)) (pending (List Name)))
  (Prod (Prod W ESt) (Option EType))
  (match (w_whnf w e)
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none))
    ((Prod.mk w1 (some e1))
     (match e1
       ((FVar _ id)
        (match (fvar_index id tps 0)
          ((some i) (Prod.mk (Prod.mk w1 es) (some (ETVar i))))
          (none (Prod.mk (Prod.mk w1 es) none))))
       (_
         (match (get_app_fn e1)
           ((Const _ n _)
            (if (is_nat_or_int n)
              (if (= (get_app_num_args e1) 0) (Prod.mk (Prod.mk w1 es) (some (ETCon n nil)))
              (Prod.mk (Prod.mk w1 es) none))
            (if (rep_row n)
              (match (row_param_roles w1 n)
                ((Prod.mk w2 none) (Prod.mk (Prod.mk w2 es) none))
                ((Prod.mk w2 (some roles))
                 (if (bool_not (= (len roles) (get_app_num_args e1))) (Prod.mk (Prod.mk w2 es) none)
                 (match (etype_args w2 es sc roles (get_app_args e1) tps pending nil)
                   ((Prod.mk (Prod.mk w3 es3) none) (Prod.mk (Prod.mk w3 es3) none))
                   ((Prod.mk (Prod.mk w3 es3) (some args))
                    (Prod.mk (Prod.mk w3 es3) (some (ETCon n args))))))))
              (match (es_info es n)
                ((some (EISigType a))  ; a view's sig type: the parameter applied to its type arguments
                 (if (bool_not (= a (get_app_num_args e1))) (Prod.mk (Prod.mk w1 es) none)
                 (match (etype_args w1 es sc (trues a) (get_app_args e1) tps pending nil)
                   ((Prod.mk (Prod.mk w4 es4) none) (Prod.mk (Prod.mk w4 es4) none))
                   ((Prod.mk (Prod.mk w4 es4) (some args))
                    (Prod.mk (Prod.mk w4 es4) (some (ETCon n args)))))))
                (_
                  (match (ind_eligible w1 es sc n pending)
                    ((Prod.mk (Prod.mk w2 es2) false) (Prod.mk (Prod.mk w2 es2) none))
                    ((Prod.mk (Prod.mk w2 es2) true)
                     (match (ind_param_roles w2 n)
                       ((Prod.mk w3 none) (Prod.mk (Prod.mk w3 es2) none))
                       ((Prod.mk w3 (some roles))
                        (if (bool_not (= (len roles) (get_app_num_args e1)))
                          (Prod.mk (Prod.mk w3 es2) none)
                          (match (etype_args w3 es2 sc roles (get_app_args e1) tps pending nil)
                            ((Prod.mk (Prod.mk w4 es4) none) (Prod.mk (Prod.mk w4 es4) none))
                            ((Prod.mk (Prod.mk w4 es4) (some args))
                             (Prod.mk (Prod.mk w4 es4) (some (ETCon n args)))))))))))))))
           (_ (Prod.mk (Prod.mk w1 es) none))))))))
(fn trues ((n Int)) (List Bool)
  (measure (Int.natAbs n))
  (if (< n 1) nil (cons true (trues (- n 1)))))
(fulfills trues.dec_1 (by (intro n h) (apply natAbs_pred (arith))))
(fn etype_args
  ((w W)
   (es ESt)
   (sc Scope)
   (roles (List Bool))
   (args (List Expr))
   (tps (List Expr))
   (pending (List Name))
   (acc (List EType)))
  (Prod (Prod W ESt) (Option (List EType)))
  (measure (struct roles))
  (match roles
    (nil (Prod.mk (Prod.mk w es) (some (rev acc))))
    ((cons is_type rr)
     (match args
       (nil (Prod.mk (Prod.mk w es) none))
       ((cons a ar)
        (if is_type
          (match (l_to_etype w es sc a tps pending)
            ((Prod.mk (Prod.mk w1 es1) none) (Prod.mk (Prod.mk w1 es1) none))
            ((Prod.mk (Prod.mk w1 es1) (some t))
             (etype_args w1 es1 sc rr ar tps pending (cons t acc))))
          (etype_args w es sc rr ar tps pending acc)))))))

;; ---- the roles of a constant's binders -----------------------------------------------------
;; BStatic: a function-typed binder — a static parameter, the declaration
;; a template; its arity the count of its runtime arguments
(type BRole (BType) (BErased) (BData EType) (BStatic Int))
(type TBind (TBind Name BRole Expr))  ; the binder's name, role, local
(type Tele (Tele (List Level) (List TBind) EType Expr))  ; levels, binders in order, the result's E type and L type
(type TeleRes (TeleOk W ESt Tele) (TeleErr Symbol (List Int)))
;; the telescope of a constant at its solved levels, its binders opened as locals (kept in W)
(fn tele_of ((w W) (es ESt) (sc Scope) (info ConstantInfo)) TeleRes
  (match (type_at_levels w info)
    ((Prod.mk w1 none)
     (TeleErr (sym "realize_signature")
       (append (show_name (ci_name info)) (utf8 ": its universe parameters do not solve to Type"))))
    ((Prod.mk w1 (some (Prod.mk ls ty))) (tele_walk w1 es sc ty nil ls (budget_depth)))))
(fn tele_walk ((w W) (es ESt) (sc Scope) (ty Expr) (acc (List TBind)) (ls (List Level)) (fuel Int))
  TeleRes
  (measure fuel)
  (if (< fuel 0) (TeleErr (sym "realize_signature") (utf8 "the telescope is too deep"))
  (match (w_whnf w ty)
    ((Prod.mk w1 none) (TeleErr (sym "realize_signature") (utf8 "K could not read the type")))
    ((Prod.mk w1 (some (Pi _ n bi dom body)))
     (match (binder_role w1 es sc dom (tparams_of acc))
       ((Prod.mk (Prod.mk w2 es2) none)
        (TeleErr (sym "realize_signature")
          (append (show_name n)
            (utf8 ": a binder that is neither a type parameter, a proposition nor an E type"))))
       ((Prod.mk (Prod.mk w2 es2) (some role))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1)
              (tele_walk w4 es2 sc body1 (cons (TBind n role fv) acc) ls (- fuel 1)))))))))
    ((Prod.mk w1 (some r))
     (match (binder_role w1 es sc r (tparams_of acc))
       ((Prod.mk (Prod.mk w2 es2) (some (BData rt))) (TeleOk w2 es2 (Tele ls (rev acc) rt r)))
       ((Prod.mk (Prod.mk w2 es2) _)
        (TeleErr (sym "realize_signature")
          (utf8 "the result is not an E type (a proposition, a type, a function)"))))))))
;; a constructor's telescope with its first k binders — the inductive's parameters — opened
;; unclassified: a Sort-typed one a type parameter, any other erased (Subtype's predicate is
;; neither a type, a proposition nor data; the fields after it are what a row needs)
(fn tele_of_fields ((w W) (es ESt) (sc Scope) (info ConstantInfo) (k Int)) TeleRes
  (match (type_at_levels w info)
    ((Prod.mk w1 none)
     (TeleErr (sym "realize_signature")
       (append (show_name (ci_name info)) (utf8 ": its universe parameters do not solve to Type"))))
    ((Prod.mk w1 (some (Prod.mk ls ty))) (tele_params w1 es sc ty nil ls k (budget_depth)))))
(fn tele_params
  ((w W) (es ESt) (sc Scope) (ty Expr) (acc (List TBind)) (ls (List Level)) (k Int) (fuel Int))
  TeleRes
  (measure k)
  (if (<= k 0) (tele_walk w es sc ty acc ls fuel)
  (match (w_whnf w ty)
    ((Prod.mk w1 (some (Pi _ n bi dom body)))
     (match (w_whnf w1 dom)
       ((Prod.mk w2 dw)
        (let
          ((role BRole
             (match dw
               ((some (Sort _ _)) BType)
               (_ BErased))))
          (match (w_local w2 n dom)
            ((Prod.mk w3 fv)
             (match (w_inst1 w3 body fv)
               ((Prod.mk w4 body1)
                (tele_params w4 es sc body1 (cons (TBind n role fv) acc) ls (- k 1) fuel)))))))))
    ((Prod.mk w1 _)
     (TeleErr (sym "realize_signature")
       (utf8 "a constructor with fewer binders than its inductive has parameters"))))))
;; the type parameters' locals in order, from the reversed binders
(fn tparams_of ((acc (List TBind))) (List Expr) (rev (tparams_rev acc)))
(fn tparams_rev ((acc (List TBind))) (List Expr)
  (measure (struct acc))
  (match acc
    (nil nil)
    ((cons (TBind _ BType fv) r) (cons fv (tparams_rev r)))
    ((cons _ r) (tparams_rev r))))
;; a binder's role from its type: a Sort at Type is a type parameter, a Sort at Prop or a
;; proposition is erased, a Pi over propositions erases to its codomain, an E type is data, a
;; function type is a static parameter (fn_arity)
(fn binder_role ((w W) (es ESt) (sc Scope) (dom Expr) (tps (List Expr)))
  (Prod (Prod W ESt) (Option BRole))
  (match (w_whnf w dom)
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none))
    ((Prod.mk w1 (some (Sort _ l)))
     (let ((nl (normalize l)))
       (if (is_zero nl) (Prod.mk (Prod.mk w1 es) (some BErased))
       (if (is_one nl) (Prod.mk (Prod.mk w1 es) (some BType))
       (Prod.mk (Prod.mk w1 es) none)))))
    ((Prod.mk w1 (some d))
     (match (w_is_prop w1 d)
       ((Prod.mk w2 (some true)) (Prod.mk (Prod.mk w2 es) (some BErased)))
       ((Prod.mk w2 _)
        (match (erased_pi w2 d (budget_depth))
          ((Prod.mk w3 d1)
           (match (l_to_etype w3 es sc d1 tps nil)
             ((Prod.mk (Prod.mk w4 es4) (some t)) (Prod.mk (Prod.mk w4 es4) (some (BData t))))
             ((Prod.mk (Prod.mk w4 es4) none)
              (match (fn_arity w4 es4 sc d1 tps)
                ((Prod.mk (Prod.mk w5 es5) (some k)) (Prod.mk (Prod.mk w5 es5) (some (BStatic k))))
                ((Prod.mk (Prod.mk w5 es5) none)
                 (match (package_type w5 es5 sc d1)  ; a binder of a package type is a static parameter of arity 0
                   ((Prod.mk (Prod.mk w6 es6) true) (Prod.mk (Prod.mk w6 es6) (some (BStatic 0))))
                   ((Prod.mk (Prod.mk w6 es6) false) (Prod.mk (Prod.mk w6 es6) none))))))))))))))
;; a function type's domains and result as E types: a Pi chain of
;; E-typed domains over an E result; None for anything else — a Sort domain (no polymorphic
;; static parameter), a proposition domain, a domain or a result that is no E type. Its arity
;; (fn_arity) is the count of the domains; a static parameter of arity 0 is a package
(fn static_etypes
  ((w W) (es ESt) (sc Scope) (d Expr) (tps (List Expr)) (acc (List EType)) (fuel Int))
  (Prod (Prod W ESt) (Option (List EType)))
  (measure fuel)
  (if (< fuel 0) (Prod.mk (Prod.mk w es) none)
  (match (w_whnf w d)
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none))
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (l_to_etype w1 es sc dom tps nil)
       ((Prod.mk (Prod.mk w2 es2) none) (Prod.mk (Prod.mk w2 es2) none))
       ((Prod.mk (Prod.mk w2 es2) (some dt))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1) (static_etypes w4 es2 sc body1 tps (cons dt acc) (- fuel 1)))))))))
    ((Prod.mk w1 (some r))
     (if (= (len acc) 0) (Prod.mk (Prod.mk w1 es) none)
     (match (l_to_etype w1 es sc r tps nil)
       ((Prod.mk (Prod.mk w2 es2) (some rt)) (Prod.mk (Prod.mk w2 es2) (some (rev (cons rt acc)))))
       ((Prod.mk (Prod.mk w2 es2) none) (Prod.mk (Prod.mk w2 es2) none))))))))
(fn fn_arity ((w W) (es ESt) (sc Scope) (d Expr) (tps (List Expr))) (Prod (Prod W ESt) (Option Int))
  (match (static_etypes w es sc d tps nil (budget_depth))
    ((Prod.mk ws (some ts)) (Prod.mk ws (some (- (len ts) 1))))
    ((Prod.mk ws none) (Prod.mk ws none))))
;; a package type: a structure — one constructor, no indices, not unsafe —
;; that is no E type, with a function-typed field. Its constructor and its fields' roles: a
;; function field a static parameter, a proposition a law (erased), an E-typed field a value; a
;; field that is a type, or that is none of these, is no package. The type as written — the
;; structure applied to its parameters
(fn package_type ((w W) (es ESt) (sc Scope) (d Expr)) (Prod (Prod W ESt) Bool)
  (match (w_whnf w d)
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) false))
    ((Prod.mk w1 (some d1))
     (match (get_app_fn d1)
       ((Const _ n _)
        (match (package_of w1 es sc n)
          ((Prod.mk ws (some _)) (Prod.mk ws true))
          ((Prod.mk ws none) (Prod.mk ws false))))
       (_ (Prod.mk (Prod.mk w1 es) false))))))
(fn package_of ((w W) (es ESt) (sc Scope) (n Name))
  (Prod (Prod W ESt) (Option (Prod Name (List BRole))))
  (match (ind_eligible w es sc n nil)
    ((Prod.mk (Prod.mk w1 es1) true) (Prod.mk (Prod.mk w1 es1) none))
    ((Prod.mk (Prod.mk w1 es1) false)
     (match (env_find (w_env w1) n)
       ((some (InductInfo _ nparams nindices _ (cons c nil) _ _ unsafe refl))
        (if (bool_or (bool_not (= nindices 0)) (bool_or unsafe refl))
          (Prod.mk (Prod.mk w1 es1) none)
          (match (env_find (w_env w1) c)
            ((some cinfo)
             (match (type_at_levels w1 cinfo)
               ((Prod.mk w2 none) (Prod.mk (Prod.mk w2 es1) none))
               ((Prod.mk w2 (some (Prod.mk _ cty)))
                (match (package_params w2 cty nparams nil)
                  ((Prod.mk w3 none) (Prod.mk (Prod.mk w3 es1) none))
                  ((Prod.mk w3 (some (Prod.mk tps fty)))
                   (match (package_fields w3 es1 sc fty tps nil (budget_depth))
                     ((Prod.mk (Prod.mk w4 es4) none) (Prod.mk (Prod.mk w4 es4) none))
                     ((Prod.mk (Prod.mk w4 es4) (some roles))
                      (Prod.mk (Prod.mk w4 es4)
                        (if (has_static_role roles) (some (Prod.mk c roles)) none)))))))))
            (none (Prod.mk (Prod.mk w1 es1) none)))))
       (_ (Prod.mk (Prod.mk w1 es1) none))))))
;; the constructor's first k binders — the structure's parameters — opened unclassified: the
;; Sort-typed ones among them (the type parameters, in order) and the fields' type after them
(fn package_params ((w W) (ty Expr) (k Int) (tps (List Expr)))
  (Prod W (Option (Prod (List Expr) Expr)))
  (measure (Int.natAbs k))
  (if (<= k 0) (Prod.mk w (some (Prod.mk (rev tps) ty)))
  (match (w_whnf w ty)
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (w_whnf w1 dom)
       ((Prod.mk w2 dw)
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1)
              (package_params w4 body1 (- k 1)
                (match dw
                  ((some (Sort _ _)) (cons fv tps))
                  (_ tps))))))))))
    ((Prod.mk w1 _) (Prod.mk w1 none)))))
(fulfills package_params.dec_1
  (by (intro p h w1 dd n bi dom body hm w2 dw hw w3 fv hl w4 body1 hi) (apply natAbs_pred (arith))))
(fn package_fields
  ((w W) (es ESt) (sc Scope) (ty Expr) (tps (List Expr)) (acc (List BRole)) (fuel Int))
  (Prod (Prod W ESt) (Option (List BRole)))
  (measure fuel)
  (if (< fuel 0) (Prod.mk (Prod.mk w es) none)
  (match (w_whnf w ty)
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none))
    ((Prod.mk w1 (some (Pi _ n _ dom body)))
     (match (binder_role w1 es sc dom tps)
       ((Prod.mk (Prod.mk w2 es2) none) (Prod.mk (Prod.mk w2 es2) none))
       ((Prod.mk (Prod.mk w2 es2) (some BType)) (Prod.mk (Prod.mk w2 es2) none))
       ((Prod.mk (Prod.mk w2 es2) (some role))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1) (package_fields w4 es2 sc body1 tps (cons role acc) (- fuel 1)))))))))
    ((Prod.mk w1 (some _)) (Prod.mk (Prod.mk w1 es) (some (rev acc)))))))
(fn has_static_role ((roles (List BRole))) Bool
  (measure (struct roles))
  (match roles
    (nil false)
    ((cons (BStatic _) _) true)
    ((cons _ r) (has_static_role r))))
;; a Pi whose domain is a proposition, repeatedly: its codomain (the proof argument vanishes in E)
(fn erased_pi ((w W) (d Expr) (fuel Int)) (Prod W Expr)
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) (Prod.mk w d)
  (match d
    ((Pi _ n _ dom body)
     (match (w_is_prop w dom)
       ((Prod.mk w1 (some true))
        (match (w_local w1 n dom)
          ((Prod.mk w2 fv)
           (match (w_inst1 w2 body fv)
             ((Prod.mk w3 body1) (erased_pi w3 body1 (- fuel 1)))))))
       ((Prod.mk w1 _) (Prod.mk w1 d))))
    (_ (Prod.mk w d)))))
(fulfills erased_pi.dec_1
  (by (intro p h dd n bi dom body hm w1 hp w2 fv hl w3 body1 hi) (apply natAbs_lt (arith) (arith))))

;; ---- runtime flags ---------------------------------------------------------------------------
;; a telescope's binders: True for runtime data, False for a type or an erased one
(fn data_flags ((binds (List TBind))) (List Bool)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ (BData _) _) r) (cons true (data_flags r)))
    ((cons _ r) (cons false (data_flags r)))))
;; field i's index among the runtime fields, and their count
(fn runtime_index ((roles (List Bool)) (i Int) (k Int) (j Int)) (Option (Prod Int Int))
  (measure (struct roles))
  (match roles
    (nil none)
    ((cons rt r)
     (if (= k i) (if rt (some (Prod.mk j (+ j (count_true roles)))) none)
     (runtime_index r i (+ k 1) (if rt (+ j 1) j))))))
(fn count_true ((bs (List Bool))) Int
  (measure (struct bs))
  (match bs
    (nil 0)
    ((cons true r) (+ 1 (count_true r)))
    ((cons _ r) (count_true r))))
;; a constructor's fields in order: True for a runtime field, False for an erased one (a proof)
(fn ctor_data_flags ((w W) (es ESt) (sc Scope) (c Name)) (Option (List Bool))
  (match (env_find (w_env w) c)
    ((some info)
     (match info
       ((CtorInfo _ _ _ nparams _ _)
        (match (tele_of_fields w es sc info nparams)
          ((TeleOk _ _ (Tele _ binds _ _)) (some (data_flags (drop nparams binds))))
          ((TeleErr _ _) none)))
       (_ none)))
    (none none)))

;; ---- the pre-scan: a form's names that resolve to eligible inductives or their constructors ----
(fn es_scan_init ((es ESt) (sc Scope) (env CheckedEnv) (s SExpr)) ESt
  (match (scan_sexpr (w0 env) es sc s)
    ((Prod.mk _ es1) es1)))
(fn scan_sexpr ((w W) (es ESt) (sc Scope) (s SExpr)) (Prod W ESt)
  (measure (struct s))
  (match s
    ((SSym x) (scan_name w es sc x))
    ((SSymU x _) (scan_name w es sc x))
    ((SStr _) (scan_name w es sc (sym "List")))  ; "…" is a String: its bytes as List cells
    ((SList xs) (scan_list w es sc xs))
    (_ (Prod.mk w es))))
(fn scan_list ((w W) (es ESt) (sc Scope) (xs (List SExpr))) (Prod W ESt)
  (measure (struct xs))
  (match xs
    (nil (Prod.mk w es))
    ((cons x r)
     (match (scan_sexpr w es sc x)
       ((Prod.mk w1 es1) (scan_list w1 es1 sc r))))))
(fn scan_name ((w W) (es ESt) (sc Scope) (x Symbol)) (Prod W ESt)
  (match (name_of_sym x)
    (none (Prod.mk w es))
    ((some n)
     (match (resolve (cx0 sc (w_env w) nil nil) n)
       ((RName k _)
        (match (env_find (w_env w) k)
          ((some (InductInfo _ _ _ _ _ _ _ _ _))
           (match (ind_eligible w es sc k nil)
             ((Prod.mk (Prod.mk w1 es1) _) (Prod.mk w1 es1))))
          ((some (CtorInfo _ ind _ _ _ _))
           (match (ind_eligible w es sc ind nil)
             ((Prod.mk (Prod.mk w1 es1) _) (Prod.mk w1 es1))))
          (_ (Prod.mk w es))))
       (_ (Prod.mk w es))))))
