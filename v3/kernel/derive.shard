;;; v3/kernel/derive.shard — deriving under a declared policy. `(derive TYPE CAPABILITY…)`
;;; gives a closed inductive type decidable equality (`eq`), an ordering (`(ord structural)`)
;;; and a diagnostic rendering (`render`) — or registers a procedure the file wrote
;;; (`(CAPABILITY by NAME)`).
;;;
;;; Generation is source: a derivation is `fn` forms, s-expressions the loader then reads as
;;; if the file held them (one front end) — K checks the definitions and their
;;; equations, the programs are their erasures, nothing here is trusted. What this file
;;; reads of the type it reads from K's environment: the constructors and their fields'
;;; types at the type's arguments. Per capability and field it selects a procedure — the
;;; elaborator's own rows at Nat, Int and Bool, the function itself on a recursive field,
;;; else the derivation table's one visible entry (scope.shard `derived_for`) — and what it
;;; selected is in the generated source by name, so in the definition's dependencies.
;;;
;;;   NS.ctorIdx   the constructor's index (two constructors or more)
;;;   NS.decEq     (a b : T) → Decidable (a = b): a row per pair of constructors; the same
;;;                constructor decides its fields left to right through `dite`, isTrue by
;;;                congruence, isFalse by injectivity; two constructors differ by their indices
;;;   NS.compare   T → T → Ordering: fields left to right, the first not `eq` decides;
;;;                different constructors by their indices — the declaration order is the
;;;                convention, and it is in the value
;;;   NS.renderOnto, NS.render   the value in canonical S before a rest; its bytes
;;;
;;; NS is the type's mangled name: its head's last component, then its arguments'.

(import "elab.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.kw)
(use kernel.descent)
(use kernel.elab)
(use kernel.level)
(use kernel.name)
(use kernel.expr)
(use kernel.matcher)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.unify)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.elab.ERes)
(use kernel.expr.Expr)
(use kernel.level.Level)
(use kernel.matcher.MtInd)
(use kernel.name.Name)
(use kernel.scope.Resolved)
(use kernel.scope.Scope)
(use kernel.kw.WOut)
(use kernel.sexpr.SExpr)

;; ---- what a derivation is --------------------------------------------------------------------
;; a field as K gives it: the type itself, erased (a proof, a type), a function, one whose type
;; mentions an earlier field, or a value at a closed type
(type DvRaw (DvRSelf) (DvRErased) (DvRFun) (DvRDep) (DvRAt Expr))
;; a field as a capability handles it: the function's own call, the elaborator's rows, the
;; table's procedure, or — a renderer's — the placeholder
(type DvField (DvSelf) (DvNat) (DvInt) (DvBool) (DvProc Name) (DvBlank))
;; how a constructor's injectivity is proven: its `inj` theorem, or the projections of a
;; one-constructor type; none needed without fields
(type DvInj (DvInjThm Name) (DvInjProj) (DvInjNone))
(type DvCtor (DvCtor Name (List DvField) DvInj))
;; one capability's derivation: the type, the capability, the procedure's identity, the policy
;; (structural, by), the field procedures selected, the forms to load before it is registered
(type DvGen (DvGen Expr Symbol Name Symbol (List Name) (List SExpr)))
(type DvRes (DvOk (List DvGen)) (DvErr Symbol (List Int)))
(type DvCap (DvCapOk (List DvGen) Bool) (DvCapErr Symbol (List Int)))
(type DvCs (DvCsOk (List DvCtor)) (DvCsErr Symbol (List Int)))
(type DvFs (DvFsOk (List DvField)) (DvFsErr Symbol (List Int)))
;; the type and its arguments as the generated source cites them, the type as K has it, its
;; inductive, its mangled name, its constructors with their raw fields
(record DvCx (sc Scope) (env CheckedEnv) (tys SExpr) (targs (List SExpr)) (ty Expr) (ind Name)
  (ns (List Int))
  (raws (List (Prod Name (List DvRaw)))))

;; ---- the entry -------------------------------------------------------------------------------
(fn derive_form ((sc Scope) (env CheckedEnv) (s SExpr)) DvRes
  (match s
    ((SList (cons _ (cons tys (cons c1 caps))))
     (match
       (elab_type (el_with_etype (el0 sc env nil nil (qualify sc (n1 (sym "derive")))) true) tys)
       ((EErr r m)
        (DvErr (sym "derive_type")
          (append (show_sexpr tys)
            (append (utf8 " is not a type here — ")
              (append (chars_of_sym r) (append (utf8 ": ") m))))))
       ((EOk e1 ty0 _)
        (match (w_norm_ty (el_w e1) ty0 16)
          ((Prod.mk w1 ty)
           ;; procedures the file wrote need no constructor: any closed type takes them — a
           ;; view's sig type in a consumer, whose module exports the procedure
           (if (dv_all_by (cons c1 caps))
             (dv_caps
               (make DvCx (sc sc) (env env) (tys (dv_ty_s sc ty)) (targs nil) (ty ty) (ind Anon)
                 (ns (dv_mangle ty))
                 (raws nil))
               (cons c1 caps)
               false
               nil
               nil)
           (if (bool_or (is_const_named ty (n1 (sym "Nat"))) (is_const_named ty (n1 (sym "Int"))))
             (DvErr (sym "derive_type")
               (append (show_expr ty)
                 (utf8
                   " is the integer: its equality and its ordering are the elaborator's own rows, and nothing is generated from its constructors — register a procedure with (CAPABILITY by NAME)")))
             (match (dv_is_prop w1 ty)
               ((Prod.mk w1p true)
                (DvErr (sym "derive_type")
                  (append (dv_show_ty ty)
                    (utf8 " is a proposition: its proofs are all equal and none is a value"))))
               ((Prod.mk w1p false)
                (match (mt_ind_of w1p ty)
                  ((Prod.mk _ (MtNoInd r _))
                   (if (sym_eq r (sym "match_indexed"))
                     (DvErr (sym "derive_shape")
                       (append (show_expr ty) (utf8 ": an indexed family")))
                     (DvErr (sym "derive_type")
                       (append (show_expr ty)
                         (utf8
                           " is not an inductive type visible here — a view's sig type is derived by its module: register the procedure it exports, (derive TYPE (CAPABILITY by NAME))")))))
                  ((Prod.mk w2 (MtInd ind ls params ctors))
                   (match (env_find env ind)
                     ((some (InductInfo _ _ _ all _ nnested _ _ _))
                      (if (bool_not (= (len all) 1))
                        (DvErr (sym "derive_shape")
                          (append (show_name ind)
                            (utf8
                              ": a mutual type — one of several types that name each other: no derivation reads their block, a size among them")))
                      (if (dv_only_size (cons c1 caps)) (dv_size sc env w2 ty ind ls params)
                      (if (< 0 nnested)
                        (DvErr (sym "derive_shape")
                          (append (show_name ind)
                            (utf8
                              ": a type nested through another (a field whose type applies another type to it)")))
                      (if (< (len ctors) 1)
                        (DvErr (sym "derive_shape")
                          (append (show_name ind)
                            (utf8 ": a type without constructors has no value to compare or render")))
                      (if (< 0 (len (expr_fvars ty nil)))
                        (DvErr (sym "derive_type") (append (show_expr ty) (utf8 " is not closed")))
                        (match (dv_type_args w2 params)
                          ((Prod.mk _ false)
                           (DvErr (sym "derive_type")
                             (append (dv_show_ty ty)
                               (utf8
                                 ": an argument that is a value — a derivation is at an inductive applied to closed types"))))
                          ((Prod.mk w3 true)
                           (match (dv_raw_ctors w3 ty ctors ls params nil)
                             ((Prod.mk _ none)
                              (DvErr (sym "derive_shape")
                                (append (show_name ind) (utf8 ": K could not open a constructor"))))
                             ((Prod.mk _ (some raws))
                              (dv_caps
                                (make DvCx (sc sc) (env env) (tys (dv_ty_s sc ty))
                                  (targs (dv_tys_s sc (get_app_args ty)))
                                  (ty ty)
                                  (ind ind)
                                  (ns (dv_mangle ty))
                                  (raws raws))
                                (cons c1 caps)
                                false
                                nil
                                nil)))))))))))
                     (_
                       (DvErr (sym "derive_type")
                         (append (show_expr ty) (utf8 " is not an inductive type"))))))))))))))))
    (_
      (DvErr (sym "bad_shape")
        (utf8 "(derive TYPE CAPABILITY…): eq, (ord structural), render, or (CAPABILITY by NAME)")))))
;; the type is a proposition (K's is_prop; False where K cannot say)
(fn dv_is_prop ((w W) (ty Expr)) (Prod W Bool)
  (match (w_is_prop w ty)
    ((Prod.mk w1 (some true)) (Prod.mk w1 true))
    ((Prod.mk w1 _) (Prod.mk w1 false))))
;; every argument of the type is itself a type
(fn dv_type_args ((w W) (args (List Expr))) (Prod W Bool)
  (measure (struct args))
  (match args
    (nil (Prod.mk w true))
    ((cons a r)
     (match (w_infer w a)
       ((Prod.mk w1 none) (Prod.mk w1 false))
       ((Prod.mk w1 (some s))
        (match (w_whnf w1 s)
          ((Prod.mk w2 (some (Sort _ _))) (dv_type_args w2 r))
          ((Prod.mk w2 _) (Prod.mk w2 false))))))))
;; every capability is `(CAPABILITY by NAME)`
(fn dv_all_by ((caps (List SExpr))) Bool
  (measure (struct caps))
  (match caps
    (nil true)
    ((cons (SList (cons (SSym _) (cons (SSym by) (cons (SSym _) nil)))) r)
     (if (sym_eq by (sym "by")) (dv_all_by r) false))
    ((cons _ _) false)))
;; the type as a derivation writes it: identities, no universe lists
(fn dv_show_ty ((t Expr)) (List Int)
  (match (get_app_args t)
    (nil
      (match t
        ((Const _ n _) (show_name n))
        (_ (show_expr t))))
    (args
      (append (utf8 "(")
        (append (dv_show_ty (get_app_fn t)) (append (dv_show_args args) (utf8 ")")))))))
(fn dv_show_args ((args (List Expr))) (List Int)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons a r) (cons 32 (append (dv_show_ty a) (dv_show_args r))))))
;; the type as the generated source cites it: every constant by its identity (an imported
;; one under Init), so a type whose constructor bears its name — `(type Card (Card …))`, bare
;; `Card` ambiguous in a term — is cited the same in a binder and in a term
(fn dv_ty_s ((sc Scope) (t Expr)) SExpr
  (match (get_app_args t)
    (nil
      (match t
        ((Const _ n _) (dv_cite_in sc n))
        (_ (dv_s (show_expr t)))))
    (args (SList (cons (dv_ty_s sc (get_app_fn t)) (dv_tys_s sc args))))))
(fn dv_tys_s ((sc Scope) (ts (List Expr))) (List SExpr)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (cons (dv_ty_s sc t) (dv_tys_s sc r)))))
;; the mangled name: `Tok`, `List_Tok`, `Prod_Nat_Tok` — prefix notation over fixed arities
(fn dv_mangle ((ty Expr)) (List Int)
  (match (get_app_fn ty)
    ((Const _ n _) (dv_mangle_args (chars_of_name_last n) (get_app_args ty)))
    (_ (utf8 "T"))))
(fn dv_mangle_args ((acc (List Int)) (args (List Expr))) (List Int)
  (measure (struct args))
  (match args
    (nil acc)
    ((cons a r) (dv_mangle_args (append acc (cons 95 (dv_mangle a))) r))))

;; ---- the constructors' fields as K gives them ------------------------------------------------
(fn dv_raw_ctors
  ((w W)
   (ty Expr)
   (ctors (List Name))
   (ls (List Level))
   (params (List Expr))
   (acc (List (Prod Name (List DvRaw)))))
  (Prod W (Option (List (Prod Name (List DvRaw)))))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk w (some (rev acc))))
    ((cons c r)
     (match (mt_ctor_type w c ls params)
       ((Prod.mk w1 none) (Prod.mk w1 none))
       ((Prod.mk w1 (some (Prod.mk ct nf)))
        (match (mt_open_fields w1 ct nf nil)
          ((Prod.mk w2 none) (Prod.mk w2 none))
          ((Prod.mk w2 (some fs))
           (match (dv_raw_fields w2 ty fs nil nil)
             ((Prod.mk w3 raws) (dv_raw_ctors w3 ty r ls params (cons (Prod.mk c raws) acc)))))))))))
(fn dv_raw_fields
  ((w W) (ty Expr) (fs (List (Prod Expr Expr))) (seen (List Int)) (acc (List DvRaw)))
  (Prod W (List DvRaw))
  (measure (struct fs))
  (match fs
    (nil (Prod.mk w (rev acc)))
    ((cons (Prod.mk fv dom) r)
     (match (dv_raw w ty dom seen)
       ((Prod.mk w1 raw) (dv_raw_fields w1 ty r (cons (fvar_id_of fv) seen) (cons raw acc)))))))
(fn dv_raw ((w W) (ty Expr) (dom Expr) (seen (List Int))) (Prod W DvRaw)
  (match (w_is_prop w dom)
    ((Prod.mk w1 (some true)) (Prod.mk w1 DvRErased))
    ((Prod.mk w1 _)
     (match (w_norm_ty w1 dom 16)
       ((Prod.mk w2 dw)
        (match dw
          ((Sort _ _) (Prod.mk w2 DvRErased))
          ((Pi _ _ _ _ _) (Prod.mk w2 DvRFun))
          (_
            (if (expr_eq dw ty) (Prod.mk w2 DvRSelf)
            (if (dv_any_in (expr_fvars dw nil) seen) (Prod.mk w2 DvRDep)
            (Prod.mk w2 (DvRAt dw)))))))))))
(fn dv_any_in ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (mem_int x ys) true (dv_any_in r ys)))))

;; ---- size: the measure of a data value ---------------------------------------------------------
;; `(derive TYPE size)`: `NS.size : TYPE → Nat` from the type's recursor with every motive
;; `λ _. Nat` — a constructor is 1 plus the sizes of its recursive fields, a recursive field
;; being one K gives an induction hypothesis for. A nested type has a function per auxiliary
;; type of K's translation as well, under that type's mangled name (`List_T.size`, from
;; `T.rec_1`). Each function has its equations `NAME.size.eq_K`, one per constructor in
;; order, by `Eq.refl`. The functions are `def`s over the recursor — source, as every
;; derivation's, but no `fn`: a `fn` over a nested type would be a group of its own, whose
;; measure this is. They have no program, and need none: a measure is never run, and a
;; program whose measure cites one records that (prog.shard RecLogical).
;; The whole is read off the recursor's telescope: its motives' domains are the types, its
;; minors the constructors, a minor's binder under a motive an induction hypothesis.
(fn dv_only_size ((caps (List SExpr))) Bool
  (match caps
    ((cons (SSym k) nil) (sym_eq k (sym "size")))
    (_ false)))
;; a motive: its local's id, the type it is over, the size function's name as the source writes it
(type DvMot (DvMot Int Expr (List Int)))
;; a minor read: the source of the minor, the motive its constructor's type belongs to, the
;; equation's binders, the constructor applied, the equation's right side
(type DvMinor (DvMinor SExpr Int (List SExpr) SExpr SExpr))
(type DvMins (DvMinsOk (List DvMinor)) (DvMinsErr Symbol (List Int)))
(fn dv_level_nat ((l Level)) (Option Int)
  (measure (struct l))
  (match l
    (LZero (some 0))
    ((LSucc x)
     (match (dv_level_nat x)
       ((some k) (some (+ k 1)))
       (none none)))
    (_ none)))
;; the type's universe arguments as the source writes them: numerals
(fn dv_level_nums ((ls (List Level))) (Option (List SExpr))
  (measure (struct ls))
  (match ls
    (nil (some nil))
    ((cons l r)
     (match (dv_level_nat l)
       (none none)
       ((some k)
        (match (dv_level_nums r)
          (none none)
          ((some t) (some (cons (SNum k) t)))))))))
(fn dv_cite_text ((sc Scope) (n Name)) (List Int)
  (if (native_decl sc n) (show_name n) (append (utf8 "Init.") (show_name n))))
(fn dv_nat_s ((sc Scope)) SExpr (dv_s (dv_cite_text sc (n1 (sym "Nat")))))
(fn dv_size_name ((a Expr)) (List Int) (append (dv_mangle a) (utf8 ".size")))
(fn dv_size
  ((sc Scope) (env CheckedEnv) (w W) (ty Expr) (ind Name) (ls (List Level)) (params (List Expr)))
  DvRes
  (if (< 0 (len (expr_fvars ty nil)))
    (DvErr (sym "derive_type") (append (show_expr ty) (utf8 " is not closed")))
    (match (dv_level_nums ls)
      (none
        (DvErr (sym "derive_type")
          (append (dv_show_ty ty) (utf8 ": a universe argument that is not a number"))))
      ((some lstext)
       (match (env_find env (name_append ind (n1 (sym "rec"))))
         ((some rinfo)
          (match rinfo
            ((RecInfo _ _ _ ni nmot nmin _ _ _)
             (if (< 0 ni)
               (DvErr (sym "derive_shape") (append (show_name ind) (utf8 ": an indexed family")))
               (match (w_inst_lparams w (ci_type rinfo) (ci_lparams rinfo) (cons (LSucc LZero) ls))
                 ((Prod.mk w1 rty)
                  (match (dv_inst_params w1 rty params)
                    ((Prod.mk _ none)
                     (DvErr (sym "derive_shape")
                       (append (show_name ind)
                         (utf8 ": the recursor does not take the type's arguments"))))
                    ((Prod.mk w2 (some rty1))
                     (match (dv_open_motives w2 rty1 nmot nil)
                       ((Prod.mk _ none)
                        (DvErr (sym "derive_shape")
                          (append (show_name ind)
                            (utf8 ": the recursor's motives could not be opened"))))
                       ((Prod.mk w3 (some (Prod.mk rty2 mots)))
                        (match (dv_minors sc env w3 rty2 nmin mots 1 nil)
                          ((DvMinsErr e m) (DvErr e m))
                          ((DvMinsOk mins)
                           (DvOk
                             (list
                               (DvGen ty (sym "size") (dv_size_ident sc (dv_size_name ty))
                                 (sym "structural")
                                 (dv_size_idents sc (drop 1 mots))
                                 (append
                                   (dv_size_defs sc ind lstext (dv_tys_s sc params) mots mots mins 0)
                                   (dv_size_eqns sc mots mots mins 0)))))))))))))))
            (_ (DvErr (sym "derive_shape") (append (show_name ind) (utf8 " has no recursor"))))))
         (none (DvErr (sym "derive_shape") (append (show_name ind) (utf8 " has no recursor")))))))))
(fn dv_size_ident ((sc Scope) (short (List Int))) Name
  (match (name_of_sym (sym_of_chars short))
    ((some n) (qualify sc n))
    (none (qualify sc (n1 (sym_of_chars short))))))
(fn dv_size_idents ((sc Scope) (mots (List DvMot))) (List Name)
  (measure (struct mots))
  (match mots
    (nil nil)
    ((cons (DvMot _ _ nm) r) (cons (dv_size_ident sc nm) (dv_size_idents sc r)))))
(fn dv_inst_params ((w W) (ty Expr) (params (List Expr))) (Prod W (Option Expr))
  (measure (struct params))
  (match params
    (nil (Prod.mk w (some ty)))
    ((cons p r)
     (match ty
       ((Pi _ _ _ _ body)
        (match (w_inst1 w body p)
          ((Prod.mk w1 body1) (dv_inst_params w1 body1 r))))
       (_ (Prod.mk w none))))))
;; the motives opened as locals: each binder is `(x : A) → Sort 1`, A the type the motive is over
(fn dv_open_motives ((w W) (ty Expr) (n Int) (acc (List DvMot)))
  (Prod W (Option (Prod Expr (List DvMot))))
  (measure n)
  (if (< n 1) (Prod.mk w (some (Prod.mk ty (rev acc))))
  (match ty
    ((Pi _ nm _ dom body)
     (match dom
       ((Pi _ _ _ a _)
        (match (w_local w nm dom)
          ((Prod.mk w1 fv)
           (match (w_inst1 w1 body fv)
             ((Prod.mk w2 body1)
              (dv_open_motives w2 body1 (- n 1)
                (cons (DvMot (fvar_id_of fv) a (dv_size_name a)) acc)))))))
       (_ (Prod.mk w none))))
    (_ (Prod.mk w none)))))
(fn dv_mot_index ((mots (List DvMot)) (id Int) (j Int)) (Option (Prod Int (List Int)))
  (measure (struct mots))
  (match mots
    (nil none)
    ((cons (DvMot i _ nm) r) (if (= i id) (some (Prod.mk j nm)) (dv_mot_index r id (+ j 1))))))
;; a telescope's binders as locals, in order, with what is under them
(fn dv_open ((w W) (ty Expr) (acc (List Expr)) (fuel Int)) (Prod W (Prod (List Expr) Expr))
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (Prod.mk w (Prod.mk (rev acc) ty))
  (match ty
    ((Pi _ nm _ dom body)
     (match (w_local w nm dom)
       ((Prod.mk w1 fv)
        (match (w_inst1 w1 body fv)
          ((Prod.mk w2 body1) (dv_open w2 body1 (cons fv acc) (- fuel 1)))))))
    (_ (Prod.mk w (Prod.mk (rev acc) ty))))))
(fulfills dv_open.dec_1
  (by (intro p h a nm bi dom body hm w1 fv hm1 w2 body1 hm2) (apply natAbs_pred (arith))))
;; the minors, in order: each `Π fields ihs. motive_j (C params fields)`
(fn dv_minors
  ((sc Scope)
   (env CheckedEnv)
   (w W)
   (ty Expr)
   (n Int)
   (mots (List DvMot))
   (k Int)
   (acc (List DvMinor)))
  DvMins
  (measure n)
  (if (< n 1) (DvMinsOk (rev acc))
  (match ty
    ((Pi _ _ _ dom body)
     (match (dv_open w dom nil 256)
       ((Prod.mk w1 (Prod.mk fvs cod))
        (match (get_app_fn cod)
          ((FVar _ mid)
           (match (dv_mot_index mots mid 0)
             (none (DvMinsErr (sym "derive_shape") (utf8 "a minor premise that ends in no motive")))
             ((some (Prod.mk j nm))
              (match (get_app_args cod)
                ((cons capp nil)
                 (match (dv_minor_binders sc w1 mots fvs fvs 1 nil nil nil)
                   ((Prod.mk (Prod.mk fbs ihbs) (Prod.mk (some terms) _))
                    (match (dv_ctor_app sc env capp fvs)
                      (none
                        (DvMinsErr (sym "derive_shape") (utf8 "a minor premise over no constructor")))
                      ((some cs)
                       (let ((rhs (dv_size_sum terms)) (ihsum (dv_size_sum (dv_ih_vars ihbs))))
                         (match (w_inst1 w1 body (mk_const (n1 (sym "Nat")) nil))  ; the minor's own binder is not cited after it
                           ((Prod.mk w2 body1)
                            (dv_minors sc env w2 body1 (- n 1) mots (+ k 1)
                              (cons
                                (DvMinor
                                  (match (append fbs ihbs)
                                    (nil ihsum)
                                    (bs (SList (list (dv_s (utf8 "fun")) (SList bs) ihsum))))
                                  j
                                  fbs
                                  cs
                                  rhs)
                                acc))))))))
                   ((Prod.mk _ (Prod.mk none (Prod.mk e m))) (DvMinsErr e m))))
                (_ (DvMinsErr (sym "derive_shape") (utf8 "a motive applied to more than its value")))))))
          (_ (DvMinsErr (sym "derive_shape") (utf8 "a minor premise that ends in no motive")))))))
    (_ (DvMinsErr (sym "derive_shape") (utf8 "the recursor has fewer minor premises than it says"))))))
;; a minor's binders: a field `(v K TYPE)` — its type closed, no earlier field in it — or an
;; induction hypothesis `(h K Nat)`, which adds `(SIZE v)` of the field it is about to the sum
(fn dv_minor_binders
  ((sc Scope)
   (w W)
   (mots (List DvMot))
   (all (List Expr))
   (fvs (List Expr))
   (i Int)
   (fbs (List SExpr))
   (ihbs (List SExpr))
   (terms (List SExpr)))
  (Prod (Prod (List SExpr) (List SExpr)) (Prod (Option (List SExpr)) (Prod Symbol (List Int))))
  (measure (struct fvs))
  (match fvs
    (nil
      (Prod.mk (Prod.mk (rev fbs) (rev ihbs))
        (Prod.mk (some (rev terms)) (Prod.mk (sym "none") nil))))
    ((cons fv r)
     (match (w_local_type w (fvar_id_of fv))
       (none
         (Prod.mk (Prod.mk nil nil)
           (Prod.mk none (Prod.mk (sym "derive_shape") (utf8 "a binder without a type")))))
       ((some fty)
        (match (get_app_fn fty)
          ((FVar _ hid)
           (match (dv_mot_index mots hid 0)
             ((some (Prod.mk _ nm))
              (match (get_app_args fty)
                ((cons x nil)
                 (match (dv_field_pos all (fvar_id_of x) 1)
                   ((some fi)
                    (dv_minor_binders sc w mots all r (+ i 1) fbs
                      (cons (dv_bind (dv_vname (utf8 "h") i) (dv_nat_s sc)) ihbs)
                      (cons (dv_ap (dv_s nm) (list (dv_var (utf8 "v") fi))) terms)))
                   (none
                     (Prod.mk (Prod.mk nil nil)
                       (Prod.mk none
                         (Prod.mk (sym "derive_field")
                           (utf8 "an induction hypothesis about a term that is no field")))))))
                (_
                  (Prod.mk (Prod.mk nil nil)
                    (Prod.mk none
                      (Prod.mk (sym "derive_shape") (utf8 "a motive applied to more than its value")))))))
             (none
               (Prod.mk (Prod.mk nil nil)
                 (Prod.mk none
                   (Prod.mk (sym "derive_field") (utf8 "a field whose type is a variable")))))))
          (_
            (if (< 0 (len (expr_fvars fty nil)))
              (Prod.mk (Prod.mk nil nil)
                (Prod.mk none
                  (Prod.mk (sym "derive_field")
                    (utf8
                      "a field whose type is over an earlier field, or a recursive field under a function: no size is derived"))))
              (dv_minor_binders sc w mots all r (+ i 1)
                (cons (dv_bind (dv_vname (utf8 "v") i) (dv_ty_s sc fty)) fbs)
                ihbs
                terms)))))))))
(fn dv_field_pos ((fvs (List Expr)) (id Int) (i Int)) (Option Int)
  (measure (struct fvs))
  (match fvs
    (nil none)
    ((cons fv r) (if (= (fvar_id_of fv) id) (some i) (dv_field_pos r id (+ i 1))))))
;; the induction hypotheses' variables: the first symbol of each binder
(fn dv_ih_vars ((bs (List SExpr))) (List SExpr)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (SList (cons x _)) r) (cons x (dv_ih_vars r)))
    ((cons _ r) (dv_ih_vars r))))
;; 1, or (+ 1 (+ a (+ b …)))
(fn dv_size_sum ((ts (List SExpr))) SExpr
  (match ts
    (nil (SNum 1))
    (_ (dv_l3 (dv_s (utf8 "+")) (SNum 1) (dv_sum ts)))))
(fn dv_sum ((ts (List SExpr))) SExpr
  (measure (struct ts))
  (match ts
    (nil (SNum 0))
    ((cons t nil) t)
    ((cons t r) (dv_l3 (dv_s (utf8 "+")) t (dv_sum r)))))
;; the constructor of a minor's result applied in source: its type arguments written where it
;; has any, then the fields — each a field's variable
(fn dv_ctor_app ((sc Scope) (env CheckedEnv) (capp Expr) (fvs (List Expr))) (Option SExpr)
  (match (get_app_fn capp)
    ((Const _ c _)
     (match (env_find env c)
       ((some (CtorInfo _ _ _ np _ _))
        (let ((args (get_app_args capp)))
          (match (dv_field_args fvs (drop np args) nil)
            (none none)
            ((some fs)
             (if (= np 0)
               (match fs
                 (nil (some (dv_s (dv_cite_text sc c))))
                 (_ (some (dv_ap (dv_s (dv_cite_text sc c)) fs))))
               (some
                 (dv_ap (dv_s (append (utf8 "@") (dv_cite_text sc c)))
                   (append (dv_tys_s sc (take np args)) fs))))))))
       (_ none)))
    (_ none)))
(fn dv_field_args ((fvs (List Expr)) (args (List Expr)) (acc (List SExpr))) (Option (List SExpr))
  (measure (struct args))
  (match args
    (nil (some (rev acc)))
    ((cons a r)
     (match a
       ((FVar _ id)
        (match (dv_field_pos fvs id 1)
          ((some i) (dv_field_args fvs r (cons (dv_var (utf8 "v") i) acc)))
          (none none)))
       (_ none)))))
;; `(def NS.size ((x 1 TYPE)) Nat (@T.rec[_J].{1 LS} PARAMS MOTIVES MINORS x 1))`, a motive each
(fn dv_size_defs
  ((sc Scope)
   (ind Name)
   (lstext (List SExpr))
   (params (List SExpr))
   (all (List DvMot))
   (mots (List DvMot))
   (mins (List DvMinor))
   (j Int))
  (List SExpr)
  (measure (struct mots))
  (match mots
    (nil nil)
    ((cons (DvMot _ a nm) r)
     (cons
       (SList
         (list (dv_s (utf8 "def")) (dv_s nm)
           (SList (list (dv_bind (dv_vname (utf8 "x") 1) (dv_ty_s sc a))))
           (dv_nat_s sc)
           (dv_ap
             ;; `@T.rec.{1 LS}`: the recursor explicit, its motives into Type — cited as its
             ;; inductive is (a native one by its identity, an imported one under Init)
             (SSymU
               (sym_of_chars
                 (append (if (native_decl sc ind) (utf8 "@") (utf8 "@Init."))
                   (show_name
                     (name_append ind
                       (n1
                         (if (= j 0) (sym "rec") (sym_of_chars (append (utf8 "rec_") (show_nat j)))))))))
               (cons (SNum 1) lstext))
             (append params
               (append (dv_size_motives sc all)
                 (append (dv_minor_sources mins) (list (dv_var (utf8 "x") 1))))))))
       (dv_size_defs sc ind lstext params all r mins (+ j 1))))))
(fn dv_size_motives ((sc Scope) (mots (List DvMot))) (List SExpr)
  (measure (struct mots))
  (match mots
    (nil nil)
    ((cons (DvMot _ a _) r)
     (cons
       (SList
         (list (dv_s (utf8 "fun")) (SList (list (SList (list (dv_s (utf8 "_")) (dv_ty_s sc a)))))
           (dv_nat_s sc)))
       (dv_size_motives sc r)))))
(fn dv_minor_sources ((mins (List DvMinor))) (List SExpr)
  (measure (struct mins))
  (match mins
    (nil nil)
    ((cons (DvMinor src _ _ _ _) r) (cons src (dv_minor_sources r)))))
;; `(theorem NS.size.eq_K (FIELDS) (= (NS.size (C fields)) RHS) (exact (Eq.refl (NS.size (C fields)))))`,
;; a motive's constructors in order
(fn dv_size_eqns ((sc Scope) (all (List DvMot)) (mots (List DvMot)) (mins (List DvMinor)) (j Int))
  (List SExpr)
  (measure (struct mots))
  (match mots
    (nil nil)
    ((cons (DvMot _ _ nm) r)
     (append (dv_size_eqns_of sc nm mins j 1) (dv_size_eqns sc all r mins (+ j 1))))))
(fn dv_size_eqns_of ((sc Scope) (nm (List Int)) (mins (List DvMinor)) (j Int) (k Int)) (List SExpr)
  (measure (struct mins))
  (match mins
    (nil nil)
    ((cons (DvMinor _ mj fbs cs rhs) r)
     (if (bool_not (= mj j)) (dv_size_eqns_of sc nm r j k)
     (let ((lhs (dv_ap (dv_s nm) (list cs))))
       (cons
         (SList
           (list (dv_s (utf8 "theorem")) (dv_s (append nm (append (utf8 ".eq_") (show_nat k))))
             (SList fbs)
             (dv_eqn lhs rhs)
             (SList
               (list (dv_s (utf8 "exact"))
                 (dv_ap (dv_s (dv_cite_text sc (n2 (sym "Eq") (sym "refl")))) (list lhs))))))
         (dv_size_eqns_of sc nm r j (+ k 1))))))))

;; ---- the capabilities of one form ------------------------------------------------------------
;; `idx`: NS.ctorIdx is already among the forms of an earlier capability
(fn dv_caps ((cx DvCx) (caps (List SExpr)) (idx Bool) (done (List Symbol)) (acc (List DvGen))) DvRes
  (measure (struct caps))
  (match caps
    (nil (DvOk (rev acc)))
    ((cons c r)
     (match (dv_cap cx c idx done)
       ((DvCapErr e m) (DvErr e m))
       ((DvCapOk gs idx1) (dv_caps cx r idx1 (append (dv_gen_caps gs) done) (rev_onto gs acc)))))))
(fn dv_gen_caps ((gs (List DvGen))) (List Symbol)
  (measure (struct gs))
  (match gs
    (nil nil)
    ((cons (DvGen _ c _ _ _ _) r) (cons c (dv_gen_caps r)))))
(fn dv_is_cap ((k Symbol)) Bool
  (bool_or (sym_eq k (sym "eq")) (bool_or (sym_eq k (sym "ord")) (sym_eq k (sym "render")))))
(fn dv_bad_cap ((c SExpr)) DvCap
  (DvCapErr (sym "bad_shape")
    (append (show_sexpr c)
      (utf8
        ": a capability is eq, (ord structural), render, or (CAPABILITY by NAME); size is derived by a form of its own, (derive TYPE size)"))))
(fn dv_cap ((cx DvCx) (c SExpr) (idx Bool) (done (List Symbol))) DvCap
  (match c
    ((SSym k)
     (if (sym_eq k (sym "ord"))
       (DvCapErr (sym "derive_policy")
         (utf8
           "an ordering is a convention: write (ord structural), or (ord by NAME) for a procedure of the file's"))
     (if (dv_is_cap k) (dv_fresh cx k idx done)
     (dv_bad_cap c))))
    ((SList (cons (SSym k) (cons (SSym p) nil)))
     (if (sym_eq k (sym "ord"))
       (if (sym_eq p (sym "structural")) (dv_fresh cx k idx done)
       (DvCapErr (sym "derive_policy")
         (append (chars_of_sym p)
           (utf8
             ": structural is the one policy — constructors in declaration order, fields left to right"))))
       (dv_bad_cap c)))
    ((SList (cons (SSym k) (cons (SSym by) (cons (SSym nm) nil))))
     (if (bool_and (sym_eq by (sym "by")) (dv_is_cap k))
       (match (dv_dup cx k done)
         ((some m) (DvCapErr (sym "derive_duplicate") m))
         (none (dv_by cx k nm idx)))
       (dv_bad_cap c)))
    (_ (dv_bad_cap c))))
;; an entry for the type and capability already visible, or earlier in this form
(fn dv_dup ((cx DvCx) (k Symbol) (done (List Symbol))) (Option (List Int))
  (if (mem_sym k done) (some (append (chars_of_sym k) (utf8 " twice in one derivation")))
  (match (derived_for (DvCx.sc cx) (DvCx.ty cx) k)
    ((cons p _)
     (some
       (append (chars_of_sym k)
         (append (utf8 " at ")
           (append (dv_show_ty (DvCx.ty cx)) (append (utf8 " is already derived: ") (show_name p)))))))
    (nil none))))
(fn dv_fresh ((cx DvCx) (k Symbol) (idx Bool) (done (List Symbol))) DvCap
  (match (dv_dup cx k done)
    ((some m) (DvCapErr (sym "derive_duplicate") m))
    (none
      (if (sym_eq k (sym "eq")) (dv_eq cx idx)
      (if (sym_eq k (sym "ord")) (dv_ord cx idx)
      (dv_render cx idx))))))

;; ---- a procedure the file wrote: its type is the capability's ----------------------------------
(fn dv_by_type ((cx DvCx) (k Symbol)) SExpr
  (let ((t (DvCx.tys cx)))
    (if (sym_eq k (sym "eq"))
      (dv_l3 (dv_s (utf8 "forall")) (SList (list (dv_bind (utf8 "a") t) (dv_bind (utf8 "b") t)))
        (dv_ap (dv_init (utf8 "Decidable"))
          (list (dv_l3 (dv_s (utf8 "=")) (dv_s (utf8 "a")) (dv_s (utf8 "b"))))))
    (if (sym_eq k (sym "ord"))
      (dv_l3 (dv_s (utf8 "forall")) (SList (list (dv_bind (utf8 "a") t) (dv_bind (utf8 "b") t)))
        (dv_init (utf8 "Ordering")))
      (dv_l3 (dv_s (utf8 "forall"))
        (SList (list (dv_bind (utf8 "a") t) (dv_bind (utf8 "rest") (dv_codes_ty))))
        (dv_codes_ty))))))
(fn dv_by ((cx DvCx) (k Symbol) (nm Symbol) (idx Bool)) DvCap
  (match (name_of_sym nm)
    (none (DvCapErr (sym "bad_name") (chars_of_sym nm)))
    ((some n)
     (match (resolve (cx0 (DvCx.sc cx) (DvCx.env cx) nil nil) n)
       ((RName p _)
        (match (env_find (DvCx.env cx) p)
          ((some info)
           (match
             (elab_type
               (el_with_etype
                 (el0 (DvCx.sc cx) (DvCx.env cx) nil nil (qualify (DvCx.sc cx) (n1 (sym "derive"))))
                 true)
               (dv_by_type cx k))
             ((EErr _ m)
              (DvCapErr (sym "derive_needs")
                (append (utf8 "the capability's type could not be read: ") m)))
             ((EOk e1 want _)
              (match (w_is_def_eq_r (el_w e1) want (ci_type info))
                ((Prod.mk _ (WVal true))
                 (match (ci_lparams info)
                   (nil (DvCapOk (list (DvGen (DvCx.ty cx) k p (sym "by") nil nil)) idx))
                   (_
                     (DvCapErr (sym "derive_by")
                       (append (show_name p)
                         (utf8 " has universe parameters: a procedure is cited at none"))))))
                (_
                  (DvCapErr (sym "derive_by")
                    (append (show_name p)
                      (append (utf8 " : ")
                        (append (show_expr (ci_type info))
                          (append (utf8 " — the capability's type is ") (show_expr want)))))))))))
          (none (DvCapErr (sym "derive_by") (append (show_name p) (utf8 " is not a constant"))))))
       (_
         (DvCapErr (sym "derive_by")
           (append (chars_of_sym nm) (utf8 " names no one visible constant"))))))))

;; ---- source, written ---------------------------------------------------------------------------
(fn dv_s ((cs (List Int))) SExpr (SSym (sym_of_chars cs)))
(fn dv_ap ((h SExpr) (args (List SExpr))) SExpr (SList (cons h args)))
(fn dv_l3 ((a SExpr) (b SExpr) (c SExpr)) SExpr (SList (list a b c)))
(fn dv_bind ((x (List Int)) (t SExpr)) SExpr (SList (list (dv_s x) t)))
;; an imported constant is cited under Init, a native one by its identity: neither spelling
;; depends on what the file opened
(fn dv_init ((cs (List Int))) SExpr (dv_s (append (utf8 "Init.") cs)))
(fn dv_cite_in ((sc Scope) (n Name)) SExpr
  (if (native_decl sc n) (dv_s (show_name n)) (dv_init (show_name n))))
(fn dv_cite ((cx DvCx) (n Name)) SExpr (dv_cite_in (DvCx.sc cx) n))
(fn dv_at_cite ((cx DvCx) (n Name)) SExpr
  (dv_s
    (append (utf8 "@")
      (if (native_decl (DvCx.sc cx) n) (show_name n) (append (utf8 "Init.") (show_name n))))))
;; a generated variable: `x 1` — a space, which no source symbol holds, so no constructor of a
;; field's type bears its name (a pattern's bare symbol is a constructor where one exists)
(fn dv_vname ((p (List Int)) (i Int)) (List Int) (append p (cons 32 (show_nat i))))
(fn dv_var ((p (List Int)) (i Int)) SExpr (dv_s (dv_vname p i)))
;; p_i … p_k
(fn dv_vars ((p (List Int)) (k Int) (i Int)) (List SExpr)
  (measure (Int.natAbs (- (+ k 1) i)))
  (if (< k i) nil (cons (dv_var p i) (dv_vars p k (+ i 1)))))
(fulfills dv_vars.dec_1 (by (intro q h) (apply natAbs_lt (arith) (arith))))
(fn dv_blanks ((k Int)) (List SExpr)
  (measure (Int.natAbs k))
  (if (< k 1) nil (cons (dv_s (utf8 "_")) (dv_blanks (- k 1)))))
(fulfills dv_blanks.dec_1 (by (intro k h) (apply natAbs_pred (arith))))
;; the generated functions' names as the form declares them, and their identities
(fn dv_short ((cx DvCx) (f (List Int))) (List Int) (append (DvCx.ns cx) (cons 46 f)))
(fn dv_ident ((cx DvCx) (f (List Int))) Name
  (match (name_of_sym (sym_of_chars (dv_short cx f)))
    ((some n) (qualify (DvCx.sc cx) n))
    (none (qualify (DvCx.sc cx) (n1 (sym_of_chars f))))))
;; a constructor applied: every argument written when the type has arguments
(fn dv_ctor_term ((cx DvCx) (c Name) (args (List SExpr))) SExpr
  (match (DvCx.targs cx)
    (nil
      (match args
        (nil (dv_cite cx c))
        (_ (dv_ap (dv_cite cx c) args))))
    (ts (dv_ap (dv_at_cite cx c) (append ts args)))))
;; a constructor as a function of its fields
(fn dv_ctor_fn ((cx DvCx) (c Name)) SExpr
  (match (DvCx.targs cx)
    (nil (dv_cite cx c))
    (ts (dv_ap (dv_at_cite cx c) ts))))
(fn dv_pat ((cx DvCx) (c Name) (vars (List SExpr))) SExpr
  (match vars
    (nil (dv_cite cx c))
    (_ (dv_ap (dv_cite cx c) vars))))
(fn dv_eqn ((a SExpr) (b SExpr)) SExpr (dv_l3 (dv_s (utf8 "=")) a b))
;; (fn NAME BINDERS RET (measure (struct a))? BODY)
(fn dv_fn
  ((cx DvCx) (f (List Int)) (binders (List SExpr)) (ret SExpr) (recursive Bool) (body SExpr))
  SExpr
  (SList
    (append (list (dv_s (utf8 "fn")) (dv_s (dv_short cx f)) (SList binders) ret)
      (append
        (if recursive
          (list
            (SList
              (list (dv_s (utf8 "measure")) (SList (list (dv_s (utf8 "struct")) (dv_s (utf8 "a")))))))
          nil)
        (list body)))))
(fn dv_match ((s SExpr) (rows (List SExpr))) SExpr
  (SList (cons (dv_s (utf8 "match")) (cons s rows))))
(fn dv_row ((p SExpr) (b SExpr)) SExpr (SList (list p b)))

;; ---- the fields per capability -----------------------------------------------------------------
(fn dv_ctors ((cx DvCx) (cap Symbol) (raws (List (Prod Name (List DvRaw)))) (acc (List DvCtor)))
  DvCs
  (measure (struct raws))
  (match raws
    (nil (DvCsOk (rev acc)))
    ((cons (Prod.mk c fs) r)
     (match (dv_fields cx cap c fs nil)
       ((DvFsErr e m) (DvCsErr e m))
       ((DvFsOk fields)
        (match (dv_inj cx cap c fields)
          (none
            (DvCsErr (sym "derive_needs")
              (append (show_name c)
                (utf8
                  ".inj is not in the environment — no constructor-structure bundle is generated for a type with parameters: register a procedure with (eq by NAME)"))))
          ((some inj) (dv_ctors cx cap r (cons (DvCtor c fields inj) acc)))))))))
;; a constructor's injectivity as the generated source uses it: the theorem `C.inj`, or the
;; projections of a one-constructor type. A constructor of the load takes its theorem where
;; the load generated one. A constructor of Init takes the projections where its type has one
;; constructor, whether or not the environment holds `C.inj` — what is generated does not
;; depend on what else the load fetched — and its theorem otherwise; where the environment
;; lacks that, the refusal names it
(fn dv_inj ((cx DvCx) (cap Symbol) (c Name) (fields (List DvField))) (Option DvInj)
  (if (bool_or (bool_not (sym_eq cap (sym "eq"))) (< (len fields) 1)) (some DvInjNone)
  (let ((thm (name_append c (n1 (sym "inj")))))
    (if (bool_and (native_decl (DvCx.sc cx) c) (dv_has cx thm)) (some (DvInjThm thm))
    (if (= (len (DvCx.raws cx)) 1) (some DvInjProj)
    (if (dv_has cx thm) (some (DvInjThm thm))
    none))))))
(fn dv_fields ((cx DvCx) (cap Symbol) (c Name) (fs (List DvRaw)) (acc (List DvField))) DvFs
  (measure (struct fs))
  (match fs
    (nil (DvFsOk (rev acc)))
    ((cons raw r)
     (match (dv_field cx cap c raw)
       ((Prod.mk (some fd) _) (dv_fields cx cap c r (cons fd acc)))
       ((Prod.mk none (Prod.mk e m)) (DvFsErr e m))))))
(fn dv_field_err ((e Symbol) (c Name) (m (List Int)))
  (Prod (Option DvField) (Prod Symbol (List Int)))
  (Prod.mk none (Prod.mk e (append (show_name c) (append (utf8 ": ") m)))))
(fn dv_field_ok ((f DvField)) (Prod (Option DvField) (Prod Symbol (List Int)))
  (Prod.mk (some f) (Prod.mk (sym "none") nil)))
(fn dv_field ((cx DvCx) (cap Symbol) (c Name) (raw DvRaw))
  (Prod (Option DvField) (Prod Symbol (List Int)))
  (let ((render (sym_eq cap (sym "render"))))
    (match raw
      (DvRSelf (dv_field_ok DvSelf))
      (DvRErased
        (if render (dv_field_ok DvBlank)
        (dv_field_err (sym "derive_shape") c
          (utf8 "a field that is a proof or a type — supply the procedure: (CAPABILITY by NAME)"))))
      (DvRFun
        (dv_field_err (sym "derive_field") c
          (if render
            (utf8 "a function-valued field: the type has no program, so no value to render")
            (utf8 "a function-valued field has no decidable equality and no ordering"))))
      (DvRDep
        (dv_field_err (sym "derive_shape") c
          (utf8
            "a field whose type depends on an earlier field — supply the procedure: (CAPABILITY by NAME)")))
      ((DvRAt t)
       (if (bool_and (bool_not render) (is_const_named t (n1 (sym "Nat")))) (dv_field_ok DvNat)
       (if (bool_and (bool_not render) (is_const_named t (n1 (sym "Int")))) (dv_field_ok DvInt)
       (if (bool_and (sym_eq cap (sym "eq")) (is_const_named t (n1 (sym "Bool"))))
         (dv_field_ok DvBool)
         (match (derived_for (DvCx.sc cx) t cap)
           ((cons p nil) (dv_field_ok (DvProc p)))
           ((cons p (cons q _))
            (dv_field_err (sym "derive_field") c
              (append (utf8 "two derivations of ")
                (append (chars_of_sym cap)
                  (append (utf8 " at ")
                    (append (dv_show_ty t)
                      (append (utf8 " are visible: ")
                        (append (show_name q) (append (utf8 " and ") (show_name p))))))))))
           (nil
             (if (bool_and render (bool_not (dv_inductive cx t))) (dv_field_ok DvBlank)
             (dv_field_err (sym "derive_field") c
               (append (utf8 "no ")
                 (append (chars_of_sym cap)
                   (append (utf8 " at its field's type ")
                     (append (dv_show_ty t)
                       (append (utf8 ": derive it first — (derive ")
                         (append (dv_show_ty t)
                           (append (utf8 " ") (append (dv_cap_text cap) (utf8 ")"))))))))))))))))))))
(fn dv_cap_text ((cap Symbol)) (List Int)
  (if (sym_eq cap (sym "ord")) (utf8 "(ord structural)") (chars_of_sym cap)))
(fn dv_inductive ((cx DvCx) (t Expr)) Bool
  (match (get_app_fn t)
    ((Const _ n _)
     (match (env_find (DvCx.env cx) n)
       ((some (InductInfo _ _ _ _ _ _ _ _ _)) true)
       (_ false)))
    (_ false)))
;; a constant the generated source cites: in the environment and visible here
(fn dv_has ((cx DvCx) (n Name)) Bool
  (match (env_find (DvCx.env cx) n)
    ((some _) (visible (DvCx.sc cx) n))
    (none false)))
(fn dv_first_missing ((cx DvCx) (ns (List Name))) (Option Name)
  (measure (struct ns))
  (match ns
    (nil none)
    ((cons n r) (if (dv_has cx n) (dv_first_missing cx r) (some n)))))
(fn dv_needs ((n Name)) DvCap
  (DvCapErr (sym "derive_needs")
    (append (show_name n)
      (utf8
        " is not visible here, and the generated source cites it: import the library file that declares it (std/derive.shard for a rendering)"))))
(fn dv_recursive ((cs (List DvCtor))) Bool
  (measure (struct cs))
  (match cs
    (nil false)
    ((cons (DvCtor _ fs _) r) (if (dv_has_self fs) true (dv_recursive r)))))
(fn dv_has_self ((fs (List DvField))) Bool
  (measure (struct fs))
  (match fs
    (nil false)
    ((cons DvSelf _) true)
    ((cons _ r) (dv_has_self r))))
;; the procedures the fields selected, each once, in order
(fn dv_procs ((cap Symbol) (cs (List DvCtor)) (acc (List Name))) (List Name)
  (measure (struct cs))
  (match cs
    (nil (rev acc))
    ((cons (DvCtor _ fs _) r) (dv_procs cap r (dv_procs_of cap fs acc)))))
(fn dv_procs_of ((cap Symbol) (fs (List DvField)) (acc (List Name))) (List Name)
  (measure (struct fs))
  (match fs
    (nil acc)
    ((cons f r)
     (dv_procs_of cap r
       (match (dv_proc_name cap f)
         ((some p) (if (mem_name p acc) acc (cons p acc)))
         (none acc))))))
(fn dv_proc_name ((cap Symbol) (f DvField)) (Option Name)
  (match f
    ((DvProc p) (some p))
    (DvNat
      (some (if (sym_eq cap (sym "eq")) (n2 (sym "Nat") (sym "decEq")) (n2 (sym "Nat") (sym "lt")))))
    (DvInt
      (some (if (sym_eq cap (sym "eq")) (n2 (sym "Int") (sym "decEq")) (n2 (sym "Int") (sym "lt")))))
    (DvBool (some (n1 (sym "instDecidableEqBool"))))
    (_ none)))

;; ---- NS.ctorIdx --------------------------------------------------------------------------------
;; its own derivation (capability `idx`), generated with the first capability that cites it and
;; shared through the table: a later derivation at the type — in this module or one that sees
;; it — cites the registered function, never a constant that merely bears the name
(fn dv_idx_name ((cx DvCx)) Name
  (match (derived_for (DvCx.sc cx) (DvCx.ty cx) (sym "idx"))
    ((cons p _) p)
    (nil (dv_ident cx (utf8 "ctorIdx")))))
(fn dv_idx_gens ((cx DvCx) (idx Bool)) (List DvGen)
  (if idx nil
  (match (derived_for (DvCx.sc cx) (DvCx.ty cx) (sym "idx"))
    ((cons _ _) nil)
    (nil
      (list
        (DvGen (DvCx.ty cx) (sym "idx") (dv_ident cx (utf8 "ctorIdx")) (sym "structural") nil
          (list
            (dv_fn cx (utf8 "ctorIdx") (list (dv_bind (utf8 "a") (DvCx.tys cx)))
              (dv_init (utf8 "Nat"))
              false
              (dv_match (dv_s (utf8 "a")) (dv_idx_rows cx (DvCx.raws cx) 0))))))))))
(fn dv_idx_rows ((cx DvCx) (raws (List (Prod Name (List DvRaw)))) (i Int)) (List SExpr)
  (measure (struct raws))
  (match raws
    (nil nil)
    ((cons (Prod.mk c fs) r)
     (cons (dv_row (dv_pat cx c (dv_blanks (len fs))) (SNum i)) (dv_idx_rows cx r (+ i 1))))))
(fn dv_idx_of ((cx DvCx) (t SExpr)) SExpr (dv_ap (dv_cite cx (dv_idx_name cx)) (list t)))

;; ---- eq ----------------------------------------------------------------------------------------
(fn dv_eq ((cx DvCx) (idx Bool)) DvCap
  (match (dv_ctors cx (sym "eq") (DvCx.raws cx) nil)
    ((DvCsErr e m) (DvCapErr e m))
    ((DvCsOk cs)
     (let ((many Bool (if (< 1 (len cs)) true false)))
       (match
         (dv_first_missing cx
           (append
             (list (n1 (sym "Decidable")) (n1 (sym "dite")) (n1 (sym "rfl")) (n1 (sym "congrArg"))
               (n1 (sym "congr"))
               (n1 (sym "Not"))
               (n2 (sym "And") (sym "left"))
               (n2 (sym "And") (sym "right")))
             (append (if many (list (n2 (sym "Nat") (sym "ne_of_beq_eq_false"))) nil)
               (dv_procs (sym "eq") cs nil))))
         ((some n) (dv_needs n))
         (none
           (DvCapOk
             (append (if many (dv_idx_gens cx idx) nil)
               (list
                 (DvGen (DvCx.ty cx) (sym "eq") (dv_ident cx (utf8 "decEq")) (sym "structural")
                   (dv_procs (sym "eq") cs nil)
                   (list
                     (dv_fn cx (utf8 "decEq")
                       (list (dv_bind (utf8 "a") (DvCx.tys cx)) (dv_bind (utf8 "b") (DvCx.tys cx)))
                       (dv_ap (dv_init (utf8 "Decidable"))
                         (list (dv_eqn (dv_s (utf8 "a")) (dv_s (utf8 "b")))))
                       (dv_recursive cs)
                       (dv_match (dv_s (utf8 "a")) (dv_eq_rows cx cs cs)))))))
             (bool_or idx many))))))))
;; a row per constructor of a, and under it a row per constructor of b
(fn dv_eq_rows ((cx DvCx) (all (List DvCtor)) (cs (List DvCtor))) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (DvCtor c fs inj) r)
     (cons
       (dv_row (dv_pat cx c (dv_vars (utf8 "x") (len fs) 1))
         (dv_match (dv_s (utf8 "b")) (dv_eq_inner cx c fs inj all)))
       (dv_eq_rows cx all r)))))
(fn dv_eq_inner ((cx DvCx) (c Name) (fs (List DvField)) (inj DvInj) (others (List DvCtor)))
  (List SExpr)
  (measure (struct others))
  (match others
    (nil nil)
    ((cons (DvCtor d ds _) r)
     (let
       ((tx (dv_ctor_term cx c (dv_vars (utf8 "x") (len fs) 1)))
        (ty (dv_ctor_term cx d (dv_vars (utf8 "y") (len ds) 1))))
       (cons
         (dv_row (dv_pat cx d (dv_vars (utf8 "y") (len ds) 1))
           (if (name_eq c d) (dv_eq_same cx c fs inj (dv_eqn tx ty) 1 fs) (dv_eq_differ cx tx ty)))
         (dv_eq_inner cx c fs inj r))))))
;; two constructors: their indices differ, and the index is a function
(fn dv_eq_differ ((cx DvCx) (tx SExpr) (ty SExpr)) SExpr
  (dv_ap (dv_init (utf8 "Decidable.isFalse"))
    (list
      (dv_l3 (dv_s (utf8 "fun")) (SList (list (dv_bind (utf8 "h") (dv_eqn tx ty))))
        (dv_ap (dv_s (utf8 "@Init.Nat.ne_of_beq_eq_false"))
          (list (dv_idx_of cx tx) (dv_idx_of cx ty)
            (dv_ap (dv_init (utf8 "Eq.refl")) (list (dv_init (utf8 "Bool.false"))))
            (dv_ap (dv_init (utf8 "congrArg"))
              (list (dv_cite cx (dv_idx_name cx)) (dv_s (utf8 "h"))))))))))
;; one constructor: field m decides, the rest under its equation; `goal` is the row's equation
(fn dv_eq_same
  ((cx DvCx) (c Name) (fs (List DvField)) (inj DvInj) (goal SExpr) (m Int) (rest (List DvField)))
  SExpr
  (measure (struct rest))
  (match rest
    (nil (dv_ap (dv_init (utf8 "Decidable.isTrue")) (list (dv_eq_cong cx c (len fs)))))
    ((cons f r)
     (let ((x (dv_var (utf8 "x") m)) (y (dv_var (utf8 "y") m)))
       (dv_ap (dv_s (utf8 "@Init.dite"))
         (list (dv_ap (dv_init (utf8 "Decidable")) (list goal)) (dv_eqn x y) (dv_eq_dec cx f x y)
           (dv_l3 (dv_s (utf8 "fun")) (SList (list (dv_bind (dv_vname (utf8 "e") m) (dv_eqn x y))))
             (dv_eq_same cx c fs inj goal (+ m 1) r))
           (dv_l3 (dv_s (utf8 "fun"))
             (SList
               (list
                 (dv_bind (dv_vname (utf8 "n") m) (dv_ap (dv_init (utf8 "Not")) (list (dv_eqn x y))))))
             (dv_ap (dv_init (utf8 "Decidable.isFalse"))
               (list
                 (dv_l3 (dv_s (utf8 "fun")) (SList (list (dv_bind (utf8 "h") goal)))
                   (dv_ap (dv_var (utf8 "n") m) (list (dv_eq_inj cx c inj (len fs) m)))))))))))))
(fn dv_eq_dec ((cx DvCx) (f DvField) (x SExpr) (y SExpr)) SExpr
  (match f
    (DvSelf (dv_ap (dv_s (dv_short cx (utf8 "decEq"))) (list x y)))
    (DvNat (dv_ap (dv_init (utf8 "Nat.decEq")) (list x y)))
    (DvInt (dv_ap (dv_init (utf8 "Int.decEq")) (list x y)))
    (DvBool (dv_ap (dv_init (utf8 "instDecidableEqBool")) (list x y)))
    ((DvProc p) (dv_ap (dv_cite cx p) (list x y)))
    (DvBlank (dv_s (utf8 "_")))))
;; C x… = C y… from e1 … ek: congrArg on the first, congr on each further one
(fn dv_eq_cong ((cx DvCx) (c Name) (k Int)) SExpr
  (if (< k 1) (dv_init (utf8 "rfl"))
  (dv_eq_cong_go 2 k
    (dv_ap (dv_init (utf8 "congrArg")) (list (dv_ctor_fn cx c) (dv_var (utf8 "e") 1))))))
(fn dv_eq_cong_go ((m Int) (k Int) (acc SExpr)) SExpr
  (measure (Int.natAbs (- (+ k 1) m)))
  (if (< k m) acc
  (dv_eq_cong_go (+ m 1) k (dv_ap (dv_init (utf8 "congr")) (list acc (dv_var (utf8 "e") m))))))
(fulfills dv_eq_cong_go.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))
;; x_m = y_m from h : C x… = C y…
(fn dv_eq_inj ((cx DvCx) (c Name) (inj DvInj) (k Int) (m Int)) SExpr
  (match inj
    ((DvInjThm thm)
     (let ((base (dv_ap (dv_cite cx thm) (list (dv_s (utf8 "h"))))))
       (if (= k 1) base
       (if (< m k) (dv_ap (dv_init (utf8 "And.left")) (list (dv_rights base (- m 1))))
       (dv_rights base (- k 1))))))
    (_
      (dv_ap (dv_init (utf8 "congrArg"))
        (list
          (dv_l3 (dv_s (utf8 "fun")) (SList (list (dv_bind (utf8 "t") (DvCx.tys cx))))
            (SList
              (list (dv_s (utf8 "proj")) (dv_cite cx (DvCx.ind cx)) (SNum (- m 1)) (dv_s (utf8 "t")))))
          (dv_s (utf8 "h")))))))
(fn dv_rights ((base SExpr) (k Int)) SExpr
  (measure (Int.natAbs k))
  (if (< k 1) base (dv_rights (dv_ap (dv_init (utf8 "And.right")) (list base)) (- k 1))))
(fulfills dv_rights.dec_1 (by (intro p h) (apply natAbs_pred (arith))))

;; ---- ord ---------------------------------------------------------------------------------------
(fn dv_ord ((cx DvCx) (idx Bool)) DvCap
  (match (dv_ctors cx (sym "ord") (DvCx.raws cx) nil)
    ((DvCsErr e m) (DvCapErr e m))
    ((DvCsOk cs)
     (let ((n (len cs)))
       (match
         (dv_first_missing cx
           (cons (n1 (sym "Ordering"))
             (cons (n2 (sym "Ordering") (sym "casesOn")) (dv_procs (sym "ord") cs nil))))
         ((some m) (dv_needs m))
         (none
           (DvCapOk
             (append (if (< 2 n) (dv_idx_gens cx idx) nil)
               (list
                 (DvGen (DvCx.ty cx) (sym "ord") (dv_ident cx (utf8 "compare")) (sym "structural")
                   (dv_procs (sym "ord") cs nil)
                   (list
                     (dv_fn cx (utf8 "compare")
                       (list (dv_bind (utf8 "a") (DvCx.tys cx)) (dv_bind (utf8 "b") (DvCx.tys cx)))
                       (dv_init (utf8 "Ordering"))
                       (dv_recursive cs)
                       (dv_match (dv_s (utf8 "a")) (dv_ord_rows cx cs n 0)))))))
             (bool_or idx (< 2 n)))))))))
(fn dv_ordering ((k (List Int))) SExpr (dv_init (append (utf8 "Ordering.") k)))
(fn dv_ord_rows ((cx DvCx) (cs (List DvCtor)) (n Int) (i Int)) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (DvCtor c fs _) r)
     (cons
       (dv_row (dv_pat cx c (dv_vars (utf8 "x") (len fs) 1))
         (dv_match (dv_s (utf8 "b"))
           (cons (dv_row (dv_pat cx c (dv_vars (utf8 "y") (len fs) 1)) (dv_ord_chain cx 1 fs))
             (dv_ord_other cx n i))))
       (dv_ord_rows cx r n (+ i 1))))))
;; another constructor: the first is below every other, the last above; between them the index
(fn dv_ord_other ((cx DvCx) (n Int) (i Int)) (List SExpr)
  (if (< n 2) nil
  (list
    (dv_row (dv_s (utf8 "_"))
      (if (< i 1) (dv_ordering (utf8 "lt"))
      (if (= i (- n 1)) (dv_ordering (utf8 "gt"))
      (SList
        (list (dv_s (utf8 "if")) (dv_l3 (dv_s (utf8 "<")) (dv_idx_of cx (dv_s (utf8 "b"))) (SNum i))
          (dv_ordering (utf8 "gt"))
          (dv_ordering (utf8 "lt"))))))))))
(fn dv_ord_chain ((cx DvCx) (m Int) (fs (List DvField))) SExpr
  (measure (struct fs))
  (match fs
    (nil (dv_ordering (utf8 "eq")))
    ((cons f nil) (dv_ord_cmp cx f (dv_var (utf8 "x") m) (dv_var (utf8 "y") m)))
    ((cons f r)
     (dv_match (dv_ord_cmp cx f (dv_var (utf8 "x") m) (dv_var (utf8 "y") m))
       (list (dv_row (dv_ordering (utf8 "lt")) (dv_ordering (utf8 "lt")))
         (dv_row (dv_ordering (utf8 "eq")) (dv_ord_chain cx (+ m 1) r))
         (dv_row (dv_ordering (utf8 "gt")) (dv_ordering (utf8 "gt"))))))))
(fn dv_ord_cmp ((cx DvCx) (f DvField) (x SExpr) (y SExpr)) SExpr
  (match f
    (DvSelf (dv_ap (dv_s (dv_short cx (utf8 "compare"))) (list x y)))
    ((DvProc p) (dv_ap (dv_cite cx p) (list x y)))
    (_
      (SList
        (list (dv_s (utf8 "if")) (dv_l3 (dv_s (utf8 "<")) x y) (dv_ordering (utf8 "lt"))
          (SList
            (list (dv_s (utf8 "if")) (dv_eqn x y) (dv_ordering (utf8 "eq"))
              (dv_ordering (utf8 "gt")))))))))

;; ---- render ------------------------------------------------------------------------------------
(fn dv_codes_ty () SExpr (dv_ap (dv_init (utf8 "List")) (list (dv_init (utf8 "Nat")))))
(fn dv_bytes_of_nats () Name
  (Str (Str (Str (Str Anon (sym "std")) (sym "bytes")) (sym "Bytes")) (sym "ofNats")))
(fn dv_render ((cx DvCx) (idx Bool)) DvCap
  (match (dv_ctors cx (sym "render") (DvCx.raws cx) nil)
    ((DvCsErr e m) (DvCapErr e m))
    ((DvCsOk cs)
     (match
       (dv_first_missing cx
         (append (list (n1 (sym "List")) (n1 (sym "ByteArray")) (dv_bytes_of_nats))
           (dv_procs (sym "render") cs nil)))
       ((some m) (dv_needs m))
       (none
         (DvCapOk
           (list
             (DvGen (DvCx.ty cx) (sym "render") (dv_ident cx (utf8 "renderOnto")) (sym "structural")
               (dv_procs (sym "render") cs nil)
               (list
                 (dv_fn cx (utf8 "renderOnto")
                   (list (dv_bind (utf8 "a") (DvCx.tys cx)) (dv_bind (utf8 "rest") (dv_codes_ty)))
                   (dv_codes_ty)
                   (dv_recursive cs)
                   (dv_match (dv_s (utf8 "a")) (dv_render_rows cx cs)))
                 (dv_fn cx (utf8 "render") (list (dv_bind (utf8 "a") (DvCx.tys cx)))
                   (dv_init (utf8 "ByteArray"))
                   false
                   (dv_ap (dv_s (show_name (dv_bytes_of_nats)))
                     (list
                       (dv_ap (dv_s (show_name (dv_ident cx (utf8 "renderOnto"))))
                         (list (dv_s (utf8 "a")) (dv_init (utf8 "List.nil"))))))))))
           idx))))))
;; `NAME` for a constructor without fields, `(NAME F…)` with: the name's bytes, a space before
;; each field, the fields left to right, each before what follows it
(fn dv_render_rows ((cx DvCx) (cs (List DvCtor))) (List SExpr)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (DvCtor c fs _) r)
     (cons
       (dv_row (dv_pat cx c (dv_render_vars fs 1))
         (match fs
           (nil (dv_codes (chars_of_name_last c) (dv_s (utf8 "rest"))))
           (_ (dv_code 40 (dv_codes (chars_of_name_last c) (dv_render_fields cx 1 fs))))))
       (dv_render_rows cx r)))))
(fn dv_render_vars ((fs (List DvField)) (m Int)) (List SExpr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons DvBlank r) (cons (dv_s (utf8 "_")) (dv_render_vars r (+ m 1))))
    ((cons _ r) (cons (dv_var (utf8 "x") m) (dv_render_vars r (+ m 1))))))
(fn dv_render_fields ((cx DvCx) (m Int) (fs (List DvField))) SExpr
  (measure (struct fs))
  (match fs
    (nil (dv_code 41 (dv_s (utf8 "rest"))))
    ((cons f r)
     (let ((next (dv_render_fields cx (+ m 1) r)))
       (dv_code 32
         (match f
           (DvSelf
             (dv_ap (dv_s (dv_short cx (utf8 "renderOnto"))) (list (dv_var (utf8 "x") m) next)))
           ((DvProc p) (dv_ap (dv_cite cx p) (list (dv_var (utf8 "x") m) next)))
           (_ (dv_code 95 next))))))))
(fn dv_code ((c Int) (tail SExpr)) SExpr (dv_l3 (dv_init (utf8 "List.cons")) (SNum c) tail))
(fn dv_codes ((bs (List Int)) (tail SExpr)) SExpr
  (measure (struct bs))
  (match bs
    (nil tail)
    ((cons b r) (dv_code b (dv_codes r tail)))))

;; the constants the derivations' generated source cites by name
(fn dv_kit () (List Name)
  (list (n1 (sym "Decidable")) (n1 (sym "dite")) (n1 (sym "rfl")) (n1 (sym "congrArg"))
    (n1 (sym "congr"))
    (n1 (sym "Not"))
    (n2 (sym "And") (sym "left"))
    (n2 (sym "And") (sym "right"))
    (n2 (sym "Nat") (sym "ne_of_beq_eq_false"))
    (n2 (sym "Nat") (sym "decEq"))
    (n2 (sym "Nat") (sym "lt"))
    (n2 (sym "Int") (sym "decEq"))
    (n2 (sym "Int") (sym "lt"))
    (n1 (sym "instDecidableEqBool"))
    (n1 (sym "Ordering"))
    (n2 (sym "Ordering") (sym "casesOn"))
    (n1 (sym "List"))
    (n1 (sym "ByteArray"))
    (n1 (sym "Bool"))
    (n1 (sym "Int"))
    (n1 (sym "Nat"))))
