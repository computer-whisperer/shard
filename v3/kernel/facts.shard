;;; v3/kernel/facts.shard — what the plain reading asks K about Init's names, as a table.
;;; The classifier reads a program from the source and K's declared signatures: which written
;;; arguments run, which constructor a pattern names, what a row is represented by. The Rust
;;; bootstrap reads ordinary files the same way (rust_bootstrap/src/plain/) and has no K: it
;;; reads these facts instead. `load.shard --facts` prints them for the closure it loaded — one
;;; line per constant of Init that a token of the closure's files can resolve to (the loader's
;;; demand, loader.shard init_demand; the files of an implementation it linked among them), with
;;; the constructors of every inductive among them, the inductive of every constructor, the
;;; types an inductive's fields are at and the structure of every projection function; sorted
;;; bytewise.
;;;
;;;   (ind NAME PROP PARAMS (CTOR…) VIEW)   VIEW: (e N (CTOR T…)…) an E type of N type parameters
;;;                                               and its constructors' runtime fields | row | int | none
;;;   (ctor NAME IND BINDERS FIELDS)        FIELDS: per field after the parameters, t runtime / f erased
;;;   (def NAME PROP BINDERS PROJ)          PROJ: (STRUCT INDEX E…) for a projection function — the
;;;                                               structure, the field, its lambdas' binders —, else -
;;;   (thm NAME PROP)  (axiom NAME PROP)  (opaque NAME PROP)  (other NAME PROP)
;;;
;;;   PARAMS, BINDERS: (B…) with B = (E R), or - where K's signature gives no roles
;;;   E: x explicit, i implicit      R: k runtime data (a kept type argument, for PARAMS),
;;;   PROP: p where the constant's type ends in Prop, else -    d a type or a dropped argument, p a proof
;;;   T: a type parameter by position (a numeral), NAME, or (NAME T…)

(import "classify.shard")
(import "dump.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.kw)
(use kernel.classify)
(use kernel.classify.Rd)
(use kernel.decl)
(use kernel.decl.ConstantInfo)
(use kernel.dump)
(use kernel.erase)
(use kernel.etable)
(use kernel.etable.ESt)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.name)
(use kernel.name.Name)
(use kernel.prog)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.EType)
(use kernel.scope)
(use kernel.scope.Scope)
(use kernel.scope.Vis)
(use kernel.util)

;; the table for these constants of Init (each named once), over the load's environment and
;; E table
(fn facts_lines ((es ESt) (env CheckedEnv) (names (List Name))) (List (List Int))
  (let ((sc (Scope Anon Anon nil VisAll)))
    (dm_sort (facts_each es sc env (facts_closure es sc env names IMEmpty nil (facts_rounds))))))
;; two tables as one: sorted, a line both hold once (a linked implementation's fork fetched
;; what the main line did not, and both fetched what the view cites)
(fn facts_join ((a (List (List Int))) (b (List (List Int)))) (List (List Int))
  (facts_once (dm_sort (append a b))))
(fn facts_once ((ls (List (List Int)))) (List (List Int))
  (measure (struct ls))
  (match ls
    ((cons x (cons y r))
     (if (int_list_eq x y) (facts_once (cons y r)) (cons x (facts_once (cons y r)))))
    (_ ls)))
(fn facts_rounds () Int 64)
;; the names with what a reader of them is led to: an inductive's constructors, a
;; constructor's inductive, the types an E inductive's fields are at, the structure a
;; projection function projects — until nothing is new
(fn facts_closure
  ((es ESt)
   (sc Scope)
   (env CheckedEnv)
   (todo (List Name))
   (seen (IntMap (List Name)))
   (acc (List Name))
   (fuel Int))
  (List Name)
  (measure fuel)
  (if (< fuel 0) acc
  (match (facts_fresh todo seen nil)
    ((Prod.mk nil _) acc)
    ((Prod.mk fresh seen1)
     (facts_closure es sc env (facts_led es sc env fresh nil) seen1 (rev_onto fresh acc) (- fuel 1))))))
(fn facts_fresh ((ns (List Name)) (seen (IntMap (List Name))) (acc (List Name)))
  (Prod (List Name) (IntMap (List Name)))
  (measure (struct ns))
  (match ns
    (nil (Prod.mk acc seen))
    ((cons n r)
     (let ((h (name_key n)))
       (let
         ((b
            (match (im_find seen h)
              ((some x) x)
              (none nil))))
         (if (mem_name n b) (facts_fresh r seen acc)
         (facts_fresh r (im_insert seen h (cons n b)) (cons n acc))))))))
(fn facts_led ((es ESt) (sc Scope) (env CheckedEnv) (ns (List Name)) (acc (List Name))) (List Name)
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r)
     (facts_led es sc env r
       (match (env_find env n)
         ((some (InductInfo _ _ _ _ ctors _ _ _ _))
          (append ctors
            (match (facts_view es sc env n)
              ((some (EInd _ _ cdefs)) (ctor_type_names cdefs acc))
              (_ acc))))
         ((some (CtorInfo _ ind _ _ _ _)) (cons ind acc))
         ((some (DefnInfo _ v _ _ _))
          (match (proj_fn_of v 0)
            ((some (Prod.mk (Prod.mk sn _) _)) (cons sn acc))
            (none acc)))
         (_ acc))))))
(fn ctor_type_names ((cs (List ECtorDef)) (acc (List Name))) (List Name)
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons (ECtorDef _ fts) r) (ctor_type_names r (etypes_names fts acc)))))
(fn etypes_names ((ts (List EType)) (acc (List Name))) (List Name)
  (measure (struct ts))
  (match ts
    (nil acc)
    ((cons t r) (etypes_names r (etype_names t acc)))))
(fn etype_names ((t EType) (acc (List Name))) (List Name)
  (measure (struct t))
  (match t
    ((ETVar _) acc)
    ((ETCon n as) (etypes_names as (cons n acc)))))
;; an inductive as the E type it is, where it is one (erase.shard ind_eligible registers it)
(fn facts_view ((es ESt) (sc Scope) (env CheckedEnv) (n Name)) (Option EDecl)
  (match (ind_eligible (w0 env) es sc n nil)
    ((Prod.mk (Prod.mk _ es1) true) (es_find_decl es1 n))
    ((Prod.mk _ false) none)))

(fn facts_each ((es ESt) (sc Scope) (env CheckedEnv) (ns (List Name))) (List (List Int))
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n r)
     (match (env_find env n)
       ((some info) (cons (fact_line es sc env n info) (facts_each es sc env r)))
       (none (facts_each es sc env r))))))
(fn fact_line ((es ESt) (sc Scope) (env CheckedEnv) (n Name) (info ConstantInfo)) (List Int)
  (let ((prop (if (ends_in_prop (ci_type info)) "p" "-")) (r (Rd es sc env nil none true)))
    (match info
      ((InductInfo _ _ _ _ ctors _ _ _ _)
       (fact "ind" n
         (list prop (fact_flags (type_flags env n)) (fact_group (fact_names ctors))
           (if (is_nat_or_int n) "int"
           (if (rep_row n) "row"
           (match (facts_view es sc env n)
             ((some (EInd _ np cdefs))
              (fact_group (append "e " (append (show_nat np) (fact_ctors cdefs)))))
             (_ "none")))))))
      ((CtorInfo _ ind _ _ _ _)
       (fact "ctor" n
         (list (show_name ind) (fact_flags (k_flags r n))
           (match (ctor_data_flags (w0 env) es sc n)
             ((some fs) (fact_group (fact_bools fs)))
             (none "-")))))
      ((DefnInfo _ v _ _ _)
       (fact "def" n
         (list prop (fact_flags (k_flags r n))
           (match (proj_fn_of v 0)
             ((some (Prod.mk (Prod.mk sn i) depth))
              (fact_group
                (append (show_name sn)
                  (append " "
                    (append (show_nat i) (fact_explicit (pi_explicit (ci_type info) depth)))))))
             (none "-")))))
      ((ThmInfo _ _ _) (fact "thm" n (list prop)))
      ((AxiomInfo _ _) (fact "axiom" n (list prop)))
      ((OpaqueInfo _ _ _ _) (fact "opaque" n (list prop)))
      (_ (fact "other" n (list prop))))))
;; (KIND NAME PART…)
(fn fact ((kind (List Int)) (n Name) (parts (List (List Int)))) (List Int)
  (append "(" (append kind (append " " (append (show_name n) (append (fact_parts parts) ")"))))))
(fn fact_parts ((ps (List (List Int)))) (List Int)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r) (append (utf8 " ") (append p (fact_parts r))))))
(fn fact_group ((inner (List Int))) (List Int) (append (utf8 "(") (append inner (utf8 ")"))))
;; names separated by spaces
(fn fact_names ((ns (List Name))) (List Int)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n nil) (show_name n))
    ((cons n r) (append (show_name n) (append " " (fact_names r))))))
(fn fact_flags ((fs (Option (List (Prod Bool Symbol))))) (List Int)
  (match fs
    (none "-")
    ((some flags) (fact_group (fact_flag_list flags true)))))
(fn fact_flag_list ((fs (List (Prod Bool Symbol))) (first Bool)) (List Int)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Prod.mk explicit role) r)
     (append (if first nil " ")
       (append "("
         (append (if explicit "x" "i")
           (append " "
             (append
               (if (sym_eq role (quote keep)) "k"
               (if (sym_eq role (quote drop)) "d"
               "p"))
               (append ")" (fact_flag_list r false))))))))))
(fn fact_bools ((bs (List Bool))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b nil) (if b (utf8 "t") (utf8 "f")))
    ((cons b r) (append (if b (utf8 "t ") (utf8 "f ")) (fact_bools r)))))
(fn fact_explicit ((bs (List Bool))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons b r) (append (if b (utf8 " x") (utf8 " i")) (fact_explicit r)))))
(fn fact_ctors ((cs (List ECtorDef))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (ECtorDef c fts) r)
     (append " (" (append (show_name c) (append (fact_types fts) (append ")" (fact_ctors r))))))))
(fn fact_types ((ts (List EType))) (List Int)
  (measure (struct ts))
  (match ts
    (nil nil)
    ((cons t r) (append " " (append (fact_type t) (fact_types r))))))
(fn fact_type ((t EType)) (List Int)
  (measure (struct t))
  (match t
    ((ETVar i) (show_nat i))
    ((ETCon n nil) (show_name n))
    ((ETCon n as) (append "(" (append (show_name n) (append (fact_types as) ")"))))))
