;;; v3/kernel/scope.shard — names, the loader's scope and resolution:
;;; what a citation means in a file. The elaborator (elab.shard), the classifier,
;;; the erasure and the loader all resolve through here. The context `Cx`
;;; carries what resolution needs beside the scope — the environment, the
;;; declaration's universe parameters, the names the current form declares
;;; (citable before admission, with their types) — and the elaborator's
;;; bound names, each with its fvar (terms are built over K's
;;; locals and closed by K's mk_binding, never by de Bruijn arithmetic).

(import "sexpr.shard")
(import "k")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.expr)
(use kernel.intmap)
(use kernel.name)
(use kernel.sexpr)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ReducibilityHints)
(use kernel.expr.Expr)
(use kernel.name.Name)
(use kernel.sexpr.SExpr)

;; the scope the loader builds (loader.shard): the module's own path
;; (Anon for a scratch file: declared names stay bare), the opened prefixes in
;; order (`(use Init)` = bare names, always last), and what is visible. A prefix is held with
;; its hash (name.shard `hash_name`), which resolution folds a citation's components onto
;; (`scope_keyed`): `open_all`, `open_some` and `scope_of` are how the three are built
(type Open
  (OpenAll Name Int)  ; (use P): P.x is citable as x
  (OpenSome Name Int (List Symbol)))  ; (use P a b): only a… and b… — the citation's first component
(fn open_all ((p Name)) Open (OpenAll p (hash_name p)))
(fn open_some ((p Name) (ms (List Symbol))) Open (OpenSome p (hash_name p) ms))
;; `(use P)` with no member opens all of P
(fn open_of ((p Name) (ms (List Symbol))) Open (if (= (len ms) 0) (open_all p) (open_some p ms)))
(fn open_prefixes ((os (List Open))) (List Name)
  (measure (struct os))
  (match os
    (nil nil)
    ((cons (OpenAll p _) r) (cons p (open_prefixes r)))
    ((cons (OpenSome p _ _) r) (cons p (open_prefixes r)))))
;; a derivation: the type, the capability (eq, ord, render; idx for
;; the constructor index the generated source shares), the procedure, the deriving module. An
;; entry is visible where its module and its procedure are — a registration in a module the
;; file does not import is not the file's, whatever was loaded before it
(type Derived (Derived Expr Symbol Name Name))
(type Vis
  (VisAll)  ; a scratch scope: everything the environment holds
  (VisOnly (List Name) (IntMap (List (Prod Name Name))) (List Name) (List Derived)
    (IntMap (List (Prod Name Int)))))
;; the visible modules (the file's import closure and itself), declaration → module for every
;; native declaration (a constant absent from the table is Init's, and every file sees
;; Init), the pending
;; names, the derivation table, declaration → the export's ordinal for every
;; declaration the load imported from Init (what tells Init's own constant from a namesake)
;; the module prefix a file's declarations take (the sealed directory's for a file
;; directly inside one, as in k/) and its hash, the file's own module (the tag
;; visibility and the E table's registration go by), the opened prefixes, the visible set
(type Scope (Scope Name Int Name (List Open) Vis))
(fn scope_of ((m Name) (tag Name) (os (List Open)) (v Vis)) Scope (Scope m (hash_name m) tag os v))

;; a name the current form declares: citable before admission — its universe
;; arity and its type (the elaborator types a citation of it from here)
(type Defd (Defd Name Int Expr))

;; the elaboration context: scope, environment, the declaration's universe
;; parameters, the names being declared by this form, the bound names innermost
;; first with their fvars, the projection aliases (field name → index and the
;; field's type, over the bound `self`), and the E-type flag (a bare polymorphic constant takes
;; level 0 by rule there)
(type Cx
  (Cx Scope CheckedEnv (List Name) (List Defd) (List (Prod Name Expr))
    (List (Prod Name (Prod Int Expr)))
    Bool))

(fn cx_scope ((c Cx)) Scope
  (match c
    ((Cx s _ _ _ _ _ _) s)))
(fn cx_env ((c Cx)) CheckedEnv
  (match c
    ((Cx _ e _ _ _ _ _) e)))
(fn cx_lps ((c Cx)) (List Name)
  (match c
    ((Cx _ _ l _ _ _ _) l)))
(fn cx_defining ((c Cx)) (List Defd)
  (match c
    ((Cx _ _ _ d _ _ _) d)))
(fn cx_bound ((c Cx)) (List (Prod Name Expr))
  (match c
    ((Cx _ _ _ _ b _ _) b)))
(fn cx_aliases ((c Cx)) (List (Prod Name (Prod Int Expr)))
  (match c
    ((Cx _ _ _ _ _ a _) a)))
(fn cx_etype ((c Cx)) Bool
  (match c
    ((Cx _ _ _ _ _ _ t) t)))
(fn cx_bind ((c Cx) (n Name) (fv Expr)) Cx
  (match c
    ((Cx s e l d b a t) (Cx s e l d (cons (Prod.mk n fv) b) a t))))
(fn cx_with_etype ((c Cx) (t Bool)) Cx
  (match c
    ((Cx s e l d b a _) (Cx s e l d b a t))))
(fn cx_with_aliases ((c Cx) (a (List (Prod Name (Prod Int Expr))))) Cx
  (match c
    ((Cx s e l d b _ t) (Cx s e l d b a t))))
(fn cx_with_defining ((c Cx) (d (List Defd))) Cx
  (match c
    ((Cx s e l _ b a t) (Cx s e l d b a t))))
(fn cx0 ((sc Scope) (env CheckedEnv) (lps (List Name)) (defining (List Defd))) Cx
  (Cx sc env lps defining nil nil false))
;; the bound fvar of a name (innermost wins)
(fn cx_lookup ((c Cx) (n Name)) (Option Expr) (assoc_name_expr n (cx_bound c)))
(fn assoc_name_expr ((n Name) (xs (List (Prod Name Expr)))) (Option Expr)
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons (Prod.mk m e) r) (if (name_eq n m) (some e) (assoc_name_expr n r)))))
;; the fvar ids in scope
(fn cx_fvar_ids ((c Cx)) (List Int) (bound_ids (cx_bound c)))
(fn bound_ids ((bs (List (Prod Name Expr)))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons (Prod.mk _ (FVar _ id)) r) (cons id (bound_ids r)))
    ((cons _ r) (bound_ids r))))

;; ---- names ---------------------------------------------------------------------------
;; a symbol's components on `.`; an all-digit component is a Num
(fn name_of_bytes ((bs (List Int)) (comp (List Int)) (acc Name)) (Option Name)
  (measure (struct bs))
  (match bs
    (nil (name_push acc (rev comp)))
    ((cons c r)
     (if (= c 46)
       (match (name_push acc (rev comp))
         ((some n) (name_of_bytes r nil n))
         (none none))
       (name_of_bytes r (cons c comp) acc)))))
(fn name_push ((acc Name) (comp (List Int))) (Option Name)
  (match comp
    (nil none)
    (_
      (if (all_digits comp) (some (Num acc (digits_val comp 0)))
      (some (Str acc (sym_of_chars comp)))))))
(fn name_of_sym ((s Symbol)) (Option Name) (name_of_bytes (chars_of_sym s) nil Anon))

;; p ++ n
(fn name_append ((p Name) (n Name)) Name
  (measure (struct n))
  (match n
    (Anon p)
    ((Str q s) (Str (name_append p q) s))
    ((Num q k) (Num (name_append p q) k))))

(fn sc_module ((sc Scope)) Name
  (match sc
    ((Scope m _ _ _ _) m)))
(fn sc_module_hash ((sc Scope)) Int
  (match sc
    ((Scope _ h _ _ _) h)))
(fn sc_tag ((sc Scope)) Name
  (match sc
    ((Scope _ _ t _ _) t)))
(fn sc_opened ((sc Scope)) (List Open)
  (match sc
    ((Scope _ _ _ o _) o)))
(fn sc_vis ((sc Scope)) Vis
  (match sc
    ((Scope _ _ _ _ v) v)))
;; a declared name's identity: the module path plus the name
(fn qualify ((sc Scope) (n Name)) Name (name_append (sc_module sc) n))
;; n without its prefix p — the inverse of name_append; n itself where p is no prefix of it
(fn name_after ((p Name) (n Name)) Name
  (measure (struct n))
  (if (name_eq p n) Anon
  (match n
    (Anon Anon)
    ((Str q s) (Str (name_after p q) s))
    ((Num q k) (Num (name_after p q) k)))))

;; the declaration → module table (VisOnly's second field), keyed as the environment is
(fn tbl_find ((tbl (IntMap (List (Prod Name Name)))) (k Name)) (Option Name)
  (tbl_find_at tbl (env_key k) k))
(fn tbl_find_at ((tbl (IntMap (List (Prod Name Name)))) (key Int) (k Name)) (Option Name)
  (match (im_find tbl key)
    ((some b) (assoc_name k b))
    (none none)))
(fn tbl_add ((tbl (IntMap (List (Prod Name Name)))) (k Name) (m Name))
  (IntMap (List (Prod Name Name)))
  (let ((h (env_key k)))
    (im_insert tbl h
      (cons (Prod.mk k m)
        (match (im_find tbl h)
          ((some b) b)
          (none nil))))))
;; is the constant k citable from this scope? (a name being declared by the
;; current form is, always — resolve_go asks first)
(fn visible ((sc Scope) (k Name)) Bool (visible_at sc (env_key k) k))
(fn visible_at ((sc Scope) (key Int) (k Name)) Bool
  (match (sc_vis sc)
    (VisAll true)
    ((VisOnly mods tbl _ _ _)
     (match (tbl_find_at tbl key k)
       ((some m) (mem_name m mods))
       (none true)))))  ; a constant no module of the load declared is Init's: citable from every file
(fn ords_find ((ords (IntMap (List (Prod Name Int)))) (k Name)) (Option Int)
  (match (im_find ords (env_key k))
    ((some b) (ords_assoc k b))
    (none none)))
(fn ords_assoc ((k Name) (b (List (Prod Name Int)))) (Option Int)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk n o) r) (if (name_eq k n) (some o) (ords_assoc k r)))))
(fn ords_add ((ords (IntMap (List (Prod Name Int)))) (k Name) (o Int))
  (IntMap (List (Prod Name Int)))
  (let ((h (env_key k)))
    (im_insert ords h
      (cons (Prod.mk k o)
        (match (im_find ords h)
          ((some b) b)
          (none nil))))))
;; the visible procedures derived for a capability at a type: none, the one, or — two modules
;; of the closure each derived it — several
(fn derived_for ((sc Scope) (ty Expr) (cap Symbol)) (List Name)
  (match (sc_vis sc)
    (VisAll nil)
    ((VisOnly mods _ _ ds _) (derived_among sc mods ds ty cap nil))))
(fn derived_among
  ((sc Scope) (mods (List Name)) (ds (List Derived)) (ty Expr) (cap Symbol) (acc (List Name)))
  (List Name)
  (measure (struct ds))
  (match ds
    (nil acc)
    ((cons (Derived t c p m) r)
     (derived_among sc mods r ty cap
       (if
         (bool_and (sym_eq c cap)
           (bool_and (expr_eq t ty)
             (bool_and (mem_name m mods) (bool_and (visible sc p) (bool_not (mem_name p acc))))))
         (cons p acc)
         acc)))))
;; every visible procedure derived for a capability, with the type it was derived at (the
;; classifier keys them by E type: classify.shard derived_eqs)
(fn derived_visible ((sc Scope) (cap Symbol)) (List (Prod Expr Name))
  (match (sc_vis sc)
    (VisAll nil)
    ((VisOnly mods _ _ ds _) (derived_pairs sc mods ds cap))))
(fn derived_pairs ((sc Scope) (mods (List Name)) (ds (List Derived)) (cap Symbol))
  (List (Prod Expr Name))
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons (Derived t c p m) r)
     (if (bool_and (sym_eq c cap) (bool_and (mem_name m mods) (visible sc p)))
       (cons (Prod.mk t p) (derived_pairs sc mods r cap))
       (derived_pairs sc mods r cap)))))
;; a native declaration (in the declaration → module table); an imported one is not
(fn native_decl ((sc Scope) (k Name)) Bool
  (match (sc_vis sc)
    (VisAll false)
    ((VisOnly _ tbl _ _ _)
     (match (tbl_find tbl k)
       ((some _) true)
       (none false)))))
(fn pending_name ((sc Scope) (k Name)) Bool
  (match (sc_vis sc)
    (VisAll false)
    ((VisOnly _ _ p _ _) (mem_name k p))))

;; the universe arity of a citable constant: being declared here, or in the environment
(fn const_arity ((c Cx) (n Name)) (Option Int) (const_arity_at c (env_key n) n))
(fn const_arity_at ((c Cx) (key Int) (n Name)) (Option Int)
  (match (find_defd n (cx_defining c))
    ((some (Defd _ k _)) (some k))
    (none
      (match (env_find_at (cx_env c) key n)
        ((some info) (some (len (ci_lparams info))))
        (none none)))))
(fn find_defd ((n Name) (ds (List Defd))) (Option Defd)
  (measure (struct ds))
  (match ds
    (nil none)
    ((cons (Defd m k t) r) (if (name_eq n m) (some (Defd m k t)) (find_defd n r)))))

;; resolution: the module's own declarations, each opened prefix in
;; order, then the bare name (`(use Init)` is implicit). Two hits = ambiguous.
;; A candidate is a hit when it is being declared by this form or is a
;; visible constant; a pending candidate is the obligation itself.
(type Resolved (RName Name Int) (RNone) (RAmbiguous Name Name) (RPend Name))
(fn resolve ((c Cx) (n Name)) Resolved (resolve_go c n (scope_keyed (cx_scope c) n) RNone))
(fn scope_candidates ((sc Scope) (n Name)) (List Name) (keyed_names (scope_keyed sc n)))
;; the candidates, each with its key in the environment (`env_key`): n's bytes are gone
;; through once, and a candidate's key is its prefix's hash folded over n's components
(fn scope_keyed ((sc Scope) (n Name)) (List (Prod Name Int))
  (let ((m (sc_module sc)) (cs (comp_hashes n nil)))
    (append
      (match m
        (Anon nil)
        (_ (list (keyed_under m (sc_module_hash sc) n cs))))
      (append (prefixed (sc_opened sc) n cs)
        (append (init_cited n) (list (Prod.mk n (key_under (hash_name Anon) cs))))))))
(fn keyed_under ((p Name) (h Int) (n Name) (cs (List Int))) (Prod Name Int)
  (Prod.mk (name_append p n) (key_under h cs)))
(fn keyed ((n Name)) (Prod Name Int) (Prod.mk n (env_key n)))
(fn keyed_names ((ks (List (Prod Name Int)))) (List Name)
  (measure (struct ks))
  (match ks
    (nil nil)
    ((cons (Prod.mk n _) r) (cons n (keyed_names r)))))
;; `Init.NAME` cites the imported NAME explicitly: imported names are bare in
;; K and the loader shows them under the prefix Init, so the citation is the bare name —
;; the spelling that tells Init's `Bool` from a native `main.Bool`
(fn init_cited ((n Name)) (List (Prod Name Int))
  (if (init_prefixed n) (list (keyed (drop_init n))) nil))
;; the comparison primitives are `< <= =`: the spellings `lt le int_eq` are refused
;; everywhere with the one to write (`renamed_primitive`, from the classifier and from the
;; elaborator)
(fn renamed_prim ((s Symbol)) (Option Symbol)
  (if (sym_eq s (quote lt)) (some (quote <))
  (if (sym_eq s (quote le)) (some (quote <=))
  (if (sym_eq s (quote int_eq)) (some (quote =))
  none))))
(fn renamed_spelling ((s Symbol)) Bool
  (match (renamed_prim s)
    ((some _) true)
    (none false)))
(fn renamed_msg ((old Symbol) (new Symbol)) (List Int)
  (append (chars_of_sym old)
    (append " is spelled " (append (chars_of_sym new) ": write that instead"))))
(fn init_prefixed ((n Name)) Bool
  (match (first_component n)
    ((some s) (sym_eq s (quote Init)))
    (none false)))
;; the name without its leading `Init` component (`(use Init.List)` opens `List`)
(fn drop_init ((n Name)) Name
  (measure (struct n))
  (match n
    ((Str Anon s) (if (sym_eq s (quote Init)) Anon n))
    ((Str p s) (Str (drop_init p) s))
    ((Num p k) (Num (drop_init p) k))
    (Anon Anon)))
(fn prefixed ((ps (List Open)) (n Name) (cs (List Int))) (List (Prod Name Int))
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons (OpenAll p h) r) (cons (keyed_under p h n cs) (prefixed r n cs)))
    ((cons (OpenSome p h ms) r)
     (if (first_component_in n ms) (cons (keyed_under p h n cs) (prefixed r n cs))
     (prefixed r n cs)))))
(fn first_component_in ((n Name) (ms (List Symbol))) Bool
  (match (first_component n)
    ((some s) (mem_sym s ms))
    (none false)))
(fn first_component ((n Name)) (Option Symbol)
  (measure (struct n))
  (match n
    (Anon none)
    ((Str Anon s) (some s))
    ((Str p _) (first_component p))
    ((Num Anon _) none)
    ((Num p _) (first_component p))))
(fn mem_sym ((s Symbol) (xs (List Symbol))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (sym_eq s y) true (mem_sym s r)))))
(fn is_defining ((c Cx) (k Name)) Bool
  (match (find_defd k (cx_defining c))
    ((some _) true)
    (none false)))
(fn resolve_go ((c Cx) (n Name) (cands (List (Prod Name Int))) (found Resolved)) Resolved
  (measure (struct cands))
  (match cands
    (nil found)
    ((cons (Prod.mk k key) r)
     (if (pending_name (cx_scope c) k) (RPend k)
     (match (const_arity_at c key k)
       (none (resolve_go c n r found))
       ((some a)
        (if (bool_or (is_defining c k) (visible_at (cx_scope c) key k))
          (match found
            (RNone (resolve_go c n r (RName k a)))
            ((RName f _)
             (if (name_eq f k) (resolve_go c n r found) (resolve_type_pick c n r found f k a)))
            (_ found))
          (resolve_go c n r found))))))))
;; two candidates: ambiguous — except in an E-type position (a fn's binders and result, a
;; type's fields), where the one that is an inductive is what the position determines:
;; a `type` whose constructor bears its name — `(type World (World Int))` — opens both
;; `World` and `World.World` for the file
(fn resolve_type_pick
  ((c Cx) (n Name) (r (List (Prod Name Int))) (found Resolved) (f Name) (k Name) (a Int))
  Resolved
  (if (cx_etype c)
    (match (Prod.mk (is_inductive c f) (is_inductive c k))
      ((Prod.mk true false) (resolve_go c n r found))
      ((Prod.mk false true) (resolve_go c n r (RName k a)))
      (_ (RAmbiguous f k)))
    (RAmbiguous f k)))
(fn is_inductive ((c Cx) (k Name)) Bool
  (match (env_find (cx_env c) k)
    ((some (InductInfo _ _ _ _ _ _ _ _ _)) true)
    (_ false)))

;; a constructor by the type a position expects: the name under the
;; inductive's own prefix first (`Add` at an expected `Exp` is `Exp.Add`), then the scope's
;; candidates — the first that is a citable constructor of that inductive. A pattern's head
;; resolves through here; a term's does when the plain resolution is ambiguous
(fn resolve_ctor ((c Cx) (n Name) (ind Name)) (Option Name)
  (first_ctor_of c ind (cons (keyed (name_append ind n)) (scope_keyed (cx_scope c) n))))
(fn first_ctor_of ((c Cx) (ind Name) (cands (List (Prod Name Int)))) (Option Name)
  (measure (struct cands))
  (match cands
    (nil none)
    ((cons (Prod.mk k key) r)
     (match (env_find_at (cx_env c) key k)
       ((some (CtorInfo _ i _ _ _ _))
        (if (bool_and (name_eq i ind) (bool_or (is_defining c k) (visible_at (cx_scope c) key k)))
          (some k)
          (first_ctor_of c ind r)))
       (_ (first_ctor_of c ind r))))))

;; the position of a name in a list (the classifier's bound names)
(fn index_of ((n Name) (bs (List Name)) (i Int)) (Option Int)
  (measure (struct bs))
  (match bs
    (nil none)
    ((cons b r) (if (name_eq n b) (some i) (index_of n r (+ i 1))))))

;; ---- heads (the reader's and the classifier's) --------------------------------------
;; `@f`: Lean's explicit application — every binder of f takes a written argument
(fn sym_explicit ((x Symbol)) Bool
  (match (chars_of_sym x)
    ((cons 64 _) true)
    (_ false)))
(fn sym_strip ((x Symbol)) Symbol
  (match (chars_of_sym x)
    ((cons 64 r) (sym_of_chars r))
    (_ x)))
;; a match with a numeral row is a literal match — tests in row order, never a matcher (elab.shard
;; elab_match_lit, classify.shard read_ematch_lit) —, and the scrutinee's name in its tests is
;; one no source symbol can be: it holds a space
(fn has_numeral_row ((arms (List SExpr))) Bool
  (measure (struct arms))
  (match arms
    (nil false)
    ((cons (SList (cons (SNum _) _)) _) true)
    ((cons _ r) (has_numeral_row r))))
(fn lit_scrut () Symbol (sym_of_chars "match scrutinee"))
(fn univ_params ((ls (List SExpr)) (acc (List Name))) (Option (List Name))
  (measure (struct ls))
  (match ls
    (nil (some (rev acc)))
    ((cons (SSym u) r)
     (match (name_of_sym u)
       ((some n) (univ_params r (cons n acc)))
       (none none)))
    (_ none)))

;; (type (NAME T…) …) / (type NAME …): the qualified name and its parameters
(fn type_head ((sc Scope) (s SExpr)) (Prod (Option (Prod Name (List Name))) (List Int))
  (match s
    ((SSym x)
     (match (name_of_sym x)
       ((some n) (Prod.mk (some (Prod.mk (qualify sc n) nil)) nil))
       (none (Prod.mk none (chars_of_sym x)))))
    ((SList (cons (SSym x) ps))
     (match (name_of_sym x)
       (none (Prod.mk none (chars_of_sym x)))
       ((some n)
        (match (univ_params ps nil)
          ((some names) (Prod.mk (some (Prod.mk (qualify sc n) names)) nil))
          (none (Prod.mk none "type parameters are names"))))))
    (_ (Prod.mk none "(type (NAME T…) …) or (type NAME …)"))))

;; ---- reducibility height (environment.cpp: 1 + the greatest height cited) -----------
(fn def_height ((env CheckedEnv) (v Expr)) Int (+ 1 (max_height env (expr_consts v) 0)))
(fn max_height ((env CheckedEnv) (ns (List Name)) (acc Int)) Int
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r)
     (max_height env r
       (match (env_find env n)
         ((some (DefnInfo _ _ (HRegular h) _ _)) (max_int acc h))
         (_ acc))))))
