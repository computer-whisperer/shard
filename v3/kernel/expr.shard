(fulfills expr_eq_seen.dec_1
  (by
    (intro a b seen ia ha h6 h7 h8 h9 h ib hb h13 h14 h15 h16 h_17 h_18 h_19 h_20)
    (arith only h_18 (farkas 1))))
(fulfills expr_eq_seen.dec_2
  (by
    (intro a b seen ia ha h6 h7 h8 h9 h ib hb h13 h14 h15 h16 h_17 h_18 h_19 h_20)
    (arith only h_18 h_19 h_20 (farkas 1))))
