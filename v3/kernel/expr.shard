;;; v3/kernel/expr.shard — L terms (Lean `Expr`) and the rules over them.
;;;
;;; Reconciled against src/kernel/expr.h, type_checker.cpp, inductive.h
;;; (v4.33.1). Line numbers are into type_checker.cpp unless said.
;;; Representation choices that are NOT rule departures:
;;;   - MVar is the elaborator's (FOUNDATION §6; LANGUAGE.md §8.4 slice
;;;     3.15): a term reaching K with one is Malformed (l. 342 "does not
;;;     support meta variables") — infer refuses the node, the raw entry
;;;     refuses the declaration. Its assignment lives in the elaborator's
;;;     own state (unify.shard), never in a term K reads.
;;;   - no MData: transparent to every rule (infer l. 339, whnf l. 742,
;;;     quick_is_def_eq); stripped at import (the exporter drops it).
;;;   - FVar is K-internal: locally nameless checking opens a binder with
;;;     a fresh FVar in a local context; a raw input containing one is
;;;     Malformed (`check_no_metavar_no_fvar`).
;;;   - de Bruijn indices and projection indices are Int ≥ 0.
;;;
;;; REPRESENTATION (ruled 2026-09-07; records §8): annotated nodes with
;;; identity — the pin's own mechanism (expr.h `expr_data`: cached hash,
;;; loose-bvar range, has_fvar, has_univ_param; pointer identity as the
;;; equality fast path; expr_map memo tables keyed structurally). Every
;;; node carries a `D` as its FIRST field:
;;;   id      0 = ANONYMOUS (no identity claim); > 0 = unique within the
;;;           environment lineage it was minted in. INVARIANT, for every
;;;           term K mints: two nodes with the same id > 0 are
;;;           structurally identical (inside a check no state is advanced
;;;           twice — the state's check, thread.shard). The layers above
;;;           K reuse states and a term of theirs can wear one id on two
;;;           nodes, so every reader of an id reads the hash with it
;;;           (expr_eq, same_node, ing_same, used_consts; store.shard's
;;;           sw_same): LANGUAGE.md §8.6 "An id confirmed by its hash".
;;;           Only the constructors below build a D; a D is never copied.
;;;   hash    the structural hash (binder names/infos ignored) — the same
;;;           formulas as before this representation, so the accelerator
;;;           identity pins (accel_pins.shard) are unchanged.
;;;   range   get_loose_bvar_range: 0 for a closed term, else 1 + the
;;;           largest loose index — prunes every traversal to the open
;;;           part of a term (the export's sharing is walked once, not as
;;;           a tree; the measurement of records §8).
;;;   fvar    has_fvar (prunes abstract); lparam has_univ_param (prunes
;;;           level instantiation); mvar has_mvar (prunes the elaborator's
;;;           instantiation of assignments; always false in K's terms).
;;; Ids come from the node counter of `St` (below): `new_*` mint an id,
;;; `mk_*` build anonymous nodes (leaves are always anonymous: identity
;;; buys nothing on a leaf). A St whose node counter is negative is in
;;; anonymous mode (`st_anon`): every threaded utility then produces
;;; anonymous nodes — for tests and for terms built outside a check.
;;; Ids persist inside a CheckedEnv, so the env carries a WATERMARK (its
;;; 4th field): `check_decl` seeds the counter from max(watermark, st) and
;;; writes the final counter back; a direct caller of the checker on a
;;; checked env must start from `(st_for env)` (tc.shard).

(import "level.shard")
(import "intmap.shard")
(use kernel.intmap)
(use kernel.level)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.intmap.IntMap)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

(type BinderInfo
  (BDefault)
  (BImplicit)
  (BStrictImplicit)
  (BInstImplicit))
;; Binder info never affects a judgment; it is display/elaboration data
;; carried through for the exporter round trip and for I (§7). The C++
;; enum also has `Rec` (legacy); the exporter does not emit it — Malformed
;; if seen.

(type Literal
  (LitNat Int)          ; a Nat numeral (GMP); ≥ 0; size-bounded (below)
  (LitStr (List Int)))  ; a string literal as its UTF-8 bytes

;; the node data (expr.h `expr_data`): id, hash, loose-bvar range, has_fvar, has_lparam, has_mvar
(type D (D Int Int Int Bool Bool Bool))

(type Expr
  (BVar D Int)                        ; bound variable, de Bruijn index
  (FVar D Int)                        ; K-internal free variable (local context id)
  (Sort D Level)                      ; Sort u
  (Const D Name (List Level))         ; a constant with universe arguments
  (App D Expr Expr)                   ; f a
  (Lam D Name BinderInfo Expr Expr)   ; fun (x : A) => b   — name is display only
  (Pi  D Name BinderInfo Expr Expr)   ; (x : A) → B
  (Let D Name Expr Expr Expr)         ; let x : A := v; b
  (Lit D Literal)
  (Proj D Name Int Expr)              ; e.i on structure S: (Proj S i e)
  (MVar D Int))                       ; ?m — an elaboration metavariable (never in K's terms)

;; the memo tables of the pin's type_checker::state (the operations are
;; tc.shard's): each maps the low bits of a structural hash to a bucket of
;; (key, value) pairs verified by expr_eq — infer in checking mode, infer
;; in inference-only mode, whnf_core, whnf, unfold (a constant with level
;; arguments → its instantiated value), is_def_eq successes and failures
;; (the pair tables hold (t, s) ordered by hash). Reset per declaration:
;; the pin builds a fresh type_checker for every environment::add.
(type Memo
  (Memo (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))
        (IntMap (List (Pair Expr Expr)))))

(fn memo_empty () Memo (Memo IMEmpty IMEmpty IMEmpty IMEmpty IMEmpty IMEmpty IMEmpty))

;; the checker state: next fvar id, heartbeats used, next node id (< 0 =
;; anonymous mode), the memo tables. Threaded through every procedure and
;; every constructing utility; the bootstrap has no mutation.
(type St (St Int Int Int Memo))

(fn st_init () St (St 0 0 0 (memo_empty)))
(fn st_anon () St (St 0 0 (- 0 1) (memo_empty)))
(fn st_node ((st St)) Int (match st ((St _ _ k _) k)))
;; a fresh node id (ids start at 1; 0 is the anonymous id), or 0 in anonymous mode
(fn st_fresh_node ((st St)) (Pair St Int)
  (match st ((St g t k m) (if (< k 0) (Pair st 0) (Pair (St g t (+ k 1) m) (+ k 1))))))

;; ======================================================================
;; TYPING — `infer_type_core(e, infer_only)` (l. 325). With infer_only
;; false every rule also CHECKS; K's `check` is the checking mode, and
;; the inference-only mode is an internal accelerator that must agree.
;; Results are memoized per mode.
;;
;;   BVar      unreachable: a checked term is closed; binders are opened
;;             with FVars (l. 344 `lean_unreachable`). Loose bvar in a raw
;;             input → Malformed.
;;   FVar      its type in the local context (l. 93); unknown → Malformed.
;;   Sort u    check_level u (declared params only); type = Sort (u+1).
;;   Const c ls
;;             c must exist; length ls = c's level-parameter count
;;             (l. 105 "incorrect number of universe levels parameters");
;;             checking mode: c unsafe ⇒ the checked declaration must be
;;             unsafe; c partial ⇒ the checked declaration must not be
;;             safe (l. 110–116); each l in ls check_level'd; type =
;;             c's type with its level params instantiated by ls.
;;   App f a   f's type whnf'd must be a Pi (l. 175 `ensure_pi_core`, else
;;             "function expected"); a's type must be def-eq to the
;;             domain (l. 184, else "application type mismatch"); the
;;             `eagerReduce _ _` argument form sets the eager flag for
;;             that comparison (l. 178); type = codomain[a].
;;   Lam x A b infer_lambda (l. 125): A checks as a type (ensure_sort of
;;             A's type); open x as an FVar; type = Pi x A (type of b).
;;   Pi x A B  infer_pi (l. 144): A : Sort u, B : Sort v (each ensure_sort);
;;             type = Sort (imax u v) — impredicative Prop.
;;   Let x A v b
;;             infer_let (l. 208): A a type; v's type def-eq A; body under
;;             an FVar whose local decl carries the value (whnf may
;;             zeta-expand it, l. 744 `is_let_fvar`); type = type of b[v].
;;   Lit (LitNat n)
;;             infer_lit (l. 315): the numeral's byte size is bounded by
;;             LEAN_NAT_MAX_SIZE (`check_nat_size`, else an exception K
;;             reports as Exhausted(nat_size)); type = Nat.
;;   Lit (LitStr s)
;;             type = String (the pinned `String`; its expansion below).
;;   Proj S i e
;;             infer_proj (l. 247): e's type whnf's to `S params indices`
;;             with S an inductive with exactly one constructor
;;             (else "invalid projection"); walk the constructor's type
;;             past the params (instantiated with the actual params) and
;;             the first i fields (each dependent field instantiated with
;;             `Proj S j e`); if the struct type is a proposition, every
;;             field passed and the result must be propositions (no data
;;             out of a proof); type = the i-th field's type.

;; ======================================================================
;; REDUCTION — `whnf_core(e, cheap_rec, cheap_proj)` (l. 468) and
;; `whnf(e)` (l. 736).
;;
;;   whnf_core (no delta, no Nat/native extensions), memoized:
;;     BVar Sort Pi Lit          : itself
;;     FVar                      : itself unless a let-bound local (zeta)
;;     MData                     : the inner term
;;     Proj                      : reduce_proj (l. 444): whnf_core the
;;                                 struct (whnf if not cheap_proj); if it
;;                                 is a string literal, expand it first
;;                                 (l. 421); if a constructor application
;;                                 with enough args, the i-th field.
;;     App                       : whnf_core the head; Lam head → beta
;;                                 (all available args at once, l. 523);
;;                                 Const head → reduce_recursor (below);
;;                                 changed head → rebuild and recurse.
;;     Let x A v b               : zeta — b[v] (l. 543).
;;   reduce_recursor (l. 393): quot_reduce_rec first, then
;;     inductive_reduce_rec (inductive.h l. 77):
;;       major index = nparams + nmotives + nminors + nindices;
;;       K-like target: major replaced by the nullary constructor when its
;;         type is def-eq to the recursor's expected inductive
;;         (`to_cnstr_when_K`);
;;       major := whnf(major); a Nat literal → `Nat.succ (n-1)` / Nat.zero
;;         (`nat_lit_to_constructor`); a string literal → whnf of its
;;         expansion; otherwise `to_cnstr_when_structure`: for a
;;         non-recursive single-constructor type (not a proposition) a
;;         non-constructor major is eta-expanded to `mk e.0 … e.(n-1)`;
;;       rule := the rule whose ctor is the major's head (none → stuck);
;;       rhs := rule.rhs with the recursor's level params := the
;;         recursor's level arguments (counts must match, else stuck),
;;         applied to the first nparams+nmotives+nminors rec args, then
;;         the major's LAST nfields args, then the args after the major.
;;     quot_reduce_rec (quot.h): `Quot.lift f h (Quot.mk r a) rest…` ⇒
;;       `f a rest…` (major at index 5); `Quot.ind h (Quot.mk r a)` ⇒
;;       `h a`; the major is whnf'd first and must be a `Quot.mk` app.
;;   whnf (l. 736): loop { t := whnf_core t; native (below) ; reduce_nat
;;     (below); else unfold_definition t (delta, l. 589: the head constant
;;     must have a value — a DEFINITION or a THEOREM, never opaque/axiom
;;     — and exactly its level-parameter count of arguments) } until no
;;     step applies; memoized.
;;   reduce_nat (l. 702): on `Nat.succ lit` and on the binary ops
;;     Nat.add sub mul pow gcd mod div beq ble land lor xor shiftLeft
;;     shiftRight (exactly these, l. 717–731) with BOTH arguments literals or `Nat.zero`:
;;     compute (GMP); `beq`/`ble` yield Bool.true/false; results and
;;     inputs size-bounded; `pow`/`shiftLeft` count must fit 32 bits
;;     (else Exhausted, l. 671/686). K binds each op name to the
;;     admitted declaration's fixed identity (FOUNDATION §3.2), validated
;;     at phase 0/T0 against the export.
;;   reduce_native (l. 614): `Lean.reduceBool c` / `Lean.reduceNat c` run
;;     compiled code — sound only under axiom `Lean.ofReduceBool`, outside
;;     the standard profile: K returns Unsupported at that site.

;; ======================================================================
;; DEFINITIONAL EQUALITY — `is_def_eq_core(t, s)` (l. 1171), in EXACTLY
;; this order (the order is observable through budgets and caches):
;;   0. quick_is_def_eq (l. 835): pointer/structural equality or a cached
;;      success → true; same kind and Lam/Pi → is_def_eq_binding (domains
;;      then bodies under a shared FVar, l. 785); Sort → level
;;      is_equivalent; Lit → literal equality; else undecided.
;;   1. `s` is `Bool.true` and `t` closed (or eager): if whnf(t) is
;;      Bool.true → true (the `decide` path, l. 1180).
;;   2. t_n := whnf_core(t, cheap_proj=true), s_n likewise; if either
;;      changed, quick_is_def_eq again.
;;   3. is_def_eq_proof_irrel (l. 932): if t_n's type is a proposition,
;;      the answer is whether the two TYPES are def-eq.
;;   4. lazy_delta_reduction (l. 1088), a loop: is_def_eq_offset (both
;;      `Nat.zero`/0 → true; both `succ`/positive literals → recurse on
;;      predecessors); if no FVars (or eager) reduce_nat on either side
;;      and recurse; reduce_native on either side and recurse; then one
;;      lazy_delta_reduction_step (l. 999): neither side delta → stop
;;      undecided; one side delta → unfold it (unless the OTHER side is
;;      a projection application that whnf_core can reduce — reduce that
;;      instead, l. 1010); both delta → compare ReducibilityHints:
;;      unfold the greater height (abbrev counts as greatest, opaque as
;;      least); equal heights of the SAME regular constant with
;;      arguments → try levels + argument-wise equality first (cached
;;      failure prevents retry); else unfold both; then quick_is_def_eq
;;      decides or the loop continues.
;;   5. same Const name with def-eq levels → true; same FVar → true.
;;   6. Proj with the same struct and index → lazy_delta_proj_reduction
;;      (l. 1123) on the struct terms, falling back to reducing both
;;      projections; true if that succeeds.
;;   7. whnf_core with full projection reduction; if changed, recurse.
;;   8. is_def_eq_app (l. 911): same-length applications with def-eq
;;      heads and def-eq arguments pairwise.
;;   9. try_eta_expansion (l. 874), both directions: `fun x => b` vs `s`
;;      where s's whnf'd type is a Pi ⇒ compare with `fun x => s x`.
;;  10. try_eta_struct (l. 889), both directions: s = `mk a_1 … a_n` of a
;;      non-recursive structure with nparams+nfields args, types def-eq,
;;      and each `Proj i t` def-eq `a_i`.
;;  11. try_string_lit_expansion (l. 1145), both directions: a string
;;      literal against a `String.ofList …` application ⇒ compare the
;;      literal's expansion.
;;  12. is_def_eq_unit_like (l. 1159): t's type whnf's to a non-recursive
;;      structure with a zero-field constructor and the types are def-eq
;;      ⇒ true.
;;  13. false. Successes are cached symmetrically (l. 1248).
;;
;; String literal expansion (inductive.cpp l. 1368, at v4.33.1):
;;   "…" ⇒ String.ofList (List.cons.{0} Char (Char.ofNat c₁)
;;                          (… (List.nil.{0} Char)))
;;   over the UTF-8-decoded scalar values c_i as Nat literals. The head
;;   is `String.ofList` (g_string_mk, inductive.cpp l. 1394) — the
;;   logical String is `String.ofByteArray` (v3/INVENTORY.md); the
;;   kernel's literal rule goes through `ofList`, whose body relates
;;   the two. Exactness means K expands to this term, not to `String.mk`.

;; ======================================================================
;; THE FUNCTIONS (phase 1) — expr.cpp / instantiate.cpp / abstract.cpp.
;; De Bruijn discipline: `instantiate` and `abstract` are the pin's
;; (instantiate.cpp l. 15/99, abstract.cpp l. 14) over the cached range
;; and flags of D: a subterm the operation cannot touch is returned as it
;; is (the same node, identity kept), never rebuilt.

;; ---- structural hashing (identity pins, memo tables) --------------------------------
;; A structural hash ignoring binder names and binder infos (like expr_eq),
;; bounded by the prime M = 2^61 − 1. Not a security hash: it fixes an
;; identity for the accelerator pins (FOUNDATION §3.2) and keys caches.
;; Computed once per node at construction and cached in D. `hash_m`, `mix`
;; and `hash_name` are name.shard's (the environment's key, ev's tables).

(fn mix3 ((a Int) (b Int) (c Int)) Int (mix (mix a b) c))

(fn hash_level ((l Level)) Int
  (measure (struct l))
  (match l
    (LZero 11)
    ((LSucc x) (mix 13 (hash_level x)))
    ((LMax a b) (mix3 17 (hash_level a) (hash_level b)))
    ((LIMax a b) (mix3 19 (hash_level a) (hash_level b)))
    ((LParam n) (mix 23 (hash_name n)))
    ((LMVar i) (mix 27 i))))

(fn hash_levels ((ls (List Level)) (acc Int)) Int
  (measure (struct ls))
  (match ls (Nil acc) ((Cons l r) (hash_levels r (mix acc (hash_level l))))))

(fn hash_lit ((l Literal)) Int
  (match l ((LitNat n) (mix 61 n)) ((LitStr s) (mix 67 (hash_bytes s 1)))))

(fn levels_have_param ((ls (List Level))) Bool
  (measure (struct ls))
  (match ls (Nil False) ((Cons l r) (if (level_has_param l) True (levels_have_param r)))))
(fn levels_have_mvar ((ls (List Level))) Bool
  (measure (struct ls))
  (match ls (Nil False) ((Cons l r) (if (level_has_mvar l) True (levels_have_mvar r)))))

;; ---- the node data ------------------------------------------------------------------

(fn expr_d ((e Expr)) D
  (match e
    ((App d _ _) d) ((Const d _ _) d) ((BVar d _) d) ((Pi d _ _ _ _) d) ((Lam d _ _ _ _) d)
    ((FVar d _) d) ((Sort d _) d) ((Lit d _) d) ((Proj d _ _ _) d) ((Let d _ _ _ _) d) ((MVar d _) d)))

(fn d_id ((d D)) Int (match d ((D i _ _ _ _ _) i)))
(fn d_hash ((d D)) Int (match d ((D _ h _ _ _ _) h)))
(fn d_range ((d D)) Int (match d ((D _ _ r _ _ _) r)))

(fn expr_id ((e Expr)) Int (d_id (expr_d e)))
(fn hash_expr ((e Expr)) Int (d_hash (expr_d e)))
;; get_loose_bvar_range: 0 for a closed term, else 1 + the largest loose index
(fn loose_bvar_range ((e Expr)) Int (d_range (expr_d e)))
(fn has_loose_bvars ((e Expr)) Bool (< 0 (loose_bvar_range e)))
(fn has_fvar ((e Expr)) Bool (match (expr_d e) ((D _ _ _ f _ _) f)))
(fn has_lparam ((e Expr)) Bool (match (expr_d e) ((D _ _ _ _ p _) p)))
(fn has_mvar ((e Expr)) Bool (match (expr_d e) ((D _ _ _ _ _ m) m)))

;; did a traversal keep this node? the same identified node, or (for an
;; anonymous node — leaves always are) structural equality, which a touched
;; node never has (every touch alters a leaf). An id is read with its hash
;; (LANGUAGE.md §8.6 "An id confirmed by its hash"): a term from above K can
;; wear one id on two nodes
(fn same_node ((a Expr) (b Expr)) Bool
  (let ((ia (expr_id a)))
    (if (< 0 ia) (if (= ia (expr_id b)) (= (hash_expr a) (hash_expr b)) False) (expr_eq a b))))

;; ---- constructors ---------------------------------------------------------------------
;; leaves: always anonymous
(fn mk_bvar ((i Int)) Expr (BVar (D 0 (mix 29 i) (+ i 1) False False False) i))
(fn mk_fvar ((i Int)) Expr (FVar (D 0 (mix 31 i) 0 True False False) i))
(fn mk_sort ((u Level)) Expr (Sort (D 0 (mix 37 (hash_level u)) 0 False (level_has_param u) (level_has_mvar u)) u))
(fn mk_const ((n Name) (ls (List Level))) Expr
  (Const (D 0 (mix3 41 (hash_name n) (hash_levels ls 1)) 0 False (levels_have_param ls) (levels_have_mvar ls)) n ls))
(fn mk_lit ((l Literal)) Expr (Lit (D 0 (hash_lit l) 0 False False False) l))
(fn mk_mvar ((i Int)) Expr (MVar (D 0 (mix 73 i) 0 False False True) i))

;; the D of a compound node from its children
(fn d_app ((id Int) (f Expr) (a Expr)) D
  (match (expr_d f)
    ((D _ hf rf ff pf mf)
     (match (expr_d a)
       ((D _ ha ra fa pa ma) (D id (mix3 43 hf ha) (max_int rf ra) (if ff True fa) (if pf True pa) (if mf True ma)))))))
(fn d_bind ((id Int) (tag Int) (dm Expr) (b Expr)) D
  (match (expr_d dm)
    ((D _ hd rd fd pd md)
     (match (expr_d b)
       ((D _ hb rb fb pb mb) (D id (mix3 tag hd hb) (max_int rd (- rb 1)) (if fd True fb) (if pd True pb) (if md True mb)))))))
(fn d_let ((id Int) (t Expr) (v Expr) (b Expr)) D
  (match (expr_d t)
    ((D _ ht rt ft pt mt)
     (match (expr_d v)
       ((D _ hv rv fv pv mv)
        (match (expr_d b)
          ((D _ hb rb fb pb mb)
           (D id (mix3 59 (mix ht hv) hb) (max_int (max_int rt rv) (- rb 1))
              (if ft True (if fv True fb)) (if pt True (if pv True pb)) (if mt True (if mv True mb))))))))))
(fn d_proj ((id Int) (s Name) (i Int) (x Expr)) D
  (match (expr_d x) ((D _ hx rx fx px mx) (D id (mix3 71 (mix (hash_name s) i) hx) rx fx px mx))))

;; anonymous compound nodes (pure)
(fn mk_app ((f Expr) (a Expr)) Expr (App (d_app 0 f a) f a))
(fn mk_app_n ((f Expr) (args (List Expr))) Expr
  (measure (struct args))
  (match args (Nil f) ((Cons a r) (mk_app_n (mk_app f a) r))))
(fn mk_lam ((n Name) (bi BinderInfo) (dm Expr) (b Expr)) Expr (Lam (d_bind 0 47 dm b) n bi dm b))
(fn mk_pi ((n Name) (bi BinderInfo) (dm Expr) (b Expr)) Expr (Pi (d_bind 0 53 dm b) n bi dm b))
(fn mk_let ((n Name) (t Expr) (v Expr) (b Expr)) Expr (Let (d_let 0 t v b) n t v b))
(fn mk_proj ((s Name) (i Int) (x Expr)) Expr (Proj (d_proj 0 s i x) s i x))

;; identified compound nodes (an id minted from St)
(fn new_app ((st St) (f Expr) (a Expr)) (Pair St Expr)
  (match (st_fresh_node st) ((Pair st1 id) (Pair st1 (App (d_app id f a) f a)))))
(fn new_lam ((st St) (n Name) (bi BinderInfo) (dm Expr) (b Expr)) (Pair St Expr)
  (match (st_fresh_node st) ((Pair st1 id) (Pair st1 (Lam (d_bind id 47 dm b) n bi dm b)))))
(fn new_pi ((st St) (n Name) (bi BinderInfo) (dm Expr) (b Expr)) (Pair St Expr)
  (match (st_fresh_node st) ((Pair st1 id) (Pair st1 (Pi (d_bind id 53 dm b) n bi dm b)))))
(fn new_let ((st St) (n Name) (t Expr) (v Expr) (b Expr)) (Pair St Expr)
  (match (st_fresh_node st) ((Pair st1 id) (Pair st1 (Let (d_let id t v b) n t v b)))))
(fn new_proj ((st St) (s Name) (i Int) (x Expr)) (Pair St Expr)
  (match (st_fresh_node st) ((Pair st1 id) (Pair st1 (Proj (d_proj id s i x) s i x)))))

;; ---- ingestion (FOUNDATION §3.5; GPT-6 R43, 2026-09-12; each structure once, 2026-11-11) ----
;; A raw term from outside K wears whatever node data its author wrote: its ids, hashes,
;; ranges and flags are CLAIMS. Every shortcut above — expr_eq's positive-id test, the memo
;; tables keyed on the hash, the range- and flag-pruned traversals — consumes them, so two
;; different literals wearing one positive id made `0 = 1` a theorem through the raw entry
;; (the hostile battery, case 16). Ingestion rebuilds every node from its structure and reads
;; no claim; the raw entry `check` (add.shard) applies it to a submitted declaration before
;; anything reads one. And it builds each distinct structure ONCE (LANGUAGE.md §8.6 "The raw
;; entry builds each structure once"): a compound node is looked for, by its structural hash,
;; in the table of the nodes this declaration has built — found when its children are the
;; same nodes (compound children by the ids minted here, leaves by value) under the same
;; binder name and binder info, so what the author wrote for display stands — and minted from
;; the check's own state only when the table lacks it: no id is minted twice, the state is
;; never taken back (§8.6 "An id confirmed by its hash", rule 2). A submitted graph
;; leaves ingestion a graph whatever ids it wore, and K's check, the axiom pass and the store
;; cost its size; the anonymous tree this walk left before cost them the tree's (a run lemma
;; of 4.05 million nodes for 50 thousand distinct). The walk itself is still the tree's: the
;; sharing of what is submitted cannot be seen without trusting its ids.
(type Ingest (Ingest St (IntMap (List Expr))))
(fn ingest_new ((st St)) Ingest (Ingest st IMEmpty))
(fn ingest_st ((g Ingest)) St (match g ((Ingest st _) st)))
(fn ing_leaf ((e Expr)) Bool
  (match e
    ((App _ _ _) False) ((Lam _ _ _ _ _) False) ((Pi _ _ _ _ _) False) ((Let _ _ _ _ _) False) ((Proj _ _ _ _) False)
    (_ True)))
;; two children the same: one node minted here, or two leaves equal (a leaf is never minted).
;; Two compound children without an id — the state anonymous, as `check`'s never is — are
;; not called the same: expr_eq would say so of two binders that differ in name, and what is
;; kept is the submitted term in its display data too. Such a state shares less; it is never
;; wrong
(fn ing_same ((x Expr) (y Expr)) Bool
  (let ((ix (expr_id x)))
    (if (< 0 ix) (if (= ix (expr_id y)) (= (hash_expr x) (hash_expr y)) False)
      (if (< 0 (expr_id y)) False (if (ing_leaf x) (expr_eq x y) False)))))
(fn binfo_eq ((a BinderInfo) (b BinderInfo)) Bool
  (match a
    (BDefault (match b (BDefault True) (_ False)))
    (BImplicit (match b (BImplicit True) (_ False)))
    (BStrictImplicit (match b (BStrictImplicit True) (_ False)))
    (BInstImplicit (match b (BInstImplicit True) (_ False)))))
;; two compound nodes the same in everything: the kind, the children, the binder's name and info
(fn ing_is ((x Expr) (y Expr)) Bool
  (match x
    ((App _ f a) (match y ((App _ g b) (if (ing_same f g) (ing_same a b) False)) (_ False)))
    ((Lam _ n bi d b) (match y ((Lam _ m bj e c) (if (ing_same d e) (if (ing_same b c) (if (name_eq n m) (binfo_eq bi bj) False) False) False)) (_ False)))
    ((Pi _ n bi d b) (match y ((Pi _ m bj e c) (if (ing_same d e) (if (ing_same b c) (if (name_eq n m) (binfo_eq bi bj) False) False) False)) (_ False)))
    ((Let _ n t v b) (match y ((Let _ m u w c) (if (ing_same t u) (if (ing_same v w) (if (ing_same b c) (name_eq n m) False) False) False)) (_ False)))
    ((Proj _ s i z) (match y ((Proj _ r j w) (if (= i j) (if (ing_same z w) (name_eq s r) False) False)) (_ False)))
    (_ False)))
(fn ing_find ((b (List Expr)) (x Expr)) (Option Expr)
  (measure (struct b))
  (match b (Nil None) ((Cons y r) (if (ing_is x y) (Some y) (ing_find r x)))))
;; the node the table holds for a compound node's anonymous spelling — its hash and its shape,
;; which no id is part of — if it holds one
(fn ing_held ((g Ingest) (x Expr)) (Option Expr)
  (match g ((Ingest _ m) (match (im_find m (hash_expr x)) ((Some b) (ing_find b x)) (None None)))))
;; a node just minted, with the state after it: entered in the table
(fn ing_enter ((g Ingest) (r (Pair St Expr))) (Pair Ingest Expr)
  (match g
    ((Ingest _ m)
     (match r
       ((Pair st1 x)
        (let ((h (hash_expr x)))
          (Pair (Ingest st1 (im_insert m h (Cons x (match (im_find m h) ((Some xs) xs) (None Nil))))) x)))))))
(fn ingest_expr ((g Ingest) (e Expr)) (Pair Ingest Expr)
  (measure (struct e))
  (match e
    ((BVar _ i) (Pair g (mk_bvar i)))
    ((FVar _ i) (Pair g (mk_fvar i)))
    ((Sort _ u) (Pair g (mk_sort u)))
    ((Const _ n ls) (Pair g (mk_const n ls)))
    ((Lit _ l) (Pair g (mk_lit l)))
    ((MVar _ i) (Pair g (mk_mvar i)))
    ((App _ f a)
     (match (ingest_expr g f)
       ((Pair g1 f1)
        (match (ingest_expr g1 a)
          ((Pair g2 a1)
           (match (ing_held g2 (mk_app f1 a1)) ((Some y) (Pair g2 y)) (None (ing_enter g2 (new_app (ingest_st g2) f1 a1)))))))))
    ((Lam _ n bi dm b)
     (match (ingest_expr g dm)
       ((Pair g1 dm1)
        (match (ingest_expr g1 b)
          ((Pair g2 b1)
           (match (ing_held g2 (mk_lam n bi dm1 b1)) ((Some y) (Pair g2 y)) (None (ing_enter g2 (new_lam (ingest_st g2) n bi dm1 b1)))))))))
    ((Pi _ n bi dm b)
     (match (ingest_expr g dm)
       ((Pair g1 dm1)
        (match (ingest_expr g1 b)
          ((Pair g2 b1)
           (match (ing_held g2 (mk_pi n bi dm1 b1)) ((Some y) (Pair g2 y)) (None (ing_enter g2 (new_pi (ingest_st g2) n bi dm1 b1)))))))))
    ((Let _ n t v b)
     (match (ingest_expr g t)
       ((Pair g1 t1)
        (match (ingest_expr g1 v)
          ((Pair g2 v1)
           (match (ingest_expr g2 b)
             ((Pair g3 b1)
              (match (ing_held g3 (mk_let n t1 v1 b1)) ((Some y) (Pair g3 y)) (None (ing_enter g3 (new_let (ingest_st g3) n t1 v1 b1)))))))))))
    ((Proj _ s i x)
     (match (ingest_expr g x)
       ((Pair g1 x1)
        (match (ing_held g1 (mk_proj s i x1)) ((Some y) (Pair g1 y)) (None (ing_enter g1 (new_proj (ingest_st g1) s i x1)))))))))

;; ---- predicates ----------------------------------------------------------

(fn is_sort ((e Expr)) Bool (match e ((Sort _ _) True) (_ False)))
(fn is_pi ((e Expr)) Bool (match e ((Pi _ _ _ _ _) True) (_ False)))
(fn is_lambda ((e Expr)) Bool (match e ((Lam _ _ _ _ _) True) (_ False)))
(fn is_let ((e Expr)) Bool (match e ((Let _ _ _ _ _) True) (_ False)))
(fn is_app ((e Expr)) Bool (match e ((App _ _ _) True) (_ False)))
(fn is_const ((e Expr)) Bool (match e ((Const _ _ _) True) (_ False)))
(fn is_fvar ((e Expr)) Bool (match e ((FVar _ _) True) (_ False)))
(fn is_bvar ((e Expr)) Bool (match e ((BVar _ _) True) (_ False)))
(fn is_lit ((e Expr)) Bool (match e ((Lit _ _) True) (_ False)))
(fn is_proj ((e Expr)) Bool (match e ((Proj _ _ _ _) True) (_ False)))
(fn is_mvar ((e Expr)) Bool (match e ((MVar _ _) True) (_ False)))
(fn is_nat_lit ((e Expr)) Bool (match e ((Lit _ (LitNat _)) True) (_ False)))
(fn is_string_lit ((e Expr)) Bool (match e ((Lit _ (LitStr _)) True) (_ False)))
(fn is_const_named ((e Expr) (n Name)) Bool (match e ((Const _ c _) (name_eq c n)) (_ False)))

(fn lit_eq ((a Literal) (b Literal)) Bool
  (match a
    ((LitNat x) (match b ((LitNat y) (= x y)) (_ False)))
    ((LitStr x) (match b ((LitStr y) (int_list_eq x y)) (_ False)))))

;; structural equality (expr_eq_fn.cpp `is_equal`): binder names and
;; binder info are NOT compared; levels structurally (level_eq). The
;; pin's order: pointer identity → true; hash mismatch → false; structural.
;; Here the hash is read first: an id stands for a pointer only among the nodes
;; one counter minted, and a term from above K can wear one id on two nodes
;; (LANGUAGE.md §8.6 "An id confirmed by its hash") — equal ids on unequal
;; hashes are two nodes, and no answer changes where the ids are unique.
(fn expr_eq ((a Expr) (b Expr)) Bool
  (match (expr_d a)
    ((D ia ha _ _ _ _)
     (match (expr_d b)
       ((D ib hb _ _ _ _)
        (if (= ha hb)
          (if (= ia ib) (if (< 0 ia) True (expr_eq_core a b)) (expr_eq_core a b))
          False))))))

(fn expr_eq_core ((a Expr) (b Expr)) Bool
  (measure (struct a))
  (match a
    ((BVar _ i) (match b ((BVar _ j) (= i j)) (_ False)))
    ((FVar _ i) (match b ((FVar _ j) (= i j)) (_ False)))
    ((Sort _ u) (match b ((Sort _ v) (level_eq u v)) (_ False)))
    ((Const _ n ls) (match b ((Const _ m ms) (if (name_eq n m) (levels_eq ls ms) False)) (_ False)))
    ((App _ f x) (match b ((App _ g y) (if (expr_eq f g) (expr_eq x y) False)) (_ False)))
    ((Lam _ _ _ d1 b1) (match b ((Lam _ _ _ d2 b2) (if (expr_eq d1 d2) (expr_eq b1 b2) False)) (_ False)))
    ((Pi _ _ _ d1 b1) (match b ((Pi _ _ _ d2 b2) (if (expr_eq d1 d2) (expr_eq b1 b2) False)) (_ False)))
    ((Let _ _ t1 v1 b1)
     (match b ((Let _ _ t2 v2 b2) (if (expr_eq t1 t2) (if (expr_eq v1 v2) (expr_eq b1 b2) False) False)) (_ False)))
    ((Lit _ l1) (match b ((Lit _ l2) (lit_eq l1 l2)) (_ False)))
    ((MVar _ i) (match b ((MVar _ j) (= i j)) (_ False)))
    ((Proj _ s1 i1 e1) (match b ((Proj _ s2 i2 e2) (if (name_eq s1 s2) (if (= i1 i2) (expr_eq e1 e2) False) False)) (_ False)))))

(fn exprs_eq ((a (List Expr)) (b (List Expr))) Bool
  (measure (struct a))
  (match a
    (Nil (match b (Nil True) (_ False)))
    ((Cons x ar) (match b (Nil False) ((Cons y br) (if (expr_eq x y) (exprs_eq ar br) False))))))

;; ---- the constants a term cites --------------------------------------------------
;; every Const name in the term (with repeats across distinct nodes; shared
;; identified nodes visited once); the axiom closure (axioms.shard) and the
;; identity closure of the accelerator pins (add.shard) are both over these edges.
;; The nodes seen are held by id with their hash: a node whose id stands there
;; under another hash is another node and is read (§8.6 "An id confirmed by its
;; hash" — the loader reads an elaborated body's constants with this, for a
;; definition's height and a requirement's key)
(fn used_consts ((e Expr) (seen (IntMap Int)) (acc (List Name))) (Pair (IntMap Int) (List Name))
  (measure (struct e))
  (let ((id (expr_id e)))
    (if (bool_and (< 0 id) (match (im_find seen id) ((Some h) (= h (hash_expr e))) (None False)))
      (Pair seen acc)
      (let ((seen1 (if (< 0 id) (im_insert seen id (hash_expr e)) seen)))
        (match e
          ((Const _ n _) (Pair seen1 (Cons n acc)))
          ((App _ f a) (match (used_consts f seen1 acc) ((Pair s1 a1) (used_consts a s1 a1))))
          ((Lam _ _ _ t b) (match (used_consts t seen1 acc) ((Pair s1 a1) (used_consts b s1 a1))))
          ((Pi _ _ _ t b) (match (used_consts t seen1 acc) ((Pair s1 a1) (used_consts b s1 a1))))
          ((Let _ _ t v b)
           (match (used_consts t seen1 acc)
             ((Pair s1 a1) (match (used_consts v s1 a1) ((Pair s2 a2) (used_consts b s2 a2))))))
          ((Proj _ _ _ x) (used_consts x seen1 acc))
          (_ (Pair seen1 acc)))))))

(fn expr_consts ((e Expr)) (List Name) (match (used_consts e IMEmpty Nil) ((Pair _ ns) ns)))

;; ---- loose bound variables ---------------------------------------------

;; has_loose_bvar(e, i): does the loose index i occur?
(fn has_loose_bvar ((e Expr) (i Int)) Bool
  (measure (struct e))
  (if (<= (loose_bvar_range e) i) False
  (match e
    ((BVar _ j) (= i j))
    ((App _ f a) (if (has_loose_bvar f i) True (has_loose_bvar a i)))
    ((Lam _ _ _ d b) (if (has_loose_bvar d i) True (has_loose_bvar b (+ i 1))))
    ((Pi _ _ _ d b) (if (has_loose_bvar d i) True (has_loose_bvar b (+ i 1))))
    ((Let _ _ t v b) (if (has_loose_bvar t i) True (if (has_loose_bvar v i) True (has_loose_bvar b (+ i 1)))))
    ((Proj _ _ _ x) (has_loose_bvar x i))
    (_ False))))

;; lift_loose_bvars(e, s, d): every loose index ≥ s becomes index + d;
;; a subterm whose range is ≤ s has no such index and is kept as it is
(fn lift_loose_bvars ((st St) (e Expr) (s Int) (d Int)) (Pair St Expr)
  (measure (struct e))
  (if (= d 0) (Pair st e)
  (if (<= (loose_bvar_range e) s) (Pair st e)
  (match e
    ((BVar _ i) (Pair st (mk_bvar (+ i d))))
    ((App _ f a)
     (match (lift_loose_bvars st f s d)
       ((Pair st1 f1) (match (lift_loose_bvars st1 a s d) ((Pair st2 a1) (new_app st2 f1 a1))))))
    ((Lam _ n bi t b)
     (match (lift_loose_bvars st t s d)
       ((Pair st1 t1) (match (lift_loose_bvars st1 b (+ s 1) d) ((Pair st2 b1) (new_lam st2 n bi t1 b1))))))
    ((Pi _ n bi t b)
     (match (lift_loose_bvars st t s d)
       ((Pair st1 t1) (match (lift_loose_bvars st1 b (+ s 1) d) ((Pair st2 b1) (new_pi st2 n bi t1 b1))))))
    ((Let _ n t v b)
     (match (lift_loose_bvars st t s d)
       ((Pair st1 t1)
        (match (lift_loose_bvars st1 v s d)
          ((Pair st2 v1) (match (lift_loose_bvars st2 b (+ s 1) d) ((Pair st3 b1) (new_let st3 n t1 v1 b1))))))))
    ((Proj _ sn i x) (match (lift_loose_bvars st x s d) ((Pair st1 x1) (new_proj st1 sn i x1))))
    (_ (Pair st e))))))

;; lower_loose_bvars(e, s, d): every loose index ≥ s becomes index − d
;; (precondition: no loose index in [s−d, s))
(fn lower_loose_bvars ((st St) (e Expr) (s Int) (d Int)) (Pair St Expr)
  (measure (struct e))
  (if (<= (loose_bvar_range e) s) (Pair st e)
  (match e
    ((BVar _ i) (Pair st (mk_bvar (- i d))))
    ((App _ f a)
     (match (lower_loose_bvars st f s d)
       ((Pair st1 f1) (match (lower_loose_bvars st1 a s d) ((Pair st2 a1) (new_app st2 f1 a1))))))
    ((Lam _ n bi t b)
     (match (lower_loose_bvars st t s d)
       ((Pair st1 t1) (match (lower_loose_bvars st1 b (+ s 1) d) ((Pair st2 b1) (new_lam st2 n bi t1 b1))))))
    ((Pi _ n bi t b)
     (match (lower_loose_bvars st t s d)
       ((Pair st1 t1) (match (lower_loose_bvars st1 b (+ s 1) d) ((Pair st2 b1) (new_pi st2 n bi t1 b1))))))
    ((Let _ n t v b)
     (match (lower_loose_bvars st t s d)
       ((Pair st1 t1)
        (match (lower_loose_bvars st1 v s d)
          ((Pair st2 v1) (match (lower_loose_bvars st2 b (+ s 1) d) ((Pair st3 b1) (new_let st3 n t1 v1 b1))))))))
    ((Proj _ sn i x) (match (lower_loose_bvars st x s d) ((Pair st1 x1) (new_proj st1 sn i x1))))
    (_ (Pair st e)))))

;; instantiate(e, s, subst) (instantiate.cpp l. 15): under `offset`
;; binders, a loose bvar with index vidx ≥ s+offset becomes
;;   subst[vidx − (s+offset)] lifted by offset   if vidx < s+offset+n
;;   BVar (vidx − n)                              otherwise
;; A subterm with range ≤ s+offset has no such index and is kept as it is
;; (the pin's `s1 >= get_loose_bvar_range(m)` return).
(fn instantiate_go ((st St) (e Expr) (s Int) (subst (List Expr)) (n Int) (offset Int)) (Pair St Expr)
  (measure (struct e))
  (let ((s1 (+ s offset)))
    (if (<= (loose_bvar_range e) s1) (Pair st e)
    (match e
      ((BVar _ i)
       (if (< i (+ s1 n))
         (match (nth subst (- i s1)) ((Some v) (lift_loose_bvars st v 0 offset)) (None (Pair st e)))
         (Pair st (mk_bvar (- i n)))))
      ((App _ f a)
       (match (instantiate_go st f s subst n offset)
         ((Pair st1 f1) (match (instantiate_go st1 a s subst n offset) ((Pair st2 a1) (new_app st2 f1 a1))))))
      ((Lam _ nm bi t b)
       (match (instantiate_go st t s subst n offset)
         ((Pair st1 t1)
          (match (instantiate_go st1 b s subst n (+ offset 1)) ((Pair st2 b1) (new_lam st2 nm bi t1 b1))))))
      ((Pi _ nm bi t b)
       (match (instantiate_go st t s subst n offset)
         ((Pair st1 t1)
          (match (instantiate_go st1 b s subst n (+ offset 1)) ((Pair st2 b1) (new_pi st2 nm bi t1 b1))))))
      ((Let _ nm t v b)
       (match (instantiate_go st t s subst n offset)
         ((Pair st1 t1)
          (match (instantiate_go st1 v s subst n offset)
            ((Pair st2 v1)
             (match (instantiate_go st2 b s subst n (+ offset 1)) ((Pair st3 b1) (new_let st3 nm t1 v1 b1))))))))
      ((Proj _ sn i x) (match (instantiate_go st x s subst n offset) ((Pair st1 x1) (new_proj st1 sn i x1))))
      (_ (Pair st e))))))

(fn instantiate_n ((st St) (e Expr) (s Int) (subst (List Expr))) (Pair St Expr)
  (let ((n (len subst)))
    (if (= n 0) (Pair st e)
    (if (<= (loose_bvar_range e) s) (Pair st e)
      (instantiate_go st e s subst n 0)))))

;; instantiate(e, v): BVar 0 := v
(fn instantiate1 ((st St) (e Expr) (v Expr)) (Pair St Expr) (instantiate_n st e 0 (Cons v Nil)))

;; instantiate_rev(e, subst) (l. 99): subst given in BINDER order — the
;; LAST element replaces BVar 0 (the innermost binder). Implemented by
;; reversing and using `instantiate_n` at s = 0.
(fn instantiate_rev ((st St) (e Expr) (subst (List Expr))) (Pair St Expr)
  (match subst (Nil (Pair st e)) (_ (instantiate_n st e 0 (rev subst)))))

;; abstract(e, fvars) (abstract.cpp l. 14): fvars in binder order; the
;; i-th fvar becomes BVar (offset + n − i − 1). A subterm without fvars is
;; kept; a rebuilt node whose children did not change is kept too (the
;; pin's `update_*` identity preservation).
(fn abstract_go ((st St) (e Expr) (ids (List Int)) (n Int) (offset Int)) (Pair St Expr)
  (measure (struct e))
  (if (bool_not (has_fvar e)) (Pair st e)
  (match e
    ((FVar _ id)
     (match (index_of_int id ids 0)
       ((Some i) (Pair st (mk_bvar (- (+ offset n) (+ i 1)))))
       (None (Pair st e))))
    ((App _ f a)
     (match (abstract_go st f ids n offset)
       ((Pair st1 f1)
        (match (abstract_go st1 a ids n offset)
          ((Pair st2 a1) (if (same_node f f1) (if (same_node a a1) (Pair st2 e) (new_app st2 f1 a1)) (new_app st2 f1 a1)))))))
    ((Lam _ nm bi t b)
     (match (abstract_go st t ids n offset)
       ((Pair st1 t1)
        (match (abstract_go st1 b ids n (+ offset 1))
          ((Pair st2 b1) (if (same_node t t1) (if (same_node b b1) (Pair st2 e) (new_lam st2 nm bi t1 b1)) (new_lam st2 nm bi t1 b1)))))))
    ((Pi _ nm bi t b)
     (match (abstract_go st t ids n offset)
       ((Pair st1 t1)
        (match (abstract_go st1 b ids n (+ offset 1))
          ((Pair st2 b1) (if (same_node t t1) (if (same_node b b1) (Pair st2 e) (new_pi st2 nm bi t1 b1)) (new_pi st2 nm bi t1 b1)))))))
    ((Let _ nm t v b)
     (match (abstract_go st t ids n offset)
       ((Pair st1 t1)
        (match (abstract_go st1 v ids n offset)
          ((Pair st2 v1)
           (match (abstract_go st2 b ids n (+ offset 1))
             ((Pair st3 b1)
              (if (same_node t t1) (if (same_node v v1) (if (same_node b b1) (Pair st3 e) (new_let st3 nm t1 v1 b1)) (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1)))))))))
    ((Proj _ sn i x)
     (match (abstract_go st x ids n offset)
       ((Pair st1 x1) (if (same_node x x1) (Pair st1 e) (new_proj st1 sn i x1)))))
    (_ (Pair st e)))))

(fn index_of_int ((x Int) (xs (List Int)) (i Int)) (Option Int)
  (measure (struct xs))
  (match xs
    (Nil None)
    ((Cons y r) (if (= x y) (Some i) (index_of_int x r (+ i 1))))))

(fn abstract_fvars ((st St) (e Expr) (ids (List Int))) (Pair St Expr)
  (if (has_fvar e) (abstract_go st e ids (len ids) 0) (Pair st e)))

;; ---- application spines ---------------------------------------------------

(fn get_app_fn ((e Expr)) Expr
  (measure (struct e))
  (match e ((App _ f _) (get_app_fn f)) (_ e)))

(fn get_app_args_go ((e Expr) (acc (List Expr))) (List Expr)
  (measure (struct e))
  (match e ((App _ f a) (get_app_args_go f (Cons a acc))) (_ acc)))

;; the arguments in order (leftmost first)
(fn get_app_args ((e Expr)) (List Expr) (get_app_args_go e Nil))

(fn get_app_num_args ((e Expr)) Int
  (measure (struct e))
  (match e ((App _ f _) (+ 1 (get_app_num_args f))) (_ 0)))

(fn mk_app_list ((st St) (f Expr) (args (List Expr))) (Pair St Expr)
  (measure (struct args))
  (match args
    (Nil (Pair st f))
    ((Cons a r) (match (new_app st f a) ((Pair st1 fa) (mk_app_list st1 fa r))))))

;; ---- universe parameters in terms ----------------------------------------

;; instantiate_lparams (instantiate.cpp l. 236): a subterm without level
;; parameters is kept as it is; a rebuilt node whose children did not
;; change is kept too
(fn expr_inst_lparams ((st St) (e Expr) (ps (List Name)) (ls (List Level))) (Pair St Expr)
  (measure (struct e))
  (if (bool_not (has_lparam e)) (Pair st e)
  (match e
    ((Sort _ u) (Pair st (mk_sort (level_inst u ps ls))))
    ((Const _ n us) (Pair st (mk_const n (levels_inst us ps ls))))
    ((App _ f a)
     (match (expr_inst_lparams st f ps ls)
       ((Pair st1 f1)
        (match (expr_inst_lparams st1 a ps ls)
          ((Pair st2 a1) (if (same_node f f1) (if (same_node a a1) (Pair st2 e) (new_app st2 f1 a1)) (new_app st2 f1 a1)))))))
    ((Lam _ nm bi t b)
     (match (expr_inst_lparams st t ps ls)
       ((Pair st1 t1)
        (match (expr_inst_lparams st1 b ps ls)
          ((Pair st2 b1) (if (same_node t t1) (if (same_node b b1) (Pair st2 e) (new_lam st2 nm bi t1 b1)) (new_lam st2 nm bi t1 b1)))))))
    ((Pi _ nm bi t b)
     (match (expr_inst_lparams st t ps ls)
       ((Pair st1 t1)
        (match (expr_inst_lparams st1 b ps ls)
          ((Pair st2 b1) (if (same_node t t1) (if (same_node b b1) (Pair st2 e) (new_pi st2 nm bi t1 b1)) (new_pi st2 nm bi t1 b1)))))))
    ((Let _ nm t v b)
     (match (expr_inst_lparams st t ps ls)
       ((Pair st1 t1)
        (match (expr_inst_lparams st1 v ps ls)
          ((Pair st2 v1)
           (match (expr_inst_lparams st2 b ps ls)
             ((Pair st3 b1)
              (if (same_node t t1) (if (same_node v v1) (if (same_node b b1) (Pair st3 e) (new_let st3 nm t1 v1 b1)) (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1)))))))))
    ((Proj _ sn i x)
     (match (expr_inst_lparams st x ps ls)
       ((Pair st1 x1) (if (same_node x x1) (Pair st1 e) (new_proj st1 sn i x1)))))
    (_ (Pair st e)))))

;; ---- beta ----------------------------------------------------------------------

;; cheap_beta_reduce (instantiate.cpp l. 211): strip as many lambdas as
;; there are arguments; if the remaining body has no loose bvars, drop the
;; consumed arguments; if it is a bare BVar, select that argument; else
;; leave the term alone.
(fn cheap_beta_reduce ((st St) (e Expr)) (Pair St Expr)
  (match e
    ((App _ _ _)
     (let ((fn (get_app_fn e)) (args (get_app_args e)))
       (if (is_lambda fn)
         (match (strip_lambdas fn (len args) 0)
           ((Pair body i)
            (if (bool_not (has_loose_bvars body)) (mk_app_list st body (drop i args))
            (match body
              ((BVar _ k) (match (nth args (- (- i k) 1))
                            ((Some a) (mk_app_list st a (drop i args)))
                            (None (Pair st e))))
              (_ (Pair st e))))))
         (Pair st e))))
    (_ (Pair st e))))

;; strip up to n lambdas; returns (body, number stripped)
(fn strip_lambdas ((f Expr) (n Int) (i Int)) (Pair Expr Int)
  (measure (struct f))
  (match f
    ((Lam _ _ _ _ b) (if (< i n) (strip_lambdas b n (+ i 1)) (Pair f i)))
    (_ (Pair f i))))

;; beta-reduce the head with all available arguments at once (the App case
;; of whnf_core, type_checker.cpp l. 517–524): consume min(#lambdas, #args)
(fn beta_head ((st St) (f Expr) (args (List Expr))) (Pair St Expr)
  (match (strip_lambdas f (len args) 0)
    ((Pair body m)
     (match (instantiate_n st body 0 (rev (take m args)))
       ((Pair st1 r) (mk_app_list st1 r (drop m args)))))))

;; ---- rendering (diagnostics, tests) ----------------------------------------

(fn show_expr ((e Expr)) (List Int)
  (measure (struct e))
  (match e
    ((BVar _ i) (append "#" (show_nat i)))
    ((FVar _ i) (append "?f" (show_nat i)))
    ((Sort _ u) (append "(Sort " (append (show_level u) ")")))
    ((Const _ n Nil) (show_name n))
    ((Const _ n ls) (append (show_name n) (append ".{" (append (show_levels ls) "}"))))
    ((App _ f a) (append "(" (append (show_expr f) (append " " (append (show_expr a) ")")))))
    ((Lam _ n _ d b)
     (append "(fun (" (append (chars_of_name_last n) (append " : " (append (show_expr d) (append ") => " (append (show_expr b) ")")))))))
    ((Pi _ n _ d b)
     (append "((" (append (chars_of_name_last n) (append " : " (append (show_expr d) (append ") -> " (append (show_expr b) ")")))))))
    ((Let _ n t v b)
     (append "(let " (append (chars_of_name_last n) (append " : " (append (show_expr t) (append " := " (append (show_expr v) (append "; " (append (show_expr b) ")")))))))))
    ((Lit _ (LitNat k)) (show_nat k))
    ((Lit _ (LitStr s)) (append "\"" (append s "\"")))
    ((MVar _ i) (append "?m" (show_nat i)))
    ((Proj _ s i x) (append (show_expr x) (append "." (show_nat i))))))

(fn show_levels ((ls (List Level))) (List Int)
  (measure (struct ls))
  (match ls
    (Nil "")
    ((Cons l Nil) (show_level l))
    ((Cons l r) (append (show_level l) (append ", " (show_levels r))))))

(fn chars_of_name_last ((n Name)) (List Int)
  (match n ((Str _ s) (chars_of_sym s)) ((Num _ k) (show_nat k)) (Anon "_")))
