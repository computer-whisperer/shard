;;; v3/kernel/expr.shard — L terms (Lean `Expr`) and the rules over them.
;;;
;;; Reconciled against src/kernel/expr.h, type_checker.cpp, inductive.h
;;; (v4.33.1). Line numbers are into type_checker.cpp unless said.
;;; Representation choices that are NOT rule departures:
;;;   - no MVar: refused in inputs (l. 342 "does not support meta
;;;     variables"); K's metavariables live in meta (FOUNDATION §6).
;;;   - no MData: transparent to every rule (infer l. 339, whnf l. 742,
;;;     quick_is_def_eq); stripped at import (the exporter drops it).
;;;   - FVar is K-internal: locally nameless checking opens a binder with
;;;     a fresh FVar in a local context; a raw input containing one is
;;;     Malformed (`check_no_metavar_no_fvar`).
;;;   - de Bruijn indices and projection indices are Int ≥ 0.

(import "level.shard")

(type BinderInfo
  (BDefault)
  (BImplicit)
  (BStrictImplicit)
  (BInstImplicit))
;; Binder info never affects a judgment; it is display/elaboration data
;; carried through for the exporter round trip and for I (§7). The C++
;; enum also has `Rec` (legacy); the exporter does not emit it — Malformed
;; if seen.

(type Literal
  (LitNat Int)          ; a Nat numeral (GMP); ≥ 0; size-bounded (below)
  (LitStr (List Int)))  ; a string literal as its UTF-8 bytes

(type Expr
  (BVar Int)                        ; bound variable, de Bruijn index
  (FVar Int)                        ; K-internal free variable (local context id)
  (Sort Level)                      ; Sort u
  (Const Name (List Level))         ; a constant with universe arguments
  (App Expr Expr)                   ; f a
  (Lam Name BinderInfo Expr Expr)   ; fun (x : A) => b   — name is display only
  (Pi  Name BinderInfo Expr Expr)   ; (x : A) → B
  (Let Name Expr Expr Expr)         ; let x : A := v; b
  (Lit Literal)
  (Proj Name Int Expr))             ; e.i on structure S: (Proj S i e)

;; ======================================================================
;; TYPING — `infer_type_core(e, infer_only)` (l. 325). With infer_only
;; false every rule also CHECKS; K's `check` is the checking mode, and
;; the inference-only mode is an internal accelerator that must agree.
;; Results are memoized per mode.
;;
;;   BVar      unreachable: a checked term is closed; binders are opened
;;             with FVars (l. 344 `lean_unreachable`). Loose bvar in a raw
;;             input → Malformed.
;;   FVar      its type in the local context (l. 93); unknown → Malformed.
;;   Sort u    check_level u (declared params only); type = Sort (u+1).
;;   Const c ls
;;             c must exist; length ls = c's level-parameter count
;;             (l. 105 "incorrect number of universe levels parameters");
;;             checking mode: c unsafe ⇒ the checked declaration must be
;;             unsafe; c partial ⇒ the checked declaration must not be
;;             safe (l. 110–116); each l in ls check_level'd; type =
;;             c's type with its level params instantiated by ls.
;;   App f a   f's type whnf'd must be a Pi (l. 175 `ensure_pi_core`, else
;;             "function expected"); a's type must be def-eq to the
;;             domain (l. 184, else "application type mismatch"); the
;;             `eagerReduce _ _` argument form sets the eager flag for
;;             that comparison (l. 178); type = codomain[a].
;;   Lam x A b infer_lambda (l. 125): A checks as a type (ensure_sort of
;;             A's type); open x as an FVar; type = Pi x A (type of b).
;;   Pi x A B  infer_pi (l. 144): A : Sort u, B : Sort v (each ensure_sort);
;;             type = Sort (imax u v) — impredicative Prop.
;;   Let x A v b
;;             infer_let (l. 208): A a type; v's type def-eq A; body under
;;             an FVar whose local decl carries the value (whnf may
;;             zeta-expand it, l. 744 `is_let_fvar`); type = type of b[v].
;;   Lit (LitNat n)
;;             infer_lit (l. 315): the numeral's byte size is bounded by
;;             LEAN_NAT_MAX_SIZE (`check_nat_size`, else an exception K
;;             reports as Exhausted(nat_size)); type = Nat.
;;   Lit (LitStr s)
;;             type = String (the pinned `String`; its expansion below).
;;   Proj S i e
;;             infer_proj (l. 247): e's type whnf's to `S params indices`
;;             with S an inductive with exactly one constructor
;;             (else "invalid projection"); walk the constructor's type
;;             past the params (instantiated with the actual params) and
;;             the first i fields (each dependent field instantiated with
;;             `Proj S j e`); if the struct type is a proposition, every
;;             field passed and the result must be propositions (no data
;;             out of a proof); type = the i-th field's type.

;; ======================================================================
;; REDUCTION — `whnf_core(e, cheap_rec, cheap_proj)` (l. 468) and
;; `whnf(e)` (l. 736).
;;
;;   whnf_core (no delta, no Nat/native extensions), memoized:
;;     BVar Sort Pi Lit          : itself
;;     FVar                      : itself unless a let-bound local (zeta)
;;     MData                     : the inner term
;;     Proj                      : reduce_proj (l. 444): whnf_core the
;;                                 struct (whnf if not cheap_proj); if it
;;                                 is a string literal, expand it first
;;                                 (l. 421); if a constructor application
;;                                 with enough args, the i-th field.
;;     App                       : whnf_core the head; Lam head → beta
;;                                 (all available args at once, l. 523);
;;                                 Const head → reduce_recursor (below);
;;                                 changed head → rebuild and recurse.
;;     Let x A v b               : zeta — b[v] (l. 543).
;;   reduce_recursor (l. 393): quot_reduce_rec first, then
;;     inductive_reduce_rec (inductive.h l. 77):
;;       major index = nparams + nmotives + nminors + nindices;
;;       K-like target: major replaced by the nullary constructor when its
;;         type is def-eq to the recursor's expected inductive
;;         (`to_cnstr_when_K`);
;;       major := whnf(major); a Nat literal → `Nat.succ (n-1)` / Nat.zero
;;         (`nat_lit_to_constructor`); a string literal → whnf of its
;;         expansion; otherwise `to_cnstr_when_structure`: for a
;;         non-recursive single-constructor type (not a proposition) a
;;         non-constructor major is eta-expanded to `mk e.0 … e.(n-1)`;
;;       rule := the rule whose ctor is the major's head (none → stuck);
;;       rhs := rule.rhs with the recursor's level params := the
;;         recursor's level arguments (counts must match, else stuck),
;;         applied to the first nparams+nmotives+nminors rec args, then
;;         the major's LAST nfields args, then the args after the major.
;;     quot_reduce_rec (quot.h): `Quot.lift f h (Quot.mk r a) rest…` ⇒
;;       `f a rest…` (major at index 5); `Quot.ind h (Quot.mk r a)` ⇒
;;       `h a`; the major is whnf'd first and must be a `Quot.mk` app.
;;   whnf (l. 736): loop { t := whnf_core t; native (below) ; reduce_nat
;;     (below); else unfold_definition t (delta, l. 589: the head constant
;;     must have a value — a DEFINITION or a THEOREM, never opaque/axiom
;;     — and exactly its level-parameter count of arguments) } until no
;;     step applies; memoized.
;;   reduce_nat (l. 702): on `Nat.succ lit` and on the binary ops
;;     Nat.add sub mul pow gcd mod div beq ble land lor xor shiftLeft
;;     shiftRight (exactly these, l. 717–731) with BOTH arguments literals or `Nat.zero`:
;;     compute (GMP); `beq`/`ble` yield Bool.true/false; results and
;;     inputs size-bounded; `pow`/`shiftLeft` count must fit 32 bits
;;     (else Exhausted, l. 671/686). K binds each op name to the
;;     admitted declaration's fixed identity (FOUNDATION §3.2), validated
;;     at phase 0/T0 against the export.
;;   reduce_native (l. 614): `Lean.reduceBool c` / `Lean.reduceNat c` run
;;     compiled code — sound only under axiom `Lean.ofReduceBool`, outside
;;     the standard profile: K returns Unsupported at that site.

;; ======================================================================
;; DEFINITIONAL EQUALITY — `is_def_eq_core(t, s)` (l. 1171), in EXACTLY
;; this order (the order is observable through budgets and caches):
;;   0. quick_is_def_eq (l. 835): pointer/structural equality or a cached
;;      success → true; same kind and Lam/Pi → is_def_eq_binding (domains
;;      then bodies under a shared FVar, l. 785); Sort → level
;;      is_equivalent; Lit → literal equality; else undecided.
;;   1. `s` is `Bool.true` and `t` closed (or eager): if whnf(t) is
;;      Bool.true → true (the `decide` path, l. 1180).
;;   2. t_n := whnf_core(t, cheap_proj=true), s_n likewise; if either
;;      changed, quick_is_def_eq again.
;;   3. is_def_eq_proof_irrel (l. 932): if t_n's type is a proposition,
;;      the answer is whether the two TYPES are def-eq.
;;   4. lazy_delta_reduction (l. 1088), a loop: is_def_eq_offset (both
;;      `Nat.zero`/0 → true; both `succ`/positive literals → recurse on
;;      predecessors); if no FVars (or eager) reduce_nat on either side
;;      and recurse; reduce_native on either side and recurse; then one
;;      lazy_delta_reduction_step (l. 999): neither side delta → stop
;;      undecided; one side delta → unfold it (unless the OTHER side is
;;      a projection application that whnf_core can reduce — reduce that
;;      instead, l. 1010); both delta → compare ReducibilityHints:
;;      unfold the greater height (abbrev counts as greatest, opaque as
;;      least); equal heights of the SAME regular constant with
;;      arguments → try levels + argument-wise equality first (cached
;;      failure prevents retry); else unfold both; then quick_is_def_eq
;;      decides or the loop continues.
;;   5. same Const name with def-eq levels → true; same FVar → true.
;;   6. Proj with the same struct and index → lazy_delta_proj_reduction
;;      (l. 1123) on the struct terms, falling back to reducing both
;;      projections; true if that succeeds.
;;   7. whnf_core with full projection reduction; if changed, recurse.
;;   8. is_def_eq_app (l. 911): same-length applications with def-eq
;;      heads and def-eq arguments pairwise.
;;   9. try_eta_expansion (l. 874), both directions: `fun x => b` vs `s`
;;      where s's whnf'd type is a Pi ⇒ compare with `fun x => s x`.
;;  10. try_eta_struct (l. 889), both directions: s = `mk a_1 … a_n` of a
;;      non-recursive structure with nparams+nfields args, types def-eq,
;;      and each `Proj i t` def-eq `a_i`.
;;  11. try_string_lit_expansion (l. 1145), both directions: a string
;;      literal against a `String.ofList …` application ⇒ compare the
;;      literal's expansion.
;;  12. is_def_eq_unit_like (l. 1159): t's type whnf's to a non-recursive
;;      structure with a zero-field constructor and the types are def-eq
;;      ⇒ true.
;;  13. false. Successes are cached symmetrically (l. 1248).
;;
;; String literal expansion (inductive.cpp l. 1368, at v4.33.1):
;;   "…" ⇒ String.ofList (List.cons.{0} Char (Char.ofNat c₁)
;;                          (… (List.nil.{0} Char)))
;;   over the UTF-8-decoded scalar values c_i as Nat literals. The head
;;   is `String.ofList` (g_string_mk, inductive.cpp l. 1394) — the
;;   logical String is `String.ofByteArray` (v3/INVENTORY.md); the
;;   kernel's literal rule goes through `ofList`, whose body relates
;;   the two. Exactness means K expands to this term, not to `String.mk`.

;; ======================================================================
;; THE FUNCTIONS (phase 1) — expr.cpp / instantiate.cpp / abstract.cpp.
;; De Bruijn discipline: `instantiate` and `abstract` are the pin's
;; (instantiate.cpp l. 15/99, abstract.cpp l. 14); the loose-bvar range is
;; recomputed rather than cached (a measured optimization point for T0).

;; ---- predicates ----------------------------------------------------------

(fn is_sort ((e Expr)) Bool (match e ((Sort _) True) (_ False)))
(fn is_pi ((e Expr)) Bool (match e ((Pi _ _ _ _) True) (_ False)))
(fn is_lambda ((e Expr)) Bool (match e ((Lam _ _ _ _) True) (_ False)))
(fn is_let ((e Expr)) Bool (match e ((Let _ _ _ _) True) (_ False)))
(fn is_app ((e Expr)) Bool (match e ((App _ _) True) (_ False)))
(fn is_const ((e Expr)) Bool (match e ((Const _ _) True) (_ False)))
(fn is_fvar ((e Expr)) Bool (match e ((FVar _) True) (_ False)))
(fn is_bvar ((e Expr)) Bool (match e ((BVar _) True) (_ False)))
(fn is_lit ((e Expr)) Bool (match e ((Lit _) True) (_ False)))
(fn is_proj ((e Expr)) Bool (match e ((Proj _ _ _) True) (_ False)))
(fn is_nat_lit ((e Expr)) Bool (match e ((Lit (LitNat _)) True) (_ False)))
(fn is_string_lit ((e Expr)) Bool (match e ((Lit (LitStr _)) True) (_ False)))
(fn is_const_named ((e Expr) (n Name)) Bool (match e ((Const c _) (name_eq c n)) (_ False)))

(fn lit_eq ((a Literal) (b Literal)) Bool
  (match a
    ((LitNat x) (match b ((LitNat y) (int_eq x y)) (_ False)))
    ((LitStr x) (match b ((LitStr y) (int_list_eq x y)) (_ False)))))

;; structural equality (expr.cpp `is_equal`): binder names and binder
;; info are NOT compared; levels structurally (level_eq)
(fn expr_eq ((a Expr) (b Expr)) Bool
  (measure (struct a))
  (match a
    ((BVar i) (match b ((BVar j) (int_eq i j)) (_ False)))
    ((FVar i) (match b ((FVar j) (int_eq i j)) (_ False)))
    ((Sort u) (match b ((Sort v) (level_eq u v)) (_ False)))
    ((Const n ls) (match b ((Const m ms) (if (name_eq n m) (levels_eq ls ms) False)) (_ False)))
    ((App f x) (match b ((App g y) (if (expr_eq f g) (expr_eq x y) False)) (_ False)))
    ((Lam _ _ d1 b1) (match b ((Lam _ _ d2 b2) (if (expr_eq d1 d2) (expr_eq b1 b2) False)) (_ False)))
    ((Pi _ _ d1 b1) (match b ((Pi _ _ d2 b2) (if (expr_eq d1 d2) (expr_eq b1 b2) False)) (_ False)))
    ((Let _ t1 v1 b1)
     (match b ((Let _ t2 v2 b2) (if (expr_eq t1 t2) (if (expr_eq v1 v2) (expr_eq b1 b2) False) False)) (_ False)))
    ((Lit l1) (match b ((Lit l2) (lit_eq l1 l2)) (_ False)))
    ((Proj s1 i1 e1) (match b ((Proj s2 i2 e2) (if (name_eq s1 s2) (if (int_eq i1 i2) (expr_eq e1 e2) False) False)) (_ False)))))

(fn exprs_eq ((a (List Expr)) (b (List Expr))) Bool
  (measure (struct a))
  (match a
    (Nil (match b (Nil True) (_ False)))
    ((Cons x ar) (match b (Nil False) ((Cons y br) (if (expr_eq x y) (exprs_eq ar br) False))))))

;; ---- loose bound variables ---------------------------------------------

;; get_loose_bvar_range: 0 for a closed term, else 1 + the largest loose index
(fn loose_bvar_range ((e Expr)) Int
  (measure (struct e))
  (match e
    ((BVar i) (+ i 1))
    ((App f a) (max_int (loose_bvar_range f) (loose_bvar_range a)))
    ((Lam _ _ d b) (max_int (loose_bvar_range d) (- (loose_bvar_range b) 1)))
    ((Pi _ _ d b) (max_int (loose_bvar_range d) (- (loose_bvar_range b) 1)))
    ((Let _ t v b) (max_int (max_int (loose_bvar_range t) (loose_bvar_range v)) (- (loose_bvar_range b) 1)))
    ((Proj _ _ x) (loose_bvar_range x))
    (_ 0)))

(fn has_loose_bvars ((e Expr)) Bool (lt 0 (loose_bvar_range e)))

;; has_loose_bvar(e, i): does the loose index i occur?
(fn has_loose_bvar ((e Expr) (i Int)) Bool
  (measure (struct e))
  (match e
    ((BVar j) (int_eq i j))
    ((App f a) (bool_or (has_loose_bvar f i) (has_loose_bvar a i)))
    ((Lam _ _ d b) (bool_or (has_loose_bvar d i) (has_loose_bvar b (+ i 1))))
    ((Pi _ _ d b) (bool_or (has_loose_bvar d i) (has_loose_bvar b (+ i 1))))
    ((Let _ t v b) (bool_or (bool_or (has_loose_bvar t i) (has_loose_bvar v i)) (has_loose_bvar b (+ i 1))))
    ((Proj _ _ x) (has_loose_bvar x i))
    (_ False)))

;; lift_loose_bvars(e, s, d): every loose index ≥ s becomes index + d
(fn lift_loose_bvars ((e Expr) (s Int) (d Int)) Expr
  (measure (struct e))
  (if (int_eq d 0) e
  (match e
    ((BVar i) (if (le s i) (BVar (+ i d)) e))
    ((App f a) (App (lift_loose_bvars f s d) (lift_loose_bvars a s d)))
    ((Lam n bi t b) (Lam n bi (lift_loose_bvars t s d) (lift_loose_bvars b (+ s 1) d)))
    ((Pi n bi t b) (Pi n bi (lift_loose_bvars t s d) (lift_loose_bvars b (+ s 1) d)))
    ((Let n t v b) (Let n (lift_loose_bvars t s d) (lift_loose_bvars v s d) (lift_loose_bvars b (+ s 1) d)))
    ((Proj sn i x) (Proj sn i (lift_loose_bvars x s d)))
    (_ e))))

;; lower_loose_bvars(e, s, d): every loose index ≥ s becomes index − d
;; (precondition: no loose index in [s−d, s))
(fn lower_loose_bvars ((e Expr) (s Int) (d Int)) Expr
  (measure (struct e))
  (match e
    ((BVar i) (if (le s i) (BVar (- i d)) e))
    ((App f a) (App (lower_loose_bvars f s d) (lower_loose_bvars a s d)))
    ((Lam n bi t b) (Lam n bi (lower_loose_bvars t s d) (lower_loose_bvars b (+ s 1) d)))
    ((Pi n bi t b) (Pi n bi (lower_loose_bvars t s d) (lower_loose_bvars b (+ s 1) d)))
    ((Let n t v b) (Let n (lower_loose_bvars t s d) (lower_loose_bvars v s d) (lower_loose_bvars b (+ s 1) d)))
    ((Proj sn i x) (Proj sn i (lower_loose_bvars x s d)))
    (_ e)))

;; instantiate(e, s, subst) (instantiate.cpp l. 15): under `offset`
;; binders, a loose bvar with index vidx ≥ s+offset becomes
;;   subst[vidx − (s+offset)] lifted by offset   if vidx < s+offset+n
;;   BVar (vidx − n)                              otherwise
(fn instantiate_go ((e Expr) (s Int) (subst (List Expr)) (n Int) (offset Int)) Expr
  (measure (struct e))
  (match e
    ((BVar i)
     (let ((s1 (+ s offset)))
       (if (lt i s1) e
       (if (lt i (+ s1 n))
         (match (nth subst (- i s1)) ((Some v) (lift_loose_bvars v 0 offset)) (None e))
         (BVar (- i n))))))
    ((App f a) (App (instantiate_go f s subst n offset) (instantiate_go a s subst n offset)))
    ((Lam nm bi t b) (Lam nm bi (instantiate_go t s subst n offset) (instantiate_go b s subst n (+ offset 1))))
    ((Pi nm bi t b) (Pi nm bi (instantiate_go t s subst n offset) (instantiate_go b s subst n (+ offset 1))))
    ((Let nm t v b)
     (Let nm (instantiate_go t s subst n offset) (instantiate_go v s subst n offset) (instantiate_go b s subst n (+ offset 1))))
    ((Proj sn i x) (Proj sn i (instantiate_go x s subst n offset)))
    (_ e)))

(fn instantiate_n ((e Expr) (s Int) (subst (List Expr))) Expr
  (let ((n (len subst)))
    (if (int_eq n 0) e
      ;; the pin skips closed terms by a cached range; here the range is a
      ;; second O(n) walk, so only the s > 0 case (rare) pays for it
      (if (bool_and (lt 0 s) (le (loose_bvar_range e) s)) e
        (instantiate_go e s subst n 0)))))

;; instantiate(e, v): BVar 0 := v
(fn instantiate1 ((e Expr) (v Expr)) Expr (instantiate_n e 0 (Cons v Nil)))

;; instantiate_rev(e, subst) (l. 99): subst given in BINDER order — the
;; LAST element replaces BVar 0 (the innermost binder). Implemented by
;; reversing and using `instantiate_n` at s = 0.
(fn instantiate_rev ((e Expr) (subst (List Expr))) Expr
  (match subst (Nil e) (_ (instantiate_n e 0 (rev subst)))))

;; abstract(e, fvars) (abstract.cpp l. 14): fvars in binder order; the
;; i-th fvar becomes BVar (offset + n − i − 1)
(fn abstract_go ((e Expr) (ids (List Int)) (n Int) (offset Int)) Expr
  (measure (struct e))
  (match e
    ((FVar id)
     (match (index_of_int id ids 0)
       ((Some i) (BVar (- (+ offset n) (+ i 1))))
       (None e)))
    ((App f a) (App (abstract_go f ids n offset) (abstract_go a ids n offset)))
    ((Lam nm bi t b) (Lam nm bi (abstract_go t ids n offset) (abstract_go b ids n (+ offset 1))))
    ((Pi nm bi t b) (Pi nm bi (abstract_go t ids n offset) (abstract_go b ids n (+ offset 1))))
    ((Let nm t v b) (Let nm (abstract_go t ids n offset) (abstract_go v ids n offset) (abstract_go b ids n (+ offset 1))))
    ((Proj sn i x) (Proj sn i (abstract_go x ids n offset)))
    (_ e)))

(fn index_of_int ((x Int) (xs (List Int)) (i Int)) (Option Int)
  (measure (struct xs))
  (match xs
    (Nil None)
    ((Cons y r) (if (int_eq x y) (Some i) (index_of_int x r (+ i 1))))))

(fn abstract_fvars ((e Expr) (ids (List Int))) Expr
  (if (has_fvar e) (abstract_go e ids (len ids) 0) e))

(fn has_fvar ((e Expr)) Bool
  (measure (struct e))
  (match e
    ((FVar _) True)
    ((App f a) (bool_or (has_fvar f) (has_fvar a)))
    ((Lam _ _ d b) (bool_or (has_fvar d) (has_fvar b)))
    ((Pi _ _ d b) (bool_or (has_fvar d) (has_fvar b)))
    ((Let _ t v b) (bool_or (bool_or (has_fvar t) (has_fvar v)) (has_fvar b)))
    ((Proj _ _ x) (has_fvar x))
    (_ False)))

;; ---- application spines ---------------------------------------------------

(fn get_app_fn ((e Expr)) Expr
  (measure (struct e))
  (match e ((App f _) (get_app_fn f)) (_ e)))

(fn get_app_args_go ((e Expr) (acc (List Expr))) (List Expr)
  (measure (struct e))
  (match e ((App f a) (get_app_args_go f (Cons a acc))) (_ acc)))

;; the arguments in order (leftmost first)
(fn get_app_args ((e Expr)) (List Expr) (get_app_args_go e Nil))

(fn get_app_num_args ((e Expr)) Int
  (measure (struct e))
  (match e ((App f _) (+ 1 (get_app_num_args f))) (_ 0)))

(fn mk_app_list ((f Expr) (args (List Expr))) Expr
  (measure (struct args))
  (match args (Nil f) ((Cons a r) (mk_app_list (App f a) r))))

;; ---- universe parameters in terms ----------------------------------------

(fn expr_inst_lparams ((e Expr) (ps (List Name)) (ls (List Level))) Expr
  (measure (struct e))
  (match e
    ((Sort u) (Sort (level_inst u ps ls)))
    ((Const n us) (Const n (levels_inst us ps ls)))
    ((App f a) (App (expr_inst_lparams f ps ls) (expr_inst_lparams a ps ls)))
    ((Lam nm bi t b) (Lam nm bi (expr_inst_lparams t ps ls) (expr_inst_lparams b ps ls)))
    ((Pi nm bi t b) (Pi nm bi (expr_inst_lparams t ps ls) (expr_inst_lparams b ps ls)))
    ((Let nm t v b) (Let nm (expr_inst_lparams t ps ls) (expr_inst_lparams v ps ls) (expr_inst_lparams b ps ls)))
    ((Proj sn i x) (Proj sn i (expr_inst_lparams x ps ls)))
    (_ e)))

;; ---- beta ----------------------------------------------------------------------

;; cheap_beta_reduce (instantiate.cpp l. 211): strip as many lambdas as
;; there are arguments; if the remaining body has no loose bvars, drop the
;; consumed arguments; if it is a bare BVar, select that argument; else
;; leave the term alone.
(fn cheap_beta_reduce ((e Expr)) Expr
  (match e
    ((App _ _)
     (let ((fn (get_app_fn e)) (args (get_app_args e)))
       (if (is_lambda fn)
         (match (strip_lambdas fn (len args) 0)
           ((Pair body i)
            (if (bool_not (has_loose_bvars body)) (mk_app_list body (drop i args))
            (match body
              ((BVar k) (match (nth args (- (- i k) 1))
                          ((Some a) (mk_app_list a (drop i args)))
                          (None e)))
              (_ e)))))
         e)))
    (_ e)))

;; strip up to n lambdas; returns (body, number stripped)
(fn strip_lambdas ((f Expr) (n Int) (i Int)) (Pair Expr Int)
  (measure (struct f))
  (match f
    ((Lam _ _ _ b) (if (lt i n) (strip_lambdas b n (+ i 1)) (Pair f i)))
    (_ (Pair f i))))

;; beta-reduce the head with all available arguments at once (the App case
;; of whnf_core, type_checker.cpp l. 517–524): consume min(#lambdas, #args)
(fn beta_head ((f Expr) (args (List Expr))) Expr
  (match (strip_lambdas f (len args) 0)
    ((Pair body m)
     (mk_app_list (instantiate_n body 0 (rev (take m args))) (drop m args)))))

;; ---- rendering (diagnostics, tests) ----------------------------------------

(fn show_expr ((e Expr)) (List Int)
  (measure (struct e))
  (match e
    ((BVar i) (append "#" (show_nat i)))
    ((FVar i) (append "?f" (show_nat i)))
    ((Sort u) (append "(Sort " (append (show_level u) ")")))
    ((Const n Nil) (show_name n))
    ((Const n ls) (append (show_name n) (append ".{" (append (show_levels ls) "}"))))
    ((App f a) (append "(" (append (show_expr f) (append " " (append (show_expr a) ")")))))
    ((Lam n _ d b)
     (append "(fun (" (append (chars_of_name_last n) (append " : " (append (show_expr d) (append ") => " (append (show_expr b) ")")))))))
    ((Pi n _ d b)
     (append "((" (append (chars_of_name_last n) (append " : " (append (show_expr d) (append ") -> " (append (show_expr b) ")")))))))
    ((Let n t v b)
     (append "(let " (append (chars_of_name_last n) (append " : " (append (show_expr t) (append " := " (append (show_expr v) (append "; " (append (show_expr b) ")")))))))))
    ((Lit (LitNat k)) (show_nat k))
    ((Lit (LitStr s)) (append "\"" (append s "\"")))
    ((Proj s i x) (append (show_expr x) (append "." (show_nat i))))))

(fn show_levels ((ls (List Level))) (List Int)
  (measure (struct ls))
  (match ls
    (Nil "")
    ((Cons l Nil) (show_level l))
    ((Cons l r) (append (show_level l) (append ", " (show_levels r))))))

(fn chars_of_name_last ((n Name)) (List Int)
  (match n ((Str _ s) (chars_of_sym s)) ((Num _ k) (show_nat k)) (Anon "_")))

;; ---- structural hashing (identity pins, memo tables) --------------------------------
;; A structural hash ignoring binder names and binder infos (like expr_eq),
;; bounded by the prime M = 2^61 − 1. Not a security hash: it fixes an
;; identity for the accelerator pins (FOUNDATION §3.2) and keys caches.

(fn hash_m () Int 2305843009213693951)
(fn mix ((a Int) (b Int)) Int (mod (+ (* a 1000003) (+ b 1)) (hash_m)))
(fn mix3 ((a Int) (b Int) (c Int)) Int (mix (mix a b) c))

(fn hash_bytes ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs (Nil acc) ((Cons b r) (hash_bytes r (mix acc b)))))

(fn hash_name ((n Name)) Int
  (measure (struct n))
  (match n
    (Anon 7)
    ((Str p s) (mix (hash_name p) (hash_bytes (chars_of_sym s) 5)))
    ((Num p k) (mix (hash_name p) (+ k 3)))))

(fn hash_level ((l Level)) Int
  (measure (struct l))
  (match l
    (LZero 11)
    ((LSucc x) (mix 13 (hash_level x)))
    ((LMax a b) (mix3 17 (hash_level a) (hash_level b)))
    ((LIMax a b) (mix3 19 (hash_level a) (hash_level b)))
    ((LParam n) (mix 23 (hash_name n)))))

(fn hash_levels ((ls (List Level)) (acc Int)) Int
  (measure (struct ls))
  (match ls (Nil acc) ((Cons l r) (hash_levels r (mix acc (hash_level l))))))

(fn hash_expr ((e Expr)) Int
  (measure (struct e))
  (match e
    ((BVar i) (mix 29 i))
    ((FVar i) (mix 31 i))
    ((Sort u) (mix 37 (hash_level u)))
    ((Const n ls) (mix3 41 (hash_name n) (hash_levels ls 1)))
    ((App f a) (mix3 43 (hash_expr f) (hash_expr a)))
    ((Lam _ _ d b) (mix3 47 (hash_expr d) (hash_expr b)))
    ((Pi _ _ d b) (mix3 53 (hash_expr d) (hash_expr b)))
    ((Let _ t v b) (mix3 59 (mix (hash_expr t) (hash_expr v)) (hash_expr b)))
    ((Lit (LitNat n)) (mix 61 n))
    ((Lit (LitStr s)) (mix 67 (hash_bytes s 1)))
    ((Proj s i x) (mix3 71 (mix (hash_name s) i) (hash_expr x)))))
