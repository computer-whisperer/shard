      Expr.size.eq_6 Expr.size.eq_7 Expr.size.eq_8 Expr.size.eq_9 Expr.size.eq_10 Expr.size.eq_11 h
      h_13 h_14 h_15)
    (arith only h_15 (farkas 1))))

(fn exprs_eq ((a (List Expr)) (b (List Expr))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (expr_eq x y) (exprs_eq ar br) false))))))

;; ---- the constants a term cites --------------------------------------------------
;; every Const name in the term (with repeats across distinct nodes; shared
;; identified nodes visited once); the axiom closure (axioms.shard) and the
;; identity closure of the accelerator pins (add.shard) are both over these edges.
;; The nodes seen are held by id with their hash: a node whose id stands there
;; under another hash is another node and is read (the loader reads an
;; elaborated body's constants with this, for a definition's height and a
;; requirement's key)
(fn used_consts ((e Expr) (seen (IntMap Int)) (acc (List Name))) (Prod (IntMap Int) (List Name))
  (measure (struct e))
  (let ((id (expr_id e)))
    (if
      (bool_and (< 0 id)
        (match (im_find seen id)
          ((some h) (= h (hash_expr e)))
          (none false)))
      (Prod.mk seen acc)
      (let ((seen1 (if (< 0 id) (im_insert seen id (hash_expr e)) seen)))
        (match e
          ((Const _ n _) (Prod.mk seen1 (cons n acc)))
          ((App _ f a)
           (match (used_consts f seen1 acc)
             ((Prod.mk s1 a1) (used_consts a s1 a1))))
          ((Lam _ _ _ t b)
           (match (used_consts t seen1 acc)
             ((Prod.mk s1 a1) (used_consts b s1 a1))))
          ((Pi _ _ _ t b)
           (match (used_consts t seen1 acc)
             ((Prod.mk s1 a1) (used_consts b s1 a1))))
          ((Let _ _ t v b)
           (match (used_consts t seen1 acc)
             ((Prod.mk s1 a1)
              (match (used_consts v s1 a1)
                ((Prod.mk s2 a2) (used_consts b s2 a2))))))
          ((Proj _ _ _ x) (used_consts x seen1 acc))
          (_ (Prod.mk seen1 acc)))))))

(fn expr_consts ((e Expr)) (List Name)
  (match (used_consts e IMEmpty nil)
    ((Prod.mk _ ns) ns)))

;; ---- loose bound variables ---------------------------------------------

;; has_loose_bvar(e, i): does the loose index i occur?
(fn has_loose_bvar ((e Expr) (i Int)) Bool
  (measure (struct e))
  (if (<= (loose_bvar_range e) i) false
  (match e
    ((BVar _ j) (= i j))
    ((App _ f a) (if (has_loose_bvar f i) true (has_loose_bvar a i)))
    ((Lam _ _ _ d b) (if (has_loose_bvar d i) true (has_loose_bvar b (+ i 1))))
    ((Pi _ _ _ d b) (if (has_loose_bvar d i) true (has_loose_bvar b (+ i 1))))
    ((Let _ _ t v b)
     (if (has_loose_bvar t i) true
     (if (has_loose_bvar v i) true
     (has_loose_bvar b (+ i 1)))))
    ((Proj _ _ _ x) (has_loose_bvar x i))
    (_ false))))

;; lift_loose_bvars(e, s, d): every loose index ≥ s becomes index + d;
;; a subterm whose range is ≤ s has no such index and is kept as it is
(fn lift_loose_bvars ((st St) (e Expr) (s Int) (d Int)) (Prod St Expr)
  (measure (struct e))
  (if (= d 0) (Prod.mk st e)
  (if (<= (loose_bvar_range e) s) (Prod.mk st e)
  (match e
    ((BVar _ i) (Prod.mk st (mk_bvar (+ i d))))
    ((App _ f a)
     (match (lift_loose_bvars st f s d)
       ((Prod.mk st1 f1)
        (match (lift_loose_bvars st1 a s d)
          ((Prod.mk st2 a1) (new_app st2 f1 a1))))))
    ((Lam _ n bi t b)
     (match (lift_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lift_loose_bvars st1 b (+ s 1) d)
          ((Prod.mk st2 b1) (new_lam st2 n bi t1 b1))))))
    ((Pi _ n bi t b)
     (match (lift_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lift_loose_bvars st1 b (+ s 1) d)
          ((Prod.mk st2 b1) (new_pi st2 n bi t1 b1))))))
    ((Let _ n t v b)
     (match (lift_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lift_loose_bvars st1 v s d)
          ((Prod.mk st2 v1)
           (match (lift_loose_bvars st2 b (+ s 1) d)
             ((Prod.mk st3 b1) (new_let st3 n t1 v1 b1))))))))
    ((Proj _ sn i x)
     (match (lift_loose_bvars st x s d)
       ((Prod.mk st1 x1) (new_proj st1 sn i x1))))
    (_ (Prod.mk st e))))))

;; lower_loose_bvars(e, s, d): every loose index ≥ s becomes index − d
;; (precondition: no loose index in [s−d, s))
(fn lower_loose_bvars ((st St) (e Expr) (s Int) (d Int)) (Prod St Expr)
  (measure (struct e))
  (if (<= (loose_bvar_range e) s) (Prod.mk st e)
  (match e
    ((BVar _ i) (Prod.mk st (mk_bvar (- i d))))
    ((App _ f a)
     (match (lower_loose_bvars st f s d)
       ((Prod.mk st1 f1)
        (match (lower_loose_bvars st1 a s d)
          ((Prod.mk st2 a1) (new_app st2 f1 a1))))))
    ((Lam _ n bi t b)
     (match (lower_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lower_loose_bvars st1 b (+ s 1) d)
          ((Prod.mk st2 b1) (new_lam st2 n bi t1 b1))))))
    ((Pi _ n bi t b)
     (match (lower_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lower_loose_bvars st1 b (+ s 1) d)
          ((Prod.mk st2 b1) (new_pi st2 n bi t1 b1))))))
    ((Let _ n t v b)
     (match (lower_loose_bvars st t s d)
       ((Prod.mk st1 t1)
        (match (lower_loose_bvars st1 v s d)
          ((Prod.mk st2 v1)
           (match (lower_loose_bvars st2 b (+ s 1) d)
             ((Prod.mk st3 b1) (new_let st3 n t1 v1 b1))))))))
    ((Proj _ sn i x)
     (match (lower_loose_bvars st x s d)
       ((Prod.mk st1 x1) (new_proj st1 sn i x1))))
    (_ (Prod.mk st e)))))

;; instantiate(e, s, subst) (instantiate.cpp l. 15): under `offset`
;; binders, a loose bvar with index vidx ≥ s+offset becomes
;;   subst[vidx − (s+offset)] lifted by offset   if vidx < s+offset+n
;;   BVar (vidx − n)                              otherwise
;; A subterm with range ≤ s+offset has no such index and is kept as it is
;; (the pin's `s1 >= get_loose_bvar_range(m)` return).
(fn instantiate_go ((st St) (e Expr) (s Int) (subst (List Expr)) (n Int) (offset Int))
  (Prod St Expr)
  (measure (struct e))
  (let ((s1 (+ s offset)))
    (if (<= (loose_bvar_range e) s1) (Prod.mk st e)
    (match e
      ((BVar _ i)
       (if (< i (+ s1 n))
         (match (nth subst (- i s1))
           ((some v) (lift_loose_bvars st v 0 offset))
           (none (Prod.mk st e)))
         (Prod.mk st (mk_bvar (- i n)))))
      ((App _ f a)
       (match (instantiate_go st f s subst n offset)
         ((Prod.mk st1 f1)
          (match (instantiate_go st1 a s subst n offset)
            ((Prod.mk st2 a1) (new_app st2 f1 a1))))))
      ((Lam _ nm bi t b)
       (match (instantiate_go st t s subst n offset)
         ((Prod.mk st1 t1)
          (match (instantiate_go st1 b s subst n (+ offset 1))
            ((Prod.mk st2 b1) (new_lam st2 nm bi t1 b1))))))
      ((Pi _ nm bi t b)
       (match (instantiate_go st t s subst n offset)
         ((Prod.mk st1 t1)
          (match (instantiate_go st1 b s subst n (+ offset 1))
            ((Prod.mk st2 b1) (new_pi st2 nm bi t1 b1))))))
      ((Let _ nm t v b)
       (match (instantiate_go st t s subst n offset)
         ((Prod.mk st1 t1)
          (match (instantiate_go st1 v s subst n offset)
            ((Prod.mk st2 v1)
             (match (instantiate_go st2 b s subst n (+ offset 1))
               ((Prod.mk st3 b1) (new_let st3 nm t1 v1 b1))))))))
      ((Proj _ sn i x)
       (match (instantiate_go st x s subst n offset)
         ((Prod.mk st1 x1) (new_proj st1 sn i x1))))
      (_ (Prod.mk st e))))))

(fn instantiate_n ((st St) (e Expr) (s Int) (subst (List Expr))) (Prod St Expr)
  (let ((n (len subst)))
    (if (= n 0) (Prod.mk st e)
    (if (<= (loose_bvar_range e) s) (Prod.mk st e)
    (instantiate_go st e s subst n 0)))))

;; instantiate(e, v): BVar 0 := v
(fn instantiate1 ((st St) (e Expr) (v Expr)) (Prod St Expr) (instantiate_n st e 0 (cons v nil)))

;; instantiate_rev(e, subst) (l. 99): subst given in BINDER order — the
;; LAST element replaces BVar 0 (the innermost binder). Implemented by
;; reversing and using `instantiate_n` at s = 0.
(fn instantiate_rev ((st St) (e Expr) (subst (List Expr))) (Prod St Expr)
  (match subst
    (nil (Prod.mk st e))
    (_ (instantiate_n st e 0 (rev subst)))))

;; abstract(e, fvars) (abstract.cpp l. 14): fvars in binder order; the
;; i-th fvar becomes BVar (offset + n − i − 1). A subterm without fvars is
;; kept; a rebuilt node whose children did not change is kept too (the
;; pin's `update_*` identity preservation).
(fn abstract_go ((st St) (e Expr) (ids (List Int)) (n Int) (offset Int)) (Prod St Expr)
  (measure (struct e))
  (if (bool_not (has_fvar e)) (Prod.mk st e)
  (match e
    ((FVar _ id)
     (match (index_of_int id ids 0)
       ((some i) (Prod.mk st (mk_bvar (- (+ offset n) (+ i 1)))))
       (none (Prod.mk st e))))
    ((App _ f a)
     (match (abstract_go st f ids n offset)
       ((Prod.mk st1 f1)
        (match (abstract_go st1 a ids n offset)
          ((Prod.mk st2 a1)
           (if (same_node f f1) (if (same_node a a1) (Prod.mk st2 e) (new_app st2 f1 a1))
           (new_app st2 f1 a1)))))))
    ((Lam _ nm bi t b)
     (match (abstract_go st t ids n offset)
       ((Prod.mk st1 t1)
        (match (abstract_go st1 b ids n (+ offset 1))
          ((Prod.mk st2 b1)
           (if (same_node t t1) (if (same_node b b1) (Prod.mk st2 e) (new_lam st2 nm bi t1 b1))
           (new_lam st2 nm bi t1 b1)))))))
    ((Pi _ nm bi t b)
     (match (abstract_go st t ids n offset)
       ((Prod.mk st1 t1)
        (match (abstract_go st1 b ids n (+ offset 1))
          ((Prod.mk st2 b1)
           (if (same_node t t1) (if (same_node b b1) (Prod.mk st2 e) (new_pi st2 nm bi t1 b1))
           (new_pi st2 nm bi t1 b1)))))))
    ((Let _ nm t v b)
     (match (abstract_go st t ids n offset)
       ((Prod.mk st1 t1)
        (match (abstract_go st1 v ids n offset)
          ((Prod.mk st2 v1)
           (match (abstract_go st2 b ids n (+ offset 1))
             ((Prod.mk st3 b1)
              (if (same_node t t1)
                (if (same_node v v1) (if (same_node b b1) (Prod.mk st3 e) (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1)))))))))
    ((Proj _ sn i x)
     (match (abstract_go st x ids n offset)
       ((Prod.mk st1 x1) (if (same_node x x1) (Prod.mk st1 e) (new_proj st1 sn i x1)))))
    (_ (Prod.mk st e)))))

(fn index_of_int ((x Int) (xs (List Int)) (i Int)) (Option Int)
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons y r) (if (= x y) (some i) (index_of_int x r (+ i 1))))))

(fn abstract_fvars ((st St) (e Expr) (ids (List Int))) (Prod St Expr)
  (if (has_fvar e) (abstract_go st e ids (len ids) 0) (Prod.mk st e)))

;; ---- application spines ---------------------------------------------------

(fn get_app_fn ((e Expr)) Expr
  (measure (struct e))
  (match e
    ((App _ f _) (get_app_fn f))
    (_ e)))

(fn get_app_args_go ((e Expr) (acc (List Expr))) (List Expr)
  (measure (struct e))
  (match e
    ((App _ f a) (get_app_args_go f (cons a acc)))
    (_ acc)))

;; the arguments in order (leftmost first)
(fn get_app_args ((e Expr)) (List Expr) (get_app_args_go e nil))

;; What a function that walks a term by its spine descends by. A list of terms weighs each
;; term's size and one (`exprs_weight`); a term's head and its arguments together weigh what
;; the term does (`get_app_args_go_weight`). So the arguments weigh less than the term
;; (`get_app_args_lt`), each of the first two is smaller than it (`app_arg_lt`, `app_arg2_lt`),
;; and the head is never the larger (`get_app_fn_le`), smaller under an application
;; (`get_app_fn_lt`)
(def exprs_weight ((xs (List Expr))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons x r) (+ (+ (Expr.size x) (exprs_weight r)) 1))))
(theorem expr_size_pos ((e Expr)) (< 0 (Expr.size e))
  (by
    (cases e
      ((BVar (d i) (rw Expr.size.eq_1) (arith))
       (FVar (d i) (rw Expr.size.eq_2) (arith))
       (Sort (d u) (rw Expr.size.eq_3) (arith))
       (Const (d n ls) (rw Expr.size.eq_4) (arith))
       (App (d f a) (rw Expr.size.eq_5) (arith))
       (Lam (d n bi dm b) (rw Expr.size.eq_6) (arith))
       (Pi (d n bi dm b) (rw Expr.size.eq_7) (arith))
       (Let (d n ty v b) (rw Expr.size.eq_8) (arith))
       (Lit (d l) (rw Expr.size.eq_9) (arith))
       (Proj (d sn i x) (rw Expr.size.eq_10) (arith))
       (MVar (d i) (rw Expr.size.eq_11) (arith))))))
(theorem get_app_fn_le ((e Expr)) (<= (Expr.size (get_app_fn e)) (Expr.size e))
  (by
    (induction e
      ((BVar (d i) (unfold get_app_fn) (arith))
       (FVar (d i) (unfold get_app_fn) (arith))
       (Sort (d u) (unfold get_app_fn) (arith))
       (Const (d n ls) (unfold get_app_fn) (arith))
       (App (d f a ihf iha) (unfold get_app_fn) (rw Expr.size.eq_5) (arith))
       (Lam (d n bi dm b ihd ihb) (unfold get_app_fn) (arith))
       (Pi (d n bi dm b ihd ihb) (unfold get_app_fn) (arith))
       (Let (d n ty v b iht ihv ihb) (unfold get_app_fn) (arith))
       (Lit (d l) (unfold get_app_fn) (arith))
       (Proj (d sn i x ih) (unfold get_app_fn) (arith))
       (MVar (d i) (unfold get_app_fn) (arith))))))
(theorem get_app_fn_lt ((d D) (f Expr) (a Expr))
  (< (Expr.size (get_app_fn (App d f a))) (Expr.size (App d f a)))
  (by (unfold get_app_fn) (rw Expr.size.eq_5) (arith (get_app_fn_le f))))
(theorem get_app_args_go_weight ((e Expr))
  (forall ((acc (List Expr)))
    (= (+ (Expr.size (get_app_fn e)) (exprs_weight (get_app_args_go e acc)))
      (+ (Expr.size e) (exprs_weight acc))))
  (by
    (induction e
      ((BVar (d i) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (FVar (d i) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Sort (d u) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Const (d n ls) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (App (d f a ihf iha) (intro acc) (unfold get_app_fn get_app_args_go) (rw (ihf (cons a acc)))
         (rw exprs_weight.eq_2)
         (rw Expr.size.eq_5)
         (arith))
       (Lam (d n bi dm b ihd ihb) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Pi (d n bi dm b ihd ihb) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Let (d n ty v b iht ihv ihb) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Lit (d l) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (Proj (d sn i x ih) (intro acc) (unfold get_app_fn get_app_args_go) rfl)
       (MVar (d i) (intro acc) (unfold get_app_fn get_app_args_go) rfl)))))
(theorem get_app_args_lt ((e Expr)) (< (exprs_weight (get_app_args e)) (Expr.size e))
  (by
    (unfold get_app_args)
    (arith (get_app_args_go_weight e nil) (expr_size_pos (get_app_fn e)) exprs_weight.eq_1)))
(theorem app_arg_lt ((t Expr) (a Expr) (r (List Expr)) (h (= (get_app_args t) (cons a r))))
  (< (Expr.size a) (Expr.size t))
  (by
    (have w (< (exprs_weight (cons a r)) (Expr.size t)) (rw (<- h)) (exact (get_app_args_lt t)))
    (arith (exprs_weight.eq_2 a r))))
(theorem app_arg2_lt
  ((t Expr) (a Expr) (b Expr) (r (List Expr)) (h (= (get_app_args t) (cons a (cons b r)))))
  (< (Expr.size b) (Expr.size t))
  (by
    (have w (< (exprs_weight (cons a (cons b r))) (Expr.size t))
      (rw (<- h))
      (exact (get_app_args_lt t)))
    (arith (exprs_weight.eq_2 a (cons b r)) (exprs_weight.eq_2 b r))))

(fn get_app_num_args ((e Expr)) Int
  (measure (struct e))
  (match e
    ((App _ f _) (+ 1 (get_app_num_args f)))
    (_ 0)))

(fn mk_app_list ((st St) (f Expr) (args (List Expr))) (Prod St Expr)
  (measure (struct args))
  (match args
    (nil (Prod.mk st f))
    ((cons a r)
     (match (new_app st f a)
       ((Prod.mk st1 fa) (mk_app_list st1 fa r))))))

;; ---- universe parameters in terms ----------------------------------------

;; instantiate_lparams (instantiate.cpp l. 236): a subterm without level
;; parameters is kept as it is; a rebuilt node whose children did not
;; change is kept too
(fn expr_inst_lparams ((st St) (e Expr) (ps (List Name)) (ls (List Level))) (Prod St Expr)
  (measure (struct e))
  (if (bool_not (has_lparam e)) (Prod.mk st e)
  (match e
    ((Sort _ u) (Prod.mk st (mk_sort (level_inst u ps ls))))
    ((Const _ n us) (Prod.mk st (mk_const n (levels_inst us ps ls))))
    ((App _ f a)
     (match (expr_inst_lparams st f ps ls)
       ((Prod.mk st1 f1)
        (match (expr_inst_lparams st1 a ps ls)
          ((Prod.mk st2 a1)
           (if (same_node f f1) (if (same_node a a1) (Prod.mk st2 e) (new_app st2 f1 a1))
           (new_app st2 f1 a1)))))))
    ((Lam _ nm bi t b)
     (match (expr_inst_lparams st t ps ls)
       ((Prod.mk st1 t1)
        (match (expr_inst_lparams st1 b ps ls)
          ((Prod.mk st2 b1)
           (if (same_node t t1) (if (same_node b b1) (Prod.mk st2 e) (new_lam st2 nm bi t1 b1))
           (new_lam st2 nm bi t1 b1)))))))
    ((Pi _ nm bi t b)
     (match (expr_inst_lparams st t ps ls)
       ((Prod.mk st1 t1)
        (match (expr_inst_lparams st1 b ps ls)
          ((Prod.mk st2 b1)
           (if (same_node t t1) (if (same_node b b1) (Prod.mk st2 e) (new_pi st2 nm bi t1 b1))
           (new_pi st2 nm bi t1 b1)))))))
    ((Let _ nm t v b)
     (match (expr_inst_lparams st t ps ls)
       ((Prod.mk st1 t1)
        (match (expr_inst_lparams st1 v ps ls)
          ((Prod.mk st2 v1)
           (match (expr_inst_lparams st2 b ps ls)
             ((Prod.mk st3 b1)
              (if (same_node t t1)
                (if (same_node v v1) (if (same_node b b1) (Prod.mk st3 e) (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1))
                (new_let st3 nm t1 v1 b1)))))))))
    ((Proj _ sn i x)
     (match (expr_inst_lparams st x ps ls)
       ((Prod.mk st1 x1) (if (same_node x x1) (Prod.mk st1 e) (new_proj st1 sn i x1)))))
    (_ (Prod.mk st e)))))

;; ---- beta ----------------------------------------------------------------------

;; cheap_beta_reduce (instantiate.cpp l. 211): strip as many lambdas as
;; there are arguments; if the remaining body has no loose bvars, drop the
;; consumed arguments; if it is a bare BVar, select that argument; else
;; leave the term alone.
(fn cheap_beta_reduce ((st St) (e Expr)) (Prod St Expr)
  (match e
    ((App _ _ _)
     (let ((fn (get_app_fn e)) (args (get_app_args e)))
       (if (is_lambda fn)
         (match (strip_lambdas fn (len args) 0)
           ((Prod.mk body i)
            (if (bool_not (has_loose_bvars body)) (mk_app_list st body (drop i args))
            (match body
              ((BVar _ k)
               (match (nth args (- (- i k) 1))
                 ((some a) (mk_app_list st a (drop i args)))
                 (none (Prod.mk st e))))
              (_ (Prod.mk st e))))))
         (Prod.mk st e))))
    (_ (Prod.mk st e))))

;; strip up to n lambdas; returns (body, number stripped)
(fn strip_lambdas ((f Expr) (n Int) (i Int)) (Prod Expr Int)
  (measure (struct f))
  (match f
    ((Lam _ _ _ _ b) (if (< i n) (strip_lambdas b n (+ i 1)) (Prod.mk f i)))
    (_ (Prod.mk f i))))

;; beta-reduce the head with all available arguments at once (the App case
;; of whnf_core, type_checker.cpp l. 517–524): consume min(#lambdas, #args)
(fn beta_head ((st St) (f Expr) (args (List Expr))) (Prod St Expr)
  (match (strip_lambdas f (len args) 0)
    ((Prod.mk body m)
     (match (instantiate_n st body 0 (rev (take m args)))
       ((Prod.mk st1 r) (mk_app_list st1 r (drop m args)))))))

;; ---- rendering (diagnostics, tests) ----------------------------------------

(fn show_expr ((e Expr)) (List Int)
  (measure (struct e))
  (match e
    ((BVar _ i) (append (utf8 "#") (show_nat i)))
    ((FVar _ i) (append (utf8 "?f") (show_nat i)))
    ((Sort _ u) (append (utf8 "(Sort ") (append (show_level u) (utf8 ")"))))
    ((Const _ n nil) (show_name n))
    ((Const _ n ls)
     (append (show_name n) (append (utf8 ".{") (append (show_levels ls) (utf8 "}")))))
    ((App _ f a)
     (append (utf8 "(") (append (show_expr f) (append (utf8 " ") (append (show_expr a) (utf8 ")"))))))
    ((Lam _ n _ d b)
     (append (utf8 "(fun (")
       (append (chars_of_name_last n)
         (append (utf8 " : ")
           (append (show_expr d) (append (utf8 ") => ") (append (show_expr b) (utf8 ")"))))))))
    ((Pi _ n _ d b)
     (append (utf8 "((")
       (append (chars_of_name_last n)
         (append (utf8 " : ")
           (append (show_expr d) (append (utf8 ") -> ") (append (show_expr b) (utf8 ")"))))))))
    ((Let _ n t v b)
     (append (utf8 "(let ")
       (append (chars_of_name_last n)
         (append (utf8 " : ")
           (append (show_expr t)
             (append (utf8 " := ")
               (append (show_expr v) (append (utf8 "; ") (append (show_expr b) (utf8 ")"))))))))))
    ((Lit _ (LitNat k)) (show_nat k))
    ((Lit _ (LitStr s)) (append (utf8 "\"") (append s (utf8 "\""))))
    ((MVar _ i) (append (utf8 "?m") (show_nat i)))
    ((Proj _ s i x) (append (show_expr x) (append (utf8 ".") (show_nat i))))))

(fn show_levels ((ls (List Level))) (List Int)
  (measure (struct ls))
  (match ls
    (nil (utf8 ""))
    ((cons l nil) (show_level l))
    ((cons l r) (append (show_level l) (append (utf8 ", ") (show_levels r))))))

(fn chars_of_name_last ((n Name)) (List Int)
  (match n
    ((Str _ s) (chars_of_sym s))
    ((Num _ k) (show_nat k))
    (Anon (utf8 "_"))))
