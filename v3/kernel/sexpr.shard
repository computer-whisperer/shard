;;; v3/kernel/sexpr.shard — the s-expression reader: S text → SExpr.
;;; Pure syntax: no name has a meaning here. One reader serves every
;;; file: a leading `-` makes a numeral, whose sign the L
;;; reader refuses in an L position (K's literals are naturals).
;;; A `'` at a token's start is refused (`no_quote`: there is no quote form;
;;; a symbol is written `(sym "x")`). A symbol ending in `.{` opens a level
;;; list closed by `}` — `List.{0}`, `Prod.{u v}` — kept on the symbol as
;;; its universe arguments (SSymU); the level terms are ordinary tokens.
;;; Strings decode `\n \t \r \\ \" \xHH \u{HHHH}` to UTF-8 bytes. Errors
;;; carry a reason and the unconsumed input (its length is the offset).

(import "util.shard")
(import "sym.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.descent)
(use kernel.sym)
(use kernel.util)

(type SExpr
  (SNum Int)  ; a numeral, any sign
  (SSym Symbol)  ; a symbol
  (SSymU Symbol (List SExpr))  ; a symbol with its universe list: `Name.{L…}`
  (SStr (List Int))  ; a string as UTF-8 bytes
  (SList (List SExpr)))  ; ( … )
;; a tree's size and a list's — `SExpr.size`, `List_SExpr.size` —, what the functions that
;; walk a tree and its lists are measured by; definitions with no program
(derive SExpr size)

;; one tree and the rest of the input; or nothing but whitespace and
;; comments remained; or an error at the unconsumed input
(type SRes (SOk SExpr (List Int)) (SEnd) (SErr Symbol (List Int)))

;; a whole file: every top-level tree, or the first error and its byte offset
(type RAll (RAOk (List SExpr)) (RAErr Symbol Int))

;; ---- characters (is_ws, is_digit: util.shard) -----------------------------------------
;; a delimiter ends an atom: whitespace, parens, the string quote, the comment
;; mark, and both braces (`{` after `.` opens a level list, `}` closes one; a
;; brace anywhere else is an error). `'` is an identifier character inside an
;; atom (`f'`, Lean's primes); at a token's start it is refused.
(fn is_delim ((c Int)) Bool
  (bool_or (is_ws c)
    (bool_or (= c 40)
      (bool_or (= c 41) (bool_or (= c 34) (bool_or (= c 59) (bool_or (= c 123) (= c 125))))))))

(fn skip_blank ((cs (List Int))) (List Int)
  (measure (List.length cs))
  (match cs
    (nil nil)
    ((cons c r)
     (if (is_ws c) (skip_blank r)
     (if (= c 59) (skip_blank (skip_line r))
     cs)))))
(fn skip_line ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r) (if (= c 10) r (skip_line r)))))
(fulfills skip_blank.dec_1
  (by
    (intro cs c r hm hw hc)
    (have hs (forall ((xs (List Int))) (<= (List.length (skip_line xs)) (List.length xs)))
      (intro xs)
      (induction xs
        ((nil () (unfold skip_line) (arith))
         (cons (x t ih) (unfold skip_line)
           (cases (Int.decEq x 10)
             ((isFalse (ne) (rw (if_neg ne)) (rw List.length_cons) (arith))
              (isTrue (e) (rw (if_pos e)) (rw List.length_cons) (arith))))))))
    (rw hm)
    (rw List.length_cons)
    (arith (hs r))))
(fulfills skip_blank.dec_2 (by (intro cs c r hm hw) (rw hm) (rw List.length_cons) (arith)))

;; ---- atoms --------------------------------------------------------------------------
;; the bytes up to the next delimiter, and the rest
(fn take_atom ((cs (List Int)) (acc (List Int))) (Prod (List Int) (List Int))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (rev acc) nil))
    ((cons c r) (if (is_delim c) (Prod.mk (rev acc) cs) (take_atom r (cons c acc))))))

(fn all_digits ((cs (List Int))) Bool
  (measure (struct cs))
  (match cs
    (nil true)
    ((cons c r) (if (is_digit c) (all_digits r) false))))
(fn digits_val ((cs (List Int)) (acc Int)) Int
  (measure (struct cs))
  (match cs
    (nil acc)
    ((cons c r) (digits_val r (+ (* acc 10) (- c 48))))))
(fn ends_with_dot ((cs (List Int))) Bool
  (measure (struct cs))
  (match cs
    (nil false)
    ((cons c nil) (= c 46))
    ((cons _ r) (ends_with_dot r))))
(fn drop_last ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons _ nil) nil)
    ((cons c r) (cons c (drop_last r)))))

;; ---- the reader ---------------------------------------------------------------------
(fn read_budget () Int 100000000)

;; one tree from the input (whitespace and comments skipped first)
(fn read_expr ((cs0 (List Int)) (fuel Int)) SRes
  (measure (* 2 (Int.natAbs (+ fuel 1))))
  (if (< fuel 0) (SErr (sym "reader_fuel") cs0)
  (let ((cs (skip_blank cs0)))
    (match cs
      (nil SEnd)
      ((cons c r)
       (if (= c 40) (read_list r nil (- fuel 1))
       (if (= c 41) (SErr (sym "unexpected_close") cs)
       (if (= c 34) (read_string r nil cs)
       (if (= c 39) (SErr (sym "no_quote") cs)
       (if (bool_or (= c 123) (= c 125)) (SErr (sym "stray_brace") cs)
       (read_atom cs (- fuel 1))))))))))))

;; after `(`: the items to the matching `)`
(fn read_list ((cs0 (List Int)) (acc (List SExpr)) (fuel Int)) SRes
  (measure (* 2 (Int.natAbs (+ fuel 1))))
  (if (< fuel 0) (SErr (sym "reader_fuel") cs0)
  (let ((cs (skip_blank cs0)))
    (match cs
      (nil (SErr (sym "unterminated_list") cs))
      ((cons c r)
       (if (= c 41) (SOk (SList (rev acc)) r)
       (match (read_expr cs (- fuel 1))
         ((SOk x rest) (read_list rest (cons x acc) (- fuel 1)))
         (SEnd (SErr (sym "unterminated_list") cs))
         ((SErr e at) (SErr e at)))))))))

;; a numeral or a symbol, with its universe list when the atom ends in `.` and `{` follows
(fn read_atom ((cs (List Int)) (fuel Int)) SRes
  (measure (+ (* 2 (Int.natAbs (+ fuel 1))) 1))
  (match (take_atom cs nil)
    ((Prod.mk a rest)
     (match a
       (nil (SErr (sym "empty_atom") cs))
       ((cons c0 _)
        (if (is_digit c0)
          (if (all_digits a) (SOk (SNum (digits_val a 0)) rest) (SErr (sym "bad_numeral") cs))
        (if
          (bool_and (= c0 45)
            (match a
              ((cons _ (cons d _)) (is_digit d))
              (_ false)))
          ;; `-7`: a numeral (the L reader refuses the sign in an L position)
          (if (all_digits (drop_first a)) (SOk (SNum (- 0 (digits_val (drop_first a) 0))) rest)
          (SErr (sym "bad_numeral") cs))
          (if (ends_with_dot a)
            (match rest
              ((cons c1 r2)
               (if (= c1 123) (read_levels r2 nil (sym_of_chars (drop_last a)) fuel)
               (SErr (sym "bad_universe_suffix") cs)))
              (nil (SErr (sym "bad_universe_suffix") cs)))
            (match rest
              ((cons c1 _)
               (if (= c1 123) (SErr (sym "bad_universe_suffix") cs)
               (SOk (SSym (sym_of_chars a)) rest)))
              (nil (SOk (SSym (sym_of_chars a)) rest)))))))))))
(fn drop_first ((cs (List Int))) (List Int)
  (match cs
    (nil nil)
    ((cons _ r) r)))

;; after `NAME.{`: the level terms to `}`
(fn read_levels ((cs0 (List Int)) (acc (List SExpr)) (s Symbol) (fuel Int)) SRes
  (measure (* 2 (Int.natAbs (+ fuel 1))))
  (if (< fuel 0) (SErr (sym "reader_fuel") cs0)
  (let ((cs (skip_blank cs0)))
    (match cs
      (nil (SErr (sym "unterminated_universe_list") cs))
      ((cons c r)
       (if (= c 125) (SOk (SSymU s (rev acc)) r)
       (match (read_expr cs (- fuel 1))
         ((SOk x rest) (read_levels rest (cons x acc) s (- fuel 1)))
         (SEnd (SErr (sym "unterminated_universe_list") cs))
         ((SErr e at) (SErr e at)))))))))

;; after the opening quote: the bytes to the closing quote, escapes decoded
(fn read_string ((cs (List Int)) (acc (List Int)) (start (List Int))) SRes
  (measure (List.length cs))
  (match cs
    (nil (SErr (sym "unterminated_string") start))
    ((cons c r)
     (if (= c 34) (SOk (SStr (rev acc)) r)
     (if (= c 92)
       (match r
         (nil (SErr (sym "unterminated_string") start))
         ((cons e r2)
          (if (= e 110) (read_string r2 (cons 10 acc) start)
          (if (= e 116) (read_string r2 (cons 9 acc) start)
          (if (= e 114) (read_string r2 (cons 13 acc) start)
          (if (= e 92) (read_string r2 (cons 92 acc) start)
          (if (= e 34) (read_string r2 (cons 34 acc) start)
          (if (= e 120)
            (match r2
              ((cons h1 (cons h2 r3))
               (if (bool_and (is_hex h1) (is_hex h2))
                 (read_string r3 (cons (+ (* 16 (hex_val h1)) (hex_val h2)) acc) start)
                 (SErr (sym "bad_escape") cs)))
              (_ (SErr (sym "bad_escape") cs)))
          (if (= e 117)
            (match r2
              ((cons c3 r3)
               (if (= c3 123)
                 (match (take_hex r3 0 0)
                   ((Prod.mk (Prod.mk cp k) r4)
                    (match r4
                      ((cons c5 r5)
                       (if (bool_and (= c5 125) (bool_and (< 0 k) (<= k 6)))
                         (read_string r5 (rev_onto (utf8_of cp) acc) start)
                         (SErr (sym "bad_escape") cs)))
                      (nil (SErr (sym "bad_escape") cs)))))
                 (SErr (sym "bad_escape") cs)))
              (nil (SErr (sym "bad_escape") cs)))
            (SErr (sym "bad_escape") cs))))))))))
       (read_string r (cons c acc) start))))))

(fn is_hex ((c Int)) Bool
  (bool_or (is_digit c) (bool_or (bool_and (<= 97 c) (<= c 102)) (bool_and (<= 65 c) (<= c 70)))))
;; hex digits to a value: ((value, count), rest)
(fn take_hex ((cs (List Int)) (acc Int) (k Int)) (Prod (Prod Int Int) (List Int))
  (measure (struct cs))
  (match cs
    ((cons c r)
     (if (is_hex c) (take_hex r (+ (* acc 16) (hex_val c)) (+ k 1)) (Prod.mk (Prod.mk acc k) cs)))
    (nil (Prod.mk (Prod.mk acc k) nil))))
;; the rest `take_hex` leaves is no longer than what it was given: `read_string` goes on from
;; it after a `\u{…}` escape
(theorem take_hex_le ((cs (List Int)))
  (forall ((acc Int) (k Int) (v Int) (n Int) (rest (List Int)))
    (-> (= (take_hex cs acc k) (Prod.mk (Prod.mk v n) rest))
      (<= (List.length rest) (List.length cs))))
  (by
    (induction cs
      ((nil () (intro acc k v n rest h)
         (have e (= (Prod.mk (Prod.mk acc k) (@nil Int)) (Prod.mk (Prod.mk v n) rest)) (exact h))
         (have er (= (@nil Int) rest) (exact (congrArg Prod.snd e)))
         (rw (<- er))
         (arith))
       (cons (c r ih) (intro acc k v n rest h)
         (cases (Bool.decEq (is_hex c) true)
           ((isFalse (hn)
              (have e (= (take_hex (cons c r) acc k) (Prod.mk (Prod.mk acc k) (cons c r)))
                (rw take_hex.eq_2)
                (rw (if_neg hn))
                rfl)
              (have e2 (= (Prod.mk (Prod.mk acc k) (cons c r)) (Prod.mk (Prod.mk v n) rest))
                (rw (<- e))
                (exact h))
              (have er (= (cons c r) rest) (exact (congrArg Prod.snd e2)))
              (rw (<- er))
              (arith))
            (isTrue (hc)
              (have e
                (= (take_hex (cons c r) acc k) (take_hex r (+ (* acc 16) (hex_val c)) (+ k 1)))
                (rw take_hex.eq_2)
                (rw (if_pos hc))
                rfl)
              (have h2
                (= (take_hex r (+ (* acc 16) (hex_val c)) (+ k 1)) (Prod.mk (Prod.mk v n) rest))
                (rw (<- e))
                (exact h))
              (have g (<= (List.length rest) (List.length r))
                (exact (ih (+ (* acc 16) (hex_val c)) (+ k 1) v n rest h2)))
              (rw List.length_cons)
              (arith)))))))))
;; a code point as UTF-8 bytes
(fn utf8_of ((cp Int)) (List Int)
  (if (< cp 128) (list cp)
  (if (< cp 2048) (list (+ 192 (bshr cp 6)) (+ 128 (band cp 63)))
  (if (< cp 65536) (list (+ 224 (bshr cp 12)) (+ 128 (band (bshr cp 6) 63)) (+ 128 (band cp 63)))
  (list (+ 240 (bshr cp 18)) (+ 128 (band (bshr cp 12) 63)) (+ 128 (band (bshr cp 6) 63))
    (+ 128 (band cp 63)))))))
(fulfills read_string.dec_1 (by (intro p c r h n1 n2) (rw h) (rw List.length_cons) (arith)))
(fulfills read_string.dec_2
  (by
    (intro p c r h n1 hc e r2 h2 n3 n4 n5 n6 n7 n8 he c3 r3 h3 hc3 cp k r4 ht c5 r5 h5 hb)
    (have g (<= (List.length r4) (List.length r3)) (exact (take_hex_le r3 0 0 cp k r4 ht)))
    (have g2 (= (List.length r4) (+ (List.length r5) 1)) (rw h5) (rw List.length_cons) rfl)
    (rw h)
    (rw h2)
    (rw h3)
    (simp_only List.length_cons)
    (arith)))
(fulfills read_string.dec_3
  (by
    (intro p c r h n1 hc e r2 h2 n3 n4 n5 n6 n7 he x1 x2 r3 h3 hb)
    (rw h)
    (rw h2)
    (rw h3)
    (simp_only List.length_cons)
    (arith)))
(fulfills read_string.dec_4
  (by
    (intro p c r h n1 hc e r2 h2 n3 n4 n5 n6 he)
    (rw h)
    (rw h2)
    (simp_only List.length_cons)
    (arith)))
(fulfills read_string.dec_5
  (by (intro p c r h n1 hc e r2 h2 n3 n4 n5 he) (rw h) (rw h2) (simp_only List.length_cons) (arith)))
(fulfills read_string.dec_6
  (by (intro p c r h n1 hc e r2 h2 n3 n4 he) (rw h) (rw h2) (simp_only List.length_cons) (arith)))
(fulfills read_string.dec_7
  (by (intro p c r h n1 hc e r2 h2 n3 he) (rw h) (rw h2) (simp_only List.length_cons) (arith)))
(fulfills read_string.dec_8
  (by (intro p c r h n1 hc e r2 h2 he) (rw h) (rw h2) (simp_only List.length_cons) (arith)))
(fulfills read_expr.dec_1
  (by
    (intro cs0 fuel hf c r h n1 n2 n3 n4 n5)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills read_expr.dec_2
  (by
    (intro cs0 fuel hf c r h hc)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills read_list.dec_1
  (by
    (intro cs0 acc fuel hf c r h n1)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills read_list.dec_2
  (by
    (intro cs0 acc fuel hf c r h n1 x rest)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills read_atom.dec_1 (by (intro cs fuel a rest h c0 w h2 n1 n2 hd c1 r2 h3 hc) (arith)))
(fulfills read_levels.dec_1
  (by
    (intro cs0 acc s fuel hf c r h n1)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))
(fulfills read_levels.dec_2
  (by
    (intro cs0 acc s fuel hf c r h n1 x rest)
    (have g (< (Int.natAbs (+ (- fuel 1) 1)) (Int.natAbs (+ fuel 1)))
      (apply natAbs_lt (arith) (arith)))
    (arith)))

;; ---- a whole file -------------------------------------------------------------------
(fn read_all ((src (List Int))) RAll (read_all_go src (len src) nil (read_budget)))
(fn read_all_go ((cs (List Int)) (total Int) (acc (List SExpr)) (fuel Int)) RAll
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) (RAErr (sym "reader_fuel") (- total (len cs)))
  (match (read_expr cs fuel)
    (SEnd (RAOk (rev acc)))
    ((SOk x rest) (read_all_go rest total (cons x acc) (- fuel 1)))
    ((SErr e at) (RAErr e (- total (len at)))))))
(fulfills read_all_go.dec_1 (by (intro p hf x rest h) (apply natAbs_lt (arith) (arith))))

;; ---- printing ------------------------------------------------------------------------
(fn show_sexpr ((s SExpr)) (List Int)
  (measure (SExpr.size s))
  (match s
    ((SNum k) (show_int k))
    ((SSym x) (chars_of_sym x))
    ((SSymU x ls)
     (append (chars_of_sym x) (append (utf8 ".{") (append (show_sexprs ls) (utf8 "}")))))
    ((SStr bs) (append (utf8 "\"") (append (escape_str bs) (utf8 "\""))))
    ((SList xs) (append (utf8 "(") (append (show_sexprs xs) (utf8 ")"))))))
(fn show_sexprs ((xs (List SExpr))) (List Int)
  (measure (List_SExpr.size xs))
  (match xs
    (nil nil)
    ((cons x nil) (show_sexpr x))
    ((cons x r) (append (show_sexpr x) (cons 32 (show_sexprs r))))))
;; the printable escapes back; other bytes raw
(fn escape_str ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (nil nil)
    ((cons c r)
     (if (= c 34) (cons 92 (cons 34 (escape_str r)))
     (if (= c 92) (cons 92 (cons 92 (escape_str r)))
     (if (= c 10) (cons 92 (cons 110 (escape_str r)))
     (if (= c 9) (cons 92 (cons 116 (escape_str r)))
     (if (= c 13) (cons 92 (cons 114 (escape_str r)))
     (cons c (escape_str r))))))))))
(fulfills show_sexpr.dec_1 (by (intro s x ls h) (rw h) (rw SExpr.size.eq_3) (arith)))
(fulfills show_sexpr.dec_2 (by (intro s xs h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills show_sexprs.dec_1 (by (intro xs x h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills show_sexprs.dec_2 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills show_sexprs.dec_3 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))

;; the structural size (the measure for walks above this file)
(fn size_sexpr ((s SExpr)) Int
  (measure (SExpr.size s))
  (match s
    ((SList xs) (+ 1 (size_sexprs xs)))
    ((SSymU _ ls) (+ 1 (size_sexprs ls)))
    (_ 1)))
(fn size_sexprs ((xs (List SExpr))) Int
  (measure (List_SExpr.size xs))
  (match xs
    (nil 0)
    ((cons x r) (+ (size_sexpr x) (size_sexprs r)))))
(fulfills size_sexpr.dec_1 (by (intro s xs h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills size_sexpr.dec_2 (by (intro s w ls h) (rw h) (rw SExpr.size.eq_3) (arith)))
(fulfills size_sexprs.dec_1 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills size_sexprs.dec_2 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
