;;; v3/kernel/cgen.shard — the restricted form RS transcribed to C: the second of the back
;;; end's two stages. The input is lower.shard's output — bodies in ANF, flat arms, atomic
;;; operands — and this file does no semantic work, only transcription onto the runtime
;;; (rt.h). A shape outside RS is refused, never guessed.
;;;
;;;   a function    value_t s_NAME(value_t p_0, …) { start_:; … }
;;;   a let         value_t v_D = RHS;            D the depth: unique in its C scope
;;;   a self tail call   the parameters reassigned, goto start_
;;;   a match       the scrutinee copied, then a switch on the tag (constructors) or on the
;;;                 integer (numerals); a variable arm the default; no arm at all the trap
;;;                 rt_no_match
;;;   a constructor an allocation of its tag and fields; the four cells the runtime keeps
;;;                 (true, false, nil, none) by name
;;;   a primitive, an extern   the runtime's function of that operation
;;;
;;; NAMES. A function's C name is `s_` and its identity mangled injectively — an alphanumeric
;;; as itself, `_` as `__`, any other byte as `_xHH`, the components joined by `_x2e`, a
;;; numeric component (a lifted function's) as `_jN` —, so two identities never meet in one C
;;; name and no word is reserved.
;;;
;;; TAGS. A tag's low bit says "second constructor of its type", as the evaluator's tags do
;;; (ev.shard), so the runtime decides an `if` by that bit and takes the branch the evaluator
;;; takes on a value of any type. A constructor with a wire role (lower.shard `lw_role`)
;;; carries the runtime's fixed tag for it, 900–908 — which is what identifies Init's wire
;;; types with the cells rt.h's extern shims build —, odd for the three roles that are second
;;; constructors (true, cons, some); every other constructor two tags from 1000 in the
;;; program's order, the odd one its own where it is the second of its type. The World's tag
;;; is fixed and even, so a constructor named `World` that is the second of its type is refused.
;;;
;;; THE TEXT IN UNITS. `prog.h` holds the tags, the runtime's include and what every unit
;;; reads of the program: the counters' declaration and the prototypes. The functions are in
;;; `pNNNN.c`, cg_part of them a file; `main.c` holds the tables and `main`, and is the unit
;;; the runtime itself is compiled in (`RT_MAIN`, rt.h). Every `.c` file includes `prog.h` and
;;; is a translation unit of its own: the C compiler runs on them side by side (v3/build.sh),
;;; and the engine that runs this file never holds the text of the whole program as one list.
;;; A function is therefore an external name of the program, which the mangling keeps apart.

(import "lower.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.descent)
(use kernel.intmap)
(use kernel.lower)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ETerm)
(use kernel.prog.Prim)
(use kernel.prog.Prog)

;; ---- the output: a tree of fragments, flattened once per file --------------------------------
(type CgDoc (CgS (List Int)) (CgCat CgDoc CgDoc))
(fn cg_cat3 ((a CgDoc) (b CgDoc) (c CgDoc)) CgDoc (CgCat a (CgCat b c)))
(fn cg_cat4 ((a CgDoc) (b CgDoc) (c CgDoc) (d CgDoc)) CgDoc (CgCat a (CgCat b (CgCat c d))))
(fn cg_flat ((d CgDoc) (tail (List Int))) (List Int)
  (measure (struct d))
  (match d
    ((CgS s) (append s tail))
    ((CgCat a b) (cg_flat a (cg_flat b tail)))))
(fn cg_num ((n Int)) CgDoc (CgS (show_int n)))
(fn cg_ind ((n Int)) CgDoc
  (measure (Int.natAbs n))
  (if (< n 1) (CgS nil) (CgCat (CgS (utf8 "  ")) (cg_ind (- n 1)))))
(fulfills cg_ind.dec_1 (by (intro n h) (apply natAbs_pred (arith))))

;; ---- names ---------------------------------------------------------------------------------
(fn cg_hex ((n Int)) Int (if (< n 10) (+ 48 n) (+ 87 n)))
(fn cg_alnum ((c Int)) Bool
  (bool_or (bool_and (<= 48 c) (<= c 57))
    (bool_or (bool_and (<= 97 c) (<= c 122)) (bool_and (<= 65 c) (<= c 90)))))
(fn cg_mangle ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r)
     (if (cg_alnum c) (cons c (cg_mangle r))
     (if (= c 95) (cons 95 (cons 95 (cg_mangle r)))
     (cons 95 (cons 120 (cons (cg_hex (/ c 16)) (cons (cg_hex (mod c 16)) (cg_mangle r))))))))))
(fn cg_name ((n Name)) (List Int)
  (measure (struct n))
  (match n
    (Anon nil)
    ((Str Anon s) (cg_mangle (chars_of_sym s)))
    ((Str p s) (append (cg_name p) (append (utf8 "_x2e") (cg_mangle (chars_of_sym s)))))
    ((Num p k) (append (cg_name p) (append (utf8 "_j") (show_nat k))))))
(fn cg_fname ((n Name)) (List Int) (append (utf8 "s_") (cg_name n)))
;; a name inside a C string literal
(fn cg_cstr ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons c r)
     (if (= c 34) (cons 92 (cons 34 (cg_cstr r)))
     (if (= c 92) (cons 92 (cons 92 (cg_cstr r)))
     (if (= c 10) (cons 92 (cons 110 (cg_cstr r)))
     (cons c (cg_cstr r))))))))

;; ---- the constructors' tags: identity → (tag, fields) ---------------------------------------
(fn cg_tag_add ((t (IntMap (List (Prod Name (Prod Int Int))))) (c Name) (tag Int) (arity Int))
  (IntMap (List (Prod Name (Prod Int Int))))
  (let ((h (name_key c)))
    (im_insert t h
      (cons (Prod.mk c (Prod.mk tag arity))
        (match (im_find t h)
          ((some b) b)
          (none nil))))))
(fn cg_tag_find ((t (IntMap (List (Prod Name (Prod Int Int))))) (c Name)) (Option (Prod Int Int))
  (match (im_find t (name_key c))
    (none none)
    ((some b) (cg_tag_assoc b c))))
(fn cg_tag_assoc ((b (List (Prod Name (Prod Int Int)))) (c Name)) (Option (Prod Int Int))
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk k v) r) (if (name_eq k c) (some v) (cg_tag_assoc r c)))))
(fn cg_tags ((ds (List EDecl)) (t (IntMap (List (Prod Name (Prod Int Int))))) (next Int))
  (IntMap (List (Prod Name (Prod Int Int))))
  (measure (List.length ds))
  (match ds
    (nil t)
    ((cons (EInd _ _ cs) r)
     (match (cg_tag_ctors cs t next 0)
       ((Prod.mk t1 next1) (cg_tags r t1 next1))))
    ((cons _ r) (cg_tags r t next))))
;; i is the constructor's place in its type: the second one takes the odd tag of its two
(fn cg_tag_ctors
  ((cs (List ECtorDef)) (t (IntMap (List (Prod Name (Prod Int Int))))) (next Int) (i Int))
  (Prod (IntMap (List (Prod Name (Prod Int Int)))) Int)
  (measure (List.length cs))
  (match cs
    (nil (Prod.mk t next))
    ((cons (ECtorDef c fs) r)
     (let ((role (lw_role c)))
       (if (< 0 role) (cg_tag_ctors r (cg_tag_add t c (cg_role_tag role) (len fs)) next (+ i 1))
       (cg_tag_ctors r (cg_tag_add t c (+ next (if (= i 1) 1 0)) (len fs)) (+ next 2) (+ i 1)))))))
;; the runtime's tag of a role: odd for true, cons and some, the second constructors of their
;; types; even for false, nil, none, pair and the World
(fn cg_role_tag ((role Int)) Int
  (if (= role 1) 901
  (if (= role 2) 900
  (if (= role 8) 908
  (+ 899 role)))))
(fulfills cg_tag_ctors.dec_1 (by (intro p c fs r h hr) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_tag_ctors.dec_2 (by (intro p c fs r h hr) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_tags.dec_1
  (by (intro p w1 w2 cs r h t1 next1 h1) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_tags.dec_2 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
;; what the runtime cannot hold of a type's constructors, each a refusal. The World's tag is
;; fixed and even, and with it the bit an `if` reads: a constructor named `World` that is the
;; second of its type (Init's own are at their roles' places by declaration). A cell's
;; fields: one more than the allocator's size classes reach. errs is newest first
(fn cg_ctor_errs ((ds (List EDecl)) (errs (List (List Int)))) (List (List Int))
  (measure (List.length ds))
  (match ds
    (nil errs)
    ((cons (EInd _ _ cs) r) (cg_ctor_errs r (cg_ctor_errs_in cs 0 errs)))
    ((cons _ r) (cg_ctor_errs r errs))))
(fn cg_ctor_errs_in ((cs (List ECtorDef)) (i Int) (errs (List (List Int)))) (List (List Int))
  (measure (List.length cs))
  (match cs
    (nil errs)
    ((cons (ECtorDef c fs) r)
     (cg_ctor_errs_in r (+ i 1) (cg_wide_err c (len fs) (cg_role_err c i errs))))))
(fn cg_role_err ((c Name) (i Int) (errs (List (List Int)))) (List (List Int))
  (if (bool_and (= (lw_role c) 8) (= i 1))
    (cons
      (append (utf8 "the constructor ")
        (append (show_name c)
          (utf8 " is the World's cell and must not be the second constructor of its type")))
      errs)
    errs))
;; the most fields a cell has: rt.h's RT_MAX_ARITY, which the generated text asserts
(fn cg_max_fields () Int 125)
(fn cg_wide_err ((c Name) (nf Int) (errs (List (List Int)))) (List (List Int))
  (if (<= nf (cg_max_fields)) errs
  (cons
    (append (utf8 "the constructor ")
      (append (show_name c)
        (append (utf8 " has ")
          (append (show_nat nf)
            (append (utf8 " fields: a cell of the runtime holds at most ")
              (show_nat (cg_max_fields)))))))
    errs)))
(fulfills cg_ctor_errs_in.dec_1 (by (intro p c fs r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_ctor_errs.dec_1 (by (intro p w1 w2 cs r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_ctor_errs.dec_2 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
;; the World's cell: its constructor's field count, where the program declares one
(fn cg_world ((ds (List EDecl))) (Option Int)
  (measure (List.length ds))
  (match ds
    (nil none)
    ((cons (EInd _ _ cs) r)
     (match (cg_world_in cs)
       ((some a) (some a))
       (none (cg_world r))))
    ((cons _ r) (cg_world r))))
(fn cg_world_in ((cs (List ECtorDef))) (Option Int)
  (measure (List.length cs))
  (match cs
    (nil none)
    ((cons (ECtorDef c fs) r) (if (= (lw_role c) 8) (some (len fs)) (cg_world_in r)))))
(fulfills cg_world_in.dec_1 (by (intro cs c fs r h hr) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_world.dec_1 (by (intro ds w1 w2 cs r h h1) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_world.dec_2 (by (intro ds w r h) (rw h) (rw List.length_cons) (arith)))

;; ---- the context of one function -----------------------------------------------------------
(type CgCx (CgCx (IntMap (List (Prod Name (Prod Int Int)))) Name Int))  ; tags, the function, its arity
(fn cg_cx_tags ((c CgCx)) (IntMap (List (Prod Name (Prod Int Int))))
  (match c
    ((CgCx t _ _) t)))
(fn cg_cx_self ((c CgCx)) Name
  (match c
    ((CgCx _ n _) n)))
(fn cg_cx_arity ((c CgCx)) Int
  (match c
    ((CgCx _ _ a) a)))
;; a constructor's tag: its declaration's, or its role's where the program declares no type for it
(fn cg_tag_of ((cx CgCx) (c Name)) (Option Int)
  (match (cg_tag_find (cg_cx_tags cx) c)
    ((some (Prod.mk tag _)) (some tag))
    (none (let ((role (lw_role c))) (if (< 0 role) (some (cg_role_tag role)) none)))))
;; rt_no_match("NAME")
(fn cg_trap ((cx CgCx)) CgDoc
  (cg_cat3 (CgS (utf8 "rt_no_match(\"")) (CgS (cg_cstr (show_name (cg_cx_self cx))))
    (CgS (utf8 "\")"))))

;; ---- the runtime's operations -----------------------------------------------------------------
;; the eighteen bare-named primitives by their code (prog.shard's table) and the seven under
;; Init's names lower.shard keeps (its `lw_prim_kept`): the runtime's operation agrees with
;; each on the values E reaches, and answers a decision with the cell its role names
;; (`Nat.beq` true is the true cell, whichever Bool the program means)
(fn cg_prim_rt ((code Int)) (Option (List Int))
  (if (= code 0) (some (utf8 "rt_int_eq"))
  (if (= code 1) (some (utf8 "rt_add"))
  (if (= code 2) (some (utf8 "rt_sub"))
  (if (= code 3) (some (utf8 "rt_lt"))
  (if (= code 4) (some (utf8 "rt_le"))
  (if (= code 6) (some (utf8 "rt_band"))
  (if (= code 7) (some (utf8 "rt_bshr"))
  (if (= code 8) (some (utf8 "rt_mul"))
  (if (= code 9) (some (utf8 "rt_mod"))
  (if (= code 10) (some (utf8 "rt_div"))
  (if (= code 11) (some (utf8 "rt_tmod"))
  (if (= code 12) (some (utf8 "rt_ediv"))
  (if (= code 13) (some (utf8 "rt_bor"))
  (if (= code 14) (some (utf8 "rt_bxor"))
  (if (= code 15) (some (utf8 "rt_bshl"))
  (if (= code 23) (some (utf8 "rt_band"))
  (if (= code 24) (some (utf8 "rt_bor"))
  (if (= code 25) (some (utf8 "rt_bxor"))
  (if (= code 26) (some (utf8 "rt_nat_shl"))
  (if (= code 27) (some (utf8 "rt_nat_shr"))
  (if (= code 34) (some (utf8 "rt_int_eq"))
  (if (= code 35) (some (utf8 "rt_le"))
  none)))))))))))))))))))))))
;; the externs the runtime has a shim for, by the declared name's last component
(fn cg_ext_rt ((x Name)) (Option (List Int))
  (match x
    ((Str _ s)
     (let ((c (chars_of_sym s)))
       (if
         (cg_ext_known c
           (list (utf8 "get_args") (utf8 "read_file") (utf8 "read_range") (utf8 "write")
             (utf8 "write_line")
             (utf8 "write_file")
             (utf8 "exit")))
         (some (append (utf8 "rt_") c))
         none)))
    (_ none)))
(fn cg_ext_known ((c (List Int)) (xs (List (List Int)))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (int_list_eq c x) true (cg_ext_known c r)))))

;; ---- atoms and right-hand sides; env is innermost first, the C names of the variables ---------
(type CgR (CgOk CgDoc) (CgErr (List Int)))
(type CgRs (CgsOk (List CgDoc)) (CgsErr (List Int)))

;; a numeral inside the runtime's small integers is a C constant; outside, parsed at run time
(fn cg_int ((n Int)) CgDoc
  (if (bool_and (<= -4611686018427387904 n) (<= n 4611686018427387903))
    (cg_cat3 (CgS (utf8 "rt_tag_int(")) (cg_num n) (CgS (utf8 "LL)")))
    (cg_cat3 (CgS (utf8 "rt_big_dec(\"")) (cg_num n) (CgS (utf8 "\")")))))
(fn cg_atom ((t ETerm) (env (List (List Int))) (cx CgCx)) CgR
  (match t
    ((EBVar i)
     (match (nth env i)
       ((some n) (CgOk (CgS n)))
       (none (CgErr (utf8 "a variable out of range")))))
    ((ELit (LNat n)) (CgOk (cg_int n)))
    ((ELit (LInt n)) (CgOk (cg_int n)))
    (_ (CgErr (utf8 "an operand that is not an atom (not the restricted form)")))))
(fn cg_atoms ((ts (List ETerm)) (env (List (List Int))) (cx CgCx)) CgRs
  (measure (List.length ts))
  (match ts
    (nil (CgsOk nil))
    ((cons t r)
     (match (cg_atom t env cx)
       ((CgErr m) (CgsErr m))
       ((CgOk d)
        (match (cg_atoms r env cx)
          ((CgsErr m) (CgsErr m))
          ((CgsOk ds) (CgsOk (cons d ds)))))))))
(fulfills cg_atoms.dec_1 (by (intro p t r h d hd) (rw h) (rw List.length_cons) (arith)))
(fn cg_commas ((ds (List CgDoc))) CgDoc
  (measure (struct ds))
  (match ds
    (nil (CgS nil))
    ((cons d nil) d)
    ((cons d r) (cg_cat3 d (CgS (utf8 ", ")) (cg_commas r)))))
;; NAME(a, b, …)
(fn cg_apply ((f (List Int)) (ds (List CgDoc))) CgDoc
  (cg_cat4 (CgS f) (CgS (utf8 "(")) (cg_commas ds) (CgS (utf8 ")"))))
;; an allocation, as a statement expression; the four cells the runtime keeps by name
(fn cg_ctor ((c Name) (as (List ETerm)) (env (List (List Int))) (cx CgCx)) CgR
  (match (cg_tag_of cx c)
    (none (CgErr (append (utf8 "an unknown constructor: ") (show_name c))))
    ((some tag)
     (match as
       (nil
         (let ((role (lw_role c)))
           (CgOk
             (if (= role 1) (CgS (utf8 "rt_true_"))
             (if (= role 2) (CgS (utf8 "rt_false_"))
             (if (= role 3) (CgS (utf8 "rt_nil_"))
             (if (= role 5) (CgS (utf8 "rt_none_"))
             (cg_cat3 (CgS (utf8 "rt_alloc(")) (cg_num tag) (CgS (utf8 ", 0)"))))))))))
       (_
         (match (cg_atoms as env cx)
           ((CgsErr m) (CgErr m))
           ((CgsOk ds)
            (CgOk
              (cg_cat4
                (cg_cat3 (CgS (utf8 "({ value_t c_ = rt_alloc(")) (cg_num tag) (CgS (utf8 ", ")))
                (cg_cat3 (cg_num (len ds)) (CgS (utf8 "); ")) (cg_stores ds 0))
                (CgS (utf8 " c_; })"))
                (CgS (utf8 "")))))))))))
(fn cg_stores ((ds (List CgDoc)) (i Int)) CgDoc
  (measure (List.length ds))
  (match ds
    (nil (CgS nil))
    ((cons d r)
     (cg_cat4 (cg_cat3 (CgS (utf8 "rt_cellof(c_)->fields[")) (cg_num i) (CgS (utf8 "] = "))) d
       (CgS (utf8 "; "))
       (cg_stores r (+ i 1))))))
(fulfills cg_stores.dec_1 (by (intro p d r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_rhs ((t ETerm) (env (List (List Int))) (cx CgCx)) CgR
  (match t
    ((ECtor c as) (cg_ctor c as env cx))
    ((ECall f as)
     (match (cg_atoms as env cx)
       ((CgsErr m) (CgErr m))
       ((CgsOk ds) (CgOk (cg_apply (cg_fname f) ds)))))
    ((EPrim p as)
     (match (prim_find p)
       (none (CgErr (append (utf8 "an unknown primitive: ") (show_name p))))
       ((some (Prim code _))
        (match (cg_prim_rt code)
          (none
            (CgErr
              (append (utf8 "the primitive ")
                (append (show_name p)
                  (utf8 " has no operation in the runtime (not the restricted form)")))))
          ((some rt)
           (match (cg_atoms as env cx)
             ((CgsErr m) (CgErr m))
             ((CgsOk ds) (CgOk (cg_apply rt ds)))))))))
    ((EExt x as)
     (match (cg_ext_rt x)
       (none
         (CgErr
           (append (utf8 "the extern ") (append (show_name x) (utf8 " has no shim in the runtime")))))
       ((some rt)
        (match (cg_atoms as env cx)
          ((CgsErr m) (CgErr m))
          ((CgsOk ds) (CgOk (cg_apply rt ds)))))))
    (EAbsurd (CgOk (cg_trap cx)))
    ((ELam _ _ _)
     (CgErr (utf8 "internal: a lambda in a program — the classifier lifts each one")))
    (_ (cg_atom t env cx))))

;; ---- statements: every body ends in a return, a goto or a trap --------------------------------
;; a let's C name: the depth, unique in its scope
(fn cg_lname ((env (List (List Int)))) (List Int) (append (utf8 "v_") (show_nat (len env))))
(fn cg_return ((t ETerm) (env (List (List Int))) (cx CgCx) (ind Int)) CgR
  (match (cg_rhs t env cx)
    ((CgErr m) (CgErr m))
    ((CgOk d) (CgOk (cg_cat4 (cg_ind ind) (CgS (utf8 "return ")) d (CgS (utf8 ";\n")))))))
;; a self tail call: the operands to shadows, the shadows to the parameters, goto
(fn cg_selftail ((as (List ETerm)) (env (List (List Int))) (cx CgCx) (ind Int)) CgR
  (match (cg_atoms as env cx)
    ((CgsErr m) (CgErr m))
    ((CgsOk ds)
     (CgOk
       (cg_cat4 (CgCat (cg_ind ind) (CgS (utf8 "{ "))) (cg_shadow ds 0) (cg_rebind ds 0)
         (CgS (utf8 "goto start_; }\n")))))))
(fn cg_shadow ((ds (List CgDoc)) (i Int)) CgDoc
  (measure (List.length ds))
  (match ds
    (nil (CgS nil))
    ((cons d r)
     (cg_cat4 (cg_cat3 (CgS (utf8 "value_t n_")) (cg_num i) (CgS (utf8 " = "))) d (CgS (utf8 "; "))
       (cg_shadow r (+ i 1))))))
(fulfills cg_shadow.dec_1 (by (intro p d r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_rebind ((ds (List CgDoc)) (i Int)) CgDoc
  (measure (List.length ds))
  (match ds
    (nil (CgS nil))
    ((cons _ r)
     (cg_cat4 (cg_cat3 (CgS (utf8 "p_")) (cg_num i) (CgS (utf8 " = n_"))) (cg_num i)
       (CgS (utf8 "; "))
       (cg_rebind r (+ i 1))))))
(fulfills cg_rebind.dec_1 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_tail ((t ETerm) (env (List (List Int))) (cx CgCx) (ind Int)) CgR
  (measure (* 2 (ETerm.size t)))
  (match t
    ((ELet (cons r nil) body)
     (match (cg_rhs r env cx)
       ((CgErr m) (CgErr m))
       ((CgOk rd)
        (match (cg_tail body (cons (cg_lname env) env) cx ind)
          ((CgErr m) (CgErr m))
          ((CgOk bd)
           (CgOk
             (cg_cat4
               (cg_cat4 (cg_ind ind) (CgS (utf8 "value_t ")) (CgS (cg_lname env)) (CgS (utf8 " = ")))
               rd
               (CgS (utf8 ";\n"))
               bd)))))))
    ((ELet _ _) (CgErr (utf8 "a let of several bindings (not the restricted form)")))
    ((EIf c a b)
     (match (cg_atom c env cx)
       ((CgErr m) (CgErr m))
       ((CgOk cd)
        (match (cg_tail a env cx (+ ind 1))
          ((CgErr m) (CgErr m))
          ((CgOk ad)
           (match (cg_tail b env cx (+ ind 1))
             ((CgErr m) (CgErr m))
             ((CgOk bd)
              (CgOk
                (cg_cat4
                  (cg_cat4 (cg_ind ind) (CgS (utf8 "if (rt_truthy(")) cd (CgS (utf8 ")) {\n")))
                  ad
                  (cg_cat3 (cg_ind ind) (CgS (utf8 "} else {\n")) bd)
                  (CgCat (cg_ind ind) (CgS (utf8 "}\n"))))))))))))
    ((EMatch s arms) (cg_match s arms env cx ind))
    ((ECall f as)
     (if (bool_and (name_eq f (cg_cx_self cx)) (= (len as) (cg_cx_arity cx)))
       (cg_selftail as env cx ind)
       (cg_return t env cx ind)))
    (_ (cg_return t env cx ind))))

;; ---- a match: the arms' kind is the first arm's that is not a variable -----------------------
;; 0 variables only, 1 constructors, 2 numerals
(fn cg_kind ((arms (List EArm))) Int
  (measure (List.length arms))
  (match arms
    (nil 0)
    ((cons (EArm (PCtor _ _) _) _) 1)
    ((cons (EArm (PLit _) _) _) 2)
    ((cons (EArm PVar _) r) (cg_kind r))))
(fulfills cg_kind.dec_1 (by (intro arms w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_has_var ((arms (List EArm))) Bool
  (measure (List.length arms))
  (match arms
    (nil false)
    ((cons (EArm PVar _) _) true)
    ((cons _ r) (cg_has_var r))))
(fulfills cg_has_var.dec_1 (by (intro arms w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_match ((s ETerm) (arms (List EArm)) (env (List (List Int))) (cx CgCx) (ind Int)) CgR
  (measure (+ (* 2 (List_EArm.size arms)) 1))
  (match (cg_atom s env cx)
    ((CgErr m) (CgErr m))
    ((CgOk sd)
     (let ((sn (cg_lname env)) (k (cg_kind arms)))
       (match (cg_arms arms env sn cx (+ ind 1) k)
         ((CgErr m) (CgErr m))
         ((CgOk ad)
          (CgOk
            (cg_cat4 (cg_cat4 (cg_ind ind) (CgS (utf8 "{ value_t ")) (CgS sn) (CgS (utf8 " = ")))
              (cg_cat3 sd (CgS (utf8 ";\n")) (cg_open sn ind k))
              ad
              (cg_close cx ind k (cg_has_var arms))))))))))
(fn cg_open ((sn (List Int)) (ind Int) (k Int)) CgDoc
  (if (= k 1)
    (cg_cat4 (cg_ind ind) (CgS (utf8 "switch (rt_tag(")) (CgS sn) (CgS (utf8 ")) {\n")))
    ;; an integer outside the small ones takes the default through a value no case label has
    (if (= k 2)
      (cg_cat4 (cg_ind ind)
        (cg_cat3 (CgS (utf8 "switch (rt_is_int(")) (CgS sn) (CgS (utf8 ") ? (int64_t)rt_untag(")))
        (CgS sn)
        (CgS (utf8 ") : (-9223372036854775807LL - 1)) {\n")))
      (CgS nil))))
;; where no arm is a variable, what no arm matches is the trap
(fn cg_close ((cx CgCx) (ind Int) (k Int) (hasdef Bool)) CgDoc
  (if (bool_or (= k 1) (= k 2))
    (if hasdef (CgCat (cg_ind ind) (CgS (utf8 "} }\n")))
    (cg_cat4 (cg_ind (+ ind 1))
      (cg_cat3 (CgS (utf8 "default: return ")) (cg_trap cx) (CgS (utf8 ";\n")))
      (cg_ind ind)
      (CgS (utf8 "} }\n"))))
  (if hasdef (CgCat (cg_ind ind) (CgS (utf8 "}\n")))
  (cg_cat4 (cg_ind (+ ind 1)) (cg_cat3 (CgS (utf8 "return ")) (cg_trap cx) (CgS (utf8 ";\n")))
    (cg_ind ind)
    (CgS (utf8 "}\n"))))))
(fn cg_arms ((arms (List EArm)) (env (List (List Int))) (sn (List Int)) (cx CgCx) (ind Int) (k Int))
  CgR
  (measure (* 2 (List_EArm.size arms)))
  (match arms
    (nil (CgOk (CgS (utf8 ""))))
    ((cons (EArm p body) r)
     (match (cg_arm p body env sn cx ind k)
       ((CgErr m) (CgErr m))
       ((CgOk d)
        (match (cg_arms r env sn cx ind k)
          ((CgErr m) (CgErr m))
          ((CgOk dr) (CgOk (CgCat d dr)))))))))
;; one arm; a constructor's fields are bound in order, the last one innermost
(fn cg_arm
  ((p EPat) (body ETerm) (env (List (List Int))) (sn (List Int)) (cx CgCx) (ind Int) (k Int))
  CgR
  (measure (+ (* 2 (ETerm.size body)) 1))
  (match p
    ((PCtor c ps)
     (if (bool_not (cg_all_vars ps)) (CgErr (utf8 "a nested pattern (not the restricted form)"))
     (match (cg_tag_of cx c)
       (none (CgErr (append (utf8 "an unknown constructor in a pattern: ") (show_name c))))
       ((some tag)
        (match (cg_tail body (cg_field_env ps sn env 0) cx (+ ind 1))
          ((CgErr m) (CgErr m))
          ((CgOk bd)
           (CgOk
             (cg_cat4 (cg_cat4 (cg_ind ind) (CgS (utf8 "case ")) (cg_num tag) (CgS (utf8 ": {\n")))
               (cg_field_decls ps sn (+ ind 1) 0)
               bd
               (CgCat (cg_ind ind) (CgS (utf8 "}\n")))))))))))
    ((PLit (LStr _)) (CgErr (utf8 "a string pattern (not the restricted form)")))
    ((PLit l)
     (let
       ((n Int
          (match l
            ((LNat v) v)
            ((LInt v) v)
            (_ 0))))
       ;; a C case label is a small integer; a larger scrutinee takes the default
       (if (bool_not (bool_and (<= -4611686018427387904 n) (<= n 4611686018427387903)))
         (CgErr (utf8 "a numeral pattern outside the runtime's small integers"))
         (match (cg_tail body env cx (+ ind 1))
           ((CgErr m) (CgErr m))
           ((CgOk bd)
            (CgOk
              (cg_cat4 (cg_cat4 (cg_ind ind) (CgS (utf8 "case ")) (cg_num n) (CgS (utf8 "LL: {\n")))
                bd
                (CgCat (cg_ind ind) (CgS (utf8 "}\n")))
                (CgS (utf8 "")))))))))
    (PVar
      (match (cg_tail body (cons sn env) cx (+ ind 1))
        ((CgErr m) (CgErr m))
        ((CgOk bd)
         (if (bool_or (= k 1) (= k 2))
           (CgOk
             (cg_cat4 (CgCat (cg_ind ind) (CgS (utf8 "default: {\n"))) bd
               (CgCat (cg_ind ind) (CgS (utf8 "}\n")))
               (CgS (utf8 ""))))
           (CgOk bd)))))))
(fn cg_all_vars ((ps (List EPat))) Bool
  (measure (List.length ps))
  (match ps
    (nil true)
    ((cons PVar r) (cg_all_vars r))
    (_ false)))
(fulfills cg_all_vars.dec_1 (by (intro ps r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_field ((sn (List Int)) (i Int)) (List Int) (append sn (append (utf8 "f") (show_nat i))))
(fn cg_field_env ((ps (List EPat)) (sn (List Int)) (env (List (List Int))) (i Int))
  (List (List Int))
  (measure (List.length ps))
  (match ps
    (nil env)
    ((cons _ r) (cg_field_env r sn (cons (cg_field sn i) env) (+ i 1)))))
(fulfills cg_field_env.dec_1 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_field_decls ((ps (List EPat)) (sn (List Int)) (ind Int) (i Int)) CgDoc
  (measure (List.length ps))
  (match ps
    (nil (CgS (utf8 "")))
    ((cons _ r)
     (cg_cat4
       (cg_cat4 (cg_ind ind) (CgS (utf8 "value_t ")) (CgS (cg_field sn i)) (CgS (utf8 " = ")))
       (cg_cat3 (CgS (utf8 "rt_field(")) (CgS sn) (CgS (utf8 ", ")))
       (cg_cat3 (cg_num i) (CgS (utf8 ");\n")) (cg_field_decls r sn ind (+ i 1)))
       (CgS (utf8 ""))))))

(fulfills cg_field_decls.dec_1 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_tail.dec_1
  (by (intro t env cx ind r body h rd hr) (rw h) (rw ETerm.size.eq_8) (arith)))
(fulfills cg_tail.dec_2 (by (intro t env cx ind c a b h cd hc) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills cg_tail.dec_3
  (by (intro t env cx ind c a b h cd hc ad) (rw h) (rw ETerm.size.eq_9) (arith)))
(fulfills cg_tail.dec_4 (by (intro t env cx ind s arms h) (rw h) (rw ETerm.size.eq_7) (arith)))
(fulfills cg_match.dec_1
  (by
    (intro s arms env cx ind sd hs)
    (show (< (* 2 (List_EArm.size arms)) (+ (* 2 (List_EArm.size arms)) 1)))
    (arith)))
(fulfills cg_arms.dec_1
  (by
    (intro arms env sn cx ind k p body r h)
    (rw h)
    (rw List_EArm.size.eq_2)
    (rw EArm.size.eq_1)
    (arith)))
(fulfills cg_arms.dec_2
  (by (intro arms env sn cx ind k p body r h d) (rw h) (rw List_EArm.size.eq_2) (arith)))
(fulfills cg_arm.dec_1 (by (intro p body env sn cx ind k c ps h hv tag ht) (arith)))
(fulfills cg_arm.dec_2 (by (intro p body env sn cx ind k l h hn) (arith)))
(fulfills cg_arm.dec_3 (by (intro p body env sn cx ind k h) (arith)))
;; ---- a function: fi is its place in the counters' table ---------------------------------------
(fn cg_params ((n Int) (i Int)) CgDoc
  (measure (Int.natAbs (- n i)))
  (if (<= n i) (CgS nil)
  (cg_cat4 (if (= i 0) (CgS nil) (CgS (utf8 ", "))) (CgS (utf8 "value_t p_")) (cg_num i)
    (cg_params n (+ i 1)))))
(fulfills cg_params.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))
;; the parameters' C names innermost first: p_{n-1} … p_0
(fn cg_param_env ((n Int)) (List (List Int))
  (measure (Int.natAbs n))
  (if (< n 1) nil (cons (append (utf8 "p_") (show_nat (- n 1))) (cg_param_env (- n 1)))))
(fulfills cg_param_env.dec_1 (by (intro n h) (apply natAbs_pred (arith))))
(fn cg_proto ((n Name) (np Int)) CgDoc
  (cg_cat4 (cg_cat3 (CgS (utf8 "value_t ")) (CgS (cg_fname n)) (CgS (utf8 "("))) (cg_params np 0)
    (CgS (utf8 ");\n"))
    (CgS (utf8 ""))))
;; the counter's increment sits after start_: so a self tail call counts as a call
(fn cg_fn
  ((n Name) (np Int) (body ETerm) (tags (IntMap (List (Prod Name (Prod Int Int))))) (fi Int))
  CgR
  (match (cg_tail body (cg_param_env np) (CgCx tags n np) 1)
    ((CgErr m) (CgErr (append m (append (utf8 " in ") (show_name n)))))
    ((CgOk bd)
     (CgOk
       (cg_cat4
         (cg_cat3 (cg_cat3 (CgS (utf8 "value_t ")) (CgS (cg_fname n)) (CgS (utf8 "(")))
           (cg_params np 0)
           (cg_cat3 (CgS (utf8 ") {\nstart_:;\nrt_fnctr_g[")) (cg_num fi) (CgS (utf8 "]++;\n"))))
         bd
         (CgS (utf8 "}\n\n"))
         (CgS (utf8 "")))))))

;; ---- the files ---------------------------------------------------------------------------
;; the functions of one part file
(fn cg_part () Int 400)
;; what every unit opens with
(fn cg_unit_head () (List Int) (utf8 "#include \"prog.h\"\n"))
(fn cg_part_name ((i Int)) (List Int)
  (append (utf8 "p")
    (append
      (if (< i 10) (utf8 "000")
      (if (< i 100) (utf8 "00")
      (if (< i 1000) (utf8 "0")
      nil)))
      (append (show_nat i) (utf8 ".c")))))
;; the state of the walk over the functions: the finished parts (newest first), the current
;; part's text and count, the next function's index, the refusals (newest first)
(type CgSt (CgSt (List (Prod (List Int) (List Int))) CgDoc Int Int (List (List Int))))
(fn cg_fns ((ds (List EDecl)) (tags (IntMap (List (Prod Name (Prod Int Int))))) (st CgSt)) CgSt
  (measure (List.length ds))
  (match ds
    (nil (cg_flush st))
    ((cons (EFn n _ ps _ _ body) r)
     (match st
       ((CgSt parts cur k fi errs)
        (match (cg_fn n (len ps) body tags fi)
          ((CgErr m) (cg_fns r tags (CgSt parts cur k (+ fi 1) (cons m errs))))
          ((CgOk d)
           (let ((st1 (CgSt.CgSt parts (CgCat cur d) (+ k 1) (+ fi 1) errs)))
             (cg_fns r tags (if (<= (cg_part) (+ k 1)) (cg_flush st1) st1))))))))
    ((cons _ r) (cg_fns r tags st))))
(fn cg_flush ((st CgSt)) CgSt
  (match st
    ((CgSt parts cur k fi errs)
     (if (< k 1) st
     (CgSt
       (cons (Prod.mk (cg_part_name (len parts)) (append (cg_unit_head) (cg_flat cur nil))) parts)
       (CgS nil)
       0
       fi
       errs)))))
(fulfills cg_fns.dec_1
  (by
    (intro p n w1 ps w2 w3 body r h parts cur k fi errs hs m hm)
    (rw h)
    (rw List.length_cons)
    (arith)))
(fulfills cg_fns.dec_2
  (by
    (intro p n w1 ps w2 w3 body r h parts cur k fi errs hs d hd)
    (rw h)
    (rw List.length_cons)
    (show (< (List.length r) (+ (List.length r) 1)))
    (arith)))
(fulfills cg_fns.dec_3 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_protos ((ds (List EDecl))) CgDoc
  (measure (List.length ds))
  (match ds
    (nil (CgS (utf8 "")))
    ((cons (EFn n _ ps _ _ _) r) (CgCat (cg_proto n (len ps)) (cg_protos r)))
    ((cons _ r) (cg_protos r))))
(fulfills cg_protos.dec_1 (by (intro ds n w1 ps w2 w3 w4 r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_protos.dec_2 (by (intro ds w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_fnnames ((ds (List EDecl))) CgDoc
  (measure (List.length ds))
  (match ds
    (nil (CgS (utf8 "")))
    ((cons (EFn n _ _ _ _ _) r)
     (cg_cat4 (CgS (utf8 "  \"")) (CgS (cg_cstr (show_name n))) (CgS (utf8 "\",\n")) (cg_fnnames r)))
    ((cons _ r) (cg_fnnames r))))
(fulfills cg_fnnames.dec_1
  (by (intro ds n w1 w2 w3 w4 w5 r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_fnnames.dec_2 (by (intro ds w r h) (rw h) (rw List.length_cons) (arith)))
(fn cg_count_fns ((ds (List EDecl)) (k Int)) Int
  (measure (List.length ds))
  (match ds
    (nil k)
    ((cons (EFn _ _ _ _ _ _) r) (cg_count_fns r (+ k 1)))
    ((cons _ r) (cg_count_fns r k))))
(fulfills cg_count_fns.dec_1
  (by (intro p w1 w2 w3 w4 w5 w6 r h) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_count_fns.dec_2 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
;; the entry's refusal: `main` calls it on the World alone, so it is a function of one
;; parameter. What the loader's `--run` reads from the arguments into the parameters before
;; the World has no source in a binary
(fn cg_entry_err ((ds (List EDecl)) (n Name)) (Option (List Int))
  (measure (List.length ds))
  (match ds
    (nil (some (append (utf8 "no fn ") (append (show_name n) (utf8 " to start from")))))
    ((cons (EFn m _ ps _ _ _) r)
     (if (bool_not (name_eq m n)) (cg_entry_err r n)
     (if (= (len ps) 1) none
     (some
       (append (show_name n)
         (if (< (len ps) 1) (utf8 " takes no parameter: a binary's main takes the World")
         (append (utf8 " takes ")
           (append (show_nat (len ps))
             (utf8
               " parameters: a binary's main takes the World alone (a main with parameters before the World runs under the loader's --run only)")))))))))
    ((cons _ r) (cg_entry_err r n))))
(fulfills cg_entry_err.dec_1
  (by (intro p m w1 ps w2 w3 w4 r h hm) (rw h) (rw List.length_cons) (arith)))
(fulfills cg_entry_err.dec_2 (by (intro p w r h) (rw h) (rw List.length_cons) (arith)))
;; the roles' tags under the names rt.h reads them by
(fn cg_tag_defs () CgDoc
  (cg_tag_def (utf8 "True") 1
    (cg_tag_def (utf8 "False") 2
      (cg_tag_def (utf8 "Nil") 3
        (cg_tag_def (utf8 "Cons") 4
          (cg_tag_def (utf8 "None") 5
            (cg_tag_def (utf8 "Some") 6
              (cg_tag_def (utf8 "Pair") 7 (cg_tag_def (utf8 "World") 8 (CgS nil))))))))))
(fn cg_tag_def ((cell (List Int)) (role Int) (rest CgDoc)) CgDoc
  (cg_cat4 (cg_cat3 (CgS (utf8 "#define RT_TAG_")) (CgS cell) (CgS (utf8 " ")))
    (cg_num (cg_role_tag role))
    (CgS (utf8 "\n"))
    rest))
;; the counters, a slot a function: declared for every unit, and in main.c with the names
(fn cg_counters_decl ((nfn Int)) CgDoc
  (cg_cat3 (CgS (utf8 "extern long long rt_fnctr_g[")) (cg_num (if (< nfn 1) 1 nfn))
    (CgS (utf8 "];\n"))))
(fn cg_counters ((ds (List EDecl)) (nfn Int)) CgDoc
  (cg_cat4
    (cg_cat3 (CgS (utf8 "long long rt_fnctr_g[")) (cg_num (if (< nfn 1) 1 nfn)) (CgS (utf8 "];\n")))
    (cg_cat3 (CgS (utf8 "static const char *const rt_fnname_g[")) (cg_num (if (< nfn 1) 1 nfn))
      (CgS (utf8 "] = {\n")))
    (cg_fnnames ds)
    (CgS (if (< nfn 1) (utf8 "  \"\"\n};\n\n") (utf8 "};\n\n")))))
;; main: the counters bound, the runtime started, the entry called on the World
(fn cg_main ((entry Name) (world (Option Int)) (nfn Int)) CgDoc
  (cg_cat3
    (cg_cat3
      (CgS (utf8 "int main(int argc, char **argv) {\n  rt_stats_bind(rt_fnctr_g, rt_fnname_g, "))
      (cg_num nfn)
      (CgS (utf8 ");\n  rt_init(argc, argv);\n")))
    (match world
      (none (cg_cat3 (CgS (utf8 "  ")) (CgS (cg_fname entry)) (CgS (utf8 "(rt_unit_world);\n"))))
      ((some a)
       (if (< a 1)
         (cg_cat3 (CgS (utf8 "  ")) (CgS (cg_fname entry))
           (CgS (utf8 "(rt_alloc(RT_TAG_World, 0));\n")))
         (cg_cat3
           (CgS
             (utf8
               "  { value_t w = rt_alloc(RT_TAG_World, 1); rt_cellof(w)->fields[0] = rt_tag_int(0); "))
           (CgS (cg_fname entry))
           (CgS (utf8 "(w); }\n"))))))
    (CgS (utf8 "  return 0;\n}\n"))))

;; a program in the restricted form and its entry: the files — `main.c`, `prog.h`, the parts —
;; and the count of functions; or every refusal
(type CgRes (CgFiles (List (Prod (List Int) (List Int))) Int) (CgRefused (List (List Int))))
(fn cg_prog ((p Prog) (entry Name)) CgRes
  (match p
    ((Prog ds)
     (match (cg_entry_err ds entry)
       ((some m) (CgRefused (list m)))
       (none
         (let ((tags (cg_tags ds IMEmpty 1000)) (nfn (cg_count_fns ds 0)))
           (match (cg_fns ds tags (CgSt nil (CgS (utf8 "")) 0 0 (cg_ctor_errs ds nil)))
             ((CgSt parts _ _ _ errs)
              (match errs
                ((cons _ _) (CgRefused (rev errs)))
                (nil
                  (let ((ps (rev parts)))
                    (CgFiles
                      (cons
                        (Prod.mk (utf8 "main.c")
                          (cg_flat
                            (cg_cat4
                              (CgS
                                (utf8
                                  "/* GENERATED by v3/kernel/cgen.shard — do not edit. */\n#define RT_MAIN\n"))
                              (CgCat (CgS (cg_unit_head)) (CgS (utf8 "\n")))
                              (cg_counters ds nfn)
                              (cg_main entry (cg_world ds) nfn))
                            nil))
                        (cons
                          (Prod.mk (utf8 "prog.h")
                            (cg_flat
                              (cg_cat3
                                (cg_cat3
                                  (CgS
                                    (utf8
                                      "/* GENERATED by v3/kernel/cgen.shard — do not edit. */\n"))
                                  (cg_tag_defs)
                                  (cg_cat3
                                    (CgS (utf8 "#include \"rt.h\"\n_Static_assert(RT_MAX_ARITY == "))
                                    (cg_num (cg_max_fields))
                                    (CgS
                                      (utf8
                                        ", \"the generator's bound on a cell's fields is the runtime's\");\n\n"))))
                                (CgCat (cg_counters_decl nfn) (CgS (utf8 "\n")))
                                (cg_protos ds))
                              nil))
                          ps))
                      nfn))))))))))))
