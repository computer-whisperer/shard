;;; v3/kernel/initload.shard — the Init load on demand:
;;; the export opened by its index (index.shard), names looked up, the
;;; closure of a set of declarations walked by range reads and fed to K as a sub-stream
;;; in export order. The walk: the demanded records' ordinals are pending; the blocks
;;; to read are scheduled highest first; a block is read once, its lines scanned from
;;; its record line backwards, and every pending line parsed — its name, level and
;;; expression ids pushed (a child always precedes its parent: in the same block it
;;; comes later in the scan, in an earlier block it schedules that block), a constant
;;; it cites resolved by its name id through the declaration table to the record
;;; declaring it, which is pushed. What was extracted comes out newest first — export
;;; order reversed when no push went upward, sorted by offset otherwise — and goes
;;; through K's process_record: node lines into K's tables (sparse: the ids stay the
;;; export's), records checked — on a fresh run over the environment the caller gives
;;; (K's run_on): the environment is the caller's own, extended, and no second one
;;; stands beside it. The tables are a
;;; feed's: what persists is the record of the records an environment holds (OdDone's
;;; ordinals), so a record is checked once into an environment and a node line is fed
;;; again to every feed whose records need it.
;;; The export's meta line is checked against the pin before anything is read; an
;;; index whose header names another byte count is refused.

(import "host.shard")
(import "json.shard")
(import "intmap.shard")
(import "name.shard")
(import "util.shard")
(import "index.shard")
(import "k")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.descent)
(use kernel.host)
(use kernel.json)
(use kernel.intmap)
(use kernel.index)
(use kernel.name)
(use kernel.sym)
(use kernel.util)
(use kernel.host.World)
(use kernel.index.IxHdr)
(use kernel.index.IxRow)
(use kernel.json.JRes)
(use kernel.intmap.IntMap)
(use kernel.verdict.Verdict)

;; ---- the pin: the export's meta line must say so ----------------------------------------
(fn init_pin_githash () (List Int) (utf8 "819816b2e0a3bf405af45ae5c7af2491d8f5bee6"))
(fn init_pin_exporter () (List Int) (utf8 "lean4export"))
(fn init_pin_exporter_version () (List Int) (utf8 "3.1.0"))
(fn init_pin_format () (List Int) (utf8 "3.1.0"))
;; the first record must be the meta line matching the pin: None, or what differs
(fn od_check_meta ((bs (List Int))) (Option (List Int))
  (match (json_parse bs)
    (JErr (some (utf8 "the export's first record is not JSON")))
    ((JRes j _)
     (match (jget j (utf8 "meta"))
       (none (some (utf8 "the export's first record is not its meta line")))
       ((some m)
        (let
          ((githash (od_jpath m (utf8 "lean") (utf8 "githash")))
           (exporter (od_jpath m (utf8 "exporter") (utf8 "name")))
           (exv (od_jpath m (utf8 "exporter") (utf8 "version")))
           (fmt (od_jpath m (utf8 "format") (utf8 "version"))))
          (if (bool_not (od_opt_str_eq githash (init_pin_githash)))
            (some
              (append (utf8 "lean githash ")
                (append (od_show_opt_str githash) (append (utf8 ", the pin is ") (init_pin_githash)))))
          (if (bool_not (od_opt_str_eq exporter (init_pin_exporter)))
            (some (append (utf8 "exporter ") (od_show_opt_str exporter)))
          (if (bool_not (od_opt_str_eq exv (init_pin_exporter_version)))
            (some
              (append (utf8 "exporter version ")
                (append (od_show_opt_str exv)
                  (append (utf8 ", the pin is ") (init_pin_exporter_version)))))
          (if (bool_not (od_opt_str_eq fmt (init_pin_format)))
            (some
              (append (utf8 "format version ")
                (append (od_show_opt_str fmt) (append (utf8 ", the pin is ") (init_pin_format)))))
            none))))))))))
(fn od_jpath ((j Json) (a (List Int)) (b (List Int))) (Option (List Int))
  (match (jget j a)
    ((some x)
     (match (jget x b)
       ((some y) (jstr y))
       (none none)))
    (none none)))
(fn od_opt_str_eq ((o (Option (List Int))) (s (List Int))) Bool
  (match o
    ((some x) (int_list_eq x s))
    (none false)))
(fn od_show_opt_str ((o (Option (List Int)))) (List Int)
  (match o
    ((some x) x)
    (none (utf8 "(missing)"))))

;; ---- the export opened ------------------------------------------------------------------------
;; the export's path, the index's path and header, the record-table rows read so far (by
;; ordinal), the lookups made (by key: the name and its ordinal, -1 for none), the name rows
;; the search's top levels read (by row), whether the export declares anything under a prefix
(type OdIx
  (OdIx (List Int) (List Int) IxHdr (IntMap IxRow) (IntMap (List (Prod Name Int)))
    (IntMap (List Int))
    (IntMap (List (Prod Name Bool)))))
(fn odx_export ((x OdIx)) (List Int)
  (match x
    ((OdIx a _ _ _ _ _ _) a)))
(fn odx_index ((x OdIx)) (List Int)
  (match x
    ((OdIx _ a _ _ _ _ _) a)))
(fn odx_hdr ((x OdIx)) IxHdr
  (match x
    ((OdIx _ _ a _ _ _ _) a)))
(fn odx_rows ((x OdIx)) (IntMap IxRow)
  (match x
    ((OdIx _ _ _ a _ _ _) a)))
(fn odx_memo ((x OdIx)) (IntMap (List (Prod Name Int)))
  (match x
    ((OdIx _ _ _ _ a _ _) a)))
(fn odx_nrows ((x OdIx)) (IntMap (List Int))
  (match x
    ((OdIx _ _ _ _ _ a _) a)))
(fn odx_pmemo ((x OdIx)) (IntMap (List (Prod Name Bool)))
  (match x
    ((OdIx _ _ _ _ _ _ a) a)))
(fn odx_set_rows ((x OdIx) (v (IntMap IxRow))) OdIx
  (match x
    ((OdIx f0 f1 f2 _ f4 f5 f6) (OdIx f0 f1 f2 v f4 f5 f6))))
(fn odx_set_memo ((x OdIx) (v (IntMap (List (Prod Name Int))))) OdIx
  (match x
    ((OdIx f0 f1 f2 f3 _ f5 f6) (OdIx f0 f1 f2 f3 v f5 f6))))
(fn odx_set_nrows ((x OdIx) (v (IntMap (List Int)))) OdIx
  (match x
    ((OdIx f0 f1 f2 f3 f4 _ f6) (OdIx f0 f1 f2 f3 f4 v f6))))
(fn odx_set_pmemo ((x OdIx) (v (IntMap (List (Prod Name Bool))))) OdIx
  (match x
    ((OdIx f0 f1 f2 f3 f4 f5 _) (OdIx f0 f1 f2 f3 f4 f5 v))))
(fn odx0 ((export (List Int)) (index (List Int)) (h IxHdr)) OdIx
  (OdIx export index h IMEmpty IMEmpty IMEmpty IMEmpty))
(fn odx_records ((x OdIx)) Int (ix_hdr_records (odx_hdr x)))
;; what K has been fed: the name, level and expression ids of the feed under way (a feed's
;; tables are its own run's) and the record ordinals the environment holds
(type OdDone (OdDone (IntMap Bool) (IntMap Bool) (IntMap Bool) (IntMap Bool)))
(fn odd_names ((x OdDone)) (IntMap Bool)
  (match x
    ((OdDone a _ _ _) a)))
(fn odd_levels ((x OdDone)) (IntMap Bool)
  (match x
    ((OdDone _ a _ _) a)))
(fn odd_exprs ((x OdDone)) (IntMap Bool)
  (match x
    ((OdDone _ _ a _) a)))
(fn odd_recs ((x OdDone)) (IntMap Bool)
  (match x
    ((OdDone _ _ _ a) a)))
(fn odd_set_names ((x OdDone) (v (IntMap Bool))) OdDone
  (match x
    ((OdDone _ f1 f2 f3) (OdDone v f1 f2 f3))))
(fn odd_set_levels ((x OdDone) (v (IntMap Bool))) OdDone
  (match x
    ((OdDone f0 _ f2 f3) (OdDone f0 v f2 f3))))
(fn odd_set_exprs ((x OdDone) (v (IntMap Bool))) OdDone
  (match x
    ((OdDone f0 f1 _ f3) (OdDone f0 f1 v f3))))
(fn odd_set_recs ((x OdDone) (v (IntMap Bool))) OdDone
  (match x
    ((OdDone f0 f1 f2 _) (OdDone f0 f1 f2 v))))
(fn odd0 () OdDone (OdDone IMEmpty IMEmpty IMEmpty IMEmpty))
;; the records held, a feed's node ids forgotten: what a feed starts from and what it leaves
(fn odd_records ((d OdDone)) OdDone (OdDone IMEmpty IMEmpty IMEmpty (odd_recs d)))
(fn odd_has ((d OdDone) (kind Int) (id Int)) Bool
  (if (= kind 0) (im_has (odd_names d) id)
  (if (= kind 1) (im_has (odd_levels d) id)
  (if (= kind 2) (im_has (odd_exprs d) id)
  (im_has (odd_recs d) id)))))
(fn odd_add ((d OdDone) (kind Int) (id Int)) OdDone
  (if (= kind 0) (odd_set_names d (im_insert (odd_names d) id true))
  (if (= kind 1) (odd_set_levels d (im_insert (odd_levels d) id true))
  (if (= kind 2) (odd_set_exprs d (im_insert (odd_exprs d) id true))
  (odd_set_recs d (im_insert (odd_recs d) id true))))))

(type OdOpen (OdOpened OdIx) (OdOpenErr Symbol (List Int)))
;; the export and its index opened: the meta line against the pin, the index's header,
;; the export's size the header's
(fn od_open ((export (List Int)) (index (List Int)) (w World)) (Prod OdOpen World)
  (match (read_range export 0 4096 w)
    ((Prod.mk none w1) (Prod.mk (OdOpenErr (sym "missing_file") (utf8 "the export")) w1))
    ((Prod.mk (some bs) w1)
     (match (od_check_meta bs)
       ((some msg) (Prod.mk (OdOpenErr (sym "export_pin_mismatch") msg) w1))
       (none
         (match (ix_read_header index w1)
           ((Prod.mk none w2)
            (Prod.mk
              (OdOpenErr (sym "init_index_stale")
                (append (utf8 "no index at ") (append index (utf8 " (kernel/test/init_index.sh)"))))
              w2))
           ((Prod.mk (some h) w2)
            (match (ix_verify_size export (ix_hdr_bytes h) w2)
              ((Prod.mk false w3)
               (Prod.mk
                 (OdOpenErr (sym "init_index_stale")
                   (append (utf8 "the index is over an export of ")
                     (append (show_nat (ix_hdr_bytes h))
                       (utf8 " bytes; rebuild it (kernel/test/init_index.sh)"))))
                 w3))
              ((Prod.mk true w3) (Prod.mk (OdOpened (odx0 export index h)) w3))))))))))

;; a name's ordinal in the export, None when Init declares no such constant; memoized, the
;; binary search's top ten levels of name rows cached (the rows every search reads)
(fn od_lookup ((x OdIx) (nm Name) (w World)) (Prod (Prod OdIx (Option Int)) World)
  (let ((k (name_key nm)))
    (match
      (od_memo_find
        (match (im_find (odx_memo x) k)
          ((some b) b)
          (none nil))
        nm)
      ((some o) (Prod.mk (Prod.mk x (if (< o 0) none (some o))) w))
      (none
        (match
          (od_search x (ix_pad (show_name nm) (ix_name_w)) 0 (- (ix_hdr_names (odx_hdr x)) 1) 0 64 w)
          ((Prod.mk (Prod.mk x1 r) w1)
           (let
             ((o Int
                (match r
                  ((some v) v)
                  (none -1))))
             (Prod.mk
               (Prod.mk
                 (odx_set_memo x1
                   (im_insert (odx_memo x1) k
                     (cons (Prod.mk nm o)
                       (match (im_find (odx_memo x1) k)
                         ((some b) b)
                         (none nil)))))
                 r)
               w1))))))))
(fn od_memo_find ((b (List (Prod Name Int))) (nm Name)) (Option Int)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk n o) r) (if (name_eq n nm) (some o) (od_memo_find r nm)))))
(fn od_nrow ((x OdIx) (k Int) (cache Bool) (w World)) (Prod (Prod OdIx (Option (List Int))) World)
  (match (im_find (odx_nrows x) k)
    ((some row) (Prod.mk (Prod.mk x (some row)) w))
    (none
      (match (ix_read_nrow (odx_index x) (odx_hdr x) k w)
        ((Prod.mk none w1) (Prod.mk (Prod.mk x none) w1))
        ((Prod.mk (some row) w1)
         (Prod.mk
           (Prod.mk (if cache (odx_set_nrows x (im_insert (odx_nrows x) k row)) x) (some row))
           w1))))))
(fn od_search ((x OdIx) (key (List Int)) (lo Int) (hi Int) (depth Int) (fuel Int) (w World))
  (Prod (Prod OdIx (Option Int)) World)
  (measure (Int.natAbs fuel))
  (if (bool_or (<= fuel 0) (< hi lo)) (Prod.mk (Prod.mk x none) w)
  (let ((mid (/ (+ lo hi) 2)))
    (match (od_nrow x mid (< depth 10) w)
      ((Prod.mk (Prod.mk x1 none) w1) (Prod.mk (Prod.mk x1 none) w1))
      ((Prod.mk (Prod.mk x1 (some row)) w1)
       (let ((k (take (ix_name_w) row)))
         (if (int_list_eq k key) (Prod.mk (Prod.mk x1 (ix_field row (+ (ix_name_w) 1) 8)) w1)
         (if (int_list_lt k key) (od_search x1 key (+ mid 1) hi (+ depth 1) (- fuel 1) w1)
         (od_search x1 key lo (- mid 1) (+ depth 1) (- fuel 1) w1)))))))))
(fulfills od_search.dec_1
  (by
    (intro p h x1 row w1 hm he hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
(fulfills od_search.dec_2
  (by
    (intro p h x1 row w1 hm he hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
;; does the export declare anything under the prefix (a name rendering as `P.…`)? memoized
(fn od_has_under ((x OdIx) (p Name) (w World)) (Prod (Prod OdIx Bool) World)
  (let ((k (name_key p)))
    (match
      (od_pmemo_find
        (match (im_find (odx_pmemo x) k)
          ((some b) b)
          (none nil))
        p)
      ((some b) (Prod.mk (Prod.mk x b) w))
      (none
        (let ((prefix (append (show_name p) (utf8 "."))))
          (match (ix_lower (odx_index x) (odx_hdr x) prefix 0 (ix_hdr_names (odx_hdr x)) 64 w)
            ((Prod.mk i w1)
             (match (ix_read_nrow (odx_index x) (odx_hdr x) i w1)
               ((Prod.mk row w2)
                (let
                  ((b Bool
                     (match row
                       ((some r) (ix_starts r prefix))
                       (none false))))
                  (Prod.mk
                    (Prod.mk
                      (odx_set_pmemo x
                        (im_insert (odx_pmemo x) k
                          (cons (Prod.mk p b)
                            (match (im_find (odx_pmemo x) k)
                              ((some bb) bb)
                              (none nil)))))
                      b)
                    w2)))))))))))
(fn od_pmemo_find ((b (List (Prod Name Bool))) (nm Name)) (Option Bool)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk n v) r) (if (name_eq n nm) (some v) (od_pmemo_find r nm)))))
;; every declared name rendering with the prefix, as rendered
(fn od_names_under ((x OdIx) (prefix (List Int)) (w World)) (Prod (List (List Int)) World)
  (ix_names_under (odx_index x) (odx_hdr x) prefix w))
;; record row k, cached
(fn od_row ((x OdIx) (k Int) (w World)) (Prod (Prod OdIx (Option IxRow)) World)
  (match (im_find (odx_rows x) k)
    ((some r) (Prod.mk (Prod.mk x (some r)) w))
    (none
      (match (ix_read_row (odx_index x) (odx_hdr x) k w)
        ((Prod.mk none w1) (Prod.mk (Prod.mk x none) w1))
        ((Prod.mk (some r) w1)
         (Prod.mk (Prod.mk (odx_set_rows x (im_insert (odx_rows x) k r)) (some r)) w1))))))
;; the kind byte of ordinal k's record: a d t o i q, 0 when there is no such row
(fn od_kind_of ((x OdIx) (k Int) (w World)) (Prod (Prod OdIx Int) World)
  (match (od_row x k w)
    ((Prod.mk (Prod.mk x1 (some r)) w1) (Prod.mk (Prod.mk x1 (ix_row_kind r)) w1))
    ((Prod.mk (Prod.mk x1 none) w1) (Prod.mk (Prod.mk x1 0) w1))))
;; the ordinal of the block holding the id (which: 0 name, 1 level, 2 expression): the last
;; row whose first id is at most it, the rows cached
(fn od_block_of ((x OdIx) (which Int) (id Int) (w World)) (Prod (Prod OdIx (Option Int)) World)
  (od_block_search x which id 0 (- (odx_records x) 1) -1 64 w))
(fn od_block_search
  ((x OdIx) (which Int) (id Int) (lo Int) (hi Int) (best Int) (fuel Int) (w World))
  (Prod (Prod OdIx (Option Int)) World)
  (measure (Int.natAbs fuel))
  (if (bool_or (<= fuel 0) (< hi lo)) (Prod.mk (Prod.mk x (if (< best 0) none (some best))) w)
  (let ((mid (/ (+ lo hi) 2)))
    (match (od_row x mid w)
      ((Prod.mk (Prod.mk x1 none) w1) (Prod.mk (Prod.mk x1 none) w1))
      ((Prod.mk (Prod.mk x1 (some row)) w1)
       (if (<= (ix_row_first row which) id)
         (od_block_search x1 which id (+ mid 1) hi mid (- fuel 1) w1)
         (od_block_search x1 which id lo (- mid 1) best (- fuel 1) w1)))))))
(fulfills od_block_search.dec_1
  (by
    (intro p h x1 row w1 hm hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))
(fulfills od_block_search.dec_2
  (by
    (intro p h x1 row w1 hm hl)
    (apply natAbs_pred ((intro hc) (apply h ((rw decide_eq_true (arith)) rfl))))))

;; ---- the walk ----------------------------------------------------------------------------------
;; a line extracted: its byte offset, the ordinal of the record it is (-1: a node line), its bytes
(type OdLine (OdLine Int Int (List Int)))
;; the pending name, level and expression ids and record ordinals (not yet extracted), the
;; blocks scheduled (descending, no duplicate), the lines extracted newest first, the last
;; offset extracted, whether the offsets came out descending, the first failure
(type OdWalk
  (OdWalk (IntMap Bool) (IntMap Bool) (IntMap Bool) (IntMap Bool) (List Int) (List OdLine) Int Bool
    (List Int)))
(fn odw_pn ((x OdWalk)) (IntMap Bool)
  (match x
    ((OdWalk a _ _ _ _ _ _ _ _) a)))
(fn odw_pl ((x OdWalk)) (IntMap Bool)
  (match x
    ((OdWalk _ a _ _ _ _ _ _ _) a)))
(fn odw_pe ((x OdWalk)) (IntMap Bool)
  (match x
    ((OdWalk _ _ a _ _ _ _ _ _) a)))
(fn odw_pr ((x OdWalk)) (IntMap Bool)
  (match x
    ((OdWalk _ _ _ a _ _ _ _ _) a)))
(fn odw_sched ((x OdWalk)) (List Int)
  (match x
    ((OdWalk _ _ _ _ a _ _ _ _) a)))
(fn odw_out ((x OdWalk)) (List OdLine)
  (match x
    ((OdWalk _ _ _ _ _ a _ _ _) a)))
(fn odw_last ((x OdWalk)) Int
  (match x
    ((OdWalk _ _ _ _ _ _ a _ _) a)))
(fn odw_sorted ((x OdWalk)) Bool
  (match x
    ((OdWalk _ _ _ _ _ _ _ a _) a)))
(fn odw_bad ((x OdWalk)) (List Int)
  (match x
    ((OdWalk _ _ _ _ _ _ _ _ a) a)))
(fn odw_set_pn ((x OdWalk) (v (IntMap Bool))) OdWalk
  (match x
    ((OdWalk _ f1 f2 f3 f4 f5 f6 f7 f8) (OdWalk v f1 f2 f3 f4 f5 f6 f7 f8))))
(fn odw_set_pl ((x OdWalk) (v (IntMap Bool))) OdWalk
  (match x
    ((OdWalk f0 _ f2 f3 f4 f5 f6 f7 f8) (OdWalk f0 v f2 f3 f4 f5 f6 f7 f8))))
(fn odw_set_pe ((x OdWalk) (v (IntMap Bool))) OdWalk
  (match x
    ((OdWalk f0 f1 _ f3 f4 f5 f6 f7 f8) (OdWalk f0 f1 v f3 f4 f5 f6 f7 f8))))
(fn odw_set_pr ((x OdWalk) (v (IntMap Bool))) OdWalk
  (match x
    ((OdWalk f0 f1 f2 _ f4 f5 f6 f7 f8) (OdWalk f0 f1 f2 v f4 f5 f6 f7 f8))))
(fn odw_set_sched ((x OdWalk) (v (List Int))) OdWalk
  (match x
    ((OdWalk f0 f1 f2 f3 _ f5 f6 f7 f8) (OdWalk f0 f1 f2 f3 v f5 f6 f7 f8))))
(fn odw_set_out ((x OdWalk) (v (List OdLine))) OdWalk
  (match x
    ((OdWalk f0 f1 f2 f3 f4 _ f6 f7 f8) (OdWalk f0 f1 f2 f3 f4 v f6 f7 f8))))
(fn odw_set_last ((x OdWalk) (v Int)) OdWalk
  (match x
    ((OdWalk f0 f1 f2 f3 f4 f5 _ f7 f8) (OdWalk f0 f1 f2 f3 f4 f5 v f7 f8))))
(fn odw_set_sorted ((x OdWalk) (v Bool)) OdWalk
  (match x
    ((OdWalk f0 f1 f2 f3 f4 f5 f6 _ f8) (OdWalk f0 f1 f2 f3 f4 f5 f6 v f8))))
(fn odw_set_bad ((x OdWalk) (v (List Int))) OdWalk
  (match x
    ((OdWalk f0 f1 f2 f3 f4 f5 f6 f7 _) (OdWalk f0 f1 f2 f3 f4 f5 f6 f7 v))))
(fn odw0 () OdWalk (OdWalk IMEmpty IMEmpty IMEmpty IMEmpty nil nil 1000000000000 true nil))
(fn odw_pending ((wk OdWalk) (kind Int) (id Int)) Bool
  (if (= kind 0) (im_has (odw_pn wk) id)
  (if (= kind 1) (im_has (odw_pl wk) id)
  (if (= kind 2) (im_has (odw_pe wk) id)
  (im_has (odw_pr wk) id)))))
(fn odw_mark ((wk OdWalk) (kind Int) (id Int) (v Bool)) OdWalk
  (if (= kind 0) (odw_set_pn wk (im_insert (odw_pn wk) id v))
  (if (= kind 1) (odw_set_pl wk (im_insert (odw_pl wk) id v))
  (if (= kind 2) (odw_set_pe wk (im_insert (odw_pe wk) id v))
  (odw_set_pr wk (im_insert (odw_pr wk) id v))))))
(fn odw_fail ((wk OdWalk) (msg (List Int))) OdWalk
  (match (odw_bad wk)
    ((cons _ _) wk)
    (nil (odw_set_bad wk msg))))
;; a block scheduled: descending, once
(fn odw_schedule ((wk OdWalk) (b Int)) OdWalk (odw_set_sched wk (od_sched_add (odw_sched wk) b)))
(fn od_sched_add ((s (List Int)) (b Int)) (List Int)
  (measure (struct s))
  (match s
    (nil (list b))
    ((cons x r)
     (if (= x b) s
     (if (< x b) (cons b s)
     (cons x (od_sched_add r b)))))))
;; a line extracted: newest first; the offsets descending unless a push went upward
(fn odw_extract ((wk OdWalk) (ln OdLine)) OdWalk
  (match ln
    ((OdLine off _ _)
     (odw_set_sorted (odw_set_last (odw_set_out wk (cons ln (odw_out wk))) off)
       (bool_and (odw_sorted wk) (< off (odw_last wk)))))))
(fn od_kind_name ((kind Int)) (List Int)
  (if (= kind 0) (utf8 "name")
  (if (= kind 1) (utf8 "level")
  (if (= kind 2) (utf8 "expression")
  (utf8 "record")))))

;; the ids a line refers to: names, levels, expressions, and the names of the constants it
;; cites (whose declarations are needed)
(type OdRefs (OdRefs (List Int) (List Int) (List Int) (List Int)))
(fn od_int ((o Json) (key (List Int))) (List Int)
  (match (jget o key)
    ((some v)
     (match (jint v)
       ((some i) (list i))
       (none nil)))
    (none nil)))
(fn od_ints ((o Json) (key (List Int))) (List Int)
  (match (jget o key)
    ((some v)
     (match (jarr v)
       ((some xs) (od_int_list xs nil))
       (none nil)))
    (none nil)))
(fn od_int_list ((xs (List Json)) (acc (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil (rev acc))
    ((cons x r)
     (od_int_list r
       (match (jint x)
         ((some i) (cons i acc))
         (none acc))))))
(fn od_sub_int ((j Json) (k1 (List Int)) (k2 (List Int))) (List Int)
  (match (jget j k1)
    ((some o) (od_int o k2))
    (none nil)))
(fn od_sub_ints ((j Json) (k1 (List Int)) (k2 (List Int))) (List Int)
  (match (jget j k1)
    ((some o) (od_ints o k2))
    (none nil)))
(fn od_objs ((o Json) (key (List Int))) (List Json)
  (match (jget o key)
    ((some v)
     (match (jarr v)
       ((some xs) xs)
       (none nil)))
    (none nil)))
;; the key's int or ints in each object
(fn od_each ((xs (List Json)) (key (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (append (od_int x key) (append (od_ints x key) (od_each r key))))))
(fn od_rules ((rs (List Json)) (key (List Int))) (List Int)
  (measure (struct rs))
  (match rs
    (nil nil)
    ((cons x r) (append (od_each (od_objs x (utf8 "rules")) key) (od_rules r key)))))
;; a record line's references
(fn od_record_refs ((j Json)) (Option OdRefs)
  (match (jkind_of_record j)
    (none none)
    ((some kind)
     (if (int_list_eq kind (utf8 "inductive"))
       (match (jget j (utf8 "inductive"))
         (none none)
         ((some o)
          (let
            ((ts (od_objs o (utf8 "types")))
             (cs (od_objs o (utf8 "ctors")))
             (rs (od_objs o (utf8 "recs"))))
            (some
              (OdRefs
                (append (od_each ts (utf8 "name"))
                  (append (od_each ts (utf8 "all"))
                    (append (od_each ts (utf8 "ctors"))
                      (append (od_each ts (utf8 "levelParams"))
                        (append (od_each cs (utf8 "name"))
                          (append (od_each cs (utf8 "induct"))
                            (append (od_each cs (utf8 "levelParams"))
                              (append (od_each rs (utf8 "name"))
                                (append (od_each rs (utf8 "all"))
                                  (append (od_each rs (utf8 "levelParams"))
                                    (od_rules rs (utf8 "ctor"))))))))))))
                nil
                (append (od_each ts (utf8 "type"))
                  (append (od_each cs (utf8 "type"))
                    (append (od_each rs (utf8 "type")) (od_rules rs (utf8 "rhs")))))
                nil)))))
       (match (jget j kind)
         (none none)
         ((some o)
          (some
            (OdRefs
              (append (od_int o (utf8 "name"))
                (append (od_ints o (utf8 "levelParams")) (od_ints o (utf8 "all"))))
              nil
              (append (od_int o (utf8 "type")) (od_int o (utf8 "value")))
              nil))))))))
;; a node line's references by its kind (0 name, 1 level, 2 expression)
(fn od_node_refs ((kind Int) (j Json)) OdRefs
  (if (= kind 0)
    (OdRefs
      (append (od_sub_int j (utf8 "str") (utf8 "pre")) (od_sub_int j (utf8 "num") (utf8 "pre")))
      nil
      nil
      nil)
  (if (= kind 1)
    (OdRefs (od_int j (utf8 "param"))
      (append (od_ints j (utf8 "max")) (append (od_ints j (utf8 "imax")) (od_int j (utf8 "succ"))))
      nil
      nil)
    (let
      ((c
         (append (od_sub_int j (utf8 "const") (utf8 "name"))
           (od_sub_int j (utf8 "proj") (utf8 "typeName")))))
      (OdRefs
        (append c
          (append (od_sub_int j (utf8 "forallE") (utf8 "name"))
            (append (od_sub_int j (utf8 "lam") (utf8 "name"))
              (od_sub_int j (utf8 "letE") (utf8 "name")))))
        (append (od_int j (utf8 "sort")) (od_sub_ints j (utf8 "const") (utf8 "us")))
        (append (od_sub_int j (utf8 "app") (utf8 "fn"))
          (append (od_sub_int j (utf8 "app") (utf8 "arg"))
            (append (od_sub_int j (utf8 "forallE") (utf8 "type"))
              (append (od_sub_int j (utf8 "forallE") (utf8 "body"))
                (append (od_sub_int j (utf8 "lam") (utf8 "type"))
                  (append (od_sub_int j (utf8 "lam") (utf8 "body"))
                    (append (od_sub_int j (utf8 "letE") (utf8 "type"))
                      (append (od_sub_int j (utf8 "letE") (utf8 "value"))
                        (append (od_sub_int j (utf8 "letE") (utf8 "body"))
                          (append (od_sub_int j (utf8 "proj") (utf8 "struct"))
                            (od_sub_int j (utf8 "mdata") (utf8 "expr"))))))))))))
        c)))))
;; a node line's kind and id, read without parsing
(fn od_line_id ((line (List Int))) (Option (Prod Int Int))
  (match (ix_id_in line (utf8 "in"))
    ((some i) (some (Prod.mk 0 i)))
    (none
      (match (ix_id_in line (utf8 "il"))
        ((some i) (some (Prod.mk 1 i)))
        (none
          (match (ix_id_in line (utf8 "ie"))
            ((some i) (some (Prod.mk 2 i)))
            (none none)))))))

;; an id pushed: nothing when fed already or pending; in this block (its first id at most
;; the id) pending for the scan to reach; in an earlier block, that block scheduled
(fn od_push ((x OdIx) (wk OdWalk) (done OdDone) (row IxRow) (kind Int) (id Int) (w World))
  (Prod (Prod OdIx OdWalk) World)
  (if (bool_and (< kind 2) (= id 0)) (Prod.mk (Prod.mk x wk) w)  ; the anonymous name, level zero: no line
  (if (bool_or (odd_has done kind id) (odw_pending wk kind id)) (Prod.mk (Prod.mk x wk) w)
  (if (<= (ix_row_first row kind) id) (Prod.mk (Prod.mk x (odw_mark wk kind id true)) w)
  (match (od_block_of x kind id w)
    ((Prod.mk (Prod.mk x1 none) w1)
     (Prod.mk
       (Prod.mk x1
         (odw_fail wk
           (append (utf8 "no block holds ")
             (append (od_kind_name kind) (append (utf8 " id ") (show_nat id))))))
       w1))
    ((Prod.mk (Prod.mk x1 (some b)) w1)
     (Prod.mk (Prod.mk x1 (odw_schedule (odw_mark wk kind id true) b)) w1)))))))
(fn od_push_ids
  ((x OdIx) (wk OdWalk) (done OdDone) (row IxRow) (kind Int) (ids (List Int)) (w World))
  (Prod (Prod OdIx OdWalk) World)
  (measure (struct ids))
  (match ids
    (nil (Prod.mk (Prod.mk x wk) w))
    ((cons i r)
     (match (od_push x wk done row kind i w)
       ((Prod.mk (Prod.mk x1 wk1) w1) (od_push_ids x1 wk1 done row kind r w1))))))
;; a record pushed by its ordinal: its block is itself
(fn od_push_rec ((wk OdWalk) (done OdDone) (o Int)) OdWalk
  (if (bool_or (odd_has done 3 o) (odw_pending wk 3 o)) wk (odw_schedule (odw_mark wk 3 o true) o)))
(fn od_push_recs ((wk OdWalk) (done OdDone) (os (List Int))) OdWalk
  (measure (struct os))
  (match os
    (nil wk)
    ((cons o r) (od_push_recs (od_push_rec wk done o) done r))))
;; the constants cited: each name id to the record declaring it
(fn od_push_consts ((x OdIx) (wk OdWalk) (done OdDone) (ids (List Int)) (w World))
  (Prod (Prod OdIx OdWalk) World)
  (measure (struct ids))
  (match ids
    (nil (Prod.mk (Prod.mk x wk) w))
    ((cons i r)
     (match (ix_decl_of (odx_index x) (odx_hdr x) i w)
       ((Prod.mk none w1)
        (Prod.mk
          (Prod.mk x
            (odw_fail wk (append (utf8 "a constant with no declaration: name id ") (show_nat i))))
          w1))
       ((Prod.mk (some o) w1) (od_push_consts x (od_push_rec wk done o) done r w1))))))
(fn od_push_refs ((x OdIx) (wk OdWalk) (done OdDone) (row IxRow) (refs OdRefs) (w World))
  (Prod (Prod OdIx OdWalk) World)
  (match refs
    ((OdRefs ns ls es cs)
     (match (od_push_ids x wk done row 0 ns w)
       ((Prod.mk (Prod.mk x1 wk1) w1)
        (match (od_push_ids x1 wk1 done row 1 ls w1)
          ((Prod.mk (Prod.mk x2 wk2) w2)
           (match (od_push_ids x2 wk2 done row 2 es w2)
             ((Prod.mk (Prod.mk x3 wk3) w3) (od_push_consts x3 wk3 done cs w3))))))))))

;; a block's lines with their offsets, the record line first (the block reversed)
(fn od_block_lines ((bs (List Int)) (pos Int) (acc (List (Prod Int (List Int)))))
  (List (Prod Int (List Int)))
  (measure (struct bs))
  (match bs
    (nil acc)
    (_
      (match (take_line bs nil)
        ((Prod.mk line rest)
         (od_block_lines rest (+ pos (+ (len line) 1)) (cons (Prod.mk pos line) acc)))))))
;; the scan of one block from its record line back: a pending line is parsed, its references
;; pushed, the line extracted
(fn od_scan
  ((x OdIx)
   (wk OdWalk)
   (done OdDone)
   (row IxRow)
   (lines (List (Prod Int (List Int))))
   (first Bool)
   (w World))
  (Prod (Prod OdIx (Prod OdWalk OdDone)) World)
  (measure (struct lines))
  (match lines
    (nil (Prod.mk (Prod.mk x (Prod.mk wk done)) w))
    ((cons (Prod.mk off line) rest)
     (if first
       (if (odw_pending wk 3 (ix_row_ord row))
         (match (json_parse line)
           (JErr
             (Prod.mk
               (Prod.mk x
                 (Prod.mk
                   (odw_fail wk (append (utf8 "a record is not JSON at byte ") (show_nat off)))
                   done))
               w))
           ((JRes j _)
            (match (od_record_refs j)
              (none
                (Prod.mk
                  (Prod.mk x
                    (Prod.mk
                      (odw_fail wk (append (utf8 "a malformed record at byte ") (show_nat off)))
                      done))
                  w))
              ((some refs)
               (match (od_push_refs x wk done row refs w)
                 ((Prod.mk (Prod.mk x1 wk1) w1)
                  (od_scan x1
                    (odw_extract (odw_mark wk1 3 (ix_row_ord row) false)
                      (OdLine off (ix_row_ord row) line))
                    (odd_add done 3 (ix_row_ord row))
                    row
                    rest
                    false
                    w1)))))))
         (od_scan x wk done row rest false w))
       (match (od_line_id line)
         (none
           (if (= (len line) 0) (od_scan x wk done row rest false w)
           (Prod.mk
             (Prod.mk x
               (Prod.mk (odw_fail wk (append (utf8 "a line without an id at byte ") (show_nat off)))
                 done))
             w)))
         ((some (Prod.mk kind id))
          (if (odw_pending wk kind id)
            (match (json_parse line)
              (JErr
                (Prod.mk
                  (Prod.mk x
                    (Prod.mk
                      (odw_fail wk (append (utf8 "a line is not JSON at byte ") (show_nat off)))
                      done))
                  w))
              ((JRes j _)
               (match (od_push_refs x wk done row (od_node_refs kind j) w)
                 ((Prod.mk (Prod.mk x1 wk1) w1)
                  (od_scan x1 (odw_extract (odw_mark wk1 kind id false) (OdLine off -1 line))
                    (odd_add done kind id)
                    row
                    rest
                    false
                    w1)))))
            (od_scan x wk done row rest false w))))))))
;; the walk: the highest scheduled block read and scanned, until none is scheduled
(fn od_walk ((x OdIx) (wk OdWalk) (done OdDone) (fuel Int) (w World))
  (Prod (Prod OdIx (Prod OdWalk OdDone)) World)
  (measure fuel)
  (if (<= fuel 0) (Prod.mk (Prod.mk x (Prod.mk (odw_fail wk (utf8 "the block budget")) done)) w)
  (match (odw_bad wk)
    ((cons _ _) (Prod.mk (Prod.mk x (Prod.mk wk done)) w))
    (nil
      (match (odw_sched wk)
        (nil (Prod.mk (Prod.mk x (Prod.mk wk done)) w))
        ((cons b rest)
         (match (od_row x b w)
           ((Prod.mk (Prod.mk x1 none) w1)
            (Prod.mk
              (Prod.mk x1 (Prod.mk (odw_fail wk (append (utf8 "no record row ") (show_nat b))) done))
              w1))
           ((Prod.mk (Prod.mk x1 (some row)) w1)
            (match (read_range (odx_export x1) (ix_row_off row) (ix_row_len row) w1)
              ((Prod.mk none w2)
               (Prod.mk
                 (Prod.mk x1
                   (Prod.mk (odw_fail wk (append (utf8 "cannot read ") (odx_export x1))) done))
                 w2))
              ((Prod.mk (some bs) w2)
               (match
                 (od_scan x1 (odw_set_sched wk rest) done row
                   (od_block_lines bs (ix_row_off row) nil)
                   true
                   w2)
                 ((Prod.mk (Prod.mk x2 (Prod.mk wk2 done2)) w3)
                  (od_walk x2 wk2 done2 (- fuel 1) w3)))))))))))))

;; the lines in export order: extracted highest offset first and consed, they stand ascending
;; unless a push went upward, when they are sorted
(fn od_ordered ((wk OdWalk)) (List OdLine)
  (if (odw_sorted wk) (odw_out wk) (od_sort_lines (odw_out wk))))
(fn od_line_off ((ln OdLine)) Int
  (match ln
    ((OdLine off _ _) off)))
(fn od_sort_lines ((xs (List OdLine))) (List OdLine)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x nil) (list x))
    (_
      (match (od_split_lines xs nil nil)
        ((Prod.mk a b) (od_merge_lines (od_sort_lines a) (od_sort_lines b)))))))
(fn od_split_lines ((xs (List OdLine)) (a (List OdLine)) (b (List OdLine)))
  (Prod (List OdLine) (List OdLine))
  (measure (struct xs))
  (match xs
    (nil (Prod.mk a b))
    ((cons x nil) (Prod.mk (cons x a) b))
    ((cons x (cons y r)) (od_split_lines r (cons x a) (cons y b)))))
(fn od_merge_lines ((a (List OdLine)) (b (List OdLine))) (List OdLine)
  (measure (+ (List.length a) (List.length b)))
  (match a
    (nil b)
    ((cons x ar)
     (match b
       (nil a)
       ((cons y br)
        (if (< (od_line_off y) (od_line_off x)) (cons y (od_merge_lines a br))
        (cons x (od_merge_lines ar b))))))))
(fulfills od_merge_lines.dec_1
  (by (intro p x ar ha y br hb hl) (rw ha) (rw List.length_cons) (arith)))
(fulfills od_merge_lines.dec_2
  (by (intro p x ar ha y br hb hl) (rw hb) (rw List.length_cons) (arith)))

;; ---- the sub-stream through K --------------------------------------------------------------------
;; the run after the lines, the constants admitted with their ordinals, the records fed; or
;; the first verdict that is not an acceptance
(type OdFed (OdFed Run (List (Prod Name Int)) Int) (OdFedErr (List Int)))
(fn od_feed ((run Run) (ls (List OdLine)) (acc (List (Prod Name Int))) (n Int)) OdFed
  (measure (struct ls))
  (match ls
    (nil (OdFed run (rev acc) n))
    ((cons (OdLine off o line) r)
     (match (json_parse line)
       (JErr (OdFedErr (append (utf8 "a line is not JSON at byte ") (show_nat off))))
       ((JRes j _)
        (match (process_record run j)
          ((Prod.mk run1 v)
           (match v
             (VSkip (od_feed run1 r acc n))
             ((VAccept _)
              (od_feed run1 r (od_with_ordinal (record_constants (run_tabs run1) j v) o acc) (+ n 1)))
             (_
               (OdFedErr
                 (match (show_verdict v)
                   ((some t) t)
                   (none (utf8 "?")))))))))))))
(fn od_with_ordinal ((ns (List Name)) (o Int) (acc (List (Prod Name Int)))) (List (Prod Name Int))
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons nm r) (od_with_ordinal r o (cons (Prod.mk nm o) acc)))))

;; the load: the records' closure walked and fed to a fresh run over ENV — the run after the
;; feed (its environment ENV with the records admitted, its counts the feed's), the records the
;; environment now holds, the constants admitted with their ordinals, the records fed. On a
;; failure nothing of a partial feed persists: the environment and the record given stand
(type OdLoad
  (OdLoaded OdIx Run OdDone (List (Prod Name Int)) Int)
  (OdLoadErr OdIx Symbol (List Int)))
(fn od_load ((x OdIx) (env CheckedEnv) (done OdDone) (ords (List Int)) (w World))
  (Prod OdLoad World)
  (let ((held (odd_records done)))
    (match (od_walk x (od_push_recs (odw0) held ords) held 10000000 w)
      ((Prod.mk (Prod.mk x1 (Prod.mk wk done1)) w1)
       (match (odw_bad wk)
         ((cons _ _) (Prod.mk (OdLoadErr x1 (sym "init_malformed") (odw_bad wk)) w1))
         (nil
           (match (od_feed (run_on env) (od_ordered wk) nil 0)
             ((OdFed run1 cs n) (Prod.mk (OdLoaded x1 run1 (odd_records done1) cs n) w1))
             ((OdFedErr msg) (Prod.mk (OdLoadErr x1 (sym "init_refused") msg) w1)))))))))
