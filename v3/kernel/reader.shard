;;; v3/kernel/reader.shard — the reader of the L forms: S forms → K's
;;; `Declaration` (v3/LANGUAGE.md §4, §5.1–5.3). Phase 2, slice 2; over the
;;; elaborator since slice 3.15 (elab.shard: implicit arguments, universe
;;; inference, the numeral rule, the one coercion — the terms are built over
;;; K's locals and closed by K's mk_binding). The scope is data the loader
;;; builds (scope.shard). A `fn`'s body is E and is read by the classifier
;;; (classify.shard); this file reads the L side and routes the E forms and
;;; the directives to their owners. Errors are a reason symbol and a message;
;;; K's verdicts on what this file produces are K's (add.shard).

(import "elab.shard")
(import "engine.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.elab)
(use kernel.expr)
(use kernel.kw)
(use kernel.name)
(use kernel.prelude)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.util)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.ReducibilityHints)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.tactic)
(use kernel.engine)
(use kernel.engine.Produced)
(use kernel.tactic.ProveRes)
(use kernel.expr.BinderInfo)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.scope.Defd)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)

(type RDecl
  (RDOk (List Declaration))     ; what the form declares, in admission order
  (RDPending Name Symbol)       ; `sorry`: read, admits nothing; the loader's obligation
  (RDDirective SExpr)           ; import / use / trusts: the loader's
  (RDParam Declaration Symbol Int)  ; a view parameter (§6.5): the axiom, its kind (type / fn / requirement), a sig type's arity
  (RDLater Symbol)              ; an E form the loader owns (fn, extern, realize: classify.shard, realize.shard; fulfills: §6.6) — the loader intercepts them before read_decl
  (RDSolved Name Int (List SExpr) (List Declaration))   ; an `auto` proof the engine produced under mode `solve` (slice 3.22 rule 6): the theorem, the fingerprint, the block, what it declares
  (RDMeasured Name Bool (List Declaration))   ; mode `measure`: a hand-written proof read as usual, and whether the engine closes the statement unaided
  (RDErr Symbol (List Int)))    ; reason, message

;; ---- the declared name and its universe parameters ------------------------------------
(type Head (Head Name (List Name)))
(fn read_head ((sc Scope) (s SExpr)) (Pair (Option Head) (List Int))
  (match s
    ((SSym x) (match (name_of_sym x) ((Some n) (Pair (Some (Head (qualify sc n) Nil)) Nil)) (None (Pair None (chars_of_sym x)))))
    ((SSymU x ls)
     (match (name_of_sym x)
       (None (Pair None (chars_of_sym x)))
       ((Some n)
        (match (univ_params ls Nil)
          ((Some ps) (Pair (Some (Head (qualify sc n) ps)) Nil))
          (None (Pair None "universe parameters are names: NAME.{u v}"))))))
    (_ (Pair None "a declared name is NAME or NAME.{u…}"))))

;; ---- closing over the binders ------------------------------------------------------------
;; the Pi over the declaration's binders, finished (no metavariable survives)
(fn close_pis ((e El) (fvars (List Expr)) (t Expr)) (Pair El FinRes)
  (match (el_pis e fvars t) ((Pair e1 pi) (Pair e1 (el_finish e1 pi)))))
(fn close_lams ((e El) (fvars (List Expr)) (v Expr)) (Pair El FinRes)
  (match (el_lams e fvars v) ((Pair e1 lam) (Pair e1 (el_finish e1 lam)))))

;; what a form declares after the matchers its terms generated (elab.shard's el_aux: already
;; checked into the walk's environment, admitted by the loader before their owner)
(fn rd_ok ((e El) (ds (List Declaration))) RDecl (RDOk (append (el_aux e) ds)))
(fn rd_err ((r FinRes)) RDecl (match r ((FinErr s m) (RDErr s m)) ((FinOk _) (RDErr (quote bad_shape) "finished"))))

;; ---- the forms (§4) -----------------------------------------------------------------------
;; a sidecar entry (slice 3.22 rule 1): the theorem's name as its source writes it, the
;; fingerprint of the statement the entry was made for, the block's steps
(type Auto (Auto Name Int (List SExpr)))
;; the load's mode for proofs (slice 3.22 rule 6): `off` — the build, nothing searches; `solve` — an
;; `auto` without a valid entry is the engine's, RDSolved; `measure` — every hand-written proof is
;; read as usual and the engine is also run on the statement, RDMeasured (the count over calc)
(fn read_decl ((sc Scope) (env CheckedEnv) (s SExpr)) RDecl (read_decl_autos sc env s Nil (quote off)))
(fn read_decl_autos ((sc Scope) (env CheckedEnv) (s SExpr) (autos (List Auto)) (mode Symbol)) RDecl
  (match s
    ((SList (Cons (SSym h) args))
     (if (sym_eq h (quote def)) (read_def sc env args (quote def) Nil mode)
     (if (sym_eq h (quote abbrev)) (read_def sc env args (quote abbrev) Nil mode)
     (if (sym_eq h (quote opaque)) (read_def sc env args (quote opaque) Nil mode)
     (if (sym_eq h (quote theorem)) (read_def sc env args (quote theorem) autos mode)
     (if (sym_eq h (quote axiom)) (read_axiom sc env args)
     (if (sym_eq h (quote inductive)) (read_inductive sc env args)
     (if (sym_eq h (quote type)) (read_type sc env args)
     (if (sym_eq h (quote structure)) (read_structure sc env args)
     (if (bool_or (sym_eq h (quote import)) (bool_or (sym_eq h (quote use)) (sym_eq h (quote trusts)))) (RDDirective s)
     (if (sym_eq h (quote sig)) (read_sig sc env args)
     (if (sym_eq h (quote requirement)) (read_requirement sc env args)
     (if (bool_or (sym_eq h (quote fn)) (bool_or (sym_eq h (quote extern)) (bool_or (sym_eq h (quote fulfills)) (sym_eq h (quote realize)))))
       (RDLater h)
     (match (reserved_phase h)
       ((Some ph) (RDErr (quote reserved_form) (append (chars_of_sym h) (append ": " ph))))
       (None (RDErr (quote unknown_form) (chars_of_sym h)))))))))))))))))
    (_ (RDErr (quote unknown_form) "a top-level form is (KEYWORD …)"))))
(fn reserved_phase ((h Symbol)) (Option (List Int))
  (if (bool_or (sym_eq h (quote instance)) (sym_eq h (quote class))) (Some "phase 3 (Stage 3)")
  (if (bool_or (sym_eq h (quote bin)) (bool_or (sym_eq h (quote requires)) (sym_eq h (quote app)))) (Some "phase 4")
  (if (bool_or (sym_eq h (quote namespace)) (bool_or (sym_eq h (quote section)) (sym_eq h (quote variable)))) (Some "undecided; declare the dotted name")
  None))))

;; (def NAME.{u…} BINDERS TYPE VALUE); abbrev, opaque; (theorem … PROP PROOF)
(fn read_def ((sc Scope) (env CheckedEnv) (args (List SExpr)) (kind Symbol) (autos (List Auto)) (mode Symbol)) RDecl
  (match args
    ((Cons hd (Cons (SList bs) (Cons ty (Cons val Nil))))
     (match (read_head sc hd)
       ((Pair None m) (RDErr (quote bad_name) m))
       ((Pair (Some (Head n lps)) _)
        (match (read_binders (el0 sc env lps Nil n) bs Nil)
          ((Pair None m) (RDErr (quote bad_binder) m))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (if (sym_eq kind (quote theorem))
                (read_proof e2 n lps fvars t val (auto_entry sc autos n) mode)
                (match (elab e2 val (Some t))
                  ((EErr r m) (RDErr r m))
                  ((EOk e3 v _)
                   (match (close_pis e3 fvars t)
                     ((Pair _ (FinErr r m)) (RDErr r m))
                     ((Pair e4 (FinOk T))
                      (match (close_lams e4 fvars v)
                        ((Pair _ (FinErr r m)) (RDErr r m))
                        ((Pair e5 (FinOk value))
                         (let ((cv (ConstantVal n lps T)))
                           (if (sym_eq kind (quote opaque))
                             (rd_ok e5 (list (OpaqueDecl cv value False (list n))))
                             (rd_ok e5 (list (DefnDecl cv value (if (sym_eq kind (quote abbrev)) HAbbrev (HRegular (def_height (el_env e5) value))) Safe (list n))))))))))))))))))))
    (_ (RDErr (quote bad_shape) (append "(" (append (chars_of_sym kind) " NAME ((x TYPE)…) TYPE VALUE)"))))))

;; the sidecar's entry for the theorem n: its name as written, qualified as n was
(fn auto_entry ((sc Scope) (autos (List Auto)) (n Name)) (Option (Pair Int (List SExpr))) (auto_entry_as sc autos n Anon))
;; a discharge's theorem is OBLIGATION.proof: the entry names the obligation (f.dec_1)
(fn auto_entry_as ((sc Scope) (autos (List Auto)) (n Name) (suffix Name)) (Option (Pair Int (List SExpr)))
  (measure (struct autos))
  (match autos
    (Nil None)
    ((Cons (Auto an fp steps) r) (if (name_eq (name_append (qualify sc an) suffix) n) (Some (Pair fp steps)) (auto_entry_as sc r n suffix)))))
;; a proof: (exact TERM) — TERM at the statement, over the binders; sorry; (by STEP…) — I's
;; block on the statement closed over the binders (tactic.shard, slice 3.20); auto or
;; (auto HINT…) — the sidecar's block for the theorem, replayed as (by …) when the entry's
;; fingerprint is the statement's (slice 3.22 rules 1–2): no entry is pending auto_missing,
;; another statement's entry pending auto_stale; the hints are the producer's, unread here
(fn read_proof ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (t Expr) (p SExpr) (entry (Option (Pair Int (List SExpr)))) (mode Symbol)) RDecl
  (if (sym_eq mode (quote measure)) (read_measured e n lps fvars t p entry) (read_proof_go e n lps fvars t p entry mode)))
(fn read_proof_go ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (t Expr) (p SExpr) (entry (Option (Pair Int (List SExpr)))) (mode Symbol)) RDecl
  (match p
    ((SSym s)
     (if (sym_eq s (quote sorry)) (RDPending n (quote sorry))
     (if (sym_eq s (quote auto)) (read_auto e n lps fvars t entry Nil mode)
       (RDErr (quote bad_proof) "a proof is (exact TERM), (by STEP…), auto or sorry"))))
    ((SList (Cons (SSym x) Nil)) (if (sym_eq x (quote auto)) (read_auto e n lps fvars t entry Nil mode) (RDErr (quote bad_proof) "a proof is (exact TERM), (by STEP…), auto or sorry")))
    ((SList (Cons (SSym x) (Cons pt rest)))
     (if (sym_eq x (quote auto)) (read_auto e n lps fvars t entry (Cons pt rest) mode)
     (if (bool_and (sym_eq x (quote exact)) (int_eq (len rest) 0))
       (match (elab e pt (Some t))
         ((EErr r m) (RDErr r m))
         ((EOk e1 v _)
          (match (close_pis e1 fvars t)
            ((Pair _ (FinErr r m)) (RDErr r m))
            ((Pair e2 (FinOk T))
             (match (close_lams e2 fvars v)
               ((Pair _ (FinErr r m)) (RDErr r m))
               ((Pair e3 (FinOk value)) (rd_ok e3 (list (ThmDecl (ConstantVal n lps T) value (list n))))))))))
     (if (sym_eq x (quote by))
       (match (close_pis e fvars t)
         ((Pair _ (FinErr r m)) (RDErr r m))
         ((Pair e1 (FinOk T))
          (match (tac_prove e1 T (len fvars) (Cons pt rest))
            ((ProveErr r m) (RDErr r m))
            ((ProvePending _ gs) (RDPending n (sym_of_chars (append "sorry goals=" (append (show_nat (len gs)) (goals_bracketed gs))))))
            ((ProveOk e2 value) (rd_ok e2 (list (ThmDecl (ConstantVal n lps T) value (list n))))))))
       (RDErr (quote bad_proof) "a proof is (exact TERM), (by STEP…), auto or sorry")))))
    (_ (RDErr (quote bad_proof) "a proof is (exact TERM), (by STEP…), auto or sorry"))))
(fn read_auto ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (t Expr) (entry (Option (Pair Int (List SExpr)))) (hints (List SExpr)) (mode Symbol)) RDecl
  (match (close_pis e fvars t)
    ((Pair _ (FinErr r m)) (RDErr r m))
    ((Pair e1 (FinOk T))
     (match (auto_valid entry (hash_expr T))
       ((Some steps) (read_block_proof e1 n lps fvars T steps))
       (None
        (if (sym_eq mode (quote solve))
          ;; the engine's block, replayed as an entry's would be before it is one
          (match (engine_prove e1 T (len fvars) hints)
            ((NotProduced m) (RDPending n (sym_of_chars (append "auto_unsolved fp=" (append (show_int (hash_expr T)) (append " " m))))))
            ((Produced nodes)
             (let ((steps (nodes_sx nodes)))
               (match (read_block_proof e1 n lps fvars T steps)
                 ((RDOk ds) (RDSolved n (hash_expr T) steps ds))
                 (other other)))))
          (RDPending n (sym_of_chars (append (match entry (None "auto_missing fp=") (_ "auto_stale fp=")) (show_int (hash_expr T)))))))))))
;; the entry's block when its fingerprint is the statement's
(fn auto_valid ((entry (Option (Pair Int (List SExpr)))) (fp Int)) (Option (List SExpr))
  (match entry
    (None None)
    ((Some (Pair efp steps)) (if (int_eq efp fp) (Some steps) None))))
;; a block on the closed statement: the theorem, pending with its goals, or the refusal
(fn read_block_proof ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (T Expr) (steps (List SExpr))) RDecl
  (match (tac_prove e T (len fvars) steps)
    ((ProveErr r m) (RDErr r m))
    ((ProvePending _ gs) (RDPending n (sym_of_chars (append "sorry goals=" (append (show_nat (len gs)) (goals_bracketed gs))))))
    ((ProveOk e2 value) (rd_ok e2 (list (ThmDecl (ConstantVal n lps T) value (list n)))))))
;; mode `measure`: the proof as written, and whether the engine closes the statement unaided —
;; the engine's count (slice 3.22's third ruling); an `auto` here is read as the build reads it
(fn read_measured ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (t Expr) (p SExpr) (entry (Option (Pair Int (List SExpr))))) RDecl
  (match (read_proof_go e n lps fvars t p entry (quote off))
    ((RDOk ds)
     (match (close_pis e fvars t)
       ((Pair _ (FinErr r m)) (RDOk ds))
       ((Pair e1 (FinOk T))
        (RDMeasured n (match (engine_prove e1 T (len fvars) Nil) ((Produced _) True) ((NotProduced _) False)) ds))))
    (other other)))

;; ---- views (§6.5, §6.6) ---------------------------------------------------------------
;; (sig type NAME) / (sig type (NAME T…)): the parameter NAME : Type → … → Type
;; (sig fn NAME BINDERS RET): the parameter NAME : ∀ BINDERS, RET — E-types (level 0 by rule)
(fn read_sig ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((Cons (SSym k) rest)
     (if (sym_eq k (quote type))
       (match rest
         ((Cons hd Nil)
          (match (type_head sc hd)
            ((Pair None m) (RDErr (quote bad_name) m))
            ((Pair (Some (Pair n params)) _)
             (RDParam (AxiomDecl (ConstantVal n Nil (type_former_type (len params))) False) (quote type) (len params)))))
         (_ (RDErr (quote bad_shape) "(sig type NAME) or (sig type (NAME T…))")))
     (if (sym_eq k (quote fn))
       (match (read_signature sc env rest)
         ((Pair (Some (Pair n t)) _) (RDParam (AxiomDecl (ConstantVal n Nil t) False) (quote fn) 0))
         ((Pair None m) (RDErr (quote bad_shape) m)))
       (RDErr (quote bad_shape) "(sig fn NAME BINDERS RET) or (sig type NAME)"))))
    (_ (RDErr (quote bad_shape) "(sig fn NAME BINDERS RET) or (sig type NAME)"))))
;; Type → … → Type with k arrows
(fn type_former_type ((k Int)) Expr
  (measure k)
  (if (lt k 1) (mk_sort (LSucc LZero)) (mk_pi Anon BDefault (mk_sort (LSucc LZero)) (type_former_type (- k 1)))))
;; NAME BINDERS RET …: the E signature as a Π-type — a `sig fn`'s, or a `fn`'s
;; head (its body and measure ignored); the qualified name with it
(fn read_signature ((sc Scope) (env CheckedEnv) (args (List SExpr))) (Pair (Option (Pair Name Expr)) (List Int))
  (match args
    ((Cons (SSym x) (Cons (SList bs) (Cons ret _)))
     (match (name_of_sym x)
       (None (Pair None (chars_of_sym x)))
       ((Some short)
        (match (read_binders (el_with_etype (el0 sc env Nil Nil (qualify sc short)) True) bs Nil)
          ((Pair None m) (Pair None (append "bad binder: " m)))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 ret)
             ((EErr r m) (Pair None (append (chars_of_sym r) (append ": " m))))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Pair _ (FinErr r m)) (Pair None (append (chars_of_sym r) (append ": " m))))
                ((Pair _ (FinOk T)) (Pair (Some (Pair (qualify sc short) T)) Nil))))))))))
    (_ (Pair None "NAME ((x TYPE)…) RET"))))
;; (requirement NAME BINDERS PROP): the parameter NAME : ∀ BINDERS, PROP (L terms)
(fn read_requirement ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match (read_statement sc env args)
    ((RSOk e n lps _ _ T)
     (match (el_aux e)
       (Nil (RDParam (AxiomDecl (ConstantVal n lps T) False) (quote requirement) 0))
       (_ (RDErr (quote match_in_requirement) "a requirement's statement with a match needs its matcher in the view: state it over a def (LANGUAGE.md §8.4 slice 3.16 rule 1)"))))
    ((RSErr m) (RDErr (quote bad_shape) m))))
;; a statement read: the state over the binders, the name, its universe
;; parameters, the fvars, the open proposition, the closed one
(type RStmt (RSOk El Name (List Name) (List Expr) Expr Expr) (RSErr (List Int)))
(fn read_statement ((sc Scope) (env CheckedEnv) (args (List SExpr))) RStmt
  (match args
    ((Cons hd (Cons (SList bs) (Cons prop Nil)))
     (match (read_head sc hd)
       ((Pair None m) (RSErr m))
       ((Pair (Some (Head n lps)) _)
        (match (read_binders (el0 sc env lps Nil n) bs Nil)
          ((Pair None m) (RSErr (append "bad binder: " m)))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 prop)
             ((EErr r m) (RSErr (append (chars_of_sym r) (append ": " m))))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Pair _ (FinErr r m)) (RSErr (append (chars_of_sym r) (append ": " m))))
                ((Pair e3 (FinOk T)) (RSOk e3 n lps fvars t T))))))))))
    (_ (RSErr "(requirement NAME ((x TYPE)…) PROP)"))))
;; (fulfills NAME PROOF) against the view's (requirement NAME BINDERS PROP), the
;; statement re-read in this environment: a theorem, or pending
(fn read_fulfills ((sc Scope) (env CheckedEnv) (req_args (List SExpr)) (proof SExpr) (autos (List Auto)) (mode Symbol)) RDecl
  (match (read_statement sc env req_args)
    ((RSErr m) (RDErr (quote bad_shape) m))
    ((RSOk e n lps fvars t _) (read_proof e n lps fvars t proof (auto_entry sc autos n) mode))))

;; (fulfills f.dec_N PROOF) outside a view (§8.4 slice 3.16 rule 8): PROOF against the
;; obligation's own statement, a theorem under `thm`
(fn read_discharge ((sc Scope) (env CheckedEnv) (thm Name) (stmt Expr) (proof SExpr) (autos (List Auto)) (mode Symbol)) RDecl
  (read_proof (el0 sc env Nil Nil thm) thm Nil Nil stmt proof (auto_entry_as sc autos thm (n1 (quote proof))) mode))

;; (axiom NAME.{u…} BINDERS TYPE) — the loader admits it only under (trusts NAME) (§9)
(fn read_axiom ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((Cons hd (Cons (SList bs) (Cons ty Nil)))
     (match (read_head sc hd)
       ((Pair None m) (RDErr (quote bad_name) m))
       ((Pair (Some (Head n lps)) _)
        (match (read_binders (el0 sc env lps Nil n) bs Nil)
          ((Pair None m) (RDErr (quote bad_binder) m))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Pair _ (FinErr r m)) (RDErr r m))
                ((Pair e3 (FinOk T)) (rd_ok e3 (list (AxiomDecl (ConstantVal n lps T) False))))))))))))
    (_ (RDErr (quote bad_shape) "(axiom NAME ((x TYPE)…) TYPE)"))))

;; (inductive NAME.{u…} BINDERS TYPE (CTOR TYPE)…): one type, Lean's shapes; the
;; type's own name is citable in the constructors with the type it declares
(fn read_inductive ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((Cons hd (Cons (SList bs) (Cons ty ctors)))
     (match (read_head sc hd)
       ((Pair None m) (RDErr (quote bad_name) m))
       ((Pair (Some (Head n lps)) _)
        (match (read_binders (el0 sc env lps Nil n) bs Nil)
          ((Pair None m) (RDErr (quote bad_binder) m))
          ((Pair (Some (Pair e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Pair _ (FinErr r m)) (RDErr r m))
                ((Pair e3 (FinOk IT))
                 (match (read_ctors (el_with_defining e3 (list (Defd n (len lps) IT))) n fvars ctors Nil)
                   ((Pair None m) (RDErr (quote bad_constructor) m))
                   ((Pair (Some cs) _)
                    (RDOk (list (InductDecl lps (len fvars) (list (InductiveType n IT cs)) False))))))))))))))
    (_ (RDErr (quote bad_shape) "(inductive NAME ((x TYPE)…) TYPE (CTOR TYPE)…)"))))
;; (CTOR TYPE): the constructor's type after the parameters, in the binder context
(fn read_ctors ((e El) (ind Name) (fvars (List Expr)) (cs (List SExpr)) (acc (List Constructor))) (Pair (Option (List Constructor)) (List Int))
  (measure (struct cs))
  (match cs
    (Nil (Pair (Some (rev acc)) Nil))
    ((Cons (SList (Cons (SSym cn) (Cons ty Nil))) r)
     (match (name_of_sym cn)
       (None (Pair None (chars_of_sym cn)))
       ((Some short)
        (match (elab_type e ty)
          ((EErr r2 m) (Pair None (append (chars_of_sym r2) (append ": " m))))
          ((EOk e1 t _)
           (match (close_pis e1 fvars t)
             ((Pair _ (FinErr r2 m)) (Pair None (append (chars_of_sym r2) (append ": " m))))
             ((Pair e2 (FinOk CT)) (read_ctors e2 ind fvars r (Cons (Constructor (name_append ind short) CT) acc)))))))))
    (_ (Pair None "a constructor is (CTOR TYPE)"))))

;; (type (NAME T…) (CTOR FIELD-TYPE…)…) / (type NAME (CTOR FIELD-TYPE…)…): today's
;; E data form as an inductive with `(T Type)` parameters, result `Type`,
;; non-dependent fields in E-type position (level 0 by rule, §4)
(fn read_type ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((Cons hd ctors)
     (match (type_head sc hd)
       ((Pair None m) (RDErr (quote bad_name) m))
       ((Pair (Some (Pair n params)) _)
        (let ((IT (type_former_type (len params))))
          (match (type_locals (el_with_etype (el0 sc env Nil (list (Defd n 0 IT)) n) True) params Nil)
            ((Pair e1 fvars)
             (match (w_apps (el_w e1) (mk_const n Nil) fvars)
               ((Pair w2 result)
                (match (read_fields_ctors (el_set_w e1 w2) n fvars result ctors Nil)
                  ((Pair None m) (RDErr (quote bad_constructor) m))
                  ((Pair (Some cs) _)
                   (RDOk (list (InductDecl Nil (len params) (list (InductiveType n IT cs)) False)))))))))))))
    (_ (RDErr (quote bad_shape) "(type (NAME T…) (CTOR FIELD-TYPE…)…)"))))
;; the `(T Type)` parameters as locals — implicit in the constructors, as Lean's inductive
;; parameters are and as E cites them (slice 3.15: `(Pair2.mk two green)` in L as in a body)
(fn type_locals ((e El) (ps (List Name)) (acc (List Expr))) (Pair El (List Expr))
  (measure (struct ps))
  (match ps
    (Nil (Pair e (rev acc)))
    ((Cons p r) (match (el_local e p (mk_sort (LSucc LZero)) BImplicit) ((Pair e1 fv) (type_locals e1 r (Cons fv acc)))))))
;; (CTOR FIELD-TYPE…): CTOR : (T…) → FIELD-TYPES → NAME T…
(fn read_fields_ctors ((e El) (ind Name) (fvars (List Expr)) (result Expr) (cs (List SExpr)) (acc (List Constructor))) (Pair (Option (List Constructor)) (List Int))
  (measure (struct cs))
  (match cs
    (Nil (Pair (Some (rev acc)) Nil))
    ((Cons (SList (Cons (SSym cn) fields)) r)
     (match (name_of_sym cn)
       (None (Pair None (chars_of_sym cn)))
       ((Some short)
        (match (field_locals e fields Nil)
          ((Pair None m) (Pair None m))
          ((Pair (Some (Pair e1 flocals)) _)
           (match (close_pis e1 (append fvars flocals) result)
             ((Pair _ (FinErr r2 m)) (Pair None (append (chars_of_sym r2) (append ": " m))))
             ((Pair e2 (FinOk CT)) (read_fields_ctors (el_restore e2 e) ind fvars result r (Cons (Constructor (name_append ind short) CT) acc)))))))))
    (_ (Pair None "a constructor is (CTOR FIELD-TYPE…)"))))
;; each field type in the parameter context, an anonymous local per field
(fn field_locals ((e El) (fields (List SExpr)) (acc (List Expr))) (Pair (Option (Pair El (List Expr))) (List Int))
  (measure (struct fields))
  (match fields
    (Nil (Pair (Some (Pair e (rev acc))) Nil))
    ((Cons f r)
     (match (elab_type e f)
       ((EErr r2 m) (Pair None (append (chars_of_sym r2) (append ": " m))))
       ((EOk e1 t _)
        (match (el_local e1 Anon t BDefault)
          ((Pair e2 fv) (field_locals e2 r (Cons fv acc)))))))))

;; (structure NAME.{u…} BINDERS (FIELD TYPE)…): the inductive with `NAME.mk`
;; (the fields as dependent binders after the parameters), then a projection
;; `NAME.FIELD` per field as an abbrev over `proj` (Lean's projections are
;; `Expr.proj` definitions), its type the field's type with the earlier
;; fields replaced by their projections of `self`
(fn read_structure ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((Cons hd (Cons (SList bs) fields))
     (match (read_head sc hd)
       ((Pair None m) (RDErr (quote bad_name) m))
       ((Pair (Some (Head n lps)) _)
        (match (read_binders (el0 sc env lps Nil n) bs Nil)
          ((Pair None m) (RDErr (quote bad_binder) m))
          ((Pair (Some (Pair e1 params)) _)
           (match (close_pis e1 params (mk_sort (LSucc LZero)))
             ((Pair _ (FinErr r m)) (RDErr r m))
             ((Pair e2 (FinOk IT))
              (let ((e3 (el_with_defining e2 (list (Defd n (len lps) IT)))))
                (match (w_apps (el_w e3) (mk_const n (lparam_levels lps)) params)
                  ((Pair w4 self_ty)
                   (match (read_binders (el_set_w e3 w4) fields Nil)
                     ((Pair None m) (RDErr (quote bad_field) m))
                     ((Pair (Some (Pair e5 fs)) _)
                      (match (close_pis e5 (append params fs) self_ty)
                        ((Pair _ (FinErr r m)) (RDErr r m))
                        ((Pair e6 (FinOk CT))
                         (let ((ctor (Constructor (name_append n (Str Anon (quote mk))) CT)))
                           (match (el_local (el_restore e6 e3) (self_name) self_ty BDefault)
                             ((Pair e7 self)
                           (match (projections e7 n lps params self fields 0 Nil Nil)
                             ((Pair None m) (RDErr (quote bad_field) m))
                             ((Pair (Some projs) _)
                              (RDOk (Cons (InductDecl lps (len params) (list (InductiveType n IT (list ctor))) False)
                                          projs)))))))))))))))))))))
    (_ (RDErr (quote bad_shape) "(structure NAME ((x TYPE)…) (FIELD TYPE)…)"))))

;; NAME.f_i : forall BINDERS (self : NAME params), T_i[f_j := (proj NAME j self)]
;;   := fun BINDERS self => (proj NAME i self)
;; T_i is re-elaborated from its source over the bound `self`, the earlier
;; fields as aliases carrying their open types (elab_sym: the structure is not
;; in the environment yet, so K cannot type the projection); `e` holds the
;; parameters and `self`
(fn projections ((e El) (n Name) (lps (List Name)) (params (List Expr)) (self Expr) (fields (List SExpr)) (i Int) (aliases (List (Pair Name (Pair Int Expr)))) (acc (List Declaration))) (Pair (Option (List Declaration)) (List Int))
  (measure (struct fields))
  (match fields
    (Nil (Pair (Some (rev acc)) Nil))
    ((Cons (SList (Cons (SSym fx) (Cons fty _))) r)
     (match (name_of_sym fx)
       (None (Pair None (chars_of_sym fx)))
       ((Some f)
        (match (elab_type (el_with_aliases e aliases) fty)
          ((EErr r2 m) (Pair None (append (chars_of_sym r2) (append ": " m))))
          ((EOk e2 t _)
           (match (close_pis e2 (append params (list self)) t)
             ((Pair _ (FinErr r2 m)) (Pair None (append (chars_of_sym r2) (append ": " m))))
             ((Pair e3 (FinOk PT))
              (match (close_lams e3 (append params (list self)) (mk_proj n i self))
                ((Pair _ (FinErr r2 m)) (Pair None (append (chars_of_sym r2) (append ": " m))))
                ((Pair e4 (FinOk value))
                 (projections (el_restore e4 e) n lps params self r (+ i 1) (Cons (Pair f (Pair i (el_zonk e4 t))) aliases)
                   (Cons (DefnDecl (ConstantVal (name_append n f) lps PT) value HAbbrev Safe (list (name_append n f))) acc)))))))))))
    (_ (Pair None "a field is (FIELD TYPE)"))))
