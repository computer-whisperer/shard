;;; v3/kernel/reader.shard — the reader of the L forms: S forms → K's
;;; `Declaration`, over the elaborator (elab.shard: implicit arguments, universe
;;; inference, the numeral rule, the coercions — the terms are built over
;;; K's locals and closed by K's mk_binding). The scope is data the loader
;;; builds (scope.shard). A `fn` is the loader's (predef.shard reads it, or
;;; classify.shard program-first); this file reads the L side and routes
;;; the E forms and the directives to their owners. Errors are a reason
;;; symbol and a message; K's verdicts on what this file produces are K's
;;; (k/add.shard).

(import "elab.shard")
(import "engine.shard")
(import "ev.shard")
(import "etable.shard")
(import "inhabit.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.descent)
(use kernel.elab)
(use kernel.expr)
(use kernel.inhabit)
(use kernel.kw)
(use kernel.name)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.scope.Vis)
(use kernel.sym)
(use kernel.util)
(use kernel.decl.ConstantVal)
(use kernel.decl.Constructor)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.InductiveType)
(use kernel.decl.ReducibilityHints)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.elab.FinRes)
(use kernel.tactic)
(use kernel.engine)
(use kernel.engine.Produced)
(use kernel.ev)
(use kernel.etable)
(use kernel.etable.ESt)
(use kernel.prog)
(use kernel.prog.EDecl)
(use kernel.prog.EvRes)
(use kernel.sexpr.RAll)
(use kernel.tactic.ProveRes)
(use kernel.tactic.Goal)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.scope.Defd)
(use kernel.scope.Scope)
(use kernel.sexpr.SExpr)

;; the resolved requirement's key: four fingerprints —
;; the closed statement's, the referenced declarations' (the identity closure through the
;; load's own declarations), the policy's (the file's trusts resolved, the parameters it sees),
;; the environment's (the export's identity) — or, from a sidecar
;; of schema 2, the statement's alone. Fingerprints, never authorities: the key detects
;; a changed task; K's replay accepts.
(type Req (ReqFull Int Int Int Int) (ReqStmt Int))
(type RDecl
  (RDOk (List Declaration))  ; what the form declares, in admission order
  (RDPending Name Symbol)  ; a pending proof and its cause (sorry, auto_missing, …): read, admits nothing; the loader's obligation
  (RDDirective SExpr)  ; import / use / trusts: the loader's
  (RDParam Declaration Symbol Int)  ; a view parameter: the axiom, its kind (type / fn / requirement), a sig type's arity
  (RDLater Symbol)  ; a form the loader owns (fn, extern, realize, fulfills, bin) — the loader intercepts them before read_decl
  (RDSolved Name Req (List SExpr) (List Declaration))  ; an `auto` proof the engine produced under mode `solve`, or a schema-2 entry re-keyed: the theorem, the key, the block, what it declares
  (RDMeasured Name Bool (Option (Prod Name Bool)) (List Declaration))  ; mode `measure`: a hand-written proof read as usual, and whether the engine closes the statement unaided
  (RDErr Symbol (List Int)))  ; reason, message

;; ---- the declared name and its universe parameters ------------------------------------
(type Head (Head Name (List Name)))
(fn read_head ((sc Scope) (s SExpr)) (Prod (Option Head) (List Int))
  (match s
    ((SSym x)
     (match (name_of_sym x)
       ((some n) (Prod.mk (some (Head (qualify sc n) nil)) nil))
       (none (Prod.mk none (chars_of_sym x)))))
    ((SSymU x ls)
     (match (name_of_sym x)
       (none (Prod.mk none (chars_of_sym x)))
       ((some n)
        (match (univ_params ls nil)
          ((some ps) (Prod.mk (some (Head (qualify sc n) ps)) nil))
          (none (Prod.mk none (utf8 "universe parameters are names: NAME.{u v}")))))))
    (_ (Prod.mk none (utf8 "a declared name is NAME or NAME.{u…}")))))

;; ---- closing over the binders ------------------------------------------------------------
;; the Pi over the declaration's binders, finished (no metavariable survives)
(fn close_pis ((e El) (fvars (List Expr)) (t Expr)) (Prod El FinRes)
  (match (el_pis e fvars t)
    ((Prod.mk e1 pi) (Prod.mk e1 (el_finish e1 pi)))))
(fn close_lams ((e El) (fvars (List Expr)) (v Expr)) (Prod El FinRes)
  (match (el_lams e fvars v)
    ((Prod.mk e1 lam) (Prod.mk e1 (el_finish e1 lam)))))

;; what a form declares after the matchers its terms generated (elab.shard's el_aux: already
;; checked into the walk's environment, admitted by the loader before their owner)
(fn rd_ok ((e El) (ds (List Declaration))) RDecl (RDOk (append (el_aux e) ds)))

;; ---- the forms ----------------------------------------------------------------------------
(fn req_stmt ((k Req)) Int
  (match k
    ((ReqFull s _ _ _) s)
    ((ReqStmt s) s)))
;; a sidecar entry: the theorem's name as its source writes
;; it, the key of the requirement the entry was made for, the block's steps
(type Auto (Auto Name Req (List SExpr)))
;; the file's parts of the key, computed once by the loader: the scope (the
;; declaration table tells the load's own names from Init's), the policy's and the
;; environment's fingerprints
(type ReqCtx (ReqCtx Scope Int Int))
;; the producers' inputs for a file: the sidecar's entries, the loaded
;; programs (a tactic named by `(auto (tactic M.FN))` runs under `ev` on them, mode `solve`),
;; the driver's fuel for such a run, and the file's parts of the key
(type Producers (Producers (List Auto) ESt Int ReqCtx))
(fn pr_autos ((pr Producers)) (List Auto)
  (match pr
    ((Producers as _ _ _) as)))
(fn pr_req ((pr Producers)) ReqCtx
  (match pr
    ((Producers _ _ _ rc) rc)))
(fn no_producers () Producers (Producers nil (es0) 0 (ReqCtx (scope_of Anon Anon nil VisAll) 0 0)))

;; ---- the key ------------------------------------------------------------------------------
;; The key of a closed statement T under the file's parts is S.D.P.E: S the statement's
;; structural hash (binder names outside it), D the identity closure, P and E the file's.
;; D is the referenced declarations' identities: from the constants T cites, every declaration
;; of the load's own that is reachable through K's edge relation (ci_used, the axiom walk's),
;; each mixed with its name — a sum, so the order of the walk is no part of the key; Init's
;; names stop the walk (their identity is the export's, E's).
;; A declaration's part of every walk that reaches it: its term of the sum, and the constants
;; it cites, each with its key in the environment (`env_key`) — as ci_used gives them, none
;; left out, so a walk goes through the names it always went through and no name's bytes
;; are hashed in it. The memo holds the part of each declaration a walk has reached, by the
;; name's key: a cache of a function of the declaration as the environment holds it, kept
;; outside the environment and good for as long as K's memo of axiom closures is (the
;; loader keeps the two together, loader.shard `Memos`). Whether a name is the load's own
;; is no part of it: the walk asks its scope at every step, and the table it asks grows
(type ReqNode (ReqNode Int (List (Prod Name Int))))
(type ReqMemo (ReqMemo (IntMap (List (Prod Name ReqNode)))))
;; what a walk leaves: the names it has seen, the sum, the memo
(type ReqWalk (ReqWalk (IntMap (List (Prod Name Int))) Int ReqMemo))
(fn req_memo_empty () ReqMemo (ReqMemo IMEmpty))
(fn req_bucket ((t (IntMap (List (Prod Name ReqNode)))) (k Int)) (List (Prod Name ReqNode))
  (match (im_find t k)
    ((some b) b)
    (none nil)))
(fn req_bucket_find ((b (List (Prod Name ReqNode))) (n Name)) (Option ReqNode)
  (measure (struct b))
  (match b
    (nil none)
    ((cons (Prod.mk x v) r) (if (name_eq x n) (some v) (req_bucket_find r n)))))
;; n's part, from the memo or made and put there; none for a name the environment does not
;; hold — which it may hold later, so nothing is kept of that
(fn req_node ((env CheckedEnv) (m ReqMemo) (k Int) (n Name)) (Prod (Option ReqNode) ReqMemo)
  (match m
    ((ReqMemo t)
     (match (req_bucket_find (req_bucket t k) n)
       ((some v) (Prod.mk (some v) m))
       (none
         (match (env_find_at env k n)
           (none (Prod.mk none m))
           ((some info) (req_node_put t k n (req_node_of env n info)))))))))
(fn req_node_of ((env CheckedEnv) (n Name) (info ConstantInfo)) ReqNode
  (ReqNode
    (mix (hash_name n)
      (match (identity_hash env n)
        ((some h) h)
        (none 0)))
    (keyed_all (ci_used info))))
(fn req_node_put ((t (IntMap (List (Prod Name ReqNode)))) (k Int) (n Name) (v ReqNode))
  (Prod (Option ReqNode) ReqMemo)
  (Prod.mk (some v) (ReqMemo (im_insert t k (cons (Prod.mk n v) (req_bucket t k))))))
;; does the walk pass n by: a name it has seen, or one that is not the load's own
(fn req_stop ((sc Scope) (seen (IntMap (List (Prod Name Int)))) (k Int) (n Name)) Bool
  (match (ords_find_at seen k n)
    ((some _) true)
    (none (bool_not (native_decl_at sc k n)))))
(fn req_fuel () Int 1000000)
(fn req_walk
  ((env CheckedEnv)
   (sc Scope)
   (ns (List (Prod Name Int)))
   (seen (IntMap (List (Prod Name Int))))
   (acc Int)
   (m ReqMemo)
   (fuel Int))
  ReqWalk
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (ReqWalk seen acc m)
  (match ns
    (nil (ReqWalk seen acc m))
    ((cons (Prod.mk n k) r)
     (if (req_stop sc seen k n) (req_walk env sc r seen acc m (- fuel 1))
     (match (req_node env m k n)
       ((Prod.mk none m1) (req_walk env sc r (ords_add_at seen k n 1) acc m1 (- fuel 1)))
       ((Prod.mk (some (ReqNode t cites)) m1)
        (match
          (req_walk env sc cites (ords_add_at seen k n 1) (mod (+ acc t) (hash_m)) m1 (- fuel 1))
          ((ReqWalk seen1 acc1 m2) (req_walk env sc r seen1 acc1 m2 (- fuel 1)))))))))))
(fulfills req_walk.dec_1 (by (intro p h n k r hm hc m1 hn) (apply natAbs_pred (arith))))
(fulfills req_walk.dec_2 (by (intro p h n k r hm hc t cites m1 hs) (apply natAbs_pred (arith))))
(fulfills req_walk.dec_3
  (by (intro p h n k r hm hc t cites m1 hs seen1 acc1 m2) (apply natAbs_pred (arith))))
(fulfills req_walk.dec_4 (by (intro p h n k r hm hc) (apply natAbs_pred (arith))))
;; the key, and the memo of its walk, which the caller keeps for the next key or drops
(fn req_key ((env CheckedEnv) (rc ReqCtx) (m ReqMemo) (T Expr)) (Prod Req ReqMemo)
  (match rc
    ((ReqCtx sc p e)
     (match (req_walk env sc (keyed_all (expr_consts T)) IMEmpty 0 m (req_fuel))
       ((ReqWalk _ d m1) (Prod.mk (ReqFull (hash_expr T) d p e) m1))))))
;; the key by a walk that starts from no memo and keeps none: the reader's, whose environment
;; holds the matchers of the form it is reading, which the load has not admitted
(fn req_key_alone ((env CheckedEnv) (rc ReqCtx) (T Expr)) Req
  (match (req_key env rc (req_memo_empty) T)
    ((Prod.mk k _) k)))
;; the sum of the names' hashes — the policy's part (the trusts' candidates, the parameters)
(fn req_names ((ns (List Name)) (acc Int)) Int
  (measure (struct ns))
  (match ns
    (nil acc)
    ((cons n r) (req_names r (mod (+ acc (hash_name n)) (hash_m))))))
(fn req_show ((k Req)) (List Int)
  (match k
    ((ReqFull s d p e)
     (append (show_int s)
       (cons 46 (append (show_int d) (cons 46 (append (show_int p) (cons 46 (show_int e))))))))
    ((ReqStmt s) (show_int s))))
;; an entry against the statement's key: the block when every part agrees (a schema-2 entry by
;; the statement alone), else the parts that differ, in the key's order
(type AutoFit (AutoFits (List SExpr)) (AutoStale (List (List Int))) (AutoNone))
(fn auto_fit ((entry (Option (Prod Req (List SExpr)))) (k Req)) AutoFit
  (match entry
    (none AutoNone)
    ((some (Prod.mk ek steps))
     (match k
       ((ReqFull s d p e)
        (match ek
          ((ReqStmt es) (if (= es s) (AutoFits steps) (AutoStale (list (utf8 "statement")))))
          ((ReqFull es ed ep ee)
           (let
             ((bad
                (append (if (= es s) nil (list (utf8 "statement")))
                  (append (if (= ed d) nil (list (utf8 "deps")))
                    (append (if (= ep p) nil (list (utf8 "policy")))
                      (if (= ee e) nil (list (utf8 "env"))))))))
             (match bad
               (nil (AutoFits steps))
               (_ (AutoStale bad)))))))
       ((ReqStmt s) (if (= (req_stmt ek) s) (AutoFits steps) (AutoStale (list (utf8 "statement")))))))))
(fn join_sp ((xs (List (List Int)))) (List Int)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x nil) x)
    ((cons x r) (append x (cons 44 (join_sp r))))))
;; the load's mode for proofs: `off` — the build, nothing searches; `solve` — an
;; `auto` without a valid entry is the engine's, RDSolved; `measure` — every hand-written proof is
;; read as usual and the engine is also run on the statement, RDMeasured (the engine's count)
(fn read_decl ((sc Scope) (env CheckedEnv) (s SExpr)) RDecl
  (read_decl_autos sc env s (no_producers) (sym "off")))
(fn read_decl_autos ((sc Scope) (env CheckedEnv) (s SExpr) (autos Producers) (mode Symbol)) RDecl
  (match s
    ((SList (cons (SSym h) args))
     (if (sym_eq h (sym "def")) (read_def sc env args (sym "def") nil mode)
     (if (sym_eq h (sym "abbrev")) (read_def sc env args (sym "abbrev") nil mode)
     (if (sym_eq h (sym "opaque")) (read_def sc env args (sym "opaque") nil mode)
     (if (sym_eq h (sym "theorem")) (read_def sc env args (sym "theorem") autos mode)
     (if (sym_eq h (sym "axiom")) (read_axiom sc env args)
     (if (sym_eq h (sym "inductive")) (read_inductive sc env args)
     (if (sym_eq h (sym "type")) (read_type sc env args)
     (if (sym_eq h (sym "structure")) (read_structure sc env args)
     (if
       (bool_or (sym_eq h (sym "import")) (bool_or (sym_eq h (sym "use")) (sym_eq h (sym "trusts"))))
       (RDDirective s)
       (if (sym_eq h (sym "sig")) (read_sig sc env args)
       (if (sym_eq h (sym "requirement")) (read_requirement sc env args)
       (if
         (bool_or (sym_eq h (sym "fn"))
           (bool_or (sym_eq h (sym "extern"))
             (bool_or (sym_eq h (sym "fulfills"))
               (bool_or (sym_eq h (sym "realize")) (sym_eq h (sym "bin"))))))
         (RDLater h)
         (match (reserved_why h)
           ((some ph)
            (RDErr (sym "reserved_form") (append (chars_of_sym h) (append (utf8 ": ") ph))))
           (none
             (match (lean_form h)
               ((some p)
                (RDErr (sym "lean_form") (append (chars_of_sym h) (append (utf8 " — ") p))))
               (none (RDErr (sym "unknown_form") (chars_of_sym h)))))))))))))))))))
    (_ (RDErr (sym "unknown_form") (utf8 "a top-level form is (KEYWORD …)")))))
(fn reserved_why ((h Symbol)) (Option (List Int))
  (if (bool_or (sym_eq h (sym "instance")) (sym_eq h (sym "class")))
    (some
      (utf8
        "there are no user classes and no instance declarations: an instance argument at Nat, Int, Bool or List is filled from a fixed table of Init's instances — pass a structure of functions as an argument, and for equality, ordering and printing write (derive TYPE CAPABILITY…)"))
  (if (sym_eq h (sym "requires"))
    (some
      (utf8
        "a clause of the bin form, not a form of its own: write (bin NAME (entry F) (externs E…) (trusts A…) (requires R…))"))
  (if (sym_eq h (sym "app"))
    (some
      (utf8
        "there is no app form: write the loop in the entry function of a bin — (bin NAME (entry F) (externs E…) (trusts A…) (requires R…))"))
  (if
    (bool_or (sym_eq h (sym "namespace"))
      (bool_or (sym_eq h (sym "section")) (sym_eq h (sym "variable"))))
    (some
      (utf8 "there is no such block: declare the dotted name, with its binders on each declaration"))
    none)))))
;; a Lean keyword with no form here is refused `lean_form` with what to write or the reason
;; (docs/LEAN.md lists the rows) — `unknown_form` is for the rest
(fn lean_form ((h Symbol)) (Option (List Int))
  (if (sym_eq h (sym "partial"))
    (some
      (utf8
        "there are no partial definitions: write (fn NAME BINDERS RET (measure M) BODY) — the measure is the totality obligation"))
  (if (sym_eq h (sym "unsafe"))
    (some (utf8 "there is no unsafe modifier: every declaration is checked by K"))
  (if
    (bool_or (sym_eq h (sym "notation"))
      (bool_or (sym_eq h (sym "infix"))
        (bool_or (sym_eq h (sym "infixl"))
          (bool_or (sym_eq h (sym "infixr"))
            (bool_or (sym_eq h (sym "prefix"))
              (bool_or (sym_eq h (sym "postfix"))
                (bool_or (sym_eq h (sym "syntax"))
                  (bool_or (sym_eq h (sym "macro"))
                    (bool_or (sym_eq h (sym "macro_rules"))
                      (bool_or (sym_eq h (sym "elab"))
                        (bool_or (sym_eq h (sym "elab_rules")) (sym_eq h (sym "declare_syntax_cat")))))))))))))
    (some
      (utf8
        "there are no user-defined notation, macros or syntax extensions: define a fn or a def under an ordinary name; a proof procedure is a fn from the goal's text to a block of steps, named by (auto (tactic M.FN)) — the surface is fixed with the elaborator"))
    (if (sym_eq h (sym "open"))
      (some (utf8 "Lean's open is (use PREFIX) or (use PREFIX NAME…); import opens nothing"))
    (if (bool_or (sym_eq h (sym "lemma")) (sym_eq h (sym "example")))
      (some (utf8 "write (theorem NAME BINDERS PROP PROOF): every theorem is named"))
    (if (sym_eq h (sym "mutual"))
      (some
        (utf8
          "there is no mutual block: write each fn on its own, with its (measure …) — functions that call each other are found and defined together as one group"))
    (if (bool_or (sym_eq h (sym "termination_by")) (sym_eq h (sym "decreasing_by")))
      (some
        (utf8
          "the measure is written in the fn: (fn NAME BINDERS RET (measure M) BODY); a descent it leaves to prove is (fulfills NAME.dec_N PROOF)"))
    (if (sym_eq h (sym "noncomputable"))
      (some
        (utf8 "no modifier: a def is logical and never runs; a fn is a def with its realization"))
    (if (bool_or (sym_eq h (sym "private")) (sym_eq h (sym "protected")))
      (some (utf8 "no modifier: a directory module's public surface is its view, DIR/mod.req.shard"))
    (if (sym_eq h (sym "universe"))
      (some (utf8 "universe parameters are declared on the name: (def NAME.{u} …)"))
    (if (sym_eq h (sym "deriving")) (some (utf8 "write (derive TYPE CAPABILITY…) after the type"))
    (if (sym_eq h (sym "implemented_by"))
      (some
        (utf8
          "write (realize NAME BINDERS RET BODY): it attaches the executable body to a declared constant"))
    (if (sym_eq h (sym "attribute"))
      (some (utf8 "there are no attributes: simp_only and rw take their lemmas by name"))
    (if (sym_eq h (sym "set_option"))
      (some (utf8 "there are no options: the elaborator has one behavior, versioned with it"))
      none)))))))))))))))

;; (def NAME.{u…} BINDERS TYPE VALUE); abbrev, opaque; (theorem … PROP PROOF)
(fn read_def
  ((sc Scope) (env CheckedEnv) (args (List SExpr)) (kind Symbol) (autos Producers) (mode Symbol))
  RDecl
  (match args
    ((cons hd (cons (SList bs) (cons ty (cons val nil))))
     (match (read_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RDErr (sym "bad_binder") m))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (if (sym_eq kind (sym "theorem"))
                (read_proof e2 n lps fvars t val (auto_entry sc (pr_autos autos) n) mode autos)
                (match (elab e2 val (some t))
                  ((EErr r m) (RDErr r m))
                  ((EOk e3 v _)
                   (match (close_pis e3 fvars t)
                     ((Prod.mk _ (FinErr r m)) (RDErr r m))
                     ((Prod.mk e4 (FinOk T))
                      (match (close_lams e4 fvars v)
                        ((Prod.mk _ (FinErr r m)) (RDErr r m))
                        ((Prod.mk e5 (FinOk value))
                         (let ((cv (ConstantVal n lps T)))
                           (if (sym_eq kind (sym "opaque"))
                             (rd_ok e5 (list (OpaqueDecl cv value false (list n))))
                             (rd_ok e5
                               (list
                                 (DefnDecl cv value
                                   (if (sym_eq kind (sym "abbrev")) HAbbrev
                                   (HRegular (def_height (el_env e5) value)))
                                   Safe
                                   (list n))))))))))))))))))))
    (_
      (RDErr (sym "bad_shape")
        (append (utf8 "(") (append (chars_of_sym kind) (utf8 " NAME ((x TYPE)…) TYPE VALUE)")))))))

;; (extern NAME BINDERS RET): in L an opaque constant of the declared type. K's opaque kind
;; checks a value and never unfolds it, so the value is the type's default witness
;; (inhabit.shard) and the constant has no equations: a function calling the extern is defined
;; with its equations, and a requirement can name the entry. No witness is
;; `extern_uninhabited`; a binder or the result the elaborator cannot read is its refusal — the
;; loader then keeps the extern E-only with the obstacle on its record (loader.shard
;; load_extern)
(fn read_extern ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons hd (cons (SList bs) (cons ty nil)))
     (match (read_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RDErr (sym "bad_binder") m))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (match (inhabit (el_w e2) t 32)
                ((Prod.mk _ none)
                 (RDErr (sym "extern_uninhabited")
                   (append (show_name n)
                     (utf8
                       ": no default value of the declared result type can be built (a sort, a proposition, or a type without a closing constructor)"))))
                ((Prod.mk w (some v))
                 (match (close_pis (el_set_w e2 w) fvars t)
                   ((Prod.mk _ (FinErr r m)) (RDErr r m))
                   ((Prod.mk e4 (FinOk T))
                    (match (close_lams e4 fvars v)
                      ((Prod.mk _ (FinErr r m)) (RDErr r m))
                      ((Prod.mk e5 (FinOk value))
                       (rd_ok e5 (list (OpaqueDecl (ConstantVal n lps T) value false (list n)))))))))))))))))
    (_ (RDErr (sym "bad_shape") (utf8 "(extern NAME ((x TYPE)…) TYPE)")))))

;; the sidecar's entry for the theorem n: its name as written, qualified as n was
(fn auto_entry ((sc Scope) (autos (List Auto)) (n Name)) (Option (Prod Req (List SExpr)))
  (auto_entry_as sc autos n Anon))
;; a discharge's theorem is OBLIGATION.proof: the entry names the obligation (f.dec_1)
(fn auto_entry_as ((sc Scope) (autos (List Auto)) (n Name) (suffix Name))
  (Option (Prod Req (List SExpr)))
  (measure (struct autos))
  (match autos
    (nil none)
    ((cons (Auto an fp steps) r)
     (if (name_eq (name_append (qualify sc an) suffix) n) (some (Prod.mk fp steps))
     (auto_entry_as sc r n suffix)))))
;; a proof: (exact TERM) — TERM at the statement, over the binders; sorry; (by STEP…) — I's
;; block on the statement closed over the binders (tactic.shard); auto or
;; (auto HINT…) — the sidecar's block for the theorem, replayed as (by …) when the entry's
;; key is the statement's: no entry is pending
;; auto_missing, another requirement's entry pending auto_stale with the parts that differ
;; named; the hints are the producer's, unread here
(fn read_proof
  ((e El)
   (n Name)
   (lps (List Name))
   (fvars (List Expr))
   (t Expr)
   (p SExpr)
   (entry (Option (Prod Req (List SExpr))))
   (mode Symbol)
   (pr Producers))
  RDecl
  (if (sym_eq mode (sym "measure")) (read_measured e n lps fvars t p entry pr)
  (read_proof_go e n lps fvars t p entry mode pr)))
(fn read_proof_go
  ((e El)
   (n Name)
   (lps (List Name))
   (fvars (List Expr))
   (t Expr)
   (p SExpr)
   (entry (Option (Prod Req (List SExpr))))
   (mode Symbol)
   (pr Producers))
  RDecl
  (match p
    ((SSym s)
     (if (sym_eq s (sym "sorry")) (RDPending n (sym "sorry"))
     (if (sym_eq s (sym "auto")) (read_auto e n lps fvars t entry nil mode pr)
     (RDErr (sym "bad_proof") (utf8 "a proof is (exact TERM), (by STEP…), auto or sorry")))))
    ((SList (cons (SSym x) nil))
     (if (sym_eq x (sym "auto")) (read_auto e n lps fvars t entry nil mode pr)
     (RDErr (sym "bad_proof") (utf8 "a proof is (exact TERM), (by STEP…), auto or sorry"))))
    ((SList (cons (SSym x) (cons pt rest)))
     (if (sym_eq x (sym "auto")) (read_auto e n lps fvars t entry (cons pt rest) mode pr)
     (if (bool_and (sym_eq x (sym "exact")) (= (len rest) 0))
       (match (elab e pt (some t))
         ((EErr r m) (RDErr r m))
         ((EOk e1 v _)
          (match (close_pis e1 fvars t)
            ((Prod.mk _ (FinErr r m)) (RDErr r m))
            ((Prod.mk e2 (FinOk T))
             (match (close_lams e2 fvars v)
               ((Prod.mk _ (FinErr r m)) (RDErr r m))
               ((Prod.mk e3 (FinOk value))
                (rd_ok e3 (list (ThmDecl (ConstantVal n lps T) value (list n))))))))))
     (if (sym_eq x (sym "by"))
       (match (close_pis e fvars t)
         ((Prod.mk _ (FinErr r m)) (RDErr r m))
         ((Prod.mk e1 (FinOk T))
          (match (tac_prove e1 T (len fvars) (cons pt rest))
            ((ProveErr r m) (RDErr r m))
            ((ProvePending _ gs)
             (RDPending n
               (sym_of_chars
                 (append (utf8 "sorry goals=") (append (show_nat (len gs)) (goals_bracketed gs))))))
            ((ProveOk e2 value) (rd_ok e2 (list (ThmDecl (ConstantVal n lps T) value (list n))))))))
       (RDErr (sym "bad_proof") (utf8 "a proof is (exact TERM), (by STEP…), auto or sorry"))))))
    (_ (RDErr (sym "bad_proof") (utf8 "a proof is (exact TERM), (by STEP…), auto or sorry")))))
(fn read_auto
  ((e El)
   (n Name)
   (lps (List Name))
   (fvars (List Expr))
   (t Expr)
   (entry (Option (Prod Req (List SExpr))))
   (hints (List SExpr))
   (mode Symbol)
   (pr Producers))
  RDecl
  (match (close_pis e fvars t)
    ((Prod.mk _ (FinErr r m)) (RDErr r m))
    ((Prod.mk e1 (FinOk T))
     (let ((key (req_key_alone (el_env e1) (pr_req pr) T)))
       (match (auto_fit entry key)
         ((AutoFits steps)
          (match entry
            ;; a schema-2 entry fits by its statement; under solve it is re-keyed whole (the
            ;; restamp, no search)
            ((some (Prod.mk (ReqStmt _) _))
             (if (sym_eq mode (sym "solve"))
               (match (read_block_proof e1 n lps fvars T steps)
                 ((RDOk ds) (RDSolved n key steps ds))
                 (other other))
               (read_block_proof e1 n lps fvars T steps)))
            (_ (read_block_proof e1 n lps fvars T steps))))
         (fit
           (if (sym_eq mode (sym "solve"))
             (match (tactic_named hints)
               ((TacticErr m)
                (RDPending n
                  (sym_of_chars
                    (append (utf8 "auto_unsolved fp=")
                      (append (show_int (req_stmt key)) (append (utf8 " ") m))))))
               ((TacticNamed tfn rest)
                ;; the library's block, replayed as an entry's would be before it is one
                (match (run_tactic e1 T (len fvars) tfn rest pr)
                  ((TacNo m)
                   (RDPending n
                     (sym_of_chars
                       (append (utf8 "auto_unsolved fp=")
                         (append (show_int (req_stmt key))
                           (append (utf8 " tactic=") (append (show_name tfn) (append (utf8 ": ") m))))))))
                  ((TacSteps steps)
                   (match (read_block_proof e1 n lps fvars T steps)
                     ((RDOk ds) (RDSolved n key steps ds))
                     ((RDErr r m)
                      (RDPending n
                        (sym_of_chars
                          (append (utf8 "auto_unsolved fp=")
                            (append (show_int (req_stmt key))
                              (append (utf8 " tactic=")
                                (append (show_name tfn)
                                  (append (utf8 ": ")
                                    (append (chars_of_sym r) (append (utf8 ": ") m))))))))))
                     ((RDPending _ why)
                      (RDPending n
                        (sym_of_chars
                          (append (utf8 "auto_unsolved fp=")
                            (append (show_int (req_stmt key))
                              (append (utf8 " tactic=")
                                (append (show_name tfn) (append (utf8 ": ") (chars_of_sym why)))))))))
                     (other other)))))
               (TacticNone
                 ;; the engine's block, replayed as an entry's would be before it is one
                 (match (engine_prove e1 T (len fvars) hints)
                   ((NotProduced m)
                    (RDPending n
                      (sym_of_chars
                        (append (utf8 "auto_unsolved fp=")
                          (append (show_int (req_stmt key)) (append (utf8 " ") m))))))
                   ((Produced nodes)
                    (let ((steps (nodes_sx nodes)))
                      (match (read_block_proof e1 n lps fvars T steps)
                        ((RDOk ds) (RDSolved n key steps ds))
                        (other other)))))))
             (RDPending n
               (sym_of_chars
                 (match fit
                   ((AutoStale bad)
                    (append (utf8 "auto_stale ")
                      (append (join_sp bad) (append (utf8 " fp=") (show_int (req_stmt key))))))
                   (_ (append (utf8 "auto_missing fp=") (show_int (req_stmt key))))))))))))))
;; the producer a delegation names: `(tactic M.FN)` among the hints, once;
;; the hints after it are the library's
(type TacticHint (TacticNamed Name (List SExpr)) (TacticNone) (TacticErr (List Int)))
(fn tactic_named ((hints (List SExpr))) TacticHint (tactic_named_go hints none nil))
(fn tactic_named_go ((hints (List SExpr)) (found (Option Name)) (acc (List SExpr))) TacticHint
  (measure (struct hints))
  (match hints
    (nil
      (match found
        ((some f) (TacticNamed f (rev acc)))
        (none TacticNone)))
    ((cons (SList (cons (SSym h) args)) r)
     (if (sym_eq h (sym "tactic"))
       (match found
         ((some _)
          (TacticErr
            (utf8
              "tactic: several tactics in one delegation — name one; a library composes its own")))
         (none
           (match args
             ((cons (SSym f) nil)
              (match (name_of_sym f)
                ((some fn) (tactic_named_go r (some fn) acc))
                (none (TacticErr (append (utf8 "tactic: not a name: ") (chars_of_sym f))))))
             (_
               (TacticErr (utf8 "tactic: (tactic M.FN) names one fn of the load, module-qualified"))))))
       (tactic_named_go r found (cons (SList (cons (SSym h) args)) acc))))
    ((cons o r) (tactic_named_go r found (cons o acc)))))
;; the tactic run: M.FN a fn of the loaded programs taking the goal
;; and the hints as text and answering text; the goal as goal_sx renders it, the hints as
;; the S text of the forms after (tactic M.FN); the answer one block (STEP…), or empty
(type TacRun (TacSteps (List SExpr)) (TacNo (List Int)))
(fn run_tactic ((e El) (T Expr) (nctx Int) (tfn Name) (hints (List SExpr)) (pr Producers)) TacRun
  (match pr
    ((Producers _ est fuel _)
     (let ((prog (es_prog est)))
       (match (prog_find prog tfn)
         ((some (EFn _ ntp (cons gt (cons ht nil)) rt _ _))
          (if
            (bool_not
              (bool_and (= ntp 0) (bool_and (text_type gt) (bool_and (text_type ht) (text_type rt)))))
            (TacNo
              (append (show_name tfn)
                (utf8
                  " is not (fn NAME ((goal TEXT) (hints TEXT)) TEXT), TEXT a byte type of the entry codec ((List Nat) or (List Int), ByteArray)")))
            (match (el_fresh e (n1 (sym "goal")) T (sym "goal"))
              ((Prod.mk e1 (MVar _ i))
               (let ((g (Goal i T nctx)))
                 (match (val_of_text gt (goal_sx e1 g))
                   (none (TacNo (utf8 "the goal's text has no value of the parameter's type")))
                   ((some gv)
                    (match
                      (val_of_text ht (append (utf8 "(") (append (show_sexprs hints) (utf8 ")"))))
                      (none (TacNo (utf8 "the hints' text has no value of the parameter's type")))
                      ((some hv)
                       (match (ev prog tfn (list gv hv) fuel)
                         ((EvOk v)
                          (match (text_of_val v)
                            (none (TacNo (utf8 "the answer is not text")))
                            ((some nil) (TacNo (utf8 "no answer")))
                            ((some bs)
                             (match (read_all bs)
                               ((RAErr r off)
                                (TacNo
                                  (append (utf8 "the answer does not read: ")
                                    (append (chars_of_sym r)
                                      (append (utf8 " at byte ")
                                        (append (show_nat off) (append (utf8 " of ") bs)))))))
                               ((RAOk (cons (SList steps) nil)) (TacSteps steps))
                               ((RAOk _)
                                (TacNo (append (utf8 "the answer is not one block (STEP…): ") bs)))))))
                         ((EvStuck r f)
                          (TacNo
                            (append (utf8 "ev: stuck ")
                              (append (chars_of_sym r) (append (utf8 " in ") (show_name f))))))
                         ((EvExhausted r f)
                          (TacNo
                            (append (utf8 "ev: exhausted ")
                              (append (chars_of_sym r) (append (utf8 " in ") (show_name f))))))
                         (EvOut (TacNo (utf8 "ev: the tactic performed an effect"))))))))))
              ((Prod.mk _ _) (TacNo (utf8 "no metavariable"))))))
         ((some _)
          (TacNo
            (append (show_name tfn)
              (utf8
                " is not (fn NAME ((goal TEXT) (hints TEXT)) TEXT): a fn of two parameters, no type parameter"))))
         (none
           (TacNo
             (append (show_name tfn)
               (utf8
                 " is not a fn of the load (the library is imported as any module; the name is module-qualified)")))))))))
;; a block on the closed statement: the theorem, pending with its goals, or the refusal
(fn read_block_proof
  ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (T Expr) (steps (List SExpr)))
  RDecl
  (match (tac_prove e T (len fvars) steps)
    ((ProveErr r m) (RDErr r m))
    ((ProvePending _ gs)
     (RDPending n
       (sym_of_chars
         (append (utf8 "sorry goals=") (append (show_nat (len gs)) (goals_bracketed gs))))))
    ((ProveOk e2 value) (rd_ok e2 (list (ThmDecl (ConstantVal n lps T) value (list n)))))))
;; mode `measure`: the proof as written, and whether the engine closes the statement unaided —
;; the engine's count; an `auto` here is read as the build reads it
(fn read_measured
  ((e El)
   (n Name)
   (lps (List Name))
   (fvars (List Expr))
   (t Expr)
   (p SExpr)
   (entry (Option (Prod Req (List SExpr))))
   (pr Producers))
  RDecl
  (match (read_proof_go e n lps fvars t p entry (sym "off") pr)
    ((RDOk ds)
     (match (close_pis e fvars t)
       ((Prod.mk _ (FinErr r m)) (RDOk ds))
       ((Prod.mk e1 (FinOk T))
        (RDMeasured n
          (match (engine_prove e1 T (len fvars) nil)
            ((Produced _) true)
            ((NotProduced _) false))
          (measure_tactic e1 n lps fvars T p pr)
          ds))))
    (other other)))
;; under `measure`, the tactic a delegation names is run too: its name
;; and whether its answer closes the statement; None when none is named
(fn measure_tactic
  ((e El) (n Name) (lps (List Name)) (fvars (List Expr)) (T Expr) (p SExpr) (pr Producers))
  (Option (Prod Name Bool))
  (match p
    ((SList (cons (SSym x) hints))
     (if (sym_eq x (sym "auto"))
       (match (tactic_named hints)
         ((TacticNamed tfn rest)
          (some
            (Prod.mk tfn
              (match (run_tactic e T (len fvars) tfn rest pr)
                ((TacNo _) false)
                ((TacSteps steps)
                 (match (read_block_proof e n lps fvars T steps)
                   ((RDOk _) true)
                   (_ false)))))))
         (_ none))
       none))
    (_ none)))

;; ---- views ------------------------------------------------------------------------------
;; (sig type NAME) / (sig type (NAME T…)): the parameter NAME : Type → … → Type
;; (sig fn NAME BINDERS RET): the parameter NAME : ∀ BINDERS, RET — E-types (level 0 by rule)
(fn read_sig ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons (SSym k) rest)
     (if (sym_eq k (sym "type"))
       (match rest
         ((cons hd nil)
          (match (type_head sc hd)
            ((Prod.mk none m) (RDErr (sym "bad_name") m))
            ((Prod.mk (some (Prod.mk n params)) _)
             (RDParam (AxiomDecl (ConstantVal n nil (type_former_type (len params))) false)
               (sym "type")
               (len params)))))
         (_ (RDErr (sym "bad_shape") (utf8 "(sig type NAME) or (sig type (NAME T…))"))))
     (if (sym_eq k (sym "fn"))
       (match (read_signature sc env rest)
         ((Prod.mk (some (Prod.mk n t)) _)
          (RDParam (AxiomDecl (ConstantVal n nil t) false) (sym "fn") 0))
         ((Prod.mk none m) (RDErr (sym "bad_shape") m)))
       (RDErr (sym "bad_shape") (utf8 "(sig fn NAME BINDERS RET) or (sig type NAME)")))))
    (_ (RDErr (sym "bad_shape") (utf8 "(sig fn NAME BINDERS RET) or (sig type NAME)")))))
;; Type → … → Type with k arrows
(fn type_former_type ((k Int)) Expr
  (measure (Int.natAbs k))
  (if (< k 1) (mk_sort (LSucc LZero))
  (mk_pi Anon BDefault (mk_sort (LSucc LZero)) (type_former_type (- k 1)))))
(fulfills type_former_type.dec_1 (by (intro k h) (apply natAbs_pred (arith))))
;; NAME BINDERS RET …: the E signature as a Π-type — a `sig fn`'s, or a `fn`'s
;; head (its body and measure ignored); the qualified name with it
(fn read_signature ((sc Scope) (env CheckedEnv) (args (List SExpr)))
  (Prod (Option (Prod Name Expr)) (List Int))
  (match args
    ((cons (SSym x) (cons (SList bs) (cons ret _)))
     (match (name_of_sym x)
       (none (Prod.mk none (chars_of_sym x)))
       ((some short)
        (match (read_binders (el_with_etype (el0 sc env nil nil (qualify sc short)) true) bs nil)
          ((Prod.mk none m) (Prod.mk none (append (utf8 "bad binder: ") m)))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ret)
             ((EErr r m) (Prod.mk none (append (chars_of_sym r) (append (utf8 ": ") m))))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Prod.mk _ (FinErr r m))
                 (Prod.mk none (append (chars_of_sym r) (append (utf8 ": ") m))))
                ((Prod.mk _ (FinOk T)) (Prod.mk (some (Prod.mk (qualify sc short) T)) nil))))))))))
    (_ (Prod.mk none (utf8 "NAME ((x TYPE)…) RET")))))
;; (requirement NAME BINDERS PROP): the parameter NAME : ∀ BINDERS, PROP (L terms)
(fn read_requirement ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match (read_statement sc env args)
    ((RSOk e n lps _ _ T)
     (match (el_aux e)
       (nil (RDParam (AxiomDecl (ConstantVal n lps T) false) (sym "requirement") 0))
       (_
         (RDErr (sym "match_in_requirement")
           (utf8
             "a requirement's statement with a match needs its matcher in the view: state it over a def")))))
    ((RSErr m) (RDErr (sym "bad_shape") m))))
;; a statement read: the state over the binders, the name, its universe
;; parameters, the fvars, the open proposition, the closed one
(type RStmt (RSOk El Name (List Name) (List Expr) Expr Expr) (RSErr (List Int)))
(fn read_statement ((sc Scope) (env CheckedEnv) (args (List SExpr))) RStmt
  (match args
    ((cons hd (cons (SList bs) (cons prop nil)))
     (match (read_head sc hd)
       ((Prod.mk none m) (RSErr m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RSErr (append (utf8 "bad binder: ") m)))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 prop)
             ((EErr r m) (RSErr (append (chars_of_sym r) (append (utf8 ": ") m))))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Prod.mk _ (FinErr r m)) (RSErr (append (chars_of_sym r) (append (utf8 ": ") m))))
                ((Prod.mk e3 (FinOk T)) (RSOk e3 n lps fvars t T))))))))))
    (_ (RSErr (utf8 "(requirement NAME ((x TYPE)…) PROP)")))))
;; (fulfills NAME PROOF) against the view's (requirement NAME BINDERS PROP), the
;; statement re-read in this environment: a theorem, or pending
(fn read_fulfills
  ((sc Scope)
   (env CheckedEnv)
   (req_args (List SExpr))
   (proof SExpr)
   (autos Producers)
   (mode Symbol))
  RDecl
  (match (read_statement sc env req_args)
    ((RSErr m) (RDErr (sym "bad_shape") m))
    ((RSOk e n lps fvars t _)
     (read_proof e n lps fvars t proof (auto_entry sc (pr_autos autos) n) mode autos))))

;; (fulfills f.dec_N PROOF) outside a view: PROOF against the
;; obligation's own statement, a theorem under `thm`
(fn read_discharge
  ((sc Scope) (env CheckedEnv) (thm Name) (stmt Expr) (proof SExpr) (autos Producers) (mode Symbol))
  RDecl
  (read_proof (el0 sc env nil nil thm) thm nil nil stmt proof
    (auto_entry_as sc (pr_autos autos) thm (n1 (sym "proof")))
    mode
    autos))

;; (axiom NAME.{u…} BINDERS TYPE) — the loader admits it only under (trusts NAME)
(fn read_axiom ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons hd (cons (SList bs) (cons ty nil)))
     (match (read_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RDErr (sym "bad_binder") m))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Prod.mk _ (FinErr r m)) (RDErr r m))
                ((Prod.mk e3 (FinOk T)) (rd_ok e3 (list (AxiomDecl (ConstantVal n lps T) false))))))))))))
    (_ (RDErr (sym "bad_shape") (utf8 "(axiom NAME ((x TYPE)…) TYPE)")))))

;; (inductive NAME.{u…} BINDERS TYPE (CTOR TYPE)…): one type, Lean's shapes; the
;; type's own name is citable in the constructors with the type it declares
(fn read_inductive ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons hd (cons (SList bs) (cons ty ctors)))
     (match (read_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RDErr (sym "bad_binder") m))
          ((Prod.mk (some (Prod.mk e1 fvars)) _)
           (match (elab_type e1 ty)
             ((EErr r m) (RDErr r m))
             ((EOk e2 t _)
              (match (close_pis e2 fvars t)
                ((Prod.mk _ (FinErr r m)) (RDErr r m))
                ((Prod.mk e3 (FinOk IT))
                 (match
                   (read_ctors (el_with_defining e3 (list (Defd n (len lps) IT))) n fvars ctors nil)
                   ((Prod.mk none m) (RDErr (sym "bad_constructor") m))
                   ((Prod.mk (some cs) _)
                    (RDOk (list (InductDecl lps (len fvars) (list (InductiveType n IT cs)) false))))))))))))))
    (_ (RDErr (sym "bad_shape") (utf8 "(inductive NAME ((x TYPE)…) TYPE (CTOR TYPE)…)")))))
;; (CTOR TYPE): the constructor's type after the parameters, in the binder context
(fn read_ctors ((e El) (ind Name) (fvars (List Expr)) (cs (List SExpr)) (acc (List Constructor)))
  (Prod (Option (List Constructor)) (List Int))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (some (rev acc)) nil))
    ((cons (SList (cons (SSym cn) (cons ty nil))) r)
     (match (name_of_sym cn)
       (none (Prod.mk none (chars_of_sym cn)))
       ((some short)
        (match (elab_type e ty)
          ((EErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
          ((EOk e1 t _)
           (match (close_pis e1 fvars t)
             ((Prod.mk _ (FinErr r2 m))
              (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
             ((Prod.mk e2 (FinOk CT))
              (read_ctors e2 ind fvars r (cons (Constructor (name_append ind short) CT) acc)))))))))
    (_ (Prod.mk none (utf8 "a constructor is (CTOR TYPE)")))))

;; (type (NAME T…) (CTOR FIELD-TYPE…)…) / (type NAME (CTOR FIELD-TYPE…)…): the
;; E data form as an inductive with `(T Type)` parameters, result `Type`,
;; non-dependent fields in E-type position (level 0 by rule)
(fn read_type ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons hd ctors)
     (match (type_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Prod.mk n params)) _)
        (let ((IT (type_former_type (len params))))
          (match
            (type_locals (el_with_etype (el0 sc env nil (list (Defd n 0 IT)) n) true) params nil)
            ((Prod.mk e1 fvars)
             (match (w_apps (el_w e1) (mk_const n nil) fvars)
               ((Prod.mk w2 result)
                (match (read_fields_ctors (el_set_w e1 w2) n fvars result ctors nil)
                  ((Prod.mk none m) (RDErr (sym "bad_constructor") m))
                  ((Prod.mk (some cs) _)
                   (RDOk (list (InductDecl nil (len params) (list (InductiveType n IT cs)) false)))))))))))))
    (_ (RDErr (sym "bad_shape") (utf8 "(type (NAME T…) (CTOR FIELD-TYPE…)…)")))))
;; the `(T Type)` parameters as locals — implicit in the constructors, as Lean's inductive
;; parameters are and as E cites them (`(Pair2.mk two green)` in L as in a body)
(fn type_locals ((e El) (ps (List Name)) (acc (List Expr))) (Prod El (List Expr))
  (measure (struct ps))
  (match ps
    (nil (Prod.mk e (rev acc)))
    ((cons p r)
     (match (el_local e p (mk_sort (LSucc LZero)) BImplicit)
       ((Prod.mk e1 fv) (type_locals e1 r (cons fv acc)))))))
;; (CTOR FIELD-TYPE…): CTOR : (T…) → FIELD-TYPES → NAME T…
(fn read_fields_ctors
  ((e El) (ind Name) (fvars (List Expr)) (result Expr) (cs (List SExpr)) (acc (List Constructor)))
  (Prod (Option (List Constructor)) (List Int))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk (some (rev acc)) nil))
    ((cons (SList (cons (SSym cn) fields)) r)
     (match (name_of_sym cn)
       (none (Prod.mk none (chars_of_sym cn)))
       ((some short)
        (match (field_locals e fields nil)
          ((Prod.mk none m) (Prod.mk none m))
          ((Prod.mk (some (Prod.mk e1 flocals)) _)
           (match (close_pis e1 (append fvars flocals) result)
             ((Prod.mk _ (FinErr r2 m))
              (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
             ((Prod.mk e2 (FinOk CT))
              (read_fields_ctors (el_restore e2 e) ind fvars result r
                (cons (Constructor (name_append ind short) CT) acc)))))))))
    (_ (Prod.mk none (utf8 "a constructor is (CTOR FIELD-TYPE…)")))))
;; each field type in the parameter context, an anonymous local per field
(fn field_locals ((e El) (fields (List SExpr)) (acc (List Expr)))
  (Prod (Option (Prod El (List Expr))) (List Int))
  (measure (struct fields))
  (match fields
    (nil (Prod.mk (some (Prod.mk e (rev acc))) nil))
    ((cons f r)
     (match (elab_type e f)
       ((EErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
       ((EOk e1 t _)
        (match (el_local e1 Anon t BDefault)
          ((Prod.mk e2 fv) (field_locals e2 r (cons fv acc)))))))))

;; (structure NAME.{u…} BINDERS (FIELD TYPE)…): the inductive with `NAME.mk`
;; (the fields as dependent binders after the parameters), then a projection
;; `NAME.FIELD` per field as an abbrev over `proj` (Lean's projections are
;; `Expr.proj` definitions), its type the field's type with the earlier
;; fields replaced by their projections of `self`
(fn read_structure ((sc Scope) (env CheckedEnv) (args (List SExpr))) RDecl
  (match args
    ((cons hd (cons (SList bs) fields))
     (match (read_head sc hd)
       ((Prod.mk none m) (RDErr (sym "bad_name") m))
       ((Prod.mk (some (Head n lps)) _)
        (match (read_binders (el0 sc env lps nil n) bs nil)
          ((Prod.mk none m) (RDErr (sym "bad_binder") m))
          ((Prod.mk (some (Prod.mk e1 params)) _)
           (match (close_pis e1 params (mk_sort (LSucc LZero)))
             ((Prod.mk _ (FinErr r m)) (RDErr r m))
             ((Prod.mk e2 (FinOk IT))
              (let ((e3 (el_with_defining e2 (list (Defd n (len lps) IT)))))
                (match (w_apps (el_w e3) (mk_const n (lparam_levels lps)) params)
                  ((Prod.mk w4 self_ty)
                   (match (read_binders (el_set_w e3 w4) fields nil)
                     ((Prod.mk none m) (RDErr (sym "bad_field") m))
                     ((Prod.mk (some (Prod.mk e5 fs)) _)
                      (match (close_pis e5 (append params fs) self_ty)
                        ((Prod.mk _ (FinErr r m)) (RDErr r m))
                        ((Prod.mk e6 (FinOk CT))
                         (let
                           ((ctor
                              (Constructor.Constructor (name_append n (Str Anon (sym "mk")))
                                (implicit_prefix CT (len params)))))
                           (match (el_local (el_restore e6 e3) (self_name) self_ty BDefault)
                             ((Prod.mk e7 self)
                              (match (projections e7 n lps params self fields 0 nil nil)
                                ((Prod.mk none m) (RDErr (sym "bad_field") m))
                                ((Prod.mk (some projs) _)
                                 (RDOk
                                   (cons
                                     (InductDecl lps (len params)
                                       (list (InductiveType n IT (list ctor)))
                                       false)
                                     projs)))))))))))))))))))))
    (_ (RDErr (sym "bad_shape") (utf8 "(structure NAME ((x TYPE)…) (FIELD TYPE)…)")))))

;; NAME.f_i : forall BINDERS (self : NAME params), T_i[f_j := (proj NAME j self)]
;;   := fun BINDERS self => (proj NAME i self)
;; T_i is re-elaborated from its source over the bound `self`, the earlier
;; fields as aliases carrying their open types (elab_sym: the structure is not
;; in the environment yet, so K cannot type the projection); `e` holds the
;; parameters and `self`
(fn projections
  ((e El)
   (n Name)
   (lps (List Name))
   (params (List Expr))
   (self Expr)
   (fields (List SExpr))
   (i Int)
   (aliases (List (Prod Name (Prod Int Expr))))
   (acc (List Declaration)))
  (Prod (Option (List Declaration)) (List Int))
  (measure (struct fields))
  (match fields
    (nil (Prod.mk (some (rev acc)) nil))
    ((cons (SList (cons (SSym fx) (cons fty _))) r)
     (match (name_of_sym fx)
       (none (Prod.mk none (chars_of_sym fx)))
       ((some f)
        (match (elab_type (el_with_aliases e aliases) fty)
          ((EErr r2 m) (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
          ((EOk e2 t _)
           (match (close_pis e2 (append params (list self)) t)
             ((Prod.mk _ (FinErr r2 m))
              (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
             ((Prod.mk e3 (FinOk PT))
              (match (close_lams e3 (append params (list self)) (mk_proj n i self))
                ((Prod.mk _ (FinErr r2 m))
                 (Prod.mk none (append (chars_of_sym r2) (append (utf8 ": ") m))))
                ((Prod.mk e4 (FinOk value))
                 (projections (el_restore e4 e) n lps params self r (+ i 1)
                   (cons (Prod.mk f (Prod.mk i (el_zonk e4 t))) aliases)
                   (cons
                     (DefnDecl (ConstantVal (name_append n f) lps (implicit_prefix PT (len params)))
                       (implicit_prefix value (len params))
                       HAbbrev
                       Safe
                       (list (name_append n f)))
                     acc)))))))))))
    (_ (Prod.mk none (utf8 "a field is (FIELD TYPE)")))))
;; the first k binders of a Pi or lambda chain made implicit: a structure's parameters in its
;; constructor and its projections, as Lean declares them — explicit in the type itself — so a
;; package's field is read as `(Monoid.op m x y)`
(fn implicit_prefix ((e Expr) (k Int)) Expr
  (measure (Int.natAbs k))
  (if (< k 1) e
  (match e
    ((Pi _ n _ dom body) (mk_pi n BImplicit dom (implicit_prefix body (- k 1))))
    ((Lam _ n _ dom body) (mk_lam n BImplicit dom (implicit_prefix body (- k 1))))
    (_ e))))
(fulfills implicit_prefix.dec_1 (by (intro p h a n bi dom body hm) (apply natAbs_pred (arith))))
(fulfills implicit_prefix.dec_2 (by (intro p h a n bi dom body hm) (apply natAbs_pred (arith))))
