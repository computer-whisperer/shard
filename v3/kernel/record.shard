;;; v3/kernel/record.shard — records: named-field products as loader-level sugar.
;;;
;;;   (record NAME (ctor CTOR)? (FIELD TYPE)+)      NAME may be (NAME P…), P… type parameters
;;;
;;; expands at the s-expression level, before any form is read, into the positional
;;; single-constructor type `(type NAME (CTOR TYPE…))` — CTOR defaults to MkNAME — an
;;; accessor `NAME.FIELD : NAME → TYPE` and an updater `NAME.with_FIELD : TYPE → NAME → NAME`
;;; (the value first) per field, in the record's namespace — opened for the file as any
;;; type's is, so `(FIELD r)` cites it bare where no other opened record has
;;; the field, `(NAME.FIELD r)` always; `(make NAME (FIELD V)…)` — every field exactly once,
;;; order-free — and `(with NAME E (FIELD V)…)` — chained updaters, a later entry outermost —
;;; both against the records of the current file, are rewritten in every form of the file,
;;; nested values first. Namespaced, not bare `FIELD_of`/`with_FIELD` names: records of
;;; the loader share field names, and bare accessor names would collide with functions
;;; of the closure. The bootstrap expands the same way (rust_bootstrap/src/plain/record.rs)
;;; and reader parity ties the two. No law family is generated: the
;;; accessors and updaters are definitions, and the laws relating them are `Eq.refl` over a
;;; local (pin record_laws).
;;;
;;; `make` and `with` also reach a `(structure NAME () (FIELD TYPE)…)` of the file — the L
;;; form whose later fields' types may mention earlier ones: `make` is `NAME.mk` on the
;;; values in field order, `with` is `NAME.mk` on each field's entry or its projection of E.
;;; A field kept whose type mentions an updated one is the refusal `dependent_update`,
;;; naming the field to supply — never an inserted cast. A structure with
;;; parameters is out of the sugar's reach (its constructor takes them): `record_make` /
;;; `record_with` with that pointer. The bootstrap reads no `structure` (an L form).

(import "sexpr.shard")
(import "util.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.sexpr)
(use kernel.sexpr.SExpr)
(use kernel.sym)
(use kernel.util)

;; a record: its name, its type parameters, its constructor, its fields in order, its kind —
;; a `record`, or a `structure` of the file (with parameters or without)
(type RecKind (KRecord) (KStruct Bool))
(type RecDef (RecDef Symbol (List Symbol) Symbol (List (Prod Symbol SExpr)) RecKind))
(fn rec_name ((r RecDef)) Symbol
  (match r
    ((RecDef n _ _ _ _) n)))
(fn rec_params ((r RecDef)) (List Symbol)
  (match r
    ((RecDef _ ps _ _ _) ps)))
(fn rec_ctor ((r RecDef)) Symbol
  (match r
    ((RecDef _ _ c _ _) c)))
(fn rec_fields ((r RecDef)) (List (Prod Symbol SExpr))
  (match r
    ((RecDef _ _ _ fs _) fs)))
(fn rec_kind ((r RecDef)) RecKind
  (match r
    ((RecDef _ _ _ _ k) k)))

(type RxRes (RxOk (List SExpr)) (RxErr Symbol (List Int)))
(type RdRes (RdOk (List RecDef)) (RdErr Symbol (List Int)))
(type RwRes (RwOk SExpr) (RwErr Symbol (List Int)))
(type RlRes (RlOk (List SExpr)) (RlErr Symbol (List Int)))

;; the file's forms with every record expanded and every make / with rewritten
(fn expand_records ((forms (List SExpr))) RxRes
  (match (collect_records forms nil)
    ((RdErr e m) (RxErr e m))
    ((RdOk recs)
     (match (expand_go recs forms nil)
       ((RlErr e m) (RxErr e m))
       ((RlOk fs) (RxOk fs))))))

(fn is_head ((s SExpr) (h Symbol)) Bool
  (match s
    ((SList (cons (SSym x) _)) (sym_eq x h))
    (_ false)))

;; ---- the record table -----------------------------------------------------------------
(fn collect_records ((forms (List SExpr)) (acc (List RecDef))) RdRes
  (measure (struct forms))
  (match forms
    (nil (RdOk (rev acc)))
    ((cons s r)
     (if (is_head s (sym "record"))
       (match (parse_record s)
         ((RdErr e m) (RdErr e m))
         ((RdOk rs) (collect_records r (append rs acc))))
     (if (is_head s (sym "structure"))
       (match (parse_structure s)
         ((some rc) (collect_records r (cons rc acc)))
         (none (collect_records r acc)))
       (collect_records r acc))))))
;; a structure of the file, for make and with: its constructor NAME.mk, its fields with their
;; types' source. A shape this does not read is the reader's refusal, not this table's
(fn parse_structure ((s SExpr)) (Option RecDef)
  (match s
    ((SList (cons _ (cons hd (cons (SList bs) fields))))
     (match (structure_name hd)
       (none none)
       ((some n)
        (match (rec_entries fields nil)
          (none none)
          ((some fs)
           (some
             (RecDef n nil (sym_of_chars (append (chars_of_sym n) (utf8 ".mk"))) fs
               (KStruct
                 (match bs
                   (nil false)
                   (_ true))))))))))
    (_ none)))
(fn structure_name ((hd SExpr)) (Option Symbol)
  (match hd
    ((SSym n) (some n))
    ((SSymU n _) (some n))
    (_ none)))
(fn parse_record ((s SExpr)) RdRes
  (match s
    ((SList (cons _ (cons hd entries)))
     (match (record_head hd)
       (none
         (RdErr (sym "record_form")
           (utf8 "(record NAME (ctor CTOR)? (FIELD TYPE)…) — NAME a symbol or (NAME P…)")))
       ((some (Prod.mk n ps))
        (match entries
          ((cons (SList (cons (SSym c) (cons (SSym ctor) nil))) rest)
           (if (sym_eq c (sym "ctor")) (record_fields n ps ctor rest)
           (record_fields n ps (mk_ctor n) entries)))
          (_ (record_fields n ps (mk_ctor n) entries))))))
    (_ (RdErr (sym "record_form") (utf8 "(record NAME (ctor CTOR)? (FIELD TYPE)…)")))))
(fn record_head ((hd SExpr)) (Option (Prod Symbol (List Symbol)))
  (match hd
    ((SSym n) (some (Prod.mk n nil)))
    ((SList (cons (SSym n) ps))
     (match (param_syms ps nil)
       ((some xs) (some (Prod.mk n xs)))
       (none none)))
    (_ none)))
(fn param_syms ((ps (List SExpr)) (acc (List Symbol))) (Option (List Symbol))
  (measure (struct ps))
  (match ps
    (nil (some (rev acc)))
    ((cons (SSym p) r) (param_syms r (cons p acc)))
    (_ none)))
(fn mk_ctor ((n Symbol)) Symbol (sym_of_chars (append (utf8 "Mk") (chars_of_sym n))))
(fn record_fields ((n Symbol) (ps (List Symbol)) (ctor Symbol) (entries (List SExpr))) RdRes
  (match (rec_entries entries nil)
    (none
      (RdErr (sym "record_form")
        (append (chars_of_sym n)
          (utf8 ": a field is (FIELD TYPE), FIELD a symbol other than ctor, at least one"))))
    ((some fs)
     (if (dup_field fs)
       (RdErr (sym "record_form") (append (chars_of_sym n) (utf8 ": a field twice")))
       (RdOk (list (RecDef n ps ctor fs KRecord)))))))
(fn rec_entries ((entries (List SExpr)) (acc (List (Prod Symbol SExpr))))
  (Option (List (Prod Symbol SExpr)))
  (measure (struct entries))
  (match entries
    (nil
      (match acc
        (nil none)
        (_ (some (rev acc)))))
    ((cons (SList (cons (SSym f) (cons t nil))) r)
     (if (sym_eq f (sym "ctor")) none (rec_entries r (cons (Prod.mk f t) acc))))
    (_ none)))
(fn dup_field ((fs (List (Prod Symbol SExpr)))) Bool
  (measure (struct fs))
  (match fs
    (nil false)
    ((cons (Prod.mk f _) r) (if (field_in r f) true (dup_field r)))))
(fn field_in ((fs (List (Prod Symbol SExpr))) (f Symbol)) Bool
  (measure (struct fs))
  (match fs
    (nil false)
    ((cons (Prod.mk g _) r) (if (sym_eq f g) true (field_in r f)))))
(fn find_record ((recs (List RecDef)) (n Symbol)) (Option RecDef)
  (measure (struct recs))
  (match recs
    (nil none)
    ((cons r rest) (if (sym_eq (rec_name r) n) (some r) (find_record rest n)))))

;; ---- the expansion ----------------------------------------------------------------------
(fn expand_go ((recs (List RecDef)) (forms (List SExpr)) (acc (List SExpr))) RlRes
  (measure (struct forms))
  (match forms
    (nil (RlOk (rev acc)))
    ((cons s r)
     (if (is_head s (sym "record"))
       (match (parse_record s)
         ((RdErr e m) (RlErr e m))
         ((RdOk (cons rc _)) (expand_go recs r (append (rev (generate rc)) acc)))
         ((RdOk nil) (expand_go recs r acc)))
       (match (rewrite recs s)
         ((RwErr e m) (RlErr e m))
         ((RwOk s1) (expand_go recs r (cons s1 acc))))))))
;; the type, then an accessor and an updater per field
(fn generate ((rc RecDef)) (List SExpr) (cons (gen_type rc) (gen_fields rc (rec_fields rc) nil)))
(fn head_form ((rc RecDef)) SExpr
  (match (rec_params rc)
    (nil (SSym (rec_name rc)))
    (ps (SList (cons (SSym (rec_name rc)) (sym_forms ps))))))
(fn sym_forms ((ps (List Symbol))) (List SExpr)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r) (cons (SSym p) (sym_forms r)))))
(fn gen_type ((rc RecDef)) SExpr
  (SList
    (list (SSym (sym "type")) (head_form rc)
      (SList (cons (SSym (rec_ctor rc)) (field_types (rec_fields rc)))))))
(fn field_types ((fs (List (Prod Symbol SExpr)))) (List SExpr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Prod.mk _ t) r) (cons t (field_types r)))))
;; the type-parameter binders ((P Type) …) a generated fn starts with
(fn tparam_binders ((ps (List Symbol))) (List SExpr)
  (measure (struct ps))
  (match ps
    (nil nil)
    ((cons p r) (cons (SList (list (SSym p) (SSym (sym "Type")))) (tparam_binders r)))))
(fn gen_fields ((rc RecDef) (fs (List (Prod Symbol SExpr))) (acc (List SExpr))) (List SExpr)
  (measure (struct fs))
  (match fs
    (nil (rev acc))
    ((cons (Prod.mk f t) r)
     (gen_fields rc r (cons (gen_updater rc f t) (cons (gen_accessor rc f t) acc))))))
(fn r_sym () SExpr (SSym (sym "r")))
;; the pattern binds the fields it uses as fld_FIELD (a field name itself would shadow the
;; accessor the record's namespace opens — pattern_name) and wildcards the rest
(fn fld ((f Symbol)) SExpr (SSym (sym_of_chars (append (utf8 "fld_") (chars_of_sym f)))))
(fn pattern_one ((rc RecDef) (f Symbol)) SExpr
  (SList (cons (SSym (rec_ctor rc)) (pat_vars (rec_fields rc) f false))))
(fn pattern_all ((rc RecDef) (f Symbol)) SExpr
  (SList (cons (SSym (rec_ctor rc)) (pat_vars (rec_fields rc) f true))))
(fn pat_vars ((fs (List (Prod Symbol SExpr))) (f Symbol) (all Bool)) (List SExpr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Prod.mk g _) r)
     (cons (if (bool_or all (sym_eq g f)) (fld g) (SSym (sym "_"))) (pat_vars r f all)))))
;; (fn NAME.FIELD ((P Type)… (r NAME)) TYPE (match r ((CTOR f…) FIELD)))
(fn dotted ((rc RecDef) (s (List Int))) SExpr
  (SSym (sym_of_chars (append (chars_of_sym (rec_name rc)) (append (utf8 ".") s)))))
(fn gen_accessor ((rc RecDef) (f Symbol) (t SExpr)) SExpr
  (SList
    (list (SSym (sym "fn")) (dotted rc (chars_of_sym f))
      (SList (append (tparam_binders (rec_params rc)) (list (SList (list (r_sym) (head_form rc))))))
      t
      (SList (list (SSym (sym "match")) (r_sym) (SList (list (pattern_one rc f) (fld f))))))))
;; (fn NAME.with_FIELD ((P Type)… (new_FIELD TYPE) (r NAME)) NAME (match r ((CTOR f…) (CTOR … new_FIELD …))))
(fn gen_updater ((rc RecDef) (f Symbol) (t SExpr)) SExpr
  (let ((nv (SSym (sym_of_chars (append (utf8 "new_") (chars_of_sym f))))))
    (SList
      (list (SSym (sym "fn")) (dotted rc (append (utf8 "with_") (chars_of_sym f)))
        (SList
          (append (tparam_binders (rec_params rc))
            (list (SList (list nv t)) (SList (list (r_sym) (head_form rc))))))
        (head_form rc)
        (SList
          (list (SSym (sym "match")) (r_sym)
            (SList
              (list (pattern_all rc f)
                (SList (cons (SSym (rec_ctor rc)) (replaced (rec_fields rc) f nv)))))))))))
(fn replaced ((fs (List (Prod Symbol SExpr))) (f Symbol) (nv SExpr)) (List SExpr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Prod.mk g _) r) (cons (if (sym_eq g f) nv (fld g)) (replaced r f nv)))))

;; ---- make and with, rewritten in every subterm, nested values first ---------------------
(fn rewrite ((recs (List RecDef)) (s SExpr)) RwRes
  (measure (struct s))
  (match s
    ((SList items)
     (match (rewrite_all recs items nil)
       ((RlErr e m) (RwErr e m))
       ((RlOk items1)
        (if (is_head s (sym "make")) (rewrite_make recs items1)
        (if (is_head s (sym "with")) (rewrite_with recs items1)
        (RwOk (SList items1)))))))
    (_ (RwOk s))))
(fn rewrite_all ((recs (List RecDef)) (items (List SExpr)) (acc (List SExpr))) RlRes
  (measure (struct items))
  (match items
    (nil (RlOk (rev acc)))
    ((cons s r)
     (match (rewrite recs s)
       ((RwErr e m) (RlErr e m))
       ((RwOk s1) (rewrite_all recs r (cons s1 acc)))))))
;; (make NAME (FIELD V)…) → (CTOR V…) in field order; every field exactly once
(fn rewrite_make ((recs (List RecDef)) (items (List SExpr))) RwRes
  (match items
    ((cons _ (cons (SSym n) entries))
     (match (find_record recs n)
       (none
         (RwErr (sym "record_make") (append (chars_of_sym n) (utf8 ": no such record in this file"))))
       ((some (RecDef _ _ _ _ (KStruct true)))
        (RwErr (sym "record_make")
          (append (chars_of_sym n)
            (utf8 ": a structure with parameters — apply its constructor to them and the fields"))))
       ((some rc)
        (match (entry_pairs entries nil)
          (none
            (RwErr (sym "record_make") (append (chars_of_sym n) (utf8 ": an entry is (FIELD V)"))))
          ((some es)
           (if (bool_not (= (len es) (len (rec_fields rc))))
             (RwErr (sym "record_make")
               (append (chars_of_sym n) (utf8 ": every field exactly once")))
             (match (ordered (rec_fields rc) es nil)
               (none
                 (RwErr (sym "record_make")
                   (append (chars_of_sym n) (utf8 ": every field exactly once"))))
               ((some vs) (RwOk (SList (cons (SSym (rec_ctor rc)) vs)))))))))))
    (_ (RwErr (sym "record_make") (utf8 "(make NAME (FIELD V)…)")))))
(fn entry_pairs ((es (List SExpr)) (acc (List (Prod Symbol SExpr))))
  (Option (List (Prod Symbol SExpr)))
  (measure (struct es))
  (match es
    (nil (some (rev acc)))
    ((cons (SList (cons (SSym f) (cons v nil))) r) (entry_pairs r (cons (Prod.mk f v) acc)))
    (_ none)))
(fn ordered ((fs (List (Prod Symbol SExpr))) (es (List (Prod Symbol SExpr))) (acc (List SExpr)))
  (Option (List SExpr))
  (measure (struct fs))
  (match fs
    (nil (some (rev acc)))
    ((cons (Prod.mk f _) r)
     (match (lookup_once es f)
       (none none)
       ((some v) (ordered r es (cons v acc)))))))
(fn lookup_once ((es (List (Prod Symbol SExpr))) (f Symbol)) (Option SExpr)
  (match (lookups es f nil)
    ((cons v nil) (some v))
    (_ none)))
(fn lookups ((es (List (Prod Symbol SExpr))) (f Symbol) (acc (List SExpr))) (List SExpr)
  (measure (struct es))
  (match es
    (nil acc)
    ((cons (Prod.mk g v) r) (lookups r f (if (sym_eq f g) (cons v acc) acc)))))
;; (with NAME E (FIELD V)…) → (NAME.with_FIELDn Vn (… (NAME.with_FIELD0 V0 E))), a later entry outermost
(fn rewrite_with ((recs (List RecDef)) (items (List SExpr))) RwRes
  (match items
    ((cons _ (cons (SSym n) (cons e entries)))
     (match (find_record recs n)
       (none
         (RwErr (sym "record_with") (append (chars_of_sym n) (utf8 ": no such record in this file"))))
       ((some (RecDef _ _ _ _ (KStruct true)))
        (RwErr (sym "record_with")
          (append (chars_of_sym n)
            (utf8 ": a structure with parameters — apply its constructor to them and the fields"))))
       ((some rc)
        (match (entry_pairs entries nil)
          (none (RwErr (sym "record_with") (utf8 "(with NAME E (FIELD V)…)")))
          ((some es)
           (if (bool_not (all_fields rc es))
             (RwErr (sym "record_with") (append (chars_of_sym n) (utf8 ": no such field")))
             (match (rec_kind rc)
               (KRecord (RwOk (chain rc es e)))
               ((KStruct _) (struct_with rc e es)))))))))
    (_ (RwErr (sym "record_with") (utf8 "(with NAME E (FIELD V)…)")))))
;; (with NAME E (FIELD V)…) over a structure → (NAME.mk A…): a field's entry, else its
;; projection of E — E bound once when it is not a name. A field kept whose type mentions an
;; updated one would need a cast, which the sugar never inserts: dependent_update
(fn struct_with ((rc RecDef) (e SExpr) (es (List (Prod Symbol SExpr)))) RwRes
  (if (dup_field es)
    (RwErr (sym "record_with") (append (chars_of_sym (rec_name rc)) (utf8 ": a field twice")))
    (match (stale_field (rec_fields rc) es)
      ((some (Prod.mk g f))
       (RwErr (sym "dependent_update")
         (append (chars_of_sym (rec_name rc))
           (append (utf8 ": the type of ")
             (append (chars_of_sym g)
               (append (utf8 " mentions the updated ")
                 (append (chars_of_sym f)
                   (append (utf8 " — supply ")
                     (append (chars_of_sym g) (utf8 " too: no cast is inserted"))))))))))
      (none
        (match e
          ((SSym _)
           (RwOk (SList (cons (SSym (rec_ctor rc)) (struct_args rc (rec_fields rc) es e)))))
          (_
            (RwOk
              (SList
                (list (SSym (sym "let")) (SList (list (SList (list (with_subject) e))))
                  (SList
                    (cons (SSym (rec_ctor rc)) (struct_args rc (rec_fields rc) es (with_subject)))))))))))))
;; the updated value's name where E is bound: no source symbol holds a space
(fn with_subject () SExpr (SSym (sym_of_chars (utf8 "with subject"))))
(fn struct_args
  ((rc RecDef) (fs (List (Prod Symbol SExpr))) (es (List (Prod Symbol SExpr))) (e SExpr))
  (List SExpr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Prod.mk f _) r)
     (cons
       (match (lookup_once es f)
         ((some v) v)
         (none (SList (list (dotted rc (chars_of_sym f)) e))))
       (struct_args rc r es e)))))
;; the first field kept whose type's source names an updated field, with that field
(fn stale_field ((fs (List (Prod Symbol SExpr))) (es (List (Prod Symbol SExpr))))
  (Option (Prod Symbol Symbol))
  (measure (struct fs))
  (match fs
    (nil none)
    ((cons (Prod.mk g t) r)
     (if (field_in es g) (stale_field r es)
     (match (field_mentioned es t)
       ((some f) (some (Prod.mk g f)))
       (none (stale_field r es)))))))
(fn field_mentioned ((es (List (Prod Symbol SExpr))) (t SExpr)) (Option Symbol)
  (measure (struct es))
  (match es
    (nil none)
    ((cons (Prod.mk f _) r) (if (sexpr_mentions t f) (some f) (field_mentioned r t)))))
(fn sexpr_mentions ((t SExpr) (f Symbol)) Bool
  (measure (struct t))
  (match t
    ((SSym x) (sym_eq x f))
    ((SSymU x _) (sym_eq x f))
    ((SList xs) (any_mentions xs f))
    (_ false)))
(fn any_mentions ((xs (List SExpr)) (f Symbol)) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (sexpr_mentions x f) true (any_mentions r f)))))
(fn all_fields ((rc RecDef) (es (List (Prod Symbol SExpr)))) Bool
  (measure (struct es))
  (match es
    (nil true)
    ((cons (Prod.mk f _) r) (if (field_in (rec_fields rc) f) (all_fields rc r) false))))
(fn chain ((rc RecDef) (es (List (Prod Symbol SExpr))) (acc SExpr)) SExpr
  (measure (struct es))
  (match es
    (nil acc)
    ((cons (Prod.mk f v) r)
     (chain rc r (SList (list (dotted rc (append (utf8 "with_") (chars_of_sym f))) v acc))))))
