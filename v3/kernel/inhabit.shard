;;; v3/kernel/inhabit.shard — a default witness of a K type.
;;; An extern is, in L, an opaque constant of its declared
;;; type: K's opaque kind checks a value and never unfolds it, so the value is a typing
;;; witness alone — Lean's `opaque` takes `default` of an `Inhabited` instance; here the
;;; witness is built structurally. A function type is a lambda over its binder whose body is
;;; the codomain's witness; an inductive type is its first constructor whose fields all
;;; close, applied to the type's parameters and to the fields' witnesses in order (a later
;;; field's type instantiated with the earlier witnesses); anything else — a sort, a
;;; proposition, a variable's type, a constructor none of whose rows close — has no witness,
;;; and the extern keeps no L constant (`extern_uninhabited`, reader.shard). Fuel bounds the
;;; descent through a recursive row, so the first closing constructor wins: `List.nil`,
;;; `Nat.zero`, `Option.none`, `Prod.mk` of two witnesses, `World.World Nat.zero`.

(import "kw.shard")
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.kw)
(use kernel.expr)
(use kernel.level)
(use kernel.name)
(use kernel.util)
(use kernel.decl)
(use kernel.decl.ConstantInfo)
(use kernel.expr.Expr)

;; a witness of the type under the walk's environment, or None
(fn inhabit ((w W) (ty Expr) (fuel Int)) (Prod W (Option Expr))
  (measure fuel)
  (if (< fuel 1) (Prod.mk w none)
  (match (w_whnf w ty)
    ((Prod.mk w1 none) (Prod.mk w1 none))
    ((Prod.mk w1 (some t))
     (match t
       ((Pi _ n bi dom body)
        (match (w_local_bi w1 n dom bi)
          ((Prod.mk w2 fv)
           (match (w_inst1 w2 body fv)
             ((Prod.mk w3 body1)
              (match (inhabit w3 body1 (- fuel 1))
                ((Prod.mk w4 none) (Prod.mk w4 none))
                ((Prod.mk w4 (some v))
                 (match (w_lams w4 (list fv) v)
                   ((Prod.mk w5 lam) (Prod.mk w5 (some lam)))))))))))
       (_
         (match (get_app_fn t)
           ((Const _ c ls)
            (match (env_find (w_env w1) c)
              ((some (InductInfo _ nparams _ _ ctors _ _ _ _))
               (inhabit_ctors w1 ls (take nparams (get_app_args t)) ctors (- fuel 1)))
              (_ (Prod.mk w1 none))))
           (_ (Prod.mk w1 none)))))))))
;; the constructors in order: the first that closes
(fn inhabit_ctors ((w W) (ls (List Level)) (params (List Expr)) (cs (List Name)) (fuel Int))
  (Prod W (Option Expr))
  (measure (struct cs))
  (match cs
    (nil (Prod.mk w none))
    ((cons c r)
     (match (inhabit_ctor w c ls params fuel)
       ((Prod.mk w1 (some v)) (Prod.mk w1 (some v)))
       ((Prod.mk w1 none) (inhabit_ctors w1 ls params r fuel))))))
;; one constructor: its type at the levels, the parameters instantiated, every field witnessed
(fn inhabit_ctor ((w W) (c Name) (ls (List Level)) (params (List Expr)) (fuel Int))
  (Prod W (Option Expr))
  (match (env_find (w_env w) c)
    (none (Prod.mk w none))
    ((some info)
     (match (w_inst_lparams w (ci_type info) (ci_lparams info) ls)
       ((Prod.mk w1 cty)
        (match (inhabit_params w1 cty params)
          ((Prod.mk w2 none) (Prod.mk w2 none))
          ((Prod.mk w2 (some fty))
           (match (inhabit_fields w2 fty fuel nil)
             ((Prod.mk w3 none) (Prod.mk w3 none))
             ((Prod.mk w3 (some fields))
              (match (w_apps w3 (mk_const c ls) (append params fields))
                ((Prod.mk w4 v) (Prod.mk w4 (some v)))))))))))))
;; the leading binders instantiated with the type's parameters
(fn inhabit_params ((w W) (ty Expr) (ps (List Expr))) (Prod W (Option Expr))
  (measure (struct ps))
  (match ps
    (nil (Prod.mk w (some ty)))
    ((cons p r)
     (match (w_whnf w ty)
       ((Prod.mk w1 (some (Pi _ _ _ _ body)))
        (match (w_inst1 w1 body p)
          ((Prod.mk w2 b1) (inhabit_params w2 b1 r))))
       ((Prod.mk w1 _) (Prod.mk w1 none))))))
;; the fields in order, each witnessed and substituted into the rest; the result type ends them
(fn inhabit_fields ((w W) (ty Expr) (fuel Int) (acc (List Expr))) (Prod W (Option (List Expr)))
  (measure fuel)
  (if (< fuel 1) (Prod.mk w none)
  (match (w_whnf w ty)
    ((Prod.mk w1 none) (Prod.mk w1 none))
    ((Prod.mk w1 (some (Pi _ _ _ dom body)))
     (match (inhabit w1 dom (- fuel 1))
       ((Prod.mk w2 none) (Prod.mk w2 none))
       ((Prod.mk w2 (some v))
        (match (w_inst1 w2 body v)
          ((Prod.mk w3 b1) (inhabit_fields w3 b1 (- fuel 1) (cons v acc)))))))
    ((Prod.mk w1 (some _)) (Prod.mk w1 (some (rev acc)))))))
