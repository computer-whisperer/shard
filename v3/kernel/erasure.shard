;;; v3/kernel/erasure.shard — the E projection. An L term erased to an E term by the roles of
;;; erase.shard: types, proofs and erased binders dropped; a constructor and a call at their
;;; runtime arguments; `casesOn` and a recursor without its hypotheses as a match, a
;;; two-constructor case analysis that ignores its fields as the `if` it was written as;
;;; `ite`/`dite` as an if on the decision; a matcher application as the match of the rows read
;;; back off its type (matcher.shard); `Decidable.decide` as the explicit conversion; a
;;; resolved operation as its entry of the realization registry; a row of the registry's
;;; types (erase.shard's rep_row) as its one runtime field — the constructor its argument,
;;; the projection its subject —, a projection function as its projection, a string literal
;;; as its bytes. Two callers: a constant's
;;; derived view (realize.shard) and a pre-definition (predef.shard), whose erasure **is** the
;;; function's program — the self-local and a callee-local a call. A template's call (of a fn
;;; with a function-typed binder) is a call of its instance at the static
;;; arguments' shapes — a lambda lifted to a generated fn on the way —, the instance demanded
;;; of the loader, which builds it (template.shard). The walk's state `Tr` and
;;; its K procedures are here, under the three files that build terms over it (this one,
;;; realize.shard, define.shard). Untrusted for what K accepts. For what a binary does, the
;;; erasure rule's implementation is a stated trust dependency: reviewed and tested, not proven.
(import Init)
(import "predef.shard")
(import "erase.shard")
(import "prog.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.decl)
(use kernel.erase)
(use kernel.kw)
(use kernel.elab El el_w el0 el_set_w el_set_cx el_cx el_aux elab el_finish)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.matcher)
(use kernel.name)
(use kernel.predef)
(use kernel.prog)
(use kernel.scope)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.kw.W)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.level.Level)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtPat)
(use kernel.predef.CalleeLocal)
(use kernel.predef.PdRec)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.scope.Scope)

;; ---- templates and instances --------------------------------------
;; the shape of a static argument: the identity it names as the L term it is (a fn with a
;; program, a realized constant, an instance, a lifted lambda; a constant of the realization
;; registry), the primitive the registry realizes it to (None for a program), its arity, its
;; leading arguments — Some a type or erased argument kept in the L term (closed), None a
;; captured runtime value — and the captured values' L types (closed). The captured count is
;; their number; the values themselves are never part of a shape: they are passed at run time
(type Shape (Shape Expr (Option Name) Int (List (Option Expr)) (List Expr)))
(fn shape_head ((s Shape)) Expr
  (match s
    ((Shape h _ _ _ _) h)))
(fn shape_id ((s Shape)) Name
  (match (shape_head s)
    ((Const _ n _) n)
    (_ Anon)))
(fn shape_prim ((s Shape)) (Option Name)
  (match s
    ((Shape _ p _ _ _) p)))
(fn shape_arity ((s Shape)) Int
  (match s
    ((Shape _ _ k _ _) k)))
(fn shape_leading ((s Shape)) (List (Option Expr))
  (match s
    ((Shape _ _ _ ls _) ls)))
(fn shape_captured ((s Shape)) (List Expr)
  (match s
    ((Shape _ _ _ _ cs) cs)))
;; an instance a body demands: its name, the template, the template's type arguments as the
;; closed L types they are and as E types, the shapes of its static arguments in order
(type Demand (Demand Name Name (List Expr) (List EType) (List Shape)))
(fn demand_name ((d Demand)) Name
  (match d
    ((Demand n _ _ _ _) n)))
(fn demand_template ((d Demand)) Name
  (match d
    ((Demand _ c _ _ _) c)))
(fn demand_shapes ((d Demand)) (List Shape)
  (match d
    ((Demand _ _ _ _ ss) ss)))
;; a lambda lifted to a generated fn under the caller's name: its program and its L definition
(type Lifted (Lifted Name EDecl Declaration))

;; ---- the walk's state -------------------------------------------------------------------
;; the walk (environment, locals, checker state), the E table, the scope, the realized or
;; defined constant's identity and its type parameters' locals (an ETVar of the body is one of
;; them); for a definition (define.shard) the value once built and the descent obligations
;; collected on the way, newest first
;; the lambdas lifted so far (a counter for their names), the generated fns
;; and the instances the body demands, in order; `owner` when the body is a template's — at
;; an instance, or at the check of its declaration: the template and the instance's name (a
;; self-call at other shapes is refused), with the template's binders (its self-call's roles,
;; before its constant is in the walk's environment)
(record Tr (w W) (es ESt) (sc Scope) (id Name) (tps (List Expr)) (value (Option Expr))
  (obls (List Declaration))
  (lams Int)
  (lifted (List Lifted))
  (demands (List Demand))
  (owner (Option (Prod Name Name)))
  (obinds (List TBind)))
(fn tr_new ((w W) (es ESt) (sc Scope) (id Name) (tps (List Expr))) Tr
  (make Tr (w w) (es es) (sc sc) (id id) (tps tps) (value none) (obls nil) (lams 0) (lifted nil)
    (demands nil)
    (owner none)
    (obinds nil)))
(fn tr_own ((t Tr) (c Name) (inst Name) (binds (List TBind))) Tr
  (with Tr t (owner (some (Prod.mk c inst))) (obinds binds)))
;; the template's own binders where the call is the owner's self-call
(fn owner_binds ((t Tr) (c Name)) (Option (List TBind))
  (match (Tr.owner t)
    ((some (Prod.mk oc _)) (if (name_eq oc c) (some (Tr.obinds t)) none))
    (none none)))
(fn owner_is ((t Tr) (c Name)) Bool
  (match (Tr.owner t)
    ((some (Prod.mk oc _)) (name_eq oc c))
    (none false)))
(fn in_template ((t Tr)) Bool
  (match (Tr.owner t)
    ((some _) true)
    (none false)))
;; the owner's self-call at one of its own type parameters (a template calls itself at its
;; own types; at a type built from them — f at (List a) — the shape set would grow)
(fn own_tparam ((t Tr) (a Expr)) Bool
  (match a
    ((FVar _ id)
     (match (fvar_index id (Tr.tps t) 0)
       ((some _) true)
       (none false)))
    (_ false)))
(fn tr_lift ((t Tr) (x Lifted)) Tr (with Tr t (lifted (append (Tr.lifted t) (list x)))))
(fn tr_demand ((t Tr) (d Demand)) Tr
  (if (has_demand (Tr.demands t) (demand_name d)) t
  (with Tr t (demands (append (Tr.demands t) (list d))))))
(fn has_demand ((ds (List Demand)) (n Name)) Bool
  (measure (struct ds))
  (match ds
    (nil false)
    ((cons d r) (if (name_eq (demand_name d) n) true (has_demand r n)))))
(fn tr_set_w ((t Tr) (w W)) Tr (with Tr t (w w)))
;; the owner the walk names under from here on (a group's members in turn: define.shard)
(fn tr_set_id ((t Tr) (k Name)) Tr (with Tr t (id k)))
(fn tr_set_es ((t Tr) (es ESt)) Tr (with Tr t (es es)))
(fn tr_set_value ((t Tr) (v Expr)) Tr (with Tr t (value (some v))))
(fn tr_add_obl ((t Tr) (d Declaration)) Tr (with Tr t (obls (cons d (Tr.obls t)))))
(fn tr_obls ((t Tr)) (List Declaration) (rev (Tr.obls t)))
(fn tr_env ((t Tr)) CheckedEnv (w_env (Tr.w t)))
(type TrRes (TrOk Tr Expr) (TrErr Symbol (List Int)))

;; ---- K's procedures over the state ----------------------------------------------------------
;; K through the state
(fn tr_infer ((t Tr) (e Expr)) (Prod Tr (Option Expr))
  (match (w_infer (Tr.w t) e)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_whnf ((t Tr) (e Expr)) (Prod Tr (Option Expr))
  (match (w_whnf (Tr.w t) e)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_local ((t Tr) (n Name) (ty Expr)) (Prod Tr Expr)
  (match (w_local (Tr.w t) n ty)
    ((Prod.mk w1 fv) (Prod.mk (tr_set_w t w1) fv))))
(fn tr_local_bi ((t Tr) (n Name) (ty Expr) (bi BinderInfo)) (Prod Tr Expr)
  (match (w_local_bi (Tr.w t) n ty bi)
    ((Prod.mk w1 fv) (Prod.mk (tr_set_w t w1) fv))))
(fn tr_local_val ((t Tr) (n Name) (ty Expr) (v Expr)) (Prod Tr Expr)
  (match (w_local_val (Tr.w t) n ty v)
    ((Prod.mk w1 fv) (Prod.mk (tr_set_w t w1) fv))))
(fn tr_inst1 ((t Tr) (e Expr) (v Expr)) (Prod Tr Expr)
  (match (w_inst1 (Tr.w t) e v)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_apps ((t Tr) (f Expr) (args (List Expr))) (Prod Tr Expr)
  (match (w_apps (Tr.w t) f args)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_lams ((t Tr) (fvs (List Expr)) (b Expr)) (Prod Tr Expr)
  (match (w_lams (Tr.w t) fvs b)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_pis ((t Tr) (fvs (List Expr)) (b Expr)) (Prod Tr Expr)
  (match (w_pis (Tr.w t) fvs b)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_subst ((t Tr) (e Expr) (id Int) (v Expr)) (Prod Tr Expr)
  (match (w_subst (Tr.w t) e id v)
    ((Prod.mk w1 r) (Prod.mk (tr_set_w t w1) r))))
(fn tr_type_of_local ((t Tr) (fv Expr)) (Option Expr)
  (match fv
    ((FVar _ id)
     (match (lctx_find (w_lctx (Tr.w t)) id)
       ((some d) (some (ldecl_type d)))
       (none none)))
    (_ none)))
;; the telescope of a constant, its binders opened in the state
(fn tr_tele ((t Tr) (info ConstantInfo)) (Prod Tr (Option Tele))
  (match (tele_of (Tr.w t) (Tr.es t) (Tr.sc t) info)
    ((TeleErr _ _) (Prod.mk t none))
    ((TeleOk w1 es1 tele) (Prod.mk (with Tr t (w w1) (es es1)) (some tele)))))
(fn tr_tele_fields ((t Tr) (info ConstantInfo) (k Int)) (Prod Tr (Option Tele))
  (match (tele_of_fields (Tr.w t) (Tr.es t) (Tr.sc t) info k)
    ((TeleErr _ _) (Prod.mk t none))
    ((TeleOk w1 es1 tele) (Prod.mk (with Tr t (w w1) (es es1)) (some tele)))))
(fn level_one () Level (LSucc LZero))
(fn ind_ctor_names ((t Tr) (ind Name)) (List Name)
  (match (es_info (Tr.es t) ind)
    ((some (EIInd _ cs)) cs)
    (_ nil)))

;; ---- a constructor opened at its fields ------------------------------------------------------
;; a constructor opened at the scrutinee's type: its fields as locals — each with its runtime
;; E type, or None for an erased one — and the constructor term
(type Field (Field Expr (Option EType) Bool))  ; the local, its E type (None = erased), recursive?
(fn field_fvars ((fs (List Field))) (List Expr)
  (measure (struct fs))
  (match fs
    (nil nil)
    ((cons (Field fv _ _) r) (cons fv (field_fvars r)))))
(fn rz_open_ctor ((t Tr) (c Name) (ls (List Level)) (largs (List Expr)))
  (Prod Tr (Option (Prod (List Field) Expr)))
  (match (env_find (tr_env t) c)
    ((some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (w_inst_lparams (Tr.w t) (ci_type info) (ci_lparams info) ls)
          ((Prod.mk w1 cty)
           (match (inst_params w1 cty largs)
             ((Prod.mk w2 none) (Prod.mk (tr_set_w t w2) none))
             ((Prod.mk w2 (some fty))
              (match (open_fields (tr_set_w t w2) ind fty nil (budget_depth))
                ((Prod.mk t1 none) (Prod.mk t1 none))
                ((Prod.mk t1 (some fields))
                 (match (tr_apps t1 (mk_const c ls) (append largs (field_fvars fields)))
                   ((Prod.mk t2 cterm) (Prod.mk t2 (some (Prod.mk fields cterm))))))))))))
       (_ (Prod.mk t none))))  ; not a constructor
    (none (Prod.mk t none))))
(fn open_fields ((t Tr) (ind Name) (ty Expr) (acc (List Field)) (fuel Int))
  (Prod Tr (Option (List Field)))
  (measure fuel)
  (if (< fuel 0) (Prod.mk t none)
  (match (tr_whnf t ty)
    ((Prod.mk t1 (some (Pi _ n _ dom body)))
     (match (w_is_prop (Tr.w t1) dom)
       ((Prod.mk w2 (some true))
        (match (w_local w2 n dom)
          ((Prod.mk w3 fv)
           (match (w_inst1 w3 body fv)
             ((Prod.mk w4 body1)
              (open_fields (tr_set_w t1 w4) ind body1 (cons (Field fv none false) acc) (- fuel 1)))))))
       ((Prod.mk w2 _)
        (match (l_to_etype w2 (Tr.es t1) (Tr.sc t1) dom (Tr.tps t1) nil)
          ((Prod.mk (Prod.mk w3 es3) fety)
           (match (w_local w3 n dom)
             ((Prod.mk w4 fv)
              (match (w_inst1 w4 body fv)
                ((Prod.mk w5 body1)
                 (open_fields (tr_set_es (tr_set_w t1 w5) es3) ind body1
                   (cons (Field fv fety (is_head_const dom ind)) acc)
                   (- fuel 1)))))))))))
    ((Prod.mk t1 (some _)) (Prod.mk t1 (some (rev acc))))
    ((Prod.mk t1 none) (Prod.mk t1 none)))))
(fn is_head_const ((e Expr) (n Name)) Bool
  (match (get_app_fn e)
    ((Const _ c _) (name_eq c n))
    (_ false)))
(fn mentions_any ((e Expr) (ids (List Int))) Bool
  (measure (struct e))
  (if (bool_not (has_fvar e)) false
  (match e
    ((FVar _ id) (mem_int id ids))
    ((App _ f a) (bool_or (mentions_any f ids) (mentions_any a ids)))
    ((Lam _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Pi _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Let _ _ ty v b)
     (bool_or (mentions_any ty ids) (bool_or (mentions_any v ids) (mentions_any b ids))))
    ((Proj _ _ _ x) (mentions_any x ids))
    (_ false))))
(fn count_types ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds
    (nil 0)
    ((cons (TBind _ BType _) r) (+ 1 (count_types r)))
    ((cons _ r) (count_types r))))
(fn tbind_types ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ BType fv) r) (cons fv (tbind_types r)))
    ((cons _ r) (tbind_types r))))
(fn count_data ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds
    (nil 0)
    ((cons (TBind _ (BData _) _) r) (+ 1 (count_data r)))
    ((cons _ r) (count_data r))))
(fn tbind_fvars ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ _ fv) r) (cons fv (tbind_fvars r)))))
;; an alternative at its variables: each lambda's body instantiated, else applied
(fn pj_inst_lams ((t Tr) (e Expr) (vars (List Expr))) (Prod Tr Expr)
  (measure (struct vars))
  (match vars
    (nil (Prod.mk t e))
    ((cons v r)
     (match e
       ((Lam _ _ _ _ b)
        (match (tr_inst1 t b v)
          ((Prod.mk t1 b1) (pj_inst_lams t1 b1 r))))
       (_
         (match (tr_apps t e (list v))
           ((Prod.mk t1 e1) (pj_inst_lams t1 e1 r))))))))

;; ---- the erasure ---------------------------------------------------------------
;; the body's variables in the erasure: a local is a runtime variable (its E index counted among
;; those), a static or erased one, an induction hypothesis,
;; or a function standing for a call — the pre-definition's self-local, its
;; identity and its binders' runtime flags;
;; EKShape: a static parameter at an instance — its shape, and the captured
;; slots' entries (EKVar each, under ids no local has: the instance's leading parameters);
;; EKTemplate: a template's own name — the self-local at an instance, a call of the template
(type EKind
  (EKVar)
  (EKStatic)
  (EKErased)
  (EKIH)
  (EKCall Name (List Bool))
  (EKShape Shape (List Int))
  (EKTemplate Name))
(type ErEnt (ErEnt Int EKind))
(fn er_index ((env (List ErEnt)) (id Int) (k Int)) (Option (Prod EKind Int))
  (measure (struct env))
  (match env
    (nil none)
    ((cons (ErEnt j kind) r)
     (if (= id j) (some (Prod.mk kind k))
     (er_index r id
       (match kind
         (EKVar (+ k 1))
         (_ k)))))))
(type ErRes (ErOk Tr ETerm) (ErErr Symbol (List Int)))
(fn bind_ptypes ((binds (List TBind))) (List EType)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ (BData ety) _) r) (cons ety (bind_ptypes r)))
    ((cons _ r) (bind_ptypes r))))
;; the binders' entries, innermost first
(fn binder_ents ((binds (List TBind))) (List ErEnt) (rev (binder_ents_fwd binds)))
(fn binder_ents_fwd ((binds (List TBind))) (List ErEnt)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ role fv) r)
     (cons
       (ErEnt (fvar_id_of fv)
         (match role
           (BType EKStatic)
           (BErased EKErased)
           ((BData _) EKVar)
           ((BStatic _) EKErased)))
       (binder_ents_fwd r)))))  ; a static binder is bound by template.shard (a fn's or a realize's template), never here: erased, so a use is loud
;; the erasure of an L term in a runtime position
(fn erase ((t Tr) (env (List ErEnt)) (e Expr) (fuel Int)) ErRes
  (measure fuel)
  (if (< fuel 0) (ErErr (quote erased_in_runtime) "the body is too deep")
  (match e
    ((FVar _ id)
     (match (er_index env id 0)
       ((some (Prod.mk EKVar i)) (ErOk t (EBVar i)))
       ((some (Prod.mk EKIH _))
        (ErErr (quote recursion_structure)
          "a recursive definition's executable structure is not readable off the recursor: supply the body"))
       ((some (Prod.mk (EKCall c roles) _))
        (match roles
          (nil (ErOk t (ECall c nil)))
          (_
            (ErErr (quote function_value)
              (append (show_name c) " unapplied: a function is no value")))))
       ((some (Prod.mk (EKShape sh _) _))
        (ErErr (quote function_value)
          (append "a static parameter (at "
            (append (show_name (shape_id sh))
              ") unapplied: it is called at its arity, or passed on as a static argument"))))
       ((some (Prod.mk (EKTemplate c) _))
        (ErErr (quote function_value)
          (append (show_name c) " unapplied: a template is called at its full arity")))
       ((some (Prod.mk _ _))
        (ErErr (quote erased_in_runtime)
          "a type or a proof in a runtime position: both are erased from a program"))
       (none (ErErr (quote erased_in_runtime) "a variable the erasure does not know"))))
    ((Lit _ (LitNat n)) (ErOk t (ELit (LNat n))))
    ((Lit _ (LitStr bs))  ; a String is its bytes: Init's List cells, built once at link
     (if (utf8_ok bs) (ErOk t (ELit (LStr (nm_list_nil) (nm_list_cons) bs)))
     (ErErr (quote bad_string)
       "a string literal's bytes are not UTF-8: K reads the literal by decoding it")))
    ((Let _ n ty v b) (erase_let t env n ty v b fuel))
    ((Lam _ _ _ _ _)
     (ErErr (quote function_value)
       "a lambda in a runtime position: a lambda is a static argument of a template, lifted to a fn — never a value, a field, a let or a result"))
    ((Pi _ _ _ _ _) (ErErr (quote erased_in_runtime) "a type in a runtime position"))
    ((Sort _ _) (ErErr (quote erased_in_runtime) "a sort in a runtime position"))
    ((BVar _ _) (ErErr (quote erased_in_runtime) "a loose variable"))
    ((Proj _ sn i x) (erase_proj t env sn i x fuel))
    (_ (erase_app t env (get_app_fn e) (get_app_args e) fuel)))))
(fn erase_all ((t Tr) (env (List ErEnt)) (es (List Expr)) (fuel Int) (acc (List ETerm)))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr (List ETerm)))
  (measure (struct es))
  (match es
    (nil (Prod.mk none (Prod.mk t (rev acc))))
    ((cons e r)
     (match (erase t env e fuel)
       ((ErErr x m) (Prod.mk (some (Prod.mk x m)) (Prod.mk t nil)))
       ((ErOk t1 e1) (erase_all t1 env r fuel (cons e1 acc)))))))
;; a let: a proposition or a type vanishes (its variable erased), a value is an E let
(fn erase_let ((t Tr) (env (List ErEnt)) (n Name) (ty Expr) (v Expr) (b Expr) (fuel Int)) ErRes
  (match (w_is_prop (Tr.w t) ty)
    ((Prod.mk w1 (some true))
     (match (tr_local_val (tr_set_w t w1) n ty v)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 b fv)
          ((Prod.mk t2 b1) (erase t2 (cons (ErEnt (fvar_id_of fv) EKErased) env) b1 (- fuel 1)))))))
    ((Prod.mk w1 _)
     (match (tr_whnf (tr_set_w t w1) ty)
       ((Prod.mk t1 (some (Sort _ _)))
        (match (tr_local_val t1 n ty v)
          ((Prod.mk t2 fv)
           (match (tr_inst1 t2 b fv)
             ((Prod.mk t3 b1) (erase t3 (cons (ErEnt (fvar_id_of fv) EKStatic) env) b1 (- fuel 1)))))))
       ((Prod.mk t1 _)
        (match (erase t1 env v (- fuel 1))
          ((ErErr e m) (ErErr e m))
          ((ErOk t2 v1)
           (match (tr_local_val t2 n ty v)
             ((Prod.mk t3 fv)
              (match (tr_inst1 t3 b fv)
                ((Prod.mk t4 b1)
                 (match (erase t4 (cons (ErEnt (fvar_id_of fv) EKVar) env) b1 (- fuel 1))
                   ((ErErr e m) (ErErr e m))
                   ((ErOk t5 b2) (ErOk t5 (ELet (list v1) b2)))))))))))))))
;; a projection: a match on the structure's constructor, the field's variable; of a row of the
;; registry's types, the subject itself
(fn erase_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (fuel Int)) ErRes
  (match (tr_package t sn)
    ((Prod.mk t0 (some _)) (erase_package_proj t0 env sn i x nil fuel))
    ((Prod.mk t0 none) (erase_struct_proj t0 env sn i x fuel))))
(fn erase_struct_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (fuel Int)) ErRes
  (match (erase t env x (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 x1)
     (if (rep_row sn)
       (match (row_field t1 sn)
         ((Prod.mk t2 none)
          (ErErr (quote no_realization)
            (append (show_name sn)
              ": the registry's row does not describe this structure (one constructor, one runtime field)")))
         ((Prod.mk t2 (some (Prod.mk _ roles)))
          (match (runtime_index roles i 0 0)
            (none
              (ErErr (quote erased_in_runtime)
                (append (show_name sn) ": a projection of an erased field")))
            ((some _) (ErOk t2 x1)))))
       (match (ind_eligible (Tr.w t1) (Tr.es t1) (Tr.sc t1) sn nil)
         ((Prod.mk (Prod.mk w2 es2) false)
          (ErErr (quote no_realization) (append (show_name sn) " is not an E type")))
         ((Prod.mk (Prod.mk w2 es2) true)
          (let ((t2 (tr_set_es (tr_set_w t1 w2) es2)))
            (match (ind_ctor_names t2 sn)
              ((cons c nil)
               (match (field_roles t2 c)
                 ((Prod.mk t3 none) (ErErr (quote no_realization) (show_name c)))
                 ((Prod.mk t3 (some roles))
                  (match (runtime_index roles i 0 0)
                    (none
                      (ErErr (quote erased_in_runtime)
                        (append (show_name sn) ": a projection of an erased field")))
                    ((some (Prod.mk j nrt))
                     (ErOk t3
                       (EMatch x1 (list (EArm (PCtor c (pvars nrt)) (EBVar (- (- nrt 1) j)))))))))))
              (_ (ErErr (quote no_realization) (append (show_name sn) " is not a structure")))))))))))
;; a row's constructor and its fields' roles, when the structure is what the row says: one
;; constructor, exactly one runtime field
(fn row_field ((t Tr) (ind Name)) (Prod Tr (Option (Prod Name (List Bool))))
  (match (env_find (tr_env t) ind)
    ((some (InductInfo _ _ _ _ (cons c nil) _ _ _ _))
     (match (field_roles t c)
       ((Prod.mk t1 (some roles))
        (if (= (count_true roles) 1) (Prod.mk t1 (some (Prod.mk c roles))) (Prod.mk t1 none)))
       ((Prod.mk t1 none) (Prod.mk t1 none))))
    (_ (Prod.mk t none))))
;; a projection function — a constant whose value is λ params self. self.i —, applied at least
;; to its lambdas: the structure, the field, the subject and the arguments past it (a
;; package's function field takes them)
(fn proj_fn_app ((info ConstantInfo) (args (List Expr)))
  (Option (Prod (Prod Name Int) (Prod Expr (List Expr))))
  (match info
    ((DefnInfo _ v _ _ _)
     (let ((k (lam_depth v 0)))
       (if (< (len args) k) none
       (match (under_lams v k)
         ((some (Proj _ sn i (BVar _ 0)))
          (match (nth args (- k 1))
            ((some x) (some (Prod.mk (Prod.mk sn i) (Prod.mk x (drop k args)))))
            (none none)))
         (_ none)))))
    (_ none)))
(fn lam_depth ((e Expr) (k Int)) Int
  (measure (struct e))
  (match e
    ((Lam _ _ _ _ b) (lam_depth b (+ k 1)))
    (_ k)))
(fn under_lams ((e Expr) (k Int)) (Option Expr)
  (measure k)
  (if (< k 1)
    (match e
      ((Lam _ _ _ _ _) none)
      (_ (some e)))
    (match e
      ((Lam _ _ _ _ b) (under_lams b (- k 1)))
      (_ none))))
;; ---- a package ---------------------------------------------------------
;; a package type by erase.shard's reading, over the walk
(fn tr_package ((t Tr) (sn Name)) (Prod Tr (Option (Prod Name (List BRole))))
  (match (package_of (Tr.w t) (Tr.es t) (Tr.sc t) sn)
    ((Prod.mk (Prod.mk w1 es1) r) (Prod.mk (tr_set_es (tr_set_w t w1) es1) r))))
;; the subject of a package's projection: a package parameter at its shape — the constant's
;; fields (its value read by whnf to the constructor applied), or a placeholder at the template's
;; declaration (the check erases it once with no constant behind it) — or a closed package term
(type PkRes (PkFields Expr (List Expr)) (PkPlaceholder Name) (PkErr Symbol (List Int)))  ; the package term and its fields
(fn package_subject ((t Tr) (env (List ErEnt)) (x Expr)) (Prod Tr PkRes)
  (match x
    ((FVar _ id)
     (match (er_index env id 0)
       ((some (Prod.mk (EKShape sh _) _))
        (if (bool_not (= (shape_arity sh) 0))
          (Prod.mk t (PkErr (quote function_value) "a static parameter projected as a package"))
          (match (env_find (tr_env t) (shape_id sh))
            (none (Prod.mk t (PkPlaceholder (shape_id sh))))
            ((some _)
             (package_fields_of t (mk_app_n (shape_head sh) (fill_somes (shape_leading sh))))))))
       (_
         (Prod.mk t
           (PkErr (quote function_value)
             "a package in a runtime position: a package is a static parameter, its fields read at the instance")))))
    (_
      (if (has_fvar x)
        (Prod.mk t
          (PkErr (quote function_value)
            "a package built from locals of the caller: a package constant is closed"))
        (package_fields_of t x)))))
(fn fill_somes ((ls (List (Option Expr)))) (List Expr)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons (some a) r) (cons a (fill_somes r)))
    ((cons none r) (fill_somes r))))
(fn package_fields_of ((t Tr) (x Expr)) (Prod Tr PkRes)
  (match (tr_whnf t x)
    ((Prod.mk t1 none)
     (Prod.mk t1
       (PkErr (quote no_realization) "a package constant K could not reduce to its constructor")))
    ((Prod.mk t1 (some v))
     (match (get_app_fn v)
       ((Const _ mk _)
        (match (env_find (tr_env t1) mk)
          ((some (CtorInfo _ _ _ nparams _ _))
           (Prod.mk t1 (PkFields x (drop nparams (get_app_args v)))))
          (_
            (Prod.mk t1
              (PkErr (quote no_realization)
                "a package constant whose value is not its constructor applied")))))
       (_
         (Prod.mk t1
           (PkErr (quote no_realization)
             "a package constant whose value is not its constructor applied")))))))
;; a package's field i applied to `args`: the field's term applied and erased — a function field
;; a call head (a name, a partial application, a lambda the erasure beta-reduces or lifts), a value
;; field its closed E term, a law field never in a runtime position. At the declaration's check
;; the placeholder's field by its role
(fn erase_package_proj
  ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (args (List Expr)) (fuel Int))
  ErRes
  (match (package_subject t env x)
    ((Prod.mk t1 (PkErr e m)) (ErErr e m))
    ((Prod.mk t1 (PkFields _ fields))
     (match (nth fields i)
       ((some fi) (erase t1 env (mk_app_n fi args) (- fuel 1)))
       (none
         (ErErr (quote no_realization)
           (append (show_name sn) ": a projection past the constructor's fields")))))
    ((Prod.mk t1 (PkPlaceholder pn))
     (match (tr_package t1 sn)
       ((Prod.mk t2 none)
        (ErErr (quote no_realization) (append (show_name sn) " is not a package type")))
       ((Prod.mk t2 (some (Prod.mk _ roles)))
        (match (nth roles i)
          ((some BErased)
           (ErErr (quote erased_in_runtime)
             (append (show_name sn) ": a package's law in a runtime position")))
          ((some (BStatic k))
           (if (bool_not (= (len args) k))
             (ErErr (quote function_value)
               (append (show_name sn)
                 (append ": a package's function field applied to "
                   (append (show_nat (len args))
                     (append " arguments, its arity "
                       (append (show_nat k) ": it is called at its arity"))))))
             (match (erase_all t2 env args fuel nil)
               ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
               ((Prod.mk none (Prod.mk t3 as)) (ErOk t3 (ECall (package_field_name pn i) as))))))
          ((some (BData _))
           (match args
             (nil (ErOk t2 (ECall (package_field_name pn i) nil)))
             (_
               (ErErr (quote function_value)
                 (append (show_name sn)
                   ": a package's value field applied: it is a value, not a function")))))
          (_
            (ErErr (quote no_realization)
              (append (show_name sn) ": a projection past the constructor's fields")))))))))
(fn package_field_name ((pn Name) (i Int)) Name
  (name_append pn (n1 (sym_of_chars (append "field_" (show_nat i))))))
;; the field roles of a constructor: True for a runtime field, False for an erased one
(fn field_roles ((t Tr) (c Name)) (Prod Tr (Option (List Bool)))
  (match (env_find (tr_env t) c)
    ((some info)
     (match info
       ((CtorInfo _ _ _ nparams _ _)
        (match (tr_tele_fields t info nparams)
          ((Prod.mk t1 none) (Prod.mk t1 none))
          ((Prod.mk t1 (some (Tele _ binds _ _)))
           (Prod.mk t1 (some (data_flags (drop nparams binds)))))))
       (_ (Prod.mk t none))))
    (none (Prod.mk t none))))
;; an application by its head
(fn erase_app ((t Tr) (env (List ErEnt)) (head Expr) (args (List Expr)) (fuel Int)) ErRes
  (match head
    ((Const _ c _) (erase_const t env c args fuel))
    ((FVar _ id)
     (match (er_index env id 0)
       ((some (Prod.mk EKVar i)) (erase_erased_args t env (EBVar i) args fuel))
       ((some (Prod.mk EKIH _))
        (ErErr (quote recursion_structure)
          "a recursive definition's executable structure is not readable off the recursor: supply the body"))
       ((some (Prod.mk (EKCall c roles) _))
        (if (bool_not (= (len args) (len roles)))
          (ErErr (quote function_value)
            (append (show_name c) " partially applied: a function is no value"))
          (match (erase_roles t env roles args fuel nil)
            ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
            ((Prod.mk none (Prod.mk t1 as)) (ErOk t1 (ECall c as))))))
       ((some (Prod.mk (EKShape sh ids) _)) (erase_shape_call t env sh ids args fuel))
       ((some (Prod.mk (EKTemplate c) _)) (erase_template_call t env c args fuel))
       (_
         (ErErr (quote function_value)
           "an application whose head is not a constant: a function is no value"))))
    ((Lam _ _ _ _ _)
     (match (beta_head (w_st (Tr.w t)) head args)
       ((Prod.mk st r) (erase (tr_set_w t (w_set_st (Tr.w t) st)) env r (- fuel 1)))))
    ((Proj _ sn i x)  ; a package's function field applied
     (match (tr_package t sn)
       ((Prod.mk t1 (some _)) (erase_package_proj t1 env sn i x args fuel))
       ((Prod.mk t1 none)
        (ErErr (quote function_value)
          "an application whose head is a projection: a function is no value"))))
    (_
      (ErErr (quote function_value)
        "an application whose head is not a constant: a function is no value"))))
;; a runtime variable applied to proofs (dite's branches): the variable itself; to anything else, a function value
(fn erase_erased_args ((t Tr) (env (List ErEnt)) (v ETerm) (args (List Expr)) (fuel Int)) ErRes
  (measure (struct args))
  (match args
    (nil (ErOk t v))
    ((cons a r)
     (match (tr_infer t a)
       ((Prod.mk t1 (some aty))
        (match (w_is_prop (Tr.w t1) aty)
          ((Prod.mk w2 (some true)) (erase_erased_args (tr_set_w t1 w2) env v r fuel))
          ((Prod.mk w2 _)
           (ErErr (quote function_value)
             "a variable applied to a runtime value: a function is no value — a function-typed binder is a static parameter of a template"))))
       ((Prod.mk t1 none)
        (ErErr (quote function_value) "a variable applied to an argument K could not type"))))))
(fn last_component ((n Name)) Symbol
  (match n
    ((Str _ s) s)
    (_ (quote anon))))
;; a constant generated for a recursion, whose executable structure no kernel term shows:
;; `T.below`, `T.brecOn` and `T.binductionOn` of an inductive T, and Init's fixpoints. A
;; declaration that only bears such a last component — a fn named `below` — is none
(fn rec_generated ((env CheckedEnv) (c Name)) Bool
  (match c
    ((Str _ lc)
     (if
       (bool_or (sym_eq lc (quote brecOn))
         (bool_or (sym_eq lc (quote below)) (sym_eq lc (quote binductionOn))))
       (of_inductive env c)
       (bool_or (name_eq c (n2 (quote WellFounded) (quote fix)))
         (bool_or (name_eq c (Str (n2 (quote WellFounded) (quote Nat)) (quote fix)))
           (name_eq c (Str (n2 (quote Lean) (quote Order)) (quote fix)))))))
    (_ false)))
;; a name directly under an inductive type's: where a generated constant of the type stands
(fn of_inductive ((env CheckedEnv) (c Name)) Bool
  (match c
    ((Str p _)
     (match (env_find env p)
       ((some (InductInfo _ _ _ _ _ _ _ _ _)) true)
       (_ false)))
    (_ false)))
;; `k`: the constant where a row of the registry may speak for it — Init's; a native declaration
;; that bears a row's name (a module `Bool` declaring `or` under a prefix that stops before
;; Init's) is its own program, never the row's
(fn erase_const ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (erase_const_at t env c (if (native_decl (Tr.sc t) c) Anon c) args fuel))
(fn erase_const_at ((t Tr) (env (List ErEnt)) (c Name) (k Name) (args (List Expr)) (fuel Int)) ErRes
  (let ((lc (last_component c)))
    (if (bool_or (name_eq k (n1 (quote absurd))) (name_eq k (n2 (quote False) (quote elim))))
      (ErOk t EAbsurd)  ; a refuted row
    (if (name_eq k (n2 (quote OfNat) (quote ofNat)))
      (match args
        ((cons (Const _ nn _) (cons (Lit _ (LitNat n)) _))
         (if (name_eq nn (nm_nat)) (ErOk t (ELit (LNat n)))
         (ErErr (quote no_realization) "OfNat.ofNat off Nat")))
        (_ (ErErr (quote no_realization) "OfNat.ofNat")))
    (if (name_eq k (nm_nat_zero)) (ErOk t (ELit (LNat 0)))
    (if (name_eq k (nm_nat_succ))
      (match args
        ((cons x nil)
         (match (erase t env x (- fuel 1))
           ((ErErr e m) (ErErr e m))
           ((ErOk t1 x1) (ErOk t1 (EPrim (n2 (quote Nat) (quote add)) (list x1 (ELit (LNat 1))))))))
        (_ (ErErr (quote function_value) "Nat.succ unapplied")))
    (if (name_eq k (nm_int_of_nat))  ; Nat and Int share the integer: the coercion is the identity
      (match args
        ((cons x nil) (erase t env x (- fuel 1)))
        (_ (ErErr (quote function_value) "Int.ofNat unapplied")))
    (if (name_eq k (nm_int_neg_succ))
      (match args
        ((cons (Lit _ (LitNat n)) nil) (ErOk t (ELit (LInt (- (- 0 n) 1)))))
        ((cons x nil)
         (match (erase t env x (- fuel 1))
           ((ErErr e m) (ErErr e m))
           ((ErOk t1 x1)
            (ErOk t1
              (EPrim (n1 (quote -))
                (list (EPrim (n1 (quote -)) (list (ELit (LNat 0)) x1)) (ELit (LNat 1))))))))
        (_ (ErErr (quote function_value) "Int.negSucc unapplied")))
    (if (name_eq k (n2 (quote Decidable) (quote decide)))
      ;; decide p inst: Bool and Decidable have different cells (ev.shard), so the conversion is
      ;; explicit — (if ⟦inst⟧ true false) over Init's Bool
      (match args
        ((cons _ (cons inst nil))
         (match (erase_cond t env inst (- fuel 1))
           ((ErErr e m) (ErErr e m))
           ((ErOk t1 i1)
            (match (erase t1 env (mk_const (n2 (quote Bool) (quote true)) nil) (- fuel 1))
              ((ErErr e m) (ErErr e m))
              ((ErOk t2 tt)
               (match (erase t2 env (mk_const (n2 (quote Bool) (quote false)) nil) (- fuel 1))
                 ((ErErr e m) (ErErr e m))
                 ((ErOk t3 ff) (ErOk t3 (EIf i1 tt ff)))))))))
        (_ (ErErr (quote function_value) "Decidable.decide unapplied")))
      (if (name_eq k (n1 (quote instDecidableEqBool)))
        ;; a value here: Decidable's cells (where an `if` reads it, erase_cond gives the test)
        (match args
          ((cons a (cons b nil)) (erase_bool_eq t env a b fuel))
          (_ (ErErr (quote function_value) "instDecidableEqBool unapplied")))
        (if (bool_or (name_eq k (n1 (quote ite))) (name_eq k (n1 (quote dite))))
          (match args
            ((cons _ (cons _ (cons h (cons a (cons b nil)))))
             (erase_ite t env h a b (name_eq k (n1 (quote dite))) fuel))
            (_ (ErErr (quote function_value) "ite unapplied")))
        (if
          (bool_or (name_eq k (n2 (quote Bool) (quote and)))
            (bool_or (name_eq k (n2 (quote Bool) (quote or)))
              (name_eq k (n2 (quote Bool) (quote not)))))
          (erase_bool_op t env c args fuel)
          (if (rec_generated (tr_env t) c)
            (ErErr (quote recursion_structure)
              (append (show_name c)
                ": a recursive definition's executable structure is not readable off the kernel term — supply the body"))
          (if
            (bool_or (name_eq k (n2 (quote Classical) (quote choice)))
              (bool_or (name_eq k (n2 (quote Acc) (quote rec)))
                (bool_or (name_eq k (nm_quot_lift))
                  (bool_or (name_eq k (nm_quot_mk)) (name_eq k (nm_quot_ind))))))
            (ErErr (quote noncomputable)
              (append (show_name c) " in a runtime position: it has no program"))
            (match (env_find (tr_env t) c)
              (none (ErErr (quote unknown_constant) (show_name c)))
              ((some info)
               (match info
                 ((CtorInfo _ ind _ nparams _ _) (erase_ctor t env c ind nparams args fuel))
                 ((RecInfo _ _ nparams _ nmotives nminors _ _ _)
                  (erase_rec t env c nparams nmotives nminors args fuel))
                 (_
                   (if (bool_and (sym_eq lc (quote casesOn)) (of_inductive (tr_env t) c))
                     (erase_cases t env c args fuel)
                   (if (bool_or (is_template (Tr.es t) c) (owner_is t c))
                     ;; a template's call is a call of its instance; a realize template's
                     ;; self-call names its constant
                     (erase_template_call t env c args fuel)
                     (match
                       (if (name_eq c (Tr.id t)) (some (ESig c 0 nil (ETVar 0)))
                       (es_find_decl (Tr.es t) c))  ; the realized constant calling itself: a call
                       ((some (EFn _ _ ps _ _ _)) (erase_call t env c info args fuel))
                       ((some (ESig _ _ ps _)) (erase_call t env c info args fuel))
                       ((some (EExtern _ _ _ _)) (erase_call_as t env c info args fuel true))
                       (_
                         (match (realization_of k)
                           ((some p)
                            (match (erase_all t env args fuel nil)
                              ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                              ((Prod.mk none (Prod.mk t1 as))
                               (if (is_decision k) (erase_dec_value t1 env (EPrim p as) fuel)
                               (ErOk t1 (EPrim p as))))))
                           (none
                             (match (realization_expr k)
                               ((some body)
                                (match (erase_all t env args fuel nil)
                                  ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                                  ((Prod.mk none (Prod.mk t1 (cons a nil)))
                                   (ErOk t1 (ELet (list a) body)))
                                  ((Prod.mk none _)
                                   (ErErr (quote function_value)
                                     (append (show_name c)
                                       " partially applied: a function is no value")))))
                               (none
                                 (match (prim_l_identity k)
                                   ((some _)
                                    (match (erase_all t env args fuel nil)
                                      ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                                      ((Prod.mk none (Prod.mk t1 as)) (ErOk t1 (EPrim c as)))))
                                   (none
                                     (match (mt_is_matcher (tr_env t) c)
                                       ((some desc) (erase_matcher t env c desc args fuel))
                                       (none
                                         (match (proj_fn_app info args)
                                           ((some (Prod.mk (Prod.mk sn i) (Prod.mk x nil)))
                                            (erase_proj t env sn i x fuel))
                                           ((some (Prod.mk (Prod.mk sn i) (Prod.mk x rest)))
                                            (match (tr_package t sn)
                                              ((Prod.mk t1 (some _))
                                               (erase_package_proj t1 env sn i x rest fuel))
                                              ((Prod.mk t1 none)
                                               (ErErr (quote function_value)
                                                 (append (show_name c)
                                                   ": a projection applied past its structure — a function is no value")))))
                                           (none (erase_unfold_matcher t env c info args fuel)))))))))))))))))))))))))))))))))
;; a definition without a realization: Lean's own matcher (`NAME.match_N`, no descriptor of this
;; run) is a definition over `casesOn` — unfolded at its arguments and erased as any definition's
;; value; anything else has no realization
(fn erase_unfold_matcher
  ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int))
  ErRes
  (match info
    ((DefnInfo _ v _ _ _)
     (if (is_match_name c)
       (match (beta_head (w_st (Tr.w t)) v args)
         ((Prod.mk st r) (erase (tr_set_w t (w_set_st (Tr.w t) st)) env r (- fuel 1))))
       (ErErr (quote no_realization)
         (append (show_name c)
           ": no realization attached — realize it first, or import the file that does"))))
    (_
      (ErErr (quote no_realization)
        (append (show_name c)
          ": no realization attached — realize it first, or import the file that does")))))
(fn is_match_name ((c Name)) Bool
  (match c
    ((Str _ s) (is_match_prefix (chars_of_sym s)))
    (_ false)))
(fn is_match_prefix ((cs (List Int))) Bool  ; "match_"
  (match cs
    ((cons c1 (cons c2 (cons c3 (cons c4 (cons c5 (cons c6 _))))))
     (bool_and (= c1 109)
       (bool_and (= c2 97)
         (bool_and (= c3 116) (bool_and (= c4 99) (bool_and (= c5 104) (= c6 95)))))))
    (_ false)))

;; ---- decisions: a value and a condition -------------------------------------------
;; A `Decidable` value is one of the type's two cells — a match by constructor reads it, a
;; function returns it, a derived decision is built of them. The registry's decisions answer a
;; test instead (the integer comparison's cell, a Bool), which is all an `if` reads: so where a
;; decision is an `if`'s condition — `ite`, `dite`, `decide`, a `casesOn` read back as an `if` —
;; erase_cond gives the bare test, and everywhere else the constant erases to
;; (if TEST isTrue isFalse): with the bare test in every position, a
;; match on `(Nat.decEq a b)` by constructor would take the wrong row
(fn erase_dec_value ((t Tr) (env (List ErEnt)) (test ETerm) (fuel Int)) ErRes
  (let ((tt (mk_const (n1 (quote True)) nil)) (pf (mk_const (n2 (quote True) (quote intro)) nil)))
    (match
      (erase_all t env
        (list (mk_app (mk_app (mk_const (n2 (quote Decidable) (quote isTrue)) nil) tt) pf)
          (mk_app (mk_app (mk_const (n2 (quote Decidable) (quote isFalse)) nil) tt) pf))
        fuel
        nil)  ; the proofs are erased unread: only the cells are wanted
      ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
      ((Prod.mk none (Prod.mk t1 (cons yes (cons no nil)))) (ErOk t1 (EIf test yes no)))
      ((Prod.mk none _) (ErErr (quote no_realization) "Decidable's cells")))))
(fn is_decision ((c Name)) Bool
  (let ((lc (last_component c)))
    (bool_or (sym_eq lc (quote decEq)) (bool_or (sym_eq lc (quote decLt)) (sym_eq lc (quote decLe))))))
;; `a = b` at Bool: the test over the erased operands (prog.shard bool_eq_cond) — `a` where b
;; is `true` (and symmetrically), else (if a b (if b false true)) over Init's Bool cells
(fn bool_eq_test ((t Tr) (env (List ErEnt)) (a Expr) (b Expr) (fuel Int)) ErRes
  (match (erase_all t env (list a b) fuel nil)
    ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
    ((Prod.mk none (Prod.mk t1 (cons a1 (cons b1 nil)))) (ErOk t1 (bool_eq_cond a1 b1)))
    ((Prod.mk none _) (ErErr (quote no_realization) "Bool's decidable equality"))))
(fn erase_bool_eq ((t Tr) (env (List ErEnt)) (a Expr) (b Expr) (fuel Int)) ErRes
  (match (bool_eq_test t env a b fuel)
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 test) (erase_dec_value t1 env test fuel))))
;; a decision where an `if` reads it
(fn erase_cond ((t Tr) (env (List ErEnt)) (h Expr) (fuel Int)) ErRes
  (match (get_app_fn h)
    ((Const _ c _)
     (if (native_decl (Tr.sc t) c) (erase t env h fuel)
     (let ((args (get_app_args h)))
       (if (name_eq c (n1 (quote instDecidableEqBool)))
         (match args
           ((cons a (cons b nil)) (bool_eq_test t env a b fuel))
           (_ (erase t env h fuel)))
       (if
         (bool_and (is_decision c)
           (match (es_find_decl (Tr.es t) c)
             ((some _) false)
             (none true)))
         (match (realization_of c)
           ((some p)
            (match (erase_all t env args fuel nil)
              ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
              ((Prod.mk none (Prod.mk t1 as)) (ErOk t1 (EPrim p as)))))
           (none (erase t env h fuel)))
         (erase t env h fuel))))))
    (_ (erase t env h fuel))))
;; the registry's Bool rows: Init's connectives as the `if` their definitions are —
;; `Bool.and a b` is (if a b false), `Bool.or a b` (if a true b), `Bool.not a` (if a false true),
;; the second operand not evaluated where the first decides (Init marks them macro_inline)
(fn erase_bool_op ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match
    (erase_all t env
      (append args
        (list (mk_const (n2 (quote Bool) (quote true)) nil)
          (mk_const (n2 (quote Bool) (quote false)) nil)))
      fuel
      nil)
    ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
    ((Prod.mk none (Prod.mk t1 (cons a (cons tt (cons ff nil)))))
     (if (name_eq c (n2 (quote Bool) (quote not))) (ErOk t1 (EIf a ff tt))
     (ErErr (quote function_value)
       (append (show_name c) " partially applied: a function is no value"))))
    ((Prod.mk none (Prod.mk t1 (cons a (cons b (cons tt (cons ff nil))))))
     (if (name_eq c (n2 (quote Bool) (quote and))) (ErOk t1 (EIf a b ff))
     (if (name_eq c (n2 (quote Bool) (quote or))) (ErOk t1 (EIf a tt b))
     (ErErr (quote function_value) (append (show_name c) " over-applied")))))
    ((Prod.mk none _)
     (ErErr (quote function_value)
       (append (show_name c) " partially applied: a function is no value")))))
;; ---- a matcher application ------------------------------------------------
;; OWNER.match_N params motive scrutinee alternatives: the E match of the rows read back off
;; the matcher's own type (mt_is_matcher has regenerated and compared it), each alternative's
;; lambdas the row's variables — control flow in E: the scrutinee once, then the first
;; matching row's arm only
(fn erase_matcher ((t Tr) (env (List ErEnt)) (c Name) (desc MtDesc) (args (List Expr)) (fuel Int))
  ErRes
  (match desc
    ((MtDesc np nd rows)
     (if (bool_not (= nd 1))
       (ErErr (quote no_realization)
         (append (show_name c) ": a match on several scrutinees has no E form"))
     (if (< (len args) (+ np (+ 2 (len rows))))
       (ErErr (quote function_value)
         (append (show_name c) " partially applied: a function is no value"))
       (match (nth args (+ np 1))
         (none (ErErr (quote function_value) (show_name c)))
         ((some scrut)
          (match (erase t env scrut (- fuel 1))
            ((ErErr e m) (ErErr e m))
            ((ErOk t1 s1)
             (match
               (erase_alts t1 env rows (drop (+ np 2) args) (drop (+ np (+ 2 (len rows))) args) fuel
                 nil)
               ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
               ((Prod.mk none (Prod.mk t2 arms)) (ErOk t2 (EMatch s1 arms)))))))))))))
(fn erase_alts
  ((t Tr)
   (env (List ErEnt))
   (rows (List (List MtPat)))
   (alts (List Expr))
   (extra (List Expr))
   (fuel Int)
   (acc (List EArm)))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr (List EArm)))
  (measure (struct rows))
  (match rows
    (nil (Prod.mk none (Prod.mk t (rev acc))))
    ((cons (cons p nil) r)
     (match alts
       (nil
         (Prod.mk (some (Prod.mk (quote function_value) "a match with too few alternatives"))
           (Prod.mk t nil)))
       ((cons a ar)
        (match (mt_epat t p true 64)
          ((Prod.mk t1 none)
           (Prod.mk
             (some
               (Prod.mk (quote no_realization)
                 "a pattern on an erased field, or on a type that is not an E type"))
             (Prod.mk t1 nil)))
          ((Prod.mk t1 (some (Prod.mk ep roles)))
           (match (alt_with_extra t1 a (len roles) extra nil)
             ((Prod.mk t1x a1)
              (match (erase_alt t1x env a1 roles fuel)
                ((Prod.mk (some (Prod.mk e m)) _) (Prod.mk (some (Prod.mk e m)) (Prod.mk t1x nil)))
                ((Prod.mk none (Prod.mk t2 body))
                 (erase_alts t2 env r ar extra fuel
                   (cons
                     (EArm
                       (match ep
                         ((some q) q)
                         (none PVar))
                       body)
                     acc)))))))))))
    (_
      (Prod.mk (some (Prod.mk (quote no_realization) "a match on several scrutinees has no E form"))
        (Prod.mk t nil)))))
;; an alternative under a matcher applied past its alternatives (the dependent match):
;; its field lambdas opened, the lambdas after them instantiated at the extra arguments
;; — the generalized locals, re-bound in the arm —, the fields closed again
(fn alt_with_extra ((t Tr) (a Expr) (k Int) (extra (List Expr)) (fvs (List Expr))) (Prod Tr Expr)
  (measure k)
  (match extra
    (nil (Prod.mk t a))
    (_
      (if (<= k 0)
        (match (inst_extra t a extra)
          ((Prod.mk t1 b) (tr_lams t1 (rev fvs) b)))
        (match (open_lam t a)
          ((Prod.mk t1 none) (Prod.mk t1 a))
          ((Prod.mk t1 (some (Prod.mk fv body)))
           (alt_with_extra t1 body (- k 1) extra (cons fv fvs))))))))
(fn inst_extra ((t Tr) (a Expr) (extra (List Expr))) (Prod Tr Expr)
  (measure (struct extra))
  (match extra
    (nil (Prod.mk t a))
    ((cons x r)
     (match a
       ((Lam _ _ _ _ body)
        (match (tr_inst1 t body x)
          ((Prod.mk t1 b) (inst_extra t1 b r))))
       (_
         (match (tr_apps t a (list x))
           ((Prod.mk t1 b) (inst_extra t1 b r))))))))
;; a row's pattern in E and its variables' runtime flags in slot order: a variable binds a
;; slot where its position is runtime data and vanishes where it is erased; a constructor
;; keeps its runtime fields
(fn mt_epat ((t Tr) (p MtPat) (runtime Bool) (fuel Int))
  (Prod Tr (Option (Prod (Option EPat) (List Bool))))
  (measure fuel)
  (if (< fuel 1) (Prod.mk t none)
  (match p
    ((MtVar _) (Prod.mk t (some (Prod.mk (if runtime (some PVar) none) (list runtime)))))
    ((MtCtor c subs)
     (if (bool_not runtime) (Prod.mk t none)
     (match (env_find (tr_env t) c)
       ((some (CtorInfo _ ind _ _ _ _))
        (if (rep_row ind)  ; a row's constructor pattern is its one runtime field's pattern, on the scrutinee itself
          (match (row_field t ind)
            ((Prod.mk t1 none) (Prod.mk t1 none))
            ((Prod.mk t1 (some (Prod.mk _ roles)))
             (match (mt_epats t1 subs roles nil nil (- fuel 1))
               ((Prod.mk t2 (some (Prod.mk (cons q nil) vroles)))
                (Prod.mk t2 (some (Prod.mk (some q) vroles))))
               ((Prod.mk t2 _) (Prod.mk t2 none)))))
          (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind nil)
            ((Prod.mk (Prod.mk w1 es1) false) (Prod.mk t none))
            ((Prod.mk (Prod.mk w1 es1) true)
             (match (field_roles (tr_set_es (tr_set_w t w1) es1) c)
               ((Prod.mk t1 none) (Prod.mk t1 none))
               ((Prod.mk t1 (some roles))
                (match (mt_epats t1 subs roles nil nil (- fuel 1))
                  ((Prod.mk t2 none) (Prod.mk t2 none))
                  ((Prod.mk t2 (some (Prod.mk eps vroles)))
                   (Prod.mk t2 (some (Prod.mk (some (PCtor c eps)) vroles)))))))))))
       (_ (Prod.mk t none))))))))
(fn mt_epats
  ((t Tr) (subs (List MtPat)) (roles (List Bool)) (eps (List EPat)) (vroles (List Bool)) (fuel Int))
  (Prod Tr (Option (Prod (List EPat) (List Bool))))
  (measure (struct subs))
  (match subs
    (nil (Prod.mk t (some (Prod.mk (rev eps) vroles))))
    ((cons p r)
     (match roles
       (nil (Prod.mk t none))
       ((cons rt rr)
        (match (mt_epat t p rt fuel)
          ((Prod.mk t1 none) (Prod.mk t1 none))
          ((Prod.mk t1 (some (Prod.mk ep vr)))
           (mt_epats t1 r rr
             (match ep
               ((some q) (cons q eps))
               (none eps))
             (append vroles vr)
             fuel))))))))
;; one alternative: a lambda per variable of the row, then its body
(fn erase_alt ((t Tr) (env (List ErEnt)) (a Expr) (roles (List Bool)) (fuel Int))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr ETerm))
  (measure (struct roles))
  (match roles
    (nil
      (match (erase t env a (- fuel 1))
        ((ErErr e msg) (Prod.mk (some (Prod.mk e msg)) (Prod.mk t (EBVar 0))))
        ((ErOk t1 b) (Prod.mk none (Prod.mk t1 b)))))
    ((cons rt r)
     (match (open_lam t a)
       ((Prod.mk t1 none)
        (Prod.mk
          (some
            (Prod.mk (quote no_realization)
              "a match alternative K could not open as a function of its variables"))
          (Prod.mk t1 (EBVar 0))))
       ((Prod.mk t1 (some (Prod.mk fv body)))
        (erase_alt t1 (cons (ErEnt (fvar_id_of fv) (if rt EKVar EKErased)) env) body r fuel))))))

;; ---- the E projection of a pre-definition (predef.shard) ---------------------------
;; the binders' roles from their locals' types, the self-local a call of the function with
;; those roles; the body erased. The function's E signature with it
;; PdEraseOk carries the lambdas the body lifted and the instances it demands;
;; PdEraseTemplate: a binder is a static parameter — the fn is a
;; template, with no program of its own: its binders' roles and its result's E type for the
;; instances (template.shard)
(type PdErase
  (PdEraseOk ESt EDecl (List Lifted) (List Demand))
  (PdEraseTemplate ESt (List TBind) EType)
  (PdEraseErr Symbol (List Int)))
(fn erase_predef ((es ESt) (sc Scope) (pd PreDef)) PdErase
  (match (predef_binds (el_w (pd_state pd)) es sc (pd_binders pd) nil nil)
    ((Prod.mk (Prod.mk w1 es1) none)
     (PdEraseErr (quote no_l_identity) "a binder whose type is not an E type"))
    ((Prod.mk (Prod.mk w1 es1) (some binds))
     (match (predef_ret w1 es1 sc pd binds)
       ((Prod.mk (Prod.mk w2 es2) none)
        (PdEraseErr (quote no_l_identity)
          "a result type that is not an E type (a function returned is no value)"))
       ((Prod.mk (Prod.mk w2 es2) (some rt))
        (if (has_static binds) (PdEraseTemplate es2 binds rt)
        (let
          ((t (tr_new w2 es2 sc (pd_name pd) (tbind_types binds)))
           (env
             (append (callee_ents (pd_callees pd))
               (cons (ErEnt (fvar_id_of (pd_self pd)) (EKCall (pd_name pd) (data_flags binds)))
                 (binder_ents binds)))))
          (match (predef_rec t env (pd_rec pd) binds)
            ((Prod.mk _ (Left5r e m)) (PdEraseErr e m))
            ((Prod.mk t0 (Right5r rec))
             (match (erase t0 env (pd_body pd) (budget_depth))
               ((ErErr e m) (PdEraseErr e m))
               ((ErOk t1 ebody)
                (PdEraseOk (Tr.es t1)
                  (EFn (pd_name pd) (count_types binds) (bind_ptypes binds) rt rec ebody)
                  (Tr.lifted t1)
                  (Tr.demands t1)))))))))))))
(fn has_static ((binds (List TBind))) Bool
  (measure (struct binds))
  (match binds
    (nil false)
    ((cons (TBind _ (BStatic _) _) _) true)
    ((cons _ r) (has_static r))))
(fn count_static ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds
    (nil 0)
    ((cons (TBind _ (BStatic _) _) r) (+ 1 (count_static r)))
    ((cons _ r) (count_static r))))
;; a callee-local is a call of the callee
(fn callee_ents ((cs (List CalleeLocal))) (List ErEnt)
  (measure (struct cs))
  (match cs
    (nil nil)
    ((cons (CalleeLocal fv id flags) r)
     (cons (ErEnt (fvar_id_of fv) (EKCall id flags)) (callee_ents r)))))
;; the program's recursion clause: the structural binder's position among the data binders, a
;; measure erased over the binders
(type Either5r (Left5r Symbol (List Int)) (Right5r ERec))
(fn predef_rec ((t Tr) (env (List ErEnt)) (prec PdRec) (binds (List TBind))) (Prod Tr Either5r)
  (match prec
    (PdNone (Prod.mk t (Right5r RecNone)))
    ((PdStruct x)
     (match (fvar_index (fvar_id_of x) (data_fvars binds) 0)
       ((some i) (Prod.mk t (Right5r (RecStruct i))))
       (none
         (Prod.mk t (Left5r (quote bad_measure) "the structural parameter is not a data parameter")))))
    ;; a measure that cites a function with no program — a definition and nothing more, a
    ;; derived size — is K's alone: the program's clause says so and holds
    ;; no term. Any other obstacle of the measure's erasure is the function's
    ((PdMeasure m)
     (match (erase t env m (budget_depth))
       ((ErErr e msg)
        (if (sym_eq e (quote no_realization)) (Prod.mk t (Right5r RecLogical))
        (Prod.mk t (Left5r e msg))))
       ((ErOk t1 em) (Prod.mk t1 (Right5r (RecMeasure em))))))))
(fn data_fvars ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds
    (nil nil)
    ((cons (TBind _ (BData _) fv) r) (cons fv (data_fvars r)))
    ((cons _ r) (data_fvars r))))
(fn predef_binds ((w W) (es ESt) (sc Scope) (fvs (List Expr)) (tps (List Expr)) (acc (List TBind)))
  (Prod (Prod W ESt) (Option (List TBind)))
  (measure (struct fvs))
  (match fvs
    (nil (Prod.mk (Prod.mk w es) (some (rev acc))))
    ((cons fv r)
     (match (w_local_type w (fvar_id_of fv))
       (none (Prod.mk (Prod.mk w es) none))
       ((some ty)
        (match (binder_role w es sc ty tps)
          ((Prod.mk (Prod.mk w1 es1) none) (Prod.mk (Prod.mk w1 es1) none))
          ((Prod.mk (Prod.mk w1 es1) (some role))
           (predef_binds w1 es1 sc r
             (match role
               (BType (append tps (list fv)))
               (_ tps))
             (cons (TBind Anon role fv) acc)))))))))
;; the result's E type: the declared type's codomain at the binders' locals
(fn predef_ret ((w W) (es ESt) (sc Scope) (pd PreDef) (binds (List TBind)))
  (Prod (Prod W ESt) (Option EType))
  (match (mt_inst_args w (pd_type pd) (pd_binders pd))
    ((Prod.mk w1 none) (Prod.mk (Prod.mk w1 es) none))
    ((Prod.mk w1 (some rt)) (l_to_etype w1 es sc rt (tbind_types binds) nil))))

;; ---- constructors, calls, decisions, case analyses ---------------------------------------------
;; a constructor: its inductive E-eligible, the static and erased arguments dropped
(fn erase_ctor
  ((t Tr) (env (List ErEnt)) (c Name) (ind Name) (nparams Int) (args (List Expr)) (fuel Int))
  ErRes
  (if (rep_row ind)  ; a row's constructor is its one runtime argument
    (match (row_field t ind)
      ((Prod.mk t1 none)
       (ErErr (quote no_realization)
         (append (show_name ind)
           ": the registry's row does not describe this structure (one constructor, one runtime field)")))
      ((Prod.mk t1 (some (Prod.mk _ roles)))
       (if (bool_not (= (len args) (+ nparams (len roles))))
         (ErErr (quote function_value)
           (append (show_name c) " partially applied: a function is no value"))
         (match (erase_roles t1 env roles (drop nparams args) fuel nil)
           ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
           ((Prod.mk none (Prod.mk t2 (cons a nil))) (ErOk t2 a))
           ((Prod.mk none _) (ErErr (quote no_realization) (show_name c)))))))
    (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind nil)
      ((Prod.mk (Prod.mk w1 es1) false)
       (ErErr (quote no_realization) (append (show_name ind) " is not an E type")))
      ((Prod.mk (Prod.mk w1 es1) true)
       (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
         (match (field_roles t1 c)
           ((Prod.mk t2 none) (ErErr (quote no_realization) (show_name c)))
           ((Prod.mk t2 (some roles))
            (if (bool_not (= (len args) (+ nparams (len roles))))
              (ErErr (quote function_value)
                (append (show_name c) " partially applied: a function is no value"))
              (match (erase_roles t2 env roles (drop nparams args) fuel nil)
                ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                ((Prod.mk none (Prod.mk t3 as)) (ErOk t3 (ECtor c as))))))))))))
(fn erase_roles
  ((t Tr) (env (List ErEnt)) (roles (List Bool)) (args (List Expr)) (fuel Int) (acc (List ETerm)))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr (List ETerm)))
  (measure (struct roles))
  (match roles
    (nil (Prod.mk none (Prod.mk t (rev acc))))
    ((cons rt r)
     (match args
       (nil (Prod.mk (some (Prod.mk (quote function_value) "partially applied")) (Prod.mk t nil)))
       ((cons a ar)
        (if rt
          (match (erase t env a (- fuel 1))
            ((ErErr e m) (Prod.mk (some (Prod.mk e m)) (Prod.mk t nil)))
            ((ErOk t1 a1) (erase_roles t1 env r ar fuel (cons a1 acc))))
          (erase_roles t env r ar fuel acc)))))))
;; a call of a realized constant: its binders' roles select the runtime arguments
(fn erase_call
  ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int))
  ErRes
  (erase_call_as t env c info args fuel false))
;; an extern's call is the effect, EExt: the extern is an opaque
;; constant in L, its program the extern — `ev` stops there, `run` performs it
(fn erase_call_as
  ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int) (ext Bool))
  ErRes
  (match (tr_tele t info)
    ((Prod.mk t1 none) (ErErr (quote no_realization) (show_name c)))
    ((Prod.mk t1 (some (Tele _ binds _ _)))
     (let ((roles (data_flags binds)))
       (if (bool_not (= (len args) (len roles)))
         (ErErr (quote function_value)
           (append (show_name c) " partially applied: a function is no value"))
         (match (erase_roles t1 env roles args fuel nil)
           ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
           ((Prod.mk none (Prod.mk t2 as)) (ErOk t2 (if ext (EExt c as) (ECall c as))))))))))
;; ite / dite: an if on the decision; dite's branches applied to their proof
(fn erase_ite ((t Tr) (env (List ErEnt)) (h Expr) (a Expr) (b Expr) (dep Bool) (fuel Int)) ErRes
  (match (erase_cond t env h (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 h1)
     (match (erase_branch t1 env a dep fuel)
       ((ErErr e m) (ErErr e m))
       ((ErOk t2 a1)
        (match (erase_branch t2 env b dep fuel)
          ((ErErr e m) (ErErr e m))
          ((ErOk t3 b1) (ErOk t3 (EIf h1 a1 b1)))))))))
(fn erase_branch ((t Tr) (env (List ErEnt)) (br Expr) (dep Bool) (fuel Int)) ErRes
  (if (bool_not dep) (erase t env br (- fuel 1))
  (match br
    ((Lam _ n _ dom body)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1)
           (erase t2 (cons (ErEnt (fvar_id_of fv) EKErased) env) body1 (- fuel 1)))))))
    (_ (erase t env br (- fuel 1))))))
;; T.casesOn params motive major minors: a match, each minor's field lambdas the pattern's variables
(fn erase_cases ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match c
    ((Str ind _)
     (match (env_find (tr_env t) ind)
       ((some (InductInfo _ nparams _ _ ctors _ _ _ _))
        (if (rep_row ind)
          (erase_row_cases t env c ind (nth args (+ nparams 1)) (nth args (+ nparams 2))
            (if (= (len args) (+ nparams 3)) true false)
            fuel)
          (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind nil)
            ((Prod.mk (Prod.mk w1 es1) false)
             (ErErr (quote no_realization) (append (show_name ind) " is not an E type")))
            ((Prod.mk (Prod.mk w1 es1) true)
             (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
               (if (bool_not (= (len args) (+ nparams (+ 2 (len ctors)))))
                 (ErErr (quote function_value) (append (show_name c) " partially applied"))
                 (match (nth args (+ nparams 1))
                   (none (ErErr (quote function_value) (show_name c)))
                   ((some major)
                    (match (if_branches t1 ctors (drop (+ nparams 2) args))
                      ((some (Prod.mk else_b then_b))
                       (match (erase_cond t1 env major (- fuel 1))
                         ((ErErr e m) (ErErr e m))
                         ((ErOk t2 major1) (erase_ite_bodies t2 env major1 then_b else_b fuel))))
                      (none
                        (match (erase t1 env major (- fuel 1))
                          ((ErErr e m) (ErErr e m))
                          ((ErOk t2 major1)
                           (match
                             (erase_minors t2 env ctors (drop (+ nparams 2) args) false fuel nil)
                             ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                             ((Prod.mk none (Prod.mk t3 arms)) (ErOk t3 (EMatch major1 arms))))))))))))))))
       (_ (ErErr (quote no_realization) (show_name c)))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; a case analysis of a row of the registry's types: its one alternative with the runtime
;; field bound to the scrutinee, a let
(fn erase_row_cases
  ((t Tr)
   (env (List ErEnt))
   (c Name)
   (ind Name)
   (major (Option Expr))
   (minor (Option Expr))
   (saturated Bool)
   (fuel Int))
  ErRes
  (match (Prod.mk major minor)
    ((Prod.mk (some mj) (some mn))
     (if (bool_not saturated)
       (ErErr (quote function_value) (append (show_name c) " partially applied"))
       (match (row_field t ind)
         ((Prod.mk t1 none)
          (ErErr (quote no_realization)
            (append (show_name ind)
              ": the registry's row does not describe this structure (one constructor, one runtime field)")))
         ((Prod.mk t1 (some (Prod.mk _ roles)))
          (match (erase t1 env mj (- fuel 1))
            ((ErErr e m) (ErErr e m))
            ((ErOk t2 mj1)
             (match (erase_minor t2 env mn roles 0 fuel)
               ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
               ((Prod.mk none (Prod.mk t3 body)) (ErOk t3 (ELet (list mj1) body))))))))))
    (_ (ErErr (quote function_value) (append (show_name c) " partially applied")))))
;; a case analysis over a two-constructor inductive whose alternatives ignore their fields is
;; the `if` it was written as (the second constructor takes the then-branch;
;; elab.shard's elab_if_cases): the two bodies, first constructor's first
(fn if_branches ((t Tr) (ctors (List Name)) (minors (List Expr))) (Option (Prod Expr Expr))
  (match ctors
    ((cons c1 (cons c2 nil))
     (match minors
       ((cons m1 (cons m2 nil))
        (match (closed_under (tr_env t) c1 m1)
          ((some b1)
           (match (closed_under (tr_env t) c2 m2)
             ((some b2) (some (Prod.mk b1 b2)))
             (none none)))
          (none none)))
       (_ none)))
    (_ none)))
;; the alternative's body under its constructor's fields' lambdas, when it cites none of them
(fn closed_under ((env CheckedEnv) (c Name) (m Expr)) (Option Expr)
  (match (env_find env c)
    ((some (CtorInfo _ _ _ _ nfields _)) (strip_unused_lams m nfields))
    (_ none)))
(fn strip_unused_lams ((m Expr) (k Int)) (Option Expr)
  (measure k)
  (if (< k 1) (if (has_loose_bvars m) none (some m))
  (match m
    ((Lam _ _ _ _ b) (strip_unused_lams b (- k 1)))
    (_ none))))
(fn erase_ite_bodies ((t Tr) (env (List ErEnt)) (c ETerm) (a Expr) (b Expr) (fuel Int)) ErRes
  (match (erase t env a (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 a1)
     (match (erase t1 env b (- fuel 1))
       ((ErErr e m) (ErErr e m))
       ((ErOk t2 b1) (ErOk t2 (EIf c a1 b1)))))))
;; T.rec params motive minors major with no use of an induction hypothesis: a match
(fn erase_rec
  ((t Tr)
   (env (List ErEnt))
   (c Name)
   (nparams Int)
   (nmotives Int)
   (nminors Int)
   (args (List Expr))
   (fuel Int))
  ErRes
  (match c
    ((Str ind _)
     (if (bool_not (= nmotives 1))
       (ErErr (quote recursion_structure) (append (show_name c) ": a nested inductive's recursor"))
       (match (env_find (tr_env t) ind)
         ((some (InductInfo _ _ _ _ ctors _ _ _ _))
          (if (rep_row ind)
            (erase_row_cases t env c ind (nth args (+ nparams 2)) (nth args (+ nparams 1))
              (bool_and (= nminors 1) (= (len args) (+ nparams 3)))
              fuel)
            (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind nil)
              ((Prod.mk (Prod.mk w1 es1) false)
               (ErErr (quote no_realization) (append (show_name ind) " is not an E type")))
              ((Prod.mk (Prod.mk w1 es1) true)
               (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
                 (if (bool_not (= (len args) (+ nparams (+ 2 nminors))))
                   (ErErr (quote function_value) (append (show_name c) " partially applied"))
                   (match (nth args (+ nparams (+ 1 nminors)))
                     (none (ErErr (quote function_value) (show_name c)))
                     ((some major)
                      (match (erase t1 env major (- fuel 1))
                        ((ErErr e m) (ErErr e m))
                        ((ErOk t2 major1)
                         (match
                           (erase_minors t2 env ctors (take nminors (drop (+ nparams 1) args)) true
                             fuel
                             nil)
                           ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
                           ((Prod.mk none (Prod.mk t3 arms)) (ErOk t3 (EMatch major1 arms))))))))))))))
         (_ (ErErr (quote no_realization) (show_name c))))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; the minors in constructor order: each a lambda over the fields (and, for a recursor, the hypotheses)
(fn erase_minors
  ((t Tr)
   (env (List ErEnt))
   (ctors (List Name))
   (minors (List Expr))
   (with_ihs Bool)
   (fuel Int)
   (acc (List EArm)))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr (List EArm)))
  (measure (struct ctors))
  (match ctors
    (nil (Prod.mk none (Prod.mk t (rev acc))))
    ((cons c r)
     (match minors
       (nil
         (Prod.mk
           (some (Prod.mk (quote function_value) "a case analysis with too few alternatives"))
           (Prod.mk t nil)))
       ((cons m mr)
        (match (field_roles t c)
          ((Prod.mk t1 none)
           (Prod.mk (some (Prod.mk (quote no_realization) (show_name c))) (Prod.mk t1 nil)))
          ((Prod.mk t1 (some roles))
           (match (erase_minor t1 env m roles (if with_ihs (ih_count t1 c) 0) fuel)
             ((Prod.mk (some (Prod.mk e msg)) _) (Prod.mk (some (Prod.mk e msg)) (Prod.mk t1 nil)))
             ((Prod.mk none (Prod.mk t2 body))
              (erase_minors t2 env r mr with_ihs fuel
                (cons (EArm (PCtor c (pvars (count_true roles))) body) acc)))))))))))
;; the induction hypotheses of a constructor: one per field whose type's head is its inductive
(fn ih_count ((t Tr) (c Name)) Int
  (match (env_find (tr_env t) c)
    ((some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (tr_tele t info)
          ((Prod.mk _ none) 0)
          ((Prod.mk t1 (some (Tele _ binds _ _))) (count_recursive t1 (drop nparams binds) ind))))
       (_ 0)))
    (none 0)))
(fn count_recursive ((t Tr) (binds (List TBind)) (ind Name)) Int
  (measure (struct binds))
  (match binds
    (nil 0)
    ((cons (TBind _ _ fv) r)
     (+
       (match (tr_type_of_local t fv)
         ((some ty) (if (is_head_const ty ind) 1 0))
         (none 0))
       (count_recursive t r ind)))))
;; one minor: a lambda per field (erased fields and hypotheses as erased entries), then its body
(fn erase_minor ((t Tr) (env (List ErEnt)) (m Expr) (roles (List Bool)) (nihs Int) (fuel Int))
  (Prod (Option (Prod Symbol (List Int))) (Prod Tr ETerm))
  (measure (struct roles))
  (match roles
    (nil
      (match (open_ihs_lams t env m nihs fuel)
        ((Prod.mk t1 none)
         (Prod.mk
           (some
             (Prod.mk (quote no_realization)
               "a case alternative K could not open as a function of its hypotheses"))
           (Prod.mk t1 (EBVar 0))))
        ((Prod.mk t1 (some (Prod.mk env1 body)))
         (match (erase t1 env1 body (- fuel 1))
           ((ErErr e msg) (Prod.mk (some (Prod.mk e msg)) (Prod.mk t1 (EBVar 0))))
           ((ErOk t2 b) (Prod.mk none (Prod.mk t2 b)))))))
    ((cons rt r)
     (match (open_lam t m)
       ((Prod.mk t1 none)
        (Prod.mk
          (some
            (Prod.mk (quote no_realization)
              "a case alternative K could not open as a function of its fields"))
          (Prod.mk t1 (EBVar 0))))
       ((Prod.mk t1 (some (Prod.mk fv body)))
        (erase_minor t1 (cons (ErEnt (fvar_id_of fv) (if rt EKVar EKErased)) env) body r nihs fuel))))))
;; a lambda's binder opened as a local (a non-lambda is applied to the local — eta)
(fn open_lam ((t Tr) (m Expr)) (Prod Tr (Option (Prod Expr Expr)))
  (match m
    ((Lam _ n _ dom body)
     (match (tr_local t n dom)
       ((Prod.mk t1 fv)
        (match (tr_inst1 t1 body fv)
          ((Prod.mk t2 body1) (Prod.mk t2 (some (Prod.mk fv body1))))))))
    (_
      (match (tr_infer t m)
        ((Prod.mk t1 (some ty))
         (match (tr_whnf t1 ty)
           ((Prod.mk t2 (some (Pi _ n _ dom _)))
            (match (tr_local t2 n dom)
              ((Prod.mk t3 fv)
               (match (tr_apps t3 m (list fv))
                 ((Prod.mk t4 m1) (Prod.mk t4 (some (Prod.mk fv m1))))))))
           ((Prod.mk t2 _) (Prod.mk t2 none))))
        ((Prod.mk t1 none) (Prod.mk t1 none))))))
(fn open_ihs_lams ((t Tr) (env (List ErEnt)) (m Expr) (k Int) (fuel Int))
  (Prod Tr (Option (Prod (List ErEnt) Expr)))
  (measure k)
  (if (< k 1) (Prod.mk t (some (Prod.mk env m)))
  (match (open_lam t m)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some (Prod.mk fv body)))
     (open_ihs_lams t1 (cons (ErEnt (fvar_id_of fv) EKIH) env) body (- k 1) fuel)))))

;; ---- a template's call, the shapes of its static arguments, the lifted lambda -----------------
;; a template is called at its full arity: its type arguments closed E types (an instance is
;; at closed types — a polymorphic taker is refused), its static arguments
;; shapes, its data arguments erased; the call is the instance's, at the captured values
;; group by group then the data, and the instance is demanded of the loader. In a template's
;; body at an instance (owner), a call of the template itself at another name is the
;; type-growing recursion, refused
(fn is_template ((es ESt) (c Name)) Bool
  (match (es_info es c)
    ((some (EITemplate _ _ _ _)) true)
    (_ false)))
(fn erase_template_call ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match (owner_binds t c)
    ((some binds) (erase_template_at t env c binds args fuel))
    (none
      (match (env_find (tr_env t) c)
        (none (ErErr (quote unknown_constant) (show_name c)))
        ((some info)
         (match (tr_tele t info)
           ((Prod.mk t1 none)
            (ErErr (quote no_realization)
              (append (show_name c) ": a template whose telescope K could not read")))
           ((Prod.mk t1 (some (Tele _ binds _ _))) (erase_template_at t1 env c binds args fuel))))))))
(fn erase_template_at
  ((t Tr) (env (List ErEnt)) (c Name) (binds (List TBind)) (args (List Expr)) (fuel Int))
  ErRes
  (if (bool_not (= (len args) (len binds)))
    (ErErr (quote function_value)
      (append (show_name c)
        (append " applied to "
          (append (show_nat (len args))
            (append " arguments: a template is called at its full arity of "
              (append (show_nat (len binds)) " arguments"))))))
    (match (template_args t env c binds args fuel nil nil nil nil nil)
      ((Prod.mk t2 (TaErr e m)) (ErErr e m))
      ((Prod.mk t2 (TaOk tyl tye shapes caps data))
       (let ((name (instance_name (Tr.sc t2) c tye shapes)))
         (if (other_shape (Tr.owner t2) c name)
           (ErErr (quote realize_descent)
             (append (show_name c)
               ": a recursive call at other static arguments or type arguments — a template calls itself at its own shapes"))
           (ErOk (tr_demand t2 (Demand name c tyl tye shapes)) (ECall name (append caps data)))))))))
(fn other_shape ((owner (Option (Prod Name Name))) (c Name) (name Name)) Bool
  (match owner
    ((some (Prod.mk oc oname)) (bool_and (name_eq oc c) (bool_not (name_eq oname name))))
    (none false)))
(type TaRes
  (TaOk (List Expr) (List EType) (List Shape) (List ETerm) (List ETerm))
  (TaErr Symbol (List Int)))
(fn template_args
  ((t Tr)
   (env (List ErEnt))
   (c Name)
   (binds (List TBind))
   (args (List Expr))
   (fuel Int)
   (tyl (List Expr))
   (tye (List EType))
   (shapes (List Shape))
   (caps (List ETerm))
   (data (List ETerm)))
  (Prod Tr TaRes)
  (measure (struct binds))
  (match binds
    (nil (Prod.mk t (TaOk (rev tyl) (rev tye) (rev shapes) caps (rev data))))
    ((cons (TBind _ role _) br)
     (match args
       (nil
         (Prod.mk t
           (TaErr (quote function_value)
             (append (show_name c) " partially applied: a function is no value"))))
       ((cons a ar)
        (match role
          (BType
            ;; an open type argument: inside a template (the declaration's check, at placeholders) a
            ;; template is taken at the enclosing template's own type parameters — the instance is
            ;; at closed types —, but the template itself only at its parameters exactly (at a type
            ;; built from them the shape set grows); outside a template a polymorphic taker is
            ;; refused
            (if
              (bool_and (has_fvar a)
                (bool_or (bool_not (in_template t))
                  (bool_and (owner_is t c) (bool_not (own_tparam t a)))))
              (Prod.mk t
                (if (in_template t)
                  (TaErr (quote realize_descent)
                    (append (show_name c)
                      ": a recursive call at a type built from a type parameter — a template calls itself at its own types, or the shape set grows"))
                  (TaErr (quote function_value)
                    (append (show_name c)
                      ": a template taken at an open type — a type parameter of the caller; an instance is at closed types"))))
              (match (l_to_etype (Tr.w t) (Tr.es t) (Tr.sc t) a (Tr.tps t) nil)
                ((Prod.mk (Prod.mk w1 es1) none)
                 (Prod.mk (tr_set_es (tr_set_w t w1) es1)
                   (TaErr (quote no_realization)
                     (append (show_name c) ": a type argument that is no E type"))))
                ((Prod.mk (Prod.mk w1 es1) (some ety))
                 (template_args (tr_set_es (tr_set_w t w1) es1) env c br ar fuel (cons a tyl)
                   (cons ety tye)
                   shapes
                   caps
                   data)))))
          (BErased (template_args t env c br ar fuel tyl tye shapes caps data))
          ((BData _)
           (match (erase t env a (- fuel 1))
             ((ErErr e m) (Prod.mk t (TaErr e m)))
             ((ErOk t1 a1) (template_args t1 env c br ar fuel tyl tye shapes caps (cons a1 data)))))
          ((BStatic k)
           (match (static_shape t env a k fuel)
             ((Prod.mk t1 (SsErr e m)) (Prod.mk t1 (TaErr e m)))
             ((Prod.mk t1 (SsOk sh cs))
              (template_args t1 env c br ar fuel tyl tye (cons sh shapes) (append caps cs) data))))))))))
;; a static parameter's call at an instance: its shape's identity at the captured slots then the arguments
(fn erase_shape_call
  ((t Tr) (env (List ErEnt)) (sh Shape) (ids (List Int)) (args (List Expr)) (fuel Int))
  ErRes
  (if (bool_not (= (len args) (shape_arity sh)))
    (ErErr (quote function_value)
      (append "a static parameter (at "
        (append (show_name (shape_id sh))
          (append ") applied to "
            (append (show_nat (len args))
              (append " arguments, its arity "
                (append (show_nat (shape_arity sh)) ": it is called at its arity")))))))
    (match (erase_all t env args fuel nil)
      ((Prod.mk (some (Prod.mk e m)) _) (ErErr e m))
      ((Prod.mk none (Prod.mk t1 as))
       (let ((all (append (captured_bvars env ids) as)))
         (match (shape_prim sh)
           ((some p)
            (if (is_decision (shape_id sh)) (erase_dec_value t1 env (EPrim p all) fuel)
            (ErOk t1 (EPrim p all))))
           (none (ErOk t1 (ECall (shape_id sh) all)))))))))
(fn captured_bvars ((env (List ErEnt)) (ids (List Int))) (List ETerm)
  (measure (struct ids))
  (match ids
    (nil nil)
    ((cons id r)
     (cons
       (match (er_index env id 0)
         ((some (Prod.mk _ i)) (EBVar i))
         (none (EBVar 0)))
       (captured_bvars env r)))))
;; the shape of a static argument: (a) a name with a program; (b) such a name applied —
;; type and erased arguments kept, runtime arguments captured; (c) a closed lambda, lifted; (d)
;; a static parameter passed on; (e) a package constant. Anything else — a static
;; parameter applied, a runtime variable, a let-bound function — is refused
(type SsRes (SsOk Shape (List ETerm)) (SsErr Symbol (List Int)))
(fn static_pointer () (List Int)
  "a static argument is the name of a fn with a program, a realized constant or an instance, such a name applied to runtime values of the caller, a closed lambda, or a static parameter passed on")
(fn static_shape ((t Tr) (env (List ErEnt)) (a Expr) (k Int) (fuel Int)) (Prod Tr SsRes)
  (match a
    ((Lam _ _ _ _ _) (lift_lambda t env a k fuel))
    ((FVar _ id) (passed_shape t env id k))
    (_
      (match (get_app_fn a)
        ((Const d g ls)
         (if (= k 0) (package_shape t env (Const d g ls) g (get_app_args a))
         (match (env_find (tr_env t) g)
           ((some info)
            (match (proj_fn_app info (get_app_args a))
              ;; a package's function field passed on: the field's term at the constant, a
              ;; placeholder at the check
              ((some (Prod.mk (Prod.mk sn i) (Prod.mk x rest)))
               (package_field_shape t env sn i x rest k fuel))
              (none (named_shape t env (Const d g ls) g (get_app_args a) k fuel))))
           (none (named_shape t env (Const d g ls) g (get_app_args a) k fuel)))))
        ((FVar _ id)
         (match (er_index env id 0)
           ((some (Prod.mk (EKShape sh _) _))
            (Prod.mk t
              (SsErr (quote function_value)
                (append "a static parameter (at "
                  (append (show_name (shape_id sh))
                    ") applied as a static argument: a static parameter is passed on, never transformed")))))
           (_ (Prod.mk t (SsErr (quote function_value) (static_pointer))))))
        ((Proj _ sn i x) (package_field_shape t env sn i x (get_app_args a) k fuel))
        ((Lam _ _ _ _ _)  ; a lambda applied (a package's lambda field at its captured values): reduced, then read as any static argument
         (match (beta_head (w_st (Tr.w t)) (get_app_fn a) (get_app_args a))
           ((Prod.mk st r) (static_shape (tr_set_w t (w_set_st (Tr.w t) st)) env r k (- fuel 1)))))
        (_ (Prod.mk t (SsErr (quote function_value) (static_pointer))))))))
;; (e) a package constant: a closed term whose value whnf reads as a package type's
;; constructor applied — the shape its identity with its arguments, nothing captured
(fn package_shape ((t Tr) (env (List ErEnt)) (head Expr) (g Name) (gargs (List Expr)))
  (Prod Tr SsRes)
  (if (has_fvar (mk_app_n head gargs))
    (Prod.mk t
      (SsErr (quote function_value)
        (append (show_name g)
          ": a package constant applied to a local of the caller — a package is closed")))
    (match (package_fields_of t (mk_app_n head gargs))
      ((Prod.mk t1 (PkFields _ _)) (Prod.mk t1 (SsOk (Shape head none 0 (somes_of gargs) nil) nil)))
      ((Prod.mk t1 (PkPlaceholder _)) (Prod.mk t1 (SsErr (quote no_realization) (show_name g))))
      ((Prod.mk t1 (PkErr _ _))
       (Prod.mk t1
         (SsErr (quote no_realization)
           (append (show_name g)
             ": a static argument of a package type names a package constant — a def whose value is the structure's constructor applied")))))))
(fn somes_of ((es (List Expr))) (List (Option Expr))
  (measure (struct es))
  (match es
    (nil nil)
    ((cons a r) (cons (some a) (somes_of r)))))
;; a package's function field as a static argument: at the constant, the field's term (a name, a
;; partial application or a lambda — lifted under the taking body's name) read as any static
;; argument; at the declaration's check, a placeholder of the field's arity
(fn package_field_shape
  ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (rest (List Expr)) (k Int) (fuel Int))
  (Prod Tr SsRes)
  (match (package_subject t env x)
    ((Prod.mk t1 (PkErr e m)) (Prod.mk t1 (SsErr e m)))
    ((Prod.mk t1 (PkFields pk fields))
     (match (nth fields i)
       ((some fi)
        ;; the arguments may mention the package parameter (its unit, say): the parameter replaced
        ;; by the constant, so a lambda lifted here is closed
        (match
          (match x
            ((FVar _ id) (tr_subst t1 (mk_app_n fi rest) id pk))
            (_ (Prod.mk t1 (mk_app_n fi rest))))
          ((Prod.mk t2 term) (static_shape t2 env term k fuel))))
       (none
         (Prod.mk t1
           (SsErr (quote no_realization)
             (append (show_name sn) ": a projection past the constructor's fields"))))))
    ((Prod.mk t1 (PkPlaceholder pn))
     (Prod.mk t1 (SsOk (Shape (mk_const (package_field_name pn i) nil) none k nil nil) nil)))))
(fn passed_shape ((t Tr) (env (List ErEnt)) (id Int) (k Int)) (Prod Tr SsRes)
  (match (er_index env id 0)
    ((some (Prod.mk (EKShape sh ids) _))
     (if (= (shape_arity sh) k) (Prod.mk t (SsOk sh (captured_bvars env ids)))
     (Prod.mk t
       (SsErr (quote function_value)
         (append "a static parameter (at "
           (append (show_name (shape_id sh))
             (append ") of arity "
               (append (show_nat (shape_arity sh))
                 (append " passed where the arity is " (show_nat k))))))))))
    ((some (Prod.mk (EKCall g _) _))
     (Prod.mk t
       (SsErr (quote no_l_meaning)
         (append (show_name g)
           ": a function with a program and no K constant, or the enclosing function itself, as a static argument — its instance would have no L reading"))))
    ((some (Prod.mk (EKTemplate g) _))
     (Prod.mk t
       (SsErr (quote function_value)
         (append (show_name g)
           ": a template as a static argument — an instance is taken where the template is called"))))
    (_ (Prod.mk t (SsErr (quote function_value) (static_pointer))))))
(fn named_shape
  ((t Tr) (env (List ErEnt)) (head Expr) (g Name) (gargs (List Expr)) (k Int) (fuel Int))
  (Prod Tr SsRes)
  (if (is_template (Tr.es t) g)
    (Prod.mk t
      (SsErr (quote function_value)
        (append (show_name g)
          ": a template as a static argument — an instance is taken where the template is called")))
    (match (shape_kind t g)
      (none
        (Prod.mk t
          (SsErr (quote no_realization)
            (append (show_name g)
              ": no program — a static argument names a fn with a program, a realized constant or an instance"))))
      ((some prim)
       (match (env_find (tr_env t) g)
         (none (Prod.mk t (SsErr (quote unknown_constant) (show_name g))))
         ((some info)
          (match (tr_tele t info)
            ((Prod.mk t1 none)
             (Prod.mk t1
               (SsErr (quote no_realization)
                 (append (show_name g) ": a static argument whose telescope K could not read"))))
            ((Prod.mk t1 (some (Tele _ binds _ _)))
             (shape_args t1 env head g binds gargs k fuel nil nil nil prim)))))))))
;; a static argument's identity has a program — a fn, a realized constant or an instance of the
;; E table (None: a call) — or is a constant of the realization registry (its primitive)
(fn shape_kind ((t Tr) (g Name)) (Option (Option Name))
  (match (es_find_decl (Tr.es t) g)
    ((some (EFn _ _ _ _ _ _)) (some none))
    (_
      (match (realization_of g)
        ((some p) (some (some p)))
        (none none)))))
(fn shape_args
  ((t Tr)
   (env (List ErEnt))
   (head Expr)
   (g Name)
   (binds (List TBind))
   (gargs (List Expr))
   (k Int)
   (fuel Int)
   (leading (List (Option Expr)))
   (ctys (List Expr))
   (cvals (List ETerm))
   (prim (Option Name)))
  (Prod Tr SsRes)
  (measure (struct binds))
  (match gargs
    (nil
      (if (trailing_data binds k)
        (Prod.mk t (SsOk (Shape head prim k (rev leading) (rev ctys)) (rev cvals)))
        (Prod.mk t
          (SsErr (quote function_value)
            (append (show_name g)
              (append " applied to "
                (append (show_nat (len leading))
                  (append " arguments does not leave "
                    (append (show_nat k) " runtime binders, the static parameter's arity")))))))))
    ((cons a ar)
     (match binds
       (nil (Prod.mk t (SsErr (quote function_value) (append (show_name g) " over-applied"))))
       ((cons (TBind _ role _) br)
        (match role
          (BType
            (if (has_fvar a)
              (Prod.mk t
                (SsErr (quote function_value)
                  (append (show_name g)
                    ": a type argument of a static argument mentions a local of the caller — it must be closed")))
              (shape_args t env head g br ar k fuel (cons (some a) leading) ctys cvals prim)))
          (BErased
            (if (has_fvar a)
              (Prod.mk t
                (SsErr (quote function_value)
                  (append (show_name g)
                    ": an erased argument of a static argument mentions a local of the caller — it must be closed")))
              (shape_args t env head g br ar k fuel (cons (some a) leading) ctys cvals prim)))
          ((BData _)
           (match (tr_infer t a)
             ((Prod.mk t1 none)
              (Prod.mk t1
                (SsErr (quote function_value)
                  (append (show_name g) ": a captured value K could not type"))))
             ((Prod.mk t1 (some ty))
              (if (has_fvar ty)
                (Prod.mk t1
                  (SsErr (quote function_value)
                    (append (show_name g)
                      ": a captured value whose type mentions a local of the caller — its type must be closed")))
                (match (erase t1 env a (- fuel 1))
                  ((ErErr e m) (Prod.mk t1 (SsErr e m)))
                  ((ErOk t2 a1)
                   (shape_args t2 env head g br ar k fuel (cons none leading) (cons ty ctys)
                     (cons a1 cvals)
                     prim)))))))
          ((BStatic _)
           (Prod.mk t
             (SsErr (quote function_value)
               (append (show_name g)
                 ": a template as a static argument — an instance is taken where the template is called"))))))))))
(fn trailing_data ((binds (List TBind)) (k Int)) Bool
  (measure (struct binds))
  (match binds
    (nil (= k 0))
    ((cons (TBind _ (BData _) _) r) (trailing_data r (- k 1)))
    (_ false)))
;; a closed lambda lifted to CALLER.lam_N: the caller's runtime locals it mentions
;; are captured, in order of first occurrence, as its leading parameters; its own binders
;; follow (opened at the static parameter's arity — eta past the lambdas written); its body
;; erased over them; its L definition the same lambda over the captured locals. A lambda over
;; a type parameter, a proof, a function with no K constant or a static parameter is refused
(fn lift_lambda ((t Tr) (env (List ErEnt)) (lam Expr) (k Int) (fuel Int)) (Prod Tr SsRes)
  (match (captured_of env (fvars_of lam) nil)
    ((Left6 e m) (Prod.mk t (SsErr e m)))
    ((Right6 captured)
     (let ((n (+ (Tr.lams t) 1)))
       (let ((name (name_append (Tr.id t) (n1 (sym_of_chars (append "lam_" (show_nat n)))))))
         (match (open_lams (with Tr t (lams n)) lam k nil)
           ((Prod.mk t1 none)
            (Prod.mk t1
              (SsErr (quote function_value)
                "a lambda K could not open at the static parameter's arity")))
           ((Prod.mk t1 (some (Prod.mk bfvs body)))
            (match (local_etypes t1 (append captured bfvs) nil)
              ((Prod.mk t2 none)
               (Prod.mk t2
                 (SsErr (quote function_value)
                   "a lambda whose binder or captured local has no closed E type — over a type parameter, a proof or a dependent type")))
              ((Prod.mk t2 (some ptys))
               (match (tr_infer t2 body)
                 ((Prod.mk t3 none)
                  (Prod.mk t3 (SsErr (quote function_value) "a lambda whose body K could not type")))
                 ((Prod.mk t3 (some bty))
                  (match (l_to_etype (Tr.w t3) (Tr.es t3) (Tr.sc t3) bty nil nil)
                    ((Prod.mk (Prod.mk w4 es4) none)
                     (Prod.mk (tr_set_es (tr_set_w t3 w4) es4)
                       (SsErr (quote function_value)
                         "a lambda whose result is no E type (a function returned is no value)")))
                    ((Prod.mk (Prod.mk w4 es4) (some rty))
                     (match
                       (erase (tr_set_es (tr_set_w t3 w4) es4) (lifted_env env captured bfvs) body
                         (- fuel 1))
                       ((ErErr e m) (Prod.mk t3 (SsErr e m)))
                       ((ErOk t5 ebody)
                        (match (tr_lams t5 (append captured bfvs) body)
                          ((Prod.mk t6 value)
                           (match (tr_pis t6 (append captured bfvs) bty)
                             ((Prod.mk t7 ty)
                              (if (has_fvar ty)
                                (Prod.mk t7
                                  (SsErr (quote function_value)
                                    "a lambda whose type mentions a local of the caller — its type must be closed"))
                                (match (local_ltypes t7 captured nil)
                                  ((Prod.mk t8 ctys)
                                   (Prod.mk
                                     (tr_lift t8
                                       (Lifted name (EFn name 0 ptys rty RecNone ebody)
                                         (DefnDecl (ConstantVal name nil ty) value
                                           (HRegular (def_height (tr_env t8) value))
                                           Safe
                                           (list name))))
                                     (SsOk
                                       (Shape (mk_const name nil) none k (nones_of (len captured))
                                         ctys)
                                       (captured_bvars env (pd_fvar_ids captured))))))))))))))))))))))))))
(type Either6 (Left6 Symbol (List Int)) (Right6 (List Expr)))
(fn captured_of ((env (List ErEnt)) (fvs (List Expr)) (acc (List Expr))) Either6
  (measure (struct fvs))
  (match fvs
    (nil (Right6 (rev acc)))
    ((cons fv r)
     (match (er_index env (fvar_id_of fv) 0)
       ((some (Prod.mk EKVar _)) (captured_of env r (cons fv acc)))
       ((some (Prod.mk EKStatic _))
        (Left6 (quote function_value)
          "a lambda over a type parameter of the caller — a polymorphic lambda is not supported"))
       ((some (Prod.mk EKErased _))
        (Left6 (quote function_value)
          "a lambda mentioning a proof or a type of the caller is not supported"))
       ((some (Prod.mk EKIH _))
        (Left6 (quote recursion_structure) "a lambda over an induction hypothesis"))
       ((some (Prod.mk (EKCall g _) _))
        (Left6 (quote function_value)
          (append (show_name g)
            ": a lambda calling a function with a program and no K constant, or its enclosing function — the lifted fn would have no L definition")))
       ((some (Prod.mk (EKShape sh _) _))
        (Left6 (quote function_value)
          (append "a lambda over a static parameter (at "
            (append (show_name (shape_id sh))
              "): a static parameter is passed on, never transformed"))))
       ((some (Prod.mk (EKTemplate g) _))
        (Left6 (quote function_value)
          (append (show_name g) ": a lambda calling the template it stands in")))
       (none (Left6 (quote erased_in_runtime) "a variable the erasure does not know"))))))
;; the free locals of a term, first occurrence first
(fn fvars_of ((e Expr)) (List Expr) (rev (fvars_acc e nil)))
(fn fvars_acc ((e Expr) (acc (List Expr))) (List Expr)
  (measure (struct e))
  (if (bool_not (has_fvar e)) acc
  (match e
    ((FVar _ id) (if (mem_int id (pd_fvar_ids acc)) acc (cons e acc)))
    ((App _ f a) (fvars_acc a (fvars_acc f acc)))
    ((Lam _ _ _ d b) (fvars_acc b (fvars_acc d acc)))
    ((Pi _ _ _ d b) (fvars_acc b (fvars_acc d acc)))
    ((Let _ _ ty v b) (fvars_acc b (fvars_acc v (fvars_acc ty acc))))
    ((Proj _ _ _ x) (fvars_acc x acc))
    (_ acc))))
(fn open_lams ((t Tr) (e Expr) (k Int) (acc (List Expr))) (Prod Tr (Option (Prod (List Expr) Expr)))
  (measure k)
  (if (< k 1) (Prod.mk t (some (Prod.mk (rev acc) e)))
  (match (open_lam t e)
    ((Prod.mk t1 none) (Prod.mk t1 none))
    ((Prod.mk t1 (some (Prod.mk fv body))) (open_lams t1 body (- k 1) (cons fv acc))))))
;; the locals' E types, each from a closed L type
(fn local_etypes ((t Tr) (fvs (List Expr)) (acc (List EType))) (Prod Tr (Option (List EType)))
  (measure (struct fvs))
  (match fvs
    (nil (Prod.mk t (some (rev acc))))
    ((cons fv r)
     (match (tr_type_of_local t fv)
       (none (Prod.mk t none))
       ((some ty)
        (if (has_fvar ty) (Prod.mk t none)
        (match (l_to_etype (Tr.w t) (Tr.es t) (Tr.sc t) ty nil nil)
          ((Prod.mk (Prod.mk w1 es1) none) (Prod.mk (tr_set_es (tr_set_w t w1) es1) none))
          ((Prod.mk (Prod.mk w1 es1) (some ety))
           (local_etypes (tr_set_es (tr_set_w t w1) es1) r (cons ety acc))))))))))
(fn local_ltypes ((t Tr) (fvs (List Expr)) (acc (List Expr))) (Prod Tr (List Expr))
  (measure (struct fvs))
  (match fvs
    (nil (Prod.mk t (rev acc)))
    ((cons fv r)
     (local_ltypes t r
       (cons
         (match (tr_type_of_local t fv)
           ((some ty) ty)
           (none (mk_sort LZero)))
         acc)))))
(fn nones_of ((k Int)) (List (Option Expr))
  (measure k)
  (if (< k 1) nil (cons none (nones_of (- k 1)))))
;; the lifted body's variables: its binders innermost, the captured locals after them, and the
;; caller's entries that are no runtime variable (a mentioned one was refused; the rest are unread)
(fn lifted_env ((env (List ErEnt)) (captured (List Expr)) (bfvs (List Expr))) (List ErEnt)
  (append (rev (var_ents bfvs)) (append (rev (var_ents captured)) (non_var_ents env))))
(fn var_ents ((fvs (List Expr))) (List ErEnt)
  (measure (struct fvs))
  (match fvs
    (nil nil)
    ((cons fv r) (cons (ErEnt (fvar_id_of fv) EKVar) (var_ents r)))))
(fn non_var_ents ((env (List ErEnt))) (List ErEnt)
  (measure (struct env))
  (match env
    (nil nil)
    ((cons (ErEnt _ EKVar) r) (non_var_ents r))
    ((cons x r) (cons x (non_var_ents r)))))
;; the instance's name: MODULE.TEMPLATE_flat[_TYPE…].of.SHAPE… — the taking module's, the
;; template flattened with its type arguments, `of`, then each shape as its identity flattened
;; and its captured count — etable.shard's instance_name_of, the formula both routes share
(fn instance_name ((sc Scope) (c Name) (tye (List EType)) (shapes (List Shape))) Name
  (instance_name_of sc c tye (shape_keys shapes)))
(fn shape_keys ((ss (List Shape))) (List (Prod Name Int))
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s r) (cons (Prod.mk (shape_id s) (len (shape_captured s))) (shape_keys r)))))
(fn shape_record ((s Shape)) (List Int)
  (append (show_name (shape_id s)) (cons 47 (show_nat (len (shape_captured s))))))
