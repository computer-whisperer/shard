;;; v3/kernel/erasure.shard — the E projection (v3/LANGUAGE.md §7.1, §7.5; §8.4 slice
;;; 3.16 "the shape", rules 3 and 4; law §4.4). An L term erased to an E term by the roles of
;;; erase.shard: types, proofs and erased binders dropped; a constructor and a call at their
;;; runtime arguments; `casesOn` and a recursor without its hypotheses as a match, a
;;; two-constructor case analysis that ignores its fields as the `if` it was written as;
;;; `ite`/`dite` as an if on the decision; a matcher application as the match of the rows read
;;; back off its type (matcher.shard); `Decidable.decide` as the explicit conversion; a
;;; resolved operation as its entry of the realization registry; a row of the registry's
;;; types (erase.shard's rep_row) as its one runtime field — the constructor its argument,
;;; the projection its subject —, a projection function as its projection, a string literal
;;; as its bytes (slice 3.18). Two callers: a constant's
;;; derived view (realize.shard) and a pre-definition (predef.shard), whose erasure **is** the
;;; function's program — the self-local and a callee-local a call. A template's call (§8.4
;;; slice 3.28: a fn with a function-typed binder) is a call of its instance at the static
;;; arguments' shapes — a lambda lifted to a generated fn on the way —, the instance demanded
;;; of the loader, which builds it (template.shard). The walk's state `Tr` and
;;; its K procedures are here, under the three files that build terms over it (this one,
;;; realize.shard, define.shard). Untrusted: the erasure rule's implementation is a stated
;;; bring-up trust dependency (§7.1, GPT-6 R58) until route 1's proof covers it.
(import "predef.shard")
(import "erase.shard")
(import "prog.shard")
(use kernel.k)
(use kernel.decl)
(use kernel.erase)
(use kernel.kw)
(use kernel.elab El el_w el0 el_set_w el_set_cx el_cx el_aux elab el_finish)
(use kernel.etable)
(use kernel.expr)
(use kernel.level)
(use kernel.matcher)
(use kernel.name)
(use kernel.predef)
(use kernel.prelude)
(use kernel.prog)
(use kernel.scope)
(use kernel.util)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.decl.Declaration)
(use kernel.decl.DefinitionSafety)
(use kernel.decl.ReducibilityHints)
(use kernel.erase.BRole)
(use kernel.erase.TBind)
(use kernel.erase.Tele)
(use kernel.erase.TeleRes)
(use kernel.kw.W)
(use kernel.etable.EInfo)
(use kernel.etable.ESt)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.level.Level)
(use kernel.matcher.MtDesc)
(use kernel.matcher.MtPat)
(use kernel.predef.CalleeLocal)
(use kernel.predef.PdRec)
(use kernel.name.Name)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)
(use kernel.prog.EArm)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.scope.Scope)

;; ---- templates and instances (§8.4 slice 3.28 rule 3) --------------------------------------
;; the shape of a static argument: the identity it names as the L term it is (a fn with a
;; program, a realized constant, an instance, a lifted lambda; a constant of the realization
;; registry), the primitive the registry realizes it to (None for a program), its arity, its
;; leading arguments — Some a type or erased argument kept in the L term (closed), None a
;; captured runtime value — and the captured values' L types (closed). The captured count is
;; their number; the values themselves are never part of a shape (law §4.3)
(type Shape (Shape Expr (Option Name) Int (List (Option Expr)) (List Expr)))
(fn shape_head ((s Shape)) Expr (match s ((Shape h _ _ _ _) h)))
(fn shape_id ((s Shape)) Name (match (shape_head s) ((Const _ n _) n) (_ Anon)))
(fn shape_prim ((s Shape)) (Option Name) (match s ((Shape _ p _ _ _) p)))
(fn shape_arity ((s Shape)) Int (match s ((Shape _ _ k _ _) k)))
(fn shape_leading ((s Shape)) (List (Option Expr)) (match s ((Shape _ _ _ ls _) ls)))
(fn shape_captured ((s Shape)) (List Expr) (match s ((Shape _ _ _ _ cs) cs)))
;; an instance a body demands: its name, the template, the template's type arguments as the
;; closed L types they are and as E types, the shapes of its static arguments in order
(type Demand (Demand Name Name (List Expr) (List EType) (List Shape)))
(fn demand_name ((d Demand)) Name (match d ((Demand n _ _ _ _) n)))
(fn demand_template ((d Demand)) Name (match d ((Demand _ c _ _ _) c)))
(fn demand_shapes ((d Demand)) (List Shape) (match d ((Demand _ _ _ _ ss) ss)))
;; a lambda lifted to a generated fn under the caller's name: its program and its L definition
(type Lifted (Lifted Name EDecl Declaration))

;; ---- the walk's state -------------------------------------------------------------------
;; the walk (environment, locals, checker state), the E table, the scope, the realized or
;; defined constant's identity and its type parameters' locals (an ETVar of the body is one of
;; them); for a definition (define.shard) the value once built and the descent obligations
;; collected on the way, newest first
;; (§8.4 slice 3.28) the lambdas lifted so far (a counter for their names), the generated fns
;; and the instances the body demands, in order; `owner` when the body is a template's — at
;; an instance, or at the check of its declaration: the template and the instance's name (a
;; self-call at other shapes is refused), with the template's binders (its self-call's roles,
;; before its constant is in the walk's environment)
(record Tr (w W) (es ESt) (sc Scope) (id Name) (tps (List Expr)) (value (Option Expr)) (obls (List Declaration))
           (lams Int) (lifted (List Lifted)) (demands (List Demand)) (owner (Option (Pair Name Name))) (obinds (List TBind)))
(fn tr_new ((w W) (es ESt) (sc Scope) (id Name) (tps (List Expr))) Tr
  (make Tr (w w) (es es) (sc sc) (id id) (tps tps) (value None) (obls Nil) (lams 0) (lifted Nil) (demands Nil) (owner None) (obinds Nil)))
(fn tr_own ((t Tr) (c Name) (inst Name) (binds (List TBind))) Tr (with Tr t (owner (Some (Pair c inst))) (obinds binds)))
;; the template's own binders where the call is the owner's self-call
(fn owner_binds ((t Tr) (c Name)) (Option (List TBind))
  (match (Tr.owner t)
    ((Some (Pair oc _)) (if (name_eq oc c) (Some (Tr.obinds t)) None))
    (None None)))
(fn owner_is ((t Tr) (c Name)) Bool (match (Tr.owner t) ((Some (Pair oc _)) (name_eq oc c)) (None False)))
(fn in_template ((t Tr)) Bool (match (Tr.owner t) ((Some _) True) (None False)))
;; the owner's self-call at one of its own type parameters (rule 4: a template calls itself at its
;; own types; at a type built from them — f at (List a) — the shape set would grow)
(fn own_tparam ((t Tr) (a Expr)) Bool
  (match a ((FVar _ id) (match (fvar_index id (Tr.tps t) 0) ((Some _) True) (None False))) (_ False)))
(fn tr_lift ((t Tr) (x Lifted)) Tr (with Tr t (lifted (append (Tr.lifted t) (list x)))))
(fn tr_demand ((t Tr) (d Demand)) Tr
  (if (has_demand (Tr.demands t) (demand_name d)) t (with Tr t (demands (append (Tr.demands t) (list d))))))
(fn has_demand ((ds (List Demand)) (n Name)) Bool
  (measure (struct ds))
  (match ds (Nil False) ((Cons d r) (if (name_eq (demand_name d) n) True (has_demand r n)))))
(fn tr_set_w ((t Tr) (w W)) Tr (with Tr t (w w)))
(fn tr_set_es ((t Tr) (es ESt)) Tr (with Tr t (es es)))
(fn tr_set_value ((t Tr) (v Expr)) Tr (with Tr t (value (Some v))))
(fn tr_add_obl ((t Tr) (d Declaration)) Tr (with Tr t (obls (Cons d (Tr.obls t)))))
(fn tr_obls ((t Tr)) (List Declaration) (rev (Tr.obls t)))
(fn tr_env ((t Tr)) CheckedEnv (w_env (Tr.w t)))
(type TrRes (TrOk Tr Expr) (TrErr Symbol (List Int)))

;; ---- K's procedures over the state ----------------------------------------------------------
;; K through the state
(fn tr_infer ((t Tr) (e Expr)) (Pair Tr (Option Expr))
  (match (w_infer (Tr.w t) e) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_whnf ((t Tr) (e Expr)) (Pair Tr (Option Expr))
  (match (w_whnf (Tr.w t) e) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_local ((t Tr) (n Name) (ty Expr)) (Pair Tr Expr)
  (match (w_local (Tr.w t) n ty) ((Pair w1 fv) (Pair (tr_set_w t w1) fv))))
(fn tr_local_bi ((t Tr) (n Name) (ty Expr) (bi BinderInfo)) (Pair Tr Expr)
  (match (w_local_bi (Tr.w t) n ty bi) ((Pair w1 fv) (Pair (tr_set_w t w1) fv))))
(fn tr_local_val ((t Tr) (n Name) (ty Expr) (v Expr)) (Pair Tr Expr)
  (match (w_local_val (Tr.w t) n ty v) ((Pair w1 fv) (Pair (tr_set_w t w1) fv))))
(fn tr_inst1 ((t Tr) (e Expr) (v Expr)) (Pair Tr Expr)
  (match (w_inst1 (Tr.w t) e v) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_apps ((t Tr) (f Expr) (args (List Expr))) (Pair Tr Expr)
  (match (w_apps (Tr.w t) f args) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_lams ((t Tr) (fvs (List Expr)) (b Expr)) (Pair Tr Expr)
  (match (w_lams (Tr.w t) fvs b) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_pis ((t Tr) (fvs (List Expr)) (b Expr)) (Pair Tr Expr)
  (match (w_pis (Tr.w t) fvs b) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_subst ((t Tr) (e Expr) (id Int) (v Expr)) (Pair Tr Expr)
  (match (w_subst (Tr.w t) e id v) ((Pair w1 r) (Pair (tr_set_w t w1) r))))
(fn tr_type_of_local ((t Tr) (fv Expr)) (Option Expr)
  (match fv
    ((FVar _ id) (match (lctx_find (w_lctx (Tr.w t)) id) ((Some d) (Some (ldecl_type d))) (None None)))
    (_ None)))
;; the telescope of a constant, its binders opened in the state
(fn tr_tele ((t Tr) (info ConstantInfo)) (Pair Tr (Option Tele))
  (match (tele_of (Tr.w t) (Tr.es t) (Tr.sc t) info)
    ((TeleErr _ _) (Pair t None))
    ((TeleOk w1 es1 tele) (Pair (with Tr t (w w1) (es es1)) (Some tele)))))
(fn tr_tele_fields ((t Tr) (info ConstantInfo) (k Int)) (Pair Tr (Option Tele))
  (match (tele_of_fields (Tr.w t) (Tr.es t) (Tr.sc t) info k)
    ((TeleErr _ _) (Pair t None))
    ((TeleOk w1 es1 tele) (Pair (with Tr t (w w1) (es es1)) (Some tele)))))
(fn level_one () Level (LSucc LZero))
;; the result type against the expected type binds type parameters too
;; let: sequential, each value's type inferred
;; if: the condition's two-constructor inductive's recursor with a constant motive
;; a match not on a variable: the recursor over flat constructor patterns, a variable arm expanded
;; the scrutinee's inductive, levels and parameters from its inferred type
(fn ind_ctor_names ((t Tr) (ind Name)) (List Name)
  (match (es_info (Tr.es t) ind) ((Some (EIInd _ cs)) cs) (_ Nil)))

;; ---- a constructor opened at its fields ------------------------------------------------------
;; a constructor opened at the scrutinee's type: its fields as locals — each with its runtime
;; E type, or None for an erased one — and the constructor term
(type Field (Field Expr (Option EType) Bool))   ; the local, its E type (None = erased), recursive?
(fn field_fvars ((fs (List Field))) (List Expr)
  (measure (struct fs))
  (match fs (Nil Nil) ((Cons (Field fv _ _) r) (Cons fv (field_fvars r)))))
(fn rz_open_ctor ((t Tr) (c Name) (ls (List Level)) (largs (List Expr))) (Pair Tr (Option (Pair (List Field) Expr)))
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (w_inst_lparams (Tr.w t) (ci_type info) (ci_lparams info) ls)
          ((Pair w1 cty)
           (match (inst_params w1 cty largs)
             ((Pair w2 None) (Pair (tr_set_w t w2) None))
             ((Pair w2 (Some fty))
              (match (open_fields (tr_set_w t w2) ind fty Nil (budget_depth))
                ((Pair t1 None) (Pair t1 None))
                ((Pair t1 (Some fields))
                 (match (tr_apps t1 (mk_const c ls) (append largs (field_fvars fields)))
                   ((Pair t2 cterm) (Pair t2 (Some (Pair fields cterm))))))))))))
       (_ (Pair t None))))   ; not a constructor: the wildcard arm belongs to `info`'s match (it sat one level too deep until the parity test classified the driver's closure, slice 6)
    (None (Pair t None))))
(fn open_fields ((t Tr) (ind Name) (ty Expr) (acc (List Field)) (fuel Int)) (Pair Tr (Option (List Field)))
  (measure fuel)
  (if (lt fuel 0) (Pair t None)
  (match (tr_whnf t ty)
    ((Pair t1 (Some (Pi _ n _ dom body)))
     (match (w_is_prop (Tr.w t1) dom)
       ((Pair w2 (Some True))
        (match (w_local w2 n dom)
          ((Pair w3 fv) (match (w_inst1 w3 body fv) ((Pair w4 body1) (open_fields (tr_set_w t1 w4) ind body1 (Cons (Field fv None False) acc) (- fuel 1)))))))
       ((Pair w2 _)
        (match (l_to_etype w2 (Tr.es t1) (Tr.sc t1) dom (Tr.tps t1) Nil)
          ((Pair (Pair w3 es3) fety)
           (match (w_local w3 n dom)
             ((Pair w4 fv)
              (match (w_inst1 w4 body fv)
                ((Pair w5 body1) (open_fields (tr_set_es (tr_set_w t1 w5) es3) ind body1 (Cons (Field fv fety (is_head_const dom ind)) acc) (- fuel 1)))))))))))
    ((Pair t1 (Some _)) (Pair t1 (Some (rev acc))))
    ((Pair t1 None) (Pair t1 None)))))
(fn is_head_const ((e Expr) (n Name)) Bool (match (get_app_fn e) ((Const _ c _) (name_eq c n)) (_ False)))
;; the arm's variables: a constructor pattern binds the runtime fields in order, a variable arm
;; binds the constructor term; an if's branches bind nothing
;; the minors' shared result type: the expected E type's L form, else the first body's inferred type,
;; which must not mention the fields
(fn mentions_any ((e Expr) (ids (List Int))) Bool
  (measure (struct e))
  (if (bool_not (has_fvar e)) False
  (match e
    ((FVar _ id) (mem_int id ids))
    ((App _ f a) (bool_or (mentions_any f ids) (mentions_any a ids)))
    ((Lam _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Pi _ _ _ d b) (bool_or (mentions_any d ids) (mentions_any b ids)))
    ((Let _ _ ty v b) (bool_or (mentions_any ty ids) (bool_or (mentions_any v ids) (mentions_any b ids))))
    ((Proj _ _ _ x) (mentions_any x ids))
    (_ False))))
(fn count_types ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds (Nil 0) ((Cons (TBind _ BType _) r) (+ 1 (count_types r))) ((Cons _ r) (count_types r))))
(fn tbind_types ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ BType fv) r) (Cons fv (tbind_types r))) ((Cons _ r) (tbind_types r))))
;; the equations: the leaves of the case tree over the data binders, each a theorem
(fn count_data ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds (Nil 0) ((Cons (TBind _ (BData _) _) r) (+ 1 (count_data r))) ((Cons _ r) (count_data r))))
(fn tbind_fvars ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ _ fv) r) (Cons fv (tbind_fvars r)))))
;; an alternative at its variables: each lambda's body instantiated, else applied
(fn pj_inst_lams ((t Tr) (e Expr) (vars (List Expr))) (Pair Tr Expr)
  (measure (struct vars))
  (match vars
    (Nil (Pair t e))
    ((Cons v r)
     (match e
       ((Lam _ _ _ _ b) (match (tr_inst1 t b v) ((Pair t1 b1) (pj_inst_lams t1 b1 r))))
       (_ (match (tr_apps t e (list v)) ((Pair t1 e1) (pj_inst_lams t1 e1 r))))))))

;; ---- the erasure (§7.1, §7.5) ---------------------------------------------------------------
;; the body's variables in the erasure: a local is a runtime variable (its E index counted among
;; those), a static or erased one, or an induction hypothesis
;; (slice 3.16) or a function standing for a call — the pre-definition's self-local, its
;; identity and its binders' runtime flags
;; (§8.4 slice 3.28) EKShape: a static parameter at an instance — its shape, and the captured
;; slots' entries (EKVar each, under ids no local has: the instance's leading parameters);
;; EKTemplate: a template's own name — the self-local at an instance, a call of the template
(type EKind (EKVar) (EKStatic) (EKErased) (EKIH) (EKCall Name (List Bool)) (EKShape Shape (List Int)) (EKTemplate Name))
(type ErEnt (ErEnt Int EKind))
(fn er_index ((env (List ErEnt)) (id Int) (k Int)) (Option (Pair EKind Int))
  (measure (struct env))
  (match env
    (Nil None)
    ((Cons (ErEnt j kind) r)
     (if (int_eq id j) (Some (Pair kind k))
       (er_index r id (match kind (EKVar (+ k 1)) (_ k)))))))
(type ErRes (ErOk Tr ETerm) (ErErr Symbol (List Int)))
(fn bind_ptypes ((binds (List TBind))) (List EType)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ (BData ety) _) r) (Cons ety (bind_ptypes r))) ((Cons _ r) (bind_ptypes r))))
;; the binders' entries, innermost first
(fn binder_ents ((binds (List TBind))) (List ErEnt) (rev (binder_ents_fwd binds)))
(fn binder_ents_fwd ((binds (List TBind))) (List ErEnt)
  (measure (struct binds))
  (match binds
    (Nil Nil)
    ((Cons (TBind _ role fv) r) (Cons (ErEnt (fvar_id_of fv) (match role (BType EKStatic) (BErased EKErased) ((BData _) EKVar) ((BStatic _) EKErased))) (binder_ents_fwd r)))))   ; a static binder is bound by template.shard (a fn's or a realize's template), never here: erased, so a use is loud
;; the erasure of an L term in a runtime position (§7.5)
(fn erase ((t Tr) (env (List ErEnt)) (e Expr) (fuel Int)) ErRes
  (measure fuel)
  (if (lt fuel 0) (ErErr (quote erased_in_runtime) "the body is too deep")
  (match e
    ((FVar _ id)
     (match (er_index env id 0)
       ((Some (Pair EKVar i)) (ErOk t (EBVar i)))
       ((Some (Pair EKIH _)) (ErErr (quote recursion_structure) "a recursive definition's executable structure is not readable off the recursor: supply the body (§7.1, §7.3)"))
       ((Some (Pair (EKCall c roles) _)) (match roles (Nil (ErOk t (ECall c Nil))) (_ (ErErr (quote function_value) (append (show_name c) " unapplied (law §4.3)")))))
       ((Some (Pair (EKShape sh _) _)) (ErErr (quote function_value) (append "a static parameter (at " (append (show_name (shape_id sh)) ") unapplied: it is called at its arity, or passed on as a static argument (§8.4 slice 3.28 rule 2; law §4.3)"))))
       ((Some (Pair (EKTemplate c) _)) (ErErr (quote function_value) (append (show_name c) " unapplied: a template is called at its full arity (§8.4 slice 3.28 rule 2; law §4.3)")))
       ((Some (Pair _ _)) (ErErr (quote erased_in_runtime) "a type or a proof in a runtime position (law §4.2)"))
       (None (ErErr (quote erased_in_runtime) "a variable the erasure does not know"))))
    ((Lit _ (LitNat n)) (ErOk t (ELit (LNat n))))
    ((Lit _ (LitStr bs))   ; String's representation is its bytes (rule 1 of slice 3.18): Init's List cells, built once at link
     (if (utf8_ok bs) (ErOk t (ELit (LStr (nm_list_nil) (nm_list_cons) bs)))
       (ErErr (quote bad_string) "a string literal's bytes are not UTF-8: K reads the literal by decoding it (§8.4 slice 3.18 rule 3)")))
    ((Let _ n ty v b) (erase_let t env n ty v b fuel))
    ((Lam _ _ _ _ _) (ErErr (quote function_value) "a lambda in a runtime position: a lambda is a static argument of a template, lifted to a fn — never a value, a field, a let or a result (§8.4 slice 3.28 rule 2; law §4.3)"))
    ((Pi _ _ _ _ _) (ErErr (quote erased_in_runtime) "a type in a runtime position"))
    ((Sort _ _) (ErErr (quote erased_in_runtime) "a sort in a runtime position"))
    ((BVar _ _) (ErErr (quote erased_in_runtime) "a loose variable"))
    ((Proj _ sn i x) (erase_proj t env sn i x fuel))
    (_ (erase_app t env (get_app_fn e) (get_app_args e) fuel)))))
(fn erase_all ((t Tr) (env (List ErEnt)) (es (List Expr)) (fuel Int) (acc (List ETerm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List ETerm)))
  (measure (struct es))
  (match es
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons e r)
     (match (erase t env e fuel)
       ((ErErr x m) (Pair (Some (Pair x m)) (Pair t Nil)))
       ((ErOk t1 e1) (erase_all t1 env r fuel (Cons e1 acc)))))))
;; a let: a proposition or a type vanishes (its variable erased), a value is an E let
(fn erase_let ((t Tr) (env (List ErEnt)) (n Name) (ty Expr) (v Expr) (b Expr) (fuel Int)) ErRes
  (match (w_is_prop (Tr.w t) ty)
    ((Pair w1 (Some True))
     (match (tr_local_val (tr_set_w t w1) n ty v)
       ((Pair t1 fv) (match (tr_inst1 t1 b fv) ((Pair t2 b1) (erase t2 (Cons (ErEnt (fvar_id_of fv) EKErased) env) b1 (- fuel 1)))))))
    ((Pair w1 _)
     (match (tr_whnf (tr_set_w t w1) ty)
       ((Pair t1 (Some (Sort _ _)))
        (match (tr_local_val t1 n ty v)
          ((Pair t2 fv) (match (tr_inst1 t2 b fv) ((Pair t3 b1) (erase t3 (Cons (ErEnt (fvar_id_of fv) EKStatic) env) b1 (- fuel 1)))))))
       ((Pair t1 _)
        (match (erase t1 env v (- fuel 1))
          ((ErErr e m) (ErErr e m))
          ((ErOk t2 v1)
           (match (tr_local_val t2 n ty v)
             ((Pair t3 fv)
              (match (tr_inst1 t3 b fv)
                ((Pair t4 b1)
                 (match (erase t4 (Cons (ErEnt (fvar_id_of fv) EKVar) env) b1 (- fuel 1))
                   ((ErErr e m) (ErErr e m))
                   ((ErOk t5 b2) (ErOk t5 (ELet (list v1) b2)))))))))))))))
;; a projection: a match on the structure's constructor, the field's variable; of a row of the
;; registry's types, the subject itself
(fn erase_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (fuel Int)) ErRes
  (match (tr_package t sn)
    ((Pair t0 (Some _)) (erase_package_proj t0 env sn i x Nil fuel))
    ((Pair t0 None) (erase_struct_proj t0 env sn i x fuel))))
(fn erase_struct_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (fuel Int)) ErRes
  (match (erase t env x (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 x1)
     (if (rep_row sn)
       (match (row_field t1 sn)
         ((Pair t2 None) (ErErr (quote no_realization) (append (show_name sn) ": the registry's row does not describe this structure (one constructor, one runtime field)")))
         ((Pair t2 (Some (Pair _ roles)))
          (match (runtime_index roles i 0 0)
            (None (ErErr (quote erased_in_runtime) (append (show_name sn) ": a projection of an erased field")))
            ((Some _) (ErOk t2 x1)))))
     (match (ind_eligible (Tr.w t1) (Tr.es t1) (Tr.sc t1) sn Nil)
       ((Pair (Pair w2 es2) False) (ErErr (quote no_realization) (append (show_name sn) " is not an E type")))
       ((Pair (Pair w2 es2) True)
        (let ((t2 (tr_set_es (tr_set_w t1 w2) es2)))
          (match (ind_ctor_names t2 sn)
            ((Cons c Nil)
             (match (field_roles t2 c)
               ((Pair t3 None) (ErErr (quote no_realization) (show_name c)))
               ((Pair t3 (Some roles))
                (match (runtime_index roles i 0 0)
                  (None (ErErr (quote erased_in_runtime) (append (show_name sn) ": a projection of an erased field")))
                  ((Some (Pair j nrt)) (ErOk t3 (EMatch x1 (list (EArm (PCtor c (pvars nrt)) (EBVar (- (- nrt 1) j)))))))))))
            (_ (ErErr (quote no_realization) (append (show_name sn) " is not a structure")))))))))))
;; a row's constructor and its fields' roles, when the structure is what the row says: one
;; constructor, exactly one runtime field (§8.4 slice 3.18 rule 1)
(fn row_field ((t Tr) (ind Name)) (Pair Tr (Option (Pair Name (List Bool))))
  (match (env_find (tr_env t) ind)
    ((Some (InductInfo _ _ _ _ (Cons c Nil) _ _ _ _))
     (match (field_roles t c)
       ((Pair t1 (Some roles)) (if (int_eq (count_true roles) 1) (Pair t1 (Some (Pair c roles))) (Pair t1 None)))
       ((Pair t1 None) (Pair t1 None))))
    (_ (Pair t None))))
;; a projection function — a constant whose value is λ params self. self.i —, applied at least
;; to its lambdas: the structure, the field, the subject and the arguments past it (rule 2; a
;; package's function field takes them, §8.4 slice 3.28 rule 5)
(fn proj_fn_app ((info ConstantInfo) (args (List Expr))) (Option (Pair (Pair Name Int) (Pair Expr (List Expr))))
  (match info
    ((DefnInfo _ v _ _ _)
     (let ((k (lam_depth v 0)))
       (if (lt (len args) k) None
       (match (under_lams v k)
         ((Some (Proj _ sn i (BVar _ 0))) (match (nth args (- k 1)) ((Some x) (Some (Pair (Pair sn i) (Pair x (drop k args))))) (None None)))
         (_ None)))))
    (_ None)))
(fn lam_depth ((e Expr) (k Int)) Int
  (measure (struct e))
  (match e ((Lam _ _ _ _ b) (lam_depth b (+ k 1))) (_ k)))
(fn under_lams ((e Expr) (k Int)) (Option Expr)
  (measure k)
  (if (lt k 1) (match e ((Lam _ _ _ _ _) None) (_ (Some e)))
    (match e ((Lam _ _ _ _ b) (under_lams b (- k 1))) (_ None))))
;; ---- a package (§8.4 slice 3.28 rule 5) ---------------------------------------------------------
;; a package type by erase.shard's reading, over the walk
(fn tr_package ((t Tr) (sn Name)) (Pair Tr (Option (Pair Name (List BRole))))
  (match (package_of (Tr.w t) (Tr.es t) (Tr.sc t) sn)
    ((Pair (Pair w1 es1) r) (Pair (tr_set_es (tr_set_w t w1) es1) r))))
;; the subject of a package's projection: a package parameter at its shape — the constant's
;; fields (its value read by whnf to the constructor applied), or a placeholder at the template's
;; declaration (the check erases it once with no constant behind it) — or a closed package term
(type PkRes (PkFields Expr (List Expr)) (PkPlaceholder Name) (PkErr Symbol (List Int)))   ; the package term and its fields
(fn package_subject ((t Tr) (env (List ErEnt)) (x Expr)) (Pair Tr PkRes)
  (match x
    ((FVar _ id)
     (match (er_index env id 0)
       ((Some (Pair (EKShape sh _) _))
        (if (bool_not (int_eq (shape_arity sh) 0)) (Pair t (PkErr (quote function_value) "a static parameter projected as a package"))
          (match (env_find (tr_env t) (shape_id sh))
            (None (Pair t (PkPlaceholder (shape_id sh))))
            ((Some _) (package_fields_of t (mk_app_n (shape_head sh) (fill_somes (shape_leading sh))))))))
       (_ (Pair t (PkErr (quote function_value) "a package in a runtime position: a package is a static parameter, its fields read at the instance (§8.4 slice 3.28 rule 5; law §4.1)")))))
    (_ (if (has_fvar x) (Pair t (PkErr (quote function_value) "a package built from locals of the caller: a package constant is closed (§8.4 slice 3.28 rule 5)"))
         (package_fields_of t x)))))
(fn fill_somes ((ls (List (Option Expr)))) (List Expr)
  (measure (struct ls))
  (match ls (Nil Nil) ((Cons (Some a) r) (Cons a (fill_somes r))) ((Cons None r) (fill_somes r))))
(fn package_fields_of ((t Tr) (x Expr)) (Pair Tr PkRes)
  (match (tr_whnf t x)
    ((Pair t1 None) (Pair t1 (PkErr (quote no_realization) "a package constant K could not reduce to its constructor")))
    ((Pair t1 (Some v))
     (match (get_app_fn v)
       ((Const _ mk _)
        (match (env_find (tr_env t1) mk)
          ((Some (CtorInfo _ _ _ nparams _ _)) (Pair t1 (PkFields x (drop nparams (get_app_args v)))))
          (_ (Pair t1 (PkErr (quote no_realization) "a package constant whose value is not its constructor applied (§8.4 slice 3.28 rule 5)")))))
       (_ (Pair t1 (PkErr (quote no_realization) "a package constant whose value is not its constructor applied (§8.4 slice 3.28 rule 5)")))))))
;; a package's field i applied to `args`: the field's term applied and erased — a function field
;; a call head (a name, a partial application, a lambda the erasure beta-reduces or lifts), a value
;; field its closed E term, a law field never in a runtime position. At the declaration's check
;; the placeholder's field by its role
(fn erase_package_proj ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (args (List Expr)) (fuel Int)) ErRes
  (match (package_subject t env x)
    ((Pair t1 (PkErr e m)) (ErErr e m))
    ((Pair t1 (PkFields _ fields))
     (match (nth fields i)
       ((Some fi) (erase t1 env (mk_app_n fi args) (- fuel 1)))
       (None (ErErr (quote no_realization) (append (show_name sn) ": a projection past the constructor's fields")))))
    ((Pair t1 (PkPlaceholder pn))
     (match (tr_package t1 sn)
       ((Pair t2 None) (ErErr (quote no_realization) (append (show_name sn) " is not a package type")))
       ((Pair t2 (Some (Pair _ roles)))
        (match (nth roles i)
          ((Some BErased) (ErErr (quote erased_in_runtime) (append (show_name sn) ": a package's law in a runtime position (§8.4 slice 3.28 rule 5; law §4.2)")))
          ((Some (BStatic k))
           (if (bool_not (int_eq (len args) k)) (ErErr (quote function_value) (append (show_name sn) (append ": a package's function field applied to " (append (show_nat (len args)) (append " arguments, its arity " (append (show_nat k) " (§8.4 slice 3.28 rule 2; law §4.3)"))))))
             (match (erase_all t2 env args fuel Nil)
               ((Pair (Some (Pair e m)) _) (ErErr e m))
               ((Pair None (Pair t3 as)) (ErOk t3 (ECall (package_field_name pn i) as))))))
          ((Some (BData _))
           (match args (Nil (ErOk t2 (ECall (package_field_name pn i) Nil))) (_ (ErErr (quote function_value) (append (show_name sn) ": a package's value field applied (law §4.3)")))))
          (_ (ErErr (quote no_realization) (append (show_name sn) ": a projection past the constructor's fields")))))))))
(fn package_field_name ((pn Name) (i Int)) Name (name_append pn (n1 (sym_of_chars (append "field_" (show_nat i))))))
;; the field roles of a constructor: True for a runtime field, False for an erased one
(fn field_roles ((t Tr) (c Name)) (Pair Tr (Option (List Bool)))
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ _ _ nparams _ _)
        (match (tr_tele_fields t info nparams)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some (Tele _ binds _ _))) (Pair t1 (Some (data_flags (drop nparams binds)))))))
       (_ (Pair t None))))
    (None (Pair t None))))
(fn data_flags ((binds (List TBind))) (List Bool)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ (BData _) _) r) (Cons True (data_flags r))) ((Cons _ r) (Cons False (data_flags r)))))
;; field i's index among the runtime fields, and their count
(fn runtime_index ((roles (List Bool)) (i Int) (k Int) (j Int)) (Option (Pair Int Int))
  (measure (struct roles))
  (match roles
    (Nil None)
    ((Cons rt r)
     (if (int_eq k i)
       (if rt (Some (Pair j (+ j (count_true roles)))) None)
       (runtime_index r i (+ k 1) (if rt (+ j 1) j))))))
(fn count_true ((bs (List Bool))) Int
  (measure (struct bs))
  (match bs (Nil 0) ((Cons True r) (+ 1 (count_true r))) ((Cons _ r) (count_true r))))
;; an application by its head
(fn erase_app ((t Tr) (env (List ErEnt)) (head Expr) (args (List Expr)) (fuel Int)) ErRes
  (match head
    ((Const _ c _) (erase_const t env c args fuel))
    ((FVar _ id)
     (match (er_index env id 0)
       ((Some (Pair EKVar i)) (erase_erased_args t env (EBVar i) args fuel))
       ((Some (Pair EKIH _)) (ErErr (quote recursion_structure) "a recursive definition's executable structure is not readable off the recursor: supply the body (§7.1, §7.3)"))
       ((Some (Pair (EKCall c roles) _))
        (if (bool_not (int_eq (len args) (len roles))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
          (match (erase_roles t env roles args fuel Nil)
            ((Pair (Some (Pair e m)) _) (ErErr e m))
            ((Pair None (Pair t1 as)) (ErOk t1 (ECall c as))))))
       ((Some (Pair (EKShape sh ids) _)) (erase_shape_call t env sh ids args fuel))
       ((Some (Pair (EKTemplate c) _)) (erase_template_call t env c args fuel))
       (_ (ErErr (quote function_value) "an application whose head is not a constant: a function is no value (§8.4 slice 3.28 rule 2; law §4.3)"))))
    ((Lam _ _ _ _ _)
     (match (beta_head (w_st (Tr.w t)) head args)
       ((Pair st r) (erase (tr_set_w t (w_set_st (Tr.w t) st)) env r (- fuel 1)))))
    ((Proj _ sn i x)   ; a package's function field applied (rule 5)
     (match (tr_package t sn)
       ((Pair t1 (Some _)) (erase_package_proj t1 env sn i x args fuel))
       ((Pair t1 None) (ErErr (quote function_value) "an application whose head is a projection: a function is no value (law §4.3)"))))
    (_ (ErErr (quote function_value) "an application whose head is not a constant (law §4.3)"))))
;; a runtime variable applied to proofs (dite's branches): the variable itself; to anything else, a function value
(fn erase_erased_args ((t Tr) (env (List ErEnt)) (v ETerm) (args (List Expr)) (fuel Int)) ErRes
  (measure (struct args))
  (match args
    (Nil (ErOk t v))
    ((Cons a r)
     (match (tr_infer t a)
       ((Pair t1 (Some aty))
        (match (w_is_prop (Tr.w t1) aty)
          ((Pair w2 (Some True)) (erase_erased_args (tr_set_w t1 w2) env v r fuel))
          ((Pair w2 _) (ErErr (quote function_value) "a variable applied to a runtime value: a function is no value — a function-typed binder is a static parameter of a template (§8.4 slice 3.28 rules 1–2; law §4.3)"))))
       ((Pair t1 None) (ErErr (quote function_value) "a variable applied to an argument K could not type"))))))
(fn last_component ((n Name)) Symbol (match n ((Str _ s) s) (_ (quote anon))))
;; `k`: the constant where a row of the registry may speak for it — Init's; a native declaration
;; that bears a row's name (a module `Bool` declaring `or` under a prefix that stops before
;; Init's) is its own program, never the row's (slice 3.19: the second reader's probe)
(fn erase_const ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (erase_const_at t env c (if (native_decl (Tr.sc t) c) Anon c) args fuel))
(fn erase_const_at ((t Tr) (env (List ErEnt)) (c Name) (k Name) (args (List Expr)) (fuel Int)) ErRes
  (let ((lc (last_component c)))
    (if (bool_or (name_eq k (n1 (quote absurd))) (name_eq k (n2 (quote False) (quote elim)))) (ErOk t EAbsurd)   ; a refuted row (slice 3.27 landing 3)
    (if (name_eq k (n2 (quote OfNat) (quote ofNat)))
      (match args ((Cons (Const _ nn _) (Cons (Lit _ (LitNat n)) _)) (if (name_eq nn (nm_nat)) (ErOk t (ELit (LNat n))) (ErErr (quote no_realization) "OfNat.ofNat off Nat"))) (_ (ErErr (quote no_realization) "OfNat.ofNat")))
    (if (name_eq k (nm_nat_zero)) (ErOk t (ELit (LNat 0)))
    (if (name_eq k (nm_nat_succ))
      (match args
        ((Cons x Nil) (match (erase t env x (- fuel 1)) ((ErErr e m) (ErErr e m)) ((ErOk t1 x1) (ErOk t1 (EPrim (n2 (quote Nat) (quote add)) (list x1 (ELit (LNat 1))))))))
        (_ (ErErr (quote function_value) "Nat.succ unapplied")))
    (if (name_eq k (nm_int_of_nat))          ; Nat and Int share the integer (INVENTORY): the coercion is the identity
      (match args ((Cons x Nil) (erase t env x (- fuel 1))) (_ (ErErr (quote function_value) "Int.ofNat unapplied")))
    (if (name_eq k (nm_int_neg_succ))
      (match args
        ((Cons (Lit _ (LitNat n)) Nil) (ErOk t (ELit (LInt (- (- 0 n) 1)))))
        ((Cons x Nil) (match (erase t env x (- fuel 1)) ((ErErr e m) (ErErr e m)) ((ErOk t1 x1) (ErOk t1 (EPrim (n1 (quote -)) (list (EPrim (n1 (quote -)) (list (ELit (LNat 0)) x1)) (ELit (LNat 1))))))))
        (_ (ErErr (quote function_value) "Int.negSucc unapplied")))
    (if (name_eq k (n2 (quote Decidable) (quote decide)))
      ;; decide p inst: Bool and Decidable have different cells (ev.shard), so the conversion is
      ;; explicit — (if ⟦inst⟧ true false) over Init's Bool (slice 3.16 rule 3; GPT-6 R66)
      (match args
        ((Cons _ (Cons inst Nil))
         (match (erase_cond t env inst (- fuel 1))
           ((ErErr e m) (ErErr e m))
           ((ErOk t1 i1)
            (match (erase t1 env (mk_const (n2 (quote Bool) (quote true)) Nil) (- fuel 1))
              ((ErErr e m) (ErErr e m))
              ((ErOk t2 tt)
               (match (erase t2 env (mk_const (n2 (quote Bool) (quote false)) Nil) (- fuel 1))
                 ((ErErr e m) (ErErr e m))
                 ((ErOk t3 ff) (ErOk t3 (EIf i1 tt ff)))))))))
        (_ (ErErr (quote function_value) "Decidable.decide unapplied")))
    (if (name_eq k (n1 (quote instDecidableEqBool)))
      ;; a value here: Decidable's cells (where an `if` reads it, erase_cond gives the test)
      (match args
        ((Cons a (Cons b Nil)) (erase_bool_eq t env a b fuel))
        (_ (ErErr (quote function_value) "instDecidableEqBool unapplied")))
    (if (bool_or (name_eq k (n1 (quote ite))) (name_eq k (n1 (quote dite))))
      (match args
        ((Cons _ (Cons _ (Cons h (Cons a (Cons b Nil))))) (erase_ite t env h a b (name_eq k (n1 (quote dite))) fuel))
        (_ (ErErr (quote function_value) "ite unapplied")))
    (if (bool_or (name_eq k (n2 (quote Bool) (quote and))) (bool_or (name_eq k (n2 (quote Bool) (quote or))) (name_eq k (n2 (quote Bool) (quote not)))))
      (erase_bool_op t env c args fuel)
    (if (bool_or (sym_eq lc (quote brecOn)) (bool_or (sym_eq lc (quote below)) (bool_or (sym_eq lc (quote fix)) (sym_eq lc (quote binductionOn)))))
      (ErErr (quote recursion_structure) (append (show_name c) ": a recursive definition's executable structure is not readable off the kernel term — supply the body (§7.1, §7.3)"))
    (if (bool_or (name_eq k (n2 (quote Classical) (quote choice))) (bool_or (name_eq k (n2 (quote Acc) (quote rec))) (bool_or (name_eq k (nm_quot_lift)) (bool_or (name_eq k (nm_quot_mk)) (name_eq k (nm_quot_ind))))))
      (ErErr (quote noncomputable) (append (show_name c) " in a runtime position (law §4.2)"))
    (match (env_find (tr_env t) c)
      (None (ErErr (quote unknown_constant) (show_name c)))
      ((Some info)
       (match info
         ((CtorInfo _ ind _ nparams _ _) (erase_ctor t env c ind nparams args fuel))
         ((RecInfo _ _ nparams _ nmotives nminors _ _ _) (erase_rec t env c nparams nmotives nminors args fuel))
         (_
          (if (sym_eq lc (quote casesOn))
            (erase_cases t env c args fuel)
          (if (bool_or (is_template (Tr.es t) c) (owner_is t c))   ; a template's call is a call of its instance (§8.4 slice 3.28 rule 3); a realize template's self-call names its constant
            (erase_template_call t env c args fuel)
            (match (if (name_eq c (Tr.id t)) (Some (ESig c 0 Nil (ETVar 0))) (es_find_decl (Tr.es t) c))   ; the realized constant calling itself: a call
              ((Some (EFn _ _ ps _ _ _)) (erase_call t env c info args fuel))
              ((Some (ESig _ _ ps _)) (erase_call t env c info args fuel))
              (_
               (match (realization_of k)
                 ((Some p)
                  (match (erase_all t env args fuel Nil)
                    ((Pair (Some (Pair e m)) _) (ErErr e m))
                    ((Pair None (Pair t1 as)) (if (is_decision k) (erase_dec_value t1 env (EPrim p as) fuel) (ErOk t1 (EPrim p as))))))
                 (None
                  (match (realization_expr k)
                    ((Some body)
                     (match (erase_all t env args fuel Nil)
                       ((Pair (Some (Pair e m)) _) (ErErr e m))
                       ((Pair None (Pair t1 (Cons a Nil))) (ErOk t1 (ELet (list a) body)))
                       ((Pair None _) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)")))))
                    (None
                  (match (prim_l_identity k)
                    ((Some _) (match (erase_all t env args fuel Nil) ((Pair (Some (Pair e m)) _) (ErErr e m)) ((Pair None (Pair t1 as)) (ErOk t1 (EPrim c as)))))
                    (None
                     (match (mt_is_matcher (tr_env t) c)
                       ((Some desc) (erase_matcher t env c desc args fuel))
                       (None
                        (match (proj_fn_app info args)
                          ((Some (Pair (Pair sn i) (Pair x Nil))) (erase_proj t env sn i x fuel))
                          ((Some (Pair (Pair sn i) (Pair x rest)))
                           (match (tr_package t sn)
                             ((Pair t1 (Some _)) (erase_package_proj t1 env sn i x rest fuel))
                             ((Pair t1 None) (ErErr (quote function_value) (append (show_name c) ": a projection applied past its structure — a function is no value (law §4.3)")))))
                          (None (erase_unfold_matcher t env c info args fuel)))))))))))))))))))))))))))))))))
;; a definition without a realization: Lean's own matcher (`NAME.match_N`, no descriptor of this
;; run) is a definition over `casesOn` — unfolded at its arguments and erased as any definition's
;; value (slice 3.27 rule 6); anything else has no realization
(fn erase_unfold_matcher ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int)) ErRes
  (match info
    ((DefnInfo _ v _ _ _)
     (if (is_match_name c)
       (match (beta_head (w_st (Tr.w t)) v args)
         ((Pair st r) (erase (tr_set_w t (w_set_st (Tr.w t) st)) env r (- fuel 1))))
       (ErErr (quote no_realization) (append (show_name c) ": no realization attached — realize it first (§7.1)"))))
    (_ (ErErr (quote no_realization) (append (show_name c) ": no realization attached — realize it first (§7.1)")))))
(fn is_match_name ((c Name)) Bool (match c ((Str _ s) (is_match_prefix (chars_of_sym s))) (_ False)))
(fn is_match_prefix ((cs (List Int))) Bool   ; "match_"
  (match cs
    ((Cons c1 (Cons c2 (Cons c3 (Cons c4 (Cons c5 (Cons c6 _))))))
     (bool_and (int_eq c1 109) (bool_and (int_eq c2 97) (bool_and (int_eq c3 116) (bool_and (int_eq c4 99) (bool_and (int_eq c5 104) (int_eq c6 95)))))))
    (_ False)))

;; ---- decisions: a value and a condition (slice 3.19) -------------------------------------------
;; A `Decidable` value is one of the type's two cells — a match by constructor reads it, a
;; function returns it, a derived decision is built of them. The registry's decisions answer a
;; test instead (the integer comparison's cell, a Bool), which is all an `if` reads: so where a
;; decision is an `if`'s condition — `ite`, `dite`, `decide`, a `casesOn` read back as an `if` —
;; erase_cond gives the bare test, and everywhere else the constant erases to
;; (if TEST isTrue isFalse). Before this slice the bare test stood in every position, and a
;; match on `(Nat.decEq a b)` by constructor took the wrong row (the second reader's probe)
(fn erase_dec_value ((t Tr) (env (List ErEnt)) (test ETerm) (fuel Int)) ErRes
  (let ((tt (mk_const (n1 (quote True)) Nil)) (pf (mk_const (n2 (quote True) (quote intro)) Nil)))
    (match (erase_all t env (list (mk_app (mk_app (mk_const (n2 (quote Decidable) (quote isTrue)) Nil) tt) pf)
                                 (mk_app (mk_app (mk_const (n2 (quote Decidable) (quote isFalse)) Nil) tt) pf)) fuel Nil)   ; the proofs are erased unread: only the cells are wanted
      ((Pair (Some (Pair e m)) _) (ErErr e m))
      ((Pair None (Pair t1 (Cons yes (Cons no Nil)))) (ErOk t1 (EIf test yes no)))
      ((Pair None _) (ErErr (quote no_realization) "Decidable's cells")))))
(fn is_decision ((c Name)) Bool
  (let ((lc (last_component c)))
    (bool_or (sym_eq lc (quote decEq)) (bool_or (sym_eq lc (quote decLt)) (sym_eq lc (quote decLe))))))
;; `a = b` at Bool: the test is `a` where b is `true` (and symmetrically), else
;; (if a b (if b false true)) over Init's Bool cells — b read once on either path
(fn bool_eq_test ((t Tr) (env (List ErEnt)) (a Expr) (b Expr) (fuel Int)) ErRes
  (if (is_const_named b (n2 (quote Bool) (quote true))) (erase t env a (- fuel 1))
  (if (is_const_named a (n2 (quote Bool) (quote true))) (erase t env b (- fuel 1))
    (match (erase_all t env (list a b (mk_const (n2 (quote Bool) (quote true)) Nil) (mk_const (n2 (quote Bool) (quote false)) Nil)) fuel Nil)
      ((Pair (Some (Pair e m)) _) (ErErr e m))
      ((Pair None (Pair t1 (Cons a1 (Cons b1 (Cons tt (Cons ff Nil)))))) (ErOk t1 (EIf a1 b1 (EIf b1 ff tt))))
      ((Pair None _) (ErErr (quote no_realization) "Bool's decidable equality"))))))
(fn erase_bool_eq ((t Tr) (env (List ErEnt)) (a Expr) (b Expr) (fuel Int)) ErRes
  (match (bool_eq_test t env a b fuel)
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 test) (erase_dec_value t1 env test fuel))))
;; a decision where an `if` reads it
(fn erase_cond ((t Tr) (env (List ErEnt)) (h Expr) (fuel Int)) ErRes
  (match (get_app_fn h)
    ((Const _ c _)
     (if (native_decl (Tr.sc t) c) (erase t env h fuel)
       (let ((args (get_app_args h)))
         (if (name_eq c (n1 (quote instDecidableEqBool)))
           (match args
             ((Cons a (Cons b Nil)) (bool_eq_test t env a b fuel))
             (_ (erase t env h fuel)))
         (if (bool_and (is_decision c) (match (es_find_decl (Tr.es t) c) ((Some _) False) (None True)))
           (match (realization_of c)
             ((Some p) (match (erase_all t env args fuel Nil) ((Pair (Some (Pair e m)) _) (ErErr e m)) ((Pair None (Pair t1 as)) (ErOk t1 (EPrim p as)))))
             (None (erase t env h fuel)))
           (erase t env h fuel))))))
    (_ (erase t env h fuel))))
;; the registry's Bool rows (slice 3.19): Init's connectives as the `if` their definitions are —
;; `Bool.and a b` is (if a b false), `Bool.or a b` (if a true b), `Bool.not a` (if a false true),
;; the second operand not evaluated where the first decides (Init marks them macro_inline)
(fn erase_bool_op ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match (erase_all t env (append args (list (mk_const (n2 (quote Bool) (quote true)) Nil) (mk_const (n2 (quote Bool) (quote false)) Nil))) fuel Nil)
    ((Pair (Some (Pair e m)) _) (ErErr e m))
    ((Pair None (Pair t1 (Cons a (Cons tt (Cons ff Nil))))) (if (name_eq c (n2 (quote Bool) (quote not))) (ErOk t1 (EIf a ff tt)) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))))
    ((Pair None (Pair t1 (Cons a (Cons b (Cons tt (Cons ff Nil))))))
     (if (name_eq c (n2 (quote Bool) (quote and))) (ErOk t1 (EIf a b ff))
     (if (name_eq c (n2 (quote Bool) (quote or))) (ErOk t1 (EIf a tt b))
       (ErErr (quote function_value) (append (show_name c) " over-applied")))))
    ((Pair None _) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)")))))
;; the realization registry's Int rows (slice 3.16 rule 4): a resolved L operation → the table's
;; entry. ev's integer operation and K's constant agree on every input for these; the
;; decisions answer a two-constructor cell, which is all an `if` reads (decide converts)
(fn realization_of ((c Name)) (Option Name)
  (if (name_eq c (n2 (quote Int) (quote add))) (Some (n1 (quote +)))
  (if (name_eq c (n2 (quote Int) (quote sub))) (Some (n1 (quote -)))
  (if (name_eq c (n2 (quote Int) (quote mul))) (Some (n1 (quote *)))
  (if (name_eq c (n2 (quote Int) (quote decEq))) (Some (n1 (quote =)))
  (if (name_eq c (n2 (quote Int) (quote decLt))) (Some (n1 (quote <)))
  (if (name_eq c (n2 (quote Int) (quote decLe))) (Some (n1 (quote <=)))
  ;; Nat's five that are the integer entry's own operation on naturals: one entry, the
  ;; spelling the classifier gives `+ * = < <=` (frontend parity stays byte for byte);
  ;; Nat.sub, Nat.div, Nat.mod differ from `- / mod` and keep their own entries (rule 4)
  (if (name_eq c (n2 (quote Nat) (quote add))) (Some (n1 (quote +)))
  (if (name_eq c (n2 (quote Nat) (quote mul))) (Some (n1 (quote *)))
  (if (name_eq c (n2 (quote Nat) (quote decEq))) (Some (n1 (quote =)))
  (if (name_eq c (n2 (quote Nat) (quote decLt))) (Some (n1 (quote <)))
  (if (name_eq c (n2 (quote Nat) (quote decLe))) (Some (n1 (quote <=)))
    None))))))))))))
;; the registry's expression rows (slice 3.17 rule 7): a one-argument L operation with no
;; table entry of its own, as an E expression over the existing entries with the argument
;; bound once (#0) — it agrees with K's constant on every input, as the rows above do
(fn realization_expr ((c Name)) (Option ETerm)
  (if (name_eq c (n2 (quote Int) (quote natAbs)))       ; |n|: (if (< n 0) (- 0 n) n)
    (Some (EIf (EPrim (n1 (quote <)) (list (EBVar 0) (ELit (LNat 0))))
               (EPrim (n1 (quote -)) (list (ELit (LNat 0)) (EBVar 0)))
               (EBVar 0)))
    None))

;; ---- a matcher application (slice 3.16 rule 1) ------------------------------------------------
;; OWNER.match_N params motive scrutinee alternatives: the E match of the rows read back off
;; the matcher's own type (mt_is_matcher has regenerated and compared it), each alternative's
;; lambdas the row's variables — control flow in E: the scrutinee once, then the first
;; matching row's arm only (§6.2)
(fn erase_matcher ((t Tr) (env (List ErEnt)) (c Name) (desc MtDesc) (args (List Expr)) (fuel Int)) ErRes
  (match desc
    ((MtDesc np nd rows)
     (if (bool_not (int_eq nd 1)) (ErErr (quote no_realization) (append (show_name c) ": a match on several scrutinees has no E form"))
     (if (lt (len args) (+ np (+ 2 (len rows)))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
       (match (nth args (+ np 1))
         (None (ErErr (quote function_value) (show_name c)))
         ((Some scrut)
          (match (erase t env scrut (- fuel 1))
            ((ErErr e m) (ErErr e m))
            ((ErOk t1 s1)
             (match (erase_alts t1 env rows (drop (+ np 2) args) (drop (+ np (+ 2 (len rows))) args) fuel Nil)
               ((Pair (Some (Pair e m)) _) (ErErr e m))
               ((Pair None (Pair t2 arms)) (ErOk t2 (EMatch s1 arms)))))))))))))
(fn erase_alts ((t Tr) (env (List ErEnt)) (rows (List (List MtPat))) (alts (List Expr)) (extra (List Expr)) (fuel Int) (acc (List EArm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List EArm)))
  (measure (struct rows))
  (match rows
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons (Cons p Nil) r)
     (match alts
       (Nil (Pair (Some (Pair (quote function_value) "a match with too few alternatives")) (Pair t Nil)))
       ((Cons a ar)
        (match (mt_epat t p True 64)
          ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a pattern on an erased field, or on a type that is not an E type")) (Pair t1 Nil)))
          ((Pair t1 (Some (Pair ep roles)))
           (match (alt_with_extra t1 a (len roles) extra Nil)
             ((Pair t1x a1)
           (match (erase_alt t1x env a1 roles fuel)
             ((Pair (Some (Pair e m)) _) (Pair (Some (Pair e m)) (Pair t1x Nil)))
             ((Pair None (Pair t2 body)) (erase_alts t2 env r ar extra fuel (Cons (EArm (match ep ((Some q) q) (None PVar)) body) acc)))))))))))
    (_ (Pair (Some (Pair (quote no_realization) "a match on several scrutinees has no E form")) (Pair t Nil)))))
;; an alternative under a matcher applied past its alternatives (the dependent match, slice 3.27
;; landing 3): its field lambdas opened, the lambdas after them instantiated at the extra arguments
;; — the generalized locals, re-bound in the arm —, the fields closed again
(fn alt_with_extra ((t Tr) (a Expr) (k Int) (extra (List Expr)) (fvs (List Expr))) (Pair Tr Expr)
  (measure k)
  (match extra
    (Nil (Pair t a))
    (_
     (if (le k 0)
       (match (inst_extra t a extra) ((Pair t1 b) (tr_lams t1 (rev fvs) b)))
       (match (open_lam t a)
         ((Pair t1 None) (Pair t1 a))
         ((Pair t1 (Some (Pair fv body))) (alt_with_extra t1 body (- k 1) extra (Cons fv fvs))))))))
(fn inst_extra ((t Tr) (a Expr) (extra (List Expr))) (Pair Tr Expr)
  (measure (struct extra))
  (match extra
    (Nil (Pair t a))
    ((Cons x r)
     (match a
       ((Lam _ _ _ _ body) (match (tr_inst1 t body x) ((Pair t1 b) (inst_extra t1 b r))))
       (_ (match (tr_apps t a (list x)) ((Pair t1 b) (inst_extra t1 b r))))))))
;; a row's pattern in E and its variables' runtime flags in slot order: a variable binds a
;; slot where its position is runtime data and vanishes where it is erased; a constructor
;; keeps its runtime fields
(fn mt_epat ((t Tr) (p MtPat) (runtime Bool) (fuel Int)) (Pair Tr (Option (Pair (Option EPat) (List Bool))))
  (measure fuel)
  (if (lt fuel 1) (Pair t None)
  (match p
    ((MtVar _) (Pair t (Some (Pair (if runtime (Some PVar) None) (list runtime)))))
    ((MtCtor c subs)
     (if (bool_not runtime) (Pair t None)
       (match (env_find (tr_env t) c)
         ((Some (CtorInfo _ ind _ _ _ _))
          (if (rep_row ind)   ; a row's constructor pattern is its one runtime field's pattern, on the scrutinee itself
            (match (row_field t ind)
              ((Pair t1 None) (Pair t1 None))
              ((Pair t1 (Some (Pair _ roles)))
               (match (mt_epats t1 subs roles Nil Nil (- fuel 1))
                 ((Pair t2 (Some (Pair (Cons q Nil) vroles))) (Pair t2 (Some (Pair (Some q) vroles))))
                 ((Pair t2 _) (Pair t2 None)))))
          (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind Nil)
            ((Pair (Pair w1 es1) False) (Pair t None))
            ((Pair (Pair w1 es1) True)
             (match (field_roles (tr_set_es (tr_set_w t w1) es1) c)
               ((Pair t1 None) (Pair t1 None))
               ((Pair t1 (Some roles))
                (match (mt_epats t1 subs roles Nil Nil (- fuel 1))
                  ((Pair t2 None) (Pair t2 None))
                  ((Pair t2 (Some (Pair eps vroles))) (Pair t2 (Some (Pair (Some (PCtor c eps)) vroles)))))))))))
         (_ (Pair t None))))))))
(fn mt_epats ((t Tr) (subs (List MtPat)) (roles (List Bool)) (eps (List EPat)) (vroles (List Bool)) (fuel Int)) (Pair Tr (Option (Pair (List EPat) (List Bool))))
  (measure (struct subs))
  (match subs
    (Nil (Pair t (Some (Pair (rev eps) vroles))))
    ((Cons p r)
     (match roles
       (Nil (Pair t None))
       ((Cons rt rr)
        (match (mt_epat t p rt fuel)
          ((Pair t1 None) (Pair t1 None))
          ((Pair t1 (Some (Pair ep vr)))
           (mt_epats t1 r rr (match ep ((Some q) (Cons q eps)) (None eps)) (append vroles vr) fuel))))))))
;; one alternative: a lambda per variable of the row, then its body
(fn erase_alt ((t Tr) (env (List ErEnt)) (a Expr) (roles (List Bool)) (fuel Int)) (Pair (Option (Pair Symbol (List Int))) (Pair Tr ETerm))
  (measure (struct roles))
  (match roles
    (Nil
     (match (erase t env a (- fuel 1))
       ((ErErr e msg) (Pair (Some (Pair e msg)) (Pair t (EBVar 0))))
       ((ErOk t1 b) (Pair None (Pair t1 b)))))
    ((Cons rt r)
     (match (open_lam t a)
       ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a match alternative K could not open as a function of its variables")) (Pair t1 (EBVar 0))))
       ((Pair t1 (Some (Pair fv body))) (erase_alt t1 (Cons (ErEnt (fvar_id_of fv) (if rt EKVar EKErased)) env) body r fuel))))))

;; ---- the E projection of a pre-definition (slice 3.16; predef.shard) ---------------------------
;; the binders' roles from their locals' types, the self-local a call of the function with
;; those roles; the body erased. The function's E signature with it
;; PdEraseOk carries the lambdas the body lifted and the instances it demands (§8.4 slice
;; 3.28 rule 3); PdEraseTemplate: a binder is a static parameter (rule 1) — the fn is a
;; template, with no program of its own: its binders' roles and its result's E type for the
;; instances (template.shard)
(type PdErase (PdEraseOk ESt EDecl (List Lifted) (List Demand)) (PdEraseTemplate ESt (List TBind) EType) (PdEraseErr Symbol (List Int)))
(fn erase_predef ((es ESt) (sc Scope) (pd PreDef)) PdErase
  (match (predef_binds (el_w (pd_state pd)) es sc (pd_binders pd) Nil Nil)
    ((Pair (Pair w1 es1) None) (PdEraseErr (quote no_l_identity) "a binder whose type is not an E type"))
    ((Pair (Pair w1 es1) (Some binds))
     (match (predef_ret w1 es1 sc pd binds)
       ((Pair (Pair w2 es2) None) (PdEraseErr (quote no_l_identity) "a result type that is not an E type (a function returned is no value: §8.4 slice 3.28 rule 2; law §4.3)"))
       ((Pair (Pair w2 es2) (Some rt))
        (if (has_static binds) (PdEraseTemplate es2 binds rt)
        (let ((t (tr_new w2 es2 sc (pd_name pd) (tbind_types binds)))
              (env (append (callee_ents (pd_callees pd)) (Cons (ErEnt (fvar_id_of (pd_self pd)) (EKCall (pd_name pd) (data_flags binds))) (binder_ents binds)))))
          (match (predef_rec t env (pd_rec pd) binds)
            ((Pair _ (Left5r e m)) (PdEraseErr e m))
            ((Pair t0 (Right5r rec))
             (match (erase t0 env (pd_body pd) (budget_depth))
               ((ErErr e m) (PdEraseErr e m))
               ((ErOk t1 ebody) (PdEraseOk (Tr.es t1) (EFn (pd_name pd) (count_types binds) (bind_ptypes binds) rt rec ebody) (Tr.lifted t1) (Tr.demands t1)))))))))))))
(fn has_static ((binds (List TBind))) Bool
  (measure (struct binds))
  (match binds (Nil False) ((Cons (TBind _ (BStatic _) _) _) True) ((Cons _ r) (has_static r))))
(fn count_static ((binds (List TBind))) Int
  (measure (struct binds))
  (match binds (Nil 0) ((Cons (TBind _ (BStatic _) _) r) (+ 1 (count_static r))) ((Cons _ r) (count_static r))))
;; a callee-local is a call of the callee (rule 6)
(fn callee_ents ((cs (List CalleeLocal))) (List ErEnt)
  (measure (struct cs))
  (match cs (Nil Nil) ((Cons (CalleeLocal fv id flags) r) (Cons (ErEnt (fvar_id_of fv) (EKCall id flags)) (callee_ents r)))))
;; the program's recursion clause: the structural binder's position among the data binders, a
;; measure erased over the binders
(type Either5r (Left5r Symbol (List Int)) (Right5r ERec))
(fn predef_rec ((t Tr) (env (List ErEnt)) (prec PdRec) (binds (List TBind))) (Pair Tr Either5r)
  (match prec
    (PdNone (Pair t (Right5r RecNone)))
    ((PdStruct x)
     (match (fvar_index (fvar_id_of x) (data_fvars binds) 0)
       ((Some i) (Pair t (Right5r (RecStruct i))))
       (None (Pair t (Left5r (quote bad_measure) "the structural parameter is not a data parameter")))))
    ((PdMeasure m)
     (match (erase t env m (budget_depth))
       ((ErErr e msg) (Pair t (Left5r e msg)))
       ((ErOk t1 em) (Pair t1 (Right5r (RecMeasure em))))))))
(fn data_fvars ((binds (List TBind))) (List Expr)
  (measure (struct binds))
  (match binds (Nil Nil) ((Cons (TBind _ (BData _) fv) r) (Cons fv (data_fvars r))) ((Cons _ r) (data_fvars r))))
(fn predef_binds ((w W) (es ESt) (sc Scope) (fvs (List Expr)) (tps (List Expr)) (acc (List TBind))) (Pair (Pair W ESt) (Option (List TBind)))
  (measure (struct fvs))
  (match fvs
    (Nil (Pair (Pair w es) (Some (rev acc))))
    ((Cons fv r)
     (match (w_local_type w (fvar_id_of fv))
       (None (Pair (Pair w es) None))
       ((Some ty)
        (match (binder_role w es sc ty tps)
          ((Pair (Pair w1 es1) None) (Pair (Pair w1 es1) None))
          ((Pair (Pair w1 es1) (Some role))
           (predef_binds w1 es1 sc r (match role (BType (append tps (list fv))) (_ tps)) (Cons (TBind Anon role fv) acc)))))))))
;; the result's E type: the declared type's codomain at the binders' locals
(fn predef_ret ((w W) (es ESt) (sc Scope) (pd PreDef) (binds (List TBind))) (Pair (Pair W ESt) (Option EType))
  (match (mt_inst_args w (pd_type pd) (pd_binders pd))
    ((Pair w1 None) (Pair (Pair w1 es) None))
    ((Pair w1 (Some rt)) (l_to_etype w1 es sc rt (tbind_types binds) Nil))))

;; ---- constructors, calls, decisions, case analyses ---------------------------------------------
;; a constructor: its inductive E-eligible, the static and erased arguments dropped
(fn erase_ctor ((t Tr) (env (List ErEnt)) (c Name) (ind Name) (nparams Int) (args (List Expr)) (fuel Int)) ErRes
  (if (rep_row ind)   ; a row's constructor is its one runtime argument
    (match (row_field t ind)
      ((Pair t1 None) (ErErr (quote no_realization) (append (show_name ind) ": the registry's row does not describe this structure (one constructor, one runtime field)")))
      ((Pair t1 (Some (Pair _ roles)))
       (if (bool_not (int_eq (len args) (+ nparams (len roles)))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
         (match (erase_roles t1 env roles (drop nparams args) fuel Nil)
           ((Pair (Some (Pair e m)) _) (ErErr e m))
           ((Pair None (Pair t2 (Cons a Nil))) (ErOk t2 a))
           ((Pair None _) (ErErr (quote no_realization) (show_name c)))))))
  (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind Nil)
    ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
    ((Pair (Pair w1 es1) True)
     (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
       (match (field_roles t1 c)
         ((Pair t2 None) (ErErr (quote no_realization) (show_name c)))
         ((Pair t2 (Some roles))
          (if (bool_not (int_eq (len args) (+ nparams (len roles)))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
            (match (erase_roles t2 env roles (drop nparams args) fuel Nil)
              ((Pair (Some (Pair e m)) _) (ErErr e m))
              ((Pair None (Pair t3 as)) (ErOk t3 (ECtor c as))))))))))))
(fn erase_roles ((t Tr) (env (List ErEnt)) (roles (List Bool)) (args (List Expr)) (fuel Int) (acc (List ETerm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List ETerm)))
  (measure (struct roles))
  (match roles
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons rt r)
     (match args
       (Nil (Pair (Some (Pair (quote function_value) "partially applied")) (Pair t Nil)))
       ((Cons a ar)
        (if rt
          (match (erase t env a (- fuel 1))
            ((ErErr e m) (Pair (Some (Pair e m)) (Pair t Nil)))
            ((ErOk t1 a1) (erase_roles t1 env r ar fuel (Cons a1 acc))))
          (erase_roles t env r ar fuel acc)))))))
;; a call of a realized constant: its binders' roles select the runtime arguments
(fn erase_call ((t Tr) (env (List ErEnt)) (c Name) (info ConstantInfo) (args (List Expr)) (fuel Int)) ErRes
  (match (tr_tele t info)
    ((Pair t1 None) (ErErr (quote no_realization) (show_name c)))
    ((Pair t1 (Some (Tele _ binds _ _)))
     (let ((roles (data_flags binds)))
       (if (bool_not (int_eq (len args) (len roles))) (ErErr (quote function_value) (append (show_name c) " partially applied (law §4.3)"))
         (match (erase_roles t1 env roles args fuel Nil)
           ((Pair (Some (Pair e m)) _) (ErErr e m))
           ((Pair None (Pair t2 as)) (ErOk t2 (ECall c as)))))))))
;; ite / dite: an if on the decision; dite's branches applied to their proof
(fn erase_ite ((t Tr) (env (List ErEnt)) (h Expr) (a Expr) (b Expr) (dep Bool) (fuel Int)) ErRes
  (match (erase_cond t env h (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 h1)
     (match (erase_branch t1 env a dep fuel)
       ((ErErr e m) (ErErr e m))
       ((ErOk t2 a1)
        (match (erase_branch t2 env b dep fuel)
          ((ErErr e m) (ErErr e m))
          ((ErOk t3 b1) (ErOk t3 (EIf h1 a1 b1)))))))))
(fn erase_branch ((t Tr) (env (List ErEnt)) (br Expr) (dep Bool) (fuel Int)) ErRes
  (if (bool_not dep) (erase t env br (- fuel 1))
    (match br
      ((Lam _ n _ dom body)
       (match (tr_local t n dom)
         ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (erase t2 (Cons (ErEnt (fvar_id_of fv) EKErased) env) body1 (- fuel 1)))))))
      (_ (erase t env br (- fuel 1))))))
;; T.casesOn params motive major minors: a match, each minor's field lambdas the pattern's variables
(fn erase_cases ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match c
    ((Str ind _)
     (match (env_find (tr_env t) ind)
       ((Some (InductInfo _ nparams _ _ ctors _ _ _ _))
        (if (rep_row ind) (erase_row_cases t env c ind (nth args (+ nparams 1)) (nth args (+ nparams 2)) (int_eq (len args) (+ nparams 3)) fuel)
        (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind Nil)
          ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
          ((Pair (Pair w1 es1) True)
           (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
             (if (bool_not (int_eq (len args) (+ nparams (+ 2 (len ctors))))) (ErErr (quote function_value) (append (show_name c) " partially applied"))
               (match (nth args (+ nparams 1))
                 (None (ErErr (quote function_value) (show_name c)))
                 ((Some major)
                  (match (if_branches t1 ctors (drop (+ nparams 2) args))
                    ((Some (Pair else_b then_b))
                     (match (erase_cond t1 env major (- fuel 1))
                       ((ErErr e m) (ErErr e m))
                       ((ErOk t2 major1) (erase_ite_bodies t2 env major1 then_b else_b fuel))))
                    (None
                     (match (erase t1 env major (- fuel 1))
                       ((ErErr e m) (ErErr e m))
                       ((ErOk t2 major1)
                        (match (erase_minors t2 env ctors (drop (+ nparams 2) args) False fuel Nil)
                          ((Pair (Some (Pair e m)) _) (ErErr e m))
                          ((Pair None (Pair t3 arms)) (ErOk t3 (EMatch major1 arms))))))))))))))))
       (_ (ErErr (quote no_realization) (show_name c)))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; a case analysis of a row of the registry's types: its one alternative with the runtime
;; field bound to the scrutinee, a let (rule 1 of slice 3.18)
(fn erase_row_cases ((t Tr) (env (List ErEnt)) (c Name) (ind Name) (major (Option Expr)) (minor (Option Expr)) (saturated Bool) (fuel Int)) ErRes
  (match (Pair major minor)
    ((Pair (Some mj) (Some mn))
     (if (bool_not saturated) (ErErr (quote function_value) (append (show_name c) " partially applied"))
       (match (row_field t ind)
         ((Pair t1 None) (ErErr (quote no_realization) (append (show_name ind) ": the registry's row does not describe this structure (one constructor, one runtime field)")))
         ((Pair t1 (Some (Pair _ roles)))
          (match (erase t1 env mj (- fuel 1))
            ((ErErr e m) (ErErr e m))
            ((ErOk t2 mj1)
             (match (erase_minor t2 env mn roles 0 fuel)
               ((Pair (Some (Pair e m)) _) (ErErr e m))
               ((Pair None (Pair t3 body)) (ErOk t3 (ELet (list mj1) body))))))))))
    (_ (ErErr (quote function_value) (append (show_name c) " partially applied")))))
;; a case analysis over a two-constructor inductive whose alternatives ignore their fields is
;; the `if` it was written as (§6.2's tag rule: the second constructor takes the then-branch;
;; elab.shard's elab_if_cases): the two bodies, first constructor's first
(fn if_branches ((t Tr) (ctors (List Name)) (minors (List Expr))) (Option (Pair Expr Expr))
  (match ctors
    ((Cons c1 (Cons c2 Nil))
     (match minors
       ((Cons m1 (Cons m2 Nil))
        (match (closed_under (tr_env t) c1 m1)
          ((Some b1) (match (closed_under (tr_env t) c2 m2) ((Some b2) (Some (Pair b1 b2))) (None None)))
          (None None)))
       (_ None)))
    (_ None)))
;; the alternative's body under its constructor's fields' lambdas, when it cites none of them
(fn closed_under ((env CheckedEnv) (c Name) (m Expr)) (Option Expr)
  (match (env_find env c)
    ((Some (CtorInfo _ _ _ _ nfields _)) (strip_unused_lams m nfields))
    (_ None)))
(fn strip_unused_lams ((m Expr) (k Int)) (Option Expr)
  (measure k)
  (if (lt k 1) (if (has_loose_bvars m) None (Some m))
    (match m ((Lam _ _ _ _ b) (strip_unused_lams b (- k 1))) (_ None))))
(fn erase_ite_bodies ((t Tr) (env (List ErEnt)) (c ETerm) (a Expr) (b Expr) (fuel Int)) ErRes
  (match (erase t env a (- fuel 1))
    ((ErErr e m) (ErErr e m))
    ((ErOk t1 a1)
     (match (erase t1 env b (- fuel 1))
       ((ErErr e m) (ErErr e m))
       ((ErOk t2 b1) (ErOk t2 (EIf c a1 b1)))))))
;; T.rec params motive minors major with no use of an induction hypothesis: a match
(fn erase_rec ((t Tr) (env (List ErEnt)) (c Name) (nparams Int) (nmotives Int) (nminors Int) (args (List Expr)) (fuel Int)) ErRes
  (match c
    ((Str ind _)
     (if (bool_not (int_eq nmotives 1)) (ErErr (quote recursion_structure) (append (show_name c) ": a nested inductive's recursor"))
     (match (env_find (tr_env t) ind)
       ((Some (InductInfo _ _ _ _ ctors _ _ _ _))
        (if (rep_row ind) (erase_row_cases t env c ind (nth args (+ nparams 2)) (nth args (+ nparams 1)) (bool_and (int_eq nminors 1) (int_eq (len args) (+ nparams 3))) fuel)
        (match (ind_eligible (Tr.w t) (Tr.es t) (Tr.sc t) ind Nil)
          ((Pair (Pair w1 es1) False) (ErErr (quote no_realization) (append (show_name ind) " is not an E type (§7.5)")))
          ((Pair (Pair w1 es1) True)
           (let ((t1 (tr_set_es (tr_set_w t w1) es1)))
             (if (bool_not (int_eq (len args) (+ nparams (+ 2 nminors)))) (ErErr (quote function_value) (append (show_name c) " partially applied"))
               (match (nth args (+ nparams (+ 1 nminors)))
                 (None (ErErr (quote function_value) (show_name c)))
                 ((Some major)
                  (match (erase t1 env major (- fuel 1))
                    ((ErErr e m) (ErErr e m))
                    ((ErOk t2 major1)
                     (match (erase_minors t2 env ctors (take nminors (drop (+ nparams 1) args)) True fuel Nil)
                       ((Pair (Some (Pair e m)) _) (ErErr e m))
                       ((Pair None (Pair t3 arms)) (ErOk t3 (EMatch major1 arms))))))))))))))
       (_ (ErErr (quote no_realization) (show_name c))))))
    (_ (ErErr (quote no_realization) (show_name c)))))
;; the minors in constructor order: each a lambda over the fields (and, for a recursor, the hypotheses)
(fn erase_minors ((t Tr) (env (List ErEnt)) (ctors (List Name)) (minors (List Expr)) (with_ihs Bool) (fuel Int) (acc (List EArm))) (Pair (Option (Pair Symbol (List Int))) (Pair Tr (List EArm)))
  (measure (struct ctors))
  (match ctors
    (Nil (Pair None (Pair t (rev acc))))
    ((Cons c r)
     (match minors
       (Nil (Pair (Some (Pair (quote function_value) "a case analysis with too few alternatives")) (Pair t Nil)))
       ((Cons m mr)
        (match (field_roles t c)
          ((Pair t1 None) (Pair (Some (Pair (quote no_realization) (show_name c))) (Pair t1 Nil)))
          ((Pair t1 (Some roles))
           (match (erase_minor t1 env m roles (if with_ihs (ih_count t1 c) 0) fuel)
             ((Pair (Some (Pair e msg)) _) (Pair (Some (Pair e msg)) (Pair t1 Nil)))
             ((Pair None (Pair t2 body))
              (erase_minors t2 env r mr with_ihs fuel (Cons (EArm (PCtor c (pvars (count_true roles))) body) acc)))))))))))
;; the induction hypotheses of a constructor: one per field whose type's head is its inductive
(fn ih_count ((t Tr) (c Name)) Int
  (match (env_find (tr_env t) c)
    ((Some info)
     (match info
       ((CtorInfo _ ind _ nparams _ _)
        (match (tr_tele t info)
          ((Pair _ None) 0)
          ((Pair t1 (Some (Tele _ binds _ _))) (count_recursive t1 (drop nparams binds) ind))))
       (_ 0)))
    (None 0)))
(fn count_recursive ((t Tr) (binds (List TBind)) (ind Name)) Int
  (measure (struct binds))
  (match binds
    (Nil 0)
    ((Cons (TBind _ _ fv) r)
     (+ (match (tr_type_of_local t fv) ((Some ty) (if (is_head_const ty ind) 1 0)) (None 0)) (count_recursive t r ind)))))
;; one minor: a lambda per field (erased fields and hypotheses as erased entries), then its body
(fn erase_minor ((t Tr) (env (List ErEnt)) (m Expr) (roles (List Bool)) (nihs Int) (fuel Int)) (Pair (Option (Pair Symbol (List Int))) (Pair Tr ETerm))
  (measure (struct roles))
  (match roles
    (Nil
     (match (open_ihs_lams t env m nihs fuel)
       ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a case alternative K could not open as a function of its hypotheses")) (Pair t1 (EBVar 0))))
       ((Pair t1 (Some (Pair env1 body)))
        (match (erase t1 env1 body (- fuel 1))
          ((ErErr e msg) (Pair (Some (Pair e msg)) (Pair t1 (EBVar 0))))
          ((ErOk t2 b) (Pair None (Pair t2 b)))))))
    ((Cons rt r)
     (match (open_lam t m)
       ((Pair t1 None) (Pair (Some (Pair (quote no_realization) "a case alternative K could not open as a function of its fields")) (Pair t1 (EBVar 0))))
       ((Pair t1 (Some (Pair fv body))) (erase_minor t1 (Cons (ErEnt (fvar_id_of fv) (if rt EKVar EKErased)) env) body r nihs fuel))))))
;; a lambda's binder opened as a local (a non-lambda is applied to the local — eta)
(fn open_lam ((t Tr) (m Expr)) (Pair Tr (Option (Pair Expr Expr)))
  (match m
    ((Lam _ n _ dom body)
     (match (tr_local t n dom) ((Pair t1 fv) (match (tr_inst1 t1 body fv) ((Pair t2 body1) (Pair t2 (Some (Pair fv body1))))))))
    (_
     (match (tr_infer t m)
       ((Pair t1 (Some ty))
        (match (tr_whnf t1 ty)
          ((Pair t2 (Some (Pi _ n _ dom _)))
           (match (tr_local t2 n dom) ((Pair t3 fv) (match (tr_apps t3 m (list fv)) ((Pair t4 m1) (Pair t4 (Some (Pair fv m1))))))))
          ((Pair t2 _) (Pair t2 None))))
       ((Pair t1 None) (Pair t1 None))))))
(fn open_ihs_lams ((t Tr) (env (List ErEnt)) (m Expr) (k Int) (fuel Int)) (Pair Tr (Option (Pair (List ErEnt) Expr)))
  (measure k)
  (if (lt k 1) (Pair t (Some (Pair env m)))
    (match (open_lam t m)
      ((Pair t1 None) (Pair t1 None))
      ((Pair t1 (Some (Pair fv body))) (open_ihs_lams t1 (Cons (ErEnt (fvar_id_of fv) EKIH) env) body (- k 1) fuel)))))

;; ---- a template's call, the shapes of its static arguments, the lifted lambda (§8.4 slice 3.28 rule 3) ----
;; a template is called at its full arity: its type arguments closed E types (an instance is
;; at closed types — a polymorphic taker is this landing's limit), its static arguments
;; shapes, its data arguments erased; the call is the instance's, at the captured values
;; group by group then the data, and the instance is demanded of the loader. In a template's
;; body at an instance (owner), a call of the template itself at another name is the
;; type-growing recursion (rule 4)
(fn is_template ((es ESt) (c Name)) Bool (match (es_info es c) ((Some (EITemplate _)) True) (_ False)))
(fn erase_template_call ((t Tr) (env (List ErEnt)) (c Name) (args (List Expr)) (fuel Int)) ErRes
  (match (owner_binds t c)
    ((Some binds) (erase_template_at t env c binds args fuel))
    (None
     (match (env_find (tr_env t) c)
       (None (ErErr (quote unknown_constant) (show_name c)))
       ((Some info)
        (match (tr_tele t info)
          ((Pair t1 None) (ErErr (quote no_realization) (append (show_name c) ": a template whose telescope K could not read")))
          ((Pair t1 (Some (Tele _ binds _ _))) (erase_template_at t1 env c binds args fuel))))))))
(fn erase_template_at ((t Tr) (env (List ErEnt)) (c Name) (binds (List TBind)) (args (List Expr)) (fuel Int)) ErRes
  (if (bool_not (int_eq (len args) (len binds)))
    (ErErr (quote function_value) (append (show_name c) (append " applied to " (append (show_nat (len args)) (append " arguments: a template is called at its full arity of " (append (show_nat (len binds)) " (§8.4 slice 3.28 rule 2; law §4.3)"))))))
    (match (template_args t env c binds args fuel Nil Nil Nil Nil Nil)
      ((Pair t2 (TaErr e m)) (ErErr e m))
      ((Pair t2 (TaOk tyl tye shapes caps data))
       (let ((name (instance_name (Tr.sc t2) c tye shapes)))
         (if (other_shape (Tr.owner t2) c name)
           (ErErr (quote realize_descent) (append (show_name c) ": a recursive call at other static arguments or type arguments — a template calls itself at its own shapes (§8.4 slice 3.28 rule 4)"))
           (ErOk (tr_demand t2 (Demand name c tyl tye shapes)) (ECall name (append caps data)))))))))
(fn other_shape ((owner (Option (Pair Name Name))) (c Name) (name Name)) Bool
  (match owner
    ((Some (Pair oc oname)) (bool_and (name_eq oc c) (bool_not (name_eq oname name))))
    (None False)))
(type TaRes (TaOk (List Expr) (List EType) (List Shape) (List ETerm) (List ETerm)) (TaErr Symbol (List Int)))
(fn template_args ((t Tr) (env (List ErEnt)) (c Name) (binds (List TBind)) (args (List Expr)) (fuel Int) (tyl (List Expr)) (tye (List EType)) (shapes (List Shape)) (caps (List ETerm)) (data (List ETerm))) (Pair Tr TaRes)
  (measure (struct binds))
  (match binds
    (Nil (Pair t (TaOk (rev tyl) (rev tye) (rev shapes) caps (rev data))))
    ((Cons (TBind _ role _) br)
     (match args
       (Nil (Pair t (TaErr (quote function_value) (append (show_name c) " partially applied (§8.4 slice 3.28 rule 2; law §4.3)"))))
       ((Cons a ar)
        (match role
          (BType
           ;; an open type argument: inside a template (the declaration's check, at placeholders) a
           ;; template is taken at the enclosing template's own type parameters — the instance is at
           ;; closed types —, but the template itself only at its parameters exactly (rule 4: at a type
           ;; built from them the shape set grows); outside a template, a polymorphic taker is landing 1's limit
           (if (bool_and (has_fvar a) (bool_or (bool_not (in_template t)) (bool_and (owner_is t c) (bool_not (own_tparam t a)))))
             (Pair t (if (in_template t)
                       (TaErr (quote realize_descent) (append (show_name c) ": a recursive call at a type built from a type parameter — a template calls itself at its own types, or the shape set grows (§8.4 slice 3.28 rule 4)"))
                       (TaErr (quote function_value) (append (show_name c) ": a template taken at an open type — a type parameter of the caller; an instance is at closed types (§8.4 slice 3.28 rule 3, landing 1)"))))
             (match (l_to_etype (Tr.w t) (Tr.es t) (Tr.sc t) a (Tr.tps t) Nil)
               ((Pair (Pair w1 es1) None) (Pair (tr_set_es (tr_set_w t w1) es1) (TaErr (quote no_realization) (append (show_name c) ": a type argument that is no E type"))))
               ((Pair (Pair w1 es1) (Some ety)) (template_args (tr_set_es (tr_set_w t w1) es1) env c br ar fuel (Cons a tyl) (Cons ety tye) shapes caps data)))))
          (BErased (template_args t env c br ar fuel tyl tye shapes caps data))
          ((BData _)
           (match (erase t env a (- fuel 1))
             ((ErErr e m) (Pair t (TaErr e m)))
             ((ErOk t1 a1) (template_args t1 env c br ar fuel tyl tye shapes caps (Cons a1 data)))))
          ((BStatic k)
           (match (static_shape t env a k fuel)
             ((Pair t1 (SsErr e m)) (Pair t1 (TaErr e m)))
             ((Pair t1 (SsOk sh cs)) (template_args t1 env c br ar fuel tyl tye (Cons sh shapes) (append caps cs) data))))))))))
;; a static parameter's call at an instance: its shape's identity at the captured slots then the arguments
(fn erase_shape_call ((t Tr) (env (List ErEnt)) (sh Shape) (ids (List Int)) (args (List Expr)) (fuel Int)) ErRes
  (if (bool_not (int_eq (len args) (shape_arity sh)))
    (ErErr (quote function_value) (append "a static parameter (at " (append (show_name (shape_id sh)) (append ") applied to " (append (show_nat (len args)) (append " arguments, its arity " (append (show_nat (shape_arity sh)) " (§8.4 slice 3.28 rule 2; law §4.3)")))))))
    (match (erase_all t env args fuel Nil)
      ((Pair (Some (Pair e m)) _) (ErErr e m))
      ((Pair None (Pair t1 as))
       (let ((all (append (captured_bvars env ids) as)))
         (match (shape_prim sh)
           ((Some p) (if (is_decision (shape_id sh)) (erase_dec_value t1 env (EPrim p all) fuel) (ErOk t1 (EPrim p all))))
           (None (ErOk t1 (ECall (shape_id sh) all)))))))))
(fn captured_bvars ((env (List ErEnt)) (ids (List Int))) (List ETerm)
  (measure (struct ids))
  (match ids
    (Nil Nil)
    ((Cons id r) (Cons (match (er_index env id 0) ((Some (Pair _ i)) (EBVar i)) (None (EBVar 0))) (captured_bvars env r)))))
;; the shape of a static argument (rule 3): (a) a name with a program; (b) such a name applied —
;; type and erased arguments kept, runtime arguments captured; (c) a closed lambda, lifted; (d)
;; a static parameter passed on; (e) a package constant (rule 5). Anything else — a static
;; parameter applied (rule 4), a runtime variable, a let-bound function — is refused
(type SsRes (SsOk Shape (List ETerm)) (SsErr Symbol (List Int)))
(fn static_pointer () (List Int) "a static argument is the name of a fn with a program, a realized constant or an instance, such a name applied to runtime values of the caller, a closed lambda, or a static parameter passed on (§8.4 slice 3.28 rule 3; law §4.3)")
(fn static_shape ((t Tr) (env (List ErEnt)) (a Expr) (k Int) (fuel Int)) (Pair Tr SsRes)
  (match a
    ((Lam _ _ _ _ _) (lift_lambda t env a k fuel))
    ((FVar _ id) (passed_shape t env id k))
    (_
     (match (get_app_fn a)
       ((Const d g ls)
        (if (int_eq k 0) (package_shape t env (Const d g ls) g (get_app_args a))
          (match (env_find (tr_env t) g)
            ((Some info)
             (match (proj_fn_app info (get_app_args a))   ; a package's function field passed on (rule 5): the field's term at the constant, a placeholder at the check
               ((Some (Pair (Pair sn i) (Pair x rest))) (package_field_shape t env sn i x rest k fuel))
               (None (named_shape t env (Const d g ls) g (get_app_args a) k fuel))))
            (None (named_shape t env (Const d g ls) g (get_app_args a) k fuel)))))
       ((FVar _ id)
        (match (er_index env id 0)
          ((Some (Pair (EKShape sh _) _)) (Pair t (SsErr (quote function_value) (append "a static parameter (at " (append (show_name (shape_id sh)) ") applied as a static argument: a static parameter is passed on, never transformed (§8.4 slice 3.28 rule 4; law §4.3)")))))
          (_ (Pair t (SsErr (quote function_value) (static_pointer))))))
       ((Proj _ sn i x) (package_field_shape t env sn i x (get_app_args a) k fuel))
       ((Lam _ _ _ _ _)   ; a lambda applied (a package's lambda field at its captured values): reduced, then read as any static argument
        (match (beta_head (w_st (Tr.w t)) (get_app_fn a) (get_app_args a))
          ((Pair st r) (static_shape (tr_set_w t (w_set_st (Tr.w t) st)) env r k (- fuel 1)))))
       (_ (Pair t (SsErr (quote function_value) (static_pointer))))))))
;; (e) a package constant (rule 5): a closed term whose value whnf reads as a package type's
;; constructor applied — the shape its identity with its arguments, nothing captured
(fn package_shape ((t Tr) (env (List ErEnt)) (head Expr) (g Name) (gargs (List Expr))) (Pair Tr SsRes)
  (if (has_fvar (mk_app_n head gargs)) (Pair t (SsErr (quote function_value) (append (show_name g) ": a package constant applied to a local of the caller — a package is closed (§8.4 slice 3.28 rule 5)")))
  (match (package_fields_of t (mk_app_n head gargs))
    ((Pair t1 (PkFields _ _)) (Pair t1 (SsOk (Shape head None 0 (somes_of gargs) Nil) Nil)))
    ((Pair t1 (PkPlaceholder _)) (Pair t1 (SsErr (quote no_realization) (show_name g))))
    ((Pair t1 (PkErr _ _)) (Pair t1 (SsErr (quote no_realization) (append (show_name g) ": a static argument of a package type names a package constant — a def whose value is the structure's constructor applied (§8.4 slice 3.28 rule 5)")))))))
(fn somes_of ((es (List Expr))) (List (Option Expr))
  (measure (struct es))
  (match es (Nil Nil) ((Cons a r) (Cons (Some a) (somes_of r)))))
;; a package's function field as a static argument: at the constant, the field's term (a name, a
;; partial application or a lambda — lifted under the taking body's name) read as any static
;; argument; at the declaration's check, a placeholder of the field's arity
(fn package_field_shape ((t Tr) (env (List ErEnt)) (sn Name) (i Int) (x Expr) (rest (List Expr)) (k Int) (fuel Int)) (Pair Tr SsRes)
  (match (package_subject t env x)
    ((Pair t1 (PkErr e m)) (Pair t1 (SsErr e m)))
    ((Pair t1 (PkFields pk fields))
     (match (nth fields i)
       ((Some fi)
        ;; the arguments may mention the package parameter (its unit, say): the parameter replaced
        ;; by the constant, so a lambda lifted here is closed
        (match (match x ((FVar _ id) (tr_subst t1 (mk_app_n fi rest) id pk)) (_ (Pair t1 (mk_app_n fi rest))))
          ((Pair t2 term) (static_shape t2 env term k fuel))))
       (None (Pair t1 (SsErr (quote no_realization) (append (show_name sn) ": a projection past the constructor's fields"))))))
    ((Pair t1 (PkPlaceholder pn)) (Pair t1 (SsOk (Shape (mk_const (package_field_name pn i) Nil) None k Nil Nil) Nil)))))
(fn passed_shape ((t Tr) (env (List ErEnt)) (id Int) (k Int)) (Pair Tr SsRes)
  (match (er_index env id 0)
    ((Some (Pair (EKShape sh ids) _))
     (if (int_eq (shape_arity sh) k) (Pair t (SsOk sh (captured_bvars env ids)))
       (Pair t (SsErr (quote function_value) (append "a static parameter (at " (append (show_name (shape_id sh)) (append ") of arity " (append (show_nat (shape_arity sh)) (append " passed where the arity is " (show_nat k))))))))))
    ((Some (Pair (EKCall g _) _)) (Pair t (SsErr (quote no_l_meaning) (append (show_name g) ": a function with a program and no K constant, or the enclosing function itself, as a static argument — its instance would have no L reading (§8.4 slice 3.28 rule 3)"))))
    ((Some (Pair (EKTemplate g) _)) (Pair t (SsErr (quote function_value) (append (show_name g) ": a template as a static argument — an instance is taken where the template is called (§8.4 slice 3.28 rule 3)"))))
    (_ (Pair t (SsErr (quote function_value) (static_pointer))))))
(fn named_shape ((t Tr) (env (List ErEnt)) (head Expr) (g Name) (gargs (List Expr)) (k Int) (fuel Int)) (Pair Tr SsRes)
  (if (is_template (Tr.es t) g) (Pair t (SsErr (quote function_value) (append (show_name g) ": a template as a static argument — an instance is taken where the template is called (§8.4 slice 3.28 rule 3)")))
  (match (shape_kind t g)
    (None (Pair t (SsErr (quote no_realization) (append (show_name g) ": no program — a static argument names a fn with a program, a realized constant or an instance (§8.4 slice 3.28 rule 3)"))))
    ((Some prim)
     (match (env_find (tr_env t) g)
       (None (Pair t (SsErr (quote unknown_constant) (show_name g))))
       ((Some info)
        (match (tr_tele t info)
          ((Pair t1 None) (Pair t1 (SsErr (quote no_realization) (append (show_name g) ": a static argument whose telescope K could not read"))))
          ((Pair t1 (Some (Tele _ binds _ _))) (shape_args t1 env head g binds gargs k fuel Nil Nil Nil prim)))))))))
;; a static argument's identity has a program — a fn, a realized constant or an instance of the
;; E table (None: a call) — or is a constant of the realization registry (its primitive)
(fn shape_kind ((t Tr) (g Name)) (Option (Option Name))
  (match (es_find_decl (Tr.es t) g)
    ((Some (EFn _ _ _ _ _ _)) (Some None))
    (_ (match (realization_of g) ((Some p) (Some (Some p))) (None None)))))
(fn shape_args ((t Tr) (env (List ErEnt)) (head Expr) (g Name) (binds (List TBind)) (gargs (List Expr)) (k Int) (fuel Int) (leading (List (Option Expr))) (ctys (List Expr)) (cvals (List ETerm)) (prim (Option Name))) (Pair Tr SsRes)
  (measure (struct binds))
  (match gargs
    (Nil
     (if (trailing_data binds k) (Pair t (SsOk (Shape head prim k (rev leading) (rev ctys)) (rev cvals)))
       (Pair t (SsErr (quote function_value) (append (show_name g) (append " applied to " (append (show_nat (len leading)) (append " arguments does not leave " (append (show_nat k) " runtime binders, the static parameter's arity (§8.4 slice 3.28 rule 3; law §4.3)")))))))))
    ((Cons a ar)
     (match binds
       (Nil (Pair t (SsErr (quote function_value) (append (show_name g) " over-applied"))))
       ((Cons (TBind _ role _) br)
        (match role
          (BType
           (if (has_fvar a) (Pair t (SsErr (quote function_value) (append (show_name g) ": a type argument of a static argument mentions a local of the caller (§8.4 slice 3.28 rule 3, landing 1)")))
             (shape_args t env head g br ar k fuel (Cons (Some a) leading) ctys cvals prim)))
          (BErased
           (if (has_fvar a) (Pair t (SsErr (quote function_value) (append (show_name g) ": an erased argument of a static argument mentions a local of the caller (§8.4 slice 3.28 rule 3, landing 1)")))
             (shape_args t env head g br ar k fuel (Cons (Some a) leading) ctys cvals prim)))
          ((BData _)
           (match (tr_infer t a)
             ((Pair t1 None) (Pair t1 (SsErr (quote function_value) (append (show_name g) ": a captured value K could not type"))))
             ((Pair t1 (Some ty))
              (if (has_fvar ty) (Pair t1 (SsErr (quote function_value) (append (show_name g) ": a captured value whose type mentions a local of the caller (§8.4 slice 3.28 rule 3, landing 1)")))
                (match (erase t1 env a (- fuel 1))
                  ((ErErr e m) (Pair t1 (SsErr e m)))
                  ((ErOk t2 a1) (shape_args t2 env head g br ar k fuel (Cons None leading) (Cons ty ctys) (Cons a1 cvals) prim)))))))
          ((BStatic _) (Pair t (SsErr (quote function_value) (append (show_name g) ": a template as a static argument (§8.4 slice 3.28 rule 3)"))))))))))
(fn trailing_data ((binds (List TBind)) (k Int)) Bool
  (measure (struct binds))
  (match binds
    (Nil (int_eq k 0))
    ((Cons (TBind _ (BData _) _) r) (trailing_data r (- k 1)))
    (_ False)))
;; a closed lambda lifted to CALLER.lam_N (rule 3(c)): the caller's runtime locals it mentions
;; are captured, in order of first occurrence, as its leading parameters; its own binders
;; follow (opened at the static parameter's arity — eta past the lambdas written); its body
;; erased over them; its L definition the same lambda over the captured locals. A lambda over
;; a type parameter, a proof, a function with no K constant or a static parameter is refused
(fn lift_lambda ((t Tr) (env (List ErEnt)) (lam Expr) (k Int) (fuel Int)) (Pair Tr SsRes)
  (match (captured_of env (fvars_of lam) Nil)
    ((Left6 e m) (Pair t (SsErr e m)))
    ((Right6 captured)
     (let ((n (+ (Tr.lams t) 1)))
       (let ((name (name_append (Tr.id t) (n1 (sym_of_chars (append "lam_" (show_nat n)))))))
         (match (open_lams (with Tr t (lams n)) lam k Nil)
           ((Pair t1 None) (Pair t1 (SsErr (quote function_value) "a lambda K could not open at the static parameter's arity")))
           ((Pair t1 (Some (Pair bfvs body)))
            (match (local_etypes t1 (append captured bfvs) Nil)
              ((Pair t2 None) (Pair t2 (SsErr (quote function_value) "a lambda whose binder or captured local has no closed E type — over a type parameter, a proof or a dependent type (§8.4 slice 3.28 rule 3, landing 1)")))
              ((Pair t2 (Some ptys))
               (match (tr_infer t2 body)
                 ((Pair t3 None) (Pair t3 (SsErr (quote function_value) "a lambda whose body K could not type")))
                 ((Pair t3 (Some bty))
                  (match (l_to_etype (Tr.w t3) (Tr.es t3) (Tr.sc t3) bty Nil Nil)
                    ((Pair (Pair w4 es4) None) (Pair (tr_set_es (tr_set_w t3 w4) es4) (SsErr (quote function_value) "a lambda whose result is no E type (§8.4 slice 3.28 rule 2; law §4.3)")))
                    ((Pair (Pair w4 es4) (Some rty))
                     (match (erase (tr_set_es (tr_set_w t3 w4) es4) (lifted_env env captured bfvs) body (- fuel 1))
                       ((ErErr e m) (Pair t3 (SsErr e m)))
                       ((ErOk t5 ebody)
                        (match (tr_lams t5 (append captured bfvs) body)
                          ((Pair t6 value)
                           (match (tr_pis t6 (append captured bfvs) bty)
                             ((Pair t7 ty)
                              (if (has_fvar ty) (Pair t7 (SsErr (quote function_value) "a lambda whose type mentions a local of the caller (§8.4 slice 3.28 rule 3, landing 1)"))
                                (match (local_ltypes t7 captured Nil)
                                  ((Pair t8 ctys)
                                   (Pair (tr_lift t8 (Lifted name (EFn name 0 ptys rty RecNone ebody) (DefnDecl (ConstantVal name Nil ty) value (HRegular (def_height (tr_env t8) value)) Safe (list name))))
                                         (SsOk (Shape (mk_const name Nil) None k (nones_of (len captured)) ctys) (captured_bvars env (pd_fvar_ids captured))))))))))))))))))))))))))
(type Either6 (Left6 Symbol (List Int)) (Right6 (List Expr)))
(fn captured_of ((env (List ErEnt)) (fvs (List Expr)) (acc (List Expr))) Either6
  (measure (struct fvs))
  (match fvs
    (Nil (Right6 (rev acc)))
    ((Cons fv r)
     (match (er_index env (fvar_id_of fv) 0)
       ((Some (Pair EKVar _)) (captured_of env r (Cons fv acc)))
       ((Some (Pair EKStatic _)) (Left6 (quote function_value) "a lambda over a type parameter of the caller — a polymorphic lambda (§8.4 slice 3.28 rule 3, landing 1)"))
       ((Some (Pair EKErased _)) (Left6 (quote function_value) "a lambda mentioning a proof or a type of the caller (§8.4 slice 3.28 rule 3, landing 1)"))
       ((Some (Pair EKIH _)) (Left6 (quote recursion_structure) "a lambda over an induction hypothesis"))
       ((Some (Pair (EKCall g _) _)) (Left6 (quote function_value) (append (show_name g) ": a lambda calling a function with a program and no K constant, or its enclosing function — the lifted fn would have no L definition (§8.4 slice 3.28 rule 3)")))
       ((Some (Pair (EKShape sh _) _)) (Left6 (quote function_value) (append "a lambda over a static parameter (at " (append (show_name (shape_id sh)) "): a static parameter is passed on, never transformed (§8.4 slice 3.28 rule 4; law §4.3)"))))
       ((Some (Pair (EKTemplate g) _)) (Left6 (quote function_value) (append (show_name g) ": a lambda calling the template it stands in (§8.4 slice 3.28 rule 3)")))
       (None (Left6 (quote erased_in_runtime) "a variable the erasure does not know"))))))
;; the free locals of a term, first occurrence first
(fn fvars_of ((e Expr)) (List Expr) (rev (fvars_acc e Nil)))
(fn fvars_acc ((e Expr) (acc (List Expr))) (List Expr)
  (measure (struct e))
  (if (bool_not (has_fvar e)) acc
  (match e
    ((FVar _ id) (if (mem_int id (pd_fvar_ids acc)) acc (Cons e acc)))
    ((App _ f a) (fvars_acc a (fvars_acc f acc)))
    ((Lam _ _ _ d b) (fvars_acc b (fvars_acc d acc)))
    ((Pi _ _ _ d b) (fvars_acc b (fvars_acc d acc)))
    ((Let _ _ ty v b) (fvars_acc b (fvars_acc v (fvars_acc ty acc))))
    ((Proj _ _ _ x) (fvars_acc x acc))
    (_ acc))))
(fn open_lams ((t Tr) (e Expr) (k Int) (acc (List Expr))) (Pair Tr (Option (Pair (List Expr) Expr)))
  (measure k)
  (if (lt k 1) (Pair t (Some (Pair (rev acc) e)))
    (match (open_lam t e)
      ((Pair t1 None) (Pair t1 None))
      ((Pair t1 (Some (Pair fv body))) (open_lams t1 body (- k 1) (Cons fv acc))))))
;; the locals' E types, each from a closed L type
(fn local_etypes ((t Tr) (fvs (List Expr)) (acc (List EType))) (Pair Tr (Option (List EType)))
  (measure (struct fvs))
  (match fvs
    (Nil (Pair t (Some (rev acc))))
    ((Cons fv r)
     (match (tr_type_of_local t fv)
       (None (Pair t None))
       ((Some ty)
        (if (has_fvar ty) (Pair t None)
          (match (l_to_etype (Tr.w t) (Tr.es t) (Tr.sc t) ty Nil Nil)
            ((Pair (Pair w1 es1) None) (Pair (tr_set_es (tr_set_w t w1) es1) None))
            ((Pair (Pair w1 es1) (Some ety)) (local_etypes (tr_set_es (tr_set_w t w1) es1) r (Cons ety acc))))))))))
(fn local_ltypes ((t Tr) (fvs (List Expr)) (acc (List Expr))) (Pair Tr (List Expr))
  (measure (struct fvs))
  (match fvs
    (Nil (Pair t (rev acc)))
    ((Cons fv r) (local_ltypes t r (Cons (match (tr_type_of_local t fv) ((Some ty) ty) (None (mk_sort LZero))) acc)))))
(fn nones_of ((k Int)) (List (Option Expr)) (measure k) (if (lt k 1) Nil (Cons None (nones_of (- k 1)))))
;; the lifted body's variables: its binders innermost, the captured locals after them, and the
;; caller's entries that are no runtime variable (a mentioned one was refused; the rest are unread)
(fn lifted_env ((env (List ErEnt)) (captured (List Expr)) (bfvs (List Expr))) (List ErEnt)
  (append (rev (var_ents bfvs)) (append (rev (var_ents captured)) (non_var_ents env))))
(fn var_ents ((fvs (List Expr))) (List ErEnt)
  (measure (struct fvs))
  (match fvs (Nil Nil) ((Cons fv r) (Cons (ErEnt (fvar_id_of fv) EKVar) (var_ents r)))))
(fn non_var_ents ((env (List ErEnt))) (List ErEnt)
  (measure (struct env))
  (match env
    (Nil Nil)
    ((Cons (ErEnt _ EKVar) r) (non_var_ents r))
    ((Cons x r) (Cons x (non_var_ents r)))))
;; the instance's name: MODULE.TEMPLATE_flat[_TYPE…].of.SHAPE… — the taking module's, the
;; template flattened with its type arguments (derive's precedent, std.derive.List_UInt8.decEq),
;; `of`, then each shape as its identity flattened and its captured count
(fn instance_name ((sc Scope) (c Name) (tye (List EType)) (shapes (List Shape))) Name
  (name_append (qualify sc (n2 (sym_of_chars (append (flat_name c) (flat_etys tye))) (quote of))) (shape_name_chain shapes)))
(fn shape_name_chain ((ss (List Shape))) Name
  (measure (struct ss))
  (match ss
    (Nil Anon)
    ((Cons s r) (name_append (n1 (sym_of_chars (shape_text s))) (shape_name_chain r)))))
(fn shape_text ((s Shape)) (List Int) (append (flat_name (shape_id s)) (Cons 95 (show_nat (len (shape_captured s))))))
(fn shape_record ((s Shape)) (List Int) (append (show_name (shape_id s)) (Cons 47 (show_nat (len (shape_captured s))))))
(fn flat_name ((n Name)) (List Int) (flat_chars (show_name n)))
(fn flat_chars ((cs (List Int))) (List Int)
  (measure (struct cs))
  (match cs (Nil Nil) ((Cons c r) (Cons (if (int_eq c 46) 95 c) (flat_chars r)))))
(fn flat_etys ((ts (List EType))) (List Int)
  (measure (struct ts))
  (match ts (Nil Nil) ((Cons t r) (append (Cons 95 (flat_ety t)) (flat_etys r)))))
(fn flat_ety ((t EType)) (List Int)
  (measure (struct t))
  (match t
    ((ETVar i) (Cons 84 (show_nat i)))
    ((ETCon n as) (append (flat_name n) (flat_etys as)))))
