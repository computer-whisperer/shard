;;; v3/kernel/prove.shard — the producer's driver:
;;;   eval direct v3/kernel/prove.shard --root DIR [--init EXPORT --init-index INDEX] [--fuel N] FILE…
;;;   eval direct v3/kernel/prove.shard --root DIR [--init EXPORT --init-index INDEX] --measure FILE…
;;; `--init` and `--init-index` as load.shard's; `--fuel N` the fuel of a tactic's run.
;;; loads each FILE as load.shard does, under the mode `solve`: an `auto` theorem (a
;;; fulfills, a discharge) without a valid sidecar entry is the engine's (engine.shard) —
;;; or, delegated `(auto (tactic M.FN) HINT…)`, the named library fn's, run under ev on the
;;; loaded programs with the goal and the hints as text —
;;; and the block it finds is replayed before it is accepted. Then the sidecar of every
;;; file that gained a block, or whose sidecar was read at an older schema or another
;;; reconstruction version (the restamp), is rewritten whole — FILE.auto.shard, machine-owned:
;;; the entries it held that were not superseded, then the new ones in the file's order, one
;;; `(proof-for NAME (req S D P E) (by STEP…))` per theorem — the key the resolved
;;; requirement's —, under a header naming the engine's version; a
;;; schema-2 entry that replays is re-keyed so (the restamp, no search). The file's form is
;;; `(sidecar SCHEMA RECON)`, RECON the reconstruction version (tactic.shard). The records are
;;; printed as the loader's are (PROVED NAME req=S.D.P.E (by …) for each solved theorem; an
;;; unsolved one stays PENDING auto_unsolved with its goal),
;;; then the counts; the exit code is refused + errors + the theorems left unsolved. No
;;; source file is written.
;;; `--measure`: the files load under the mode `measure` —
;;; every hand-written proof is read as the build reads it and the engine is also run on
;;; its statement, unaided — and the ENGINE records are printed with the count
;;; (`ENGINE: solved S of N`); nothing is written.

(import "loader.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.engine)
(use kernel.host)
(use kernel.loader)
(use kernel.name)
(use kernel.reader)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.tactic)
(use kernel.util)
(use kernel.host.World)
(use kernel.loader.Rec)
(use kernel.sexpr.RAll)
(use kernel.reader.Auto)
(use kernel.reader.Req)

(type PArgs (PArgs (List Int) (List Int) (List Int) (List (List Int)) Bool Int))  ; root, the export, its index, files, measure, the fuel for a tactic's run
(fn parse_pargs ((args (List (List Int))) (a PArgs)) PArgs
  (measure (struct args))
  (match a
    ((PArgs root export index files measure fuel)
     (match args
       (nil (PArgs root export index (rev files) measure fuel))
       ((cons x r)
        (if (int_list_eq x (utf8 "--root"))
          (match r
            ((cons v r2) (parse_pargs r2 (PArgs v export index files measure fuel)))
            (nil (parse_pargs nil a)))
        (if (int_list_eq x (utf8 "--init"))
          (match r
            ((cons v r2) (parse_pargs r2 (PArgs root v index files measure fuel)))
            (nil (parse_pargs nil a)))
        (if (int_list_eq x (utf8 "--init-index"))
          (match r
            ((cons v r2) (parse_pargs r2 (PArgs root export v files measure fuel)))
            (nil (parse_pargs nil a)))
        (if (int_list_eq x (utf8 "--fuel"))
          (match r
            ((cons v r2)
             (parse_pargs r2
               (PArgs root export index files measure
                 (match (read_nat v)
                   ((some k) k)
                   (none fuel)))))
            (nil (parse_pargs nil a)))
        (if (int_list_eq x (utf8 "--measure"))
          (parse_pargs r (PArgs root export index files true fuel))
          (parse_pargs r (PArgs root export index (cons x files) measure fuel))))))))))))
(fn read_nat ((s (List Int))) (Option Int)
  (if (bool_and (< 0 (len s)) (all_digits s)) (some (digits_val s 0)) none))

(fn prove_files ((l Load) (files (List (List Int))) (w World)) (Prod Load World)
  (measure (struct files))
  (match files
    (nil (Prod.mk l w))
    ((cons f r)
     (match (load_root_file l f w)
       ((Prod.mk l1 w1) (prove_files l1 r w1))))))
(fn print_precs ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs
    (nil w)
    ((cons x r) (print_precs r (write_line (show_rec x) w)))))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match (parse_pargs args (PArgs nil nil nil nil false (default_fuel)))
       ((PArgs root export index files measure fuel)
        (match (parts_of root)
          (none (exit 2 (write_line (utf8 "prove: --root DIR is required") w1)))
          ((some rootp)
           (if (= (len rootp) 0) (exit 2 (write_line (utf8 "prove: --root DIR is required") w1))
           (let ((l0 (ld_with_fuel (ld_start rootp export index) fuel)))
             (if measure (main_measure l0 files w1) (main_solve l0 files w1)))))))))))

;; ---- solve -------------------------------------------------------------------------------------
(fn main_solve ((l0 Load) (files (List (List Int))) (w World)) World
  (match
    (prove_files (ld_with_mode l0 (sym "solve")) files
      (write_line
        (append (utf8 "PROVE root=")
          (append (join_path (Load.root l0))
            (append (utf8 " engine_version=") (show_nat (engine_version)))))
        w))
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (match
         (write_sidecars l
           (with_restamps (proved_by_file (ld_recs l) nil) (restamp_files (ld_recs l) nil))
           w2)
         ((Prod.mk written w3)
          (exit (+ (load_failures cs) (unsolved (ld_recs l)))
            (write_line
              (append (utf8 "PROVE: ")
                (append (show_counts_load cs)
                  (append (utf8 "  proved ")
                    (append (show_nat (proved (ld_recs l)))
                      (append (utf8 "  unsolved ")
                        (append (show_nat (unsolved (ld_recs l)))
                          (append (utf8 "  sidecars written ") (show_nat written))))))))
              (print_precs (ld_recs l) w3)))))))))
;; a record as it was made: one of an implementation's check stands under IMPL in the load's records
(fn impl_inner ((x Rec)) Rec
  (measure (struct x))
  (match x
    ((RImplRec y) (impl_inner y))
    (_ x)))
(fn proved ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons x r)
     (match (impl_inner x)
       ((RProved _ _ _ _ _) (+ 1 (proved r)))
       (_ (proved r))))))
;; the theorems the engine did not close: PENDING auto_unsolved
(fn unsolved ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons x r)
     (match (impl_inner x)
       ((RPending _ why)
        (+ (if (starts_with (chars_of_sym why) (utf8 "auto_unsolved")) 1 0) (unsolved r)))
       (_ (unsolved r))))))
(fn starts_with ((s (List Int)) (p (List Int))) Bool (int_list_eq (take (len p) s) p))

;; the files whose sidecar was read at an older schema or another reconstruction version
;; (SIDECAR, RECON): rewritten whole at the current form with their entries as they stand —
;; the restamp, no search
(fn restamp_files ((rs (List Rec)) (acc (List (List Int)))) (List (List Int))
  (measure (struct rs))
  (match rs
    (nil (rev acc))
    ((cons x r)
     (match (impl_inner x)
       ((RSidecar file _ _) (restamp_files r (if (mem_bytes_p file acc) acc (cons file acc))))
       ((RRecon file _ _) (restamp_files r (if (mem_bytes_p file acc) acc (cons file acc))))
       (_ (restamp_files r acc))))))
(fn mem_bytes_p ((x (List Int)) (xs (List (List Int)))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (int_list_eq x y) true (mem_bytes_p x r)))))
;; the groups with a (file, no new entries) group per restamped file not already in them
(fn with_restamps ((gs (List (Prod (List Int) (List Auto)))) (files (List (List Int))))
  (List (Prod (List Int) (List Auto)))
  (measure (struct files))
  (match files
    (nil gs)
    ((cons f r) (with_restamps (if (group_has gs f) gs (append gs (list (Prod.mk f nil)))) r))))
(fn group_has ((gs (List (Prod (List Int) (List Auto)))) (f (List Int))) Bool
  (measure (struct gs))
  (match gs
    (nil false)
    ((cons (Prod.mk g _) r) (if (int_list_eq g f) true (group_has r f)))))
;; the PROVED records grouped by the file their proof stands in — an implementation's among
;; them, under its own file: (file, entries)
(fn proved_by_file ((rs (List Rec)) (acc (List (Prod (List Int) (List Auto)))))
  (List (Prod (List Int) (List Auto)))
  (measure (struct rs))
  (match rs
    (nil (rev_groups acc nil))
    ((cons x r)
     (match (impl_inner x)
       ((RProved _ en file k steps) (proved_by_file r (group_add acc file (Auto en k steps))))
       (_ (proved_by_file r acc))))))
(fn group_add ((acc (List (Prod (List Int) (List Auto)))) (file (List Int)) (a Auto))
  (List (Prod (List Int) (List Auto)))
  (measure (struct acc))
  (match acc
    (nil (list (Prod.mk file (list a))))
    ((cons (Prod.mk f as) r)
     (if (int_list_eq f file) (cons (Prod.mk f (cons a as)) r)
     (cons (Prod.mk f as) (group_add r file a))))))
(fn rev_groups
  ((gs (List (Prod (List Int) (List Auto)))) (acc (List (Prod (List Int) (List Auto)))))
  (List (Prod (List Int) (List Auto)))
  (measure (struct gs))
  (match gs
    (nil (rev acc))
    ((cons (Prod.mk f as) r) (rev_groups r (cons (Prod.mk f (rev as)) acc)))))

;; the sidecars rewritten: each file's existing entries not superseded, then the new ones
(fn write_sidecars ((l Load) (groups (List (Prod (List Int) (List Auto)))) (w World))
  (Prod Int World)
  (measure (struct groups))
  (match groups
    (nil (Prod.mk 0 w))
    ((cons (Prod.mk file news) r)
     (let
       ((path
          (append
            (drop_shard_suffix
              (join_path
                (append (Load.root l)
                  (match (parts_of file)
                    ((some ps) ps)
                    (none nil)))))
            (utf8 ".auto.shard"))))
       (match (read_file path w)
         ((Prod.mk bytes w1)
          (let
            ((olds (List Auto)
               (match bytes
                 ((some src)
                  (match (read_all src)
                    ((RAOk es)
                     (match (sidecar_split es)
                       ((Prod.mk (some (Prod.mk (Prod.mk _ _) rest)) _)
                        (match (sidecar_entries rest nil)
                          ((Prod.mk (some as) _) as)
                          (_ nil)))
                       (_ nil)))
                    (_ nil)))
                 (none nil))))
            (match (write_file path (render_sidecar (append (not_superseded olds news) news)) w1)
              ((Prod.mk ok w2)
               (match (write_sidecars l r w2)
                 ((Prod.mk k w3)
                  (Prod.mk (+ k (if ok 1 0))
                    (if ok w3 (write_line (append (utf8 "PROVE: could not write ") path) w3))))))))))))))
(fn not_superseded ((olds (List Auto)) (news (List Auto))) (List Auto)
  (measure (struct olds))
  (match olds
    (nil nil)
    ((cons (Auto n k steps) r)
     (if (names_has news n) (not_superseded r news) (cons (Auto n k steps) (not_superseded r news))))))
(fn names_has ((as (List Auto)) (n Name)) Bool
  (measure (struct as))
  (match as
    (nil false)
    ((cons (Auto m _ _) r) (if (name_eq m n) true (names_has r n)))))
;; the file whole: the header comment (the engine's version, the producer's), the schema form
;; (I's schema the entries are written in — the loader refuses a newer one —
;; and the reconstruction version), then the entries
(fn render_sidecar ((as (List Auto))) (List Int)
  (append (utf8 ";; machine-owned: written by v3/kernel/prove.shard (engine version ")
    (append (show_nat (engine_version))
      (append
        (utf8
          "); one entry per theorem, keyed by the resolved requirement it proves (req STATEMENT DEPS POLICY ENV)\n(sidecar ")
        (append (show_nat (sidecar_schema))
          (append (utf8 " ")
            (append (show_nat (reconstruction_version)) (append (utf8 ")\n") (render_entries as)))))))))
(fn render_entries ((as (List Auto))) (List Int)
  (measure (struct as))
  (match as
    (nil nil)
    ((cons (Auto n k steps) r)
     (append (utf8 "(proof-for ")
       (append (show_name n)
         (append (utf8 " ")
           (append (render_key k)
             (append (utf8 " (by ")
               (append (show_sexprs steps) (append (utf8 "))\n") (render_entries r)))))))))))
;; (req S D P E); a statement-only key (an entry kept from an older schema) as it was
(fn render_key ((k Req)) (List Int)
  (match k
    ((ReqFull s d p e)
     (append (utf8 "(req ")
       (append (show_int s)
         (cons 32
           (append (show_int d)
             (cons 32 (append (show_int p) (cons 32 (append (show_int e) (utf8 ")"))))))))))
    ((ReqStmt s) (show_int s))))

;; ---- measure -----------------------------------------------------------------------------------
(fn main_measure ((l0 Load) (files (List (List Int))) (w World)) World
  (match
    (prove_files (ld_with_mode l0 (sym "measure")) files
      (write_line
        (append (utf8 "MEASURE root=")
          (append (join_path (Load.root l0))
            (append (utf8 " engine_version=") (show_nat (engine_version)))))
        w))
    ((Prod.mk l w2)
     (let ((cs (rec_counts (ld_recs l) (zero_counts))))
       (exit (load_failures cs)
         (write_line
           (append (utf8 "ENGINE: solved ")
             (append (show_nat (engine_solved (ld_recs l)))
               (append (utf8 " of ") (show_nat (engine_tried (ld_recs l))))))
           (write_line (append (utf8 "LOAD: ") (show_counts_load cs)) (print_precs (ld_recs l) w2))))))))
(fn engine_solved ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons (REngine _ ok) r) (+ (if ok 1 0) (engine_solved r)))
    ((cons _ r) (engine_solved r))))
(fn engine_tried ((rs (List Rec))) Int
  (measure (struct rs))
  (match rs
    (nil 0)
    ((cons (REngine _ _) r) (+ 1 (engine_tried r)))
    ((cons _ r) (engine_tried r))))
