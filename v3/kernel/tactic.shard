;;; v3/kernel/tactic.shard — the step elaborator. A `theorem`'s proof may be `(by STEP…)`: the
;;; block is I's concrete syntax, read into `Node` (one constructor per form)
;;; and elaborated to P — one closed proof term K checks as the theorem's
;;; value — without search: every step is a function of its node, the goal
;;; and the environment.
;;;
;;; A goal is a metavariable whose type is the goal's statement closed over
;;; its named context (`Goal`: the id, the closed statement, the context's
;;; size); an occurrence of a goal in a term is the metavariable applied to
;;; the context's locals, so closing a binder abstracts the occurrence's
;;; arguments and never the hole — a contextual hole, by construction.
;;; `tac_step` opens the context as K locals, acts on the target and answers
;;; the goal's filling (a closed term over the subgoals' occurrences) with
;;; the subgoals; `tac_block` runs a block's nodes on one goal, the children
;;; of a branching node inline, depth-first, and assigns each filling;
;;; `tac_prove` instantiates the root. `sorry` leaves its goal unassigned
;;; and the theorem pending.
;;;
;;; `arith` is a Farkas certificate over the goal's rows (arith.shard) and
;;; `simp_only` a bounded rewriter over a rule list; every new goal's
;;; statement and every lemma's equation enter in the source's spelling of
;;; Init's class methods (spelling.shard's `sp_canon`), so a rewrite and an
;;; assumption match across the two.
;;;
;;; Untrusted, as the elaborator is: K rechecks the closed term.

(import "elab.shard")
(import "arith.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.arith)
(use kernel.elab)
(use kernel.expr)
(use kernel.kw)
(use kernel.level)
(use kernel.name)
(use kernel.scope)
(use kernel.scope.Open)
(use kernel.sexpr)
(use kernel.spelling)
(use kernel.sym)
(use kernel.unify)
(use kernel.util)
(use kernel.decl)
(use kernel.descent)
(use kernel.matcher)
(use kernel.arith.ARel)
(use kernel.arith.ARes)
(use kernel.arith.Lin)
(use kernel.elab.El)
(use kernel.elab.ERes)
(use kernel.elab.EU)
(use kernel.elab.FinRes)
(use kernel.matcher.MtDesc)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.kw.WOut)
(use kernel.decl.ConstantInfo)
(use kernel.decl.ConstantVal)
(use kernel.level.Level)
(use kernel.name.Name)
(use kernel.sexpr.SExpr)
(use kernel.unify.URes)

;; the reconstruction version: the version of the I → P elaboration this file performs. A
;; sidecar's form `(sidecar SCHEMA RECON)` names the version its entries were last replayed
;; under; a sidecar at another version is replayed and reported (loader.shard RECON), and
;; `prove` rewrites it at this one. Version 2: `reduce`, `unfold` and `simp_only` compose
;; their steps' equations under one Eq.mpr per step of I (evidence of version 1 has an Eq.mpr
;; per rewrite, with K-convertible steps left to conversion).
(fn reconstruction_version () Int 2)

;; ---- I's data ----------------------------------------------------------------------------
;; a goal: its metavariable, its statement closed over the named context, the context's size
(type Goal (Goal Int Expr Int))
(fn goal_id ((g Goal)) Int
  (match g
    ((Goal i _ _) i)))
(fn goal_stmt ((g Goal)) Expr
  (match g
    ((Goal _ s _) s)))
(fn goal_nctx ((g Goal)) Int
  (match g
    ((Goal _ _ n) n)))

;; a node of I: one constructor per form, its arguments as data; a branching node carries its
;; children's blocks inline — an arm is a node of its own kind, never read at a block's head
(type Node
  (NIntro (List Name))  ; (intro NAME…)
  (NExact SExpr)  ; (exact TERM)
  (NRfl)  ; rfl
  (NHave Name SExpr (List Node))  ; (have NAME PROP STEP…)
  (NShow SExpr)  ; (show PROP)
  (NApply SExpr (List Node))  ; (apply TERM (STEP…)…): the premises' blocks as NBlock
  (NCases SExpr (Option Name) (List Node))  ; (cases X H? ((CTOR (NAME…) STEP…)…)): arms as NArm; H names the equation X = CTOR … in each arm
  (NInduction SExpr (Option Name) (List Node))  ; (induction X H? ((CTOR (NAME… IH…) STEP…)…))
  (NWf SExpr SExpr Name (List Node))  ; (wf LOCAL MEASURE IH STEP…)
  (NDecide)  ; decide
  (NUnfold (List Name))  ; (unfold NAME…)
  (NReduce Symbol (List (Prod Bool SExpr)))  ; (reduce SIDE? (using RULE…)?): the side (both, lhs, rhs); the rules, each a lemma and whether it is reversed
  (NRw Bool SExpr Int (Option SExpr) (List Node))  ; (rw LEMMA | (<- LEMMA)) (occ K EXPECT?)? (STEP…)…: K = 0 is every occurrence; EXPECT the instance expected at the occurrence (refused rw_occ_changed when another is found)
  (NSorry)  ; sorry
  (NArith Bool (List SExpr) (List (List Int)))  ; (arith only? FACT… (farkas K…)?): only (no context row), the facts, the certificates given (two for an equation)
  (NSimp (List (Prod Bool SExpr)))  ; (simp_only RULE…): each a lemma and whether it is reversed
  (NBlock (List Node))  ; a child block of apply or rw
  (NArm Name (List Name) (List Node)))  ; an arm of cases or induction

;; ---- reading a block -----------------------------------------------------------------------
(type NodeRes (NROk Node) (NRErr Symbol (List Int)))
(type BlockRes (BROk (List Node)) (BRErr Symbol (List Int)))
(fn read_block ((ss (List SExpr))) BlockRes (read_block_go ss nil))
(fn read_block_go ((ss (List SExpr)) (acc (List Node))) BlockRes
  (measure (struct ss))
  (match ss
    (nil (BROk (rev acc)))
    ((cons s r)
     (match (read_node s)
       ((NRErr x m) (BRErr x m))
       ((NROk nd) (read_block_go r (cons nd acc)))))))
(fn read_node ((s SExpr)) NodeRes
  (match s
    ((SSym x)
     (if (sym_eq x (sym "rfl")) (NROk (NRfl))
     (if (sym_eq x (sym "sorry")) (NROk (NSorry))
     (if (sym_eq x (sym "decide")) (NROk (NDecide))
     (if (sym_eq x (sym "reduce")) (NROk (NReduce (sym "both") nil))
     (if (sym_eq x (sym "arith")) (NROk (NArith false nil nil))
     (NRErr (sym "unknown_step")
       (append (chars_of_sym x)
         (utf8
           ": not a form of I (rfl, sorry, decide, reduce, arith, or a list); a new tactic is an E library producing these forms, named by (auto (tactic M.FN))")))))))))
    ((SList (cons (SSym h) args))
     (if (sym_eq h (sym "intro")) (read_names args nil (sym "intro"))
     (if (sym_eq h (sym "exact"))
       (match args
         ((cons t nil) (NROk (NExact t)))
         (_ (NRErr (sym "bad_step") (utf8 "(exact TERM)"))))
     (if (sym_eq h (sym "rfl"))
       (match args
         (nil (NROk (NRfl)))
         (_ (NRErr (sym "bad_step") (utf8 "rfl takes no argument"))))
     (if (sym_eq h (sym "decide"))
       (match args
         (nil (NROk (NDecide)))
         (_ (NRErr (sym "bad_step") (utf8 "decide takes no argument"))))
     (if (sym_eq h (sym "sorry"))
       (match args
         (nil (NROk (NSorry)))
         (_ (NRErr (sym "bad_step") (utf8 "sorry takes no argument"))))
     (if (sym_eq h (sym "show"))
       (match args
         ((cons t nil) (NROk (NShow t)))
         (_ (NRErr (sym "bad_step") (utf8 "(show PROP)"))))
     (if (sym_eq h (sym "have")) (read_have args)
     (if (sym_eq h (sym "apply")) (read_apply args)
     (if (sym_eq h (sym "cases")) (read_cases args false)
     (if (sym_eq h (sym "induction")) (read_cases args true)
     (if (sym_eq h (sym "wf")) (read_wf args)
     (if (sym_eq h (sym "unfold")) (read_names args nil (sym "unfold"))
     (if (sym_eq h (sym "reduce")) (read_reduce args)
     (if (sym_eq h (sym "rw")) (read_rw args)
     (if (sym_eq h (sym "arith")) (read_arith args nil nil)
     (if (sym_eq h (sym "simp_only")) (read_simp args nil)
     (NRErr (sym "unknown_step")
       (append (chars_of_sym h)
         (utf8
           ": not a form of I (intro exact rfl have show apply cases induction wf decide unfold reduce rw simp_only arith sorry); a new tactic is an E library producing these forms, named by (auto (tactic M.FN))"))))))))))))))))))))
    (_ (NRErr (sym "bad_step") (utf8 "a step is a symbol or (FORM …)")))))
(fn read_names ((ss (List SExpr)) (acc (List Name)) (form Symbol)) NodeRes
  (measure (struct ss))
  (match ss
    (nil
      (match acc
        (nil
          (NRErr (sym "bad_step")
            (append (utf8 "(") (append (chars_of_sym form) (utf8 " NAME…) names at least one")))))
        (_ (if (sym_eq form (sym "intro")) (NROk (NIntro (rev acc))) (NROk (NUnfold (rev acc)))))))
    ((cons (SSym x) r)
     (match (name_of_sym x)
       ((some n) (read_names r (cons n acc) form))
       (none (NRErr (sym "bad_step") (append (chars_of_sym x) (utf8 ": not a name"))))))
    (_
      (NRErr (sym "bad_step")
        (append (utf8 "(") (append (chars_of_sym form) (utf8 " NAME…): a name is a symbol")))))))
(fn read_have ((args (List SExpr))) NodeRes
  (match args
    ((cons (SSym x) (cons prop steps))
     (match (name_of_sym x)
       (none (NRErr (sym "bad_step") (append (chars_of_sym x) (utf8 ": not a name"))))
       ((some n)
        (match steps
          (nil
            (NRErr (sym "bad_step")
              (utf8 "(have NAME PROP STEP…): the block that proves PROP is empty")))
          (_
            (match (read_block steps)
              ((BRErr e m) (NRErr e m))
              ((BROk b) (NROk (NHave n prop b)))))))))
    (_ (NRErr (sym "bad_step") (utf8 "(have NAME PROP STEP…)")))))
(fn read_apply ((args (List SExpr))) NodeRes
  (match args
    ((cons t blocks)
     (match (read_blocks blocks nil)
       ((BRErr e m) (NRErr e m))
       ((BROk bs) (NROk (NApply t bs)))))
    (_ (NRErr (sym "bad_step") (utf8 "(apply TERM (STEP…)…)")))))
;; the child blocks of apply and rw: each a list of steps, as NBlock; a list headed by a form's
;; name is one step (`(exact h)`), so a one-step block needs no second parenthesis
(fn read_blocks ((ss (List SExpr)) (acc (List Node))) BlockRes
  (measure (struct ss))
  (match ss
    (nil (BROk (rev acc)))
    ((cons (SList (cons (SSym h) rest)) r)
     (match
       (read_block (if (tac_form_head h) (list (SList (cons (SSym h) rest))) (cons (SSym h) rest)))
       ((BRErr e m) (BRErr e m))
       ((BROk b) (read_blocks r (cons (NBlock b) acc)))))
    ((cons (SList steps) r)
     (match (read_block steps)
       ((BRErr e m) (BRErr e m))
       ((BROk b) (read_blocks r (cons (NBlock b) acc)))))
    (_ (BRErr (sym "bad_step") (utf8 "a premise's block is (STEP…)")))))
(fn tac_form_head ((h Symbol)) Bool
  (mem_sym h
    (list (sym "intro") (sym "exact") (sym "rfl") (sym "have") (sym "show") (sym "apply")
      (sym "cases")
      (sym "induction")
      (sym "wf")
      (sym "decide")
      (sym "unfold")
      (sym "reduce")
      (sym "rw")
      (sym "simp_only")
      (sym "arith")
      (sym "sorry"))))

(fn read_cases ((args (List SExpr)) (ind Bool)) NodeRes
  (match args
    ((cons t (cons (SList arms) nil))
     (match (read_arms arms nil)
       ((BRErr e m) (NRErr e m))
       ((BROk as) (if ind (NROk (NInduction t none as)) (NROk (NCases t none as))))))
    ((cons t (cons (SSym hn) (cons (SList arms) nil)))
     (match (name_of_sym hn)
       (none (NRErr (sym "bad_step") (append (chars_of_sym hn) (utf8 ": not a name"))))
       ((some h)
        (match (read_arms arms nil)
          ((BRErr e m) (NRErr e m))
          ((BROk as) (if ind (NROk (NInduction t (some h) as)) (NROk (NCases t (some h) as))))))))
    (_
      (NRErr (sym "bad_step")
        (utf8
          "(cases X ((CTOR (NAME…) STEP…)…)) or (cases X H ((CTOR …)…)) — the arms in one list, H the name of the equation X = CTOR … in each arm")))))
(fn read_arms ((ss (List SExpr)) (acc (List Node))) BlockRes
  (measure (struct ss))
  (match ss
    (nil (BROk (rev acc)))
    ((cons (SList (cons (SSym c) (cons (SList vars) steps))) r)
     (match (name_of_sym c)
       (none (BRErr (sym "bad_step") (append (chars_of_sym c) (utf8 ": not a constructor name"))))
       ((some cn)
        (match (read_arm_names vars nil)
          (none (BRErr (sym "bad_step") (utf8 "an arm's names are symbols")))
          ((some ns)
           (match (read_block steps)
             ((BRErr e m) (BRErr e m))
             ((BROk b) (read_arms r (cons (NArm cn ns b) acc)))))))))
    (_
      (BRErr (sym "bad_step") (utf8 "an arm is (CTOR (NAME…) STEP…), with the names in a list")))))
(fn read_arm_names ((ss (List SExpr)) (acc (List Name))) (Option (List Name))
  (measure (struct ss))
  (match ss
    (nil (some (rev acc)))
    ((cons (SSym x) r)
     (match (name_of_sym x)
       ((some n) (read_arm_names r (cons n acc)))
       (none none)))
    (_ none)))
(fn read_wf ((args (List SExpr))) NodeRes
  (match args
    ((cons x (cons m (cons (SSym ih) steps)))
     (match (name_of_sym ih)
       (none (NRErr (sym "bad_step") (append (chars_of_sym ih) (utf8 ": not a name"))))
       ((some ihn)
        (match (read_block steps)
          ((BRErr e mm) (NRErr e mm))
          ((BROk b) (NROk (NWf x m ihn b)))))))
    (_ (NRErr (sym "bad_step") (utf8 "(wf LOCAL MEASURE IH STEP…)")))))
(fn read_reduce ((args (List SExpr))) NodeRes
  (match args
    ((cons (SSym side) r)
     (if (bool_or (sym_eq side (sym "lhs")) (sym_eq side (sym "rhs"))) (read_reduce_with side r)
     (NRErr (sym "bad_step") (utf8 "(reduce SIDE? (using RULE…)?): SIDE is lhs or rhs"))))
    (_ (read_reduce_with (sym "both") args))))
(fn read_reduce_with ((side Symbol) (args (List SExpr))) NodeRes
  (match args
    (nil (NROk (NReduce side nil)))
    ((cons (SList (cons (SSym w) rules)) nil)
     (if (sym_eq w (sym "using"))
       (match rules
         (nil (NRErr (sym "bad_step") (utf8 "(using RULE…) names at least one rule")))
         (_ (NROk (NReduce side (read_rules rules nil)))))
       (NRErr (sym "bad_step")
         (utf8 "(reduce SIDE? (using RULE…)?): after the side, (using RULE…) and nothing else"))))
    (_
      (NRErr (sym "bad_step")
        (utf8 "(reduce SIDE? (using RULE…)?): after the side, (using RULE…) and nothing else")))))
(fn read_rules ((ss (List SExpr)) (acc (List (Prod Bool SExpr)))) (List (Prod Bool SExpr))
  (measure (struct ss))
  (match ss
    (nil (rev acc))
    ((cons t r) (read_rules r (cons (rw_lemma t) acc)))))
(fn read_rw ((args (List SExpr))) NodeRes
  (match args
    ((cons lem rest)
     (match (rw_lemma lem)
       ((Prod.mk rev1 t)
        (match rest
          ((cons (SList (cons (SSym o) (cons (SNum k) more))) blocks)
           (if (sym_eq o (sym "occ"))
             (if (< k 1) (NRErr (sym "bad_step") (utf8 "(occ K): K counts from 1"))
             (match more
               (nil
                 (match (read_blocks blocks nil)
                   ((BRErr e m) (NRErr e m))
                   ((BROk bs) (NROk (NRw rev1 t k none bs)))))
               ((cons ex nil)
                (match (read_blocks blocks nil)
                  ((BRErr e m) (NRErr e m))
                  ((BROk bs) (NROk (NRw rev1 t k (some ex) bs)))))
               (_
                 (NRErr (sym "bad_step")
                   (utf8
                     "(occ K) or (occ K EXPECT): the occurrence, and the instance expected there")))))
             (match (read_blocks rest nil)
               ((BRErr e m) (NRErr e m))
               ((BROk bs) (NROk (NRw rev1 t 0 none bs))))))
          (_
            (match (read_blocks rest nil)
              ((BRErr e m) (NRErr e m))
              ((BROk bs) (NROk (NRw rev1 t 0 none bs)))))))))
    (_
      (NRErr (sym "bad_step")
        (utf8 "(rw LEMMA (occ K EXPECT?)? (STEP…)…) or (rw (<- LEMMA) …)")))))
;; (arith FACT… (farkas K…)…): the facts, then the certificates
(fn read_arith ((args (List SExpr)) (facts (List SExpr)) (certs (List (List Int)))) NodeRes
  (match args
    ((cons (SSym o) r)
     (if (sym_eq o (sym "only")) (read_arith_go r true facts certs)
     (read_arith_go args false facts certs)))
    (_ (read_arith_go args false facts certs))))
(fn read_arith_go ((args (List SExpr)) (only Bool) (facts (List SExpr)) (certs (List (List Int))))
  NodeRes
  (measure (struct args))
  (match args
    (nil (NROk (NArith only (rev facts) (rev certs))))
    ((cons (SList (cons (SSym h) ks)) r)
     (if (sym_eq h (sym "farkas"))
       (match (read_ints ks nil)
         (none (NRErr (sym "bad_step") (utf8 "(farkas K…): a weight is an integer")))
         ((some ws) (read_arith_go r only facts (cons ws certs))))
       (match certs
         (nil (read_arith_go r only (cons (SList (cons (SSym h) ks)) facts) certs))
         (_
           (NRErr (sym "bad_step")
             (utf8 "(arith FACT… (farkas K…)): the certificate comes after the facts"))))))
    ((cons t r)
     (match certs
       (nil (read_arith_go r only (cons t facts) certs))
       (_
         (NRErr (sym "bad_step")
           (utf8 "(arith FACT… (farkas K…)): the certificate comes after the facts")))))))
(fn read_ints ((ss (List SExpr)) (acc (List Int))) (Option (List Int))
  (measure (struct ss))
  (match ss
    (nil (some (rev acc)))
    ((cons (SNum k) r) (read_ints r (cons k acc)))
    (_ none)))
;; (simp_only RULE…): each rule a lemma or (<- LEMMA)
(fn read_simp ((args (List SExpr)) (acc (List (Prod Bool SExpr)))) NodeRes
  (measure (struct args))
  (match args
    (nil
      (match acc
        (nil (NRErr (sym "bad_step") (utf8 "(simp_only RULE…) names at least one rule")))
        (_ (NROk (NSimp (rev acc))))))
    ((cons t r) (read_simp r (cons (rw_lemma t) acc)))))
;; (<- LEMMA) reverses the equation
(fn rw_lemma ((s SExpr)) (Prod Bool SExpr)
  (match s
    ((SList (cons (SSym a) (cons t nil)))
     (if (sym_eq a (sym "<-")) (Prod.mk true t) (Prod.mk false s)))
    (_ (Prod.mk false s))))

;; ---- goals: open, close, make, show ------------------------------------------------------
;; the context of a goal as K locals and its target: the first `nctx` binders of the
;; statement, each a fresh local under its binder's name
(type Opened (Opened El (List Expr) Expr))
;; zonked: a witness assigned by an earlier block shows
(fn tac_open ((e El) (g Goal)) Opened (tac_open_go e (el_zonk e (goal_stmt g)) (goal_nctx g) nil))
(fn tac_open_go ((e El) (t Expr) (k Int) (acc (List Expr))) Opened
  (measure (Int.natAbs k))
  (if (< k 1) (Opened e (rev acc) t)
  (match t
    ((Pi _ n bi dom body)
     (match (el_local e n dom bi)
       ((Prod.mk e1 fv)
        (match (w_inst1 (el_w e1) body fv)
          ((Prod.mk w2 body1) (tac_open_go (el_set_w e1 w2) body1 (- k 1) (cons fv acc)))))))
    (_ (Opened e (rev acc) t)))))
(fulfills tac_open_go.dec_1
  (by (intro p h a n bi dom body hm e1 fv hm1 w2 body1 hm2) (apply natAbs_pred (arith))))
;; a new goal over the locals `ctx` with the target: its metavariable has the closed statement
;; as its type and no telescope; its occurrence is the metavariable applied to `ctx`. The
;; statement enters in the one spelling (a hypothesis or a premise that came from one of
;; Init's lemmas reads `Int.lt n 10` as the source's do, so a rewrite and an assumption match
;; it; K converts the occurrence)
(type Made (Made El Goal Expr))
(fn tac_goal ((e El) (ctx (List Expr)) (target Expr)) Made
  (match (el_pis e ctx target)
    ((Prod.mk e1 stmt0)
     (let ((stmt (sp_canon (el_zonk e1 stmt0))))
       (match (el_fresh e1 (n1 (sym "goal")) stmt (sym "goal"))
         ((Prod.mk e2 (MVar _ i)) (Made e2 (Goal i stmt (len ctx)) (mk_app_n (mk_mvar i) ctx)))
         ((Prod.mk e2 m) (Made e2 (Goal 0 stmt (len ctx)) m)))))))
;; the context without the local `x`, when no other local's type mentions it (wf replaces it by
;; its hypothesis's local; a dependent would be left speaking of the old local, so then it
;; stays); the occurrence of a goal over the smaller context still closes, K's mk_binding
;; abstracting only what the term mentions. cases and induction revert the dependents instead
;; (ctx_dependents) and the eliminated local always leaves
(fn ctx_without ((e El) (ctx (List Expr)) (x Expr)) (List Expr)
  (match x
    ((FVar _ id) (if (ctx_depends e ctx id) ctx (remove_local ctx id)))
    (_ ctx)))
(fn ctx_depends ((e El) (ctx (List Expr)) (id Int)) Bool
  (measure (struct ctx))
  (match ctx
    (nil false)
    ((cons (FVar _ j) r)
     (if (= j id) (ctx_depends e r id)
     (match (w_local_type (el_w e) j)
       ((some ty) (if (mem_int id (expr_fvars ty nil)) true (ctx_depends e r id)))
       (none (ctx_depends e r id)))))
    ((cons _ r) (ctx_depends e r id))))
;; the locals of the context whose types mention `x` — transitively, in the context's order (a
;; later local's type may mention an earlier dependent); none for a term scrutinee
(fn ctx_dependents ((e El) (ctx (List Expr)) (x Expr)) (List Expr)
  (match x
    ((FVar _ id) (ctx_dependents_go e ctx (list id) nil))
    (_ nil)))
(fn ctx_dependents_go ((e El) (ctx (List Expr)) (ids (List Int)) (acc (List Expr))) (List Expr)
  (measure (struct ctx))
  (match ctx
    (nil (rev acc))
    ((cons (FVar d j) r)
     (if (mem_int j ids) (ctx_dependents_go e r ids acc)
     (match (w_local_type (el_w e) j)
       ((some ty)
        (if (ids_meet (expr_fvars ty nil) ids)
          (ctx_dependents_go e r (cons j ids) (cons (FVar d j) acc))
          (ctx_dependents_go e r ids acc)))
       (none (ctx_dependents_go e r ids acc)))))
    ((cons _ r) (ctx_dependents_go e r ids acc))))
;; the context without the given locals
(fn ctx_minus ((ctx (List Expr)) (xs (List Expr))) (List Expr)
  (measure (struct xs))
  (match xs
    (nil ctx)
    ((cons (FVar _ j) r) (ctx_minus (remove_local ctx j) r))
    ((cons _ r) (ctx_minus ctx r))))
(fn local_names ((e El) (xs (List Expr))) (List Name)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (FVar _ j) r) (cons (local_name e j) (local_names e r)))
    ((cons _ r) (local_names e r))))
(fn remove_local ((ctx (List Expr)) (id Int)) (List Expr)
  (measure (struct ctx))
  (match ctx
    (nil nil)
    ((cons (FVar d j) r) (if (= j id) r (cons (FVar d j) (remove_local r id))))
    ((cons o r) (cons o (remove_local r id)))))
;; the filling of a goal: the term over its context, closed
(fn tac_close ((e El) (ctx (List Expr)) (t Expr)) (Prod El Expr) (el_lams e ctx t))
;; the goal's named context and target, rendered
(fn goal_of ((g Goal)) (List Int) (show_goal_go (goal_stmt g) (goal_nctx g) nil))
;; the goal as one S form for a tactic library: the named context in
;; order, the target, and the forms `applicable` answers — `(goal ((NAME TYPE)…) TARGET
;; (applicable SYM…))`; the terms as goal_of shows them
(fn goal_sx ((e El) (g Goal)) (List Int)
  (append (utf8 "(goal (") (goal_sx_go e g (goal_stmt g) (goal_nctx g) nil)))
(fn goal_sx_go ((e El) (g Goal) (t Expr) (k Int) (names (List (List Int)))) (List Int)
  (measure k)
  (if (< k 1)
    (append (utf8 ") ")
      (append (tc_show t names)
        (append (utf8 " (applicable") (append (syms_spaced (applicable e g)) (utf8 "))")))))
    (match t
      ((Pi _ n _ dom body)
       (let ((nm (tc_binder n)))
         (append (utf8 "(")
           (append nm
             (append (utf8 " ")
               (append (tc_show dom names)
                 (append (utf8 ")")
                   (append (if (< 1 k) (utf8 " ") nil) (goal_sx_go e g body (- k 1) (cons nm names))))))))))
      (_
        (append (utf8 ") ")
          (append (tc_show t names)
            (append (utf8 " (applicable") (append (syms_spaced (applicable e g)) (utf8 "))")))))))))
(fn syms_spaced ((ss (List Symbol))) (List Int)
  (measure (struct ss))
  (match ss
    (nil nil)
    ((cons s r) (append (utf8 " ") (append (chars_of_sym s) (syms_spaced r))))))
(fn show_goal_go ((t Expr) (k Int) (names (List (List Int)))) (List Int)
  (measure k)
  (if (< k 1) (append (utf8 "⊢ ") (tc_show t names))
  (match t
    ((Pi _ n _ dom body)
     (let ((nm (tc_binder n)))
       (append (utf8 "(")
         (append nm
           (append (utf8 " : ")
             (append (tc_show dom names)
               (append (utf8 ") ") (show_goal_go body (- k 1) (cons nm names)))))))))
    (_ (append (utf8 "⊢ ") (tc_show t names))))))
;; a binder's name as a goal shows it: its last component, a generated one (a number) as `xN`
;; so it does not read as a literal
(fn tc_binder ((n Name)) (List Int)
  (let ((nm (chars_of_name_last n)))
    (match nm
      ((cons c _) (if (bool_and (<= 48 c) (<= c 57)) (cons 120 nm) nm))
      (nil (utf8 "x")))))
;; a term in S, bound variables by their binder names, locals by `?f`, Eq and the
;; comparisons under their operator spellings, the binders as source writes them —
;; `(forall ((x T)) P)`, `(fun ((x T)) e)`, `(let ((x V)) e)` (one spelling: the goal a tactic
;; reads is the one a refusal shows)
(fn tc_show ((t Expr) (names (List (List Int)))) (List Int)
  (measure (struct t))
  (match t
    ((BVar _ i)
     (match (nth names i)
       ((some nm) nm)
       (none (append (utf8 "#") (show_nat i)))))
    ((FVar _ i) (append (utf8 "?f") (show_nat i)))
    ((MVar _ i) (append (utf8 "?") (show_nat i)))
    ((Sort _ u)
     (if (level_is_zero u) (utf8 "Prop")
     (append (utf8 "(Sort ") (append (show_level u) (utf8 ")")))))
    ((Const _ n _) (show_name n))
    ((App _ _ _) (tc_show_app (get_app_fn t) (get_app_args t) names))
    ((Lam _ n _ dom body)
     (let ((nm (tc_binder n)))
       (append (utf8 "(fun ((")
         (append nm
           (append (utf8 " ")
             (append (tc_show dom names)
               (append (utf8 ")) ") (append (tc_show body (cons nm names)) (utf8 ")")))))))))
    ((Pi _ n _ dom body)
     (if (has_loose_bvar body 0)
       (let ((nm (tc_binder n)))
         (append (utf8 "(forall ((")
           (append nm
             (append (utf8 " ")
               (append (tc_show dom names)
                 (append (utf8 ")) ") (append (tc_show body (cons nm names)) (utf8 ")"))))))))
       (append (utf8 "(-> ")
         (append (tc_show dom names)
           (append (utf8 " ") (append (tc_show body (cons (utf8 "_") names)) (utf8 ")")))))))
    ((Let _ n ty v body)
     (let ((nm (tc_binder n)))
       (append (utf8 "(let ((")
         (append nm
           (append (utf8 " ")
             (append (tc_show v names)
               (append (utf8 ")) ") (append (tc_show body (cons nm names)) (utf8 ")")))))))))
    ((Lit _ (LitNat k)) (show_nat k))
    ((Lit _ (LitStr s)) (append (utf8 "\"") (append s (utf8 "\""))))
    ((Proj _ _ i x)
     (append (utf8 "(proj ")
       (append (show_nat i) (append (utf8 " ") (append (tc_show x names) (utf8 ")"))))))))
(fn tc_show_app ((f Expr) (args (List Expr)) (names (List (List Int)))) (List Int)
  (match f
    ((Const _ n _)
     (if (name_eq n (nm_eq))
       (match args
         ((cons _ rest) (tc_show_args (utf8 "(=") rest names))
         (_ (tc_show_args (append (utf8 "(") (show_name n)) args names)))
       (match (tc_int_literal n args)
         ((some lit) lit)
         (none
           (match (tc_op_spelling n)
             ((some sp) (tc_show_args (append (utf8 "(") sp) args names))
             (none (tc_show_args (append (utf8 "(") (show_name n)) args names)))))))
    (_ (tc_show_args (append (utf8 "(") (tc_show f names)) args names))))
;; an Int literal as source writes it: Int.ofNat 48 is 48, Int.negSucc 0 is -1
(fn tc_int_literal ((n Name) (args (List Expr))) (Option (List Int))
  (match args
    ((cons (Lit _ (LitNat k)) nil)
     (if (name_eq n (nm_int_of_nat)) (some (show_nat k))
     (if (name_eq n (nm_int_neg_succ)) (some (append (utf8 "-") (show_nat (+ k 1))))
     none)))
    (_ none)))
(fn tc_show_args ((acc (List Int)) (args (List Expr)) (names (List (List Int)))) (List Int)
  (measure (struct args))
  (match args
    (nil (append acc (utf8 ")")))
    ((cons a r) (tc_show_args (append acc (append (utf8 " ") (tc_show a names))) r names))))
(fn tc_op_spelling ((n Name)) (Option (List Int))
  (if (bool_or (name_eq n (n2 (sym "Nat") (sym "lt"))) (name_eq n (n2 (sym "Int") (sym "lt"))))
    (some (utf8 "<"))
  (if (bool_or (name_eq n (n2 (sym "Nat") (sym "le"))) (name_eq n (n2 (sym "Int") (sym "le"))))
    (some (utf8 "<="))
  (if (bool_or (name_eq n (n2 (sym "Nat") (sym "add"))) (name_eq n (n2 (sym "Int") (sym "add"))))
    (some (utf8 "+"))
  (if (bool_or (name_eq n (n2 (sym "Nat") (sym "mul"))) (name_eq n (n2 (sym "Int") (sym "mul"))))
    (some (utf8 "*"))
  (if (name_eq n (n2 (sym "Int") (sym "sub"))) (some (utf8 "-"))
  none))))))
(fn level_is_zero ((u Level)) Bool
  (match u
    (LZero true)
    (_ false)))

;; the forms whose precondition the goal meets (not a completeness claim): intro at a Pi, rfl
;; and rw at an equation, cases/induction/wf where a local has an inductive type, decide where
;; the target has a decision, arith where the target is a linear comparison; exact, apply,
;; have, show, unfold, reduce, simp_only and sorry always
(fn applicable ((e El) (g Goal)) (List Symbol)
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (match (el_whnf e1 target)
       ((Prod.mk e2 tw)
        (append (if (is_pi tw) (list (sym "intro")) nil)
          (append
            (match (eq_sides tw)
              ((some _) (list (sym "rfl") (sym "rw")))
              (none nil))
            (append
              (if (ctx_has_inductive e2 ctx) (list (sym "cases") (sym "induction") (sym "wf")) nil)
              (append
                (match (decision_of e2 (el_zonk e2 target))
                  ((Prod.mk _ (some _)) (list (sym "decide")))
                  (_ nil))
                (append
                  (match (ar_rel (sp_canon (el_zonk e2 target)))
                    ((ARNone) nil)
                    (_ (list (sym "arith"))))
                  (list (sym "exact") (sym "apply") (sym "have") (sym "show") (sym "unfold")
                    (sym "reduce")
                    (sym "simp_only")
                    (sym "sorry"))))))))))))
(fn ctx_has_inductive ((e El) (ctx (List Expr))) Bool
  (measure (struct ctx))
  (match ctx
    (nil false)
    ((cons (FVar _ id) r)
     (match (w_local_type (el_w e) id)
       ((some ty)
        (match (ind_of_type e ty)
          ((IndOf _ _ _ _ _ _ _) true)
          (_ (ctx_has_inductive e r))))
       (none (ctx_has_inductive e r))))
    ((cons _ r) (ctx_has_inductive e r))))

;; ---- the steps -------------------------------------------------------------------------------
;; a step's answer: the state, the goal's filling (closed), the child goals with their blocks
;; (one each, in the goals' order), the continuation goal of a sequential step
(type TStep
  (StepOk El Expr (List Goal) (List (List Node)) (Option Goal))
  (StepErr Symbol (List Int)))

(fn tac_step ((e El) (g Goal) (nd Node)) TStep
  (match (tac_open e g)
    ((Opened e1 ctx target)
     (match nd
       ((NIntro ns) (step_intro e1 ctx target ns))
       ((NExact t) (step_exact e1 ctx target t))
       ((NRfl) (step_rfl e1 ctx target))
       ((NHave n p b) (step_have e1 ctx target n p b))
       ((NShow p) (step_show e1 ctx target p))
       ((NSorry) (step_sorry e1 ctx target))
       ((NApply t bs) (step_apply e1 ctx target t bs))
       ((NCases t hn arms) (step_cases e1 ctx target t hn arms false))
       ((NInduction t hn arms) (step_cases e1 ctx target t hn arms true))
       ((NWf x m ih b) (step_wf e1 ctx target x m ih b))
       ((NDecide) (step_decide e1 ctx target))
       ((NUnfold ns) (step_unfold e1 ctx target ns))
       ((NReduce side rules) (step_reduce e1 ctx target side rules))
       ((NRw rv lem occ ex bs) (step_rw e1 ctx target rv lem occ ex bs))
       ((NArith only facts certs) (step_arith e1 ctx target only facts certs))
       ((NSimp rules) (step_simp e1 ctx target rules))
       (_ (StepErr (sym "bad_step") (utf8 "an arm or a block is not a step")))))))

;; a sequential step's answer: the continuation goal over `ctx` at `target`, the filling its
;; occurrence — the parent's statement and the continuation's are K-convertible
(fn step_continue
  ((e El) (ctx (List Expr)) (target Expr) (children (List Goal)) (blocks (List (List Node))))
  TStep
  (match (tac_goal e ctx target)
    ((Made e1 g occ)
     (match (tac_close e1 ctx occ)
       ((Prod.mk e2 filling) (StepOk e2 filling children blocks (some g)))))))
;; a closing step's answer
(fn step_close
  ((e El) (ctx (List Expr)) (t Expr) (children (List Goal)) (blocks (List (List Node))))
  TStep
  (match (tac_close e ctx t)
    ((Prod.mk e1 filling) (StepOk e1 filling children blocks none))))

;; (intro NAME…): the target a Pi after whnf, one local per name
(fn step_intro ((e El) (ctx (List Expr)) (target Expr) (ns (List Name))) TStep
  (match (intro_go e ctx target ns)
    ((Prod.mk (some (Opened e1 ctx1 target1)) _) (step_continue e1 ctx1 target1 nil nil))
    ((Prod.mk none m) (StepErr (sym "intro_no_pi") m))))
(fn intro_go ((e El) (ctx (List Expr)) (target Expr) (ns (List Name)))
  (Prod (Option Opened) (List Int))
  (measure (struct ns))
  (match ns
    (nil (Prod.mk (some (Opened e ctx target)) nil))
    ((cons n r)
     (match (el_whnf e target)
       ((Prod.mk e1 (Pi _ _ bi dom body))
        (match (el_local e1 n dom bi)
          ((Prod.mk e2 fv)
           (match (w_inst1 (el_w e2) body fv)
             ((Prod.mk w3 body1) (intro_go (el_set_w e2 w3) (append ctx (list fv)) body1 r))))))
       ((Prod.mk e1 _)
        (Prod.mk none (utf8 "the target is not a forall or an implication after whnf")))))))

;; (exact TERM): the term at the target
(fn step_exact ((e El) (ctx (List Expr)) (target Expr) (t SExpr)) TStep
  (match (elab e t (some target))
    ((EErr x m) (StepErr x m))
    ((EOk e1 v _)
     (match (tac_unsolved e1 v)
       ((some (Prod.mk x m)) (StepErr x m))
       (none (step_close e1 ctx (el_zonk e1 v) nil nil))))))
;; a metavariable of the step's own left open (a goal's is not, nor a witness's: a later block assigns it)
(fn tac_unsolved ((e El) (v Expr)) (Option (Prod Symbol (List Int)))
  (match (first_open_mvar e (el_zonk e v))
    (none none)
    ((some i)
     (match (unsolved_msg e i)
       ((FinErr x m) (some (Prod.mk x m)))
       ((FinOk _) none)))))
(fn first_open_mvar ((e El) (v Expr)) (Option Int) (first_open_go e (mvars_of v nil)))
(fn first_open_go ((e El) (is (List Int))) (Option Int)
  (measure (struct is))
  (match is
    (nil none)
    ((cons i r)
     (match (mc_decl (el_mc e) i)
       ((some d)
        (if (bool_or (sym_eq (md_kind d) (sym "goal")) (sym_eq (md_kind d) (sym "witness")))
          (first_open_go e r)
          (some i)))
       (none (first_open_go e r))))))
(fn mvars_of ((t Expr) (acc (List Int))) (List Int)
  (measure (struct t))
  (if (bool_not (has_mvar t)) acc
  (match t
    ((MVar _ i) (if (mem_int i acc) acc (cons i acc)))
    ((App _ f a) (mvars_of a (mvars_of f acc)))
    ((Lam _ _ _ d b) (mvars_of b (mvars_of d acc)))
    ((Pi _ _ _ d b) (mvars_of b (mvars_of d acc)))
    ((Let _ _ ty v b) (mvars_of b (mvars_of v (mvars_of ty acc))))
    ((Proj _ _ _ x) (mvars_of x acc))
    (_ acc))))

;; rfl: Eq.refl at `a = b`, the sides K-convertible
(fn step_rfl ((e El) (ctx (List Expr)) (target Expr)) TStep
  (match (el_whnf e target)
    ((Prod.mk e1 tw)
     (match (eq_sides tw)
       (none
         (StepErr (sym "rfl_not_eq")
           (append (utf8 "rfl closes an equation; the target is ") (tc_show_closed e1 ctx tw))))
       ((some (Prod.mk u (Prod.mk ty (Prod.mk a b))))
        (match (el_unify_r e1 a b)
          ((EUOk e2)
           (step_close e2 ctx (mk_app (mk_app (mk_const (nm_eq_refl) (list u)) ty) a) nil nil))
          ((EUStuck i)
           (match (eu_refusal e1 (EUStuck i) (EErr (sym "rfl_failed") (utf8 "")))
             ((EErr x m) (StepErr x m))
             (_ (StepErr (sym "rfl_failed") (utf8 "")))))
          ((EUExhausted s)
           (StepErr (sym "unify_exhausted")
             (append (utf8 "unification ran out at ") (chars_of_sym s))))
          (EUNo
            (StepErr (sym "rfl_failed")
              (append (utf8 "the sides are not convertible")
                (append (waits_note e1 ctx tw)
                  (append (utf8 ": ")
                    (append (tc_show_closed e1 ctx a)
                      (append (utf8 " and ") (tc_show_closed e1 ctx b))))))))))))))
;; `@Eq.{u} ty a b` taken apart
(fn eq_sides ((t Expr)) (Option (Prod Level (Prod Expr (Prod Expr Expr))))
  (match (get_app_fn t)
    ((Const _ n (cons u nil))
     (if (name_eq n (nm_eq))
       (match (get_app_args t)
         ((cons ty (cons a (cons b nil))) (some (Prod.mk u (Prod.mk ty (Prod.mk a b)))))
         (_ none))
       none))
    (_ none)))
;; a term over the step's locals, rendered as the goal would show it: the term alone, its
;; locals by their names (closed over the context, the binders walked for the names)
(fn tc_show_closed ((e El) (ctx (List Expr)) (t Expr)) (List Int)
  (match (el_pis e ctx (el_zonk e t))
    ((Prod.mk _ c) (show_body_go c (len ctx) nil))))
(fn show_body_go ((t Expr) (k Int) (names (List (List Int)))) (List Int)
  (measure k)
  (if (< k 1) (tc_show t names)
  (match t
    ((Pi _ n _ _ body) (show_body_go body (- k 1) (cons (tc_binder n) names)))
    (_ (tc_show t names)))))

;; (have NAME PROP STEP…): the cut — the child goal PROP over ctx, the continuation with
;; NAME : PROP; the filling applies the continuation's lambda to the child's occurrence
(fn step_have ((e El) (ctx (List Expr)) (target Expr) (n Name) (p SExpr) (b (List Node))) TStep
  (match (elab_type e p)
    ((EErr x m) (StepErr x m))
    ((EOk e1 prop _)
     (match (tac_unsolved e1 prop)
       ((some (Prod.mk x m)) (StepErr x m))
       (none
         (match (tac_goal e1 ctx (el_zonk e1 prop))
           ((Made e2 child cocc)
            (match (el_local e2 n (el_zonk e2 prop) BDefault)
              ((Prod.mk e3 h)
               (match (tac_goal e3 (append ctx (list h)) target)
                 ((Made e4 cont kocc)
                  (match (el_lams e4 (list h) kocc)
                    ((Prod.mk e5 lam)
                     (match (tac_close e5 ctx (mk_app lam cocc))
                       ((Prod.mk e6 filling) (StepOk e6 filling (list child) (list b) (some cont)))))))))))))))))

;; (show PROP): the target replaced where K's conversion agrees
(fn step_show ((e El) (ctx (List Expr)) (target Expr) (p SExpr)) TStep
  (match (elab_type e p)
    ((EErr x m) (StepErr x m))
    ((EOk e1 prop _)
     (match (tac_unsolved e1 prop)
       ((some (Prod.mk x m)) (StepErr x m))
       (none
         (match (w_is_def_eq_r (el_w e1) (el_zonk e1 prop) (el_zonk e1 target))
           ((Prod.mk w2 (WVal true)) (step_continue (el_set_w e1 w2) ctx (el_zonk e1 prop) nil nil))
           ((Prod.mk w2 _)
            (StepErr (sym "show_mismatch")
              (append (utf8 "not convertible to the target: ")
                (tc_show_closed (el_set_w e1 w2) ctx prop))))))))))

;; sorry: the goal stays open (the theorem is pending); the filling is its own occurrence
(fn step_sorry ((e El) (ctx (List Expr)) (target Expr)) TStep
  (match (tac_goal e ctx target)
    ((Made e1 g occ)
     (match (tac_close e1 ctx occ)
       ((Prod.mk e2 filling) (StepOk e2 filling (list g) nil none))))))

;; ---- apply, cases, induction, wf, decide ------------------------------------------------------
;; the number of binders of a type, whnf at each
(fn tac_arity ((e El) (t Expr) (fuel Int)) (Prod El Int)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) (Prod.mk e 0)
  (match (el_whnf e t)
    ((Prod.mk e1 (Pi _ _ _ _ body))
     (match (tac_arity e1 body (- fuel 1))
       ((Prod.mk e2 k) (Prod.mk e2 (+ k 1)))))
    ((Prod.mk e1 _) (Prod.mk e1 0)))))
(fulfills tac_arity.dec_1 (by (intro p h e1 a n bi d body hm) (apply natAbs_pred (arith))))
;; a type's first k binders opened with fresh metavariables: the term applied, the type left,
;; the metavariables; the whnf is taken only where the type is not a Pi already
(type OpenedM (OpenedM El Expr Expr (List Expr)))
(fn open_mvars ((e El) (v Expr) (t Expr) (k Int) (acc (List Expr))) OpenedM
  (measure (Int.natAbs k))
  (if (< k 1) (OpenedM e v t (rev acc))
  (match (if (is_pi t) (Prod.mk e t) (el_whnf e t))
    ((Prod.mk e1 (Pi _ n bi dom body))
     (match
       (el_fresh e1 n dom
         (if (bi_default bi) (sym "explicit")
         (if (bi_inst bi) (sym "inst")
         (sym "implicit"))))
       ((Prod.mk e2 m)
        (match (w_inst1 (el_w e2) body m)
          ((Prod.mk w3 body1) (open_mvars (el_set_w e2 w3) (mk_app v m) body1 (- k 1) (cons m acc)))))))
    ((Prod.mk e1 t1) (OpenedM e1 v t1 (rev acc))))))
(fulfills open_mvars.dec_1
  (by (intro p h e1 a n bi dom body hm e2 m hm2 w3 body1 hm3) (apply natAbs_pred (arith))))
;; the metavariables of an opening left unassigned: each a proposition is a child goal over ctx,
;; assigned its occurrence; a datum is a witness — closed over ctx as a goal
;; is, its occurrence the closed metavariable applied to ctx, so a block that opens the context
;; afresh assigns it by pattern unification and the assignment closes; an instance argument is
;; the table's, else the refusal `instance_needed` as everywhere
(type Premises (PrOk El (List Goal)) (PrErr Symbol (List Int)))
(fn premise_goals ((e El) (ctx (List Expr)) (ms (List Expr)) (who Symbol) (acc (List Goal)))
  Premises
  (match (witness_close e ctx ms)
    ((PrErr x m) (PrErr x m))
    ((PrOk e1 _) (premise_goals_go e1 ctx ms who acc))))
(fn witness_close ((e El) (ctx (List Expr)) (ms (List Expr))) Premises
  (measure (struct ms))
  (match ms
    (nil (PrOk e nil))
    ((cons (MVar _ i) r)
     (match (mc_assigned (el_mc e) i)
       ((some _) (witness_close e ctx r))
       (none
         (match (mc_decl (el_mc e) i)
           (none (PrErr (sym "bad_shape") (utf8 "a metavariable without a declaration")))
           ((some d)
            (let ((ty (el_zonk e (md_type d))))
              (match (w_is_prop (el_w e) ty)
                ((Prod.mk w1 (some true)) (witness_close (el_set_w e w1) ctx r))
                ((Prod.mk w1 _)
                 (if (sym_eq (md_kind d) (sym "inst"))
                   (let ((ei (el_solve_one (el_set_w e w1) i)))  ; the table's instance, else the refusal
                     (match (mc_assigned (el_mc ei) i)
                       ((some _) (witness_close ei ctx r))
                       (none
                         (match (unsolved_msg ei i)
                           ((FinErr x m) (PrErr x m))
                           ((FinOk _) (PrErr (sym "bad_shape") (utf8 "an instance")))))))
                   (match (el_pis (el_set_w e w1) ctx ty)
                     ((Prod.mk e1 tyc)
                      (match (el_fresh e1 (md_name d) tyc (sym "witness"))
                        ((Prod.mk e2 (MVar _ j))
                         (witness_close
                           (el_set_mc e2 (mc_set (el_mc e2) i (mk_app_n (mk_mvar j) ctx)))
                           ctx
                           r))
                        ((Prod.mk e2 _) (PrErr (sym "bad_shape") (utf8 "no metavariable")))))))))))))))
    ((cons _ r) (witness_close e ctx r))))
(fn premise_goals_go ((e El) (ctx (List Expr)) (ms (List Expr)) (who Symbol) (acc (List Goal)))
  Premises
  (measure (struct ms))
  (match ms
    (nil (PrOk e (rev acc)))
    ((cons (MVar _ i) r)
     (match (mc_assigned (el_mc e) i)
       ((some _) (premise_goals_go e ctx r who acc))
       (none
         (match (mc_decl (el_mc e) i)
           (none (PrErr (sym "bad_shape") (utf8 "a metavariable without a declaration")))
           ((some d)
            (match (tac_goal e ctx (el_zonk e (md_type d)))
              ((Made e2 g occ)
               (premise_goals_go (el_set_mc e2 (mc_set (el_mc e2) i occ)) ctx r who (cons g acc)))))))))
    ((cons _ r) (premise_goals_go e ctx r who acc))))
;; a witness left open when the step's blocks have run
(fn mvar_terms ((is (List Int))) (List Expr)
  (measure (struct is))
  (match is
    (nil nil)
    ((cons i r) (cons (mk_mvar i) (mvar_terms r)))))
(fn witness_open ((e El) (v Expr)) (Option (List Int))
  (witness_open_go e (mvars_of (el_zonk e v) nil)))
(fn witness_open_go ((e El) (is (List Int))) (Option (List Int))
  (measure (struct is))
  (match is
    (nil none)
    ((cons i r)
     (match (mc_decl (el_mc e) i)
       ((some d)
        (if (sym_eq (md_kind d) (sym "witness")) (some (show_name (md_name d)))
        (witness_open_go e r)))
       (none (witness_open_go e r))))))
;; the children against the node's blocks
(fn blocks_match ((who Symbol) (gs (List Goal)) (nblocks Int)) (Option (Prod Symbol (List Int)))
  (if (= (len gs) nblocks) none
  (some
    (Prod.mk (sym_of_chars (append (chars_of_sym who) (utf8 "_goals")))
      (append (chars_of_sym who)
        (append (utf8 " opens ")
          (append (show_nat (len gs))
            (append (utf8 " goal(s) and the step gives ")
              (append (show_nat nblocks) (append (utf8 " block(s): ") (goals_list gs)))))))))))
;; the sorried goals of a pending theorem, in its record: ` [GOAL] [GOAL]`
(fn goals_bracketed ((gs (List Goal))) (List Int)
  (measure (struct gs))
  (match gs
    (nil (utf8 ""))
    ((cons g r) (append (utf8 " [") (append (goal_of g) (append (utf8 "]") (goals_bracketed r)))))))
(fn goals_list ((gs (List Goal))) (List Int)
  (measure (struct gs))
  (match gs
    (nil (utf8 ""))
    ((cons g r) (append (utf8 "[") (append (goal_of g) (append (utf8 "] ") (goals_list r)))))))

;; (apply TERM BLOCK…): TERM's conclusion after arity(TERM) - arity(target) binders unified with
;; the target; each premise left open a child goal in binder order
(fn step_apply ((e El) (ctx (List Expr)) (target Expr) (t SExpr) (bs (List Node))) TStep
  (match (elab e t none)
    ((EErr x m) (StepErr x m))
    ((EOk e1 v ty)
     (match (tac_arity e1 ty 64)
       ((Prod.mk e2 at)
        (match (tac_arity e2 target 64)
          ((Prod.mk e3 ag)
           (match (open_mvars e3 v ty (max_int (- at ag) 0) nil)
             ((OpenedM e4 v1 concl ms)
              (match (el_unify_r e4 concl target)
                ((EUOk e5)
                 (match (witness_close e5 ctx (mvar_terms (mvars_of (el_zonk e5 v1) nil)))  ; the implicit arguments the elaborator inserted are not among ms
                   ((PrErr x m) (StepErr x m))
                   ((PrOk e5w _)
                    (match (premise_goals e5w ctx ms (sym "apply") nil)
                      ((PrErr x m) (StepErr x m))
                      ((PrOk e6 gs)
                       (match (blocks_match (sym "apply") gs (len bs))
                         ((some (Prod.mk x m)) (StepErr x m))
                         (none
                           (match (tac_unsolved e6 v1)
                             ((some (Prod.mk x m)) (StepErr x m))
                             (none (step_close e6 ctx (el_zonk e6 v1) gs (blocks_of bs nil)))))))))))
                (EUNo
                  (StepErr (sym "apply_mismatch")
                    (append (utf8 "the conclusion ")
                      (append (tc_show_closed e4 ctx concl)
                        (append (utf8 " does not unify with the target ")
                          (tc_show_closed e4 ctx target))))))
                (u
                  (match (eu_refusal e4 u (EErr (sym "apply_mismatch") (utf8 "")))
                    ((EErr x m) (StepErr x m))
                    (_ (StepErr (sym "apply_mismatch") (utf8 "")))))))))))))))

;; the inductive of a type: its name, levels, arguments, parameter and index counts, ctors
(type IndOf (IndOf El Name (List Level) (List Expr) Int Int (List Name)) (IndNone El (List Int)))
(fn ind_of_type ((e El) (ty Expr)) IndOf
  (match (el_whnf e ty)
    ((Prod.mk e1 tw)
     (match (get_app_fn tw)
       ((Const _ n ls)
        (match (env_find (el_env e1) n)
          ((some (InductInfo _ nparams nindices _ ctors _ _ _ _))
           (IndOf e1 n ls (get_app_args tw) nparams nindices ctors))
          (_ (IndNone e1 (append (show_name n) (utf8 " is not an inductive type"))))))
       (_ (IndNone e1 (append (utf8 "not an inductive type: ") (tc_show tw nil))))))))
;; a head-beta step: (fun x => b) a… to b[a]…
(fn tac_beta ((e El) (t Expr)) (Prod El Expr)
  (match (get_app_fn t)
    ((Lam _ _ _ _ _)
     (match (beta_head (w_st (el_w e)) (get_app_fn t) (get_app_args t))
       ((Prod.mk st r) (Prod.mk (el_set_w e (w_set_st (el_w e) st)) r))))
    (_ (Prod.mk e t))))
;; the target with the scrutinee generalized: a local by its id, a term by its occurrences
(fn generalize ((e El) (target Expr) (x Expr) (d Expr)) (Prod El Expr)
  (match x
    ((FVar _ id)
     (match (w_subst (el_w e) target id d)
       ((Prod.mk w1 r) (Prod.mk (el_set_w e w1) r))))
    (_ (Prod.mk e (tc_replace target x d 0)))))

;; (cases X ARM…) and (induction X ARM…): the eliminator applied to the generalized motive —
;; the locals whose types mention x reverted into it first (the motive is
;; `λ d. (h : T[d]) → … → target[d]`, the eliminator's result applied back to them, and each arm
;; re-introduces them after the constructor's fields, under their names, so an arm sees
;; `h : T[CTOR fields]` and an induction hypothesis quantifies over them; Lean's `cases` reverts
;; dependents, `induction … generalizing`); the eliminated local leaves the arm's context. With
;; an equation name, the motive is `λ d. x = d → …` and the eliminator's result is applied to
;; Eq.refl x, so each arm has `H : x = CTOR fields` (Lean's `cases h : x`; x stays, H names it)
(fn step_cases
  ((e El)
   (ctx (List Expr))
   (target Expr)
   (t SExpr)
   (hn (Option Name))
   (arms (List Node))
   (ind Bool))
  TStep
  (match (elab e t none)
    ((EErr x m) (StepErr x m))
    ((EOk e1 x0 xty)
     (let ((x (el_zonk e1 x0)))
       (match (tac_unsolved e1 x)
         ((some (Prod.mk xx m)) (StepErr xx m))
         (none
           (match (ind_of_type e1 xty)
             ((IndNone e2 m) (StepErr (sym "cases_type") m))
             ((IndOf e2 iname ils iargs nparams nindices ctors)
              (if (< 0 nindices)
                (StepErr (sym "cases_indexed")
                  (append (show_name iname)
                    (utf8
                      " is an indexed family: cases and induction take a type without indices (there is no injection or subst step) — use Init's lemmas (T.CTOR.inj, Eq.subst) in a term")))
              (if
                (bool_and ind
                  (match hn
                    ((some _) true)
                    (none false)))
                (StepErr (sym "induction_eq")
                  (utf8
                    "induction takes no equation name: the hypotheses would be guarded by it (Lean has none either); name the equation under cases, or state the equation and induct on the local"))
                (let ((elim (name_append iname (n1 (if ind (sym "rec") (sym "casesOn"))))))
                  (match (env_find (el_env e2) elim)
                    (none
                      (StepErr (sym "cases_type")
                        (append (show_name elim)
                          (utf8
                            " is not in the environment: cases and induction are built on a type's casesOn and rec"))))
                    ((some einfo)
                     (let
                       ((levels (if (< (len ils) (len (ci_lparams einfo))) (cons LZero ils) ils)))
                       (match (el_local e2 (n1 (sym "d")) (el_zonk e2 xty) BDefault)
                         ((Prod.mk e3 d)
                          (let ((deps (ctx_dependents e3 ctx x)))
                            (match (el_pis e3 deps (el_zonk e3 target))
                              ((Prod.mk e3b target1)
                               (match (generalize e3b target1 x d)
                                 ((Prod.mk e4a body0)
                                  (match (cases_eq_motive e4a hn xty x d body0)
                                    ((Prod.mk e4 body)
                                     (match (el_lams e4 (list d) body)
                                       ((Prod.mk e5 motive)
                                        ;; casesOn takes the major before its minors, rec after them
                                        (let
                                          ((head
                                             (mk_app_n (mk_const elim levels)
                                               (append (take nparams iargs)
                                                 (if ind (list motive) (list motive x))))))
                                          (match (el_infer e5 head)
                                            ((Prod.mk e6 none)
                                             (StepErr (sym "cases_type")
                                               (append (utf8 "K could not type ")
                                                 (append (show_name elim) (utf8 " at this motive")))))
                                            ((Prod.mk e6 (some hty))
                                             (match
                                               (cases_minors e6
                                                 (ctx_minus
                                                   (match hn
                                                     ((some _) ctx)
                                                     (none (ctx_minus ctx (list x))))
                                                   deps)
                                                 hty
                                                 ctors
                                                 arms
                                                 hn
                                                 (local_names e6 deps)
                                                 nil
                                                 nil
                                                 nil
                                                 (if ind (sym "induction") (sym "cases")))
                                               ((MinErr xx m) (StepErr xx m))
                                               ((MinOk e7 minors gs bls)
                                                (step_close e7 ctx
                                                  (mk_app_n
                                                    (mk_app_n head
                                                      (if ind (append minors (list x)) minors))
                                                    (append
                                                      (match hn
                                                        ((some _)
                                                         (list
                                                           (mk_app_n
                                                             (mk_const (nm_eq_refl)
                                                               (list (sort_level_of e7 xty)))
                                                             (list (el_zonk e7 xty) x))))
                                                        (none nil))
                                                      deps))
                                                  gs
                                                  bls)))))))))))))))))))))))))))))))
;; the motive's body under an equation name: `(= x d) -> body`
(fn cases_eq_motive ((e El) (hn (Option Name)) (xty Expr) (x Expr) (d Expr) (body Expr))
  (Prod El Expr)
  (match hn
    (none (Prod.mk e body))
    ((some _)
     (match
       (el_local e (n1 (sym "h"))
         (mk_app_n (mk_const (nm_eq) (list (sort_level_of e xty))) (list (el_zonk e xty) x d))
         BDefault)
       ((Prod.mk e1 h) (el_pis e1 (list h) body))))))
(fn sort_level_of ((e El) (ty Expr)) Level
  (match (tac_sort_level e ty)
    ((Prod.mk _ (some u)) u)
    ((Prod.mk _ none) (LSucc LZero))))
;; one minor premise per constructor: its telescope opened under the arm's names, its result
;; the child goal (with the equation hypothesis opened after the fields, under its name, and
;; the reverted dependents after it under theirs — `depn`, their names in the motive's order)
(type Minors (MinOk El (List Expr) (List Goal) (List (List Node))) (MinErr Symbol (List Int)))
(fn cases_minors
  ((e El)
   (ctx (List Expr))
   (hty Expr)
   (ctors (List Name))
   (arms (List Node))
   (hn (Option Name))
   (depn (List Name))
   (macc (List Expr))
   (gacc (List Goal))
   (bacc (List (List Node)))
   (who Symbol))
  Minors
  (measure (struct ctors))
  (match ctors
    (nil
      (match arms
        (nil (MinOk e (rev macc) (rev gacc) (rev bacc)))
        ((cons (NArm c _ _) _)
         (MinErr (sym_of_chars (append (chars_of_sym who) (utf8 "_rows")))
           (append (show_name c) (utf8 " is not a constructor of the type, or is named twice"))))
        (_ (MinErr (sym "bad_step") (utf8 "an arm is (CTOR (NAME…) STEP…)")))))
    ((cons c cr)
     (match (take_arm c arms nil)
       (none
         (MinErr (sym_of_chars (append (chars_of_sym who) (utf8 "_rows")))
           (append (utf8 "no arm for the constructor ") (show_name c))))
       ((some (Prod.mk (NArm _ names ablock) rest))
        (match (el_whnf e hty)
          ((Prod.mk e1 (Pi _ _ _ mty body))
           (match (tac_fields_open e1 (el_zonk e1 mty) names nil)
             ((Prod.mk _ (Opened e2a fields0 res0))
              (match (open_eq_hyp e2a hn fields0 res0)
                ((Opened e2 fields res)
                 (if (bool_not (= (minor_binders (el_zonk e1 mty) 64) (len names)))
                   (MinErr (sym_of_chars (append (chars_of_sym who) (utf8 "_fields")))
                     (fields_refusal e1 ctx c (el_zonk e1 mty) names))
                   (match (tac_fields_open e2 res depn nil)
                     ((Prod.mk _ (Opened e2b deps res1))
                      (match (tac_goal e2b (append ctx (append fields deps)) res1)
                        ((Made e3 g occ)
                         (match (el_lams e3 (append fields deps) occ)
                           ((Prod.mk e4 minor)
                            (match (w_inst1 (el_w e4) body minor)
                              ((Prod.mk w5 hty1)
                               (cases_minors (el_set_w e4 w5) ctx hty1 cr rest hn depn
                                 (cons minor macc)
                                 (cons g gacc)
                                 (cons ablock bacc)
                                 who)))))))))))))))
          ((Prod.mk e1 _)
           (MinErr (sym "cases_type")
             (utf8 "the eliminator's type has fewer minor premises than constructors")))))
       ((some _) (MinErr (sym "bad_step") (utf8 "an arm is (CTOR (NAME…) STEP…)")))))))
;; the arm named after the constructor (by its last component or in full), and the rest
(fn take_arm ((c Name) (arms (List Node)) (acc (List Node))) (Option (Prod Node (List Node)))
  (measure (struct arms))
  (match arms
    (nil none)
    ((cons (NArm n ns b) r)
     (if (bool_or (name_eq n c) (int_list_eq (chars_of_name_last n) (chars_of_name_last c)))
       (some (Prod.mk (NArm n ns b) (append (rev acc) r)))
       (take_arm c r (cons (NArm n ns b) acc))))
    ((cons o r) (take_arm c r (cons o acc)))))
;; a minor premise's binders as locals under the names given — as many as the names, every
;; binder's type head-beta reduced (the motive applied); the result head-beta reduced
(fn tac_fields_open ((e El) (t Expr) (names (List Name)) (acc (List Expr))) (Prod Bool Opened)
  (measure (struct names))
  (match names
    (nil
      (match (tac_beta e t)
        ((Prod.mk e1 r) (Prod.mk true (Opened e1 (rev acc) r)))))
    ((cons n r)
     (match t
       ((Pi _ _ bi dom body)
        (match (tac_beta e dom)
          ((Prod.mk e1 dom1)
           (match (el_local e1 n dom1 bi)
             ((Prod.mk e2 fv)
              (match (w_inst1 (el_w e2) body fv)
                ((Prod.mk w3 body1) (tac_fields_open (el_set_w e2 w3) body1 r (cons fv acc)))))))))
       (_
         (match (tac_beta e t)
           ((Prod.mk e1 r1) (Prod.mk false (Opened e1 (rev acc) r1)))))))))
;; the binders of a minor premise's type: its own, before the equation's (the type is a Pi
;; telescope ending in the motive applied)
(fn minor_binders ((t Expr) (fuel Int)) Int
  (measure (Int.natAbs fuel))
  (if (< fuel 1) 0
  (match t
    ((Pi _ _ _ _ body) (+ 1 (minor_binders body (- fuel 1))))
    (_ 0))))
(fulfills minor_binders.dec_1 (by (intro p h a n bi d body hm) (apply natAbs_pred (arith))))
;; the equation hypothesis after the fields: the minor's result is `(= x (C fields)) -> target`
(fn open_eq_hyp ((e El) (hn (Option Name)) (fields (List Expr)) (res Expr)) Opened
  (match hn
    (none (Opened e fields res))
    ((some h)
     (match res
       ((Pi _ _ bi dom body)
        (match (el_local e h dom bi)
          ((Prod.mk e1 fv)
           (match (w_inst1 (el_w e1) body fv)
             ((Prod.mk w2 body1) (Opened (el_set_w e1 w2) (append fields (list fv)) body1))))))
       (_ (Opened e fields res))))))
;; an arm whose name list is not its case's: both counts, what the case's binders are — the
;; constructor's fields, then under induction one hypothesis for each recursive field — and
;; the binders themselves, each under the arm's name for it where the arm gave one
(fn fields_refusal ((e El) (ctx (List Expr)) (c Name) (mty Expr) (names (List Name))) (List Int)
  (let
    ((total (minor_binders mty 64))
     (nf Int
       (match (env_find (el_env e) c)
         ((some (CtorInfo _ _ _ _ k _)) k)
         (_ 0))))
    (match (tac_fields_open e mty (case_names mty names 64) nil)
      ((Prod.mk _ (Opened e1 fields _))
       (append (show_name c)
         (append (utf8 "'s arm names ")
           (append (show_nat (len names))
             (append (utf8 " binder(s) and its case has ")
               (append (show_nat total)
                 (append (utf8 ": name the constructor's ")
                   (append (show_nat nf)
                     (append (utf8 " field(s)")
                       (append
                         (if (< nf total)
                           (append (utf8 ", then ")
                             (append (show_nat (- total nf))
                               (utf8 " induction hypothesis name(s), one for each recursive field")))
                           nil)
                         (append (utf8 " —") (binders_list e1 ctx fields)))))))))))))))
;; a name for every binder of a minor premise: the arm's, then the binder's own
(fn case_names ((t Expr) (names (List Name)) (fuel Int)) (List Name)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) nil
  (match t
    ((Pi _ n _ _ body)
     (match names
       ((cons x r) (cons x (case_names body r (- fuel 1))))
       (nil (cons n (case_names body nil (- fuel 1))))))
    (_ nil))))
(fulfills case_names.dec_1 (by (intro p h a n bi d body hm x r hn) (apply natAbs_pred (arith))))
(fulfills case_names.dec_2 (by (intro p h a n bi d body hm hn) (apply natAbs_pred (arith))))
;; the locals as ` (NAME : TYPE)…`, their types read under the context
(fn binders_list ((e El) (ctx (List Expr)) (fields (List Expr))) (List Int)
  (match (el_pis e (append ctx fields) (mk_sort LZero))
    ((Prod.mk _ c) (show_binders_go c (len ctx) (len fields) nil))))
(fn show_binders_go ((t Expr) (skip Int) (k Int) (names (List (List Int)))) (List Int)
  (measure (struct t))
  (match t
    ((Pi _ n _ dom body)
     (let ((nm (tc_binder n)))
       (if (< 0 skip) (show_binders_go body (- skip 1) k (cons nm names))
       (if (< k 1) nil
       (append (utf8 " (")
         (append nm
           (append (utf8 " : ")
             (append (tc_show dom names)
               (append (utf8 ")") (show_binders_go body 0 (- k 1) (cons nm names)))))))))))
    (_ nil)))

;; (wf X MEASURE IH STEP…): WellFounded.fix over (measure MEASURE) with the target as motive
(fn step_wf
  ((e El) (ctx (List Expr)) (target Expr) (xs SExpr) (ms SExpr) (ihn Name) (b (List Node)))
  TStep
  (match (elab e xs none)
    ((EErr x m) (StepErr x m))
    ((EOk e1 x0 alpha0)
     (match (el_zonk e1 x0)
       ((FVar dd xid)
        (let ((x (FVar dd xid)) (alpha (el_zonk e1 alpha0)))
          (match (elab e1 ms (some (mk_const (nm_nat) nil)))
            ((EErr xx m) (StepErr xx m))
            ((EOk e2 mz _)
             (match (tac_unsolved e2 mz)
               ((some (Prod.mk xx m)) (StepErr xx m))
               (none
                 (let ((mt (el_zonk e2 mz)))
                   (match (tac_sort_level e2 alpha)
                     ((Prod.mk e3 none)
                      (StepErr (sym "wf_local") (utf8 "the local's type is not a type")))
                     ((Prod.mk e3 (some u))
                      (match (el_local e3 (n1 (sym "x")) alpha BDefault)
                        ((Prod.mk e4 xa)
                         (match (w_subst (el_w e4) mt xid xa)
                           ((Prod.mk w5 ma)
                            (match (w_lams w5 (list xa) ma)
                              ((Prod.mk w6 mfn)
                               (match (w_subst w6 (el_zonk e4 target) xid xa)
                                 ((Prod.mk w7 ta)
                                  (match (w_lams w7 (list xa) ta)
                                    ((Prod.mk w8 motive)
                                     (match (wf_rel (el_set_w e4 w8) u alpha mfn)
                                       ((Prod.mk e5 (Prod.mk rel hwf))
                                        ;; the hypothesis: x' with the target's name, ih : ∀ y, m[y] < m[x'] → target[y]
                                        (match (el_local e5 (local_name e5 xid) alpha BDefault)
                                          ((Prod.mk e6 xp)
                                           (match (ih_type e6 alpha mt xid xp target)
                                             ((Prod.mk e7 ihty)
                                              (match (el_local e7 ihn ihty BDefault)
                                                ((Prod.mk e8 ih)
                                                 (match
                                                   (w_subst (el_w e8) (el_zonk e8 target) xid xp)
                                                   ((Prod.mk w9 tp)
                                                    (match
                                                      (tac_goal (el_set_w e8 w9)
                                                        (append (ctx_without e8 ctx x) (list xp ih))
                                                        tp)
                                                      ((Made e9 g occ)
                                                       (match (el_lams e9 (list xp ih) occ)
                                                         ((Prod.mk e10 F)
                                                          (step_close e10 ctx
                                                            (mk_app_n
                                                              (mk_const
                                                                (n2 (sym "WellFounded") (sym "fix"))
                                                                (list u LZero))
                                                              (list alpha motive rel hwf F x))
                                                            (list g)
                                                            (list b)))))))))))))))))))))))))))))))))))
       (_
         (StepErr (sym "wf_local") (utf8 "wf takes a local of the context (a variable, not a term)")))))))
;; the level of a type's sort
(fn tac_sort_level ((e El) (ty Expr)) (Prod El (Option Level))
  (match (el_infer e ty)
    ((Prod.mk e1 none) (Prod.mk e1 none))
    ((Prod.mk e1 (some s))
     (match (el_whnf e1 s)
       ((Prod.mk e2 (Sort _ u)) (Prod.mk e2 (some u)))
       ((Prod.mk e2 _) (Prod.mk e2 none))))))
(fn local_name ((e El) (id Int)) Name (bound_name (cx_bound (el_cx e)) id))
(fn bound_name ((bs (List (Prod Name Expr))) (id Int)) Name
  (measure (struct bs))
  (match bs
    (nil (n1 (sym "x")))
    ((cons (Prod.mk n (FVar _ j)) r) (if (= id j) n (bound_name r id)))
    ((cons _ r) (bound_name r id))))
;; InvImage Nat.lt_wfRel.rel m and InvImage.wf m Nat.lt_wfRel.wf, as define.shard builds them
(fn wf_rel ((e El) (u Level) (alpha Expr) (mfn Expr)) (Prod El (Prod Expr Expr))
  (let
    ((nat (mk_const (nm_nat) nil))
     (wfrel (mk_const (n2 (sym "Nat") (sym "lt_wfRel")) nil))
     (one (LSucc LZero)))
    (let
      ((rnat
         (mk_app_n (mk_const (n2 (sym "WellFoundedRelation") (sym "rel")) (list one))
           (list nat wfrel)))
       (hnat
         (mk_app_n (mk_const (n2 (sym "WellFoundedRelation") (sym "wf")) (list one))
           (list nat wfrel))))
      (Prod.mk e
        (Prod.mk (mk_app_n (mk_const (n1 (sym "InvImage")) (list u one)) (list alpha nat rnat mfn))
          (mk_app_n (mk_const (n2 (sym "InvImage") (sym "wf")) (list u one))
            (list alpha nat rnat mfn hnat)))))))
;; ∀ (y : α), (< m[y] m[x']) → target[y]
(fn ih_type ((e El) (alpha Expr) (mt Expr) (xid Int) (xp Expr) (target Expr)) (Prod El Expr)
  (match (el_local e (n1 (sym "y")) alpha BDefault)
    ((Prod.mk e1 y)
     (match (w_subst (el_w e1) mt xid y)
       ((Prod.mk w2 my)
        (match (w_subst w2 mt xid xp)
          ((Prod.mk w3 mx)
           (match
             (el_local (el_set_w e1 w3) (n1 (sym "h"))
               (mk_app_n (mk_const (n2 (sym "Nat") (sym "lt")) nil) (list my mx))
               BDefault)
             ((Prod.mk e4 h)
              (match (w_subst (el_w e4) (el_zonk e4 target) xid y)
                ((Prod.mk w5 ty)
                 (match (w_pis w5 (list y h) ty)
                   ((Prod.mk w6 r) (Prod.mk (el_set_w e4 w6) r))))))))))))))

;; decide: of_decide_eq_true at the target's decision, K's conversion the work
(fn step_decide ((e El) (ctx (List Expr)) (target Expr)) TStep
  (let ((tz (el_zonk e target)))
    (match (decision_of e tz)
      ((Prod.mk e1 none)
       (match (no_decision e1 tz (utf8 "decide: the target has no decision"))
         ((EErr x m) (StepErr x m))
         (_ (StepErr (sym "no_decision") (utf8 "decide: the target has no decision")))))
      ((Prod.mk e1 (some inst))
       (let
         ((dec (mk_app_n (mk_const (n2 (sym "Decidable") (sym "decide")) nil) (list tz inst)))
          (tru (mk_const (n2 (sym "Bool") (sym "true")) nil)))
         (match (w_is_def_eq_r (el_w e1) dec tru)
           ((Prod.mk w2 (WVal true))
            (step_close (el_set_w e1 w2) ctx
              (mk_app_n (mk_const (n1 (sym "of_decide_eq_true")) nil)
                (list tz inst
                  (mk_app_n (mk_const (nm_eq_refl) (list (LSucc LZero)))
                    (list (mk_const (n1 (sym "Bool")) nil) tru))))
              nil
              nil))
           ((Prod.mk w2 _)
            (StepErr (sym "decide_failed")
              (append (utf8 "the decision does not evaluate to true: ")
                (tc_show_closed (el_set_w e1 w2) ctx tz))))))))))

;; ---- rewriting -------------------------------------------------------------------------------
;; t with every occurrence of `pat` (or the sel-th, counting from 1) replaced by `r`: pre-order,
;; left to right, the function before its arguments; a subterm under a binder is compared as it
;; stands (`pat` is closed, so no occurrence mentions a bound variable)
(fn tc_replace ((t Expr) (pat Expr) (r Expr) (sel Int)) Expr
  (match (tc_replace_go t pat r sel 0)
    ((Prod.mk t1 _) t1)))
(fn tc_replace_go ((t Expr) (pat Expr) (r Expr) (sel Int) (seen Int)) (Prod Expr Int)
  (measure (struct t))
  (if (expr_eq t pat)
    (if (bool_or (= sel 0) (= sel (+ seen 1))) (Prod.mk r (+ seen 1)) (Prod.mk t (+ seen 1)))
    (match t
      ((App _ _ _)  ; the whole spine is one occurrence: its head and arguments are visited, never a prefix
       (match (tc_replace_go (get_app_fn t) pat r sel seen)
         ((Prod.mk f1 s1)
          (match (tc_replace_args (get_app_args t) pat r sel s1 nil)
            ((Prod.mk as s2) (Prod.mk (mk_app_n f1 as) s2))))))
      ((Lam _ n bi d b)
       (match (tc_replace_go d pat r sel seen)
         ((Prod.mk d1 s1)
          (match (tc_replace_go b pat r sel s1)
            ((Prod.mk b1 s2) (Prod.mk (mk_lam n bi d1 b1) s2))))))
      ((Pi _ n bi d b)
       (match (tc_replace_go d pat r sel seen)
         ((Prod.mk d1 s1)
          (match (tc_replace_go b pat r sel s1)
            ((Prod.mk b1 s2) (Prod.mk (mk_pi n bi d1 b1) s2))))))
      ((Let _ n ty v b)
       (match (tc_replace_go ty pat r sel seen)
         ((Prod.mk ty1 s1)
          (match (tc_replace_go v pat r sel s1)
            ((Prod.mk v1 s2)
             (match (tc_replace_go b pat r sel s2)
               ((Prod.mk b1 s3) (Prod.mk (mk_let n ty1 v1 b1) s3))))))))
      ((Proj _ sn i x)
       (match (tc_replace_go x pat r sel seen)
         ((Prod.mk x1 s1) (Prod.mk (mk_proj sn i x1) s1))))
      (_ (Prod.mk t seen)))))
(fn tc_replace_args ((args (List Expr)) (pat Expr) (r Expr) (sel Int) (seen Int) (acc (List Expr)))
  (Prod (List Expr) Int)
  (measure (struct args))
  (match args
    (nil (Prod.mk (rev acc) seen))
    ((cons a rest)
     (match (tc_replace_go a pat r sel seen)
       ((Prod.mk a1 s1) (tc_replace_args rest pat r sel s1 (cons a1 acc)))))))
(fn tc_count ((t Expr) (pat Expr)) Int
  (match (tc_replace_go t pat pat 0 0)
    ((Prod.mk _ k) k)))

;; the subterms of t without loose bound variables, pre-order, left to right, the function
;; before its arguments; an application is one subterm with its whole
;; spine — a prefix of the spine (`ite α c h t` without its `e`) is no subterm, since K's whnf
;; of it is a lambda and a rewrite of it would leave a redex
(fn tc_subterms ((t Expr) (acc (List Expr))) (List Expr)
  (measure (struct t))
  (let ((acc1 (if (has_loose_bvars t) acc (cons t acc))))
    (match t
      ((App _ _ _) (tc_subterms_list (get_app_args t) (tc_subterms (get_app_fn t) acc1)))
      ((Lam _ _ _ d b) (tc_subterms b (tc_subterms d acc1)))
      ((Pi _ _ _ d b) (tc_subterms b (tc_subterms d acc1)))
      ((Let _ _ ty v b) (tc_subterms b (tc_subterms v (tc_subterms ty acc1))))
      ((Proj _ _ _ x) (tc_subterms x acc1))
      (_ acc1))))
(fn tc_subterms_list ((ts (List Expr)) (acc (List Expr))) (List Expr)
  (measure (struct ts))
  (match ts
    (nil acc)
    ((cons x r) (tc_subterms_list r (tc_subterms x acc)))))

;; the equation of a lemma: its term applied to fresh metavariables for every binder, the sides,
;; the metavariables
(type EqOf (EqOk El Expr Level Expr Expr Expr (List Expr)) (EqErr Symbol (List Int)))
(fn eq_of_lemma ((e El) (v Expr) (ty Expr)) EqOf
  (match (tac_arity e ty 64)
    ((Prod.mk e1 k)
     (match (open_mvars e1 v ty k nil)
       ((OpenedM e2 v1 concl ms)
        (match (if (is_app concl) (Prod.mk e2 concl) (el_whnf e2 concl))
          ((Prod.mk e3 cw0)
           (let ((cw (sp_canon (el_zonk e3 cw0))))  ; the sides in the one spelling: the target's
             (match (eq_sides cw)
               ((some (Prod.mk u (Prod.mk a (Prod.mk l r)))) (EqOk e3 v1 u a l r ms))
               (none
                 (EqErr (sym "rw_not_eq")
                   (append (utf8 "the lemma is not an equation: ") (tc_show (el_zonk e3 cw) nil)))))))))))))

;; syntactic matching of a pattern with metavariables against a term: structural descent,
;; a metavariable assigned (typed, unify.shard's assign), levels structurally — never K's
;; conversion, which would unfold a definition to make an instance (`app nil ?ys` against
;; `app (cons x r) nil` by computing both sides: a match, and a useless one)
(fn tac_match ((e El) (p Expr) (t Expr)) (Option El) (tac_match_go e p t 256))
(fn tac_match_go ((e El) (p0 Expr) (t0 Expr) (d Int)) (Option El)
  (measure d)
  (if (< d 1) none
  (let ((p (el_zonk e p0)) (t (el_zonk e t0)))
    (if (expr_eq p t) (some e)
    (match p
      ((MVar _ i)
       (match (assign (el_w e) (el_mc e) i t 32)
         ((UYes w1 mc1) (some (El w1 mc1 (el_cx e) (el_gen e))))
         (_ none)))
      ((App _ pf pa)
       (match t
         ((App _ tf ta)
          (match (tac_match_go e pf tf (- d 1))
            ((some e1) (tac_match_go e1 pa ta (- d 1)))
            (none none)))
         (_ none)))
      ((Const _ n ls)
       (match t
         ((Const _ m ms)
          (if (name_eq n m)
            (match (unify_levels (el_mc e) ls ms)
              ((some mc1) (some (el_set_mc e mc1)))
              (none none))
            none))
         (_ none)))
      ((Sort _ u)
       (match t
         ((Sort _ v)
          (match (unify_level (el_mc e) u v 32)
            ((some mc1) (some (el_set_mc e mc1)))
            (none none)))
         (_ none)))
      ((Lam _ _ _ pd pb)
       (match t
         ((Lam _ _ _ td tb)
          (match (tac_match_go e pd td (- d 1))
            ((some e1) (tac_match_go e1 pb tb (- d 1)))
            (none none)))
         (_ none)))
      ((Pi _ _ _ pd pb)
       (match t
         ((Pi _ _ _ td tb)
          (match (tac_match_go e pd td (- d 1))
            ((some e1) (tac_match_go e1 pb tb (- d 1)))
            (none none)))
         (_ none)))
      ((Let _ _ pty pv pb)
       (match t
         ((Let _ _ tty tv tb)
          (match (tac_match_go e pty tty (- d 1))
            ((some e1)
             (match (tac_match_go e1 pv tv (- d 1))
               ((some e2) (tac_match_go e2 pb tb (- d 1)))
               (none none)))
            (none none)))
         (_ none)))
      ((Proj _ ps pidx px)
       (match t
         ((Proj _ ts ti tx)
          (if (bool_and (name_eq ps ts) (= pidx ti)) (tac_match_go e px tx (- d 1)) none))
         (_ none)))
      (_ none))))))
;; the first subterm of `t` the pattern matches: the state after the match
(fn first_match ((e El) (pat Expr) (subs (List Expr))) (Option El)
  (measure (struct subs))
  (match subs
    (nil none)
    ((cons s r)
     (match (tac_match e pat s)
       ((some e1) (some e1))
       (none (first_match e pat r))))))

;; the equation of one rewrite of the target by heq : a = b (instantiated, closed over the
;; step's locals): target[b] and congrArg motive heq : target = target[b]
(type RwEq (RwEqOk El Expr Expr) (RwEqErr Symbol (List Int)))
(fn rewrite_eq
  ((e El) (ctx (List Expr)) (target Expr) (ty Expr) (a Expr) (b Expr) (heq Expr) (sel Int))
  RwEq
  (match (tac_sort_level e ty)
    ((Prod.mk e1 none) (RwEqErr (sym "rw_motive") (utf8 "the equation's type is not a type")))
    ((Prod.mk e1 (some u))
     (match (el_local e1 (n1 (sym "x")) ty BDefault)
       ((Prod.mk e2 d)
        (let ((body (tc_replace target a d sel)))
          (match (el_lams e2 (list d) body)
            ((Prod.mk e3 motive)
             ;; the motive CHECKED, not only typed: abstracting an occurrence that stands beside
             ;; a proof stating it gives an ill-typed lambda, which an infer-only pass types all
             ;; the same — K would then refuse the whole certificate
             (match (el_infer_checked e3 motive)
               ((Prod.mk e4 none)
                (RwEqErr (sym "rw_motive")
                  (append
                    (utf8 "the motive is not type correct (the occurrence is under a dependency): ")
                    (tc_show_closed e3 ctx body))))
               ((Prod.mk e4 (some _))
                (RwEqOk e4 (tc_replace target a b sel)
                  (mk_app_n (mk_const (n1 (sym "congrArg")) (list u (LSucc LZero)))
                    (list ty (mk_sort LZero) a b motive heq)))))))))))))
;; one rewrite of the target by such an equation: the continuation goal at target[b] and the
;; term Eq.mpr (congrArg motive heq) (its occurrence)
(type Rewritten (TRwOk El Goal Expr Expr) (TRwErr Symbol (List Int)))
(fn rewrite_by
  ((e El) (ctx (List Expr)) (target Expr) (ty Expr) (a Expr) (b Expr) (heq Expr) (sel Int))
  Rewritten
  (match (rewrite_eq e ctx target ty a b heq sel)
    ((RwEqErr x m) (TRwErr x m))
    ((RwEqOk e4 target1 eqn)
     (match (tac_goal e4 ctx target1)
       ((Made e5 g occ)
        (TRwOk e5 g target1
          (mk_app_n (mk_const (n2 (sym "Eq") (sym "mpr")) (list LZero))
            (list target target1 eqn occ))))))))

;; (rw LEMMA (occ K EXPECT?)? BLOCK…): the lemma's left side matched against the target's subterms,
;; every occurrence of the instance rewritten (the K-th alone under occ); the premises left open
;; are child goals. The guard: EXPECT names the instance the author saw at the occurrence — the
;; instance found must be it, by structure or by K's conversion, else the step is refused
;; rw_occ_changed showing both (the source moved under the guard, or the expectation is wrong)
(fn step_rw
  ((e El)
   (ctx (List Expr))
   (target Expr)
   (rv Bool)
   (lem SExpr)
   (sel Int)
   (expect (Option SExpr))
   (bs (List Node)))
  TStep
  (match (elab e lem none)
    ((EErr x m) (StepErr x m))
    ((EOk e1 v ty)
     (match (eq_of_lemma e1 v ty)
       ((EqErr x m) (StepErr x m))
       ((EqOk e2 v1 u a l r ms)
        (let ((pat (if rv r l)) (rhs (if rv l r)))
          (match (first_match e2 pat (rev (tc_subterms target nil)))
            (none
              (StepErr (sym "rw_no_match")
                (append (utf8 "no subterm of the target matches ")
                  (append (tc_show_closed e2 ctx pat)
                    (append (utf8 " in ") (tc_show_closed e2 ctx target))))))
            ((some e3)
             (match (premise_goals e3 ctx ms (sym "rw") nil)
               ((PrErr x m) (StepErr x m))
               ((PrOk e4 gs)
                (match (blocks_match (sym "rw") gs (len bs))
                  ((some (Prod.mk x m)) (StepErr x m))
                  (none
                    (let
                      ((pz (el_zonk e4 pat))
                       (rz (el_zonk e4 rhs))
                       (az (el_zonk e4 a))
                       (hz (el_zonk e4 v1)))
                      (match (tac_unsolved e4 hz)
                        ((some (Prod.mk x m)) (StepErr x m))
                        (none
                          (match (rw_occ_check e4 ctx expect az pz)
                            ((Prod.mk _ (some (Prod.mk x m))) (StepErr x m))
                            ((Prod.mk _ none)
                             (if (bool_and (< 0 sel) (< (tc_count target pz) sel))
                               (StepErr (sym "rw_no_match")
                                 (append (utf8 "the target has ")
                                   (append (show_nat (tc_count target pz))
                                     (append (utf8 " occurrence(s) of ") (tc_show_closed e4 ctx pz)))))
                               (let
                                 ((heq
                                    (if rv
                                      (mk_app_n (mk_const (n2 (sym "Eq") (sym "symm")) (list u))
                                        (list az (el_zonk e4 l) (el_zonk e4 r) hz))
                                      hz)))
                                 (match (rewrite_by e4 ctx (el_zonk e4 target) az pz rz heq sel)
                                   ((TRwErr x m) (StepErr x m))
                                   ((TRwOk e5 g _ term)
                                    (match (tac_close e5 ctx term)
                                      ((Prod.mk e6 filling)
                                       (StepOk e6 filling gs (blocks_of bs nil) (some g)))))))))))))))))))))))))
(fn rw_occ_check ((e El) (ctx (List Expr)) (expect (Option SExpr)) (ty Expr) (found Expr))
  (Prod El (Option (Prod Symbol (List Int))))
  (match expect
    (none (Prod.mk e none))
    ((some s)
     (match (elab e s (some ty))
       ((EErr x m) (Prod.mk e (some (Prod.mk x m))))
       ((EOk e1 v _)
        (let ((vz (sp_canon (el_zonk e1 v))))
          (if (expr_eq vz found) (Prod.mk e1 none)
          (match (el_unify e1 vz found)
            ((some e2) (Prod.mk e2 none))
            (none
              (Prod.mk e1
                (some
                  (Prod.mk (sym "rw_occ_changed")
                    (append (utf8 "(occ K EXPECT): the occurrence found is ")
                      (append (tc_show_closed e1 ctx found)
                        (append (utf8 ", not the expected ")
                          (append (tc_show_closed e1 ctx vz)
                            (utf8
                              " — the source moved under the guard, or the expectation is wrong")))))))))))))))))

;; ---- unfold and reduce -----------------------------------------------------------------------
;; a redex found in the target: the subterm, its replacement, what shows K the step, and
;; whether it is an unfolding at a closed occurrence
(type Evid
  (EvEq Expr Expr Bool)  ; an equation: its carrier, its proof instantiated, whether that proof is Eq.refl (the step K-convertible)
  (EvRule Int Expr Expr)  ; a rule of (using …): its place in the list, its carrier, its proof instantiated
  (EvConv))  ; K's own step on the subterm — a case step, a whnf step, a delta step: K-convertible
(type Redex (Redex Expr Expr Evid Bool))
(type Found (FoundOk El Redex) (FoundNone El))

;; the equations of a constant, in order, until one is missing: a fn's `f.eq_k`; else a
;; realization's `M.f.realize_k` for the module M that attached it — this module, or one it
;; opens (calc runs Init's List.length through std/list's realization and reduces by its
;; equations; a use of the realizing module is needed for that, as the loader records).
;; Only a declaration of the load has equations here: Lean's own `f.eq_k` of a function of
;; Init are in the environment when some proof of Init the load fetched happens to cite
;; them, so a step that unfolded by them would depend on what else was fetched — such a
;; function unfolds by K, by a realization's equations, or by its lemma cited as a rule
(fn equations_of ((e El) (f Name)) (List Name)
  (match (if (native_decl (cx_scope (el_cx e)) f) (equations_go e f (utf8 "eq_") 1 nil) nil)
    (nil
      (realize_equations e f
        (cons (sc_module (cx_scope (el_cx e))) (open_prefixes (sc_opened (cx_scope (el_cx e)))))))
    (eqs eqs)))
(fn realize_equations ((e El) (f Name) (ms (List Name))) (List Name)
  (measure (struct ms))
  (match ms
    (nil nil)
    ((cons m r)
     (match (equations_go e (name_append m f) (utf8 "realize_") 1 nil)
       (nil (realize_equations e f r))
       (eqs eqs)))))
(fn equations_go ((e El) (f Name) (kind (List Int)) (k Int) (acc (List Name))) (List Name)
  (measure (Int.natAbs (- 65 k)))
  (if (< 64 k) (rev acc)
  (let ((n (name_append f (n1 (sym_of_chars (append kind (show_nat k)))))))
    (if (el_sees e n) (equations_go e f kind (+ k 1) (cons n acc)) (rev acc)))))
(fulfills equations_go.dec_1 (by (intro p h hs) (apply natAbs_lt (arith) (arith))))
;; an equation applied to a subterm: its instantiated right side and proof, and whether that
;; proof is Eq.refl (then the replacement is also K-convertible: redex_apply's fallback under a binder)
(fn try_equation ((e El) (s Expr) (eqn Name)) Found
  (match (env_find (el_env e) eqn)
    (none (FoundNone e))
    ((some info)
     (match (el_fresh_levels e (len (ci_lparams info)))
       ((Prod.mk e1 ls)
        (match (w_inst_lparams (el_w e1) (ci_type info) (ci_lparams info) ls)
          ((Prod.mk w2 ty)
           (match (eq_of_lemma (el_set_w e1 w2) (mk_const eqn ls) ty)
             ((EqErr _ _) (FoundNone e))
             ((EqOk e3 v1 _ a l r _)
              (match (tac_match e3 l s)
                ((some e4)
                 (let ((rz (el_zonk e4 r)))
                   (if (has_mvar rz) (FoundNone e)
                   (let ((unf (bool_not (computes e eqn))))
                     (FoundOk e4
                       (Redex s rz (EvEq (el_zonk e4 a) (el_zonk e4 v1) (eqn_definitional info)) unf))))))
                (_ (FoundNone e))))))))))))
(fn eqn_definitional ((info ConstantInfo)) Bool
  (match (ci_value info)
    ((some v) (is_const_named (get_app_fn v) (nm_eq_refl)))
    (none false)))
(fn try_equations ((e El) (s Expr) (eqns (List Name)) (any Bool)) Found
  (measure (struct eqns))
  (match eqns
    (nil (FoundNone e))
    ((cons q r)
     (if (bool_and (bool_not any) (bool_and (bool_not (computes e q)) (bool_not (ground_term e s))))
       (try_equations e s r any)
       (match (try_equation e s q)
         ((FoundOk e1 rd) (FoundOk e1 rd))
         (_ (try_equations e s r any)))))))
;; a computation rule: an equation whose left side has a constructor or a literal among its
;; arguments — `f (cons x r) ys = …`. `f n = ite …` (a measured function's one leaf) is an
;; unfolding, which `reduce` applies only to a ground occurrence (a ground computation ends,
;; the budget bounding it) — at a variable it would apply to its own result without end — and
;; `unfold` applies once per occurrence. Ground: no local, no metavariable, and every constant
;; a definition, a constructor, a recursor, an inductive or a quotient — an opaque constant, an
;; axiom or a parameter (a pending obligation) never reduces, so nothing under it ends
(fn ground_term ((e El) (s Expr)) Bool
  (if (bool_or (has_fvar s) (has_mvar s)) false (consts_reduce e (expr_consts s))))
(fn consts_reduce ((e El) (ns (List Name))) Bool
  (measure (struct ns))
  (match ns
    (nil true)
    ((cons n r)
     (match (env_find (el_env e) n)
       ((some (DefnInfo _ _ _ _ _)) (consts_reduce e r))
       ((some (CtorInfo _ _ _ _ _ _)) (consts_reduce e r))
       ((some (RecInfo _ _ _ _ _ _ _ _ _)) (consts_reduce e r))
       ((some (InductInfo _ _ _ _ _ _ _ _ _)) (consts_reduce e r))
       ((some (QuotInfo _ _)) (consts_reduce e r))
       (_ false)))))
(fn computes ((e El) (eqn Name)) Bool
  (match (env_find (el_env e) eqn)
    (none false)
    ((some info) (lhs_has_ctor (el_env e) (pi_body (ci_type info) 64)))))
(fn pi_body ((t Expr) (fuel Int)) Expr
  (measure (Int.natAbs fuel))
  (if (< fuel 1) t
  (match t
    ((Pi _ _ _ _ b) (pi_body b (- fuel 1)))
    (_ t))))
(fulfills pi_body.dec_1 (by (intro p h a n bi d b hm) (apply natAbs_pred (arith))))
(fn lhs_has_ctor ((env CheckedEnv) (stmt Expr)) Bool
  (match (eq_sides stmt)
    ((some (Prod.mk _ (Prod.mk _ (Prod.mk l _)))) (args_have_ctor env (get_app_args l)))
    (none false)))
(fn args_have_ctor ((env CheckedEnv) (args (List Expr))) Bool
  (measure (struct args))
  (match args
    (nil false)
    ((cons a r) (if (ctor_shaped env a) true (args_have_ctor env r)))))
(fn ctor_shaped ((env CheckedEnv) (a Expr)) Bool
  (match (get_app_fn a)
    ((Const _ n _)
     (match (env_find env n)
       ((some (CtorInfo _ _ _ _ _ _)) true)
       (_ false)))
    ((Lit _ _) true)
    (_ false)))
;; whether a head stands for a stuck eliminator: no progress by whnf there — a recursor, a
;; case analysis, course-of-values recursion and its helpers (`List.brecOn.go`), a matcher,
;; well-founded fixpoints; a projection of a stuck term is stuck
(fn stuck_head ((t Expr)) Bool
  (match (get_app_fn t)
    ((Const _ n _) (stuck_name n))
    ((Proj _ _ _ x) (stuck_head x))
    (_ false)))
(fn stuck_name ((n Name)) Bool
  (match n
    ((Str p c)
     (let ((cs (chars_of_sym c)))
       (if
         (bool_or (int_list_eq cs (utf8 "rec"))
           (bool_or (int_list_eq cs (utf8 "casesOn"))
             (bool_or (int_list_eq cs (utf8 "brecOn"))
               (bool_or (int_list_eq cs (utf8 "binductionOn"))
                 (bool_or (int_list_eq cs (utf8 "below"))
                   (bool_or (int_list_eq cs (utf8 "ibelow"))
                     (bool_or (int_list_eq cs (utf8 "fix")) (starts_match cs (utf8 "match_")))))))))
         true
         (stuck_name p))))
    ((Num p _) (stuck_name p))
    (Anon false)))
(fn starts_match ((s (List Int)) (p (List Int))) Bool
  (match (starts_with_lit p s)
    ((some _) true)
    (none false)))
;; a head constant's facts the scan asks at every subterm, found once and kept for the loop:
;; its equations and whether K's whnf may unfold it. Unkept, equations_of builds and looks up
;; `f.eq_k` — and for a head with none, every constructor, `M.f.realize_k` for the module and
;; each one it opens — at each of a goal's subterms on every step, each lookup a hash of the
;; name's bytes: most of a whole-run reduction's time
(type HeadFacts (HeadFacts Name (List Name) Bool))
(fn head_find ((hs (List HeadFacts)) (f Name)) (Option HeadFacts)
  (measure (struct hs))
  (match hs
    (nil none)
    ((cons (HeadFacts g q u) r) (if (name_eq g f) (some (HeadFacts g q u)) (head_find r f)))))
(fn head_of ((e El) (hs (List HeadFacts)) (f Name)) (Prod (List HeadFacts) HeadFacts)
  (match (head_find hs f)
    ((some h) (Prod.mk hs h))
    (none (head_new hs (HeadFacts f (equations_of e f) (reducible_head e f))))))
(fn head_new ((hs (List HeadFacts)) (h HeadFacts)) (Prod (List HeadFacts) HeadFacts)
  (Prod.mk (cons h hs) h))
;; a whnf step that makes progress: the result (its head beta-reduced) differs and its head is
;; neither a stuck eliminator nor a lambda (a function constant's value is no reduction of it).
;; K's whnf reduces the head as far as it goes, past the one step wanted — an `ite` on a
;; decided condition to its branch, then that branch's `fn` unfolded to its recursor form —
;; so every application of a constant with equations inside `s` is masked by a local first (K
;; cannot unfold a local) and restored after
(fn whnf_progress ((e El) (hs (List HeadFacts)) (s Expr))
  (Prod (List HeadFacts) (Prod El (Option Expr)))
  (match (mask_fns e hs (rev (tc_subterms s nil)) s nil)
    ((Prod.mk hs1 (Prod.mk e1 (Prod.mk sm masks)))
     (match (w_whnf_r (el_w e1) sm)
       ((Prod.mk w1 (WVal r0))
        (match (tac_beta (el_set_w e1 w1) r0)
          ((Prod.mk e2 rm)
           (let ((r (unmask masks rm)))
             (if (bool_or (expr_eq r s) (bool_or (stuck_head r) (is_lambda (get_app_fn r))))
               (Prod.mk hs1 (Prod.mk e2 none))
               (Prod.mk hs1 (Prod.mk e2 (some r))))))))
       ((Prod.mk w1 _) (Prod.mk hs1 (Prod.mk (el_set_w e1 w1) none)))))))
;; the applications (whole spines) of constants with equations among the subterms, each
;; replaced by a fresh local of its type: the masked term and the (local, subterm) pairs
(fn mask_fns
  ((e El) (hs (List HeadFacts)) (subs (List Expr)) (t Expr) (acc (List (Prod Expr Expr))))
  (Prod (List HeadFacts) (Prod El (Prod Expr (List (Prod Expr Expr)))))
  (measure (struct subs))
  (match subs
    (nil (Prod.mk hs (Prod.mk e (Prod.mk t acc))))
    ((cons s r)
     (if (bool_not (is_app s)) (mask_fns e hs r t acc)
     (match (get_app_fn s)
       ((Const _ f _)
        (match (head_of e hs f)
          ((Prod.mk hs1 (HeadFacts _ nil _)) (mask_fns e hs1 r t acc))
          ((Prod.mk hs1 _)
           (if (= (tc_count t s) 0) (mask_fns e hs1 r t acc)
           (match (el_infer e s)
             ((Prod.mk e1 none) (mask_fns e1 hs1 r t acc))
             ((Prod.mk e1 (some ty))
              (match (el_local e1 (n1 (sym "fn")) ty BDefault)
                ((Prod.mk e2 fv)
                 (mask_fns e2 hs1 r (tc_replace t s fv 0) (cons (Prod.mk fv s) acc))))))))))
       (_ (mask_fns e hs r t acc)))))))
(fn unmask ((masks (List (Prod Expr Expr))) (t Expr)) Expr
  (measure (struct masks))
  (match masks
    (nil t)
    ((cons (Prod.mk fv s) r) (unmask r (tc_replace t fv s 0)))))
;; ---- reduce's rules: (reduce SIDE? (using RULE…)) -------------------------------------------
;; A rule is a fact the run rewrites by where its left side stands: a hypothesis, a lemma
;; applied to its premises ((if_pos h)), a lemma whose data arguments the match finds. It
;; carries its place in the list (from 1), the head of its left side — a constant, a local, or
;; neither —, the functions that left side applies (the run holds them: rules_hold), that left
;; side as first elaborated (an argument left open a metavariable: the scan's test before a rule
;; is elaborated at a subterm) and as shown then (its metavariables are that elaboration's: a
;; later state would read them as its own), whether it is reversed, its term. A rule is
;; elaborated anew where it is tried: what the elaborator left open is the match's to assign,
;; per use. Nothing is looked for: a rule with an argument its left side does not fix
;; — a premise, a value only a premise fixes — is refused before the run
(type RuleHead (RhConst Name) (RhLocal Expr) (RhAny))
(type Rule (Rule Int RuleHead (List Name) Expr (List Int) Bool SExpr))
(type RulesRes (RulesOk (List Rule)) (RulesErr Symbol (List Int)))
(fn rules_prepare
  ((e El) (ctx (List Expr)) (rules (List (Prod Bool SExpr))) (idx Int) (acc (List Rule)))
  RulesRes
  (measure (struct rules))
  (match rules
    (nil (RulesOk (rev acc)))
    ((cons (Prod.mk rv lem) r)
     (match (elab e lem none)
       ((EErr x m)
        (RulesErr x (append (utf8 "rule ") (append (show_nat idx) (append (utf8 ": ") m)))))
       ((EOk e1 v ty)
        (match (eq_of_lemma e1 v ty)
          ((EqErr x m)
           (RulesErr x
             (append (utf8 "rule ")
               (append (show_nat idx)
                 (append (utf8 ": ")
                   (append m
                     (fn_not_rule e1 v
                       (utf8
                         " — reduce applies a function's equations unnamed: leave it out (a constant without arguments unfolds by (unfold NAME), or by its NAME.eq_1 as the rule)"))))))))
          ((EqOk e2 _ _ _ l rr ms)
           (let ((pat (el_zonk e2 (if rv rr l))))
             (match (open_arg e2 ms (mvars_of pat nil))
               ((some ty)
                (RulesErr (sym "reduce_rule_open")
                  (append (utf8 "rule ")
                    (append (show_nat idx)
                      (append (utf8 " has an argument its left side does not fix, of type ")
                        (append (tc_show_closed e2 ctx ty)
                          (utf8
                            ": a rule is given its premises, as (if_pos h) — reduce looks for none")))))))
               (none
                 (rules_prepare e ctx r (+ idx 1)
                   (cons
                     (Rule idx (rule_head pat) (pat_fns e2 (tc_subterms pat nil) nil) pat
                       (tc_show_closed e2 ctx pat)
                       rv
                       lem)
                     acc))))))))))))
;; the first binder left open that the left side does not hold: its type
(fn open_arg ((e El) (ms (List Expr)) (inpat (List Int))) (Option Expr)
  (measure (struct ms))
  (match ms
    (nil none)
    ((cons (MVar _ i) r)
     (match (mc_assigned (el_mc e) i)
       ((some _) (open_arg e r inpat))
       (none
         (if (has_int inpat i) (open_arg e r inpat)
         (match (mc_decl (el_mc e) i)
           (none (open_arg e r inpat))
           ((some d) (some (el_zonk e (md_type d)))))))))
    ((cons _ r) (open_arg e r inpat))))
;; the pointer where a function's name stands for a rule
(fn fn_not_rule ((e El) (v Expr) (pointer (List Int))) (List Int)
  (match (get_app_fn v)
    ((Const _ f _)
     (match (equations_of e f)
       (nil (utf8 ""))
       (_ pointer)))
    (_ (utf8 ""))))
(fn rule_head ((pat Expr)) RuleHead
  (match (get_app_fn pat)
    ((Const _ f _) (RhConst f))
    ((FVar n i) (RhLocal (FVar n i)))
    (_ (RhAny))))
(fn rule_head_fits ((h RuleHead) (s Expr)) Bool
  (match h
    ((RhConst f)
     (match (get_app_fn s)
       ((Const _ g _) (name_eq f g))
       (_ false)))
    ((RhLocal x) (expr_eq (get_app_fn s) x))
    (RhAny true)))
;; the functions a rule's left side applies: the constants with equations that head an
;; application among its subterms, its own head among them
(fn pat_fns ((e El) (subs (List Expr)) (acc (List Name))) (List Name)
  (measure (struct subs))
  (match subs
    (nil acc)
    ((cons s r)
     (if (bool_not (is_app s)) (pat_fns e r acc)
     (match (get_app_fn s)
       ((Const _ f _)
        (if (mem_name f acc) (pat_fns e r acc)
        (match (equations_of e f)
          (nil (pat_fns e r acc))
          (_ (pat_fns e r (cons f acc))))))
       (_ (pat_fns e r acc)))))))
;; the hold: an application of a function some rule's left side applies — at its head or
;; anywhere inside — has its equations wait while a rule or another redex is found. The run
;; does not take apart what a fact is made of: a call a fact speaks of keeps its form while its
;; arguments reach the form the fact states, and the fact's own arguments keep theirs (a call's
;; result rewritten in, not the call run). A case step is never held: an `ite` kept from its
;; step has its instance reduced in place, and the rewrite of a subterm a proof inside it is
;; typed by makes a motive K refuses
(fn rules_hold ((rules (List Rule)) (f Name)) Bool
  (measure (struct rules))
  (match rules
    (nil false)
    ((cons (Rule _ _ fs _ _ _ _) r) (if (mem_name f fs) true (rules_hold r f)))))
;; whether the left side as first elaborated can match the subterm: a metavariable fits
;; anything, the rest by structure (no state: the scan asks it at every subterm a head fits)
(fn pat_fits ((p Expr) (t Expr) (d Int)) Bool
  (measure d)
  (if (< d 1) true
  (match p
    ((MVar _ _) true)
    ((App _ pf pa)
     (match t
       ((App _ tf ta) (if (pat_fits pf tf (- d 1)) (pat_fits pa ta (- d 1)) false))
       (_ false)))
    ((Const _ n _)
     (match t
       ((Const _ m _) (name_eq n m))
       (_ false)))
    (_ (expr_eq p t)))))
;; the first rule that rewrites the subterm: its left side matches, nothing of it is left
;; open, and the right side neither is the subterm nor holds it. A subterm under a binder is
;; left to the reduction (no motive abstracts it)
(fn try_rules ((e El) (s Expr) (rules (List Rule))) Found
  (measure (struct rules))
  (match rules
    (nil (FoundNone e))
    ((cons (Rule i h _ pat _ rv lem) r)
     (if
       (bool_or (bool_not (rule_head_fits h s))
         (bool_or (has_loose_bvars s) (bool_not (pat_fits pat s 64))))
       (try_rules e s r)
       (match (try_rule e s i rv lem)
         ((FoundOk e1 rd) (FoundOk e1 rd))
         (_ (try_rules e s r)))))))
(fn try_rule ((e El) (s Expr) (i Int) (rv Bool) (lem SExpr)) Found
  (match (elab e lem none)
    ((EErr _ _) (FoundNone e))
    ((EOk e1 v ty)
     (match (eq_of_lemma e1 v ty)
       ((EqErr _ _) (FoundNone e))
       ((EqOk e2 v1 u a l rr _)
        (match (tac_match e2 (if rv rr l) s)
          (none (FoundNone e))
          ((some e3)
           (let ((rz (el_zonk e3 (if rv l rr))) (az (el_zonk e3 a)) (hz (el_zonk e3 v1)))
             (if
               (bool_or (has_mvar rz)
                 (bool_or (< 0 (tc_count rz s))
                   (match (tac_unsolved e3 hz)
                     ((some _) true)
                     (none false))))
               (FoundNone e)
               (FoundOk e3
                 (Redex s rz
                   (EvRule i az
                     (if rv
                       (mk_app_n (mk_const (n2 (sym "Eq") (sym "symm")) (list u))
                         (list az (el_zonk e3 l) (el_zonk e3 rr) hz))
                       hz))
                   false)))))))))))
;; the rules that rewrote: a rule that never did is refused at the run's end (the list is what
;; the run used, no more)
(fn has_int ((is (List Int)) (i Int)) Bool
  (measure (struct is))
  (match is
    (nil false)
    ((cons j r) (if (= i j) true (has_int r i)))))
(fn fired_add ((fired (List Int)) (rd Redex)) (List Int)
  (match rd
    ((Redex _ _ (EvRule i _ _) _) (if (has_int fired i) fired (cons i fired)))
    (_ fired)))
(fn rule_unused ((rules (List Rule)) (fired (List Int))) (Option Rule)
  (measure (struct rules))
  (match rules
    (nil none)
    ((cons (Rule i h fs pat sh rv lem) r)
     (if (has_int fired i) (rule_unused r fired) (some (Rule i h fs pat sh rv lem))))))
;; ---- where a run waits ------------------------------------------------------------------------
;; a case analysis waiting at an open discriminant (alt_open_discriminant): that discriminant
(fn wait_disc ((e El) (s Expr)) (Option Expr)
  (match (get_app_fn s)
    ((Const _ f _)
     (if (has_loose_bvars s) none
     (match (alt_positions e f (len (get_app_args s)))
       (nil none)
       (_
         (if (alt_open_discriminant e f (get_app_args s))
           (nth (get_app_args s) (alt_discriminant_index e f))
           none)))))
    (_ none)))
(fn waits_any ((e El) (subs (List Expr))) Bool
  (measure (struct subs))
  (match subs
    (nil false)
    ((cons s r)
     (match (wait_disc e s)
       ((some _) true)
       (none (waits_any e r))))))
;; the first waiting case analysis with none waiting inside its discriminant — where the run
;; stands, not what stands on it: an `ite`'s condition, a matcher's scrutinee
(fn waits_leaf ((e El) (subs (List Expr))) (Option Expr)
  (measure (struct subs))
  (match subs
    (nil none)
    ((cons s r)
     (match (wait_disc e s)
       (none (waits_leaf e r))
       ((some d)
        (if (waits_any e (rev (tc_subterms d nil))) (waits_leaf e r) (some (wait_shown s d))))))))
(fn wait_shown ((s Expr) (d Expr)) Expr
  (match (get_app_fn s)
    ((Const _ f _)
     (if (bool_or (name_eq f (n1 (sym "ite"))) (name_eq f (n1 (sym "dite"))))
       (match (nth (get_app_args s) 1)
         ((some c) c)
         (none d))
       d))
    (_ d)))
(fn waits_note ((e El) (ctx (List Expr)) (t Expr)) (List Int)
  (match (waits_leaf e (rev (tc_subterms t nil)))
    (none (utf8 ""))
    ((some d) (append (utf8 " — a case analysis waits at ") (take 600 (tc_show_closed e ctx d))))))
;; the first redex among the subterms (pre-order): a `fn` by its equations only, a stuck
;; eliminator never, a case analysis at a decided scrutinee by its alternative, anything else by
;; K's whnf or one delta step where it progresses — on a CLOSED subterm only: on an open term
;; K's unfolding of an imported definition is no computation (`Nat.land a 1` to its
;; well-founded internals, `a + 8` to eight successors) and buries the term a later rewrite
;; must match; an open occurrence unfolds by its equations, by a case step, or by name.
;; `only` restricts to the named constants (unfold), open or closed
(fn find_redex
  ((e El) (rules (List Rule)) (hs (List HeadFacts)) (subs (List Expr)) (only (List Name)))
  (Prod (List HeadFacts) Found)
  (measure (struct subs))
  (match subs
    (nil (Prod.mk hs (FoundNone e)))
    ((cons s r)
     (match (try_rules e s rules)
       ((FoundOk e9 rd) (Prod.mk hs (FoundOk e9 rd)))
       (_
         (match (get_app_fn s)
           ((Const _ f _)
            (if (bool_and (bool_not (= (len only) 0)) (bool_not (mem_name f only)))
              (find_redex e rules hs r only)
            (if (bool_and (= (len only) 0) (= (len (get_app_args s)) 0))
              (find_redex e rules hs r only)  ; a bare constant is no redex: its unfolding is a lambda over the arguments it lacks
              (match (head_of e hs f)
                ((Prod.mk hs1 (HeadFacts _ nil red))
                 (if (if (= (len only) 0) (if red (is_proposition e s) true) false)  ; asked in this order: the type of a constructor's application is never inferred
                   (find_redex e rules hs1 r only)
                   (match (alt_step e s)
                     ((Prod.mk e0 (some t)) (Prod.mk hs1 (FoundOk e0 (Redex s t EvConv false))))
                     ((Prod.mk e0 none)
                      (if (bool_and (= (len only) 0) (bool_or (has_fvar s) (has_loose_bvars s)))
                        (find_redex e0 rules hs1 r only)  ; the goal's context is bound in the closed target
                        (match (whnf_progress e0 hs1 s)
                          ((Prod.mk hs2 (Prod.mk e1 (some t)))
                           (Prod.mk hs2 (FoundOk e1 (Redex s t EvConv false))))
                          ((Prod.mk hs2 (Prod.mk e1 none))
                           (match (delta_once e1 s)
                             ((Prod.mk e2 (some t))
                              (Prod.mk hs2 (FoundOk e2 (Redex s t EvConv false))))
                             ((Prod.mk e2 none) (find_redex e2 rules hs2 r only))))))))))
                ((Prod.mk hs1 (HeadFacts _ eqns _))
                 (if (rules_hold rules f) (find_redex e rules hs1 r only)  ; a function a rule's left side applies: its equations wait while anything else steps (reduce_loop)
                 (match (try_equations e s eqns (bool_not (= (len only) 0)))
                   ((FoundOk e1 rd) (Prod.mk hs1 (FoundOk e1 rd)))
                   (_ (find_redex e rules hs1 r only)))))))))
           (_
             (if (= (len only) 0)
               (match (whnf_progress e hs s)
                 ((Prod.mk hs1 (Prod.mk e1 (some t)))
                  (Prod.mk hs1 (FoundOk e1 (Redex s t EvConv false))))
                 ((Prod.mk hs1 (Prod.mk e1 none)) (find_redex e1 rules hs1 r only)))
               (find_redex e rules hs r only)))))))))
;; a case analysis at a decided scrutinee takes one step, to its alternative. K's
;; whnf goes on into the alternative's body — an `ite` on an open condition there is a stuck
;; Decidable.rec, which whnf_progress reads as no progress — so the alternatives (an `ite`'s
;; branches, a matcher's rows) are masked by locals while K picks one, and the one picked is
;; applied to the fields K gave it (and to the equation a measured function's matcher carries)
(fn alt_step ((e El) (s Expr)) (Prod El (Option Expr))
  (match (get_app_fn s)
    ((Const _ f _)
     (match (alt_positions e f (len (get_app_args s)))
       (nil (Prod.mk e none))
       (ps
         (if (alt_open_discriminant e f (get_app_args s)) (Prod.mk e none)  ; no K whnf at an open, non-constructor discriminant: its equations first
         (match (alt_mask e (get_app_args s) ps 0 nil nil)
           ((Prod.mk e1 (Prod.mk margs masks))
            (match (w_whnf_r (el_w e1) (mk_app_n (get_app_fn s) margs))
              ((Prod.mk w1 (WVal r0))
               (match (get_app_fn r0)
                 ((FVar _ id)
                  (if (mask_has masks id)
                    (match (tac_beta (el_set_w e1 w1) (unmask masks r0))
                      ((Prod.mk e3 r) (Prod.mk e3 (some r))))
                    (Prod.mk (el_set_w e1 w1) none)))
                 (_ (Prod.mk (el_set_w e1 w1) none))))
              ((Prod.mk w1 _) (Prod.mk (el_set_w e1 w1) none)))))))))
    (_ (Prod.mk e none))))
;; the case step's discriminant — the instance of an `ite`/`dite`, the scrutinee of a matcher —
;; when it is open and not constructor-headed: K's whnf there is no
;; computation but a search through the definitions the discriminant is built from (a
;; well-founded `fn` over an open list to its accessibility proofs: ten minutes and the box's
;; memory on `len`'s tag test), so the step waits; the discriminant reduces by its equations as
;; a subterm, and the case step fires once a constructor stands at its head
(fn alt_open_discriminant ((e El) (f Name) (args (List Expr))) Bool
  (match (nth args (alt_discriminant_index e f))
    ((some d)
     (bool_and (bool_or (has_fvar d) (has_loose_bvars d)) (bool_not (ctor_shaped (el_env e) d))))
    (none false)))
(fn alt_discriminant_index ((e El) (f Name)) Int
  (if (bool_or (name_eq f (n1 (sym "ite"))) (name_eq f (n1 (sym "dite")))) 2
  (match (mt_is_matcher (el_env e) f)
    ((some (MtDesc np _ _)) (+ np 1))
    (_ 0))))
(fn alt_positions ((e El) (f Name) (nargs Int)) (List Int)
  (if (bool_or (name_eq f (n1 (sym "ite"))) (name_eq f (n1 (sym "dite"))))
    (if (< 4 nargs) (list 3 4) nil)
    (match (mt_is_matcher (el_env e) f)
      ((some (MtDesc np 1 rows))
       (if (< (+ np (+ 1 (len rows))) nargs) (range_from (+ np 2) (len rows)) nil))
      (_ nil))))
(fn range_from ((a Int) (n Int)) (List Int)
  (measure (Int.natAbs n))
  (if (< n 1) nil (cons a (range_from (+ a 1) (- n 1)))))
(fulfills range_from.dec_1 (by (intro p h) (apply natAbs_pred (arith))))
(fn alt_mask
  ((e El)
   (args (List Expr))
   (ps (List Int))
   (i Int)
   (acc (List Expr))
   (masks (List (Prod Expr Expr))))
  (Prod El (Prod (List Expr) (List (Prod Expr Expr))))
  (measure (struct args))
  (match args
    (nil (Prod.mk e (Prod.mk (rev acc) masks)))
    ((cons a r)
     (if (mem_int i ps)
       (match (el_infer e a)
         ((Prod.mk e1 none) (alt_mask e1 r ps (+ i 1) (cons a acc) masks))
         ((Prod.mk e1 (some ty))
          (match (el_local e1 (n1 (sym "alt")) ty BDefault)
            ((Prod.mk e2 fv) (alt_mask e2 r ps (+ i 1) (cons fv acc) (cons (Prod.mk fv a) masks))))))
       (alt_mask e r ps (+ i 1) (cons a acc) masks)))))
(fn mask_has ((masks (List (Prod Expr Expr))) (id Int)) Bool
  (measure (struct masks))
  (match masks
    (nil false)
    ((cons (Prod.mk (FVar _ j) _) r) (if (= j id) true (mask_has r id)))
    ((cons _ r) (mask_has r id))))
;; a proposition is no computation: reduce leaves `a < b` as it is (Nat.lt's value is Nat.le
;; at the successor, Int.le's a predicate of the difference — unfolded, neither reads as the
;; comparison nor is one to arith); unfold by name still unfolds it
(fn is_proposition ((e El) (s Expr)) Bool
  (match (w_is_prop (el_w e) s)
    ((Prod.mk _ (some true)) true)
    (_ false)))
;; one delta step by hand, for a definition K's whnf takes past the one step wanted (`double x`
;; to `x + x`, which K then unfolds to a stuck recursor): the value at the constant's levels,
;; head-beta-reduced on the arguments; kept where the result is neither a lambda nor stuck
(fn delta_once ((e El) (s Expr)) (Prod El (Option Expr))
  (match (get_app_fn s)
    ((Const _ f ls)
     (match (env_find (el_env e) f)
       ((some (DefnInfo (ConstantVal _ lps _) v _ _ _))
        (match (w_inst_lparams (el_w e) v lps ls)
          ((Prod.mk w1 v1)
           (match (beta_head (w_st w1) v1 (get_app_args s))
             ((Prod.mk st2 r)
              (let ((e2 (el_set_w e (w_set_st w1 st2))))
                (if (bool_or (expr_eq r s) (bool_or (stuck_head r) (is_lambda (get_app_fn r))))
                  (Prod.mk e2 none)
                  (Prod.mk e2 (some r)))))))))
       (_ (Prod.mk e none))))
    (_ (Prod.mk e none))))
;; a head K's whnf may unfold under reduce: a definition (not a theorem, an axiom, an inductive
;; or a constructor — whose applications are values)
(fn reducible_head ((e El) (f Name)) Bool
  (match (env_find (el_env e) f)
    ((some (DefnInfo _ _ _ _ _)) true)
    ((some (RecInfo _ _ _ _ _ _ _ _ _)) true)
    ((some (QuotInfo _ _)) true)
    (_ false)))

;; one redex applied: the next target and the step's equation target = next — a rewrite of the
;; occurrence by the equation's own proof where an equation justifies the step, by Eq.refl at
;; the subterm where the step is K's — so K checks each step where it happened. A step left to
;; conversion changes the target and has no equation (None): K then compares two whole targets
;; by its own reduction, which does not wait at an open discriminant as the reducer does (a
;; branch on wide-word arithmetic over a local: no end). Conversion stays for an occurrence no
;; motive abstracts — under a binder, or under a dependency — where the step is K-convertible
(type RdApp (RaOk El Expr (Option Expr)) (RaErr Symbol (List Int)))
(fn redex_apply ((e El) (ctx (List Expr)) (target Expr) (rd Redex)) RdApp
  (match rd
    ((Redex s t ev _)
     (match (redex_evidence e s t ev)
       ((Prod.mk e1 none) (RaOk e1 (tc_replace target s t 0) none))
       ((Prod.mk e1 (some (Prod.mk ty heq)))
        (match (rewrite_eq e1 ctx target ty s t heq 0)
          ((RwEqErr x m)
           (if (evid_convertible ev) (RaOk e1 (tc_replace target s t 0) none) (RaErr x m)))
          ((RwEqOk e2 target1 eqn) (RaOk e2 target1 (some eqn)))))))))
;; the carrier and the proof of s = t for the rewrite; None where the occurrence is under a
;; binder (or has no type of its own) and the step is K-convertible
(fn redex_evidence ((e El) (s Expr) (t Expr) (ev Evid)) (Prod El (Option (Prod Expr Expr)))
  (match ev
    ((EvEq ty heq conv)
     (if (bool_and conv (has_loose_bvars s)) (Prod.mk e none) (Prod.mk e (some (Prod.mk ty heq)))))
    ((EvRule _ ty heq) (Prod.mk e (some (Prod.mk ty heq))))
    (EvConv
      (if (has_loose_bvars s) (Prod.mk e none)
      (match (el_infer e s)
        ((Prod.mk e1 none) (Prod.mk e1 none))
        ((Prod.mk e1 (some ty))
         (match (tac_sort_level e1 ty)
           ((Prod.mk e2 none) (Prod.mk e2 none))
           ((Prod.mk e2 (some u))
            (Prod.mk e2 (some (Prod.mk ty (mk_app (mk_app (mk_const (nm_eq_refl) (list u)) ty) t))))))))))))
(fn evid_convertible ((ev Evid)) Bool
  (match ev
    ((EvEq _ _ conv) conv)
    ((EvRule _ _ _) false)
    (EvConv true)))
;; a loop's certified steps: from, to, the equation from = to; kept latest first
(type Leg (Leg Expr Expr Expr))
(fn legs_add ((legs (List Leg)) (from Expr) (to Expr) (eqn (Option Expr))) (List Leg)
  (match eqn
    (none legs)
    ((some h) (cons (Leg from to h) legs))))
;; the legs' equations composed in order, as a balanced tree of Eq.trans: K's recursion is
;; bounded in depth, and a chain of one Eq.mpr per step is as deep as the steps are many
;; (exhausted_rec_depth_at_infer on a run of a few statements). Where a conversion step stood
;; between two legs the left one's end and the right one's start differ and K converts there
(fn legs_join ((legs (List Leg)) (fuel Int)) (Option Leg)
  (measure (Int.natAbs fuel))
  (if (< fuel 1) none
  (match legs
    (nil none)
    ((cons l nil) (some l))
    (_ (legs_join (legs_pairs legs nil) (- fuel 1))))))
(fn legs_pairs ((legs (List Leg)) (acc (List Leg))) (List Leg)
  (measure (struct legs))
  (match legs
    (nil (rev acc))
    ((cons l nil) (rev (cons l acc)))
    ((cons (Leg a b h1) (cons (Leg _ c h2) r))
     (legs_pairs r
       (cons
         (Leg a c
           (mk_app_n (mk_const (n2 (sym "Eq") (sym "trans")) (list (LSucc LZero)))
             (list (mk_sort LZero) a b c h1 h2)))
         acc)))))
(fulfills legs_join.dec_1 (by (intro p h x hx) (apply natAbs_pred (arith))))
;; the term at the loop's start for the continuation's occurrence at its end: Eq.mpr of the
;; composed equation, or the occurrence itself where every step was by conversion
(fn legs_term ((start Expr) (target Expr) (legs (List Leg)) (occ Expr)) Expr
  (match (legs_join (rev legs) 32)
    (none occ)
    ((some (Leg _ _ h))
     (mk_app_n (mk_const (n2 (sym "Eq") (sym "mpr")) (list LZero)) (list start target h occ)))))
;; the loop's end: the current goal (its target `start`) assigned its continuation at the final target
(type Loop (LoopOk El Goal) (LoopErr Symbol (List Int)))
(fn loop_end ((e El) (ctx (List Expr)) (cur Goal) (start Expr) (target Expr) (legs (List Leg))) Loop
  (match (tac_goal e ctx target)
    ((Made e2 g occ)
     (match (tac_close e2 ctx (legs_term start target legs occ))
       ((Prod.mk e3 filling) (LoopOk (el_set_mc e3 (mc_set (el_mc e3) (goal_id cur) filling)) g))))))
;; reduce: the first redex of the target (or of one side), to a fixpoint under a budget of 2000
;; rewrites and 64 unfoldings of a function at closed arguments (a ground computation deeper
;; than that — a condition no reduction decides, a long recursion — is the author's to unfold)
(fn reduce_loop
  ((e El)
   (ctx (List Expr))
   (cur Goal)
   (start Expr)
   (target Expr)
   (legs (List Leg))
   (hs (List HeadFacts))
   (rules (List Rule))
   (fired (List Int))
   (side Symbol)
   (budget Int)
   (unfolds Int))
  Loop
  (measure budget)
  (if (< budget 1)
    (LoopErr (sym "reduce_budget") (utf8 "the normalization ran out of budget (2000 rewrites)"))
  (if (< 64 unfolds)
    (LoopErr (sym "reduce_budget")
      (append (utf8 "64 unfoldings of a function at closed arguments did not end the computation: ")
        (tc_show_closed e ctx target)))
    (match (find_redex e rules hs (rev (tc_subterms (side_of target side) nil)) nil)
      ((Prod.mk hs0 (FoundNone e0))
       (let
         ((again (Prod (List HeadFacts) Found)
            (match rules
              (nil (Prod.mk hs0 (FoundNone e0)))
              (_ (find_redex e0 nil hs0 (rev (tc_subterms (side_of target side) nil)) nil)))))  ; no rule and nothing beside what the rules hold: that steps
         (match again
           ((Prod.mk _ (FoundNone e1))  ; a normalization: nothing to do is done — and every rule given was used
            (match (rule_unused rules fired)
              (none (loop_end e1 ctx cur start target legs))
              ((some (Rule i _ _ _ sh _ _))
               (LoopErr (sym "reduce_rule_unused")
                 (append (utf8 "rule ")
                   (append (show_nat i)
                     (append
                       (utf8 " rewrote nothing: no subterm of the run matched its left side, ")
                       (append sh
                         (append (utf8 ", in ")
                           (append (show_nat (- 2000 budget))
                             (append (utf8 " rewrites") (waits_note e1 ctx (side_of target side)))))))))))))
           ((Prod.mk hs1 (FoundOk e1 rd))
            (reduce_step e1 ctx cur start target legs hs1 rules fired side budget unfolds rd)))))
      ((Prod.mk hs1 (FoundOk e1 rd))
       (reduce_step e1 ctx cur start target legs hs1 rules fired side budget unfolds rd))))))
(fn reduce_step
  ((e El)
   (ctx (List Expr))
   (cur Goal)
   (start Expr)
   (target Expr)
   (legs (List Leg))
   (hs (List HeadFacts))
   (rules (List Rule))
   (fired (List Int))
   (side Symbol)
   (budget Int)
   (unfolds Int)
   (rd Redex))
  Loop
  (match (redex_apply e ctx target rd)
    ((RaErr x m) (LoopErr x m))
    ((RaOk e2 target1 eqn)
     (reduce_loop e2 ctx cur start target1 (legs_add legs target target1 eqn) hs rules
       (fired_add fired rd)
       side
       (- budget 1)
       (if (redex_unfolds rd) (+ unfolds 1) unfolds)))))
(fn redex_unfolds ((rd Redex)) Bool
  (match rd
    ((Redex _ _ _ u) u)))
;; unfold: the occurrences of the named constants present when the step starts, each
;; rewritten once by the first of its equations that matches (an unfolding equation among
;; them), or delta-reduced; never the occurrences a rewrite introduces
(fn unfold_loop
  ((e El)
   (ctx (List Expr))
   (cur Goal)
   (start Expr)
   (target Expr)
   (legs (List Leg))
   (hs (List HeadFacts))
   (only (List Name))
   (occs (List Expr))
   (made Int))
  Loop
  (measure (struct occs))
  (match occs
    (nil
      (if (= made 0)
        (LoopErr (sym "unfold_stuck")
          (append
            (utf8
              "no occurrence of the named constant unfolds — no equation of it matches (cases on its argument first), or its one delta step is a stuck recursor: ")
            (tc_show_closed e ctx target)))
        (loop_end e ctx cur start target legs)))
    ((cons s r)
     (if (= (tc_count target s) 0) (unfold_loop e ctx cur start target legs hs only r made)
     (match (find_redex e nil hs (list s) only)
       ((Prod.mk hs1 (FoundNone e1)) (unfold_loop e1 ctx cur start target legs hs1 only r made))
       ((Prod.mk hs1 (FoundOk e1 rd))
        (match (redex_apply e1 ctx target rd)
          ((RaErr x m) (LoopErr x m))
          ((RaOk e2 target1 eqn)
           (unfold_loop e2 ctx cur start target1 (legs_add legs target target1 eqn) hs1 only r
             (+ made 1))))))))))
;; the subterms headed by one of the names, pre-order, each once
(fn headed_by ((subs (List Expr)) (only (List Name)) (acc (List Expr))) (List Expr)
  (measure (struct subs))
  (match subs
    (nil (rev acc))
    ((cons s r)
     (match (get_app_fn s)
       ((Const _ f _)
        (if (bool_and (mem_name f only) (bool_not (tac_mem_expr s acc)))
          (headed_by r only (cons s acc))
          (headed_by r only acc)))
       (_ (headed_by r only acc))))))
(fn tac_mem_expr ((x Expr) (xs (List Expr))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (expr_eq x y) true (tac_mem_expr x r)))))
;; the side of an equation reduce works in
(fn side_of ((target Expr) (side Symbol)) Expr
  (if (sym_eq side (sym "both")) target
  (match (eq_sides target)
    ((some (Prod.mk _ (Prod.mk _ (Prod.mk l r)))) (if (sym_eq side (sym "lhs")) l r))
    (none target))))
;; each loop starts on a goal of its own, so the step's goal is assigned like any other
(fn step_reduce
  ((e El) (ctx (List Expr)) (target0 Expr) (side Symbol) (rules0 (List (Prod Bool SExpr))))
  TStep
  (let ((target (el_zonk e target0)))
    (match (rules_prepare e ctx rules0 1 nil)
      ((RulesErr x m) (StepErr x m))
      ((RulesOk rules)
       (match (tac_goal e ctx target)
         ((Made e1 g0 occ0)
          (match (tac_close e1 ctx occ0)
            ((Prod.mk e2 filling0)
             (match (reduce_loop e2 ctx g0 target target nil nil rules nil side 2000 0)
               ((LoopErr x m) (StepErr x m))
               ((LoopOk e3 g) (StepOk e3 filling0 nil nil (some g))))))))))))
;; (unfold NAME…): the names resolved as constants of the scope
(fn step_unfold ((e El) (ctx (List Expr)) (target0 Expr) (ns (List Name))) TStep
  (let ((target (el_zonk e target0)))
    (match (resolve_consts e ns nil)
      ((Prod.mk e1 (Prod.mk none m)) (StepErr (sym "unknown_constant") m))
      ((Prod.mk e1 (Prod.mk (some cs) _))
       (match (tac_goal e1 ctx target)
         ((Made e2 g0 occ0)
          (match (tac_close e2 ctx occ0)
            ((Prod.mk e3 filling0)
             (match
               (unfold_loop e3 ctx g0 target target nil nil cs
                 (headed_by (rev (tc_subterms target nil)) cs nil)
                 0)
               ((LoopErr x m) (StepErr x m))
               ((LoopOk e4 g) (StepOk e4 filling0 nil nil (some g))))))))))))
(fn resolve_consts ((e El) (ns (List Name)) (acc (List Name)))
  (Prod El (Prod (Option (List Name)) (List Int)))
  (measure (struct ns))
  (match ns
    (nil (Prod.mk e (Prod.mk (some (rev acc)) nil)))
    ((cons n r)
     (match (elab e (SSym (sym_of_chars (show_name n))) none)
       ((EErr _ m) (Prod.mk e (Prod.mk none m)))
       ((EOk e1 v _)
        (match (get_app_fn (el_zonk e1 v))
          ((Const _ c _) (resolve_consts e1 r (cons c acc)))
          (_ (Prod.mk e1 (Prod.mk none (append (show_name n) (utf8 " is not a constant")))))))))))

;; ---- arith and simp_only -------------------------------------------------------------------
;; the facts elaborated: each term and its type
(type FactsRes (FactsOk El (List (Prod Expr Expr))) (FactsErr Symbol (List Int)))
(fn arith_facts ((e El) (facts (List SExpr)) (acc (List (Prod Expr Expr)))) FactsRes
  (measure (struct facts))
  (match facts
    (nil (FactsOk e (rev acc)))
    ((cons t r)
     (match (elab e t none)
       ((EErr x m) (FactsErr x m))
       ((EOk e1 v ty)
        (match (tac_unsolved e1 v)
          ((some (Prod.mk x m)) (FactsErr x m))
          (none (arith_facts e1 r (cons (Prod.mk (el_zonk e1 v) (el_zonk e1 ty)) acc)))))))))
;; the context's locals with their types (arith keeps the comparisons)
(fn arith_ctx ((e El) (ctx (List Expr)) (acc (List (Prod Expr Expr)))) (List (Prod Expr Expr))
  (measure (struct ctx))
  (match ctx
    (nil (rev acc))
    ((cons (FVar d id) r)
     (match (w_local_type (el_w e) id)
       ((some ty) (arith_ctx e r (cons (Prod.mk (FVar d id) (el_zonk e ty)) acc)))
       (none (arith_ctx e r acc))))
    ((cons _ r) (arith_ctx e r acc))))
;; (arith only? FACT… (farkas K…)?): linear arithmetic over the goal's rows (arith.shard); under
;; `only` the context brings no row (an engine names its facts, so a certificate's positions
;; survive a changed context); K reads the term before it is the goal's filling, so a refusal
;; names the step
(fn step_arith
  ((e El)
   (ctx (List Expr))
   (target Expr)
   (only Bool)
   (facts (List SExpr))
   (certs (List (List Int))))
  TStep
  (match (arith_facts e facts nil)
    ((FactsErr x m) (StepErr x m))
    ((FactsOk e1 fs)
     (match (ar_prove e1 (el_zonk e1 target) (if only nil (arith_ctx e1 ctx nil)) fs certs)
       ((ARErr x m atoms rows) (StepErr x (append m (arith_show e1 ctx atoms rows))))
       ((AROk e2 p _)
        (match (el_infer e2 p)
          ((Prod.mk e3 none)
           (StepErr (sym "arith_internal") (utf8 "K could not type the proof arith built")))
          ((Prod.mk e3 (some pty))
           (match (w_is_def_eq_r (el_w e3) pty (el_zonk e3 target))
             ((Prod.mk w4 (WVal true)) (step_close (el_set_w e3 w4) ctx p nil nil))
             ((Prod.mk w4 _)
              (StepErr (sym "arith_internal")
                (append (utf8 "the proof arith built has the type ")
                  (tc_show_closed (el_set_w e3 w4) ctx pty))))))))))))
;; the rows in normal form, for a refusal: [0 <= 3 + 1*(len rest) + -1*x]
(fn arith_show ((e El) (ctx (List Expr)) (atoms (List Expr)) (rows (List (Prod Bool Lin))))
  (List Int)
  (match rows
    (nil (utf8 ""))
    (_ (append (utf8 " — rows: ") (arith_show_rows e ctx atoms rows)))))
(fn arith_show_rows ((e El) (ctx (List Expr)) (atoms (List Expr)) (rows (List (Prod Bool Lin))))
  (List Int)
  (measure (struct rows))
  (match rows
    (nil (utf8 ""))
    ((cons (Prod.mk q (Lin c ks)) r)
     (append (utf8 "[")
       (append (if q (utf8 "0 = ") (utf8 "0 <= "))
         (append (show_int c)
           (append (arith_show_terms e ctx atoms ks)
             (append (utf8 "] ") (arith_show_rows e ctx atoms r)))))))))
(fn arith_show_terms ((e El) (ctx (List Expr)) (atoms (List Expr)) (ks (List Int))) (List Int)
  (measure (struct ks))
  (match ks
    (nil (utf8 ""))
    ((cons k r)
     (match atoms
       (nil (utf8 ""))
       ((cons a ar)
        (if (= k 0) (arith_show_terms e ctx ar r)
        (append (utf8 " + ")
          (append (show_int k)
            (append (utf8 "*") (append (tc_show_closed e ctx a) (arith_show_terms e ctx ar r)))))))))))

;; (simp_only RULE…): until no rule applies, the first rule in list order with a match whose
;; premises the context states is applied as rw applies it; budget 256
(fn step_simp ((e El) (ctx (List Expr)) (target0 Expr) (rules (List (Prod Bool SExpr)))) TStep
  (let ((target (el_zonk e target0)))
    (match (tac_goal e ctx target)
      ((Made e1 g0 occ0)
       (match (tac_close e1 ctx occ0)
         ((Prod.mk e2 filling0)
          (match (simp_loop e2 ctx g0 target target nil rules 256 0)
            ((LoopErr x m) (StepErr x m))
            ((LoopOk e3 g) (StepOk e3 filling0 nil nil (some g))))))))))
(fn simp_loop
  ((e El)
   (ctx (List Expr))
   (cur Goal)
   (start Expr)
   (target Expr)
   (legs (List Leg))
   (rules (List (Prod Bool SExpr)))
   (budget Int)
   (made Int))
  Loop
  (measure budget)
  (if (< budget 1)
    (LoopErr (sym "simp_budget")
      (append (utf8 "256 rewrites did not reach a fixpoint (a rule rewrites its own result): ")
        (tc_show_closed e ctx target)))
    (match (simp_rules e ctx target rules 1)
      ((RaErr x m) (LoopErr x m))
      ((RaOk e1 target1 eqn)
       (if (expr_eq target1 target)
         (if (= made 0)
           (LoopErr (sym "simp_no_progress")
             (append
               (utf8
                 "no rule rewrites the target (a rule with a premise applies where a hypothesis states it): ")
               (tc_show_closed e1 ctx target)))
           (loop_end e1 ctx cur start target legs))
         (simp_loop e1 ctx cur start target1 (legs_add legs target target1 eqn) rules (- budget 1)
           (+ made 1)))))))
;; the first rule that applies, applied: the next target and the rewrite's equation; the
;; target unchanged (and no equation) where none does
(fn simp_rules ((e El) (ctx (List Expr)) (target Expr) (rules (List (Prod Bool SExpr))) (idx Int))
  RdApp
  (measure (struct rules))
  (match rules
    (nil (RaOk e target none))
    ((cons (Prod.mk rv lem) r)
     (match (elab e lem none)
       ((EErr x m) (RaErr x (append (utf8 "rule ") (append (show_nat idx) (append (utf8 ": ") m)))))
       ((EOk e1 v ty)
        (match (eq_of_lemma e1 v ty)
          ((EqErr x m)
           (RaErr x
             (append (utf8 "rule ")
               (append (show_nat idx)
                 (append (utf8 ": ")
                   (append m
                     (fn_not_rule e1 v
                       (utf8
                         " — a function is not a rule of simp_only: its equations are reduce's; (reduce (using FACT…)) runs it with the facts"))))))))
          ((EqOk e2 v1 u a l rr ms)
           (let ((pat (if rv rr l)) (rhs (if rv l rr)))
             (match (simp_match e2 ctx pat ms (rev (tc_subterms target nil)))
               (none (simp_rules e ctx target r (+ idx 1)))
               ((some e3)
                (let
                  ((pz (el_zonk e3 pat))
                   (rz (el_zonk e3 rhs))
                   (az (el_zonk e3 a))
                   (hz (el_zonk e3 v1)))
                  (if
                    (bool_or (expr_eq pz rz)
                      (match (tac_unsolved e3 hz)
                        ((some _) true)
                        (none false)))
                    (simp_rules e ctx target r (+ idx 1))
                    ;; a rule whose right side holds its left at this instance rewrites its own result,
                    ;; twice over where it holds it twice (the target doubles and no budget of rewrites
                    ;; is reached): `r = mk (fst r) (snd r)` given without its argument
                    (if (< 0 (tc_count rz pz))
                      (RaErr (sym "simp_self")
                        (append (utf8 "rule ")
                          (append (show_nat idx)
                            (append (utf8 " rewrites ")
                              (append (tc_show_closed e3 ctx pz)
                                (append (utf8 " to a term that holds it, ")
                                  (append (tc_show_closed e3 ctx rz)
                                    (utf8
                                      ": no fixpoint — give the rule its arguments, or use rw for one step"))))))))
                      (let
                        ((heq
                           (if rv
                             (mk_app_n (mk_const (n2 (sym "Eq") (sym "symm")) (list u))
                               (list az (el_zonk e3 l) (el_zonk e3 rr) hz))
                             hz)))
                        (match (rewrite_eq e3 ctx target az pz rz heq 0)
                          ((RwEqErr _ _) (simp_rules e ctx target r (+ idx 1)))
                          ((RwEqOk e5 target1 eqn) (RaOk e5 target1 (some eqn))))))))))))))))))
;; the first subterm the pattern matches with every premise stated by the context
(fn simp_match ((e El) (ctx (List Expr)) (pat Expr) (ms (List Expr)) (subs (List Expr))) (Option El)
  (measure (struct subs))
  (match subs
    (nil none)
    ((cons s r)
     (match (tac_match e pat s)
       (none (simp_match e ctx pat ms r))
       ((some e1)
        (match (simp_premises e1 ctx ms)
          ((some e2) (some e2))
          (none (simp_match e ctx pat ms r))))))))
;; each premise left open after the match: a proposition a hypothesis of the context states
(fn simp_premises ((e El) (ctx (List Expr)) (ms (List Expr))) (Option El)
  (measure (struct ms))
  (match ms
    (nil (some e))
    ((cons (MVar _ i) r)
     (match (mc_assigned (el_mc e) i)
       ((some _) (simp_premises e ctx r))
       (none
         (match (mc_decl (el_mc e) i)
           (none none)
           ((some d)
            (let ((ty (sp_canon (el_zonk e (md_type d)))))
              (if (has_mvar ty) none
              (match (w_is_prop (el_w e) ty)
                ((Prod.mk w1 (some true))
                 (match (assumption_of (el_set_w e w1) ctx ty)
                   ((some h)
                    (simp_premises (el_set_mc (el_set_w e w1) (mc_set (el_mc e) i h)) ctx r))
                   (none none)))
                (_ none)))))))))
    ((cons _ r) (simp_premises e ctx r))))
(fn assumption_of ((e El) (ctx (List Expr)) (ty Expr)) (Option Expr)
  (measure (struct ctx))
  (match ctx
    (nil none)
    ((cons (FVar d id) r)
     (match (w_local_type (el_w e) id)
       ((some t) (if (expr_eq (el_zonk e t) ty) (some (FVar d id)) (assumption_of e r ty)))
       (none (assumption_of e r ty))))
    ((cons _ r) (assumption_of e r ty))))

;; ---- the block runner and the entry -------------------------------------------------------
;; the blocks of apply's and rw's premises
(fn blocks_of ((bs (List Node)) (acc (List (List Node)))) (List (List Node))
  (measure (struct bs))
  (match bs
    (nil (rev acc))
    ((cons (NBlock b) r) (blocks_of r (cons b acc)))
    ((cons _ r) (blocks_of r acc))))

(type TacRes (TacOk El (List Goal)) (TacErr Symbol (List Int)))
(fn tac_fail ((g Goal) (idx Int) (x Symbol) (m (List Int))) TacRes
  (TacErr x
    (append (utf8 "step ")
      (append (show_nat idx)
        (append (utf8 ": ") (append m (append (utf8 " — the goal: ") (goal_of g))))))))
;; a block on one goal: each node a step, its children's blocks run, the continuation the rest
(fn tac_block ((e El) (g Goal) (nodes (List Node)) (idx Int) (sorried (List Goal)) (fuel Int))
  TacRes
  (measure fuel)
  (if (< fuel 1) (TacErr (sym "tactic_budget") (utf8 "the derivation is deeper than 100000 nodes"))
  (match nodes
    (nil
      (TacErr (sym "goal_open") (append (utf8 "the block ends with the goal open: ") (goal_of g))))
    ((cons nd rest)
     (match (tac_step e g nd)
       ((StepErr x m) (tac_fail g idx x m))
       ((StepOk e1 filling children blocks cont)
        (let ((e2 (el_set_mc e1 (mc_set (el_mc e1) (goal_id g) filling))))
          (match nd
            ((NSorry) (tac_after e2 g rest idx cont (append sorried children) (- fuel 1)))
            (_
              (match (tac_children e2 children blocks sorried (- fuel 1))
                ((TacErr x m) (TacErr x m))
                ((TacOk e3 sorried1)
                 (match (witness_open e3 filling)
                   ((some nm)
                    (tac_fail g idx (sym "witness_open")
                      (append (utf8 "the argument ")
                        (append nm
                          (utf8
                            " is not determined by the goal and no block assigned it: give it through a premise's exact")))))
                   (none (tac_after e3 g rest idx cont sorried1 (- fuel 1)))))))))))))))
(fn tac_after
  ((e El)
   (g Goal)
   (rest (List Node))
   (idx Int)
   (cont (Option Goal))
   (sorried (List Goal))
   (fuel Int))
  TacRes
  (match cont
    ((some g1) (tac_block e g1 rest (+ idx 1) sorried fuel))
    (none
      (match rest
        (nil (TacOk e sorried))
        (_
          (TacErr (sym "goal_closed")
            (append (utf8 "step ")
              (append (show_nat idx) (utf8 " closed the goal and steps follow it")))))))))
(fn tac_children
  ((e El) (gs (List Goal)) (blocks (List (List Node))) (sorried (List Goal)) (fuel Int))
  TacRes
  (measure (struct gs))
  (match gs
    (nil (TacOk e sorried))
    ((cons g r)
     (match blocks
       (nil (TacErr (sym "goal_open") (append (utf8 "a child goal has no block: ") (goal_of g))))
       ((cons b br)
        (match (tac_block e g b 1 sorried fuel)
          ((TacErr x m) (TacErr x m))
          ((TacOk e1 sorried1) (tac_children e1 r br sorried1 fuel))))))))

;; the entry: the statement closed over the theorem's binders (`nctx` of them), the block; the
;; value instantiated, or the sorried goals, or the refusal
(type ProveRes (ProveOk El Expr) (ProvePending El (List Goal)) (ProveErr Symbol (List Int)))
(fn tac_prove ((e El) (stmt Expr) (nctx Int) (steps (List SExpr))) ProveRes
  (match (read_block steps)
    ((BRErr x m) (ProveErr x m))
    ((BROk nodes)
     (match (el_fresh e (n1 (sym "goal")) stmt (sym "goal"))
       ((Prod.mk e1 (MVar _ i))
        (match (tac_block e1 (Goal i stmt nctx) nodes 1 nil 100000)
          ((TacErr x m) (ProveErr x m))
          ((TacOk e2 nil)
           (match (el_finish e2 (mk_mvar i))
             ((FinErr x m) (ProveErr x m))
             ((FinOk v) (ProveOk e2 v))))
          ((TacOk e2 sorried) (ProvePending e2 sorried))))
       ((Prod.mk e1 _) (ProveErr (sym "bad_shape") (utf8 "no metavariable")))))))

;; the constants the tactics construct by name (the well-founded kit of (wf …) among them)
(fn tc_kit () (List Name)
  (list (n2 (sym "WellFounded") (sym "fix")) (n2 (sym "InvImage") (sym "wf"))
    (n2 (sym "Nat") (sym "lt_wfRel"))
    (n2 (sym "WellFoundedRelation") (sym "wf"))
    (n2 (sym "WellFoundedRelation") (sym "rel"))
    (n1 (sym "InvImage"))
    (n1 (sym "congrArg"))
    (n2 (sym "Eq") (sym "mpr"))
    (n2 (sym "Eq") (sym "symm"))
    (n1 (sym "of_decide_eq_true"))
    (n2 (sym "Decidable") (sym "decide"))
    (n2 (sym "Bool") (sym "true"))
    (n1 (sym "dite"))
    (n1 (sym "ite"))
    (n2 (sym "Int") (sym "add"))
    (n2 (sym "Int") (sym "le"))
    (n2 (sym "Int") (sym "lt"))
    (n2 (sym "Int") (sym "mul"))
    (n2 (sym "Int") (sym "sub"))
    (n2 (sym "Nat") (sym "add"))
    (n2 (sym "Nat") (sym "le"))
    (n2 (sym "Nat") (sym "lt"))
    (n2 (sym "Nat") (sym "mul"))))
