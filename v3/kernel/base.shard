;;; v3/kernel/base.shard — the base: the definitions every file sees beside Init's. An operator
;;; the pinned Init does not define takes its meaning from a definition here, which K checks
;;; like any other; what is believed is the registry's row that runs it as an engine's
;;; operation (prog.shard realization_of; LAW.md §4). Three stand here: `and`, `or`, `xor` on
;;; Int, which Init has at Nat alone. An integer is its two's complement at any size — a
;;; negative one, `Int.negSucc m`, is the complement of m — and each is given by its operands'
;;; signs over Init's `Nat.land`, `Nat.lor`, `Nat.xor`.
;;;
;;; The definitions are TEXT here, read by the loader as the module `shard.int`, and not a
;;; file it finds: a load's root is the package it loads, and the loader reads no file outside
;;; it. The text is read once in a load, before the first file whose forms use one of the
;;; three operators (loader.shard load_base_for); a file's own module may not be named `shard`.
(import "util.shard")
(import "sym.shard")
(import "name.shard")
(import "sexpr.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.name)
(use kernel.sexpr)
(use kernel.sym)
(use kernel.util)
(use kernel.name.Name)
(use kernel.sexpr.SExpr)

(fn base_module () Name (n2 (sym "shard") (sym "int")))
;; the path its records and messages name: this file
(fn base_rel () (List (List Int)) (list (utf8 "kernel") (utf8 "base.shard")))
;; a module a file may not be: the base's, and any other under its first name
(fn base_reserved ((rel (List (List Int)))) Bool
  (match rel
    ((cons p _) (bool_or (int_list_eq p (utf8 "shard")) (int_list_eq p (utf8 "shard.shard"))))
    (nil false)))
;; a declaration of the base: the one native declaration a row of the registry speaks for
(fn base_decl ((c Name)) Bool
  (match c
    ((Str p _) (name_eq p (base_module)))
    (_ false)))
;; the base's definition of an operation, by Init's name for it at Nat: land, lor, xor
(fn base_op ((op Symbol)) Name (Str (base_module) op))
(fn base_source () (List Int)
  (base_join
    (utf8_all
      (list "(def land ((a Int) (b Int)) Int" "  (match a" "    ((Int.ofNat m)" "     (match b"
        "       ((Int.ofNat n) (Int.ofNat (Nat.land m n)))"
        "       ((Int.negSucc n) (Int.ofNat (- m (Nat.land m n))))))"
        "    ((Int.negSucc m)"
        "     (match b"
        "       ((Int.ofNat n) (Int.ofNat (- n (Nat.land n m))))"
        "       ((Int.negSucc n) (Int.negSucc (Nat.lor m n)))))))"
        "(def lor ((a Int) (b Int)) Int"
        "  (match a"
        "    ((Int.ofNat m)"
        "     (match b"
        "       ((Int.ofNat n) (Int.ofNat (Nat.lor m n)))"
        "       ((Int.negSucc n) (Int.negSucc (- n (Nat.land n m))))))"
        "    ((Int.negSucc m)"
        "     (match b"
        "       ((Int.ofNat n) (Int.negSucc (- m (Nat.land m n))))"
        "       ((Int.negSucc n) (Int.negSucc (Nat.land m n)))))))"
        "(def xor ((a Int) (b Int)) Int"
        "  (match a"
        "    ((Int.ofNat m)"
        "     (match b"
        "       ((Int.ofNat n) (Int.ofNat (Nat.xor m n)))"
        "       ((Int.negSucc n) (Int.negSucc (Nat.xor m n)))))"
        "    ((Int.negSucc m)"
        "     (match b"
        "       ((Int.ofNat n) (Int.negSucc (Nat.xor m n)))"
        "       ((Int.negSucc n) (Int.ofNat (Nat.xor m n)))))))"))))
(fn base_join ((ls (List (List Int)))) (List Int)
  (measure (struct ls))
  (match ls
    (nil nil)
    ((cons x r) (append x (cons 10 (base_join r))))))

;; the operators whose identity at Int is the base's: a file whose forms use one has the base
;; loaded before them
(fn base_head ((x Symbol)) Bool
  (bool_or (sym_eq x (sym "band")) (bool_or (sym_eq x (sym "bor")) (sym_eq x (sym "bxor")))))
;; `programs`: the load reads every `fn` as a program alone (the driver's --unchecked), and a
;; program's operator is the engine's, so a `fn` form asks for nothing
(fn uses_base ((programs Bool) (forms (List SExpr))) Bool
  (measure (struct forms))
  (match forms
    (nil false)
    ((cons f r)
     (if (bool_and programs (form_is_fn f)) (uses_base programs r)
     (if (sexpr_uses_base f) true
     (uses_base programs r))))))
(fn form_is_fn ((f SExpr)) Bool
  (match f
    ((SList (cons (SSym h) _)) (sym_eq h (sym "fn")))
    (_ false)))
(fn sexpr_uses_base ((s SExpr)) Bool
  (measure (SExpr.size s))
  (match s
    ((SList xs) (list_uses_base xs))
    ((SSym h) (base_head h))
    (_ false)))
(fn list_uses_base ((xs (List SExpr))) Bool
  (measure (List_SExpr.size xs))
  (match xs
    (nil false)
    ((cons x r) (if (sexpr_uses_base x) true (list_uses_base r)))))
(fulfills sexpr_uses_base.dec_1 (by (intro s xs h) (rw h) (rw SExpr.size.eq_5) (arith)))
(fulfills list_uses_base.dec_1 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
(fulfills list_uses_base.dec_2 (by (intro xs x r h) (rw h) (rw List_SExpr.size.eq_2) (arith)))
