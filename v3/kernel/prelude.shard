;;; v3/kernel/prelude.shard — the toolchain's own List, Option, Bool and Pair.
;;;
;;; The runtime names its cells by these constructors' names (Nil Cons True False Some None
;;; Pair): a comparison's result, a symbol's bytes and a host call's values are built of them
;;; by the Rust bootstrap and by a native binary alike (docs/KERNEL.md, the back end's
;;; refusals), and the loader's evaluator builds them by these identities (prog.shard). These
;;; are E types of the toolchain; the L-level List/Option/Bool/Nat of the library are Lean's
;;; Init declarations and are unrelated to these.

(type (List T) (Nil) (Cons T (List T)))

(type (Option T) (None) (Some T))

(type Bool (False) (True))

(type (Pair A B) (Pair A B))
