;;; v3/kernel/prelude.shard — the stdlib copy the narrow loader needs.
;;;
;;; Identical to kernel/stdlib.shard's five type declarations (the names
;;; Nil Cons True False Some None Z S are built into the Rust loader and
;;; its `if`/list-literal/string handling — LANGUAGE.md §6). v3/ never
;;; imports the old tree (LAYOUT.md), so the copy lives here. These are
;;; E types of the toolchain (FOUNDATION §2: "the toolchain is E; the
;;; logic is data"); the L-level List/Option/Bool/Nat of the library are
;;; Lean's Init declarations (v3/INVENTORY.md) and are unrelated to these.

(type (List T) (Nil) (Cons T (List T)))

(type (Option T) (None) (Some T))

(type Bool (False) (True))

(type (Pair A B) (Pair A B))

;; Nat — literal-backed Peano naturals (packed ground values in the
;; engines; LANGUAGE.md §3). The toolchain's own indices and counts use
;; Int with a nonnegativity invariant instead (today's idiom); this Nat
;; is declared for the packed literal support and for measures.
(type Nat (Z) (S Nat))
