;;; v3/kernel/prelude.shard — the toolchain's own List, Option, Bool and Pair.
;;;
;;; The Rust bootstrap builds these constructors by name (Nil Cons True
;;; False Some None Pair: its `if`, its list and string literals, its host
;;; calls). These are E types of the toolchain; the L-level
;;; List/Option/Bool/Nat of the library are Lean's Init declarations and
;;; are unrelated to these.

(type (List T) (Nil) (Cons T (List T)))

(type (Option T) (None) (Some T))

(type Bool (False) (True))

(type (Pair A B) (Pair A B))
