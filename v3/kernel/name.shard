;;; v3/kernel/name.shard — hierarchical names (Lean `Name`).
;;;
;;; Reconciled against src/kernel (v4.33.1): `name` is anonymous, or a
;;; parent plus a string component, or a parent plus a numeric component.
;;; The exporter numbers names in a table and refers to them by index;
;;; the import (phase 1) rebuilds this structure and interns components.

(import "prelude.shard")
(use kernel.prelude)
(use kernel.prelude.List)

(type Name
  (Anon)  ; Name.anonymous — the root; never the name of a declaration
  (Str Name Symbol)  ; Name.str p s — `p.s`; s interned (`String` component)
  (Num Name Int))  ; Name.num p n — `p.n`; n ≥ 0 (validated at raw admission)

;; RULES (environment.cpp `check_name`, inductive.cpp):
;;   - A declaration name must not already be in the environment
;;     (RuleViolation: "already declared"); an inductive type also
;;     reserves `<I>.rec` (`mk_rec_name`), checked before admission.
;;   - Constructor names within one inductive must be distinct
;;     ("duplicate constructor name").
;;   - The nested-inductive machinery uses the reserved components
;;     `_nested`, `_ind_fresh`, `_nested_fresh` for auxiliary types; a
;;     raw declaration referring to an auxiliary name is refused
;;     (`check_no_nested_aux`: "invalid declaration … references
;;     auxiliary declaration").
;;   - Names are compared structurally; display is `a.b.c` with numeric
;;     components as decimal. No name carries a type or a scope; scope is
;;     the environment's (§8.3: identity is name within a package root
;;     plus content hash — the hash is above K).

;; ---- hashing (expr.shard's structural hash starts here; the environment's key) ----
;; bounded by the prime M = 2^61 − 1; not a security hash (LANGUAGE.md §3: never an authority)
(fn hash_m () Int 2305843009213693951)
;; mix a b = (a·1000003 + b + 1) mod M (mix_whole). For a in [0, 2^61) — a hash or a tag: every
;; caller's — the product is taken in pieces that stay under 63 bits, and the value is the
;; same: with a = a1·2^31 + a0 and a1·1000003 = u1·2^30 + u0,
;;   a·1000003 = u1·2^61 + u0·2^31 + a0·1000003,   and 2^61 is 1 modulo M
;; (`mod` is the Euclidean one, so any b). Written whole, the product passes 63 bits and each
;; call makes two bignums, and a name's hash is a call per byte: the compiled loader spent a
;; third of a load there (measured 2026-11-10, docs/records/REDUCE-2026-11-10.md). The bootstrap
;; pays for the pieces — nine more operations a call, M spelled out to spare it one
(fn mix ((a Int) (b Int)) Int
  (if (< a 0) (mix_whole a b)
  (if (< a 2305843009213693952)
    (let ((u (* (bshr a 31) 1000003)))
      (mod
        (+ (+ (+ (bshr u 30) (* (band u 1073741823) 2147483648)) (* (band a 2147483647) 1000003))
          (+ b 1))
        2305843009213693951))
    (mix_whole a b))))
(fn mix_whole ((a Int) (b Int)) Int (mod (+ (* a 1000003) (+ b 1)) (hash_m)))
(fn hash_bytes ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs
    (Nil acc)
    ((Cons b r) (hash_bytes r (mix acc b)))))
(fn hash_name ((n Name)) Int
  (measure (struct n))
  (match n
    (Anon 7)
    ((Str p s) (mix (hash_name p) (hash_bytes (chars_of_sym s) 5)))
    ((Num p k) (mix (hash_name p) (+ k 3)))))
;; the 24-bit key the environment and the E tables index names by
(fn name_key ((n Name)) Int (band (hash_name n) 16777215))
