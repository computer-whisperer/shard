;;; v3/kernel/name.shard — hierarchical names (Lean `Name`).
;;;
;;; Reconciled against src/kernel (v4.33.1): `name` is anonymous, or a
;;; parent plus a string component, or a parent plus a numeric component.
;;; The exporter numbers names in a table and refers to them by index;
;;; the import rebuilds this structure and interns components.

(import "sym.shard")
(import "sym.shard")
(import "sym.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use kernel.sym)
(use kernel.util)

(type Name
  (Anon)  ; Name.anonymous — the root; never the name of a declaration
  (Str Name Symbol)  ; Name.str p s — `p.s`; s the component's bytes (Lean's `String`)
  (Num Name Int))  ; Name.num p n — `p.n`; n ≥ 0 (validated at raw admission)

;; RULES (environment.cpp `check_name`, inductive.cpp):
;;   - A declaration name must not already be in the environment
;;     (RuleViolation: "already declared"); an inductive type also
;;     reserves `<I>.rec` (`mk_rec_name`), checked before admission.
;;   - Constructor names within one inductive must be distinct
;;     ("duplicate constructor name").
;;   - The nested-inductive machinery uses the reserved components
;;     `_nested`, `_ind_fresh`, `_nested_fresh` for auxiliary types; a
;;     raw declaration referring to an auxiliary name is refused
;;     (`check_no_nested_aux`: "invalid declaration … references
;;     auxiliary declaration").
;;   - Names are compared structurally; display is `a.b.c` with numeric
;;     components as decimal. No name carries a type or a scope; scope is
;;     the environment's.

;; ---- hashing (expr.shard's structural hash starts here; the environment's key) ----
;; bounded by the prime M = 2^61 − 1; not a security hash: never an authority
(fn hash_m () Int 2305843009213693951)
;; mix a b = (a·1000003 + b + 1) mod M (mix_whole). For a in [0, 2^61) — a hash or a tag: every
;; caller's — the product is taken in pieces that stay under 63 bits, and the value is the
;; same: with a = a1·2^31 + a0 and a1·1000003 = u1·2^30 + u0,
;;   a·1000003 = u1·2^61 + u0·2^31 + a0·1000003,   and 2^61 is 1 modulo M
;; (`mod` is the Euclidean one, so any b). Written whole, the product passes 63 bits and each
;; call makes two bignums, and a name's hash is a call per byte: a third of a compiled load's
;; time. The bootstrap pays for the pieces — nine more operations a call, M spelled out to
;; spare it one
(fn mix ((a Int) (b Int)) Int
  (if (< a 0) (mix_whole a b)
  (if (< a 2305843009213693952)
    (let ((u (* (bshr a 31) 1000003)))
      (mod
        (+ (+ (+ (bshr u 30) (* (band u 1073741823) 2147483648)) (* (band a 2147483647) 1000003))
          (+ b 1))
        2305843009213693951))
    (mix_whole a b))))
(fn mix_whole ((a Int) (b Int)) Int (mod (+ (* a 1000003) (+ b 1)) (hash_m)))
(fn hash_bytes ((bs (List Int)) (acc Int)) Int
  (measure (struct bs))
  (match bs
    (nil acc)
    ((cons b r) (hash_bytes r (mix acc b)))))
;; a component's hash: a string's bytes from 5, a number plus 3
(fn str_hash ((s Symbol)) Int (hash_bytes (chars_of_sym s) 5))
(fn num_hash ((k Int)) Int (+ k 3))
(fn hash_name ((n Name)) Int
  (measure (struct n))
  (match n
    (Anon 7)
    ((Str p s) (mix (hash_name p) (str_hash s)))
    ((Num p k) (mix (hash_name p) (num_hash k)))))
;; the 24-bit key the environment and the E tables index names by
(fn name_key ((n Name)) Int (band (hash_name n) 16777215))
;; A name's hash is a fold of `mix` over its components from the root, so the hash of `p ++ n`
;; is the hash of p folded over n's components:
;;   hash_name (p ++ n) = hash_under (hash_name p) (comp_hashes n nil)
;; A caller that tries one name under many prefixes (scope.shard, resolution's candidates)
;; goes through the name's bytes once and pays a `mix` a component for each prefix.
;; comp_hashes: the components' hashes from the root, before `acc`
(fn comp_hashes ((n Name) (acc (List Int))) (List Int)
  (measure (struct n))
  (match n
    (Anon acc)
    ((Str p s) (comp_hashes p (cons (str_hash s) acc)))
    ((Num p k) (comp_hashes p (cons (num_hash k) acc)))))
(fn hash_under ((h Int) (cs (List Int))) Int
  (measure (struct cs))
  (match cs
    (nil h)
    ((cons c r) (hash_under (mix h c) r))))
;; the key of `p ++ n` from the hash of p and n's components
(fn key_under ((h Int) (cs (List Int))) Int (band (hash_under h cs) 16777215))

;; ---- names -----------------------------------------------------------------

(fn name_eq ((a Name) (b Name)) Bool
  (measure (struct a))
  (match a
    (Anon
      (match b
        (Anon true)
        (_ false)))
    ((Str ap as)
     (match b
       ((Str bp bs) (if (sym_eq as bs) (name_eq ap bp) false))
       (_ false)))
    ((Num ap an)
     (match b
       ((Num bp bn) (if (= an bn) (name_eq ap bp) false))
       (_ false)))))

;; Name.cmp's order (Lean `Name.cmp`; util/name.cpp `cmp`): compare the
;; prefixes first, then the last component, numerals before strings.
;; Only used to order universe levels in `normalize` (level.shard), where
;; ANY fixed total order yields the same equivalence verdicts.
(fn name_lt ((a Name) (b Name)) Bool
  (measure (struct a))
  (match a
    (Anon
      (match b
        (Anon false)
        (_ true)))
    ((Str ap as)
     (match b
       (Anon false)
       ((Num _ _) false)
       ((Str bp bs)
        (if (name_lt ap bp) true
        (if (name_lt bp ap) false
        (int_list_lt (chars_of_sym as) (chars_of_sym bs)))))))
    ((Num ap an)
     (match b
       (Anon false)
       ((Str _ _) true)
       ((Num bp bn)
        (if (name_lt ap bp) true
        (if (name_lt bp ap) false
        (< an bn))))))))

(fn names_eq ((a (List Name)) (b (List Name))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (name_eq x y) (names_eq ar br) false))))))

(fn mem_name ((x Name) (xs (List Name))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons y r) (if (name_eq x y) true (mem_name x r)))))

;; `a.b.c` rendering; numeric components in decimal
(fn show_name ((n Name)) (List Int)
  (measure (struct n))
  (match n
    (Anon (utf8 "[anonymous]"))
    ((Str Anon s) (chars_of_sym s))
    ((Str p s) (append (show_name p) (cons 46 (chars_of_sym s))))
    ((Num Anon k) (show_nat k))
    ((Num p k) (append (show_name p) (cons 46 (show_nat k))))))

;; convenience constructors
(fn n1 ((a Symbol)) Name (Str Anon a))
(fn n2 ((a Symbol) (b Symbol)) Name (Str (Str Anon a) b))
