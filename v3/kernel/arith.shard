;;; v3/kernel/arith.shard — linear arithmetic over Int and Nat by a Farkas
;;; certificate. `arith` closes a goal that follows from its rows — the goal
;;; negated, the context's linear hypotheses, the facts given, and what the
;;; atoms bring — under one integer per row: the rows so weighted sum to a
;;; constant inequality that is false.
;;; The certificate is the node's (`(farkas K…)`) or the default
;;; reconstruction's (Fourier–Motzkin elimination in atom order, bounded); P is
;;; built from Lean.Omega's lemmas either way: each side `t` of a row gets a
;;; linear combination `l` (closed data) and a proof `t = l.eval v` over the
;;; atom list `v`, a row is `Constraint.addInequality_sat`/`addEquality_sat`,
;;; the weighted sum a fold of `combo_sat'`, the contradiction
;;; `not_sat'_of_isImpossible` after `normalize_sat`. K's conversion does the
;;; arithmetic on the closed data; every intermediate combination is stated as
;;; a literal, so one step is one bounded computation.
;;;
;;; Untrusted, as the elaborator is: K rechecks the term.

(import "elab.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.elab)
(use kernel.expr)
(use kernel.kw)
(use kernel.level)
(use kernel.name)
(use kernel.spelling)
(use kernel.sym)
(use kernel.util)
(use kernel.elab.El)
(use kernel.expr.BinderInfo)
(use kernel.expr.Expr)
(use kernel.expr.Literal)
(use kernel.level.Level)
(use kernel.name.Name)

;; ---- names and literal terms ------------------------------------------------------------
(fn ar_om ((a Symbol)) Name (Str (n2 (sym "Lean") (sym "Omega")) a))
(fn ar_om2 ((a Symbol) (b Symbol)) Name (Str (ar_om a) b))
(fn ar_c ((n Name)) Expr (mk_const n nil))
(fn ar_i2 ((a Symbol)) Expr (mk_const (n2 (sym "Int") a) nil))
(fn ar_n2 ((a Symbol)) Expr (mk_const (n2 (sym "Nat") a) nil))
(fn ar_int () Expr (mk_const (nm_int_ty) nil))
(fn ar_nat () Expr (mk_const (nm_nat) nil))
(fn ar_one () Level (LSucc LZero))
(fn ar_xint ((k Int)) Expr
  (if (< k 0) (mk_app (ar_c (nm_int_neg_succ)) (mk_lit (LitNat (- (- 0 k) 1))))
  (mk_app (ar_c (nm_int_of_nat)) (mk_lit (LitNat k)))))
(fn ar_xlist ((xs (List Expr))) Expr
  (measure (struct xs))
  (match xs
    (nil (mk_app (mk_const (n2 (sym "List") (sym "nil")) (list LZero)) (ar_int)))
    ((cons x r)
     (mk_app_n (mk_const (n2 (sym "List") (sym "cons")) (list LZero)) (list (ar_int) x (ar_xlist r))))))
(fn ar_xints ((ks (List Int)) (acc (List Expr))) (List Expr)
  (measure (struct ks))
  (match ks
    (nil (rev acc))
    ((cons k r) (ar_xints r (cons (ar_xint k) acc)))))
(fn ar_xopt ((o (Option Int))) Expr
  (match o
    (none (mk_app (mk_const (n2 (sym "Option") (sym "none")) (list LZero)) (ar_int)))
    ((some k)
     (mk_app_n (mk_const (n2 (sym "Option") (sym "some")) (list LZero)) (list (ar_int) (ar_xint k))))))
(fn ar_xcon ((lo (Option Int)) (hi (Option Int))) Expr
  (mk_app_n (ar_c (ar_om2 (sym "Constraint") (sym "mk"))) (list (ar_xopt lo) (ar_xopt hi))))
(fn ar_bin ((op Symbol) (a Expr) (b Expr)) Expr (mk_app_n (ar_i2 op) (list a b)))
(fn ar_eq_at ((ty Expr) (a Expr) (b Expr)) Expr
  (mk_app_n (mk_const (nm_eq) (list (ar_one))) (list ty a b)))
(fn ar_eq ((a Expr) (b Expr)) Expr (ar_eq_at (ar_int) a b))
(fn ar_refl ((a Expr)) Expr (mk_app_n (mk_const (nm_eq_refl) (list (ar_one))) (list (ar_int) a)))
;; p : a = b and q : b = c
(fn ar_trans ((a Expr) (b Expr) (c Expr) (p Expr) (q Expr)) Expr
  (mk_app_n (mk_const (n2 (sym "Eq") (sym "trans")) (list (ar_one))) (list (ar_int) a b c p q)))
;; p : a = b, the result b = a
(fn ar_symm ((a Expr) (b Expr) (p Expr)) Expr
  (mk_app_n (mk_const (n2 (sym "Eq") (sym "symm")) (list (ar_one))) (list (ar_int) a b p)))
(fn ar_iff_mp ((p Expr) (q Expr) (iff Expr) (h Expr)) Expr
  (mk_app_n (ar_c (n2 (sym "Iff") (sym "mp"))) (list p q iff h)))

;; ---- linear combinations, as Lean.Omega computes them -----------------------------------
;; a constant and the coefficients by atom index; the operations mirror LinearCombo's and
;; IntList's (zipWithAll: the longer list's length, a missing entry 0), so the literal stated
;; for a combination is what K computes
(type Lin (Lin Int (List Int)))
(fn lin_const ((l Lin)) Int
  (match l
    ((Lin c _) c)))
(fn lin_coeffs ((l Lin)) (List Int)
  (match l
    ((Lin _ ks) ks)))
(fn lin_zip ((xs (List Int)) (ys (List Int)) (ka Int) (kb Int)) (List Int)
  (measure (+ (len xs) (len ys)))
  (match xs
    (nil
      (match ys
        (nil nil)
        ((cons y yr) (cons (* kb y) (lin_zip nil yr ka kb)))))
    ((cons x xr)
     (match ys
       (nil (cons (* ka x) (lin_zip xr nil ka kb)))
       ((cons y yr) (cons (+ (* ka x) (* kb y)) (lin_zip xr yr ka kb)))))))
(fn lin_add ((a Lin) (b Lin)) Lin
  (Lin (+ (lin_const a) (lin_const b)) (lin_zip (lin_coeffs a) (lin_coeffs b) 1 1)))
(fn lin_sub ((a Lin) (b Lin)) Lin
  (Lin (- (lin_const a) (lin_const b)) (lin_zip (lin_coeffs a) (lin_coeffs b) 1 -1)))
(fn lin_neg ((a Lin)) Lin (Lin (- 0 (lin_const a)) (lin_zip (lin_coeffs a) nil -1 0)))
;; LinearCombo.mul l1 l2 = l2.const * l1 + l1.const * l2 - {const := l1.const * l2.const}
(fn lin_mul ((a Lin) (b Lin)) Lin
  (Lin (* (lin_const a) (lin_const b))
    (lin_zip (lin_coeffs a) (lin_coeffs b) (lin_const b) (lin_const a))))
(fn lin_coord ((i Int)) Lin (Lin 0 (lin_unit i)))
(fn lin_unit ((i Int)) (List Int) (measure i) (if (< i 1) (list 1) (cons 0 (lin_unit (- i 1)))))
(fn lin_all_zero ((xs (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r) (if (= x 0) (lin_all_zero r) false))))
;; the same combination exactly — the constants and the coefficient lists entry for entry, so
;; the two sides have ONE evaluation term (a missing trailing entry read as 0 would let `[1]`
;; pass for `[1, 0]`, and K's conversion of the two evaluations is stuck at `0 * x` for a
;; symbolic x — an app_type_mismatch on `n = 10 * (n / 10) + n % 10`)
(fn lin_eq ((a Lin) (b Lin)) Bool
  (bool_and (= (lin_const a) (lin_const b)) (lin_coeffs_eq (lin_coeffs a) (lin_coeffs b))))
(fn lin_coeffs_eq ((xs (List Int)) (ys (List Int))) Bool
  (measure (struct xs))
  (match xs
    (nil
      (match ys
        (nil true)
        (_ false)))
    ((cons x r)
     (match ys
       (nil false)
       ((cons y s) (if (= x y) (lin_coeffs_eq r s) false))))))
(fn ar_xlin ((l Lin)) Expr
  (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") (sym "mk")))
    (list (ar_xint (lin_const l)) (ar_xlist (ar_xints (lin_coeffs l) nil)))))
(fn ar_xeval ((l Lin) (v Expr)) Expr
  (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") (sym "eval"))) (list (ar_xlin l) v)))

(fn ar_car2 ((car Symbol) (op Symbol) (a Expr) (b Expr)) Expr
  (mk_app_n (mk_const (n2 car op) nil) (list a b)))

;; ---- the shape of a term -------------------------------------------------------------------
;; the value of a closed numeral term: a literal, or +, -, * and unary - of such
(fn ar_num ((t Expr)) (Option Int)
  (measure (struct t))
  (match (get_app_fn t)
    ((Const _ n _)
     (match (get_app_args t)
       ((cons (Lit _ (LitNat k)) nil)
        (if (name_eq n (nm_int_of_nat)) (some k)
        (if (name_eq n (nm_int_neg_succ)) (some (- (- 0 k) 1))
        none)))
       ((cons a nil)
        (if (name_eq n (n2 (sym "Int") (sym "neg")))
          (match (ar_num a)
            ((some x) (some (- 0 x)))
            (none none))
          none))
       ((cons a (cons b nil))
        (if (name_eq n (n2 (sym "Int") (sym "add"))) (ar_num2 (sym "add") (ar_num a) (ar_num b))
        (if (name_eq n (n2 (sym "Int") (sym "sub"))) (ar_num2 (sym "sub") (ar_num a) (ar_num b))
        (if (name_eq n (n2 (sym "Int") (sym "mul"))) (ar_num2 (sym "mul") (ar_num a) (ar_num b))
        none))))
       (_ none)))
    (_ none)))
(fn ar_num2 ((op Symbol) (x (Option Int)) (y (Option Int))) (Option Int)
  (match x
    (none none)
    ((some a)
     (match y
       (none none)
       ((some b)
        (some
          (if (sym_eq op (sym "add")) (+ a b)
          (if (sym_eq op (sym "sub")) (- a b)
          (* a b)))))))))
(fn ar_pos_num ((t Expr)) Bool
  (match (ar_num t)
    ((some k) (< 0 k))
    (none false)))
(type ArShape
  (AsNum Int)
  (AsAdd Expr Expr)
  (AsSub Expr Expr)
  (AsNeg Expr)
  (AsMulL Expr Expr)
  (AsMulR Expr Expr)
  (AsCast Expr)
  (AsMod Expr Expr)
  (AsDiv Expr Expr)
  (AsAtom))
(fn ar_shape ((t Expr)) ArShape
  (match (ar_num t)
    ((some c) (AsNum c))
    (none
      (match (get_app_fn t)
        ((Const _ n _)
         (match (get_app_args t)
           ((cons a (cons b nil))
            (if (name_eq n (n2 (sym "Int") (sym "add"))) (AsAdd a b)
            (if (name_eq n (n2 (sym "Int") (sym "sub"))) (AsSub a b)
            (if (name_eq n (n2 (sym "Int") (sym "mul")))
              (match (ar_num a)
                ((some _) (AsMulL a b))
                (none
                  (match (ar_num b)
                    ((some _) (AsMulR a b))
                    (none (AsAtom)))))
            (if (name_eq n (n2 (sym "Int") (sym "emod"))) (if (ar_pos_num b) (AsMod a b) (AsAtom))
            (if (name_eq n (n2 (sym "Int") (sym "ediv"))) (if (ar_pos_num b) (AsDiv a b) (AsAtom))
            (AsAtom)))))))
           ((cons a nil)
            (if (name_eq n (n2 (sym "Int") (sym "neg"))) (AsNeg a)
            (if (name_eq n (nm_int_of_nat)) (AsCast a)
            (AsAtom))))
           (_ (AsAtom))))
        (_ (AsAtom))))))
;; a Nat term under the cast: a sum (Nat.succ x is x + 1: K converts the two), a product with
;; a literal side, or an atom
(type ArCast (AcAdd Expr Expr) (AcMul Expr Expr) (AcAtom))
(fn ar_cast_shape ((n Expr)) ArCast
  (match (get_app_fn n)
    ((Const _ f _)
     (match (get_app_args n)
       ((cons a nil)
        (if (name_eq f (n2 (sym "Nat") (sym "succ"))) (AcAdd a (mk_lit (LitNat 1))) (AcAtom)))
       ((cons a (cons b nil))
        (if (name_eq f (n2 (sym "Nat") (sym "add"))) (AcAdd a b)
        (if (bool_and (name_eq f (n2 (sym "Nat") (sym "mul"))) (bool_or (is_lit a) (is_lit b)))
          (AcMul a b)
          (AcAtom))))
       (_ (AcAtom))))
    (_ (AcAtom))))
;; x % k as x - k * (x / k) (Int.emod_def)
(fn ar_mod_form ((x Expr) (k Expr)) Expr
  (ar_bin (sym "sub") x (ar_bin (sym "mul") k (ar_bin (sym "ediv") x k))))

;; ---- atoms ---------------------------------------------------------------------------------
;; the atoms in order of first occurrence, each with its kind: plain, nat (a Nat atom under the
;; cast: it brings 0 ≤ ↑a) or div (x / k, k a positive literal: it brings the two bounds)
(fn ar_atom_index ((t Expr) (atoms (List (Prod Expr Symbol))) (i Int)) (Option Int)
  (measure (struct atoms))
  (match atoms
    (nil none)
    ((cons (Prod.mk a _) r) (if (expr_eq a t) (some i) (ar_atom_index t r (+ i 1))))))
(fn ar_atom_add ((t Expr) (kind Symbol) (atoms (List (Prod Expr Symbol)))) (List (Prod Expr Symbol))
  (match (ar_atom_index t atoms 0)
    ((some _) atoms)
    (none (append atoms (list (Prod.mk t kind))))))
(fn ar_collect ((t Expr) (atoms (List (Prod Expr Symbol))) (fuel Int)) (List (Prod Expr Symbol))
  (measure fuel)
  (if (< fuel 1) atoms
  (match (ar_shape t)
    ((AsNum _) atoms)
    ((AsAdd a b) (ar_collect b (ar_collect a atoms (- fuel 1)) (- fuel 1)))
    ((AsSub a b) (ar_collect b (ar_collect a atoms (- fuel 1)) (- fuel 1)))
    ((AsNeg a) (ar_collect a atoms (- fuel 1)))
    ((AsMulL a b) (ar_collect b atoms (- fuel 1)))
    ((AsMulR a b) (ar_collect a atoms (- fuel 1)))
    ((AsCast n)
     (match (ar_cast_shape n)
       ((AcAdd x y) (ar_collect (sp_cast y) (ar_collect (sp_cast x) atoms (- fuel 1)) (- fuel 1)))
       ((AcMul x y) (ar_collect (sp_cast y) (ar_collect (sp_cast x) atoms (- fuel 1)) (- fuel 1)))
       ((AcAtom) (ar_atom_add t (sym "nat") atoms))))
    ((AsMod x k) (ar_collect (ar_mod_form x k) atoms (- fuel 1)))
    ((AsDiv x k) (ar_collect x (ar_atom_add t (sym "div") atoms) (- fuel 1)))
    ((AsAtom) (ar_atom_add t (sym "plain") atoms)))))
(fn ar_atom_terms ((atoms (List (Prod Expr Symbol))) (acc (List Expr))) (List Expr)
  (measure (struct atoms))
  (match atoms
    (nil (rev acc))
    ((cons (Prod.mk a _) r) (ar_atom_terms r (cons a acc)))))

;; ---- t = l.eval v ---------------------------------------------------------------------------
(type ArLin (ArLinOk Lin Expr) (ArLinErr Symbol (List Int)))
;; Lean.Omega.Int.NM {a b c d} (h₁ : a = b) (h₂ : c = d) : a op c = b op d
(fn ar_congr2 ((nm Symbol) (a Expr) (ea Expr) (b Expr) (eb Expr) (pa Expr) (pb Expr)) Expr
  (mk_app_n (ar_c (ar_om2 (sym "Int") nm)) (list a ea b eb pa pb)))
(fn ar_eval2 ((nm Symbol) (la Lin) (lb Lin) (v Expr)) Expr
  (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") nm)) (list (ar_xlin la) (ar_xlin lb) v)))
;; y ∈ [] at Int, and the proof that every coefficient of an empty list is zero
(fn ar_mem_nil ((y Expr)) Expr
  (mk_app_n (mk_const (n2 (sym "Membership") (sym "mem")) (list LZero LZero))
    (list (ar_int) (mk_app (mk_const (n1 (sym "List")) (list LZero)) (ar_int))
      (mk_app (mk_const (n2 (sym "List") (sym "instMembership")) (list LZero)) (ar_int))
      (mk_app (mk_const (n2 (sym "List") (sym "nil")) (list LZero)) (ar_int))
      y)))
(fn ar_zero_proof () Expr
  (mk_lam (n1 (sym "y")) BDefault (ar_int)
    (mk_lam (n1 (sym "h")) BDefault (ar_mem_nil (mk_bvar 0))
      (mk_app_n (mk_const (n1 (sym "absurd")) (list LZero))
        (list (ar_mem_nil (mk_bvar 1)) (ar_eq (mk_bvar 1) (ar_xint 0)) (mk_bvar 0)
          (mk_app_n (mk_const (n2 (sym "List") (sym "not_mem_nil")) (list LZero))
            (list (ar_int) (mk_bvar 1))))))))
(fn ar_lin ((atoms (List (Prod Expr Symbol))) (v Expr) (t Expr) (fuel Int)) ArLin
  (measure fuel)
  (if (< fuel 1) (ArLinErr (sym "arith_depth") (utf8 "the term is deeper than 4000 nodes"))
  (match (ar_shape t)
    ((AsNum c) (ArLinOk (Lin c nil) (ar_refl t)))
    ((AsAdd a b) (ar_lin_bin atoms v t a b (sym "add") (- fuel 1)))
    ((AsSub a b) (ar_lin_bin atoms v t a b (sym "sub") (- fuel 1)))
    ((AsMulL a b) (ar_lin_bin atoms v t a b (sym "mul_left") (- fuel 1)))
    ((AsMulR a b) (ar_lin_bin atoms v t a b (sym "mul_right") (- fuel 1)))
    ((AsNeg a)
     (match (ar_lin atoms v a (- fuel 1))
       ((ArLinErr x m) (ArLinErr x m))
       ((ArLinOk la pa)
        (let ((l (lin_neg la)) (ea (ar_xeval la v)))
          (let ((el (ar_xeval l v)) (mid (mk_app (ar_i2 (sym "neg")) ea)))
            (ArLinOk l
              (ar_trans t mid el
                (mk_app_n (mk_const (n1 (sym "congrArg")) (list (ar_one) (ar_one)))
                  (list (ar_int) (ar_int) a ea (ar_i2 (sym "neg")) pa))
                (ar_symm el mid
                  (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") (sym "neg_eval")))
                    (list (ar_xlin la) v))))))))))
    ((AsCast n)
     (match (ar_cast_shape n)
       ((AcAdd x y)
        (ar_lin_via atoms v t (ar_bin (sym "add") (sp_cast x) (sp_cast y))
          (mk_app_n (ar_i2 (sym "natCast_add")) (list x y))
          (- fuel 1)))
       ((AcMul x y)
        (ar_lin_via atoms v t (ar_bin (sym "mul") (sp_cast x) (sp_cast y))
          (mk_app_n (ar_i2 (sym "natCast_mul")) (list x y))
          (- fuel 1)))
       ((AcAtom) (ar_lin_atom atoms v t))))
    ((AsMod x k)
     (ar_lin_via atoms v t (ar_mod_form x k) (mk_app_n (ar_i2 (sym "emod_def")) (list x k))
       (- fuel 1)))
    ((AsDiv _ _) (ar_lin_atom atoms v t))
    ((AsAtom) (ar_lin_atom atoms v t)))))
;; an atom: (coordinate i).eval v = v.get i, K converting v.get i to the atom
(fn ar_lin_atom ((atoms (List (Prod Expr Symbol))) (v Expr) (t Expr)) ArLin
  (match (ar_atom_index t atoms 0)
    (none (ArLinErr (sym "arith_internal") (utf8 "an atom is missing from the table")))
    ((some i)
     (let ((l (lin_coord i)))
       (ArLinOk l
         (ar_symm (ar_xeval l v) t
           (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") (sym "coordinate_eval")))
             (list (mk_lit (LitNat i)) v))))))))
;; t = inner by the lemma `step`, inner = l.eval v by its own structure
(fn ar_lin_via
  ((atoms (List (Prod Expr Symbol))) (v Expr) (t Expr) (inner Expr) (step Expr) (fuel Int))
  ArLin
  (match (ar_lin atoms v inner fuel)
    ((ArLinErr x m) (ArLinErr x m))
    ((ArLinOk l p) (ArLinOk l (ar_trans t inner (ar_xeval l v) step p)))))
(fn ar_lin_bin
  ((atoms (List (Prod Expr Symbol))) (v Expr) (t Expr) (a Expr) (b Expr) (op Symbol) (fuel Int))
  ArLin
  (match (ar_lin atoms v a fuel)
    ((ArLinErr x m) (ArLinErr x m))
    ((ArLinOk la pa)
     (match (ar_lin atoms v b fuel)
       ((ArLinErr x m) (ArLinErr x m))
       ((ArLinOk lb pb)
        (let ((ea (ar_xeval la v)) (eb (ar_xeval lb v)))
          (if (sym_eq op (sym "add"))
            (let ((l (lin_add la lb)) (mid (ar_bin (sym "add") ea eb)))
              (ArLinOk l
                (ar_trans t mid (ar_xeval l v) (ar_congr2 (sym "add_congr") a ea b eb pa pb)
                  (ar_symm (ar_xeval l v) mid (ar_eval2 (sym "add_eval") la lb v)))))
          (if (sym_eq op (sym "sub"))
            (let ((l (lin_sub la lb)) (mid (ar_bin (sym "sub") ea eb)))
              (ArLinOk l
                (ar_trans t mid (ar_xeval l v) (ar_congr2 (sym "sub_congr") a ea b eb pa pb)
                  (ar_symm (ar_xeval l v) mid (ar_eval2 (sym "sub_eval") la lb v)))))
            (let
              ((lemma
                 (if (sym_eq op (sym "mul_left")) (sym "mul_eval_of_const_left")
                 (sym "mul_eval_of_const_right"))))
              (let ((l (lin_mul la lb)) (mid (ar_bin (sym "mul") ea eb)))
                (ArLinOk l
                  (ar_trans t mid (ar_xeval l v) (ar_congr2 (sym "mul_congr") a ea b eb pa pb)
                    (ar_symm (ar_xeval l v) mid
                      (mk_app_n (ar_c (ar_om2 (sym "LinearCombo") lemma))
                        (list (ar_xlin la) (ar_xlin lb) v (ar_zero_proof))))))))))))))))

;; ---- rows -------------------------------------------------------------------------------------
;; a statement read as a comparison: its relation (le, lt, eq), its carrier (Int, Nat), whether
;; it is negated, its sides
(type ARel (ARel Symbol Symbol Bool Expr Expr) (ARFalse) (ARNone))
(fn ar_rel ((t Expr)) ARel
  (match (get_app_fn t)
    ((Const _ n _)
     (match (get_app_args t)
       (nil (if (name_eq n (n1 (sym "False"))) (ARFalse) (ARNone)))
       ((cons p nil)
        (if (name_eq n (n1 (sym "Not")))
          (match (ar_rel p)
            ((ARel op car false a b) (ARel op car true a b))
            (_ (ARNone)))
          (ARNone)))
       ((cons a (cons b nil))
        (if (name_eq n (n2 (sym "Int") (sym "le"))) (ARel (sym "le") (sym "Int") false a b)
        (if (name_eq n (n2 (sym "Int") (sym "lt"))) (ARel (sym "lt") (sym "Int") false a b)
        (if (name_eq n (n2 (sym "Nat") (sym "le"))) (ARel (sym "le") (sym "Nat") false a b)
        (if (name_eq n (n2 (sym "Nat") (sym "lt"))) (ARel (sym "lt") (sym "Nat") false a b)
        (ARNone))))))
       ((cons ty (cons a (cons b nil)))
        (if (name_eq n (nm_eq))
          (match (sp_carrier ty)
            ((some car) (ARel (sym "eq") car false a b))
            (none (ARNone)))
          (ARNone)))
       (_ (ARNone))))
    (_ (ARNone))))
;; the statement of a comparison, in the one spelling
(fn ar_rel_term ((op Symbol) (car Symbol) (a Expr) (b Expr)) Expr
  (if (sym_eq op (sym "eq")) (ar_eq_at (if (sym_eq car (sym "Int")) (ar_int) (ar_nat)) a b)
  (ar_car2 car op a b)))
;; a row before its normal form: an equation or an inequality at Int, the sides, the proof
(type ArRaw (ArRaw Bool Expr Expr Expr))
(fn ar_le_raw ((a Expr) (b Expr) (h Expr)) ArRaw (ArRaw false a b h))
;; h : a < b at Int is a + 1 ≤ b
(fn ar_lt_raw ((a Expr) (b Expr) (h Expr)) ArRaw
  (ArRaw false (ar_bin (sym "add") a (ar_xint 1)) b
    (mk_app_n (ar_i2 (sym "add_one_le_of_lt")) (list a b h))))
(fn ar_raw_of ((r ARel) (h Expr)) (Option ArRaw)
  (match r
    ((ARel op car neg a b)
     (if (sym_eq car (sym "Int"))
       (if (sym_eq op (sym "eq")) (if neg none (some (ArRaw true a b h)))
       (if (sym_eq op (sym "le"))
         (if neg (some (ar_lt_raw b a (mk_app_n (ar_i2 (sym "lt_of_not_ge")) (list a b h))))
         (some (ar_le_raw a b h)))
       (if neg
         (some
           (ar_le_raw b a
             (ar_iff_mp (sp_not (ar_bin (sym "lt") a b)) (ar_bin (sym "le") b a)
               (mk_app_n (ar_i2 (sym "not_lt")) (list a b))
               h)))
         (some (ar_lt_raw a b h)))))
       ;; Nat: the comparison cast into Int
       (if (sym_eq op (sym "eq"))
         (if neg none
         (some
           (ArRaw true (sp_cast a) (sp_cast b)
             (mk_app_n (mk_const (n1 (sym "congrArg")) (list (ar_one) (ar_one)))
               (list (ar_nat) (ar_int) a b (ar_c (nm_int_of_nat)) h)))))
       (if (sym_eq op (sym "le"))
         (if neg
           (some
             (ar_nat_lt b a
               (ar_iff_mp (sp_not (ar_car2 (sym "Nat") (sym "le") a b))
                 (ar_car2 (sym "Nat") (sym "lt") b a)
                 (mk_app_n (ar_n2 (sym "not_le")) (list a b))
                 h)))
           (some (ar_nat_le a b h)))
       (if neg
         (some
           (ar_nat_le b a
             (ar_iff_mp (sp_not (ar_car2 (sym "Nat") (sym "lt") a b))
               (ar_car2 (sym "Nat") (sym "le") b a)
               (mk_app_n (ar_n2 (sym "not_lt")) (list a b))
               h)))
         (some (ar_nat_lt a b h)))))))
    (_ none)))
(fn ar_nat_le ((a Expr) (b Expr) (h Expr)) ArRaw
  (ar_le_raw (sp_cast a) (sp_cast b)
    (mk_app_n (ar_c (ar_om2 (sym "Int") (sym "ofNat_le_of_le"))) (list a b h))))
(fn ar_nat_lt ((a Expr) (b Expr) (h Expr)) ArRaw
  (ar_lt_raw (sp_cast a) (sp_cast b)
    (mk_app_n (ar_c (ar_om2 (sym "Int") (sym "ofNat_lt_of_lt"))) (list a b h))))
;; the rows of the hypotheses: a context hypothesis that is no comparison is skipped, a fact
;; that is none is the refusal
(type ArRaws (ArRawsOk (List ArRaw)) (ArRawsErr Symbol (List Int)))
(fn ar_hyp_rows ((hs (List (Prod Expr Expr))) (strict Bool) (acc (List ArRaw))) ArRaws
  (measure (struct hs))
  (match hs
    (nil (ArRawsOk (rev acc)))
    ((cons (Prod.mk h ty) r)
     (match (ar_raw_of (ar_rel (sp_canon ty)) h)
       ((some raw) (ar_hyp_rows r strict (cons raw acc)))
       (none
         (if strict
           (ArRawsErr (sym "arith_fact")
             (utf8
               "a fact's statement is not a linear comparison over Int or Nat (≤, <, = and the negations of ≤ and <; a ≠ is no row)"))
           (ar_hyp_rows r strict acc)))))))
(fn ar_collect_raws ((raws (List ArRaw)) (atoms (List (Prod Expr Symbol))))
  (List (Prod Expr Symbol))
  (measure (struct raws))
  (match raws
    (nil atoms)
    ((cons (ArRaw _ a b _) r) (ar_collect_raws r (ar_collect b (ar_collect a atoms 4000) 4000)))))
;; decide's proof of a closed comparison: of_decide_eq_true p inst (Eq.refl true)
(fn ar_decided ((p Expr) (inst Expr)) Expr
  (mk_app_n (ar_c (n1 (sym "of_decide_eq_true")))
    (list p inst
      (mk_app_n (mk_const (nm_eq_refl) (list (ar_one)))
        (list (ar_c (n1 (sym "Bool"))) (ar_c (n2 (sym "Bool") (sym "true"))))))))
;; the rows the atoms bring, in atom order
(fn ar_auto_rows ((atoms (List (Prod Expr Symbol))) (acc (List ArRaw))) (List ArRaw)
  (measure (struct atoms))
  (match atoms
    (nil (rev acc))
    ((cons (Prod.mk a kind) r)
     (if (sym_eq kind (sym "nat"))
       (match (get_app_args a)
         ((cons n nil)
          (ar_auto_rows r
            (cons (ar_le_raw (ar_xint 0) a (mk_app (ar_i2 (sym "natCast_nonneg")) n)) acc)))
         (_ (ar_auto_rows r acc)))
     (if (sym_eq kind (sym "div"))
       (match (get_app_args a)
         ((cons x (cons k nil))
          (let ((kq (ar_bin (sym "mul") k a)) (zero (ar_xint 0)))
            (let ((ne (sp_not (ar_eq k zero))) (pos (ar_bin (sym "lt") zero k)))
              (ar_auto_rows r
                (cons
                  (ar_lt_raw x (ar_bin (sym "add") kq k)
                    (mk_app_n (ar_i2 (sym "lt_mul_ediv_self_add"))
                      (list x k (ar_decided pos (mk_app_n (ar_i2 (sym "decLt")) (list zero k))))))
                  (cons
                    (ar_le_raw kq x
                      (mk_app_n (ar_i2 (sym "mul_ediv_self_le"))
                        (list x k
                          (ar_decided ne
                            (mk_app_n (ar_c (n1 (sym "instDecidableNot")))
                              (list (ar_eq k zero) (mk_app_n (ar_i2 (sym "decEq")) (list k zero))))))))
                    acc))))))
         (_ (ar_auto_rows r acc)))
       (ar_auto_rows r acc))))))

;; a row in normal form: an equation or an inequality, its combination, and the proof that its
;; constraint holds of its coefficients at v
(type ArRow (ArRow Bool Lin Expr))
(type ArRows (ArRowsOk (List ArRow)) (ArRowsErr Symbol (List Int)))
(fn ar_rows ((atoms (List (Prod Expr Symbol))) (v Expr) (raws (List ArRaw)) (acc (List ArRow)))
  ArRows
  (measure (struct raws))
  (match raws
    (nil (ArRowsOk (rev acc)))
    ((cons (ArRaw iseq a b h) r)
     (let ((d (if iseq (ar_bin (sym "sub") a b) (ar_bin (sym "sub") b a))))
       (match (ar_lin atoms v d 4000)
         ((ArLinErr x m) (ArRowsErr x m))
         ((ArLinOk l p)
          (let
            ((el (ar_xeval l v))
             (zero (ar_xint 0))
             (c (ar_xint (lin_const l)))
             (xs (ar_xlist (ar_xints (lin_coeffs l) nil))))
            (if iseq
              ;; h : a = b; a - b = 0; l.eval v = 0
              (let
                ((w
                   (ar_trans el d zero (ar_symm d el p)
                     (mk_app_n (ar_i2 (sym "sub_eq_zero_of_eq")) (list a b h)))))
                (ar_rows atoms v r
                  (cons
                    (ArRow true l
                      (mk_app_n (ar_c (ar_om2 (sym "Constraint") (sym "addEquality_sat")))
                        (list c xs v w)))
                    acc)))
              ;; h : a ≤ b; 0 ≤ b - a; 0 ≤ l.eval v
              (let
                ((w
                   (mk_app_n (mk_const (n2 (sym "Eq") (sym "mp")) (list LZero))
                     (list (ar_bin (sym "le") zero d) (ar_bin (sym "le") zero el)
                       (mk_app_n (mk_const (n1 (sym "congrArg")) (list (ar_one) (ar_one)))
                         (list (ar_int) (mk_sort LZero) d el
                           (mk_lam (n1 (sym "z")) BDefault (ar_int)
                             (ar_bin (sym "le") zero (mk_bvar 0)))
                           p))
                       (mk_app_n (ar_i2 (sym "sub_nonneg_of_le")) (list b a h))))))
                (ar_rows atoms v r
                  (cons
                    (ArRow false l
                      (mk_app_n (ar_c (ar_om2 (sym "Constraint") (sym "addInequality_sat")))
                        (list c xs v w)))
                    acc)))))))))))
(fn ar_row_eq ((r ArRow)) Bool
  (match r
    ((ArRow q _ _) q)))
(fn ar_row_lin ((r ArRow)) Lin
  (match r
    ((ArRow _ l _) l)))
(fn ar_row_proof ((r ArRow)) Expr
  (match r
    ((ArRow _ _ p) p)))

;; ---- the certificate ---------------------------------------------------------------------------
;; the weighted sum of the rows: its constant, its coefficients, whether an inequality has a
;; positive weight, and whether every weight has a sign its row admits
(type ArSum (ArSum Int (List Int) Bool Bool Int))
(fn ar_sum ((rows (List ArRow)) (ks (List Int)) (acc ArSum)) ArSum
  (measure (struct rows))
  (match rows
    (nil acc)
    ((cons row r)
     (match ks
       (nil acc)
       ((cons k kr)
        (match acc
          ((ArSum c xs ineq ok active)
           (if (= k 0) (ar_sum r kr acc)
           (ar_sum r kr
             (ArSum (+ c (* k (lin_const (ar_row_lin row))))
               (lin_zip xs (lin_coeffs (ar_row_lin row)) 1 k)
               (bool_or ineq (bool_not (ar_row_eq row)))
               (bool_and ok (bool_or (ar_row_eq row) (< 0 k)))
               (+ active 1)))))))))))
;; whether the weights refute the rows: every coefficient cancels and the constant is false —
;; negative, or nonzero where every weighted row is an equation
(fn ar_refutes ((s ArSum)) Bool
  (match s
    ((ArSum c xs ineq ok active)
     (bool_and ok
       (bool_and (< 0 active) (bool_and (lin_all_zero xs) (if ineq (< c 0) (bool_not (= c 0)))))))))

;; ---- the default reconstruction: Fourier–Motzkin elimination ------------------------------
;; a derived row: an equation or an inequality 0 ≤ c + xs·v, and its weights over the rows given
(type FmRow (FmRow Bool Int (List Int) (List Int)))
(type FmOut (FmFound (List Int)) (FmNone) (FmBudget))
(fn ar_abs ((x Int)) Int (if (< x 0) (- 0 x) x))
(fn ar_gcd ((a Int) (b Int)) Int
  (measure (ar_abs b))
  (if (= b 0) (ar_abs a) (ar_gcd b (mod (ar_abs a) (ar_abs b)))))
(fn ar_gcd_list ((xs (List Int)) (g Int)) Int
  (measure (struct xs))
  (match xs
    (nil g)
    ((cons x r) (if (= g 1) 1 (ar_gcd_list r (ar_gcd g x))))))
(fn ar_div_list ((xs (List Int)) (g Int) (acc (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (nil (rev acc))
    ((cons x r) (ar_div_list r g (cons (ediv x g) acc)))))
(fn ar_nth0 ((xs (List Int)) (i Int)) Int
  (match (nth xs i)
    ((some x) x)
    (none 0)))
;; a·r + b·s, reduced by the gcd of everything in it
(fn fm_comb ((a Int) (r FmRow) (b Int) (s FmRow)) FmRow
  (match r
    ((FmRow rq rc rxs rms)
     (match s
       ((FmRow sq sc sxs sms)
        (let ((c (+ (* a rc) (* b sc))) (xs (lin_zip rxs sxs a b)) (ms (lin_zip rms sms a b)))
          (let ((g (ar_gcd_list ms (ar_gcd_list xs (ar_abs c)))))
            (if (< g 2) (FmRow (bool_and rq sq) c xs ms)
            (FmRow (bool_and rq sq) (ediv c g) (ar_div_list xs g nil) (ar_div_list ms g nil))))))))))
(fn fm_init ((rows (List ArRow)) (i Int) (acc (List FmRow))) (List FmRow)
  (measure (struct rows))
  (match rows
    (nil (rev acc))
    ((cons row r)
     (fm_init r (+ i 1)
       (cons
         (FmRow (ar_row_eq row) (lin_const (ar_row_lin row)) (lin_coeffs (ar_row_lin row))
           (lin_unit i))
         acc)))))
(fn fm_first_nz ((xs (List Int)) (i Int)) (Option Int)
  (measure (struct xs))
  (match xs
    (nil none)
    ((cons x r) (if (= x 0) (fm_first_nz r (+ i 1)) (some i)))))
;; a row that is a false constant: its weights
(fn fm_contra ((rows (List FmRow))) (Option (List Int))
  (measure (struct rows))
  (match rows
    (nil none)
    ((cons (FmRow q c xs ms) r)
     (if (bool_and (lin_all_zero xs) (if q (bool_not (= c 0)) (< c 0))) (some ms) (fm_contra r)))))
;; the first equation with a coefficient: it, the atom, the rows before and after
(fn fm_pick_eq ((rows (List FmRow)) (before (List FmRow)))
  (Option (Prod FmRow (Prod Int (List FmRow))))
  (measure (struct rows))
  (match rows
    (nil none)
    ((cons (FmRow q c xs ms) r)
     (if q
       (match (fm_first_nz xs 0)
         ((some j) (some (Prod.mk (FmRow q c xs ms) (Prod.mk j (append (rev before) r)))))
         (none (fm_pick_eq r (cons (FmRow q c xs ms) before))))
       (fm_pick_eq r (cons (FmRow q c xs ms) before))))))
(fn fm_coeff ((r FmRow) (j Int)) Int
  (match r
    ((FmRow _ _ xs _) (ar_nth0 xs j))))
;; the equation e solved for atom j and substituted into every row
(fn fm_subst ((e FmRow) (j Int) (rows (List FmRow)) (acc (List FmRow))) (List FmRow)
  (measure (struct rows))
  (match rows
    (nil (rev acc))
    ((cons r rest)
     (let ((rj (fm_coeff r j)) (ej (fm_coeff e j)))
       (if (= rj 0) (fm_subst e j rest (cons r acc))
       (fm_subst e j rest (cons (fm_comb (ar_abs ej) r (if (< 0 ej) (- 0 rj) rj) e) acc)))))))
(fn fm_eqs ((rows (List FmRow)) (fuel Int)) (List FmRow)
  (measure fuel)
  (if (< fuel 1) rows
  (match (fm_pick_eq rows nil)
    (none rows)
    ((some (Prod.mk e (Prod.mk j others))) (fm_eqs (fm_subst e j others nil) (- fuel 1))))))
;; the inequalities, an equation dropped (those left have no coefficient)
(fn fm_ineqs_of ((rows (List FmRow)) (acc (List FmRow))) (List FmRow)
  (measure (struct rows))
  (match rows
    (nil (rev acc))
    ((cons (FmRow q c xs ms) r)
     (if q (fm_ineqs_of r acc) (fm_ineqs_of r (cons (FmRow q c xs ms) acc))))))
;; the rows by the sign of atom j's coefficient
(type FmParts (FmParts (List FmRow) (List FmRow) (List FmRow)))
(fn fm_split ((rows (List FmRow)) (j Int) (pos (List FmRow)) (neg (List FmRow)) (zero (List FmRow)))
  FmParts
  (measure (struct rows))
  (match rows
    (nil (FmParts (rev pos) (rev neg) (rev zero)))
    ((cons r rest)
     (let ((rj (fm_coeff r j)))
       (if (= rj 0) (fm_split rest j pos neg (cons r zero))
       (if (< 0 rj) (fm_split rest j (cons r pos) neg zero)
       (fm_split rest j pos (cons r neg) zero)))))))
(fn fm_trivial ((r FmRow)) Bool
  (match r
    ((FmRow _ c xs _) (bool_and (lin_all_zero xs) (bool_not (< c 0))))))
(fn fm_cross1 ((p FmRow) (j Int) (negs (List FmRow)) (acc (List FmRow))) (List FmRow)
  (measure (struct negs))
  (match negs
    (nil acc)
    ((cons n r)
     (let ((x (fm_comb (- 0 (fm_coeff n j)) p (fm_coeff p j) n)))
       (fm_cross1 p j r (if (fm_trivial x) acc (cons x acc)))))))
(fn fm_cross ((poss (List FmRow)) (j Int) (negs (List FmRow)) (acc (List FmRow))) (List FmRow)
  (measure (struct poss))
  (match poss
    (nil acc)
    ((cons p r) (fm_cross r j negs (fm_cross1 p j negs acc)))))
(fn fm_elim ((rows (List FmRow)) (j Int) (natoms Int)) FmOut
  (measure (- natoms j))
  (match (fm_contra rows)
    ((some ms) (FmFound ms))
    (none
      (if (bool_not (< j natoms)) (FmNone)
      (match (fm_split rows j nil nil nil)
        ((FmParts pos neg zero)
         (let ((next (append zero (rev (fm_cross pos j neg nil)))))
           (if (< 512 (len next)) (FmBudget) (fm_elim next (+ j 1) natoms)))))))))
(fn fm_find ((rows (List ArRow)) (natoms Int)) FmOut
  (let ((solved (fm_eqs (fm_init rows 0 nil) 256)))
    (match (fm_contra solved)
      ((some ms) (FmFound ms))
      (none (fm_elim (fm_ineqs_of solved nil) 0 natoms)))))

;; ---- P: the weighted sum and the contradiction -------------------------------------------
;; Constraint.scale and Constraint.add on literal bounds, for a weight that is not zero
(fn ar_omul ((k Int) (o (Option Int))) (Option Int)
  (match o
    (none none)
    ((some x) (some (* k x)))))
(fn ar_oadd ((a (Option Int)) (b (Option Int))) (Option Int)
  (match a
    (none none)
    ((some x)
     (match b
       (none none)
       ((some y) (some (+ x y)))))))
(fn ar_scale_lo ((k Int) (lo (Option Int)) (hi (Option Int))) (Option Int)
  (if (< 0 k) (ar_omul k lo) (ar_omul k hi)))
(fn ar_scale_hi ((k Int) (lo (Option Int)) (hi (Option Int))) (Option Int)
  (if (< 0 k) (ar_omul k hi) (ar_omul k lo)))
;; the constraint a row states of its coefficients: -c ≤ xs·v, and ≤ -c for an equation
(fn ar_row_lo ((r ArRow)) (Option Int) (some (- 0 (lin_const (ar_row_lin r)))))
(fn ar_row_hi ((r ArRow)) (Option Int)
  (if (ar_row_eq r) (some (- 0 (lin_const (ar_row_lin r)))) none))
;; the sum so far: its bounds, its coefficients, the proof that the bounds hold of them at v
(type ArAcc (ArAcc (Option Int) (Option Int) (List Int) Expr))
(fn ar_acc_of ((r ArRow)) ArAcc
  (ArAcc (ar_row_lo r) (ar_row_hi r) (lin_coeffs (ar_row_lin r)) (ar_row_proof r)))
;; combo_sat' s t a x b y v wx wy : (Constraint.combo a s b t).sat' (Coeffs.combo a x b y) v
(fn ar_combo ((v Expr) (a Int) (s ArAcc) (b Int) (t ArAcc)) ArAcc
  (match s
    ((ArAcc slo shi sxs sw)
     (match t
       ((ArAcc tlo thi txs tw)
        (ArAcc (ar_oadd (ar_scale_lo a slo shi) (ar_scale_lo b tlo thi))
          (ar_oadd (ar_scale_hi a slo shi) (ar_scale_hi b tlo thi))
          (lin_zip sxs txs a b)
          (mk_app_n (ar_c (ar_om (sym_of_chars (utf8 "combo_sat'"))))
            (list (ar_xcon slo shi) (ar_xcon tlo thi) (ar_xint a) (ar_xlist (ar_xints sxs nil))
              (ar_xint b)
              (ar_xlist (ar_xints txs nil))
              v
              sw
              tw))))))))
;; the rows with a weight, in order
(fn ar_active ((rows (List ArRow)) (ks (List Int)) (acc (List (Prod Int ArRow))))
  (List (Prod Int ArRow))
  (measure (struct rows))
  (match rows
    (nil (rev acc))
    ((cons row r)
     (match ks
       (nil (rev acc))
       ((cons k kr) (ar_active r kr (if (= k 0) acc (cons (Prod.mk k row) acc))))))))
(fn ar_fold ((v Expr) (acc ArAcc) (rest (List (Prod Int ArRow)))) ArAcc
  (measure (struct rest))
  (match rest
    (nil acc)
    ((cons (Prod.mk k row) r) (ar_fold v (ar_combo v 1 acc k (ar_acc_of row)) r))))
;; False from the rows under the weights (the weights refute them: ar_refutes)
(fn ar_false ((v Expr) (rows (List ArRow)) (ks (List Int))) (Option Expr)
  (match (ar_active rows ks nil)
    (nil none)
    ((cons (Prod.mk k1 r1) nil) (some (ar_contra v (ar_acc_of r1))))
    ((cons (Prod.mk k1 r1) (cons (Prod.mk k2 r2) rest))
     (some (ar_contra v (ar_fold v (ar_combo v k1 (ar_acc_of r1) k2 (ar_acc_of r2)) rest))))))
;; not_sat'_of_isImpossible (c := normalizeConstraint s x) (Eq.refl true) (normalize_sat w)
(fn ar_contra ((v Expr) (acc ArAcc)) Expr
  (match acc
    ((ArAcc lo hi xs w)
     (let ((s (ar_xcon lo hi)) (x (ar_xlist (ar_xints xs nil))))
       (mk_app_n (ar_c (ar_om2 (sym "Constraint") (sym_of_chars (utf8 "not_sat'_of_isImpossible"))))
         (list (mk_app_n (ar_c (ar_om (sym "normalizeConstraint"))) (list s x))
           (mk_app_n (mk_const (nm_eq_refl) (list (ar_one)))
             (list (ar_c (n1 (sym "Bool"))) (ar_c (n2 (sym "Bool") (sym "true")))))
           (mk_app_n (ar_c (ar_om (sym "normalizeCoeffs"))) (list s x))
           v
           (mk_app_n (ar_c (ar_om (sym "normalize_sat"))) (list s x v w))))))))

;; ---- the entry -------------------------------------------------------------------------------
;; the proof of the target with the certificates it rests on (one per refutation, in order;
;; none for an identity of normal forms) — what a producer writes —, or the refusal with the
;; atoms and the rows in normal form (the caller renders them: the goal's printer is the block
;; runner's)
(type ARes
  (AROk El Expr (List (List Int)))
  (ARErr Symbol (List Int) (List Expr) (List (Prod Bool Lin))))
(fn ar_err ((x Symbol) (m (List Int))) ARes (ARErr x m nil nil))
(fn ar_show_rows ((rows (List ArRow)) (acc (List (Prod Bool Lin)))) (List (Prod Bool Lin))
  (measure (struct rows))
  (match rows
    (nil (rev acc))
    ((cons r rest) (ar_show_rows rest (cons (Prod.mk (ar_row_eq r) (ar_row_lin r)) acc)))))
(fn ar_kit () (List Name)
  (list (ar_om2 (sym "LinearCombo") (sym "coordinate_eval"))
    (ar_om2 (sym "LinearCombo") (sym "add_eval"))
    (ar_om2 (sym "LinearCombo") (sym "sub_eval"))
    (ar_om2 (sym "LinearCombo") (sym "neg_eval"))
    (ar_om2 (sym "Int") (sym "add_congr"))
    (ar_om2 (sym "Int") (sym "sub_congr"))
    (ar_om2 (sym "Constraint") (sym "addInequality_sat"))
    (ar_om2 (sym "Constraint") (sym "addEquality_sat"))
    (ar_om (sym_of_chars (utf8 "combo_sat'")))
    (ar_om (sym "normalize_sat"))
    (ar_om2 (sym "Constraint") (sym_of_chars (utf8 "not_sat'_of_isImpossible")))
    (n2 (sym "Int") (sym "sub_nonneg_of_le"))
    (n2 (sym "Int") (sym "sub_eq_zero_of_eq"))
    (n2 (sym "Int") (sym "add_one_le_of_lt"))
    (n2 (sym "Int") (sym "lt_of_not_ge"))
    (n2 (sym "Int") (sym "not_lt"))
    (n2 (sym "Int") (sym "not_le"))
    (n2 (sym "Int") (sym "le_antisymm"))
    (n2 (sym "Int") (sym "natCast_add"))
    (n2 (sym "Int") (sym "natCast_mul"))
    (n2 (sym "Int") (sym "natCast_nonneg"))
    (ar_om2 (sym "Int") (sym "ofNat_le_of_le"))
    (ar_om2 (sym "Int") (sym "ofNat_lt_of_lt"))
    (n2 (sym "Nat") (sym "not_lt"))
    (n2 (sym "Nat") (sym "not_le"))
    (n2 (sym "Nat") (sym "le_antisymm"))
    (n2 (sym "Eq") (sym "mp"))
    (n1 (sym "congrArg"))
    (n2 (sym "Iff") (sym "mp"))))
(fn ar_div_kit () (List Name)
  (list (n2 (sym "Int") (sym "emod_def")) (n2 (sym "Int") (sym "mul_ediv_self_le"))
    (n2 (sym "Int") (sym "lt_mul_ediv_self_add"))
    (n1 (sym "of_decide_eq_true"))
    (n1 (sym "instDecidableNot"))))
;; False from the rows: `row0` the goal's negation when it has one, then the hypotheses' rows,
;; then what the atoms bring; under the certificate given, or the elimination's
(fn ar_refute ((e El) (row0 (Option ArRaw)) (raws (List ArRaw)) (cert (Option (List Int)))) ARes
  (let
    ((given (List ArRaw)
       (match row0
         ((some r0) (cons r0 raws))
         (none raws))))
    (let ((atoms (ar_collect_raws given nil)))
      (let ((v (ar_xlist (ar_atom_terms atoms nil))))
        (match (ar_rows atoms v (append given (ar_auto_rows atoms nil)) nil)
          ((ArRowsErr x m) (ar_err x m))
          ((ArRowsOk rows)
           (match cert
             ((some ks)
              (if (< (len rows) (len ks))
                (ARErr (sym "arith_certificate")
                  (append (utf8 "the certificate has ")
                    (append (show_nat (len ks))
                      (append (utf8 " weights and the goal has ")
                        (append (show_nat (len rows)) (utf8 " rows")))))
                  (ar_atom_terms atoms nil)
                  (ar_show_rows rows nil))
              (if (ar_refutes (ar_sum rows ks (ArSum 0 nil false true 0)))
                (match (ar_false v rows ks)
                  ((some f) (AROk e f (list ks)))
                  (none (ar_err (sym "arith_internal") (utf8 "no weighted row"))))
                (ARErr (sym "arith_certificate")
                  (utf8
                    "the weights do not refute the rows: the coefficients must cancel and the constant be negative, no inequality's weight negative (a zero leaves its row out)")
                  (ar_atom_terms atoms nil)
                  (ar_show_rows rows nil)))))
             (none
               (match (fm_find rows (len atoms))
                 ((FmFound ks)
                  (if (ar_refutes (ar_sum rows ks (ArSum 0 nil false true 0)))
                    (match (ar_false v rows ks)
                      ((some f) (AROk e f (list ks)))
                      (none (ar_err (sym "arith_internal") (utf8 "no weighted row"))))
                    (ar_err (sym "arith_internal")
                      (utf8 "the elimination's weights do not refute the rows"))))
                 ((FmBudget)
                  (ARErr (sym "arith_budget")
                    (utf8
                      "the elimination passed 512 derived rows: give the certificate — (arith … (farkas K…)), a weight per row in the order shown")
                    (ar_atom_terms atoms nil)
                    (ar_show_rows rows nil)))
                 ((FmNone)
                  (ARErr (sym "arith_failed")
                    (utf8
                      "no weighting of the rows refutes them (linear arithmetic over the rationals with integer-tight strictness: no cut, no case split, a ≠ hypothesis is no row) — a fact is missing, or the goal is not linear in these atoms")
                    (ar_atom_terms atoms nil)
                    (ar_show_rows rows nil))))))))))))
;; a comparison that is not an equation, by the refutation of its negation
(fn ar_prove_cmp
  ((e El) (op Symbol) (car Symbol) (a Expr) (b Expr) (raws (List ArRaw)) (cert (Option (List Int))))
  ARes
  (let ((neg_op (if (sym_eq op (sym "le")) (sym "lt") (sym "le"))))
    (let ((negp (ar_car2 car neg_op b a)))
      (match (el_local e (n1 (sym "h")) negp BDefault)
        ((Prod.mk e1 hn)
         (match (ar_raw_of (ARel neg_op car false b a) hn)
           (none (ar_err (sym "arith_internal") (utf8 "the negated goal is no row")))
           ((some r0)
            (match (ar_refute e1 (some r0) raws cert)
              ((ARErr x m as rs) (ARErr x m as rs))
              ((AROk e2 f cs)
               (match (el_lams e2 (list hn) f)
                 ((Prod.mk e3 lam)
                  ;; ¬ b < a ↔ a ≤ b (not_lt at b a), ¬ b ≤ a ↔ a < b (not_le at b a)
                  (AROk e3
                    (ar_iff_mp (sp_not negp) (ar_car2 car op a b)
                      (mk_app_n
                        (mk_const (n2 car (if (sym_eq op (sym "le")) (sym "not_lt") (sym "not_le")))
                          nil)
                        (list b a))
                      lam)
                    cs))))))))))))
(fn ar_cert ((certs (List (List Int))) (i Int)) (Option (List Int)) (nth certs i))
(fn ar_prove
  ((e El)
   (target0 Expr)
   (ctxh (List (Prod Expr Expr)))
   (facts (List (Prod Expr Expr)))
   (certs (List (List Int))))
  ARes
  (match (ar_hyp_rows ctxh false nil)
    ((ArRawsErr x m) (ar_err x m))
    ((ArRawsOk craws)
     (match (ar_hyp_rows facts true nil)
       ((ArRawsErr x m) (ar_err x m))
       ((ArRawsOk fraws)
        (let ((raws (append craws fraws)))
          (match (ar_rel (sp_canon target0))
            ((ARFalse) (ar_refute e none raws (ar_cert certs 0)))
            ((ARNone)
             (ar_err (sym "arith_goal")
               (utf8
                 "the target is not a linear comparison over Int or Nat (≤, <, =, a negation of one, or False)")))
            ((ARel op car true a b)
             ;; ¬ P: P's row and the refutation
             (let ((p (ar_rel_term op car a b)))
               (match (el_local e (n1 (sym "h")) p BDefault)
                 ((Prod.mk e1 hp)
                  (match (ar_raw_of (ARel op car false a b) hp)
                    (none (ar_err (sym "arith_internal") (utf8 "the goal's statement is no row")))
                    ((some r0)
                     (match (ar_refute e1 (some r0) raws (ar_cert certs 0))
                       ((ARErr x m as rs) (ARErr x m as rs))
                       ((AROk e2 f cs)
                        (match (el_lams e2 (list hp) f)
                          ((Prod.mk e3 lam) (AROk e3 lam cs)))))))))))
            ((ARel op car false a b)
             (if (sym_eq op (sym "eq")) (ar_prove_eq e car a b raws certs)
             (ar_prove_cmp e op car a b raws (ar_cert certs 0)))))))))))
;; an equation: the two sides' evaluations where they have one normal form (lin_eq: the same
;; term), else ≤ both ways
(fn ar_prove_eq
  ((e El) (car Symbol) (a Expr) (b Expr) (raws (List ArRaw)) (certs (List (List Int))))
  ARes
  (let
    ((ai (if (sym_eq car (sym "Int")) a (sp_cast a)))
     (bi (if (sym_eq car (sym "Int")) b (sp_cast b))))
    (let ((atoms (ar_collect bi (ar_collect ai nil 4000) 4000)))
      (let ((v (ar_xlist (ar_atom_terms atoms nil))))
        (match (ar_lin atoms v ai 4000)
          ((ArLinErr x m) (ar_err x m))
          ((ArLinOk la pa)
           (match (ar_lin atoms v bi 4000)
             ((ArLinErr x m) (ar_err x m))
             ((ArLinOk lb pb)
              (if (lin_eq la lb)
                ;; ai = la.eval v, bi = lb.eval v, and K converts the two evaluations
                (let ((p (ar_trans ai (ar_xeval la v) bi pa (ar_symm bi (ar_xeval la v) pb))))
                  (AROk e
                    (if (sym_eq car (sym "Int")) p
                    (mk_app_n (mk_const (Str (n2 (sym "Int") (sym "ofNat")) (sym "inj")) nil)
                      (list a b p)))
                    nil))
                (match (ar_prove_cmp e (sym "le") car a b raws (ar_cert certs 0))
                  ((ARErr x m as rs) (ARErr x m as rs))
                  ((AROk e1 p1 cs1)
                   (match (ar_prove_cmp e1 (sym "le") car b a raws (ar_cert certs 1))
                     ((ARErr x m as rs) (ARErr x m as rs))
                     ((AROk e2 p2 cs2)
                      (AROk e2
                        (mk_app_n (mk_const (n2 car (sym "le_antisymm")) nil) (list a b p1 p2))
                        (append cs1 cs2)))))))))))))))

;; every constant arith constructs by name: the kit, the division kit,
;; the linearization's lemmas and the terms it builds
(fn ar_all_kit () (List Name)
  (append (ar_kit)
    (append (ar_div_kit)
      (list (ar_om2 (sym "LinearCombo") (sym "mul_eval_of_const_left"))
        (ar_om2 (sym "LinearCombo") (sym "mul_eval_of_const_right"))
        (ar_om2 (sym "Int") (sym "mul_congr"))
        (ar_om2 (sym "LinearCombo") (sym "eval"))
        (ar_om2 (sym "LinearCombo") (sym "mk"))
        (ar_om2 (sym "Constraint") (sym "mk"))
        (ar_om (sym "normalizeCoeffs"))
        (ar_om (sym "normalizeConstraint"))
        (n2 (sym "List") (sym "not_mem_nil"))
        (n2 (sym "List") (sym "instMembership"))
        (n2 (sym "Membership") (sym "mem"))
        (n1 (sym "List"))
        (n2 (sym "List") (sym "cons"))
        (n2 (sym "List") (sym "nil"))
        (n2 (sym "Option") (sym "some"))
        (n2 (sym "Option") (sym "none"))
        (n2 (sym "Eq") (sym "trans"))
        (n2 (sym "Eq") (sym "symm"))
        (n1 (sym "congrArg"))
        (n1 (sym "absurd"))
        (n1 (sym "False"))
        (n1 (sym "Not"))
        (n1 (sym "Bool"))
        (n2 (sym "Bool") (sym "true"))
        (n1 (sym "instDecidableNot"))
        (n2 (sym "Int") (sym "ediv"))
        (n2 (sym "Int") (sym "emod"))
        (n2 (sym "Int") (sym "add"))
        (n2 (sym "Int") (sym "sub"))
        (n2 (sym "Int") (sym "mul"))
        (n2 (sym "Int") (sym "neg"))
        (n2 (sym "Int") (sym "le"))
        (n2 (sym "Int") (sym "lt"))
        (n2 (sym "Int") (sym "ofNat"))
        (n2 (sym "Nat") (sym "add"))
        (n2 (sym "Nat") (sym "le"))
        (n2 (sym "Nat") (sym "lt"))
        (n2 (sym "Nat") (sym "mul"))
        (n2 (sym "Nat") (sym "succ"))))))
