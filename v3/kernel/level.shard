;;; v3/kernel/level.shard — universe levels (Lean `Level`).
;;;
;;; Reconciled against src/kernel/level.cpp (v4.33.1). `LMVar` is the
;;; elaborator's universe metavariable: an atom to every rule here, as level.cpp's mvar is, and
;;; refused by K's `check_level` — the exporter never emits one.

(import "util.shard")
(import "sym.shard")
(import "name.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.descent)
(use kernel.name)
(use kernel.sym)
(use kernel.util)

(type Level
  (LZero)  ; 0 — the level of Prop
  (LSucc Level)  ; u+1
  (LMax Level Level)  ; max u v
  (LIMax Level Level)  ; imax u v — 0 when v is 0, else max u v
  (LParam Name)  ; a declared universe parameter
  (LMVar Int))  ; ?u — an elaboration metavariable (never in K's terms)
;; the size the level functions recurse by: a constructor counts one over its levels' sizes
(derive Level size)

;; RULES (level.cpp):
;;   normalize (l. 454): write l as (base, k) with k the succ-offset;
;;     Zero/Param stay; IMax normalizes both sides and re-wraps;
;;     Max flattens nested maxes, normalizes the arguments, sorts them
;;     (`is_norm_lt`), keeps at most one explicit numeral (the largest,
;;     and only if no parameter-based argument has an offset ≥ it), and
;;     for arguments with the same base keeps the greater offset; then
;;     re-applies the outer offset to each and rebuilds `max`.
;;   is_equivalent (l. 518): lhs == rhs syntactically, or equal after
;;     normalize. This is the definitional equality of Sorts
;;     (`quick_is_def_eq`, Sort case → `is_def_eq(level, level)`).
;;   is_geq (l. 542): on normalized levels, `is_geq_core` (l. 523):
;;     l1 == l2 or l2 is zero → true; l2 = max a b → geq a and geq b;
;;     l1 = max a b with geq(a,l2) or geq(b,l2) → true; l2 = imax a b →
;;     geq a and geq b; l1 = imax a b → geq(b, l2); same base or l2's
;;     base zero → compare offsets; equal positive offsets → recurse on
;;     bases; else false. Used for constructor-field universe checks.
;;   is_not_zero (l. 160): Succ → true; Max → either side; IMax → the
;;     right side; Zero/Param → false. Decides "never a proposition" for
;;     elimination levels (`m_is_not_zero`).
;;   normalizes_to_zero: `normalize l == zero` — the test for "is a
;;     proposition" (`is_prop`), deliberately up to normalization so that
;;     `imax 1 0` counts (type_checker.cpp l. 383 comment).
;;   check_level (type_checker.cpp l. 85): every LParam in a checked
;;     term must be among the declaration's declared level parameters
;;     (RuleViolation: "undefined universe level parameter");
;;     `check_duplicated_univ_params` refuses a repeated parameter name.
;;   Sort typing: `Sort u : Sort (u+1)`; `Prop = Sort 0` impredicative
;;     (a Pi whose codomain is in Prop is in Prop — expr.shard, Pi).

;; ======================================================================
;; THE FUNCTIONS — each is the level.cpp procedure of the same
;; name; line numbers are into level.cpp at the pin.

;; structural equality (operator==, l. 128) — no normalization
(fn level_eq ((a Level) (b Level)) Bool
  (measure (struct a))
  (match a
    (LZero
      (match b
        (LZero true)
        (_ false)))
    ((LSucc x)
     (match b
       ((LSucc y) (level_eq x y))
       (_ false)))
    ((LMax x1 x2)
     (match b
       ((LMax y1 y2) (if (level_eq x1 y1) (level_eq x2 y2) false))
       (_ false)))
    ((LIMax x1 x2)
     (match b
       ((LIMax y1 y2) (if (level_eq x1 y1) (level_eq x2 y2) false))
       (_ false)))
    ((LParam n)
     (match b
       ((LParam m) (name_eq n m))
       (_ false)))
    ((LMVar i)
     (match b
       ((LMVar j) (= i j))
       (_ false)))))

(fn levels_eq ((a (List Level)) (b (List Level))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (level_eq x y) (levels_eq ar br) false))))))

(fn level_has_param ((l Level)) Bool
  (measure (struct l))
  (match l
    (LZero false)
    ((LSucc x) (level_has_param x))
    ((LMax x y) (bool_or (level_has_param x) (level_has_param y)))
    ((LIMax x y) (bool_or (level_has_param x) (level_has_param y)))
    ((LParam _) true)
    ((LMVar _) false)))

(fn level_has_mvar ((l Level)) Bool
  (measure (struct l))
  (match l
    (LZero false)
    ((LSucc x) (level_has_mvar x))
    ((LMax x y) (bool_or (level_has_mvar x) (level_has_mvar y)))
    ((LIMax x y) (bool_or (level_has_mvar x) (level_has_mvar y)))
    ((LParam _) false)
    ((LMVar _) true)))

;; kind order of the C++ enum: Zero < Succ < Max < IMax < Param < MVar
(fn level_kind ((l Level)) Int
  (match l
    (LZero 0)
    ((LSucc _) 1)
    ((LMax _ _) 2)
    ((LIMax _ _) 3)
    ((LParam _) 4)
    ((LMVar _) 5)))

(fn is_zero ((l Level)) Bool
  (match l
    (LZero true)
    (_ false)))
(fn is_one ((l Level)) Bool
  (match l
    ((LSucc LZero) true)
    (_ false)))

;; is_explicit (l. 60): succ^k zero
(fn is_explicit ((l Level)) Bool
  (measure (struct l))
  (match l
    (LZero true)
    ((LSucc x) (is_explicit x))
    (_ false)))

;; to_offset (l. 71): succ^k l ↦ (l, k)
(fn to_offset_go ((l Level) (k Int)) (Prod Level Int)
  (measure (struct l))
  (match l
    ((LSucc x) (to_offset_go x (+ k 1)))
    (_ (Prod.mk l k))))
(fn to_offset ((l Level)) (Prod Level Int) (to_offset_go l 0))
;; the base `to_offset` returns is the level less its successors: never the larger
(theorem to_offset_go_le ((l Level))
  (forall ((k Int) (b Level) (j Int))
    (-> (= (to_offset_go l k) (Prod.mk b j)) (<= (Level.size b) (Level.size l))))
  (by
    (induction l
      ((LZero () (intro k b j h) (have e (= (Prod.mk LZero k) (Prod.mk b j)) (exact h))
         (have eb (= LZero b) (exact (congrArg Prod.fst e)))
         (rw (<- eb))
         (arith))
       (LSucc (x ih) (intro k b j h)
         (have h2 (<= (Level.size b) (Level.size x)) (exact (ih (+ k 1) b j h)))
         (rw Level.size.eq_2)
         (arith))
       (LMax (x y ihx ihy) (intro k b j h)
         (have e (= (Prod.mk (LMax x y) k) (Prod.mk b j)) (exact h))
         (have eb (= (LMax x y) b) (exact (congrArg Prod.fst e)))
         (rw (<- eb))
         (arith))
       (LIMax (x y ihx ihy) (intro k b j h)
         (have e (= (Prod.mk (LIMax x y) k) (Prod.mk b j)) (exact h))
         (have eb (= (LIMax x y) b) (exact (congrArg Prod.fst e)))
         (rw (<- eb))
         (arith))
       (LParam (n) (intro k b j h) (have e (= (Prod.mk (LParam n) k) (Prod.mk b j)) (exact h))
         (have eb (= (LParam n) b) (exact (congrArg Prod.fst e)))
         (rw (<- eb))
         (arith))
       (LMVar (i) (intro k b j h) (have e (= (Prod.mk (LMVar i) k) (Prod.mk b j)) (exact h))
         (have eb (= (LMVar i) b) (exact (congrArg Prod.fst e)))
         (rw (<- eb))
         (arith))))))
(theorem to_offset_le ((l Level) (b Level) (j Int) (h (= (to_offset l) (Prod.mk b j))))
  (<= (Level.size b) (Level.size l))
  (by (exact (to_offset_go_le l 0 b j h))))
(fn offset_base ((l Level)) Level
  (match (to_offset l)
    ((Prod.mk b _) b)))
(fn offset_k ((l Level)) Int
  (match (to_offset l)
    ((Prod.mk _ k) k)))

;; depth (lean_level_depth): the height used by mk_max on explicit levels
(fn level_depth ((l Level)) Int
  (measure (struct l))
  (match l
    (LZero 0)
    ((LSucc x) (+ 1 (level_depth x)))
    ((LMax x y) (+ 1 (max_int (level_depth x) (level_depth y))))
    ((LIMax x y) (+ 1 (max_int (level_depth x) (level_depth y))))
    ((LParam _) 0)
    ((LMVar _) 0)))

;; mk_succ(l, k) (l. 447)
(fn mk_succ_n ((l Level) (k Int)) Level
  (measure (Int.natAbs k))
  (if (<= k 0) l (mk_succ_n (LSucc l) (- k 1))))
(fulfills mk_succ_n.dec_1 (by (intro p h) (apply natAbs_pred (arith))))

;; is_not_zero (l. 160)
(fn is_not_zero ((l Level)) Bool
  (measure (struct l))
  (match l
    (LZero false)
    ((LParam _) false)
    ((LMVar _) false)
    ((LSucc _) true)
    ((LMax x y) (bool_or (is_not_zero x) (is_not_zero y)))
    ((LIMax _ y) (is_not_zero y))))

;; normalizes_to_zero (l. 176) — the `is_prop` test
(fn normalizes_to_zero ((l Level)) Bool
  (measure (struct l))
  (match l
    (LZero true)
    ((LParam _) false)
    ((LMVar _) false)
    ((LSucc _) false)
    ((LMax x y) (bool_and (normalizes_to_zero x) (normalizes_to_zero y)))
    ((LIMax _ y) (normalizes_to_zero y))))

;; the smart constructors mk_max (l. 76) and mk_imax (l. 108), exactly
(fn mk_max ((l1 Level) (l2 Level)) Level
  (if (bool_and (is_explicit l1) (is_explicit l2)) (if (<= (level_depth l2) (level_depth l1)) l1 l2)
  (if (level_eq l1 l2) l1
  (if (is_zero l1) l2
  (if (is_zero l2) l1
  (match l2
    ((LMax a b) (if (bool_or (level_eq a l1) (level_eq b l1)) l2 (mk_max_rest l1 l2)))
    (_ (mk_max_rest l1 l2))))))))

(fn mk_max_rest ((l1 Level) (l2 Level)) Level
  (match l1
    ((LMax a b) (if (bool_or (level_eq a l2) (level_eq b l2)) l1 (mk_max_offsets l1 l2)))
    (_ (mk_max_offsets l1 l2))))

(fn mk_max_offsets ((l1 Level) (l2 Level)) Level
  (match (to_offset l1)
    ((Prod.mk b1 k1)
     (match (to_offset l2)
       ((Prod.mk b2 k2) (if (level_eq b1 b2) (if (< k2 k1) l1 l2) (LMax l1 l2)))))))

(fn mk_imax ((l1 Level) (l2 Level)) Level
  (if (is_not_zero l2) (mk_max l1 l2)
  (if (is_zero l2) l2
  (if (bool_or (is_zero l1) (is_one l1)) l2
  (if (level_eq l1 l2) l1
  (LIMax l1 l2))))))

;; is_norm_lt (l. 397): the order `normalize` sorts max-arguments by
(fn is_norm_lt ((a Level) (b Level)) Bool
  (measure (Level.size a))
  (match (to_offset a)
    ((Prod.mk l1 k1)
     (match (to_offset b)
       ((Prod.mk l2 k2)
        (if (level_eq l1 l2) (< k1 k2)
        (if (bool_not (= (level_kind l1) (level_kind l2))) (< (level_kind l1) (level_kind l2))
        (match l1
          ((LParam n)
           (match l2
             ((LParam m) (name_lt n m))
             (_ false)))
          ((LMVar i)
           (match l2
             ((LMVar j) (< i j))
             (_ false)))
          ((LMax x1 y1)
           (match l2
             ((LMax x2 y2) (if (level_eq x1 x2) (is_norm_lt y1 y2) (is_norm_lt x1 x2)))
             (_ false)))
          ((LIMax x1 y1)
           (match l2
             ((LIMax x2 y2) (if (level_eq x1 x2) (is_norm_lt y1 y2) (is_norm_lt x1 x2)))
             (_ false)))
          (_ false)))))))))

;; a level under the base is under the level: `to_offset_le`, then the base's size opened
(fulfills is_norm_lt.dec_1
  (by
    (intro p l1 k1 h1 l2 k2 h2 hne hk x1 y1 hx x2 y2 hy hc)
    (have hl (<= (Level.size l1) (Level.size (proj PProd 0 p)))
      (exact (to_offset_le (proj PProd 0 p) l1 k1 h1)))
    (have hs (= (Level.size l1) (+ 1 (+ (Level.size x1) (Level.size y1))))
      (rw hx)
      (rw Level.size.eq_3)
      (arith))
    (arith)))
(fulfills is_norm_lt.dec_2
  (by
    (intro p l1 k1 h1 l2 k2 h2 hne hk x1 y1 hx x2 y2 hy hc)
    (have hl (<= (Level.size l1) (Level.size (proj PProd 0 p)))
      (exact (to_offset_le (proj PProd 0 p) l1 k1 h1)))
    (have hs (= (Level.size l1) (+ 1 (+ (Level.size x1) (Level.size y1))))
      (rw hx)
      (rw Level.size.eq_3)
      (arith))
    (arith)))
(fulfills is_norm_lt.dec_3
  (by
    (intro p l1 k1 h1 l2 k2 h2 hne hk x1 y1 hx x2 y2 hy hc)
    (have hl (<= (Level.size l1) (Level.size (proj PProd 0 p)))
      (exact (to_offset_le (proj PProd 0 p) l1 k1 h1)))
    (have hs (= (Level.size l1) (+ 1 (+ (Level.size x1) (Level.size y1))))
      (rw hx)
      (rw Level.size.eq_4)
      (arith))
    (arith)))
(fulfills is_norm_lt.dec_4
  (by
    (intro p l1 k1 h1 l2 k2 h2 hne hk x1 y1 hx x2 y2 hy hc)
    (have hl (<= (Level.size l1) (Level.size (proj PProd 0 p)))
      (exact (to_offset_le (proj PProd 0 p) l1 k1 h1)))
    (have hs (= (Level.size l1) (+ 1 (+ (Level.size x1) (Level.size y1))))
      (rw hx)
      (rw Level.size.eq_4)
      (arith))
    (arith)))

;; push_max_args (l. 421): flatten nested max into a list, left to right
(fn push_max_args ((l Level) (acc (List Level))) (List Level)
  (measure (struct l))
  (match l
    ((LMax a b) (push_max_args a (push_max_args b acc)))
    (_ (cons l acc))))

;; what `push_max_args_norm` is measured by: each level of a list at six times its size and
;; four — more than `normalize` owes for one level, less than it has for the `max` over two
(def levels_weight ((xs (List Level))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons x r) (+ (+ (* 6 (Level.size x)) 4) (levels_weight r)))))
(theorem push_max_args_weight ((l Level))
  (forall ((acc (List Level)))
    (<= (levels_weight (push_max_args l acc)) (+ (+ (* 6 (Level.size l)) 4) (levels_weight acc))))
  (by
    (induction l
      ((LZero () (intro acc) (rw push_max_args.eq_1) (rw levels_weight.eq_2) (arith))
       (LSucc (x ih) (intro acc) (rw push_max_args.eq_2) (rw levels_weight.eq_2) (arith))
       (LMax (a b iha ihb) (intro acc)
         (have h1
           (<= (levels_weight (push_max_args a (push_max_args b acc)))
             (+ (+ (* 6 (Level.size a)) 4) (levels_weight (push_max_args b acc))))
           (exact (iha (push_max_args b acc))))
         (have h2
           (<= (levels_weight (push_max_args b acc))
             (+ (+ (* 6 (Level.size b)) 4) (levels_weight acc)))
           (exact (ihb acc)))
         (rw push_max_args.eq_3)
         (rw Level.size.eq_3)
         (arith))
       (LIMax (a b iha ihb) (intro acc) (rw push_max_args.eq_4) (rw levels_weight.eq_2) (arith))
       (LParam (n) (intro acc) (rw push_max_args.eq_5) (rw levels_weight.eq_2) (arith))
       (LMVar (i) (intro acc) (rw push_max_args.eq_6) (rw levels_weight.eq_2) (arith))))))

;; stable insertion sort by is_norm_lt (std::sort is unstable, but the
;; order among equal elements cannot affect the result of `normalize`:
;; equal-base arguments are merged by offset and explicit ones by value)
(fn insert_norm ((x Level) (xs (List Level))) (List Level)
  (measure (struct xs))
  (match xs
    (nil (cons x nil))
    ((cons y r) (if (is_norm_lt y x) (cons y (insert_norm x r)) (cons x xs)))))

(fn sort_norm ((xs (List Level))) (List Level)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (insert_norm x (sort_norm r)))))

;; mk_max over a list (l. 434): right-nested max of the arguments
(fn mk_max_list ((xs (List Level))) Level
  (measure (struct xs))
  (match xs
    (nil LZero)
    ((cons x nil) x)
    ((cons x r) (mk_max x (mk_max_list r)))))

;; normalize (l. 454)
(fn normalize ((l Level)) Level
  (measure (+ (* 6 (Level.size l)) 3))
  (match (to_offset l)
    ((Prod.mk r k)
     (match r
       (LZero l)
       ((LParam _) l)
       ((LMVar _) l)
       ((LIMax a b) (mk_succ_n (mk_imax (normalize a) (normalize b)) k))
       ((LMax _ _)
        (let ((args (sort_norm (push_max_args_norm (push_max_args r nil) nil))))
          (mk_max_list (add_offsets (merge_norm_args (drop_explicits args)) k))))
       ((LSucc _) l)))))  ; unreachable: to_offset strips every succ

;; normalize each flattened argument and flatten again (l. 466)
(fn push_max_args_norm ((xs (List Level)) (acc (List Level))) (List Level)
  (measure (levels_weight xs))
  (match xs
    (nil acc)
    ((cons x r) (push_max_args (normalize x) (push_max_args_norm r acc)))))

;; l. 470–484: among a sorted list whose explicit numerals come first,
;; keep only the LAST explicit numeral, and drop it too when some later
;; argument has an offset ≥ it.
(fn drop_explicits ((args (List Level))) (List Level)
  (match args
    (nil nil)
    ((cons a _)
     (if (is_explicit a)
       (let ((last (last_explicit args)))
         (match (skip_explicits args)
           (nil (cons last nil))
           (rest (if (exists_offset_geq (offset_k last) rest) rest (cons last rest)))))
       args))))

(fn last_explicit ((args (List Level))) Level
  (measure (struct args))
  (match args
    (nil LZero)
    ((cons a r)
     (match r
       (nil a)
       ((cons b _) (if (is_explicit b) (last_explicit r) a))))))

(fn skip_explicits ((args (List Level))) (List Level)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons a r) (if (is_explicit a) (skip_explicits r) args))))

(fn exists_offset_geq ((k Int) (args (List Level))) Bool
  (measure (struct args))
  (match args
    (nil false)
    ((cons a r) (if (<= k (offset_k a)) true (exists_offset_geq k r)))))

;; l. 486–500: consecutive arguments with the same base keep the greater
;; offset (the list is sorted, so equal bases are adjacent)
(fn merge_norm_args ((args (List Level))) (List Level)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons a r)
     (match r
       (nil args)
       ((cons b _)
        (if (level_eq (offset_base a) (offset_base b)) (merge_norm_args r)  ; b has the greater-or-equal offset (sorted)
        (cons a (merge_norm_args r))))))))

(fn add_offsets ((args (List Level)) (k Int)) (List Level)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons a r) (cons (mk_succ_n a k) (add_offsets r k)))))

;; `normalize`'s descent: a side of the base's `imax` is under the level (`to_offset_le`); the
;; flattened `max` weighs less than the level (`push_max_args_weight`, twice: its two sides)
(fulfills normalize.dec_1
  (by
    (intro l r k h a b hr)
    (have hl (<= (Level.size r) (Level.size l)) (exact (to_offset_le l r k h)))
    (have hs (= (Level.size r) (+ 1 (+ (Level.size a) (Level.size b))))
      (rw hr)
      (rw Level.size.eq_4)
      (arith))
    (arith)))
(fulfills normalize.dec_2
  (by
    (intro l r k h a b hr)
    (have hl (<= (Level.size r) (Level.size l)) (exact (to_offset_le l r k h)))
    (have hs (= (Level.size r) (+ 1 (+ (Level.size a) (Level.size b))))
      (rw hr)
      (rw Level.size.eq_4)
      (arith))
    (arith)))
(fulfills normalize.dec_3
  (by
    (intro l r k h c d hr)
    (have hl (<= (Level.size r) (Level.size l)) (exact (to_offset_le l r k h)))
    (have hs (= (Level.size r) (+ 1 (+ (Level.size c) (Level.size d))))
      (rw hr)
      (rw Level.size.eq_3)
      (arith))
    (have h1
      (<= (levels_weight (push_max_args c (push_max_args d nil)))
        (+ (+ (* 6 (Level.size c)) 4) (levels_weight (push_max_args d nil))))
      (exact (push_max_args_weight c (push_max_args d nil))))
    (have h2
      (<= (levels_weight (push_max_args d nil)) (+ (+ (* 6 (Level.size d)) 4) (levels_weight nil)))
      (exact (push_max_args_weight d nil)))
    (have h0 (= (levels_weight nil) 0) (exact levels_weight.eq_1))
    (rw hr)
    (rw push_max_args.eq_3)
    (arith)))
(fulfills push_max_args_norm.dec_1 (by (intro xs acc x r h) (rw h) (rw levels_weight.eq_2) (arith)))
(fulfills push_max_args_norm.dec_2 (by (intro xs acc x r h) (rw h) (rw levels_weight.eq_2) (arith)))

;; is_equivalent (l. 518) — the definitional equality of universe levels
(fn is_equivalent ((a Level) (b Level)) Bool
  (if (level_eq a b) true (level_eq (normalize a) (normalize b))))

(fn levels_equivalent ((a (List Level)) (b (List Level))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x ar)
     (match b
       (nil false)
       ((cons y br) (if (is_equivalent x y) (levels_equivalent ar br) false))))))

;; is_geq_core (l. 523) on normalized inputs; is_geq (l. 542)
(fn is_geq_core ((l1 Level) (l2 Level) (fuel Int)) Bool
  (measure (* 2 (Int.natAbs fuel)))
  (if (<= fuel 0) false
  (if (bool_or (level_eq l1 l2) (is_zero l2)) true
  (match l2
    ((LMax a b) (bool_and (is_geq_core l1 a (- fuel 1)) (is_geq_core l1 b (- fuel 1))))
    (_
      (let
        ((left Bool
           (match l1
             ((LMax a b) (bool_or (is_geq_core a l2 (- fuel 1)) (is_geq_core b l2 (- fuel 1))))
             (_ false))))
        (if left true
        (match l2
          ((LIMax a b) (bool_and (is_geq_core l1 a (- fuel 1)) (is_geq_core l1 b (- fuel 1))))
          (_
            (match l1
              ((LIMax _ b) (is_geq_core b l2 (- fuel 1)))
              (_ (is_geq_offsets l1 l2 (- fuel 1)))))))))))))

(fn is_geq_offsets ((l1 Level) (l2 Level) (fuel Int)) Bool
  (measure (+ (* 2 (Int.natAbs fuel)) 1))
  (match (to_offset l1)
    ((Prod.mk b1 k1)
     (match (to_offset l2)
       ((Prod.mk b2 k2)
        (if (bool_or (level_eq b1 b2) (is_zero b2)) (<= k2 k1)
        (if (bool_and (= k1 k2) (< 0 k1)) (is_geq_core b1 b2 fuel)
        false)))))))
(fulfills is_geq_core.dec_1
  (by
    (intro l1 l2 fuel h hb a b hm)
    (have e (< (Int.natAbs (- fuel 1)) (Int.natAbs fuel)) (apply natAbs_pred (arith)))
    (arith)))
(fulfills is_geq_core.dec_2
  (by
    (intro l1 l2 fuel h hb w hw a b hm)
    (have e (< (Int.natAbs (- fuel 1)) (Int.natAbs fuel)) (apply natAbs_pred (arith)))
    (arith)))
(fulfills is_geq_core.dec_3
  (by
    (intro l1 l2 fuel h hb w hw a b hm)
    (have e (< (Int.natAbs (- fuel 1)) (Int.natAbs fuel)) (apply natAbs_pred (arith)))
    (arith)))
(fulfills is_geq_core.dec_4
  (by
    (intro l1 l2 fuel h hb w hw w2 hw2 x b hm)
    (have e (< (Int.natAbs (- fuel 1)) (Int.natAbs fuel)) (apply natAbs_pred (arith)))
    (arith)))
(fulfills is_geq_core.dec_5
  (by
    (intro l1 l2 fuel h hb w hw w2 hw2 w3 hw3)
    (have e (< (Int.natAbs (- fuel 1)) (Int.natAbs fuel)) (apply natAbs_pred (arith)))
    (arith)))
(fulfills is_geq_offsets.dec_1 (by (intro l1 l2 fuel b1 k1 h1 b2 k2 h2 hb hk) (arith)))

;; the fuel bounds the recursion on the structure; the level depth is a
;; sufficient budget (each step strips a constructor from one side)
(fn is_geq ((l1 Level) (l2 Level)) Bool
  (let ((n1 (normalize l1)) (n2 (normalize l2)))
    (is_geq_core n1 n2 (+ 4 (* 2 (+ (level_depth n1) (level_depth n2)))))))

;; instantiate (l. 340): substitute the declared parameters ps by ls,
;; positionally; a parameter not in ps stays
(fn level_inst ((l Level) (ps (List Name)) (ls (List Level))) Level
  (measure (struct l))
  (match l
    (LZero l)
    ((LSucc x) (LSucc (level_inst x ps ls)))
    ((LMax x y) (mk_max (level_inst x ps ls) (level_inst y ps ls)))
    ((LIMax x y) (mk_imax (level_inst x ps ls) (level_inst y ps ls)))
    ((LParam n) (level_lookup n ps ls l))
    ((LMVar _) l)))

(fn level_lookup ((n Name) (ps (List Name)) (ls (List Level)) (dflt Level)) Level
  (measure (struct ps))
  (match ps
    (nil dflt)
    ((cons p pr)
     (match ls
       (nil dflt)
       ((cons l lr) (if (name_eq n p) l (level_lookup n pr lr dflt)))))))

(fn levels_inst ((xs (List Level)) (ps (List Name)) (ls (List Level))) (List Level)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (cons (level_inst x ps ls) (levels_inst r ps ls)))))

;; get_undef_param (l. 324): the first parameter of l not among ps —
;; `check_level`'s test (type_checker.cpp l. 85); a metavariable is
;; reported under the name `?u` (K never accepts one: l. 342)
(fn undef_param ((l Level) (ps (List Name))) (Option Name)
  (measure (struct l))
  (match l
    (LZero none)
    ((LSucc x) (undef_param x ps))
    ((LMax x y)
     (match (undef_param x ps)
       ((some n) (some n))
       (none (undef_param y ps))))
    ((LIMax x y)
     (match (undef_param x ps)
       ((some n) (some n))
       (none (undef_param y ps))))
    ((LParam n) (if (mem_name n ps) none (some n)))
    ((LMVar _) (some (n1 (sym "?u"))))))

;; rendering, for diagnostics and tests (level.cpp print, l. 361)
(fn show_level ((l Level)) (List Int)
  (measure (struct l))
  (if (is_explicit l) (show_nat (level_depth l))
  (match l
    ((LParam n) (show_name n))
    ((LMVar i) (append (utf8 "?u") (show_nat i)))
    ((LSucc x) (append (utf8 "(succ ") (append (show_level x) (utf8 ")"))))
    ((LMax x y)
     (append (utf8 "(max ")
       (append (show_level x) (append (utf8 " ") (append (show_level y) (utf8 ")"))))))
    ((LIMax x y)
     (append (utf8 "(imax ")
       (append (show_level x) (append (utf8 " ") (append (show_level y) (utf8 ")"))))))
    (LZero (utf8 "0")))))
