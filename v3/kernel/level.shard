;;; v3/kernel/level.shard — universe levels (Lean `Level`).
;;;
;;; Reconciled against src/kernel/level.cpp (v4.33.1). No `mvar`
;;; constructor: K refuses metavariables (FOUNDATION §6); the exporter
;;; never emits them.

(import "name.shard")

(type Level
  (LZero)                 ; 0 — the level of Prop
  (LSucc Level)           ; u+1
  (LMax Level Level)      ; max u v
  (LIMax Level Level)     ; imax u v — 0 when v is 0, else max u v
  (LParam Name))          ; a declared universe parameter

;; RULES (level.cpp):
;;   normalize (l. 454): write l as (base, k) with k the succ-offset;
;;     Zero/Param stay; IMax normalizes both sides and re-wraps;
;;     Max flattens nested maxes, normalizes the arguments, sorts them
;;     (`is_norm_lt`), keeps at most one explicit numeral (the largest,
;;     and only if no parameter-based argument has an offset ≥ it), and
;;     for arguments with the same base keeps the greater offset; then
;;     re-applies the outer offset to each and rebuilds `max`.
;;   is_equivalent (l. 518): lhs == rhs syntactically, or equal after
;;     normalize. This is the definitional equality of Sorts
;;     (`quick_is_def_eq`, Sort case → `is_def_eq(level, level)`).
;;   is_geq (l. 542): on normalized levels, `is_geq_core` (l. 523):
;;     l1 == l2 or l2 is zero → true; l2 = max a b → geq a and geq b;
;;     l1 = max a b with geq(a,l2) or geq(b,l2) → true; l2 = imax a b →
;;     geq a and geq b; l1 = imax a b → geq(b, l2); same base or l2's
;;     base zero → compare offsets; equal positive offsets → recurse on
;;     bases; else false. Used for constructor-field universe checks.
;;   is_not_zero (l. 160): Succ → true; Max → either side; IMax → the
;;     right side; Zero/Param → false. Decides "never a proposition" for
;;     elimination levels (`m_is_not_zero`).
;;   normalizes_to_zero: `normalize l == zero` — the test for "is a
;;     proposition" (`is_prop`), deliberately up to normalization so that
;;     `imax 1 0` counts (type_checker.cpp l. 383 comment).
;;   check_level (type_checker.cpp l. 85): every LParam in a checked
;;     term must be among the declaration's declared level parameters
;;     (RuleViolation: "undefined universe level parameter");
;;     `check_duplicated_univ_params` refuses a repeated parameter name.
;;   Sort typing: `Sort u : Sort (u+1)`; `Prop = Sort 0` impredicative
;;     (a Pi whose codomain is in Prop is in Prop — expr.shard, Pi).
