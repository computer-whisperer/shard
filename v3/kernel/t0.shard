;;; v3/kernel/t0.shard — the T0 driver: `eval direct v3/kernel/t0.shard [-v] [-a] CHUNK…`
;;; `-a` = print the axiom closure of every admitted constant (axioms.shard; §3.6).
;;; `--pins` = pins mode (gen_pins.sh): pin every candidate as admitted and print
;;; the reference table (refgen.shard) at the end.
;;; `-p` = print which candidates the run pinned (`PINS pinned: … | unpinned: …`;
;;; v3/t0_full.sh requires the unpinned list empty).
;;; `--receipt FILE` = after a run that accepted every record of its chunks
;;; (nothing rejected, exhausted, mismatched or unsupported), write FILE: one
;;; line per chunk, `PATH BYTES` — the Init receipt the loader admits the
;;; chunks under (load.shard --init-receipt; LANGUAGE.md §8.4 slice 3.23).
;;; A run with anything not accepted writes nothing and fails as before.
;;; reads the lean4export NDJSON chunks in order (split -l of the export;
;;; v3/README.md), imports and checks every declaration, prints every
;;; non-ACCEPT verdict (ACCEPT too with -v) and the counts; exit code =
;;; rejected + exhausted + mismatched (Unsupported is reported, not failed).

(import "host.shard")
(import "k")
(use kernel.k)
(use kernel.host)
(use kernel.name)
(use kernel.prelude)
(use kernel.util)
(use kernel.host.World)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

(fn run_files ((r Run) (files (List (List Int))) (verbose Bool) (lines (List Int)) (w World)) (Pair (Pair Run (List Int)) World)
  (measure (struct files))
  (match files
    (Nil (Pair (Pair r lines) w))
    ((Cons f rest)
     (match (read_file f w)
       ((Pair None w1) (run_files r rest verbose lines (write_line (append "cannot read " f) w1)))
       ((Pair (Some bs) w1)
        (match (process_lines r bs verbose (write_line (append "== " f) w1))
          ((Pair r1 w2) (run_files r1 rest verbose (append lines (append f (Cons 32 (append (show_nat (len bs)) (list 10))))) (write_line (show_counts r1) w2)))))))))

(fn parse_flags ((args (List (List Int))) (v Bool) (a Bool) (p Bool) (q Bool) (rc (List Int))) (Pair (List (List Int)) (Pair (List Bool) (List Int)))
  (measure (struct args))
  (match args
    (Nil (Pair Nil (Pair (list v a p q) rc)))
    ((Cons x r)
     (if (int_list_eq x "-v") (parse_flags r True a p q rc)
     (if (int_list_eq x "-a") (parse_flags r v True p q rc)
     (if (int_list_eq x "--pins") (parse_flags r v a True q rc)
     (if (int_list_eq x "-p") (parse_flags r v a p True rc)
     (if (int_list_eq x "--receipt") (match r ((Cons f r2) (parse_flags r2 v a p q f)) (Nil (Pair Nil (Pair (list v a p q) rc))))
     (Pair args (Pair (list v a p q) rc))))))))))

;; the receipt: written only when nothing was refused, exhausted, mismatched or unsupported
(fn write_receipt ((rc (List Int)) (lines (List Int)) (clean Bool) (w World)) World
  (if (int_eq (len rc) 0) w
  (if (bool_not clean) (write_line (append "RECEIPT: not written, the run was not clean: " rc) w)
    (match (write_file rc lines w)
      ((Pair True w1) (write_line (append "RECEIPT: " rc) w1))
      ((Pair False w1) (write_line (append "RECEIPT: cannot write " rc) w1))))))

;; -p: which candidates the run pinned (add.shard `pin_if_matches`) — every
;; candidate present in the environment must be; the unpinned list is the gate
(fn show_pinned ((env CheckedEnv) (ns (List Name)) (yes (List Int)) (no (List Int))) (List Int)
  (measure (struct ns))
  (match ns
    (Nil (append "PINS pinned:" (append yes (append " | unpinned:" no))))
    ((Cons n r)
     (match (env_find env n)
       (None (show_pinned env r yes no))
       ((Some _)
        (if (env_pinned env n)
          (show_pinned env r (append yes (Cons 32 (show_name n))) no)
          (show_pinned env r yes (append no (Cons 32 (show_name n))))))))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match (parse_flags args False False False False Nil)
       ((Pair files (Pair (Cons verbose (Cons ax (Cons pins (Cons pp Nil)))) rc))
        (match (run_files (empty_run pins ax) files verbose Nil w1)
          ((Pair (Pair r lines) w2)
           (match (run_counts r)
             ((Cons _ (Cons b (Cons c (Cons d (Cons e _)))))
              (exit (+ b (+ c d))
                (write_receipt rc lines (int_eq (+ b (+ c (+ d e))) 0)
                  (write_line (append "T0: " (show_counts r))
                    (if pp (write_line (show_pinned (run_env r) (pin_candidates) Nil Nil) w2)
                    (if pins (show_refs (run_env r) (pin_candidates) w2) w2))))))
             (_ (exit 2 w2))))))
       (_ (exit 2 w1))))))
