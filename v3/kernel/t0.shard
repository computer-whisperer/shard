;;; v3/kernel/t0.shard — the replay driver: `eval direct v3/kernel/t0.shard [-v] [-a] CHUNK…`
;;; `-a` = print the axiom closure of every admitted constant (k/axioms.shard).
;;; `--pins` = the generator (gen_pins.sh): print the reference table (k/refgen.shard)
;;; at the end — every candidate's identity closure as admitted; no privileged mode:
;;; the flag changes nothing about what is pinned.
;;; `-p` = print which candidates the run pinned (`PINS pinned: … | unpinned: …`;
;;; v3/t0_full.sh requires the unpinned list empty).
;;; reads the lean4export NDJSON chunks in order (split -l of the export),
;;; imports and checks every declaration, prints every
;;; non-ACCEPT verdict (ACCEPT too with -v) and the counts; exit code =
;;; rejected + exhausted + mismatched (Unsupported is reported, not failed).

(import "host.shard")
(import "k")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.k)
(use kernel.host)
(use kernel.name)
(use kernel.util)
(use kernel.host.World)

(fn run_files ((r Run) (files (List (List Int))) (verbose Bool) (w World)) (Prod Run World)
  (measure (struct files))
  (match files
    (nil (Prod.mk r w))
    ((cons f rest)
     (match (read_file f w)
       ((Prod.mk none w1)
        (run_files r rest verbose (write_line (append (utf8 "cannot read ") f) w1)))
       ((Prod.mk (some bs) w1)
        (match (process_lines r bs verbose (write_line (append (utf8 "== ") f) w1))
          ((Prod.mk r1 w2) (run_files r1 rest verbose (write_line (show_counts r1) w2)))))))))

(fn parse_flags ((args (List (List Int))) (v Bool) (a Bool) (p Bool) (q Bool))
  (Prod (List (List Int)) (List Bool))
  (measure (struct args))
  (match args
    (nil (Prod.mk nil (list v a p q)))
    ((cons x r)
     (if (int_list_eq x (utf8 "-v")) (parse_flags r true a p q)
     (if (int_list_eq x (utf8 "-a")) (parse_flags r v true p q)
     (if (int_list_eq x (utf8 "--pins")) (parse_flags r v a true q)
     (if (int_list_eq x (utf8 "-p")) (parse_flags r v a p true)
     (Prod.mk args (list v a p q)))))))))

;; -p: which candidates the run pinned (add.shard `pin_if_matches`) — every
;; candidate present in the environment must be; the unpinned list is the gate
(fn show_pinned ((env CheckedEnv) (ns (List Name)) (yes (List Int)) (no (List Int))) (List Int)
  (measure (struct ns))
  (match ns
    (nil (append (utf8 "PINS pinned:") (append yes (append (utf8 " | unpinned:") no))))
    ((cons n r)
     (match (env_find env n)
       (none (show_pinned env r yes no))
       ((some _)
        (if (env_pinned env n) (show_pinned env r (append yes (cons 32 (show_name n))) no)
        (show_pinned env r yes (append no (cons 32 (show_name n))))))))))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match (parse_flags args false false false false)
       ((Prod.mk files (cons verbose (cons ax (cons pins (cons pp nil)))))
        (match (run_files (empty_run ax) files verbose w1)
          ((Prod.mk r w2)
           (match (run_counts r)
             ((cons _ (cons b (cons c (cons d _))))
              (exit (+ b (+ c d))
                (write_line (append (utf8 "T0: ") (show_counts r))
                  (if pp (write_line (show_pinned (run_env r) (pin_candidates) nil nil) w2)
                  (if pins (show_refs (run_env r) (pin_candidates) w2)
                  w2)))))
             (_ (exit 2 w2))))))
       (_ (exit 2 w1))))))
