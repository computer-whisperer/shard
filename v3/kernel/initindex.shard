;;; v3/kernel/initindex.shard — the Init index's driver (index.shard):
;;;   eval direct v3/kernel/initindex.shard EXPORT INDEX            build the index
;;;   eval direct v3/kernel/initindex.shard --verify EXPORT INDEX   read it back
;;; EXPORT is the lean4export NDJSON in one file (v3/export.sh's init.ndjson); INDEX is
;;; the one file holding the record table, the name table and the declaration table,
;;; written (or, under --verify, read). Prints one line — the counts, or the first
;;; failure — and exits 0 or 1. kernel/test/init_index.sh keeps v3/.cache/init.index
;;; current.

(import Init)
(import "index.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.index)
(use kernel.index.IxOut)
(use kernel.host)
(use kernel.util)
(use kernel.host.World)

(fn usage ((w World)) World
  (exit 2 (write_line "usage: initindex.shard EXPORT INDEX | --verify EXPORT INDEX" w)))

(fn build ((export (List Int)) (index (List Int)) (w World)) World
  (match (ix_build export w)
    ((Prod.mk (IxBad msg) w1) (exit 1 (write_line (append "index: " msg) w1)))
    ((Prod.mk (IxTables bytes records names decls) w1)
     (match (write_file index bytes w1)
       ((Prod.mk true w2)
        (write_line
          (append "index: "
            (append (show_nat records)
              (append " records, "
                (append (show_nat names)
                  (append " names, " (append (show_nat decls) (append " name ids; " index)))))))
          w2))
       ((Prod.mk false w2) (exit 1 (write_line (append "index: cannot write " index) w2)))))))

(fn verify ((export (List Int)) (index (List Int)) (w World)) World
  (match (ix_verify export index w)
    ((Prod.mk (some msg) w1) (exit 1 (write_line (append "index: FAIL: " msg) w1)))
    ((Prod.mk none w1)
     (write_line
       "index: verified: every record at its row, every name at its ordinal and by its id, the name table sorted"
       w1))))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (match args
       ((cons a (cons b r))
        (if (int_list_eq a "--verify")
          (match r
            ((cons c nil) (verify b c w1))
            (_ (usage w1)))
          (match r
            (nil (build a b w1))
            (_ (usage w1)))))
       (_ (usage w1))))))
