;;; v3/kernel/initindex.shard — the Init index's driver (index.shard; LANGUAGE.md §8.4
;;; slice 3.26 rule 1):
;;;   eval direct v3/kernel/initindex.shard EXPORT INDEX            build the index
;;;   eval direct v3/kernel/initindex.shard --verify EXPORT INDEX   read it back
;;; EXPORT is the lean4export NDJSON in one file (v3/export.sh's init.ndjson); INDEX is
;;; the one file holding the record table, the name table and the declaration table,
;;; written (or, under --verify, read). Prints one line — the counts, or the first
;;; failure — and exits 0 or 1. kernel/test/init_index.sh keeps v3/.cache/init.index
;;; current.

(import "index.shard")
(use kernel.index)
(use kernel.index.IxOut)
(use kernel.host)
(use kernel.prelude)
(use kernel.util)
(use kernel.host.World)
(use kernel.prelude.Bool)
(use kernel.prelude.List)
(use kernel.prelude.Option)
(use kernel.prelude.Pair)

(fn usage ((w World)) World
  (exit 2 (write_line "usage: initindex.shard EXPORT INDEX | --verify EXPORT INDEX" w)))

(fn build ((export (List Int)) (index (List Int)) (w World)) World
  (match (ix_build export w)
    ((Pair (IxBad msg) w1) (exit 1 (write_line (append "index: " msg) w1)))
    ((Pair (IxTables bytes records names decls) w1)
     (match (write_file index bytes w1)
       ((Pair True w2)
        (write_line (append "index: " (append (show_nat records) (append " records, " (append (show_nat names) (append " names, " (append (show_nat decls) (append " name ids; " index))))))) w2))
       ((Pair False w2) (exit 1 (write_line (append "index: cannot write " index) w2)))))))

(fn verify ((export (List Int)) (index (List Int)) (w World)) World
  (match (ix_verify export index w)
    ((Pair (Some msg) w1) (exit 1 (write_line (append "index: FAIL: " msg) w1)))
    ((Pair None w1) (write_line "index: verified: every record at its row, every name at its ordinal and by its id, the name table sorted" w1))))

(fn main ((w World)) World
  (match (get_args w)
    ((Pair args w1)
     (match args
       ((Cons a (Cons b r))
        (if (int_list_eq a "--verify")
          (match r ((Cons c Nil) (verify b c w1)) (_ (usage w1)))
          (match r (Nil (build a b w1)) (_ (usage w1)))))
       (_ (usage w1))))))
