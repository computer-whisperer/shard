;;; v3/kernel/descent.shard — the descent facts of the toolchain's integer measures. A function
;;; that recurses on an Int states its measure as a Nat, `(Int.natAbs n)`, and owes for each
;;; recursive call that the measure is less at the call's arguments (`NAME.dec_N`,
;;; LANGUAGE.md "By measure"). The shapes those calls take are few, and each has its fact
;;; here: a proof of an obligation introduces what stands before the comparison and cites one.

(theorem natAbs_of_nonneg ((a Int)) (-> (<= 0 a) (= (Int.ofNat (Int.natAbs a)) a))
  (by (cases a ((ofNat (n) (intro h) rfl) (negSucc (n) (intro h) (arith (Int.negSucc_lt_zero n)))))))
;; a smaller non-negative Int has the smaller natAbs
(theorem natAbs_lt ((a Int) (b Int) (h0 (<= 0 a)) (h1 (< a b))) (< (Int.natAbs a) (Int.natAbs b))
  (by (have hb (<= 0 b) (arith)) (arith (natAbs_of_nonneg a h0) (natAbs_of_nonneg b hb))))

;; a counter stepping down past a test that it is at least 1: a budget of steps, a depth
(theorem natAbs_pred ((d Int) (h (Not (< d 1)))) (< (Int.natAbs (- d 1)) (Int.natAbs d))
  (by (apply (natAbs_lt (- d 1) d) (arith) (arith))))
;; a number losing its last decimal digit
(theorem natAbs_div10 ((n Int) (h (Not (< n 10)))) (< (Int.natAbs (/ n 10)) (Int.natAbs n))
  (by (apply (natAbs_lt (/ n 10) n) (arith) (arith))))

;; an integer losing its two low bits: never further from 0, and nearer unless it is 0 or -1,
;; the two that a shift leaves as they are
(theorem nat_shr2_lt ((n Nat) (h (< 0 n))) (< (Nat.shiftRight n 2) n)
  (by
    (rw (Nat.shiftRight_eq_div_pow n 2))
    (have h2 (< 1 (Nat.pow 2 2)) decide)
    (exact (Nat.div_lt_self h h2))))
(theorem natAbs_shr2_le ((x Int)) (<= (Int.natAbs (bshr x 2)) (Int.natAbs x))
  (by
    (cases x
      ((ofNat (n) (exact (Nat.shiftRight_le n 2)))
       (negSucc (n) (exact (Nat.succ_le_succ (Nat.shiftRight_le n 2))))))))
(theorem natAbs_shr2_lt ((x Int) (h0 (Not (= x 0))) (h1 (Not (= x -1))))
  (< (Int.natAbs (bshr x 2)) (Int.natAbs x))
  (by
    (cases x
      ((ofNat (n)
         (have hn (< 0 n)
           (exact (Nat.pos_of_ne_zero (fun ((z (= n 0))) (h0 (congrArg Int.ofNat z))))))
         (exact (nat_shr2_lt n hn)))
       (negSucc (n)
         (have hn (< 0 n)
           (exact (Nat.pos_of_ne_zero (fun ((z (= n 0))) (h1 (congrArg Int.negSucc z))))))
         (exact (Nat.succ_lt_succ (nat_shr2_lt n hn))))))))
