;;; v3/std/migration.shard — law §10.3's migration table validated (LANGUAGE.md §8.4 slice
;;; 3.27 rule 8, landing 2): one theorem per row of the table, stating the row's V3 spelling
;;; and the exceptional behavior its third column names, on this pin — `Eq.refl` where the
;;; spelling is Init's by definition, the citation of Init's theorem where it is one. The
;;; rows are numbered as the law lists them. Row 8's `List.get?` is no constant of this pin
;;; (the index `l[i]?` is GetElem?.getElem? under List's instance, List.get?Internal by
;;; definition); the law's row is corrected beside this file. `==`, `&&` and `||` are not
;;; operator symbols of the elaborator today: `and`, `or` and `not` at Bool operands are
;;; Bool.and, Bool.or and Bool.not (rows 4 and 5 state the bridges on those spellings). After
;;; the rows, the records' evidence: std/README.md's claims for the old `order`, `nat`, `div`
;;; and `arith` modules as theorems, so each record is checked and not asserted.
(import Init List.getD)

;; row 1: + - * on Int are Int.add, Int.sub, Int.mul — the operator rows (name)
(theorem int_ops ((a Int) (b Int))
  (and (= (+ a b) (Int.add a b)) (and (= (- a b) (Int.sub a b)) (= (* a b) (Int.mul a b))))
  (exact (And.intro (Eq.refl (Int.add a b)) (And.intro (Eq.refl (Int.sub a b)) (Eq.refl (Int.mul a b))))))

;; row 2: the truncating pair is named Int.tdiv and Int.tmod; x/0 = 0, tmod x 0 = x (behavior)
(theorem tdiv_zero ((x Int)) (= (Int.tdiv x 0) 0) (exact (Int.tdiv_zero x)))
(theorem tmod_zero ((x Int)) (= (Int.tmod x 0) x) (exact (Int.tmod_zero x)))

;; row 3: ediv and mod are / and %, Euclidean; x/0 = 0, x % 0 = x (behavior)
(theorem ediv_zero ((x Int)) (= (/ x 0) 0) (exact (Int.ediv_zero x)))
(theorem emod_zero ((x Int)) (= (% x 0) x) (exact (Int.emod_zero x)))

;; row 4: int_eq, le and lt are propositions, decided in E by the type's decision; the Bool
;; comparison is BEq.beq under the table's instance, a decision too (typed)
(theorem le_decides ((a Int) (b Int))
  (iff (= (@Decidable.decide (<= a b) (Int.decLe a b)) Bool.true) (<= a b))
  (exact (@decide_eq_true_iff (<= a b) (Int.decLe a b))))
(theorem beq_decides ((a Int) (b Int)) (iff (= (BEq.beq a b) Bool.true) (= a b))
  (exact (@decide_eq_true_iff (= a b) (Int.decEq a b))))

;; row 5: andb, orb and notb are the connectives on propositions; at Bool operands `and`, `or`
;; and `not` are Bool.and, Bool.or and Bool.not, bridged to the propositions (typed)
(theorem and_bridge ((a Bool) (b Bool)) (iff (= (and a b) Bool.true) (and (= a Bool.true) (= b Bool.true)))
  (exact (Iff.of_eq (Bool.and_eq_true a b))))

;; row 6: Bool's constructors are Bool.true and Bool.false (true and false in a pattern); True and
;; False are propositions (name)
(theorem bool_literals () (and (= (not Bool.false) Bool.true) True) (exact (And.intro (Eq.refl Bool.true) True.intro)))

;; row 7: Some, None, Cons, Nil and Pair are Option.some, Option.none, List.cons, List.nil and
;; Prod.mk in a term (some, none, cons and nil in a pattern) (name)
(theorem ctor_names ((x Nat) (d Nat) (y Int))
  (and (= (Option.getD (Option.some x) d) x)
  (and (= (Option.getD Option.none d) d)
  (and (= (List.length (List.cons x List.nil)) 1)
       (= (Prod.fst (Prod.mk x y)) x))))
  (exact (And.intro (Eq.refl x) (And.intro (Eq.refl d) (And.intro (Eq.refl 1) (Eq.refl x))))))

;; row 8: len, append, rev, inth and memb are List.length (at Nat), List.append, List.reverse,
;; the index l[i]? (List.get?Internal) with List.getD the named default, and List.contains
;; with List.Mem (typed)
(theorem list_names ((x Nat) (xs (List Nat)) (d Nat))
  (and (= (List.length (List.cons x xs)) (+ (List.length xs) 1))
  (and (= (List.get?Internal (List.cons x xs) 0) (Option.some x))
  (and (= (List.getD (List.cons x xs) 0 d) x)
       (= (List.getD (@List.nil Nat) 0 d) d))))
  (exact (And.intro (Eq.refl (+ (List.length xs) 1)) (And.intro (Eq.refl (Option.some x)) (And.intro (Eq.refl x) (Eq.refl d))))))

;; row 9: band, bor, bxor, bshl and bshr with their `0 ≤` premises are Nat.land, lor, xor,
;; shiftLeft and shiftRight at Nat, the premises the type: a bound with none (typed)
(theorem land_nat ((a Nat) (b Nat)) (<= (Nat.land a b) b) (exact (@Nat.and_le_right a b)))

;; row 10: the Nat former is Nat; Nat.sub saturates (name)
(theorem nat_sub_saturates ((n Nat)) (= (- 0 n) 0) (exact (Nat.zero_sub n)))

;; row 11: (refine Int nonneg) is Nat where the value is a size, Subtype otherwise (typed)
(def Nonneg ((x Int)) Prop (<= 0 x))
(theorem refine_subtype ((x Int) (h (Nonneg x))) (= (Subtype.val (@Subtype.mk Int Nonneg x h)) x) (exact (Eq.refl x)))
(theorem size_nat ((n Nat)) (= (Int.toNat (Int.ofNat n)) n) (exact (Int.toNat_natCast n)))

;; row 12: std/word's widths are UInt8 … over BitVec over Fin; the arithmetic wraps (typed)
(theorem word_wraps ((n Nat)) (= (UInt8.toNat (UInt8.ofNat n)) (% n 256)) (exact (Eq.refl (% n 256))))

;; row 13: Bytes is ByteArray, List UInt8 its view (typed)
(theorem bytes_view ((l (List UInt8))) (= (Array.toList (ByteArray.data (ByteArray.mk (Array.mk l)))) l) (exact (Eq.refl l)))

;; row 14: Str is String — in this pin a structure over its UTF-8 ByteArray and the proof it is
;; valid, String.ofByteArray its constructor and String.toByteArray the projection, the validated
;; buffer the E realization
;; — with List Char as a view through String.toList and String.ofList (typed). The view's round
;; trip is Init's String.toList_ofList, cited by name in the record and not loaded here: its
;; closure is 3,282 declarations of the export against the file's 1,400 without it.
(theorem str_buffer ((b ByteArray) (h (ByteArray.IsValidUTF8 b))) (= (String.toByteArray (String.ofByteArray b h)) b) (exact (Eq.refl b)))

;; row 15: (record …) with F_of and with_F is a structure with its projections (name)
(theorem record_projections ((a Nat) (b Int))
  (and (= (Prod.fst (Prod.mk a b)) a) (= (Prod.snd (Prod.mk a b)) b))
  (exact (And.intro (Eq.refl a) (Eq.refl b))))

;; row 16: sym_eq, chars_of_sym and sym_of_chars are String and Char (name); gen_fresh is
;; std/fresh.shard's supply
(theorem char_of_nat () (= (Char.toNat (Char.ofNat 65)) 65) (exact (Eq.refl 65)))

;; ---- the records' evidence (std/README.md): the old modules' claims as theorems ----------
;; std/order's 22 claims (if_le_lt_swap, the branch swap, waits for a consumer): Init's name
;; where it exists, arith where the claim is an entailment
(theorem order_le_refl ((a Int)) (<= a a) (exact (Int.le_refl a)))
(theorem order_lt_irrefl ((a Int)) (not (< a a)) (exact (Int.lt_irrefl a)))
(theorem order_eq_refl ((a Int)) (= a a) (exact (Eq.refl a)))
(theorem order_lt_succ_from_lt ((p Int) (i Int) (h (< p i))) (< p (+ i 1)) (by (arith)))
(theorem order_le_implies_not_lt ((a Int) (b Int) (h (<= a b))) (not (< b a)) (exact (Iff.mpr (@Int.not_lt b a) h)))
(theorem order_not_le_implies_lt ((a Int) (b Int) (h (not (<= a b)))) (< b a) (exact (Iff.mp (@Int.not_le a b) h)))
(theorem order_le_trans ((a Int) (b Int) (c Int) (h1 (<= a b)) (h2 (<= b c))) (<= a c) (exact (Int.le_trans h1 h2)))
(theorem order_lt_implies_ne ((a Int) (b Int) (h (< a b))) (not (= a b)) (exact (Int.ne_of_lt h)))
(theorem order_lt_trans_to_ne ((p Int) (i Int) (j Int) (h1 (< p i)) (h2 (< i j))) (not (= p j)) (by (have h (< p j) (arith)) (exact (Int.ne_of_lt h))))
(theorem order_lt_pred_from_lt ((j Int) (p Int) (h (< j p))) (< (- j 1) p) (by (arith)))
(theorem order_lt_implies_ne_flip ((a Int) (b Int) (h (< a b))) (not (= b a)) (exact (Int.ne_of_gt h)))
(theorem order_lt_trans_to_ne_flip ((i Int) (j Int) (p Int) (h1 (< i j)) (h2 (< j p))) (not (= p i)) (by (have h (< i p) (arith)) (exact (Int.ne_of_gt h))))
(theorem order_le_succ_from_lt ((i Int) (p Int) (h (< i p))) (<= (+ i 1) p) (exact (Int.add_one_le_of_lt h)))
(theorem order_le_pred_from_lt ((p Int) (j Int) (h (< p j))) (<= p (- j 1)) (by (arith)))
(theorem order_lt_self_succ ((x Int)) (< x (+ x 1)) (by (arith)))
(theorem order_le0_succ ((x Int) (h (<= 0 x))) (<= 0 (+ 1 x)) (by (arith)))
(theorem order_le_succ_r ((i Int) (base Int) (h (<= i base))) (<= i (+ base 1)) (by (arith)))
(theorem order_le_succ_l ((i Int) (b Int) (h (<= i b))) (<= i (+ 1 b)) (by (arith)))
(theorem order_lt_from_le_succ ((a Int) (b Int) (h (<= a b))) (< a (+ 1 b)) (by (arith)))
(theorem order_le_succ_shift ((a Int) (j Int) (b Int) (h (<= (+ a (+ 1 j)) b))) (<= (+ (+ a 1) j) b) (by (arith)))
(theorem order_le_succ_shift_r ((a Int) (j Int) (b Int) (h (<= (+ a (+ 1 j)) b))) (<= (+ (+ a 1) j) (+ b 1)) (by (arith)))
;; std/nat's four lemmas: the coercion's sign and steps, the halving bound at Nat
(theorem nat_int_of_nat_nonneg ((n Nat)) (<= 0 (Int.ofNat n)) (exact (Int.natCast_nonneg n)))
(theorem nat_int_of_nat_succ ((k Nat)) (= (Int.ofNat (+ k 1)) (+ (Int.ofNat k) 1)) (exact (Eq.refl (Int.ofNat (+ k 1)))))
(theorem nat_int_of_nat_zero () (= (Int.ofNat 0) 0) (exact (Eq.refl (Int.ofNat 0))))
(theorem nat_half_bound ((m Nat)) (<= m (+ (* 2 (/ m 2)) 1)) (by (arith (Nat.div_add_mod m 2) (Nat.mod_lt m Nat.zero_lt_two))))
;; std/div's seven: the literal divisor 10 by arith's quotient and remainder rows, the
;; symbolic divisor by Init's names
(theorem div_ediv_mod_10_id ((n Int)) (= n (+ (* 10 (/ n 10)) (% n 10))) (by (arith)))
(theorem div_mod_10_lo ((n Int)) (<= 0 (% n 10)) (by (arith)))
(theorem div_mod_10_hi ((n Int)) (<= (% n 10) 9) (by (arith)))
(theorem div_div_lt ((n Int) (h (< 0 n))) (< (/ n 10) n) (by (arith)))
(theorem div_div_nonneg ((n Int) (h (<= 0 n))) (<= 0 (/ n 10)) (by (arith)))
(theorem div_ediv_nonneg ((n Int) (d Int) (h1 (<= 0 n)) (h2 (< 0 d))) (<= 0 (/ n d)) (exact (Int.ediv_nonneg h1 (Int.le_of_lt h2))))
(theorem div_mod_small ((x Int) (d Int) (h1 (<= 0 x)) (h2 (< x d))) (= (% x d) x) (exact (Int.emod_eq_of_lt h1 h2)))
;; std/arith's seven index identities, each arith's
(theorem arith_idx_inner_simp ((i Int) (j Int) (p Int)) (= (- (+ (+ i 1) (- j 1)) p) (- (+ i j) p)) (by (arith)))
(theorem arith_sub_zero ((x Int)) (= (- x 0) x) (by (arith)))
(theorem arith_sub_sub_one ((x Int) (y Int)) (= (- (- x 1) y) (- x (+ 1 y))) (by (arith)))
(theorem arith_reassoc_succ ((b Int) (y Int)) (= (- (+ b (+ 1 y)) 1) (- (+ (+ b 1) y) 1)) (by (arith)))
(theorem arith_idx_cancel ((b Int) (y Int)) (= (- (- (+ (+ b 1) y) 1) y) b) (by (arith)))
(theorem arith_cap_idx ((x Int)) (= (- (+ 0 (- x 1)) 0) (- (+ 0 x) 1)) (by (arith)))
(theorem arith_idx_pred ((s Int) (base Int)) (= (- s (+ base 1)) (- (- s base) 1)) (by (arith)))
