;;; v3/std/host.shard — the host under the naming law (LANGUAGE.md §6.7, §8.4 slice 3.18
;;; rule 4; law §4.7): the World token and the six externs, each value a `ByteArray` or one of
;;; Init's `List`, `Option`, `Prod`, `Bool`. The driver (`kernel/ev.shard`) builds and reads
;;; every value by the type declared here; the toolchain's own signatures are
;;; `kernel/host.shard`'s, over the prelude. An extern has no L meaning: a function that
;;; calls one is a program without a definition (`RUNNABLE … no_l_meaning`) until phase 4's
;;; World.
(import Init Prod)   ; past String, ByteArray, List, Option and Bool

(type World (World Nat))

(extern get_args ((w World)) (Prod (List ByteArray) World))
(extern read_file ((path ByteArray) (w World)) (Prod (Option ByteArray) World))
(extern write ((bytes ByteArray) (w World)) World)
(extern write_line ((bytes ByteArray) (w World)) World)
(extern write_file ((path ByteArray) (bytes ByteArray) (w World)) (Prod Bool World))
(extern exit ((code Int) (w World)) World)
