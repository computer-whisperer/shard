;;; v3/std/host.shard — the host: the World token and the six externs, each value a `ByteArray`
;;; or one of Init's `List`, `Option`, `Prod`, `Bool`. The driver (`kernel/ev.shard`) builds and
;;; reads every value by the type declared here; the toolchain's own signatures are
;;; `kernel/host.shard`'s, over the prelude. In the logic an extern is an opaque constant with
;;; no equations: a function that calls one is defined as usual (docs/LANGUAGE.md "`extern` and
;;; `opaque`").
(import Init Prod)  ; past String, ByteArray, List, Option and Bool

(type World (World Nat))

(extern get_args ((w World)) (Prod (List ByteArray) World))
(extern read_file ((path ByteArray) (w World)) (Prod (Option ByteArray) World))
(extern write ((bytes ByteArray) (w World)) World)
(extern write_line ((bytes ByteArray) (w World)) World)
(extern write_file ((path ByteArray) (bytes ByteArray) (w World)) (Prod Bool World))
(extern exit ((code Int) (w World)) World)
