;;; v3/std/fresh.shard — the fresh-name supply (LANGUAGE.md §8.4, slice 3.17 rule 6;
;;; §12.1's `gen_fresh` row). V3 has no effectful primitive (law §4.7): where the old
;;; tree called `gen_fresh`, a function takes a supply and returns the advanced one with
;;; its result. A name is plain data — the supply's prefix and an index — and forges no
;;; declaration, node or environment identity (§3.3). The prefix's type is the caller's
;;; (`P`): the toolchain's port instantiates it with its own `Name`, text with `String`
;;; once slice 3.18 gives it an L reading.
;;;
;;; The convention: `(fn pass ((s (Fresh P)) …) (Pair RESULT (Fresh P)) …)` — every name
;;; minted through `Fresh.next`, the supply threaded in and out, never copied; two names
;;; of one supply then differ (`Fresh.next_ne`).
(import Init Nat.succ_ne_self)

;; a minted name: its supply's prefix and its index
(record (FreshName P) (prefix P) (index Nat))
;; the supply: the prefix and the next index
(record (Fresh P) (prefix P) (counter Nat))
;; one step: the name and the supply after it
(record (Minted P) (name (FreshName P)) (rest (Fresh P)))

;; a supply at index 0
(fn Fresh.start ((P Type) (prefix P)) (Fresh P) (make Fresh (prefix prefix) (counter 0)))
;; the next name, and the supply advanced past it
(fn Fresh.next ((P Type) (s (Fresh P))) (Minted P)
  (make Minted
    (name (make FreshName (prefix (Fresh.prefix s)) (index (Fresh.counter s))))
    (rest (with Fresh s (counter (+ (Fresh.counter s) 1))))))

;; two successive names of one supply differ: their indices are k and k + 1
(theorem Fresh.next_ne ((P Type) (s (Fresh P)))
  (!= (Minted.name (Fresh.next s)) (Minted.name (Fresh.next (Minted.rest (Fresh.next s)))))
  (exact (fun ((h (= (Minted.name (Fresh.next s)) (Minted.name (Fresh.next (Minted.rest (Fresh.next s)))))))
           (Nat.succ_ne_self (Fresh.counter s) (Eq.symm (congrArg FreshName.index h))))))
