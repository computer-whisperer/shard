;;; v3/std/bytes.shard — bytes and text under the naming law (LANGUAGE.md §8.4, slice 3.18
;;; rule 6; law §4.4). `UInt8`, `ByteArray` and `String` are Init's types, each represented by
;;; its one runtime field (the registry's type rows): a byte runs as an integer below 256, a
;;; byte array as `Init`'s `List` cells, a text as its UTF-8 bytes. An operation here is an S
;;; function over Init's constructors and projections — its program the erasure, the
;;; identity on the representation wherever only the type changes — or Init's own function
;;; by its derived view; where Init states the same operation another way (`UInt8.ofNat`,
;;; through `%` and `^` as instance projections, which no view derives), a theorem ties the
;;; two.
;;;
;;; Not here: text from bytes. `String.fromUTF8?` needs a validator and its proof against
;;; `ByteArray.IsValidUTF8` (I's work); until then a program's text is its literals and its
;;; input stays bytes.
(import Init UInt8.toNat)   ; line 263,515 of the export: UInt8's and ByteArray's projections are generated late

;; ---- a byte and its number -----------------------------------------------------------------
;; Init's own functions, by their derived views: the identity on the representation
(realize BitVec.toNat (view))
(realize UInt8.toNat (view))
;; n mod 256 as a byte
(fn Byte.ofNat ((n Nat)) UInt8
  (UInt8.ofBitVec (BitVec.ofFin (Fin.mk (Nat.mod n 256) (Nat.mod_lt n (Nat.zero_lt_succ 255))))))
;; it is Init's UInt8.ofNat
(theorem Byte.ofNat_eq ((n Nat)) (= (Byte.ofNat n) (UInt8.ofNat n)) (exact (Eq.refl (UInt8.ofNat n))))
(theorem Byte.toNat_ofNat ((n Nat)) (= (UInt8.toNat (Byte.ofNat n)) (Nat.mod n 256)) (exact (Eq.refl (Nat.mod n 256))))

;; ---- a byte array and its list ---------------------------------------------------------------
(fn Bytes.ofList ((l (List UInt8))) ByteArray (ByteArray.mk (Array.mk l)))
(fn Bytes.toList ((b ByteArray)) (List UInt8) (Array.toList (ByteArray.data b)))
(theorem Bytes.toList_ofList ((l (List UInt8))) (= (Bytes.toList (Bytes.ofList l)) l) (exact (Eq.refl l)))
(theorem Bytes.ofList_toList ((b ByteArray)) (= (Bytes.ofList (Bytes.toList b)) b) (exact (Eq.refl b)))   ; K's structure eta

;; a byte array from numbers (each mod 256) and back
(fn Bytes.listOfNats ((ns (List Nat))) (List UInt8) (measure (struct ns))
  (match ns
    (List.nil List.nil)
    ((List.cons n t) (List.cons (Byte.ofNat n) (Bytes.listOfNats t)))))
(fn Bytes.listToNats ((bs (List UInt8))) (List Nat) (measure (struct bs))
  (match bs
    (List.nil List.nil)
    ((List.cons b t) (List.cons (UInt8.toNat b) (Bytes.listToNats t)))))
(fn Bytes.ofNats ((ns (List Nat))) ByteArray (Bytes.ofList (Bytes.listOfNats ns)))
(fn Bytes.toNats ((b ByteArray)) (List Nat) (Bytes.listToNats (Bytes.toList b)))

;; ---- text ------------------------------------------------------------------------------------
;; a text's UTF-8 bytes: the projection (Init's String.toUTF8 lies at line 2,617,381)
(fn Bytes.ofString ((s String)) ByteArray (String.toByteArray s))
