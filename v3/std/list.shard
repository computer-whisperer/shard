;;; v3/std/list.shard — the first file of V3's standard library under the naming
;;; law (FOUNDATION §5.3; LANGUAGE.md §8.4, slice 3.13): Lean's names by
;;; default, an operation as a `fn` with the L definition and equations Stage 1
;;; gives it, a theorem stated about it. `List.append`, `List.length` and the
;;; rest are Init's, realized rather than redeclared (§4.4); what Init lacks is
;;; declared here in the `List` namespace.
(import Init Int.decEq)
(use Init.List)

;; the sum of a list of integers
(fn List.sum ((xs (List Int))) Int (measure (struct xs))
  (match xs
    (List.nil 0)
    ((List.cons x t) (+ x (List.sum t)))))
(theorem List.sum_nil () (= (List.sum List.nil) 0) (exact List.sum.eq_1))   ; the numeral rule in L (slice 3.15): 0 at Int is Int.ofNat 0
(theorem List.sum_cons ((x Int) (t (List Int)))
  (= (List.sum (List.cons x t)) (+ x (List.sum t)))
  (exact (List.sum.eq_2 x t)))
