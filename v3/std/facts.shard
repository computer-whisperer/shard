;;; v3/std/facts.shard — the fifteen former axioms of the old tree's kernel/facts.shard
;;; as theorems (LANGUAGE.md §8.4 slice 3.27 rule 9; law §10.1's statements layer): the
;;; old statement on the new spelling, its proof the citation of Init's theorem. The
;;; twelve here cite Init by name; the three bitwise recurrences (band_rec, bor_rec,
;;; bxor_rec — the low bit arithmetically) land with std/bits at landing 3. The shift
;;; laws are at Nat, their former `0 ≤` premises the type now (law §10.2's typed class);
;;; the rest keep the old binders and premises. The horizon is the highest ordinal cited.
(import Init Nat.shiftRight_zero)

;; the remainder's range at a positive divisor (mod_lo, mod_hi)
(theorem mod_lo ((n Int) (d Int) (h (< 0 d))) (<= 0 (% n d)) (exact (Int.emod_nonneg n (Int.ne_of_gt h))))
(theorem mod_hi ((n Int) (d Int) (h (< 0 d))) (< (% n d) d) (exact (Int.emod_lt_of_pos n h)))

;; the Euclidean identity (ediv_mod_id): Int.emod_def, rearranged by arith
(theorem ediv_mod_id ((n Int) (d Int) (h (< 0 d))) (= n (+ (* d (/ n d)) (% n d)))
  (by (arith (Int.emod_def n d))))

;; the quotient and the remainder are unique (div_unique, mod_unique): the two halves of
;; Int.ediv_emod_unique, the divisor positive by the remainder's range
(theorem div_unique ((n Int) (d Int) (q Int) (r Int) (h1 (= n (+ (* d q) r))) (h2 (<= 0 r)) (h3 (< r d)))
  (= (/ n d) q)
  (by (have hd (< 0 d) (arith))
      (have e (= (+ r (* d q)) n) (arith))
      (exact (And.left (Iff.mpr (@Int.ediv_emod_unique n d r q hd) (And.intro e (And.intro h2 h3)))))))
(theorem mod_unique ((n Int) (d Int) (q Int) (r Int) (h1 (= n (+ (* d q) r))) (h2 (<= 0 r)) (h3 (< r d)))
  (= (% n d) r)
  (by (have hd (< 0 d) (arith))
      (have e (= (+ r (* d q)) n) (arith))
      (exact (And.right (Iff.mpr (@Int.ediv_emod_unique n d r q hd) (And.intro e (And.intro h2 h3)))))))

;; the ring laws of multiplication (mul_comm, mul_assoc, mul_dist)
(theorem mul_comm ((a Int) (b Int)) (= (* a b) (* b a)) (exact (Int.mul_comm a b)))
(theorem mul_assoc ((a Int) (b Int) (c Int)) (= (* (* a b) c) (* a (* b c))) (exact (Int.mul_assoc a b c)))
(theorem mul_dist ((a Int) (b Int) (c Int)) (= (* a (+ b c)) (+ (* a b) (* a c))) (exact (Int.mul_add a b c)))

;; the shift laws at Nat (bshl_z, bshl_s, bshr_z, bshr_s)
(theorem bshl_z ((a Nat)) (= (Nat.shiftLeft a 0) a) (exact (@Nat.shiftLeft_zero a)))
(theorem bshl_s ((a Nat) (k Nat)) (= (Nat.shiftLeft a (+ k 1)) (* 2 (Nat.shiftLeft a k))) (exact (Nat.shiftLeft_succ a k)))
(theorem bshr_z ((a Nat)) (= (Nat.shiftRight a 0) a) (exact (@Nat.shiftRight_zero a)))
(theorem bshr_s ((a Nat) (k Nat)) (= (Nat.shiftRight a (+ k 1)) (Nat.shiftRight (/ a 2) k)) (exact (Nat.shiftRight_succ_inside a k)))
