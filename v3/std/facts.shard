;;; v3/std/facts.shard — the fifteen former axioms of the old tree's kernel/facts.shard
;;; as theorems (LANGUAGE.md §8.4 slice 3.27 rule 9; law §10.1's statements layer): the
;;; old statement on the new spelling, its proof the citation of Init's theorem. Twelve
;;; cite Init by name (landing 2); the three bitwise recurrences (band_rec, bor_rec,
;;; bxor_rec — landing 3) are the Euclidean split of the operation into its quotient by 2
;;; (Init's and_div_two, or_div_two, xor_div_two) and its low bit (Init's and_mod_two_eq_one,
;;; or_mod_two_eq_one, xor_mod_two_eq_one decided by the operands' low bits), joined by
;;; arith over Nat.div_add_mod. At Nat the old `p + q - p*q` and `p + q - 2*p*q` are stated
;;; subtraction-free — the product moved to the left — since arith reads Nat.sub as an atom.
;;; The shift laws are at Nat, their former `0 ≤` premises the type now (law §10.2's typed
;;; class); the rest keep the old binders and premises. The horizon is the highest ordinal cited.
(import Init Nat.and_mod_two_eq_one)

;; the remainder's range at a positive divisor (mod_lo, mod_hi)
(theorem mod_lo ((n Int) (d Int) (h (< 0 d))) (<= 0 (% n d)) (exact (Int.emod_nonneg n (Int.ne_of_gt h))))
(theorem mod_hi ((n Int) (d Int) (h (< 0 d))) (< (% n d) d) (exact (Int.emod_lt_of_pos n h)))

;; the Euclidean identity (ediv_mod_id): Int.emod_def, rearranged by arith
(theorem ediv_mod_id ((n Int) (d Int) (h (< 0 d))) (= n (+ (* d (/ n d)) (% n d)))
  (by (arith (Int.emod_def n d))))

;; the quotient and the remainder are unique (div_unique, mod_unique): the two halves of
;; Int.ediv_emod_unique, the divisor positive by the remainder's range
(theorem div_unique ((n Int) (d Int) (q Int) (r Int) (h1 (= n (+ (* d q) r))) (h2 (<= 0 r)) (h3 (< r d)))
  (= (/ n d) q)
  (by (have hd (< 0 d) (arith))
      (have e (= (+ r (* d q)) n) (arith))
      (exact (And.left (Iff.mpr (@Int.ediv_emod_unique n d r q hd) (And.intro e (And.intro h2 h3)))))))
(theorem mod_unique ((n Int) (d Int) (q Int) (r Int) (h1 (= n (+ (* d q) r))) (h2 (<= 0 r)) (h3 (< r d)))
  (= (% n d) r)
  (by (have hd (< 0 d) (arith))
      (have e (= (+ r (* d q)) n) (arith))
      (exact (And.right (Iff.mpr (@Int.ediv_emod_unique n d r q hd) (And.intro e (And.intro h2 h3)))))))

;; the ring laws of multiplication (mul_comm, mul_assoc, mul_dist)
(theorem mul_comm ((a Int) (b Int)) (= (* a b) (* b a)) (exact (Int.mul_comm a b)))
(theorem mul_assoc ((a Int) (b Int) (c Int)) (= (* (* a b) c) (* a (* b c))) (exact (Int.mul_assoc a b c)))
(theorem mul_dist ((a Int) (b Int) (c Int)) (= (* a (+ b c)) (+ (* a b) (* a c))) (exact (Int.mul_add a b c)))

;; the shift laws at Nat (bshl_z, bshl_s, bshr_z, bshr_s)
(theorem bshl_z ((a Nat)) (= (Nat.shiftLeft a 0) a) (exact (@Nat.shiftLeft_zero a)))
(theorem bshl_s ((a Nat) (k Nat)) (= (Nat.shiftLeft a (+ k 1)) (* 2 (Nat.shiftLeft a k))) (exact (Nat.shiftLeft_succ a k)))
(theorem bshr_z ((a Nat)) (= (Nat.shiftRight a 0) a) (exact (@Nat.shiftRight_zero a)))
(theorem bshr_s ((a Nat) (k Nat)) (= (Nat.shiftRight a (+ k 1)) (Nat.shiftRight (/ a 2) k)) (exact (Nat.shiftRight_succ_inside a k)))

;; the bitwise recurrences (band_rec, bor_rec, bxor_rec): the low bit of the operation from the
;; operands' low bits — four cases of a % 2 and b % 2, the operation's low bit decided by Init's
;; iff in each — then the Euclidean split by arith
(theorem land_low ((a Nat) (b Nat)) (= (% (Nat.land a b) 2) (* (% a 2) (% b 2)))
  (by (cases (Nat.mod_two_eq_zero_or_one a)
        ((inl (ha) (rw ha)
           (cases (Nat.mod_two_eq_zero_or_one (Nat.land a b))
             ((inl (hr) (arith))
              (inr (hr) (have h1 (= (% a 2) 1) (exact (And.left (Iff.mp (@Nat.and_mod_two_eq_one a b) hr)))) (arith)))))
         (inr (ha)
           (cases (Nat.mod_two_eq_zero_or_one b)
             ((inl (hb) (rw hb)
                (cases (Nat.mod_two_eq_zero_or_one (Nat.land a b))
                  ((inl (hr) (arith))
                   (inr (hr) (have h1 (= (% b 2) 1) (exact (And.right (Iff.mp (@Nat.and_mod_two_eq_one a b) hr)))) (arith)))))
              (inr (hb) (rw ha) (rw hb)
                (have hr (= (% (Nat.land a b) 2) 1) (exact (Iff.mpr (@Nat.and_mod_two_eq_one a b) (And.intro ha hb))))
                (arith)))))))))
(theorem lor_low ((a Nat) (b Nat)) (= (+ (% (Nat.lor a b) 2) (* (% a 2) (% b 2))) (+ (% a 2) (% b 2)))
  (by (cases (Nat.mod_two_eq_zero_or_one a)
        ((inl (ha)
           (cases (Nat.mod_two_eq_zero_or_one b)
             ((inl (hb) (rw ha) (rw hb)
                (cases (Nat.mod_two_eq_zero_or_one (Nat.lor a b))
                  ((inl (hr) (arith))
                   (inr (hr) (cases (Iff.mp (@Nat.or_mod_two_eq_one a b) hr) ((inl (h1) (arith)) (inr (h1) (arith))))))))
              (inr (hb) (rw ha) (rw hb)
                (have hr (= (% (Nat.lor a b) 2) 1) (exact (Iff.mpr (@Nat.or_mod_two_eq_one a b) (Or.inr hb))))
                (arith)))))
         (inr (ha)
           (have hr (= (% (Nat.lor a b) 2) 1) (exact (Iff.mpr (@Nat.or_mod_two_eq_one a b) (Or.inl ha))))
           (cases (Nat.mod_two_eq_zero_or_one b)
             ((inl (hb) (rw ha) (rw hb) (arith))
              (inr (hb) (rw ha) (rw hb) (arith)))))))))
(theorem lxor_low ((a Nat) (b Nat)) (= (+ (% (Nat.xor a b) 2) (* 2 (* (% a 2) (% b 2)))) (+ (% a 2) (% b 2)))
  (by (cases (Nat.mod_two_eq_zero_or_one a)
        ((inl (ha)
           (cases (Nat.mod_two_eq_zero_or_one b)
             ((inl (hb)
                (cases (Nat.mod_two_eq_zero_or_one (Nat.xor a b))
                  ((inl (hr) (rw ha) (rw hb) (arith))
                   (inr (hr)
                     (have hi (iff (= (% a 2) 1) (= (% b 2) 1)) (rw ha) (rw hb) (exact (Iff.refl (= 0 1))))
                     (exact (absurd hi (Iff.mp (@Nat.xor_mod_two_eq_one a b) hr)))))))
              (inr (hb)
                (have hn (not (iff (= (% a 2) 1) (= (% b 2) 1))) (intro hi) (have h1 (= (% a 2) 1) (exact (Iff.mpr hi hb))) (arith))
                (have hr (= (% (Nat.xor a b) 2) 1) (exact (Iff.mpr (@Nat.xor_mod_two_eq_one a b) hn)))
                (rw ha) (rw hb) (arith)))))
         (inr (ha)
           (cases (Nat.mod_two_eq_zero_or_one b)
             ((inl (hb)
                (have hn (not (iff (= (% a 2) 1) (= (% b 2) 1))) (intro hi) (have h1 (= (% b 2) 1) (exact (Iff.mp hi ha))) (arith))
                (have hr (= (% (Nat.xor a b) 2) 1) (exact (Iff.mpr (@Nat.xor_mod_two_eq_one a b) hn)))
                (rw ha) (rw hb) (arith))
              (inr (hb)
                (cases (Nat.mod_two_eq_zero_or_one (Nat.xor a b))
                  ((inl (hr) (rw ha) (rw hb) (arith))
                   (inr (hr)
                     (have hi (iff (= (% a 2) 1) (= (% b 2) 1)) (rw ha) (rw hb) (exact (Iff.refl (= 1 1))))
                     (exact (absurd hi (Iff.mp (@Nat.xor_mod_two_eq_one a b) hr))))))))))))))
(theorem band_rec ((a Nat) (b Nat)) (= (Nat.land a b) (+ (* 2 (Nat.land (/ a 2) (/ b 2))) (* (% a 2) (% b 2))))
  (by (have hd (= (/ (Nat.land a b) 2) (Nat.land (/ a 2) (/ b 2))) (exact (@Nat.and_div_two a b)))
      (have hm (= (% (Nat.land a b) 2) (* (% a 2) (% b 2))) (exact (land_low a b)))
      (arith (Nat.div_add_mod (Nat.land a b) 2))))
(theorem bor_rec ((a Nat) (b Nat)) (= (+ (Nat.lor a b) (* (% a 2) (% b 2))) (+ (* 2 (Nat.lor (/ a 2) (/ b 2))) (+ (% a 2) (% b 2))))
  (by (have hd (= (/ (Nat.lor a b) 2) (Nat.lor (/ a 2) (/ b 2))) (exact (@Nat.or_div_two a b)))
      (have hm (= (+ (% (Nat.lor a b) 2) (* (% a 2) (% b 2))) (+ (% a 2) (% b 2))) (exact (lor_low a b)))
      (arith (Nat.div_add_mod (Nat.lor a b) 2))))
(theorem bxor_rec ((a Nat) (b Nat)) (= (+ (Nat.xor a b) (* 2 (* (% a 2) (% b 2)))) (+ (* 2 (Nat.xor (/ a 2) (/ b 2))) (+ (% a 2) (% b 2))))
  (by (have hd (= (/ (Nat.xor a b) 2) (Nat.xor (/ a 2) (/ b 2))) (exact (@Nat.xor_div_two a b)))
      (have hm (= (+ (% (Nat.xor a b) 2) (* 2 (* (% a 2) (% b 2)))) (+ (% a 2) (% b 2))) (exact (lxor_low a b)))
      (arith (Nat.div_add_mod (Nat.xor a b) 2))))
