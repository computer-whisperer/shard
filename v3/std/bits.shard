;;; v3/std/bits.shard — the bitwise library at Nat (LANGUAGE.md §8.4 slice 3.27 rule 8; the
;;; record in std/README.md): what the old std/bits required, each a theorem citing Init's name
;;; — the former `0 ≤` premises are the type, `pow2 k` is `(Nat.pow 2 k)` (one spelling with
;;; Init's `2 ^ k`, slice 3.27 landing 3) — and the width material Init lacks: the instances at
;;; 8, 32 and 64 bits, each one application of the general theorem to a literal, the power a
;;; literal by Eq.refl. The three recurrences are std/facts.shard's. The horizon is the highest
;;; ordinal cited.
(import Init Nat.le_sub_one_iff_lt)

;; powers of two (pow2_z, pow2_s, pow2_pos, pow2_32, pow2_64)
(theorem pow2_z () (= (Nat.pow 2 0) 1) (exact (Eq.refl 1)))
(theorem pow2_s ((k Nat)) (= (Nat.pow 2 (+ k 1)) (* (Nat.pow 2 k) 2)) (exact (Nat.pow_succ 2 k)))
(theorem pow2_pos ((k Nat)) (< 0 (Nat.pow 2 k)) (exact (Nat.two_pow_pos k)))
(theorem pow2_8 () (= (Nat.pow 2 8) 256) (exact (Eq.refl 256)))
(theorem pow2_32 () (= (Nat.pow 2 32) 4294967296) (exact (Eq.refl 4294967296)))
(theorem pow2_64 () (= (Nat.pow 2 64) 18446744073709551616) (exact (Eq.refl 18446744073709551616)))

;; the zero laws and self-cancellation (band_zero_l, bor_zero_l, bxor_zero_l, bxor_self, bxor_cancel_right, band_zero_r)
(theorem band_zero_l ((b Nat)) (= (Nat.land 0 b) 0) (exact (Nat.zero_and b)))
(theorem bor_zero_l ((b Nat)) (= (Nat.lor 0 b) b) (exact (Nat.zero_or b)))
(theorem bxor_zero_l ((b Nat)) (= (Nat.xor 0 b) b) (exact (Nat.zero_xor b)))
(theorem bxor_self ((a Nat)) (= (Nat.xor a a) 0) (exact (Nat.xor_self a)))
(theorem bxor_cancel_right ((a Nat) (b Nat)) (= (Nat.xor (Nat.xor a b) b) a)
  (by (rw (Nat.xor_assoc a b b)) (rw (Nat.xor_self b)) (rw (Nat.xor_zero a)) rfl))
(theorem band_zero_r ((a Nat)) (= (Nat.land a 0) 0) (exact (Nat.and_zero a)))

;; the lower bounds are the type (band_lo, bor_lo, bxor_lo, shl_nonneg, shr_nonneg)
(theorem band_lo ((a Nat) (b Nat)) (<= 0 (Nat.land a b)) (exact (Nat.zero_le (Nat.land a b))))
(theorem bor_lo ((a Nat) (b Nat)) (<= 0 (Nat.lor a b)) (exact (Nat.zero_le (Nat.lor a b))))
(theorem bxor_lo ((a Nat) (b Nat)) (<= 0 (Nat.xor a b)) (exact (Nat.zero_le (Nat.xor a b))))
(theorem shl_nonneg ((a Nat) (k Nat)) (<= 0 (Nat.shiftLeft a k)) (exact (Nat.zero_le (Nat.shiftLeft a k))))
(theorem shr_nonneg ((a Nat) (k Nat)) (<= 0 (Nat.shiftRight a k)) (exact (Nat.zero_le (Nat.shiftRight a k))))

;; and is bounded by its operands (band_le_l, band_le_r)
(theorem band_le_l ((a Nat) (b Nat)) (<= (Nat.land a b) a) (exact (@Nat.and_le_left a b)))
(theorem band_le_r ((a Nat) (b Nat)) (<= (Nat.land a b) b) (exact (@Nat.and_le_right a b)))

;; or and xor stay below a power of two (bor_le_pow2, bxor_le_pow2), the old `≤ 2^k - 1` through
;; Nat.le_sub_one_iff_lt; the width instances (bor_le32, bxor_le32, bxor_lt32, bxor_lt64) at the
;; literal, the power's exponent given since a literal does not determine it
(theorem bor_le_pow2 ((a Nat) (b Nat) (k Nat) (ha (<= a (- (Nat.pow 2 k) 1))) (hb (<= b (- (Nat.pow 2 k) 1)))) (<= (Nat.lor a b) (- (Nat.pow 2 k) 1))
  (exact (Iff.mpr (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k))
           (Nat.or_lt_two_pow (Iff.mp (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k)) ha) (Iff.mp (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k)) hb)))))
(theorem bxor_le_pow2 ((a Nat) (b Nat) (k Nat) (ha (<= a (- (Nat.pow 2 k) 1))) (hb (<= b (- (Nat.pow 2 k) 1)))) (<= (Nat.xor a b) (- (Nat.pow 2 k) 1))
  (exact (Iff.mpr (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k))
           (Nat.xor_lt_two_pow (Iff.mp (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k)) ha) (Iff.mp (Nat.le_sub_one_iff_lt (Nat.two_pow_pos k)) hb)))))
(theorem bor_le32 ((a Nat) (b Nat) (ha (<= a 4294967295)) (hb (<= b 4294967295))) (<= (Nat.lor a b) 4294967295)
  (by (have ha1 (< a 4294967296) (arith)) (have ha2 (< a (Nat.pow 2 32)) (exact ha1))
      (have hb1 (< b 4294967296) (arith)) (have hb2 (< b (Nat.pow 2 32)) (exact hb1))
      (have h (< (Nat.lor a b) (Nat.pow 2 32)) (exact (Nat.or_lt_two_pow ha2 hb2)))
      (have h2 (< (Nat.lor a b) 4294967296) (exact h)) (arith)))
(theorem bxor_le32 ((a Nat) (b Nat) (ha (<= a 4294967295)) (hb (<= b 4294967295))) (<= (Nat.xor a b) 4294967295)
  (by (have ha1 (< a 4294967296) (arith)) (have ha2 (< a (Nat.pow 2 32)) (exact ha1))
      (have hb1 (< b 4294967296) (arith)) (have hb2 (< b (Nat.pow 2 32)) (exact hb1))
      (have h (< (Nat.xor a b) (Nat.pow 2 32)) (exact (Nat.xor_lt_two_pow ha2 hb2)))
      (have h2 (< (Nat.xor a b) 4294967296) (exact h)) (arith)))
(theorem bxor_lt32 ((a Nat) (b Nat) (ha (< a 4294967296)) (hb (< b 4294967296))) (< (Nat.xor a b) 4294967296)
  (by (have ha2 (< a (Nat.pow 2 32)) (exact ha)) (have hb2 (< b (Nat.pow 2 32)) (exact hb))
      (have h (< (Nat.xor a b) (Nat.pow 2 32)) (exact (Nat.xor_lt_two_pow ha2 hb2))) (exact h)))
(theorem bxor_lt64 ((a Nat) (b Nat) (ha (< a 18446744073709551616)) (hb (< b 18446744073709551616))) (< (Nat.xor a b) 18446744073709551616)
  (by (have ha2 (< a (Nat.pow 2 64)) (exact ha)) (have hb2 (< b (Nat.pow 2 64)) (exact hb))
      (have h (< (Nat.xor a b) (Nat.pow 2 64)) (exact (Nat.xor_lt_two_pow ha2 hb2))) (exact h)))

;; the shifts (shl1_mul, shl5_mul, shl8_mul, shl13_mul, shr1_div, shr8_div, shr17_div, shl_pow2, shr_pow2):
;; by one step Nat.shiftLeft and Nat.shiftRight compute; by a literal count through Init's
;; shiftLeft_eq and shiftRight_eq_div_pow, the power a literal
(theorem shl1_mul ((a Nat)) (= (Nat.shiftLeft a 1) (* 2 a)) (exact (Eq.refl (* 2 a))))
(theorem shl_pow2 ((a Nat) (k Nat)) (= (Nat.shiftLeft a k) (* a (Nat.pow 2 k))) (exact (Nat.shiftLeft_eq a k)))
(theorem shl5_mul ((a Nat)) (= (Nat.shiftLeft a 5) (* 32 a))
  (by (rw (shl_pow2 a 5)) (have h (= (Nat.pow 2 5) 32) (exact (Eq.refl 32))) (rw h) (arith)))
(theorem shl8_mul ((a Nat)) (= (Nat.shiftLeft a 8) (* 256 a))
  (by (rw (shl_pow2 a 8)) (rw pow2_8) (arith)))
(theorem shl13_mul ((a Nat)) (= (Nat.shiftLeft a 13) (* 8192 a))
  (by (rw (shl_pow2 a 13)) (have h (= (Nat.pow 2 13) 8192) (exact (Eq.refl 8192))) (rw h) (arith)))
(theorem shr1_div ((a Nat)) (= (Nat.shiftRight a 1) (/ a 2)) (exact (Eq.refl (/ a 2))))
(theorem shr_pow2 ((a Nat) (k Nat)) (= (Nat.shiftRight a k) (/ a (Nat.pow 2 k))) (exact (Nat.shiftRight_eq_div_pow a k)))
(theorem shr8_div ((a Nat)) (= (Nat.shiftRight a 8) (/ a 256)) (exact (Nat.shiftRight_eq_div_pow a 8)))
(theorem shr17_div ((a Nat)) (= (Nat.shiftRight a 17) (/ a 131072)) (exact (Nat.shiftRight_eq_div_pow a 17)))

;; masks (mask_pow2, mask_byte, mask_word32, mask_word64): and with 2^k - 1 is the remainder by 2^k
(theorem mask_pow2 ((a Nat) (k Nat)) (= (Nat.land a (- (Nat.pow 2 k) 1)) (% a (Nat.pow 2 k))) (exact (Nat.and_two_pow_sub_one_eq_mod a k)))
(theorem mask_byte ((a Nat)) (= (Nat.land a 255) (% a 256)) (exact (Nat.and_two_pow_sub_one_eq_mod a 8)))
(theorem mask_word32 ((a Nat)) (= (Nat.land a 4294967295) (% a 4294967296)) (exact (Nat.and_two_pow_sub_one_eq_mod a 32)))
(theorem mask_word64 ((a Nat)) (= (Nat.land a 18446744073709551615) (% a 18446744073709551616)) (exact (Nat.and_two_pow_sub_one_eq_mod a 64)))
