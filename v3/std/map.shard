;;; v3/std/map.shard — the old `std/map`'s finite map under the naming law (LANGUAGE.md §8.6
;;; slice 4.2 landing 0; the record in std/README.md): an association list over `Nat` keys —
;;; prepend on insert, first match on lookup, so a shadowed entry may remain and the map's
;;; facts are stated extensionally, under `map_lookup` at a probe key, never on the
;;; representation. Init has no finite map below the horizon; the three operations and the
;;; old interface's four requirements are this file's. Keys were `Int` in the old module and
;;; are `Nat` here (law §10.2's typed class: an address is a size). The names carry the
;;; module's prefix (`map_lookup`, not `lookup`) so that `std/list`'s `insert` and this
;;; file's never share a short name in one load.
(import Init if_neg)

(type (Map V) (MEmpty) (MCons Nat V (Map V)))

(fn map_empty ((V Type)) (Map V) MEmpty)

;; the first entry whose key is k, else none
(fn map_lookup ((V Type) (k Nat) (m (Map V))) (Option V)
  (measure (struct m))
  (match m
    (MEmpty Option.none)
    ((MCons k2 v rest) (if (= k k2) (Option.some v) (map_lookup k rest)))))

;; a fresh binding in front: it shadows any earlier binding of k
(fn map_insert ((V Type) (k Nat) (v V) (m (Map V))) (Map V) (MCons k v m))

;; ---- the old interface's requirements, as theorems ------------------------------------------
(theorem map_lookup_empty ((V Type) (k Nat)) (= (map_lookup k (@map_empty V)) (@Option.none V))
  (by (unfold map_empty) (unfold map_lookup) rfl))
(theorem map_lookup_insert_eq ((V Type) (k Nat) (v V) (m (Map V)))
  (= (map_lookup k (map_insert k v m)) (Option.some v))
  (by (unfold map_insert) (unfold map_lookup) (rw (if_pos (Eq.refl k))) rfl))
(theorem map_lookup_insert_neq ((V Type) (j Nat) (k Nat) (v V) (m (Map V)) (h (Not (= j k))))
  (= (map_lookup j (map_insert k v m)) (map_lookup j m))
  (by (unfold map_insert) (unfold map_lookup) (rw (if_neg h)) rfl))
(theorem map_insert_shadow ((V Type) (j Nat) (k Nat) (v1 V) (v2 V) (m (Map V)))
  (= (map_lookup j (map_insert k v2 (map_insert k v1 m))) (map_lookup j (map_insert k v2 m)))
  (by (unfold map_insert) (unfold map_lookup)
      (cases (Nat.decEq j k)
        ((isFalse (h) (rw (if_neg h)) (rw (if_neg h)) (unfold map_lookup) (rw (if_neg h)) rfl)
         (isTrue (h) (rw (if_pos h)) (rw (if_pos h)) rfl)))))
