;;; v3/search/test/tasks/holes.shard — unknown CODE written in place: a function's body with
;;; `(hole NAME)` where a part is left out. Nothing is declared for a hole: the load gives each
;;; its type and the names in scope where it stands (a `HOLE` record), and `find` fills those
;;; the goal reaches — in those names, and with what the owner's own matches say of them.

(use Init.Bool false true)
(use Init.List cons nil)

(fn same ((a (List Nat)) (b (List Nat))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x r)
     (match b
       ((cons y s) (if (= x y) (same r s) false))
       (nil false)))))

;; reverse with an accumulator: what to answer at the end, and what to do with an element
(fn rev_acc ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (match xs
    (nil (hole at_nil))
    ((cons x r) (hole at_cons))))
(fn rev_goal () Bool
  (if (same (rev_acc (list 1 2 3) nil) (list 3 2 1))
    (same (rev_acc (list 4 5) (list 6)) (list 5 4 6))
    false))

;; append: the same shape, one row left out
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (match xs
    (nil ys)
    ((cons x r) (hole at_cons))))
(fn app_goal () Bool
  (if (same (app (list 1 2) (list 3)) (list 1 2 3)) (same (app nil (list 7)) (list 7)) false))

;; a constant left out
(fn shift_goal () Bool (let ((k Nat (hole shift))) (if (= (+ k 2) 5) true false)))

;; A WHOLE BODY LEFT OUT, and a property in the place of examples: what undoes `mirror`
(type Tree (Leaf) (Fork Tree Nat Tree))
(fn tree_eq ((a Tree) (b Tree)) Bool
  (measure (struct a))
  (match a
    (Leaf
      (match b
        (Leaf true)
        (_ false)))
    ((Fork l v r)
     (match b
       ((Fork l2 v2 r2) (if (= v v2) (if (tree_eq l l2) (tree_eq r r2) false) false))
       (Leaf false)))))
(fn mirror ((t Tree)) Tree
  (measure (struct t))
  (match t
    (Leaf Leaf)
    ((Fork l v r) (Fork (mirror r) v (mirror l)))))
(fn unmirror ((t Tree)) Tree (hole))
(fn unmirror_spec ((t Tree)) Bool (tree_eq (unmirror (mirror t)) t))

;; THE CASE ANALYSIS WRITTEN, THE ANSWERS LEFT OUT: insertion into a sorted list, from what it
;; must keep — sorted stays sorted, the new element is there once more, every other as often
;; as before
(fn leq ((a Nat) (b Nat)) Bool (if (<= a b) true false))
(fn sorted ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r)
     (match r
       (nil true)
       ((cons y _) (if (<= x y) (sorted r) false))))))
(fn count ((k Nat) (xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons x r) (if (= x k) (+ 1 (count k r)) (count k r)))))
(fn insert ((x Nat) (ys (List Nat))) (List Nat)
  (match ys
    (nil (hole empty))
    ((cons y r) (if (leq x y) (hole before) (hole after)))))
(fn insert_spec ((x Nat) (y Nat) (xs (List Nat))) Bool
  (if (sorted xs)
    (if (sorted (insert x xs))
      (if (= (count x (insert x xs)) (+ (count x xs) 1))
        (if (= x y) true
        (if (= (count y (insert x xs)) (count y xs)) true
        false))
        false)
      false)
    true))
