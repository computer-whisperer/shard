;;; v3/search/test/tasks/sketch.shard — unknown CODE: a function written as its skeleton, the
;;; parts left out declared as `extern`s over what they may read. The goal runs the sketch on
;;; examples.

(use Init.Bool false true)
(use Init.List cons nil)

(fn list_eq ((a (List Nat)) (b (List Nat))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x r)
     (match b
       ((cons y s) (if (= x y) (list_eq r s) false))
       (nil false)))))

;; reverse with an accumulator: what to answer at the end, and what to do with an element
(extern at_nil ((acc (List Nat))) (List Nat))
(extern at_cons ((x Nat) (r (List Nat)) (acc (List Nat))) (List Nat))
(fn rev_acc ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (match xs
    (nil (at_nil acc))
    ((cons x r) (at_cons x r acc))))
(fn rev_goal () Bool
  (if (list_eq (rev_acc (list 1 2 3) nil) (list 3 2 1))
    (list_eq (rev_acc (list 4 5) (list 6)) (list 5 4 6))
    false))

;; append: the same shape, one hole function
(extern app_cons ((x Nat) (r (List Nat)) (ys (List Nat))) (List Nat))
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (match xs
    (nil ys)
    ((cons x r) (app_cons x r ys))))
(fn app_goal () Bool
  (if (list_eq (app (list 1 2) (list 3)) (list 1 2 3)) (list_eq (app nil (list 7)) (list 7)) false))

;; a constant left out
(extern shift () Nat)
(fn shift_goal () Bool (if (= (+ (shift) 2) 5) true false))
