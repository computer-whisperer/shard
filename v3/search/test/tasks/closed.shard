;;; v3/search/test/tasks/closed.shard — nothing unknown: functions with no parameter, each run by
;;; the narrowing machine and by `ev` (`find --closed`), which must end alike.

(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)

(fn sum ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons x r) (+ x (sum r)))))
(fn snoc ((xs (List Nat)) (x Nat)) (List Nat)
  (measure (struct xs))
  (match xs
    (nil (cons x nil))
    ((cons y r) (cons y (snoc r x)))))
(fn rev ((xs (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (snoc (rev r) x))))
(type Tree (Leaf) (Fork Tree Nat Tree))
(fn insert ((t Tree) (k Nat)) Tree
  (measure (struct t))
  (match t
    (Leaf (Fork Leaf k Leaf))
    ((Fork l v r) (if (< k v) (Fork (insert l k) v r) (Fork l v (insert r k))))))
(fn flat ((t Tree) (acc (List Nat))) (List Nat)
  (measure (struct t))
  (match t
    (Leaf acc)
    ((Fork l v r) (flat l (cons v (flat r acc))))))
;; a function that never ends: a program without a definition
(fn spin ((n Nat)) Nat (spin (+ n 1)))
(extern outside ((n Nat)) Nat)

(fn c_sum () Nat (sum (list 1 2 3 4)))
(fn c_let () Nat (let ((a 3) (b (+ a 4))) (* a b)))
(fn c_sub () Nat (Nat.sub 3 5))
(fn c_rows () Nat
  (match (snoc (cons 5 nil) 6)
    ((cons a (cons b nil)) (+ a b))
    (_ 0)))
(fn c_pair () (Prod Nat (List Nat)) (Prod.mk (sum (rev (list 1 2 3))) (rev (list 1 2 3))))
(fn c_tree () (List Nat) (flat (insert (insert (insert (insert Leaf 3) 1) 4) 2) nil))
(fn c_opt () (Option (List Nat)) (if (< (sum (list 1 2)) 4) (some (rev (list 7 8))) none))
(fn c_int () Int (- (* 6 7) 50))
(fn c_spin () Nat (spin 0))
(fn c_outside () Nat (+ 1 (outside 2)))
