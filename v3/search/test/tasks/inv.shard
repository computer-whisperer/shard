;;; v3/search/test/tasks/inv.shard — unknown VALUES: a function inverted at a point. The goals'
;;; parameters are the unknowns; nothing here is a hole function.

(use Init.Bool false true)
(use Init.List cons nil)

(fn snoc ((xs (List Nat)) (x Nat)) (List Nat)
  (measure (struct xs))
  (match xs
    (nil (cons x nil))
    ((cons y r) (cons y (snoc r x)))))
(fn rev ((xs (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (snoc (rev r) x))))
(fn list_eq ((a (List Nat)) (b (List Nat))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x r)
     (match b
       ((cons y s) (if (= x y) (list_eq r s) false))
       (nil false)))))
;; which list reverses to 3 1 2
(fn rev_is ((x (List Nat))) Bool (list_eq (rev x) (list 3 1 2)))

;; a small stack machine: which program leaves 7 from 0
(type Op (Inc) (Dbl) (Dec))
(fn step ((o Op) (n Nat)) Nat
  (match o
    (Inc (+ n 1))
    (Dbl (* n 2))
    (Dec (Nat.sub n 1))))
(fn exec ((p (List Op)) (n Nat)) Nat
  (measure (struct p))
  (match p
    (nil n)
    ((cons o r) (exec r (step o n)))))
(fn exec_is_7 ((p (List Op))) Bool (if (= (exec p 0) 7) true false))
;; two unknowns at once: a program and the number it starts from, to 9, the start under 3
(fn exec_from ((p (List Op)) (n Nat)) Bool (if (< n 3) (if (= (exec p n) 9) true false) false))
;; no list reverses to itself with a 1 first and a 0 last … and nothing but 0 and 1: none exists
(fn impossible ((x (List Nat))) Bool
  (match x
    (nil false)
    ((cons a _) (if (= a 1) (list_eq (rev x) (cons 0 x)) false))))
;; a finite space with no answer in it
(fn never ((b Bool) (c Bool)) Bool (if b (if c (if b false true) false) false))
