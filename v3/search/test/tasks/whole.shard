;;; v3/search/test/tasks/whole.shard — WHOLE FUNCTIONS FROM PROPERTIES. Each function to be
;;; found is an `extern`: a name and a signature. What it must do is one property, a function
;;; that answers yes on every argument (`find --spec`), stated over functions that are already
;;; here: "the inverse of z", "x, in another form".

(use Init.Bool false true)
(use Init.List cons nil)

(fn list_eq ((a (List Nat)) (b (List Nat))) Bool
  (measure (struct a))
  (match a
    (nil
      (match b
        (nil true)
        (_ false)))
    ((cons x r)
     (match b
       ((cons y s) (if (= x y) (list_eq r s) false))
       (nil false)))))
(fn snoc ((xs (List Nat)) (x Nat)) (List Nat)
  (measure (struct xs))
  (match xs
    (nil (cons x nil))
    ((cons y r) (cons y (snoc r x)))))
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x r) (cons x (app r ys)))))
;; reverse, the plain way: quadratic
(fn rev ((xs (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (snoc (rev r) x))))

;; THE INVERSE OF A FUNCTION: what undoes `rev`
(extern unrev ((xs (List Nat))) (List Nat))
(fn unrev_spec ((xs (List Nat))) Bool (list_eq (unrev (rev xs)) xs))

;; A FUNCTION IN ANOTHER FORM: reverse with an accumulator, linear — stated against the plain one
(extern rev_onto ((xs (List Nat)) (acc (List Nat))) (List Nat))
(fn rev_onto_spec ((xs (List Nat)) (acc (List Nat))) Bool
  (list_eq (rev_onto xs acc) (app (rev xs) acc)))

;; the inverse of a map: what undoes "one more, everywhere"
(fn inc ((n Nat)) Nat (+ n 1))
(fn dec ((n Nat)) Nat (Nat.sub n 1))
(fn inc_all ((xs (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons x r) (cons (inc x) (inc_all r)))))
(extern dec_all ((xs (List Nat))) (List Nat))
(fn dec_all_spec ((xs (List Nat))) Bool (list_eq (dec_all (inc_all xs)) xs))

;; a tree and its mirror image: what undoes `mirror`
(type Tree (Leaf) (Fork Tree Nat Tree))
(fn tree_eq ((a Tree) (b Tree)) Bool
  (measure (struct a))
  (match a
    (Leaf
      (match b
        (Leaf true)
        (_ false)))
    ((Fork l v r)
     (match b
       ((Fork l2 v2 r2) (if (= v v2) (if (tree_eq l l2) (tree_eq r r2) false) false))
       (Leaf false)))))
(fn mirror ((t Tree)) Tree
  (measure (struct t))
  (match t
    (Leaf Leaf)
    ((Fork l v r) (Fork (mirror r) v (mirror l)))))
(extern unmirror ((t Tree)) Tree)
(fn unmirror_spec ((t Tree)) Bool (tree_eq (unmirror (mirror t)) t))

;; a tree's values in order, with an accumulator — against flattening by append
(fn flat ((t Tree)) (List Nat)
  (measure (struct t))
  (match t
    (Leaf nil)
    ((Fork l v r) (app (flat l) (cons v (flat r))))))
(extern flat_onto ((t Tree) (acc (List Nat))) (List Nat))
(fn flat_onto_spec ((t Tree) (acc (List Nat))) Bool (list_eq (flat_onto t acc) (app (flat t) acc)))

;; A FUNCTION THAT DECIDES BY COMPARING: insertion into a sorted list, from what it must keep —
;; sorted stays sorted, the new element is there once more, every other as often as before
(fn le ((a Nat) (b Nat)) Bool (if (<= a b) true false))
(fn sorted ((xs (List Nat))) Bool
  (measure (struct xs))
  (match xs
    (nil true)
    ((cons x r)
     (match r
       (nil true)
       ((cons y _) (if (<= x y) (sorted r) false))))))
(fn count ((k Nat) (xs (List Nat))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons x r) (if (= x k) (+ 1 (count k r)) (count k r)))))
(extern insert ((x Nat) (xs (List Nat))) (List Nat))
(fn insert_spec ((x Nat) (y Nat) (xs (List Nat))) Bool
  (if (sorted xs)
    (if (sorted (insert x xs))
      (if (= (count x (insert x xs)) (+ (count x xs) 1))
        (if (= x y) true
        (if (= (count y (insert x xs)) (count y xs)) true
        false))
        false)
      false)
    true))
