;;; v3/search/find.shard — the search's command (the library is finder.shard):
;;;   find --root DIR [--init EXPORT --init-index INDEX] (--goal|--spec) M.FN [--hole M.FN]…
;;;        [--use M.FN]… [--tests N] [--test-size N]
;;;        [--ints K,K,…] [--size N] [--fuel N] [--fuel-min N] [--budget N] [--all] [--enum]
;;;        [--write] FILE…
;;; loads each FILE as load.shard does and searches the program the load yields. The options
;;; are the parts of a problem as finder.shard states them (`Ask`): --goal or --spec the goal
;;; (a function whose parameters are the unknown values, or a property tried on small
;;; arguments), --hole a function the program names and does not define, --use a function a
;;; found body may call, --ints, --size, --fuel, --fuel-min, --budget, --tests, --test-size,
;;; --all, --enum. A hole written in a function's body, `(hole NAME)`, needs no option: every
;;; one a run of the goal can reach is searched for.
;;; The records are finder.shard's (`found_lines`): `FIND …`, for each answer `FOUND …` with
;;; its `ARG`, `HOLE`, `FN` and `MEASURE` lines, then `FIND: VERDICT …` with the tally.
;;; Every answer printed was replayed under `ev` (task.shard). Exit 0: found; 1: not found
;;; (the verdict says what that claims); 2: the load failed, the problem does not read, or
;;; --write could not write.
;;;   --write   the first answer's code for the holes of functions' bodies goes to the sidecar
;;;             of each function's file, FILE.auto.shard (finder.shard `write_fills`): the next
;;;             load reads the function with that code in the holes' places. One line a
;;;             function, `WROTE PATH fill-for FN holes=…` or `NOT-WRITTEN FN: why`. No source
;;;             file is written; without --write no file is
;;;   --batch FILE   several problems over one load: each line of FILE is a problem's options
;;;             as above (a line that starts with # is passed over), read over the command
;;;             line's; exit 2 where a line does not read, else 0
;;;   --closed  no search: the goal, a function with no parameter, is run by the narrowing
;;;             machine and by `ev`, and the record is `SAME NAME = VALUE` or `DIFFER …` (exit
;;;             1) — the check that the machine is `ev` where nothing is unknown

(import "../kernel/loader.shard")
(import "finder.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.etable)
(use kernel.ev)
(use kernel.host)
(use kernel.host.World)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.loader)
(use kernel.name)
(use kernel.prog)
(use kernel.prog.EType)
(use kernel.prog.EvRes)
(use kernel.prog.Prog)
(use kernel.sym)
(use kernel.util)
(use search.drive)
(use search.finder)
(use search.narrow)
(use search.narrow.Stop)
(use search.task)

;; the command line: where the load starts, the problem, and what to do beside searching
(record FArgs (root (List Int)) (export (List Int)) (index (List Int)) (files (List (List Int)))
  (ask Ask)
  (closed Bool)
  (batch (List Int))
  (write Bool))
(fn parse_fargs ((args (List (List Int))) (a FArgs)) FArgs
  (measure (struct args))
  (match args
    (nil (with FArgs a (files (rev (FArgs.files a))) (ask (ask_done (FArgs.ask a)))))
    ((cons x r)
     (match (ask_flag x (FArgs.ask a))
       ((some k) (parse_fargs r (with FArgs a (ask k))))
       (none
         (if (int_list_eq x (utf8 "--closed")) (parse_fargs r (with FArgs a (closed true)))
         (if (int_list_eq x (utf8 "--write")) (parse_fargs r (with FArgs a (write true)))
         (match r
           (nil (parse_fargs nil (with FArgs a (files (cons x (FArgs.files a))))))
           ((cons v r2)
            (if (int_list_eq x (utf8 "--root")) (parse_fargs r2 (with FArgs a (root v)))
            (if (int_list_eq x (utf8 "--init")) (parse_fargs r2 (with FArgs a (export v)))
            (if (int_list_eq x (utf8 "--init-index")) (parse_fargs r2 (with FArgs a (index v)))
            (if (int_list_eq x (utf8 "--batch")) (parse_fargs r2 (with FArgs a (batch v)))
            (match (ask_option x v (FArgs.ask a))
              ((some k) (parse_fargs r2 (with FArgs a (ask k))))
              (none (parse_fargs r (with FArgs a (files (cons x (FArgs.files a))))))))))))))))))))

(fn find_files ((l Load) (files (List (List Int))) (w World)) (Prod Load World)
  (measure (struct files))
  (match files
    (nil (Prod.mk l w))
    ((cons f r)
     (match (load_root_file l f w)
       ((Prod.mk l1 w1) (find_files l1 r w1))))))
;; the records of a load that failed: the refusals and the errors, not the whole load
(fn print_frecs ((rs (List Rec)) (w World)) World
  (measure (struct rs))
  (match rs
    (nil w)
    ((cons x r)
     (let ((line (show_rec x))) (print_frecs r (if (failure_line line) (write_line line w) w))))))
;; a record whose first word is or ends in REFUSE or ERROR (REFUSE, READ-ERROR, IMPL-ERROR, …),
;; or is IMPL before such a word
(fn failure_line ((line (List Int))) Bool
  (match (words_of line nil nil)
    ((cons a rest)
     (if (failure_word a) true
     (match rest
       ((cons b _) (bool_and (int_list_eq a (utf8 "IMPL")) (failure_word b)))
       (nil false))))
    (nil false)))
(fn failure_word ((a (List Int))) Bool
  (bool_or (ends_with a (utf8 "REFUSE")) (ends_with a (utf8 "ERROR"))))
(fn ends_with ((a (List Int)) (suffix (List Int))) Bool
  (int_list_eq (drop (- (len a) (len suffix)) a) suffix))
;; a problem that does not read: its line, status 2
(fn fail ((msg (List Int)) (w World)) (Prod Int World)
  (Prod.mk 2 (write_line (append (utf8 "FIND-ERROR ") msg) w)))

(fn main ((w World)) World
  (match (get_args w)
    ((Prod.mk args w1)
     (let
       ((a
          (parse_fargs args
            (make FArgs (root nil) (export nil) (index nil) (files nil) (ask (ask_for nil false))
              (closed false)
              (batch nil)
              (write false)))))
       (match (parts_of (FArgs.root a))
         (none (exit 2 (write_line (utf8 "FIND-ERROR usage: --root DIR is required") w1)))
         ((some rootp)
          (if (= (len rootp) 0)
            (exit 2 (write_line (utf8 "FIND-ERROR usage: --root DIR is required") w1))
            (match (find_files (ld_start rootp (FArgs.export a) (FArgs.index a)) (FArgs.files a) w1)
              ((Prod.mk l w2)
               (let ((cs (rec_counts (ld_recs l) (zero_counts))))
                 (if (< 0 (load_failures cs))
                   (exit 2
                     (write_line (append (utf8 "FIND-ERROR load: ") (show_counts_load cs))
                       (print_frecs (ld_recs l) w2)))
                   (main_loaded a l w2))))))))))))
;; the program linked once; one problem from the command line, or each line of the batch file
(fn main_loaded ((a FArgs) (l Load) (w World)) World
  (match (ground_of l)
    ((GroundNo m) (exit 2 (write_line (append (utf8 "FIND-ERROR ") m) w)))
    ((GroundOk g)
     (if (= (len (FArgs.batch a)) 0)
       (match (solve a l g w)
         ((Prod.mk st w1) (exit st w1)))
       (match (read_file (FArgs.batch a) w)
         ((Prod.mk none w1)
          (exit 2 (write_line (append (utf8 "FIND-ERROR --batch: cannot read ") (FArgs.batch a)) w1)))
         ((Prod.mk (some bs) w1)
          (match (solve_lines a l g (lines_of bs nil nil) (Prod.mk 0 w1))
            ((Prod.mk st w2) (exit st w2)))))))))
;; a batch: each line a problem — the command line's options, over the command line's own. The
;; status is 2 where a line does not read, else 0: what each problem came to is in its records
(fn solve_lines ((a FArgs) (l Load) (g Ground) (lines (List (List Int))) (acc (Prod Int World)))
  (Prod Int World)
  (measure (struct lines))
  (match lines
    (nil acc)
    ((cons ln r)
     (match acc
       ((Prod.mk st w)
        (let ((words (words_of ln nil nil)))
          (match words
            (nil (solve_lines a l g r acc))
            ((cons (cons 35 _) _) (solve_lines a l g r acc))
            (_
              (match
                (solve (parse_fargs words (with FArgs a (files nil) (ask (ask_bare (FArgs.ask a)))))
                  l
                  g
                  w)
                ((Prod.mk st1 w1) (solve_lines a l g r (Prod.mk (if (= st1 2) 2 st) w1))))))))))))
(fn lines_of ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil (rev (cons (rev cur) acc)))
    ((cons c r) (if (= c 10) (lines_of r nil (cons (rev cur) acc)) (lines_of r (cons c cur) acc)))))
(fn words_of ((bs (List Int)) (cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (measure (struct bs))
  (match bs
    (nil (rev (push_word cur acc)))
    ((cons c r) (if (is_ws c) (words_of r nil (push_word cur acc)) (words_of r (cons c cur) acc)))))
(fn push_word ((cur (List Int)) (acc (List (List Int)))) (List (List Int))
  (match cur
    (nil acc)
    (_ (cons (rev cur) acc))))

;; one problem: its records; with --write, the first answer's code into the sidecars
(fn solve ((a FArgs) (l Load) (g Ground) (w World)) (Prod Int World)
  (if (FArgs.closed a) (closed_run a g w)
  (match (find_in g (FArgs.ask a))
    ((FindNo m) (fail m w))
    ((FindOk f)
     (let ((w1 (write_lines (found_lines f) w)))
       (match (Result.answers f)
         (nil (Prod.mk 1 w1))
         ((cons an _)
          (if (bool_not (FArgs.write a)) (Prod.mk 0 w1)
          (match (write_fills l an w1)
            ((Prod.mk (Wrote lines ok) w2) (Prod.mk (if ok 0 2) (write_lines lines w2))))))))))))
(fn write_lines ((lines (List (List Int))) (w World)) World
  (measure (struct lines))
  (match lines
    (nil w)
    ((cons x r) (write_lines r (write_line x w)))))
;; --closed: a function with no parameter and nothing unknown, run by the narrowing machine and
;; by `ev`: the two answers must be the same value, or the same kind of end
(fn closed_run ((a FArgs) (g Ground) (w World)) (Prod Int World)
  (match g
    ((Ground p lk _)
     (match (sig_of lk p (Ask.goal (FArgs.ask a)) false)
       ((SigNo m) (fail (append (utf8 "--goal ") m) w))
       ((SigOk gid gps _)
        (match gps
          ((cons _ _) (fail (utf8 "--closed: the function takes parameters") w))
          (nil
            (match p
              ((Prog.Prog ds)
               (let
                 ((fuel (Ask.fuel (FArgs.ask a)))
                  (pb (problem_of (Given.Given lk ds nil nil fuel) (fn_name lk gid) gid nil nil))
                  (mine
                    (end_text pb
                      (nv_start (Mach.Mach lk IMEmpty (len ds)) (heap_empty) gid nil fuel)))
                  (evs (ev_text (ev p (fn_name lk gid) nil fuel))))
                 (if (int_list_eq mine evs)
                   (Prod.mk 0
                     (write_line
                       (append (utf8 "SAME ")
                         (append (show_name (fn_name lk gid)) (append (utf8 " = ") mine)))
                       w))
                   (Prod.mk 1
                     (write_line
                       (append (utf8 "DIFFER ")
                         (append (show_name (fn_name lk gid))
                           (append (utf8 ": the narrowing machine ")
                             (append mine (append (utf8 ", ev ") evs)))))
                       w)))))))))))))
(fn end_text ((pb Problem) (st Stop)) (List Int)
  (match st
    ((SVal v h _)
     (match (closed_val pb h v)
       ((some x) (show_val x))
       (none (utf8 "an open value"))))
    ((SNeed _ _ _ _) (utf8 "a stop"))
    (SOut (utf8 "out of fuel"))
    ((SStuck why _) (append (utf8 "stuck ") (chars_of_sym why)))
    ((SExh why _) (append (utf8 "exhausted ") (chars_of_sym why)))))
(fn ev_text ((r EvRes)) (List Int)
  (match r
    ((EvOk v) (show_val v))
    (EvOut (utf8 "out of fuel"))
    ((EvStuck why _) (append (utf8 "stuck ") (chars_of_sym why)))
    ((EvExhausted why _) (append (utf8 "exhausted ") (chars_of_sym why)))))
