;;; v3/search/finder.shard — the search as a library: a problem asked of a loaded program,
;;; and what was found as a value. `find.shard` is the command over it; another program imports
;;; this file and does the same three things:
;;;   (ground_of l)        the load's program linked once, with the holes its functions hold
;;;   (find_in g ask)      one problem searched: `FindOk` with the verdict, the tally and the
;;;                        answers, or `FindNo` with why the problem does not read
;;;   (write_fills l an w) an answer's code written to the sidecars of the files its functions
;;;                        stand in, where a load reads it in the holes' places
;;; A problem (`Ask`, defaults from `ask_for`):
;;;   goal      a function whose answer is a two-constructor cell (`Bool`, a decision): the
;;;             search wants its second constructor (`true`). Its parameters are the UNKNOWN
;;;             VALUES, each of its stated type
;;;   spec      the goal is a PROPERTY: it must answer yes on every argument tuple, and is tried
;;;             on the small ones: every tuple of closed values of its parameter types by size,
;;;             smallest first, up to `test_size` units (0: 10, and 2 more for each parameter
;;;             after the first) and `tests` of them. Nothing of it is unknown: what is searched
;;;             for is the hole functions that make it hold on all of them
;;;   holes     functions the program names and does not define — an `extern`, a view's `sig fn`
;;;             with no implementation among the roots — whose bodies are to be found. A hole
;;;             written in a function's body, `(hole NAME)`, is not named here: every one a run
;;;             of the goal can reach is searched for
;;;   uses      functions a found body may call (a hole function among them: recursion; the
;;;             function a hole stands in among them: its fillings call it on a proper part of
;;;             what it was given, as a function being found calls itself)
;;;   ints      the integers an unknown `Int` or `Nat` is tried at, and a body may hold
;;;   size      the last bound tried (0: the default). For a goal: a size, one unit for each
;;;             constructor, integer, parameter or call decided (default 12). For a property:
;;;             the number of rounds (default 28), a round bounded by how deep a row's
;;;             expression nests and under how many matches a row stands — every pair by its
;;;             sum, 28 rounds the pairs of sum 7 or less
;;;   fuel      the most function entries allowed one branch. A round walks at four times what
;;;             the costliest answer so far took, between `fuel_min` and this; a replay gets
;;;             eight times the round's
;;;   budget    function entries allowed the whole search
;;;   all       every answer of the first size that has one, not the first alone
;;;   eager     the comparison: every candidate decided whole before it is run (drive.shard
;;;             `enum_walk`) — the same answers at many times the work
;;; What is found (`Result`): the verdict (drive.shard: found, none, bounded, gave_up), the
;;; tally, and each answer (`Answer`) — a goal parameter's value; for a hole of a function's
;;; body the expression to stand in its place, over the names in scope there, as source text;
;;; for a function whose holes' code makes it call itself the parameter it recurs on; for a hole
;;; function its definition as source text. Every answer was replayed under `ev` (task.shard).
;;; `found_lines` is the records the command prints.
;;; Names of the program are given as text (`m.f`), as a command line gives them.

(import "../kernel/loader.shard")
(import "drive.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.etable)
(use kernel.ev)
(use kernel.ev.LinkRes)
(use kernel.host)
(use kernel.host.World)
(use kernel.intmap)
(use kernel.intmap.IntMap)
(use kernel.loader)
(use kernel.name)
(use kernel.name.Name)
(use kernel.prog)
(use kernel.prog.EDecl)
(use kernel.prog.EType)
(use kernel.prog.Prog)
(use kernel.record)
(use kernel.record.RxRes)
(use kernel.scope)
(use kernel.sexpr)
(use kernel.sexpr.RAll)
(use kernel.sexpr.SExpr)
(use kernel.sidecar)
(use kernel.sidecar.Fill)
(use kernel.sidecar.Fit)
(use kernel.sidecar.Side)
(use kernel.sym)
(use kernel.tactic)
(use kernel.util)
(use search.drive)
(use search.narrow)
(use search.task)

;; ---- what is asked ---------------------------------------------------------------------------
(record Ask (goal (List Int)) (spec Bool) (holes (List (List Int))) (uses (List (List Int)))
  (ints (List Int))
  (size Int)
  (fuel Int)
  (fuel_min Int)
  (budget Int)
  (all Bool)
  (eager Bool)
  (tests Int)
  (test_size Int))
;; a goal, or a property, with every other part at its default
(fn ask_for ((goal (List Int)) (spec Bool)) Ask
  (make Ask (goal goal) (spec spec) (holes nil) (uses nil) (ints (list 0 1)) (size 0) (fuel 20000)
    (fuel_min 64)
    (budget 20000000)
    (all false)
    (eager false)
    (tests 400)
    (test_size 0)))
;; the last bound tried: `size`, or by default 12 units for a goal and 28 rounds for a property
(fn size_of ((a Ask)) Int (if (= (Ask.size a) 0) (if (Ask.spec a) 28 12) (Ask.size a)))

;; ---- a problem from a command line's words --------------------------------------------------------
;; an option that takes a value, with it: the problem with that part set; nothing for another
;; word. A value that does not read as a number leaves the part as it was
(fn ask_option ((x (List Int)) (v (List Int)) (k Ask)) (Option Ask)
  (if (int_list_eq x (utf8 "--goal")) (some (with Ask k (goal v) (spec false)))
  (if (int_list_eq x (utf8 "--spec")) (some (with Ask k (goal v) (spec true)))
  (if (int_list_eq x (utf8 "--tests")) (some (with Ask k (tests (read_num v (Ask.tests k)))))
  (if (int_list_eq x (utf8 "--test-size"))
    (some (with Ask k (test_size (read_num v (Ask.test_size k)))))
  (if (int_list_eq x (utf8 "--hole")) (some (with Ask k (holes (cons v (Ask.holes k)))))
  (if (int_list_eq x (utf8 "--use")) (some (with Ask k (uses (cons v (Ask.uses k)))))
  (if (int_list_eq x (utf8 "--ints")) (some (with Ask k (ints (ints_of_text v nil nil))))
  (if (int_list_eq x (utf8 "--size")) (some (with Ask k (size (read_num v (Ask.size k)))))
  (if (int_list_eq x (utf8 "--fuel")) (some (with Ask k (fuel (read_num v (Ask.fuel k)))))
  (if (int_list_eq x (utf8 "--fuel-min"))
    (some (with Ask k (fuel_min (read_num v (Ask.fuel_min k)))))
  (if (int_list_eq x (utf8 "--budget")) (some (with Ask k (budget (read_num v (Ask.budget k)))))
  none))))))))))))
;; an option that takes none
(fn ask_flag ((x (List Int)) (k Ask)) (Option Ask)
  (if (int_list_eq x (utf8 "--all")) (some (with Ask k (all true)))
  (if (int_list_eq x (utf8 "--enum")) (some (with Ask k (eager true)))
  none)))
;; the words read: --hole and --use were gathered last first; the functions in the order given
(fn ask_done ((k Ask)) Ask (with Ask k (holes (rev (Ask.holes k))) (uses (rev (Ask.uses k)))))
;; the same problem with no function named: what a line of a batch starts from
(fn ask_bare ((k Ask)) Ask (with Ask k (holes nil) (uses nil)))
(fn read_num ((s (List Int)) (dflt Int)) Int
  (if (bool_and (< 0 (len s)) (all_digits s)) (digits_val s 0) dflt))
;; integers separated by commas, each with an optional minus sign; what does not read is passed over
(fn ints_of_text ((bs (List Int)) (cur (List Int)) (acc (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (nil (rev (push_int (rev cur) acc)))
    ((cons c r)
     (if (= c 44) (ints_of_text r nil (push_int (rev cur) acc)) (ints_of_text r (cons c cur) acc)))))
(fn push_int ((s (List Int)) (acc (List Int))) (List Int)
  (match s
    ((cons 45 d) (if (bool_and (< 0 (len d)) (all_digits d)) (cons (- 0 (digits_val d 0)) acc) acc))
    (_ (if (bool_and (< 0 (len s)) (all_digits s)) (cons (digits_val s 0) acc) acc))))

;; ---- what is searched ------------------------------------------------------------------------
;; a load's program linked once — many problems are asked of one —, and the holes its functions
;; hold (etable.shard es_holes), each with the names it is handed
(type Ground (Ground Prog Linked (List (Prod Name (List Name)))))
(type GroundRes (GroundOk Ground) (GroundNo (List Int)))
(fn ground_of ((l Load)) GroundRes
  (let ((p (es_prog (Load.etab l))))
    (match (link p)
      ((LkErr e m) (GroundNo (append (utf8 "link: ") (append (chars_of_sym e) (cons 32 m)))))
      ((LkOk lk) (GroundOk (Ground p lk (es_holes (Load.etab l))))))))

;; ---- the problem as its names state it ---------------------------------------------------------
(type Sig (SigOk Int (List EType) EType) (SigNo (List Int)))
;; a name of the command line as a function of the program: its index and signature. `holes`:
;; it must be one the program does not define; otherwise any function, defined or not
(fn sig_of ((lk Linked) (p Prog) (text (List Int)) (hole Bool)) Sig
  (match (name_of_bytes text nil Anon)
    (none (SigNo (append text (utf8 ": not a name"))))
    ((some n)
     (match (nmap_find (lk_ids lk) n)
       (none (SigNo (append text (utf8 ": no function of the program has this identity"))))
       ((some id)
        (match (prog_find p n)
          ((some (EFn _ k ps rt _ _))
           (if hole
             (SigNo (append text (utf8 ": defined — a hole function is an extern or a sig fn")))
           (if (= k 0) (SigOk id ps rt)
           (SigOk id ps rt))))
          ((some (EExtern _ k ps rt))
           (if (= k 0) (SigOk id ps rt)
           (SigNo (append text (utf8 ": a hole function with type parameters")))))
          ((some (ESig _ k ps rt))
           (if (= k 0) (SigOk id ps rt)
           (SigNo (append text (utf8 ": a hole function with type parameters")))))
          (_ (SigNo (append text (utf8 ": not a function"))))))))))
(type Holes (HolesOk (IntMap Hole) (List (Prod Int Name))) (HolesNo (List Int)))
(fn holes_of
  ((lk Linked) (p Prog) (texts (List (List Int))) (hs (IntMap Hole)) (acc (List (Prod Int Name))))
  Holes
  (measure (struct texts))
  (match texts
    (nil (HolesOk hs (rev acc)))
    ((cons x r)
     (match (sig_of lk p x true)
       ((SigNo m) (HolesNo m))
       ((SigOk id ps rt)
        (holes_of lk p r
          (im_insert hs id (Hole.Hole ps rt none (HCtx.HCtx id (len ps) nil nil 0 0)))
          (cons (Prod.mk id (fn_name lk id)) acc)))))))
;; ---- the holes of the load ---------------------------------------------------------------------
;; a hole written in a function's body (`(hole NAME)`, elab.shard) is an extern of the program
;; that the load's table names with the names it is handed. Those a run of the goal can reach
;; are searched for without being named on the command line. Where a hole stands in its owner
;; — the function whose body holds it — says more than a signature: which of the names it is
;; handed are the owner's parameters, which are proper parts of one (bound by a match under
;; it) and which the owner has already taken apart. So a filling calls the owner as a function
;; being found calls itself — on a proper part alone (drive.shard `prod_rec`; the owner named
;; by --use) — and matches no name twice.
;; a hole in its place: its index, the names it is handed, its owner's index and number of
;; parameters (0 where the hole's first parameters are not the owner's in order: a parameter
;; hidden there by a later name)
(type Place1 (Place1 Int (List Name) Int Int))
(type Placed (PlacedOk (IntMap Hole) (List (Prod Int Name)) (List Place1)) (PlacedNo (List Int)))
(fn placed_holes
  ((lk Linked) (p Prog) (th (List (Prod Name (List Name)))) (reach (List Int)) (acc Placed))
  Placed
  (measure (struct th))
  (match th
    (nil
      (match acc
        ((Placed.PlacedOk hs named places) (Placed.PlacedOk hs (rev named) (rev places)))
        (no no)))
    ((cons (Prod.mk n names) r)
     (match acc
       ((Placed.PlacedNo m) (Placed.PlacedNo m))
       ((Placed.PlacedOk hs named places)
        (match (nmap_find (lk_ids lk) n)
          (none (placed_holes lk p r reach acc))
          ((some id)
           (if (bool_or (bool_not (mem_int id reach)) (hole_known hs id))
             (placed_holes lk p r reach acc)
             (match (prog_find p n)
               ((some (EExtern _ k ps rt))
                (if (bool_not (= k 0))
                  (Placed.PlacedNo
                    (append (show_name n)
                      (utf8
                        ": its function has type parameters — a search fills a hole of plain types")))
                  (match (site_of lk n id)
                    ((Site.Site oid oar matched smaller)
                     (placed_holes lk p r reach
                       (Placed.PlacedOk
                         (im_insert hs id
                           (Hole.Hole ps rt none (HCtx.HCtx oid oar matched smaller 0 0)))
                         (cons (Prod.mk id n) named)
                         (cons (Place1.Place1 id names oid oar) places)))))))
               (_ (placed_holes lk p r reach acc)))))))))))
(fn hole_known ((hs (IntMap Hole)) (id Int)) Bool
  (match (im_find hs id)
    ((some _) true)
    (none false)))
;; the functions a run from these can reach, by index: calls and extern calls
(fn reach_fns ((lk Linked) (todo (List Int)) (seen (List Int))) (List Int)
  (match todo
    (nil seen)
    ((cons id r)
     (if (mem_int id seen) (reach_fns lk r seen)
     (match (im_find (lk_fns lk) id)
       ((some (LFn.LBody _ _ b)) (reach_fns lk (heads_of b r) (cons id seen)))
       (_ (reach_fns lk r (cons id seen))))))))
(fn heads_of ((t LTerm) (acc (List Int))) (List Int)
  (match t
    ((LCall id as) (heads_all as (cons id acc)))
    ((LExt id as) (heads_all as (cons id acc)))
    ((LCtor _ as) (heads_all as acc))
    ((LPrim _ as) (heads_all as acc))
    ((LMatch s arms) (heads_arms arms (heads_of s acc)))
    ((LLet rs b) (heads_of b (heads_all rs acc)))
    ((LIf c x y) (heads_of y (heads_of x (heads_of c acc))))
    (_ acc)))
(fn heads_all ((ts (List LTerm)) (acc (List Int))) (List Int)
  (match ts
    (nil acc)
    ((cons t r) (heads_all r (heads_of t acc)))))
(fn heads_arms ((arms (List LArm)) (acc (List Int))) (List Int)
  (match arms
    (nil acc)
    ((cons (LArm.LArm _ b) r) (heads_arms r (heads_of b acc)))))
;; where a hole stands: its owner's index and number of parameters, the hole's parameters the
;; owner has matched, and those that are proper parts of an owner's parameter (the hole's
;; position, the owner's). The owner is the function the hole's name hangs under; a hole whose
;; owner the program lacks, or whose call is not found in it, stands nowhere: itself the root,
;; as a hole function named on the command line is
(type Site (Site Int Int (List Int) (List (Prod Int Int))))
;; what a variable of the owner's body is of the owner's parameters: a proper part of one, or not
(type Org (OPart Int) (ONone))
(type Seen (Seen (List Org) (List Int) (List LTerm)))  ; at the hole's call: the frame, the positions matched, the arguments
(fn site_of ((lk Linked) (n Name) (id Int)) Site
  (match n
    ((Str owner _)
     (match (nmap_find (lk_ids lk) owner)
       ((some oid)
        (match (im_find (lk_fns lk) oid)
          ((some (LFn.LBody _ oar b))
           (match (find_site b id (Prod.mk (params_orgs oar 0) nil) oar)
             ((some (Seen.Seen env matched args))
              (Site.Site oid (if (own_prefix args (len env) 0 oar) oar 0)
                (matched_args args (len env) matched 0)
                (part_args args env 0)))
             (none (Site.Site id 0 nil nil))))
          (_ (Site.Site id 0 nil nil))))
       (none (Site.Site id 0 nil nil))))
    (_ (Site.Site id 0 nil nil))))
;; the owner's own parameters: each the whole of itself — a variable at a position below the
;; owner's arity is a parameter, and a match on it binds its parts
(fn params_orgs ((oar Int) (i Int)) (List Org)
  (if (<= oar i) nil (cons Org.ONone (params_orgs oar (+ i 1)))))
;; the hole's first arguments are the owner's parameters, in order
(fn own_prefix ((args (List LTerm)) (n Int) (q Int) (oar Int)) Bool
  (if (<= oar q) true
  (match args
    ((cons (LBVar i) r) (if (= (- (- n 1) i) q) (own_prefix r n (+ q 1) oar) false))
    (_ false))))
(fn matched_args ((args (List LTerm)) (n Int) (matched (List Int)) (a Int)) (List Int)
  (match args
    (nil nil)
    ((cons (LBVar i) r)
     (if (mem_int (- (- n 1) i) matched) (cons a (matched_args r n matched (+ a 1)))
     (matched_args r n matched (+ a 1))))
    ((cons _ r) (matched_args r n matched (+ a 1)))))
(fn part_args ((args (List LTerm)) (env (List Org)) (a Int)) (List (Prod Int Int))
  (match args
    (nil nil)
    ((cons (LBVar i) r)
     (match (nth env (- (- (len env) 1) i))
       ((some (Org.OPart q)) (cons (Prod.mk a q) (part_args r env (+ a 1))))
       (_ (part_args r env (+ a 1)))))
    ((cons _ r) (part_args r env (+ a 1)))))
;; the walk to the hole's call. `st`: the frame — each variable's origin, in the order bound —
;; and the positions a match has taken apart on the way
(fn find_site ((t LTerm) (id Int) (st (Prod (List Org) (List Int))) (oar Int)) (Option Seen)
  (match st
    ((Prod.mk env matched)
     (match t
       ((LExt x args)
        (if (= x id) (some (Seen.Seen env matched args)) (find_site_all args id st oar)))
       ((LCall _ args) (find_site_all args id st oar))
       ((LCtor _ args) (find_site_all args id st oar))
       ((LPrim _ args) (find_site_all args id st oar))
       ((LMatch s arms)
        (match (find_site s id st oar)
          ((some x) (some x))
          (none
            (match s
              ((LBVar i)
               (let ((pos (- (- (len env) 1) i)))
                 (find_site_arms arms id (Prod.mk env (cons pos matched))
                   (if (< pos oar) (Org.OPart pos)
                   (match (nth env pos)
                     ((some o) o)
                     (none Org.ONone)))
                   oar)))
              (_ (find_site_arms arms id st Org.ONone oar))))))
       ((LLet rs b) (find_site_let rs b id st oar))
       ((LIf c x y)
        (match (find_site c id st oar)
          ((some v) (some v))
          (none
            (match (find_site x id st oar)
              ((some v) (some v))
              (none (find_site y id st oar))))))
       (_ none)))))
(fn find_site_all ((ts (List LTerm)) (id Int) (st (Prod (List Org) (List Int))) (oar Int))
  (Option Seen)
  (match ts
    (nil none)
    ((cons t r)
     (match (find_site t id st oar)
       ((some v) (some v))
       (none (find_site_all r id st oar))))))
;; a row binds its pattern's variables: under a scrutinee that is a parameter or a part of one,
;; each a proper part of that parameter — a row that binds the scrutinee whole (a variable
;; pattern) binds no part
(fn find_site_arms ((arms (List LArm)) (id Int) (st (Prod (List Org) (List Int))) (o Org) (oar Int))
  (Option Seen)
  (match arms
    (nil none)
    ((cons (LArm.LArm p b) r)
     (match st
       ((Prod.mk env matched)
        (match
          (find_site b id
            (Prod.mk
              (append env
                (orgs_n (pat_count p)
                  (match p
                    ((LPCtor _ _) o)
                    (_ Org.ONone))))
              matched)
            oar)
          ((some v) (some v))
          (none (find_site_arms r id st o oar))))))))
(fn find_site_let ((rs (List LTerm)) (b LTerm) (id Int) (st (Prod (List Org) (List Int))) (oar Int))
  (Option Seen)
  (match rs
    (nil (find_site b id st oar))
    ((cons x r)
     (match (find_site x id st oar)
       ((some v) (some v))
       (none
         (match st
           ((Prod.mk env matched)
            (find_site_let r b id (Prod.mk (append env (list Org.ONone)) matched) oar))))))))
(fn orgs_n ((k Int) (o Org)) (List Org) (if (< k 1) nil (cons o (orgs_n (- k 1) o))))
;; the variables a pattern binds
(fn pat_count ((p LPat)) Int
  (match p
    (LPVar 1)
    ((LPCtor _ subs) (pat_count_all subs))
    (_ 0)))
(fn pat_count_all ((ps (List LPat))) Int
  (match ps
    (nil 0)
    ((cons p r) (+ (pat_count p) (pat_count_all r)))))
(type Vocs (VocsOk (List Voc)) (VocsNo (List Int)))
(fn vocs_of ((lk Linked) (p Prog) (texts (List (List Int))) (acc (List Voc))) Vocs
  (measure (struct texts))
  (match texts
    (nil (VocsOk (rev acc)))
    ((cons x r)
     (match (sig_of lk p x false)
       ((SigNo m) (VocsNo m))
       ((SigOk id ps rt) (vocs_of lk p r (cons (Voc.Voc id ps rt) acc)))))))

;; ---- the search ----------------------------------------------------------------------------------
;; one answer: each unknown value of the goal with its type, as text; each thing found, in the
;; problem's order — a hole of a function's body (its constant, the function it stands in, the
;; expression for its place) or a hole function (its name, its definition) —; and each function
;; whose holes' code calls it, with the parameter every such call passes a proper part at
(type Got (GotHole Name Name (List Int)) (GotFn Name (List Int)))
(record Answer (args (List (Prod EType (List Int)))) (items (List Got))
  (measures (List (Prod Name Name))))
;; the problem as read (the record `FIND goal=…`), the verdict, the bound the last round
;; reached as the records word it, the tally's counts (drive.shard tally_counts), the answers
(record Result (asked (List Int)) (verdict Symbol) (bound (List Int)) (tally (List Int))
  (answers (List Answer)))
(type FindRes (FindNo (List Int)) (FindOk Result))
(fn find_in ((g Ground) (a Ask)) FindRes
  (match g
    ((Ground p lk th)
     (match (sig_of lk p (Ask.goal a) false)
       ((SigNo m) (FindNo (append (utf8 "--goal ") m)))
       ((SigOk gid gps _)
        (if (bool_not (no_type_params gps))
          (FindNo (utf8 "--goal: a parameter's type names a type parameter"))
          (match (holes_of lk p (Ask.holes a) IMEmpty nil)
            ((HolesNo m) (FindNo (append (utf8 "--hole ") m)))
            ((HolesOk hs0 named0)
             (match
               (placed_holes lk p th (reach_fns lk (list gid) nil)
                 (Placed.PlacedOk hs0 (rev named0) nil))
               ((Placed.PlacedNo m) (FindNo (append (utf8 "hole ") m)))
               ((Placed.PlacedOk hs named places)
                (match (vocs_of lk p (Ask.uses a) nil)
                  ((VocsNo m) (FindNo (append (utf8 "--use ") m)))
                  ((VocsOk voc)
                   (match p
                     ((Prog.Prog ds)
                      (let
                        ((pb0
                           (problem_of (Given.Given lk ds voc (Ask.ints a) (Ask.fuel a))
                             (fn_name lk gid)
                             gid
                             (if (Ask.spec a) nil gps)
                             named))
                         (tests
                           (if (Ask.spec a)
                             (tests_of pb0 gps 0
                               (Prod.mk
                                 (if (= (Ask.test_size a) 0) (+ 10 (* 2 (- (len gps) 1)))
                                 (Ask.test_size a))
                                 (Ask.tests a))
                               nil)
                             nil)))
                        (if (bool_and (Ask.spec a) (= (len tests) 0))
                          (FindNo
                            (utf8
                              "--spec: no test: no tuple of values of the parameter types under --test-size"))
                          (let ((pb (problem_tests pb0 tests)))
                            (FindOk
                              (found_of a pb places
                                (deepen pb
                                  (Lim.Lim (size_of a) (min_int (Ask.fuel_min a) (Ask.fuel a))
                                    (Ask.fuel a)
                                    (Ask.budget a)
                                    (Ask.all a)
                                    (Ask.eager a))
                                  (Start.Start (Mach.Mach lk hs (Problem.base pb)))
                                  1
                                  (tally_zero)))))))))))))))))))))
(fn found_of ((a Ask) (pb Problem) (places (List Place1)) (o Ending)) Result
  (match o
    ((Ending.Ending verdict size sols y)
     (make Result (asked (asked_line a pb)) (verdict verdict) (bound (bound_text a pb size))
       (tally (tally_counts y))
       (answers (answers_of pb places sols))))))
(fn answers_of ((pb Problem) (places (List Place1)) (sols (List Sol))) (List Answer)
  (measure (struct sols))
  (match sols
    (nil nil)
    ((cons (Sol.Sol m h) r)
     (cons
       (make Answer (args (args_of pb h (Problem.goal_tys pb) 0))
         (items (items_of pb m places (Problem.holes pb)))
         (measures (measures_of pb m places (owners_of places nil))))
       (answers_of pb places r)))))
(fn args_of ((pb Problem) (h Heap) (tys (List EType)) (i Int)) (List (Prod EType (List Int)))
  (measure (struct tys))
  (match tys
    (nil nil)
    ((cons ty r)
     (cons
       (Prod.mk ty
         (match (closed_val pb h (NVal.NRef i))
           ((some v) (show_val v))
           (none (utf8 "?"))))
       (args_of pb h r (+ i 1))))))
;; a hole function as a definition; a hole of a function's body as the expression that stands
;; in its place, over the names in scope there
(fn items_of ((pb Problem) (m Mach) (places (List Place1)) (hs (List (Prod Int Name)))) (List Got)
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (Prod.mk id n) r)
     (cons
       (match (place_of places id)
         ((some (Place1.Place1 _ names oid _))
          (GotHole n (fn_name (Problem.lk pb) oid) (show_filling pb m id names)))
         (none (GotFn n (show_fn pb m id n))))
       (items_of pb m places r)))))
;; a function whose holes' code calls it: the parameter every such call passes a proper part
;; at — the recursion clause the function takes with that code, (measure (struct x))
(fn measures_of ((pb Problem) (m Mach) (places (List Place1)) (owners (List (Prod Int Int))))
  (List (Prod Name Name))
  (measure (struct owners))
  (match owners
    (nil nil)
    ((cons (Prod.mk oid oar) r)
     (let ((calls (owner_calls pb m places (Prod.mk oid oar) nil)))
       (match (struct_pos calls 0 oar)
         ((some q)
          (match (owner_param places oid q)
            ((some nm)
             (cons (Prod.mk (fn_name (Problem.lk pb) oid) nm) (measures_of pb m places r)))
            (none (measures_of pb m places r))))
         (none (measures_of pb m places r)))))))
(fn owner_calls
  ((pb Problem) (m Mach) (places (List Place1)) (owner (Prod Int Int)) (acc (List (List Bool))))
  (List (List Bool))
  (measure (struct places))
  (match places
    (nil acc)
    ((cons (Place1.Place1 id _ oid oar) r)
     (owner_calls pb m r owner
       (match owner
         ((Prod.mk o _) (if (= o oid) (append (filling_calls pb m id owner) acc) acc)))))))
;; the owner's q-th parameter's name: a hole of it is handed its parameters first
(fn owner_param ((places (List Place1)) (oid Int) (q Int)) (Option Name)
  (measure (struct places))
  (match places
    (nil none)
    ((cons (Place1.Place1 _ names o _) r) (if (= o oid) (nth names q) (owner_param r oid q)))))
(fn owners_of ((places (List Place1)) (acc (List (Prod Int Int)))) (List (Prod Int Int))
  (measure (struct places))
  (match places
    (nil (rev acc))
    ((cons (Place1.Place1 _ _ oid oar) r)
     (owners_of r (if (bool_or (< oar 1) (has_owner acc oid)) acc (cons (Prod.mk oid oar) acc))))))
(fn has_owner ((os (List (Prod Int Int))) (oid Int)) Bool
  (measure (struct os))
  (match os
    (nil false)
    ((cons (Prod.mk o _) r) (if (= o oid) true (has_owner r oid)))))
(fn place_of ((places (List Place1)) (id Int)) (Option Place1)
  (measure (struct places))
  (match places
    (nil none)
    ((cons (Place1.Place1 i names o a) r)
     (if (= i id) (some (Place1.Place1 i names o a)) (place_of r id)))))

;; ---- the records ---------------------------------------------------------------------------------
;; `FIND …` (the problem as read), then for each answer `FOUND size=N` (for a property
;; `FOUND depth=E matches=D`) with one `ARG i TYPE = VALUE` a goal parameter, one
;; `HOLE F.NAME = EXPRESSION` a hole of a function's body, one `FN (fn NAME ((x0 T) …) RET BODY)`
;; a hole function named by `holes` — source text: its line stands in the place of its
;; `extern`, or in the implementation of its view —, and `MEASURE F (struct x)` where the code
;; makes F call itself; then the verdict and the tally:
;;   FIND: found|none|bounded|gave_up size=N work=W settled=… no=… out=… stuck=… cut=… dead=… unverified=…
;; (for a property `depth=E matches=D` in the place of `size=N`)
(fn found_lines ((f Result)) (List (List Int))
  (cons (Result.asked f)
    (append (answers_lines (Result.answers f) (Result.bound f))
      (list
        (append (utf8 "FIND: ")
          (append (chars_of_sym (Result.verdict f))
            (append (Result.bound f) (show_tally (Result.tally f)))))))))
(fn answers_lines ((ans (List Answer)) (bound (List Int))) (List (List Int))
  (measure (struct ans))
  (match ans
    (nil nil)
    ((cons an r)
     (cons (append (utf8 "FOUND") bound)
       (append (arg_lines (Answer.args an) 0)
         (append (item_lines (Answer.items an))
           (append (measure_lines (Answer.measures an)) (answers_lines r bound))))))))
(fn arg_lines ((xs (List (Prod EType (List Int)))) (i Int)) (List (List Int))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (Prod.mk ty v) r)
     (cons
       (append (utf8 "  ARG ")
         (append (show_nat i) (append (utf8 " ") (append (show_etype ty) (append (utf8 " = ") v)))))
       (arg_lines r (+ i 1))))))
(fn item_lines ((xs (List Got))) (List (List Int))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (GotHole n _ code) r)
     (cons (append (utf8 "  HOLE ") (append (show_name n) (append (utf8 " = ") code)))
       (item_lines r)))
    ((cons (GotFn _ text) r) (cons (append (utf8 "  FN ") text) (item_lines r)))))
(fn measure_lines ((xs (List (Prod Name Name)))) (List (List Int))
  (measure (struct xs))
  (match xs
    (nil nil)
    ((cons (Prod.mk o nm) r)
     (cons
       (append (utf8 "  MEASURE ")
         (append (show_name o) (append (utf8 " (struct ") (append (show_last nm) (utf8 ")")))))
       (measure_lines r)))))
(fn asked_line ((a Ask) (pb Problem)) (List Int)
  (append (utf8 "FIND goal=")
    (append (show_name (Problem.goal pb))
      (append (utf8 " holes=")
        (append (show_nat (len (Problem.holes pb)))
          (append (utf8 " use=")
            (append (show_nat (len (Problem.voc pb)))
              (append (utf8 " size<=")
                (append (show_nat (size_of a))
                  (append (utf8 " fuel<=")
                    (append (show_nat (Ask.fuel a))
                      (append (utf8 " budget=")
                        (append (show_nat (Ask.budget a))
                          (append
                            (if (< 0 (len (Problem.tests pb)))
                              (append (utf8 " tests=") (show_nat (len (Problem.tests pb))))
                              nil)
                            (if (Ask.eager a) (utf8 " enum") nil)))))))))))))))
;; what the round reached was bounded by: the size of what is decided; for a property walked
;; lazily, the depth of a row's expression and the matches above a row (drive.shard `round_of`)
(fn bound_text ((a Ask) (pb Problem) (b Int)) (List Int)
  (if (bool_and (< 0 (len (Problem.tests pb))) (bool_not (Ask.eager a)))
    (match (round_of b 1)
      ((Prod.mk d e)
       (append (utf8 " depth=") (append (show_nat e) (append (utf8 " matches=") (show_nat d))))))
    (append (utf8 " size=") (show_nat b))))
(fn show_tally ((cs (List Int))) (List Int)
  (match cs
    ((cons wk (cons e (cons f (cons o (cons s (cons c (cons n (cons u nil))))))))
     (append (utf8 " work=")
       (append (show_nat wk)
         (append (utf8 " settled=")
           (append (show_nat e)
             (append (utf8 " no=")
               (append (show_nat f)
                 (append (utf8 " out=")
                   (append (show_nat o)
                     (append (utf8 " stuck=")
                       (append (show_nat s)
                         (append (utf8 " cut=")
                           (append (show_nat c)
                             (append (utf8 " dead=")
                               (append (show_nat n) (append (utf8 " unverified=") (show_nat u)))))))))))))))))
    (_ nil)))

;; ---- an answer's code into the sidecars -------------------------------------------------------
;; What was found for the holes of a function's body goes to the sidecar of the file the
;; function stands in, FILE.auto.shard (kernel/sidecar.shard): one `fill-for` a function — its
;; name as the file writes it, the fingerprint of its form as the file has it now, each hole's
;; code, and the measure where the code makes it call itself —, in the place of the entry the
;; function had; the file's other entries, its proofs among them, are kept. A load then reads
;; the function with the code where its holes stand (`FILLED`), and reads its holes as holes
;; again once the function's text changes (`PENDING … fill_stale`). No source file is written.
;; One line a function: `WROTE PATH fill-for FN holes=A,B`, or `NOT-WRITTEN FN: why` — a hole
;; without a name of its own has no entry to stand under; a function in a sealed directory, or
;; whose form its file no longer holds, is not found.
;; A hole function (`holes`) is not written: its line is source for its author to place.
(type Wrote (Wrote (List (List Int)) Bool))  ; the lines; every function was written
(fn write_fills ((l Load) (an Answer) (w World)) (Prod Wrote World)
  (write_owners l an (item_owners (Answer.items an) nil) (Wrote nil true) w))
(fn item_owners ((xs (List Got)) (acc (List Name))) (List Name)
  (measure (struct xs))
  (match xs
    (nil (rev acc))
    ((cons (GotHole _ o _) r) (item_owners r (if (name_mem o acc) acc (cons o acc))))
    ((cons _ r) (item_owners r acc))))
(fn name_mem ((n Name) (xs (List Name))) Bool
  (measure (struct xs))
  (match xs
    (nil false)
    ((cons x r) (if (name_eq x n) true (name_mem n r)))))
(fn write_owners ((l Load) (an Answer) (owners (List Name)) (acc Wrote) (w World))
  (Prod Wrote World)
  (measure (struct owners))
  (match owners
    (nil
      (match acc
        ((Wrote lines ok) (Prod.mk (Wrote (rev lines) ok) w))))
    ((cons o r)
     (match (write_owner l an o w)
       ((Prod.mk (Prod.mk line ok1) w1)
        (match acc
          ((Wrote lines ok) (write_owners l an r (Wrote (cons line lines) (bool_and ok ok1)) w1))))))))
(fn not_written ((o Name) (why (List Int))) (Prod (List Int) Bool)
  (Prod.mk (append (utf8 "NOT-WRITTEN ") (append (show_name o) (append (utf8 ": ") why))) false))
(fn write_owner ((l Load) (an Answer) (o Name) (w World)) (Prod (Prod (List Int) Bool) World)
  (match o
    ((Str md short)
     (match (ld_find_mod (Load.mods l) md)
       (none (Prod.mk (not_written o (utf8 "no file of the load is its module's")) w))
       ((some m)
        (match (owner_pairs (Answer.items an) o nil)
          (none
            (Prod.mk
              (not_written o
                (utf8
                  "a hole without a name, or code that does not read as one form: a sidecar's entry names its hole — write (hole NAME)"))
              w))
          ((some pairs)
           (let
             ((src
                (join_path
                  (append (Load.root l)
                    (match (parts_of (Module.file m))
                      ((some ps) ps)
                      (none nil))))))
             (match (read_file src w)
               ((Prod.mk none w1) (Prod.mk (not_written o (append (utf8 "cannot read ") src)) w1))
               ((Prod.mk (some bs) w1)
                (match (fn_form bs short)
                  (none (Prod.mk (not_written o (append (utf8 "no fn of this name in ") src)) w1))
                  ((some form)
                   (let
                     ((fl
                        (Fill.Fill short (form_fp form) pairs
                          (measure_clause (Answer.measures an) o))))
                     (match (fill_form form fl)
                       ((FitOk _)
                        (put_fill (append (drop_shard_suffix src) (utf8 ".auto.shard")) o fl w1))
                       (_
                         (Prod.mk
                           (not_written o
                             (utf8
                               "the code does not go into the fn's form: a hole it names is missing or stands twice, or the fn states a measure of its own"))
                           w1))))))))))))))
    (_ (Prod.mk (not_written o (utf8 "not a fn's name")) w))))
;; the code of the holes that stand in `o`: each hole's own name with its code read as a form;
;; nothing where one has no name of its own (hole_K: elab.shard generated_name) or its code is
;; not one form
(fn owner_pairs ((xs (List Got)) (o Name) (acc (List (Prod Symbol SExpr))))
  (Option (List (Prod Symbol SExpr)))
  (measure (struct xs))
  (match xs
    (nil (some (rev acc)))
    ((cons (GotHole n own code) r)
     (if (bool_not (name_eq own o)) (owner_pairs r o acc)
     (match n
       ((Str _ a)
        (if (unnamed_hole a) none
        (match (read_all code)
          ((RAOk (cons s nil)) (owner_pairs r o (cons (Prod.mk a s) acc)))
          (_ none))))
       (_ none))))
    ((cons _ r) (owner_pairs r o acc))))
(fn unnamed_hole ((a Symbol)) Bool
  (let ((cs (chars_of_sym a)))
    (bool_and (int_list_eq (take 5 cs) (utf8 "hole_"))
      (bool_and (< 5 (len cs)) (all_digits (drop 5 cs))))))
(fn measure_clause ((ms (List (Prod Name Name))) (o Name)) (Option SExpr)
  (measure (struct ms))
  (match ms
    (nil none)
    ((cons (Prod.mk f nm) r)
     (if (name_eq f o)
       (some
         (SList
           (list (SSym (sym "measure"))
             (SList (list (SSym (sym "struct")) (SSym (sym_of_chars (show_last nm))))))))
       (measure_clause r o)))))
;; the fn's form as its file has it, records expanded as a load expands them
(fn fn_form ((src (List Int)) (short Symbol)) (Option SExpr)
  (match (read_all src)
    ((RAOk forms0)
     (match (expand_records forms0)
       ((RxOk forms) (form_named forms short))
       (_ none)))
    (_ none)))
(fn form_named ((forms (List SExpr)) (short Symbol)) (Option SExpr)
  (measure (struct forms))
  (match forms
    (nil none)
    ((cons (SList (cons (SSym h) (cons (SSym n) rest))) r)
     (if (bool_and (sym_eq h (sym "fn")) (sym_eq n short))
       (some (SList (cons (SSym h) (cons (SSym n) rest))))
       (form_named r short)))
    ((cons _ r) (form_named r short))))
;; the sidecar with the entry in: the file's own numbers kept (this writes no proof and replays
;; none), the current ones for a new file; a sidecar that does not read is left as it is
(fn put_fill ((path (List Int)) (o Name) (fl Fill) (w World)) (Prod (Prod (List Int) Bool) World)
  (match (read_file path w)
    ((Prod.mk bytes w1)
     (match (sidecar_read bytes)
       (none (Prod.mk (not_written o (append path (utf8 " does not read: nothing was written"))) w1))
       ((some (Prod.mk (Prod.mk schema recon) side))
        (match (write_file path (render_sidecar schema recon (side_with_fill side fl)) w1)
          ((Prod.mk true w2)
           (Prod.mk
             (Prod.mk
               (append (utf8 "WROTE ")
                 (append path
                   (append (utf8 " fill-for ")
                     (append (chars_of_sym (fill_owner fl))
                       (append (utf8 " holes=") (fill_holes_text fl))))))
               true)
             w2))
          ((Prod.mk false w2) (Prod.mk (not_written o (append (utf8 "cannot write ") path)) w2))))))))
(fn fill_holes_text ((fl Fill)) (List Int)
  (match fl
    ((Fill _ _ hs _) (syms_text (fill_names hs)))))
(fn syms_text ((ns (List Symbol))) (List Int)
  (measure (struct ns))
  (match ns
    (nil nil)
    ((cons n nil) (chars_of_sym n))
    ((cons n r) (append (chars_of_sym n) (cons 44 (syms_text r))))))
(fn sidecar_read ((bytes (Option (List Int)))) (Option (Prod (Prod Int Int) Side))
  (match bytes
    (none (some (Prod.mk (Prod.mk (sidecar_schema) (reconstruction_version)) (Side.Side nil nil))))
    ((some src)
     (match (read_all src)
       ((RAOk es)
        (match (sidecar_split es)
          ((Prod.mk (some (Prod.mk nums rest)) _)
           (match (sidecar_entries rest nil nil)
             ((Prod.mk (some side) _) (some (Prod.mk nums side)))
             (_ none)))
          (_ none)))
       (_ none)))))
