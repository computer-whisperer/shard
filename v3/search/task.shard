;;; v3/search/task.shard — a search problem, and what makes a stopped search's state an answer.
;;;
;;; THE PROBLEM (`Problem`): the program as the loader gave it and as `ev` links it; the GOAL, a
;;; function of it whose parameters are the unknown values; the program's HOLE FUNCTIONS — the
;;; functions it names and does not define (an `extern`, a view's `sig fn`) that the search is
;;; to find bodies for —; the VOCABULARY, the functions a body may call; the integers an
;;; unknown integer is tried at.
;;;
;;; AN ANSWER IS WHAT `ev` SAYS IT IS. The narrowing machine decides only what a run reads, and
;;; reads a hole function's call only where the program does. So when its goal answers yes,
;;; parts are still undecided, and parts that are decided were never run where `ev` would run
;;; them. `closed_body` and `closed_val` fill what is undecided with the first thing of the
;;; right type (a parameter, zero, a constructor with no field, else the first constructor that
;;; can be filled); `replay` writes the hole functions into the program as ordinary functions —
;;; an `extern`'s calls become calls — and runs the goal on the closed arguments under `ev`.
;;; Only an answer `ev` gives the same yes to is reported (drive.shard counts the others as
;;; `unverified`): a body that satisfies the goal lazily and loops when run in order is not one.

(import "narrow.shard")
(use Init.Bool false true)
(use Init.List cons nil)
(use Init.Option none some)
(use kernel.descent)
(use kernel.ev)
(use kernel.intmap)
(use kernel.name)
(use kernel.prog)
(use kernel.sym)
(use kernel.util)
(use kernel.intmap.IntMap)
(use kernel.name.Name)
(use kernel.prog.EArm)
(use kernel.prog.ECtorDef)
(use kernel.prog.EDecl)
(use kernel.prog.ELit)
(use kernel.prog.EPat)
(use kernel.prog.ERec)
(use kernel.prog.ETerm)
(use kernel.prog.EType)
(use kernel.prog.EvRes)
(use kernel.prog.Prog)
(use kernel.prog.Val)
(use kernel.ev.Door)
(use kernel.ev.IVal)
(use kernel.ev.InvRes)
(use kernel.ev.LArm)
(use kernel.ev.LPat)
(use kernel.ev.Prep)
(use kernel.ev.LTerm)
(use search.narrow)
(use search.narrow.Cell)
(use search.narrow.NVal)

;; a function of the vocabulary: its index, its parameter types and result type, over its own
;; type parameters
(type Voc (Voc Int (List EType) EType))
(record Problem (lk Linked)  ; the program linked
  (decls (List EDecl))  ; the program's declarations
  (inds (IntMap (List (Prod Name EDecl))))  ; its inductives by name
  (voc (List Voc))
  (ints (List Int))
  (goal Name)
  (goal_id Int)
  (goal_tys (List EType))  ; the goal's parameter types: the unknown values — none under tests
  (tests (List (List NVal)))  ; a property's tests: the argument tuples the goal must answer yes on, in order
  (holes (List (Prod Int Name)))  ; the program's hole functions: index and identity
  (base Int)  ; the first index of a hole function the search makes: past every function's
  (fuel Int)  ; the fuel of a branch in the round being walked; a replay gets eight times it
  (depth Int)  ; how deep a row's expression may nest in the round being walked
  (matches Int))  ; under how many matches a row may stand in that round
(type Given (Given Linked (List EDecl) (List Voc) (List Int) Int))
(fn problem_of
  ((pr Given) (goal Name) (goal_id Int) (goal_tys (List EType)) (holes (List (Prod Int Name))))
  Problem
  (match pr
    ((Given.Given lk ds voc ints fuel)
     (make Problem (lk lk) (decls ds) (inds (index_inds ds IMEmpty)) (voc voc) (ints ints)
       (goal goal)
       (goal_id goal_id)
       (goal_tys goal_tys)
       (tests nil)
       (holes holes)
       (base (len ds))
       (fuel fuel)
       (depth 1000000)
       (matches 1000000)))))
;; the problem as a property: the goal must answer yes on each of these argument tuples
(fn problem_tests ((pb Problem) (tests (List (List NVal)))) Problem (with Problem pb (tests tests)))
;; the problem in a round: at this fuel of a branch, this depth of a row's expression and this
;; many matches above a row
(fn problem_round ((pb Problem) (fuel Int) (depth Int) (matches Int)) Problem
  (with Problem pb (fuel fuel) (depth depth) (matches matches)))
(fn ty_is_nat ((n Name)) Bool (name_eq n (n1 (sym "Nat"))))
(fn ty_is_int ((n Name)) Bool (bool_or (name_eq n (n1 (sym "Int"))) (ty_is_nat n)))

;; ---- what is undecided, filled -----------------------------------------------------------------
;; the first thing of a type over the parameters `ptys`: a parameter of the type, zero, the
;; first constructor whose fields can be filled within `d` levels; `LAbsurd` where there is none
(fn default_term ((pb Problem) (ptys (List EType)) (rty EType) (d Int)) LTerm
  (match (first_var ptys rty (- (len ptys) 1))
    ((some i) (LBVar i))
    (none
      (match rty
        ((ETVar _) LAbsurd)
        ((ETCon n targs)
         (if (ty_is_int n) (LLit (IVInt 0))
         (if (< d 1) LAbsurd
         (match (decl_index_find (Problem.inds pb) n)
           ((some (EInd _ _ cs)) (default_ctor pb ptys targs cs d))
           (_ LAbsurd)))))))))
(fn first_var ((rest (List EType)) (rty EType) (i Int)) (Option Int)
  (measure (struct rest))
  (match rest
    (nil none)
    ((cons p more) (if (etype_eq p rty) (some i) (first_var more rty (- i 1))))))
(fn default_ctor
  ((pb Problem) (ptys (List EType)) (targs (List EType)) (cs (List ECtorDef)) (d Int))
  LTerm
  (match cs
    (nil LAbsurd)
    ((cons (ECtorDef.ECtorDef c fts) rest)
     (match (nmap_find (lk_tags (Problem.lk pb)) c)
       (none (default_ctor pb ptys targs rest d))
       ((some tag)
        (match (default_terms pb ptys (subst_tys targs fts) (- d 1) nil)
          ((some fs) (LCtor tag fs))
          (none (default_ctor pb ptys targs rest d))))))))
(fn default_terms ((pb Problem) (ptys (List EType)) (tys (List EType)) (d Int) (acc (List LTerm)))
  (Option (List LTerm))
  (match tys
    (nil (some (rev acc)))
    ((cons ty r)
     (match (default_term pb ptys ty d)
       (LAbsurd none)
       (t (default_terms pb ptys r d (cons t acc)))))))
;; a body with every hole function the search made written out in place: one with a body by
;; that body, one without by the default. A call of one passes its frame's parameters in
;; order, so its body stands where the call stood. `d` bounds the depth written out
(fn close_term ((pb Problem) (m Mach) (t LTerm) (d Int)) LTerm
  (match t
    ((LCall id args)
     (if (<= (Problem.base pb) id)
       (if (< d 1) LAbsurd
       (match (im_find (mach_holes m) id)
         ((some (Hole.Hole _ _ (some b) _)) (close_term pb m b (- d 1)))
         ((some (Hole.Hole ptys rty none _)) (default_term pb ptys rty 4))
         (none LAbsurd)))
       (LCall id (close_terms pb m args d))))
    ((LCtor tag args) (LCtor tag (close_terms pb m args d)))
    ((LMatch s arms) (LMatch (close_term pb m s d) (close_arms pb m arms d)))
    (_ t)))
(fn close_terms ((pb Problem) (m Mach) (ts (List LTerm)) (d Int)) (List LTerm)
  (match ts
    (nil nil)
    ((cons t r) (cons (close_term pb m t d) (close_terms pb m r d)))))
(fn close_arms ((pb Problem) (m Mach) (arms (List LArm)) (d Int)) (List LArm)
  (match arms
    (nil nil)
    ((cons (LArm.LArm p b) r) (cons (LArm.LArm p (close_term pb m b d)) (close_arms pb m r d)))))
;; the body found for one of the program's hole functions, closed: its own where a run needed
;; it, the default where none did
(fn closed_body ((pb Problem) (m Mach) (id Int)) LTerm
  (match (im_find (mach_holes m) id)
    ((some (Hole.Hole _ _ (some b) _)) (close_term pb m b 64))
    ((some (Hole.Hole ptys rty none _)) (default_term pb ptys rty 4))
    (none LAbsurd)))
;; the first value of a type: zero, the first constructor whose fields can be filled
(fn default_val ((pb Problem) (ty EType) (d Int)) (Option Val)
  (match ty
    ((ETVar _) none)
    ((ETCon n targs)
     (if (ty_is_int n) (some (VInt 0))
     (if (< d 1) none
     (match (decl_index_find (Problem.inds pb) n)
       ((some (EInd _ _ cs)) (default_val_ctor pb targs cs d))
       (_ none)))))))
(fn default_val_ctor ((pb Problem) (targs (List EType)) (cs (List ECtorDef)) (d Int)) (Option Val)
  (match cs
    (nil none)
    ((cons (ECtorDef.ECtorDef c fts) rest)
     (match (default_vals pb (subst_tys targs fts) (- d 1) nil)
       ((some fs) (some (VCtor c fs)))
       (none (default_val_ctor pb targs rest d))))))
(fn default_vals ((pb Problem) (tys (List EType)) (d Int) (acc (List Val))) (Option (List Val))
  (match tys
    (nil (some (rev acc)))
    ((cons ty r)
     (match (default_val pb ty d)
       (none none)
       ((some v) (default_vals pb r d (cons v acc)))))))
;; a value of the machine as closed data: read through the heap, an unknown by its type's
;; default; none where a part has no default or is a call not run
(fn closed_val ((pb Problem) (h Heap) (v NVal)) (Option Val)
  (match v
    ((NInt k) (some (VInt k)))
    ((NCtor tag fs)
     (match (closed_vals pb h fs nil)
       (none none)
       ((some vs)
        (some
          (VCtor
            (match (im_find (lk_names (Problem.lk pb)) tag)
              ((some n) n)
              (none Anon))
            vs)))))
    ((NRef r)
     (match (heap_find h r)
       ((some (CVal w)) (closed_val pb h w))
       ((some (CUnk ty)) (default_val pb ty 4))
       (_ none)))))
(fn closed_vals ((pb Problem) (h Heap) (vs (List NVal)) (acc (List Val))) (Option (List Val))
  (match vs
    (nil (some (rev acc)))
    ((cons v r)
     (match (closed_val pb h v)
       (none none)
       ((some w) (closed_vals pb h r (cons w acc)))))))
;; the goal's arguments in a heap: the first cells, one a parameter
(fn goal_args ((pb Problem) (h Heap)) (Option (List Val))
  (closed_vals pb h (arg_refs 0 (len (Problem.goal_tys pb))) nil))
(fn arg_refs ((i Int) (n Int)) (List NVal)
  (measure (Int.natAbs (- n i)))
  (if (<= n i) nil (cons (NRef i) (arg_refs (+ i 1) n))))
(fulfills arg_refs.dec_1 (by (intro p h) (apply natAbs_lt (arith) (arith))))

;; ---- the program with the hole functions written in ---------------------------------------------
;; a closed linked term as a program's term: variables, integers, cells, calls
(fn eterm_of ((lk Linked) (t LTerm)) ETerm
  (match t
    ((LBVar i) (EBVar i))
    ((LLit v) (eterm_of_val lk v))
    ((LCtor tag args) (ECtor (tag_name lk tag) (eterms_of lk args)))
    ((LCall id args) (ECall (fn_name lk id) (eterms_of lk args)))
    ((LMatch s arms) (EMatch (eterm_of lk s) (earms_of lk arms)))
    (_ EAbsurd)))
(fn eterms_of ((lk Linked) (ts (List LTerm))) (List ETerm)
  (match ts
    (nil nil)
    ((cons t r) (cons (eterm_of lk t) (eterms_of lk r)))))
(fn earms_of ((lk Linked) (arms (List LArm))) (List EArm)
  (match arms
    (nil nil)
    ((cons (LArm.LArm p b) r) (cons (EArm.EArm (epat_of lk p) (eterm_of lk b)) (earms_of lk r)))))
(fn epat_of ((lk Linked) (p LPat)) EPat
  (match p
    (LPVar PVar)
    ((LPInt k) (PLit (if (< k 0) (LInt k) (LNat k))))
    ((LPCtor tag subs) (PCtor (tag_name lk tag) (epats_of lk subs)))))
(fn epats_of ((lk Linked) (ps (List LPat))) (List EPat)
  (match ps
    (nil nil)
    ((cons p r) (cons (epat_of lk p) (epats_of lk r)))))
(fn eterm_of_val ((lk Linked) (v IVal)) ETerm
  (match v
    ((IVInt k) (ELit (if (< k 0) (LInt k) (LNat k))))
    ((IVCtor tag vs) (ECtor (tag_name lk tag) (eterms_of_vals lk vs)))))
(fn eterms_of_vals ((lk Linked) (vs (List IVal))) (List ETerm)
  (match vs
    (nil nil)
    ((cons v r) (cons (eterm_of_val lk v) (eterms_of_vals lk r)))))
(fn tag_name ((lk Linked) (tag Int)) Name
  (match (im_find (lk_names lk) tag)
    ((some n) n)
    (none Anon)))
;; the bodies found for the program's hole functions, by identity
(fn fills_of ((pb Problem) (m Mach) (hs (List (Prod Int Name)))) (List (Prod Name ETerm))
  (measure (struct hs))
  (match hs
    (nil nil)
    ((cons (Prod.mk id n) r)
     (cons (Prod.mk n (eterm_of (Problem.lk pb) (closed_body pb m id))) (fills_of pb m r)))))
(fn fill_find ((fs (List (Prod Name ETerm))) (n Name)) (Option ETerm)
  (measure (struct fs))
  (match fs
    (nil none)
    ((cons (Prod.mk k b) r) (if (name_eq k n) (some b) (fill_find r n)))))
;; the declarations with each filled hole function a function of that body, and every extern
;; call of one a call
(fn fill_decls ((ds (List EDecl)) (fs (List (Prod Name ETerm)))) (List EDecl)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d r) (cons (fill_decl d fs) (fill_decls r fs)))))
(fn fill_decl ((d EDecl) (fs (List (Prod Name ETerm)))) EDecl
  (match d
    ((EFn n k ps rt rec body) (EFn n k ps rt rec (calls_in fs body)))
    ((EExtern n k ps rt)
     (match (fill_find fs n)
       ((some b) (EFn n k ps rt RecNone b))
       (none d)))
    ((ESig n k ps rt)
     (match (fill_find fs n)
       ((some b) (EFn n k ps rt RecNone b))
       (none d)))
    (_ d)))
(fn calls_in ((fs (List (Prod Name ETerm))) (t ETerm)) ETerm
  (match t
    ((ECtor c as) (ECtor c (calls_in_all fs as)))
    ((ECall f as) (ECall f (calls_in_all fs as)))
    ((EPrim f as) (EPrim f (calls_in_all fs as)))
    ((EExt f as)
     (match (fill_find fs f)
       ((some _) (ECall f (calls_in_all fs as)))
       (none (EExt f (calls_in_all fs as)))))
    ((EMatch s arms) (EMatch (calls_in fs s) (calls_in_arms fs arms)))
    ((ELet rs b) (ELet (calls_in_all fs rs) (calls_in fs b)))
    ((EIf a b c) (EIf (calls_in fs a) (calls_in fs b) (calls_in fs c)))
    ((ELam ts rt b) (ELam ts rt (calls_in fs b)))
    (_ t)))
(fn calls_in_all ((fs (List (Prod Name ETerm))) (ts (List ETerm))) (List ETerm)
  (match ts
    (nil nil)
    ((cons t r) (cons (calls_in fs t) (calls_in_all fs r)))))
(fn calls_in_arms ((fs (List (Prod Name ETerm))) (arms (List EArm))) (List EArm)
  (match arms
    (nil nil)
    ((cons (EArm.EArm p b) r) (cons (EArm.EArm p (calls_in fs b)) (calls_in_arms fs r)))))
(fn filled_prog ((pb Problem) (m Mach)) Prog
  (Prog.Prog (fill_decls (Problem.decls pb) (fills_of pb m (Problem.holes pb)))))

;; ---- the replay ----------------------------------------------------------------------------------
;; the goal of the filled program under `ev`, linked once: is its answer the constructor `yes` —
;; on the closed arguments in the heap, or, for a property, on every test
(fn replay ((pb Problem) (m Mach) (h Heap) (yes Name) (fuel Int)) Bool
  (match (prepare (filled_prog pb m) (Problem.goal pb) (policy_of Assumed false nil fuel))
    ((PrepNo _ _) false)
    ((PrepOk hd)
     (match (Problem.tests pb)
       (nil
         (match (goal_args pb h)
           (none false)
           ((some args) (replay_one hd args yes))))
       (tests (replay_tests pb hd tests yes))))))
(fn replay_one ((hd Handle) (args (List Val)) (yes Name)) Bool
  (match (invoke hd args)
    ((InvRan (EvOk (VCtor c _))) (name_eq c yes))
    (_ false)))
(fn replay_tests ((pb Problem) (hd Handle) (tests (List (List NVal))) (yes Name)) Bool
  (measure (struct tests))
  (match tests
    (nil true)
    ((cons args r)
     (match (closed_vals pb (heap_empty) args nil)
       (none false)
       ((some vs) (if (replay_one hd vs yes) (replay_tests pb hd r yes) false))))))

;; ---- the text ------------------------------------------------------------------------------------
;; a closed body over n parameters as source text: the parameters are x0 … in order
(fn show_body ((lk Linked) (n Int) (t LTerm)) (List Int)
  (match t
    ((LBVar i) (cons 120 (show_nat (- (- n 1) i))))
    ((LLit (IVInt k)) (show_int k))
    ((LCtor tag nil) (show_name (tag_name lk tag)))
    ((LCtor tag args)
     (append (utf8 "(")
       (append (show_name (tag_name lk tag)) (append (show_bodies lk n args) (utf8 ")")))))
    ((LCall id args)
     (append (utf8 "(")
       (append (show_name (fn_name lk id)) (append (show_bodies lk n args) (utf8 ")")))))
    ((LMatch s arms)
     (append (utf8 "(match ") (append (show_body lk n s) (append (show_arms lk n arms) (utf8 ")")))))
    (_ (utf8 "?"))))
;; a row: its pattern — a constructor over new variables, numbered on from the frame's — and its
;; body in the frame with them
(fn show_arms ((lk Linked) (n Int) (arms (List LArm))) (List Int)
  (match arms
    (nil nil)
    ((cons (LArm.LArm p b) r)
     (append (utf8 " (")
       (append (show_pat lk n p)
         (append (utf8 " ")
           (append (show_body lk (+ n (row_vars p)) b) (append (utf8 ")") (show_arms lk n r)))))))))
(fn row_vars ((p LPat)) Int
  (match p
    ((LPCtor _ subs) (len subs))
    (LPVar 1)
    (_ 0)))
(fn show_pat ((lk Linked) (n Int) (p LPat)) (List Int)
  (match p
    ((LPCtor tag nil) (show_name (tag_name lk tag)))
    ((LPCtor tag subs)
     (append (utf8 "(")
       (append (show_name (tag_name lk tag)) (append (show_pat_vars n (len subs)) (utf8 ")")))))
    ((LPInt k) (show_int k))
    (LPVar (cons 120 (show_nat n)))))
(fn show_pat_vars ((n Int) (k Int)) (List Int)
  (measure (Int.natAbs k))
  (if (< k 1) nil (append (utf8 " x") (append (show_nat n) (show_pat_vars (+ n 1) (- k 1))))))
(fulfills show_pat_vars.dec_1 (by (intro p h) (apply natAbs_pred (arith))))
(fn show_bodies ((lk Linked) (n Int) (ts (List LTerm))) (List Int)
  (match ts
    (nil nil)
    ((cons t r) (cons 32 (append (show_body lk n t) (show_bodies lk n r))))))
;; a value as source text
(fn show_val ((v Val)) (List Int)
  (match v
    ((VInt k) (show_int k))
    ((VCtor c nil) (show_name c))
    ((VCtor c vs) (append (utf8 "(") (append (show_name c) (append (show_vals vs) (utf8 ")")))))))
(fn show_vals ((vs (List Val))) (List Int)
  (match vs
    (nil nil)
    ((cons v r) (cons 32 (append (show_val v) (show_vals r))))))
;; a hole function as a definition: (fn NAME ((x0 T) …) RET BODY), NAME its last component —
;; with (measure (struct xP)) where the body calls the function itself and every such call passes
;; a proper part at position P
(fn show_fn ((pb Problem) (m Mach) (id Int) (n Name)) (List Int)
  (match (im_find (mach_holes m) id)
    ((some (Hole.Hole ptys rty _ _))
     (let ((body (closed_body pb m id)) (ar (len ptys)))
       (append (utf8 "(fn ")
         (append (show_last n)
           (append (utf8 " (")
             (append (show_binders ptys 0)
               (append (utf8 ") ")
                 (append (show_etype rty)
                   (append
                     (match (struct_pos (rec_calls body (Prod.mk id ar) ar nil) 0 ar)
                       ((some q)
                        (append (utf8 " (measure (struct x") (append (show_nat q) (utf8 "))"))))
                       (none nil))
                     (append (utf8 " ") (append (show_body (Problem.lk pb) ar body) (utf8 ")"))))))))))))
    (none (utf8 "?"))))
;; the calls of the function `root` (its index and number of parameters) in a body, each as its
;; arguments' answers to: is this a variable that is none of the function's own parameters — by
;; the way such calls are made (drive.shard `prod_rec`) a proper part of one. `n` is the frame
(fn rec_calls ((t LTerm) (root (Prod Int Int)) (n Int) (acc (List (List Bool)))) (List (List Bool))
  (match t
    ((LCall id args)
     (rec_calls_all args root n
       (match root
         ((Prod.mk rid ar) (if (= id rid) (cons (part_flags args n ar) acc) acc)))))
    ((LCtor _ args) (rec_calls_all args root n acc))
    ((LMatch s arms) (rec_calls_arms arms root n (rec_calls s root n acc)))
    (_ acc)))
(fn rec_calls_all ((ts (List LTerm)) (root (Prod Int Int)) (n Int) (acc (List (List Bool))))
  (List (List Bool))
  (match ts
    (nil acc)
    ((cons t r) (rec_calls_all r root n (rec_calls t root n acc)))))
(fn rec_calls_arms ((arms (List LArm)) (root (Prod Int Int)) (n Int) (acc (List (List Bool))))
  (List (List Bool))
  (match arms
    (nil acc)
    ((cons (LArm.LArm p b) r) (rec_calls_arms r root n (rec_calls b root (+ n (row_vars p)) acc)))))
(fn part_flags ((args (List LTerm)) (n Int) (ar Int)) (List Bool)
  (measure (struct args))
  (match args
    (nil nil)
    ((cons (LBVar i) r) (cons (<= ar (- (- n 1) i)) (part_flags r n ar)))
    ((cons _ r) (cons false (part_flags r n ar)))))
;; the first position at which every call passes a proper part; none without a call
(fn struct_pos ((calls (List (List Bool))) (q Int) (ar Int)) (Option Int)
  (measure (Int.natAbs (- ar q)))
  (match calls
    (nil none)
    (_
      (if (<= ar q) none
      (if (all_at calls q) (some q)
      (struct_pos calls (+ q 1) ar))))))
(fn all_at ((calls (List (List Bool))) (q Int)) Bool
  (measure (struct calls))
  (match calls
    (nil true)
    ((cons flags r)
     (match (nth flags q)
       ((some true) (all_at r q))
       (_ false)))))
(fulfills struct_pos.dec_1 (by (intro p x hc h hn) (apply natAbs_lt (arith) (arith))))
(fn show_last ((n Name)) (List Int)
  (match n
    ((Str _ s) (chars_of_sym s))
    (_ (show_name n))))
(fn show_binders ((ptys (List EType)) (i Int)) (List Int)
  (measure (struct ptys))
  (match ptys
    (nil nil)
    ((cons p r)
     (append (if (= i 0) nil (utf8 " "))
       (append (utf8 "(x")
         (append (show_nat i)
           (append (utf8 " ") (append (show_etype p) (append (utf8 ")") (show_binders r (+ i 1)))))))))))
