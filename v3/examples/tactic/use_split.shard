;;; v3/examples/tactic/use_split.shard — theorems delegated to the library (v3/LANGUAGE.md §8.4
;;; slice 3.29 rules 2, 8 and 9): each names examples.tactic.bool_split.solve in its delegation;
;;; prove.shard ran it and wrote the blocks into use_split.auto.shard beside this file —
;;; machine-owned, keyed by each statement's fingerprint, the entries indistinguishable from
;;; the engine's. The build replays the sidecar and never runs the library;
;;; kernel/test/tactic_lib_test.sh regenerates it, has the engine solve the same statements,
;;; and replays, stores and verifies both.
(import "bool_split.shard")
(import Init List.length_append)

(theorem and_comm ((a Bool) (b Bool)) (= (and a b) (and b a)) (auto (tactic examples.tactic.bool_split.solve)))
(theorem and_assoc ((a Bool) (b Bool) (c Bool)) (= (and (and a b) c) (and a (and b c))) (auto (tactic examples.tactic.bool_split.solve)))
(theorem de_morgan ((a Bool) (b Bool)) (= (not (and a b)) (or (not a) (not b))) (auto (tactic examples.tactic.bool_split.solve)))
(theorem excluded ((a Bool)) (= (or a (not a)) Bool.true) (auto (tactic examples.tactic.bool_split.solve)))
(theorem le_self ((n Nat)) (<= n n) (auto (tactic examples.tactic.bool_split.solve)))
(theorem eq_self ((n Nat)) (= n n) (auto (tactic examples.tactic.bool_split.solve)))
