;;; v3/examples/calc/calc_spec_tests.shard — examples/calc/calc_spec_tests.shard
;;; at slice 6: nine ground claims over spec_run and no program. Slice 3.20: the
;;; claims are theorems by `(reduce lhs) rfl` — the left side computed by the
;;; functions' equations (a measured one's by WellFounded.fix_eq, applied to a
;;; closed occurrence) and K's whnf, then Eq.refl.

(import "calc_spec.shard")
(import Init WellFounded.fix_eq)   ; the measured parse_tail's equation is by fix_eq
(use examples.calc.calc_spec)
(use Init.Option)

(theorem t_1plus2 () (= (spec_run (list 49 43 50)) (some 3)) (by (reduce lhs) rfl))
(theorem t_ws () (= (spec_run (list 49 32 43 32 50)) (some 3)) (by (reduce lhs) rfl))
(theorem t_sub () (= (spec_run (list 49 50 45 51)) (some 9)) (by (reduce lhs) rfl))
(theorem t_chain () (= (spec_run (list 49 43 50 45 51)) (some 0)) (by (reduce lhs) rfl))
(theorem t_garbage () (= (spec_run (list 49 64 43 50)) none) (by (reduce lhs) rfl))
(theorem t_leadop () (= (spec_run (list 43 49)) none) (by (reduce lhs) rfl))
(theorem t_empty () (= (spec_run (list)) none) (by (reduce lhs) rfl))
(theorem t_trailop () (= (spec_run (list 49 43)) none) (by (reduce lhs) rfl))
(theorem t_twonum () (= (spec_run (list 49 32 50)) none) (by (reduce lhs) rfl))
