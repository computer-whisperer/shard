;;; v3/examples/calc/calc_ndigit.shard — digits as a ten-constructor type
;;; and the n-digit lexer/value functions, examples/calc/calc_ndigit.shard
;;; ported to S at slice 6; its twelve claims (run_ndigit_adds and the
;;; structural lemmas) wait for phase 3's I.

(import "calc_proof.shard")
(import "list.shard")
(use examples.calc.calc)
(use examples.calc.list)
(use Init.List)

(type Digit (D0) (D1) (D2) (D3) (D4) (D5) (D6) (D7) (D8) (D9))

(fn dval ((d Digit)) Int
  (match d
    (D0 0) (D1 1) (D2 2) (D3 3) (D4 4)
    (D5 5) (D6 6) (D7 7) (D8 8) (D9 9)))

;; a digit's ASCII codepoint ('0' = 48)
(fn code ((d Digit)) Int (+ 48 (dval d)))

;; a digit sequence to its codepoint string
(fn codes ((ds (List Digit))) (List Int)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d rest) (cons (code d) (codes rest)))))

;; Horner accumulator, MSD-first
(fn value_go ((ds (List Digit)) (acc Int)) Int
  (measure (struct ds))
  (match ds
    (nil acc)
    ((cons d rest) (value_go rest (+ (* acc 10) (dval d))))))

;; the numeric value of a non-empty digit sequence
(fn value ((ds (List Digit))) Int
  (match ds
    (nil 0)
    ((cons d rest) (value_go rest (dval d)))))
