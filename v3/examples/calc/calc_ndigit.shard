;;; v3/examples/calc/calc_ndigit.shard — digits as a ten-constructor type
;;; and the n-digit lexer/value functions, examples/calc/calc_ndigit.shard
;;; ported to S at slice 6; of its twelve claims the six structural lemmas
;;; are blocks since slice 3.20 (below), run_ndigit_adds and its kin wait
;;; for 3.21's arith.

(import "calc_proof.shard")
(import "list.shard")
(use examples.calc.calc)
(use examples.calc.list)
(use Init.List cons nil)
(use Init.Option)
(use Init.Bool)
(use examples.calc.calc.Token)
(use examples.calc.calc_ndigit.Digit)

(type Digit (D0) (D1) (D2) (D3) (D4) (D5) (D6) (D7) (D8) (D9))

(fn dval ((d Digit)) Int
  (match d
    (D0 0) (D1 1) (D2 2) (D3 3) (D4 4)
    (D5 5) (D6 6) (D7 7) (D8 8) (D9 9)))

;; a digit's ASCII codepoint ('0' = 48)
(fn code ((d Digit)) Int (+ 48 (dval d)))

;; a digit sequence to its codepoint string
(fn codes ((ds (List Digit))) (List Int)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d rest) (cons (code d) (codes rest)))))

;; Horner accumulator, MSD-first
(fn value_go ((ds (List Digit)) (acc Int)) Int
  (measure (struct ds))
  (match ds
    (nil acc)
    ((cons d rest) (value_go rest (+ (* acc 10) (dval d))))))

;; the numeric value of a non-empty digit sequence
(fn value ((ds (List Digit))) Int
  (match ds
    (nil 0)
    ((cons d rest) (value_go rest (dval d)))))

;;; Slice 3.20: the structural lemmas as blocks (run_ndigit_adds and its kin
;;; wait for 3.21's arith). `is_digit_code`: a case split over the ten digits,
;;; each closed by decide — the codepoint's two comparisons at Int, decided.
(theorem codes_cons ((d Digit) (ds (List Digit))) (= (codes (cons d ds)) (cons (code d) (codes ds)))
  (by (reduce lhs) rfl))
(theorem append_int_cons ((h Int) (t (List Int)) (ys (List Int))) (= (append (cons h t) ys) (cons h (append t ys)))
  (by (reduce lhs) rfl))
(theorem value_go_cons ((d Digit) (ds (List Digit)) (acc Int)) (= (value_go (cons d ds) acc) (value_go ds (+ (* acc 10) (dval d))))
  (by (reduce lhs) rfl))
(theorem value_cons ((d Digit) (ds (List Digit))) (= (value (cons d ds)) (value_go ds (dval d)))
  (by (reduce lhs) rfl))
(theorem is_digit_code ((d Digit)) (= (is_digit (code d)) true)
  (by (cases d
        ((D0 () decide) (D1 () decide) (D2 () decide) (D3 () decide) (D4 () decide)
         (D5 () decide) (D6 () decide) (D7 () decide) (D8 () decide) (D9 () decide)))))
(theorem lex_plus ((v Int) (cs (List Int))) (= (lex_go (cons 43 cs) (some v)) (cons (TNum v) (cons TPlus (lex_go cs none))))
  (by (reduce lhs) rfl))
