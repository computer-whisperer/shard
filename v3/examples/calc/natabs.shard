;;; v3/examples/calc/natabs.shard — the descent fact of an Int measure
;;; (slice 3.21). `show` and `show_nat` recurse on a quotient under the
;;; measure (Int.natAbs n); the obligation Int.natAbs (n / 10) < Int.natAbs n
;;; is linear arithmetic once natAbs is the identity on a non-negative Int.
;;; Init has both lemmas past the prefix these files import (line 672,885 of
;;; the export), so they are proven here from the constructors.

(import Init Int.lt_mul_ediv_self_add)   ; through Lean.Omega's kit with the product and the quotient's bounds: arith's (§8.4 slice 3.21)

(theorem natAbs_of_nonneg ((a Int)) (-> (<= 0 a) (= (Int.ofNat (Int.natAbs a)) a))
  (by (cases a
        ((ofNat (n) (intro h) rfl)
         (negSucc (n) (intro h) (arith (Int.negSucc_lt_zero n)))))))
;; a smaller non-negative Int has the smaller natAbs
(theorem natAbs_lt ((a Int) (b Int) (h0 (<= 0 a)) (h1 (< a b))) (< (Int.natAbs a) (Int.natAbs b))
  (by (have hb (<= 0 b) (arith))
      (arith (natAbs_of_nonneg a h0) (natAbs_of_nonneg b hb))))
