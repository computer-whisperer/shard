;;; v3/examples/calc/calc_reconcile_tests.shard — examples/calc/
;;; calc_reconcile_tests.shard at slice 6: eleven ground claims that run and
;;; spec_run agree on named inputs and no program. Slice 3.20: theorems by
;;; `(reduce) rfl` — both sides computed, then Eq.refl.

(import "calc_spec.shard")
(import Init WellFounded.fix_eq)   ; the measured parse_tail's equation is by fix_eq
(use examples.calc.calc_spec)
(use examples.calc.calc)

(theorem r_1plus2 () (= (run (list 49 43 50)) (spec_run (list 49 43 50))) (by (reduce) rfl))
(theorem r_ws () (= (run (list 49 32 43 32 50)) (spec_run (list 49 32 43 32 50))) (by (reduce) rfl))
(theorem r_sub () (= (run (list 49 50 45 51)) (spec_run (list 49 50 45 51))) (by (reduce) rfl))
(theorem r_chain () (= (run (list 49 43 50 45 51)) (spec_run (list 49 43 50 45 51))) (by (reduce) rfl))
(theorem r_garbage () (= (run (list 49 64 43 50)) (spec_run (list 49 64 43 50))) (by (reduce) rfl))
(theorem r_garbage2 () (= (run (list 49 64 50)) (spec_run (list 49 64 50))) (by (reduce) rfl))
(theorem r_leadop () (= (run (list 43 49)) (spec_run (list 43 49))) (by (reduce) rfl))
(theorem r_empty () (= (run (list)) (spec_run (list))) (by (reduce) rfl))
(theorem r_trailop () (= (run (list 49 43)) (spec_run (list 49 43))) (by (reduce) rfl))
(theorem r_twonum () (= (run (list 49 32 50)) (spec_run (list 49 32 50))) (by (reduce) rfl))
(theorem r_tabnl () (= (run (list 49 9 45 10 50)) (spec_run (list 49 9 45 10 50))) (by (reduce) rfl))
