;;; v3/examples/calc/calc_bin_model.shard — the bolt bundle tested on a model host (LANGUAGE.md
;;; §8.6 slice 4.3 landing 2, rule 6 (e); law §4.7 (ii)): the nine axioms calc's bin trusts
;;; (`calc_bin.shard`), instantiated at a pure model of the host — the arguments, the lines
;;; written, the files read and the exit as data, the three externs as functions over it, the
;;; three observables as projections — and proven as theorems, each by computation; then a
;;; ground run of three calls decided. The bundle is consistent because this model satisfies
;;; it; what the bin assumes of the host is what this model does. The lines are the model's
;;; codes, as the model world's are (`calc_app_world.shard`), the byte type of the bin's
;;; observables standing in by its codes.
;;;
;;;   load.shard --root v3 --init … v3/examples/calc/calc_bin_model.shard   → ten theorems ACCEPT

(import Init Prod.mk.inj)   ; past Int.decEq, congrArg and List.append's realization (std/list)
(import "../../std/list.shard")
(use std.list)
(use Init.List cons nil)
(use Init.Option)

;; the model host: the arguments, the lines written, the files read, the exit code
(type Host (Host (List (List Int)) (List (List Int)) (List (List Int)) (Option Int)))

;; the observables
(fn h_output ((h Host)) (List (List Int)) (match h ((Host a o r e) o)))
(fn h_reads ((h Host)) (List (List Int)) (match h ((Host a o r e) r)))
(fn h_exit ((h Host)) (Option Int) (match h ((Host a o r e) e)))

;; the externs
(fn h_get_args ((h Host)) (Prod (List (List Int)) Host) (match h ((Host a o r e) (Prod.mk a h))))
(fn h_write_line ((bs (List Int)) (h Host)) Host (match h ((Host a o r e) (Host a (List.append o (cons bs nil)) r e))))
(fn h_exit_call ((code Int) (h Host)) Host (match h ((Host a o r e) (Host a o r (some code)))))

;; the nine bolts, at the model
(theorem m_get_args_output ((h Host) (lines (List (List Int))) (h1 Host)) (-> (= (h_get_args h) (Prod.mk lines h1)) (= (h_output h1) (h_output h)))
  (by (intro hg) (cases h ((Host (a o r e) (have hg2 (= (Prod.mk a (Host.Host a o r e)) (Prod.mk lines h1)) (exact hg)) (have e2 (= (Host.Host a o r e) h1) (exact (congrArg Prod.snd hg2))) (rw (<- e2)) rfl)))))
(theorem m_get_args_reads ((h Host) (lines (List (List Int))) (h1 Host)) (-> (= (h_get_args h) (Prod.mk lines h1)) (= (h_reads h1) (h_reads h)))
  (by (intro hg) (cases h ((Host (a o r e) (have hg2 (= (Prod.mk a (Host.Host a o r e)) (Prod.mk lines h1)) (exact hg)) (have e2 (= (Host.Host a o r e) h1) (exact (congrArg Prod.snd hg2))) (rw (<- e2)) rfl)))))
(theorem m_get_args_exit ((h Host) (lines (List (List Int))) (h1 Host)) (-> (= (h_get_args h) (Prod.mk lines h1)) (= (h_exit h1) (h_exit h)))
  (by (intro hg) (cases h ((Host (a o r e) (have hg2 (= (Prod.mk a (Host.Host a o r e)) (Prod.mk lines h1)) (exact hg)) (have e2 (= (Host.Host a o r e) h1) (exact (congrArg Prod.snd hg2))) (rw (<- e2)) rfl)))))
(theorem m_write_line_output ((bs (List Int)) (h Host)) (= (h_output (h_write_line bs h)) (List.append (h_output h) (cons bs nil)))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))
(theorem m_write_line_reads ((bs (List Int)) (h Host)) (= (h_reads (h_write_line bs h)) (h_reads h))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))
(theorem m_write_line_exit ((bs (List Int)) (h Host)) (= (h_exit (h_write_line bs h)) (h_exit h))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))
(theorem m_exit_output ((code Int) (h Host)) (= (h_output (h_exit_call code h)) (h_output h))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))
(theorem m_exit_reads ((code Int) (h Host)) (= (h_reads (h_exit_call code h)) (h_reads h))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))
(theorem m_exit_exit ((code Int) (h Host)) (= (h_exit (h_exit_call code h)) (some code))
  (by (cases h ((Host (a o r e) (reduce) rfl)))))

;; a ground run of three calls on the model, computed: two lines written, then an exit
(theorem m_ground () (= (h_exit_call 0 (h_write_line (cons 55 nil) (h_write_line (cons 51 nil) (Host.Host nil nil nil none))))
                        (Host.Host nil (cons (cons 51 nil) (cons (cons 55 nil) nil)) nil (some 0)))
  (by (reduce) rfl))
