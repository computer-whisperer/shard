;;; v3/examples/calc/calc_app_world.shard — the loop closed against a world
;;; datum, examples/calc/calc_app_world.shard ported to S at slice 6: the
;;; Action interpreter as data and the run as a pure fold threading the
;;; world; the end-to-end claim run_eq_spec_world since slice 3.21.

(import "calc_app_trace.shard")
(use examples.calc.calc_app)
(use examples.calc.calc_app_trace)
(use examples.calc.list)
(use Init.List cons nil)   ; selectively: `append` is this example's own (list.shard), not Init's List.append
(use examples.calc.calc_app.Action)

;; CalcWorld: stdout as a list of printed lines
(type CalcWorld (CalcWorld (List (List Int))))

;; apply_action: the Action interpreter, as data
(fn apply_action ((w CalcWorld) (a Action)) CalcWorld
  (match w
    ((CalcWorld out)
     (match a
       ((Print cs) (CalcWorld (append out (cons cs nil))))
       ((Exit n) (CalcWorld out))
       (Nop (CalcWorld out))))))

(fn run_world ((w CalcWorld) (s CalcState) (events (List (List Int)))) CalcWorld
  (measure (struct events))
  (match events
    (nil w)
    ((cons e rest)
     (run_world (apply_action w (emitted s e)) (next_state s e) rest))))

(fn run_world_spec ((w CalcWorld) (s CalcState) (events (List (List Int)))) CalcWorld
  (measure (struct events))
  (match events
    (nil w)
    ((cons e rest)
     (run_world_spec (apply_action w (emitted_spec s e)) (next_state_spec s e) rest))))

;;; Slice 3.21: the driven world agrees with its spec-side mirror on every event list, the
;;; world and the state quantified in the induction.
(theorem run_eq_spec_world ((events (List (List Int)))) (forall ((w CalcWorld) (s CalcState)) (= (run_world w s events) (run_world_spec w s events)))
  (by (induction events
        ((nil () (intro w s) (reduce) rfl)
         (cons (e r ih) (intro w s) (reduce)
           (simp_only emitted_eq_spec next_state_eq_spec)
           (exact (ih (apply_action w (emitted_spec s e)) (next_state_spec s e))))))))
