;;; v3/examples/calc/calc_show_run.shard — the digit spec over Int values,
;;; examples/calc/calc_show_run.shard ported to S at slice 6: `codes` maps
;;; digit values to codepoints; of the seventeen claims building toward
;;;   run (codes (show n) ++ "+" ++ codes (show m)) = some (n + m)
;;; five are blocks since slice 3.20 (below); the rest wait for 3.21's arith.

(import "calc_show.shard")
(import "calc_proof.shard")
(use examples.calc.calc_show)
(use examples.calc.calc)
(use examples.calc.list)
(use Init.List cons nil)
(use Init.Option)
(use examples.calc.calc.Token)

;; digit-value list -> codepoint list
(fn codes ((ds (List Int))) (List Int)
  (measure (struct ds))
  (match ds
    (nil nil)
    ((cons d rest) (cons (+ 48 d) (codes rest)))))

;;; Slice 3.20: the claims whose lemma closure needs no arithmetic, as blocks
;;; (the rest wait for 3.21's arith). A structural function computes by its
;;; equations under `reduce`; `lex_go` under `(some v)` at a nil input flushes.
(theorem lex_nil ((v Int)) (= (lex_go nil (some v)) (cons (TNum v) nil))
  (by (reduce lhs) rfl))
(theorem lex_plus ((v Int) (cs (List Int))) (= (lex_go (cons 43 cs) (some v)) (cons (TNum v) (cons TPlus (lex_go cs none))))
  (by (reduce lhs) rfl))
(theorem codes_cons ((d Int) (ds (List Int))) (= (codes (cons d ds)) (cons (+ 48 d) (codes ds)))
  (by (reduce lhs) rfl))
(theorem append_int_cons ((h Int) (t (List Int)) (ys (List Int))) (= (append (cons h t) ys) (cons h (append t ys)))
  (by (reduce lhs) rfl))
(theorem codes_append ((xs (List Int)) (ys (List Int))) (= (codes (append xs ys)) (append (codes xs) (codes ys)))
  (by (induction xs
        ((nil () (reduce) rfl)
         (cons (x r ih) (reduce) (rw ih) rfl)))))
