;;; v3/examples/calc/calc_app_trace.shard — the app LOOP modeled as a pure
;;; fold, examples/calc/calc_app_trace.shard ported to S at slice 6; its five
;;; claims (whole-run spec-correctness lifted from the per-step capstone)
;;; wait for phase 3's I. `drive` returns a pair: Init's Prod is at export
;;; line 34,739, past the fixture the tests load (kernel/test/fixtures/
;;; init_prefix_int.ndjson, through Int), so the port declares the pair it
;;; returns; the naming-law spelling comes with the std port (phase 3).

(import "calc_app_spec.shard")
(use examples.calc.calc_app)
(use examples.calc.calc_app_spec)
(use Init.List)
(use Init.Option)
(use examples.calc.calc_app.Step)
(use examples.calc.calc_app.CalcState)

(type (Pair A B) (Pair A B))

(fn next_state ((s CalcState) (e (List Int))) CalcState
  (match (step s e)
    ((Step s2 a) s2)))

(fn emitted ((s CalcState) (e (List Int))) Action
  (match (step s e)
    ((Step s2 a) a)))

;; run_state: the final state after folding step over the events;
;; run_trace: the Action emitted at each turn; drive: both
(fn run_state ((s CalcState) (events (List (List Int)))) CalcState
  (measure (struct events))
  (match events
    (nil s)
    ((cons e rest) (run_state (next_state s e) rest))))

(fn run_trace ((s CalcState) (events (List (List Int)))) (List Action)
  (measure (struct events))
  (match events
    (nil nil)
    ((cons e rest) (cons (emitted s e) (run_trace (next_state s e) rest)))))

(fn drive ((s CalcState) (events (List (List Int)))) (Pair CalcState (List Action))
  (Pair (run_state s events) (run_trace s events)))

;; the spec-side mirror: the same folds on step_spec
(fn next_state_spec ((s CalcState) (e (List Int))) CalcState
  (match (step_spec s e)
    ((Step s2 a) s2)))

(fn emitted_spec ((s CalcState) (e (List Int))) Action
  (match (step_spec s e)
    ((Step s2 a) a)))

(fn run_state_spec ((s CalcState) (events (List (List Int)))) CalcState
  (measure (struct events))
  (match events
    (nil s)
    ((cons e rest) (run_state_spec (next_state_spec s e) rest))))

(fn run_trace_spec ((s CalcState) (events (List (List Int)))) (List Action)
  (measure (struct events))
  (match events
    (nil nil)
    ((cons e rest) (cons (emitted_spec s e) (run_trace_spec (next_state_spec s e) rest)))))

(fn drive_spec ((s CalcState) (events (List (List Int)))) (Pair CalcState (List Action))
  (Pair (run_state_spec s events) (run_trace_spec s events)))
