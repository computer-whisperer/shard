;;; v3/examples/calc/calc_app_trace.shard — the app LOOP modeled as a pure
;;; fold, examples/calc/calc_app_trace.shard ported to S at slice 6; its five
;;; claims (whole-run spec-correctness lifted from the per-step capstone)
;;; since slice 3.21. `drive` returns a pair: Init's Prod is at export
;;; line 34,739, past the horizon the tests load through (Int), so the
;;; port declares the pair it returns; the naming-law spelling comes with
;;; the std port (phase 3).

(import "calc_app_spec.shard")
(use examples.calc.calc_app)
(use examples.calc.calc_app_spec)
(use Init.List)
(use examples.calc.calc_app.Step)
(use examples.calc.calc_app.CalcState)

(type (Pair A B) (Pair A B))

(fn next_state ((s CalcState) (e (List Int))) CalcState
  (match (step s e)
    ((Step s2 a) s2)))

(fn emitted ((s CalcState) (e (List Int))) Action
  (match (step s e)
    ((Step s2 a) a)))

;; run_state: the final state after folding step over the events;
;; run_trace: the Action emitted at each turn; drive: both
(fn run_state ((s CalcState) (events (List (List Int)))) CalcState
  (measure (struct events))
  (match events
    (nil s)
    ((cons e rest) (run_state (next_state s e) rest))))

(fn run_trace ((s CalcState) (events (List (List Int)))) (List Action)
  (measure (struct events))
  (match events
    (nil nil)
    ((cons e rest) (cons (emitted s e) (run_trace (next_state s e) rest)))))

(fn drive ((s CalcState) (events (List (List Int)))) (Pair CalcState (List Action))
  (Pair (run_state s events) (run_trace s events)))

;; the spec-side mirror: the same folds on step_spec
(fn next_state_spec ((s CalcState) (e (List Int))) CalcState
  (match (step_spec s e)
    ((Step s2 a) s2)))

(fn emitted_spec ((s CalcState) (e (List Int))) Action
  (match (step_spec s e)
    ((Step s2 a) a)))

(fn run_state_spec ((s CalcState) (events (List (List Int)))) CalcState
  (measure (struct events))
  (match events
    (nil s)
    ((cons e rest) (run_state_spec (next_state_spec s e) rest))))

(fn run_trace_spec ((s CalcState) (events (List (List Int)))) (List Action)
  (measure (struct events))
  (match events
    (nil nil)
    ((cons e rest) (cons (emitted_spec s e) (run_trace_spec (next_state_spec s e) rest)))))

(fn drive_spec ((s CalcState) (events (List (List Int)))) (Pair CalcState (List Action))
  (Pair (run_state_spec s events) (run_trace_spec s events)))

;;; Slice 3.21: the folds agree with their spec-side mirrors. The state is quantified in the two
;;; inductions, so the hypothesis is cited at the next state.
(theorem next_state_eq_spec ((s CalcState) (e (List Int))) (= (next_state s e) (next_state_spec s e))
  (by (unfold next_state next_state_spec) (rw (step_eq_spec s e)) rfl))
(theorem emitted_eq_spec ((s CalcState) (e (List Int))) (= (emitted s e) (emitted_spec s e))
  (by (unfold emitted emitted_spec) (rw (step_eq_spec s e)) rfl))
(theorem run_state_eq_spec ((events (List (List Int)))) (forall ((s CalcState)) (= (run_state s events) (run_state_spec s events)))
  (by (induction events
        ((nil () (intro s) (reduce) rfl)
         (cons (e r ih) (intro s) (reduce) (rw (next_state_eq_spec s e)) (rw (ih (next_state_spec s e))) rfl)))))
(theorem run_trace_eq_spec ((events (List (List Int)))) (forall ((s CalcState)) (= (run_trace s events) (run_trace_spec s events)))
  (by (induction events
        ((nil () (intro s) (reduce) rfl)
         (cons (e r ih) (intro s) (reduce) (simp_only emitted_eq_spec next_state_eq_spec ih) rfl)))))
(theorem drive_eq_spec ((s CalcState) (events (List (List Int)))) (= (drive s events) (drive_spec s events))
  (by (unfold drive drive_spec) (rw (run_state_eq_spec events s)) (rw (run_trace_eq_spec events s)) rfl))
