;;; v3/examples/calc/calc_show.shard — show : Int -> digit values and its
;;; Horner inverse, examples/calc/calc_show.shard ported to S at slice 6
;;; (LANGUAGE.md §10 item 2). The round trip 0 <= n |- valI (show n) = n
;;; and the file's four claims wait for phase 3. `show` recurses on the
;;; quotient: at Stage 0 the measure is a reported term (§12.6).

(import "calc.shard")
(import "list.shard")
(use examples.calc.calc)
(use examples.calc.list)
(use Init.List)
(use Init.Bool)

;; MSD-first Horner value of a digit-value list, with an accumulator
(fn valI_go ((ds (List Int)) (acc Int)) Int
  (measure (struct ds))
  (match ds
    (nil acc)
    ((cons d rest) (valI_go rest (+ (* 10 acc) d)))))

(fn valI ((ds (List Int))) Int (valI_go ds 0))

;; show n: decimal digit-VALUE list, most-significant first
(fn show ((n Int)) (List Int)
  (measure n)
  (if (lt n 10) (cons n nil) (append (show (Int.ediv n 10)) (cons (Int.emod n 10) nil))))
