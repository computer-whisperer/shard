;;; v3/examples/calc/calc_proof.shard — examples/calc/calc_proof.shard: six
;;; claims about the lexer on a digit's codepoint, ported at slice 3.21 —
;;; the bounds by `arith`, the guard of `is_digit` collapsed by them, and
;;; the single-digit headline run "x+y" = some (x + y) through the real
;;; lex, parse and eval.

(import "calc.shard")
(import Init Lean.Omega.Int.ofNat_lt_of_lt)   ; through Lean.Omega's kit: arith builds its proofs from it (§8.4 slice 3.21)
(use examples.calc.calc)
(use Init.List)
(use Init.Option)
(use Init.Bool)
(use examples.calc.calc.Token)

(theorem digit_val_of_digit ((x Int)) (= (digit_val (+ 48 x)) x)
  (by (unfold digit_val) arith))
(theorem digit_ge_lo ((x Int) (h (<= 0 x))) (<= 48 (+ 48 x)) (by arith))
(theorem digit_le_hi ((x Int) (h (<= x 9))) (<= (+ 48 x) 57) (by arith))
(theorem is_digit_of_digit ((x Int) (h0 (<= 0 x)) (h1 (<= x 9))) (= (is_digit (+ 48 x)) true)
  (by (unfold is_digit) (rw (if_pos (digit_ge_lo x h0))) (exact (Init.decide_eq_true (digit_le_hi x h1)))))
(theorem lex_xy ((x Int) (y Int) (h0 (<= 0 x)) (h1 (<= x 9)) (h2 (<= 0 y)) (h3 (<= y 9)))
  (= (lex (list (+ 48 x) 43 (+ 48 y))) (list (TNum (digit_val (+ 48 x))) TPlus (TNum (digit_val (+ 48 y)))))
  (by (unfold lex) (reduce lhs) (rw (is_digit_of_digit x h0 h1)) (reduce lhs)
      (rw (is_digit_of_digit y h2 h3)) (reduce lhs) rfl))
;; the headline theorem (single digit): the calculator evaluates the text "x+y" to x + y
(theorem run_xy_adds ((x Int) (y Int) (h0 (<= 0 x)) (h1 (<= x 9)) (h2 (<= 0 y)) (h3 (<= y 9)))
  (= (run (list (+ 48 x) 43 (+ 48 y))) (some (+ x y)))
  (by (unfold run) (rw (lex_xy x y h0 h1 h2 h3)) (reduce lhs) (simp_only digit_val_of_digit) rfl))
