;;; v3/examples/calc/list.shard — the two std/list functions calc's program
;;; half uses (append, len), polymorphic under explicit type binders (law
;;; §5.3 departure 4), until v3/std exists (phase 3). `len` is Nat-valued
;;; under the naming law (LANGUAGE.md §12.4: sizes are Nat).

(import Init Int)
(use Init.List cons nil)   ; selectively: `append` is this file's own, not Init's List.append

(fn append ((T Type) (xs (List T)) (ys (List T))) (List T)
  (measure (struct xs))
  (match xs
    (nil ys)
    ((cons x t) (cons x (append t ys)))))

(fn len ((T Type) (xs (List T))) Nat
  (measure (struct xs))
  (match xs
    (nil 0)
    ((cons _ t) (+ 1 (len t)))))

;;; Slice 3.21: the two laws of append the digit proofs cite (std/list's in the old tree).
(theorem append_nil_right ((T Type) (xs (List T))) (= (append xs nil) xs)
  (by (induction xs
        ((nil () (reduce) rfl)
         (cons (x t ih) (reduce) (rw ih) rfl)))))
(theorem append_assoc ((T Type) (xs (List T)) (ys (List T)) (zs (List T))) (= (append (append xs ys) zs) (append xs (append ys zs)))
  (by (induction xs
        ((nil () (reduce) rfl)
         (cons (x t ih) (reduce) (rw ih) rfl)))))
