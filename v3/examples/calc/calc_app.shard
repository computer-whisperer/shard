;;; v3/examples/calc/calc_app.shard — the STATEFUL calculator's Model-View-
;;; Update step, examples/calc/calc_app.shard ported to S at slice 6
;;; (LANGUAGE.md §10 item 2): a pure, total step : State -> Event -> (Step
;;; State Action) whose effects are inert data. `show_nat` recurses on the
;;; quotient: at Stage 0 the measure is a reported term (§12.6).

(import "calc.shard")
(import "list.shard")
(use examples.calc.calc)
(use examples.calc.list)
(use Init.List cons nil)   ; selectively: `append` is this example's own (list.shard), not Init's List.append
(use Init.Option)
(use Init.Bool)

;; State: the most recently computed result
(type CalcState (CalcState (Option Int)))

;; Action: inert effect data the driver interprets; one action per step
(type Action (Print (List Int)) (Exit Int) (Nop))

;; Step S A: the state+action pair a step returns
(type (Step S A) (Step S A))

;; show_nat n: decimal ASCII codepoints for n >= 0
(fn show_nat ((n Int)) (List Int)
  (measure n)
  (if (lt n 10) (cons (+ 48 n) nil)
  (append (show_nat (Int.ediv n 10)) (cons (+ 48 (Int.emod n 10)) nil))))

;; show_ascii n: with a leading '-' when negative
(fn show_ascii ((n Int)) (List Int)
  (if (lt n 0) (cons 45 (show_nat (- 0 n)))
  (show_nat n)))

;; step s line: evaluate the line; on success update the state and print the
;; result, on failure keep the state and print "?"
(fn step ((s CalcState) (line (List Int))) (Step CalcState Action)
  (match (run line)
    (none (Step s (Print (cons 63 nil))))
    ((some n) (Step (CalcState (some n)) (Print (show_ascii n))))))
