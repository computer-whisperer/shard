;;; v3/examples/template/add_offset.shard — law §5.3's example as the law writes it (LANGUAGE.md
;;; §8.4 slice 3.28 rule 3(c); T2): `List.map` is a template of std/list, the lambda its static
;;; argument — lifted to `add_offset.lam_1` with the captured `n` leading, the call taking the
;;; instance `List_map_Int_Int.of.examples_template_add_offset_add_offset_lam_1_1`, definitionally
;;; the specialized body. The theorems over `add_offset` hold by `Eq.refl` through the unfolding.
(import "../../std/list.shard")
(use std.list)
(import Init Int.add)

(fn add_offset ((xs (List Int)) (n Int)) (List Int) (List.map (fun ((x Int)) (+ x n)) xs))
(theorem add_offset_nil ((n Int)) (= (add_offset List.nil n) List.nil) (exact (Eq.refl List.nil)))
(theorem add_offset_cons ((x Int) (t (List Int)) (n Int))
  (= (add_offset (List.cons x t) n) (List.cons (+ x n) (add_offset t n)))
  (exact (Eq.refl (List.cons (+ x n) (add_offset t n)))))
