;;; v3/examples/template/workload.shard — T3's large finite workload within limits (LANGUAGE.md
;;; §8.4 slice 3.28 rules 4 and 7; law §12.5): 64 instances taken in one file — std/list's
;;; `List.map`, `filter`, `any` and `all` at 16 lifted lambdas each, every lambda its own shape
;;; (`m1.lam_1` … `l16.lam_1`), so 64 lifted fns and 64 instances with their 128 equations are
;;; built and checked by K in this one load, well under the budget of 1,024 instances per
;;; template (rule 4; the budget's refusal is pin `template_budget`). `workload` combines every
;;; instance's result into one Int — over (1 2 3): the 16 maps' totals 504, the filters' lengths 3,
;;; the anys 2, the alls 0 — 509, printed by the entry as its last three digits. The lines below
;;; follow one pattern; the count is the point.
(import "../../std/list.shard")
(import "named.shard")
(use std.list)
(use examples.template.named)
(import Init Int.add)

(fn wbit ((b Bool)) Int (match b (Bool.true 1) (Bool.false 0)))

(fn m1 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 1)) xs))
(fn m2 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 2)) xs))
(fn m3 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 3)) xs))
(fn m4 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 4)) xs))
(fn m5 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 5)) xs))
(fn m6 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 6)) xs))
(fn m7 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 7)) xs))
(fn m8 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 8)) xs))
(fn m9 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 9)) xs))
(fn m10 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 10)) xs))
(fn m11 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 11)) xs))
(fn m12 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 12)) xs))
(fn m13 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 13)) xs))
(fn m14 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 14)) xs))
(fn m15 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 15)) xs))
(fn m16 ((xs (List Int))) (List Int) (List.map (fun ((x Int)) (+ x 16)) xs))
(fn f1 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 1 x) Bool.true Bool.false)) xs))
(fn f2 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 2 x) Bool.true Bool.false)) xs))
(fn f3 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 3 x) Bool.true Bool.false)) xs))
(fn f4 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 4 x) Bool.true Bool.false)) xs))
(fn f5 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 5 x) Bool.true Bool.false)) xs))
(fn f6 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 6 x) Bool.true Bool.false)) xs))
(fn f7 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 7 x) Bool.true Bool.false)) xs))
(fn f8 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 8 x) Bool.true Bool.false)) xs))
(fn f9 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 9 x) Bool.true Bool.false)) xs))
(fn f10 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 10 x) Bool.true Bool.false)) xs))
(fn f11 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 11 x) Bool.true Bool.false)) xs))
(fn f12 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 12 x) Bool.true Bool.false)) xs))
(fn f13 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 13 x) Bool.true Bool.false)) xs))
(fn f14 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 14 x) Bool.true Bool.false)) xs))
(fn f15 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 15 x) Bool.true Bool.false)) xs))
(fn f16 ((xs (List Int))) (List Int) (List.filter (fun ((x Int)) (if (< 16 x) Bool.true Bool.false)) xs))
(fn a1 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 1 x) Bool.true Bool.false))))
(fn a2 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 2 x) Bool.true Bool.false))))
(fn a3 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 3 x) Bool.true Bool.false))))
(fn a4 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 4 x) Bool.true Bool.false))))
(fn a5 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 5 x) Bool.true Bool.false))))
(fn a6 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 6 x) Bool.true Bool.false))))
(fn a7 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 7 x) Bool.true Bool.false))))
(fn a8 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 8 x) Bool.true Bool.false))))
(fn a9 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 9 x) Bool.true Bool.false))))
(fn a10 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 10 x) Bool.true Bool.false))))
(fn a11 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 11 x) Bool.true Bool.false))))
(fn a12 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 12 x) Bool.true Bool.false))))
(fn a13 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 13 x) Bool.true Bool.false))))
(fn a14 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 14 x) Bool.true Bool.false))))
(fn a15 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 15 x) Bool.true Bool.false))))
(fn a16 ((xs (List Int))) Bool (List.any xs (fun ((x Int)) (if (< 16 x) Bool.true Bool.false))))
(fn l1 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 1 x) Bool.true Bool.false))))
(fn l2 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 2 x) Bool.true Bool.false))))
(fn l3 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 3 x) Bool.true Bool.false))))
(fn l4 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 4 x) Bool.true Bool.false))))
(fn l5 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 5 x) Bool.true Bool.false))))
(fn l6 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 6 x) Bool.true Bool.false))))
(fn l7 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 7 x) Bool.true Bool.false))))
(fn l8 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 8 x) Bool.true Bool.false))))
(fn l9 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 9 x) Bool.true Bool.false))))
(fn l10 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 10 x) Bool.true Bool.false))))
(fn l11 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 11 x) Bool.true Bool.false))))
(fn l12 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 12 x) Bool.true Bool.false))))
(fn l13 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 13 x) Bool.true Bool.false))))
(fn l14 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 14 x) Bool.true Bool.false))))
(fn l15 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 15 x) Bool.true Bool.false))))
(fn l16 ((xs (List Int))) Bool (List.all xs (fun ((x Int)) (if (< 16 x) Bool.true Bool.false))))

;; every instance's result, group by group
(fn maps ((xs (List Int))) Int (+ (total (m1 xs)) (+ (total (m2 xs)) (+ (total (m3 xs)) (+ (total (m4 xs)) (+ (total (m5 xs)) (+ (total (m6 xs)) (+ (total (m7 xs)) (+ (total (m8 xs)) (+ (total (m9 xs)) (+ (total (m10 xs)) (+ (total (m11 xs)) (+ (total (m12 xs)) (+ (total (m13 xs)) (+ (total (m14 xs)) (+ (total (m15 xs)) (total (m16 xs))))))))))))))))))
(fn filters ((xs (List Int))) Int (+ (Int.ofNat (List.length (f1 xs))) (+ (Int.ofNat (List.length (f2 xs))) (+ (Int.ofNat (List.length (f3 xs))) (+ (Int.ofNat (List.length (f4 xs))) (+ (Int.ofNat (List.length (f5 xs))) (+ (Int.ofNat (List.length (f6 xs))) (+ (Int.ofNat (List.length (f7 xs))) (+ (Int.ofNat (List.length (f8 xs))) (+ (Int.ofNat (List.length (f9 xs))) (+ (Int.ofNat (List.length (f10 xs))) (+ (Int.ofNat (List.length (f11 xs))) (+ (Int.ofNat (List.length (f12 xs))) (+ (Int.ofNat (List.length (f13 xs))) (+ (Int.ofNat (List.length (f14 xs))) (+ (Int.ofNat (List.length (f15 xs))) (Int.ofNat (List.length (f16 xs)))))))))))))))))))
(fn anys ((xs (List Int))) Int (+ (wbit (a1 xs)) (+ (wbit (a2 xs)) (+ (wbit (a3 xs)) (+ (wbit (a4 xs)) (+ (wbit (a5 xs)) (+ (wbit (a6 xs)) (+ (wbit (a7 xs)) (+ (wbit (a8 xs)) (+ (wbit (a9 xs)) (+ (wbit (a10 xs)) (+ (wbit (a11 xs)) (+ (wbit (a12 xs)) (+ (wbit (a13 xs)) (+ (wbit (a14 xs)) (+ (wbit (a15 xs)) (wbit (a16 xs))))))))))))))))))
(fn alls ((xs (List Int))) Int (+ (wbit (l1 xs)) (+ (wbit (l2 xs)) (+ (wbit (l3 xs)) (+ (wbit (l4 xs)) (+ (wbit (l5 xs)) (+ (wbit (l6 xs)) (+ (wbit (l7 xs)) (+ (wbit (l8 xs)) (+ (wbit (l9 xs)) (+ (wbit (l10 xs)) (+ (wbit (l11 xs)) (+ (wbit (l12 xs)) (+ (wbit (l13 xs)) (+ (wbit (l14 xs)) (+ (wbit (l15 xs)) (wbit (l16 xs))))))))))))))))))
(fn workload ((xs (List Int))) Int (+ (maps xs) (+ (filters xs) (+ (anys xs) (alls xs)))))
