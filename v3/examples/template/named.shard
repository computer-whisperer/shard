;;; v3/examples/template/named.shard — the other static arguments (LANGUAGE.md §8.4 slice 3.28
;;; rule 3(a), 3(b); T2): a fn with a program (`inc`, `big`) and a constant of the realization
;;; registry (`Int.add`) by name, a named partial application (`(addk k)`: the shape `addk/1`,
;;; `k` captured as the instance's leading parameter and never part of the key), over std/list's
;;; six templates — `List.map`, `filter`, `foldl`, `foldr`, `any`, `all`.
(import "../../std/list.shard")
(use std.list)
(import Init Int.add)

(fn inc ((x Int)) Int (+ x 1))
(fn addk ((k Int) (x Int)) Int (+ x k))
(fn big ((x Int)) Bool (if (< 5 x) Bool.true Bool.false))
(fn incs ((xs (List Int))) (List Int) (List.map inc xs))
(fn shift ((k Int) (xs (List Int))) (List Int) (List.map (addk k) xs))
(fn total ((xs (List Int))) Int (List.foldl Int.add 0 xs))
(fn total_r ((xs (List Int))) Int (List.foldr Int.add 0 xs))
(fn bigs ((xs (List Int))) (List Int) (List.filter big xs))
(fn any_big ((xs (List Int))) Bool (List.any xs big))
(fn all_big ((xs (List Int))) Bool (List.all xs big))
(theorem incs_cons ((x Int) (t (List Int))) (= (incs (List.cons x t)) (List.cons (+ x 1) (incs t))) (exact (Eq.refl (List.cons (+ x 1) (incs t)))))
(theorem shift_cons ((k Int) (x Int) (t (List Int))) (= (shift k (List.cons x t)) (List.cons (+ x k) (shift k t))) (exact (Eq.refl (List.cons (+ x k) (shift k t)))))
(theorem total_nil () (= (total List.nil) 0) (exact (Eq.refl 0)))
(theorem total_r_cons ((x Int) (t (List Int))) (= (total_r (List.cons x t)) (+ x (total_r t))) (exact (Eq.refl (+ x (total_r t)))))
