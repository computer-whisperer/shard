;;; v3/examples/template/template_main.shard — the entry (LANGUAGE.md §8.4 slice 3.28 rule 7;
;;; T2's run): one line of digits from the instances — `total (incs (1 2 3))` = 9, `sum_int
;;; (1 2 3)` = 6, `prod_int (2 3)` = 6, the count of `bigs (3 7 9)` = 2, `any_big (1 2)` = 0,
;;; `all_big (7 8)` = 1, `sum_int` over `plus_zero (4)` = 4, then the workload's 64 instances
;;; combined over (1 2 3) as three digits, 509: "9662014509". `main` takes an instance itself —
;;; `List.map` at `digit` over the results — beside the typed fns that took theirs; until slice
;;; 4.3 landing 1 it was read E-first (it performs an extern) and its instance had a program and
;;; no generated definition (rule 3's last sentence, landing 3 — pin template_e_first's now);
;;; the extern an opaque constant in L, main is defined and the instance has its equations.
;;;
;;;   load.shard --root v3 --init … --run examples.template.template_main.main v3/examples/template/template_main.shard
(import "named.shard")
(import "package.shard")
(import "workload.shard")
(import "../../std/list.shard")
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(use examples.template.named)
(use examples.template.package)
(use examples.template.workload)
(use std.list)
(use std.bytes)
(use std.host)
(use Init.List cons nil)

(fn digit ((n Int)) UInt8 (Byte.ofNat (Int.natAbs (+ 48 n))))
(fn bit ((b Bool)) Int (match b (Bool.true 1) (Bool.false 0)))
(fn digits3 ((n Int)) (List Int) (cons (/ n 100) (cons (mod (/ n 10) 10) (cons (mod n 10) nil))))
(fn results () (List Int)
  (cons (total (incs (cons 1 (cons 2 (cons 3 nil)))))
  (cons (sum_int (cons 1 (cons 2 (cons 3 nil))))
  (cons (prod_int (cons 2 (cons 3 nil)))
  (cons (Int.ofNat (List.length (bigs (cons 3 (cons 7 (cons 9 nil))))))
  (cons (bit (any_big (cons 1 (cons 2 nil))))
  (cons (bit (all_big (cons 7 (cons 8 nil))))
  (cons (sum_int (plus_zero (cons 4 nil)))
  (digits3 (workload (cons 1 (cons 2 (cons 3 nil)))))))))))))
(fn main ((w World)) World (write_line (Bytes.ofList (List.map digit (results))) w))
