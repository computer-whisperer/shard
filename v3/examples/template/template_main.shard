;;; v3/examples/template/template_main.shard — the entry (LANGUAGE.md §8.4 slice 3.28 rule 7;
;;; T2's run): one line of digits from the instances — `total (incs (1 2 3))` = 9, `sum_int
;;; (1 2 3)` = 6, `prod_int (2 3)` = 6, the count of `bigs (3 7 9)` = 2, `any_big (1 2)` = 0,
;;; `all_big (7 8)` = 1, `sum_int` over `plus_zero (4)` = 4: "9662014". The body is read E-first
;;; (it performs an extern) and calls the typed fns that took the instances.
;;;
;;;   load.shard --root v3 --init … --run examples.template.template_main.main v3/examples/template/template_main.shard
(import "named.shard")
(import "package.shard")
(import "../../std/list.shard")
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(use examples.template.named)
(use examples.template.package)
(use std.list)
(use std.bytes)
(use std.host)
(use Init.List cons nil)

(fn digit ((n Int)) UInt8 (Byte.ofNat (Int.natAbs (+ 48 n))))
(fn bit ((b Bool)) Int (match b (Bool.true 1) (Bool.false 0)))
(fn line () ByteArray
  (Bytes.ofList (cons (digit (total (incs (cons 1 (cons 2 (cons 3 nil))))))
                (cons (digit (sum_int (cons 1 (cons 2 (cons 3 nil)))))
                (cons (digit (prod_int (cons 2 (cons 3 nil))))
                (cons (digit (Int.ofNat (List.length (bigs (cons 3 (cons 7 (cons 9 nil)))))))
                (cons (digit (bit (any_big (cons 1 (cons 2 nil)))))
                (cons (digit (bit (all_big (cons 7 (cons 8 nil)))))
                (cons (digit (sum_int (plus_zero (cons 4 nil))))
                nil)))))))))
(fn main ((w World)) World (write_line (line) w))
