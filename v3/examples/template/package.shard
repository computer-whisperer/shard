;;; v3/examples/template/package.shard — a static law-bearing package (LANGUAGE.md §8.4 slice
;;; 3.28 rule 5; law §4.1; T2's package half): `Monoid` is a structure with a function-typed
;;; field, a package type — never an E type, no runtime dictionary. `IntAdd` and `IntMul` are
;;; package constants, their values the constructor applied (a name and a lambda as the
;;; operation). `fold_m` is a template over a package parameter; its generic theorems are proven
;;; once over `m` and apply at the constants by unification through the unfolding; `sum_int`
;;; takes the instance `fold_m_Int.of.examples_template_package_IntAdd_0`, whose program calls
;;; `Int.add` and holds the unit `0` — the fields read off the constant, by the reduction.
(import "../../std/list.shard")
(use std.list)
(import Init Int.one_mul)

(structure Monoid ((a Type)) (op (-> a a a)) (unit a)
  (op_assoc (forall ((x a) (y a) (z a)) (= (op (op x y) z) (op x (op y z)))))
  (unit_left (forall ((x a)) (= (op unit x) x))))
(def IntAdd () (Monoid Int) (Monoid.mk Int.add 0 Int.add_assoc Int.zero_add))
(def IntMul () (Monoid Int) (Monoid.mk (fun ((x Int) (y Int)) (Int.mul x y)) 1 Int.mul_assoc Int.one_mul))
(theorem int_add_unit () (= (Monoid.unit IntAdd) 0) (exact (Eq.refl 0)))

(fn fold_m ((a Type) (m (Monoid a)) (xs (List a))) a (measure (struct xs))
  (match xs (nil (Monoid.unit m)) ((cons x t) (Monoid.op m x (fold_m m t)))))
(theorem fold_m_nil ((a Type) (m (Monoid a))) (= (fold_m m List.nil) (Monoid.unit m)) (exact (Eq.refl (Monoid.unit m))))
(theorem fold_m_cons ((a Type) (m (Monoid a)) (x a) (t (List a)))
  (= (fold_m m (List.cons x t)) (Monoid.op m x (fold_m m t)))
  (exact (Eq.refl (Monoid.op m x (fold_m m t)))))
(theorem fold_m_unit_left ((a Type) (m (Monoid a)) (x a)) (= (Monoid.op m (Monoid.unit m) x) x) (exact (Monoid.unit_left m x)))

(fn sum_int ((xs (List Int))) Int (fold_m IntAdd xs))
(fn prod_int ((xs (List Int))) Int (fold_m IntMul xs))
(theorem sum_int_nil () (= (sum_int List.nil) 0) (by (unfold sum_int) (apply fold_m_nil)))
(theorem sum_int_cons ((x Int) (t (List Int))) (= (sum_int (List.cons x t)) (Int.add x (sum_int t))) (by (unfold sum_int) (apply fold_m_cons)))
(theorem prod_int_nil () (= (prod_int List.nil) 1) (by (unfold prod_int) (apply fold_m_nil)))
;; the package's operation passed on as a static argument of another template: the field at the constant
(fn scale_all ((a Type) (m (Monoid a)) (xs (List a))) (List a) (List.map (Monoid.op m (Monoid.unit m)) xs))
(fn plus_zero ((xs (List Int))) (List Int) (scale_all IntAdd xs))
(fn times_one ((xs (List Int))) (List Int) (scale_all IntMul xs))
