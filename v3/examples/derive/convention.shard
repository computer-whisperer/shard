;;; v3/examples/derive/convention.shard — an ordering is a convention, declared and recorded
;;; (LANGUAGE.md §8.4, slice 3.19 rules 4 and 6; law §5.1, §5.2; T1's "a changed ordering
;;; convention changing the generated operation and the affected resolved requirement").
;;; Under the structural policy the declaration order is the order: `Ab` and `Ba` have the
;;; same constructors in opposite order, and their comparisons answer oppositely. A
;;; procedure the file wrote is registered with `(ord by NAME)`; a type over it compares its
;;; field by that procedure, and the DERIVE record names it (`kernel/test/derive_test.sh`
;;; reads the record). Every fact below is decided by K.
(import Init Ordering.casesOn)

(type Ab (A) (B) (C))
(type Ba (C) (B) (A))
(derive Ab eq (ord structural))
(derive Ba (ord structural))
(theorem ab_order () (= (Ab.compare Ab.A Ab.C) Ordering.lt) (exact (Eq.refl Ordering.lt)))
(theorem ba_order () (= (Ba.compare Ba.A Ba.C) Ordering.gt) (exact (Eq.refl Ordering.gt)))
(theorem ab_middle () (= (Ab.compare Ab.B Ab.A) Ordering.gt) (exact (Eq.refl Ordering.gt)))
(theorem ab_same () (= (Ab.compare Ab.B Ab.B) Ordering.eq) (exact (Eq.refl Ordering.eq)))

;; a priority whose order is not its declaration's: the highest first
(type Pri (Low) (High))
(derive Pri (ord structural))
(type Urgency (Urgency Pri))
(fn Urgency.first ((a Urgency) (b Urgency)) Ordering
  (match a ((Urgency p) (match b ((Urgency q) (Pri.compare q p))))))
(derive Urgency (ord by Urgency.first))
;; a job compares its urgency by the registered procedure, then its number
(type Job (Job Urgency Nat))
(derive Job (ord structural))
(theorem urgent_first () (= (Job.compare (Job (Urgency High) 9) (Job (Urgency Low) 1)) Ordering.lt) (exact (Eq.refl Ordering.lt)))
(theorem then_number () (= (Job.compare (Job (Urgency Low) 9) (Job (Urgency Low) 1)) Ordering.gt) (exact (Eq.refl Ordering.gt)))
