;;; v3/examples/derive/derive_main.shard — a new type in an `if`, as a key and in a message
;;; (LANGUAGE.md §8.4, slice 3.19; law §5.1): a hand of cards with a name, an optional
;;; trump, a flag and a score. Every type derives its equality, its ordering under the
;;; structural policy and its rendering — the instantiations `(List Card)` and
;;; `(Option Card)` their own, because E has no function values — and the program uses
;;; them: `count` asks `(= c d)` in an `if`, `insert` keys a sorted list on `Card.compare`,
;;; `main` prints the values as source would write them. `kernel/test/derive_test.sh` runs
;;; it on the host and compares the lines; the theorems are the same facts decided by K.
;;;
;;;   load.shard --root v3 --init … --run examples.derive.derive_main.main v3/examples/derive/derive_main.shard

(import "../../std/derive.shard")
(import "../../std/host.shard")
(use std.bytes)
(use std.derive)
(use std.host)
(use Init.List cons nil)
(use Init.Option)
(use Init.Bool)

(type Suit (Clubs) (Diamonds) (Hearts) (Spades))
(type Card (Card Nat Suit) (Joker))
(type Hand (Hand String (List Card) (Option Card) Bool Int))
(derive Suit eq (ord structural) render)
(derive Card eq (ord structural) render)
(derive (List Card) eq (ord structural) render)
(derive (Option Card) eq (ord structural) render)
(derive Hand eq (ord structural) render)
(derive Ordering eq render)

;; in an `if`: how often a card occurs
(fn count ((c Card) (cs (List Card))) Nat (measure (struct cs))
  (match cs
    (nil 0)
    ((cons d t) (if (= c d) (+ 1 (count c t)) (count c t)))))
;; as a key: a list kept sorted by the derived ordering
(fn insert ((c Card) (cs (List Card))) (List Card) (measure (struct cs))
  (match cs
    (nil (cons c nil))
    ((cons d t)
     (match (Card.compare c d)
       (Ordering.gt (cons d (insert c t)))
       (_ (cons c (cons d t)))))))
(fn sort ((cs (List Card)) (acc (List Card))) (List Card) (measure (struct cs))
  (match cs
    (nil acc)
    ((cons c t) (sort t (insert c acc)))))

(fn cards () (List Card) (cons (Card 10 Hearts) (cons Joker (cons (Card 2 Spades) (cons (Card 10 Clubs) nil)))))
(fn north () Hand (Hand "north" (cards) (some (Card 1 Diamonds)) true -3))
(fn south () Hand (Hand "south" nil none false 7))
(fn hand_cards ((h Hand)) (List Card) (match h ((Hand _ cs _ _ _) cs)))

;; what K decides of them, each by evaluation
(theorem sorted () (= (sort (cards) nil) (cons (Card 2 Spades) (cons (Card 10 Clubs) (cons (Card 10 Hearts) (cons Joker nil)))))
  (exact (Eq.refl (sort (cards) nil))))
(theorem joker_last () (= (Card.compare (Card 2 Hearts) Joker) Ordering.lt) (exact (Eq.refl Ordering.lt)))
(theorem suit_order () (= (Card.compare (Card 10 Clubs) (Card 10 Hearts)) Ordering.lt) (exact (Eq.refl Ordering.lt)))
(theorem counted () (= (count (Card 10 Hearts) (cards)) 1) (exact (Eq.refl 1)))

;; in an `if` again, at the largest type
(fn same_text ((a Hand) (b Hand)) String (if (= a b) "same" "different"))

;; Init's connectives on Bool, run as the `if` they are (the registry's Bool rows), and Bool's
;; equality: every row, as a program (main prints the list) and as K decides it (truth_is)
(fn logic ((a Bool) (b Bool)) Bool (and (not a) (or a b)))
(fn bool_eq ((a Bool) (b Bool)) Bool (if (= a b) true false))
(derive (List Bool) render)
(fn truth () (List Bool)
  (cons (and false false) (cons (and false true) (cons (and true false) (cons (and true true)
  (cons (or false false) (cons (or false true) (cons (or true false) (cons (or true true)
  (cons (not false) (cons (not true)
  (cons (bool_eq false false) (cons (bool_eq false true) (cons (bool_eq true false) (cons (bool_eq true true) nil)))))))))))))))
(theorem truth_is ()
  (= (truth) (cons false (cons false (cons false (cons true (cons false (cons true (cons true (cons true
             (cons true (cons false (cons true (cons false (cons false (cons true nil)))))))))))))))
  (exact (Eq.refl (truth))))

;; in a message
(fn main ((w World)) World
  (let ((w1 (write_line (Hand.render (north)) w)))
  (let ((w2 (write_line (Hand.render (south)) w1)))
  (let ((w3 (write_line (List_Card.render (sort (hand_cards (north)) nil)) w2)))
  (let ((w4 (write_line (Bytes.ofNats (Nat.renderOnto (count (Card 10 Hearts) (cards)) nil)) w3)))
  (let ((w5 (write_line (Bytes.ofString (same_text (north) (north))) w4)))
  (let ((w6 (write_line (Bytes.ofString (same_text (north) (south))) w5)))
  (let ((w7 (write_line (Ordering.render (Hand.compare (north) (south))) w6)))
  (let ((w8 (write_line (Bytes.ofNats (Text.renderOnto "a\"b\\c" nil)) w7)))
  (let ((w9 (write_line (Bool.render (logic false true)) w8)))
    (write_line (List_Bool.render (truth)) w9)))))))))))
