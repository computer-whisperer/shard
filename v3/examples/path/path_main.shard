;;; v3/examples/path/path_main.shard — the path's entry (LANGUAGE.md §8.4 slice 3.24; §9's
;;; checked entry): `main` takes one Nat from the command line — validated by the driver before
;;; the World, a malformed one refused as `RUN: argument 1 …`, exit 6 — and prints the digit
;;; `read` finds at that index of a fixed list, `-` past its end. The one function that calls
;;; an extern; a program without a definition (`no_l_meaning`) until phase 4's World.
;;;
;;;   load.shard --root v3 --init … --run examples.path.path_main.main v3/examples/path/path_main.shard -- 2
(import "path.shard")
(import "../../std/bytes.shard")
(import "../../std/host.shard")
(use examples.path.path)
(use std.bytes)
(use std.host)
(use Init.List cons nil)

;; the list every run reads: digits, so an element prints as one byte
(fn digits () (List Nat) (cons 3 (cons 1 (cons 4 (cons 1 (cons 5 (cons 9 (cons 2 (cons 6 nil)))))))))
;; a digit as its byte, `-` for none
(fn show_at ((i Nat)) ByteArray
  (match (at (digits) i)
    (Option.none (Bytes.ofList (cons (Byte.ofNat 45) nil)))
    ((Option.some f) (Bytes.ofList (cons (Byte.ofNat (+ 48 (pick (digits) f))) nil)))))
(fn main ((i Nat) (w World)) World (write_line (show_at i) w))
