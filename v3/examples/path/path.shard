;;; v3/examples/path/path.shard — law §12.4's first connected path on one program
;;; (LANGUAGE.md §8.4 slice 3.24; §13 item 58; GPT-6's R76). The joints, in order:
;;;   1. imported logical declarations — `List.length` and `List.get?Internal`, Init's own —
;;;      with CHECKED E realizations: a supplied body each, its equations theorems K proves
;;;      (`realize_1`, `realize_2`; the second of `get?Internal` by cases on the index, named
;;;      in the equations clause);
;;;   2. a caller using a BRANCH-LOCAL PROOF — `at` returns an index known to be in bounds,
;;;      `Fin (List.length xs)`, built under `(dif h (< i (List.length xs)) …)` from the
;;;      branch's hypothesis `h`, which is used only in the `Fin.mk` field (T1) and erased at E
;;;      (`Fin.mk i h` runs as `i`); `pick` consumes the index, its parameter type dependent;
;;;   3. claims constructed through I — `at_some` and `at_none`, by `dif_pos`/`dif_neg`;
;;;   4. retained P verified without the elaborator — `load.shard --store`, `verify_release`;
;;;   5. repeated execution through a prepared handle — phase 4's (T6), not here.
;;; `path_main.shard` is the entry that runs `read` on a raw argument; kernel/test/path_test.sh
;;; assembles the path and breaks each joint.
(import Init List.get?Internal)

;; ---- 1. imported declarations, realized and checked ----------------------------------------
(realize List.length ((a Type) (xs (List a))) Nat (measure (struct xs))
  (match xs (List.nil 0) ((List.cons _ t) (+ (List.length t) 1))))
;; Init's structural recursion on the index is an `if` here; the equation by cases on it
(theorem get_nil ((a Type) (i Nat)) (= (List.get?Internal (@List.nil a) i) (@Option.none a))
  (exact (Eq.refl (@Option.none a))))
(theorem get_cons ((a Type) (i Nat) (x a) (t (List a)))
  (= (List.get?Internal (List.cons x t) i) (if (= i 0) (Option.some x) (List.get?Internal t (- i 1))))
  (exact (match i (Nat.zero (Eq.refl (Option.some x))) ((Nat.succ j) (Eq.refl (List.get?Internal t j))))))
(realize List.get?Internal ((a Type) (xs (List a)) (i Nat)) (Option a) (measure (struct xs))
  (match xs
    (List.nil Option.none)
    ((List.cons x t) (if (= i 0) (Option.some x) (List.get?Internal t (- i 1)))))
  (equations get_nil get_cons))

;; ---- 2. the caller with the branch-local proof -----------------------------------------------
;; an index in bounds, or none: the proof `h` lives in the then-branch and nowhere else
(fn at ((xs (List Nat)) (i Nat)) (Option (Fin (List.length xs)))
  (dif h (< i (List.length xs)) (Option.some (Fin.mk i h)) Option.none))
(fn or_zero ((o (Option Nat))) Nat (match o (Option.none 0) ((Option.some n) n)))
;; the element at an index known to be in bounds (the bound is the parameter's type)
(fn pick ((xs (List Nat)) (f (Fin (List.length xs)))) Nat
  (or_zero (List.get?Internal xs (Fin.val f))))
;; the element at any index, 0 past the end
(fn read ((xs (List Nat)) (i Nat)) Nat
  (match (at xs i) (Option.none 0) ((Option.some f) (pick xs f))))

;; ---- 3. claims through I -------------------------------------------------------------------
(theorem at_none ((xs (List Nat)) (i Nat) (h (Not (< i (List.length xs))))) (= (at xs i) Option.none)
  (by (unfold at) (rw (dif_neg h)) rfl))
(theorem at_some ((xs (List Nat)) (i Nat) (h (< i (List.length xs)))) (= (at xs i) (Option.some (Fin.mk i h)))
  (by (unfold at) (rw (dif_pos h)) rfl))
