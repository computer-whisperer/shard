;;; v3/examples/auto/auto.shard — the producers' example (v3/LANGUAGE.md §8.4 slice 3.22):
;;; every theorem here delegates its proof with `auto`, and `v3/kernel/prove.shard` wrote
;;; the blocks into auto.auto.shard beside this file — machine-owned, keyed by each
;;; statement's fingerprint. The build (load.shard) replays those blocks and never
;;; searches; kernel/test/engine_test.sh regenerates the sidecar into a scratch copy and
;;; requires it byte-identical to the one committed. A theorem the engine cannot close
;;; stays pending with the fingerprint an entry needs (`beyond` below is the example: a
;;; product of variables is no linear fact).
(import Init Lean.Omega.Int.ofNat_lt_of_lt)
(use Init.List cons nil)

(fn len ((xs (List Nat))) Nat
  (measure (struct xs))
  (match xs (nil 0) ((cons _ r) (+ 1 (len r)))))
(fn app ((xs (List Nat)) (ys (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs (nil ys) ((cons x r) (cons x (app r ys)))))
(fn rev_onto ((xs (List Nat)) (acc (List Nat))) (List Nat)
  (measure (struct xs))
  (match xs (nil acc) ((cons x r) (rev_onto r (cons x acc)))))

;; closed by rfl, by reduce, by decide
(theorem two_three () (= (+ 2 3) 5) auto)
(theorem len_two () (= (len (cons 1 (cons 2 nil))) 2) auto)
(theorem lt_dec () (< 3 7) auto)

;; linear arithmetic: the context's comparisons become the facts of (arith only …)
(theorem le_step ((a Int) (b Int) (h (<= a b))) (<= (+ a 1) (+ b 1)) auto)
(theorem le_chain ((x Int) (y Int) (z Int) (h1 (<= x y)) (h2 (<= y z))) (<= x z) auto)
(theorem nat_cast ((n Nat)) (<= 0 (+ n 1)) auto)
(theorem implication ((x Int)) (-> (<= 0 x) (<= 48 (+ 48 x))) auto)

;; induction with the functions' equations and the hypothesis as rules
(theorem app_nil ((xs (List Nat))) (= (app xs nil) xs) auto)
(theorem len_app ((xs (List Nat)) (ys (List Nat))) (= (len (app xs ys)) (+ (len xs) (len ys))) auto)
(theorem len_rev_onto ((xs (List Nat))) (forall ((acc (List Nat))) (= (len (rev_onto xs acc)) (+ (len xs) (len acc)))) auto)

;; a hint: the induction variable named
(theorem app_assoc ((xs (List Nat)) (ys (List Nat)) (zs (List Nat))) (= (app (app xs ys) zs) (app xs (app ys zs))) (auto (induct xs)))

;; beyond the engine: a product of variables is no linear fact — pending, never searched at build
(theorem beyond ((x Int)) (<= x (* x x)) auto)
