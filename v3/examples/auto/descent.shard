;;; v3/examples/auto/descent.shard — the obligations of a measure, left to the engine. Every
;;; function here says why it terminates by `(measure …)`; each call of itself states an
;;; obligation `F.dec_N`, and each is delegated: `(fulfills F.dec_N auto)`. `prove` finds the
;;; blocks and writes them beside this file (descent.auto.shard); a load replays them. The
;;; measures are the usual ones: a derived size, a list's length, an integer through
;;; `Int.natAbs`, fuel, two parts compared in order, a weight beside a count.
;;; (v3/kernel/test/engine_test.sh holds the sidecar to what `prove` writes.)

(use Init.Bool false true)
(use Init.List cons nil)

(type T (A) (B T T))
(derive T size)
;; a derived size: one hypothesis, the size's equations
(fn count_t ((a T)) Nat
  (measure (T.size a))
  (match a
    (A 1)
    ((B l r) (+ (count_t l) (count_t r)))))
(fulfills count_t.dec_1 auto)
(fulfills count_t.dec_2 auto)
;; a row under two matches: two hypotheses, both `h` in the statement
(fn eqt ((a T) (b T)) Bool
  (measure (T.size a))
  (match a
    (A
      (match b
        (A true)
        (_ false)))
    ((B l r)
     (match b
       ((B l2 r2) (if (eqt l l2) (eqt r r2) false))
       (_ false)))))
(fulfills eqt.dec_1 auto)
(fulfills eqt.dec_2 auto)
;; a list's length: Init's own equations of it
(fn total ((xs (List Nat))) Nat
  (measure (List.length xs))
  (match xs
    (nil 0)
    ((cons x r) (+ x (total r)))))
(fulfills total.dec_1 auto)
;; an integer counted down
(fn down ((n Int) (acc Int)) Int (measure (Int.natAbs n)) (if (< n 1) acc (down (- n 1) (+ acc 1))))
(fulfills down.dec_1 auto)
;; fuel
(fn burn ((xs (List Nat)) (fuel Int)) Nat
  (measure (Int.natAbs (+ fuel 1)))
  (if (< fuel 0) 0
  (match xs
    (nil 0)
    ((cons x r) (+ x (burn r (- fuel 1)))))))
(fulfills burn.dec_1 auto)
;; fuel doubled, as a group of functions weighs it
(fn go ((xs (List Int)) (fuel Int)) Int
  (measure (* 2 (Int.natAbs (+ fuel 1))))
  (if (< fuel 0) 0
  (match xs
    (nil 0)
    ((cons c r) (if (= c 40) (go r (- fuel 1)) (+ c (go r (- fuel 1))))))))
(fulfills go.dec_1 auto)
(fulfills go.dec_2 auto)
;; a weight beside a count: twice the list's length and an integer
(fn skip ((bs (List Int)) (k Int)) Int
  (measure (+ (* 2 (List.length bs)) (Int.natAbs k)))
  (if (<= k 0) 0
  (match bs
    (nil k)
    ((cons b r) (skip r (- k 1))))))
(fulfills skip.dec_1 auto)
;; two parts: the first falls, or stays while the second falls
(fn drain ((k Nat) (xs (List Nat))) Nat
  (measure k (List.length xs))
  (match xs
    (nil (if (< 0 k) (drain (Nat.sub k 1) (cons 1 (cons 2 nil))) 0))
    ((cons x r) (+ x (drain k r)))))
(fulfills drain.dec_1 auto)
(fulfills drain.dec_2 auto)
