;; a window starting at a with 1+j more bytes below b cannot start AT b —
;; the above law's head-byte disequality (read-addr-first orientation;
;; lt_implies_neq_flip covers the below law's).
(claim mr_neq_above
  (goal ((a Int) (j Int) (b Int))
    ((= (le (+ a (+ 1 j)) b) True) (= (le 0 j) True))
    (= (int_eq a b) False))
  (by arith (list 1 1 1)))

;; --- discharge the readback interface obligations ------------------------------

(fulfills mem_read_z auto)

(fulfills mem_read_s auto)

;; below-range framing: the read walks UP from a while the store sits below;
;; each head byte skips it (b < a gives a != b) and the IH bound is b < a+1.
(fulfills mem_read_set_below
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma mem_read_z) lr lhs true ())
          (rewrite (lemma mem_read_z) lr rhs true ()))
         refl))
     (case S
       (chain
         (steps ((rewrite (lemma mem_read_s) lr lhs true ())))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma lt_implies_neq_flip)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl))
              refl)))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma lt_succ_from_lt)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl))
              refl)))
         (steps ((rewrite (lemma mem_read_s) lr rhs true ())))
         refl)))))

;; above-range framing: the probes' bc_swin shape — head-byte disequality by
;; mr_neq_above (j Inst-pinned; the successor spelling discharged by
;; int_of_nat_succ RL), IH bound by std/order's le_succ_shift.
(fulfills mem_read_set_above
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma mem_read_z) lr lhs true ())
          (rewrite (lemma mem_read_z) lr rhs true ()))
         refl))
     (case S
       (w2)
       (chain
         (steps ((rewrite (lemma mem_read_s) lr lhs true ())))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma mr_neq_above)
              lr
              lhs
              ((inst j (int_of_nat w2)))
              ((steps
                 ((rewrite (lemma int_of_nat_succ) rl lhs true ())
                  (rewrite (premise 0) lr lhs true ()))
                 refl)
               (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
              refl)))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma le_succ_shift)
              lr
              lhs
              ()
              ((steps
                 ((rewrite (lemma int_of_nat_succ) rl lhs true ())
                  (rewrite (premise 0) lr lhs true ()))
                 refl))
              refl)))
         (steps ((rewrite (lemma mem_read_s) lr rhs true ())))
         refl)))))
