;;; std/mem/mem.shard — the `mem` module IMPLEMENTATION (private).
;;;
;;; Mem as an opaque construction over std/map's (Map Int): a store is an
;;; insert, a read is a lookup defaulted to 0 and re-canonicalized mod 256 —
;;; so the byte-range facts hold UNCONDITIONALLY with no invariant over the
;;; rep (the same trick as std/bytes' bidx). The framing laws are THEOREMS
;;; over std/map's extensional lemmas + std/div's mod facts — no mem-specific
;;; axiom. Consumers never load this file; they get only mod.req.shard.
;;;
;;; This is the substrate's FIRST (functional) implementation; the arc's end
;;; state adds ISA-backed impl variants conformant to the same mod.req
;;; (docs/ISA.md §10) — swap-in is proof-neutral because consumers cite only
;;; the surface.

(import "../../kernel/stdlib.shard")
(import "../map")  ; the carrier — opaque (Map Int)
(import "../../kernel/facts.shard")  ; mod_lo / mod_hi — the masking range facts
(import "../nat")  ; int_of_nat + its lemmas — the LE framing bounds
(import "../order")  ; lt/le bridge lemmas for the framing inductions
(import "../div")  ; mod_small — the in-range remainder identity
(import "mod.req.shard")  ; our interface — opaque type + sig fns + obligations
(use (:: std map *))
(use (:: kernel facts *))
(use (:: std nat *))
(use (:: std order *))
(use (:: std div mod_small))
(use (:: std mem *))  ; impl-proof: rebind the opaque type + sig fns to our defs

;; --- representation + private helpers ---------------------------------------

(type Mem (MkMem (Map Int)))

;; the rep extractor.
(fn mrep ((m Mem)) (Map Int)
  (match m
    ((MkMem r) r)))

;; the raw cell read: lookup defaulted to 0. Total; the raw map may hold an
;; untruncated store (mem_set inserts raw) — mem_get masks on the way out.
(fn raw_get ((m Mem) (a Int)) Int
  (match (lookup a (mrep m))
    (None 0)
    ((Some v) v)))

;; --- bodies behind the opaque sig fns ---------------------------------------

(fn mem_empty () Mem (MkMem (empty)))

;; re-canonicalize the read mod 256 so 0 <= mem_get < 256 holds unconditionally.
(fn mem_get ((m Mem) (a Int)) Int (mod (raw_get m a) 256))

;; a store IS an insert (raw; truncation happens on read).
(fn mem_set ((m Mem) (a Int) (v Int)) Mem (MkMem (insert a v (mrep m))))

;; w-byte little-endian word read: lowest address = least significant byte.
(fn load_le ((w Nat) (m Mem) (a Int)) Int
  (measure (struct w))
  (match w
    (Z 0)
    ((S w2) (+ (mem_get m a) (* 256 (load_le w2 m (+ a 1)))))))

;; w-byte little-endian word write: store the raw quotient chain (mem_get's
;; masking makes each byte a byte on the way out).
(fn store_le ((w Nat) (m Mem) (a Int) (v Int)) Mem
  (measure (struct w))
  (match w
    (Z m)
    ((S w2) (store_le w2 (mem_set m a v) (+ a 1) (ediv v 256)))))

;; --- internal lemmas ---------------------------------------------------------

;; in-range mod is the identity: 0<=h<256 |- mod h 256 = h — std/div's
;; mod_small at the byte divisor (the same instance std/bytes carries).
(claim mod_byte_id
  (goal ((h Int)) ((= (le 0 h) True) (= (lt h 256) True)) (= (mod h 256) h))
  (rewrite-with
    (lemma mod_small)
    lr
    lhs
    ((inst d 256))
    ((steps ((rewrite (premise 0) lr lhs true ())) refl)
     (steps ((rewrite (premise 1) lr lhs true ())) refl))
    refl))

;; --- discharge the interface's requirements ---------------------------------

;; get_empty by hand: peel the bodies, kill the lookup via lookup_empty, and
;; the residue (mod 0 256) computes to 0. (The one the solver's ladder misses.)
(fulfills get_empty
  (steps
    ((unfold mem_get lhs)
     (unfold mem_empty lhs)
     (unfold raw_get lhs)
     (unfold mrep lhs)
     (simp lhs)
     (rewrite (lemma lookup_empty) lr lhs true ())
     (simp lhs))
    refl))

(fulfills get_lo auto)

(fulfills get_hi auto)

;; get_set / get_set_other by hand: peel the bodies to the map, then
;; lookup_insert_eq / lookup_insert_neq decide the cell. (Written out here
;; because every later proof cites these two by name.)
(fulfills get_set
  (steps
    ((unfold mem_get lhs)
     (unfold mem_set lhs)
     (unfold raw_get lhs)
     (simp lhs)
     (rewrite (lemma lookup_insert_eq) lr lhs true ())
     (simp lhs))
    refl))

(fulfills get_set_other
  (steps
    ((unfold mem_get lhs) (unfold mem_set lhs) (unfold raw_get lhs) (simp lhs))
    (rewrite-with
      (lemma lookup_insert_neq)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl))
      (steps ((unfold mem_get rhs) (unfold raw_get rhs) (simp both)) refl))))

(fulfills get_set_byte
  (steps
    ((rewrite (lemma get_set) lr lhs true ()))
    (rewrite-with
      (lemma mod_byte_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl))
      refl)))

(fulfills get_set_get
  (steps
    ((rewrite (lemma get_set) lr lhs true ()) (unfold mem_get both))
    (rewrite-with
      (lemma mod_byte_id)
      lr
      lhs
      ()
      ((rewrite-with
         (lemma mod_lo)
         lr
         lhs
         ()
         ((steps ((compute both)) refl))
         refl)
       (rewrite-with
         (lemma mod_hi)
         lr
         lhs
         ()
         ((steps ((compute both)) refl))
         refl))
      refl)))

;; --- LE-layer internal lemmas ------------------------------------------------

;; x + 0 = x (the load tower's Z tail).
(claim add_zero_r
  (goal ((x Int)) () (= (+ x 0) x))
  (by arith (list (list 1) (list 1))))

;; address disequalities at literal offsets 1/2/3 — the get_set_other feeders
;; for peeling a store chain (x matches any address tree).
(claim neq_lo1
  (goal ((x Int)) () (= (int_eq x (+ x 1)) False))
  (by arith (list 1)))

(claim neq_lo2
  (goal ((x Int)) () (= (int_eq x (+ (+ x 1) 1)) False))
  (by arith (list 1)))

(claim neq_lo3
  (goal ((x Int)) () (= (int_eq x (+ (+ (+ x 1) 1) 1)) False))
  (by arith (list 1)))

(claim neq_lo4
  (goal ((x Int)) () (= (int_eq x (+ (+ (+ (+ x 1) 1) 1) 1)) False))
  (by arith (list 1)))

(claim neq_lo5
  (goal ((x Int)) () (= (int_eq x (+ (+ (+ (+ (+ x 1) 1) 1) 1) 1)) False))
  (by arith (list 1)))

(claim neq_lo6
  (goal ((x Int)) () (= (int_eq x (+ (+ (+ (+ (+ (+ x 1) 1) 1) 1) 1) 1)) False))
  (by arith (list 1)))

(claim neq_lo7
  (goal ((x Int)) ()
    (= (int_eq x (+ (+ (+ (+ (+ (+ (+ x 1) 1) 1) 1) 1) 1) 1)) False))
  (by arith (list 1)))

;; the euclidean split at 256, unconditional: byte + 256*quotient = the word.
;; div-facts names q; premise 3 rewrites the ediv atom to it, and the goal is
;; premise 0 rearranged (two-sided farkas).
(claim split_id
  (goal ((x Int)) () (= (+ (mod x 256) (* 256 (ediv x 256))) x))
  (div-facts
    x
    256
    q
    (steps
      ((rewrite (premise 3) lr lhs true ()))
      (by arith (list (list 1 1 0 0 0) (list 1 -1 0 0 0))))))

;; quotient sign: 0 <= x |- 0 <= ediv x 256 (std/div's div_nonneg at 256).
(claim ediv_lo
  (goal ((x Int)) ((= (le 0 x) True)) (= (le 0 (ediv x 256)) True))
  (div-facts x 256 q (by arith (list 256 1 -1 0 1 256))))

;; quotient shrink, symbolic: x < 256*k |- ediv x 256 < k. The cert never
;; mentions the bound, so ONE lemma serves every level of the byte towers
;; (the call sites pin k to the literal and compute the premise's product).
(claim ediv_shrink
  (goal ((x Int) (k Int)) ((= (lt x (* 256 k)) True))
    (= (lt (ediv x 256) k) True))
  (div-facts x 256 q (by arith (list 256 1 1 1 0 -256))))

;; the framing induction's IH-precondition step: a+(1+K) <= b |- (a+1)+K <= b.
;; The successor link is a premise (discharged by int_of_nat_succ at the cite).
(claim above_step
  (goal ((a Int) (b Int) (w Nat))
    ((= (le (+ a (int_of_nat (S w))) b) True)
     (= (int_of_nat (S w)) (+ 1 (int_of_nat w))))
    (= (le (+ (+ a 1) (int_of_nat w)) b) True))
  (by arith (list 1 1 1)))

;; a store range strictly below b cannot start at b: a+(1+K) <= b, K >= 0
;; |- b != a.
(claim above_neq
  (goal ((a Int) (b Int) (w Nat))
    ((= (le (+ a (int_of_nat (S w))) b) True)
     (= (int_of_nat (S w)) (+ 1 (int_of_nat w)))
     (= (le 0 (int_of_nat w)) True))
    (= (int_eq b a) False))
  (by arith (list -1 1 1 1)))

;; the same range fact as a strict order: a+(1+K) <= b, K >= 0 |- a < b
;; (the word-grain framing inductions' byte-skip feeder, COVERAGE.md A-1)
(claim below_lt
  (goal ((a Int) (b Int) (w Nat))
    ((= (le (+ a (int_of_nat (S w))) b) True)
     (= (int_of_nat (S w)) (+ 1 (int_of_nat w)))
     (= (le 0 (int_of_nat w)) True))
    (= (lt a b) True))
  (by arith (list 1 1 1 1)))

;; (* x 0) = 0 (the load tower's Z tail, other half).
(claim mul_zero_r
  (goal ((x Int)) () (= (* x 0) 0))
  (by arith (list (list 1) (list 1))))

;; leveled in-range mod identities: the ediv-chain spelling pins the rewrite
;; site (there is no occurrence-targeted rewrite, and a bare mod_byte_id
;; pattern would grab the leftmost (mod v 256) instead of the tower's tail).
(claim mbid1
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 65536) True))
    (= (mod (ediv x 256) 256) (ediv x 256)))
  (have hlo (= (le 0 (ediv x 256)) True)
    (rewrite-with
      (lemma ediv_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl))
      refl)
    (have hhi (= (lt (ediv x 256) 256) True)
      (rewrite-with
        (lemma ediv_shrink)
        lr
        lhs
        ((inst k 256))
        ((steps ((compute lhs) (rewrite (premise 1) lr lhs true ())) refl))
        refl)
      (rewrite-with
        (lemma mod_byte_id)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hlo) lr lhs true ())) refl)
         (steps ((rewrite (premise hhi) lr lhs true ())) refl))
        refl))))

(claim mbid3
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 4294967296) True))
    (=
      (mod (ediv (ediv (ediv x 256) 256) 256) 256)
      (ediv (ediv (ediv x 256) 256) 256)))
  (have h1lo (= (le 0 (ediv x 256)) True)
    (rewrite-with
      (lemma ediv_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl))
      refl)
    (have h2lo (= (le 0 (ediv (ediv x 256) 256)) True)
      (rewrite-with
        (lemma ediv_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h1lo) lr lhs true ())) refl))
        refl)
      (have h3lo (= (le 0 (ediv (ediv (ediv x 256) 256) 256)) True)
        (rewrite-with
          (lemma ediv_lo)
          lr
          lhs
          ()
          ((steps ((rewrite (premise h2lo) lr lhs true ())) refl))
          refl)
        (have h1hi (= (lt (ediv x 256) 16777216) True)
          (rewrite-with
            (lemma ediv_shrink)
            lr
            lhs
            ((inst k 16777216))
            ((steps ((compute lhs) (rewrite (premise 1) lr lhs true ())) refl))
            refl)
          (have h2hi (= (lt (ediv (ediv x 256) 256) 65536) True)
            (rewrite-with
              (lemma ediv_shrink)
              lr
              lhs
              ((inst k 65536))
              ((steps
                 ((compute lhs) (rewrite (premise h1hi) lr lhs true ()))
                 refl))
              refl)
            (have h3hi (= (lt (ediv (ediv (ediv x 256) 256) 256) 256) True)
              (rewrite-with
                (lemma ediv_shrink)
                lr
                lhs
                ((inst k 256))
                ((steps
                   ((compute lhs) (rewrite (premise h2hi) lr lhs true ()))
                   refl))
                refl)
              (rewrite-with
                (lemma mod_byte_id)
                lr
                lhs
                ()
                ((steps ((rewrite (premise h3lo) lr lhs true ())) refl)
                 (steps ((rewrite (premise h3hi) lr lhs true ())) refl))
                refl))))))))

;; the 64-bit level (COVERAGE.md A-1): seven quotient steps
(claim mbid7
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 18446744073709551616) True))
    (=
      (mod
        (ediv
          (ediv (ediv (ediv (ediv (ediv (ediv x 256) 256) 256) 256) 256) 256)
          256)
        256)
      (ediv
        (ediv (ediv (ediv (ediv (ediv (ediv x 256) 256) 256) 256) 256) 256)
        256)))
  (have h1lo (= (le 0 (ediv x 256)) True)
    (rewrite-with
      (lemma ediv_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl))
      refl)
    (have h2lo (= (le 0 (ediv (ediv x 256) 256)) True)
      (rewrite-with
        (lemma ediv_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h1lo) lr lhs true ())) refl))
        refl)
      (have h3lo (= (le 0 (ediv (ediv (ediv x 256) 256) 256)) True)
        (rewrite-with
          (lemma ediv_lo)
          lr
          lhs
          ()
          ((steps ((rewrite (premise h2lo) lr lhs true ())) refl))
          refl)
        (have h4lo (= (le 0 (ediv (ediv (ediv (ediv x 256) 256) 256) 256)) True)
          (rewrite-with
            (lemma ediv_lo)
            lr
            lhs
            ()
            ((steps ((rewrite (premise h3lo) lr lhs true ())) refl))
            refl)
          (have h5lo
            (=
              (le 0 (ediv (ediv (ediv (ediv (ediv x 256) 256) 256) 256) 256))
              True)
            (rewrite-with
              (lemma ediv_lo)
              lr
              lhs
              ()
              ((steps ((rewrite (premise h4lo) lr lhs true ())) refl))
              refl)
            (have h6lo
              (=
                (le
                  0
                  (ediv
                    (ediv (ediv (ediv (ediv (ediv x 256) 256) 256) 256) 256)
                    256))
                True)
              (rewrite-with
                (lemma ediv_lo)
                lr
                lhs
                ()
                ((steps ((rewrite (premise h5lo) lr lhs true ())) refl))
                refl)
              (have h7lo
                (=
                  (le
                    0
                    (ediv
                      (ediv
                        (ediv (ediv (ediv (ediv (ediv x 256) 256) 256) 256) 256)
                        256)
                      256))
                  True)
                (rewrite-with
                  (lemma ediv_lo)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise h6lo) lr lhs true ())) refl))
                  refl)
                (have h1hi (= (lt (ediv x 256) 72057594037927936) True)
                  (rewrite-with
                    (lemma ediv_shrink)
                    lr
                    lhs
                    ((inst k 72057594037927936))
                    ((steps
                       ((compute lhs) (rewrite (premise 1) lr lhs true ()))
                       refl))
                    refl)
                  (have h2hi
                    (= (lt (ediv (ediv x 256) 256) 281474976710656) True)
                    (rewrite-with
                      (lemma ediv_shrink)
                      lr
                      lhs
                      ((inst k 281474976710656))
                      ((steps
                         ((compute lhs) (rewrite (premise h1hi) lr lhs true ()))
                         refl))
                      refl)
                    (have h3hi
                      (=
                        (lt (ediv (ediv (ediv x 256) 256) 256) 1099511627776)
                        True)
                      (rewrite-with
                        (lemma ediv_shrink)
                        lr
                        lhs
                        ((inst k 1099511627776))
                        ((steps
                           ((compute lhs)
                            (rewrite (premise h2hi) lr lhs true ()))
                           refl))
                        refl)
                      (have h4hi
                        (=
                          (lt
                            (ediv (ediv (ediv (ediv x 256) 256) 256) 256)
                            4294967296)
                          True)
                        (rewrite-with
                          (lemma ediv_shrink)
                          lr
                          lhs
                          ((inst k 4294967296))
                          ((steps
                             ((compute lhs)
                              (rewrite (premise h3hi) lr lhs true ()))
                             refl))
                          refl)
                        (have h5hi
                          (=
                            (lt
                              (ediv
                                (ediv (ediv (ediv (ediv x 256) 256) 256) 256)
                                256)
                              16777216)
                            True)
                          (rewrite-with
                            (lemma ediv_shrink)
                            lr
                            lhs
                            ((inst k 16777216))
                            ((steps
                               ((compute lhs)
                                (rewrite (premise h4hi) lr lhs true ()))
                               refl))
                            refl)
                          (have h6hi
                            (=
                              (lt
                                (ediv
                                  (ediv
                                    (ediv
                                      (ediv (ediv (ediv x 256) 256) 256)
                                      256)
                                    256)
                                  256)
                                65536)
                              True)
                            (rewrite-with
                              (lemma ediv_shrink)
                              lr
                              lhs
                              ((inst k 65536))
                              ((steps
                                 ((compute lhs)
                                  (rewrite (premise h5hi) lr lhs true ()))
                                 refl))
                              refl)
                            (have h7hi
                              (=
                                (lt
                                  (ediv
                                    (ediv
                                      (ediv
                                        (ediv
                                          (ediv (ediv (ediv x 256) 256) 256)
                                          256)
                                        256)
                                      256)
                                    256)
                                  256)
                                True)
                              (rewrite-with
                                (lemma ediv_shrink)
                                lr
                                lhs
                                ((inst k 256))
                                ((steps
                                   ((compute lhs)
                                    (rewrite (premise h6hi) lr lhs true ()))
                                   refl))
                                refl)
                              (rewrite-with
                                (lemma mod_byte_id)
                                lr
                                lhs
                                ()
                                ((steps
                                   ((rewrite (premise h7lo) lr lhs true ()))
                                   refl)
                                 (steps
                                   ((rewrite (premise h7hi) lr lhs true ()))
                                   refl))
                                refl))))))))))))))))

;; --- discharge the LE interface obligations ----------------------------------

(fulfills load_le_z auto)

(fulfills load_le_s auto)

(fulfills store_le_z auto)

(fulfills store_le_s auto)

;; below-range framing: induction on the width; each step skips the byte
;; store via get_set_other (b<a gives b!=a) and hands the IH the shifted
;; bound b < a+1. (The word-grain laws below cite these two fulfilled
;; requirements by name — a fulfilled requirement is citable from its own
;; impl once its fulfills has been checked.)
(fulfills store_le_get_below
  (induct w
    ((case Z (steps ((rewrite (lemma store_le_z) lr lhs true ())) refl))
     (case S
       (steps
         ((rewrite (lemma store_le_s) lr lhs true ()))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma lt_succ_from_lt)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl))
              refl))
           (rewrite-with
             (lemma get_set_other)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma lt_implies_neq)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                refl))
             refl)))))))

;; above-range framing: same induction; the IH bound steps by above_step and
;; the byte skip's disequality comes from above_neq (w2 is a pivot — premises
;; only — so it is Inst-pinned at the cite).
(fulfills store_le_get_above
  (induct w
    ((case Z (steps ((rewrite (lemma store_le_z) lr lhs true ())) refl))
     (case S
       (w2)
       (steps
         ((rewrite (lemma store_le_s) lr lhs true ()))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma above_step)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl)
               (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
              refl))
           (rewrite-with
             (lemma get_set_other)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma above_neq)
                lr
                lhs
                ((inst w w2))
                ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                 (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl)
                 (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
                refl))
             refl)))))))

;; --- word-grain framing (COVERAGE.md A-1): induct on the read width, the
;; head byte skips the store by the byte law, the tail by the IH one
;; address up (above_step / le_succ_r / lt_succ_from_lt move the bound)

(fulfills load_le_store_le_below
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma load_le_z) lr lhs true ())
          (rewrite (lemma load_le_z) lr rhs true ()))
         refl))
     (case S
       (w2)
       (steps
         ((rewrite (lemma load_le_s) lr lhs true ())
          (rewrite (lemma load_le_s) lr rhs true ()))
         (rewrite-with
           (lemma store_le_get_below)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma below_lt)
              lr
              lhs
              ((inst w w2))
              ((steps ((rewrite (premise 0) lr lhs true ())) refl)
               (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl)
               (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
              refl))
           (rewrite-with
             (hyp ih)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma above_step)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                 (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
                refl))
             refl)))))))

(fulfills load_le_store_le_above
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma load_le_z) lr lhs true ())
          (rewrite (lemma load_le_z) lr rhs true ()))
         refl))
     (case S
       (w2)
       (steps
         ((rewrite (lemma load_le_s) lr lhs true ())
          (rewrite (lemma load_le_s) lr rhs true ()))
         (rewrite-with
           (lemma store_le_get_above)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl))
           (rewrite-with
             (hyp ih)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma le_succ_r)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                refl))
             refl)))))))

(fulfills load_le_set_below
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma load_le_z) lr lhs true ())
          (rewrite (lemma load_le_z) lr rhs true ()))
         refl))
     (case S
       (w2)
       (steps
         ((rewrite (lemma load_le_s) lr lhs true ())
          (rewrite (lemma load_le_s) lr rhs true ()))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma lt_implies_neq)
              lr
              lhs
              ()
              ((rewrite-with
                 (lemma below_lt)
                 lr
                 lhs
                 ((inst w w2))
                 ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                  (steps
                    ((rewrite (lemma int_of_nat_succ) lr lhs true ()))
                    refl)
                  (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
                 refl))
              refl))
           (rewrite-with
             (hyp ih)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma above_step)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                 (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
                refl))
             refl)))))))

(fulfills load_le_set_above
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma load_le_z) lr lhs true ())
          (rewrite (lemma load_le_z) lr rhs true ()))
         refl))
     (case S
       (w2)
       (steps
         ((rewrite (lemma load_le_s) lr lhs true ())
          (rewrite (lemma load_le_s) lr rhs true ()))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma lt_implies_neq_flip)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl))
              refl))
           (rewrite-with
             (hyp ih)
             lr
             lhs
             ()
             ((rewrite-with
                (lemma lt_succ_from_lt)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                refl))
             refl)))))))

;; the congruence (COVERAGE.md A-1): induct on w; the head store at b is
;; read at a either as the stored byte (get_set, both sides) or through to
;; the bases (get_set_other, then the premise), and the IH carries the agreement up
(fulfills store_le_get_congr
  (induct w
    ((case Z
       (steps
         ((rewrite (lemma store_le_z) lr lhs true ())
          (rewrite (lemma store_le_z) lr rhs true ())
          (rewrite (premise 0) lr lhs true ()))
         refl))
     (case S
       (w2)
       (chain
         (steps
           ((rewrite (lemma store_le_s) lr lhs true ())
            (rewrite (lemma store_le_s) lr rhs true ())))
         (rewrite-with
           (hyp ih)
           lr
           lhs
           ((inst m2 (mem_set m2 b v)))
           ((case-on (int_eq a b) Bool
              ((case True
                 (chain
                   (have hab (= (int_eq a b) True)
                     (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                   (have heq (= a b)
                     (by arith (list (list 1 0 -1) (list 1 0 1))))
                   (steps
                     ((rewrite (premise heq) lr both true ())
                      (rewrite (lemma get_set) lr lhs true ())
                      (rewrite (lemma get_set) lr rhs true ()))
                     refl)))
               (case False
                 (chain
                   (have hab (= (int_eq a b) False)
                     (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                   (rewrite-with
                     (lemma get_set_other)
                     lr
                     lhs
                     ()
                     ((steps ((rewrite (premise hab) lr lhs true ())) refl)))
                   (rewrite-with
                     (lemma get_set_other)
                     lr
                     rhs
                     ()
                     ((steps ((rewrite (premise hab) lr lhs true ())) refl)))
                   (steps ((rewrite (premise 0) lr lhs true ())) refl))))))
           refl))))))

;; width-1 round trip: unfold by the defining equations, collapse the store
;; (get_set), and the in-range mod identity finishes.
(fulfills ls1_id
  (steps
    ((rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_z) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_z) lr lhs true ())
     (rewrite (lemma mul_zero_r) lr lhs true ())
     (rewrite (lemma add_zero_r) lr lhs true ())
     (rewrite (lemma get_set) lr lhs true ()))
    (rewrite-with
      (lemma mod_byte_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl))
      refl)))

;; width-2 round trip: unfold, collapse the HIGH byte first (it is the only
;; get_set site while the low site still wears the outer store), ladder it to
;; the raw quotient (mbid1), then peel the low site and split_id recomposes.
(fulfills ls2_id
  (steps
    ((rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_z) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_z) lr lhs true ())
     (rewrite (lemma mul_zero_r) lr lhs true ())
     (rewrite (lemma add_zero_r) lr lhs true ())
     (rewrite (lemma get_set) lr lhs true ()))
    (rewrite-with
      (lemma mbid1)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl))
      (rewrite-with
        (lemma get_set_other)
        lr
        lhs
        ()
        ((steps ((rewrite (lemma neq_lo1) lr lhs true ())) refl))
        (steps
          ((rewrite (lemma get_set) lr lhs true ())
           (rewrite (lemma split_id) lr lhs true ()))
          refl)))))

;; width-4 round trip: same shape, three levels deeper — peel sites highest-
;; address-first (each is the unique get_set site at its turn), mbid3 fixes
;; the top quotient, split_id recomposes level by level.
(fulfills ls4_id
  (steps
    ((rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_s) lr lhs true ())
     (rewrite (lemma store_le_z) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_s) lr lhs true ())
     (rewrite (lemma load_le_z) lr lhs true ())
     (rewrite (lemma mul_zero_r) lr lhs true ())
     (rewrite (lemma add_zero_r) lr lhs true ())
     (rewrite (lemma get_set) lr lhs true ()))
    (rewrite-with
      (lemma mbid3)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl))
      (rewrite-with
        (lemma get_set_other)
        lr
        lhs
        ()
        ((steps ((rewrite (lemma neq_lo3) lr lhs true ())) refl))
        (rewrite-with
          (lemma get_set_other)
          lr
          lhs
          ()
          ((steps ((rewrite (lemma neq_lo2) lr lhs true ())) refl))
          (rewrite-with
            (lemma get_set_other)
            lr
            lhs
            ()
            ((steps ((rewrite (lemma neq_lo1) lr lhs true ())) refl))
            (steps
              ((rewrite (lemma get_set) lr lhs true ()))
              (rewrite-with
                (lemma get_set_other)
                lr
                lhs
                ()
                ((steps ((rewrite (lemma neq_lo2) lr lhs true ())) refl))
                (rewrite-with
                  (lemma get_set_other)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (lemma neq_lo1) lr lhs true ())) refl))
                  (steps
                    ((rewrite (lemma get_set) lr lhs true ()))
                    (rewrite-with
                      (lemma get_set_other)
                      lr
                      lhs
                      ()
                      ((steps ((rewrite (lemma neq_lo1) lr lhs true ())) refl))
                      (steps
                        ((rewrite (lemma get_set) lr lhs true ())
                         (rewrite (lemma split_id) lr lhs true ())
                         (rewrite (lemma split_id) lr lhs true ())
                         (rewrite (lemma split_id) lr lhs true ()))
                        refl))))))))))))

;; --- the aggregate readback view ----------------------------------------------
;;
;; mem_read = the abstraction function for aggregate rep relations (mod.req's
;; last section; graduated from the §6p-§6r probes' br_read). The framing
;; proofs are the probes' window lemma (bc_swin) made surface law: induction
;; on the width, the head byte skips the store via get_set_other, the IH takes the
;; shifted bound.

(fn mem_read ((w Nat) (m Mem) (a Int)) (List Int)
  (measure (struct w))
  (match w
    (Z Nil)
    ((S w2) (Cons (mem_get m a) (mem_read w2 m (+ a 1))))))

