;; the epilogue: paddd feedback against the saved entry state, the unpack
;; shuffles, and the two stores back to the state home.
(fn shnw_epi ((rest (List XInstr))) (List XInstr)
  (Cons
    (XVec (XVPaddd XMM1 XMM9))
    (Cons
      (XVec (XVPaddd XMM2 XMM10))
      (Cons
        (XVec (XVPshufd XMM1 XMM1 27))
        (Cons
          (XVec (XVPshufd XMM2 XMM2 27))
          (Cons
            (XVec (XVMov XMM11 XMM1))
            (Cons
              (XVec (XVPunpckL XMM1 XMM2))
              (Cons
                (XVec (XVPunpckH XMM11 XMM2))
                (Cons
                  (XMovRI R10 131008)
                  (Cons
                    (XVec (XVStore (AReg R10) XMM1))
                    (Cons
                      (XMovRI R10 131024)
                      (Cons (XVec (XVStore (AReg R10) XMM11)) rest))))))))))))

;; the whole body: the stanzas composed, each Cons'ing onto the next.
(fn shnw_body () (List XInstr)
  (shnw_pro
    (shnw_q0
      (shnw_q1
        (shnw_q2
          (shnw_q3
            (shnw_q4
              (shnw_q5
                (shnw_q6
                  (shnw_q7
                    (shnw_q8
                      (shnw_q9
                        (shnw_q10
                          (shnw_q11
                            (shnw_q12
                              (shnw_q13 (shnw_q14 (shnw_q15 (shnw_epi Nil)))))))))))))))))))

;; the one-function module: the body at index 0, window [65536,131072).
(fn shnw_m () XModule
  (MkXModule (Cons (MkXFunc 0 (shnw_body)) Nil) 65536 131072))

;; the state home: linear dword layout, a..d at 131008, e..h at 131024.
(fn shnw_hmem ((m Mem) (st H8)) Mem
  (vstore
    (vstore m 131008 (MkXmm (shn_ha st) (shn_hb st) (shn_hc st) (shn_hd st)))
    131024
    (MkXmm (shn_he st) (shn_hf st) (shn_hg st) (shn_hh st))))

;; ---- THE STANZA LAWS ---------------------------------------------------------------
;;
;; One law per qround stanza: its twelve (or seven) instructions walked at a
;; FREE fuel tail and a FREE instruction tail, so the laws chain by rewriting
;; without ever running the walk past the stanza's end. Everything a stanza
;; produces stays FOLDED behind the article's own functions -- shn_qround's
;; two projections and shn_sstep -- which is the whole point: letting those
;; trees expand is the measured tetranacci blow-up (a symbolic shn_block
;; compute core-dumps at ~168 s).
;;
;; Both records are spelled OPEN (MkRegs / MkXmms over variables): an abstract
;; record leaves every read a stuck projection, and the address gates then
;; never resolve.

;; qround 0: the schedule step folds to shn_sstep; the round state folds to shn_qround's two projections.
(claim shnw_law_q0
  (goal
    ((f Nat)
     (rest (List XInstr))
     (mem Mem)
     (a0 Int)
     (a1 Int)
     (a2 Int)
     (a3 Int)
     (a4 Int)
     (a5 Int)
     (a6 Int)
     (a7 Int)
     (a8 Int)
     (a9 Int)
     (a10 Int)
     (a11 Int)
     (a12 Int)
     (a13 Int)
     (a14 Int)
     (v0 Xmm)
     (v1 Xmm)
     (v2 Xmm)
     (v3 Xmm)
     (v4 Xmm)
     (v5 Xmm)
     (v6 Xmm)
     (v7 Xmm)
     (v8 Xmm)
     (v9 Xmm)
     (v10 Xmm)
     (v11 Xmm)
     (v12 Xmm)
     (v13 Xmm)
     (v14 Xmm)
     (v15 Xmm))
    ()
    (=
      (xveval_seq
        (S (S (S (S (S (S (S (S (S (S (S (S (S f)))))))))))))
        (shnw_m)
        (shnw_q0 rest)
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)
      (xveval_seq
        (S f)
        (shnw_m)
        rest
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 130752 a11 a12 a13 a14)
        (MkXmms
          (vpshufd (vpaddd v3 (vload mem 130752)) 14)
          (rabef_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 130752)))
          (rcdgh_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 130752)))
          (shn_sstep v3 v4 v5 v6)
          v4
          v5
          v6
          (vpalignr v6 v5 4)
          v8
          v9
          v10
          (vload mem 130752)
          v12
          v13
          v14
          v15)
        mem)))
  (steps
    ((compute lhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2))
     (compute rhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2)))
    refl))

