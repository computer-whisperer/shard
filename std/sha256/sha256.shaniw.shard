;; ---- THE BOUNDARY LAWS -------------------------------------------------------------

;; the ShnRs eta law: rebuilding a round state from its two projections is
;; the identity. The composition needs it because each stanza law hands the
;; next one PROJECTIONS of the previous qround where the article's nest
;; passes the qround record itself.
(claim shnw_rs_eta
  (goal ((s ShnRs)) () (= (MkShnRs (rabef_of s) (rcdgh_of s)) s))
  (case-on s ShnRs
    ((case MkShnRs
       (pa pc)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

