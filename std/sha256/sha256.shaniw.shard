;; ---- THE SUMMIT'S NAMES ------------------------------------------------------------
;; shnw_s16 names the article's sixteen-qround nest (shn_block's let body);
;; shnw_f1/shnw_f2 name the two feedback registers. The composition folds the
;; walked towers INTO these names (def lemmas cited rl), so the summit's
;; statement and its final-file clobber map stay readable.

(fn shnw_s16 ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ShnRs
  (shn_qround
    (shn_qround
      (shn_qround
        (shn_qround
          (shn_qround
            (shn_qround
              (shn_qround
                (shn_qround
                  (shn_qround
                    (shn_qround
                      (shn_qround
                        (shn_qround
                          (shn_qround
                            (shn_qround
                              (shn_qround
                                (shn_qround
                                  (MkShnRs (shn_pk_abef st) (shn_pk_cdgh st))
                                  g0
                                  (shn_kg 0))
                                g1
                                (shn_kg 1))
                              g2
                              (shn_kg 2))
                            g3
                            (shn_kg 3))
                          (shn_g4 g0 g1 g2 g3)
                          (shn_kg 4))
                        (shn_g5 g0 g1 g2 g3)
                        (shn_kg 5))
                      (shn_g6 g0 g1 g2 g3)
                      (shn_kg 6))
                    (shn_g7 g0 g1 g2 g3)
                    (shn_kg 7))
                  (shn_g8 g0 g1 g2 g3)
                  (shn_kg 8))
                (shn_g9 g0 g1 g2 g3)
                (shn_kg 9))
              (shn_g10 g0 g1 g2 g3)
              (shn_kg 10))
            (shn_g11 g0 g1 g2 g3)
            (shn_kg 11))
          (shn_g12 g0 g1 g2 g3)
          (shn_kg 12))
        (shn_g13 g0 g1 g2 g3)
        (shn_kg 13))
      (shn_g14 g0 g1 g2 g3)
      (shn_kg 14))
    (shn_g15 g0 g1 g2 g3)
    (shn_kg 15)))

(fn shnw_f1 ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (vpaddd (rabef_of (shnw_s16 st g0 g1 g2 g3)) (shn_pk_abef st)))

(fn shnw_f2 ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (vpaddd (rcdgh_of (shnw_s16 st g0 g1 g2 g3)) (shn_pk_cdgh st)))

(claim shnw_s16_def
  (goal ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ()
    (=
      (shnw_s16 st g0 g1 g2 g3)
      (shn_qround
        (shn_qround
          (shn_qround
            (shn_qround
              (shn_qround
                (shn_qround
                  (shn_qround
                    (shn_qround
                      (shn_qround
                        (shn_qround
                          (shn_qround
                            (shn_qround
                              (shn_qround
                                (shn_qround
                                  (shn_qround
                                    (shn_qround
                                      (MkShnRs
                                        (shn_pk_abef st)
                                        (shn_pk_cdgh st))
                                      g0
                                      (shn_kg 0))
                                    g1
                                    (shn_kg 1))
                                  g2
                                  (shn_kg 2))
                                g3
                                (shn_kg 3))
                              (shn_g4 g0 g1 g2 g3)
                              (shn_kg 4))
                            (shn_g5 g0 g1 g2 g3)
                            (shn_kg 5))
                          (shn_g6 g0 g1 g2 g3)
                          (shn_kg 6))
                        (shn_g7 g0 g1 g2 g3)
                        (shn_kg 7))
                      (shn_g8 g0 g1 g2 g3)
                      (shn_kg 8))
                    (shn_g9 g0 g1 g2 g3)
                    (shn_kg 9))
                  (shn_g10 g0 g1 g2 g3)
                  (shn_kg 10))
                (shn_g11 g0 g1 g2 g3)
                (shn_kg 11))
              (shn_g12 g0 g1 g2 g3)
              (shn_kg 12))
            (shn_g13 g0 g1 g2 g3)
            (shn_kg 13))
          (shn_g14 g0 g1 g2 g3)
          (shn_kg 14))
        (shn_g15 g0 g1 g2 g3)
        (shn_kg 15))))
  (steps ((unfold shnw_s16 lhs)) refl))

(claim shnw_f1_def
  (goal ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ()
    (=
      (shnw_f1 st g0 g1 g2 g3)
      (vpaddd (rabef_of (shnw_s16 st g0 g1 g2 g3)) (shn_pk_abef st))))
  (steps ((unfold shnw_f1 lhs)) refl))

(claim shnw_f2_def
  (goal ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ()
    (=
      (shnw_f2 st g0 g1 g2 g3)
      (vpaddd (rcdgh_of (shnw_s16 st g0 g1 g2 g3)) (shn_pk_cdgh st))))
  (steps ((unfold shnw_f2 lhs)) refl))

;; the split: shn_block IS shn_unpack of the two named feedback registers.
(claim shnw_block_split
  (goal ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ()
    (=
      (shn_block st g0 g1 g2 g3)
      (shn_unpack (shnw_f1 st g0 g1 g2 g3) (shnw_f2 st g0 g1 g2 g3))))
  (steps
    ((compute
       lhs
       (stop shn_qround shn_kg shn_g4 shn_g5 shn_g6 shn_g7 shn_g8 shn_g9 shn_g10
         shn_g11 shn_g12 shn_g13 shn_g14 shn_g15 shn_pk_abef shn_pk_cdgh vpaddd
         x0_of x1_of x2_of x3_of rabef_of rcdgh_of))
     (compute
       rhs
       (stop shn_qround shn_kg shn_g4 shn_g5 shn_g6 shn_g7 shn_g8 shn_g9 shn_g10
         shn_g11 shn_g12 shn_g13 shn_g14 shn_g15 shn_pk_abef shn_pk_cdgh vpaddd
         x0_of x1_of x2_of x3_of rabef_of rcdgh_of)))
    refl))

