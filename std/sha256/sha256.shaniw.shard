;;; sha256.shaniw.shard — THE SHA-NI MACHINE TRANCHE AT THE STREAMING
;;; LAYOUT (Arc B rung B5, E3 slice A — docs/STREAM.md §8.4; landed
;;; from e3a_probe 2026-08-09).
;;;
;;; The E2b machine tranche (sha256.shani.shard, shn_pro..shn_walk)
;;; regenerated at THE STREAMING BIN'S LAYOUT under shnw_ names
;;; ("shani at the window"): window [0,65536) -> [65536,131072),
;;; mask@256 -> 130496 (the dead W frame's base — SHA-NI keeps the
;;; schedule in registers, so W is free), K@[512,768) -> [130752,131008)
;;; (the skeleton's own K home — byte-identical content layout),
;;; H@[768,800) -> [131008,131040) (the skeleton's H home — the
;;; absorber/finalizer readback equations hold unchanged).
;;;
;;; MECHANICALLY REGENERATED from the sha256.shani tranche text by
;;; three ordered token maps (E2b-transplant precedent, one level up):
;;;   1. the 48 machine-tranche names shn_X -> shnw_X (word-boundary;
;;;      value-tier citations shn_qround/shn_kg/... stay);
;;;   2. the address map 256->130496, 512+16i -> 130752+16i,
;;;      768->131008, 784->131024, 800->131040, 65536->131072;
;;;   3. the base fixes: src lower-bound premises (le 0 ..) ->
;;;      (le 65536 ..) and the module former's base 0 -> 65536.
;;; NO proof steps changed: every farkas gate discharge is an
;;; index-and-multiplier row citation — (rows (goal 1) (N 1)) — with
;;; no ground constants, so the discharges are invariant under the map.
;;; The checker adjudicates the whole regeneration. Ground validation
;;; was e3a_run.shard (the e2bm_run differential at this layout, 8/8).
;;; Consumed by sha256.snweld.shard (the fold leaf composes these
;;; stanza summits against its live loop tail).

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/bits")
(use (:: std bits *))
(import "../../std/mem")
(use (:: std mem *))
(import "sha256.shard")
(use (:: std sha256 sha256 *))
(import "../../models/x86/x86.shard")
(use (:: models x86 x86 *))
(import "../../models/x86/vector.shard")
(use (:: models x86 vector *))
(import "sha256.shani.shard")
(use (:: std sha256 sha256.shani *))

;; E2b MACHINE TIER -- THE HAND BODY AND THE BLOCK WALK
;; ===================================================================
;; One SHA-NI block as a straight-line XVec instruction sequence, and
;; THE BLOCK WALK (shnw_walk): walking it through the vector-tier
;; machine (xveval_seq) from ANY entry register and XMM file computes
;; shn_block on the loaded state and byte-flipped message groups.
;; Landed from the E2b machine-half probe (docs/STREAM.md 8.4; summit
;; first-check 2026-08-03). NO ground pins in this tranche: std/mem's
;; Mem is OPAQUE in check mode (mem_get of a mem_set tree stays stuck
;; -- the recorded M1 law), so ground machine runs live in the
;; run-mode differential (E2b slice A's 8 rows; the block-grain
;; silicon differential is E2c).
;;
;; REGISTER ALLOCATION (the E2b decision the body freezes):
;;   XMM0  = wk (sha256rnds2's implicit third operand)
;;   XMM1  = ABEF   XMM2 = CDGH   (roles NEVER swap: rnds2 C,A then
;;           pshufd wk 0x0E then rnds2 A,C -- the slide law's alternation)
;;   XMM3..XMM6 = the rotating four-group message window (W_j lives in
;;           XMM(3 + j mod 4); the sched step overwrites g_j with g_{j+4})
;;   XMM7  = sched temp (mov g3; palignr g2 4)
;;   XMM8  = the byte-flip mask, resident (XVBswap32's fence)
;;   XMM9/XMM10 = entry ABEF/CDGH saved for the paddd feedback
;;   XMM11 = K-group load target + pack/unpack shuffle temp
;;   scalar: RDI = src (the 64-byte block, caller's argument),
;;           R10 = home pointer scratch, R11 = K-table pointer
;; THE STREAMING-LAYOUT HOMES (the E3a rebase of the article's teaching homes):
;;   mask@130496, K table@[130752,131008) (16 groups, shn_kg i at 130752+16i),
;;   H@[131008,131040) (linear dword layout: a..d then e..h), block at RDI (the caller's in-window pointer).

;; ---- the hand body -----------------------------------------------------------------

;; the prologue: mask resident, the state home packed to ABEF/CDGH and
;; saved for the feedback, the four message groups loaded and byte-flipped.
(fn shnw_pro ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R10 130496)
    (Cons
      (XVec (XVLoad XMM8 (AReg R10)))
      (Cons
        (XMovRI R10 131008)
        (Cons
          (XVec (XVLoad XMM1 (AReg R10)))
          (Cons
            (XMovRI R10 131024)
            (Cons
              (XVec (XVLoad XMM2 (AReg R10)))
              (Cons
                (XVec (XVPshufd XMM1 XMM1 177))
                (Cons
                  (XVec (XVPshufd XMM2 XMM2 27))
                  (Cons
                    (XVec (XVPshufd XMM11 XMM1 14))
                    (Cons
                      (XVec (XVPalignr XMM1 XMM2 8))
                      (Cons
                        (XVec (XVPunpckL XMM2 XMM11))
                        (Cons
                          (XVec (XVMov XMM9 XMM1))
                          (Cons
                            (XVec (XVMov XMM10 XMM2))
                            (Cons
                              (XVec (XVLoad XMM3 (AReg RDI)))
                              (Cons
                                (XBin XAdd RDI (SImm 16))
                                (Cons
                                  (XVec (XVLoad XMM4 (AReg RDI)))
                                  (Cons
                                    (XBin XAdd RDI (SImm 16))
                                    (Cons
                                      (XVec (XVLoad XMM5 (AReg RDI)))
                                      (Cons
                                        (XBin XAdd RDI (SImm 16))
                                        (Cons
                                          (XVec (XVLoad XMM6 (AReg RDI)))
                                          (Cons
                                            (XVec (XVBswap32 XMM3 XMM8))
                                            (Cons
                                              (XVec (XVBswap32 XMM4 XMM8))
                                              (Cons
                                                (XVec (XVBswap32 XMM5 XMM8))
                                                (Cons
                                                  (XVec (XVBswap32 XMM6 XMM8))
                                                  rest)))))))))))))))))))))))))

;; qround 0 (with the just-in-time schedule step): wk = W_0 + K_0 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
;; The schedule step overwrites XMM3 (holding W_0) with W_4.
(fn shnw_q0 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 130752)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM3))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVMov XMM7 XMM6))
            (Cons
              (XVec (XVPalignr XMM7 XMM5 4))
              (Cons
                (XVec (XVSha256Msg1 XMM3 XMM4))
                (Cons
                  (XVec (XVPaddd XMM3 XMM7))
                  (Cons
                    (XVec (XVSha256Msg2 XMM3 XMM6))
                    (Cons
                      (XVec (XVSha256Rnds2 XMM2 XMM1))
                      (Cons
                        (XVec (XVPshufd XMM0 XMM0 14))
                        (Cons (XVec (XVSha256Rnds2 XMM1 XMM2)) rest)))))))))))))

