(proof-for
  shc_slen_nn
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c0 c1)
       (steps
         ((simp both))
         (have (= (le 0 (slen c1)) True)
           (steps ((rewrite (hyp 0) lr lhs true ())) refl)
           (by arith (list 1 1))))))))
(proof-for
  shc_slen_sapp
  (induct xs
    ((case Nil
       (steps
         ((unfold sapp lhs) (reduce lhs) (unfold slen rhs) (reduce rhs))
         (by arith (list))))
     (case Cons
       (c0 c1)
       (steps
         ((unfold sapp lhs)
          (reduce lhs)
          (unfold slen lhs)
          (reduce lhs)
          (unfold slen rhs)
          (reduce rhs)
          (rewrite (hyp 0) lr lhs true ()))
         (by arith (list)))))))
(proof-for
  shc_sapp_nil
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c0 c1)
       (steps
         ((unfold sapp lhs) (reduce lhs) (rewrite (hyp 0) lr lhs true ()))
         refl)))))
(proof-for
  shc_sapp_assoc
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (c0 c1)
       (steps
         ((unfold sapp lhs)
          (reduce lhs)
          (unfold sapp lhs)
          (reduce lhs)
          (unfold sapp rhs)
          (reduce rhs)
          (rewrite (hyp 0) lr lhs true ()))
         refl)))))
(proof-for
  shc_sdrop0
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons (c0 c1) (steps ((compute both)) refl)))))
(proof-for
