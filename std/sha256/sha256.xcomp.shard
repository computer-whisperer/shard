;; sha256.xcomp.shard — Arc B rung B1b: the A1×A2 composition exercise
;; (ARC-A-REVIEW-2026-07-26 §2e; STREAM.md §3).  ONE claim: vxo_add's
;; oracle skeleton (vx86_oracle_probe.shard) with the ∀-bound Int args
;; instantiated at A2's xq8-boundary view reads (sha256.xpatch.shard) —
;; x0 = the segment's accumulator local (slot 11) read through the patch
;; view, x1 = the byte the segment just wrote, read through the mem view.
;; The claim composes the A1 soundness theorem (vxg_valid) with the A2
;; patch dialect in one statement with ZERO new machinery: neither
;; execution is replayed and neither view is materialized — the read
;; terms ride the citation as opaque values.  FENCE (recorded at the
;; review): the validator family is mem-free by construction, so
;; vxg_valid cannot replace any block-chain link until a mem-capable
;; statement tier lands — that tier is the family's next growth rung,
;; not this exercise.

(import "../../kernel/stdlib.shard")
(import "sha256.xpatch.shard")
(import "../../models/imp/probes/ipatch_probe.shard")
(import "../../models/imp/probes/vx86_acc_probe.shard")
(import "../../tools/impgen/fixtures/imp_scalar.shard")
(import "../../models/wasm/loopkit.shard")
(import "../../models/imp/imp.shard")
(import "../../models/x86/x86.shard")
(import "../../models/imp/to_x86.shard")
(import "../../std/mem")
(use (:: std sha256 sha256.xpatch *))
(use (:: models imp probes ipatch_probe *))
(use (:: models imp probes vx86_acc_probe *))
(use (:: tools impgen fixtures imp_scalar *))
(use (:: models wasm loopkit *))
(use (:: models imp imp *))
(use (:: models x86 x86 *))
(use (:: models imp to_x86 *))
(use (:: std mem *))

(claim vxq8_add
  (goal
    ((l0 Int)
     (l1 Int)
     (l2 Int)
     (l3 Int)
     (l4 Int)
     (l5 Int)
     (l6 Int)
     (l7 Int)
     (l8 Int)
     (l9 Int)
     (l10 Int)
     (l11 Int)
     (m Mem)
     (c Nat)
     (c2 Nat))
    ()
    (=
      (xcall_fn
        (S^ 8 c)
        (MkXModule (list (x_of (imp2x_fn (it_add_fn)))) 0 0)
        0
        (iband_args
          (list U32 U32)
          (list
            (xp_loc
              (list l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11)
              (xq8 l6 l8 l11 m)
              11)
            (xp_byte m (xq8 l6 l8 l11 m) (xv7 l6 l8 l11 m)))))
      (icall
        (S^ 5 c2)
        (it_prog (it_add_fn))
        0
        (list
          (xp_loc
            (list l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11)
            (xq8 l6 l8 l11 m)
            11)
          (xp_byte m (xq8 l6 l8 l11 m) (xv7 l6 l8 l11 m))))))
  (chain
    (have hval
      (=
        (valid_imp_x86
          (it_add_fn)
          (x_of (imp2x_fn (it_add_fn)))
          (MkVxWitness
            (list (vx_xilen (vx_oxi (ix_stmts (ibody_of (it_add_fn))))))))
        True)
      (steps ((compute lhs)) refl))
    (have harg
      (=
        (ilen
          (list
            (xp_loc
              (list l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11)
              (xq8 l6 l8 l11 m)
              11)
            (xp_byte m (xq8 l6 l8 l11 m) (xv7 l6 l8 l11 m))))
        (ikn (ikparams_of (it_add_fn))))
      (steps ((compute both)) refl))
    (have hv
      (=
        (xcall_fn
          (lg_fuel
            (vx_iln (xbody_of (x_of (imp2x_fn (it_add_fn)))))
            (S (S^ 5 c)))
          (MkXModule (list (x_of (imp2x_fn (it_add_fn)))) 0 0)
          0
          (iband_args
            (ikparams_of (it_add_fn))
            (list
              (xp_loc
                (list l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11)
                (xq8 l6 l8 l11 m)
                11)
              (xp_byte m (xq8 l6 l8 l11 m) (xv7 l6 l8 l11 m)))))
        (icall
          (lg_fuel (istn (ibody_of (it_add_fn))) (S (S^ 4 c2)))
          (MkIProg (list (it_add_fn)) 0 0)
          0
          (list
            (xp_loc
              (list l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11)
              (xq8 l6 l8 l11 m)
              11)
            (xp_byte m (xq8 l6 l8 l11 m) (xv7 l6 l8 l11 m)))))
      (rewrite-with
        (lemma vxg_valid)
        lr
        lhs
        ((inst
           w
           (MkVxWitness
             (list (vx_xilen (vx_oxi (ix_stmts (ibody_of (it_add_fn))))))))
         (inst f (S^ 4 c2)))
        ((steps ((rewrite (premise hval) lr lhs true ())) refl)
         (steps ((rewrite (premise harg) lr lhs true ())) refl))
        refl))
    (have hfx
      (=
        (lg_fuel (vx_iln (xbody_of (x_of (imp2x_fn (it_add_fn))))) (S (S^ 5 c)))
        (S^ 8 c))
      (steps ((compute lhs)) refl))
    (have hfi
      (= (lg_fuel (istn (ibody_of (it_add_fn))) (S (S^ 4 c2))) (S^ 5 c2))
      (steps ((compute lhs)) refl))
    (have hki (= (ikparams_of (it_add_fn)) (list U32 U32))
      (steps ((compute lhs)) refl))
    (have hpr (= (MkIProg (list (it_add_fn)) 0 0) (it_prog (it_add_fn)))
      (steps ((compute both)) refl))
    (steps
      ((rewrite (premise hfx) rl lhs true ())
       (rewrite (premise hki) rl lhs true ())
       (rewrite (premise hfi) rl rhs true ())
       (rewrite (premise hpr) rl rhs true ())
       (rewrite (premise hv) lr lhs true ()))
      refl)))
