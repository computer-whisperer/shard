(claim imp_w_shinit
  (goal
    ((x0 Int)
     (x1 Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (x5 Int)
     (x6 Int)
     (x7 Int)
     (x8 Int)
     (x9 Int)
     (x10 Int)
     (x11 Int)
     (st (List Int))
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List Func)))
    ()
    (=
      (eval_seq
        (S^ 2024 c)
        (MkWModule restfs 65536)
        (inline gb_shinit_w)
        (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
        st
        m)
      (iw_sout
        st
        (istmts
          (S^ 583 c2)
          65536
          (inline gb_shinit_i)
          (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
          m))))
  (chain (steps ((compute both))) refl))

