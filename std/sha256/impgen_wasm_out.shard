(claim tie_shtcopy
  (goal () ()
    (=
      (iw_stmts (list U32 U32 U32 U32) (ibody_of (it_shtcopy_fn)))
      (Some
        (list
          (I32Const 0)
          (LocalSet 3)
          (Block
            (list
              (Loop
                (list
                  (LocalGet 2)
                  I32Eqz
                  (BrIf 1)
                  (LocalGet 1)
                  I32Load8U
                  (LocalSet 3)
                  (LocalGet 0)
                  (LocalGet 3)
                  (I32Const 255)
                  (I32Bin BAnd)
                  I32Store8
                  (LocalGet 0)
                  (I32Const 1)
                  (I32Bin BAdd)
                  (LocalSet 0)
                  (LocalGet 1)
                  (I32Const 1)
                  (I32Bin BAdd)
                  (LocalSet 1)
                  (I32Const 0)
                  (LocalSet 3)
                  (LocalGet 2)
                  (I32Const 1)
                  (I32Bin BSub)
                  (LocalSet 2)
                  (Br 0)))))))))
  (steps ((compute both)) refl))

;; it_shtcopy_fn: tie only (bridge scope: loop counter is not ground at the loop head (named growth))

