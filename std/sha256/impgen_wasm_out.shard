(claim imp_w_shpad
  (goal
    ((x0 Int)
     (x1 Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (st (List Int))
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List Func)))
    ()
    (=
      (eval_seq
        (S^ 133 c)
        (MkWModule restfs 65536)
        (inline gb_shpad_w)
        (list x0 x1 x2 x3 x4)
        st
        m)
      (iw_sout
        st
        (istmts (S^ 87 c2) 65536 (inline gb_shpad_i) (list x0 x1 x2 x3 x4) m))))
  (chain
    (have hsp0
      (=
        (inline gb_shpad_i)
        (isapp (inline gb_shpad_s0_i) (inline gb_shpad_r1_i)))
