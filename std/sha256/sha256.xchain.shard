;;; std/sha256/sha256.xchain.shard — ARC B rung B1 (docs/STREAM.md §3): the
;;; shblock suffix chain restated in the conversion dialect. Statements are
;;; byte-identical to the cmp_x_shblock_bN family; only the proofs change:
;;; ist_seam + the (kept) sqs_x_shblock_cN machine segment certs put the
;;; SAME segment term on both sides, the proof case-forks on it, the fail
;;; forks close by compute (xm_scont / ist_cont / ix_sout mirror failure),
;;; and the Some-INorm fork derives the locals arity via il_slen, mints the
;;; twelve slot values as xp_getl reads via ilv_inv12 (ilinv_probe) — one
;;; citation replacing the replay dialect's 12-deep Cons exposure — and
;;; closes with ONE fully-instantiated exact-conv of the next seam.

(import "../../kernel/stdlib.shard")
(import "../../std/mem")
(use (:: std mem *))
(import "../../models/imp/imp.shard")
(use (:: models imp imp *))
(import "../../models/x86/x86.shard")
(use (:: models x86 x86 *))
(import "../../models/imp/to_x86.shard")
(use (:: models imp to_x86 *))
(import "../../models/wasm/loopkit.shard")
(use (:: models wasm loopkit *))
(import "../../models/imp/probes/ipatch_probe.shard")
(use (:: models imp probes ipatch_probe *))
(import "../../models/imp/probes/ilinv_probe.shard")
(use (:: models imp probes ilinv_probe *))
(import "impgen_x86_out.shard")
(use (:: std sha256 impgen_x86_out *))

(claim xch_b13
  (goal
    ((x0 Int)
     (x1 Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (x5 Int)
     (x6 Int)
     (x7 Int)
     (x8 Int)
     (x9 Int)
     (x10 Int)
     (x11 Int)
     (za Int)
     (zb Int)
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List XFunc)))
    ()
    (=
      (xeval_seq
        (S^ 38 c)
        (MkXModule restfs 0 65536)
        (gb_shblock_r13_x)
        (MkRegs za x3 x2 x6 x7 x1 x0 x4 x5 zb 0 x8 x9 x10 x11)
        m)
      (ix_sout
        (istmts
          (S^ 28 c2)
          65536
          (gb_shblock_r13_i)
          (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
          m))))
  (chain
    (steps
      ((unfold gb_shblock_r13_x lhs)
       (reduce lhs)
       (unfold gb_shblock_r13_i rhs)
       (reduce rhs)))
    (steps ((compute both)))
    (case-on (le 0 (mod (+ x8 1) 4294967296)) Bool
      ((case True
         (chain
           (steps ((rewrite (hyp 0) lr both true ()) (compute both)))
           (case-on (lt (mod (+ x8 1) 4294967296) 65536) Bool
             ((case True
                (chain
                  (have hlt2 (= (lt (mod (+ x8 1) 4294967296) 65536) True)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
                  (have hle2 (= (le (+ (mod (+ x8 1) 4294967296) 1) 65536) True)
                    (steps () (by arith (rows (goal 1) (hlt2 1)))))
                  (steps
                    ((rewrite (hyp 0) lr rhs true ())
                     (rewrite (premise hle2) lr lhs true ())
                     (compute both)))
