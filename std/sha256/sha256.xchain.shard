                        ((rewrite (hyp 0) rl lhs true ())
                         (rewrite (hyp 1) rl lhs true ())))
                      (rewrite-with (lemma il_wlen) lr lhs () ())
                      (steps ((compute lhs)))
                      refl))
                  (have hlen (= (ilen lc1) 12)
                    (steps
                      ((change
                         lhs
                         true
                         (iolen
                           (ilen
                             (list
                               x0
                               x1
                               x2
                               x9
                               x4
                               x5
                               x6
                               x7
                               x8
                               x9
                               (int_of_nat 16)
                               x11))
                           (Some (INorm lc1 mm1)))
                         (stop ilen))
                       (rewrite (premise hlen0) lr lhs true ()))
                      refl))
                  (have hinv
                    (=
                      lc1
                      (list
                        (xp_getl lc1 0)
                        (xp_getl lc1 1)
                        (xp_getl lc1 2)
                        (xp_getl lc1 3)
                        (xp_getl lc1 4)
                        (xp_getl lc1 5)
                        (xp_getl lc1 6)
                        (xp_getl lc1 7)
                        (xp_getl lc1 8)
                        (xp_getl lc1 9)
                        (xp_getl lc1 10)
                        (xp_getl lc1 11)))
                    (rewrite-with
                      (lemma ilv_inv12)
                      lr
                      lhs
                      ((inst ls lc1))
                      ((steps ((rewrite (premise hlen) lr lhs true ())) refl))
                      refl))
                  (steps
                    ((rewrite (premise hinv) lr both true ())
                     (compute
                       both
                       (stop xeval_seq istmts iwhile xeval_loop lg_fuel
                         int_of_nat gb_shblock_r1_x gb_shblock_r1_i xp_getl))))
                  (exact-conv
                    (lemma xch_b1)
                    ((inst x0 (xp_getl lc1 0))
                     (inst x1 (xp_getl lc1 1))
                     (inst x2 (xp_getl lc1 2))
                     (inst x3 (xp_getl lc1 3))
                     (inst x4 (xp_getl lc1 4))
                     (inst x5 (xp_getl lc1 5))
                     (inst x6 (xp_getl lc1 6))
                     (inst x7 (xp_getl lc1 7))
                     (inst x8 (xp_getl lc1 8))
                     (inst x9 (xp_getl lc1 9))
                     (inst x10 (xp_getl lc1 10))
                     (inst x11 (xp_getl lc1 11))
                     (inst za 0)
                     (inst zb 0)
                     (inst m mm1)
                     (inst c c)
                     (inst c2 c2)
                     (inst restfs restfs))
                    ()
                    (stop xeval_seq istmts iwhile xeval_loop lg_fuel int_of_nat
                      gb_shblock_r1_x gb_shblock_r1_i xp_getl))))
              (case ITrap
                (chain
                  (steps
                    ((rewrite (hyp 0) lr both true ())
                     (compute
                       both
                       (stop iwhile xeval_loop lg_fuel int_of_nat istmts
                         xeval_seq gb_shblock_r1_x gb_shblock_r1_i
                         gb_shblock_r2_x gb_shblock_r2_i gb_shblock_r3_x
                         gb_shblock_r3_i gb_shblock_r4_x gb_shblock_r4_i
                         gb_shblock_r5_x gb_shblock_r5_i gb_shblock_r6_x
                         gb_shblock_r6_i gb_shblock_r7_x gb_shblock_r7_i
                         gb_shblock_r8_x gb_shblock_r8_i gb_shblock_r9_x
                         gb_shblock_r9_i gb_shblock_r10_x gb_shblock_r10_i
                         gb_shblock_r11_x gb_shblock_r11_i gb_shblock_r12_x
                         gb_shblock_r12_i gb_shblock_r13_x gb_shblock_r13_i))))
                  refl))))))))))
