     (x9 Int)
     (x10 Int)
     (x11 Int)
     (za Int)
     (zb Int)
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List XFunc)))
    ()
    (=
      (xeval_seq
        (S^ 38 c)
        (MkXModule restfs 65536 131072)
        (gb_shblock_r13_x)
        (MkRegs za x3 x2 x6 x7 x1 x0 x4 x5 zb 0 x8 x9 x10 x11)
        m)
      (ix_sout
        (istmts
          (S^ 28 c2)
          65536
          131072
          (gb_shblock_r13_i)
          (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
          m))))
  (chain
    (steps
      ((unfold gb_shblock_r13_x lhs)
       (reduce lhs)
       (unfold gb_shblock_r13_i rhs)
       (reduce rhs)))
    (steps ((compute both)))
    (case-on (le 65536 (mod (+ x8 1) 4294967296)) Bool
      ((case True
         (chain
           (steps ((rewrite (hyp 0) lr both true ()) (compute both)))
           (case-on (lt (mod (+ x8 1) 4294967296) 131072) Bool
             ((case True
                (chain
                  (have hlt2 (= (lt (mod (+ x8 1) 4294967296) 131072) True)
                    (steps ((rewrite (hyp 0) lr lhs true ())) refl))
