;; ==== M2: THE FINALIZER MACHINE GRAIN (STREAM.md 7.9) ==============================
;; sha_fin at the x86 grain. Modules grow 6=gb_shfpad_x 7=gb_shhex_x
;; 8=the finalizer glue; the glue reads the total (fn 3), pads in
;; place via fn 6 (length bytes from R9 = the U64 total), folds the
;; last 1-2 blocks via fn 1, and hexes H over the dead [0,64) window
;; via fn 7 -- totr runs BEFORE hex because hex overwrites the live
;; total cell. No spill: RSI/RDI carry p/src through the fpad call
;; (its walk pins them), and after the fold everything is ground.

;; the flat body, byte-copied from ipf_body (the (inline ...) carrier)
(fn ssp_ibody () (List IStmt)
  (list
    (ISet 2 (IBin U32 IAdd (ILoc 0) (ILoc 1)))
    (ISet 3 (IConst 72))
    (IWhile
      (ILoc 3)
      (list
        (IStore (ILoc 2) (IConst 0))
        (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
        (ISet 3 (IBin U32 ISub (ILoc 3) (IConst 1)))))
    (ISet 2 (IBin U32 IAdd (ILoc 0) (ILoc 1)))
    (IStore (ILoc 2) (IConst 128))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (ISet 3 (IBin U32 ISub (IConst 55) (ILoc 1)))
    (ISet 3 (IBin U32 IAnd (ILoc 3) (IConst 63)))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (ILoc 3)))
    (ISet 4 (IBin U64 IMul (IConst 8) (ILoc 5)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 56)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 48)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 40)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 32)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 24)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 16)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 8)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore (ILoc 2) (ITrunc U32 U8 (ITrunc U64 U32 (ILoc 4))))))

;; the x86 out's chained spelling: the flat tail folds behind the
;; rest fn; the bridge normalizes both spellings under a stopped
;; istmts (shp_xchain's shape at the fpad body)
(fn ssp_xchain () (List IStmt)
  (Cons
    (ISet 2 (IBin U32 IAdd (ILoc 0) (ILoc 1)))
    (Cons
      (ISet 3 (IConst 72))
      (Cons
        (IWhile
          (ILoc 3)
          (list
            (IStore (ILoc 2) (IConst 0))
            (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
            (ISet 3 (IBin U32 ISub (ILoc 3) (IConst 1)))))
        (gb_shfpad_r1_i)))))

(claim ssp_xbridge
  (goal ((ls (List Int)) (m Mem) (d Nat)) ()
    (=
      (istmts (S^ 120 d) 65536 131072 (inline ssp_xchain) ls m)
      (istmts (S^ 120 d) 65536 131072 (inline ssp_ibody) ls m)))
  (steps ((compute both (stop istmts))) refl))

;; the sweld-grain fpad walk: gb_shfpad_x from the XCall-6 site regs
;; lands ipf_mem; RSI/RDI carry n/src through (the glue's no-spill
;; design rides this pin)
(claim ssp_xfpad
  (goal
    ((src Int)
     (n Int)
     (tot Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (m Mem)
     (c Nat)
     (d Nat)
     (restfs (List XFunc)))
    ((= (le 65536 src) True)
     (= (le 0 n) True)
     (= (le (+ (+ src n) 72) 131072) True))
    (=
      (xeval_seq
        (S^ 89 c)
        (MkXModule restfs 65536 131072)
        (gb_shfpad_x)
        (MkRegs 0 x3 x2 0 0 n src x4 tot 0 0 0 0 0 0)
        m)
      (Some
        (XNorm
          (MkRegs
            0
            (ipd_zf n)
            (+ (+ (+ (+ (+ (+ (+ (ipd_ql src n) 1) 1) 1) 1) 1) 1) 1)
            0
            0
            n
            src
            (ipd_l tot)
            tot
            0
            0
            0
            0
            0
            0)
          (ipf_mem m src n tot)))))
  (chain
    (steps ((unfold gb_shfpad_x lhs)))
    (rewrite-with (lemma imp_x_shfpad) lr lhs ((inst c2 (S^ 33 d))) ())
    (steps ((rewrite (lemma ssp_xbridge) lr lhs true ())))
    (rewrite-with
      (lemma isha_fpad_walk)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)))
    (steps ((compute lhs (stop ipf_mem ipd_zf ipd_ql ipd_l))))
    refl))


;; ---- the finalizer glue + composition (differential-validated:
;; m2x_fin_run 23/23 incl. sha256("")/sha256("abc") gold vectors;
;; perturbation-checked: hex address, the R12 re-zero, and the
;; R9-total leg each break rows when disturbed)

;; the finalizer glue (frozen design): read total, pad from the tail
;; home, fold the last blocks, hex over the dead low window
(fn sst_xfin_body () (List XInstr)
  (list
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR R9 RSI)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RCX)
    (XCall 6)
    (XBin XAdd RSI (SImm 72))
    (XShrI RSI 6)
    (XMovRI RCX 0)
    (XMovRI R8 0)
    (XMovRI R9 0)
    (XCall 1)
    (XMovRI R12 0)
    (XMovRI RDI 65536)
    (XMovRI RSI 131008)
    (XCall 7)))

;; the fpad callee run at the XCall-6 site (xcall_bridge's slot)
(claim ssp_xfpad_run
  (goal
    ((src Int)
     (n Int)
     (tot Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (m Mem)
     (c Nat)
     (restfs (List XFunc)))
    ((= (le 65536 src) True)
     (= (le 0 n) True)
     (= (le (+ (+ src n) 72) 131072) True))
    (=
      (xrun_regs
        (S^ 89 c)
        (MkXModule
          (Cons
            (MkXFunc 0 (gb_shblock_x))
            (Cons
              (MkXFunc
                2
                (list
                  (XMovRR R12 RDI)
                  (XMovRR RDX RSI)
                  (XMovRI RDI 0)
                  (XMovRI RSI 0)
                  (XBlock (list (XLoop (inline ssf_xbody))))))
              (Cons
                (MkXFunc
                  0
                  (list
                    (XMovRI RCX 0)
                    (XMovRI RAX 0)
                    (XBlock (list (XLoop (inline ssc_xbody))))
                    (XMovRI RAX 0)))
                (Cons
                  (MkXFunc 0 (gb_shtotr_x))
                  (Cons
                    (MkXFunc 0 (gb_shtotw_x))
                    (Cons
                      (MkXFunc 0 (inline sst_xabs_body))
                      (Cons
                        (MkXFunc 0 (gb_shfpad_x))
                        (Cons
                          (MkXFunc 0 (gb_shhex_x))
                          (Cons (MkXFunc 0 (inline sst_xfin_body)) restfs)))))))))
          65536
          131072)
        6
        (MkRegs 0 x3 x2 0 0 n src x4 tot 0 0 0 0 0 0)
        m)
      (Some
        (Pair
          (MkRegs
            0
            (ipd_zf n)
            (+ (+ (+ (+ (+ (+ (+ (ipd_ql src n) 1) 1) 1) 1) 1) 1) 1)
            0
            0
            n
            src
            (ipd_l tot)
            tot
            0
            0
            0
            0
            0
            0)
          (ipf_mem m src n tot)))))
  (chain
    (steps
      ((unfold xrun_regs lhs)
       (compute
         lhs
         (stop xeval_seq gb_shblock_x gb_shtotr_x gb_shtotw_x gb_shfpad_x
           gb_shhex_x mem_get ibt_v ipf_mem ipd_zf ipd_ql ipd_l))))
    (rewrite-with
      (lemma ssp_xfpad)
      lr
      lhs
      ((inst d c))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)))
    (steps
      ((compute
         both
         (stop ipf_mem ipd_zf ipd_ql ipd_l gb_shblock_x gb_shtotr_x gb_shtotw_x
           gb_shfpad_x gb_shhex_x))))
    refl))

