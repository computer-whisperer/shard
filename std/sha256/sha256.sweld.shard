;; ---- THE FINALIZER COMPOSITION WALK: xrun_regs of fn 8 = the
;; composed effect ihx . shx . ipf over the window, exit fully ground
(claim sst_xfinal
  (goal
    ((kf Nat)
     (xa Int)
     (xc Int)
     (xd Int)
     (xs Int)
     (xdi Int)
     (m Mem)
     (c Nat)
     (restfs (List XFunc)))
    ((= (int_of_nat kf) (bshr (+ (band (ibt_v m 65536) 63) 72) 6)))
    (=
      (xrun_regs
        (S^ 477 (lg_fuel kf (S^ 100 c)))
        (MkXModule
          (Cons
            (MkXFunc 0 (gb_shblock_x))
            (Cons
              (MkXFunc
                2
                (list
                  (XMovRR R12 RDI)
                  (XMovRR RDX RSI)
                  (XMovRI RDI 0)
                  (XMovRI RSI 0)
                  (XBlock (list (XLoop (inline ssf_xbody))))))
