        lr
        lhs
        ((inst d 18446744073709551616))
        ((steps ((compute lhs)) refl))
        refl))
    (have hrbl (= (le 0 (mod n 18446744073709551616)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hid6
      (=
        (mod n 18446744073709551616)
        (+
          (* 64 (ediv (mod n 18446744073709551616) 64))
          (mod (mod n 18446744073709551616) 64)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 64))
        ((steps ((compute lhs)) refl))
        refl))
    (have hq6l (= (le 0 (mod (mod n 18446744073709551616) 64)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hq6h (= (lt (mod (mod n 18446744073709551616) 64) 64) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (rewrite-with
      (lemma mod_unique)
      lr
      rhs
      ((inst
         q
         (+
           (* 288230376151711744 (ediv n 18446744073709551616))
           (ediv (mod n 18446744073709551616) 64)))
       (inst r (mod (mod n 18446744073709551616) 64)))
      ((steps () (by arith (list (list 1 -1 0 -1 0 0) (list 1 1 0 1 0 0))))
       (steps ((rewrite (premise hq6l) lr lhs true ())) refl)
       (steps ((rewrite (premise hq6h) lr lhs true ())) refl))
      refl)))

;; ---- THE READBACK (M1's artifact theorem, flat-equation form) -------------
;; premises = the window realizes st = (MkShaSt h pend n) + the
;; absorber's machine pins; conclusions = the same equations at
;; sha_step's components over sst_xabsorb's composed twin.

;; the step, opened to its three components (M4's assembly pin)
(claim ssr_step_open
  (goal ((h H8) (pend (List Int)) (n Int) (chunk (List Int))) ()
    (=
      (sha_step (MkShaSt h pend n) chunk)
      (MkShaSt
        (sha_blocks h (sapp pend chunk) (ediv (slen (sapp pend chunk)) 64))
        (sdrop (* 64 (ediv (slen (sapp pend chunk)) 64)) (sapp pend chunk))
        (+ n (slen chunk)))))
  (steps ((compute both (stop sha_blocks sapp slen ediv sdrop))) refl))

;; the pending+chunk buffer splits at the machine's block boundary:
;; sapp pend chunk IS fold-input ++ new-tail, read from the window
(claim ssr_buf_split
  (goal
    ((r Int)
     (kb Nat)
     (krem Nat)
     (pn Nat)
     (rn Nat)
     (m Mem)
     (n Int)
     (h H8)
     (pend (List Int))
     (chunk (List Int)))
    ((= (le 1 r) True)
     (= (le r 61440) True)
     (= (int_of_nat kb) (bshr (+ (band (ibt_v m 65536) 63) r) 6))
     (= (int_of_nat krem) (band (+ (band (ibt_v m 65536) 63) r) 63))
     (= (le 0 n) True)
     (= (ibt_v m 65536) (mod n 18446744073709551616))
     (= (int_of_nat pn) (mod n 64))
     (= (int_of_nat rn) r)
     (= (mem_read pn m (- 65664 (int_of_nat pn))) pend)
     (= (mem_read rn m 65664) chunk)
     (= (wlist m 130752 64) (sha_k))
     (= (wlist m 131008 8) (shw_hlist h)))
    (=
      (sapp pend chunk)
      (sapp
        (mem_read (ssr_bn kb) m (- 65664 (int_of_nat pn)))
        (mem_read krem m (- (+ 65664 r) (int_of_nat krem))))))
  (chain
    (have hbv (= (band (ibt_v m 65536) 63) (int_of_nat pn))
      (chain
        (steps ((rewrite (premise 5) lr lhs true ())))
        (rewrite-with
          (lemma sst_mask6)
          lr
          lhs
          ()
          ((rewrite-with
             (lemma mod_lo)
             lr
             lhs
             ()
             ((steps ((compute both)) refl))
             refl)))
        (steps
          ((rewrite (lemma ssr_mm64) lr lhs true ())
           (rewrite (premise 6) rl lhs true ()))
          refl)))
    (have hpl (= (le 0 (int_of_nat pn)) True)
      (steps ((rewrite (lemma int_of_nat_nonneg) lr lhs true ())) refl))
    (have hpr0 (= (le 0 (+ (int_of_nat pn) r)) True)
      (steps () (by arith (rows (goal 1) (hpl 1) (0 1)))))
    (have hkb (= (int_of_nat kb) (ediv (+ (int_of_nat pn) r) 64))
      (chain
        (steps
          ((rewrite (premise 2) lr lhs true ())
           (rewrite (premise hbv) lr lhs true ())))
        (rewrite-with
          (lemma sst_shr6)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hpr0) lr lhs true ())) refl)))
        refl))
    (have hkr (= (int_of_nat krem) (mod (+ (int_of_nat pn) r) 64))
      (chain
        (steps
          ((rewrite (premise 3) lr lhs true ())
           (rewrite (premise hbv) lr lhs true ())))
        (rewrite-with
          (lemma sst_mask6)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hpr0) lr lhs true ())) refl)))
        refl))
    (have hidpr
      (=
        (+ (int_of_nat pn) r)
        (+
          (* 64 (ediv (+ (int_of_nat pn) r) 64))
          (mod (+ (int_of_nat pn) r) 64)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 64))
        ((steps ((compute lhs)) refl))
        refl))
    (have hprk
      (= (+ (int_of_nat pn) r) (+ (* 64 (int_of_nat kb)) (int_of_nat krem)))
      (chain
        (steps
          ((rewrite (premise hkb) lr rhs true ())
           (rewrite (premise hkr) lr rhs true ())))
        (steps ((rewrite (premise hidpr) lr lhs true ())) refl)))
    (have hsplit
      (=
        (mem_read (wn_add pn rn) m (- 65664 (int_of_nat pn)))
        (sapp pend chunk))
      (chain
        (steps ((rewrite (lemma ish_read_app) lr lhs true ())))
        (have ha (= (+ (- 65664 (int_of_nat pn)) (int_of_nat pn)) 65664)
          (steps () (by arith (list (list 1) (list 1)))))
        (steps
          ((rewrite (premise ha) lr lhs true ())
           (rewrite (premise 8) lr lhs true ())
           (rewrite (premise 9) lr lhs true ()))
          refl)))
    (have hcnt
      (= (int_of_nat (wn_add pn rn)) (int_of_nat (wn_add (ssr_bn kb) krem)))
      (chain
        (steps
          ((rewrite (lemma ish_iw_add) lr both true ())
           (rewrite (lemma ssr_bn_val) lr rhs true ())
           (rewrite (premise 7) lr lhs true ())
           (rewrite (premise hkb) lr rhs true ())
           (rewrite (premise hkr) lr rhs true ())))
        (steps ((rewrite (premise hidpr) lr lhs true ())) refl)))
    (have haddr
      (=
        (+ (- 65664 (int_of_nat pn)) (int_of_nat (ssr_bn kb)))
        (- (+ 65664 r) (int_of_nat krem)))
      (chain
        (steps ((rewrite (lemma ssr_bn_val) lr lhs true ())))
        (steps
          ()
          (by arith (list (rows (goal 1) (hprk 1)) (rows (goal 1) (hprk -1)))))))
    (steps ((rewrite (premise hsplit) rl lhs true ())))
    (rewrite-with
      (lemma ssr_read_ext)
      lr
      lhs
      ((inst wb (wn_add (ssr_bn kb) krem)))
      ((steps ((rewrite (premise hcnt) lr lhs true ())) refl)))
    (steps
      ((rewrite (lemma ish_read_app) lr lhs true ())
       (rewrite (premise haddr) lr lhs true ()))
      refl)))

