;; ---- mod collapses: absorb an inner mod into a sum, and drop an
;; outer 2^64 wrap under mod 64 (ibt_mm's species) ---------------------------

(claim ssr_madd64
  (goal ((n Int) (c Int)) ()
    (=
      (mod (+ (mod n 18446744073709551616) c) 18446744073709551616)
      (mod (+ n c) 18446744073709551616)))
  (chain
    (have hidn
      (=
        n
        (+
          (* 18446744073709551616 (ediv n 18446744073709551616))
          (mod n 18446744073709551616)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 18446744073709551616))
        ((steps ((compute lhs)) refl))
        refl))
    (have hids
      (=
        (+ n c)
        (+
          (* 18446744073709551616 (ediv (+ n c) 18446744073709551616))
          (mod (+ n c) 18446744073709551616)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst n (+ n c)) (inst d 18446744073709551616))
        ((steps ((compute lhs)) refl))
        refl))
    (have hlo (= (le 0 (mod (+ n c) 18446744073709551616)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hhi
      (= (lt (mod (+ n c) 18446744073709551616) 18446744073709551616) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (rewrite-with
      (lemma mod_unique)
      lr
      lhs
      ((inst
         q
         (- (ediv (+ n c) 18446744073709551616) (ediv n 18446744073709551616)))
       (inst r (mod (+ n c) 18446744073709551616)))
      ((steps () (by arith (list (list 1 1 -1 0 0) (list 1 -1 1 0 0))))
       (steps ((rewrite (premise hlo) lr lhs true ())) refl)
       (steps ((rewrite (premise hhi) lr lhs true ())) refl))
      refl)))

(claim ssr_madd6
  (goal ((n Int) (c Int)) () (= (mod (+ (mod n 64) c) 64) (mod (+ n c) 64)))
  (chain
    (have hidn (= n (+ (* 64 (ediv n 64)) (mod n 64)))
      (rewrite-with
        (lemma ediv_mod_id)
