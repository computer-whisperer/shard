;; ---- fuel reshape kit: the two-loop nesting (fold then copy behind
;; sequential calls) pushes spare S's through lg_fuel and commutes
;; the two counters so both loop certs meet their exact spellings

(claim sst_push1
  (goal ((k Nat) (c Nat)) () (= (lg_fuel k (S c)) (S (lg_fuel k c))))
  (induct k
    ((case Z (steps ((compute both)) refl))
     (case S
       (k2)
       (chain
         (have hs (= (lg_fuel (S k2) (S c)) (S (lg_fuel k2 (S c))))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (have hs2 (= (lg_fuel (S k2) c) (S (lg_fuel k2 c)))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hs) lr lhs true ())
            (rewrite (premise hs2) lr rhs true ())
            (rewrite (hyp 0) lr lhs true ()))
           refl))))))

(claim sst_lgf_comm
  (goal ((a Nat) (b Nat) (c Nat)) ()
    (= (lg_fuel a (lg_fuel b c)) (lg_fuel b (lg_fuel a c))))
  (induct a
    ((case Z
       (chain
         (have hzin (= (lg_fuel Z c) c) (steps ((compute both)) refl))
         (have hzout (= (lg_fuel Z (lg_fuel b c)) (lg_fuel b c))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hzout) lr lhs true ())
            (rewrite (premise hzin) lr rhs true ()))
           refl)))
     (case S
       (a2)
       (chain
         (have hs
           (= (lg_fuel (S a2) (lg_fuel b c)) (S (lg_fuel a2 (lg_fuel b c))))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (have hs2 (= (lg_fuel (S a2) c) (S (lg_fuel a2 c)))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hs) lr lhs true ())
            (rewrite (premise hs2) lr rhs true ())
            (rewrite (lemma sst_push1) lr rhs true ())
            (rewrite (hyp 0) lr lhs true ()))
           refl))))))

