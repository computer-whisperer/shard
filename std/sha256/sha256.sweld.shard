;; ==== THE READBACK (STREAM.md 7.9 M1, the artifact theorem) ================
;;
;; Premises = the window realizes st = (MkShaSt h pend n) in flat
;; equations (K/H wlist, total cell ibt_v, pend right-aligned at
;; [128-p,128), chunk at [128,128+r)) + the absorber's machine pins
;; (kb/krem ghost Nats). Conclusions = the SAME equations at
;; sha_step's components over sst_xabsorb's composed twin:
;;   ssr_rb_k     K survives          ssr_rb_tot   total = n + |chunk|
;;   ssr_rb_h     H = the spec fold   ssr_rb_pend  tail re-homed
;;   ssr_rb_p     krem = the new invariant residue
;; ssr_step_open pins sha_step to the three components; ssr_buf_split
;; is the fold-input decomposition (the machine mirror of the list
;; world's shc_blocks_prefix split); ssr_read_ext is the ONE spot two
;; Nat spellings of a byte count meet (int_of_nat-value extensional).

;; ---- 64k as a Nat: the fold window's byte count ---------------------------

(fn ssr_bn ((k Nat)) Nat
  (measure (struct k))
  (match k
    (Z 0)
    ((S k2) (wn_add 64 (ssr_bn k2)))))

(claim ssr_bn_s
  (goal ((k Nat)) () (= (ssr_bn (S k)) (wn_add 64 (ssr_bn k))))
  (steps ((unfold ssr_bn lhs) (reduce lhs)) refl))

(claim ssr_bn_val
  (goal ((k Nat)) () (= (int_of_nat (ssr_bn k)) (* 64 (int_of_nat k))))
  (induct k
    ((case Z
       (chain
         (have hbz (= (ssr_bn Z) Z)
           (steps ((unfold ssr_bn lhs) (compute both)) refl))
         (steps
           ((rewrite (premise hbz) lr lhs true ())
            (rewrite (lemma int_of_nat_zero) lr both true ())
            (compute rhs))
           refl)))
     (case S
       (k2)
       (chain
         (steps
           ((rewrite (lemma ssr_bn_s) lr lhs true ())
            (rewrite (lemma ish_iw_add) lr lhs true ())
            (rewrite (lemma ish_i64p) lr lhs true ())
            (rewrite (lemma int_of_nat_succ) lr rhs true ())))
         (rewrite-with (hyp 0) lr lhs () ())
         (steps () (by arith (list (list 1) (list 1)))))))))

;; ---- take/drop at the full length -----------------------------------------

(claim ssr_stake_len
  (goal ((xs (List Int))) () (= (stake (slen xs) xs) xs))
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (h t)
       (chain
         (have hnn (= (le 0 (slen t)) True)
           (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
         (have hs (= (slen (Cons h t)) (+ 1 (slen t)))
           (steps ((unfold slen lhs) (reduce lhs)) refl))
         (have hg (= (le (slen (Cons h t)) 0) False)
           (steps
             ((rewrite (premise hs) lr lhs true ()))
             (by arith (rows (goal 1) (hnn 1)))))
         (have hd (= (- (slen (Cons h t)) 1) (slen t))
           (steps
             ((rewrite (premise hs) lr lhs true ()))
             (by arith (list (list 1) (list 1)))))
         (steps
           ((unfold stake lhs)
            (reduce lhs)
            (rewrite (premise hg) lr lhs true ())
            (reduce lhs)
            (rewrite (premise hd) lr lhs true ())))
         (rewrite-with (hyp 0) lr lhs () ())
         refl)))))

(claim ssr_sdrop_len
  (goal ((xs (List Int))) () (= (sdrop (slen xs) xs) Nil))
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (h t)
       (chain
         (have hnn (= (le 0 (slen t)) True)
           (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
         (have hs (= (slen (Cons h t)) (+ 1 (slen t)))
           (steps ((unfold slen lhs) (reduce lhs)) refl))
         (have hg (= (le (slen (Cons h t)) 0) False)
           (steps
             ((rewrite (premise hs) lr lhs true ()))
             (by arith (rows (goal 1) (hnn 1)))))
         (have hd (= (- (slen (Cons h t)) 1) (slen t))
           (steps
             ((rewrite (premise hs) lr lhs true ()))
             (by arith (list (list 1) (list 1)))))
         (steps
           ((unfold sdrop lhs)
            (reduce lhs)
            (rewrite (premise hg) lr lhs true ())
            (reduce lhs)
            (rewrite (premise hd) lr lhs true ())))
         (rewrite-with (hyp 0) lr lhs () ())
         refl)))))

;; ---- mem_read count extensionality: equal values, equal windows -----------
;; the Nat-surgery choke point — the ONE place two different Nat
;; spellings of the same byte count meet.

(claim ssr_read_ext
  (goal ((wa Nat) (wb Nat) (m Mem) (a Int))
    ((= (int_of_nat wa) (int_of_nat wb)))
    (= (mem_read wa m a) (mem_read wb m a)))
  (induct wa
    ((case Z
       (case-on wb Nat
         ((case Z (steps ((rewrite (hyp 0) lr rhs true ())) refl))
          (case S
            (b2)
            (chain
              (have hv (= (int_of_nat wb) 0)
                (steps
                  ((rewrite (premise 0) rl lhs true ())
                   (rewrite (lemma int_of_nat_zero) lr lhs true ()))
                  refl))
              (have hsv (= (int_of_nat wb) (+ 1 (int_of_nat b2)))
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (rewrite (lemma int_of_nat_succ) lr lhs true ()))
                  refl))
              (have hnn (= (le 0 (int_of_nat b2)) True)
                (steps
                  ((rewrite (lemma int_of_nat_nonneg) lr lhs true ()))
                  refl))
              (have hff (= (le 1 0) True)
                (steps () (by arith (rows (goal 1) (hv -1) (hsv 1) (hnn 1)))))
              (have hx (= False True)
                (steps
                  ((rewrite (premise hff) rl rhs true ()) (compute rhs))
                  refl))
              (absurd (premise hx)))))))
     (case S
       (wa2)
       (case-on wb Nat
         ((case Z
            (chain
              (have hv (= (int_of_nat (S wa2)) 0)
                (steps
                  ((rewrite (premise 0) lr lhs true ())
                   (rewrite (hyp 0) lr lhs true ())
                   (rewrite (lemma int_of_nat_zero) lr lhs true ()))
                  refl))
              (have hsv (= (int_of_nat (S wa2)) (+ 1 (int_of_nat wa2)))
                (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
              (have hnn (= (le 0 (int_of_nat wa2)) True)
                (steps
                  ((rewrite (lemma int_of_nat_nonneg) lr lhs true ()))
                  refl))
              (have hff (= (le 1 0) True)
                (steps () (by arith (rows (goal 1) (hv -1) (hsv 1) (hnn 1)))))
              (have hx (= False True)
                (steps
                  ((rewrite (premise hff) rl rhs true ()) (compute rhs))
                  refl))
              (absurd (premise hx))))
          (case S
            (b2)
            (chain
              (have hL (= (int_of_nat (S wa2)) (+ 1 (int_of_nat wa2)))
                (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
              (have hR (= (int_of_nat wb) (+ 1 (int_of_nat b2)))
                (steps
                  ((rewrite (hyp 0) lr lhs true ())
                   (rewrite (lemma int_of_nat_succ) lr lhs true ()))
                  refl))
              (have heq (= (int_of_nat wa2) (int_of_nat b2))
                (steps () (by arith (list (list 1 -1 1 -1) (list 1 1 -1 1)))))
              (steps
                ((rewrite (hyp 0) lr rhs true ())
                 (rewrite (lemma mem_read_s) lr both true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ((inst wb b2))
                ((steps ((rewrite (premise heq) lr lhs true ())) refl)))
              refl))))))))

;; ---- THE FOLD-INPUT BRIDGE: the machine fold IS sha_blocks over the
;; window's bytes — the mirror of shc_blocks_prefix's list world

(claim ssr_fold_read
  (goal ((st H8) (m Mem) (src Int) (k Nat)) ()
    (=
      (shb_fold st m src k)
      (sha_blocks st (mem_read (ssr_bn k) m src) (int_of_nat k))))
  (induct k
    ((case Z
       (chain
         (have hbz (= (ssr_bn Z) Z)
           (steps ((unfold ssr_bn lhs) (compute both)) refl))
         (steps
           ((rewrite (premise hbz) lr rhs true ())
            (rewrite (lemma mem_read_z) lr rhs true ())
            (rewrite (lemma int_of_nat_zero) lr rhs true ())))
         (have hfz (= (shb_fold st m src Z) st)
           (steps ((unfold shb_fold lhs) (reduce lhs)) refl))
         (have hbn (= (sha_blocks st Nil 0) st) (steps ((compute lhs)) refl))
         (steps
           ((rewrite (premise hfz) lr lhs true ())
            (rewrite (premise hbn) lr rhs true ()))
           refl)))
     (case S
       (k2)
       (chain
         (have hnn (= (le 0 (int_of_nat k2)) True)
           (steps ((rewrite (lemma int_of_nat_nonneg) lr lhs true ())) refl))
         (have hi (= (int_of_nat (S k2)) (+ 1 (int_of_nat k2)))
           (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
         (have hg (= (le (int_of_nat (S k2)) 0) False)
           (steps
             ((rewrite (premise hi) lr lhs true ()))
             (by arith (rows (goal 1) (hnn 1)))))
         (have hlen (= (slen (mem_read 64 m src)) 64)
           (steps
             ((rewrite (lemma ish_read_len) lr lhs true ())
              (rewrite (lemma ish_i64p) lr lhs true ()))
             refl))
         (have hle64 (= (le 64 (slen (mem_read 64 m src))) True)
           (steps ((rewrite (premise hlen) lr lhs true ()) (compute lhs)) refl))
         (steps
           ((rewrite (lemma shb_fold_s) lr lhs true ())
            (rewrite (lemma ssr_bn_s) lr rhs true ())
            (rewrite (lemma ish_read_app) lr rhs true ())
            (rewrite (lemma ish_i64p) lr rhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ((inst st (sha_block st (mem_read 64 m src))) (inst src (+ src 64)))
           ())
         (have hstep
           (=
             (sha_blocks
               st
               (sapp (mem_read 64 m src) (mem_read (ssr_bn k2) m (+ src 64)))
               (int_of_nat (S k2)))
             (sha_blocks
               (sha_block
                 st
                 (stake
                   64
                   (sapp
                     (mem_read 64 m src)
                     (mem_read (ssr_bn k2) m (+ src 64)))))
               (sdrop
                 64
                 (sapp (mem_read 64 m src) (mem_read (ssr_bn k2) m (+ src 64))))
               (- (int_of_nat (S k2)) 1)))
           (steps
             ((unfold sha_blocks lhs)
              (reduce lhs)
              (rewrite (premise hg) lr lhs true ())
              (reduce lhs))
             refl))
         (steps ((rewrite (premise hstep) lr rhs true ())))
         (rewrite-with
           (lemma shc_stake_pre)
           lr
           rhs
           ()
           ((steps ((compute lhs)) refl)
            (steps ((rewrite (premise hle64) lr lhs true ())) refl)))
         (rewrite-with
           (lemma shc_sdrop_pre)
           lr
           rhs
           ()
           ((steps ((compute lhs)) refl)
            (steps ((rewrite (premise hle64) lr lhs true ())) refl)))
         (have hst
           (=
             (stake 64 (mem_read 64 m src))
             (stake (slen (mem_read 64 m src)) (mem_read 64 m src)))
           (steps ((rewrite (premise hlen) lr rhs true ())) refl))
         (steps
           ((rewrite (premise hst) lr rhs true ())
            (rewrite (lemma ssr_stake_len) lr rhs true ())))
         (have hsd
           (=
             (sdrop 64 (mem_read 64 m src))
             (sdrop (slen (mem_read 64 m src)) (mem_read 64 m src)))
           (steps ((rewrite (premise hlen) lr rhs true ())) refl))
         (steps
           ((rewrite (premise hsd) lr rhs true ())
            (rewrite (lemma ssr_sdrop_len) lr rhs true ())
            (compute rhs (stop sha_blocks sha_block mem_read int_of_nat ssr_bn))))
         (have hf1 (= (- (int_of_nat (S k2)) 1) (int_of_nat k2))
           (steps
             ((rewrite (premise hi) lr lhs true ()))
             (by arith (list (list 1) (list 1)))))
         (steps ((rewrite (premise hf1) lr rhs true ())))
         refl)))))

;; ---- icp_mem framing + readback: the tail-copy twin's laws ----------------

;; a get strictly below the copy's destination window sees through
(claim ssr_get_icp_below
  (goal ((m Mem) (q Int) (p Int) (a Int) (k Nat)) ((= (lt a q) True))
    (= (mem_get (icp_mem m q p k) a) (mem_get m a)))
  (induct k
    ((case Z (steps ((rewrite (lemma icp_mem_z) lr lhs true ())) refl))
     (case S
       (k2)
       (chain
         (steps ((rewrite (lemma icp_mem_s) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ((inst m (mem_set m q (mem_get m p)))
            (inst q (+ q 1))
            (inst p (+ p 1)))
           ((steps () (by arith (rows (goal 1) (0 1))))))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1))))))
         refl)))))

;; THE COPY READBACK: the destination window reads as the source did
;; (dest at or below source: the ascending walk never re-reads a
;; written cell — the absorber's dst = csrc - r with r >= 1)
(claim ssr_icp_read
  (goal ((m Mem) (q Int) (p Int) (k Nat)) ((= (le q p) True))
    (= (mem_read k (icp_mem m q p k) q) (mem_read k m p)))
  (induct k
    ((case Z
       (steps
         ((rewrite (lemma icp_mem_z) lr lhs true ())
          (rewrite (lemma mem_read_z) lr both true ()))
         refl))
     (case S
       (k2)
       (chain
         (steps
           ((rewrite (lemma icp_mem_s) lr lhs true ())
            (rewrite (lemma mem_read_s) lr both true ())))
         (rewrite-with
           (lemma ssr_get_icp_below)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1))))))
         (steps ((rewrite (lemma get_set_get) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ((inst m (mem_set m q (mem_get m p)))
            (inst q (+ q 1))
            (inst p (+ p 1)))
           ((steps () (by arith (rows (goal 1) (0 1))))))
         (rewrite-with
           (lemma mem_read_set_below)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1))))))
         refl)))))

