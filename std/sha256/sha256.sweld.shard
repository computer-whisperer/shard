    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal -1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal -1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal -1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal -1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal -1) (0 1))))))
    refl))

(claim sst_ibtv0_set_above
  (goal ((m Mem) (v Int) (b Int)) ((= (le 65544 b) True))
