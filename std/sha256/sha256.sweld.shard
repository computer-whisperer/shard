;; a store strictly below a word window is invisible to wlist
(claim ssr_wlist_set_below
  (goal ((m Mem) (p Int) (b Int) (v Int) (k Nat)) ((= (lt b p) True))
    (= (wlist (mem_set m b v) p k) (wlist m p k)))
