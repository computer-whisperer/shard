    (have hlo (= (le 0 (mod (+ n c) 64)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hhi (= (lt (mod (+ n c) 64) 64) True)
      (rewrite-with
