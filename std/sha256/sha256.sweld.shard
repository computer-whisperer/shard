;; word windows wholly above the copy's destination see through
(claim ssr_wlist_icp_above
  (goal ((m Mem) (q Int) (p Int) (w Int) (j Nat) (k Nat))
    ((= (le (+ q (int_of_nat k)) w) True))
    (= (wlist (icp_mem m q p k) w j) (wlist m w j)))
  (induct k
    ((case Z (steps ((rewrite (lemma icp_mem_z) lr lhs true ())) refl))
     (case S
       (k2)
       (chain
         (have hi (= (int_of_nat (S k2)) (+ 1 (int_of_nat k2)))
           (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
         (have hnn (= (le 0 (int_of_nat k2)) True)
           (steps ((rewrite (lemma int_of_nat_nonneg) lr lhs true ())) refl))
         (steps ((rewrite (lemma icp_mem_s) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ((inst m (mem_set m q (mem_get m p)))
            (inst q (+ q 1))
            (inst p (+ p 1)))
           ((steps () (by arith (rows (goal 1) (0 1) (hi 1))))))
         (rewrite-with
           (lemma ssr_wlist_set_below)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1) (hi 1) (hnn 1))))))
         refl)))))


