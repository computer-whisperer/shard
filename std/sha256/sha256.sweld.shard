     (= (mem_read rn m 65664) chunk)
     (= (wlist m 130752 64) (sha_k))
     (= (wlist m 131008 8) (shw_hlist h)))
    (=
      (wlist
        (icp_mem
          (shx_mem
            (ibtw_mem
              (mem_set
                (mem_set (mem_set m 65545 r) 65546 (bshr r 8))
                65544
                (int_of_nat krem))
              65536
