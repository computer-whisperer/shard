;;; std/sha256/sha256.sweld.shard — the STREAMING weld article (Arc B
;;; rung B3, docs/STREAM.md §7.9 M1: the absorber artifact at machine
;;; grain). This article welds the streaming tier's impgen products
;;; (std/sha256/sha256.imp.shard pins, impgen_x86_out ties/bridges)
;;; into the hand absorber's composition frame.
;;;
;;; THE STREAMING MODULE SKELETON (fn indices are load-bearing; M3's
;;; main and the World shims append in restfs):
;;;   0 = the frozen compression block (gb_shblock_x, one-shot verbatim)
;;;   1 = the block fold loop (the one-shot caller fn, arity 2)
;;;   2 = the tail copy (tie_x_shtcopy's list — walked HERE, hand:
;;;       the bridge is tie-only, the loop counter is not ground at
;;;       the loop head; single-sweep law, shard#22)
;;;   3 = the total-cell read (gb_shtotr_x, ascending BE Horner)
;;;   4 = the total-cell write (gb_shtotw_x, BE store ladder)
;;;   5 = the hand absorber glue (sst_xabs_body, slice 2)
;;;
;;; READBACK-STATEMENT DECISION (M1 design, 2026-07-30): the artifact
;;; theorem states the window's realization of the ShaSt as FLAT
;;; EQUATIONS — wlist/mem_read/ibt_v premises at st, the same
;;; equations at (sha_step st chunk) in the conclusion — the
;;; shb_hread species, NOT a named realize predicate. Why: the whole
;;; landed framing/readback kit speaks these forms (a named predicate
;;; would pay unfold ceremony at every cite); M2's finalizer readback
;;; consumes the same premise set; and M4's loop invariant must also
;;; carry machine-side facts whose shape only M3's walk reveals —
;;; naming the relation now would freeze the wrong signature. M4
;;; defines the named package as exactly these equations when the
;;; loop induction needs one term.
;;;
;;; The total-cell walks are stated at GROUND cell address 0 (the
;;; absorber's call sites): every guard and pointer advance computes,
;;; and the value trees are the twins' spellings verbatim (the totw
;;; chain is wrap-free — band/bshr only), so both close as pure
;;; computes. Junk rides the callee-untouched registers symbolically
;;; exactly where the glue keeps live values (RCX/RDX/RSI at the
;;; read; RAX/RCX/RDX/RBX/RBP at the write; RBX/R12 through the
;;; copy).

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/nat.shard")
(use (:: std nat *))
(import "../../std/mem")
(use (:: std mem *))
(import "../../std/bits")
(use (:: std bits *))
(import "../../models/x86/x86.shard")
(use (:: models x86 x86 *))
(import "../../models/wasm/loopkit.shard")
(use (:: models wasm loopkit *))
(import "../../models/imp/imp.shard")
(use (:: models imp imp *))
(import "../../models/imp/to_x86.shard")
(use (:: models imp to_x86 *))
(import "sha256.shard")
(use (:: std sha256 sha256 *))
(import "sha256.stream.shard")
(use (:: std sha256 sha256.stream *))
(import "sha256.imp.shard")
(use (:: std sha256 sha256.imp *))
(import "impgen_x86_out.shard")
(use (:: std sha256 impgen_x86_out *))
(import "sha256.weld.shard")
(use (:: std sha256 sha256.weld *))

;; ---- the copy loop at x86 grain -------------------------------------------
;; tie_x_shtcopy's XLoop payload, spelled verbatim (ssc_tie pins the
;; correspondence). regs: RDI=dst RSI=src RDX=count RCX/RAX=scratch.

(fn ssc_xbody () (List XInstr)
  (list
    (XBrIf (CEqz RDX) 1)
    (XLoad8 RCX (AReg RSI))
    (XMovRR RAX RCX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDI) (SReg RAX))
    (XBin32 XAdd RDI (SImm 1))
    (XBin32 XAdd RSI (SImm 1))
    (XMovRI RCX 0)
    (XBin32 XSub RDX (SImm 1))
    (XMovRI RAX 0)
    (XBr 0)))

;; the tie correspondence: the article's spelled wrapper IS the
;; generated tie's list — the regen contract's tooth for fn 2.
(claim ssc_tie
  (goal () ()
    (=
      (ix_sstmts (ibody_of (it_shtcopy_fn)))
      (Some
        (list
          (XMovRI RCX 0)
          (XMovRI RAX 0)
          (XBlock (list (XLoop (inline ssc_xbody))))
          (XMovRI RAX 0)))))
  (steps ((compute both)) refl))

;; the pass: one iteration from the loop head. Premises spelled AS
;; THE GUARDS materialize (le (+ a 1) 65536) so premise rewrites hit
;; directly; the store's band collapses through get_lo/get_hi + the
;; q=0 mod_unique; the 32-bit pointer advances collapse via
;; ish_mid32. Junk carried at RBX/R12 (the absorber's live slots at
;; the copy call site).
(claim ssc_xpass
  (goal
    ((q Int)
     (p Int)
     (zc Int)
     (xb Int)
     (x12 Int)
     (m Mem)
     (fl Nat)
     (restfs (List XFunc)))
    ((= (le 65536 q) True)
     (= (le (+ q 1) 131072) True)
     (= (le 65536 p) True)
     (= (le (+ p 1) 131072) True)
     (= (le 1 zc) True)
     (= (lt zc 4294967296) True))
    (=
      (xeval_seq
        (S^ 24 fl)
        (MkXModule restfs 65536 131072)
        (inline ssc_xbody)
        (MkRegs 0 0 zc xb 0 p q 0 0 0 0 x12 0 0 0)
        m)
      (Some
        (XBrk
          0
          (MkRegs 0 0 (- zc 1) xb 0 (+ p 1) (+ q 1) 0 0 0 0 x12 0 0 0)
          (mem_set m q (mem_get m p))))))
  (chain
    (have hne (= (int_eq zc 0) False)
      (steps () (by arith (rows (goal -1) (4 1)))))
    (have hblo (= (le 0 (mem_get m p)) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hbhi (= (lt (mem_get m p) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hb (= (band (mem_get m p) 255) (mem_get m p))
      (chain
        (rewrite-with
          (lemma mask_byte)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hblo) lr lhs true ())) refl)))
        (rewrite-with
          (lemma mod_unique)
          lr
          lhs
          ((inst q 0) (inst r (mem_get m p)))
          ((steps () (by arith (list (list 1) (list 1))))
           (steps ((rewrite (premise hblo) lr lhs true ())) refl)
           (steps ((rewrite (premise hbhi) lr lhs true ())) refl))
          refl)))
    (have hq1 (= (mod (+ q 1) 4294967296) (+ q 1))
      (rewrite-with
        (lemma ish_mid32)
        lr
        lhs
        ()
        ((steps () (by arith (rows (goal 1) (0 1))))
         (steps () (by arith (rows (goal 1) (1 1)))))
        refl))
    (have hp1 (= (mod (+ p 1) 4294967296) (+ p 1))
      (rewrite-with
        (lemma ish_mid32)
        lr
        lhs
        ()
        ((steps () (by arith (rows (goal 1) (2 1))))
         (steps () (by arith (rows (goal 1) (3 1)))))
        refl))
    (have hz1 (= (mod (- zc 1) 4294967296) (- zc 1))
      (rewrite-with
        (lemma ish_mid32)
        lr
        lhs
        ()
        ((steps () (by arith (rows (goal 1) (4 1))))
         (steps () (by arith (rows (goal 1) (5 1)))))
        refl))
    (steps
      ((compute lhs (stop mem_set mem_get))
       (rewrite (premise hne) lr lhs true ())
       (compute lhs (stop mem_set mem_get))
       (rewrite (premise 2) lr lhs true ())
       (compute lhs (stop mem_set mem_get))
       (rewrite (premise 3) lr lhs true ())
       (compute lhs (stop mem_set mem_get))
       (rewrite (premise 0) lr lhs true ())
       (compute lhs (stop mem_set mem_get))
       (rewrite (premise 1) lr lhs true ())
       (compute lhs (stop mem_set mem_get))
       (rewrite (premise hb) lr lhs true ())
       (rewrite (premise hq1) lr lhs true ())
       (rewrite (premise hp1) lr lhs true ())
       (rewrite (premise hz1) lr lhs true ())
       (compute lhs (stop mem_set mem_get)))
      refl)))

;; the worker: k passes from the loop head ARE the copy effect (exit
;; file uniform in k — the scratch re-zeroes, the count runs out).
(claim ssc_xw
  (goal
    ((q Int)
     (p Int)
     (xb Int)
     (x12 Int)
     (m Mem)
     (c Nat)
     (k Nat)
     (restfs (List XFunc)))
    ((= (le 65536 q) True)
     (= (le (+ q (int_of_nat k)) 131072) True)
     (= (le 65536 p) True)
     (= (le (+ p (int_of_nat k)) 131072) True))
    (=
      (xeval_loop
        (S^ 28 (lg_fuel k c))
        (MkXModule restfs 65536 131072)
        (inline ssc_xbody)
        (MkRegs 0 0 (int_of_nat k) xb 0 p q 0 0 0 0 x12 0 0 0)
        m)
      (Some
        (XBrk
          0
          (MkRegs 0 0 0 xb 0 (lg_advk p 1 k) (lg_advk q 1 k) 0 0 0 0 x12 0 0 0)
          (icp_mem m q p k)))))
  (induct k
    ((case Z
       (steps
         ((rewrite (lemma int_of_nat_zero) lr lhs true ())
          (compute both (stop mem_set mem_get)))
         refl))
     (case S
       (k2)
       (chain
         (have hnn (= (le 0 (int_of_nat k2)) True)
           (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
         (have hqs (= (le (+ q (+ 1 (int_of_nat k2))) 131072) True)
           (steps
             ((rewrite (lemma int_of_nat_succ) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (have hps (= (le (+ p (+ 1 (int_of_nat k2))) 131072) True)
           (steps
             ((rewrite (lemma int_of_nat_succ) rl lhs true ())
              (rewrite (premise 3) lr lhs true ()))
             refl))
         (steps
           ((unfold lg_fuel lhs)
            (reduce lhs)
            (unfold xeval_loop lhs)
            (rewrite (lemma int_of_nat_succ) lr lhs true ())
            (compute
              lhs
              (stop xeval_loop xeval_seq lg_fuel mem_set mem_get icp_mem lg_advk))))
         (rewrite-with
           (lemma ssc_xpass)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)
            (steps () (by arith (rows (goal 1) (hqs 1) (hnn 1))))
            (steps ((rewrite (premise 2) lr lhs true ())) refl)
            (steps () (by arith (rows (goal 1) (hps 1) (hnn 1))))
            (steps () (by arith (rows (goal 1) (hnn 1))))
            (steps () (by arith (rows (goal 1) (hqs 1) (0 1))))))
         (steps
           ((rewrite (lemma lg_sub) lr lhs true ())
            (compute
              lhs
              (stop xeval_loop xeval_seq lg_fuel mem_set mem_get icp_mem lg_advk))))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1))))
            (steps () (by arith (rows (goal 1) (hqs 1))))
            (steps () (by arith (rows (goal 1) (2 1))))
            (steps () (by arith (rows (goal 1) (hps 1))))))
         (steps
           ((rewrite (lemma lg_advk_s) rl lhs true ())
            (rewrite (lemma icp_mem_s) rl lhs true ())))
         refl)))))

;; the wrapper: fn 2's full body — the loop denotation behind the
;; call boundary. Entry junk at RAX/RCX (zeroed by the preamble) and
;; RBX/R12 (pass-through).
(claim ssc_xcopy
  (goal
    ((q Int)
     (p Int)
     (xa Int)
     (xc Int)
     (xb Int)
     (x12 Int)
     (m Mem)
     (c Nat)
     (k Nat)
     (restfs (List XFunc)))
    ((= (le 65536 q) True)
     (= (le (+ q (int_of_nat k)) 131072) True)
     (= (le 65536 p) True)
     (= (le (+ p (int_of_nat k)) 131072) True))
    (=
      (xeval_seq
        (S^ 34 (lg_fuel k c))
        (MkXModule restfs 65536 131072)
        (list
          (XMovRI RCX 0)
          (XMovRI RAX 0)
          (XBlock (list (XLoop (inline ssc_xbody))))
          (XMovRI RAX 0))
        (MkRegs xa xc (int_of_nat k) xb 0 p q 0 0 0 0 x12 0 0 0)
        m)
      (Some
        (XNorm
          (MkRegs 0 0 0 xb 0 (lg_advk p 1 k) (lg_advk q 1 k) 0 0 0 0 x12 0 0 0)
          (icp_mem m q p k)))))
  (chain
    (steps
      ((compute lhs (stop xeval_loop lg_fuel mem_set mem_get icp_mem lg_advk))))
    (rewrite-with
      (lemma ssc_xw)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (steps ((compute lhs (stop mem_set mem_get icp_mem lg_advk))))
    refl))

;; ---- the total-cell callee walks at the absorber's call sites -------------

;; the read (fn 3): RSI lands the ascending BE Horner = ibt_v m 0;
;; memory untouched. Entry = the XCall-3 site (RDI=0; junk at
;; RCX/RDX/RSI; zeros elsewhere — the glue zeroes RAX).
(claim sst_xtotr0
  (goal ((xc Int) (xd Int) (xs Int) (m Mem) (c Nat) (restfs (List XFunc))) ()
    (=
      (xeval_seq
        (S^ 41 c)
        (MkXModule restfs 65536 131072)
        (gb_shtotr_x)
        (MkRegs 0 xc xd 0 0 xs 65536 0 0 0 0 0 0 0 0)
        m)
      (Some
        (XNorm (MkRegs 0 0 65543 0 0 (ibt_v m 65536) 65536 0 0 0 0 0 0 0 0) m))))
  (steps ((compute lhs (stop mem_get)) (compute rhs (stop mem_get))) refl))

;; the write (fn 4): the 8 BE byte stores at [0,8) = ibtw_mem m 0 w;
;; the junk at RCX/RBX/RBP (the glue's live p/kb/rem) passes through.
(claim sst_xtotw0
  (goal
    ((w Int)
     (xa Int)
     (xc Int)
     (xd Int)
     (xb Int)
     (xbp Int)
     (m Mem)
     (c Nat)
     (restfs (List XFunc)))
    ()
    (=
      (xeval_seq
        (S^ 49 c)
        (MkXModule restfs 65536 131072)
        (gb_shtotw_x)
        (MkRegs xa xc xd xb xbp w 65536 0 0 0 0 0 0 0 0)
        m)
      (Some
        (XNorm
          (MkRegs 0 xc 65543 xb xbp w 65536 0 0 0 0 0 0 0 0)
          (ibtw_mem m 65536 w)))))
  (steps
    ((compute lhs (stop mem_set mem_get)) (compute rhs (stop mem_set mem_get)))
    refl))

;; ---- the fold-loop body, article-local (inline sugar is same-file
;; only; ssf_tie pins the transcription to the weld's shb_xbody)

(fn ssf_xbody () (List XInstr)
  (list
    (XBrIf (CEqz RDX) 1)
    (XMovRR RCX R12)
    (XBin XSub RCX (SImm 65536))
    (XMovRI RBX 131040)
    (XStore8 (AReg RBX) (SReg RCX))
    (XShrI RCX 8)
    (XMovRI RBX 131041)
    (XStore8 (AReg RBX) (SReg RCX))
    (XMovRR RCX RDX)
    (XMovRI RBX 131042)
    (XStore8 (AReg RBX) (SReg RCX))
    (XShrI RCX 8)
    (XMovRI RBX 131043)
    (XStore8 (AReg RBX) (SReg RCX))
    (XMovRI R13 130496)
    (XCall 0)
    (XMovRI RBX 131041)
    (XLoad8 R12 (AReg RBX))
    (XShlI R12 8)
    (XMovRI RBX 131040)
    (XLoad8 RCX (AReg RBX))
    (XBin XAdd R12 (SReg RCX))
    (XBin XAdd R12 (SImm 65600))
    (XMovRI RBX 131043)
    (XLoad8 RDX (AReg RBX))
    (XShlI RDX 8)
    (XMovRI RBX 131042)
    (XLoad8 RCX (AReg RBX))
    (XBin XAdd RDX (SReg RCX))
    (XBin XSub RDX (SImm 1))
    (XMovRI RCX 0)
    (XMovRI RBX 0)
    (XMovRI RBP 0)
    (XMovRI RSI 0)
    (XMovRI RDI 0)
    (XMovRI R8 0)
    (XMovRI R9 0)
    (XBr 0)))

(claim ssf_tie
  (goal () () (= (ssf_xbody) (shb_xbody)))
  (steps ((compute both)) refl))


;; ---- the absorber glue (STREAM.md 7.9 M1; the hand XCall
;; composition: spill r, read the total, derive p/kb/rem, bump the
;; cell, fold whole blocks from 128-p, copy the tail home)

(fn sst_xabs_body () (List XInstr)
  (list
    (XMovRI RCX 65545)
    (XStore8 (AReg RCX) (SReg RDI))
    (XMovRR RAX RDI)
    (XShrI RAX 8)
    (XMovRI RCX 65546)
    (XStore8 (AReg RCX) (SReg RAX))
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDX 65546)
    (XLoad8 RAX (AReg RDX))
    (XShlI RAX 8)
    (XMovRI RDX 65545)
    (XLoad8 RBX (AReg RDX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRR RBX RCX)
    (XBin XAdd RBX (SReg RAX))
    (XMovRR RBP RBX)
    (XBin XAnd RBP (SImm 63))
    (XShrI RBX 6)
    (XMovRI RDX 65544)
    (XStore8 (AReg RDX) (SReg RBP))
    (XBin XAdd RSI (SReg RAX))
    (XCall 4)
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RBX)
    (XMovRI RCX 0)
    (XMovRI RBX 0)
    (XMovRI RBP 0)
    (XCall 1)
    (XMovRI RCX 65544)
    (XLoad8 RDX (AReg RCX))
    (XMovRI RCX 65546)
    (XLoad8 RAX (AReg RCX))
    (XShlI RAX 8)
    (XMovRI RCX 65545)
    (XLoad8 RBX (AReg RCX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RDX))
    (XMovRI RSI 65664)
    (XBin XAdd RSI (SReg RAX))
    (XBin XSub RSI (SReg RDX))
    (XCall 2)))


;; ---- see-through kit for the reload sites

(claim sst_get_sp_below
  (goal ((m Mem) (s Int) (n Int) (a Int)) ((= (lt a 131040) True))
    (= (mem_get (shx_spill m s n) a) (mem_get m a)))
  (chain
    (steps ((unfold shx_spill lhs)))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma get_set_other)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    refl))

(claim sst_get_shx_below
  (goal ((m Mem) (src Int) (a Int) (k Nat)) ((= (lt a 130496) True))
    (= (mem_get (shx_mem m src k) a) (mem_get m a)))
  (induct k
    ((case Z (steps ((compute both (stop mem_get))) refl))
     (case S
       (k2)
       (chain
         (steps ((rewrite (lemma shx_mem_s) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
         (rewrite-with
           (lemma ish_get_shw_below)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
         (rewrite-with
           (lemma sst_get_sp_below)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1))))))
         refl)))))

(claim sst_get_ibtw0_above
  (goal ((m Mem) (w Int) (a Int)) ((= (le 65544 a) True))
    (= (mem_get (ibtw_mem m 65536 w) a) (mem_get m a)))
  (chain
    (steps ((unfold ibtw_mem lhs)))
    (rewrite-with
      (lemma get_set_other)
