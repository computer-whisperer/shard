                    (XMovRI RAX 0)
                    (XBlock (list (XLoop (inline ssc_xbody))))
                    (XMovRI RAX 0)))
                (Cons
                  (MkXFunc 0 (gb_shtotr_x))
                  (Cons
                    (MkXFunc 0 (gb_shtotw_x))
                    (Cons
                      (MkXFunc 0 (inline sst_xabs_body))
                      (Cons
                        (MkXFunc 0 (gb_shfpad_x))
                        (Cons
                          (MkXFunc 0 (gb_shhex_x))
                          (Cons (MkXFunc 0 (inline sst_xfin_body)) restfs)))))))))
          65536
          131072)
        8
        (MkRegs xa xc xd 0 0 xs xdi 0 0 0 0 0 0 0 0)
        m)
