        refl))
    (rewrite-with
      (lemma mod_unique)
      lr
      lhs
      ((inst q (- (ediv (+ n c) 64) (ediv n 64))) (inst r (mod (+ n c) 64)))
      ((steps () (by arith (list (list 1 1 -1 0 0) (list 1 -1 1 0 0))))
       (steps ((rewrite (premise hlo) lr lhs true ())) refl)
       (steps ((rewrite (premise hhi) lr lhs true ())) refl))
