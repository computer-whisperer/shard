            (- 65664 (band (ibt_v m 65536) 63))
            kb)
          (- 65664 (int_of_nat krem))
          (- (+ 65664 r) (int_of_nat krem))
          krem)
        131008
        8)
      (shw_hlist
        (sha_blocks h (sapp pend chunk) (ediv (slen (sapp pend chunk)) 64)))))
  (chain
    (have hbv (= (band (ibt_v m 65536) 63) (int_of_nat pn))
      (chain
        (steps ((rewrite (premise 5) lr lhs true ())))
        (rewrite-with
          (lemma sst_mask6)
          lr
          lhs
          ()
