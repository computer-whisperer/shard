;;; std/sha256/sha256.stream.shard — the INCREMENTAL SHA-256 state
;;; (Arc B rung B3, docs/STREAM.md §7.6, ratified 2026-07-29): the
;;; spec-level step/finalizer pair the streaming bin's read loop folds.
;;; State = (H after the absorbed whole blocks, the pending tail
;;; (< 64 bytes), the total byte count); `sha_step` absorbs a chunk —
;;; a PLAIN BYTE LIST, the §7.8 Fork-C ruling: the spec side never
;;; speaks memory; the window is the machine leg's business — folding
;;; every whole 64-byte block through `sha_block` and carrying the
;;; remainder; `sha_fin` pads the tail with the TOTAL length (the same
;;; zeros formula as `sha_pad`, driven by n ≡ |pend| mod 64) and
;;; produces the 32 digest bytes.
;;;
;;; The CORRESPONDENCE THEOREM (§7.6: folding chunks then finalizing =
;;; the one-shot sha256 of the concatenation, at list grain, memory-
;;; free) lands at the bottom of this file — sha_stream_corresponds,
;;; over the abstraction fn sha_abs and the shift/split/prefix lemma
;;; road. The ground pins cross every boundary shape — empty message,
;;; sub-block chunks, an empty chunk mid-stream, a fold inside a step,
;;; two folds inside one step, and the exact-block-boundary tail.

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "sha256.shard")
(use (:: std sha256 sha256 *))
(use (:: std sha256 sha256))

;; the incremental state: H = the hash state after the absorbed whole
;; blocks, pend = the unabsorbed tail (always < 64 bytes), n = total
;; bytes seen (the finalizer's length field — FIPS 180-4 pads with the
;; MESSAGE length, not the tail's).
(type ShaSt (MkShaSt H8 (List Int) Int))

(fn sha_init () ShaSt (MkShaSt (sha_h0) Nil 0))

;; absorb one chunk: append to the pending tail, fold every whole
;; 64-byte block into H (sha_blocks consumes exactly k blocks and
;; leaves the remainder untouched), keep the rest pending.
(fn sha_step ((st ShaSt) (chunk (List Int))) ShaSt
  (match st
    ((MkShaSt h pend n)
     (let ((buf (sapp pend chunk)))
       (let ((k (ediv (slen buf) 64)))
         (MkShaSt (sha_blocks h buf k) (sdrop (* 64 k) buf) (+ n (slen chunk))))))))

;; finalize: pad the pending tail exactly as sha_pad pads a whole
;; message — 0x80, zeros, the 64-bit bit length — with n the TOTAL
;; count. zeros = (55 - n) mod 64 keeps the padded tail a whole number
;; of blocks because |pend| ≡ n (mod 64).
(fn sha_fin ((st ShaSt)) (List Int)
  (match st
    ((MkShaSt h pend n)
     (let
       ((tl
          (sapp
            pend
            (Cons 128 (sapp (szeros (mod (- 55 n) 64)) (len_be (* 8 n)))))))
       (h8_bytes (sha_blocks h tl (ediv (slen tl) 64)))))))

;; the chunk-sequence fold (first-order): the spine the correspondence
;; theorem quantifies over — sha_fin (sha_steps sha_init cs) will be
;; proven equal to sha256 of the concatenation of cs.
(fn sha_steps ((st ShaSt) (chunks (List (List Int)))) ShaSt
  (measure (struct chunks))
  (match chunks
    (Nil st)
    ((Cons c t) (sha_steps (sha_step st c) t))))

;; ---- ground pins: the incremental path reproduces the one-shot ------------------
;; compute-proven both sides — a definition bug in step/fin can never
;; slip past these into the correspondence proof.

;; the empty message: finalize straight from init (pure padding block).
(claim shst_empty_pin
  (goal () () (= (sha_fin (sha_init)) (sha256 Nil)))
  (steps ((compute both)) refl))

;; one sub-block chunk.
(claim shst_abc_pin
  (goal () () (= (sha_fin (sha_step (sha_init) "abc")) (sha256 "abc")))
  (steps ((compute both)) refl))

;; the same message split — the pending tail carries across steps.
(claim shst_abc_split_pin
  (goal () ()
    (= (sha_fin (sha_steps (sha_init) (list "a" "bc"))) (sha256 "abc")))
  (steps ((compute both)) refl))

;; an empty chunk mid-stream is absorbed silently (the short-read case:
;; a legal ret > 0 loop iteration can still deliver few bytes).
(claim shst_empty_chunk_pin
  (goal () ()
    (= (sha_fin (sha_steps (sha_init) (list "a" Nil "bc"))) (sha256 "abc")))
  (steps ((compute both)) refl))

;; a fold INSIDE each step: 70-byte then 60-byte chunks — step 1 folds
;; one block and pends 6 bytes, step 2 reaches 66 and folds again,
;; the finalizer pads the 2-byte tail with n = 130.
(claim shst_two_chunk_fold_pin
  (goal () ()
    (=
      (sha_fin
        (sha_steps
          (sha_init)
          (list
            "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopq"
            "012345678901234567890123456789012345678901234567890123456789")))
      (sha256
        (sapp
          "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopq"
          "012345678901234567890123456789012345678901234567890123456789"))))
  (steps ((compute both)) refl))

;; TWO folds inside ONE step: the same 130 bytes as a single chunk.
(claim shst_one_chunk_two_block_pin
  (goal () ()
    (=
      (sha_fin
        (sha_step
          (sha_init)
          (sapp
            "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopq"
            "012345678901234567890123456789012345678901234567890123456789")))
      (sha256
        (sapp
          "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopq"
          "012345678901234567890123456789012345678901234567890123456789"))))
  (steps ((compute both)) refl))

;; the exact-block boundary: a 64-byte chunk folds clean (pend = Nil),
;; the finalizer's tail is the pure padding block with n = 64.
(claim shst_block_boundary_pin
  (goal () ()
    (=
      (sha_fin
        (sha_step
          (sha_init)
          "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl"))
      (sha256
        "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl")))
  (steps ((compute both)) refl))

;; ---- the correspondence kit (§7.6, slice 2): list-plumbing laws ------------------
;; over sha256.shard's LOCAL transparent copies — stated here, not in the
;; impl file, so the stream article stays a light self-contained closure
;; (sha256.imp.shard proved sibling shapes for the weld; its closure is
;; the whole imp tower, wrong import for a spec-side theorem file).

;; slen is nonnegative.
(claim shc_slen_nn (goal ((xs (List Int))) () (= (le 0 (slen xs)) True)) auto)

;; slen distributes over sapp.
(claim shc_slen_sapp
  (goal ((xs (List Int)) (ys (List Int))) ()
    (= (slen (sapp xs ys)) (+ (slen xs) (slen ys))))
  auto)

;; sapp right identity.
(claim shc_sapp_nil (goal ((xs (List Int))) () (= (sapp xs Nil) xs)) auto)

;; sapp associates.
(claim shc_sapp_assoc
  (goal ((xs (List Int)) (ys (List Int)) (zs (List Int))) ()
    (= (sapp (sapp xs ys) zs) (sapp xs (sapp ys zs))))
  auto)

;; dropping zero is the identity.
(claim shc_sdrop0 (goal ((xs (List Int))) () (= (sdrop 0 xs) xs)) auto)

;; taking zero is empty.
(claim shc_stake0 (goal ((xs (List Int))) () (= (stake 0 xs) Nil)) auto)

;; len_be always spells 8 bytes.
(claim shc_len_be_len (goal ((v Int)) () (= (slen (len_be v)) 8)) auto)

;; the successor-argument collapse the premised inductions cite
;; (loopkit's lg_sub, restated locally to keep the closure light).
(claim shc_sub (goal ((n Int)) () (= (- (+ 1 n) 1) n)) (by arith (list)))

;; slen opens one Cons — the have the premise-computation dance cites.
(claim shc_slen_cons
  (goal ((h Int) (t (List Int))) () (= (slen (Cons h t)) (+ 1 (slen t))))
  (steps ((unfold slen lhs) (reduce lhs)) refl))

;; ---- the premised drop/take family (hand proofs — the solver's ladder
;; exhausts on premised inductions; each is the ish_* idiom: case the
;; guard, convert case hyps to premises by have, isolate each single
;; call in a have so unfolds are unambiguous, discharge the IH's
;; premises by keyed-row arith, close by rewrite).

;; drops compose additively.
(claim shc_sdrop_sdrop
  (goal ((a Int) (b Int) (xs (List Int))) ((= (le 0 a) True) (= (le 0 b) True))
    (= (sdrop a (sdrop b xs)) (sdrop (+ a b) xs)))
  (induct xs
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (h t)
       (case-on (le b 0) Bool
         ((case True
            (chain
              (have hb (= (le b 0) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have hb0 (= b 0)
                (by arith (list (rows (goal 1) (hb 1)) (rows (goal 1) (1 1)))))
              (have ha0 (= (+ a 0) a) (by arith (list)))
              (steps
                ((rewrite (premise hb0) lr both true ())
                 (rewrite (lemma shc_sdrop0) lr lhs true ())
                 (rewrite (premise ha0) lr rhs true ()))
                refl)))
          (case False
            (chain
              (have hb (= (le b 0) False)
                (steps ((rewrite (hyp False) lr lhs true ())) refl))
              (have hab (= (le (+ a b) 0) False)
                (by arith (rows (goal 1) (hb 1) (0 1))))
              (have hsh (= (+ a (- b 1)) (- (+ a b) 1)) (by arith (list)))
              (have hin (= (sdrop b (Cons h t)) (sdrop (- b 1) t))
                (steps
                  ((unfold sdrop lhs)
                   (reduce lhs)
                   (rewrite (premise hb) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hout (= (sdrop (+ a b) (Cons h t)) (sdrop (- (+ a b) 1) t))
                (steps
                  ((unfold sdrop lhs)
                   (reduce lhs)
                   (rewrite (premise hab) lr lhs true ())
                   (reduce lhs))
                  refl))
              (steps
                ((rewrite (premise hin) lr lhs true ())
                 (rewrite (premise hout) lr rhs true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ((inst b (- b 1)))
                ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                 (steps () (by arith (rows (goal 1) (hb 1)))))
                (steps ((rewrite (premise hsh) lr lhs true ())) refl))))))))))

;; a take within the prefix ignores the appended tail.
(claim shc_stake_pre
  (goal ((n Int) (xs (List Int)) (ys (List Int)))
    ((= (le 0 n) True) (= (le n (slen xs)) True))
    (= (stake n (sapp xs ys)) (stake n xs)))
  (induct xs
    ((case Nil
       (chain
         (have hz (= (slen Nil) 0) (steps ((compute lhs)) refl))
         (have hn0 (= (le n 0) True)
           (steps
             ((rewrite (premise hz) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (have he (= n 0)
           (by arith (list (rows (goal 1) (hn0 1)) (rows (goal 1) (0 1)))))
         (steps
           ((rewrite (premise he) lr both true ())
            (rewrite (lemma shc_stake0) lr both true ()))
           refl)))
     (case Cons
       (h t)
       (case-on (le n 0) Bool
         ((case True
            (chain
              (have hn (= (le n 0) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have he (= n 0)
                (by arith (list (rows (goal 1) (hn 1)) (rows (goal 1) (0 1)))))
              (steps
                ((rewrite (premise he) lr both true ())
                 (rewrite (lemma shc_stake0) lr both true ()))
                refl)))
          (case False
            (chain
              (have hn (= (le n 0) False)
                (steps ((rewrite (hyp False) lr lhs true ())) refl))
              (have hsc (= (slen (Cons h t)) (+ 1 (slen t)))
                (steps ((rewrite (lemma shc_slen_cons) lr lhs true ())) refl))
              (have hnt (= (le n (+ 1 (slen t))) True)
                (steps
                  ((rewrite (premise hsc) rl lhs true ())
                   (rewrite (premise 1) lr lhs true ()))
                  refl))
              (have hap (= (sapp (Cons h t) ys) (Cons h (sapp t ys)))
                (steps ((unfold sapp lhs) (reduce lhs)) refl))
              (have hl
                (=
                  (stake n (Cons h (sapp t ys)))
                  (Cons h (stake (- n 1) (sapp t ys))))
                (steps
                  ((unfold stake lhs)
                   (reduce lhs)
                   (rewrite (premise hn) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hr (= (stake n (Cons h t)) (Cons h (stake (- n 1) t)))
                (steps
                  ((unfold stake lhs)
                   (reduce lhs)
                   (rewrite (premise hn) lr lhs true ())
                   (reduce lhs))
                  refl))
              (steps
                ((rewrite (premise hap) lr lhs true ())
                 (rewrite (premise hl) lr lhs true ())
                 (rewrite (premise hr) lr rhs true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ((inst n (- n 1)))
                ((steps () (by arith (rows (goal 1) (hn 1))))
                 (steps () (by arith (rows (goal 1) (hnt 1)))))
                refl)))))))))

;; a drop within the prefix passes the appended tail through.
(claim shc_sdrop_pre
  (goal ((n Int) (xs (List Int)) (ys (List Int)))
    ((= (le 0 n) True) (= (le n (slen xs)) True))
    (= (sdrop n (sapp xs ys)) (sapp (sdrop n xs) ys)))
  (induct xs
    ((case Nil
       (chain
         (have hz (= (slen Nil) 0) (steps ((compute lhs)) refl))
         (have hn0 (= (le n 0) True)
           (steps
             ((rewrite (premise hz) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (have he (= n 0)
           (by arith (list (rows (goal 1) (hn0 1)) (rows (goal 1) (0 1)))))
         (steps
           ((rewrite (premise he) lr both true ())
            (rewrite (lemma shc_sdrop0) lr both true ())
            (compute both))
           refl)))
     (case Cons
       (h t)
       (case-on (le n 0) Bool
         ((case True
            (chain
              (have hn (= (le n 0) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have he (= n 0)
                (by arith (list (rows (goal 1) (hn 1)) (rows (goal 1) (0 1)))))
              (steps
                ((rewrite (premise he) lr both true ())
                 (rewrite (lemma shc_sdrop0) lr both true ()))
                refl)))
          (case False
            (chain
              (have hn (= (le n 0) False)
                (steps ((rewrite (hyp False) lr lhs true ())) refl))
              (have hsc (= (slen (Cons h t)) (+ 1 (slen t)))
                (steps ((rewrite (lemma shc_slen_cons) lr lhs true ())) refl))
              (have hnt (= (le n (+ 1 (slen t))) True)
                (steps
                  ((rewrite (premise hsc) rl lhs true ())
                   (rewrite (premise 1) lr lhs true ()))
                  refl))
              (have hap (= (sapp (Cons h t) ys) (Cons h (sapp t ys)))
                (steps ((unfold sapp lhs) (reduce lhs)) refl))
              (have hl
                (= (sdrop n (Cons h (sapp t ys))) (sdrop (- n 1) (sapp t ys)))
                (steps
                  ((unfold sdrop lhs)
                   (reduce lhs)
                   (rewrite (premise hn) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hr (= (sdrop n (Cons h t)) (sdrop (- n 1) t))
                (steps
                  ((unfold sdrop lhs)
                   (reduce lhs)
                   (rewrite (premise hn) lr lhs true ())
                   (reduce lhs))
                  refl))
              (steps
                ((rewrite (premise hap) lr lhs true ())
                 (rewrite (premise hl) lr lhs true ())
                 (rewrite (premise hr) lr rhs true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ((inst n (- n 1)))
                ((steps () (by arith (rows (goal 1) (hn 1))))
                 (steps () (by arith (rows (goal 1) (hnt 1)))))
                refl)))))))))

;; the length of a drop within bounds.
(claim shc_slen_sdrop
  (goal ((n Int) (xs (List Int))) ((= (le 0 n) True) (= (le n (slen xs)) True))
    (= (slen (sdrop n xs)) (- (slen xs) n)))
  (induct xs
    ((case Nil
       (chain
         (have hz (= (slen Nil) 0) (steps ((compute lhs)) refl))
         (have hn0 (= (le n 0) True)
           (steps
             ((rewrite (premise hz) rl lhs true ())
              (rewrite (premise 1) lr lhs true ()))
             refl))
         (steps ((compute both)))
         (steps
           ()
           (by arith (list (rows (goal 1) (hn0 1)) (rows (goal 1) (0 1)))))))
     (case Cons
       (h t)
       (case-on (le n 0) Bool
         ((case True
            (chain
              (have hn (= (le n 0) True)
                (steps ((rewrite (hyp True) lr lhs true ())) refl))
              (have he (= n 0)
                (by arith (list (rows (goal 1) (hn 1)) (rows (goal 1) (0 1)))))
              (steps
                ((rewrite (premise he) lr both true ())
                 (rewrite (lemma shc_sdrop0) lr lhs true ())))
              (steps () (by arith (list)))))
          (case False
            (chain
              (have hn (= (le n 0) False)
                (steps ((rewrite (hyp False) lr lhs true ())) refl))
              (have hsc (= (slen (Cons h t)) (+ 1 (slen t)))
                (steps ((rewrite (lemma shc_slen_cons) lr lhs true ())) refl))
              (have hnt (= (le n (+ 1 (slen t))) True)
                (steps
                  ((rewrite (premise hsc) rl lhs true ())
                   (rewrite (premise 1) lr lhs true ()))
                  refl))
              (have hd (= (sdrop n (Cons h t)) (sdrop (- n 1) t))
                (steps
                  ((unfold sdrop lhs)
                   (reduce lhs)
                   (rewrite (premise hn) lr lhs true ())
                   (reduce lhs))
                  refl))
              (steps
                ((rewrite (premise hd) lr lhs true ())
                 (rewrite (premise hsc) lr rhs true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ((inst n (- n 1)))
                ((steps () (by arith (rows (goal 1) (hn 1))))
                 (steps () (by arith (rows (goal 1) (hnt 1)))))
                (steps () (by arith (list))))))))))))

;; the length of szeros.
(claim shc_szeros_len
  (goal ((z Int)) ((= (le 0 z) True)) (= (slen (szeros z)) z))
  (wf-induct z
    (case-on (le z 0) Bool
      ((case True
         (chain
           (have hz (= (le z 0) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (steps
             ((unfold szeros lhs)
              (rewrite (premise hz) lr lhs true ())
              (compute lhs)))
           (steps
             ()
             (by arith (list (rows (goal 1) (0 1)) (rows (goal 1) (hz 1)))))))
       (case False
         (chain
           (have hz (= (le z 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hu (= (szeros z) (Cons 0 (szeros (- z 1))))
             (steps
               ((unfold szeros lhs)
                (rewrite (premise hz) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hu) lr lhs true ())
              (unfold slen lhs)
              (reduce lhs)))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((steps () (by arith (rows (goal 1) (hz 1))))
              (steps () (by arith (rows (goal 1) (hz 1))))
              (steps () (by arith (list))))
             (steps () (by arith (list))))))))))

;; ---- the correspondence theorem (§7.6, slice 3) ----------------------------------
;; sha_abs is the abstraction function: the incremental state a whole
;; absorbed message denotes. The lemma road: the euclidean shift law
;; moves whole-block counts through ediv; blocks_split cuts a fold at
;; any fuel boundary; blocks_prefix discharges appended bytes the fuel
;; never reaches; absorb (step) and finalize (fin) commute sha_abs
;; with the two state operations; the main induction folds a chunk
;; list into one concatenation. No case split on the tail's length is
;; ever needed — the fuel shifts by exactly kM on both legs.

(fn sha_abs ((msg (List Int))) ShaSt
  (MkShaSt
    (sha_blocks (sha_h0) msg (ediv (slen msg) 64))
    (sdrop (* 64 (ediv (slen msg) 64)) msg)
    (slen msg)))

;; the spec-level chunk concatenation the theorem quantifies over.
(fn scat ((cs (List (List Int)))) (List Int)
  (measure (struct cs))
  (match cs
    (Nil Nil)
    ((Cons c t) (sapp c (scat t)))))

;; the quotient of a nonneg dividend is nonneg (divisor 64).
(claim shc_ediv64_lo
  (goal ((n Int)) ((= (le 0 n) True)) (= (le 0 (ediv n 64)) True))
  (chain
    (have hid (= n (+ (* 64 (ediv n 64)) (mod n 64)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 64))
        ((steps ((compute lhs)) refl))
        refl))
    (have hhi (= (lt (mod n 64) 64) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (steps () (by arith (rows (goal 64) (0 1) (hid -1) (hhi 1))))))

;; 64 * quotient stays below the dividend.
(claim shc_ediv64_ub
  (goal ((n Int)) ((= (le 0 n) True)) (= (le (* 64 (ediv n 64)) n) True))
  (chain
    (have hid (= n (+ (* 64 (ediv n 64)) (mod n 64)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 64))
        ((steps ((compute lhs)) refl))
        refl))
    (have hlo (= (le 0 (mod n 64)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (steps () (by arith (rows (goal 1) (hid 1) (hlo 1))))))

;; the euclidean shift law: a whole multiple of the divisor moves out
;; of the quotient (div_unique at the exhibited decomposition).
(claim shc_ediv_shift
  (goal ((a Int) (x Int)) () (= (ediv (+ (* 64 a) x) 64) (+ a (ediv x 64))))
  (chain
    (have hx (= x (+ (* 64 (ediv x 64)) (mod x 64)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 64))
        ((steps ((compute lhs)) refl))
        refl))
    (have hlo (= (le 0 (mod x 64)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hhi (= (lt (mod x 64) 64) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (rewrite-with
      (lemma div_unique)
      lr
      lhs
      ((inst q (+ a (ediv x 64))) (inst r (mod x 64)))
      ((steps () (by arith (list (list 1 -1 0 0) (list 1 1 0 0))))
       (steps ((rewrite (premise hlo) lr lhs true ())) refl)
       (steps ((rewrite (premise hhi) lr lhs true ())) refl)))
    refl))

;; a sha_blocks fold cuts at any fuel boundary: a+b blocks = a blocks,
;; then b blocks from 64a bytes in.
(claim shc_blocks_split
  (goal ((a Int) (b Int) (st H8) (bs (List Int)))
    ((= (le 0 a) True) (= (le 0 b) True))
    (=
      (sha_blocks st bs (+ a b))
      (sha_blocks (sha_blocks st bs a) (sdrop (* 64 a) bs) b)))
  (wf-induct a
    (case-on (le a 0) Bool
      ((case True
         (chain
           (have ha (= (le a 0) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have ha0 (= a 0)
             (by arith (list (rows (goal 1) (ha 1)) (rows (goal 1) (0 1)))))
           (have hzf (= (sha_blocks st bs 0) st) (steps ((compute lhs)) refl))
           (have h640 (= (* 64 0) 0) (steps ((compute lhs)) refl))
           (have h0b (= (+ 0 b) b) (by arith (list)))
           (steps
             ((rewrite (premise ha0) lr both true ())
              (rewrite (premise h0b) lr lhs true ())
              (rewrite (premise hzf) lr rhs true ())
              (rewrite (premise h640) lr rhs true ())
              (rewrite (lemma shc_sdrop0) lr rhs true ()))
             refl)))
       (case False
         (chain
           (have ha (= (le a 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hab (= (le (+ a b) 0) False)
             (by arith (rows (goal 1) (ha 1) (1 1))))
           (have hL
             (=
               (sha_blocks st bs (+ a b))
               (sha_blocks
                 (sha_block st (stake 64 bs))
                 (sdrop 64 bs)
                 (- (+ a b) 1)))
             (steps
               ((unfold sha_blocks lhs)
                (reduce lhs)
                (rewrite (premise hab) lr lhs true ())
                (reduce lhs))
               refl))
           (have hstep
             (=
               (sha_blocks st bs a)
               (sha_blocks (sha_block st (stake 64 bs)) (sdrop 64 bs) (- a 1)))
             (steps
               ((unfold sha_blocks lhs)
                (reduce lhs)
                (rewrite (premise ha) lr lhs true ())
                (reduce lhs))
               refl))
           (have hsh (= (- (+ a b) 1) (+ (- a 1) b)) (by arith (list)))
           (have hma (= (* 64 a) (+ (* 64 (- a 1)) 64)) (by arith (list)))
           (steps
             ((rewrite (premise hL) lr lhs true ())
              (rewrite (premise hsh) lr lhs true ())
              (rewrite (premise hstep) lr rhs true ())
              (rewrite (premise hma) lr rhs true ())))
           (rewrite-with
             (lemma shc_sdrop_sdrop)
             rl
             rhs
             ()
             ((steps () (by arith (rows (goal 1) (ha 64))))
              (steps ((compute lhs)) refl)))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((steps () (by arith (rows (goal 1) (ha 1))))
              (steps ((rewrite (premise 1) lr lhs true ())) refl)
              (steps () (by arith (rows (goal 1) (ha 1))))
              (steps () (by arith (list))))
             refl)))))))

;; bytes appended past the fueled prefix never reach the fold: with
;; 64k bytes of prefix available, a k-block fold ignores the suffix.
(claim shc_blocks_prefix
  (goal ((k Int) (st H8) (xs (List Int)) (ys (List Int)))
    ((= (le 0 k) True) (= (le (* 64 k) (slen xs)) True))
    (= (sha_blocks st (sapp xs ys) k) (sha_blocks st xs k)))
  (wf-induct k
    (case-on (le k 0) Bool
      ((case True
         (chain
           (have hk (= (le k 0) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hL (= (sha_blocks st (sapp xs ys) k) st)
             (steps
               ((unfold sha_blocks lhs)
                (rewrite (premise hk) lr lhs true ())
                (reduce lhs))
               refl))
           (have hR (= (sha_blocks st xs k) st)
             (steps
               ((unfold sha_blocks lhs)
                (rewrite (premise hk) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hL) lr lhs true ())
              (rewrite (premise hR) lr rhs true ()))
             refl)))
       (case False
         (chain
           (have hk (= (le k 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have h64 (= (le 64 (slen xs)) True)
             (by arith (rows (goal 1) (1 1) (hk 64))))
           (have hsd (= (slen (sdrop 64 xs)) (- (slen xs) 64))
             (rewrite-with
               (lemma shc_slen_sdrop)
               lr
               lhs
               ()
               ((steps ((compute lhs)) refl)
                (steps ((rewrite (premise h64) lr lhs true ())) refl))
               refl))
           (have hL
             (=
               (sha_blocks st (sapp xs ys) k)
               (sha_blocks
                 (sha_block st (stake 64 (sapp xs ys)))
                 (sdrop 64 (sapp xs ys))
                 (- k 1)))
             (steps
               ((unfold sha_blocks lhs)
                (reduce lhs)
                (rewrite (premise hk) lr lhs true ())
                (reduce lhs))
               refl))
           (have hR
             (=
               (sha_blocks st xs k)
               (sha_blocks (sha_block st (stake 64 xs)) (sdrop 64 xs) (- k 1)))
             (steps
               ((unfold sha_blocks lhs)
                (reduce lhs)
                (rewrite (premise hk) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hL) lr lhs true ())
              (rewrite (premise hR) lr rhs true ())))
           (rewrite-with
             (lemma shc_stake_pre)
             lr
             lhs
             ()
             ((steps ((compute lhs)) refl)
              (steps ((rewrite (premise h64) lr lhs true ())) refl)))
           (rewrite-with
             (lemma shc_sdrop_pre)
             lr
             lhs
             ()
             ((steps ((compute lhs)) refl)
              (steps ((rewrite (premise h64) lr lhs true ())) refl)))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((steps () (by arith (rows (goal 1) (hk 1))))
              (steps
                ((rewrite (premise hsd) lr lhs true ()))
                (by arith (rows (goal 1) (1 1))))
              (steps () (by arith (rows (goal 1) (hk 1))))
              (steps () (by arith (list))))
             refl)))))))

;; absorb: one sha_step from an absorbed state is the absorbed state
;; of the extended message (the main induction's step).
(claim shc_step_abs
  (goal ((M (List Int)) (c (List Int))) ()
    (= (sha_step (sha_abs M) c) (sha_abs (sapp M c))))
  (chain
    (have hm (= (le 0 (slen M)) True)
      (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
    (have hklo (= (le 0 (ediv (slen M) 64)) True)
      (rewrite-with
        (lemma shc_ediv64_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hm) lr lhs true ())) refl))
        refl))
    (have hkub (= (le (* 64 (ediv (slen M) 64)) (slen M)) True)
      (rewrite-with
        (lemma shc_ediv64_ub)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hm) lr lhs true ())) refl))
        refl))
    (have hlp
      (=
        (slen (sdrop (* 64 (ediv (slen M) 64)) M))
        (- (slen M) (* 64 (ediv (slen M) 64))))
      (rewrite-with
        (lemma shc_slen_sdrop)
        lr
        lhs
        ()
        ((steps () (by arith (rows (goal 1) (hklo 64))))
         (steps ((rewrite (premise hkub) lr lhs true ())) refl))
        refl))
    (have hlb
      (=
        (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c))
        (+ (slen (sdrop (* 64 (ediv (slen M) 64)) M)) (slen c)))
      (steps ((rewrite (lemma shc_slen_sapp) lr lhs true ())) refl))
    (have hlmc (= (slen (sapp M c)) (+ (slen M) (slen c)))
      (steps ((rewrite (lemma shc_slen_sapp) lr lhs true ())) refl))
    (have hbnn
      (= (le 0 (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c))) True)
      (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
    (have hkblo
      (=
        (le 0 (ediv (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c)) 64))
        True)
      (rewrite-with
        (lemma shc_ediv64_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hbnn) lr lhs true ())) refl))
        refl))
    (have hsplit
      (=
        (slen (sapp M c))
        (+
          (* 64 (ediv (slen M) 64))
          (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c))))
      (steps
        ()
        (by
          arith
          (list
            (rows (goal 1) (hlp 1) (hlb 1) (hlmc -1))
            (rows (goal 1) (hlp -1) (hlb -1) (hlmc 1))))))
    (have hKC
      (=
        (ediv (slen (sapp M c)) 64)
        (+
          (ediv (slen M) 64)
          (ediv (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c)) 64)))
      (steps
        ((rewrite (premise hsplit) lr lhs true ())
         (rewrite (lemma shc_ediv_shift) lr lhs true ()))
        refl))
    (have hma64
      (=
        (*
          64
          (+
            (ediv (slen M) 64)
            (ediv (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c)) 64)))
        (+
          (* 64 (ediv (slen (sapp (sdrop (* 64 (ediv (slen M) 64)) M) c)) 64))
          (* 64 (ediv (slen M) 64))))
      (by arith (list)))
    (steps
      ((unfold sha_abs lhs)
       (unfold sha_step lhs)
       (reduce lhs)
       (unfold sha_abs rhs)
       (rewrite (premise hKC) lr rhs true ())
       (rewrite (premise hlmc) lr rhs true ())
       (rewrite (premise hma64) lr rhs true ())))
    (rewrite-with
      (lemma shc_sdrop_sdrop)
      rl
      rhs
      ()
      ((steps () (by arith (rows (goal 1) (hkblo 64))))
       (steps () (by arith (rows (goal 1) (hklo 64))))))
    (rewrite-with
      (lemma shc_blocks_split)
      lr
      rhs
      ()
      ((steps ((rewrite (premise hklo) lr lhs true ())) refl)
       (steps ((rewrite (premise hkblo) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shc_blocks_prefix)
      lr
      rhs
      ()
      ((steps ((rewrite (premise hklo) lr lhs true ())) refl)
       (steps ((rewrite (premise hkub) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shc_sdrop_pre)
      lr
      rhs
      ()
      ((steps () (by arith (rows (goal 1) (hklo 64))))
       (steps ((rewrite (premise hkub) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shc_sdrop_pre)
      lr
      rhs
      ()
      ((steps () (by arith (rows (goal 1) (hklo 64))))
       (steps ((rewrite (premise hkub) lr lhs true ())) refl)))
    refl))

;; finalize: sha_fin of an absorbed state is the one-shot digest. The
;; padded message splits as 64*kM absorbed bytes ++ the padded tail,
;; and the fuel shifts by exactly kM — the r<=55 / r>55 tail shapes
;; never need separating.
(claim shc_fin_abs
  (goal ((M (List Int))) () (= (sha_fin (sha_abs M)) (sha256 M)))
  (chain
    (have hm (= (le 0 (slen M)) True)
      (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
    (have hklo (= (le 0 (ediv (slen M) 64)) True)
      (rewrite-with
        (lemma shc_ediv64_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hm) lr lhs true ())) refl))
        refl))
    (have hkub (= (le (* 64 (ediv (slen M) 64)) (slen M)) True)
      (rewrite-with
        (lemma shc_ediv64_ub)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hm) lr lhs true ())) refl))
        refl))
    (have hlp
      (=
        (slen (sdrop (* 64 (ediv (slen M) 64)) M))
        (- (slen M) (* 64 (ediv (slen M) 64))))
      (rewrite-with
        (lemma shc_slen_sdrop)
        lr
        lhs
        ()
        ((steps () (by arith (rows (goal 1) (hklo 64))))
         (steps ((rewrite (premise hkub) lr lhs true ())) refl))
        refl))
    (have hpad
      (=
        (sha_pad M)
        (sapp
          M
          (Cons
            128
            (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))
      (steps ((unfold sha_pad lhs) (reduce lhs)) refl))
    (have hlpd
      (=
        (slen
          (sapp
            M
            (Cons
              128
              (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))
        (+
          (slen M)
          (slen
            (Cons
              128
              (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M))))))))
      (steps ((rewrite (lemma shc_slen_sapp) lr lhs true ())) refl))
    (have hltl
      (=
        (slen
          (sapp
            (sdrop (* 64 (ediv (slen M) 64)) M)
            (Cons
              128
              (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))
        (+
          (slen (sdrop (* 64 (ediv (slen M) 64)) M))
          (slen
            (Cons
              128
              (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M))))))))
      (steps ((rewrite (lemma shc_slen_sapp) lr lhs true ())) refl))
    (have hpdtl
      (=
        (slen
          (sapp
            M
            (Cons
              128
              (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))
        (+
          (* 64 (ediv (slen M) 64))
          (slen
            (sapp
              (sdrop (* 64 (ediv (slen M) 64)) M)
              (Cons
                128
                (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))))
      (steps
        ()
        (by
          arith
          (list
            (rows (goal 1) (hlp 1) (hlpd -1) (hltl 1))
            (rows (goal 1) (hlp -1) (hlpd 1) (hltl -1))))))
    (have hfuel
      (=
        (ediv
          (slen
            (sapp
              M
              (Cons
                128
                (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M)))))))
          64)
        (+
          (ediv (slen M) 64)
          (ediv
            (slen
              (sapp
                (sdrop (* 64 (ediv (slen M) 64)) M)
                (Cons
                  128
                  (sapp
                    (szeros (mod (- 55 (slen M)) 64))
                    (len_be (* 8 (slen M)))))))
            64)))
      (steps
        ((rewrite (premise hpdtl) lr lhs true ())
         (rewrite (lemma shc_ediv_shift) lr lhs true ()))
        refl))
    (have htlnn
      (=
        (le
          0
          (slen
            (sapp
              (sdrop (* 64 (ediv (slen M) 64)) M)
              (Cons
                128
                (sapp (szeros (mod (- 55 (slen M)) 64)) (len_be (* 8 (slen M))))))))
        True)
      (steps ((rewrite (lemma shc_slen_nn) lr lhs true ())) refl))
    (have htlo
      (=
        (le
          0
          (ediv
            (slen
              (sapp
                (sdrop (* 64 (ediv (slen M) 64)) M)
                (Cons
                  128
                  (sapp
                    (szeros (mod (- 55 (slen M)) 64))
                    (len_be (* 8 (slen M)))))))
            64))
        True)
      (rewrite-with
        (lemma shc_ediv64_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise htlnn) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold sha_abs lhs)
       (unfold sha_fin lhs)
       (reduce lhs)
       (unfold sha256 rhs)
       (reduce rhs)
       (rewrite (premise hpad) lr rhs true ())
       (rewrite (premise hfuel) lr rhs true ())))
    (rewrite-with
      (lemma shc_blocks_split)
      lr
      rhs
      ()
      ((steps ((rewrite (premise hklo) lr lhs true ())) refl)
       (steps ((rewrite (premise htlo) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shc_blocks_prefix)
      lr
      rhs
      ()
      ((steps ((rewrite (premise hklo) lr lhs true ())) refl)
       (steps ((rewrite (premise hkub) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shc_sdrop_pre)
      lr
      rhs
      ()
      ((steps () (by arith (rows (goal 1) (hklo 64))))
       (steps ((rewrite (premise hkub) lr lhs true ())) refl)))
    refl))

;; the generalized main induction: folding any chunk list from any
;; absorbed state finalizes to the one-shot digest of the whole
;; concatenation.
(claim shc_stream_gen
  (goal ((cs (List (List Int))) (M (List Int))) ()
    (= (sha_fin (sha_steps (sha_abs M) cs)) (sha256 (sapp M (scat cs)))))
  (induct cs
    ((case Nil
       (chain
         (have hs (= (sha_steps (sha_abs M) Nil) (sha_abs M))
           (steps ((unfold sha_steps lhs) (reduce lhs)) refl))
         (have hc (= (scat Nil) Nil)
           (steps ((unfold scat lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hs) lr lhs true ())
            (rewrite (premise hc) lr rhs true ())
            (rewrite (lemma shc_sapp_nil) lr rhs true ())
            (rewrite (lemma shc_fin_abs) lr lhs true ()))
           refl)))
     (case Cons
       (c t)
       (chain
         (have hs
           (=
             (sha_steps (sha_abs M) (Cons c t))
             (sha_steps (sha_step (sha_abs M) c) t))
           (steps ((unfold sha_steps lhs) (reduce lhs)) refl))
         (have hc (= (scat (Cons c t)) (sapp c (scat t)))
           (steps ((unfold scat lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hs) lr lhs true ())
            (rewrite (premise hc) lr rhs true ())
            (rewrite (lemma shc_step_abs) lr lhs true ())))
         (rewrite-with (hyp 0) lr lhs ((inst M (sapp M c))) ())
         (steps ((rewrite (lemma shc_sapp_assoc) lr lhs true ())) refl))))))

;; THE §7.6 CORRESPONDENCE THEOREM: folding chunks from init then
;; finalizing = the one-shot sha256 of the concatenation. Pure list
;; grain; the window is the machine leg's business (Fork C ruling).
(claim sha_stream_corresponds
  (goal ((cs (List (List Int)))) ()
    (= (sha_fin (sha_steps (sha_init) cs)) (sha256 (scat cs))))
  (chain
    (have hi (= (sha_init) (sha_abs Nil)) (steps ((compute both)) refl))
    (have hn (= (sapp Nil (scat cs)) (scat cs))
      (steps ((unfold sapp lhs) (reduce lhs)) refl))
    (steps
      ((rewrite (premise hi) lr lhs true ())
       (rewrite (lemma shc_stream_gen) lr lhs true ())
       (rewrite (premise hn) lr lhs true ()))
      refl)))
