;; ===================================================================
;; E2b MACHINE TIER -- THE HAND BODY AND THE BLOCK WALK
;; ===================================================================
;; One SHA-NI block as a straight-line XVec instruction sequence, and
;; THE BLOCK WALK (shn_walk): walking it through the vector-tier
;; machine (xveval_seq) from ANY entry register and XMM file computes
;; shn_block on the loaded state and byte-flipped message groups.
;; Landed from the E2b machine-half probe (docs/STREAM.md 8.4; summit
;; first-check 2026-08-03). NO ground pins in this tranche: std/mem's
;; Mem is OPAQUE in check mode (mem_get of a mem_set tree stays stuck
;; -- the recorded M1 law), so ground machine runs live in the
;; run-mode differential (E2b slice A's 8 rows; the block-grain
;; silicon differential is E2c).
;;
;; REGISTER ALLOCATION (the E2b decision the body freezes):
;;   XMM0  = wk (sha256rnds2's implicit third operand)
;;   XMM1  = ABEF   XMM2 = CDGH   (roles NEVER swap: rnds2 C,A then
;;           pshufd wk 0x0E then rnds2 A,C -- the slide law's alternation)
;;   XMM3..XMM6 = the rotating four-group message window (W_j lives in
;;           XMM(3 + j mod 4); the sched step overwrites g_j with g_{j+4})
;;   XMM7  = sched temp (mov g3; palignr g2 4)
;;   XMM8  = the byte-flip mask, resident (XVBswap32's fence)
;;   XMM9/XMM10 = entry ABEF/CDGH saved for the paddd feedback
;;   XMM11 = K-group load target + pack/unpack shuffle temp
;;   scalar: RDI = src (the 64-byte block, caller's argument),
;;           R10 = home pointer scratch, R11 = K-table pointer
;; GROUND HOMES (the E3 image relocates by regeneration):
;;   mask@256, K table@[512,768) (16 groups, shn_kg i at 512+16i),
;;   H@[768,800) (linear dword layout: a..d then e..h), block@1024.

;; ---- the hand body -----------------------------------------------------------------

;; the prologue: mask resident, the state home packed to ABEF/CDGH and
;; saved for the feedback, the four message groups loaded and byte-flipped.
(fn shn_pro ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R10 256)
    (Cons
      (XVec (XVLoad XMM8 (AReg R10)))
      (Cons
        (XMovRI R10 768)
        (Cons
          (XVec (XVLoad XMM1 (AReg R10)))
          (Cons
            (XMovRI R10 784)
            (Cons
              (XVec (XVLoad XMM2 (AReg R10)))
              (Cons
                (XVec (XVPshufd XMM1 XMM1 177))
                (Cons
                  (XVec (XVPshufd XMM2 XMM2 27))
                  (Cons
                    (XVec (XVPshufd XMM11 XMM1 14))
                    (Cons
                      (XVec (XVPalignr XMM1 XMM2 8))
                      (Cons
                        (XVec (XVPunpckL XMM2 XMM11))
                        (Cons
                          (XVec (XVMov XMM9 XMM1))
                          (Cons
                            (XVec (XVMov XMM10 XMM2))
                            (Cons
                              (XVec (XVLoad XMM3 (AReg RDI)))
                              (Cons
                                (XBin XAdd RDI (SImm 16))
                                (Cons
                                  (XVec (XVLoad XMM4 (AReg RDI)))
                                  (Cons
                                    (XBin XAdd RDI (SImm 16))
                                    (Cons
                                      (XVec (XVLoad XMM5 (AReg RDI)))
                                      (Cons
                                        (XBin XAdd RDI (SImm 16))
                                        (Cons
                                          (XVec (XVLoad XMM6 (AReg RDI)))
                                          (Cons
                                            (XVec (XVBswap32 XMM3 XMM8))
                                            (Cons
                                              (XVec (XVBswap32 XMM4 XMM8))
                                              (Cons
                                                (XVec (XVBswap32 XMM5 XMM8))
                                                (Cons
                                                  (XVec (XVBswap32 XMM6 XMM8))
                                                  rest)))))))))))))))))))))))))

;; qround 0 (with the just-in-time schedule step): wk = W_0 + K_0 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
;; The schedule step overwrites XMM3 (holding W_0) with W_4.
(fn shn_q0 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 512)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM3))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVMov XMM7 XMM6))
            (Cons
              (XVec (XVPalignr XMM7 XMM5 4))
              (Cons
                (XVec (XVSha256Msg1 XMM3 XMM4))
                (Cons
                  (XVec (XVPaddd XMM3 XMM7))
                  (Cons
                    (XVec (XVSha256Msg2 XMM3 XMM6))
                    (Cons
                      (XVec (XVSha256Rnds2 XMM2 XMM1))
                      (Cons
                        (XVec (XVPshufd XMM0 XMM0 14))
                        (Cons (XVec (XVSha256Rnds2 XMM1 XMM2)) rest)))))))))))))

;; qround 1 (with the just-in-time schedule step): wk = W_1 + K_1 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
;; The schedule step overwrites XMM4 (holding W_1) with W_5.
(fn shn_q1 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 528)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM4))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVMov XMM7 XMM3))
            (Cons
              (XVec (XVPalignr XMM7 XMM6 4))
              (Cons
                (XVec (XVSha256Msg1 XMM4 XMM5))
                (Cons
                  (XVec (XVPaddd XMM4 XMM7))
                  (Cons
                    (XVec (XVSha256Msg2 XMM4 XMM3))
                    (Cons
                      (XVec (XVSha256Rnds2 XMM2 XMM1))
                      (Cons
                        (XVec (XVPshufd XMM0 XMM0 14))
                        (Cons (XVec (XVSha256Rnds2 XMM1 XMM2)) rest)))))))))))))

;; qround 2 (with the just-in-time schedule step): wk = W_2 + K_2 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
;; The schedule step overwrites XMM5 (holding W_2) with W_6.
(fn shn_q2 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 544)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM5))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVMov XMM7 XMM4))
            (Cons
              (XVec (XVPalignr XMM7 XMM3 4))
              (Cons
                (XVec (XVSha256Msg1 XMM5 XMM6))
                (Cons
                  (XVec (XVPaddd XMM5 XMM7))
                  (Cons
                    (XVec (XVSha256Msg2 XMM5 XMM4))
                    (Cons
                      (XVec (XVSha256Rnds2 XMM2 XMM1))
                      (Cons
                        (XVec (XVPshufd XMM0 XMM0 14))
                        (Cons (XVec (XVSha256Rnds2 XMM1 XMM2)) rest)))))))))))))

;; qround 3 (with the just-in-time schedule step): wk = W_3 + K_3 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
;; The schedule step overwrites XMM6 (holding W_3) with W_7.
(fn shn_q3 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 560)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM6))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVMov XMM7 XMM5))
            (Cons
              (XVec (XVPalignr XMM7 XMM4 4))
              (Cons
                (XVec (XVSha256Msg1 XMM6 XMM3))
                (Cons
