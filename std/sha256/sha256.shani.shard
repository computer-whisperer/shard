          (vbswap (vload mem a6))
          (vbswap (vload mem (+ a6 16)))
          (vbswap (vload mem (+ (+ a6 16) 16)))
          (vbswap (vload mem (+ (+ (+ a6 16) 16) 16)))
          v7
          (MkXmm 66051 67438087 134810123 202182159)
          (vpalignr (vpshufd sA 177) (vpshufd sC 27) 8)
          (vpunpckl (vpshufd sC 27) (vpshufd (vpshufd sA 177) 14))
          (vpshufd (vpshufd sA 177) 14)
          v12
          v13
          v14
          v15)
        mem)))
  (chain
    (have hw1 (= (mod (+ a6 16) 18446744073709551616) (+ a6 16))
      (rewrite-with
        (lemma mod_unique)
        lr
        lhs
        ((inst q 0) (inst r (+ a6 16)))
        ((steps () (by arith (list (list 1) (list 1))))
