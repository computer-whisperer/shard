    (x3_of (shn_g15 g0 g1 g2 g3))))

;; ---- the group-list nonneg fold (the slo device one level up) ---------------------

(fn shn_gso ((xs (List Xmm))) Bool
  (measure (struct xs))
  (match xs
    (Nil True)
    ((Cons h t)
     (if (le 0 (x0_of h))
       (if (le 0 (x1_of h))
         (if (le 0 (x2_of h)) (if (le 0 (x3_of h)) (shn_gso t) False) False)
         False)
       False))))

(claim shn_gso_hd
  (goal ((h Xmm) (t (List Xmm))) ((= (shn_gso (Cons h t)) True))
    (= (shn_xlos h) (list True True True True)))
  (case-on (le 0 (x0_of h)) Bool
    ((case True
       (case-on (le 0 (x1_of h)) Bool
         ((case True
            (case-on (le 0 (x2_of h)) Bool
              ((case True
                 (case-on (le 0 (x3_of h)) Bool
                   ((case True
                      (steps
                        ((compute lhs (stop x0_of x1_of x2_of x3_of))
                         (rewrite (hyp 3) lr lhs true ())
                         (rewrite (hyp 2) lr lhs true ())
                         (rewrite (hyp 1) lr lhs true ())
                         (rewrite (hyp 0) lr lhs true ()))
                        refl))
                    (case False
                      (chain
                        (have hf (= (shn_gso (Cons h t)) False)
                          (steps
                            ((unfold shn_gso lhs)
                             (reduce lhs)
                             (rewrite (hyp 3) lr lhs true ())
                             (rewrite (hyp 2) lr lhs true ())
                             (rewrite (hyp 1) lr lhs true ())
                             (rewrite (hyp 0) lr lhs true ())
                             (reduce lhs))
                            refl))
                        (have hx (= False True)
                          (steps
                            ((rewrite (premise hf) rl lhs true ())
                             (rewrite (premise 0) lr lhs true ()))
                            refl))
                        (absurd (premise hx)))))))
               (case False
                 (chain
                   (have hf (= (shn_gso (Cons h t)) False)
                     (steps
                       ((unfold shn_gso lhs)
                        (reduce lhs)
                        (rewrite (hyp 2) lr lhs true ())
                        (rewrite (hyp 1) lr lhs true ())
                        (rewrite (hyp 0) lr lhs true ())
                        (reduce lhs))
                       refl))
                   (have hx (= False True)
                     (steps
                       ((rewrite (premise hf) rl lhs true ())
                        (rewrite (premise 0) lr lhs true ()))
                       refl))
                   (absurd (premise hx)))))))
          (case False
            (chain
              (have hf (= (shn_gso (Cons h t)) False)
                (steps
                  ((unfold shn_gso lhs)
                   (reduce lhs)
                   (rewrite (hyp 1) lr lhs true ())
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hx (= False True)
                (steps
                  ((rewrite (premise hf) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (absurd (premise hx)))))))
     (case False
       (chain
         (have hf (= (shn_gso (Cons h t)) False)
           (steps
             ((unfold shn_gso lhs)
              (reduce lhs)
              (rewrite (hyp 0) lr lhs true ())
              (reduce lhs))
             refl))
         (have hx (= False True)
           (steps
             ((rewrite (premise hf) rl lhs true ())
              (rewrite (premise 0) lr lhs true ()))
             refl))
         (absurd (premise hx)))))))

(claim shn_gso_tl
  (goal ((h Xmm) (t (List Xmm))) ((= (shn_gso (Cons h t)) True))
    (= (shn_gso t) True))
  (case-on (le 0 (x0_of h)) Bool
    ((case True
       (case-on (le 0 (x1_of h)) Bool
         ((case True
            (case-on (le 0 (x2_of h)) Bool
              ((case True
                 (case-on (le 0 (x3_of h)) Bool
                   ((case True
                      (chain
                        (have hc (= (shn_gso (Cons h t)) (shn_gso t))
                          (steps
                            ((unfold shn_gso lhs)
                             (reduce lhs)
                             (rewrite (hyp 3) lr lhs true ())
                             (rewrite (hyp 2) lr lhs true ())
                             (rewrite (hyp 1) lr lhs true ())
                             (rewrite (hyp 0) lr lhs true ())
                             (reduce lhs))
                            refl))
                        (steps
                          ((rewrite (premise hc) rl lhs true ())
                           (rewrite (premise 0) lr lhs true ())))
                        refl))
                    (case False
                      (chain
                        (have hf (= (shn_gso (Cons h t)) False)
                          (steps
                            ((unfold shn_gso lhs)
                             (reduce lhs)
                             (rewrite (hyp 3) lr lhs true ())
                             (rewrite (hyp 2) lr lhs true ())
                             (rewrite (hyp 1) lr lhs true ())
                             (rewrite (hyp 0) lr lhs true ())
                             (reduce lhs))
                            refl))
                        (have hx (= False True)
                          (steps
                            ((rewrite (premise hf) rl lhs true ())
                             (rewrite (premise 0) lr lhs true ()))
                            refl))
                        (absurd (premise hx)))))))
               (case False
                 (chain
                   (have hf (= (shn_gso (Cons h t)) False)
                     (steps
                       ((unfold shn_gso lhs)
                        (reduce lhs)
                        (rewrite (hyp 2) lr lhs true ())
                        (rewrite (hyp 1) lr lhs true ())
                        (rewrite (hyp 0) lr lhs true ())
                        (reduce lhs))
                       refl))
                   (have hx (= False True)
                     (steps
                       ((rewrite (premise hf) rl lhs true ())
                        (rewrite (premise 0) lr lhs true ()))
                       refl))
                   (absurd (premise hx)))))))
          (case False
            (chain
              (have hf (= (shn_gso (Cons h t)) False)
                (steps
                  ((unfold shn_gso lhs)
                   (reduce lhs)
                   (rewrite (hyp 1) lr lhs true ())
                   (rewrite (hyp 0) lr lhs true ())
                   (reduce lhs))
                  refl))
              (have hx (= False True)
                (steps
                  ((rewrite (premise hf) rl lhs true ())
                   (rewrite (premise 0) lr lhs true ()))
                  refl))
              (absurd (premise hx)))))))
     (case False
       (chain
         (have hf (= (shn_gso (Cons h t)) False)
           (steps
             ((unfold shn_gso lhs)
              (reduce lhs)
              (rewrite (hyp 0) lr lhs true ())
              (reduce lhs))
             refl))
         (have hx (= False True)
           (steps
             ((rewrite (premise hf) rl lhs true ())
              (rewrite (premise 0) lr lhs true ()))
             refl))
         (absurd (premise hx)))))))

(claim shn_gso_cons
  (goal ((h Xmm) (t (List Xmm)))
    ((= (shn_xlos h) (list True True True True)) (= (shn_gso t) True))
    (= (shn_gso (Cons h t)) True))
  (chain
    (have hb0 (= (shn_blnth 0 (shn_xlos h)) (le 0 (x0_of h)))
      (steps ((compute lhs (stop x0_of x1_of x2_of x3_of))) refl))
    (have ht0 (= (shn_blnth 0 (shn_xlos h)) True)
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
    (have hc0 (= (le 0 (x0_of h)) True)
      (steps
        ((rewrite (premise hb0) rl lhs true ())
         (rewrite (premise ht0) lr lhs true ()))
        refl))
    (have hb1 (= (shn_blnth 1 (shn_xlos h)) (le 0 (x1_of h)))
      (steps ((compute lhs (stop x0_of x1_of x2_of x3_of))) refl))
    (have ht1 (= (shn_blnth 1 (shn_xlos h)) True)
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
    (have hc1 (= (le 0 (x1_of h)) True)
      (steps
        ((rewrite (premise hb1) rl lhs true ())
         (rewrite (premise ht1) lr lhs true ()))
        refl))
    (have hb2 (= (shn_blnth 2 (shn_xlos h)) (le 0 (x2_of h)))
      (steps ((compute lhs (stop x0_of x1_of x2_of x3_of))) refl))
    (have ht2 (= (shn_blnth 2 (shn_xlos h)) True)
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
    (have hc2 (= (le 0 (x2_of h)) True)
      (steps
        ((rewrite (premise hb2) rl lhs true ())
         (rewrite (premise ht2) lr lhs true ()))
        refl))
    (have hb3 (= (shn_blnth 3 (shn_xlos h)) (le 0 (x3_of h)))
      (steps ((compute lhs (stop x0_of x1_of x2_of x3_of))) refl))
    (have ht3 (= (shn_blnth 3 (shn_xlos h)) True)
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
    (have hc3 (= (le 0 (x3_of h)) True)
      (steps
        ((rewrite (premise hb3) rl lhs true ())
         (rewrite (premise ht3) lr lhs true ()))
        refl))
    (steps
      ((unfold shn_gso lhs)
       (reduce lhs)
       (rewrite (premise hc0) lr lhs true ())
       (rewrite (premise hc1) lr lhs true ())
       (rewrite (premise hc2) lr lhs true ())
       (rewrite (premise hc3) lr lhs true ())
       (reduce lhs)
       (rewrite (premise 1) lr lhs true ()))
      refl)))

;; ---- the group-list flattener ------------------------------------------------------

(fn shn_gflat ((xs (List Xmm))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil Nil)
    ((Cons h t)
     (Cons
       (x0_of h)
       (Cons (x1_of h) (Cons (x2_of h) (Cons (x3_of h) (shn_gflat t))))))))

;; ---- THE QROUND LAW at a VARIABLE k group ------------------------------------------
;; (the walk's step case cites this with the k group a list head, never a
;; MkXmm literal — the case split lives here, once.)

(claim shn_qround_law_v
  (goal ((st H8) (mg Xmm) (kx Xmm))
    ((= (shn_los st) (list True True True True True True True True))
     (= (shn_xlos mg) (list True True True True))
     (= (shn_xlos kx) (list True True True True)))
    (=
      (shn_qround (MkShnRs (shn_pk_abef st) (shn_pk_cdgh st)) mg kx)
      (MkShnRs
        (shn_pk_abef
          (sha_rounds
            st
            (list (x0_of kx) (x1_of kx) (x2_of kx) (x3_of kx))
            (list (x0_of mg) (x1_of mg) (x2_of mg) (x3_of mg))))
        (shn_pk_cdgh
          (sha_rounds
            st
            (list (x0_of kx) (x1_of kx) (x2_of kx) (x3_of kx))
            (list (x0_of mg) (x1_of mg) (x2_of mg) (x3_of mg)))))))
  (case-on kx Xmm
    ((case MkXmm
       (k0 k1 k2 k3)
       (chain
         (have hb0 (= (shn_blnth 0 (shn_xlos kx)) (le 0 k0))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have ht0 (= (shn_blnth 0 (shn_xlos kx)) True)
           (steps ((rewrite (premise 2) lr lhs true ()) (compute lhs)) refl))
         (have hc0 (= (le 0 k0) True)
           (steps
             ((rewrite (premise hb0) rl lhs true ())
              (rewrite (premise ht0) lr lhs true ()))
             refl))
         (have hb1 (= (shn_blnth 1 (shn_xlos kx)) (le 0 k1))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have ht1 (= (shn_blnth 1 (shn_xlos kx)) True)
           (steps ((rewrite (premise 2) lr lhs true ()) (compute lhs)) refl))
         (have hc1 (= (le 0 k1) True)
           (steps
             ((rewrite (premise hb1) rl lhs true ())
              (rewrite (premise ht1) lr lhs true ()))
             refl))
         (have hb2 (= (shn_blnth 2 (shn_xlos kx)) (le 0 k2))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have ht2 (= (shn_blnth 2 (shn_xlos kx)) True)
           (steps ((rewrite (premise 2) lr lhs true ()) (compute lhs)) refl))
         (have hc2 (= (le 0 k2) True)
           (steps
             ((rewrite (premise hb2) rl lhs true ())
              (rewrite (premise ht2) lr lhs true ()))
             refl))
         (have hb3 (= (shn_blnth 3 (shn_xlos kx)) (le 0 k3))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have ht3 (= (shn_blnth 3 (shn_xlos kx)) True)
           (steps ((rewrite (premise 2) lr lhs true ()) (compute lhs)) refl))
         (have hc3 (= (le 0 k3) True)
           (steps
             ((rewrite (premise hb3) rl lhs true ())
              (rewrite (premise ht3) lr lhs true ()))
             refl))
         (have hk0 (= (x0_of (MkXmm k0 k1 k2 k3)) k0)
           (steps ((unfold x0_of lhs) (reduce lhs)) refl))
         (have hk1 (= (x1_of (MkXmm k0 k1 k2 k3)) k1)
           (steps ((unfold x1_of lhs) (reduce lhs)) refl))
         (have hk2 (= (x2_of (MkXmm k0 k1 k2 k3)) k2)
           (steps ((unfold x2_of lhs) (reduce lhs)) refl))
         (have hk3 (= (x3_of (MkXmm k0 k1 k2 k3)) k3)
           (steps ((unfold x3_of lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (hyp 0) lr both true ())
            (rewrite (premise hk0) lr rhs true ())
            (rewrite (premise hk1) lr rhs true ())
            (rewrite (premise hk2) lr rhs true ())
            (rewrite (premise hk3) lr rhs true ())))
         (rewrite-with
           (lemma shn_qround_law)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)
            (steps ((rewrite (premise 1) lr lhs true ())) refl)
            (steps ((rewrite (premise hc0) lr lhs true ())) refl)
            (steps ((rewrite (premise hc1) lr lhs true ())) refl)
            (steps ((rewrite (premise hc2) lr lhs true ())) refl)
            (steps ((rewrite (premise hc3) lr lhs true ())) refl)))
         refl)))))

;; ---- THE FOLDED WALK ---------------------------------------------------------------
;; The 16-qround nest as ONE fold over group lists, so the walk theorem is
;; ONE induction (sha256.imp.shard's ish_srounds_los pattern one level up)
;; and no proof step ever restates a growing round nest.

(fn shn_qwalk ((rs ShnRs) (kgs (List Xmm)) (gs (List Xmm))) ShnRs
  (measure (struct kgs))
  (match kgs
    (Nil rs)
    ((Cons kg kt)
     (match gs
       (Nil rs)
       ((Cons g gt) (shn_qwalk (shn_qround rs g kg) kt gt))))))

(claim shn_qwalk_s
  (goal ((rs ShnRs) (kg Xmm) (kt (List Xmm)) (g Xmm) (gt (List Xmm))) ()
    (=
      (shn_qwalk rs (Cons kg kt) (Cons g gt))
      (shn_qwalk (shn_qround rs g kg) kt gt)))
  (steps ((unfold shn_qwalk lhs) (reduce lhs)) refl))

;; ---- THE WALK THEOREM --------------------------------------------------------------
;; The packed walk IS the flat sha_rounds tower: one induction over the k
;; groups, the qround law as the step, the los invariant threaded through.

(claim shn_qwalk_thm
  (goal ((st H8) (kgs (List Xmm)) (gs (List Xmm)))
    ((= (shn_los st) (list True True True True True True True True))
     (= (shn_gso kgs) True)
     (= (shn_gso gs) True))
    (=
      (shn_qwalk (MkShnRs (shn_pk_abef st) (shn_pk_cdgh st)) kgs gs)
      (MkShnRs
        (shn_pk_abef (sha_rounds st (shn_gflat kgs) (shn_gflat gs)))
        (shn_pk_cdgh (sha_rounds st (shn_gflat kgs) (shn_gflat gs))))))
  (induct kgs
    ((case Nil (steps ((compute both (stop shn_pk_abef shn_pk_cdgh))) refl))
     (case Cons
       (kg kt)
       (case-on gs List
         ((case Nil
            (chain
              (steps
                ((rewrite (hyp 0) lr both true ())
                 (compute
                   both
                   (stop shn_qround shn_pk_abef shn_pk_cdgh x0_of x1_of x2_of
                     x3_of))))
              refl))
          (case Cons
            (g gt)
            (chain
              (have hkx (= (shn_xlos kg) (list True True True True))
                (rewrite-with
                  (lemma shn_gso_hd)
                  lr
                  lhs
                  ((inst t kt))
                  ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (have hkt (= (shn_gso kt) True)
                (rewrite-with
                  (lemma shn_gso_tl)
                  lr
                  lhs
                  ((inst h kg))
                  ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (have hgx (= (shn_xlos g) (list True True True True))
                (rewrite-with
                  (lemma shn_gso_hd)
                  lr
                  lhs
                  ((inst t gt))
                  ((steps
                     ((rewrite (hyp 0) rl lhs true ())
                      (rewrite (premise 2) lr lhs true ()))
                     refl))
                  refl))
              (have hgt (= (shn_gso gt) True)
                (rewrite-with
                  (lemma shn_gso_tl)
                  lr
                  lhs
                  ((inst h g))
                  ((steps
                     ((rewrite (hyp 0) rl lhs true ())
                      (rewrite (premise 2) lr lhs true ()))
                     refl))
                  refl))
              (have hks
                (=
                  (shn_slo (list (x0_of kg) (x1_of kg) (x2_of kg) (x3_of kg)))
                  True)
                (rewrite-with
                  (lemma shn_slo4)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hkx) lr lhs true ())) refl))
                  refl))
              (have hws
                (=
                  (shn_slo (list (x0_of g) (x1_of g) (x2_of g) (x3_of g)))
                  True)
                (rewrite-with
                  (lemma shn_slo4)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise hgx) lr lhs true ())) refl))
                  refl))
              (have hst4
                (=
                  (shn_los
                    (sha_rounds
                      st
                      (list (x0_of kg) (x1_of kg) (x2_of kg) (x3_of kg))
                      (list (x0_of g) (x1_of g) (x2_of g) (x3_of g))))
                  (list True True True True True True True True))
                (rewrite-with
                  (lemma shn_los_rounds)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise hks) lr lhs true ())) refl)
                   (steps ((rewrite (premise hws) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (hyp 0) lr both true ())
                 (rewrite (lemma shn_qwalk_s) lr lhs true ())))
              (rewrite-with
                (lemma shn_qround_law_v)
                lr
                lhs
                ()
                ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                 (steps ((rewrite (premise hgx) lr lhs true ())) refl)
                 (steps ((rewrite (premise hkx) lr lhs true ())) refl)))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hst4) lr lhs true ())) refl)
                 (steps ((rewrite (premise hkt) lr lhs true ())) refl)
                 (steps ((rewrite (premise hgt) lr lhs true ())) refl)))
              (steps
                ((compute
                   both
                   (stop sha_round x0_of x1_of x2_of x3_of shn_pk_abef
                     shn_pk_cdgh))))
              refl))))))))

;; ---- the ground k side -------------------------------------------------------------

(claim shn_kso
  (goal () ()
    (=
      (shn_gso
        (list
          (shn_kg 0)
          (shn_kg 1)
          (shn_kg 2)
          (shn_kg 3)
          (shn_kg 4)
          (shn_kg 5)
          (shn_kg 6)
          (shn_kg 7)
          (shn_kg 8)
          (shn_kg 9)
          (shn_kg 10)
          (shn_kg 11)
          (shn_kg 12)
          (shn_kg 13)
          (shn_kg 14)
          (shn_kg 15)))
      True))
  (steps ((compute lhs)) refl))

(claim shn_kflat
  (goal () ()
    (=
      (shn_gflat
        (list
          (shn_kg 0)
          (shn_kg 1)
          (shn_kg 2)
          (shn_kg 3)
          (shn_kg 4)
          (shn_kg 5)
          (shn_kg 6)
          (shn_kg 7)
          (shn_kg 8)
          (shn_kg 9)
          (shn_kg 10)
          (shn_kg 11)
          (shn_kg 12)
          (shn_kg 13)
          (shn_kg 14)
          (shn_kg 15)))
      (sha_k)))
  (steps ((compute both)) refl))

;; ---- the group-list flat IS w64 ----------------------------------------------------

(claim shn_w64_is_flat
  (goal ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) ()
    (=
      (shn_gflat
        (list
          g0
          g1
          g2
          g3
          (shn_g4 g0 g1 g2 g3)
          (shn_g5 g0 g1 g2 g3)
          (shn_g6 g0 g1 g2 g3)
          (shn_g7 g0 g1 g2 g3)
          (shn_g8 g0 g1 g2 g3)
          (shn_g9 g0 g1 g2 g3)
          (shn_g10 g0 g1 g2 g3)
          (shn_g11 g0 g1 g2 g3)
          (shn_g12 g0 g1 g2 g3)
          (shn_g13 g0 g1 g2 g3)
          (shn_g14 g0 g1 g2 g3)
          (shn_g15 g0 g1 g2 g3)))
      (shn_w64 g0 g1 g2 g3)))
  (steps
    ((compute
       both
       (stop x0_of x1_of x2_of x3_of shn_g4 shn_g5 shn_g6 shn_g7 shn_g8 shn_g9
         shn_g10 shn_g11 shn_g12 shn_g13 shn_g14 shn_g15)))
    refl))

;; ---- THE WORD-GRAIN BLOCK THEOREM -------------------------------------------------
;; shn_block IS h8_add of the 64-round walk over the schedule-word
;; projections: bridge the 16-qround nest to the folded walk by compute
;; (everything stopped), cite THE WALK THEOREM once, collapse the ground k
;; side to sha_k, and close with the feedback law. The sixteen group
;; invariants ride the gso fold, built by cons from the four inputs via
;; xlos_sstep.

(claim shn_blockw
  (goal ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm))
    ((= (shn_los st) (list True True True True True True True True))
     (= (shn_xlos g0) (list True True True True))
     (= (shn_xlos g1) (list True True True True))
     (= (shn_xlos g2) (list True True True True))
     (= (shn_xlos g3) (list True True True True)))
    (=
      (shn_block st g0 g1 g2 g3)
      (h8_add st (sha_rounds st (sha_k) (shn_w64 g0 g1 g2 g3)))))
  (chain
    (have hx4 (= (shn_xlos (shn_g4 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g4_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 1) lr lhs true ())) refl)
           (steps ((rewrite (premise 2) lr lhs true ())) refl)
           (steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((rewrite (premise 4) lr lhs true ())) refl)))
        refl))
    (have hx5 (= (shn_xlos (shn_g5 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g5_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 2) lr lhs true ())) refl)
           (steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((rewrite (premise 4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx4) lr lhs true ())) refl)))
        refl))
    (have hx6 (= (shn_xlos (shn_g6 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g6_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((rewrite (premise 4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx5) lr lhs true ())) refl)))
        refl))
    (have hx7 (= (shn_xlos (shn_g7 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g7_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx5) lr lhs true ())) refl)
           (steps ((rewrite (premise hx6) lr lhs true ())) refl)))
        refl))
    (have hx8 (= (shn_xlos (shn_g8 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g8_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx4) lr lhs true ())) refl)
           (steps ((rewrite (premise hx5) lr lhs true ())) refl)
           (steps ((rewrite (premise hx6) lr lhs true ())) refl)
           (steps ((rewrite (premise hx7) lr lhs true ())) refl)))
        refl))
    (have hx9 (= (shn_xlos (shn_g9 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g9_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx5) lr lhs true ())) refl)
           (steps ((rewrite (premise hx6) lr lhs true ())) refl)
           (steps ((rewrite (premise hx7) lr lhs true ())) refl)
           (steps ((rewrite (premise hx8) lr lhs true ())) refl)))
        refl))
    (have hx10 (= (shn_xlos (shn_g10 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g10_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx6) lr lhs true ())) refl)
           (steps ((rewrite (premise hx7) lr lhs true ())) refl)
           (steps ((rewrite (premise hx8) lr lhs true ())) refl)
           (steps ((rewrite (premise hx9) lr lhs true ())) refl)))
        refl))
    (have hx11 (= (shn_xlos (shn_g11 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g11_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx7) lr lhs true ())) refl)
           (steps ((rewrite (premise hx8) lr lhs true ())) refl)
           (steps ((rewrite (premise hx9) lr lhs true ())) refl)
           (steps ((rewrite (premise hx10) lr lhs true ())) refl)))
        refl))
    (have hx12 (= (shn_xlos (shn_g12 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g12_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx8) lr lhs true ())) refl)
           (steps ((rewrite (premise hx9) lr lhs true ())) refl)
           (steps ((rewrite (premise hx10) lr lhs true ())) refl)
           (steps ((rewrite (premise hx11) lr lhs true ())) refl)))
        refl))
    (have hx13 (= (shn_xlos (shn_g13 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g13_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx9) lr lhs true ())) refl)
           (steps ((rewrite (premise hx10) lr lhs true ())) refl)
           (steps ((rewrite (premise hx11) lr lhs true ())) refl)
           (steps ((rewrite (premise hx12) lr lhs true ())) refl)))
        refl))
    (have hx14 (= (shn_xlos (shn_g14 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g14_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx10) lr lhs true ())) refl)
           (steps ((rewrite (premise hx11) lr lhs true ())) refl)
           (steps ((rewrite (premise hx12) lr lhs true ())) refl)
           (steps ((rewrite (premise hx13) lr lhs true ())) refl)))
        refl))
    (have hx15 (= (shn_xlos (shn_g15 g0 g1 g2 g3)) (list True True True True))
      (chain
        (steps ((rewrite (lemma shn_g15_def) lr lhs true ())))
        (rewrite-with
          (lemma shn_xlos_sstep)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hx11) lr lhs true ())) refl)
           (steps ((rewrite (premise hx12) lr lhs true ())) refl)
           (steps ((rewrite (premise hx13) lr lhs true ())) refl)
           (steps ((rewrite (premise hx14) lr lhs true ())) refl)))
        refl))
    (have s15 (= (shn_gso (list (shn_g15 g0 g1 g2 g3))) True)
      (rewrite-with
        (lemma shn_gso_cons)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hx15) lr lhs true ())) refl)
         (steps ((compute lhs)) refl))
        refl))
    (have s14
      (= (shn_gso (list (shn_g14 g0 g1 g2 g3) (shn_g15 g0 g1 g2 g3))) True)
      (rewrite-with
        (lemma shn_gso_cons)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hx14) lr lhs true ())) refl)
         (steps ((rewrite (premise s15) lr lhs true ())) refl))
        refl))
    (have s13
      (=
        (shn_gso
          (list
            (shn_g13 g0 g1 g2 g3)
            (shn_g14 g0 g1 g2 g3)
            (shn_g15 g0 g1 g2 g3)))
        True)
      (rewrite-with
        (lemma shn_gso_cons)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hx13) lr lhs true ())) refl)
         (steps ((rewrite (premise s14) lr lhs true ())) refl))
        refl))
    (have s12
      (=
