;; qround 15 (schedule-free (the last four)): wk = W_15 + K_15 in XMM0, two rnds2 issues
;; around a pshufd of wk's high half.
(fn shn_q15 ((rest (List XInstr))) (List XInstr)
  (Cons
    (XMovRI R11 752)
    (Cons
      (XVec (XVLoad XMM11 (AReg R11)))
      (Cons
        (XVec (XVMov XMM0 XMM6))
        (Cons
          (XVec (XVPaddd XMM0 XMM11))
          (Cons
            (XVec (XVSha256Rnds2 XMM2 XMM1))
            (Cons
              (XVec (XVPshufd XMM0 XMM0 14))
              (Cons (XVec (XVSha256Rnds2 XMM1 XMM2)) rest))))))))

;; the epilogue: paddd feedback against the saved entry state, the unpack
;; shuffles, and the two stores back to the state home.
(fn shn_epi ((rest (List XInstr))) (List XInstr)
  (Cons
    (XVec (XVPaddd XMM1 XMM9))
    (Cons
      (XVec (XVPaddd XMM2 XMM10))
      (Cons
        (XVec (XVPshufd XMM1 XMM1 27))
        (Cons
          (XVec (XVPshufd XMM2 XMM2 27))
          (Cons
            (XVec (XVMov XMM11 XMM1))
            (Cons
              (XVec (XVPunpckL XMM1 XMM2))
              (Cons
                (XVec (XVPunpckH XMM11 XMM2))
                (Cons
                  (XMovRI R10 768)
                  (Cons
                    (XVec (XVStore (AReg R10) XMM1))
                    (Cons
                      (XMovRI R10 784)
                      (Cons (XVec (XVStore (AReg R10) XMM11)) rest))))))))))))

;; the whole body: the stanzas composed, each Cons'ing onto the next.
(fn shn_body () (List XInstr)
  (shn_pro
    (shn_q0
      (shn_q1
        (shn_q2
          (shn_q3
            (shn_q4
              (shn_q5
                (shn_q6
                  (shn_q7
                    (shn_q8
                      (shn_q9
                        (shn_q10
                          (shn_q11
                            (shn_q12
                              (shn_q13 (shn_q14 (shn_q15 (shn_epi Nil)))))))))))))))))))

;; the one-function module: the body at index 0, window [0,65536).
(fn shn_m () XModule (MkXModule (Cons (MkXFunc 0 (shn_body)) Nil) 0 65536))

;; the state home: linear dword layout, a..d at 768, e..h at 784.
(fn shn_hmem ((m Mem) (st H8)) Mem
  (vstore
    (vstore m 768 (MkXmm (shn_ha st) (shn_hb st) (shn_hc st) (shn_hd st)))
    784
    (MkXmm (shn_he st) (shn_hf st) (shn_hg st) (shn_hh st))))

;; ---- THE STANZA LAWS ---------------------------------------------------------------
;;
;; One law per qround stanza: its twelve (or seven) instructions walked at a
;; FREE fuel tail and a FREE instruction tail, so the laws chain by rewriting
;; without ever running the walk past the stanza's end. Everything a stanza
;; produces stays FOLDED behind the article's own functions -- shn_qround's
;; two projections and shn_sstep -- which is the whole point: letting those
;; trees expand is the measured tetranacci blow-up (a symbolic shn_block
;; compute core-dumps at ~168 s).
;;
;; Both records are spelled OPEN (MkRegs / MkXmms over variables): an abstract
;; record leaves every read a stuck projection, and the address gates then
;; never resolve.

;; qround 0: the schedule step folds to shn_sstep; the round state folds to shn_qround's two projections.
(claim shn_law_q0
  (goal
    ((f Nat)
     (rest (List XInstr))
     (mem Mem)
     (a0 Int)
     (a1 Int)
     (a2 Int)
     (a3 Int)
     (a4 Int)
     (a5 Int)
     (a6 Int)
     (a7 Int)
     (a8 Int)
     (a9 Int)
     (a10 Int)
     (a11 Int)
     (a12 Int)
     (a13 Int)
     (a14 Int)
     (v0 Xmm)
     (v1 Xmm)
     (v2 Xmm)
     (v3 Xmm)
     (v4 Xmm)
     (v5 Xmm)
     (v6 Xmm)
     (v7 Xmm)
     (v8 Xmm)
     (v9 Xmm)
     (v10 Xmm)
     (v11 Xmm)
     (v12 Xmm)
     (v13 Xmm)
     (v14 Xmm)
     (v15 Xmm))
    ()
    (=
      (xveval_seq
        (S (S (S (S (S (S (S (S (S (S (S (S (S f)))))))))))))
        (shn_m)
        (shn_q0 rest)
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)
      (xveval_seq
        (S f)
        (shn_m)
        rest
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 512 a11 a12 a13 a14)
        (MkXmms
          (vpshufd (vpaddd v3 (vload mem 512)) 14)
          (rabef_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 512)))
          (rcdgh_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 512)))
          (shn_sstep v3 v4 v5 v6)
          v4
          v5
          v6
          (vpalignr v6 v5 4)
          v8
          v9
          v10
          (vload mem 512)
          v12
          v13
          v14
          v15)
        mem)))
  (steps
    ((compute lhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2))
     (compute rhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2)))
    refl))

