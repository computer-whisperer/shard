;; ---- range ladder, rung 2: the ground-shift rotate is nonneg ----------------------
;; Exemplar at k=2 (shr 2 / shl 30); the other rotate widths template
;; from this shape.

(claim shn_rotr2_lo
  (goal ((x Int)) ((= (le 0 x) True)) (= (le 0 (vrotr32 x 2)) True))
  (chain
    (have hm (= (le 0 (vm32 x)) True)
      (rewrite-with
        (lemma shn_vm32_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (steps ((unfold vrotr32 lhs) (compute lhs (stop vm32 bshr bshl bor))))
    (have hs (= (bshr (vm32 x) 2) (ediv (vm32 x) 4))
      (chain
        (rewrite-with
          (lemma shr_pow2)
          lr
          lhs
          ((inst k 2))
          ((steps ((rewrite (premise hm) lr lhs true ())) refl)
           (steps ((compute lhs)) refl)))
        (steps ((rewrite (lemma shn_pw2) lr lhs true ())))
        refl))
    (have hl (= (bshl (vm32 x) 30) (* (vm32 x) 1073741824))
      (chain
        (rewrite-with
          (lemma shl_pow2)
          lr
          lhs
          ((inst k 30))
          ((steps ((rewrite (premise hm) lr lhs true ())) refl)
           (steps ((compute lhs)) refl)))
        (steps ((rewrite (lemma shn_pw30) lr lhs true ())))
        refl))
    (have hid (= (vm32 x) (+ (* 4 (ediv (vm32 x) 4)) (mod (vm32 x) 4)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst d 4))
        ((steps ((compute lhs)) refl))
        refl))
    (have hmh (= (lt (mod (vm32 x) 4) 4) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hdlo (= (le 0 (ediv (vm32 x) 4)) True)
      (steps () (by arith (list 4 0 1 0 0 -1 1))))
    (have hslo (= (le 0 (* (vm32 x) 1073741824)) True)
      (steps () (by arith (list 1 0 1073741824 0 0 0 0))))
    (steps
      ((rewrite (premise hs) lr lhs true ())
       (rewrite (premise hl) lr lhs true ())))
    (have hor (= (le 0 (bor (ediv (vm32 x) 4) (* (vm32 x) 1073741824))) True)
      (rewrite-with
        (lemma bor_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hdlo) lr lhs true ())) refl)
         (steps ((rewrite (premise hslo) lr lhs true ())) refl))
        refl))
    (rewrite-with
      (lemma shn_vm32_mod)
      lr
      lhs
      ((inst x (bor (ediv (vm32 x) 4) (* (vm32 x) 1073741824))))
      ((steps ((rewrite (premise hor) lr lhs true ())) refl)))
    (rewrite-with (lemma mod_lo) lr lhs () ((steps ((compute lhs)) refl)))
    refl))

