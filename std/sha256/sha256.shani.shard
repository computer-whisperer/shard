     (= (le (+ a6 64) 65536) True))
    (=
      (xveval_seq
        (S
          (S
            (S
              (S
                (S
                  (S
                    (S
                      (S
                        (S
                          (S
                            (S
                              (S
                                (S
                                  (S
                                    (S
                                      (S (S (S (S (S (S (S (S (S (S f)))))))))))))))))))))))))
        (shn_m)
        (shn_pro rest)
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)
      (xveval_seq
        (S f)
        (shn_m)
        rest
        (MkRegs
          a0
          a1
          a2
          a3
          a4
          a5
          (+ (+ (+ a6 16) 16) 16)
          a7
          a8
          784
          a10
