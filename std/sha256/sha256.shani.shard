(claim shn_los_h
  (goal ((r H8))
    ((= (shn_los r) (list True True True True True True True True)))
    (= (le 0 (shn_hh r)) True))
  (case-on r H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (chain
         (have hb (= (shn_blnth 7 (shn_los r)) (le 0 (shn_hh r)))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute both))
             refl))
         (have ht (= (shn_blnth 7 (shn_los r)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (steps
           ((rewrite (premise hb) rl lhs true ())
            (rewrite (premise ht) lr lhs true ())))
         refl)))))

;; ---- the rounds step equation (at variable state) ---------------------------------

(claim shn_rounds_s
  (goal ((st H8) (k Int) (w Int) (kt (List Int)) (wt (List Int))) ()
    (=
      (sha_rounds st (Cons k kt) (Cons w wt))
      (sha_rounds (sha_round st k w) kt wt)))
  (steps ((unfold sha_rounds lhs) (reduce lhs)) refl))

;; ---- the slide law at variable state ----------------------------------------------

(claim shn_slide_v
  (goal ((st H8) (k0 Int) (w0 Int) (k1 Int) (w1 Int)) ()
    (= (shn_pk_cdgh (sha_round (sha_round st k0 w0) k1 w1)) (shn_pk_abef st)))
  (case-on st H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (chain
         (steps
           ((rewrite (hyp 0) lr lhs true ()) (rewrite (hyp 0) lr rhs true ())))
         (rewrite-with (lemma shn_slide) lr lhs () ())
         refl)))))

;; ---- one round preserves the los invariant ----------------------------------------

(claim shn_los_round
  (goal ((st H8) (k Int) (w Int))
    ((= (shn_los st) (list True True True True True True True True))
     (= (le 0 k) True)
     (= (le 0 w) True))
    (=
      (shn_los (sha_round st k w))
      (list True True True True True True True True)))
  (case-on st H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (chain
         (have hba (= (shn_blnth 0 (shn_los st)) (le 0 xa))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hta (= (shn_blnth 0 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hca (= (le 0 xa) True)
           (steps
             ((rewrite (premise hba) rl lhs true ())
              (rewrite (premise hta) lr lhs true ()))
             refl))
         (have hbb (= (shn_blnth 1 (shn_los st)) (le 0 xb))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have htb (= (shn_blnth 1 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hcb (= (le 0 xb) True)
           (steps
             ((rewrite (premise hbb) rl lhs true ())
              (rewrite (premise htb) lr lhs true ()))
             refl))
         (have hbc (= (shn_blnth 2 (shn_los st)) (le 0 xc))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have htc (= (shn_blnth 2 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hcc (= (le 0 xc) True)
           (steps
             ((rewrite (premise hbc) rl lhs true ())
              (rewrite (premise htc) lr lhs true ()))
             refl))
         (have hbd (= (shn_blnth 3 (shn_los st)) (le 0 xd))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have htd (= (shn_blnth 3 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hcd (= (le 0 xd) True)
           (steps
             ((rewrite (premise hbd) rl lhs true ())
              (rewrite (premise htd) lr lhs true ()))
             refl))
         (have hbe (= (shn_blnth 4 (shn_los st)) (le 0 xe))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hte (= (shn_blnth 4 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hce (= (le 0 xe) True)
           (steps
             ((rewrite (premise hbe) rl lhs true ())
              (rewrite (premise hte) lr lhs true ()))
             refl))
         (have hbf (= (shn_blnth 5 (shn_los st)) (le 0 xf))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have htf (= (shn_blnth 5 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hcf (= (le 0 xf) True)
           (steps
             ((rewrite (premise hbf) rl lhs true ())
              (rewrite (premise htf) lr lhs true ()))
             refl))
         (have hbg (= (shn_blnth 6 (shn_los st)) (le 0 xg))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have htg (= (shn_blnth 6 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hcg (= (le 0 xg) True)
           (steps
             ((rewrite (premise hbg) rl lhs true ())
              (rewrite (premise htg) lr lhs true ()))
             refl))
         (have hbh (= (shn_blnth 7 (shn_los st)) (le 0 xh))
           (steps ((rewrite (hyp 0) lr lhs true ()) (compute lhs)) refl))
         (have hth (= (shn_blnth 7 (shn_los st)) True)
           (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))
         (have hch (= (le 0 xh) True)
           (steps
             ((rewrite (premise hbh) rl lhs true ())
              (rewrite (premise hth) lr lhs true ()))
             refl))
         (have hkw (= (le 0 (+ k w)) True) (steps () (by arith (list 1 0 1 1))))
         (have hvkw (= (le 0 (vm32 (+ k w))) True)
           (rewrite-with
             (lemma shn_vm32_lo)
             lr
             lhs
             ((inst x (+ k w)))
             ((steps ((rewrite (premise hkw) lr lhs true ())) refl))
             refl))
         (steps ((rewrite (hyp 0) lr lhs true ())))
         (rewrite-with
           (lemma shn_round)
           lr
           lhs
           ()
           ((steps ((rewrite (premise hca) lr lhs true ())) refl)
            (steps ((rewrite (premise hcb) lr lhs true ())) refl)
            (steps ((rewrite (premise hcc) lr lhs true ())) refl)
            (steps ((rewrite (premise hcd) lr lhs true ())) refl)
            (steps ((rewrite (premise hce) lr lhs true ())) refl)
            (steps ((rewrite (premise hcf) lr lhs true ())) refl)
            (steps ((rewrite (premise hcg) lr lhs true ())) refl)
            (steps ((rewrite (premise hch) lr lhs true ())) refl)
            (steps ((rewrite (premise 1) lr lhs true ())) refl)
            (steps ((rewrite (premise 2) lr lhs true ())) refl)))
         (steps ((compute lhs (stop vrnd_a vrnd_e vm32))))
         (rewrite-with
           (lemma shn_rnd_a_lo)
           lr
           lhs
           ()
           ((steps ((rewrite (premise hca) lr lhs true ())) refl)
            (steps ((rewrite (premise hcb) lr lhs true ())) refl)
            (steps ((rewrite (premise hcc) lr lhs true ())) refl)
            (steps ((rewrite (premise hce) lr lhs true ())) refl)
            (steps ((rewrite (premise hcf) lr lhs true ())) refl)
            (steps ((rewrite (premise hcg) lr lhs true ())) refl)
            (steps ((rewrite (premise hch) lr lhs true ())) refl)
            (steps ((rewrite (premise hvkw) lr lhs true ())) refl)))
         (rewrite-with
           (lemma shn_rnd_e_lo)
           lr
           lhs
           ()
           ((steps ((rewrite (premise hcd) lr lhs true ())) refl)
            (steps ((rewrite (premise hce) lr lhs true ())) refl)
            (steps ((rewrite (premise hcf) lr lhs true ())) refl)
            (steps ((rewrite (premise hcg) lr lhs true ())) refl)
            (steps ((rewrite (premise hch) lr lhs true ())) refl)
            (steps ((rewrite (premise hvkw) lr lhs true ())) refl)))
         (steps
           ((rewrite (premise hca) lr lhs true ())
            (rewrite (premise hcb) lr lhs true ())
            (rewrite (premise hcc) lr lhs true ())
            (rewrite (premise hce) lr lhs true ())
            (rewrite (premise hcf) lr lhs true ())
            (rewrite (premise hcg) lr lhs true ())))
         refl)))))

;; ---- the rounds walk preserves the los invariant ----------------------------------

(claim shn_los_rounds
  (goal ((st H8) (ks (List Int)) (ws (List Int)))
    ((= (shn_los st) (list True True True True True True True True))
     (= (shn_slo ks) True)
     (= (shn_slo ws) True))
    (=
      (shn_los (sha_rounds st ks ws))
      (list True True True True True True True True)))
  (induct ks
    ((case Nil
       (chain
         (steps ((unfold sha_rounds lhs) (reduce lhs)))
         (steps ((rewrite (premise 0) lr lhs true ())))
         refl))
     (case Cons
       (kw kt)
       (case-on ws List
         ((case Nil
            (chain
              (steps
                ((rewrite (hyp 0) lr lhs true ())
                 (unfold sha_rounds lhs)
                 (reduce lhs)))
              (steps ((rewrite (premise 0) lr lhs true ())))
              refl))
          (case Cons
            (ww wt)
            (chain
              (have hkw (= (le 0 kw) True)
                (rewrite-with
                  (lemma shn_slo_hd)
                  lr
                  lhs
                  ((inst t kt))
                  ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (have hkt (= (shn_slo kt) True)
                (rewrite-with
                  (lemma shn_slo_tl)
                  lr
                  lhs
                  ((inst h kw))
                  ((steps ((rewrite (premise 1) lr lhs true ())) refl))
                  refl))
              (have hww (= (le 0 ww) True)
                (rewrite-with
                  (lemma shn_slo_hd)
                  lr
                  lhs
                  ((inst t wt))
                  ((steps
                     ((rewrite (hyp 0) rl lhs true ())
                      (rewrite (premise 2) lr lhs true ()))
                     refl))
                  refl))
              (have hwt (= (shn_slo wt) True)
                (rewrite-with
                  (lemma shn_slo_tl)
                  lr
                  lhs
                  ((inst h ww))
                  ((steps
                     ((rewrite (hyp 0) rl lhs true ())
                      (rewrite (premise 2) lr lhs true ()))
                     refl))
                  refl))
              (have hst
                (=
                  (shn_los (sha_round st kw ww))
                  (list True True True True True True True True))
                (rewrite-with
                  (lemma shn_los_round)
                  lr
                  lhs
                  ()
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl)
                   (steps ((rewrite (premise hkw) lr lhs true ())) refl)
                   (steps ((rewrite (premise hww) lr lhs true ())) refl))
                  refl))
              (steps
                ((rewrite (hyp 0) lr lhs true ())
                 (rewrite (lemma shn_rounds_s) lr lhs true ())))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ()
                ((steps ((rewrite (premise hst) lr lhs true ())) refl)
                 (steps ((rewrite (premise hkt) lr lhs true ())) refl)
                 (steps ((rewrite (premise hwt) lr lhs true ())) refl)))
              refl))))))))

;; ---- the schedule step preserves lane nonnegativity -------------------------------

(claim shn_xlos_sstep
  (goal ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm))
    ((= (shn_xlos g0) (list True True True True))
     (= (shn_xlos g1) (list True True True True))
     (= (shn_xlos g2) (list True True True True))
     (= (shn_xlos g3) (list True True True True)))
    (= (shn_xlos (shn_sstep g0 g1 g2 g3)) (list True True True True)))
  (case-on g0 Xmm
    ((case MkXmm
       (w0 w1 w2 w3)
