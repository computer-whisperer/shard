;; ---- range ladder, rung 3: the sha helpers are nonneg -----------------------------

(claim shn_ch_lo
  (goal ((x Int) (y Int) (z Int))
    ((= (le 0 x) True) (= (le 0 y) True) (= (le 0 z) True))
    (= (le 0 (vch x y z)) True))
  (chain
    (have h1 (= (le 0 (band x y)) True)
      (rewrite-with
        (lemma band_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl))
        refl))
    (have h2 (= (le 0 (bxor x 4294967295)) True)
      (rewrite-with
        (lemma bxor_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((compute lhs)) refl))
        refl))
    (have h3 (= (le 0 (band (bxor x 4294967295) z)) True)
      (rewrite-with
        (lemma band_lo)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h2) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (steps ((unfold vch lhs)))
    (rewrite-with
      (lemma bxor_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise h1) lr lhs true ())) refl)
       (steps ((rewrite (premise h3) lr lhs true ())) refl)))
    refl))

