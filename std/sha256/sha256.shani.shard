;; ---- the 64 schedule words, spelled at folded projections -------------------------

(fn shn_w64 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) (List Int)
  (list
    (x0_of g0)
    (x1_of g0)
    (x2_of g0)
    (x3_of g0)
    (x0_of g1)
    (x1_of g1)
    (x2_of g1)
    (x3_of g1)
    (x0_of g2)
    (x1_of g2)
    (x2_of g2)
    (x3_of g2)
    (x0_of g3)
    (x1_of g3)
    (x2_of g3)
    (x3_of g3)
    (x0_of (shn_g4 g0 g1 g2 g3))
    (x1_of (shn_g4 g0 g1 g2 g3))
    (x2_of (shn_g4 g0 g1 g2 g3))
    (x3_of (shn_g4 g0 g1 g2 g3))
    (x0_of (shn_g5 g0 g1 g2 g3))
    (x1_of (shn_g5 g0 g1 g2 g3))
    (x2_of (shn_g5 g0 g1 g2 g3))
    (x3_of (shn_g5 g0 g1 g2 g3))
    (x0_of (shn_g6 g0 g1 g2 g3))
    (x1_of (shn_g6 g0 g1 g2 g3))
    (x2_of (shn_g6 g0 g1 g2 g3))
    (x3_of (shn_g6 g0 g1 g2 g3))
    (x0_of (shn_g7 g0 g1 g2 g3))
    (x1_of (shn_g7 g0 g1 g2 g3))
    (x2_of (shn_g7 g0 g1 g2 g3))
    (x3_of (shn_g7 g0 g1 g2 g3))
    (x0_of (shn_g8 g0 g1 g2 g3))
    (x1_of (shn_g8 g0 g1 g2 g3))
    (x2_of (shn_g8 g0 g1 g2 g3))
    (x3_of (shn_g8 g0 g1 g2 g3))
    (x0_of (shn_g9 g0 g1 g2 g3))
    (x1_of (shn_g9 g0 g1 g2 g3))
    (x2_of (shn_g9 g0 g1 g2 g3))
    (x3_of (shn_g9 g0 g1 g2 g3))
    (x0_of (shn_g10 g0 g1 g2 g3))
    (x1_of (shn_g10 g0 g1 g2 g3))
    (x2_of (shn_g10 g0 g1 g2 g3))
    (x3_of (shn_g10 g0 g1 g2 g3))
    (x0_of (shn_g11 g0 g1 g2 g3))
    (x1_of (shn_g11 g0 g1 g2 g3))
    (x2_of (shn_g11 g0 g1 g2 g3))
    (x3_of (shn_g11 g0 g1 g2 g3))
    (x0_of (shn_g12 g0 g1 g2 g3))
    (x1_of (shn_g12 g0 g1 g2 g3))
    (x2_of (shn_g12 g0 g1 g2 g3))
    (x3_of (shn_g12 g0 g1 g2 g3))
    (x0_of (shn_g13 g0 g1 g2 g3))
    (x1_of (shn_g13 g0 g1 g2 g3))
    (x2_of (shn_g13 g0 g1 g2 g3))
    (x3_of (shn_g13 g0 g1 g2 g3))
