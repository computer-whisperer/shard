    (x2_of (shn_g14 g0 g1 g2 g3))
    (x3_of (shn_g14 g0 g1 g2 g3))
    (x0_of (shn_g15 g0 g1 g2 g3))
    (x1_of (shn_g15 g0 g1 g2 g3))
