       (compute lhs (stop vload vbswap vpshufd vpalignr vpunpckl))
       (rewrite (premise hg5) lr lhs true ())
       (compute lhs (stop vload vbswap vpshufd vpalignr vpunpckl))
       (rewrite (premise hw3) lr lhs true ())
       (rewrite (premise hg6) lr lhs true ())
       (compute lhs (stop vload vbswap vpshufd vpalignr vpunpckl))
