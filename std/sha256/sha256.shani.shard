            (rewrite (premise ht) lr lhs true ())))
         refl)))))

(claim shn_los_g
  (goal ((r H8))
    ((= (shn_los r) (list True True True True True True True True)))
    (= (le 0 (shn_hg r)) True))
  (case-on r H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (chain
         (have hb (= (shn_blnth 6 (shn_los r)) (le 0 (shn_hg r)))
           (steps
             ((rewrite (hyp 0) lr lhs true ())
              (rewrite (hyp 0) lr rhs true ())
              (compute both))
             refl))
         (have ht (= (shn_blnth 6 (shn_los r)) True)
