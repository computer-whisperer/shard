;;; std/sha256/sha256.shani.shard -- THE SHA-NI BLOCK ARTICLE (Arc B rung
;;; B5, slice E2 -- docs/STREAM.md par. 8.3/8.4; the E1 tier it rides on is
;;; models/x86/vector.shard, record in docs/X86.md par. 6).
;;;
;;; This file proves the canonical SHA-NI block computation AT THE VALUE
;;; LEVEL against std/sha256's spec, in the tier's own vocabulary:
;;;
;;;   - PACK/UNPACK: the permuted two-register state layout SHA-NI
;;;     dictates (ABEF register = (F,E,B,A) in lanes 0..3, CDGH =
;;;     (H,G,D,C)) is landed and inverted by pshufd/palignr/punpck
;;;     shuffle sequences (pblendw-free -- the tier models only the
;;;     species the hand body needs), proven symbolically.
;;;   - THE TWO-ROUNDS LAW shn_rnds2: sha256rnds2 at the packed layout
;;;     IS two rounds of the spec's compression, with the two rounds'
;;;     masked K+W in the wk register's low lanes (upper lanes junk).
;;;     Its companion shn_slide: after two rounds the new CDGH register
;;;     is the old ABEF register VERBATIM -- why the canonical loop
;;;     alternates rnds2 destinations with zero move instructions.
;;;   - THE SCHEDULE LAW shn_sched_group: one msg1/palignr/paddd/msg2
;;;     step over four word groups computes the next four schedule
;;;     words of sched_ext's recurrence (shn_wnext is tree-identical to
;;;     sched_ext's Cons value), lanes 2/3 chaining on lanes 0/1 inside
;;;     the instruction exactly as the spec recurs.
;;;   - THE REFERENCE BLOCK shn_block_b: the canonical 16-issue dataflow
;;;     with just-in-time schedule updates and paddd feedback, pinned
;;;     ground-equal to sha_block on "abc", the empty-pad block, and
;;;     chained over the two-block NIST vector. This is the dataflow the
;;;     machine walk (E2b, this file's next slice) ties the hand body
;;;     to, and the reference the block-grain silicon differential
;;;     replays.
;;;
;;; Proof architecture: the lane vocabulary is respelled tree-identical
;;; on both sides (the shn_*_v alignment family closes by one compute
;;; each), so the ONLY semantic seam is the wk mask -- the instruction
;;; carries m32(K+W) where the spec adds K+W raw. shn_madd32 (the
;;; unconditional additive mod collapse) + shn_absorb4 (at vt1's exact
;;; shape) cross it; everything else is wiring. The nonneg range ladder
;;; (pw rungs, ground-shift rotate bounds, helper bounds) discharges the
;;; mask/mod bridge's premises; laws carry component-nonneg premises
;;; only, which consumers meet from lane invariants (every lane is
;;; masked by construction).
;;;
;;; Trust: the instruction-grain silicon differential
;;; (models/x86/diff/) is the authority on the tier's semantics per
;;; docs/X86.md par. 32; this article is pure spec-to-model mathematics on
;;; top of it. The sha256rnds2 operand story (SDM: ABEF in SRC, CDGH in
;;; DEST; caught on silicon at E1) is recorded at the semantic fn.

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/bits")
(use (:: std bits *))
(import "sha256.shard")
(use (:: std sha256 sha256 *))
(import "../../models/x86/vector.shard")
(use (:: models x86 vector *))

;; ---- pack/unpack ------------------------------------------------------------------

(fn shn_pk_abef ((st H8)) Xmm
  (match st
    ((mk_h8 a b c d e f g h) (MkXmm f e b a))))

(fn shn_pk_cdgh ((st H8)) Xmm
  (match st
    ((mk_h8 a b c d e f g h) (MkXmm h g d c))))

(fn shn_unpack ((abef Xmm) (cdgh Xmm)) H8
  (mk_h8
    (x3_of abef)
    (x2_of abef)
    (x3_of cdgh)
    (x2_of cdgh)
    (x1_of abef)
    (x0_of abef)
    (x1_of cdgh)
    (x0_of cdgh)))

;; unpack inverts pack (symbolic).
(claim shnp_roundtrip
  (goal ((a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) ()
    (=
      (shn_unpack
        (shn_pk_abef (mk_h8 a b c d e f g h))
        (shn_pk_cdgh (mk_h8 a b c d e f g h)))
      (mk_h8 a b c d e f g h)))
  (steps ((compute both)) refl))

;; the state-LOAD shuffles: from the linear dword layout T0=(a,b,c,d),
;; T1=(e,f,g,h) (as vload delivers the H window), the sequence
;;   t0' = pshufd T0 0xB1 ; t1' = pshufd T1 0x1B
;;   abef = palignr t0' t1' 8 ; cdgh = punpcklqdq t1' (pshufd t0' 0x0E)
;; lands the packed pair (symbolic).
(claim shnp_pack_abef
  (goal ((a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) ()
    (=
      (vpalignr (vpshufd (MkXmm a b c d) 177) (vpshufd (MkXmm e f g h) 27) 8)
      (shn_pk_abef (mk_h8 a b c d e f g h))))
  (steps ((compute both)) refl))

(claim shnp_pack_cdgh
  (goal ((a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) ()
    (=
      (vpunpckl
        (vpshufd (MkXmm e f g h) 27)
        (vpshufd (vpshufd (MkXmm a b c d) 177) 14))
      (shn_pk_cdgh (mk_h8 a b c d e f g h))))
  (steps ((compute both)) refl))

;; the state-STORE shuffles: from packed abef/cdgh back to the linear
;; layout (symbolic).
(claim shnp_unpack_lo
  (goal ((a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) ()
    (=
      (vpunpckl
        (vpshufd (shn_pk_abef (mk_h8 a b c d e f g h)) 27)
        (vpshufd (shn_pk_cdgh (mk_h8 a b c d e f g h)) 27))
      (MkXmm a b c d)))
  (steps ((compute both)) refl))

(claim shnp_unpack_hi
  (goal ((a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) ()
    (=
      (vpunpckh
        (vpshufd (shn_pk_abef (mk_h8 a b c d e f g h)) 27)
        (vpshufd (shn_pk_cdgh (mk_h8 a b c d e f g h)) 27))
      (MkXmm e f g h)))
  (steps ((compute both)) refl))

;; ---- ground fixtures --------------------------------------------------------------

;; the "abc" block and its schedule.
(fn shn_blk () (List Int) (stake 64 (sha_pad "abc")))

;; word group i of a BLOCK's sixteen message words (i in 0..3).
(fn shn_wg ((b (List Int)) (i Int)) Xmm
  (MkXmm
    (snth (* 4 i) (words16 b 16))
    (snth (+ (* 4 i) 1) (words16 b 16))
    (snth (+ (* 4 i) 2) (words16 b 16))
    (snth (+ (* 4 i) 3) (words16 b 16))))

;; word group i of the abc block's FULL 64-word schedule (i in 0..15).
(fn shn_mg ((i Int)) Xmm
  (MkXmm
    (snth (* 4 i) (sha_sched (shn_blk)))
    (snth (+ (* 4 i) 1) (sha_sched (shn_blk)))
    (snth (+ (* 4 i) 2) (sha_sched (shn_blk)))
    (snth (+ (* 4 i) 3) (sha_sched (shn_blk)))))

;; K group i (i in 0..15).
(fn shn_kg ((i Int)) Xmm
  (MkXmm
    (snth (* 4 i) (sha_k))
    (snth (+ (* 4 i) 1) (sha_k))
    (snth (+ (* 4 i) 2) (sha_k))
    (snth (+ (* 4 i) 3) (sha_k))))

;; ---- rnds2 = two rounds (ground) --------------------------------------------------

;; wk lanes 0/1 = the two rounds' masked K+W; upper lanes junk (57/91).
(claim shnp_rnds2
  (goal () ()
    (=
      (vrnds2
        (shn_pk_abef (sha_h0))
        (shn_pk_cdgh (sha_h0))
        (MkXmm
          (vm32 (+ (snth 0 (sha_k)) (snth 0 (sha_sched (shn_blk)))))
          (vm32 (+ (snth 1 (sha_k)) (snth 1 (sha_sched (shn_blk)))))
          57
          91))
      (shn_pk_abef
        (sha_round
          (sha_round (sha_h0) (snth 0 (sha_k)) (snth 0 (sha_sched (shn_blk))))
          (snth 1 (sha_k))
          (snth 1 (sha_sched (shn_blk)))))))
  (steps ((compute both)) refl))

;; THE SLIDE LAW (ground): two rounds later the new CDGH register is the
;; old ABEF register verbatim (a,b,e,f slide into c,d,g,h) — why the
;; canonical loop alternates rnds2 destinations with zero moves.
(claim shnp_slide
  (goal () ()
    (=
      (shn_pk_cdgh
        (sha_round
          (sha_round (sha_h0) (snth 0 (sha_k)) (snth 0 (sha_sched (shn_blk))))
          (snth 1 (sha_k))
          (snth 1 (sha_sched (shn_blk)))))
      (shn_pk_abef (sha_h0))))
  (steps ((compute both)) refl))

;; ---- the schedule step (ground) ---------------------------------------------------

;; msg2(paddd(msg1(g0,g1), palignr(g3,g2,4)), g3) = the next word group.
(claim shnp_sched
  (goal () ()
    (=
      (vmsg2
        (vpaddd
          (vmsg1 (shn_mg 0) (shn_mg 1))
          (vpalignr (shn_mg 3) (shn_mg 2) 4))
        (shn_mg 3))
      (shn_mg 4)))
  (steps ((compute both)) refl))

;; and the NEXT step, exercising computed (not message) inputs.
(claim shnp_sched2
  (goal () ()
    (=
      (vmsg2
        (vpaddd
          (vmsg1 (shn_mg 1) (shn_mg 2))
          (vpalignr (shn_mg 4) (shn_mg 3) 4))
        (shn_mg 4))
      (shn_mg 5)))
  (steps ((compute both)) refl))

;; ---- the block ---------------------------------------------------------------------

(record ShnRs (rabef Xmm) (rcdgh Xmm))

;; one 4-round group: wk = paddd(msg-group, K-group); two rnds2 issues,
;; the second consuming wk's high lanes via pshufd 0x0E. The register
;; alternation is the slide law: after each issue the old ABEF is the
;; new CDGH.
(fn shn_qround ((s ShnRs) (m Xmm) (kg Xmm)) ShnRs
  (let ((wk (vpaddd m kg)))
    (let ((a1 (vrnds2 (rabef_of s) (rcdgh_of s) wk)))
      (MkShnRs (vrnds2 a1 (rabef_of s) (vpshufd wk 14)) a1))))

;; one schedule step at group grain.
(fn shn_sstep ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (vmsg2 (vpaddd (vmsg1 g0 g1) (vpalignr g3 g2 4)) g3))

;; the canonical block dataflow: 16 issues, schedule groups g4..g15
;; computed just-in-time, paddd feedback, unpacked back to H8. Register
;; allocation is E2b's business — this is the pure dataflow the machine
;; walk ties to.
;; the schedule chain as named fns: each names its shared subterms, so the
;; block body stays a SINGLE let and no independent adjacent lets arise --
;; C3-canonical without parallel lets (which this module's ground pins
;; forbid, per sha_round's reverse-resolution note). shn_gN = the (16+N)th
;; schedule group; g4..g15 feed the last twelve qround issues.
(fn shn_g4 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm (shn_sstep g0 g1 g2 g3))

(fn shn_g5 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep g1 g2 g3 (shn_g4 g0 g1 g2 g3)))

(fn shn_g6 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep g2 g3 (shn_g4 g0 g1 g2 g3) (shn_g5 g0 g1 g2 g3)))

(fn shn_g7 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep g3 (shn_g4 g0 g1 g2 g3) (shn_g5 g0 g1 g2 g3) (shn_g6 g0 g1 g2 g3)))

(fn shn_g8 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g4 g0 g1 g2 g3)
    (shn_g5 g0 g1 g2 g3)
    (shn_g6 g0 g1 g2 g3)
    (shn_g7 g0 g1 g2 g3)))

(fn shn_g9 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g5 g0 g1 g2 g3)
    (shn_g6 g0 g1 g2 g3)
    (shn_g7 g0 g1 g2 g3)
    (shn_g8 g0 g1 g2 g3)))

(fn shn_g10 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g6 g0 g1 g2 g3)
    (shn_g7 g0 g1 g2 g3)
    (shn_g8 g0 g1 g2 g3)
    (shn_g9 g0 g1 g2 g3)))

(fn shn_g11 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g7 g0 g1 g2 g3)
    (shn_g8 g0 g1 g2 g3)
    (shn_g9 g0 g1 g2 g3)
    (shn_g10 g0 g1 g2 g3)))

(fn shn_g12 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g8 g0 g1 g2 g3)
    (shn_g9 g0 g1 g2 g3)
    (shn_g10 g0 g1 g2 g3)
    (shn_g11 g0 g1 g2 g3)))

(fn shn_g13 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g9 g0 g1 g2 g3)
    (shn_g10 g0 g1 g2 g3)
    (shn_g11 g0 g1 g2 g3)
    (shn_g12 g0 g1 g2 g3)))

(fn shn_g14 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g10 g0 g1 g2 g3)
    (shn_g11 g0 g1 g2 g3)
    (shn_g12 g0 g1 g2 g3)
    (shn_g13 g0 g1 g2 g3)))

(fn shn_g15 ((g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) Xmm
  (shn_sstep
    (shn_g11 g0 g1 g2 g3)
    (shn_g12 g0 g1 g2 g3)
    (shn_g13 g0 g1 g2 g3)
    (shn_g14 g0 g1 g2 g3)))

;; the canonical block dataflow: 16 qround issues over the named schedule
;; chain, paddd feedback, unpacked back to H8. Register allocation is
;; E2b's business -- this is the pure dataflow the machine walk ties to.
(fn shn_block ((st H8) (g0 Xmm) (g1 Xmm) (g2 Xmm) (g3 Xmm)) H8
  (let
    ((s16
       (shn_qround
         (shn_qround
           (shn_qround
             (shn_qround
               (shn_qround
                 (shn_qround
                   (shn_qround
                     (shn_qround
                       (shn_qround
                         (shn_qround
                           (shn_qround
                             (shn_qround
                               (shn_qround
                                 (shn_qround
                                   (shn_qround
                                     (shn_qround
                                       (MkShnRs
                                         (shn_pk_abef st)
                                         (shn_pk_cdgh st))
                                       g0
                                       (shn_kg 0))
                                     g1
                                     (shn_kg 1))
                                   g2
                                   (shn_kg 2))
                                 g3
                                 (shn_kg 3))
                               (shn_g4 g0 g1 g2 g3)
                               (shn_kg 4))
                             (shn_g5 g0 g1 g2 g3)
                             (shn_kg 5))
                           (shn_g6 g0 g1 g2 g3)
                           (shn_kg 6))
                         (shn_g7 g0 g1 g2 g3)
                         (shn_kg 7))
                       (shn_g8 g0 g1 g2 g3)
                       (shn_kg 8))
                     (shn_g9 g0 g1 g2 g3)
                     (shn_kg 9))
                   (shn_g10 g0 g1 g2 g3)
                   (shn_kg 10))
                 (shn_g11 g0 g1 g2 g3)
                 (shn_kg 11))
               (shn_g12 g0 g1 g2 g3)
               (shn_kg 12))
             (shn_g13 g0 g1 g2 g3)
             (shn_kg 13))
           (shn_g14 g0 g1 g2 g3)
           (shn_kg 14))
         (shn_g15 g0 g1 g2 g3)
         (shn_kg 15))))
    (shn_unpack
      (vpaddd (rabef_of s16) (shn_pk_abef st))
      (vpaddd (rcdgh_of s16) (shn_pk_cdgh st)))))

;; the block over a raw 64-byte block.
(fn shn_block_b ((st H8) (b (List Int))) H8
  (shn_block st (shn_wg b 0) (shn_wg b 1) (shn_wg b 2) (shn_wg b 3)))

;; THE BLOCK PIN: the canonical dataflow = the spec's block on "abc".
(claim shnp_block
  (goal () ()
    (= (shn_block_b (sha_h0) (shn_blk)) (sha_block (sha_h0) (shn_blk))))
  (steps ((compute both)) refl))

;; a second vector — the empty message's pure-padding block.
(claim shnp_block_empty
  (goal () ()
    (=
      (shn_block_b (sha_h0) (stake 64 (sha_pad Nil)))
      (sha_block (sha_h0) (stake 64 (sha_pad Nil)))))
  (steps ((compute both)) refl))

;; chained feedback — the two-block NIST vector, folded by hand twice.
(fn shn_v2 () (List Int)
  (sha_pad "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))

(claim shnp_two_blocks
  (goal () ()
    (=
      (shn_block_b
        (shn_block_b (sha_h0) (stake 64 (shn_v2)))
        (stake 64 (sdrop 64 (shn_v2))))
      (sha_blocks (sha_h0) (shn_v2) 2)))
  (steps ((compute both)) refl))

;; ==== SYMBOLIC TRANCHE 1 — the article's seam kit ==================================

;; ---- alignment: the v-respellings ARE the spec functions (tree-identity
;; as theorems — one compute closes each) ---------------------------------------------

(claim shn_m32_v
  (goal ((x Int)) () (= (m32 x) (vm32 x)))
  (steps ((compute both)) refl))

(claim shn_rotr_v
  (goal ((x Int) (k Int)) () (= (rotr32 x k) (vrotr32 x k)))
  (steps ((compute both)) refl))

(claim shn_ch_v
  (goal ((x Int) (y Int) (z Int)) () (= (sha_ch x y z) (vch x y z)))
  (steps ((compute both)) refl))

(claim shn_maj_v
  (goal ((x Int) (y Int) (z Int)) () (= (sha_maj x y z) (vmaj x y z)))
  (steps ((compute both)) refl))

(claim shn_bs0_v
  (goal ((x Int)) () (= (bsig0 x) (vbs0 x)))
  (steps ((compute both)) refl))

(claim shn_bs1_v
  (goal ((x Int)) () (= (bsig1 x) (vbs1 x)))
  (steps ((compute both)) refl))

(claim shn_ss0_v
  (goal ((x Int)) () (= (ssig0 x) (vss0 x)))
  (steps ((compute both)) refl))

(claim shn_ss1_v
  (goal ((x Int)) () (= (ssig1 x) (vss1 x)))
  (steps ((compute both)) refl))

;; ---- the vm32/mod bridge ----------------------------------------------------------

(claim shn_vm32_mod
  (goal ((x Int)) ((= (le 0 x) True)) (= (vm32 x) (mod x 4294967296)))
  (chain
    (steps ((unfold vm32 lhs)))
    (rewrite-with
      (lemma mask_word32)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    refl))

;; ---- the additive mod collapse (unconditional; ipf_lm's template) -----------------

(claim shn_madd32
  (goal ((x Int) (y Int)) ()
    (= (mod (+ x (mod y 4294967296)) 4294967296) (mod (+ x y) 4294967296)))
  (chain
    (have hid (= y (+ (* 4294967296 (ediv y 4294967296)) (mod y 4294967296)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst n y) (inst d 4294967296))
        ((steps ((compute lhs)) refl))
        refl))
    (have hid2
      (=
        (+ x (mod y 4294967296))
        (+
          (* 4294967296 (ediv (+ x (mod y 4294967296)) 4294967296))
          (mod (+ x (mod y 4294967296)) 4294967296)))
      (rewrite-with
        (lemma ediv_mod_id)
        lr
        lhs
        ((inst n (+ x (mod y 4294967296))) (inst d 4294967296))
        ((steps ((compute lhs)) refl))
        refl))
    (have hml (= (le 0 (mod (+ x (mod y 4294967296)) 4294967296)) True)
      (rewrite-with
        (lemma mod_lo)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hmh (= (lt (mod (+ x (mod y 4294967296)) 4294967296) 4294967296) True)
      (rewrite-with
        (lemma mod_hi)
        lr
        lhs
        ()
        ((steps ((compute lhs)) refl))
        refl))
    (have hdec
      (=
        (+ x y)
        (+
          (*
            4294967296
            (+ (ediv y 4294967296) (ediv (+ x (mod y 4294967296)) 4294967296)))
          (mod (+ x (mod y 4294967296)) 4294967296)))
      (steps () (by arith (list (list 1 -1 -1) (list 1 1 1)))))
    (rewrite-with
      (lemma mod_unique)
      lr
      rhs
      ((inst n (+ x y))
       (inst d 4294967296)
       (inst
         q
         (+ (ediv y 4294967296) (ediv (+ x (mod y 4294967296)) 4294967296)))
       (inst r (mod (+ x (mod y 4294967296)) 4294967296)))
      ((steps ((rewrite (premise hdec) lr lhs true ())) refl)
       (steps ((rewrite (premise hml) lr lhs true ())) refl)
       (steps ((rewrite (premise hmh) lr lhs true ())) refl)))
    refl))

;; ---- absorption at vt1's exact shape ----------------------------------------------
;; vm32 (p + (q + (r + vm32 s))) = vm32 (p + (q + (r + s))) — the ONE
;; seam between vrnds2's wk-as-lane-value and the spec's raw (k + w).

(claim shn_absorb4
  (goal ((p Int) (q Int) (r Int) (s Int))
    ((= (le 0 p) True) (= (le 0 q) True) (= (le 0 r) True) (= (le 0 s) True))
    (= (vm32 (+ p (+ q (+ r (vm32 s))))) (vm32 (+ p (+ q (+ r s))))))
  (chain
    (have hs0 (= (le 0 (vm32 s)) True)
      (chain
        (steps ((unfold vm32 lhs)))
        (rewrite-with
          (lemma band_lo)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((compute lhs)) refl)))
        refl))
    (have ha1 (= (le 0 (+ p (+ q (+ r (vm32 s))))) True)
      (steps () (by arith (list 1 1 1 1 0 1))))
    (have ha2 (= (le 0 (+ p (+ q (+ r s)))) True)
      (steps () (by arith (list 1 1 1 1 1))))
    (rewrite-with
      (lemma shn_vm32_mod)
      lr
      lhs
      ((inst x (+ p (+ q (+ r (vm32 s))))))
      ((steps ((rewrite (premise ha1) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shn_vm32_mod)
      lr
      lhs
      ((inst x s))
      ((steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shn_vm32_mod)
      lr
      rhs
      ((inst x (+ p (+ q (+ r s)))))
      ((steps ((rewrite (premise ha2) lr lhs true ())) refl)))
    (have hra
      (=
        (+ p (+ q (+ r (mod s 4294967296))))
        (+ (+ p (+ q r)) (mod s 4294967296)))
      (steps () (by arith (list (list 1) (list 1)))))
    (have hrb (= (+ p (+ q (+ r s))) (+ (+ p (+ q r)) s))
      (steps () (by arith (list (list 1) (list 1)))))
    (steps
      ((rewrite (premise hra) lr lhs true ())
       (rewrite (premise hrb) lr rhs true ())))
    (rewrite-with
      (lemma shn_madd32)
      lr
      lhs
      ((inst x (+ p (+ q r))) (inst y s))
      ())
    refl))

;; ---- THE SLIDE LAW, symbolic ------------------------------------------------------
;; After two rounds the new CDGH register is the old ABEF register
;; verbatim — a,b,e,f ride through into c,d,g,h untouched, so the
;; projection discards every masked tree and refl closes.

(claim shn_slide
  (goal
    ((a Int)
     (b Int)
     (c Int)
     (d Int)
     (e Int)
     (f Int)
     (g Int)
     (h Int)
     (k0 Int)
     (w0 Int)
     (k1 Int)
     (w1 Int))
    ()
    (=
      (shn_pk_cdgh (sha_round (sha_round (mk_h8 a b c d e f g h) k0 w0) k1 w1))
      (shn_pk_abef (mk_h8 a b c d e f g h))))
  (steps ((compute both)) refl))

;; ---- the round law (premised form — the range ladder will discharge
;; the helper-nonneg premises internally in the article's final form) ---------------
;; sha_round IS one vrnd_a/vrnd_e pair at the masked wk lane value.

(claim shn_round_p
  (goal
    ((a Int)
     (b Int)
     (c Int)
     (d Int)
     (e Int)
     (f Int)
     (g Int)
     (h Int)
     (k Int)
     (w Int))
    ((= (le 0 h) True)
     (= (le 0 (vbs1 e)) True)
     (= (le 0 (vch e f g)) True)
     (= (le 0 (+ k w)) True))
    (=
      (sha_round (mk_h8 a b c d e f g h) k w)
      (mk_h8
        (vrnd_a a b c e f g h (vm32 (+ k w)))
        a
        b
        c
        (vrnd_e d e f g h (vm32 (+ k w)))
        e
        f
        g)))
  (chain
    (steps
      ((compute lhs (stop m32 bsig0 bsig1 sha_ch sha_maj))
       (compute rhs (stop vm32 vbs0 vbs1 vch vmaj))))
    (rewrite-with (lemma shn_m32_v) lr lhs () ())
    (rewrite-with (lemma shn_m32_v) lr lhs () ())
    (rewrite-with (lemma shn_m32_v) lr lhs () ())
    (rewrite-with (lemma shn_m32_v) lr lhs () ())
    (rewrite-with (lemma shn_bs1_v) lr lhs () ())
    (rewrite-with (lemma shn_bs1_v) lr lhs () ())
    (rewrite-with (lemma shn_ch_v) lr lhs () ())
    (rewrite-with (lemma shn_ch_v) lr lhs () ())
    (rewrite-with (lemma shn_bs0_v) lr lhs () ())
    (rewrite-with (lemma shn_maj_v) lr lhs () ())
    (rewrite-with
      (lemma shn_absorb4)
      lr
      rhs
      ((inst p h) (inst q (vbs1 e)) (inst r (vch e f g)) (inst s (+ k w)))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (rewrite-with
      (lemma shn_absorb4)
      lr
      rhs
      ((inst p h) (inst q (vbs1 e)) (inst r (vch e f g)) (inst s (+ k w)))
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    refl))

;; ---- range ladder, rung 0: the mask is nonneg -------------------------------------

(claim shn_vm32_lo
  (goal ((x Int)) ((= (le 0 x) True)) (= (le 0 (vm32 x)) True))
  (chain
    (steps ((unfold vm32 lhs)))
    (rewrite-with
      (lemma band_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((compute lhs)) refl)))
    refl))

