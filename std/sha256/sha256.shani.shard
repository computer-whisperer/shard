         (steps () (by arith (rows (goal 1) (4 1)))))
        refl))
    (have hw3
      (=
        (mod (+ (+ (+ a6 16) 16) 16) 18446744073709551616)
        (+ (+ (+ a6 16) 16) 16))
      (rewrite-with
        (lemma mod_unique)
        lr
        lhs
        ((inst q 0) (inst r (+ (+ (+ a6 16) 16) 16)))
        ((steps () (by arith (list (list 1) (list 1))))
