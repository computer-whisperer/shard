(claim tie_x_shblock
  (goal () ()
    (= (ix_sstmts (ibody_of (it_shblock_fn))) (Some (inline gb_shblock_x))))
  (steps ((compute both)) refl))

(fn gb_shblock_i () (List IStmt)
  (Cons
    (ISet 3 (ILoc 9))
    (Cons
      (ISet 10 (IConst 16))
      (Cons
        (IWhile
          (ILoc 10)
          (list
            (ISet 11 (IExt U8 U32 (ILoad (ILoc 8))))
            (ISet 8 (IBin U32 IAdd (ILoc 8) (IConst 1)))
            (ISet 11 (IBin U32 IMul (ILoc 11) (IConst 256)))
            (ISet 11 (IBin U32 IAdd (ILoc 11) (IExt U8 U32 (ILoad (ILoc 8)))))
            (ISet 8 (IBin U32 IAdd (ILoc 8) (IConst 1)))
            (ISet 11 (IBin U32 IMul (ILoc 11) (IConst 256)))
            (ISet 11 (IBin U32 IAdd (ILoc 11) (IExt U8 U32 (ILoad (ILoc 8)))))
            (ISet 8 (IBin U32 IAdd (ILoc 8) (IConst 1)))
            (ISet 11 (IBin U32 IMul (ILoc 11) (IConst 256)))
            (ISet 11 (IBin U32 IAdd (ILoc 11) (IExt U8 U32 (ILoad (ILoc 8)))))
            (ISet 8 (IBin U32 IAdd (ILoc 8) (IConst 1)))
            (ISet 0 (IBin U32 IAdd (ILoc 9) (IConst 3)))
            (IStore (ILoc 0) (ITrunc U32 U8 (ILoc 11)))
            (ISet 0 (IBin U32 ISub (ILoc 0) (IConst 1)))
            (ISet 11 (IBin U32 IShr (ILoc 11) (IConst 8)))
            (IStore (ILoc 0) (ITrunc U32 U8 (ILoc 11)))
            (ISet 0 (IBin U32 ISub (ILoc 0) (IConst 1)))
            (ISet 11 (IBin U32 IShr (ILoc 11) (IConst 8)))
            (IStore (ILoc 0) (ITrunc U32 U8 (ILoc 11)))
            (ISet 0 (IBin U32 ISub (ILoc 0) (IConst 1)))
            (ISet 11 (IBin U32 IShr (ILoc 11) (IConst 8)))
            (IStore (ILoc 0) (ITrunc U32 U8 (ILoc 11)))
            (ISet 9 (IBin U32 IAdd (ILoc 9) (IConst 4)))
            (ISet 0 (IConst 0))
            (ISet 1 (IConst 0))
            (ISet 11 (IConst 0))
            (ISet 10 (IBin U32 ISub (ILoc 10) (IConst 1)))))
        (gb_shblock_r1_i)))))

(fn gb_shblock_x () (List XInstr)
  (Cons
    (XMovRR RCX R13)
    (Cons
      (XMovRI R14 16)
      (Cons
        (XMovRI RAX 0)
        (Cons
          (XBlock
            (list
              (XLoop
                (list
                  (XBrIf (CEqz R14) 1)
                  (XLoad8 R15 (AReg R12))
                  (XBin32 XAdd R12 (SImm 1))
                  (XBin32 XMul R15 (SImm 256))
                  (XLoad8 RAX (AReg R12))
                  (XBin32 XAdd R15 (SReg RAX))
                  (XBin32 XAdd R12 (SImm 1))
                  (XBin32 XMul R15 (SImm 256))
                  (XLoad8 RAX (AReg R12))
                  (XBin32 XAdd R15 (SReg RAX))
