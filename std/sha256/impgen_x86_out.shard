(claim cmp_x_shblock_b12
  (goal
    ((x0 Int)
     (x1 Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (x5 Int)
     (x6 Int)
     (x7 Int)
     (x8 Int)
     (x9 Int)
     (x10 Int)
     (x11 Int)
     (za Int)
     (zb Int)
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List XFunc)))
    ()
    (=
      (xeval_seq
        (S^ 76 c)
        (MkXModule restfs 0 65536)
        (gb_shblock_r12_x)
        (MkRegs za x3 x2 x6 x7 x1 x0 x4 x5 zb 0 x8 x9 x10 x11)
        m)
      (ix_sout
        (istmts
          (S^ 52 c2)
          65536
          (gb_shblock_r12_i)
          (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
          m))))
  (chain
    (steps ((unfold gb_shblock_r12_x lhs) (reduce lhs)))
    (have hsp12
      (=
        (gb_shblock_r12_i)
        (isapp (inline gb_shblock_c12_i) (gb_shblock_r13_i)))
      (steps ((compute both)) refl))
    (steps ((rewrite (premise hsp12) lr rhs true ())))
    (have hfg12
      (= (S^ 52 c2) (lg_fuel (istn (inline gb_shblock_c12_i)) (S (S^ 27 c2))))
      (steps ((compute both)) refl))
    (steps ((rewrite (premise hfg12) lr rhs true ())))
    (rewrite-with
