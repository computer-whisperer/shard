(claim tie_x_shfpad
  (goal () ()
    (= (ix_sstmts (ibody_of (it_shfpad_fn))) (Some (inline gb_shfpad_x))))
  (steps ((compute both)) refl))

(fn gb_shfpad_i () (List IStmt)
  (Cons
    (ISet 2 (IBin U32 IAdd (ILoc 0) (ILoc 1)))
    (Cons
      (ISet 3 (IConst 72))
      (Cons
        (IWhile
          (ILoc 3)
          (list
            (IStore (ILoc 2) (IConst 0))
            (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
            (ISet 3 (IBin U32 ISub (ILoc 3) (IConst 1)))))
        (gb_shfpad_r1_i)))))

(fn gb_shfpad_x () (List XInstr)
  (Cons
    (XMovRR RDX RDI)
    (Cons
      (XBin32 XAdd RDX (SReg RSI))
      (Cons
        (XMovRI RCX 72)
        (Cons
          (XBlock
            (list
              (XLoop
                (list
                  (XBrIf (CEqz RCX) 1)
                  (XStore8 (AReg RDX) (SImm 0))
                  (XBin32 XAdd RDX (SImm 1))
                  (XBin32 XSub RCX (SImm 1))
                  (XBr 0)))))
          (gb_shfpad_r1_x))))))

(fn gb_shfpad_r1_i () (List IStmt)
  (list
    (ISet 2 (IBin U32 IAdd (ILoc 0) (ILoc 1)))
    (IStore (ILoc 2) (IConst 128))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (ISet 3 (IBin U32 ISub (IConst 55) (ILoc 1)))
    (ISet 3 (IBin U32 IAnd (ILoc 3) (IConst 63)))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (ILoc 3)))
    (ISet 4 (IBin U64 IMul (IConst 8) (ILoc 5)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 56)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 48)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 40)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 32)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 24)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 16)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 4) (IConst 8)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore (ILoc 2) (ITrunc U32 U8 (ITrunc U64 U32 (ILoc 4))))))

(fn gb_shfpad_r1_x () (List XInstr)
  (list
    (XMovRR RDX RDI)
    (XBin32 XAdd RDX (SReg RSI))
    (XStore8 (AReg RDX) (SImm 128))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRI RAX 55)
    (XBin32 XSub RAX (SReg RSI))
    (XMovRR RCX RAX)
    (XBin XAnd RCX (SImm 63))
    (XBin32 XAdd RDX (SReg RCX))
    (XMovRI RAX 8)
    (XBin XMul RAX (SReg R9))
    (XMovRR R8 RAX)
    (XMovRR RAX R8)
    (XShrI RAX 56)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 48)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 40)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 32)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 24)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 16)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XShrI RAX 8)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XBin32 XAdd RDX (SImm 1))
    (XMovRR RAX R8)
    (XMovRR32 RAX RAX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDX) (SReg RAX))
    (XMovRI RAX 0)))

(claim sqm_wid_shfpad
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 4294967296) True))
    (= (mod x 4294967296) x))
  (div-facts
    x
    4294967296
    q
    (have qlo (= (le -1 q) True)
      (by arith (list 4294967296 1 0 -1 0 1 0))
      (have qhi (= (le q 1) True)
        (by arith (list 4294967296 0 1 1 1 0 0))
        (fin-split
          q
          (premise qlo)
          (premise qhi)
          ((case -1
             (by
               arith
               (list (list 0 1 0 -1 0 1 0 0 0) (list 0 1 0 -1 0 1 0 0 0))))
           (case 0
             (by
               arith
               (list (list 1 0 0 1 0 0 0 0 0) (list 1 0 0 -1 0 0 0 0 0))))
           (case 1
             (by arith (list (list 0 0 1 1 1 0 0 0 0) (list 0 0 1 1 1 0 0 0 0))))))))))

(claim sqm_wid64_shfpad
  (goal ((x Int)) ((= (le 0 x) True) (= (lt x 18446744073709551616) True))
    (= (mod x 18446744073709551616) x))
  (div-facts
    x
    18446744073709551616
    q
    (have qlo (= (le -1 q) True)
