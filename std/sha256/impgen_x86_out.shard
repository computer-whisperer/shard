      (steps ((compute both)) refl))
    (steps ((rewrite (premise hfb8) lr rhs true ())))
    (rewrite-with (lemma sqs_x_shblock_c8) lr lhs ((inst g c2)) ())
    (case-on
      (istmts
        (S^ 24 (S c2))
        65536
        (inline gb_shblock_c8_i)
        (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
