(claim tie_x_shtcopy
  (goal () ()
    (=
      (ix_sstmts (ibody_of (it_shtcopy_fn)))
      (Some
        (list
          (XMovRI RCX 0)
          (XMovRI RAX 0)
          (XBlock
            (list
              (XLoop
                (list
                  (XBrIf (CEqz RDX) 1)
                  (XLoad8 RCX (AReg RSI))
                  (XMovRR RAX RCX)
                  (XBin XAnd RAX (SImm 255))
                  (XStore8 (AReg RDI) (SReg RAX))
                  (XBin32 XAdd RDI (SImm 1))
                  (XBin32 XAdd RSI (SImm 1))
                  (XMovRI RCX 0)
                  (XBin32 XSub RDX (SImm 1))
                  (XMovRI RAX 0)
                  (XBr 0)))))
          (XMovRI RAX 0)))))
  (steps ((compute both)) refl))

;; it_shtcopy_fn: tie only (bridge scope: loop counter is not ground at the loop head (named growth))

(claim tie_x_shtotr
  (goal () ()
    (=
      (ix_sstmts (ibody_of (it_shtotr_fn)))
      (Some
        (list
          (XMovRR RDX RDI)
          (XLoad8 RCX (AReg RDX))
          (XMovRR RAX RCX)
          (XMovRR RSI RAX)
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRI RAX 0)
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XBin32 XAdd RDX (SImm 1))
          (XLoad8 RCX (AReg RDX))
          (XBin XMul RSI (SImm 256))
          (XBin XAdd RSI (SReg RCX))
          (XMovRI RCX 0)
          (XMovRI RAX 0)))))
  (steps ((compute both)) refl))

(fn gb_shtotr_i () (List IStmt)
  (list
