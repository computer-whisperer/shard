(claim tie_x_shtotw
  (goal () ()
    (=
      (ix_sstmts (ibody_of (it_shtotw_fn)))
      (Some
        (list
          (XMovRR RDX RDI)
          (XMovRR RAX RSI)
          (XShrI RAX 56)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 48)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 40)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 32)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 24)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 16)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XShrI RAX 8)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XBin32 XAdd RDX (SImm 1))
          (XMovRR RAX RSI)
          (XMovRR32 RAX RAX)
          (XBin XAnd RAX (SImm 255))
          (XStore8 (AReg RDX) (SReg RAX))
          (XMovRI RAX 0)))))
  (steps ((compute both)) refl))

