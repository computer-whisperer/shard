                  (XBin32 XMul R15 (SImm 256))
                  (XLoad8 RAX (AReg R12))
                  (XBin32 XAdd R15 (SReg RAX))
                  (XBin32 XAdd R12 (SImm 1))
                  (XMovRR RDI R13)
                  (XBin32 XAdd RDI (SImm 3))
                  (XMovRR RAX R15)
                  (XBin XAnd RAX (SImm 255))
                  (XStore8 (AReg RDI) (SReg RAX))
                  (XBin32 XSub RDI (SImm 1))
                  (XShrI R15 8)
                  (XMovRR RAX R15)
                  (XBin XAnd RAX (SImm 255))
                  (XStore8 (AReg RDI) (SReg RAX))
                  (XBin32 XSub RDI (SImm 1))
                  (XShrI R15 8)
                  (XMovRR RAX R15)
