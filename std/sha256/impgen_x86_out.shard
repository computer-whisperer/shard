    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 1) (IConst 24)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
      (ILoc 2)
      (ITrunc U32 U8 (ITrunc U64 U32 (IBin U64 IShr (ILoc 1) (IConst 16)))))
    (ISet 2 (IBin U32 IAdd (ILoc 2) (IConst 1)))
    (IStore
