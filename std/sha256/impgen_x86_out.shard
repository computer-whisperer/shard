(claim cmp_x_shblock_b6
  (goal
    ((x0 Int)
     (x1 Int)
     (x2 Int)
     (x3 Int)
     (x4 Int)
     (x5 Int)
     (x6 Int)
     (x7 Int)
     (x8 Int)
     (x9 Int)
     (x10 Int)
     (x11 Int)
     (za Int)
     (zb Int)
     (m Mem)
     (c Nat)
     (c2 Nat)
     (restfs (List XFunc)))
    ()
    (=
      (xeval_seq
        (S^ 299 c)
        (MkXModule restfs 0 65536)
        (gb_shblock_r6_x)
        (MkRegs za x3 x2 x6 x7 x1 x0 x4 x5 zb 0 x8 x9 x10 x11)
        m)
      (ix_sout
        (istmts
          (S^ 196 c2)
          65536
          (gb_shblock_r6_i)
          (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
          m))))
  (chain
    (steps ((unfold gb_shblock_r6_x lhs) (reduce lhs)))
    (have hsp6
      (= (gb_shblock_r6_i) (isapp (inline gb_shblock_c6_i) (gb_shblock_r7_i)))
      (steps ((compute both)) refl))
    (steps ((rewrite (premise hsp6) lr rhs true ())))
    (have hfg6
      (= (S^ 196 c2) (lg_fuel (istn (inline gb_shblock_c6_i)) (S (S^ 171 c2))))
      (steps ((compute both)) refl))
    (steps ((rewrite (premise hfg6) lr rhs true ())))
    (rewrite-with
      (lemma ist_seam)
      lr
      rhs
      ((inst g c2))
      ((steps ((compute lhs)) refl)))
    (have hfb6
      (= (lg_fuel (istn (inline gb_shblock_c6_i)) (S c2)) (S^ 24 (S c2)))
      (steps ((compute both)) refl))
    (steps ((rewrite (premise hfb6) lr rhs true ())))
    (rewrite-with (lemma sqs_x_shblock_c6) lr lhs ((inst g c2)) ())
    (case-on
      (istmts
        (S^ 24 (S c2))
        65536
        (inline gb_shblock_c6_i)
        (list x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11)
        m)
      Option
      ((case None
         (chain
           (steps
             ((rewrite (hyp 0) lr both true ())
              (compute
                both
                (stop lg_fuel int_of_nat gb_shblock_r1_x gb_shblock_r1_i
                  gb_shblock_r2_x gb_shblock_r2_i gb_shblock_r3_x
