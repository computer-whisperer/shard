(claim snw_read_sle
  (goal ((w Nat) (m Mem) (a Int) (b Int) (v Int))
    ((= (le (+ a (int_of_nat w)) b) True))
    (= (mem_read w (store_le (S (S (S (S Z)))) m b v) a) (mem_read w m a)))
  (induct w
    ((case Z (steps ((rewrite (lemma mem_read_z) lr both true ())) refl))
     (case S
       (w2)
       (chain
         (have hnn (= (le 0 (int_of_nat w2)) True)
           (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
         (have hs (= (int_of_nat (S w2)) (+ 1 (int_of_nat w2)))
           (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
         (steps ((rewrite (lemma mem_read_s) lr both true ())))
         (rewrite-with
           (lemma store_le_get_below)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1) (hs 1) (hnn 1))))))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1) (hs 1))))))
         refl)))))

