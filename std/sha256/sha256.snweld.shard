        (shnw_f2
          (snw_hst m)
          (vbswap (vload m src))
          (vbswap (vload m (+ src 16)))
          (vbswap (vload m (+ (+ src 16) 16)))
          (vbswap (vload m (+ (+ (+ src 16) 16) 16)))))
      (x0_of
        (shnw_f2
          (snw_hst m)
          (vbswap (vload m src))
          (vbswap (vload m (+ src 16)))
          (vbswap (vload m (+ (+ src 16) 16)))
          (vbswap (vload m (+ (+ (+ src 16) 16) 16))))))
    (xmm12_of xs)
    (xmm13_of xs)
    (xmm14_of xs)
    (xmm15_of xs)))

;; the loop's XMM-file effect, k iterations: each pass steps the file by
;; snw_xstep over the CURRENT memory, then the memory steps by the block.
(fn snw_fxs ((xs Xmms) (m Mem) (src Int) (k Nat)) Xmms
  (measure (struct k))
  (match k
    (Z xs)
    ((S k2)
     (snw_fxs (snw_xstep xs m src) (shnw_hmem m (snw_blk m src)) (+ src 64) k2))))

(claim snw_fxs_z
  (goal ((xs Xmms) (m Mem) (src Int)) () (= (snw_fxs xs m src Z) xs))
  (steps ((unfold snw_fxs lhs) (reduce lhs)) refl))

(claim snw_fxs_s
  (goal ((xs Xmms) (m Mem) (src Int) (k Nat)) ()
    (=
      (snw_fxs xs m src (S k))
      (snw_fxs (snw_xstep xs m src) (shnw_hmem m (snw_blk m src)) (+ src 64) k)))
  (steps ((unfold snw_fxs lhs) (reduce lhs)) refl))

;; reads fully below 131008 pass the WHOLE fold untouched (the exit
;; ladder's zero-source reads at 130512 ride this through any k).
(claim snw_fmem_frame
  (goal ((m Mem) (src Int) (p Int) (k Nat)) ((= (le (+ p 16) 131008) True))
    (= (vload (snw_fmem m src k) p) (vload m p)))
  (induct k
    ((case Z (steps ((unfold snw_fmem lhs) (reduce lhs)) refl))
     (case S
       (k2)
       (chain
         (steps ((unfold snw_fmem lhs) (reduce lhs)))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
         (rewrite-with
           (lemma snw_hb2)
           lr
           lhs
           ()
           ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
         refl)))))

;; the Xmms eta law: rebuilding the file from its sixteen projections is
;; the identity (the exit ladder's vsets land on the abstract loop file
;; through this).
(claim snw_xs_eta
  (goal ((xs Xmms)) ()
    (=
      (MkXmms
        (xmm0_of xs)
        (xmm1_of xs)
        (xmm2_of xs)
        (xmm3_of xs)
        (xmm4_of xs)
        (xmm5_of xs)
        (xmm6_of xs)
        (xmm7_of xs)
        (xmm8_of xs)
        (xmm9_of xs)
        (xmm10_of xs)
        (xmm11_of xs)
        (xmm12_of xs)
        (xmm13_of xs)
        (xmm14_of xs)
        (xmm15_of xs))
      xs))
  (case-on xs Xmms
    ((case MkXmms
       (b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

;; ---- the loop-walk support laws ----------------------------------------------------

;; lg_advk's defining S-step (local twin of the imp article's lg_advk_s;
;; loopkit exports the fn but not this step law).
(claim snw_advk_s
  (goal ((x Int) (s Int) (k Nat)) ()
    (= (lg_advk x s (S k)) (lg_advk (+ x s) s k)))
  (steps ((unfold lg_advk lhs) (reduce lhs)) refl))

;; THE GATE LAW: a not-taken brif is one seq step. Stated free-tail like
;; the stanza laws so the loop walk composes it the same way: both sides
;; reduce to the same stuck match on the abstract tail.
(claim snw_law_gate
  (goal
    ((f Nat)
     (fs (List XFunc))
     (rest (List XInstr))
     (mem Mem)
     (n Int)
     (a0 Int)
     (a1 Int)
     (a3 Int)
     (a4 Int)
     (a5 Int)
     (a6 Int)
     (a7 Int)
     (a8 Int)
     (a9 Int)
     (a10 Int)
     (a11 Int)
     (a12 Int)
     (a13 Int)
     (a14 Int)
     (v0 Xmm)
     (v1 Xmm)
     (v2 Xmm)
     (v3 Xmm)
     (v4 Xmm)
     (v5 Xmm)
     (v6 Xmm)
     (v7 Xmm)
     (v8 Xmm)
     (v9 Xmm)
     (v10 Xmm)
     (v11 Xmm)
     (v12 Xmm)
     (v13 Xmm)
     (v14 Xmm)
     (v15 Xmm))
    ((= (int_eq n 0) False))
    (=
      (xveval_seq
        (S (S f))
        (MkXModule fs 65536 131072)
        (Cons (XBrIf (CEqz RDX) 1) rest)
        (MkRegs a0 a1 n a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)
      (xveval_seq
        (S f)
        (MkXModule fs 65536 131072)
        rest
        (MkRegs a0 a1 n a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)))
  (steps
    ((compute lhs)
     (rewrite (premise 0) lr lhs true ())
     (compute lhs)
     (compute rhs))
    refl))

;; ==== THE FOLD LOOP WALK ============================================================
;;
;; shb_xloop's mirror one tier up: k passes of the leaf's loop body ARE
;; the k-block SHA-NI fold. Per iteration: the gate law clears the brif,
;; the summit's stanza chain re-runs at the LIVE tail (sA/sC instantiated
;; as MkXmm-eta forms of the FOLDED H reads -- so the chain's state terms
;; equal snw_hst's spelling by syntax and the descriptor close is refl),
;; the tail computes through (wrap64 cleanups mirror the scalar's haves),
;; and the IH fires with separation side goals (snw_vlb twice per
;; below-read; H reads need NOTHING -- eta discharges them). Fuel: the
;; loop recursion re-enters at the loop peel's own f2, so the base 230 is
;; slack-insensitive (any depth >= the body's ~215 works) and lg_fuel's
;; +1/iteration is exactly the loop peel.
(claim snw_xloop
  (goal
    ((src Int)
     (m Mem)
     (c Nat)
     (k Nat)
