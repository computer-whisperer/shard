    (=
      (load_le (S (S (S (S Z)))) (store_le (S (S (S (S Z)))) m b v) a)
      (load_le (S (S (S (S Z)))) m a)))
  (chain
    (steps
      ((rewrite (lemma load_le_s) lr both true ())
       (rewrite (lemma load_le_s) lr both true ())
       (rewrite (lemma load_le_s) lr both true ())
       (rewrite (lemma load_le_s) lr both true ())
       (rewrite (lemma load_le_z) lr both true ())))
    (rewrite-with
      (lemma store_le_get_below)
      lr
