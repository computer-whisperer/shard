;; ---- the byte-swap core: vbsw32 of a LE byte assembly IS the BE word ------

(claim snw_bsw
  (goal ((v Int) (b0 Int) (b1 Int) (b2 Int) (b3 Int))
    ((= v (+ b0 (* 256 (+ b1 (* 256 (+ b2 (* 256 b3)))))))
     (= (le 0 b0) True)
     (= (lt b0 256) True)
     (= (le 0 b1) True)
     (= (lt b1 256) True)
     (= (le 0 b2) True)
     (= (lt b2 256) True)
     (= (le 0 b3) True)
     (= (lt b3 256) True))
    (= (vbsw32 v) (word_be b0 b1 b2 b3)))
  (chain
    (have hv0 (= (le 0 v) True)
      (steps
        ()
        (by arith (rows (goal 1) (0 1) (1 1) (3 256) (5 65536) (7 16777216)))))
    (have hq1 (= (ediv v 256) (+ b1 (* 256 (+ b2 (* 256 b3)))))
      (rewrite-with
        (lemma div_unique)
        lr
        lhs
        ((inst q (+ b1 (* 256 (+ b2 (* 256 b3))))) (inst r b0))
        ((steps
           ()
           (by arith (list (rows (goal 1) (0 -1)) (rows (goal 1) (0 1)))))
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hm0 (= (mod v 256) b0)
      (rewrite-with
        (lemma mod_unique)
        lr
        lhs
        ((inst q (+ b1 (* 256 (+ b2 (* 256 b3))))) (inst r b0))
        ((steps
           ()
           (by arith (list (rows (goal 1) (0 -1)) (rows (goal 1) (0 1)))))
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl))
        refl))
    (have hq2 (= (ediv v 65536) (+ b2 (* 256 b3)))
      (rewrite-with
        (lemma div_unique)
        lr
        lhs
        ((inst q (+ b2 (* 256 b3))) (inst r (+ b0 (* 256 b1))))
        ((steps
           ()
           (by arith (list (rows (goal 1) (0 -1)) (rows (goal 1) (0 1)))))
         (steps () (by arith (rows (goal 1) (1 1) (3 256))))
         (steps () (by arith (rows (goal 1) (2 1) (4 256)))))
        refl))
    (have hq3 (= (ediv v 16777216) b3)
      (rewrite-with
        (lemma div_unique)
        lr
        lhs
        ((inst q b3) (inst r (+ b0 (* 256 (+ b1 (* 256 b2))))))
        ((steps
           ()
           (by arith (list (rows (goal 1) (0 -1)) (rows (goal 1) (0 1)))))
         (steps () (by arith (rows (goal 1) (1 1) (3 256) (5 65536))))
         (steps () (by arith (rows (goal 1) (2 1) (4 256) (6 65536)))))
        refl))
    (have hm3 (= (mod b3 256) b3)
      (rewrite-with
        (lemma mod_unique)
        lr
        lhs
        ((inst q 0) (inst r b3))
        ((steps () (by arith (list (rows (goal 1)) (rows (goal 1)))))
         (steps ((rewrite (premise 7) lr lhs true ())) refl)
         (steps ((rewrite (premise 8) lr lhs true ())) refl))
        refl))
    (have hs8 (= (bshr v 8) (ediv v 256))
      (rewrite-with
        (lemma shr8_div)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hv0) lr lhs true ())) refl))
        refl))
    (have hs16 (= (bshr v 16) (ediv v 65536))
      (chain
        (rewrite-with
          (lemma shr_pow2)
          lr
          lhs
          ((inst k 16))
          ((steps ((rewrite (premise hv0) lr lhs true ())) refl)
           (steps ((compute both)) refl)))
        (steps ((rewrite (lemma snw_pw16) lr lhs true ())) refl)))
    (have hs24 (= (bshr v 24) (ediv v 16777216))
      (chain
        (rewrite-with
          (lemma shr_pow2)
          lr
          lhs
          ((inst k 24))
          ((steps ((rewrite (premise hv0) lr lhs true ())) refl)
           (steps ((compute both)) refl)))
        (steps ((rewrite (lemma snw_pw24) lr lhs true ())) refl)))
    (have hb0 (= (band v 255) b0)
      (chain
        (rewrite-with
          (lemma mask_byte)
          lr
          lhs
          ()
          ((steps ((rewrite (premise hv0) lr lhs true ())) refl)))
        (steps ((rewrite (premise hm0) lr lhs true ())) refl)))
    (have hb1 (= (band (bshr v 8) 255) b1)
      (chain
        (steps
          ((rewrite (premise hs8) lr lhs true ())
           (rewrite (premise hq1) lr lhs true ())))
        (rewrite-with
          (lemma mask_byte)
          lr
          lhs
          ()
          ((steps () (by arith (rows (goal 1) (3 1) (5 256) (7 65536))))))
        (rewrite-with
          (lemma mod_unique)
          lr
          lhs
          ((inst q (+ b2 (* 256 b3))) (inst r b1))
          ((steps () (by arith (list (rows (goal 1)) (rows (goal 1)))))
           (steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((rewrite (premise 4) lr lhs true ())) refl))
          refl)))
    (have hb2 (= (band (bshr v 16) 255) b2)
      (chain
        (steps
          ((rewrite (premise hs16) lr lhs true ())
           (rewrite (premise hq2) lr lhs true ())))
        (rewrite-with
          (lemma mask_byte)
          lr
          lhs
          ()
          ((steps () (by arith (rows (goal 1) (5 1) (7 256))))))
        (rewrite-with
          (lemma mod_unique)
          lr
          lhs
          ((inst q b3) (inst r b2))
          ((steps () (by arith (list (rows (goal 1)) (rows (goal 1)))))
           (steps ((rewrite (premise 5) lr lhs true ())) refl)
           (steps ((rewrite (premise 6) lr lhs true ())) refl))
          refl)))
    (have hb3 (= (band (bshr v 24) 255) b3)
      (chain
        (steps
          ((rewrite (premise hs24) lr lhs true ())
           (rewrite (premise hq3) lr lhs true ())))
        (rewrite-with
          (lemma mask_byte)
          lr
          lhs
          ()
          ((steps ((rewrite (premise 7) lr lhs true ())) refl)))
        (steps ((rewrite (premise hm3) lr lhs true ())) refl)))
    (have hl0 (= (bshl b0 24) (* 16777216 b0))
      (chain
        (rewrite-with
          (lemma shl_pow2)
          lr
          lhs
          ((inst k 24))
          ((steps ((rewrite (premise 1) lr lhs true ())) refl)
           (steps ((compute both)) refl)))
        (steps ((rewrite (lemma snw_pw24) lr lhs true ())))
        (rewrite-with
          (lemma mul_comm)
          lr
          lhs
          ((inst a b0) (inst b 16777216))
          ()
          refl)))
    (have hl1 (= (bshl b1 16) (* 65536 b1))
      (chain
        (rewrite-with
          (lemma shl_pow2)
          lr
          lhs
          ((inst k 16))
          ((steps ((rewrite (premise 3) lr lhs true ())) refl)
           (steps ((compute both)) refl)))
        (steps ((rewrite (lemma snw_pw16) lr lhs true ())))
        (rewrite-with
          (lemma mul_comm)
          lr
          lhs
          ((inst a b1) (inst b 65536))
          ()
          refl)))
    (have hl2 (= (bshl b2 8) (* 256 b2))
      (rewrite-with
        (lemma shl8_mul)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 5) lr lhs true ())) refl))
        refl))
    (steps
      ((unfold vbsw32 lhs)
       (rewrite (premise hb0) lr lhs true ())
       (rewrite (premise hb1) lr lhs true ())
       (rewrite (premise hb2) lr lhs true ())
       (rewrite (premise hb3) lr lhs true ())
       (rewrite (premise hl0) lr lhs true ())
       (rewrite (premise hl1) lr lhs true ())
       (rewrite (premise hl2) lr lhs true ())))
    (rewrite-with
      (lemma snw_bor8)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 5) lr lhs true ())) refl)
       (steps ((rewrite (premise 7) lr lhs true ())) refl)
       (steps ((rewrite (premise 8) lr lhs true ())) refl)))
    (rewrite-with
      (lemma snw_bor16)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 3) lr lhs true ())) refl)
       (steps () (by arith (rows (goal 1) (5 256) (7 1))))
       (steps () (by arith (rows (goal 1) (6 256) (8 1))))))
    (rewrite-with
      (lemma snw_bor24)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps () (by arith (rows (goal 1) (3 65536) (5 256) (7 1))))
       (steps () (by arith (rows (goal 1) (4 65536) (6 256) (8 1))))))
    (steps
      ((unfold word_be rhs))
      (by arith (list (rows (goal 1)) (rows (goal 1)))))))


;; ---- the seam kit: load/wget bounds, the per-lane bswap law, the group law,
;; ---- and the two etas -------------------------------------------------------

(claim snw_ll4_lo
  (goal ((m Mem) (a Int)) () (= (le 0 (load_le (S (S (S (S Z)))) m a)) True))
  (chain
    (steps
      ((rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_s) lr lhs true ())
       (rewrite (lemma load_le_z) lr lhs true ())))
    (have hg0 (= (le 0 (mem_get m a)) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg1 (= (le 0 (mem_get m (+ a 1))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg2 (= (le 0 (mem_get m (+ (+ a 1) 1))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg3 (= (le 0 (mem_get m (+ (+ (+ a 1) 1) 1))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (steps
      ()
      (by arith (rows (goal 1) (hg0 1) (hg1 256) (hg2 65536) (hg3 16777216))))))

(claim snw_wg_lo
  (goal ((m Mem) (a Int)) () (= (le 0 (wget m a)) True))
  (chain
    (steps ((unfold wget lhs) (unfold word_be lhs)))
    (have hg0 (= (le 0 (mem_get m a)) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg1 (= (le 0 (mem_get m (+ a 1))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg2 (= (le 0 (mem_get m (+ a 2))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg3 (= (le 0 (mem_get m (+ a 3))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (steps
      ()
      (by arith (rows (goal 1) (hg0 16777216) (hg1 65536) (hg2 256) (hg3 1))))))

(claim snw_wgb
  (goal ((m Mem) (a Int)) ()
    (= (vbsw32 (load_le (S (S (S (S Z)))) m a)) (wget m a)))
  (chain
    (have ha2 (= (+ (+ a 1) 1) (+ a 2))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have ha3 (= (+ (+ a 2) 1) (+ a 3))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have hd
      (=
        (load_le (S (S (S (S Z)))) m a)
        (+
          (mem_get m a)
          (*
            256
            (+
              (mem_get m (+ a 1))
              (* 256 (+ (mem_get m (+ a 2)) (* 256 (mem_get m (+ a 3)))))))))
      (chain
        (steps
          ((rewrite (lemma load_le_s) lr lhs true ())
           (rewrite (lemma load_le_s) lr lhs true ())
           (rewrite (lemma load_le_s) lr lhs true ())
           (rewrite (lemma load_le_s) lr lhs true ())
           (rewrite (lemma load_le_z) lr lhs true ())
           (rewrite (premise ha2) lr lhs true ())
           (rewrite (premise ha3) lr lhs true ())))
        (steps () (by arith (list (rows (goal 1)) (rows (goal 1)))))))
    (have hg0l (= (le 0 (mem_get m a)) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg0h (= (lt (mem_get m a) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg1l (= (le 0 (mem_get m (+ a 1))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg1h (= (lt (mem_get m (+ a 1)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg2l (= (le 0 (mem_get m (+ a 2))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg2h (= (lt (mem_get m (+ a 2)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg3l (= (le 0 (mem_get m (+ a 3))) True)
      (rewrite-with (lemma get_lo) lr lhs () () refl))
    (have hg3h (= (lt (mem_get m (+ a 3)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (steps ((rewrite (premise hd) lr lhs true ())))
    (rewrite-with
      (lemma snw_bsw)
      lr
      lhs
      ((inst b0 (mem_get m a))
       (inst b1 (mem_get m (+ a 1)))
       (inst b2 (mem_get m (+ a 2)))
       (inst b3 (mem_get m (+ a 3))))
      ((steps () (by arith (list (rows (goal 1)) (rows (goal 1)))))
       (steps ((rewrite (premise hg0l) lr lhs true ())) refl)
       (steps ((rewrite (premise hg0h) lr lhs true ())) refl)
       (steps ((rewrite (premise hg1l) lr lhs true ())) refl)
       (steps ((rewrite (premise hg1h) lr lhs true ())) refl)
       (steps ((rewrite (premise hg2l) lr lhs true ())) refl)
       (steps ((rewrite (premise hg2h) lr lhs true ())) refl)
       (steps ((rewrite (premise hg3l) lr lhs true ())) refl)
       (steps ((rewrite (premise hg3h) lr lhs true ())) refl)))
    (steps ((unfold wget rhs)) refl)))

(claim snw_vbs
  (goal ((m Mem) (a Int)) ()
    (=
      (vbswap (vload m a))
      (MkXmm (wget m a) (wget m (+ a 4)) (wget m (+ a 8)) (wget m (+ a 12)))))
  (steps
    ((unfold vload lhs)
     (unfold vbswap lhs)
     (unfold x0_of lhs)
     (unfold x1_of lhs)
     (unfold x2_of lhs)
     (unfold x3_of lhs)
     (reduce lhs)
     (rewrite (lemma snw_wgb) lr lhs true ()))
    refl))

(claim snw_x_eta
  (goal ((v Xmm)) () (= v (MkXmm (x0_of v) (x1_of v) (x2_of v) (x3_of v))))
  (case-on v Xmm
    ((case MkXmm
       (w0 w1 w2 w3)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

(claim snw_h8_eta
  (goal ((st H8)) ()
    (=
      (mk_h8
        (shn_ha st)
        (shn_hb st)
        (shn_hc st)
        (shn_hd st)
        (shn_he st)
        (shn_hf st)
        (shn_hg st)
        (shn_hh st))
      st))
  (case-on st H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))


;; ---- T3: the schedule walk kit — wnext intro, the free-tail 4-step law,
;; ---- the eta'd group law, and the four lane laws ----------------------------

(claim snw_wni
  (goal ((a Int) (b Int) (c Int) (d Int)) ()
    (= (m32 (+ (ssig1 d) (+ c (+ (ssig0 b) a)))) (shn_wnext a b c d)))
  (steps
    ((rewrite (lemma shn_ss1_v) lr lhs true ())
     (rewrite (lemma shn_ss0_v) lr lhs true ())
     (unfold m32 lhs)
     (unfold shn_wnext rhs)
     (unfold vm32 rhs))
    refl))

(claim snw_ext4
  (goal
    ((v1 Int)
     (v2 Int)
     (v3 Int)
     (v4 Int)
     (v5 Int)
     (v6 Int)
     (v7 Int)
     (v8 Int)
     (v9 Int)
     (v10 Int)
     (v11 Int)
     (v12 Int)
     (v13 Int)
     (v14 Int)
     (v15 Int)
     (v16 Int)
     (t (List Int))
     (f Int))
    ((= (le f 3) False))
    (=
      (sched_ext
        (Cons
          v1
          (Cons
            v2
            (Cons
              v3
              (Cons
                v4
                (Cons
                  v5
                  (Cons
                    v6
                    (Cons
                      v7
                      (Cons
                        v8
                        (Cons
                          v9
                          (Cons
                            v10
                            (Cons
                              v11
                              (Cons
                                v12
                                (Cons v13 (Cons v14 (Cons v15 (Cons v16 t))))))))))))))))
        f)
      (sched_ext
        (Cons
          (shn_wnext v13 v12 v4 (shn_wnext v15 v14 v6 v1))
          (Cons
            (shn_wnext v14 v13 v5 (shn_wnext v16 v15 v7 v2))
            (Cons
              (shn_wnext v15 v14 v6 v1)
              (Cons
                (shn_wnext v16 v15 v7 v2)
                (Cons
                  v1
                  (Cons
                    v2
                    (Cons
                      v3
                      (Cons
                        v4
                        (Cons
                          v5
                          (Cons
                            v6
                            (Cons
                              v7
                              (Cons
                                v8
                                (Cons
                                  v9
                                  (Cons
                                    v10
                                    (Cons
                                      v11
                                      (Cons
                                        v12
                                        (Cons
                                          v13
                                          (Cons v14 (Cons v15 (Cons v16 t))))))))))))))))))))
        (- f 4))))
  (chain
    (have hf0 (= (le f 0) False) (steps () (by arith (rows (goal 1) (0 1)))))
    (have hf1 (= (le (- f 1) 0) False)
      (steps () (by arith (rows (goal 1) (0 1)))))
    (have hf2 (= (le (- (- f 1) 1) 0) False)
      (steps () (by arith (rows (goal 1) (0 1)))))
    (have hf3 (= (le (- (- (- f 1) 1) 1) 0) False)
      (steps () (by arith (rows (goal 1) (0 1)))))
    (have hf4 (= (- (- (- (- f 1) 1) 1) 1) (- f 4))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (rewrite-with
      (lemma sched_ext_s)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hf0) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop m32 ssig0 ssig1 shn_wnext sched_ext))
       (rewrite (lemma snw_wni) lr lhs true ())))
    (rewrite-with
      (lemma sched_ext_s)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hf1) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop m32 ssig0 ssig1 shn_wnext sched_ext))
       (rewrite (lemma snw_wni) lr lhs true ())))
    (rewrite-with
      (lemma sched_ext_s)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hf2) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop m32 ssig0 ssig1 shn_wnext sched_ext))
       (rewrite (lemma snw_wni) lr lhs true ())))
    (rewrite-with
      (lemma sched_ext_s)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hf3) lr lhs true ())) refl)))
    (steps
      ((compute lhs (stop m32 ssig0 ssig1 shn_wnext sched_ext))
       (rewrite (lemma snw_wni) lr lhs true ())
       (rewrite (premise hf4) lr lhs true ()))
      refl)))

(claim snw_gstep
  (goal ((ga Xmm) (gb Xmm) (gc Xmm) (gd Xmm))
    ((= (shn_xlos ga) (list True True True True))
     (= (shn_xlos gb) (list True True True True))
     (= (shn_xlos gc) (list True True True True))
     (= (shn_xlos gd) (list True True True True)))
    (=
      (shn_sstep ga gb gc gd)
      (MkXmm
        (shn_wnext (x0_of ga) (x1_of ga) (x1_of gc) (x2_of gd))
        (shn_wnext (x1_of ga) (x2_of ga) (x2_of gc) (x3_of gd))
        (shn_wnext
          (x2_of ga)
          (x3_of ga)
          (x3_of gc)
          (shn_wnext (x0_of ga) (x1_of ga) (x1_of gc) (x2_of gd)))
        (shn_wnext
          (x3_of ga)
          (x0_of gb)
          (x0_of gd)
          (shn_wnext (x1_of ga) (x2_of ga) (x2_of gc) (x3_of gd))))))
  (case-on ga Xmm
    ((case MkXmm
       (w0 w1 w2 w3)
       (case-on gb Xmm
         ((case MkXmm
            (w4 w5 w6 w7)
            (case-on gc Xmm
              ((case MkXmm
                 (w8 w9 w10 w11)
                 (case-on gd Xmm
                   ((case MkXmm
                      (w12 w13 w14 w15)
                      (chain
                        (have hb0 (= (shn_blnth 0 (shn_xlos ga)) (le 0 w0))
                          (steps
                            ((rewrite (hyp 3) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht0 (= (shn_blnth 0 (shn_xlos ga)) True)
                          (steps
                            ((rewrite (premise 0) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc0 (= (le 0 w0) True)
                          (steps
                            ((rewrite (premise hb0) rl lhs true ())
                             (rewrite (premise ht0) lr lhs true ()))
                            refl))
                        (have hb1 (= (shn_blnth 1 (shn_xlos ga)) (le 0 w1))
                          (steps
                            ((rewrite (hyp 3) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht1 (= (shn_blnth 1 (shn_xlos ga)) True)
                          (steps
                            ((rewrite (premise 0) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc1 (= (le 0 w1) True)
                          (steps
                            ((rewrite (premise hb1) rl lhs true ())
                             (rewrite (premise ht1) lr lhs true ()))
                            refl))
                        (have hb2 (= (shn_blnth 2 (shn_xlos ga)) (le 0 w2))
                          (steps
                            ((rewrite (hyp 3) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht2 (= (shn_blnth 2 (shn_xlos ga)) True)
                          (steps
                            ((rewrite (premise 0) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc2 (= (le 0 w2) True)
                          (steps
                            ((rewrite (premise hb2) rl lhs true ())
                             (rewrite (premise ht2) lr lhs true ()))
                            refl))
                        (have hb3 (= (shn_blnth 3 (shn_xlos ga)) (le 0 w3))
                          (steps
                            ((rewrite (hyp 3) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht3 (= (shn_blnth 3 (shn_xlos ga)) True)
                          (steps
                            ((rewrite (premise 0) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc3 (= (le 0 w3) True)
                          (steps
                            ((rewrite (premise hb3) rl lhs true ())
                             (rewrite (premise ht3) lr lhs true ()))
                            refl))
                        (have hb4 (= (shn_blnth 0 (shn_xlos gb)) (le 0 w4))
                          (steps
                            ((rewrite (hyp 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht4 (= (shn_blnth 0 (shn_xlos gb)) True)
                          (steps
                            ((rewrite (premise 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc4 (= (le 0 w4) True)
                          (steps
                            ((rewrite (premise hb4) rl lhs true ())
                             (rewrite (premise ht4) lr lhs true ()))
                            refl))
                        (have hb5 (= (shn_blnth 1 (shn_xlos gb)) (le 0 w5))
                          (steps
                            ((rewrite (hyp 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht5 (= (shn_blnth 1 (shn_xlos gb)) True)
                          (steps
                            ((rewrite (premise 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc5 (= (le 0 w5) True)
                          (steps
                            ((rewrite (premise hb5) rl lhs true ())
                             (rewrite (premise ht5) lr lhs true ()))
                            refl))
                        (have hb6 (= (shn_blnth 2 (shn_xlos gb)) (le 0 w6))
                          (steps
                            ((rewrite (hyp 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht6 (= (shn_blnth 2 (shn_xlos gb)) True)
                          (steps
                            ((rewrite (premise 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc6 (= (le 0 w6) True)
                          (steps
                            ((rewrite (premise hb6) rl lhs true ())
                             (rewrite (premise ht6) lr lhs true ()))
                            refl))
                        (have hb7 (= (shn_blnth 3 (shn_xlos gb)) (le 0 w7))
                          (steps
                            ((rewrite (hyp 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht7 (= (shn_blnth 3 (shn_xlos gb)) True)
                          (steps
                            ((rewrite (premise 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc7 (= (le 0 w7) True)
                          (steps
                            ((rewrite (premise hb7) rl lhs true ())
                             (rewrite (premise ht7) lr lhs true ()))
                            refl))
                        (have hb8 (= (shn_blnth 0 (shn_xlos gc)) (le 0 w8))
                          (steps
                            ((rewrite (hyp 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht8 (= (shn_blnth 0 (shn_xlos gc)) True)
                          (steps
                            ((rewrite (premise 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc8 (= (le 0 w8) True)
                          (steps
                            ((rewrite (premise hb8) rl lhs true ())
                             (rewrite (premise ht8) lr lhs true ()))
                            refl))
                        (have hb9 (= (shn_blnth 1 (shn_xlos gc)) (le 0 w9))
                          (steps
                            ((rewrite (hyp 1) lr lhs true ()) (compute lhs))
                            refl))
                        (have ht9 (= (shn_blnth 1 (shn_xlos gc)) True)
                          (steps
                            ((rewrite (premise 2) lr lhs true ()) (compute lhs))
                            refl))
                        (have hc9 (= (le 0 w9) True)
