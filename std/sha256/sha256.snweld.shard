;; reads fully below 131008 pass the H-home store pair untouched.
(claim snw_hb2
  (goal ((m Mem) (st H8) (p Int)) ((= (le (+ p 16) 131008) True))
    (= (vload (shnw_hmem m st) p) (vload m p)))
