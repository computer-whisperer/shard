     (v12 Xmm)
     (v13 Xmm)
     (v14 Xmm)
     (v15 Xmm))
    ((= (vload m 130496) (vbswap_mask))
     (= (le 65536 src) True)
     (= (le (+ src (* 64 (int_of_nat k))) 130496) True)
     (= (vload m 130752) (shn_kg 0))
     (= (vload m 130768) (shn_kg 1))
