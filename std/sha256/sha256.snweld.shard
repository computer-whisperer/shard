;; ---- the fold descriptors (shx_mem's mirrors one tier up) --------------------------

;; the H-home readback as the tier's H8 (lanes are LE dwords, a..d low).
(fn snw_hst ((m Mem)) H8
  (mk_h8
    (x0_of (vload m 131008))
    (x1_of (vload m 131008))
    (x2_of (vload m 131008))
    (x3_of (vload m 131008))
    (x0_of (vload m 131024))
    (x1_of (vload m 131024))
    (x2_of (vload m 131024))
    (x3_of (vload m 131024))))

;; one block's state step: shn_block of the H readback over the four
;; byte-flipped message groups at src (addresses spelled exactly as the
;; stanza chain leaves them).
(fn snw_blk ((m Mem) (src Int)) H8
  (shn_block
    (snw_hst m)
    (vbswap (vload m src))
    (vbswap (vload m (+ src 16)))
    (vbswap (vload m (+ (+ src 16) 16)))
    (vbswap (vload m (+ (+ (+ src 16) 16) 16)))))

;; the loop's memory effect: k blocks folded through the H home, the
;; source window advancing 64 per block. NOTHING else moves -- no W
;; scribbles, no spills (the leaf's whole memory footprint is the two
;; H-home stores per block).
(fn snw_fmem ((m Mem) (src Int) (k Nat)) Mem
  (measure (struct k))
  (match k
    (Z m)
    ((S k2) (snw_fmem (shnw_hmem m (snw_blk m src)) (+ src 64) k2))))

(claim snw_fmem_z
  (goal ((m Mem) (src Int)) () (= (snw_fmem m src Z) m))
  (steps ((unfold snw_fmem lhs) (reduce lhs)) refl))

(claim snw_fmem_s
  (goal ((m Mem) (src Int) (k Nat)) ()
    (=
      (snw_fmem m src (S k))
      (snw_fmem (shnw_hmem m (snw_blk m src)) (+ src 64) k)))
  (steps ((unfold snw_fmem lhs) (reduce lhs)) refl))

;; the loop's XMM-file effect, one iteration: the summit walk's final
