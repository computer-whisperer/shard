(claim snw_bor8
  (goal ((a Int) (b Int))
    ((= (le 0 a) True) (= (le 0 b) True) (= (lt b 256) True))
    (= (bor (* 256 a) b) (+ (* 256 a) b)))
  (chain
    (have hml (= (* 256 a) (* (pow2 8) a))
      (steps ((rewrite (lemma snw_pw8) lr rhs true ())) refl))
    (steps ((rewrite (premise hml) lr both true ())))
    (rewrite-with
