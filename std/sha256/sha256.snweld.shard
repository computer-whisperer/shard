;; ---- T4: the elementwise-nonneg (slo) pipeline — mem_read / words16 /
;; ---- sched_ext / srev_acc / sha_sched, riding imp's slo kit ----------------

(claim snw_slo_cons
  (goal ((h Int) (t (List Int))) ((= (le 0 h) True) (= (slo t) True))
    (= (slo (Cons h t)) True))
  (steps
    ((unfold slo lhs)
     (reduce lhs)
     (rewrite (premise 0) lr lhs true ())
     (compute lhs (stop slo))
     (rewrite (premise 1) lr lhs true ()))
    refl))

(claim snw_snth_lo
  (goal ((n Int) (xs (List Int))) ((= (slo xs) True))
    (= (le 0 (snth n xs)) True))
  (induct xs
    ((case Nil (steps ((compute lhs)) refl))
     (case Cons
       (h t)
       (case-on (le n 0) Bool
         ((case True
            (chain
              (have hh (= (le 0 h) True)
                (rewrite-with
                  (lemma ish_slo_hd)
                  lr
                  lhs
                  ((inst t t))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold snth lhs)
                 (reduce lhs)
                 (rewrite (hyp True) lr lhs true ())
                 (compute lhs)
                 (rewrite (premise hh) lr lhs true ()))
                refl)))
          (case False
            (chain
              (have ht (= (slo t) True)
                (rewrite-with
                  (lemma ish_slo_tl)
                  lr
                  lhs
                  ((inst h h))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold snth lhs)
                 (reduce lhs)
                 (rewrite (hyp False) lr lhs true ())
                 (compute lhs (stop snth))))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ()
                ((steps ((rewrite (premise ht) lr lhs true ())) refl))
                refl)))))))))

(claim snw_slo_read
  (goal ((w Nat) (m Mem) (a Int)) () (= (slo (mem_read w m a)) True))
  (induct w
    ((case Z
       (steps ((rewrite (lemma mem_read_z) lr lhs true ()) (compute lhs)) refl))
     (case S
       (w2)
       (chain
         (have hg (= (le 0 (mem_get m a)) True)
           (rewrite-with (lemma get_lo) lr lhs () () refl))
         (steps
           ((rewrite (lemma mem_read_s) lr lhs true ())
            (unfold slo lhs)
            (reduce lhs)
            (rewrite (premise hg) lr lhs true ())
            (compute lhs (stop slo mem_read))))
         (rewrite-with (hyp 0) lr lhs () () refl))))))

(claim snw_slo_drop
  (goal ((n Int) (xs (List Int))) ((= (slo xs) True))
    (= (slo (sdrop n xs)) True))
  (induct xs
    ((case Nil (steps ((unfold sdrop lhs) (reduce lhs) (compute lhs)) refl))
     (case Cons
       (h t)
       (case-on (le n 0) Bool
         ((case True
            (steps
              ((unfold sdrop lhs)
               (reduce lhs)
               (rewrite (hyp True) lr lhs true ())
               (compute lhs (stop slo))
               (rewrite (premise 0) lr lhs true ()))
              refl))
          (case False
            (chain
              (have ht (= (slo t) True)
                (rewrite-with
                  (lemma ish_slo_tl)
                  lr
                  lhs
                  ((inst h h))
                  ((steps ((rewrite (premise 0) lr lhs true ())) refl))
                  refl))
              (steps
                ((unfold sdrop lhs)
                 (reduce lhs)
                 (rewrite (hyp False) lr lhs true ())
                 (compute lhs (stop slo sdrop))))
              (rewrite-with
                (hyp 1)
                lr
                lhs
                ()
                ((steps ((rewrite (premise ht) lr lhs true ())) refl))
                refl)))))))))

(claim snw_slo_w16
  (goal ((bs (List Int)) (f Int)) ((= (slo bs) True))
    (= (slo (words16 bs f)) True))
  (wf-induct f
    (case-on (le f 0) Bool
      ((case True
         (steps
           ((unfold words16 lhs)
            (rewrite (hyp True) lr lhs true ())
            (compute lhs))
           refl))
       (case False
         (chain
           (have hf (= (le f 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hs0 (= (le 0 (snth 0 bs)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hs1 (= (le 0 (snth 1 bs)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hs2 (= (le 0 (snth 2 bs)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hs3 (= (le 0 (snth 3 bs)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hw
             (=
               (le 0 (word_be (snth 0 bs) (snth 1 bs) (snth 2 bs) (snth 3 bs)))
               True)
             (steps
               ((unfold word_be lhs))
               (by
                 arith
                 (rows (goal 1) (hs0 16777216) (hs1 65536) (hs2 256) (hs3 1)))))
           (have hdr (= (slo (sdrop 4 bs)) True)
             (rewrite-with
               (lemma snw_slo_drop)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hwt (= (slo (words16 (sdrop 4 bs) (- f 1))) True)
             (rewrite-with
               (hyp 1)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hdr) lr lhs true ())) refl)
                (by arith (rows (goal 1) (hf 1)))
                (by arith (rows (goal 1))))
               refl))
           (steps
             ((unfold words16 lhs)
              (rewrite (premise hf) lr lhs true ())
              (compute lhs (stop slo word_be snth sdrop words16))))
           (rewrite-with
             (lemma snw_slo_cons)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hw) lr lhs true ())) refl)
              (steps ((rewrite (premise hwt) lr lhs true ())) refl))
             refl)))))))

(claim snw_slo_ext
  (goal ((ws (List Int)) (f Int)) ((= (slo ws) True))
    (= (slo (sched_ext ws f)) True))
  (wf-induct f
    (case-on (le f 0) Bool
      ((case True
         (steps
           ((unfold sched_ext lhs)
            (rewrite (hyp True) lr lhs true ())
            (compute lhs (stop slo))
            (rewrite (premise 0) lr lhs true ()))
           refl))
       (case False
         (chain
           (have hf (= (le f 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hn1 (= (le 0 (snth 1 ws)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hn6 (= (le 0 (snth 6 ws)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hn14 (= (le 0 (snth 14 ws)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hn15 (= (le 0 (snth 15 ws)) True)
             (rewrite-with
               (lemma snw_snth_lo)
               lr
               lhs
               ()
               ((steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (have hss1 (= (le 0 (ssig1 (snth 1 ws))) True)
             (chain
               (steps ((rewrite (lemma shn_ss1_v) lr lhs true ())))
               (rewrite-with
                 (lemma shn_ss1_lo)
                 lr
                 lhs
                 ()
                 ((steps ((rewrite (premise hn1) lr lhs true ())) refl))
                 refl)))
           (have hss0 (= (le 0 (ssig0 (snth 14 ws))) True)
             (chain
               (steps ((rewrite (lemma shn_ss0_v) lr lhs true ())))
               (rewrite-with
                 (lemma shn_ss0_lo)
                 lr
                 lhs
                 ()
                 ((steps ((rewrite (premise hn14) lr lhs true ())) refl))
                 refl)))
           (have hsum
             (=
               (le
                 0
                 (+
                   (ssig1 (snth 1 ws))
                   (+ (snth 6 ws) (+ (ssig0 (snth 14 ws)) (snth 15 ws)))))
               True)
             (steps
               ()
               (by arith (rows (goal 1) (hss1 1) (hn6 1) (hss0 1) (hn15 1)))))
           (have hnew
             (=
               (le
                 0
                 (m32
                   (+
                     (ssig1 (snth 1 ws))
                     (+ (snth 6 ws) (+ (ssig0 (snth 14 ws)) (snth 15 ws))))))
               True)
             (chain
               (steps ((unfold m32 lhs)))
               (rewrite-with
                 (lemma band_lo)
                 lr
                 lhs
                 ()
                 ((steps ((rewrite (premise hsum) lr lhs true ())) refl)
                  (steps ((compute both)) refl))
                 refl)))
           (have hcons
             (=
               (slo
                 (Cons
                   (m32
                     (+
                       (ssig1 (snth 1 ws))
                       (+ (snth 6 ws) (+ (ssig0 (snth 14 ws)) (snth 15 ws)))))
                   ws))
               True)
             (rewrite-with
               (lemma snw_slo_cons)
               lr
               lhs
               ()
               ((steps ((rewrite (premise hnew) lr lhs true ())) refl)
                (steps ((rewrite (premise 0) lr lhs true ())) refl))
               refl))
           (steps
             ((unfold sched_ext lhs)
              (rewrite (premise hf) lr lhs true ())
              (compute lhs (stop slo m32 ssig0 ssig1 snth sched_ext))))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hcons) lr lhs true ())) refl)
              (by arith (rows (goal 1) (hf 1)))
              (by arith (rows (goal 1))))
             refl)))))))

(claim snw_slo_rev
  (goal ((xs (List Int)) (acc (List Int)))
    ((= (slo xs) True) (= (slo acc) True))
    (= (slo (srev_acc xs acc)) True))
  (induct xs
    ((case Nil
       (steps
         ((unfold srev_acc lhs)
          (reduce lhs)
          (rewrite (premise 1) lr lhs true ()))
         refl))
     (case Cons
       (h t)
       (chain
         (have hh (= (le 0 h) True)
           (rewrite-with
             (lemma ish_slo_hd)
             lr
             lhs
             ((inst t t))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have ht (= (slo t) True)
           (rewrite-with
             (lemma ish_slo_tl)
             lr
             lhs
             ((inst h h))
             ((steps ((rewrite (premise 0) lr lhs true ())) refl))
             refl))
         (have hca (= (slo (Cons h acc)) True)
           (rewrite-with
             (lemma snw_slo_cons)
             lr
             lhs
             ()
             ((steps ((rewrite (premise hh) lr lhs true ())) refl)
              (steps ((rewrite (premise 1) lr lhs true ())) refl))
             refl))
         (steps ((unfold srev_acc lhs) (reduce lhs)))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise ht) lr lhs true ())) refl)
            (steps ((rewrite (premise hca) lr lhs true ())) refl))
           refl))))))

(claim snw_slo_sched
  (goal ((bs (List Int))) ((= (slo bs) True)) (= (slo (sha_sched bs)) True))
  (chain
    (have h16 (= (slo (words16 bs 16)) True)
      (rewrite-with
        (lemma snw_slo_w16)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl))
        refl))
    (have hrv (= (slo (srev_acc (words16 bs 16) Nil)) True)
      (rewrite-with
        (lemma snw_slo_rev)
        lr
        lhs
        ()
        ((steps ((rewrite (premise h16) lr lhs true ())) refl)
         (steps ((compute lhs)) refl))
        refl))
    (have hex (= (slo (sched_ext (srev_acc (words16 bs 16) Nil) 48)) True)
      (rewrite-with
        (lemma snw_slo_ext)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hrv) lr lhs true ())) refl))
        refl))
    (steps ((unfold sha_sched lhs)))
    (rewrite-with
      (lemma snw_slo_rev)
      lr
      lhs
      ()
      ((steps ((rewrite (premise hex) lr lhs true ())) refl)
       (steps ((compute lhs)) refl))
      refl)))


;; ---- the los bridge, the m32 bound lemmas, THE PER-BLOCK TIE, and the
;; ---- 32-bit-lane bounds of the block ----------------------------------------

(claim snw_losbr
  (goal ((st H8)) () (= (h8_los st) (shn_los st)))
  (case-on st H8
    ((case mk_h8
       (xa xb xc xd xe xf xg xh)
       (steps ((rewrite (hyp 0) lr both true ()) (compute both)) refl)))))

(claim snw_m32_lo
  (goal ((x Int)) ((= (le 0 x) True)) (= (le 0 (m32 x)) True))
  (chain
    (steps ((unfold m32 lhs)))
    (rewrite-with
      (lemma band_lo)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((compute both)) refl))
      refl)))

(claim snw_m32_hi
  (goal ((x Int)) ((= (le 0 x) True)) (= (lt (m32 x) 4294967296) True))
  (chain
    (have hle (= (le (band x 4294967295) 4294967295) True)
      (rewrite-with
        (lemma band_le_r)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((compute both)) refl))
        refl))
    (steps ((unfold m32 lhs)) (by arith (rows (goal 1) (hle 1))))))

(claim snw_blockm
  (goal ((st H8) (m Mem) (src Int))
    ((= (shn_los st) (list True True True True True True True True)))
    (=
      (shn_block
        st
        (vbswap (vload m src))
        (vbswap (vload m (+ src 16)))
        (vbswap (vload m (+ (+ src 16) 16)))
        (vbswap (vload m (+ (+ (+ src 16) 16) 16))))
      (sha_block st (mem_read 64 m src))))
  (chain
    (have h32 (= (+ (+ src 16) 16) (+ src 32))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h48 (= (+ (+ (+ src 16) 16) 16) (+ src 48))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (steps
      ((rewrite (premise h48) lr lhs true ())
       (rewrite (premise h32) lr lhs true ())
       (rewrite (lemma snw_vbs) lr lhs true ())))
    (have h20 (= (+ (+ src 16) 4) (+ src 20))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h24 (= (+ (+ src 16) 8) (+ src 24))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h28 (= (+ (+ src 16) 12) (+ src 28))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h36 (= (+ (+ src 32) 4) (+ src 36))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h40 (= (+ (+ src 32) 8) (+ src 40))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h44 (= (+ (+ src 32) 12) (+ src 44))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h52 (= (+ (+ src 48) 4) (+ src 52))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h56 (= (+ (+ src 48) 8) (+ src 56))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (have h60 (= (+ (+ src 48) 12) (+ src 60))
      (steps () (by arith (list (rows (goal 1)) (rows (goal 1))))))
    (steps
      ((rewrite (premise h20) lr lhs true ())
       (rewrite (premise h24) lr lhs true ())
       (rewrite (premise h28) lr lhs true ())
       (rewrite (premise h36) lr lhs true ())
       (rewrite (premise h40) lr lhs true ())
       (rewrite (premise h44) lr lhs true ())
       (rewrite (premise h52) lr lhs true ())
       (rewrite (premise h56) lr lhs true ())
       (rewrite (premise h60) lr lhs true ())))
    (rewrite-with
      (lemma shn_blockw)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps
         ((compute lhs (stop wget)) (rewrite (lemma snw_wg_lo) lr lhs true ()))
         refl)
       (steps
         ((compute lhs (stop wget)) (rewrite (lemma snw_wg_lo) lr lhs true ()))
         refl)
       (steps
         ((compute lhs (stop wget)) (rewrite (lemma snw_wg_lo) lr lhs true ()))
         refl)
       (steps
         ((compute lhs (stop wget)) (rewrite (lemma snw_wg_lo) lr lhs true ()))
         refl)))
    (steps
      ((rewrite (lemma snw_sched16) lr lhs true ()) (unfold sha_block rhs))
      refl)))

(fn snw_ls32 ((st H8)) (List Bool)
  (match st
    ((mk_h8 a b c d e f g h)
     (list
       (le 0 a)
       (lt a 4294967296)
       (le 0 b)
       (lt b 4294967296)
       (le 0 c)
       (lt c 4294967296)
       (le 0 d)
       (lt d 4294967296)
       (le 0 e)
       (lt e 4294967296)
       (le 0 f)
       (lt f 4294967296)
       (le 0 g)
       (lt g 4294967296)
       (le 0 h)
       (lt h 4294967296)))))

(claim snw_l32m
  (goal
    ((xa Int)
     (xb Int)
     (xc Int)
     (xd Int)
     (xe Int)
     (xf Int)
     (xg Int)
     (xh Int)
     (m Mem)
     (src Int))
    ((= (le 0 xa) True)
     (= (le 0 xb) True)
     (= (le 0 xc) True)
     (= (le 0 xd) True)
     (= (le 0 xe) True)
     (= (le 0 xf) True)
     (= (le 0 xg) True)
     (= (le 0 xh) True))
    (=
      (snw_ls32 (sha_block (mk_h8 xa xb xc xd xe xf xg xh) (mem_read 64 m src)))
      (list True True True True True True True True True True True True True
        True True True)))
  (chain
    (have hsl (= (slo (mem_read 64 m src)) True)
      (rewrite-with (lemma snw_slo_read) lr lhs () () refl))
    (have hsc (= (slo (sha_sched (mem_read 64 m src))) True)
      (rewrite-with
        (lemma snw_slo_sched)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl) lr lhs true ())) refl))
        refl))
    (have hlk (= (slo (sha_k)) True)
      (steps ((rewrite (lemma ish_slo_shak) lr lhs true ())) refl))
    (have hrl
      (=
        (h8_los
          (sha_rounds
            (mk_h8 xa xb xc xd xe xf xg xh)
            (sha_k)
            (sha_sched (mem_read 64 m src))))
        (list True True True True True True True True))
      (rewrite-with
        (lemma ish_srounds_los)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 1) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise 3) lr lhs true ())) refl)
         (steps ((rewrite (premise 4) lr lhs true ())) refl)
         (steps ((rewrite (premise 5) lr lhs true ())) refl)
         (steps ((rewrite (premise 6) lr lhs true ())) refl)
         (steps ((rewrite (premise 7) lr lhs true ())) refl)
         (steps ((rewrite (premise hlk) lr lhs true ())) refl)
         (steps ((rewrite (premise hsc) lr lhs true ())) refl))
        refl))
    (have hsl8
      (=
        (shn_los
          (sha_rounds
            (mk_h8 xa xb xc xd xe xf xg xh)
            (sha_k)
            (sha_sched (mem_read 64 m src))))
        (list True True True True True True True True))
      (steps
        ((rewrite (lemma snw_losbr) rl lhs true ())
         (rewrite (premise hrl) lr lhs true ()))
        refl))
    (have hra
      (=
        (le
          0
          (shn_ha
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_a)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrb
      (=
        (le
          0
          (shn_hb
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_b)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrc
      (=
        (le
          0
          (shn_hc
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_c)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrd
      (=
        (le
          0
          (shn_hd
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_d)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hre
      (=
        (le
          0
          (shn_he
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_e)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrf
      (=
        (le
          0
          (shn_hf
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_f)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrg
      (=
        (le
          0
          (shn_hg
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_g)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (have hrh
      (=
        (le
          0
          (shn_hh
            (sha_rounds
              (mk_h8 xa xb xc xd xe xf xg xh)
              (sha_k)
              (sha_sched (mem_read 64 m src)))))
        True)
      (rewrite-with
        (lemma shn_los_h)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hsl8) lr lhs true ())) refl))
        refl))
    (steps ((unfold sha_block lhs)))
    (rewrite-with
      (lemma snw_h8_eta)
      rl
      lhs
      ((inst
         st
         (sha_rounds
           (mk_h8 xa xb xc xd xe xf xg xh)
           (sha_k)
           (sha_sched (mem_read 64 m src)))))
      ())
    (steps
      ((compute
         lhs
         (stop sha_rounds sha_sched mem_read sha_k wget m32 shn_ha shn_hb shn_hc
           shn_hd shn_he shn_hf shn_hg shn_hh))))
    (rewrite-with
      (lemma snw_m32_lo)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1) (hra 1))))))
    (rewrite-with
      (lemma snw_m32_hi)
      lr
      lhs
      ()
