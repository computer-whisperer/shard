      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma snw_read_sle)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma snw_read_sle)
      lr
      lhs
      ()
      ((steps () (by arith (rows (goal 1) (0 1))))))
