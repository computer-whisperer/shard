(claim snw_xv0_lo
  (goal ((m Mem) (p Int)) () (= (le 0 (x0_of (vload m p))) True))
  (steps
    ((unfold vload lhs)
     (unfold x0_of lhs)
     (reduce lhs)
     (rewrite (lemma snw_ll4_lo) lr lhs true ()))
    refl))

