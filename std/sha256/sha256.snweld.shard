;; ---- T5: the vload/vstore round trip, the H round trip, the fold frame,
;; ---- and THE TIE -------------------------------------------------------------

(claim snw_vls
  (goal ((m Mem) (p Int) (x0 Int) (x1 Int) (x2 Int) (x3 Int))
    ((= (le 0 x0) True)
     (= (lt x0 4294967296) True)
     (= (le 0 x1) True)
     (= (lt x1 4294967296) True)
     (= (le 0 x2) True)
     (= (lt x2 4294967296) True)
     (= (le 0 x3) True)
     (= (lt x3 4294967296) True))
    (= (vload (vstore m p (MkXmm x0 x1 x2 x3)) p) (MkXmm x0 x1 x2 x3)))
  (chain
    (steps
      ((unfold vstore lhs)
       (unfold vload lhs)
       (unfold x0_of lhs)
       (unfold x1_of lhs)
       (unfold x2_of lhs)
       (unfold x3_of lhs)
       (unfold x0_of lhs)
       (unfold x1_of lhs)
       (unfold x2_of lhs)
       (unfold x3_of lhs)
       (unfold x0_of lhs)
       (unfold x1_of lhs)
       (unfold x2_of lhs)
       (unfold x3_of lhs)
       (unfold x0_of lhs)
       (unfold x1_of lhs)
       (unfold x2_of lhs)
       (unfold x3_of lhs)
       (reduce lhs)))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x3))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x2))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x1))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x3))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x2))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma snw_llb)
      lr
      lhs
      ((inst v x3))
      ((steps () (by arith (rows (goal 1))))))
    (rewrite-with
      (lemma ls4_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)))
    (rewrite-with
      (lemma ls4_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (rewrite-with
      (lemma ls4_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 4) lr lhs true ())) refl)
       (steps ((rewrite (premise 5) lr lhs true ())) refl)))
    (rewrite-with
      (lemma ls4_id)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 6) lr lhs true ())) refl)
       (steps ((rewrite (premise 7) lr lhs true ())) refl))
      refl)))

