;;; sha256.snweld.shard — THE SHA-NI STREAMING WELD: the fused fold
;;; leaf, its walks, THE GROUP->BYTES TIE, and the wveval fold seam
;;; (Arc B rung B5, E3 slice B + slice C part 1 — docs/STREAM.md §8.4;
;;; landed from e3b_probe 2026-08-09). sha256.sweld's analog one
;;; register file up: where sweld welds the SCALAR streaming bin's
;;; callees, this file welds the variant bin's fn 1.
;;;
;;; THE LEAF (snw_wrap): ONE fused call-free XMM-bearing body — the
;;; SHA-NI block fold — mirroring the scalar fold caller's contract
;;; (sst_xfold_run) exactly at the boundary:
;;;   ENTRY (arity 2): RDI = src (first block address), RSI = block
;;;   count; RAX/RCX/RBX/RBP/R8..R15 zero (caller-guaranteed);
;;;   RDX/R12 arbitrary junk (overwritten); the XMM file arbitrary.
;;;   EXIT: every GPR zero except R12 = src + 64k (the advanced
;;;   cursor); the WHOLE XMM file zeroed (the M3 re-zero discipline
;;;   extended to XMMs); memory = the per-block H-home stores plus
;;;   the entry/exit H byte-swap conversions, nothing else (no W
;;;   scribbles, no spill cells).
;;;
;;; THE H CONVERSIONS (the ratified endianness lean): the skeleton's
;;; H window is BIG-endian (wget/word_be) but the leaf's vload/vstore
;;; are LE — the wrapper converts at entry and exit (mask load, both
;;; H groups 131008/131024, XVBswap32, store back) so the window
;;; stays BE at every boundary the absorber/finalizer see; the loop
;;; sees LE. The XMM zero source is an XVLoad from 130512 (a dead,
;;; never-written cell in the dead W frame) — the tier has no pxor
;;; species; it costs ONE vload-zero premise at the seam.
;;;
;;; The ladder: the 18 module-general stanza laws (snw_law_*), the
;;; separation kit, the per-iteration walk, the loop walk snw_xloop
;;; (S^230(lg_fuel k c)), the run form snw_xrun, THE TIE snw_tie
;;; (snw_hst of the fold memory = shb_fold) + snw_blocks_read (the
;;; sweld bridge ssr_fold_read composes VERBATIM), and the seam stack
;;; snw_xseq -> snw_xcall -> snw_wcall (wveval_call grain, the form
;;; the variant bin's absorber/finalizer twins cite at their XCall-1
;;; sites). Ground validation was e3b_run.shard (fold differential
;;; 7/7 at the real BE boundary + convention teeth).

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/bits")
(use (:: std bits *))
(import "../../std/mem")
(use (:: std mem *))
(import "../../std/nat.shard")
(use (:: std nat *))
(import "../../models/wasm/loopkit.shard")
(use (:: models wasm loopkit *))
(import "sha256.shard")
(use (:: std sha256 sha256 *))
(import "../../models/x86/x86.shard")
(use (:: models x86 x86 *))
(import "../../models/x86/vector.shard")
(use (:: models x86 vector *))
(import "sha256.shani.shard")
(use (:: std sha256 sha256.shani *))
(import "sha256.imp.shard")
(use (:: std sha256 sha256.imp *))
(import "sha256.weld.shard")
(use (:: std sha256 sha256.weld *))
(import "sha256.sweld.shard")
(use (:: std sha256 sha256.sweld *))
(import "../../models/linux/kernel.shard")
(use (:: models linux kernel *))
(import "../../models/x86/world.shard")
(use (:: models x86 world *))
(import "../../models/x86/vworld.shard")
(use (:: models x86 vworld *))
(import "sha256.shaniw.shard")
(use (:: std sha256 sha256.shaniw *))

;; ---- the loop tail: complete the 64-byte stride, count down, re-zero the
;; ---- scalar scratch (R10/R11 -- the M3 re-zero discipline applied PER
;; ---- ITERATION so the loop invariant's register file is uniform across
;; ---- k = 0 and k >= 1), back edge ----

(fn snw_tail () (List XInstr)
  (list
    (XBin XAdd RDI (SImm 16))
    (XBin XSub RDX (SImm 1))
    (XMovRI R10 0)
    (XMovRI R11 0)
    (XBr 0)))

;; ---- the loop body: exit test, the rebased hand body, the tail ----
;; (the stanza composition with a LIVE tail — shnw_body is the same
;; nesting closed at Nil; the stanza walk laws are free-tail, so the
;; per-iteration walk re-composes them against (snw_tail))

(fn snw_lbody () (List XInstr)
  (Cons
    (XBrIf (CEqz RDX) 1)
    (shnw_pro
      (shnw_q0
        (shnw_q1
          (shnw_q2
            (shnw_q3
              (shnw_q4
                (shnw_q5
                  (shnw_q6
                    (shnw_q7
                      (shnw_q8
                        (shnw_q9
                          (shnw_q10
                            (shnw_q11
                              (shnw_q12
                                (shnw_q13
                                  (shnw_q14 (shnw_q15 (shnw_epi (snw_tail)))))))))))))))))))))

;; ---- the whole leaf: fn 1's body (arity 2) ----

(fn snw_wrap () (List XInstr)
  (list
    (XMovRR RDX RSI)
    (XMovRI RSI 0)
    (XMovRI R10 130496)
    (XVec (XVLoad XMM2 (AReg R10)))
    (XMovRI R10 131008)
    (XMovRI R11 131024)
    (XVec (XVLoad XMM0 (AReg R10)))
    (XVec (XVLoad XMM1 (AReg R11)))
    (XVec (XVBswap32 XMM0 XMM2))
    (XVec (XVBswap32 XMM1 XMM2))
    (XVec (XVStore (AReg R10) XMM0))
    (XVec (XVStore (AReg R11) XMM1))
    (XMovRI R10 0)
    (XMovRI R11 0)
    (XBlock (list (XLoop (snw_lbody))))
    (XMovRR R12 RDI)
    (XMovRI RDI 0)
    (XMovRI R10 130496)
    (XVec (XVLoad XMM2 (AReg R10)))
    (XMovRI R10 131008)
    (XMovRI R11 131024)
    (XVec (XVLoad XMM0 (AReg R10)))
    (XVec (XVLoad XMM1 (AReg R11)))
    (XVec (XVBswap32 XMM0 XMM2))
    (XVec (XVBswap32 XMM1 XMM2))
    (XVec (XVStore (AReg R10) XMM0))
    (XVec (XVStore (AReg R11) XMM1))
    (XMovRI R10 130512)
    (XVec (XVLoad XMM0 (AReg R10)))
    (XVec (XVLoad XMM1 (AReg R10)))
    (XVec (XVLoad XMM2 (AReg R10)))
    (XVec (XVLoad XMM3 (AReg R10)))
    (XVec (XVLoad XMM4 (AReg R10)))
    (XVec (XVLoad XMM5 (AReg R10)))
    (XVec (XVLoad XMM6 (AReg R10)))
    (XVec (XVLoad XMM7 (AReg R10)))
    (XVec (XVLoad XMM8 (AReg R10)))
    (XVec (XVLoad XMM9 (AReg R10)))
    (XVec (XVLoad XMM10 (AReg R10)))
    (XVec (XVLoad XMM11 (AReg R10)))
    (XVec (XVLoad XMM12 (AReg R10)))
    (XVec (XVLoad XMM13 (AReg R10)))
    (XVec (XVLoad XMM14 (AReg R10)))
    (XVec (XVLoad XMM15 (AReg R10)))
    (XMovRI R10 0)
    (XMovRI R11 0)))

;; ---- the probe module: fn 0 dead stub, fn 1 the leaf ----
;; (the real variant module keeps the scalar block dead at fn 0 for
;; index stability; a stub serves the probe's ground runs)

(fn snw_m () XModule
  (MkXModule
    (Cons (MkXFunc 0 Nil) (Cons (MkXFunc 2 (snw_wrap)) Nil))
    65536
    131072))

;; ==== THE MODULE-GENERAL STANZA LAWS ================================================
;;
;; e3a_probe's stanza laws restated over a QUANTIFIED function list
;; (MkXModule fs 65536 131072): the walk only touches the module through
;; xmemlo_of/xmemhi_of (which reduce on the constructor regardless of fs),
;; so the same proofs land verbatim -- and ONE law block now serves the
;; probe module (snw_m), the loop walk, and slice C's full variant module.
;; Generated from e3a_probe.shard's block by: claim rename shnw_law_ ->
;; snw_law_, (shnw_m) -> (MkXModule fs 65536 131072), + the fs binder.
(claim snw_law_q0
  (goal
    ((f Nat)
     (fs (List XFunc))
     (rest (List XInstr))
     (mem Mem)
     (a0 Int)
     (a1 Int)
     (a2 Int)
     (a3 Int)
     (a4 Int)
     (a5 Int)
     (a6 Int)
     (a7 Int)
     (a8 Int)
     (a9 Int)
     (a10 Int)
     (a11 Int)
     (a12 Int)
     (a13 Int)
     (a14 Int)
     (v0 Xmm)
     (v1 Xmm)
     (v2 Xmm)
     (v3 Xmm)
     (v4 Xmm)
     (v5 Xmm)
     (v6 Xmm)
     (v7 Xmm)
     (v8 Xmm)
     (v9 Xmm)
     (v10 Xmm)
     (v11 Xmm)
     (v12 Xmm)
     (v13 Xmm)
     (v14 Xmm)
     (v15 Xmm))
    ()
    (=
      (xveval_seq
        (S (S (S (S (S (S (S (S (S (S (S (S (S f)))))))))))))
        (MkXModule fs 65536 131072)
        (shnw_q0 rest)
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
        mem)
      (xveval_seq
        (S f)
        (MkXModule fs 65536 131072)
        rest
        (MkRegs a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 130752 a11 a12 a13 a14)
        (MkXmms
          (vpshufd (vpaddd v3 (vload mem 130752)) 14)
          (rabef_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 130752)))
          (rcdgh_of (shn_qround (MkShnRs v1 v2) v3 (vload mem 130752)))
          (shn_sstep v3 v4 v5 v6)
          v4
          v5
          v6
          (vpalignr v6 v5 4)
          v8
          v9
          v10
          (vload mem 130752)
          v12
          v13
          v14
          v15)
        mem)))
  (steps
    ((compute lhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2))
     (compute rhs (stop vload vpaddd vrnds2 vpshufd vpalignr vmsg1 vmsg2)))
    refl))

