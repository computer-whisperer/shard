(claim snw_lane0
  (goal ((ga Xmm) (gb Xmm) (gc Xmm) (gd Xmm))
    ((= (shn_xlos ga) (list True True True True))
     (= (shn_xlos gb) (list True True True True))
     (= (shn_xlos gc) (list True True True True))
     (= (shn_xlos gd) (list True True True True)))
    (=
      (shn_wnext (x0_of ga) (x1_of ga) (x1_of gc) (x2_of gd))
      (x0_of (shn_sstep ga gb gc gd))))
  (chain
    (rewrite-with
      (lemma snw_gstep)
      lr
      both
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)
       (steps ((rewrite (premise 1) lr lhs true ())) refl)
       (steps ((rewrite (premise 2) lr lhs true ())) refl)
       (steps ((rewrite (premise 3) lr lhs true ())) refl)))
    (steps ((compute both (stop shn_wnext))) refl)))

