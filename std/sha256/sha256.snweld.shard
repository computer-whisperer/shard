;; ==== THE RUN FORM ==================================================================
;;
;; sst_xfold_run's twin at xvrun_regs grain: the whole leaf (wrapper +
;; loop + exit ladder) as fn 1 of a PARTIALLY-QUANTIFIED module (f0 and
;; the function tail free -- slice C instantiates the variant bin's module
;; directly). Entry mirrors the scalar fold contract exactly: RDX/R12
;; junk, RSI = count, RDI = src, everything else zero, the XMM file
;; arbitrary. Exit: all GPRs zero except R12 = src + 64k; the XMM file
;; GROUND ZERO (the exit ladder's sixteen loads from the dead-zero cell,
;; premise 19); memory = snw_fmem (the H-home stores, nothing else).
;; the wrapper's H-window byte-swap: both groups loaded from m, lane-
;; bswapped, stored back (the entry conversion's memory effect, and —
;; applied to the folded memory — the exit conversion's). BE-in/LE-out
;; at entry, LE-in/BE-out at exit: one fn serves both (vbswap is an
;; involution on the byte level).
(fn snw_hbsw ((m Mem)) Mem
  (vstore
    (vstore m 131008 (vbswap (vload m 131008)))
    131024
    (vbswap (vload m 131024))))

