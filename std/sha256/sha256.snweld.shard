     (= (vload m 130992) (shn_kg 15)))
    (=
      (xveval_loop
        (S^ 230 (lg_fuel k c))
        (MkXModule fs 65536 131072)
        (snw_lbody)
        (MkRegs 0 0 (int_of_nat k) 0 0 0 src 0 0 0 0 x12 0 0 0)
        (MkXmms v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
