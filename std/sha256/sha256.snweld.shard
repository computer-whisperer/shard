(claim snw_fold_frame
  (goal ((st H8) (st2 H8) (m Mem) (p Int) (k Nat))
    ((= (le (+ p (* 64 (int_of_nat k))) 131008) True))
    (= (shb_fold st (shnw_hmem m st2) p k) (shb_fold st m p k)))
  (induct k
    ((case Z (steps ((compute both (stop shnw_hmem))) refl))
     (case S
       (k2)
       (chain
         (have hnn (= (le 0 (int_of_nat k2)) True)
           (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
         (have hqs (= (le (+ p (* 64 (+ 1 (int_of_nat k2)))) 131008) True)
           (steps
             ((rewrite (lemma int_of_nat_succ) rl lhs true ())
              (rewrite (premise 0) lr lhs true ()))
             refl))
         (steps ((rewrite (lemma shb_fold_s) lr both true ())))
         (rewrite-with
           (lemma snw_read_hmem)
           lr
           lhs
           ()
           ((chain
              (steps ((rewrite (lemma ish_i64p) lr lhs true ())))
              (steps () (by arith (rows (goal 1) (hqs 1) (hnn 64)))))))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (hqs 1))))))
         refl)))))

;; ---- THE B-iii SUMMIT: the machine fold's H readback IS the spec fold ------

(claim snw_tie
  (goal ((m Mem) (src Int) (k Nat))
    ((= (le (+ src (* 64 (int_of_nat k))) 130496) True))
    (= (snw_hst (snw_fmem m src k)) (shb_fold (snw_hst m) m src k)))
  (induct k
    ((case Z
       (steps
         ((rewrite (lemma snw_fmem_z) lr lhs true ())
          (unfold shb_fold rhs)
          (reduce rhs))
         refl))
     (case S
       (k2)
       (chain
         (have hs (= (int_of_nat (S k2)) (+ 1 (int_of_nat k2)))
           (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
         (have hqs (= (le (+ (+ src 64) (* 64 (int_of_nat k2))) 130496) True)
           (steps () (by arith (rows (goal 1) (0 1) (hs 64)))))
         (steps ((rewrite (lemma snw_fmem_s) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps ((rewrite (premise hqs) lr lhs true ())) refl)))
         (have hblk
           (= (snw_blk m src) (sha_block (snw_hst m) (mem_read 64 m src)))
           (steps ((rewrite (lemma snw_blkw) lr lhs true ())) refl))
         (steps ((rewrite (premise hblk) lr lhs true ())))
         (rewrite-with
           (lemma snw_hrt)
           lr
           lhs
           ()
           ((steps ((rewrite (lemma snw_blk_l32) lr lhs true ())) refl)))
         (rewrite-with
           (lemma snw_fold_frame)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (hqs 1))))))
         (steps ((rewrite (lemma shb_fold_s) lr rhs true ())) refl))))))

;; ---- T6: the sweld connection — ssr_fold_read composes verbatim ------------

(claim snw_blocks_read
  (goal ((m Mem) (src Int) (k Nat))
    ((= (le (+ src (* 64 (int_of_nat k))) 130496) True))
    (=
      (snw_hst (snw_fmem m src k))
      (sha_blocks (snw_hst m) (mem_read (ssr_bn k) m src) (int_of_nat k))))
  (chain
    (rewrite-with
      (lemma snw_tie)
      lr
      lhs
      ()
      ((steps ((rewrite (premise 0) lr lhs true ())) refl)))
    (steps ((rewrite (lemma ssr_fold_read) lr lhs true ())) refl)))
