     (compute lhs (stop vload x0_of x1_of x2_of x3_of))
     (rewrite (lemma snw_xv0_lo) lr lhs true ())
     (rewrite (lemma snw_xv1_lo) lr lhs true ())
     (rewrite (lemma snw_xv2_lo) lr lhs true ())
     (rewrite (lemma snw_xv3_lo) lr lhs true ()))
