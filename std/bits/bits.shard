              (rewrite (premise ha) lr lhs true ()))
             refl)
           (steps
             ((rewrite (premise hm) rl lhs true ())
              (rewrite (premise hb) lr lhs true ()))
             refl))
          refl)))
    (by arith (list 1 0 0 0 0 0 0 0 1))))

