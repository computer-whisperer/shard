;; The lt-spelled twin: convert the lt-bounds to le, cite bxor_le32, convert
;; back. Pure premise algebra over the proven closure fact.
(fulfills bxor_lt32
  (chain
    (have ha (= (le a 4294967295) True) (by arith (list 1 0 1 0 0)))
    (have hb (= (le b 4294967295) True) (by arith (list 1 0 0 0 1 0)))
    (have hx (= (le (bxor a b) 4294967295) True)
      (rewrite-with
        (lemma bxor_le32)
        lr
        lhs
        ()
        ((steps ((rewrite (premise 0) lr lhs true ())) refl)
         (steps ((rewrite (premise 2) lr lhs true ())) refl)
         (steps ((rewrite (premise ha) lr lhs true ())) refl)
         (steps ((rewrite (premise hb) lr lhs true ())) refl))
        refl))
    (by arith (list 1 0 0 0 0 0 0 1))))

(fulfills bxor_lt64
  (chain
    (have hm (= 18446744073709551615 (- (pow2 64) 1))
      (steps ((compute rhs)) refl))
    (have ha (= (le a 18446744073709551615) True) (by arith (list 1 0 1 0 0)))
    (have hb (= (le b 18446744073709551615) True) (by arith (list 1 0 0 0 1 0)))
    (have hx (= (le (bxor a b) 18446744073709551615) True)
      (chain
        (steps ((rewrite (premise hm) lr lhs true ())))
        (rewrite-with
          (lemma bxor_le_pow2)
          lr
