               b
               2
               qb
               (chain
                 (rewrite-with
                   (lemma bxor_rec)
                   lr
                   lhs
                   ()
                   ((steps ((rewrite (premise 1) lr lhs true ())) refl)
                    (steps ((rewrite (premise 2) lr lhs true ())) refl)))
                 (steps
                   ((rewrite (premise 11) lr lhs true ())
                    (rewrite (premise 15) lr lhs true ())))
                 (have hchi
                   (=
