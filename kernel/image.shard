;;; image.shard — the binary module-image codec (docs/STORAGE.md §8a), in
;;; the kernel so the loader's image front door (S2b) can consult it. Born
;;; as tools/image (S2a); the tool remains as the roundtrip-gate driver and
;;; now cites this file.
;;;
;;; v1 covers the RAW-SEXPR layer: the context-free tree the reader
;;; produces before any elaboration. Parsing depends on nothing
;;; accumulated, so an SExpr image validates against file bytes alone and
;;; replaces the check path's whole-source read_all (parse-once field,
;;; reader.shard SrcEntry). The Module layer (keys chained over the import
;;; prefix) comes after this layer earns its warm number.
;;;
;;; FORMAT IMG1 (CANON.md §7 identity-bytes style; the encoder mirrors
;;; tools/canon/hash.shard's hx_ser family; the decoder is the tree's
;;; first):
;;;   image   = "IMG1;" int(count) sx*
;;;   sx      = 0 int(n)                    SInt
;;;           | 1 int(len) byte*            SSym (chars_of_sym bytes)
;;;           | 2 int(len) byte*            SStr (raw content bytes)
;;;           | 3 int(count) sx*            SList
;;;   int     = '-'? digit+ ';'             sign + decimal digits
;;; Counts prefix every list; payload bytes are raw (0..255, write_file
;;; safe).
;;;
;;; CONTAINER IMG2 (S2b, the cache-file wrapper):
;;;   file    = "IMG2;" int(plen) path-byte* int(slen) src-byte* IMG1-image
;;; The container embeds the source's PATH and FULL BYTES; a cache hit
;;; requires byte-identity with what read_file just returned — validation
;;; is EXACT (no hash, no collision class), so the cache filename is a
;;; convenience, never load-bearing. CACHE, NEVER TRUST: images never
;;; enter the trust ledger; corpus/CI runs stay on the from-text path.
;;;
;;; Accumulator discipline (the reader's own law, reader.shard): host
;;; stack depth is the NESTING depth, never the sibling count — sibling
;;; walks are tail-recursive over a reversed byte/tree accumulator.

(import "stdlib.shard")
(import "term.shard")
(import "reader.shard")

(use (:: kernel term *))
(use (:: kernel reader *))

;; ---------------------------------------------------------------------------
;; byte-list helpers
;; ---------------------------------------------------------------------------

;; aliases of the kit's len — kept by name for tools/image (globs (:: kernel image *)).
(fn img_len ((a (List Int))) Int (len a))

;; byte-list equality (loader's int_list_eq is downstream of this file)
(fn img_bytes_eq ((a (List Int)) (b (List Int))) Bool
  (measure (struct a))
  (match a
    (Nil
      (match b
        (Nil True)
        (_ False)))
    ((Cons x xs)
     (match b
       (Nil False)
       ((Cons y ys) (if (int_eq x y) (img_bytes_eq xs ys) False))))))

;; sign + decimal digits + ';' as a small forward chunk (hx_int style)
(fn img_int_chunk ((n Int)) (List Int)
  (if (lt n 0) (Cons 45 (append_int (show_int (- 0 n)) (Cons 59 Nil)))
  (append_int (show_int n) (Cons 59 Nil))))

(fn img_sx_len ((xs (List SExpr))) Int (len xs))

;; ---------------------------------------------------------------------------
;; encoder — reversed-stream accumulator; depth = nesting only
;; ---------------------------------------------------------------------------

;; tag + count-prefixed raw payload bytes
(fn img_renc_bytes ((tag Int) (bs (List Int)) (acc (List Int))) (List Int)
  (rev_onto bs (rev_onto (Cons tag (img_int_chunk (len bs))) acc)))

(fn img_renc_sx ((e SExpr) (acc (List Int))) (List Int)
  (measure (struct e))
  (match e
    ((SInt n) (rev_onto (Cons 0 (img_int_chunk n)) acc))
    ((SSym s) (img_renc_bytes 1 (chars_of_sym s) acc))
    ((SStr bs) (img_renc_bytes 2 bs acc))
    ((SList xs)
     (img_renc_sxs xs (rev_onto (Cons 3 (img_int_chunk (len xs))) acc)))))

(fn img_renc_sxs ((xs (List SExpr)) (acc (List Int))) (List Int)
  (measure (struct xs))
  (match xs
    (Nil acc)
    ((Cons h t) (img_renc_sxs t (img_renc_sx h acc)))))

(fn img_encode ((xs (List SExpr))) (List Int)
  (rev_onto
    (img_renc_sxs
      xs
      (rev_onto (append_int "IMG1;" (img_int_chunk (len xs))) Nil))
    Nil))

;; ---------------------------------------------------------------------------
;; decoder — fuel-bounded (read_expr_go's measure idiom); the tree's first
;; ---------------------------------------------------------------------------

;; digit run then ';' (any = at least one digit seen)
(fn img_dec_nat ((bs (List Int)) (acc Int) (any Bool))
  (Option (Pair Int (List Int)))
  (measure (struct bs))
  (match bs
    (Nil None)
    ((Cons c rest)
     (if (int_eq c 59) (if any (Some (Pair acc rest)) None)
     (if (lt c 48) None
     (if (lt 57 c) None
     (img_dec_nat rest (+ (* acc 10) (- c 48)) True)))))))

(fn img_dec_int ((bs (List Int))) (Option (Pair Int (List Int)))
  (match bs
    (Nil None)
    ((Cons c rest)
     (if (int_eq c 45)
       (match (img_dec_nat rest 0 False)
         (None None)
         ((Some (Pair n r)) (Some (Pair (- 0 n) r))))
       (img_dec_nat (Cons c rest) 0 False)))))

(fn img_take ((n Int) (bs (List Int)) (acc (List Int)))
  (Option (Pair (List Int) (List Int)))
  (measure (struct bs))
  (if (lt n 1) (Some (Pair (rev_onto acc Nil) bs))
  (match bs
    (Nil None)
    ((Cons c rest) (img_take (- n 1) rest (Cons c acc))))))

;; count-prefixed raw payload
(fn img_dec_payload ((bs (List Int))) (Option (Pair (List Int) (List Int)))
  (match (img_dec_int bs)
    (None None)
    ((Some (Pair n r)) (if (lt n 0) None (img_take n r Nil)))))

(fn img_dec_sx ((bs (List Int)) (fuel Int)) (Option (Pair SExpr (List Int)))
  (measure fuel (by arith (list 1 0)) (by arith (list 1 1)))
  (if (lt fuel 1) None
  (match bs
    (Nil None)
    ((Cons tag rest)
     (if (int_eq tag 0)
       (match (img_dec_int rest)
         (None None)
         ((Some (Pair n r)) (Some (Pair (SInt n) r))))
     (if (int_eq tag 1)
       (match (img_dec_payload rest)
         (None None)
         ((Some (Pair cs r)) (Some (Pair (SSym (sym_of_chars cs)) r))))
     (if (int_eq tag 2)
       (match (img_dec_payload rest)
         (None None)
         ((Some (Pair cs r)) (Some (Pair (SStr cs) r))))
     (if (int_eq tag 3)
       (match (img_dec_int rest)
         (None None)
         ((Some (Pair n r))
          (if (lt n 0) None
          (match (img_dec_sxs n r Nil (- fuel 1))
            (None None)
            ((Some (Pair xs r2)) (Some (Pair (SList xs) r2)))))))
       None))))))))

;; n siblings, accumulator style (depth = nesting via img_dec_sx only)
(fn img_dec_sxs ((n Int) (bs (List Int)) (acc (List SExpr)) (fuel Int))
  (Option (Pair (List SExpr) (List Int)))
  (measure
    fuel
    (by arith (list 1 0))
    (by arith (list 1 1))
    (by arith (list 1 0))
    (by arith (list 1 1)))
  (if (lt fuel 1) None
  (if (lt n 1) (Some (Pair (rev_onto acc Nil) bs))
  (match (img_dec_sx bs (- fuel 1))
    (None None)
    ((Some (Pair e r)) (img_dec_sxs (- n 1) r (Cons e acc) (- fuel 1)))))))

;; the magic prefix, or None
(fn img_strip ((pre (List Int)) (bs (List Int))) (Option (List Int))
  (measure (struct pre))
  (match pre
    (Nil (Some bs))
    ((Cons p pt)
     (match bs
       (Nil None)
       ((Cons c ct) (if (int_eq c p) (img_strip pt ct) None))))))

;; whole image -> the file's SExpr list; trailing bytes = malformed.
;; Fuel 2*(bytes+2): every decoder step consumes >=1 byte per <=2 ticks.
(fn img_decode ((bs (List Int))) (Option (List SExpr))
  (match (img_strip "IMG1;" bs)
    (None None)
    ((Some r)
     (match (img_dec_int r)
       (None None)
       ((Some (Pair n r2))
        (if (lt n 0) None
        (match (img_dec_sxs n r2 Nil (* 2 (+ (len r2) 2)))
          (None None)
          ((Some (Pair xs tail))
           (match tail
             (Nil (Some xs))
             (_ None))))))))))

;; ---------------------------------------------------------------------------
;; structural equality
;; ---------------------------------------------------------------------------

(fn img_sx_eq ((a SExpr) (b SExpr)) Bool
  (measure (struct a))
  (match a
    ((SInt x)
     (match b
       ((SInt y) (int_eq x y))
       (_ False)))
    ((SSym s)
     (match b
       ((SSym s2) (sym_eq s s2))
       (_ False)))
    ((SStr xs)
     (match b
       ((SStr ys) (img_bytes_eq xs ys))
       (_ False)))
    ((SList xs)
     (match b
       ((SList ys) (img_sxs_eq xs ys))
       (_ False)))))

(fn img_sxs_eq ((xs (List SExpr)) (ys (List SExpr))) Bool
  (measure (struct xs))
  (match xs
    (Nil
      (match ys
        (Nil True)
        (_ False)))
    ((Cons x xt)
     (match ys
       (Nil False)
       ((Cons y yt) (if (img_sx_eq x y) (img_sxs_eq xt yt) False))))))

;; ---------------------------------------------------------------------------
;; the IMG2 container — cache-file assembly and split (validation lives at
;; the consumer: the loader byte-compares embedded path/src against what
;; it just read before trusting the payload)
;; ---------------------------------------------------------------------------

(fn img2_build ((path (List Int)) (src (List Int)) (payload (List Int)))
  (List Int)
  (rev_onto
    (rev_onto
      payload
      (rev_onto
        src
        (rev_onto
          (img_int_chunk (len src))
          (rev_onto
            path
            (rev_onto (img_int_chunk (len path)) (rev_onto "IMG2;" Nil))))))
    Nil))

;; container -> (Pair path (Pair src payload)), or None on any malformation
(fn img2_parts ((bs (List Int)))
  (Option (Pair (List Int) (Pair (List Int) (List Int))))
  (match (img_strip "IMG2;" bs)
    (None None)
    ((Some r0)
     (match (img_dec_int r0)
       (None None)
       ((Some (Pair plen r1))
        (if (lt plen 0) None
        (match (img_take plen r1 Nil)
          (None None)
          ((Some (Pair path r2))
           (match (img_dec_int r2)
             (None None)
             ((Some (Pair slen r3))
              (if (lt slen 0) None
              (match (img_take slen r3 Nil)
                (None None)
                ((Some (Pair src payload))
                 (Some (Pair path (Pair src payload))))))))))))))))
