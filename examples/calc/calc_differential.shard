;;; calc_differential — the OLD TREE's side of V3's calc differential
;;; (v3/LANGUAGE.md §10 item 2, slice 6; v3/kernel/test/calc_test.sh).
;;;
;;; A pure module: v3/kernel/test/calc_test.sh evaluates one expression per
;;; input line and case through the tower's expression mode,
;;;
;;;   eval examples/calc/calc_differential.shard '(run (list 49 43 50))'
;;;
;;; whose printer renders the value — `(Some 3)`, `(Cons 1 Nil)`, `True`,
;;; a nullary constructor bare — and v3/kernel/test/calc_harness.shard
;;; prints the same lines for the S port under `ev`. (`eval direct`'s flat
;;; resolver cannot follow std/list's directory-module imports, which is why
;;; the tower drives this side.) This file adds only what the cases need
;;; beside the program's own functions: the derived inputs — the run
;;; result's magnitude, the line's digits as Digit values, its first digit,
;;; its first byte — as helpers whose results are Options.
;;;
;;; calc_show_run is imported FIRST so that its `codes` (digit values →
;;; codepoints) is the one this flat closure sees; calc_ndigit's `codes`
;;; (Digit → codepoints) is shadowed by first-definition-wins and left out
;;; of the cases on both sides — `code` covers it.

(import "../../kernel/stdlib.shard")
(import "calc_show_run.shard")
(import "calc_app_world.shard")
(import "calc_ndigit.shard")
(use (:: examples calc calc *))
(use (:: examples calc calc_spec *))
(use (:: examples calc calc_show *))
(use (:: examples calc calc_show_run *))
(use (:: examples calc calc_equiv *))
(use (:: examples calc calc_app *))
(use (:: examples calc calc_app_spec *))
(use (:: examples calc calc_app_trace *))
(use (:: examples calc calc_app_world *))
(use (:: examples calc calc_ndigit *))

(fn abs_int ((n Int)) Int (if (lt n 0) (- 0 n) n))
(fn digit_of ((b Int)) Digit
  (if (int_eq b 48) D0 (if (int_eq b 49) D1 (if (int_eq b 50) D2 (if (int_eq b 51) D3 (if (int_eq b 52) D4
  (if (int_eq b 53) D5 (if (int_eq b 54) D6 (if (int_eq b 55) D7 (if (int_eq b 56) D8 D9))))))))))
(fn digits_of ((bs (List Int))) (List Digit)
  (measure (struct bs))
  (match bs
    (Nil Nil)
    ((Cons b r) (if (is_digit b) (Cons (digit_of b) (digits_of r)) (digits_of r)))))
(fn first_digit ((bs (List Int))) (Option Digit)
  (measure (struct bs))
  (match bs
    (Nil None)
    ((Cons b r) (if (is_digit b) (Some (digit_of b)) (first_digit r)))))

;; over the run result, when some
(fn h_show_ascii ((line (List Int))) (Option (List Int))
  (match (run line) (None None) ((Some m) (Some (show_ascii m)))))
(fn h_show ((line (List Int))) (Option (List Int))
  (match (run line) (None None) ((Some m) (Some (show (abs_int m))))))
(fn h_show_nat ((line (List Int))) (Option (List Int))
  (match (run line) (None None) ((Some m) (Some (show_nat (abs_int m))))))
(fn h_valI ((line (List Int))) (Option Int)
  (match (run line) (None None) ((Some m) (Some (valI (show (abs_int m)))))))
(fn h_codes ((line (List Int))) (Option (List Int))
  (match (run line) (None None) ((Some m) (Some (codes (show (abs_int m)))))))
;; over the first digit, when any
(fn h_dval ((line (List Int))) (Option Int)
  (match (first_digit line) (None None) ((Some d) (Some (dval d)))))
(fn h_code ((line (List Int))) (Option Int)
  (match (first_digit line) (None None) ((Some d) (Some (code d)))))
;; over the first byte, when any
(fn h_is_digit ((line (List Int))) (Option Bool)
  (match line (Nil None) ((Cons b _) (Some (is_digit b)))))
(fn h_is_ws ((line (List Int))) (Option Bool)
  (match line (Nil None) ((Cons b _) (Some (is_ws b)))))
(fn h_digit_val ((line (List Int))) (Option Int)
  (match line (Nil None) ((Cons b _) (Some (digit_val b)))))
