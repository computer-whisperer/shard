;;; examples/sha256sum/sha256sum_stream_write.shard — RUN-ONLY emit glue for the
;;; pure STREAMING ELF emitter (examples/sha256sum/sha256sum_stream_elf.shard).
;;; It writes the emitter's bytes to examples/sha256sum/sha256sum_stream and
;;; exits; it computes nothing and proves nothing.
;;;
;;; ⚠ NEVER A CORPUS TARGET — but note the twin's asymmetry, because it is easy
;;; to mis-generalize. examples/sha256sum/sha256sum_write.shard is check-RED by
;;; construction: its closure carries a `(bin …)` form, so the eight loader IO
;;; externs this file's World main pulls in violate the bin-boundary law. THIS
;;; file's closure carries NO bin form — the streaming article never imports
;;; sha256sum_stream_src.shard — so there is no declared-extern list to violate
;;; and `bin/check` on it is GREEN. It stays out of TARGETS anyway, on the
;;; separation-of-duty rule rather than the boundary law: emit glue is run-mode
;;; plumbing, the corpus gates the pure articles, and a writer in TARGETS would
;;; make the corpus's verdict depend on loader's IO surface for no proof value.
;;;
;;; The pure side — examples/sha256sum/sha256sum_stream_elf.shard, which carries
;;; the D8 byte-tie (ssx_main_eof/err/dry) — IS the corpus target.
;;;
;;; Run:  bin/shard_eval run examples/sha256sum/sha256sum_stream_write.shard
;;; Effect: writes examples/sha256sum/sha256sum_stream (repo-relative) — an
;;;         ELF64 whose RW window sits at 65536, so it is CAPLESS: no setcap,
;;;         no vm.mmap_min_addr change, no non-nosuid-filesystem requirement.
;;;         examples/sha256sum/sha256sum_silicon_diff.sh drives this.

(import "../../kernel/loader.shard")
(import "sha256sum_stream_elf.shard")
(use (:: kernel loader *))
(use (:: examples sha256sum sha256sum_stream_elf ssx_elf))

(fn main ((w World)) World
  (match (write_file "examples/sha256sum/sha256sum_stream" (ssx_elf) w)
    ((Pair ok w2) (exit (if ok 0 1) w2))))
