;; ================================================================================
;; THE M4 WELD (ssw_*): the loop invariant sealed against the spec.
;; The SswOb package (total cell, K/H windows, right-aligned pend tail)
;; realizes the ShaSt; ssw_step reads one absorber iteration back as
;; sha_step via the ssr_rb_* family at the filled window; ssw_inv folds
;; it over the run from ikh_mem's init windows; ssw_main_eof is the
;; SEALED Done leg — with ssm_main_err/ssm_main_dry it closes STREAM.md
;; §7.3's D8 disjunction. M5 regenerates the image at base 65536.
;; ================================================================================

;; --- the chunks projection: what the oracle delivered, masked ---------------------

(fn ssw_chunks ((its (List SsmIt))) (List (List Int))
  (measure (struct its))
  (match its
    (Nil Nil)
    ((Cons it rest) (Cons (ssm_msk (ssm_ibs it)) (ssw_chunks rest)))))

;; --- the realize package: the four window observations as ONE value ---------------
;; (one equation carries the whole invariant through the induction)

(record SswOb (swtot Int) (swk (List Int)) (swh (List Int)) (swpd (List Int)))

(fn ssw_obs ((m Mem)) SswOb
  (MkSswOb
    (ibt_v m 65536)
    (wlist m 130752 64)
    (wlist m 131008 8)
    (mem_read
      (wnat (band (ibt_v m 65536) 63))
      m
      (- 65664 (int_of_nat (wnat (band (ibt_v m 65536) 63)))))))

(fn ssw_spec ((st ShaSt)) SswOb
  (match st
    ((MkShaSt h pd n)
     (MkSswOb (mod n 18446744073709551616) (sha_k) (shw_hlist h) pd))))

;; --- constructor injectivity peels (component extraction from the package) --------

(claim ssw_pk_tot
  (goal
    ((a Int)
     (b (List Int))
     (c (List Int))
     (d (List Int))
     (a2 Int)
     (b2 (List Int))
     (c2 (List Int))
     (d2 (List Int)))
    ((= (MkSswOb a b c d) (MkSswOb a2 b2 c2 d2)))
    (= a a2))
  (chain
    (have h0 (= (swtot_of (MkSswOb a b c d)) (swtot_of (MkSswOb a2 b2 c2 d2)))
      (steps ((rewrite (premise 0) lr lhs true ())) refl))
    (have h1 (= (swtot_of (MkSswOb a b c d)) a) (steps ((compute lhs)) refl))
    (have h2 (= (swtot_of (MkSswOb a2 b2 c2 d2)) a2)
      (steps ((compute lhs)) refl))
    (steps
      ((rewrite (premise h1) rl lhs true ())
       (rewrite (premise h0) lr lhs true ())
       (rewrite (premise h2) lr lhs true ()))
      refl)))

