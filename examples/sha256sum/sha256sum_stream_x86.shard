;; int_of_nat inverts wnat on the nonnegatives — the ghost-exhibit lemma
;; (the composition instantiates kb/krem/kf at wnat terms; the ground-b
;; slab spellings ride (wnat 63)/(wnat 64) through this same lemma)
(claim ssm_wnat_val
  (goal ((x Int)) ((= (le 0 x) True)) (= (int_of_nat (wnat x)) x))
  (wf-induct x
    (case-on (le x 0) Bool
      ((case True
         (chain
           (have hx (= (le x 0) True)
             (steps ((rewrite (hyp True) lr lhs true ())) refl))
           (have hw (= (wnat x) Z)
             (steps
               ((unfold wnat lhs)
                (rewrite (premise hx) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hw) lr lhs true ())
              (rewrite (lemma int_of_nat_zero) lr lhs true ()))
             (by arith (list (list 1 1 0 0) (list 1 0 1 0))))))
       (case False
         (chain
           (have hx (= (le x 0) False)
             (steps ((rewrite (hyp False) lr lhs true ())) refl))
           (have hw (= (wnat x) (S (wnat (- x 1))))
             (steps
               ((unfold wnat lhs)
                (rewrite (premise hx) lr lhs true ())
                (reduce lhs))
               refl))
           (steps
             ((rewrite (premise hw) lr lhs true ())
              (rewrite (lemma int_of_nat_succ) lr lhs true ())))
           (rewrite-with
             (hyp 1)
             lr
             lhs
             ()
             ((steps () (by arith (rows (goal 1) (hx 1))))
              (steps () (by arith (rows (goal 1) (hx 1))))
              (steps () (by arith (rows (goal 1))))))
           (steps () (by arith (list (list 1) (list 1))))))))))

