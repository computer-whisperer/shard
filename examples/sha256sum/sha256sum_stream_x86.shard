;;; examples/sha256sum/sha256sum_stream_x86.shard — the STREAMING bin's
;;; MACHINE leg (Arc B rung B3, docs/STREAM.md §7.9 M3): the hand-built
;;; streaming main over the sweld's frozen skeleton, plus its walk
;;; ladder up to the entry equations at xrun_w — M0's stdin_count_probe
;;; walk shape instantiated over the streaming module, with
;;; xcall_bridge welding sst_xabsorb/sst_xfinal/shi_xinit at the call
;;; sites.
;;;
;;; THE MODULE (window [65536, 131072) — M5's relocation landed):
;;;   0-8   sha256.sweld.shard's frozen fns: block loop, fold caller,
;;;         copy, totr, totw, absorber, fpad, hex, finalizer
;;;   9     THE STREAMING MAIN — XCall 13 (init), then the
;;;         read-until-EOF loop
;;;   10-12 read/write/exit shims (models/x86/linux.shard's bodies)
;;;   13    the init WRAPPER (one XCall 14 — gb_shinit_x is 577
;;;         instrs, over weff_budget=96, so the purity dispatch would
;;;         mirror it; the 1-instr wrapper delegates whole, and
;;;         shi_xinit's xeval cert welds in behind the inner bridge)
;;;   14    gb_shinit_x
;;; Loop legs: error (one unsigned CLeU RAX 61440 catches the wrapped
;;; negative → exit(1), the §7.2 fail-stop), EOF (CNz RAX → finalize,
;;; write the 64 hex bytes from [0,64), exit(0)), data (RDI := ret,
;;; re-zero R11/RBX/R12, XCall 5, back edge). (inline …) is same-file
;;; sugar, so the sfm_* carriers below are byte copies of the sweld's
;;; bodies — tie-claimed so drift fails loudly at the tie.
;;;
;;; THE ENTRY EQUATIONS (ssm_main_eof/err/dry, the file's top) are the
;;; statements M4 consumes: from the ELF stub's all-zero registers at
;;; fn 9, for EVERY oracle behavior at every sufficient fuel, the bin
;;; exits 0 having written the 64 digest bytes of the folded state
;;; (the LxWrote payload = lx_read of the composed finalizer memory),
;;; or fail-stops at exit 1 on a read error, or the oracle runs dry.
;;; THE WELD (M4, ssw_* at the file's tail) seals that payload: the
;;; SswOb realize package is the loop invariant, ssw_step reads one
;;; absorber iteration back as sha_step (ssr_rb_* at the filled
;;; window), ssw_inv folds it over the run, and ssw_main_eof is the
;;; SEALED Done leg — from a zero total cell the bin's trace is reads
;;; until EOF, LxWrote 1 (bytes_hex (sha256 (scat (ssw_chunks its)))),
;;; exit 0. With ssm_main_err/ssm_main_dry this closes §7.3's D8
;;; disjunction (sha_stream_corresponds ties it to sst_trace's ghost).
;;;
;;; THE FUEL-SLAB DESIGN (the file's load-bearing idea): x86 fuel is a
;;; DEPTH bound, so a callee's ghost tower (S^493 (lg_fuel kb (S^50
;;; (lg_fuel krem c)))) constrains fuel only ALONG THE CALL PATH — the
;;; continuation and the back edge run at head-minus-constants
;;; regardless. Since the cap bounds the ghosts (kb ≤ cap/64 = 960,
;;; krem ≤ 63, kf ≤ 2), the bounded-complement lemma ssm_lg_pad
;;; (lg_fuel k (ssm_pad b k c) = lg_fuel b c for k ≤ b) rewrites a
;;; GROUND fuel head into each cert's exact tower at the call site
;;; (ssm_wnat_val makes (wnat 960)/(wnat 63)/(wnat 2) the ground-b
;;; spellings). The pieces then keep M0's constant head-to-head shape
;;; (S^1596 f → S^1595 f) and the walks keep scp_fuel's
;;; one-S-per-iteration ladder — no per-iteration tower ladder, no
;;; reshuffle stanzas. THE CAP IS THE ONLY DIAL: kb's bound is cap/64,
;;; so the absorber slab (and every head above it) moves by exactly
;;; cap/64 − 64 when the cap is retuned — B4's regeneration, STREAM.md
;;; §7.9 Fork F.
;;;
;;; REGISTER DISCIPLINE (differential-proven contract obligations, not
;;; semantics — dropping a re-zero flips zero differential rows; they
;;; exist so the callees' zero-pinned entry files fire): the stub
;;; zeroes all 15 registers; init clobbers ONLY RDI; the loop re-zeros
;;; R11 (syscall trash) + RBX/R12 (absorber exit dirt) before XCall
;;; 5/8. Addresses (window grain, post-M5): total cell @ 65536, spill @
;;; [65544,65547), tail home [65600,65664) right-aligned, read buffer @
;;; 65664 cap 61440, W@130496 K@130752 H@131008 spill-hi@131040 frozen
;;; homes untouched. THE CAP CEILING: the buffer ends at 65664 + cap and
;;; must clear W, so cap ≤ 130496 − 65664 = 64832; 61440 = 15 pages is
;;; the largest multiple of 4096 that fits (B4's retune of the 4096
;;; proving-rung cap, STREAM.md §7.9 Fork F).

(import "../../kernel/stdlib.shard")
(import "../../kernel/facts.shard")
(use (:: kernel facts *))
(import "../../std/nat.shard")
(use (:: std nat *))
(import "../../std/mem")
(use (:: std mem *))
(import "../../std/bits")
(use (:: std bits *))
(import "../../models/x86/x86.shard")
(use (:: models x86 x86 *))
(import "../../models/linux/kernel.shard")
(use (:: models linux kernel *))
(import "../../models/x86/world.shard")
(use (:: models x86 world *))
(import "../../models/wasm/loopkit.shard")
(use (:: models wasm loopkit *))
(import "../../std/sha256/sha256.shard")
(use (:: std sha256 sha256 *))
(use (:: std sha256 sha256))
(import "../../std/sha256/sha256.imp.shard")
(use (:: std sha256 sha256.imp *))
(import "../../std/sha256/impgen_x86_out.shard")
(use (:: std sha256 impgen_x86_out *))
(import "../../std/sha256/sha256.weld.shard")
(use (:: std sha256 sha256.weld *))
(import "../../std/sha256/sha256.sweld.shard")
(use (:: std sha256 sha256.sweld *))
(import "../../std/sha256/sha256.stream.shard")
(use (:: std sha256 sha256.stream *))

;; --- byte-copy carriers (inline sugar is same-file only; texts are the
;; --- sweld's own, so the expanded module trees match its certs') -----------------

(fn sfm_floop () (List XInstr)
  (list
    (XBrIf (CEqz RDX) 1)
    (XMovRR RCX R12)
    (XBin XSub RCX (SImm 65536))
    (XMovRI RBX 131040)
    (XStore8 (AReg RBX) (SReg RCX))
    (XShrI RCX 8)
    (XMovRI RBX 131041)
    (XStore8 (AReg RBX) (SReg RCX))
    (XMovRR RCX RDX)
    (XMovRI RBX 131042)
    (XStore8 (AReg RBX) (SReg RCX))
    (XShrI RCX 8)
    (XMovRI RBX 131043)
    (XStore8 (AReg RBX) (SReg RCX))
    (XMovRI R13 130496)
    (XCall 0)
    (XMovRI RBX 131041)
    (XLoad8 R12 (AReg RBX))
    (XShlI R12 8)
    (XMovRI RBX 131040)
    (XLoad8 RCX (AReg RBX))
    (XBin XAdd R12 (SReg RCX))
    (XBin XAdd R12 (SImm 65600))
    (XMovRI RBX 131043)
    (XLoad8 RDX (AReg RBX))
    (XShlI RDX 8)
    (XMovRI RBX 131042)
    (XLoad8 RCX (AReg RBX))
    (XBin XAdd RDX (SReg RCX))
    (XBin XSub RDX (SImm 1))
    (XMovRI RCX 0)
    (XMovRI RBX 0)
    (XMovRI RBP 0)
    (XMovRI RSI 0)
    (XMovRI RDI 0)
    (XMovRI R8 0)
    (XMovRI R9 0)
    (XBr 0)))

(fn sfm_copy () (List XInstr)
  (list
    (XBrIf (CEqz RDX) 1)
    (XLoad8 RCX (AReg RSI))
    (XMovRR RAX RCX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDI) (SReg RAX))
    (XBin32 XAdd RDI (SImm 1))
    (XBin32 XAdd RSI (SImm 1))
    (XMovRI RCX 0)
    (XBin32 XSub RDX (SImm 1))
    (XMovRI RAX 0)
    (XBr 0)))

(fn sfm_abs () (List XInstr)
  (list
    (XMovRI RCX 65545)
    (XStore8 (AReg RCX) (SReg RDI))
    (XMovRR RAX RDI)
    (XShrI RAX 8)
    (XMovRI RCX 65546)
    (XStore8 (AReg RCX) (SReg RAX))
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDX 65546)
    (XLoad8 RAX (AReg RDX))
    (XShlI RAX 8)
    (XMovRI RDX 65545)
    (XLoad8 RBX (AReg RDX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRR RBX RCX)
    (XBin XAdd RBX (SReg RAX))
    (XMovRR RBP RBX)
    (XBin XAnd RBP (SImm 63))
    (XShrI RBX 6)
    (XMovRI RDX 65544)
    (XStore8 (AReg RDX) (SReg RBP))
    (XBin XAdd RSI (SReg RAX))
    (XCall 4)
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RBX)
    (XMovRI RCX 0)
    (XMovRI RBX 0)
    (XMovRI RBP 0)
    (XCall 1)
    (XMovRI RCX 65544)
    (XLoad8 RDX (AReg RCX))
    (XMovRI RCX 65546)
    (XLoad8 RAX (AReg RCX))
    (XShlI RAX 8)
    (XMovRI RCX 65545)
    (XLoad8 RBX (AReg RCX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RDX))
    (XMovRI RSI 65664)
    (XBin XAdd RSI (SReg RAX))
    (XBin XSub RSI (SReg RDX))
    (XCall 2)))

(fn sfm_fin () (List XInstr)
  (list
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR R9 RSI)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RCX)
    (XCall 6)
    (XBin XAdd RSI (SImm 72))
    (XShrI RSI 6)
    (XMovRI RCX 0)
    (XMovRI R8 0)
    (XMovRI R9 0)
    (XCall 1)
    (XMovRI R12 0)
    (XMovRI RDI 65536)
    (XMovRI RSI 131008)
    (XCall 7)))

;; the carrier ties: drift from the sweld's bodies fails HERE, not at
;; a cert-match deep inside a walk
(claim sfm_floop_tie
  (goal () () (= (sfm_floop) (ssf_xbody)))
  (steps ((compute both)) refl))

(claim sfm_copy_tie
  (goal () () (= (sfm_copy) (ssc_xbody)))
  (steps ((compute both)) refl))

(claim sfm_abs_tie
  (goal () () (= (sfm_abs) (sst_xabs_body)))
  (steps ((compute both)) refl))

(claim sfm_fin_tie
  (goal () () (= (sfm_fin) (sst_xfin_body)))
  (steps ((compute both)) refl))

;; --- the M3 bodies (differential-validated: m3_run 25/25 incl. gold
;; --- ""/"abc" vectors, cap/error/dry strata, perturbation teeth) -----------------

(fn ssm_loop_body () (List XInstr)
  (list
    (XMovRI RDI 0)
    (XMovRI RSI 65664)
    (XMovRI RDX 61440)
    (XCall 10)
    (XBlock (list (XBrIf (CLeU RAX (SImm 61440)) 0) (XMovRI RDI 1) (XCall 12)))
    (XBlock
      (list
        (XBrIf (CNz RAX) 0)
        (XMovRI R11 0)
        (XMovRI RBX 0)
        (XMovRI R12 0)
        (XCall 8)
        (XMovRI RDI 1)
        (XMovRI RSI 65536)
        (XMovRI RDX 64)
        (XCall 11)
        (XMovRI RDI 0)
        (XCall 12)))
    (XMovRR RDI RAX)
    (XMovRI R11 0)
    (XMovRI RBX 0)
    (XMovRI R12 0)
    (XCall 5)
    (XBr 0)))

(fn ssm_main_body () (List XInstr)
  (list (XCall 13) (XBlock (list (XLoop (inline ssm_loop_body))))))

(fn ssm_init_body () (List XInstr) (list (XCall 14)))

(fn ssm_read_body () (List XInstr) (list (XMovRI RAX 0) XSyscall))

(fn ssm_write_body () (List XInstr) (list (XMovRI RAX 1) XSyscall))

(fn ssm_exit_body () (List XInstr) (list (XMovRI RAX 60) XSyscall))

;; --- stream vocabulary (M0's local twins, transplanted) --------------------------

(fn ssm_app ((a (List Int)) (b (List Int))) (List Int)
  (measure (struct a))
  (match a
    (Nil b)
    ((Cons h t) (Cons h (ssm_app t b)))))

(fn ssm_len ((bs (List Int))) Nat
  (measure (struct bs))
  (match bs
    (Nil 0)
    ((Cons b t) (S (ssm_len t)))))

(fn ssm_msk ((bs (List Int))) (List Int)
  (measure (struct bs))
  (match bs
    (Nil Nil)
    ((Cons b t) (Cons (mod b 256) (ssm_msk t)))))

;; --- the iteration record --------------------------------------------------------

(record SsmIt (smb0 Int) (smbs (List Int)) (smc1 Int) (smc2 Int))

(fn ssm_ibs ((it SsmIt)) (List Int) (Cons (smb0_of it) (smbs_of it)))

(fn ssm_ilen ((it SsmIt)) Int (int_of_nat (ssm_len (ssm_ibs it))))

(fn ssm_ws ((its (List SsmIt)) (tail (List Int))) (List Int)
  (measure (struct its))
  (match its
    (Nil tail)
    ((Cons it rest)
     (Cons
       (ssm_ilen it)
       (ssm_app
         (ssm_ibs it)
         (Cons (smc1_of it) (Cons (smc2_of it) (ssm_ws rest tail))))))))

;; every iteration's delivery fits the cap — the one per-element premise
(fn ssm_ok ((its (List SsmIt))) Bool
  (measure (struct its))
  (match its
    (Nil True)
    ((Cons it rest) (if (le (ssm_ilen it) 61440) (ssm_ok rest) False))))

;; one S per iteration over the slack tail (fuel is depth: the body's
;; whole cost — the callee towers included — rides in the ground head)
(fn ssm_fuel ((its (List SsmIt)) (c Nat)) Nat
  (measure (struct its))
  (match its
    (Nil c)
    ((Cons it rest) (S (ssm_fuel rest c)))))

(fn ssm_pre ((tr (List LxEvent)) (o (Option WOut))) (Option WOut)
  (match o
    (None None)
    ((Some out) (Some (wtr_pre tr out)))))

;; --- the take/framing kit (M0 transplants) ---------------------------------------

(claim ssm_ne_lt
  (goal ((a Int) (b Int)) ((= (lt a b) True)) (= (int_eq a b) False))
  (by arith (list 1 1)))

(claim ssm_take_go
  (goal ((bs (List Int)) (t (List Int)) (i Int)) ()
    (=
      (lx_take_r (ssm_app bs t) i (+ i (int_of_nat (ssm_len bs))))
      (Some (Pair (ssm_msk bs) t))))
  (induct bs
    ((case Nil
       (chain
         (have hz (= (int_of_nat (ssm_len Nil)) (int_of_nat Z))
           (steps ((compute both)) refl))
         (have ha (= (ssm_app Nil t) t)
           (steps ((unfold ssm_app lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hz) lr lhs true ())
            (rewrite (lemma int_of_nat_zero) lr lhs true ())
            (rewrite (premise ha) lr lhs true ())
            (unfold lx_take_r lhs)))
         (have hlt (= (lt i (+ i 0)) False) (by arith (rows (goal 1))))
         (steps ((rewrite (premise hlt) lr lhs true ()) (compute both)))
         refl))
     (case Cons
       (b bs2)
       (chain
         (have hl (= (ssm_len (Cons b bs2)) (S (ssm_len bs2)))
           (steps ((unfold ssm_len lhs) (reduce lhs)) refl))
         (have ha (= (ssm_app (Cons b bs2) t) (Cons b (ssm_app bs2 t)))
           (steps ((unfold ssm_app lhs) (reduce lhs)) refl))
         (have hm (= (ssm_msk (Cons b bs2)) (Cons (mod b 256) (ssm_msk bs2)))
           (steps ((unfold ssm_msk lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hl) lr lhs true ())
            (rewrite (lemma int_of_nat_succ) lr lhs true ())
            (rewrite (premise ha) lr lhs true ())
            (rewrite (premise hm) lr rhs true ())
            (unfold lx_take_r lhs)))
         (have hnn (= (le 0 (int_of_nat (ssm_len bs2))) True)
           (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
         (have hlt (= (lt i (+ i (+ 1 (int_of_nat (ssm_len bs2))))) True)
           (by arith (rows (goal 1) (hnn 1))))
         (steps
           ((rewrite (premise hlt) lr lhs true ())
            (compute
              lhs
              (stop lx_take_r ssm_app ssm_msk ssm_len int_of_nat mod))))
         (have hsh
           (=
             (+ i (+ 1 (int_of_nat (ssm_len bs2))))
             (+ (+ i 1) (int_of_nat (ssm_len bs2))))
           (by arith (list (list 1) (list 1))))
         (steps
           ((rewrite (premise hsh) lr lhs true ())
            (rewrite (hyp 0) lr lhs true ())
            (compute both (stop ssm_msk mod))))
         refl)))))

(claim ssm_take
  (goal ((bs (List Int)) (t (List Int))) ()
    (=
      (lx_take (ssm_app bs t) (int_of_nat (ssm_len bs)))
      (Some (Pair (ssm_msk bs) t))))
  (chain
    (steps ((unfold lx_take lhs)))
    (have hz (= (int_of_nat (ssm_len bs)) (+ 0 (int_of_nat (ssm_len bs))))
      (by arith (list (list 1) (list 1))))
    (steps
      ((rewrite (premise hz) lr lhs true ())
       (rewrite (lemma ssm_take_go) lr lhs true ()))
      refl)))

(claim ssm_take_it
  (goal ((it SsmIt) (t (List Int))) ()
    (=
      (lx_take (ssm_app (ssm_ibs it) t) (ssm_ilen it))
      (Some (Pair (ssm_msk (ssm_ibs it)) t))))
  (chain
    (steps ((unfold ssm_ilen lhs) (rewrite (lemma ssm_take) lr lhs true ())))
    refl))

;; a fill strictly above the probed cell is invisible (the state-below-
;; the-buffer framing law, M0's scp_fill_below)
(claim ssm_fill_below
  (goal ((ds (List Int)) (m Mem) (q Int) (p Int)) ((= (lt p q) True))
    (= (mem_get (lx_fill m q ds) p) (mem_get m p)))
  (induct ds
    ((case Nil
       (chain
         (have hf (= (lx_fill m q Nil) m)
           (steps ((unfold lx_fill lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hf) lr lhs true ())) refl)))
     (case Cons
       (d t)
       (chain
         (have hf
           (= (lx_fill m q (Cons d t)) (lx_fill (mem_set m q d) (+ q 1) t))
           (steps ((unfold lx_fill lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hf) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1))))))
         (rewrite-with
           (lemma get_set_other)
           lr
           lhs
           ()
           ((rewrite-with
              (lemma ssm_ne_lt)
              lr
              lhs
              ()
              ((steps ((rewrite (premise 0) lr lhs true ())) refl))
              refl)))
         refl)))))

;; the total cell reads back through the buffer fill: ibt_v's eight
;; byte probes all sit strictly below 128
(claim ssm_ibtv_fill
  (goal ((ds (List Int)) (m Mem)) ()
    (= (ibt_v (lx_fill m 65664 ds) 65536) (ibt_v m 65536)))
  (chain
    (steps
      ((unfold ibt_v lhs)
       (unfold ibt_v rhs)
       (compute lhs (stop mem_get lx_fill mod))
       (compute rhs (stop mem_get mod))))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    (rewrite-with
      (lemma ssm_fill_below)
      lr
      lhs
      ()
      ((steps ((compute both)) refl)))
    refl))

(claim ssm_ilen_nn
  (goal ((it SsmIt)) () (= (le 0 (ssm_ilen it)) True))
  (chain
    (steps ((unfold ssm_ilen lhs)))
    (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl)))

(claim ssm_ilen_ge1
  (goal ((it SsmIt)) () (= (le 1 (ssm_ilen it)) True))
  (chain
    (have hl (= (ssm_len (ssm_ibs it)) (S (ssm_len (smbs_of it))))
      (steps ((unfold ssm_ibs lhs) (unfold ssm_len lhs) (reduce lhs)) refl))
    (have hnn (= (le 0 (int_of_nat (ssm_len (smbs_of it)))) True)
      (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
    (steps
      ((unfold ssm_ilen lhs)
       (rewrite (premise hl) lr lhs true ())
       (rewrite (lemma int_of_nat_succ) lr lhs true ())))
    (steps () (by arith (rows (goal 1) (hnn 1))))))

;; --- THE FUEL-SLAB KIT -----------------------------------------------------------
;;
;; ssm_pad b k c lays (b - k) S's over c (for k <= b): the COMPLEMENT of
;; a callee's ghost tower inside a ground fuel slab. ssm_lg_pad then
;; collapses lg_fuel k (ssm_pad b k c) to lg_fuel b c — which computes
;; to a plain S-tower at ground b — so a ground head fuel REWRITES into
;; a cert's exact (lg_fuel GHOST …) spelling at the call site. Recursion
;; on k, the exhausted arm delegating to lg_fuel whole: no ground Nat
;; spelled in any arm (canon C6/C8 quiet), and the k = Z leg of the
;; collapse is definitional.

(fn ssm_pad ((b Nat) (k Nat) (c Nat)) Nat
  (measure (struct k))
  (match k
    (Z (lg_fuel b c))
    ((S k2)
     (match b
       (Z c)
       ((S b2) (ssm_pad b2 k2 c))))))

(claim ssm_lg_pad
  (goal ((k Nat) (b Nat) (c Nat)) ((= (le (int_of_nat k) (int_of_nat b)) True))
    (= (lg_fuel k (ssm_pad b k c)) (lg_fuel b c)))
  (induct k
    ((case Z
       (chain
         (have h1 (= (lg_fuel Z (ssm_pad b Z c)) (ssm_pad b Z c))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (have h2 (= (ssm_pad b Z c) (lg_fuel b c))
           (steps ((unfold ssm_pad lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise h1) lr lhs true ())
            (rewrite (premise h2) lr lhs true ()))
           refl)))
     (case S
       (k2)
       (case-on b Nat
         ((case Z
            (chain
