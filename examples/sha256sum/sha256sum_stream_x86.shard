;; --- the composition folds -------------------------------------------------------
;;
;; ssm_step spells the data piece's exit memory VERBATIM at the
;; wnat-exhibited ghosts (kb/krem := wnat of their coherence values), so
;; the walks' inductions align by ONE unfold — no per-step rewriting.
;; The coherence lemmas below discharge the pieces' ghost premises at
;; exactly those instantiations.

(fn ssm_step ((m Mem) (it SsmIt)) Mem
  (icp_mem
    (shx_mem
      (ibtw_mem
        (mem_set
          (mem_set
            (mem_set (lx_fill m 128 (ssm_msk (ssm_ibs it))) 9 (ssm_ilen it))
            10
            (bshr (ssm_ilen it) 8))
          8
          (int_of_nat (wnat (band (+ (band (ibt_v m 0) 63) (ssm_ilen it)) 63))))
        0
        (mod (+ (ibt_v m 0) (ssm_ilen it)) 18446744073709551616))
      (- 128 (band (ibt_v m 0) 63))
      (wnat (bshr (+ (band (ibt_v m 0) 63) (ssm_ilen it)) 6)))
    (-
      128
      (int_of_nat (wnat (band (+ (band (ibt_v m 0) 63) (ssm_ilen it)) 63))))
    (-
      (+ 128 (ssm_ilen it))
      (int_of_nat (wnat (band (+ (band (ibt_v m 0) 63) (ssm_ilen it)) 63))))
    (wnat (band (+ (band (ibt_v m 0) 63) (ssm_ilen it)) 63))))

(fn ssm_mem ((m Mem) (its (List SsmIt))) Mem
  (measure (struct its))
  (match its
    (Nil m)
    ((Cons it rest) (ssm_mem (ssm_step m it) rest))))

(fn ssm_tr ((its (List SsmIt)) (k (List LxEvent))) (List LxEvent)
  (measure (struct its))
  (match its
    (Nil k)
    ((Cons it rest) (Cons (LxRead 0 (ssm_msk (ssm_ibs it))) (ssm_tr rest k)))))

