;; --- the cap premise, split across the record list (M0 transplants) --------------

(claim ssm_ok_hd
  (goal ((it SsmIt) (rest (List SsmIt))) ((= (ssm_ok (Cons it rest)) True))
    (= (le (ssm_ilen it) 4096) True))
  (case-on (le (ssm_ilen it) 4096) Bool
    ((case True (steps ((rewrite (hyp 0) lr lhs true ())) refl))
     (case False
       (have hf (= (ssm_ok (Cons it rest)) False)
         (steps
           ((unfold ssm_ok lhs)
            (reduce lhs)
            (rewrite (hyp 0) lr lhs true ())
            (reduce lhs))
           refl)
         (have contra (= True False)
           (steps
             ((rewrite (premise 0) rl lhs true ())
              (rewrite (premise hf) lr lhs true ()))
             refl)
           (absurd (premise contra))))))))

(claim ssm_ok_tl
  (goal ((it SsmIt) (rest (List SsmIt))) ((= (ssm_ok (Cons it rest)) True))
    (= (ssm_ok rest) True))
  (case-on (le (ssm_ilen it) 4096) Bool
    ((case True
       (have hred (= (ssm_ok (Cons it rest)) (ssm_ok rest))
         (steps
           ((unfold ssm_ok lhs)
            (reduce lhs)
            (rewrite (hyp 0) lr lhs true ())
            (reduce lhs))
           refl)
         (steps
           ((rewrite (premise hred) rl lhs true ())
            (rewrite (premise 0) lr lhs true ()))
           refl)))
     (case False
       (have hf (= (ssm_ok (Cons it rest)) False)
         (steps
           ((unfold ssm_ok lhs)
            (reduce lhs)
            (rewrite (hyp 0) lr lhs true ())
            (reduce lhs))
           refl)
         (have contra (= True False)
           (steps
             ((rewrite (premise 0) rl lhs true ())
              (rewrite (premise hf) lr lhs true ()))
             refl)
           (absurd (premise contra))))))))

