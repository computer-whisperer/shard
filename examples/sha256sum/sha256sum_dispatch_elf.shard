;; --- the bytes ----------------------------------------------------------------

(fn dsx_nth ((xs (List Int)) (i Int)) Int
  (measure (struct xs))
  (match xs
    (Nil 0)
    ((Cons h t) (if (int_eq i 0) h (dsx_nth t (- i 1))))))

;; the index-order image — the bytes of the 31 functions, in module order:
;; scalar 0-14, SHA-NI 15-29 (call targets already shifted by `xlk_shfns`),
;; the CPUID stub 30
(fn dsx_elf_image () (List Int) (enc_image_ord (dsx_xfuncs)))

;; their offsets in that image; slot 30 is the dispatch stub, the entry
(fn dsx_elf_offsets () (List Int) (img_offs_ord (dsx_xfuncs) 0))

(fn dsx_entry_off () Int (dsx_nth (dsx_elf_offsets) 30))

;; the whole capless ELF: window [65536, 131072) = the merged module's own
;; (MkXModule … 65536 131072) bounds, at win_base = stock vm.mmap_min_addr.
(fn dsx_elf () (List Int)
  (enc_winelf (dsx_elf_image) (dsx_entry_off) 65536 65536))
