;; word-grain nth (the ikh_k_read extraction helper)
(fn vim_nth ((k Int) (xs (List Int))) Int
  (measure (struct xs))
  (match xs
    (Nil 0)
    ((Cons h t) (if (lt k 1) h (vim_nth (- k 1) t)))))

