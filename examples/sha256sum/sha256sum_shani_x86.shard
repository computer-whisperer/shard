    (XMovRI RCX 65546)
    (XStore8 (AReg RCX) (SReg RAX))
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDX 65546)
    (XLoad8 RAX (AReg RDX))
    (XShlI RAX 8)
    (XMovRI RDX 65545)
    (XLoad8 RBX (AReg RDX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRR RBX RCX)
    (XBin XAdd RBX (SReg RAX))
    (XMovRR RBP RBX)
    (XBin XAnd RBP (SImm 63))
    (XShrI RBX 6)
    (XMovRI RDX 65544)
    (XStore8 (AReg RDX) (SReg RBP))
    (XBin XAdd RSI (SReg RAX))
    (XCall 4)
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RBX)
    (XMovRI RCX 0)
    (XMovRI RBX 0)
    (XMovRI RBP 0)
    (XCall 1)
    (XMovRI RCX 65544)
    (XLoad8 RDX (AReg RCX))
    (XMovRI RCX 65546)
    (XLoad8 RAX (AReg RCX))
    (XShlI RAX 8)
    (XMovRI RCX 65545)
    (XLoad8 RBX (AReg RCX))
    (XBin XAdd RAX (SReg RBX))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RDX))
    (XMovRI RSI 65664)
    (XBin XAdd RSI (SReg RAX))
    (XBin XSub RSI (SReg RDX))
    (XCall 2)))

(fn vfm_fin () (List XInstr)
  (list
    (XMovRI RAX 0)
    (XMovRI RDI 65536)
    (XCall 3)
    (XMovRR R9 RSI)
    (XMovRR RCX RSI)
    (XBin XAnd RCX (SImm 63))
    (XMovRI RDI 65664)
    (XBin XSub RDI (SReg RCX))
    (XMovRR RSI RCX)
    (XCall 6)
    (XBin XAdd RSI (SImm 72))
    (XShrI RSI 6)
    (XMovRI RCX 0)
    (XMovRI R8 0)
    (XMovRI R9 0)
    (XCall 1)
    (XMovRI R12 0)
    (XMovRI RDI 65536)
    (XMovRI RSI 131008)
    (XCall 7)))

(fn vfm_loop () (List XInstr)
  (list
    (XMovRI RDI 0)
    (XMovRI RSI 65664)
    (XMovRI RDX 61440)
    (XCall 10)
    (XBlock (list (XBrIf (CLeU RAX (SImm 61440)) 0) (XMovRI RDI 1) (XCall 12)))
    (XBlock
      (list
        (XBrIf (CNz RAX) 0)
        (XMovRI R11 0)
        (XMovRI RBX 0)
        (XMovRI R12 0)
        (XCall 8)
        (XMovRI RDI 1)
        (XMovRI RSI 65536)
        (XMovRI RDX 64)
        (XCall 11)
        (XMovRI RDI 0)
        (XCall 12)))
    (XMovRR RDI RAX)
    (XMovRI R11 0)
    (XMovRI RBX 0)
    (XMovRI R12 0)
    (XCall 5)
    (XBr 0)))

(fn vfm_read () (List XInstr) (list (XMovRI RAX 0) XSyscall))

(fn vfm_write () (List XInstr) (list (XMovRI RAX 1) XSyscall))

(fn vfm_exit () (List XInstr) (list (XMovRI RAX 60) XSyscall))

