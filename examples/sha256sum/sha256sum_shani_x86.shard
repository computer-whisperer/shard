  (steps ((compute both)) refl))

;; byte read below the K home sees through ikh_mem (ssw_get_ikh transplant;
;; mem_get is opaque outside std/mem -- go through mem_read at width one)
(fn vim_hd ((xs (List Int))) Int
  (match xs
    (Nil 0)
    ((Cons h t) h)))

(claim vim_gikh
  (goal ((m Mem) (p Int)) ((= (le (+ p 1) 130752) True))
    (= (mem_get (ikh_mem m) p) (mem_get m p)))
  (chain
    (have hw1 (= (+ p (int_of_nat (S Z))) (+ p 1))
      (steps
        ((rewrite (lemma int_of_nat_succ) lr lhs true ())
         (rewrite (lemma int_of_nat_zero) lr lhs true ()))
        (by arith (list (list 1) (list 1)))))
    (have hb (= (le (+ p (int_of_nat (S Z))) 130752) True)
      (steps
        ((rewrite (premise hw1) lr lhs true ())
         (rewrite (premise 0) lr lhs true ()))
        refl))
    (have h1 (= (mem_read (S Z) (ikh_mem m) p) (mem_read (S Z) m p))
      (rewrite-with
        (lemma ish_read_ikh_below)
        lr
        lhs
        ()
        ((steps ((rewrite (premise hb) lr lhs true ())) refl))
        refl))
    (have h2
      (= (mem_read (S Z) (ikh_mem m) p) (Cons (mem_get (ikh_mem m) p) Nil))
      (steps
        ((rewrite (lemma mem_read_s) lr lhs true ())
         (rewrite (lemma mem_read_z) lr lhs true ()))
        refl))
    (have h3 (= (mem_read (S Z) m p) (Cons (mem_get m p) Nil))
      (steps
        ((rewrite (lemma mem_read_s) lr lhs true ())
         (rewrite (lemma mem_read_z) lr lhs true ()))
        refl))
    (have h4 (= (Cons (mem_get (ikh_mem m) p) Nil) (Cons (mem_get m p) Nil))
      (steps
        ((rewrite (premise h2) rl lhs true ())
         (rewrite (premise h1) lr lhs true ())
         (rewrite (premise h3) lr lhs true ()))
        refl))
    (have h5
      (=
        (vim_hd (Cons (mem_get (ikh_mem m) p) Nil))
        (vim_hd (Cons (mem_get m p) Nil)))
      (steps ((rewrite (premise h4) lr lhs true ())) refl))
    (have h6
      (= (vim_hd (Cons (mem_get (ikh_mem m) p) Nil)) (mem_get (ikh_mem m) p))
      (steps ((unfold vim_hd lhs) (reduce lhs)) refl))
    (have h7 (= (vim_hd (Cons (mem_get m p) Nil)) (mem_get m p))
      (steps ((unfold vim_hd lhs) (reduce lhs)) refl))
    (steps
      ((rewrite (premise h6) rl lhs true ())
       (rewrite (premise h5) lr lhs true ())
       (rewrite (premise h7) lr lhs true ()))
      refl)))


