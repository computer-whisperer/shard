(fn vfm_copy () (List XInstr)
  (list
    (XBrIf (CEqz RDX) 1)
    (XLoad8 RCX (AReg RSI))
    (XMovRR RAX RCX)
    (XBin XAnd RAX (SImm 255))
    (XStore8 (AReg RDI) (SReg RAX))
    (XBin32 XAdd RDI (SImm 1))
    (XBin32 XAdd RSI (SImm 1))
    (XMovRI RCX 0)
    (XBin32 XSub RDX (SImm 1))
    (XMovRI RAX 0)
    (XBr 0)))

