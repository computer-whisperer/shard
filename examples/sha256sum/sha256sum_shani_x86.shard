(fn vfm_m () XModule
  (MkXModule
    (Cons
      (MkXFunc 0 (gb_shblock_x))
      (Cons
        (MkXFunc 2 (snw_wrap))
        (Cons
          (MkXFunc
            0
            (list
              (XMovRI RCX 0)
              (XMovRI RAX 0)
              (XBlock (list (XLoop (vfm_copy))))
              (XMovRI RAX 0)))
          (Cons
            (MkXFunc 0 (gb_shtotr_x))
            (Cons
              (MkXFunc 0 (gb_shtotw_x))
              (Cons
                (MkXFunc 0 (vfm_abs))
                (Cons
                  (MkXFunc 0 (gb_shfpad_x))
                  (Cons
                    (MkXFunc 0 (gb_shhex_x))
                    (Cons
                      (MkXFunc 0 (vfm_fin))
                      (Cons
                        (MkXFunc
                          0
                          (list (XCall 13) (XBlock (list (XLoop (vfm_loop))))))
                        (Cons
                          (MkXFunc 0 (vfm_read))
                          (Cons
                            (MkXFunc 0 (vfm_write))
                            (Cons
                              (MkXFunc 0 (vfm_exit))
                              (Cons
                                (MkXFunc 0 (vfm_init))
                                (Cons (MkXFunc 0 (gb_shinit_x)) Nil)))))))))))))))
    65536
    131072))

;; ==== E3 SLICE C part 2 chunk 2: THE INIT-WALK TWIN (fn 13 at wveval grain) ====
;;
;; Descriptors: vim_msk = the 16 mask byte-sets (walk spelling, first store
;; innermost); vim_kn n i = the memory after K groups 0..i-1 converted BE->LE
;; in place (each level references level i-1 TWICE -- the walk keeps it
;; FOLDED via the ground fold equations vim_kf1..16, refolding at each
;; stanza's mask-fence stick so the accumulated term stays LINEAR);
;; vki_mem = the whole init transform over ikh_mem (fn 14's effect).

(fn vim_msk ((n Mem)) Mem
  (mem_set
    (mem_set
      (mem_set
        (mem_set
          (mem_set
            (mem_set
              (mem_set
                (mem_set
                  (mem_set
                    (mem_set
                      (mem_set
                        (mem_set
                          (mem_set
                            (mem_set
                              (mem_set (mem_set n 130496 3) 130497 2)
                              130498
                              1)
                            130499
                            0)
                          130500
                          7)
                        130501
                        6)
                      130502
                      5)
                    130503
                    4)
                  130504
                  11)
                130505
                10)
              130506
              9)
            130507
            8)
          130508
          15)
        130509
        14)
      130510
      13)
    130511
    12))

;; the fold equation: the walk's raw mask nest IS vim_msk
(claim vim_mskf
  (goal ((n Mem)) ()
    (=
      (mem_set
        (mem_set
          (mem_set
            (mem_set
              (mem_set
                (mem_set
                  (mem_set
                    (mem_set
                      (mem_set
                        (mem_set
                          (mem_set
                            (mem_set
                              (mem_set
                                (mem_set
                                  (mem_set (mem_set n 130496 3) 130497 2)
                                  130498
                                  1)
                                130499
                                0)
                              130500
                              7)
                            130501
                            6)
                          130502
                          5)
                        130503
                        4)
                      130504
                      11)
                    130505
                    10)
                  130506
                  9)
                130507
                8)
              130508
              15)
            130509
            14)
          130510
          13)
        130511
        12)
      (vim_msk n)))
  (steps ((unfold vim_msk rhs)) refl))

;; K-conversion state: groups 0..i-1 done (group j at 130752+16j; the value
;; spelling is the WALK's own -- vbswap of the vload of the accumulated mem)
(fn vim_kn ((n Mem) (i Int)) Mem
  (measure
    i
    (by arith (list 1 0))
    (by arith (list 1 1))
    (by arith (list 1 0))
    (by arith (list 1 1)))
  (if (lt i 1) n
  (vstore
    (vim_kn n (- i 1))
    (+ 130752 (* 16 (- i 1)))
    (vbswap (vload (vim_kn n (- i 1)) (+ 130752 (* 16 (- i 1))))))))

(fn vki_mem ((m Mem)) Mem (vim_kn (vim_msk (ikh_mem m)) 16))

;; ground fold equations: one stanza's raw store over the compact level
;; i-1 refolds to compact level i (the walk cites these lr at each stick)
(claim vim_kf1
  (goal ((n Mem)) ()
    (= (vstore n 130752 (vbswap (vload n 130752))) (vim_kn n 1)))
  (steps
    ((unfold vim_kn rhs)
     (compute rhs (stop vim_kn vstore vload vbswap mem_set ikh_mem))
     (compute rhs (stop vstore vload vbswap mem_set ikh_mem)))
    refl))

(claim vim_kf2
  (goal ((n Mem)) ()
    (=
      (vstore (vim_kn n 1) 130768 (vbswap (vload (vim_kn n 1) 130768)))
      (vim_kn n 2)))
  (steps
    ((unfold vim_kn rhs)
     (compute rhs (stop vim_kn vstore vload vbswap mem_set ikh_mem)))
    refl))

