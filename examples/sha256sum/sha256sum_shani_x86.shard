;; ==== E3 SLICE C part 2 chunk 3: THE WVEVAL TWIN TOWER ======================
;;
;; The scalar-callee ladders (vin_x14/xv14/wv14 pattern): each sweld walk
;; cert lifted to wveval_call grain over the variant module through the
;; two bridges. Fuel = the inner cert's tower + one S at the call layer.

(claim vsm_push249
  (goal ((k Nat) (c Nat)) () (= (lg_fuel k (S^ 249 c)) (S^ 249 (lg_fuel k c))))
  (induct k
    ((case Z (steps ((compute both)) refl))
     (case S
       (k2)
       (chain
         (have hs (= (lg_fuel (S k2) (S^ 249 c)) (S (lg_fuel k2 (S^ 249 c))))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (have hs2 (= (lg_fuel (S k2) c) (S (lg_fuel k2 c)))
           (steps ((unfold lg_fuel lhs) (reduce lhs)) refl))
         (steps
           ((rewrite (premise hs) lr lhs true ())
            (rewrite (premise hs2) lr rhs true ())
            (rewrite (hyp 0) lr lhs true ()))
           refl))))))

