;; ---- the composition folds + the vector-cell preservation -----------------
;; vsm_step = the data piece's exit memory at the wnat-exhibited ghosts
;; (ssm_step with the fold sandwich swapped in); the walks' inductions
;; align by ONE unfold. vsm_vstep_thru carries the 18 vector-cell
;; premises across one iteration (every write layer sits below 130496
;; or above-at the H homes).

(claim vsm_vicp
  (goal ((m Mem) (q Int) (s Int) (p Int) (k Nat))
    ((= (le (+ q (int_of_nat k)) p) True))
    (= (vload (icp_mem m q s k) p) (vload m p)))
  (induct k
    ((case Z
       (chain
         (have hz (= (icp_mem m q s Z) m)
           (steps ((unfold icp_mem lhs) (reduce lhs)) refl))
         (steps ((rewrite (premise hz) lr lhs true ())) refl)))
     (case S
       (k2)
       (chain
         (have hs
           (=
             (icp_mem m q s (S k2))
             (icp_mem (mem_set m q (mem_get m s)) (+ q 1) (+ s 1) k2))
           (steps ((unfold icp_mem lhs) (reduce lhs)) refl))
         (have hsc (= (int_of_nat (S k2)) (+ 1 (int_of_nat k2)))
           (steps ((rewrite (lemma int_of_nat_succ) lr lhs true ())) refl))
         (have hnn2 (= (le 0 (int_of_nat k2)) True)
           (rewrite-with (lemma int_of_nat_nonneg) lr lhs () () refl))
         (have hb (= (le (+ (+ q 1) (int_of_nat k2)) p) True)
           (steps () (by arith (rows (goal 1) (0 1) (hsc 1)))))
         (steps ((rewrite (premise hs) lr lhs true ())))
         (rewrite-with
           (hyp 0)
           lr
           lhs
           ((inst m (mem_set m q (mem_get m s)))
            (inst q (+ q 1))
            (inst s (+ s 1)))
           ((steps ((rewrite (premise hb) lr lhs true ())) refl)))
         (rewrite-with
           (lemma vim_vsa)
           lr
           lhs
           ()
           ((steps () (by arith (rows (goal 1) (0 1) (hsc 1) (hnn2 1))))))
         refl)))))

(fn vsm_step ((m Mem) (it SsmIt)) Mem
  (icp_mem
    (snw_hbsw
      (snw_fmem
        (snw_hbsw
          (ibtw_mem
            (mem_set
              (mem_set
                (mem_set
                  (lx_fill m 65664 (ssm_msk (ssm_ibs it)))
                  65545
                  (ssm_ilen it))
                65546
                (bshr (ssm_ilen it) 8))
              65544
              (int_of_nat
                (wnat (band (+ (band (ibt_v m 65536) 63) (ssm_ilen it)) 63))))
            65536
            (mod (+ (ibt_v m 65536) (ssm_ilen it)) 18446744073709551616)))
        (- 65664 (band (ibt_v m 65536) 63))
        (wnat (bshr (+ (band (ibt_v m 65536) 63) (ssm_ilen it)) 6))))
    (-
      65664
      (int_of_nat (wnat (band (+ (band (ibt_v m 65536) 63) (ssm_ilen it)) 63))))
    (-
      (+ 65664 (ssm_ilen it))
      (int_of_nat (wnat (band (+ (band (ibt_v m 65536) 63) (ssm_ilen it)) 63))))
    (wnat (band (+ (band (ibt_v m 65536) 63) (ssm_ilen it)) 63))))

(fn vsm_mem ((m Mem) (its (List SsmIt))) Mem
  (measure (struct its))
  (match its
    (Nil m)
    ((Cons it rest) (vsm_mem (vsm_step m it) rest))))

(claim vsm_vstep_thru
