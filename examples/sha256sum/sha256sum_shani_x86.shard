;; the mask fence, ground (the walk stops vxeq to force per-stanza sticks;
;; this unsticks each one)
(claim vim_vxm
  (goal () ()
    (= (vxeq (vbswap_mask) (MkXmm 66051 67438087 134810123 202182159)) True))
  (steps ((compute both)) refl))

(claim vim_vxg
  (goal () ()
