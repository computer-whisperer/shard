;; ==== E3 SLICE C WELD TIER (vsw_): the value half over the sandwich =========
;; The variant absorber/finalizer memory carries snw_hbsw . snw_fmem .
;; snw_hbsw where the skeleton carried shx_mem.  This tier re-derives the
;; sweld readbacks over that sandwich and seals the Done leg to
;; bytes_hex (sha256 (scat chunks)).  K premises are DROPPED throughout:
;; the variant K window is LE (the BE observation is false) and the vector
;; fold bakes its K constants -- nothing reads K at the value tier.

;; ---- the H-observation kit: wget bounds, the bswap converse, the
;; ---- double-swap collapse, and the two window observations ------------------

(claim vsw_wg_hi
  (goal ((m Mem) (a Int)) () (= (lt (wget m a) 4294967296) True))
  (chain
    (steps ((unfold wget lhs) (unfold word_be lhs)))
    (have hg0 (= (lt (mem_get m a) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg1 (= (lt (mem_get m (+ a 1)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg2 (= (lt (mem_get m (+ a 2)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (have hg3 (= (lt (mem_get m (+ a 3)) 256) True)
      (rewrite-with (lemma get_hi) lr lhs () () refl))
    (steps
      ()
      (by arith (rows (goal 1) (hg0 16777216) (hg1 65536) (hg2 256) (hg3 1))))))

