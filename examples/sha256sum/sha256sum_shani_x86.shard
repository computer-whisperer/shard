(claim vsw_gvsa
  (goal ((m Mem) (q Int) (v Xmm) (a Int)) ((= (le (+ q 16) a) True))
    (= (mem_get (vstore m q v) a) (mem_get m a)))
  (chain
    (steps ((unfold vstore lhs)))
    (rewrite-with
      (lemma store_le_get_above)
      lr
      lhs
      ()
      ((steps
         ((rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_zero) lr lhs true ()))
         (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma store_le_get_above)
      lr
      lhs
      ()
      ((steps
         ((rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_zero) lr lhs true ()))
         (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma store_le_get_above)
      lr
      lhs
      ()
      ((steps
         ((rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_zero) lr lhs true ()))
         (by arith (rows (goal 1) (0 1))))))
    (rewrite-with
      (lemma store_le_get_above)
      lr
      lhs
      ()
      ((steps
         ((rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_succ) lr lhs true ())
          (rewrite (lemma int_of_nat_zero) lr lhs true ()))
         (by arith (rows (goal 1) (0 1))))))
    refl))

