;; ---- the iteration pieces: one loop-body pass per oracle outcome ----------
;; (head S^1385: the absorber site lands at S^1372 exactly; the XMM file
;; is ground-zero at every loop head -- init establishes it, the absorber
;; and the fold re-zero it)

(fn vsm_pre ((tr (List LxEvent)) (o (Option WVOut))) (Option WVOut)
  (match o
    (None None)
    ((Some out) (Some (wvtr_pre tr out)))))

