;;; examples/sha256sum/sha256sum_write.shard — RUN-ONLY emit glue for the pure
;;; one-shot ELF emitter (examples/sha256sum/sha256sum_elf.shard). It writes the
;;; emitter's bytes to examples/sha256sum/sha256sum and exits; it computes
;;; nothing and proves nothing.
;;;
;;; ⚠ NEVER A CORPUS TARGET — and unlike its streaming twin, this one CANNOT
;;; be. Importing kernel/loader.shard for the World main puts loader's eight IO
;;; externs (get_args, read_file, read_dir, write, write_file, write_line, exit,
;;; read_key) in the closure, and this closure ALSO carries the
;;; `(bin sha256sum_oneshot … (externs nw_read nw_write nw_exit))` form — via
;;; sha256sum_elf → sha256sum_x86_out → sha256sum_src. The bin-boundary law
;;; demands the declared-extern surface EQUAL the bin's list, so `bin/check` on
;;; this file reports `boundary: a declared extern is not listed in
;;; (bin externs)` once per loader extern. That is the law WORKING, not a
;;; defect: a product is written by a run-mode World program, never statically
;;; fused into a bin's closure, and quarantining the writer here is what keeps
;;; the emitter article pure. Adding this file to run_corpus.sh's TARGETS would
;;; turn a correct refusal into a red build.
;;;
;;; The pure side — examples/sha256sum/sha256sum_elf.shard — IS a corpus
;;; target, and it checks green with exactly the bin's three externs reachable.
;;;
;;; Run:  bin/shard_eval run examples/sha256sum/sha256sum_write.shard
;;; Effect: writes examples/sha256sum/sha256sum (repo-relative) — an ELF64
;;;         whose RW window sits at 65536, so it is CAPLESS: no setcap, no
;;;         vm.mmap_min_addr change, no non-nosuid-filesystem requirement.
;;;         examples/sha256sum/sha256sum_silicon_diff.sh drives this.

(import "../../kernel/loader.shard")
(import "sha256sum_elf.shard")
(use (:: kernel loader *))
(use (:: examples sha256sum sha256sum_elf shs_elf))

(fn main ((w World)) World
  (match (write_file "examples/sha256sum/sha256sum" (shs_elf) w)
    ((Pair ok w2) (exit (if ok 0 1) w2))))
