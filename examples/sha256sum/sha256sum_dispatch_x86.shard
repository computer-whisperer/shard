;; --- the fuel pad + slack, the merged-module windows, the crossing, and ---------
;; --- both families' transfers onto the merged module ----------------------------

(fn dsm_pad ((j Nat) (c Nat)) Nat
  (measure (struct j))
  (match j
    (Z c)
    ((S k) (S (dsm_pad k c)))))

(claim dsm_padS
  (goal ((j Nat) (x Nat)) () (= (dsm_pad j (S x)) (S (dsm_pad j x))))
  (induct j
    ((case Z (steps ((compute both)) refl))
     (case S
       (k)
       (steps
         ((unfold dsm_pad lhs)
          (reduce lhs)
          (unfold dsm_pad rhs)
          (reduce rhs)
          (rewrite (hyp 0) lr lhs true ()))
         refl)))))

(claim dsm_fuel_pad
  (goal ((its (List SsmIt)) (j Nat) (c Nat)) ()
    (= (ssm_fuel its (dsm_pad j c)) (dsm_pad j (ssm_fuel its c))))
  (induct its
    ((case Nil (steps ((compute both)) refl))
     (case Cons
       (it rest)
       (steps
         ((unfold ssm_fuel lhs)
          (reduce lhs)
          (unfold ssm_fuel rhs)
          (reduce rhs)
          (rewrite (hyp 0) lr lhs true ())
          (rewrite (lemma dsm_padS) lr rhs true ()))
         refl)))))

