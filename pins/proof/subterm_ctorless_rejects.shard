;;; subterm_ctorless_rejects.shard — SOUNDNESS pin for subterm-induct's DATATYPE
;;; gate. Both claims must FAIL and the binary must exit non-zero. The third
;;; file in the (below) family: subterm_induct_rejects pins the reflexive
;;; citation, below_resolve_rejects pins the hypothesis resolution, this one
;;; pins what may be inducted on in the first place.
;;;
;;; THE SHAPE (2026-07-25). `subterm_is_datatype` asked only whether the split
;;; var's type resolves to a TYPEDEF — and a typedef with ZERO constructors is
;;; one. `(type Zed (refine Int zero_p))` is such a type: nominal, nullary, its
;;; values ARE their Int carriers, and it has no constructor form anywhere. ⊰ is
;;; well-founded on an inductive datatype's values; on a ctorless type it has
;;; nothing to descend, so the strong IH is issued over an order that is empty
;;; by construction. That is the issue-#16 shape, which Induct has refused since
;;; the zerocase fix ("a zero-case induct is vacuously exhaustive") — the
;;; subterm twin was written without the same gate.
;;;
;;; It was not exploitable, and PIN 1 records exactly how close it got: measured
;;; before the fix, subterm-induct on Zed was ADMITTED, the IH landed as Hyp 0,
;;; the citation passed the type gate and the rewrite APPLIED (`after rewrite
;;; (hyp 0): 5 = 5`), leaving one obligation — `(subterm_below z z) = True` —
;;; which `(below)` refused because z has no constructor form to resolve to.
;;; So the whole refusal rested on do_below's CTORFORM requirement, three layers
;;; below the gate whose job it was. A guard whose stated purpose ("a misuse is
;;; a clean rejection, not a vacuous IH") is discharged somewhere else is not a
;;; guard; both now hold independently.
;;;
;;; FLIP DETECTION: this file is 0 passed, 2 failed. PIN 1 flips to a `below`
;;; refusal if the ctor check is dropped (still red — that is the layer behind
;;; it) and PASSES if do_below's CTORFORM requirement is ALSO lost, proving
;;; 0 = 5 for a type whose only inhabitant is 0. PIN 2 is the gate's original
;;; purpose and must never move. Both legs report as `FAIL`, so both are visible
;;; to CI's fail-set projection.

(import "../../kernel/stdlib.shard")

(fn zero_p ((x Int)) Bool (int_eq x 0))

(type Zed (refine Int zero_p))

(fn obs ((z Zed)) Int (refine_val z))

;; PIN 1 — FALSE (obs z is 0 for every inhabitant, by the refinement predicate).
;; The IH is cited AT z ITSELF: the pattern (obs z') matches the goal's own lhs
;; and binds z' := z, so the entire proof rests on whether (subterm_below z z)
;; can be discharged for a type with no constructors.
(claim vacuous_refined
  (goal ((z Zed)) () (= (obs z) 5))
  (subterm-induct z (rewrite-with (hyp ih) lr lhs () ((below)) refl)))

;; PIN 2 — a plain Int param: not a typedef at all, and the case the gate was
;; written for. Refused at the gate itself, before any IH exists.
(claim vacuous_int
  (goal ((k Int)) () (= 0 1))
  (subterm-induct k (rewrite-with (hyp ih) lr lhs () ((below)) refl)))
