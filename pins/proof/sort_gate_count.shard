;;; sort_gate_count.shard — CERT.md's recorded boundary (2) for the
;;; literal-sort gate: on a bare-literal pattern, occurrence counting
;;; (`false` / `(at K)`) counts only sort-compatible sites — a refused site
;;; is skipped, NOT counted. The Nat-sorted 16 (sg_ni's first param) is
;;; refused for the Int replacement x, so the Int-sorted 16 is site 0 and
;;; there is no site 1. See sort_gate.shard / sort_gate_rejects.shard for
;;; the gate's accepted / refused shapes.

(import "../../kernel/stdlib.shard")

(fn sg_ni ((k Nat) (j Int)) Int j)

;; (at 0) lands on the Int position — the refused Nat position before it is
;; not counted.
(claim sgc_at_zero_skips_refused
  (goal ((x Int)) ((= x 16)) (= (sg_ni 16 16) (sg_ni 16 x)))
  (steps ((rewrite (premise 0) rl lhs (at 0) ())) refl))

;; `false` = (at 0).
(claim sgc_first_skips_refused
  (goal ((x Int)) ((= x 16)) (= (sg_ni 16 16) (sg_ni 16 x)))
  (steps ((rewrite (premise 0) rl lhs false ())) refl))

;; `true` rewrites every compatible site — the one Int position.
(claim sgc_all_skips_refused
  (goal ((x Int)) ((= x 16)) (= (sg_ni 16 16) (sg_ni 16 x)))
  (steps ((rewrite (premise 0) rl lhs true ())) refl))

;; MUST FAIL: (at 1) is out of range — the refused site does not make a
;; second index.
(claim sgc_at_one_out_of_range
  (goal ((x Int)) ((= x 16)) (= (sg_ni 16 16) (sg_ni 16 x)))
  (steps ((rewrite (premise 0) rl lhs (at 1) ())) refl))
