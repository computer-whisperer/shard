;;; rewrite_first_arms.shard — the `false` (first-site) occurrence selector
;;; is `(at 0)`: ONE preorder walk (checker.shard rewrite_nth, k = 0), so a
;;; first-site rewrite reaches the same sites an all-occurrences rewrite
;;; would — including a `match` arm BODY when pattern and replacement are
;;; BVar-free and the replacement introduces no binder (the rewrite_all
;;; guard). Before the fold `false` had its own walker that stopped at the
;;; scrutinee, so the claims below FAILED while their `(at 0)` twins passed.

(import "../../kernel/stdlib.shard")

(fn g ((a Bool) (k Int)) Int
  (match a
    (True (if (int_eq k 1) 3 4))
    (False 9)))

;; plain rewrite, `false`: the only site of (int_eq k 1) is inside the
;; reified True-arm body.
(claim first_reaches_arm_body
  (goal ((a Bool) (k Int)) ((= a True) (= (int_eq k 1) True)) (= (g a k) 3))
  (steps
    ((compute lhs)
     (rewrite (premise 1) lr lhs false ())
     (rewrite (premise 0) lr lhs true ())
     (compute lhs))
    refl))

;; control: (at 0) — the same site, the same walk.
(claim at_zero_reaches_arm_body
  (goal ((a Bool) (k Int)) ((= a True) (= (int_eq k 1) True)) (= (g a k) 3))
  (steps
    ((compute lhs)
     (rewrite (premise 1) lr lhs (at 0) ())
     (rewrite (premise 0) lr lhs true ())
     (compute lhs))
    refl))

(fn wrapq ((n Int)) Int (if (le 0 n) n -1))

(claim wrapq_id
  (goal ((n Int)) ((= (le 0 n) True)) (= (wrapq n) n))
  (steps
    ((unfold wrapq lhs) (rewrite (premise 0) lr lhs true ()) (reduce lhs))
    refl))

(fn h ((a Bool) (k Int)) Int
  (match a
    (True (wrapq k))
    (False 9)))

;; rewrite-with, the 6-arg (first-site) spelling: the only (wrapq k) site
;; sits in the True-arm body after the unfold.
(claim with_first_reaches_arm_body
  (goal ((a Bool) (k Int)) ((= a True) (= (le 0 k) True)) (= (h a k) k))
  (steps
    ((unfold h lhs))
    (rewrite-with
      (lemma wrapq_id)
      lr
      lhs
      ((inst n k))
      ((steps ((rewrite (premise 1) lr lhs true ())) refl))
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))))

;; the same with an explicit `false` in the 7-arg spelling.
(claim with_false_reaches_arm_body
  (goal ((a Bool) (k Int)) ((= a True) (= (le 0 k) True)) (= (h a k) k))
  (steps
    ((unfold h lhs))
    (rewrite-with
      (lemma wrapq_id)
      lr
      lhs
      false
      ((inst n k))
      ((steps ((rewrite (premise 1) lr lhs true ())) refl))
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))))

;; control: (at 0) through rewrite-with.
(claim with_at_zero_reaches_arm_body
  (goal ((a Bool) (k Int)) ((= a True) (= (le 0 k) True)) (= (h a k) k))
  (steps
    ((unfold h lhs))
    (rewrite-with
      (lemma wrapq_id)
      lr
      lhs
      (at 0)
      ((inst n k))
      ((steps ((rewrite (premise 1) lr lhs true ())) refl))
      (steps ((rewrite (premise 0) lr lhs true ()) (compute lhs)) refl))))
