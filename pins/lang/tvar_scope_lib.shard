;;; tvar_scope_lib.shard — issue-#38 fixture, the LIBRARY half.
;;;
;;; `T` is declared nowhere in this module's scope, so in `hd_or_cons` it is
;;; a GENERIC type variable of the goal (the spelling kernel/term's len_cons,
;;; std/list's requirements and std/order's if_le_lt_swap all use). That
;;; meaning must not depend on who imports this file: tvar_scope.shard
;;; imports it and declares its own `(type T …)`.
(import "../../kernel/stdlib.shard")

(fn (hd_or T) ((d T) (xs (List T))) T
  (match xs
    (Nil d)
    ((Cons h _) h)))

(claim hd_or_cons
  (goal ((d T) (h T) (t (List T))) () (= (hd_or d (Cons h t)) h))
  (steps ((simp lhs)) refl))
