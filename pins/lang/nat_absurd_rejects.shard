;;; nat_absurd_rejects.shard — SOUNDNESS REGRESSION TEST.
;;;
;;; The rejects twin of nat_prim.shard, guarding `absurd`'s no-confusion half
;;; against the Nat former's packed representation.
;;;
;;; A ground Z/S tower and its nonneg literal are the SAME value (reduce.shard
;;; nat_pack; tc_nat_lit_view is the typing twin), and the PROOF-FACING
;;; normalizers deliberately do not pack — so `simp`, which is what Absurd
;;; normalizes with, can leave one side spelled (S Z) and the other spelled 1.
;;;
;;; The bug: head_clash called Ctor-vs-IntLit a DEFINITE clash — true for every
;;; other datatype, false for Nat. `zero_is_one` below checked, with no axiom,
;;; no shadowing, and no admit: (S 1) is well-typed (tc_nat_lit_view admits a
;;; nonneg literal in an ARGUMENT position), `inject` peels one S into the
;;; premise (= (S Z) 1) — a TRUE equation — and absurd read it as a
;;; contradiction.
;;;
;;; The fix: head_clash decides the Nat case structurally (nat_lit_clash)
;;; instead of assuming it. Z vs n clashes iff n /= 0; (S e) vs n recurses on
;;; e vs n-1; every other ctor against a literal still clashes outright.
;;;
;;; nat_mixed PASSES and stays here on purpose: it pins that the mixed spelling
;;; is legitimately well-typed and legitimately TRUE, so the guard below is
;;; about head_clash's verdict, not about rejecting the term.
;;;
;;; If a future change re-opens the hole, this file flips from "1 passed, 1
;;; failed" to "2 passed" and the corpus diff catches it.

(import "../../kernel/stdlib.shard")

;; PASSES — both sides are the ground Nat 2. The literal sits in an argument
;; position, where the Nat-literal view accepts it.
(claim nat_mixed (goal () () (= (S (S Z)) (S 1))) (steps ((compute both)) refl))

;; MUST FAIL — inject hands absurd the TRUE equation (= (S Z) 1).
(claim zero_is_one
  (goal () () (= 0 1))
  (inject (lemma nat_mixed) (k) (absurd (premise 0))))
